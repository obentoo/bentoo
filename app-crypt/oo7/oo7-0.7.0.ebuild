RUST_MIN_VER="1.95"

inherit cargo meson pam systemd

DESCRIPTION="Secret Service provider, CLI and portal backend written in Rust"
HOMEPAGE="https://github.com/linux-credentials/oo7"
SRC_URI="
	https://github.com/linux-credentials/oo7/archive/refs/tags/${PV}.tar.gz
		-> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD MIT Unicode-3.0
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="pam +portal +server systemd"
REQUIRED_USE="pam? ( server )"
# The suites need a live D-Bus session bus and a PAM stack; neither exists
# in the Portage sandbox.
RESTRICT="test"

DEPEND="pam? ( sys-libs/pam )"
RDEPEND="
	${DEPEND}
	sys-apps/dbus
	portal? ( sys-apps/xdg-desktop-portal )
"
BDEPEND="
	>=dev-build/meson-1.7
	server? ( sys-devel/gettext )
"

QA_FLAGS_IGNORED="
	usr/bin/.*
	usr/libexec/oo7-.*
	.*/security/pam_oo7.so
"

# Each meson project runs "cargo build" from its build directory, so cargo
# resolves the workspace from there: the build directories live inside ${S},
# and each one's "src" output directory is the shared cargo target, so the
# three projects reuse the artifacts instead of compiling the tree three times.
oo7_meson_projects() {
	usev server
	usev portal
	usev pam
}

src_prepare() {
	default

	# Build only the crate a meson project installs. Unrestricted, "cargo
	# build" from the workspace builds every member, the pyo3 bindings
	# included. A silent no-op here would bring that back, hence the guard.
	local dir crate
	for dir in server:oo7-daemon portal:oo7-portal pam:oo7-pam; do
		crate=${dir#*:}
		dir=${dir%%:*}
		grep -qF "cargo_options = []" "${dir}/src/meson.build" ||
			die "${dir}/src/meson.build: cargo_options anchor not found"
		sed -i "s/^cargo_options = \[\]$/cargo_options = [ '--package', '${crate}' ]/" \
			"${dir}/src/meson.build" || die
		grep -qF "'--package', '${crate}'" "${dir}/src/meson.build" ||
			die "${dir}/src/meson.build: --package was not applied"
	done
}

src_configure() {
	# gettext-rs links the libc's gettext instead of building its bundled copy.
	export GETTEXT_SYSTEM=1

	local proj emesonargs
	for proj in $(oo7_meson_projects); do
		emesonargs=()
		case ${proj} in
			server|portal)
				emesonargs+=( $(meson_feature systemd) )
				use systemd && emesonargs+=(
					-Dsystemduserunitdir="$(systemd_get_userunitdir)"
				)
				;;
			pam)
				emesonargs+=( -Dpam_moduledir="$(getpam_mod_dir)" )
				;;
		esac
		EMESON_SOURCE="${S}/${proj}" BUILD_DIR="${S}/build-${proj}" \
			meson_src_configure
		rmdir "${S}/build-${proj}/src" || die
		ln -s "${S}/target" "${S}/build-${proj}/src" || die
	done
}

src_compile() {
	cargo_src_compile \
		--package oo7-cli \
		--package cargo-credential-oo7 \
		--package git-credential-oo7

	local proj
	for proj in $(oo7_meson_projects); do
		BUILD_DIR="${S}/build-${proj}" cargo_env meson_src_compile
	done
}

src_install() {
	local proj
	for proj in $(oo7_meson_projects); do
		BUILD_DIR="${S}/build-${proj}" meson_src_install
	done

	dobin "$(cargo_target_dir)"/{oo7-cli,cargo-credential-oo7,git-credential-oo7}

	# The systemd user units above are gated behind USE=systemd; the OpenRC
	# user scripts never are (overlay policy: no systemd-only daemons).
	exeinto /etc/user/init.d
	use server && newexe "${FILESDIR}"/oo7-daemon.initd oo7-daemon
	use portal && newexe "${FILESDIR}"/oo7-portal.initd oo7-portal

	dodoc README.md
}

pkg_postinst() {
	if use server; then
		elog "oo7-daemon provides org.freedesktop.secrets. Run only one Secret"
		elog "Service provider per session: gnome-keyring-daemon and KDE's"
		elog "ksecretd claim the same D-Bus name, and whichever starts first"
		elog "wins."
		elog
		elog "OpenRC: rc-update -U add oo7-daemon"
		use systemd && elog "systemd: systemctl --user enable --now oo7-daemon.service"
	fi
	if use pam; then
		elog
		elog "To unlock the keyring at login, add pam_oo7.so to the display"
		elog "manager's PAM stack, e.g. in /etc/pam.d/<dm>:"
		elog "  auth     optional  pam_oo7.so"
		elog "  session  optional  pam_oo7.so"
		elog "The module stays inactive until it is listed there."
	fi
}
