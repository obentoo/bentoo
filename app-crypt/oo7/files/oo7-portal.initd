description="Secret portal backend (oo7)"

depend() {
	need dbus
}

DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
supervisor=supervise-daemon
command="/usr/libexec/oo7-portal"
no_new_privs=1
umask=0077
