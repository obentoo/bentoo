description="Secret Service provider (oo7)"

depend() {
	need dbus
}

DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
supervisor=supervise-daemon
command="/usr/libexec/oo7-daemon"
# Mirrors NoNewPrivileges= of the upstream systemd unit; the keyring files
# the daemon creates are private to the user.
no_new_privs=1
umask=0077
