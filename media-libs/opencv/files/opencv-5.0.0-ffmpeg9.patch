AVCodec::pix_fmts and AVCodec::supported_framerates were deprecated in
FFmpeg 7.1 (libavcodec 61.13.100) and removed in FFmpeg 9.0. Query them
through avcodec_get_supported_config() when it is available.

diff --git a/modules/videoio/src/cap_ffmpeg_hw.hpp b/modules/videoio/src/cap_ffmpeg_hw.hpp
index 65045a2..4b21c8f 100644
--- a/modules/videoio/src/cap_ffmpeg_hw.hpp
+++ b/modules/videoio/src/cap_ffmpeg_hw.hpp
@@ -757,9 +757,17 @@ AVCodec *hw_find_codec(AVCodecID id, AVHWDeviceType hw_type, int (*check_categor
 #endif
             if (hw_type == AV_HWDEVICE_TYPE_CUDA) // CUDA encoders don't support avcodec_get_hw_config()
                 hw_native_fmt = AV_PIX_FMT_CUDA;
-            if (av_codec_is_encoder(c) && hw_native_fmt != AV_PIX_FMT_NONE && c->pix_fmts) {
-                for (int i = 0; c->pix_fmts[i] != AV_PIX_FMT_NONE; i++) {
-                    if (c->pix_fmts[i] == hw_native_fmt) {
+            // AVCodec::pix_fmts removed in FFmpeg release 9.0
+            const AVPixelFormat *pix_fmts = NULL;
+#if LIBAVCODEC_BUILD >= CALC_FFMPEG_VERSION(61, 13, 100)
+            if (avcodec_get_supported_config(NULL, c, AV_CODEC_CONFIG_PIX_FORMAT, 0, (const void **)&pix_fmts, NULL) < 0)
+                pix_fmts = NULL;
+#else
+            pix_fmts = c->pix_fmts;
+#endif
+            if (av_codec_is_encoder(c) && hw_native_fmt != AV_PIX_FMT_NONE && pix_fmts) {
+                for (int i = 0; pix_fmts[i] != AV_PIX_FMT_NONE; i++) {
+                    if (pix_fmts[i] == hw_native_fmt) {
                         *hw_pix_fmt = hw_native_fmt;
                         if (hw_check_codec(c, hw_type, disabled_codecs))
                             return c;
diff --git a/modules/videoio/src/cap_ffmpeg_impl.hpp b/modules/videoio/src/cap_ffmpeg_impl.hpp
index 3dd42ec..2ad71c6 100644
