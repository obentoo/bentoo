@@ -30,6 +30,32 @@
 
 AUD_NAMESPACE_BEGIN
 
+// FFmpeg 9 removed AVCodec::sample_fmts and AVCodec::supported_samplerates
+// (deprecated since 7.1); query them through avcodec_get_supported_config().
+static const AVSampleFormat* aud_get_sample_fmts(AVCodecContext* context, const AVCodec* codec)
+{
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+	const AVSampleFormat* sample_fmts = nullptr;
+	if(avcodec_get_supported_config(context, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, (const void**)&sample_fmts, nullptr) < 0)
+		return nullptr;
+	return sample_fmts;
+#else
+	return codec->sample_fmts;
+#endif
+}
+
+static const int* aud_get_sample_rates(AVCodecContext* context, const AVCodec* codec)
+{
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+	const int* sample_rates = nullptr;
+	if(avcodec_get_supported_config(context, codec, AV_CODEC_CONFIG_SAMPLE_RATE, 0, (const void**)&sample_rates, nullptr) < 0)
+		return nullptr;
+	return sample_rates;
+#else
+	return codec->supported_samplerates;
+#endif
+}
+
