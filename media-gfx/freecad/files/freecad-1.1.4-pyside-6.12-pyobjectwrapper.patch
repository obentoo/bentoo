PySide 6.12 stopped including pyobjectwrapper.h from signalmanager.h, so
PythonWrapper.cpp fails with "'PyObjectWrapper' in namespace 'PySide' does not
name a type". Include it explicitly; __has_include keeps older PySide working.
No upstream fix yet.

--- a/src/Gui/PythonWrapper.cpp
+++ b/src/Gui/PythonWrapper.cpp
@@ -121,6 +121,10 @@
 
 #ifdef HAVE_PYSIDE
 # include <signalmanager.h>
+// PySide 6.12 no longer includes pyobjectwrapper.h from signalmanager.h
+# if __has_include(<pyobjectwrapper.h>)
+#  include <pyobjectwrapper.h>
+# endif
 #endif  // HAVE_PYSIDE
 
 //-----------------------------------------------------------------------------
