   testonly = true
   sources = [ "private_verification_tokens_test_util.h" ]
-  public_deps = [
-    "//base",
-    "//components/private_verification_tokens/common/athm_ffi:athm_ffi_bindings",
-  ]
+  public_deps = [ "//base" ]
+
+  # bentoo: Crubit bindings only exist when enable_cpp_api_from_rust is true.
+  if (enable_cpp_api_from_rust) {
+    public_deps += [ "//components/private_verification_tokens/common/athm_ffi:athm_ffi_bindings" ]
+  }
 }
 
 # ATHM (Anonymous Tokens with Hidden Metadata): Crubit bindings over
@@ -203,7 +205,9 @@
     public_deps = [
       ":private_verification_tokens_issuer_config",
       "//base",
-      "//components/private_verification_tokens/common/athm_ffi:athm_ffi_bindings",
+
+      # bentoo: cxx bridge, see athm_ffi/athm_cxx.rs.
+      "//components/private_verification_tokens/common/athm_ffi:athm_cxx",
     ]
   }
 
@@ -216,10 +220,14 @@
       ":private_verification_tokens_parameters",
       ":private_verification_tokens_public_key",
       "//base",
-      "//components/private_verification_tokens/common/athm_ffi:athm_ffi_bindings",
       "//testing/gmock",
       "//testing/gtest",
       "//url",
     ]
+
+    # bentoo: Crubit bindings only exist when enable_cpp_api_from_rust is true.
+    if (enable_cpp_api_from_rust) {
+      deps += [ "//components/private_verification_tokens/common/athm_ffi:athm_ffi_bindings" ]
+    }
   }
 }
diff -ruN a/components/private_verification_tokens/common/privacy_pass_athm_batch_request.cc b/components/private_verification_tokens/common/privacy_pass_athm_batch_request.cc
--- a/components/private_verification_tokens/common/privacy_pass_athm_batch_request.cc
+++ b/components/private_verification_tokens/common/privacy_pass_athm_batch_request.cc
@@ -7,9 +7,10 @@
 #include <utility>
 #include <vector>
 
+#include "base/compiler_specific.h"
+#include "base/containers/span_rust.h"
 #include "base/containers/to_vector.h"
-#include "components/private_verification_tokens/common/athm_ffi/athm_ffi.h"
-#include "third_party/crubit/support/rs_std/slice_ref.h"
+#include "components/private_verification_tokens/common/athm_ffi/athm_cxx.rs.h"
 
 namespace private_verification_tokens {
 
@@ -26,27 +27,30 @@
         PrivacyPassAthmBatchRequestError::kInvalidBucketCount);
   }
 
-  auto client_result = PrivacyPassBatchClient::try_new(
-      rs_std::SliceRef<const uint8_t>(issuer_config.public_key.public_key()),
-      rs_std::SliceRef<const uint8_t>(
-          issuer_config.public_key.public_key_proof()),
+  rust::Box<athm_cxx::AthmCxxBatchClient> client = athm_cxx::new_batch_client(
+      base::SpanToRustSlice(issuer_config.public_key.public_key()),
+      base::SpanToRustSlice(issuer_config.public_key.public_key_proof()),
       num_buckets,
-      rs_std::SliceRef<const uint8_t>(
-          base::as_byte_span(issuer_config.deployment_id)),
+      base::SpanToRustSlice(base::as_byte_span(issuer_config.deployment_id)),
       issuer_config.public_key.version(),
       static_cast<size_t>(issuer_config.batch_size));
-  if (!client_result.has_value()) {
+  if (!client->batch_client_ok()) {
     return base::unexpected(
         PrivacyPassAthmBatchRequestError::kClientRequestGenerationFailed);
   }
 
-  return PrivacyPassAthmBatchRequest(std::move(*client_result));
+  return PrivacyPassAthmBatchRequest(std::move(client));
 }
 
 PrivacyPassAthmBatchRequest::PrivacyPassAthmBatchRequest(
-    PrivacyPassBatchClient batch_client)
-    : batch_client_(std::move(batch_client)),
-      request_body_(base::ToVector(batch_client_->request_body().to_span())) {}
+    rust::Box<athm_cxx::AthmCxxBatchClient> batch_client)
+    : batch_client_(std::move(batch_client)) {
+  rust::Slice<const uint8_t> body = (*batch_client_)->request_body();
+  // SAFETY: `body` borrows the Rust-owned request body inside
+  // `batch_client_`, and `data()`/`size()` describe exactly that allocation.
+  request_body_ =
+      base::ToVector(UNSAFE_BUFFERS(base::span(body.data(), body.size())));
+}
 
 PrivacyPassAthmBatchRequest::PrivacyPassAthmBatchRequest(
     PrivacyPassAthmBatchRequest&&) = default;
@@ -62,22 +66,29 @@
         PrivacyPassAthmBatchRequestError::kAlreadyFinalized);
   }
 
-  auto finalize_result =
-      std::exchange(batch_client_, std::nullopt)
-          ->finalize(rs_std::SliceRef<const uint8_t>(response_body));
-  if (!finalize_result.has_value()) {
-    if (finalize_result.error() == AthmStatus::MakeInvalidInput()) {
-      return base::unexpected(
-          PrivacyPassAthmBatchRequestError::kInvalidResponseBodyLength);
-    }
+  rust::Box<athm_cxx::AthmCxxBatchClient> batch_client =
+      std::move(*std::exchange(batch_client_, std::nullopt));
+  rust::Vec<uint8_t> tokens;
+  rust::Vec<size_t> token_sizes;
+  const athm_cxx::FinalizeStatus status = batch_client->finalize(
+      base::SpanToRustSlice(response_body), tokens, token_sizes);
+  if (status == athm_cxx::FinalizeStatus::InvalidInput) {
+    return base::unexpected(
+        PrivacyPassAthmBatchRequestError::kInvalidResponseBodyLength);
+  }
+  if (status != athm_cxx::FinalizeStatus::Success) {
     return base::unexpected(
         PrivacyPassAthmBatchRequestError::kClientFinalizeFailed);
   }
 
+  // SAFETY: `tokens` owns `size()` contiguous bytes at `data()`.
+  base::span<const uint8_t> remaining =
+      UNSAFE_BUFFERS(base::span(tokens.data(), tokens.size()));
   std::vector<std::vector<uint8_t>> finalized_tokens;
-  finalized_tokens.reserve(finalize_result->size());
-  for (const auto& token : *finalize_result) {
-    finalized_tokens.push_back(base::ToVector(token));
+  finalized_tokens.reserve(token_sizes.size());
+  for (size_t token_size : token_sizes) {
+    finalized_tokens.push_back(
+        base::ToVector(remaining.take_first(token_size)));
   }
   return finalized_tokens;
 }
