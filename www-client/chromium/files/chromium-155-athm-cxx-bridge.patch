diff -ruN a/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs b/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs
--- a/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs
+++ b/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs
@@ -0,0 +1,105 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `cxx` bridge over the client half of `athm_ffi`, for builds where Crubit's
+//! `cpp_api_from_rust` is unavailable (`enable_cpp_api_from_rust == false`).
+//!
+//! It exposes exactly the operations `PrivacyPassAthmBatchRequest` needs, and
+//! nothing else: the protocol logic stays in `athm_ffi`, this file only adapts
+//! calling conventions. `cxx` cannot return `Result` without C++ exceptions,
+//! which Chromium disables, so a failed constructor yields an object whose
+//! `batch_client_ok()` is false, and `finalize` reports its outcome as a shared
+//! enum. `cxx` has no `Vec<Vec<u8>>` either, so the finalized tokens come back
+//! concatenated, with their individual lengths alongside.
+
+chromium::import! {
+    "//components/private_verification_tokens/common/athm_ffi:athm_ffi";
+}
+
+use athm_ffi::{AthmStatus, PrivacyPassBatchClient};
+
+#[cxx::bridge(namespace = "private_verification_tokens::athm_cxx")]
+mod ffi {
+    enum FinalizeStatus {
+        Success,
+        InvalidInput,
+        OperationFailed,
+    }
+
+    extern "Rust" {
+        type AthmCxxBatchClient;
+
+        fn new_batch_client(
+            public_key: &[u8],
+            public_key_proof: &[u8],
+            num_buckets: u8,
+            deployment_id: &[u8],
+            version: u32,
+            batch_size: usize,
+        ) -> Box<AthmCxxBatchClient>;
+        fn batch_client_ok(self: &AthmCxxBatchClient) -> bool;
+        fn request_body(self: &AthmCxxBatchClient) -> &[u8];
+        fn finalize(
+            self: &mut AthmCxxBatchClient,
+            response_body: &[u8],
+            tokens: &mut Vec<u8>,
+            token_sizes: &mut Vec<usize>,
+        ) -> FinalizeStatus;
+    }
+}
+
+pub struct AthmCxxBatchClient(Option<PrivacyPassBatchClient>);
+
+fn new_batch_client(
+    public_key: &[u8],
+    public_key_proof: &[u8],
+    num_buckets: u8,
+    deployment_id: &[u8],
+    version: u32,
+    batch_size: usize,
+) -> Box<AthmCxxBatchClient> {
+    Box::new(AthmCxxBatchClient(
+        PrivacyPassBatchClient::try_new(
+            public_key,
+            public_key_proof,
+            num_buckets,
+            deployment_id,
+            version,
+            batch_size,
+        )
+        .ok(),
+    ))
+}
+
+impl AthmCxxBatchClient {
+    fn batch_client_ok(&self) -> bool {
+        self.0.is_some()
+    }
+
+    fn request_body(&self) -> &[u8] {
+        self.0.as_ref().map_or(&[][..], PrivacyPassBatchClient::request_body)
+    }
+
+    fn finalize(
+        &mut self,
+        response_body: &[u8],
+        tokens: &mut Vec<u8>,
+        token_sizes: &mut Vec<usize>,
+    ) -> ffi::FinalizeStatus {
+        let Some(client) = self.0.as_mut() else {
+            return ffi::FinalizeStatus::OperationFailed;
+        };
+        match client.finalize(response_body) {
+            Ok(finalized) => {
+                for token in finalized {
+                    token_sizes.push(token.len());
+                    tokens.extend_from_slice(&token);
+                }
+                ffi::FinalizeStatus::Success
+            }
+            Err(AthmStatus::InvalidInput) => ffi::FinalizeStatus::InvalidInput,
+            Err(AthmStatus::OperationFailed) => ffi::FinalizeStatus::OperationFailed,
+        }
+    }
+}
diff -ruN a/components/private_verification_tokens/common/athm_ffi/BUILD.gn b/components/private_verification_tokens/common/athm_ffi/BUILD.gn
--- a/components/private_verification_tokens/common/athm_ffi/BUILD.gn
+++ b/components/private_verification_tokens/common/athm_ffi/BUILD.gn
@@ -26,6 +26,18 @@
   ]
 }
 
+# bentoo: `cxx` bridge over the client half of athm_ffi, used in place of the
+# Crubit `athm_ffi_bindings` above, which gn only defines when
+# enable_cpp_api_from_rust is true.
+rust_static_library("athm_cxx") {
+  allow_unsafe = true  # Needed for FFI that underpins the `cxx` crate.
+  crate_root = "athm_cxx.rs"
+  sources = [ crate_root ]
+  cxx_bindings = [ crate_root ]
+  deps = [ ":athm_ffi" ]
+  visibility = [ "//components/private_verification_tokens/common:*" ]
+}
+
 rust_static_library("privacy_pass_unittests") {
   testonly = true
   is_gtest_unittests = true
