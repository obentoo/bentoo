+
+// bentoo: `cxx` bridge standing in for the Crubit `cpp_api_from_rust` binding,
+// which needs Chromium's bundled Rust toolchain. Only the binding layer is
+// new; everything above is upstream's code. `union` is a C++ keyword, so it
+// is exported as `union_`, the name Crubit gave it.
+#[cxx::bridge(namespace = "ift_patcher_rs")]
+mod ffi {
+    enum ApplyStatus {
+        Success,
+        InvalidFont,
+        PatchGroupError,
+        PatchError,
+        MissingPatches,
+    }
+
+    extern "Rust" {
+        type IftSubsetDefinition;
+        type IftPatcher;
+
+        fn new_subset_definition() -> Box<IftSubsetDefinition>;
+        fn clone_subset_definition(subset: &IftSubsetDefinition) -> Box<IftSubsetDefinition>;
+        fn add_codepoint(self: &mut IftSubsetDefinition, codepoint: u32) -> bool;
+        fn add_feature_tag(self: &mut IftSubsetDefinition, tag: u32) -> bool;
+        fn add_design_space(
+            self: &mut IftSubsetDefinition,
+            tag: u32,
+            min_val: f64,
+            max_val: f64,
+        ) -> bool;
+        #[cxx_name = "union_"]
+        fn union(self: &mut IftSubsetDefinition, other: &IftSubsetDefinition);
+
+        fn is_ift_font(font_data: &[u8]) -> bool;
+        fn new_patcher(font_data: &[u8]) -> Box<IftPatcher>;
+        fn font_data(self: &IftPatcher) -> &[u8];
+        fn request_patches(self: &mut IftPatcher, subset: &IftSubsetDefinition) -> Vec<String>;
+        fn add_patch_data(self: &mut IftPatcher, patch: &str, data: &[u8]);
+        fn apply_patches_ffi(self: &mut IftPatcher, subset: &IftSubsetDefinition) -> ApplyStatus;
+        fn has_pending_patch_requests(self: &IftPatcher) -> bool;
+    }
+}
+
+fn new_subset_definition() -> Box<IftSubsetDefinition> {
+    Box::default()
+}
+
+fn clone_subset_definition(subset: &IftSubsetDefinition) -> Box<IftSubsetDefinition> {
+    Box::new(subset.clone())
+}
+
+fn is_ift_font(font_data: &[u8]) -> bool {
+    IftPatcher::is_ift(font_data)
+}
+
+fn new_patcher(font_data: &[u8]) -> Box<IftPatcher> {
+    Box::new(IftPatcher::from(font_data))
+}
+
+impl IftPatcher {
+    fn apply_patches_ffi(&mut self, subset: &IftSubsetDefinition) -> ffi::ApplyStatus {
+        match self.apply_patches(subset) {
+            IftApplyStatus::Success => ffi::ApplyStatus::Success,
+            IftApplyStatus::InvalidFont => ffi::ApplyStatus::InvalidFont,
+            IftApplyStatus::PatchGroupError => ffi::ApplyStatus::PatchGroupError,
+            IftApplyStatus::PatchError => ffi::ApplyStatus::PatchError,
+            IftApplyStatus::MissingPatches => ffi::ApplyStatus::MissingPatches,
+        }
+    }
+}
