# Rust support: the drm_panic QR code (its encoder is written in Rust) and
# the Rust drivers the base config selects (Rust binder, Rust PHY drivers).
# The early nova driver for NVIDIA GSP GPUs stays off, as in Fedora's config.
CONFIG_RUST=y
CONFIG_DRM_PANIC_SCREEN="qr_code"
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
# The kmsg goes after '#', in the URL fragment, which browsers never send to
# the server: the page decodes it on the reader's device.
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL="https://drm-panic.obentoo.org/#"
