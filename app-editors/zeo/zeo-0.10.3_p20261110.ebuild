	LIVEKIT_GIT+=", rev = \"${LIVEKIT_COMMIT}\""
	local LIVEKIT_PATH="livekit = \\{ path = \"${WORKDIR}/livekit-rust-sdks-${LIVEKIT_COMMIT}/livekit\""

	local LIBWEBRTC_GIT="libwebrtc = { git = \"https://github.com/zed-industries/livekit-rust-sdks\""
	LIBWEBRTC_GIT+=", rev = \"${LIVEKIT_COMMIT}\""
	local LIBWEBRTC_PATH="libwebrtc = \\{ path = \"${WORKDIR}/livekit-rust-sdks-${LIVEKIT_COMMIT}/libwebrtc\""

	local WIN_CAP_COMMIT="f0d6c1b6691db75461b732f6d5ff56eed002eeb9"
	local WIN_CAP_GIT="windows-capture = { git = \"https://github.com/zed-industries/windows-capture.git\""
	WIN_CAP_GIT+=", rev = \"${WIN_CAP_COMMIT}\""
	local WIN_CAP_PATH="windows-capture = \\{ path = \"${WORKDIR}/windows-capture-${WIN_CAP_COMMIT}\""

	local WEBRTC_SYS_GIT="webrtc-sys = { git = \"https://github.com/zed-industries/livekit-rust-sdks\""
	WEBRTC_SYS_GIT+=", rev = \"${LIVEKIT_COMMIT}\""
	local WEBRTC_SYS_PATH="webrtc-sys = \\{ path = \"${WORKDIR}/livekit-rust-sdks-${LIVEKIT_COMMIT}/webrtc-sys\""

	local NOTIFY_COMMIT="d842f16b2716bd60f09caf3ae3a894237ab38f54"
	local NOTIFY_GIT="notify = { git = \"https://github.com/zed-industries/notify\""
	NOTIFY_GIT+=", rev = \"${NOTIFY_COMMIT}\""
	local NOTIFY_PATH="notify = \\{ path = \"${WORKDIR}/notify-${NOTIFY_COMMIT}/notify\""

	local TREE_SITTER_COMMIT="803c6ebaac27d69e1808b45058482e868d073ceb"
	local TREE_SITTER_GIT="tree-sitter = { git = \"https://github.com/tree-sitter/tree-sitter\""
	TREE_SITTER_GIT+=", rev = \"${TREE_SITTER_COMMIT}\""
	local TREE_SITTER_PATH="tree-sitter = \\{ path = \"${WORKDIR}/tree-sitter-${TREE_SITTER_COMMIT}/lib\""

	local TS_LANGUAGE_GIT="tree-sitter-language = { git = \"https://github.com/tree-sitter/tree-sitter\""
	TS_LANGUAGE_GIT+=", rev = \"${TREE_SITTER_COMMIT}\""
	local TS_LANGUAGE_PATH="tree-sitter-language = \\{ path = \"${WORKDIR}"
	TS_LANGUAGE_PATH+="/tree-sitter-${TREE_SITTER_COMMIT}/crates/language\""

	local NOTIFY_TYPES_GIT="notify-types = { git = \"https://github.com/zed-industries/notify\""
	NOTIFY_TYPES_GIT+=", rev = \"${NOTIFY_COMMIT}\""
	local NOTIFY_TYPES_PATH="notify-types = \\{ path = \"${WORKDIR}/notify-${NOTIFY_COMMIT}/notify-types\""

	local CRASH_CONTEXT_COMMIT="911b04e09b79b736cc15cbe712e83e2d3f348bb9"
	local CRASH_CONTEXT_GIT="crash-context = { git = \"https://github.com/rust-minidump/minidump-writer\""
	CRASH_CONTEXT_GIT+=", rev = \"${CRASH_CONTEXT_COMMIT}\""
	local CRASH_CONTEXT_PATH="crash-context = \\{ path = \"${WORKDIR}/minidump-writer-${CRASH_CONTEXT_COMMIT}"
	CRASH_CONTEXT_PATH+="/crates/crash-context\""

	sed -e "s#${ASYNC_PROCESS_GIT}#${ASYNC_PROCESS_PATH}#" \
		-e "s#${ASYNC_TASK_GIT}#${ASYNC_TASK_PATH}#" \
		-e "s#${CALLOOP_GIT}#${CALLOOP_PATH}#" \
		-e "s#${CPAL_GIT}#${CPAL_PATH}#" \
		-e "s#${KHRONOS_EGL_GIT}#${KHRONOS_EGL_PATH}#" \
		-e "s#${LIVEKIT_GIT}#${LIVEKIT_PATH}#" \
		-e "s#${LIBWEBRTC_GIT}#${LIBWEBRTC_PATH}#" \
		-e "s#${WEBRTC_SYS_GIT}#${WEBRTC_SYS_PATH}#" \
		-e "s#${WIN_CAP_GIT}#${WIN_CAP_PATH}#" \
		-e "s#${NOTIFY_TYPES_GIT}#${NOTIFY_TYPES_PATH}#" \
		-e "s#${NOTIFY_GIT}#${NOTIFY_PATH}#" \
		-e "s#${TS_LANGUAGE_GIT}#${TS_LANGUAGE_PATH}#" \
		-e "s#${TREE_SITTER_GIT}#${TREE_SITTER_PATH}#" \
		-e "s#${CRASH_CONTEXT_GIT}#${CRASH_CONTEXT_PATH}#" \
		-i "${S}/Cargo.toml" || die "Cargo fetch workaround failed"

	# Toggle gpui display backend features based on USE flags
	if ! use wayland; then
		sed -e '/\"gpui\/wayland\"/d' \
			-e '/^\s*\"wayland\",$/d' \
			-e 's/, "wayland"//' \
			-e 's/"wayland", //' \
			-i "${S}/crates/zed/Cargo.toml" || die "Failed to disable wayland feature"
	fi
	if ! use X; then
		sed -e '/\"gpui\/x11\"/d' \
			-e '/^\s*\"x11\",$/d' \
			-e 's/, "x11"//' \
			-e 's/"x11", //' \
			-i "${S}/crates/zed/Cargo.toml" || die "Failed to disable x11 feature"
	fi

	# Toggle screen-capture feature on gpui_platform
	# The first expression deletes the whole LINE: since ef50ad95 the
	# gpui_platform features array is multi-line, so removing only the text
	# would leave an orphan comma ("extra comma in array") that makes the TOML
	# invalid. The other three keep covering the inline form, in case upstream
	# collapses the array again.
	if ! use screen-capture; then
		sed -e '/^[[:space:]]*"screen-capture",\?[[:space:]]*$/d' \
			-e 's/"screen-capture", //' \
			-e 's/, "screen-capture"//' \
			-e 's/"screen-capture"//' \
			-i "${S}/crates/zed/Cargo.toml" || die "Failed to disable screen-capture feature"
	fi

	# Enable neovim integration in vim crate
	if use neovim; then
		sed -e 's/vim\.workspace = true/vim = { workspace = true, features = ["neovim"] }/' \
			-i "${S}/crates/zed/Cargo.toml" || die "Failed to enable neovim feature"
	fi
}

src_compile() {
	export RELEASE_VERSION="${PV}"
	# 0091 (Zeo next proposal §6.18): the About window's Zed row shows the
	# packaged upstream commit. Not ZED_COMMIT_SHA, which would also rewrite
	# AppVersion, the version extensions check compatibility against.
	export ZEO_UPSTREAM_COMMIT="${EGIT_COMMIT}"
	export ZED_UPDATE_EXPLANATION='Zeo updates are handled by portage'
	# crates/zed/build.rs reads RELEASE_CHANNEL as an ENVIRONMENT VARIABLE, via
	# option_env!, to pick the icon it embeds -- a different input from the
	# crates/zed/RELEASE_CHANNEL file src_prepare writes, which drives the
	# runtime ReleaseChannel enum. Its match is on a string with a `_ => "-dev"`
	# arm, so leaving this unset compiles clean and embeds Zed's development
	# icon. app-editors/zed has exactly that gap today; it is masked on Wayland
	# because the compositor resolves the INSTALLED icon by app_id instead.
	export RELEASE_CHANNEL="zeo"
	# whisper-rs-sys's build.rs hands every GGML_*, WHISPER_* and CMAKE_*
	# variable to whisper.cpp's CMake. GGML_NATIVE defaults to ON, which is
	# -march=native: the build machine's CPU, the AVX-512 trap that once broke
	# zeo-bin. With it OFF, ggml switches its own x86 set on instead (SSE4.2,
	# AVX, AVX2, BMI2, FMA, F16C); turning those off too leaves the instruction
	# set to CFLAGS' -march. GGML_CCACHE=OFF keeps ggml from wrapping the
	# compiler in ccache or sccache behind Portage's back (FEATURES=ccache
	# decides that), as sci-ml/whisper-cpp and sci-ml/llama-cpp do here.
	# WHISPER_DONT_GENERATE_BINDINGS uses the crate's bundled bindings instead
	# of running bindgen. Without USE=voice nothing reads them: whisper-rs-sys
	# is not in the lockfile.
	# Exported here, they stay in the saved environment for src_test too.
	# Accepted: whisper.cpp builds at -O3 (Release), not CFLAGS' -O level.
	if use voice; then
		export GGML_NATIVE=OFF GGML_SSE42=OFF GGML_AVX=OFF GGML_AVX2=OFF \
			GGML_FMA=OFF GGML_F16C=OFF GGML_BMI2=OFF GGML_AVX512=OFF \
			GGML_CCACHE=OFF WHISPER_DONT_GENERATE_BINDINGS=1
	fi
	if use arm64; then
		export LK_CUSTOM_WEBRTC="${WORKDIR}/linux-arm64-release"
	elif use amd64; then
		export LK_CUSTOM_WEBRTC="${WORKDIR}/linux-x64-release"
	fi
	local features=()
	# gpui/inspector, not zed/inspector: upstream reverted "Implement
	# `inspector` flag" (#62920) on 2026-09-15, so the zed crate has carried no
	# such feature since. The switch is back where it was before that PR, in
	# gpui, and gpui is a direct dependency of zed, so dep/feature resolves.
	use inspector && features+=( gpui/inspector )
	use mimalloc && features+=( zed/mimalloc )
	use tracy && features+=( zed/tracy )

	local packages=(
		--package zed
		--package cli
	)
	# The native-messaging host the browser starts (0058): a workspace member of
	# its own, so it is only built when the browser channel is.
	use browser-extension && packages+=( --package zeo_browser_host )
	# "${features[*]}" alone would be an empty --features argument when no flag
	# is on; the count is what decides whether the option appears at all.
	local feature_args=()
	(( ${#features[@]} )) && feature_args=( --features "${features[*]}" )

	cargo_src_compile "${packages[@]}" "${feature_args[@]}"
}

src_install() {
	newbin "$(cargo_target_dir)"/cli "${APP_CLI}"
	exeinto "/usr/libexec"
	# zeo-editor, not zed-editor: patch 0023 leaves the launcher looking only for
	# ../libexec/zeo-editor, and this is also what keeps the file off
	# app-editors/zed's path so the two can be installed together.
	newexe "$(cargo_target_dir)"/zeo zeo-editor

	# The Zeo mark, installed under the APP_ID name because that is how a Wayland
	# compositor resolves a window's icon: it matches the app_id against the
	# installed icon file name, not against anything inside the binary.
	newicon -s 512 crates/zed/resources/app-icon-zeo.png "${APP_ID}.png"
	newicon -s 1024 crates/zed/resources/app-icon-zeo@2x.png "${APP_ID}.png"
	domenu "${S}/${APP_ID}.desktop"

	if use browser-extension; then
		# The host is started by the browser, never by a user: libexec, next to
		# zeo-editor. Its manifests name this path and only the committed
		# extension IDs (0058, crates/zeo_browser_host/manifests).
		exeinto "/usr/libexec"
		doexe "$(cargo_target_dir)"/zeo-browser-host
		local manifests="${S}/crates/zeo_browser_host/manifests"
		insinto /etc/opt/chrome/native-messaging-hosts
		newins "${manifests}"/dev.zeo.browser_host.chrome.json dev.zeo.browser_host.json
		insinto /etc/chromium/native-messaging-hosts
		newins "${manifests}"/dev.zeo.browser_host.chrome.json dev.zeo.browser_host.json
		insinto "/usr/$(get_libdir)/mozilla/native-messaging-hosts"
		newins "${manifests}"/dev.zeo.browser_host.firefox.json dev.zeo.browser_host.json
	fi
}

src_test () {
	# Patch 0019 moves APP_NAME to "Zeo", so the suite writes under zeo/ - these
	# are the directories the tests expect to exist, not zed/ ones.
	mkdir -p "${HOME}/.config/zeo" || die
	mkdir -p "${HOME}/.local/share/zeo/logs/" || die

	SHELL=/usr/bin/sh RUST_BACKTRACE=full cargo_src_test -vv \
		-- --skip zed::tests::test_window_edit_state_restoring_enabled
}

pkg_postinst() {
	xdg_pkg_postinst

	if use claude-agent-acp-plus; then
		elog ""
		elog "Claude Agent (Plus) is available in Zeo's agent panel by default and runs"
		elog "the adapter installed as /usr/bin/claude-agent-acp-plus. No settings.json"
		elog "entry is needed."
	fi

	if use claude-agent-acp-tui; then
		elog ""
		elog "Claude Agent TUI is available in Zeo's agent panel by default and runs"
		elog "the bridge installed as /usr/bin/claude-agent-acp-tui. No settings.json"
		elog "entry is needed."
	fi

	if use ai-jail; then
		elog ""
		elog "Zeo can start the Claude adapters inside ai-jail: writable project,"
		elog "read-only .git and .zed, network limited to the allowed hosts, and none"
		elog "of your ~/.claude visible. The jail keeps its own Claude state in a"
		elog "separate directory, so log in once, outside the sandbox:"
		elog ""
		elog "    install -d -m 700 ~/.claude-jailed"
		elog "    CLAUDE_CONFIG_DIR=~/.claude-jailed claude    # then: /login"
		elog ""
		elog "Then turn it on per project in Settings -> AI -> Agent Sandbox (ai-jail),"
		elog "or with the palette command 'agent sandbox: toggle'. The lock icon in the"
		elog "agent panel shows whether the thread you are looking at is jailed."
		elog "A hand-written \"ai-jail\" entry in agent_servers keeps working, shown as"
		elog "jailed by its own command."
	fi

	if use browser-extension; then
		elog ""
		elog "The browser sidebar (zeo-browser) talks to this Zeo through"
		elog "/usr/libexec/zeo-browser-host, installed with its Chrome, Chromium and"
		elog "Firefox host manifests. Firefox loads the add-on, installed by"
		elog "www-plugins/zeo-browser, from the system scope;"
		elog "on Chrome or Chromium build and load it yourself:"
		elog ""
		elog "    cd zeo-browser && npm ci && npm run build"
		elog "    chrome://extensions -> Developer mode -> Load unpacked -> dist/chrome"
		elog ""
		elog "The first connection asks in Zeo: Allow or Deny. Palette command"
		elog "'devtools bridge: revoke browser access' forgets every browser allowed."
	fi

	if use claude-code-ide; then
		elog ""
		elog "Claude Code IDE integration uses an unofficial, reverse-engineered"
		elog "protocol that may break without notice."
		elog "It activates automatically in Zeo-spawned terminals via environment"
		elog "variables; no settings.json configuration is needed."
		elog "The 'claude' CLI it talks to comes from dev-util/claude-code,"
		elog "which this USE flag pulls in."
		elog "Verify the connection by running /ide inside 'claude'."
	fi
}
