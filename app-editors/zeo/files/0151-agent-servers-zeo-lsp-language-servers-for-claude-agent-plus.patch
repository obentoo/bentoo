diff --git a/crates/agent_servers/src/acp/v1/zeo_lsp_tests.rs b/crates/agent_servers/src/acp/v1/zeo_lsp_tests.rs
new file mode 100644
index 0000000..19dcc7d
--- /dev/null
+++ b/crates/agent_servers/src/acp/v1/zeo_lsp_tests.rs
@@ -0,0 +1,312 @@
+//! Zeo next proposal §6.13: `zeo-lsp`, the project's language servers as an MCP server over
+//! MCP-over-ACP. The agent is the scripted one of `mcp_over_acp_tests`; the language server is
+//! a fake one, so each answer can be traced to the request it got. Filter: `zeo_lsp_tests`.
+
+use std::sync::Arc;
+
+use super::mcp_over_acp_harness::{ProxyAgent, result_of, with_binding_meta};
+use super::*;
+use futures::StreamExt as _;
+use serde_json::{Value, json};
+
+const FILE: &str = "/a/main.rs";
+const SOURCE: &str = "fn target() {}\nfn main() {\n    target();\n}\n";
+
+struct LspAgent {
+    agent: ProxyAgent,
+    server: lsp::FakeLanguageServer,
+    zeo_lsp: String,
+    _buffer: (
+        Entity<language::Buffer>,
+        project::lsp_store::OpenLspBufferHandle,
+    ),
+}
+
+fn uri() -> lsp::Uri {
+    lsp::Uri::from_file_path(FILE).expect("a file uri")
+}
+
+fn range(start: (u32, u32), end: (u32, u32)) -> lsp::Range {
+    lsp::Range::new(
+        lsp::Position::new(start.0, start.1),
+        lsp::Position::new(end.0, end.1),
+    )
+}
+
+impl LspAgent {
+    /// A Rust file with a fake language server already attached, as a buffer an editor had
+    /// open would have it, and a session that declared `zeo-lsp`.
+    async fn connect(cx: &mut gpui::TestAppContext) -> Self {
+        let agent = ProxyAgent::connect_with(
+            true,
+            json!({ "a": { "main.rs": SOURCE } }),
+            |settings| settings.agent.get_or_insert_default().zeo_lsp = Some(true),
+            cx,
+        )
+        .await;
+        let registry = agent
+            .project
+            .read_with(cx, |project, _| project.languages().clone());
+        registry.add(Arc::new(language::Language::new(
+            language::LanguageConfig {
+                name: "Rust".into(),
+                matcher: language::LanguageMatcher {
+                    path_suffixes: vec!["rs".into()],
+                    ..Default::default()
+                }
+                .into(),
+                ..Default::default()
+            },
+            None,
+        )));
+        let mut servers = registry.register_fake_lsp(
+            "Rust",
+            language::FakeLspAdapter {
+                capabilities: lsp::ServerCapabilities {
+                    definition_provider: Some(lsp::OneOf::Left(true)),
+                    references_provider: Some(lsp::OneOf::Left(true)),
+                    hover_provider: Some(lsp::HoverProviderCapability::Simple(true)),
+                    document_symbol_provider: Some(lsp::OneOf::Left(true)),
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        );
+        let buffer = agent
+            .project
+            .update(cx, |project, cx| {
+                project.open_local_buffer_with_lsp(FILE, cx)
+            })
+            .await
+            .expect("the file opens");
+        let server = servers.next().await.expect("the fake server starts");
+        cx.run_until_parked();
+
+        agent.new_session(cx).await;
+        let zeo_lsp = agent.declared_id_of("zeo-lsp");
+        Self {
+            agent,
+            server,
+            zeo_lsp,
+            _buffer: buffer,
+        }
+    }
+
+    /// `tools/call` of `tool`: its text and `isError`.
+    async fn call(&self, tool: &str, arguments: Value) -> (String, bool) {
+        let params = with_binding_meta(json!({ "name": tool, "arguments": arguments }));
+        let result = result_of(
+            self.agent
+                .mcp(&self.zeo_lsp, &format!("{tool}-1"), "tools/call", params)
+                .await
+                .expect("zeo-lsp answers"),
+        );
+        (
+            result["content"][0]["text"]
+                .as_str()
+                .expect("a text block")
+                .to_string(),
+            result["isError"].as_bool().expect("isError"),
+        )
+    }
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_is_declared_and_lists_its_tools(cx: &mut gpui::TestAppContext) {
+    let fixture = LspAgent::connect(cx).await;
+
+    let discovery = result_of(
+        fixture
+            .agent
+            .mcp(
+                &fixture.zeo_lsp,
+                "d-1",
+                "server/discover",
+                with_binding_meta(json!({})),
+            )
+            .await
+            .expect("discover"),
+    );
+    assert_eq!(discovery["serverInfo"]["name"], "zeo-lsp");
+    assert!(discovery["capabilities"]["tools"].is_object());
+
+    let list = result_of(
+        fixture
+            .agent
+            .mcp(
+                &fixture.zeo_lsp,
+                "l-1",
+                "tools/list",
+                with_binding_meta(json!({})),
+            )
+            .await
+            .expect("tools/list"),
+    );
+    let names: Vec<&str> = list["tools"]
+        .as_array()
+        .expect("tools")
+        .iter()
+        .filter_map(|tool| tool["name"].as_str())
+        .collect();
+    assert_eq!(
+        names,
+        [
+            "diagnostics",
+            "definition",
+            "references",
+            "hover",
+            "document_symbols"
+        ]
+    );
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_is_not_declared_when_off(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    let servers = agent.new_session(cx).await;
+
+    assert!(
+        !format!("{servers:?}").contains("zeo-lsp"),
+        "agent.zeo_lsp: false declares nothing more: {servers:?}"
+    );
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_definition_asks_at_the_named_symbol(cx: &mut gpui::TestAppContext) {
+    let fixture = LspAgent::connect(cx).await;
+    fixture
+        .server
+        .set_request_handler::<lsp::request::GotoDefinition, _, _>(|params, _| async move {
+            assert_eq!(
+                params.text_document_position_params.position,
+                lsp::Position::new(2, 4),
+                "line 3, at `target`"
+            );
+            Ok(Some(lsp::GotoDefinitionResponse::Scalar(
+                lsp::Location::new(uri(), range((0, 3), (0, 9))),
+            )))
+        });
+
+    let (text, is_error) = fixture
+        .call(
+            "definition",
+            json!({ "path": FILE, "line": 3, "symbol": "target" }),
+        )
+        .await;
+
+    assert!(!is_error, "{text}");
+    assert!(text.ends_with("main.rs:1: fn target() {}"), "{text}");
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_references_hover_and_symbols(cx: &mut gpui::TestAppContext) {
+    let fixture = LspAgent::connect(cx).await;
+    fixture
+        .server
+        .set_request_handler::<lsp::request::References, _, _>(|_, _| async move {
+            Ok(Some(vec![
+                lsp::Location::new(uri(), range((0, 3), (0, 9))),
+                lsp::Location::new(uri(), range((2, 4), (2, 10))),
+            ]))
+        });
+    fixture
+        .server
+        .set_request_handler::<lsp::request::HoverRequest, _, _>(|_, _| async move {
+            Ok(Some(lsp::Hover {
+                contents: lsp::HoverContents::Scalar(lsp::MarkedString::String(
+                    "fn target()".into(),
+                )),
+                range: None,
+            }))
+        });
+    fixture
+        .server
+        .set_request_handler::<lsp::request::DocumentSymbolRequest, _, _>(|_, _| async move {
+            #[allow(deprecated)]
+            let main = lsp::DocumentSymbol {
+                name: "main".into(),
+                detail: None,
+                kind: lsp::SymbolKind::FUNCTION,
+                tags: None,
+                deprecated: None,
+                range: range((1, 0), (3, 1)),
+                selection_range: range((1, 3), (1, 7)),
+                children: None,
+            };
+            Ok(Some(lsp::DocumentSymbolResponse::Nested(vec![main])))
+        });
+
+    let (references, _) = fixture
+        .call(
+            "references",
+            json!({ "path": FILE, "line": 1, "symbol": "target" }),
+        )
+        .await;
+    assert!(references.starts_with("2 references:"), "{references}");
+    assert!(references.contains("main.rs:3: target();"), "{references}");
+
+    let (hover, _) = fixture
+        .call("hover", json!({ "path": FILE, "line": 3, "column": 5 }))
+        .await;
+    assert_eq!(hover, "fn target()");
+
+    let (symbols, _) = fixture
+        .call("document_symbols", json!({ "path": FILE }))
+        .await;
+    assert_eq!(symbols, "function main L2-4");
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_diagnostics_per_file_and_for_the_project(cx: &mut gpui::TestAppContext) {
+    let fixture = LspAgent::connect(cx).await;
+    fixture
+        .server
+        .notify::<lsp::notification::PublishDiagnostics>(lsp::PublishDiagnosticsParams {
+            uri: uri(),
+            version: None,
+            diagnostics: vec![lsp::Diagnostic {
+                range: range((2, 4), (2, 10)),
+                severity: Some(lsp::DiagnosticSeverity::ERROR),
+                message: "boom".into(),
+                ..Default::default()
+            }],
+        });
+    cx.run_until_parked();
+
+    let (file, _) = fixture.call("diagnostics", json!({ "path": FILE })).await;
+    assert_eq!(file, "error 3:5: boom");
+    let (project, _) = fixture.call("diagnostics", json!({})).await;
+    assert!(
+        project.ends_with("main.rs: 1 error(s), 0 warning(s)"),
+        "{project}"
+    );
+}
+
+#[gpui::test]
+async fn zeo_lsp_tests_a_failed_lookup_is_the_tools_answer(cx: &mut gpui::TestAppContext) {
+    let fixture = LspAgent::connect(cx).await;
+
+    let (text, is_error) = fixture
+        .call(
+            "definition",
+            json!({ "path": FILE, "line": 1, "symbol": "absent" }),
+        )
+        .await;
+    assert!(is_error, "the model reads why: {text}");
+    assert!(text.contains("\"absent\" is not on line 1"), "{text}");
+
+    let response = fixture
+        .agent
+        .mcp(
+            &fixture.zeo_lsp,
+            "x-1",
+            "tools/call",
+            with_binding_meta(json!({ "name": "rename", "arguments": {} })),
+        )
+        .await
+        .expect("an inner error is a successful ACP response");
+    assert!(
+        matches!(response, acp::MessageMcpResponse::Error { ref error, .. } if error.code == -32602),
+        "read-only: there is no rename tool: {response:?}"
+    );
+}
diff --git a/crates/agent_servers/src/acp/zeo_lsp.rs b/crates/agent_servers/src/acp/zeo_lsp.rs
new file mode 100644
index 0000000..20b7421
--- /dev/null
+++ b/crates/agent_servers/src/acp/zeo_lsp.rs
@@ -0,0 +1,153 @@
+//! `zeo-lsp`: Zeo's language servers as one more MCP server for Claude Agent (Plus), carried
+//! over MCP-over-ACP like the proxied ones (next proposal §6.13, spike
+//! `docs/SPIKE-6.13-LSP-OVER-MCP.md`).
+//!
+//! Claude Code reads code through grep and file reads; the language servers Zeo already runs
+//! for the project know where a symbol is defined, who uses it and what it is. `0002`'s IDE
+//! server was not the vehicle: the CLI keeps only `getDiagnostics` and `executeCode` from it,
+//! and only for buffers that are open. This server answers from the project itself, opening a
+//! file with its language servers when asked about it. Read-only: no edit, rename or code
+//! action is offered.
+//!
+//! The first cut is the spike's: `diagnostics`, `definition`, `references`, `hover` and
+//! `document_symbols`, lines 1-based, a symbol found on its line by name when no column is
+//! given. It is declared only to an agent that advertised `mcpCapabilities.acp`, under
+//! `agent.zeo_lsp` (default on, the operator's 2026-11-21 decision), and a jail reaches it only
+//! through the same opt-in list as any proxied server.
+
+use agent_client_protocol::v1::schema as acp;
+use gpui::{App, AsyncApp, Entity};
+use project::Project;
+use serde_json::{Map, Value, json};
+use settings::SettingsStore;
+
+#[path = "zeo_lsp_tools.rs"]
+mod tools;
+
+/// The server's name, as the agent sees it (`mcp__zeo-lsp__<tool>` in Claude Code).
+pub(crate) const ZEO_LSP_SERVER_NAME: &str = "zeo-lsp";
+/// MCP's "method not found" and "invalid params", for the inner error carrier.
+const METHOD_NOT_FOUND: i32 = -32601;
+const INVALID_PARAMS: i32 = -32602;
+
+const INSTRUCTIONS: &str = "Zeo's language servers for this project. Lines are 1-based. Name \
+the symbol on its line (`symbol`), or give a 1-based `column`. Paths are relative to the \
+project, or absolute. A file is opened with its language servers when asked about, so the \
+first answer for a file nobody had open can be empty until its server has indexed it.";
+
+/// `agent.zeo_lsp`, default on. A test app may run without a settings store.
+pub(crate) fn enabled(cx: &App) -> bool {
+    cx.try_global::<SettingsStore>()
+        .and_then(|store| store.merged_settings().agent.as_ref()?.zeo_lsp)
+        .unwrap_or(true)
+}
+
+/// One `mcp/message` for `zeo-lsp`, in `project`.
+pub(super) async fn serve(
+    project: Entity<Project>,
+    method: &str,
+    params: Option<Map<String, Value>>,
+    cx: &mut AsyncApp,
+) -> acp::MessageMcpResponse {
+    match method {
+        "server/discover" => acp::MessageMcpResponse::success(discovery()),
+        "ping" => acp::MessageMcpResponse::success(json!({})),
+        "tools/list" => acp::MessageMcpResponse::success(json!({ "tools": tool_list() })),
+        "tools/call" => {
+            let params = params.unwrap_or_default();
+            let Some(name) = params.get("name").and_then(Value::as_str) else {
+                return inner_error(INVALID_PARAMS, "tools/call needs a tool name");
+            };
+            let arguments = params
+                .get("arguments")
+                .and_then(Value::as_object)
+                .cloned()
+                .unwrap_or_default();
+            match tools::call(&project, name, &arguments, cx).await {
+                Some(Ok(text)) => acp::MessageMcpResponse::success(tool_result(text, false)),
+                // A failed lookup is the tool's answer, not a protocol error: the model reads it.
+                Some(Err(text)) => acp::MessageMcpResponse::success(tool_result(text, true)),
+                None => inner_error(INVALID_PARAMS, &format!("zeo-lsp has no tool {name:?}")),
+            }
+        }
+        other => inner_error(METHOD_NOT_FOUND, &format!("zeo-lsp does not serve {other}")),
+    }
+}
+
+fn discovery() -> Value {
+    json!({
+        "supportedVersions": ["2026-07-28"],
+        "capabilities": { "tools": {} },
+        "serverInfo": {
+            "name": ZEO_LSP_SERVER_NAME,
+            "title": "Zeo language servers",
+            "version": env!("CARGO_PKG_VERSION"),
+        },
+        "instructions": INSTRUCTIONS,
+    })
+}
+
+fn tool_result(text: String, is_error: bool) -> Value {
+    json!({ "content": [{ "type": "text", "text": text }], "isError": is_error })
+}
+
+fn inner_error(code: i32, message: &str) -> acp::MessageMcpResponse {
+    acp::MessageMcpResponse::error(acp::McpError::new(code, message))
+}
+
+fn position_schema(description: &str) -> Value {
+    json!({
+        "type": "object",
+        "description": description,
+        "properties": {
+            "path": { "type": "string", "description": "The file, relative to the project or absolute." },
+            "line": { "type": "integer", "minimum": 1, "description": "The 1-based line the symbol is on." },
+            "symbol": { "type": "string", "description": "The symbol's name as written on that line; its first occurrence is used." },
+            "column": { "type": "integer", "minimum": 1, "description": "The 1-based column, instead of `symbol`." },
+        },
+        "required": ["path", "line"],
+    })
+}
+
+fn tool_list() -> Value {
+    let read_only = json!({ "readOnlyHint": true, "openWorldHint": false });
+    json!([
+        {
+            "name": "diagnostics",
+            "description": "Errors and warnings the language servers report: for one file with `path`, otherwise a count per file for the whole project.",
+            "inputSchema": {
+                "type": "object",
+                "properties": { "path": { "type": "string", "description": "A file, relative to the project or absolute." } },
+            },
+            "annotations": read_only,
+        },
+        {
+            "name": "definition",
+            "description": "Where the symbol at a position is defined: path, lines and the defining line.",
+            "inputSchema": position_schema("The position of a use of the symbol."),
+            "annotations": read_only,
+        },
+        {
+            "name": "references",
+            "description": "Every place the symbol at a position is used, as path and line.",
+            "inputSchema": position_schema("The position of the symbol."),
+            "annotations": read_only,
+        },
+        {
+            "name": "hover",
+            "description": "What the language server says about the symbol at a position: its type, signature and documentation.",
+            "inputSchema": position_schema("The position of the symbol."),
+            "annotations": read_only,
+        },
+        {
+            "name": "document_symbols",
+            "description": "The outline of a file: its symbols, their kind and lines, nested.",
+            "inputSchema": {
+                "type": "object",
+                "properties": { "path": { "type": "string", "description": "The file, relative to the project or absolute." } },
+                "required": ["path"],
+            },
+            "annotations": read_only,
+        },
+    ])
+}
diff --git a/crates/agent_servers/src/acp/zeo_lsp_tools.rs b/crates/agent_servers/src/acp/zeo_lsp_tools.rs
new file mode 100644
index 0000000..8c570a8
--- /dev/null
+++ b/crates/agent_servers/src/acp/zeo_lsp_tools.rs
@@ -0,0 +1,309 @@
+//! The five `zeo-lsp` tools (see `zeo_lsp.rs`), answered from the project's language servers.
+//! Each returns the text the model reads, or the reason it could not answer.
+
+use std::fmt::Write as _;
+
+use gpui::{App, AsyncApp, Entity};
+use language::{Buffer, DiagnosticSeverity, Location, Point, ToPoint as _};
+use project::lsp_store::OpenLspBufferHandle;
+use project::{DocumentSymbol, Project};
+use serde_json::{Map, Value};
+
+/// A line quoted back is cut here, as the native agent's tools cut theirs.
+const MAX_QUOTED_LINE: usize = 200;
+
+type Args = Map<String, Value>;
+
+/// `None` for a tool `zeo-lsp` does not have.
+pub(super) async fn call(
+    project: &Entity<Project>,
+    name: &str,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Option<Result<String, String>> {
+    Some(match name {
+        "diagnostics" => diagnostics(project, args, cx).await,
+        "definition" => definition(project, args, cx).await,
+        "references" => references(project, args, cx).await,
+        "hover" => hover(project, args, cx).await,
+        "document_symbols" => document_symbols(project, args, cx).await,
+        _ => return None,
+    })
+}
+
+/// A file opened with its language servers; they stay attached while this lives.
+struct Opened {
+    buffer: Entity<Buffer>,
+    _lsp: OpenLspBufferHandle,
+}
+
+fn path_arg(args: &Args) -> Result<&str, String> {
+    args.get("path")
+        .and_then(Value::as_str)
+        .filter(|path| !path.is_empty())
+        .ok_or_else(|| "`path` is required".to_string())
+}
+
+async fn open(project: &Entity<Project>, path: &str, cx: &mut AsyncApp) -> Result<Opened, String> {
+    let task = project.update(cx, |project, cx| {
+        let project_path = project
+            .find_project_path(path, cx)
+            .ok_or_else(|| format!("No file {path:?} in the project"))?;
+        // `Project::open_buffer_with_lsp` is test-support only, so a release build has no such
+        // method: this is its body, open then register.
+        Ok::<_, String>(project.open_buffer(project_path, cx))
+    })?;
+    let buffer = task
+        .await
+        .map_err(|error| format!("Could not open {path:?}: {error:#}"))?;
+    let lsp = project.update(cx, |project, cx| {
+        project.register_buffer_with_language_servers(&buffer, cx)
+    });
+    Ok(Opened { buffer, _lsp: lsp })
+}
+
+/// The point the arguments name: `line` (1-based), then `column` (1-based characters) or
+/// the first occurrence of `symbol` on that line, else the line's first non-blank character.
+fn position(buffer: &Entity<Buffer>, args: &Args, cx: &AsyncApp) -> Result<Point, String> {
+    let line = args
+        .get("line")
+        .and_then(Value::as_u64)
+        .filter(|line| *line >= 1)
+        .ok_or_else(|| "`line` must be a 1-based line number".to_string())?;
+    buffer.read_with(cx, |buffer, _| {
+        let snapshot = buffer.snapshot();
+        let last_row = snapshot.max_point().row;
+        let row = u32::try_from(line - 1).unwrap_or(u32::MAX);
+        if row > last_row {
+            return Err(format!(
+                "Line {line} is past the end of the file ({} lines)",
+                last_row + 1
+            ));
+        }
+        let text: String = snapshot
+            .text_for_range(Point::new(row, 0)..Point::new(row, snapshot.line_len(row)))
+            .collect();
+        let byte = if let Some(column) = args.get("column").and_then(Value::as_u64) {
+            let index = usize::try_from(column.saturating_sub(1)).unwrap_or(usize::MAX);
+            text.char_indices()
+                .nth(index)
+                .map_or(text.len(), |(byte, _)| byte)
+        } else if let Some(symbol) = args.get("symbol").and_then(Value::as_str) {
+            text.find(symbol).ok_or_else(|| {
+                format!("{symbol:?} is not on line {line}: {}", quoted(text.trim()))
+            })?
+        } else {
+            text.len() - text.trim_start().len()
+        };
+        Ok(Point::new(row, u32::try_from(byte).unwrap_or(u32::MAX)))
+    })
+}
+
+fn quoted(text: &str) -> String {
+    match text.char_indices().nth(MAX_QUOTED_LINE) {
+        Some((cut, _)) => format!("{}…", &text[..cut]),
+        None => text.to_string(),
+    }
+}
+
+/// `path:line: the line`, or `path:start-end: …` for a range over several lines.
+fn describe(location: &Location, cx: &App) -> String {
+    let buffer = location.buffer.read(cx);
+    let snapshot = buffer.snapshot();
+    let start = location.range.start.to_point(&snapshot);
+    let end = location.range.end.to_point(&snapshot);
+    let path = buffer
+        .file()
+        .map(|file| file.full_path(cx).display().to_string())
+        .unwrap_or_else(|| "<untitled>".to_string());
+    let lines = if start.row == end.row {
+        (start.row + 1).to_string()
+    } else {
+        format!("{}-{}", start.row + 1, end.row + 1)
+    };
+    let text: String = snapshot
+        .text_for_range(
+            Point::new(start.row, 0)..Point::new(start.row, snapshot.line_len(start.row)),
+        )
+        .collect();
+    format!("{path}:{lines}: {}", quoted(text.trim()))
+}
+
+async fn definition(
+    project: &Entity<Project>,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Result<String, String> {
+    let opened = open(project, path_arg(args)?, cx).await?;
+    let point = position(&opened.buffer, args, cx)?;
+    let links = project
+        .update(cx, |project, cx| {
+            project.definitions(&opened.buffer, point, cx)
+        })
+        .await
+        .map_err(|error| format!("The language server failed: {error:#}"))?
+        .unwrap_or_default();
+    if links.is_empty() {
+        return Ok("No definition found.".to_string());
+    }
+    Ok(cx.update(|cx| {
+        links
+            .iter()
+            .map(|link| describe(&link.target, cx))
+            .collect::<Vec<_>>()
+            .join("\n")
+    }))
+}
+
+async fn references(
+    project: &Entity<Project>,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Result<String, String> {
+    let opened = open(project, path_arg(args)?, cx).await?;
+    let point = position(&opened.buffer, args, cx)?;
+    let locations = project
+        .update(cx, |project, cx| {
+            project.references(&opened.buffer, point, cx)
+        })
+        .await
+        .map_err(|error| format!("The language server failed: {error:#}"))?
+        .unwrap_or_default();
+    if locations.is_empty() {
+        return Ok("No references found.".to_string());
+    }
+    Ok(cx.update(|cx| {
+        let mut out = format!("{} references:\n", locations.len());
+        for location in &locations {
+            writeln!(out, "{}", describe(location, cx)).ok();
+        }
+        out.trim_end().to_string()
+    }))
+}
+
+async fn hover(
+    project: &Entity<Project>,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Result<String, String> {
+    let opened = open(project, path_arg(args)?, cx).await?;
+    let point = position(&opened.buffer, args, cx)?;
+    let hovers = project
+        .update(cx, |project, cx| project.hover(&opened.buffer, point, cx))
+        .await
+        .unwrap_or_default();
+    let text = hovers
+        .iter()
+        .flat_map(|hover| hover.contents.iter())
+        .map(|block| block.text.trim())
+        .filter(|text| !text.is_empty())
+        .collect::<Vec<_>>()
+        .join("\n\n");
+    if text.is_empty() {
+        Ok("The language server has nothing to say about this position.".to_string())
+    } else {
+        Ok(text)
+    }
+}
+
+async fn document_symbols(
+    project: &Entity<Project>,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Result<String, String> {
+    let opened = open(project, path_arg(args)?, cx).await?;
+    let symbols = project
+        .update(cx, |project, cx| {
+            project.document_symbols(&opened.buffer, cx)
+        })
+        .await
+        .map_err(|error| format!("The language server failed: {error:#}"))?;
+    if symbols.is_empty() {
+        return Ok("No symbols.".to_string());
+    }
+    let mut out = String::new();
+    outline(&symbols, 0, &mut out);
+    Ok(out.trim_end().to_string())
+}
+
+fn outline(symbols: &[DocumentSymbol], depth: usize, out: &mut String) {
+    for symbol in symbols {
+        let start = symbol.range.start.0.row + 1;
+        let end = symbol.range.end.0.row + 1;
+        let kind = format!("{:?}", symbol.kind).to_lowercase();
+        writeln!(
+            out,
+            "{}{kind} {} L{start}-{end}",
+            "  ".repeat(depth),
+            symbol.name
+        )
+        .ok();
+        outline(&symbol.children, depth + 1, out);
+    }
+}
+
+async fn diagnostics(
+    project: &Entity<Project>,
+    args: &Args,
+    cx: &mut AsyncApp,
+) -> Result<String, String> {
+    let Ok(path) = path_arg(args) else {
+        return Ok(project_diagnostics(project, cx));
+    };
+    let opened = open(project, path, cx).await?;
+    let text = opened.buffer.read_with(cx, |buffer, _| {
+        let snapshot = buffer.snapshot();
+        let mut out = String::new();
+        for (_, group) in snapshot.diagnostic_groups(None) {
+            let entry = &group.entries[group.primary_ix];
+            let severity = match entry.diagnostic.severity {
+                DiagnosticSeverity::ERROR => "error",
+                DiagnosticSeverity::WARNING => "warning",
+                DiagnosticSeverity::INFORMATION => "info",
+                _ => "hint",
+            };
+            let start = entry.range.start.to_point(&snapshot);
+            writeln!(
+                out,
+                "{severity} {}:{}: {}",
+                start.row + 1,
+                start.column + 1,
+                entry.diagnostic.message
+            )
+            .ok();
+        }
+        out
+    });
+    if text.is_empty() {
+        Ok(format!("No diagnostics for {path}."))
+    } else {
+        Ok(text.trim_end().to_string())
+    }
+}
+
+fn project_diagnostics(project: &Entity<Project>, cx: &AsyncApp) -> String {
+    project.read_with(cx, |project, cx| {
+        let mut out = String::new();
+        for (project_path, _, summary) in project.diagnostic_summaries(true, cx) {
+            if summary.error_count == 0 && summary.warning_count == 0 {
+                continue;
+            }
+            let Some(worktree) = project.worktree_for_id(project_path.worktree_id, cx) else {
+                continue;
+            };
+            writeln!(
+                out,
+                "{}: {} error(s), {} warning(s)",
+                worktree.read(cx).absolutize(&project_path.path).display(),
+                summary.error_count,
+                summary.warning_count
+            )
+            .ok();
+        }
+        if out.is_empty() {
+            "No errors or warnings in the project.".to_string()
+        } else {
+            out.trim_end().to_string()
+        }
+    })
+}
