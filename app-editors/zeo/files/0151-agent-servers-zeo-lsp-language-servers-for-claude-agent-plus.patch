                 acp::McpServer::Acp(acp::McpServerAcp::new(name, server_id))
@@ -131,6 +139,43 @@ impl McpOverAcp {
             .collect()
     }
 
+    /// `servers` and `zeo-lsp` after them, when it is on, the policy lets the connection reach
+    /// it and no context server already has the name.
+    pub(crate) fn declare_zeo_lsp(
+        &self,
+        project: &Entity<Project>,
+        mut servers: Vec<acp::McpServer>,
+        policy: &McpProxyPolicy,
+        cx: &App,
+    ) -> Vec<acp::McpServer> {
+        let name = super::zeo_lsp::ZEO_LSP_SERVER_NAME;
+        let taken = servers.iter().any(|server| match server {
+            acp::McpServer::Stdio(stdio) => stdio.name == name,
+            acp::McpServer::Http(http) => http.name == name,
+            acp::McpServer::Acp(acp) => acp.name == name,
+            _ => false,
+        });
+        // A remote project's language servers run on the remote host: not proven, as above.
+        if taken
+            || !project.read(cx).is_local()
+            || !policy.allows(name)
+            || !super::zeo_lsp::enabled(cx)
+        {
+            return servers;
+        }
+        let server_id = server_id_for(project, name);
+        self.routes.borrow_mut().insert(
+            server_id.clone(),
+            Route {
+                name: name.to_string(),
+                project: project.downgrade(),
+                backend: Backend::ZeoLsp,
+            },
+        );
+        servers.push(acp::McpServer::Acp(acp::McpServerAcp::new(name, server_id)));
+        servers
+    }
+
     fn route(&self, server_id: &str) -> Option<Route> {
         self.routes.borrow().get(server_id).cloned()
     }
