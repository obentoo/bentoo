+
+/// The status a thread's sidebar row shows. The order is the point: a permission prompt
+/// outranks a question (0030), both outrank an error, and background work (0029) marks
+/// only a thread that is otherwise idle -- it never hides a prompt, a question or an error.
+fn thread_row_status(
+    pending_tool_call: bool,
+    pending_elicitation: bool,
+    had_error: bool,
+    status: ThreadStatus,
+    background_task_count: usize,
+) -> AgentThreadStatus {
+    if pending_tool_call {
+        AgentThreadStatus::WaitingForConfirmation
+    } else if pending_elicitation {
+        AgentThreadStatus::WaitingForAnswer
+    } else if had_error {
+        AgentThreadStatus::Error
+    } else {
+        match status {
+            ThreadStatus::Generating => AgentThreadStatus::Running,
+            ThreadStatus::Idle if background_task_count > 0 => AgentThreadStatus::Background,
+            ThreadStatus::Idle => AgentThreadStatus::Completed,
+        }
+    }
+}
