+// 0029/0030: the row's status, as a truth table over what can be pending at once. A
+// permission prompt outranks a question, both outrank an error, and background work only
+// ever marks an otherwise idle thread.
+#[test]
+fn test_thread_row_status_precedence() {
+    use acp_thread::ThreadStatus::{Generating, Idle};
+    use super::thread_row_status as status;
+
+    // (tool call, question, error, thread status, background tasks) -> row
+    let cases = [
+        ((true, true, true, Idle, 3), AgentThreadStatus::WaitingForConfirmation),
+        ((true, false, false, Generating, 0), AgentThreadStatus::WaitingForConfirmation),
+        ((false, true, true, Idle, 3), AgentThreadStatus::WaitingForAnswer),
+        ((false, true, false, Generating, 0), AgentThreadStatus::WaitingForAnswer),
+        ((false, false, true, Idle, 3), AgentThreadStatus::Error),
+        ((false, false, false, Generating, 3), AgentThreadStatus::Running),
+        ((false, false, false, Idle, 1), AgentThreadStatus::Background),
+        ((false, false, false, Idle, 0), AgentThreadStatus::Completed),
+    ];
+    for ((tool_call, question, error, thread, background), expected) in cases {
+        let case = format!(
+            "tool call {tool_call}, question {question}, error {error}, {thread:?}, {background} background"
+        );
+        assert_eq!(
+            status(tool_call, question, error, thread, background),
+            expected,
+            "{case}"
+        );
+    }
+}
