+    // Zeo: patches 0029 and 0034 read the Claude adapter's task `_meta` only on the v1 arm,
+    // so a v2 agent's session info update reached neither the background count nor the
+    // task list.
+    #[gpui::test]
+    async fn v2_session_info_carries_the_claude_task_meta(cx: &mut gpui::TestAppContext) {
+        use serde_json::json;
+
+        let harness = V2SessionHarness::new(cx).await;
+        harness.send(
+            json!({
+                "sessionUpdate": "session_info_update",
+                "_meta": {
+                    "_claude/backgroundTasks": { "count": 2 },
+                    "_claude/tasks": { "tasks": [{
+                        "id": "t1",
+                        "type": "shell",
+                        "description": "sleep 60",
+                        "background": true,
+                        "depth": 0,
+                        "status": "running",
+                        "startedAt": 1
+                    }] }
+                }
+            }),
+            None,
+        );
+        harness.drain(cx).await;
+
+        harness.thread.read_with(cx, |thread, _| {
+            assert_eq!(thread.background_task_count(), 2, "0029's count");
+            assert_eq!(thread.tasks().len(), 1, "0034's task list");
+        });
+    }
+
     #[gpui::test]
     async fn v2_session_info_sdk_updates_thread_and_list_projection(cx: &mut gpui::TestAppContext) {
         use acp_thread::{AcpThreadEvent, AgentSessionInfo, SessionListUpdate};
