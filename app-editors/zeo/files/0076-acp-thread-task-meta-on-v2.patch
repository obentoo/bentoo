+    /// The Claude adapter's task `_meta` on a session info update — the background count of
+    /// patch 0029 and the `_claude/tasks` snapshot of 0034 — read for either protocol
+    /// version. Only the v1 arm used to read it, so a v2 agent's update bypassed both.
+    pub fn apply_claude_task_meta(
+        &mut self,
+        meta: Option<&serde_json::Map<String, serde_json::Value>>,
+        cx: &mut Context<Self>,
+    ) {
+        // Absent for every agent but the Claude adapter, and absent from its own
+        // title-only updates too, so a missing key leaves the count alone rather
+        // than resetting it.
+        let background_task_count = meta
+            .and_then(|meta| meta.get(CLAUDE_BACKGROUND_TASKS_META_KEY))
+            .and_then(|payload| payload.get("count"))
+            .and_then(|count| count.as_u64());
+        if let Some(count) = background_task_count
+            && let Ok(count) = usize::try_from(count)
+            && count != self.background_task_count
+        {
+            self.background_task_count = count;
+            cx.emit(AcpThreadEvent::BackgroundTasksUpdated);
+        }
+        // Absent from the adapter's title-only and count-only updates: a missing
+        // key is "no change", never "no tasks", or the list would blank.
+        if let Some(payload) = meta.and_then(|meta| meta.get(CLAUDE_TASKS_META_KEY)) {
+            match serde_json::from_value::<WireTasksSnapshot>(payload.clone()) {
+                Ok(snapshot) => self.apply_tasks_snapshot(snapshot, cx),
+                // Category and position only: serde's message quotes the
+                // offending value, which for `tail` is the shell's output.
+                Err(err) => log::warn!(
+                    "malformed _claude/tasks for session {}: {:?} error at line {} column {}",
+                    self.session_id(),
+                    err.classify(),
+                    err.line(),
+                    err.column()
+                ),
+            }
+        }
+    }
+
     pub fn update_session_info(
         &mut self,
         update: impl Into<AgentSessionInfoUpdate>,
