+//! `/btw` beside Steer on a queued message (Zeo next proposal §6.45, ask 69).
+//!
+//! `0115` answers a composer message that starts with `/btw` at once, in a card; `0116` gave each
+//! queued message a Steer. A message already queued behind a running turn had no way to become a
+//! side question short of retyping it. This adds that third way to send it: the message leaves
+//! the queue and is asked on the side, answered in `0115`'s card and kept out of the
+//! conversation.
+//!
+//! A side question is text only, so a queued message that carries a mention or an image keeps
+//! the button disabled, with the reason in its tooltip.
+
+use acp_thread::SIDE_QUESTION_MAX_CHARS;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Context, IntoElement};
+use ui::{Button, ButtonCommon, Clickable, Disableable, LabelSize, Tooltip, prelude::*};
+
+use super::ThreadView;
+use super::side_question_card::{SideQuestionInvocation, side_question_invocation};
+use crate::conversation_view::QueueEntryId;
+
+const BTW_TOOLTIP: &str = "Ask this on the side instead: the agent answers it in a card while it \
+     works, and neither the question nor the answer joins the conversation.";
+const BTW_TEXT_ONLY: &str =
+    "A side question is text only; this message carries a mention or an image.";
+
+/// The text a side question can carry for a queued message: its text blocks, trimmed. `None`
+/// when it holds anything but text, or no text at all.
+pub(crate) fn queued_side_question_text(content: &[acp_v2::ContentBlock]) -> Option<String> {
+    let mut text = String::new();
+    for block in content {
+        let acp_v2::ContentBlock::Text(block) = block else {
+            return None;
+        };
+        text.push_str(&block.text);
+    }
+    let text = text.trim();
+    (!text.is_empty()).then(|| text.to_string())
+}
+
+/// What asking `text` on the side sends: a message already written as `/btw …` is read as
+/// `0115` reads it, and any other text is the question itself.
+pub(crate) fn queued_side_question(text: &str) -> SideQuestionInvocation {
+    if let Some(invocation) = side_question_invocation(text) {
+        return invocation;
+    }
+    let chars = text.chars().count();
+    if chars > SIDE_QUESTION_MAX_CHARS {
+        SideQuestionInvocation::TooLong(chars)
+    } else {
+        SideQuestionInvocation::Ask(text.to_string())
+    }
+}
+
+impl ThreadView {
+    /// Whether the queue offers BTW: the agent answers side questions.
+    pub(super) fn queue_offers_side_question(&self, cx: &Context<Self>) -> bool {
+        self.thread.read(cx).connection().supports_side_question()
+    }
+
+    /// Takes queued message `id` out of the queue and asks it on the side. Returns `false`,
+    /// touching nothing, when the agent takes no side questions or the message is not text.
+    pub(super) fn ask_queued_entry_aside(
+        &mut self,
+        id: QueueEntryId,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        if !self.queue_offers_side_question(cx) {
+            return false;
+        }
+        let Some(text) = self
+            .message_queue
+            .entry_by_id(id)
+            .and_then(|entry| queued_side_question_text(&entry.content))
+        else {
+            return false;
+        };
+        // Out of the queue first, so the queue never also sends it as a prompt.
+        if self.message_queue.remove(id).is_none() {
+            return false;
+        }
+        log::info!("side question from queue: chars={}", text.chars().count());
+        self.show_side_question(queued_side_question(&text), cx);
+        true
+    }
+
+    pub(super) fn render_queue_btw_button(
+        &self,
+        entry_id: QueueEntryId,
+        index: usize,
+        cx: &Context<Self>,
+    ) -> impl IntoElement {
+        let text_only = self
+            .message_queue
+            .entry_by_id(entry_id)
+            .is_some_and(|entry| queued_side_question_text(&entry.content).is_some());
+        let meta = if text_only {
+            BTW_TOOLTIP
+        } else {
+            BTW_TEXT_ONLY
+        };
+        div()
+            .debug_selector(move || format!("queue-btw-{index}"))
+            .child(
+                Button::new(("btw", index), "BTW")
+                    .label_size(LabelSize::Small)
+                    .disabled(!text_only)
+                    .tooltip(move |_window, cx| {
+                        Tooltip::with_meta("Ask on the Side (/btw)", None, meta, cx)
+                    })
+                    .on_click(cx.listener(move |this, _, _, cx| {
+                        this.ask_queued_entry_aside(entry_id, cx);
+                    })),
+            )
+    }
+}
+
+#[cfg(test)]
+#[path = "queue_side_question_tests.rs"]
+mod tests;
