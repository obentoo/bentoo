@@ -0,0 +1,39 @@
+// Zeo next proposal §6.45 (ask 69): BTW beside Steer on a queued message.
+// Filter: `queue_side_question`.
+use super::*;
+
+fn text(text: &str) -> acp_v2::ContentBlock {
+    acp_v2::ContentBlock::Text(acp_v2::TextContent::new(text))
+}
+
+#[test]
+fn only_a_text_message_can_be_asked_on_the_side() {
+    assert_eq!(
+        queued_side_question_text(&[text("  why is "), text("this slow?  ")]),
+        Some("why is this slow?".to_string())
+    );
+    assert_eq!(queued_side_question_text(&[text("   ")]), None);
+    assert_eq!(queued_side_question_text(&[]), None);
+    let link = acp_v2::ContentBlock::ResourceLink(acp_v2::ResourceLink::new(
+        "main.rs",
+        "file:///w/main.rs",
+    ));
+    assert_eq!(queued_side_question_text(&[text("see"), link]), None);
+}
+
+#[test]
+fn a_queued_btw_is_read_as_the_composer_reads_it() {
+    assert_eq!(
+        queued_side_question("/btw what changed?"),
+        SideQuestionInvocation::Ask("what changed?".into())
+    );
+    assert_eq!(
+        queued_side_question("what changed?"),
+        SideQuestionInvocation::Ask("what changed?".into())
+    );
+    let long = "x".repeat(SIDE_QUESTION_MAX_CHARS + 1);
+    assert_eq!(
+        queued_side_question(&long),
+        SideQuestionInvocation::TooLong(SIDE_QUESTION_MAX_CHARS + 1)
+    );
+}
