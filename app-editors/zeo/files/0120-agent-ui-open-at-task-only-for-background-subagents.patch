 /// One `_claude/tasks` wire task, in the adapter's camelCase shape (story 012).
+/// A background subagent with output: the one kind of row that offers "Open Thread at This
+/// Task" (Zeo next §6.47).
+pub(crate) fn wire_background_subagent(
+    id: &str,
+    status: &str,
+    started_at_ms: u64,
+) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, started_at_ms);
+    task["type"] = json!("subagent");
+    task["hasOutput"] = json!(true);
+    task
+}
+
 pub(crate) fn wire_task(
     id: &str,
     status: &str,
