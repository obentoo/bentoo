 /// Whether "Send to Background" applies to `task`: a running foreground task with a tool
 /// call to address. The Agent Tasks panel offers the card's ↓ on the same condition
 /// (Zeo next §6.21).
+/// Whether a row offers "Open Thread at This Task" (Zeo next §6.47, ask 71): only a subagent
+/// running in the background with something to show -- its own thread or output. A task of
+/// the main agent lives in the thread the row already belongs to, so there is no other thread
+/// to open at it.
+pub fn offers_open_at_task(
+    kind: &str,
+    background: bool,
+    has_child_thread: bool,
+    has_output: bool,
+) -> bool {
+    kind == SUBAGENT_KIND && background && (has_child_thread || has_output)
+}
+
 pub fn can_send_to_background(task: &AgentTask) -> bool {
     task.status.is_running() && background_target(task).is_some()
 }
