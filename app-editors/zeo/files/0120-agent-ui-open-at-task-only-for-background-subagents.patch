+// Zeo next proposal §6.47 (ask 71): "Open Thread at This Task" only for a background subagent
+// with something to show. Filter: `open_at_task_rule`.
+use super::*;
+
+#[test]
+fn only_a_background_subagent_with_a_thread_or_output_opens_at_its_task() {
+    // A task of the main agent lives in the thread its row belongs to.
+    assert!(!offers_open_at_task(SHELL_KIND, true, false, true));
+    assert!(!offers_open_at_task(SHELL_KIND, false, false, true));
+    // A subagent in the foreground, or with nothing to show yet.
+    assert!(!offers_open_at_task(SUBAGENT_KIND, false, true, true));
+    assert!(!offers_open_at_task(SUBAGENT_KIND, true, false, false));
+    // A background subagent with its own thread, or with output.
+    assert!(offers_open_at_task(SUBAGENT_KIND, true, true, false));
+    assert!(offers_open_at_task(SUBAGENT_KIND, true, false, true));
+}
