+/// on a symlink rather than follow it -- and a rename puts it in place, replacing whatever sat
+/// at the name, a link included, instead of writing through it.
+pub(crate) fn install_credentials(dir: &Path, credentials: &[u8], owner: u32) -> Result<()> {
+    let meta = fs::symlink_metadata(dir)
+        .with_context(|| format!("reading the jail's config directory {}", dir.display()))?;
