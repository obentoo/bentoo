+/// The folder of the jails' own agent: one per user, at a fixed place so the operator can
+/// `ssh-add` to it.
+pub fn zeo_agent_dir(uid: u32) -> PathBuf {
+    std::env::temp_dir().join(format!("zeo-ssh-{uid}"))
+}
+
+/// The socket of the jails' own agent.
+pub fn zeo_agent_socket(uid: u32) -> PathBuf {
+    zeo_agent_dir(uid).join("agent.sock")
+}
+
+/// [`zeo_agent_socket`] for the user Zeo runs as.
+pub fn current_user_agent_socket() -> PathBuf {
+    // SAFETY: getuid(2) cannot fail and touches no memory.
+    zeo_agent_socket(unsafe { libc::getuid() })
+}
+
+/// Makes sure the jails' own agent listens at [`zeo_agent_socket`], starting it if nothing does,
+/// and returns the socket and its folder. The folder is made mode 700 when absent; one already
+/// there must be a real directory of `uid`, open to nobody else -- `/tmp` is shared, and a
+/// folder somebody else made first would hold their socket, not Zeo's.
+pub fn ensure_zeo_agent(uid: u32) -> Result<(PathBuf, PathBuf), (PathBuf, SshSocketProblem)> {
+    ensure_agent_in(&zeo_agent_dir(uid), uid).map(|(socket, folder, _)| (socket, folder))
+}
+
+/// [`ensure_zeo_agent`] in `folder`; also the pid of an agent it started.
+#[allow(
+    clippy::disallowed_methods,
+    reason = "the launch decision is synchronous, and ssh-agent/ssh-add answer at once on a local socket"
+)]
+fn ensure_agent_in(
+    folder: &Path,
+    uid: u32,
+) -> Result<(PathBuf, PathBuf, Option<u32>), (PathBuf, SshSocketProblem)> {
+    use std::os::unix::fs::DirBuilderExt as _;
+    let folder = folder.to_path_buf();
+    let socket = folder.join("agent.sock");
+    let refuse = |problem| Err((socket.clone(), problem));
+    match std::fs::DirBuilder::new().mode(0o700).create(&folder) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(_) => return refuse(SshSocketProblem::AgentFailed),
+    }
+    let Ok(meta) = std::fs::symlink_metadata(&folder) else {
+        return refuse(SshSocketProblem::AgentFailed);
+    };
+    if !meta.is_dir() || meta.uid() != uid {
+        return refuse(SshSocketProblem::NotYours);
+    }
+    if meta.permissions().mode() & 0o077 != 0 {
+        return refuse(SshSocketProblem::OpenFolder);
+    }
+    if agent_answers(&socket) {
+        return Ok((socket, folder, None));
+    }
+    // Nothing answers: a stale socket from an agent that ended, or none yet.
+    if std::fs::symlink_metadata(&socket).is_ok() && std::fs::remove_file(&socket).is_err() {
+        return refuse(SshSocketProblem::AgentFailed);
+    }
+    let started = std::process::Command::new("ssh-agent")
+        .arg("-a")
+        .arg(&socket)
+        .stdin(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .output();
+    // ssh-agent forks the agent, which binds the socket and leaves stdout, then prints
+    // `SSH_AGENT_PID=<pid>;` and exits.
+    match started {
+        Ok(output) if output.status.success() && agent_answers(&socket) => {
+            let pid = String::from_utf8_lossy(&output.stdout)
+                .split("SSH_AGENT_PID=")
+                .nth(1)
+                .and_then(|rest| rest.split(';').next())
+                .and_then(|pid| pid.trim().parse::<u32>().ok());
+            log::info!(
+                "agent_sandbox event=ssh_agent_started socket={} pid={pid:?}",
+                socket.display()
+            );
+            Ok((socket, folder, pid))
+        }
+        Ok(output) => {
+            log::warn!(
+                "agent_sandbox event=ssh_agent_start_failed status={}",
+                output.status
+            );
+            refuse(SshSocketProblem::AgentFailed)
+        }
+        Err(error) => {
+            log::warn!("agent_sandbox event=ssh_agent_start_failed error={error}");
+            refuse(SshSocketProblem::AgentFailed)
+        }
+    }
+}
+
+/// Whether an agent answers at `socket`: `ssh-add -l` exits 0 (keys) or 1 (none) when it
+/// reaches one, 2 when it cannot.
+#[allow(
+    clippy::disallowed_methods,
+    reason = "the launch decision is synchronous, and ssh-agent/ssh-add answer at once on a local socket"
+)]
+fn agent_answers(socket: &Path) -> bool {
+    std::process::Command::new("ssh-add")
+        .arg("-l")
+        .env("SSH_AUTH_SOCK", socket)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .is_ok_and(|status| matches!(status.code(), Some(0 | 1)))
+}
+
+/// Empties the jails' agent (`ssh-add -D`), for the kill switch, and says whether it did: the
+/// log line follows ssh-add's own exit status, not the spawn (2026-11-27 review, Z5).
+#[allow(
+    clippy::disallowed_methods,
+    reason = "the kill switch is synchronous, and ssh-agent/ssh-add answer at once on a local socket"
+)]
+pub fn empty_agent(socket: &Path) -> bool {
+    let status = std::process::Command::new("ssh-add")
         .arg("-D")
         .env("SSH_AUTH_SOCK", socket)
         .stdin(std::process::Stdio::null())
         .stdout(std::process::Stdio::null())
         .stderr(std::process::Stdio::null())
-        .spawn();
-    match spawned {
-        Ok(_) => log::info!(
-            "agent_sandbox event=ssh_agent_emptied socket={}",
-            socket.display()
-        ),
-        Err(error) => log::warn!(
-            "agent_sandbox event=ssh_agent_empty_failed socket={} error={error}",
-            socket.display()
-        ),
+        .status();
+    match status {
+        Ok(status) if status.success() => {
+            log::info!(
+                "agent_sandbox event=ssh_agent_emptied socket={}",
+                socket.display()
+            );
+            true
+        }
+        Ok(status) => {
+            log::error!(
+                "agent_sandbox event=ssh_agent_empty_failed socket={} status={status}",
+                socket.display()
+            );
+            false
+        }
+        Err(error) => {
+            log::error!(
+                "agent_sandbox event=ssh_agent_empty_failed socket={} error={error}",
+                socket.display()
+            );
+            false
+        }
     }
 }
 
