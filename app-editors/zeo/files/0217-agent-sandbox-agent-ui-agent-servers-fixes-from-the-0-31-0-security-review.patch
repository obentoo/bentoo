+    std::fs::create_dir(&base).unwrap();
+    set_user_settings(with_limits_on(&f, &base), cx);
+    let project = project(&f, cx).await;
+    let dir = project_state_dir(&base, &f.root);
+
+    let elsewhere = f.base.join("planted");
+    std::fs::create_dir_all(elsewhere.join("claude")).unwrap();
+    std::os::unix::fs::symlink(&elsewhere, &dir).unwrap();
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(text.contains("not a private folder"), "a link: {text}");
+
+    std::fs::remove_file(&dir).unwrap();
+    std::fs::create_dir(&dir).unwrap();
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o755)).unwrap();
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        text.contains("not a private folder"),
+        "open to others: {text}"
+    );
+
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
+    jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+}
