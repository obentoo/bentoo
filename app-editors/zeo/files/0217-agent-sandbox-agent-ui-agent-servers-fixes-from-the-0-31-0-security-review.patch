+/// Review Z8: names the loader, ai-jail, TLS or a proxy library read in the unjailed supervisor.
+#[test]
+fn a_secret_may_not_take_a_name_the_supervisor_reads() {
+    for name in [
+        "LD_PRELOAD",
+        "ld_library_path",
+        "AI_JAIL_CONFIG",
+        "SSL_CERT_FILE",
+        "HTTPS_PROXY",
+        "all_proxy",
+    ] {
+        let vault = vec![entry("x", "v", Some((name, &["example.com"])))];
+        assert_eq!(
+            match_chosen(&chosen(&["secret://x/v"]), &vault, &[]).expect_err(name),
