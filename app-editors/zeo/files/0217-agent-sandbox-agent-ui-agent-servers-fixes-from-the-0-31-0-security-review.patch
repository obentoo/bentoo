+/// Only the credentials file reaches the jail's directory, and a link the agent planted at its
+/// name is replaced, not written through.
+#[test]
+fn agent_jail_login_installs_only_the_credentials_and_never_through_a_link() {
+    use std::os::unix::fs::MetadataExt as _;
+    let base = tempfile::tempdir().unwrap();
+    let jail = base.path().join("claude");
+    std::fs::create_dir(&jail).unwrap();
+    let outside = base.path().join("outside.json");
+    std::fs::write(&outside, b"host file").unwrap();
+    std::os::unix::fs::symlink(&outside, jail.join(".credentials.json")).unwrap();
+    let owner = std::fs::metadata(base.path()).unwrap().uid();
+
+    install_credentials(&jail, br#"{"token":"t"}"#, owner).unwrap();
+
+    assert_eq!(
+        std::fs::read(&outside).unwrap(),
+        b"host file",
+        "the link was not followed"
+    );
+    let installed = jail.join(".credentials.json");
+    assert!(
+        !std::fs::symlink_metadata(&installed)
+            .unwrap()
+            .file_type()
+            .is_symlink()
+    );
+    assert_eq!(std::fs::read(&installed).unwrap(), br#"{"token":"t"}"#);
+    let names: Vec<_> = std::fs::read_dir(&jail)
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name())
+        .collect();
+    assert_eq!(
+        names,
+        [".credentials.json"],
+        "nothing staged is left behind"
+    );
+
+    // The directory itself swapped for a link: refused.
+    let swapped = base.path().join("swapped");
+    std::os::unix::fs::symlink(base.path(), &swapped).unwrap();
+    assert!(install_credentials(&swapped, b"{}", owner).is_err());
+}
