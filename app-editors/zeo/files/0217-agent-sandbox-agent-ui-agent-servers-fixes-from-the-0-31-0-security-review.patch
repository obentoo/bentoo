+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&staged)
+        .with_context(|| format!("staging the credentials in {}", dir.display()))?;
+    let written = file.write_all(credentials).and_then(|()| file.sync_all());
+    drop(file);
+    if let Err(error) = written.and_then(|()| fs::rename(&staged, dir.join(CREDENTIALS_FILE))) {
+        let _ = fs::remove_file(&staged);
+        return Err(error).context("installing the credentials");
+    }
