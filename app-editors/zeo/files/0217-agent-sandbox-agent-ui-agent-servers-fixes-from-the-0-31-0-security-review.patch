+/// How long ai-jail has after SIGTERM to end the jail and itself (§6.55 measured it well under
+/// a second) before the kill switch sends SIGKILL.
+#[cfg(unix)]
+const KILL_GRACE_MS: libc::c_int = 2000;
+
+/// Waits up to `grace_ms` for the process behind `pidfd` to exit, then SIGKILLs it through the
+/// pidfd if it has not, and closes the descriptor. A pidfd turns readable when its process
+/// exits, a zombie included.
+#[cfg(unix)]
+fn escalate_after(pidfd: libc::c_int, pid: libc::pid_t, grace_ms: libc::c_int) {
+    let mut poll = libc::pollfd {
+        fd: pidfd,
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    // SAFETY: one valid pollfd, owned by this frame.
+    let ready = unsafe { libc::poll(&mut poll, 1, grace_ms) };
+    if ready == 0 {
+        // SAFETY: pidfd_send_signal(2) on our pidfd with a valid signal and no siginfo.
+        let sent = unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                pidfd,
+                libc::SIGKILL,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        };
+        if sent == 0 {
+            log::warn!(
+                "agent_sandbox event=kill_switch pid={pid} outcome=escalated signal=SIGKILL"
+            );
+        } else {
+            let error = io::Error::last_os_error();
+            log::error!(
+                "agent_sandbox event=kill_switch pid={pid} outcome=escalation_failed error={error}"
+            );
+        }
+    }
+    // SAFETY: closing the descriptor this function was handed.
+    unsafe { libc::close(pidfd) };
+}
+
