diff --git a/crates/acp_thread/src/acp_thread_account_refresh_tests.rs b/crates/acp_thread/src/acp_thread_account_refresh_tests.rs
new file mode 100644
index 0000000..e1d3c94
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_account_refresh_tests.rs
@@ -0,0 +1,170 @@
+// Zeo next proposal §6.16 (ask 36): the Weekly bar refreshes live.
+//
+// Hovering the context ring asks the agent for the quota; a click asks even inside the
+// minimum interval, for a pointer without hover. The tooltip says what the rows are: being
+// refreshed, refreshed at a time, or waiting for the turn to end -- the agent refuses a
+// usage request while a turn runs, so its Stop button never waits behind one.
+//
+// Included at the end of `mod tests` in `acp_thread.rs`.
+
+async fn account_refresh_thread(
+    connection: Rc<FakeAgentConnection>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    cx.update(|cx| connection.new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx))
+        .await
+        .unwrap()
+}
+
+fn account_refresh_window(thread: &Entity<AcpThread>, cx: &mut TestAppContext) {
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        CLAUDE_RATE_LIMIT_META_KEY.to_string(),
+        rate_limit("seven_day", "allowed", 0.42),
+    );
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp_v1::SessionUpdate::UsageUpdate(
+                    acp_v1::UsageUpdate::new(1000, 10000).meta(meta),
+                ),
+                cx,
+            )
+        })
+        .unwrap();
+}
+
+/// Hostile: a click inside the interval still asks; a hover there does not. A click does
+/// not stack a second request on one in flight.
+#[gpui::test]
+async fn account_refresh_a_click_skips_the_interval_but_not_a_request_in_flight(
+    cx: &mut TestAppContext,
+) {
+    let connection = Rc::new(FakeAgentConnection::new());
+    let thread = account_refresh_thread(connection.clone(), cx).await;
+    let refresh = |force: bool, cx: &mut TestAppContext| {
+        thread.update(cx, |thread, cx| thread.refresh_account_usage(force, cx));
+        cx.run_until_parked();
+    };
+
+    refresh(false, cx);
+    refresh(false, cx);
+    assert_eq!(
+        connection.usage_refreshes.get(),
+        1,
+        "a hover inside the interval"
+    );
+    refresh(true, cx);
+    assert_eq!(
+        connection.usage_refreshes.get(),
+        2,
+        "a click inside the interval"
+    );
+
+    connection.hold_usage_refreshes.set(true);
+    refresh(true, cx);
+    refresh(true, cx);
+    assert_eq!(connection.usage_refreshes.get(), 3, "one request in flight");
+}
+
+/// The interval a hover waits is one second, not five.
+#[gpui::test]
+async fn account_refresh_a_hover_asks_again_after_one_second(cx: &mut TestAppContext) {
+    let connection = Rc::new(FakeAgentConnection::new());
+    let thread = account_refresh_thread(connection.clone(), cx).await;
+    thread.update(cx, |thread, cx| thread.refresh_account_usage(false, cx));
+    cx.run_until_parked();
+    cx.executor().advance_clock(Duration::from_secs(1));
+    thread.update(cx, |thread, cx| thread.refresh_account_usage(false, cx));
+    cx.run_until_parked();
+    assert_eq!(connection.usage_refreshes.get(), 2);
+}
+
+/// The status follows the request: refreshing while it is answered, then the time the
+/// windows arrived.
+#[gpui::test]
+async fn account_refresh_status_is_refreshing_then_updated(cx: &mut TestAppContext) {
+    let connection = Rc::new(FakeAgentConnection::new());
+    let thread = account_refresh_thread(connection.clone(), cx).await;
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(
+            thread.account_usage_refresh_status(),
+            AccountUsageRefreshStatus::Unknown
+        );
+    });
+
+    connection.hold_usage_refreshes.set(true);
+    thread.update(cx, |thread, cx| thread.refresh_account_usage(false, cx));
+    cx.run_until_parked();
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(
+            thread.account_usage_refresh_status(),
+            AccountUsageRefreshStatus::Refreshing
+        );
+    });
+
+    let before = chrono::Utc::now();
+    account_refresh_window(&thread, cx);
+    for tx in connection.held_usage_refreshes.borrow_mut().drain(..) {
+        tx.send(()).ok();
+    }
+    cx.run_until_parked();
+    thread.read_with(cx, |thread, _| {
+        match thread.account_usage_refresh_status() {
+            AccountUsageRefreshStatus::Updated(at) => assert!(at >= before, "stamped on arrival"),
+            other => panic!("expected Updated, got {other:?}"),
+        }
+    });
+}
+
+/// Hostile: during a turn nothing is asked -- the agent would refuse it -- and the status
+/// says the rows wait for the turn's end, even when windows arrived before.
+#[gpui::test]
+async fn account_refresh_waits_for_the_turn_to_end(cx: &mut TestAppContext) {
+    let (release, released) = oneshot::channel::<()>();
+    let released = Rc::new(RefCell::new(Some(released)));
+    let connection = Rc::new(FakeAgentConnection::new().on_user_message(move |_, _, _| {
+        let released = released.borrow_mut().take();
+        async move {
+            if let Some(released) = released {
+                released.await.ok();
+            }
+            Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn))
+        }
+        .boxed_local()
+    }));
+    let thread = account_refresh_thread(connection.clone(), cx).await;
+    account_refresh_window(&thread, cx);
+    let turn = thread.update(cx, |thread, cx| thread.send_raw("question", cx));
+    cx.run_until_parked();
+
+    thread.update(cx, |thread, cx| thread.refresh_account_usage(true, cx));
+    cx.run_until_parked();
+    assert_eq!(
+        connection.usage_refreshes.get(),
+        0,
+        "nothing asked during a turn"
+    );
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(
+            thread.account_usage_refresh_status(),
+            AccountUsageRefreshStatus::AfterTurn
+        );
+    });
+
+    release.send(()).ok();
+    turn.await.ok();
+    cx.run_until_parked();
+    thread.read_with(cx, |thread, _| {
+        assert!(
+            matches!(
+                thread.account_usage_refresh_status(),
+                AccountUsageRefreshStatus::Updated(_)
+            ),
+            "back to the last arrival once the turn ends"
+        );
+    });
+}
