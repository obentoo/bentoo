-/// also keeps a shared sample, so a tighter loop would read the same numbers.
-pub const ACCOUNT_USAGE_REFRESH_MIN_INTERVAL: Duration = Duration::from_secs(5);
+/// The shortest gap between two hover refreshes of one thread. Hovering in and out of
+/// the ring must not turn into a request per pointer movement. One second, not five
+/// (Zeo next §6.16): a hover is read as asking for the numbers now, and the agent's
+/// shared sample (5 s in Claude Agent (Plus)) already absorbs a tighter loop. A click
+/// skips it.
+pub const ACCOUNT_USAGE_REFRESH_MIN_INTERVAL: Duration = Duration::from_secs(1);
+
+/// What the context ring's quota rows are, for the tooltip to say (Zeo next §6.16).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AccountUsageRefreshStatus {
+    /// No quota window has arrived and none is being asked for.
+    Unknown,
+    /// A refresh was asked for and the agent has not answered yet.
+    Refreshing,
+    /// A turn is running: the agent answers no usage request until it ends, so its
+    /// Stop button never waits behind one. The turn's own end refreshes the rows.
+    AfterTurn,
+    /// The rows are the windows that arrived at this time.
+    Updated(chrono::DateTime<chrono::Utc>),
+}
 
 /// Account-level quota state, accumulated across `rate_limit_event`s.
 #[derive(Debug, Clone, Default, PartialEq)]
