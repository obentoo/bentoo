@@ -0,0 +1,35 @@
+// Zeo next proposal §6.16 (ask 36): under the context ring's quota rows, one line says what
+// they are -- being refreshed, waiting for the turn to end, or the local time they arrived.
+
+use acp_thread::AccountUsageRefreshStatus as Status;
+
+use super::super::account_refresh_line;
+
+#[test]
+fn account_refresh_line_says_what_the_quota_rows_are() {
+    assert_eq!(
+        account_refresh_line(Status::Unknown),
+        None,
+        "nothing to say"
+    );
+    assert_eq!(
+        account_refresh_line(Status::Refreshing).as_deref(),
+        Some("Refreshing\u{2026}")
+    );
+    assert_eq!(
+        account_refresh_line(Status::AfterTurn).as_deref(),
+        Some("Refreshes when the turn ends")
+    );
+    let at = chrono::DateTime::parse_from_rfc3339("2026-11-10T09:15:07Z")
+        .expect("fixture")
+        .with_timezone(&chrono::Utc);
+    let local = at
+        .with_timezone(&chrono::Local)
+        .format("%H:%M:%S")
+        .to_string();
+    assert_eq!(
+        account_refresh_line(Status::Updated(at)),
+        Some(format!("Updated at {local}")),
+        "the arrival in local time, to the second"
+    );
+}
