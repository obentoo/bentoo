             return;
         }
         self.account_usage_refreshing = true;
         self.account_usage_refreshed_at = Some(now);
+        cx.notify();
         let session_id = self.session_id().clone();
         let request = self
             .connection
@@ -5618,8 +5661,11 @@ impl AcpThread {
