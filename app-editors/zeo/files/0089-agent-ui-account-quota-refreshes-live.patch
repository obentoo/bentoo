+/// The line under the tooltip's quota rows that says what they are (Zeo next §6.16).
+fn account_refresh_line(status: acp_thread::AccountUsageRefreshStatus) -> Option<String> {
+    use acp_thread::AccountUsageRefreshStatus as Status;
+    match status {
