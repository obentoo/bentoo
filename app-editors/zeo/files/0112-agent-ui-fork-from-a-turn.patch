+// Zeo next proposal §6.33: a fork from a turn names it under `_meta["_claude/forkAt"]`, and a
+// plain fork sends no `_meta` at all, as before.
+#[test]
+fn a_cut_point_goes_under_the_fork_at_meta_key_only_when_given() {
+    let directories = || SessionDirectories {
+        cwd: PathBuf::from(CWD),
+        additional_directories: vec![],
+    };
+    let cut = serde_json::json!({ "messageId": "msg_2" });
+    let request = directories().into_fork_session_request(
+        acp_v2::SessionId::new(PARENT),
+        vec![],
+        Some(cut.clone()),
+    );
+    assert_eq!(
+        request
+            .meta
+            .as_ref()
+            .and_then(|meta| meta.get("_claude/forkAt")),
+        Some(&cut)
+    );
+    let plain =
+        directories().into_fork_session_request(acp_v2::SessionId::new(PARENT), vec![], None);
+    assert_eq!(plain.meta, None);
+}
