             .additional_directories(self.additional_directories)
-            .mcp_servers(mcp_servers)
+            .mcp_servers(mcp_servers);
+        if let Some(cut) = cut {
+            let mut meta = serde_json::Map::new();
+            meta.insert(CLAUDE_FORK_AT_META_KEY.to_string(), cut);
+            request.meta = Some(meta);
+        }
+        request
     }
 }
 
