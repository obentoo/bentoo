+// Zeo next proposal §6.33 (ask 55): which turn a fork from the turn's controls names.
+// Filter: `turn_fork::tests`.
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection as _, StubAgentConnection};
+use agent_client_protocol::v1::schema as acp_v1;
+use fs::FakeFs;
+use gpui::{Entity, TestAppContext};
+use project::Project;
+use serde_json::json;
+use util::path_list::PathList;
+
+use super::turn_cut;
+
+fn user(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+fn says(text: &str, id: Option<&str>) -> acp_v1::SessionUpdate {
+    let chunk = acp_v1::ContentChunk::new(text.into());
+    let chunk = match id {
+        Some(id) => chunk.message_id(acp_v1::MessageId::new(id)),
+        None => chunk,
+    };
+    acp_v1::SessionUpdate::AgentMessageChunk(chunk)
+}
+
+fn tool(id: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::ToolCall(acp_v1::ToolCall::new(
+        acp_v1::ToolCallId::new(id.to_string()),
+        "Read the changelog",
+    ))
+}
+
+async fn thread_of(
+    updates: Vec<acp_v1::SessionUpdate>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    crate::test_support::init_test(cx);
+    let project = Project::test(FakeFs::new(cx.executor()), [], cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    let thread = cx
+        .update(|cx| {
+            connection
+                .clone()
+                .new_session(project, PathList::new(&[Path::new("/project")]), cx)
+        })
+        .await
+        .expect("a stub session");
+    let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+    for update in updates {
+        cx.update(|cx| connection.send_update(session_id.clone(), update, cx));
+    }
+    cx.run_until_parked();
+    thread
+}
+
+fn cut_at(
+    thread: &Entity<AcpThread>,
+    entry_ix: usize,
+    cx: &TestAppContext,
+) -> Option<serde_json::Value> {
+    thread.read_with(cx, |thread, _| turn_cut(thread.entries(), entry_ix))
+}
+
+#[gpui::test]
+async fn names_the_turn_by_its_last_agent_message_id(cx: &mut TestAppContext) {
+    // [user, agent msg_1, tool, agent msg_2, user, agent msg_3]
+    let thread = thread_of(
+        vec![
+            user("first"),
+            says("looking", Some("msg_1")),
+            tool("t1"),
+            says("done", Some("msg_2")),
+            user("second"),
+            says("ok", Some("msg_3")),
+        ],
+        cx,
+    )
+    .await;
+    assert_eq!(
+        cut_at(&thread, 3, cx),
+        Some(json!({ "messageId": "msg_2" }))
+    );
+    assert_eq!(
+        cut_at(&thread, 5, cx),
+        Some(json!({ "messageId": "msg_3" }))
+    );
+}
+
+/// Hostile: the id must come from the turn being forked, never from an earlier turn, even
+/// when that turn's own messages carry none.
+#[gpui::test]
+async fn an_id_from_an_earlier_turn_is_never_used(cx: &mut TestAppContext) {
+    let thread = thread_of(
+        vec![
+            user("first"),
+            says("one", Some("msg_1")),
+            user("second"),
+            says("two", None),
+        ],
+        cx,
+    )
+    .await;
+    assert_eq!(
+        cut_at(&thread, 3, cx),
+        Some(json!({ "turn": 2 })),
+        "no id in this turn: its position, not msg_1"
+    );
+}
+
+#[gpui::test]
+async fn nothing_to_fork_before_the_first_prompt(cx: &mut TestAppContext) {
+    let thread = thread_of(vec![says("hello", Some("msg_0"))], cx).await;
+    assert_eq!(
+        cut_at(&thread, 0, cx),
+        Some(json!({ "messageId": "msg_0" })),
+        "an agent message alone still names itself"
+    );
+    let empty = thread_of(vec![tool("t0")], cx).await;
+    assert_eq!(cut_at(&empty, 0, cx), None);
+    assert_eq!(cut_at(&empty, 9, cx), None, "an index past the entries");
+}
