 impl AssistantMessage {
+    /// The ACP id of this message's last reply chunk that carries one (Zeo next proposal
+    /// §6.33): what an agent keys a turn on when the client forks or rewinds from it.
+    /// Thoughts are skipped; a v2 keyed identity is not a v1 message id and is skipped too.
+    pub fn last_message_id(&self) -> Option<String> {
+        self.chunks.iter().rev().find_map(|chunk| match chunk {
+            AssistantMessageChunk::Message {
+                identity: MessageIdentity::Legacy(Some(id)),
+                ..
+            } => Some(id.0.to_string()),
+            _ => None,
+        })
+    }
