 impl AcpConnection {
+    /// Sends `session/fork` (still `unstable_` in ACP) for `session_id` with the parent
+    /// thread's directories and the project's MCP servers, and registers the thread of the
+    /// session the agent answers with, marked as forked from the parent.
+    ///
+    /// `cut`, when set, goes to the agent as `_meta["_claude/forkAt"]` (Zeo next §6.33): the
+    /// fork keeps the conversation up to the end of that turn only.
+    fn fork_session_with(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cut: Option<serde_json::Value>,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        if !self.agent_supports_session_fork() {
+            return Task::ready(Err(anyhow!(LoadError::Other(
+                "Forking sessions is not supported by this agent.".into()
+            ))));
+        }
+        let directories = match self.session_directories_from_work_dirs(&work_dirs) {
+            Ok(directories) => directories,
+            Err(error) => return Task::ready(Err(error)),
+        };
+        let parent = session_id.clone();
+        let mcp_servers = mcp_servers_for_project(&project, cx);
+        // Read before the request, as a reopen reads before `session/load`. Keyed by
+        // this entry and the parent, so another entry's record of the same id is not it.
+        let parent_record = thread_config_store::read(&self.id, &parent, cx);
+
+        cx.spawn(async move |cx| {
+            let (response_sender, response_received) = futures::channel::oneshot::channel();
+            let (registered, registration_finished) = futures::channel::oneshot::channel();
+            let request = self
+                .connection
+                .prepare_request(directories.into_fork_session_request(
+                    parent.clone(),
+                    mcp_servers,
+                    cut,
+                ));
+            let cancellation = request.cancellation_handle();
+            request
+                .on_receiving_result({
+                    let connection = self.connection.clone();
+                    let supports_close = self.agent_supports_session_close();
+                    // The same abandoned-session close as `new_session`: a fork nobody
+                    // registered would otherwise stay open in the agent.
+                    async move |result: Result<
+                        acp::ForkSessionResponse,
+                        agent_client_protocol::Error,
+                    >| {
+                        let session_id = result
+                            .as_ref()
+                            .ok()
+                            .map(|response| response.session_id.clone());
+                        let registered = response_sender.send(result).is_ok()
+                            && registration_finished.await.is_ok();
+                        if !registered
+                            && supports_close
+                            && let Some(session_id) = session_id
+                        {
+                            connection
+                                .prepare_request(acp::CloseSessionRequest::new(session_id))
+                                .on_receiving_result(
+                                    async move |result: Result<
+                                        acp::CloseSessionResponse,
+                                        agent_client_protocol::Error,
+                                    >| {
+                                        if let Err(error) = result {
+                                            log::warn!(
+                                                "ACP abandoned-fork close failed with code {}",
+                                                error.code
+                                            );
+                                        }
+                                        Ok(())
+                                    },
+                                )
+                                .log_err();
+                        }
+                        Ok(())
+                    }
+                })
+                .map_err(map_acp_error)?;
+            // Armed after the publishing call returns, as in `new_session`: early SDK
+            // cancellation is not latched.
+            let _request_guard = util::defer(move || {
+                cancellation.cancel().log_err();
+            });
+            let response = response_received
+                .await
+                .context("ACP fork-session response callback was cancelled")?
+                .map_err(map_acp_error)?;
+
+            let inherited = parent_record.map(|record| InheritedConfig {
+                parent: parent.clone(),
+                record,
+            });
+            let thread = self.register_answered_session(
+                response.session_id,
+                response.modes,
+                response.config_options,
+                inherited,
+                project,
+                work_dirs,
+                cx,
+            )?;
+            thread.update(cx, |thread, _| thread.mark_forked_from(parent));
+
+            registered.send(()).map_err(|_| {
+                anyhow!("ACP fork-session ordering callback ended before registration")
+            })?;
+            Ok(thread)
+        })
+    }
+
+    /// Whether the agent lists `capability` in its `agentCapabilities._meta`.
+    fn agent_advertises(&self, capability: &str) -> bool {
+        self.agent_capabilities
+            .meta
+            .as_ref()
+            .is_some_and(|meta| meta.contains_key(capability))
+    }
+
