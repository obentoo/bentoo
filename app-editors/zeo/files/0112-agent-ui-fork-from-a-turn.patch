+//! Fork from a turn (Zeo next proposal §6.33, ask 55).
+//!
+//! The row of controls under each finished turn gains a fork button: it opens a "with context"
+//! sub-thread (story 039's fork, `0070`) that keeps the conversation only up to the end of that
+//! turn. The turn is named to the agent by the ACP id of its last agent message, which the plus
+//! adapter (0.38.0) translates to its transcript; a turn with no id falls back to its position
+//! among the user's prompts. The button shows only when the agent takes a cut point
+//! (`supports_fork_at_turn`), on the root session's view, and waits while a turn runs, as
+//! `0070`'s menu entry does.
+
+use acp_thread::{AgentThreadEntry, ThreadStatus};
+use gpui::{AnyElement, App, Context, Entity, Window};
+use serde_json::json;
+use ui::{IconButton, IconName, IconSize, Tooltip, prelude::*};
+
+use super::{SubThreadRequest, inherited_message_count};
+use crate::AgentPanel;
+use crate::conversation_view::ThreadView;
+use crate::thread_organization::ForkKind;
+
+pub(crate) const FORK_TURN_TOOLTIP: &str = "Fork to a Sub-thread from Here";
+const WAIT_FOR_TURN: &str = "Wait for the turn to end";
+
+/// How the agent is told which turn a fork keeps up to, for the turn that ends at
+/// `entry_ix`: the last agent message id of that turn, or else the turn's 1-based position
+/// among the user's prompts. `None` before the first prompt.
+pub(crate) fn turn_cut(entries: &[AgentThreadEntry], entry_ix: usize) -> Option<serde_json::Value> {
+    let entries = entries.get(..=entry_ix)?;
+    let message_id = entries
+        .iter()
+        .rev()
+        .take_while(|entry| !matches!(entry, AgentThreadEntry::UserMessage(_)))
+        .find_map(|entry| match entry {
+            AgentThreadEntry::AssistantMessage(message) => message.last_message_id(),
+            _ => None,
+        });
+    if let Some(message_id) = message_id {
+        return Some(json!({ "messageId": message_id }));
+    }
+    let turn = entries
+        .iter()
+        .filter(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)))
+        .count();
+    (turn > 0).then(|| json!({ "turn": turn }))
+}
+
+impl ThreadView {
+    /// The fork button for the turn ending at `entry_ix`, or `None` where it is not offered.
+    pub(crate) fn render_fork_turn_button(
+        &self,
+        entry_ix: usize,
+        cx: &Context<Self>,
+    ) -> Option<AnyElement> {
+        let thread = self.thread.read(cx);
+        let connection = thread.connection();
+        let offered = connection.supports_fork_at_turn()
+            && (connection.supports_load_session() || connection.supports_resume_session())
+            && self.shows_root_session(cx);
+        if !offered {
+            return None;
+        }
+        let cut = turn_cut(thread.entries(), entry_ix)?;
+        let turn_running = thread.status() != ThreadStatus::Idle;
+        Some(
+            IconButton::new(("fork-turn", entry_ix), IconName::GitBranchPlus)
+                .icon_size(IconSize::Small)
+                .icon_color(Color::Muted)
+                .disabled(turn_running)
+                .tooltip(Tooltip::text(if turn_running {
+                    WAIT_FOR_TURN
+                } else {
+                    FORK_TURN_TOOLTIP
+                }))
+                .on_click(cx.listener(move |_, _, window, cx| {
+                    // The click runs inside this view's update, and opening the fork reads the
+                    // view again through its handle: defer it past the update, or it panics
+                    // ("already being updated", seen on the Xvfb proof).
+                    let thread_view = cx.entity();
+                    let cut = cut.clone();
+                    window.defer(cx, move |window, cx| {
+                        open_fork_at_turn(&thread_view, entry_ix, cut, window, cx);
+                    });
+                }))
+                .into_any_element(),
+        )
+    }
+}
+
+fn open_fork_at_turn(
+    thread_view: &Entity<ThreadView>,
+    entry_ix: usize,
+    cut: serde_json::Value,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let view = thread_view.read(cx);
+    let thread = view.thread.read(cx);
+    let parent_session_id = thread.session_id().clone();
+    let Some(agent) = view
+        .server_view
+        .upgrade()
+        .map(|conversation| conversation.read(cx).agent_key().clone())
+    else {
+        log::warn!(
+            "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind=with_context source=turn reason=no_conversation"
+        );
+        return;
+    };
+    let entries = thread.entries();
+    let kept = entries.get(..=entry_ix).unwrap_or(entries);
+    let request = SubThreadRequest {
+        parent_thread_id: view.root_thread_id,
+        parent_session_id: parent_session_id.clone(),
+        agent,
+        work_dirs: thread.work_dirs().cloned(),
+        kind: ForkKind::WithContext,
+        excerpt: "".into(),
+        inherited_messages: Some(inherited_message_count(kept)),
+    };
+    let Some(panel) = view
+        .workspace
+        .upgrade()
+        .and_then(|workspace| workspace.read(cx).panel::<AgentPanel>(cx))
+    else {
+        log::warn!(
+            "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind=with_context source=turn reason=no_agent_panel"
+        );
+        return;
+    };
+    let opening = panel.update(cx, |panel, cx| {
+        panel.open_sub_thread_at(request, cut, true, window, cx)
+    });
+    cx.spawn(async move |_| {
+        if let Err(error) = opening.await {
+            log::warn!(
+                "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind=with_context source=turn: {error:#}"
+            );
+        }
+    })
+    .detach();
+}
+
