+
+#[gpui::test]
+async fn load_ignores_a_recorded_toggle(cx: &mut gpui::TestAppContext) {
+    // Toggles are session-scoped (patch 0059). A record written before that
+    // still holds `web_search: true`; reopening the thread must not re-arm it,
+    // while the select it was recorded beside is still restored.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(plus_script(), project, cx).await;
+    record(
+        PLUS,
+        "s-old-toggle",
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus".into())),
+                ("web_search", RecordedValue::Bool(true)),
+            ],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("s-old-toggle", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))],
+        "the recorded toggle is not sent; the agent's own value stands"
+    );
+}
