+// Zeo next proposal §5.2 (asks 4, 32, 33): an ended row can be dismissed from the card, and
+// "Clear finished" removes every ended row while running rows stay. Card only: the Agent
+// Tasks panel keeps the records.
+//
+// Not covered here: dismissing a native subagent row in state `Unknown` (it needs the
+// native-subagent fixture), and the always-visible scrollbar, which only an Xvfb capture
+// proves (GPUI tests do not see auto-hide).
+
+use super::TaskRowStatus;
+use super::test_helpers::*;
+use gpui::TestAppContext;
+
+#[gpui::test]
+async fn an_ended_row_dismissed_leaves_before_its_linger(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "Thread", &mut cx);
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "completed", true, 1_000)],
+        &mut cx,
+    );
+    let card = card(&panel, &cx);
+    let session = session_of(&thread, &cx);
+    let row = find_row(&card, &session, "t1", &mut cx).expect("fixture: the ended row lingers");
+    assert!(row.status.is_terminal(), "fixture: the row has ended");
+
+    card.update(&mut cx, |card, cx| {
+        card.dismiss_row((session.clone(), row.task.id.clone()), row.status, cx)
+    });
+
+    assert!(find_row(&card, &session, "t1", &mut cx).is_none());
+    assert!(!visible(&card, &mut cx), "nothing left: the card hides");
+}
+
+#[gpui::test]
+async fn a_running_row_cannot_be_dismissed(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "Thread", &mut cx);
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    let card = card(&panel, &cx);
+    let session = session_of(&thread, &cx);
+    let key = (session.clone(), "t1".to_string().into());
+
+    card.update(&mut cx, |card, cx| {
+        card.dismiss_row(key, TaskRowStatus::Running, cx)
+    });
+
+    assert!(
+        find_row(&card, &session, "t1", &mut cx).is_some(),
+        "Stop is its control"
+    );
+}
+
+#[gpui::test]
+async fn clear_finished_removes_ended_rows_and_keeps_running_ones(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "Thread", &mut cx);
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "running", true, 1_000),
+            wire_task("live", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "completed", true, 1_000),
+            wire_task("live", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+    let card = card(&panel, &cx);
+    let session = session_of(&thread, &cx);
+    assert_eq!(
+        row_ids(&rows_of(&card, &session, &mut cx)),
+        vec!["done".to_string(), "live".to_string()],
+        "fixture: an ended row lingers beside a running one"
+    );
+
+    card.update(&mut cx, |card, cx| card.clear_finished(cx));
+
+    assert_eq!(
+        row_ids(&rows_of(&card, &session, &mut cx)),
+        vec!["live".to_string()]
+    );
+}
