+    /// Removes one row from the card (§5.2): an ended row leaves before its linger runs out,
+    /// an `Unknown` row is hidden while it stays `Unknown`. Running rows have Stop instead.
+    pub fn dismiss_row(&mut self, key: TaskKey, status: TaskRowStatus, cx: &mut Context<Self>) {
+        if status.is_terminal() {
+            self.ended.remove(&key);
+        } else if status == TaskRowStatus::Unknown {
+            self.dismissed_unknown.insert(key);
+        } else {
+            return;
+        }
+        cx.notify();
+    }
+
+    /// "Clear finished" (§5.2): every ended row leaves, and every `Unknown` row on show is
+    /// hidden. Running and waiting rows stay.
+    pub fn clear_finished(&mut self, cx: &mut Context<Self>) {
+        let unknown: Vec<TaskKey> = self
+            .rows(cx)
+            .into_iter()
+            .flat_map(|group| {
+                let session_id = group.session_id;
+                group
+                    .rows
+                    .into_iter()
+                    .filter(|row| row.status == TaskRowStatus::Unknown)
+                    .map(move |row| (session_id.clone(), row.task.id))
+            })
+            .collect();
+        self.ended.clear();
+        self.dismissed_unknown.extend(unknown);
+        cx.notify();
+    }
