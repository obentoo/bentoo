+// ── Zeo 0.9.1 — a card emptied by dismissals, and the pill with nothing running ──
+
+/// A child that has reported no state reads Unknown and can be dismissed. Dismissing the
+/// last row must hide the card: the group it emptied used to keep it on screen.
+#[gpui::test]
+async fn test_dismissing_the_last_unknown_row_hides_the_card(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.cx.run_until_parked();
+    let row = rig.row_of(&alpha).expect("fixture: the child has a row");
+    assert!(
+        row.status == super::TaskRowStatus::Unknown,
+        "fixture: a child with no state reads Unknown"
+    );
+
+    let card = rig.card.clone();
+    let key = (rig.parent_session.clone(), row.task.id.clone());
+    card.update(&mut rig.cx, |card, cx| {
+        card.dismiss_row(key, row.status, cx)
+    });
+    rig.cx.run_until_parked();
+
+    assert!(rig.row_of(&alpha).is_none(), "the row left");
+    assert!(
+        !visible(&card, &mut rig.cx),
+        "nothing left on the card: it hides"
+    );
+}
