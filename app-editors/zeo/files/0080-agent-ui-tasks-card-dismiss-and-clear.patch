+    let mut rig = subagent_rig(cx).await;
+    let _alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    card.update(&mut rig.cx, |card, cx| card.toggle_minimized(cx));
+    RENDERED_ARIA_LABELS.with_borrow_mut(Vec::clear);
+    rig.draw();
+
+    assert!(
+        rig.cx.debug_bounds("tasks-card-pill").is_some(),
+        "fixture: the pill is painted"
+    );
+    assert!(
+        rig.cx.debug_bounds("tasks-card-pill-spinner").is_none(),
+        "nothing runs: no spinner"
+    );
+    let labels = RENDERED_ARIA_LABELS.with_borrow(Clone::clone);
+    assert!(
+        labels
+            .iter()
+            .any(|label| label.as_ref() == "Expand the tasks card: 1 task, none running"),
+        "the pill counts the row it holds, got {labels:?}"
+    );
+}
+
+/// Running, the pill keeps its spinner and its running count.
+#[gpui::test]
+async fn test_the_pill_spins_while_a_child_runs(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    let card = rig.card.clone();
+    card.update(&mut rig.cx, |card, cx| card.toggle_minimized(cx));
+    RENDERED_ARIA_LABELS.with_borrow_mut(Vec::clear);
+    rig.draw();
+
+    assert!(rig.cx.debug_bounds("tasks-card-pill-spinner").is_some());
+    let labels = RENDERED_ARIA_LABELS.with_borrow(Clone::clone);
+    assert!(
+        labels
+            .iter()
+            .any(|label| label.as_ref() == "Expand the tasks card: 1 task running"),
+        "got {labels:?}"
+    );
+}
