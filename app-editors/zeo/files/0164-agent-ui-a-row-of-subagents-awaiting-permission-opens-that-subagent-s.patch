-                        |(ix, (label, entry_ix))| {
+                        |(ix, (label, entry_ix, subagent_session_id))| {
                             let is_last = ix == item_count - 1;
                             let group = format!("group-{}", entry_ix);
 
@@ -5191,17 +5194,39 @@ impl ThreadView {
                                 )
                                 .child(
                                     div().visible_on_hover(&group).child(
-                                        Label::new("Scroll to Subagent")
+                                        Label::new("Open Subagent Thread")
                                             .size(LabelSize::Small)
                                             .color(Color::Muted)
                                             .truncate(),
                                     ),
                                 )
-                                .on_click(cx.listener(move |this, _, _, cx| {
-                                    this.list_state.scroll_to(ListOffset {
-                                        item_ix: entry_ix,
-                                        offset_in_item: px(0.0),
-                                    });
+                                // Operator ask of 2026-11-23: the row opens the waiting child's
+                                // own thread, where its prompt is. Upstream only scrolled the
+                                // parent to the child's card; that stays the fallback for a child
+                                // with no thread view of its own here.
+                                .on_click(cx.listener(move |this, _, window, cx| {
+                                    let opened = this
+                                        .server_view
