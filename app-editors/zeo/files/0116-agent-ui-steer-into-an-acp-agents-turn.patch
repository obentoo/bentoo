+
+    fn steer(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        prompt: Vec<acp_v2::ContentBlock>,
+        cx: &mut App,
+    ) -> Task<Result<acp_thread::SteerOutcome>> {
+        if !self.supports_steering() {
+            return Task::ready(Err(anyhow!("This agent does not take steering.")));
+        }
+        // The same conversion `prompt` applies, so a steered message reaches the agent in the
+        // shape a queued one would have.
+        let prompt = match acp_thread::content::prompt_to_v1(acp_v2::PromptRequest::new(
+            session_id.clone(),
+            prompt,
+        ))
+        .and_then(|request| Ok(serde_json::to_value(request.prompt)?))
+        {
+            Ok(prompt) => prompt,
+            Err(error) => return Task::ready(Err(error)),
+        };
+        // `promptRequired`: with no turn running the agent takes nothing, so the message stays
+        // the client's to send as an ordinary prompt -- never a turn the client did not start.
+        let params = serde_json::json!({
+            "sessionId": session_id,
+            "prompt": prompt,
+            "_meta": { "steering": { "idleBehavior": "promptRequired" } },
+        });
+        let request = send_task_request(
+            self.connection.clone(),
+            STEERING_METHOD,
+            params,
+            session_id.to_string(),
+        );
+        cx.foreground_executor()
+            .spawn(async move { parse_steer_answer(&request.await?) })
+    }
