diff --git a/crates/agent_ui/src/conversation_view/thread_view/queue_steering.rs b/crates/agent_ui/src/conversation_view/thread_view/queue_steering.rs
new file mode 100644
index 0000000..c13c8cf
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/thread_view/queue_steering.rs
@@ -0,0 +1,89 @@
+//! Steer for an ACP agent that takes steering (Zeo next proposal §6.8, ask 29).
+//!
+//! Upstream offers the queue's Steer toggle for Zed's native agent only: it ends the running
+//! turn at its next boundary, then sends the message. An ACP agent that advertises steering
+//! (Claude Agent (Plus), `_session/steering`) can do better — take the message into the
+//! running turn at its next step, without stopping it — so for such an agent the toggle
+//! sends the queued message at once.
+//!
+//! The agent does not echo a steered message back, so the thread shows it from here, once the
+//! agent has it. When the turn ended before the message reached it, the agent takes nothing
+//! and the message goes back to its place in the queue; so does a message whose steer failed,
+//! with the error shown.
+
+use acp_thread::{SteerOutcome, ThreadStatus};
+use gpui::Context;
+
+use super::ThreadView;
+use crate::conversation_view::{QueueEntry, QueueEntryId};
+
+/// Whether a queued message for this connection and thread state is steered at once.
+pub(crate) fn steers_at_once(
+    is_native: bool,
+    supports_steering: bool,
+    status: ThreadStatus,
+) -> bool {
+    !is_native && supports_steering && status == ThreadStatus::Generating
+}
+
+impl ThreadView {
+    /// Sends a queued message into the running turn when the agent takes steering. Returns
+    /// `false`, touching nothing, when it does not apply — Zed's native agent, an agent
+    /// without steering, or no running turn — so the toggle keeps its upstream meaning.
+    pub(super) fn steer_queued_entry(&mut self, id: QueueEntryId, cx: &mut Context<Self>) -> bool {
+        let thread = self.thread.read(cx);
+        let connection = thread.connection().clone();
+        if !steers_at_once(
+            self.as_native_thread(cx).is_some(),
+            connection.supports_steering(),
+            thread.status(),
+        ) {
+            return false;
+        }
+        let session_id = thread.session_id().clone();
+        // Out of the queue while the agent answers, so the queue never sends it a second time.
+        let Some(entry) = self.message_queue.remove(id) else {
+            return false;
+        };
+        let request = connection.steer(&session_id, entry.content.clone(), cx);
+        cx.spawn(async move |this, cx| {
+            let outcome = request.await;
+            this.update(cx, |this, cx| {
+                match outcome {
+                    Ok(SteerOutcome::Delivered) => this.show_steered_message(&entry, cx),
+                    Ok(SteerOutcome::PromptRequired) => this.return_to_queue(entry),
+                    Err(error) => {
+                        log::warn!("steer failed: session={session_id} error={error:#}");
+                        this.return_to_queue(entry);
+                        this.handle_thread_error(error, cx);
+                    }
+                }
+                cx.notify();
+            })
+            .ok();
+        })
+        .detach();
+        cx.notify();
+        true
+    }
+
+    /// The steered message in the thread, where the agent took it.
+    fn show_steered_message(&mut self, entry: &QueueEntry, cx: &mut Context<Self>) {
+        let content = entry.content.clone();
+        self.thread.update(cx, |thread, cx| {
+            for block in content {
+                thread.push_user_content_block(None, block, cx);
+            }
+        });
+    }
+
+    /// Back to its place in the queue, steer off, the queue paused as after any failed send.
+    fn return_to_queue(&mut self, mut entry: QueueEntry) {
+        entry.steer = false;
+        self.message_queue.restore_after_failed_send(entry);
+    }
+}
+
+#[cfg(test)]
+#[path = "queue_steering_tests.rs"]
+mod tests;
diff --git a/crates/agent_ui/src/conversation_view/thread_view/queue_steering_tests.rs b/crates/agent_ui/src/conversation_view/thread_view/queue_steering_tests.rs
