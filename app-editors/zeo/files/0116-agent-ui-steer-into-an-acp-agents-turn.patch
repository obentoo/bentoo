+// Zeo next proposal §6.8 (ask 29): steering, as Claude Agent (Plus) advertises and answers it.
+// Filter: `v1::steering_tests`.
+
+use agent_client_protocol::v1::schema as acp;
+use serde_json::json;
+
+use super::{ZEO_STEERING_CAPABILITY, parse_steer_answer, with_steering_capability};
+
+fn meta(value: serde_json::Value) -> serde_json::Map<String, serde_json::Value> {
+    value.as_object().cloned().expect("an object")
+}
+
+#[test]
+fn top_level_steering_support_is_kept_beside_the_capabilities() {
+    let capabilities = acp::AgentCapabilities::default().meta(meta(json!({
+        "_claude/btw": { "version": 1 },
+    })));
+    let capabilities = with_steering_capability(
+        capabilities,
+        Some(&meta(json!({ "steering": { "supported": true } }))),
+    );
+    let kept = capabilities.meta.expect("meta");
+    assert!(kept.contains_key(ZEO_STEERING_CAPABILITY));
+    // What the agent advertised is left as it was.
+    assert!(kept.contains_key("_claude/btw"));
+}
+
+/// Hostile: anything short of `supported: true` must not offer steering, or the Steer button
+/// sends to an agent that cannot take it.
+#[test]
+fn steering_is_not_assumed() {
+    for initialize_meta in [
+        None,
+        Some(meta(json!({}))),
+        Some(meta(json!({ "steering": {} }))),
+        Some(meta(json!({ "steering": { "supported": false } }))),
+        Some(meta(json!({ "steering": { "supported": "yes" } }))),
+    ] {
+        let capabilities =
+            with_steering_capability(acp::AgentCapabilities::default(), initialize_meta.as_ref());
+        assert!(
+            !capabilities
+                .meta
+                .as_ref()
+                .is_some_and(|meta| meta.contains_key(ZEO_STEERING_CAPABILITY)),
+            "{initialize_meta:?}"
+        );
+    }
+}
+
+#[test]
+fn the_outcomes_read() {
+    use acp_thread::SteerOutcome;
+    assert_eq!(
+        parse_steer_answer(&json!({ "outcome": "injected" })).unwrap(),
+        SteerOutcome::Delivered
+    );
+    assert_eq!(
+        parse_steer_answer(&json!({ "outcome": "startedNewTurn" })).unwrap(),
+        SteerOutcome::Delivered
+    );
+    assert_eq!(
+        parse_steer_answer(&json!({ "outcome": "promptRequired", "reason": "noRunningTurn" }))
+            .unwrap(),
+        SteerOutcome::PromptRequired
+    );
+    assert!(
+        parse_steer_answer(&json!({ "outcome": "later" }))
+            .unwrap_err()
+            .to_string()
+            .contains("unknown outcome")
+    );
+}
