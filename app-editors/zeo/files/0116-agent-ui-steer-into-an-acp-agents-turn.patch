@@ -0,0 +1,27 @@
+// Zeo next proposal §6.8 (ask 29): when the queue's Steer sends at once. Filter:
+// `queue_steering`.
+
+use acp_thread::ThreadStatus;
+
+use super::steers_at_once;
+
+#[test]
+fn an_acp_agent_that_steers_takes_the_message_during_a_turn() {
+    assert!(steers_at_once(false, true, ThreadStatus::Generating));
+}
+
+/// Zed's native agent keeps upstream's Steer (end the turn at its next boundary), even if a
+/// connection ever answered yes.
+#[test]
+fn the_native_agent_keeps_upstreams_steer() {
+    assert!(!steers_at_once(true, true, ThreadStatus::Generating));
+}
+
+/// Hostile: with no running turn there is nothing to steer, and an agent without steering
+/// must never be sent `_session/steering`.
+#[test]
+fn nothing_is_steered_without_a_turn_or_without_support() {
+    assert!(!steers_at_once(false, true, ThreadStatus::Idle));
+    assert!(!steers_at_once(false, true, ThreadStatus::Unconfirmed));
+    assert!(!steers_at_once(false, false, ThreadStatus::Generating));
+}
