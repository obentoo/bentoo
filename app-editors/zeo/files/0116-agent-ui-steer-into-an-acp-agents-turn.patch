+/// `capabilities` with `ZEO_STEERING_CAPABILITY` added when the `initialize` answer's top-level
+/// `_meta` says `steering.supported: true` (Zeo next proposal §6.8). Kept in the capability
+/// map so the connection answers it with `agent_advertises`, like every other extension, and
+/// no new field has to be threaded through each place a connection is built.
+fn with_steering_capability(
+    mut capabilities: acp::AgentCapabilities,
+    initialize_meta: Option<&serde_json::Map<String, serde_json::Value>>,
+) -> acp::AgentCapabilities {
+    let supported = initialize_meta
+        .and_then(|meta| meta.get("steering"))
+        .and_then(|steering| steering.get("supported"))
+        .and_then(|supported| supported.as_bool())
+        == Some(true);
+    if supported {
+        capabilities
+            .meta
+            .get_or_insert_with(Default::default)
+            .insert(ZEO_STEERING_CAPABILITY.to_string(), serde_json::json!({}));
+    }
+    capabilities
+}
+
+/// Reads a `_session/steering` answer. `injected` and `startedNewTurn` both mean the agent has
+/// the message; `promptRequired` means it took nothing because no turn was running.
+fn parse_steer_answer(answer: &serde_json::Value) -> Result<acp_thread::SteerOutcome> {
+    match answer.get("outcome").and_then(|outcome| outcome.as_str()) {
+        Some("injected") | Some("startedNewTurn") => Ok(acp_thread::SteerOutcome::Delivered),
+        Some("promptRequired") => Ok(acp_thread::SteerOutcome::PromptRequired),
+        other => Err(anyhow!(
+            "{STEERING_METHOD} answered an unknown outcome {other:?}"
+        )),
+    }
+}
