+#[test]
+fn agent_jail_host_disks_follow_the_project_and_need_the_host_view() {
+    let on = sandbox(
+        true,
+        false,
+        AgentSandboxProjectSettings {
+            overlay_system: Some(true),
+            ..AgentSandboxProjectSettings::default()
+        },
+    );
+    let switches = host_switches(&on, Some("/p"));
+    assert!(switches.overlay_system && !switches.overlay_disabled);
+    let host_shown = sandbox(
+        true,
+        false,
+        AgentSandboxProjectSettings {
+            mask_host: Some(false),
+            overlay_system: Some(true),
+            ..AgentSandboxProjectSettings::default()
+        },
+    );
+    let switches = host_switches(&host_shown, Some("/p"));
+    assert!(
+        switches.overlay_system && switches.overlay_disabled,
+        "kept as set, but disabled while the host is shown"
+    );
+}
