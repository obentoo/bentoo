@@ -323,6 +323,14 @@ pub fn set_project_mask_host(root: &Path, on: bool, cx: &mut App) -> Task<bool>
     write_entry(root, "mask_host", write, cx)
 }
 
+/// Sets the project's `overlay_system` (ai-jail's --overlay-system; the page's Hide the Disks);
+/// a restart applies it.
+pub fn set_project_overlay_system(root: &Path, on: bool, cx: &mut App) -> Task<bool> {
+    let write =
+        move |entry: &mut AgentSandboxProjectSettingsContent| entry.overlay_system = Some(on);
+    write_entry(root, "overlay_system", write, cx)
+}
+
 /// Writes the project's `capabilities` through `update`, which also sees the default MCP server
 /// list in the file (empty when the file has none, as `default.json` says). A `capabilities`
 /// left with nothing set is removed, so a reset leaves the entry as it was.
diff --git a/crates/agent_sandbox/src/host_view.rs b/crates/agent_sandbox/src/host_view.rs
index 4d083f3..e5302f8 100644
--- a/crates/agent_sandbox/src/host_view.rs
+++ b/crates/agent_sandbox/src/host_view.rs
@@ -36,6 +36,16 @@
 //! --show`, `df`, `lscpu`, node, python, git and cargo still run); the kernel-version files and
 //! os-release need content, so they wait for ai-jail.
 //!
+//! ai-jail 3.5.0-r3 adds the identity layer under `--mask-host` (§4.2): the kernel's build
+//! strings without suffix or date, a generic os-release, a swap table with no swap, its own boot
+//! id, a time namespace that starts `CLOCK_BOOTTIME` and `sysinfo().uptime` at the launch, CPU
+//! topology files. There Zeo leaves swap and the boot id to it ([`IDENTITY_LAYER_MASKS`]); the
+//! rest of [`HOST_MASKS`] stays for older binaries and costs nothing twice. Its
+//! `--overlay-system` serves `/usr`, `/etc` and `/opt` through read-only overlays, so the mount
+//! table names no host disk for them; it is a switch of its own (`agent_sandbox.overlay_system`,
+//! off by default) because an overlay slows metadata walks (+21 % on a `find` over `/usr`) and
+//! its cost on a real build has not been measured.
+//!
 //! This hides, it does not isolate: `cpuid`, timing, `uname(2)`, `sysinfo(2)` and mount sources
 //! stay visible short of a VM. The writable mounts' sources (the project's disk and subvolume)
 //! stay visible by decision (operator, 2026-11-23): hiding them needs root on the host.
@@ -80,6 +90,26 @@ pub const MACHINE_ID: &str = "/etc/machine-id";
 /// ai-jail's option for the synthetic host view (§6.63 step 2).
 pub const MASK_HOST_OPTION: &str = "--mask-host";
 
+/// ai-jail's option for read-only overlays over `/usr`, `/etc` and `/opt` under `--mask-host`
+/// (docs/HOST-VIEW-EXTRA-LAYER.md §4.2), so the mount table names no host disk for them.
+pub const OVERLAY_SYSTEM_OPTION: &str = "--overlay-system";
+
+/// Masks `--mask-host` gives better answers for once ai-jail has its identity layer (3.5.0-r3,
+/// the release that brings `--overlay-system`): a swap table with its header instead of an empty
+/// file, and a boot id of the jail's own instead of none. Zeo's `--mask` lands after ai-jail's
+/// view, so it would replace them; it is left out there.
+pub const IDENTITY_LAYER_MASKS: [&str; 2] = ["/proc/swaps", "/proc/sys/kernel/random/boot_id"];
+
+/// What the installed ai-jail's host view can do beyond `--mask-host` itself.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct HostLayer {
+    /// The identity layer (kernel strings, os-release, swap, boot id, a time namespace) rides
+    /// `--mask-host`; ai-jail 3.5.0-r3 and later.
+    pub identity: bool,
+    /// The project asks for `--overlay-system` (only with `mask_host`).
+    pub overlay_system: bool,
+}
+
 /// The variable Claude Code reads to load the account's claude.ai connectors. They are reached
 /// through `mcp-proxy.anthropic.com`, so a jail that allows `anthropic.com` would let every one
 /// of them past `allow_hosts`; jails set it to `false` unless the project turns them on.
@@ -89,9 +119,21 @@ pub const CONNECTORS_ENV: &str = "ENABLE_CLAUDEAI_MCP_SERVERS";
 /// missing one and applies nothing). `exists` is the file-system check, a parameter so the rule
 /// is tested without this machine's `/etc`.
 pub fn host_args(mask_host: bool, exists: impl Fn(&Path) -> bool) -> Vec<String> {
+    host_args_for(mask_host, HostLayer::default(), exists)
+}
+
+/// [`host_args`] for an ai-jail whose host view has `layer`: under `mask_host`, the masks its
+/// identity layer covers are left to it, and `--overlay-system` follows `--mask-host`.
+pub fn host_args_for(
+    mask_host: bool,
+    layer: HostLayer,
+    exists: impl Fn(&Path) -> bool,
+) -> Vec<String> {
     let mut paths: Vec<&str> = HOST_MASKS.to_vec();
     if !mask_host {
         paths.push(MACHINE_ID);
+    } else if layer.identity {
+        paths.retain(|path| !IDENTITY_LAYER_MASKS.contains(path));
     }
     let mut args = Vec::new();
     for path in paths {
@@ -101,6 +143,9 @@ pub fn host_args(mask_host: bool, exists: impl Fn(&Path) -> bool) -> Vec<String>
     }
     if mask_host {
         args.push(MASK_HOST_OPTION.to_string());
+        if layer.overlay_system {
+            args.push(OVERLAY_SYSTEM_OPTION.to_string());
+        }
     }
     args
 }
diff --git a/crates/agent_sandbox/src/host_view_layer_tests.rs b/crates/agent_sandbox/src/host_view_layer_tests.rs
new file mode 100644
index 0000000..d0535e5
--- /dev/null
+++ b/crates/agent_sandbox/src/host_view_layer_tests.rs
@@ -0,0 +1,134 @@
+// docs/HOST-VIEW-EXTRA-LAYER.md §4.4: what a jailed start passes an ai-jail whose host view has
+// the identity layer (3.5.0-r3, which brings --overlay-system). Filter: `host_view_layer`.
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use crate::host_view::{IDENTITY_LAYER_MASKS, MASK_HOST_OPTION, OVERLAY_SYSTEM_OPTION};
+use crate::launch_tests::*;
+
+/// The fork's 3.5.0-r2 options; `layer` adds `--overlay-system`, as 3.5.0-r3 does.
+fn help(layer: bool) -> String {
+    let layer = if layer {
+        "    --overlay-system  Overlays\\n"
+    } else {
+        ""
+    };
+    format!(
+        "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n    --cpus <LIST>  Pin CPUs\\n    --mask-host  Synthetic host view\\n{layer}' ;; *) echo 'ai-jail 3.5.0' ;; esac"
+    )
+}
+
+fn settings(f: &Fixture, project: Value) -> Value {
+    let mut value = sandbox(f, true, project, memory_off());
+    value["agent_sandbox"]["state_root"] = json!(f.base.join("state"));
+    value
+}
+
+fn before_separator(args: &[String]) -> &[String] {
+    let separator = args.iter().position(|arg| arg == "--").expect("`--`");
+    &args[..separator]
+}
+
+fn has(args: &[String], flag: &str) -> bool {
+    before_separator(args).iter().any(|arg| arg == flag)
+}
+
+#[gpui::test]
+async fn host_view_layer_passes_overlay_system_after_mask_host(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "overlay_system": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let args = before_separator(&cmd.args);
+    let mask = args.iter().position(|a| a == MASK_HOST_OPTION);
+    let overlay = args.iter().position(|a| a == OVERLAY_SYSTEM_OPTION);
+    assert!(
+        mask.is_some() && overlay > mask,
+        "--overlay-system follows --mask-host: {args:?}"
+    );
+}
+
+#[gpui::test]
+async fn host_view_layer_refuses_overlay_system_without_the_option(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "overlay_system": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        text.contains("--overlay-system"),
+        "says what is missing: {text}"
+    );
+}
+
+/// Off by default: an older ai-jail still starts.
+#[gpui::test]
+async fn host_view_layer_overlay_is_off_by_default(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(!has(&cmd.args, OVERLAY_SYSTEM_OPTION), "{:?}", cmd.args);
+}
+
+#[gpui::test]
+async fn host_view_layer_overlay_needs_the_host_view(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": false, "overlay_system": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        !has(&cmd.args, OVERLAY_SYSTEM_OPTION) && !has(&cmd.args, MASK_HOST_OPTION),
+        "without the host view the overlays are not asked for: {:?}",
+        cmd.args
+    );
+}
+
+/// The identity layer writes a swap table and a boot id of the jail's own; Zeo's empty masks
+/// would land on top of them, so they are left out there, and only there.
+async fn identity_masks(layer: bool, cx: &mut TestAppContext) -> Vec<String> {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(layer));
+    set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    cmd.args
+}
+
+#[gpui::test]
+async fn host_view_layer_leaves_swap_and_boot_id_to_the_identity_layer(cx: &mut TestAppContext) {
+    let args = identity_masks(true, cx).await;
+    for path in IDENTITY_LAYER_MASKS {
+        assert_eq!(count(&args, "--mask", path), 0, "{path}: {args:?}");
+    }
+}
+
+#[gpui::test]
+async fn host_view_layer_keeps_swap_and_boot_id_masks_for_an_older_ai_jail(
+    cx: &mut TestAppContext,
+) {
+    let args = identity_masks(false, cx).await;
+    for path in IDENTITY_LAYER_MASKS {
+        if std::path::Path::new(path).exists() {
+            assert_eq!(count(&args, "--mask", path), 1, "{path}: {args:?}");
+        }
+    }
+}
