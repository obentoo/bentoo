index e1c80e2..bd5a891 100644
--- a/crates/agent_sandbox/src/host_view_tests.rs
+++ b/crates/agent_sandbox/src/host_view_tests.rs
@@ -159,3 +159,53 @@ fn host_view_is_not_fooled_by_dot_dot_or_a_shared_prefix() {
     let args = vec!["/w/app2/x.js".to_string()];
     assert!(hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()).is_some());
 }
+
+/// ai-jail 3.5.0-r3's identity layer (docs/HOST-VIEW-EXTRA-LAYER.md §4.2) gives swap and the boot
+/// id better answers than an empty mask, so they are left to it under `mask_host`, and only there.
+#[test]
+fn host_view_identity_layer_takes_over_swap_and_the_boot_id() {
+    let layer = HostLayer {
+        identity: true,
+        overlay_system: false,
+    };
+    let with_layer = host_args_for(true, layer, all_exist);
+    for path in IDENTITY_LAYER_MASKS {
+        assert!(
+            !with_layer.contains(&path.to_string()),
+            "{path}: {with_layer:?}"
+        );
+    }
+    assert!(with_layer.contains(&"/etc/crypttab".to_string()));
+    let shown = host_args_for(false, layer, all_exist);
+    for path in IDENTITY_LAYER_MASKS {
+        assert!(
+            shown.contains(&path.to_string()),
+            "masked without --mask-host: {path}"
+        );
+    }
+    assert_eq!(
+        host_args(true, all_exist),
+        host_args_for(true, HostLayer::default(), all_exist)
+    );
+}
+
+#[test]
+fn host_view_overlay_system_rides_mask_host_only() {
+    let layer = HostLayer {
+        identity: true,
+        overlay_system: true,
+    };
+    let args = host_args_for(true, layer, all_exist);
+    assert_eq!(
+        &args[args.len() - 2..],
+        [
+            MASK_HOST_OPTION.to_string(),
+            OVERLAY_SYSTEM_OPTION.to_string()
+        ]
+    );
+    let shown = host_args_for(false, layer, all_exist);
+    assert!(
+        !shown.contains(&OVERLAY_SYSTEM_OPTION.to_string()),
+        "{shown:?}"
+    );
+}
