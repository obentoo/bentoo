@@ -0,0 +1,113 @@
+//! A status bar button that opens a remote project (Zeo next proposal §6.36, ask 59).
+//!
+//! Zed reaches its remote projects modal only through the title bar's project menu or the
+//! command palette (`projects::OpenRemote`). The operator asked for it beside the other
+//! status bar buttons. It is upstream's own action, so the button adds no behaviour of its
+//! own; `status_bar.remote_projects_button` hides it, and so does the status bar's
+//! right-click "Hide" through `hide_setting`.
+
+use gpui::App;
+use settings::{Settings as _, SettingsContent};
+use ui::{Context, IconButton, IconName, IconSize, Render, Tooltip, Window, prelude::*};
+use workspace::{HideStatusItem, ItemHandle, StatusBarSettings, StatusItemView};
+use zed_actions::OpenRemote;
+
+/// The tooltip, shared with the tests.
+pub const REMOTE_PROJECTS_BUTTON_TOOLTIP: &str = "Open Remote Project";
+
+/// The action the button dispatches: upstream's modal, in the current window.
+fn open_remote_action() -> OpenRemote {
+    OpenRemote {
+        from_existing_connection: false,
+        create_new_window: None,
+    }
+}
+
+/// Writes the hidden state, for the status bar's "Hide" entry.
+fn hide_remote_projects_button(settings: &mut SettingsContent) {
+    settings
+        .status_bar
+        .get_or_insert_default()
+        .remote_projects_button = Some(false);
+}
+
+#[derive(Default)]
+pub struct RemoteProjectsButton;
+
+impl RemoteProjectsButton {
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl Render for RemoteProjectsButton {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let button = div();
+        if !StatusBarSettings::get_global(cx).remote_projects_button {
+            return button.hidden();
+        }
+        button.child(
+            IconButton::new("remote-projects-button", IconName::Server)
+                .icon_size(IconSize::Small)
+                .aria_label(REMOTE_PROJECTS_BUTTON_TOOLTIP)
+                .tooltip(|_window, cx| {
+                    Tooltip::for_action(REMOTE_PROJECTS_BUTTON_TOOLTIP, &open_remote_action(), cx)
+                })
+                .on_click(|_, window, cx| {
+                    window.dispatch_action(Box::new(open_remote_action()), cx);
+                }),
+        )
+    }
+}
+
+impl StatusItemView for RemoteProjectsButton {
+    fn set_active_pane_item(
+        &mut self,
+        _active_pane_item: Option<&dyn ItemHandle>,
+        _window: &mut Window,
+        _cx: &mut Context<Self>,
+    ) {
+        // The button does not depend on the active item.
+    }
+
+    fn hide_setting(&self, _: &App) -> Option<HideStatusItem> {
+        Some(HideStatusItem::new(hide_remote_projects_button))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hiding_writes_the_status_bar_setting() {
+        let mut settings = SettingsContent::default();
+        hide_remote_projects_button(&mut settings);
+        assert_eq!(
+            settings
+                .status_bar
+                .as_ref()
+                .and_then(|status_bar| status_bar.remote_projects_button),
+            Some(false)
+        );
+    }
+
+    /// Hostile: the button must open the modal in place, not a new window or an existing
+    /// connection's picker.
+    #[test]
+    fn the_button_opens_the_remote_modal_in_this_window() {
+        let action = open_remote_action();
+        assert!(!action.from_existing_connection);
+        assert_eq!(action.create_new_window, None);
+    }
+
+    #[gpui::test]
+    fn the_button_shows_by_default(cx: &mut gpui::TestAppContext) {
+        cx.update(|cx| {
+            let store = settings::SettingsStore::test(cx);
+            cx.set_global(store);
+            StatusBarSettings::register(cx);
+            assert!(StatusBarSettings::get_global(cx).remote_projects_button);
+        });
+    }
+}
