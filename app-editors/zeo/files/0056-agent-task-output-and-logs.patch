+// Story 041, task 7.2 — "Open Log" on a history row is refused when the panel's project is remote
+// (R5.11; Q5, Q16). Module path: `panel::open_log_remote`. Wired in `src/panel.rs`, beside 7.1's
+// `open_log` module:
+//
+//     #[cfg(test)]
+//     #[path = "panel/open_log_remote_tests.rs"]
+//     mod open_log_remote;
+//
+// Validation filter: `cargo test -p agent_tasks_panel open_log` (every test name below contains
+// `open_log`).
+//
+// The remote seam, stated plainly: a real `Project` switched into its non-local client state by
+// `Project::mark_as_collab_for_testing()` (project test-support, already used by
+// `agent_panel.rs`'s own tests). After it `is_local()` is false and `is_remote()` true, through
+// the project's real client state, not a stubbed predicate. It is NOT the SSH shape
+// (`is_via_remote_server()` stays false): this crate has no `proto` dependency to answer the
+// mock transport's connect `Ping`, and the card-side file
+// (`agent_ui/src/tasks_card/open_log_remote_tests.rs`) already proves the SSH shape over a real
+// `Project::remote`. Together they pin the guard as design.md words it — "checks whether the
+// workspace's project is local" — so a guard written as `is_via_remote_server()` alone fails here.
+// If Run mode adds `proto` as a dev-dependency, an SSH-shaped variant of test 1 may be added; do
+// not replace this one.
+//
+// Contract (design.md §Agent Tasks panel, "Remote projects (R5.11)"): when the panel's workspace
+// project is remote, `open_log` calls `set_notice(key, "Open Log is not available in remote
+// projects", cx)` and opens nothing, BEFORE any filesystem check. Beyond it, this file assumes
+// what 7.1's `open_log_tests.rs` assumes: `AgentTasksPanel::open_log(&key, window, cx)`,
+// `PanelRow::can_open_log`, `agent_ui::task_log::{LogsRootOverride, log_path, write_log}`, and
+// the `test_helpers` (`init_base`, `record`, `open_panels`, `find_row`, `notice_of`, `key`, `sid`).
+//
+// Order: hostile halves first —
+//   1. remote, log file present: the notice, no tab (the "wrongly opens" half);
+//   2. remote, log file GONE: still the remote notice, never "Log no longer available" — the
+//      check comes before the filesystem is consulted (a guard placed after `is_file()` collapses
+//      the two notices into the wrong one);
+// then the converse —
+//   3. local: the same row opens its log read-only with no notice.
+//
+// Red, before 7.2: tests 1 and 2 fail on the notice assertion (the panel opens the log, or says
+// "Log no longer available"). Test 3 is the guard against an over-broad fix and may already pass
+// after 7.1.
+
+use std::path::{Path, PathBuf};
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use agent_ui::task_log::{LogsRootOverride, log_path, write_log};
+use gpui::TestAppContext;
+
+use crate::test_helpers::*;
+
+const REMOTE_NOTICE: &str = "Open Log is not available in remote projects";
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-panel-log-remote-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Records (s1, t1) ended, with a saved log of `text`, before the panel loads.
+async fn seed(root: &Path, text: &str, cx: &mut TestAppContext) -> PathBuf {
+    let db = init_base(cx);
+    let root_owned = root.to_path_buf();
+    cx.update(|cx| cx.set_global(LogsRootOverride(root_owned)));
+    db.insert_started(&record("s1", "t1", AgentTaskStatus::Running, 1_000))
+        .await
+        .unwrap();
+    db.update_ended(&record("s1", "t1", AgentTaskStatus::Completed, 1_000))
+        .await
+        .unwrap();
+    let path = log_path(root, "s1", "t1");
+    let bytes = write_log(&path, text).expect("seed the log");
+    db.set_log_bytes(
+        &sid("s1"),
+        &AgentTaskId::from("t1".to_string()),
+        Some(bytes),
+    )
+    .await
+    .unwrap();
+    path
+}
+
+/// The workspace opens through its project's FakeFs: seed a copy there too, so an unguarded
+/// open in tests 1 and 3 really can show the text.
+async fn seed_fake_copy(panels: &mut Panels, path: &Path, text: &str) {
+    let fs = panels.cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    fs.create_dir(path.parent().unwrap()).await.unwrap();
+    fs.as_fake()
+        .insert_file(path, text.as_bytes().to_vec())
+        .await;
+}
+
+fn make_project_remote(panels: &mut Panels) {
+    let workspace = panels.workspace.clone();
+    let project = workspace.update(&mut panels.cx, |workspace, _| workspace.project().clone());
+    project.update(&mut panels.cx, |project, _| {
+        project.mark_as_collab_for_testing()
+    });
+    project.update(&mut panels.cx, |project, _| {
+        assert!(
+            !project.is_local(),
+            "the rig must make the panel's project non-local"
+        );
+    });
+}
+
+fn active_editor(panels: &mut Panels) -> Option<(bool, String)> {
+    let workspace = panels.workspace.clone();
+    workspace.update(&mut panels.cx, |workspace, cx| {
+        workspace
+            .active_item_as::<editor::Editor>(cx)
+            .map(|editor| {
+                let editor = editor.read(cx);
+                (editor.read_only(cx), editor.text(cx))
+            })
+    })
+}
+
+fn open_log(panels: &mut Panels) {
+    let panel = panels.tasks_panel.clone();
+    let key = key("s1", "t1");
+    panel.update_in(&mut panels.cx, |panel, window, cx| {
+        panel.open_log(&key, window, cx)
+    });
+    panels.cx.run_until_parked();
+}
+
+fn notice(panels: &mut Panels) -> Option<String> {
+    let panel = panels.tasks_panel.clone();
+    notice_of(&panel, &sid("s1"), "t1", &mut panels.cx).map(|notice| notice.to_string())
+}
+
+// ---- 1. Hostile: a remote project, the log present — open nothing, say why ----------------
+
+#[gpui::test]
+async fn open_log_in_a_remote_project_shows_the_notice_and_opens_nothing(cx: &mut TestAppContext) {
+    let scratch = Scratch::new("remote");
+    let path = seed(&scratch.root(), "REMOTE-PANEL-LOG\n", cx).await;
+    let mut panels = open_panels(cx).await;
+    seed_fake_copy(&mut panels, &path, "REMOTE-PANEL-LOG\n").await;
+    make_project_remote(&mut panels);
+    let before = active_editor(&mut panels);
+
+    open_log(&mut panels);
+
+    assert_eq!(notice(&mut panels).as_deref(), Some(REMOTE_NOTICE));
+    assert_eq!(active_editor(&mut panels), before, "no tab opened");
+    assert!(path.is_file(), "refusing never touches the saved log");
+}
+
+// ---- 2. Hostile: a remote project, the log gone — the remote check comes first -------------
+
+#[gpui::test]
+async fn open_log_in_a_remote_project_refuses_before_checking_the_file(cx: &mut TestAppContext) {
+    let scratch = Scratch::new("remote-missing");
+    let path = seed(&scratch.root(), "gone\n", cx).await;
+    let mut panels = open_panels(cx).await;
+    make_project_remote(&mut panels);
+    std::fs::remove_file(&path).unwrap();
+    let before = active_editor(&mut panels);
+
+    open_log(&mut panels);
+
+    let notice = notice(&mut panels);
+    assert_ne!(
+        notice.as_deref(),
+        Some("Log no longer available"),
+        "the remote check runs before any filesystem check"
+    );
+    assert_eq!(notice.as_deref(), Some(REMOTE_NOTICE));
+    assert_eq!(active_editor(&mut panels), before, "no tab opened");
+}
+
+// ---- 3. Converse: the same row in a local project opens its log ----------------------------
+
+#[gpui::test]
+async fn open_log_in_a_local_project_still_opens_the_log_read_only(cx: &mut TestAppContext) {
+    let scratch = Scratch::new("local");
+    let path = seed(&scratch.root(), "LOCAL-PANEL-LOG\n", cx).await;
+    let mut panels = open_panels(cx).await;
+    seed_fake_copy(&mut panels, &path, "LOCAL-PANEL-LOG\n").await;
+    let workspace = panels.workspace.clone();
+    let project = workspace.update(&mut panels.cx, |workspace, _| workspace.project().clone());
+    project.update(&mut panels.cx, |project, _| assert!(project.is_local()));
+
+    open_log(&mut panels);
+
+    let (read_only, text) = active_editor(&mut panels).expect("an editor tab opened");
+    assert!(read_only, "the saved log opens read-only");
+    assert_eq!(text, "LOCAL-PANEL-LOG\n");
+    assert_eq!(notice(&mut panels), None, "a local project gets no notice");
+}
