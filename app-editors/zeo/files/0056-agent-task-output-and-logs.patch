+    let output = thread
+        .update(cx, |thread, cx| {
+            thread.fetch_task_output(&acp_thread::AgentTaskId::from("b1".to_string()), cx)
+        })
+        .await
+        .expect("the thread's fetch reaches the agent");
+    assert!(output.truncated);
+    assert_eq!(task_actions_requests(&peer).len(), 1);
+}
