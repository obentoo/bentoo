+    let output = out("line 1\nline 2\n", false);
+    connection.answer(&sa, "t1", Ok(output.clone()));
+    let path = log_path(&scratch.root(), &sa.to_string(), "t1");
+    let rendered = render_log(&output);
+    seed_fake_copy(&path, &rendered, &mut cx).await;
+    let card = card(&panel, &cx);
