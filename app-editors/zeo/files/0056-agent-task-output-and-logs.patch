+fn use_scratch_logs_root(root: &Path, cx: &mut VisualTestContext) {
+    let root = root.to_path_buf();
+    cx.update(|_, cx| cx.set_global(LogsRootOverride(root)));
+}
+
+fn open_thread(
+    panel: &Entity<crate::AgentPanel>,
+    connection: &OutputConnection,
+    title: &str,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    open_thread_with_custom_connection(panel, connection.clone(), cx);
+    let thread = panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    send_info(&thread, acp::SessionInfoUpdate::new().title(title), cx);
