+// ---- 1. Hostile: a remote project opens nothing and says why -------------------------------
+
+#[gpui::test]
+async fn test_open_log_in_a_remote_project_shows_the_notice_and_opens_nothing(
+    cx: &mut TestAppContext,
+    server_cx: &mut TestAppContext,
+) {
+    let (panel, workspace, host, mut cx) = setup_remote_card_panel(cx, server_cx).await;
+    let scratch = Scratch::new("remote");
+    use_scratch_logs_root(&scratch.root(), &mut cx);
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![shell("t1", "running"), shell("t2", "running")],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    connection.answer(&sa, "t1", out("REMOTE-PROJECT-LOG\n"));
+    connection.answer(&sa, "t2", out("sibling\n"));
+    let card = card(&panel, &cx);
+    let path = log_path(&scratch.root(), &sa.to_string(), "t1");
+    let before = active_editor(&workspace, &mut cx);
+
+    open_log(&card, &sa, "t1", &mut cx);
+
+    let error = find_row(&card, &sa, "t1", &mut cx)
+        .expect("t1 is listed")
+        .error
+        .map(|error| error.to_string());
+    assert_eq!(
+        error.as_deref(),
+        Some(REMOTE_NOTICE),
+        "the row says Open Log is refused, not an open failure"
+    );
+    let path_text = path.to_string_lossy().to_string();
+    let root_text = scratch.root().to_string_lossy().to_string();
+    let leaked: Vec<String> = host
+        .asked()
+        .into_iter()
+        .filter(|asked| asked == &path_text || asked.starts_with(&root_text))
+        .collect();
+    assert!(
+        leaked.is_empty(),
+        "the local log path must never be resolved on the remote host: {leaked:?}"
+    );
+    assert_eq!(active_editor(&workspace, &mut cx), before, "no tab opened");
+    assert!(
+        find_row(&card, &sa, "t2", &mut cx)
+            .expect("t2 is listed")
+            .error
+            .is_none(),
+        "the notice lands on the row that asked, not on its sibling"
+    );
+}
+
+// ---- 2. Hostile: the refusal does not reach the copy on end --------------------------------
+
+#[gpui::test]
+async fn test_open_log_remote_project_still_copies_an_ended_shell_log(
+    cx: &mut TestAppContext,
+    server_cx: &mut TestAppContext,
+) {
+    let (panel, workspace, _host, mut cx) = setup_remote_card_panel(cx, server_cx).await;
+    let scratch = Scratch::new("remote-copy");
+    use_scratch_logs_root(&scratch.root(), &mut cx);
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    let sa = session_of(&a, &cx);
+    let output = out("ended in a remote project\n");
+    connection.answer(&sa, "t1", output.clone());
+    let card = card(&panel, &cx);
+    let before = active_editor(&workspace, &mut cx);
+
+    send_tasks(&a, vec![shell("t1", "completed")], &mut cx);
+    send_tasks(&a, vec![], &mut cx);
+
+    let path = log_path(&scratch.root(), &sa.to_string(), "t1");
+    assert_eq!(
+        std::fs::read_to_string(&path).ok().as_deref(),
+        Some(render_log(&output).as_str()),
+        "the copy on end still saves the log locally in a remote project"
+    );
+    assert_eq!(
+        active_editor(&workspace, &mut cx),
+        before,
+        "the copy opens nothing"
+    );
+    if let Some(row) = find_row(&card, &sa, "t1", &mut cx) {
+        assert!(row.error.is_none(), "nobody asked, so the row says nothing");
+    }
+}
+
+// ---- 3. Converse: the same row in a local project opens its log ----------------------------
+
+#[gpui::test]
+async fn test_open_log_in_a_local_project_still_opens_the_log_read_only(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let project = workspace.update(&mut cx, |workspace, _| workspace.project().clone());
+    project.read_with(&cx, |project, _| assert!(project.is_local()));
+    let scratch = Scratch::new("local");
+    use_scratch_logs_root(&scratch.root(), &mut cx);
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    let sa = session_of(&a, &cx);
+    let output = out("LOCAL-PROJECT-LOG\n");
+    connection.answer(&sa, "t1", output.clone());
+    let path = log_path(&scratch.root(), &sa.to_string(), "t1");
+    let rendered = render_log(&output);
+    // The workspace opens through its FakeFs, the card writes the real disk (as in 6.2).
+    let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    fs.create_dir(path.parent().unwrap()).await.unwrap();
+    fs.as_fake()
+        .insert_file(&path, rendered.as_bytes().to_vec())
+        .await;
+    let card = card(&panel, &cx);
+
+    open_log(&card, &sa, "t1", &mut cx);
+
+    let (read_only, text) = active_editor(&workspace, &mut cx).expect("an editor tab opened");
+    assert!(read_only, "the log opens read-only");
+    assert_eq!(text, rendered);
+    let error = find_row(&card, &sa, "t1", &mut cx)
+        .expect("t1 is listed")
+        .error;
+    assert!(
+        error.is_none(),
+        "a local project is never told Open Log is unavailable: {error:?}"
+    );
+}
