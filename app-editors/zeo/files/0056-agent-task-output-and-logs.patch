+// ---- R4.2–R4.5 — expand and collapse --------------------------------------------------------
+
+#[gpui::test]
+async fn test_expand_shows_what_runs_details_and_tail_then_collapses(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
