+}
+
+fn shell(id: &str, status: &str, has_output: bool) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, 1_000);
+    task["hasOutput"] = json!(has_output);
+    task["tail"] = json!(null);
+    task
+}
+
+fn subagent(id: &str, status: &str) -> serde_json::Value {
+    let mut task = wire_task(id, status, false, 1_000);
+    task["type"] = json!("subagent");
+    task["hasOutput"] = json!(false);
+    task["tail"] = json!(null);
+    task
+}
+
+fn out(content: &str, truncated: bool) -> TaskOutput {
+    TaskOutput {
+        content: content.to_string(),
+        total_bytes: if truncated {
+            3 * 1_048_576
+        } else {
+            content.len() as u64
+        },
+        truncated,
+    }
+}
+
+/// Every event the card emits, as text: `saved:<task>:<bytes>`, `open:<task>:<path>`.
+fn record_events(card: &Entity<TasksCard>, cx: &mut VisualTestContext) -> Rc<RefCell<Vec<String>>> {
+    let events = Rc::new(RefCell::new(Vec::new()));
+    let sink = events.clone();
+    cx.update(|_, cx| {
+        cx.subscribe(card, move |_, event: &TasksCardEvent, _| {
+            let text = match event {
+                TasksCardEvent::TaskLogSaved { task_id, bytes, .. } => format!(
+                    "saved:{task_id}:{}",
+                    bytes.map_or("none".to_string(), |b| b.to_string())
+                ),
+                TasksCardEvent::OpenLog { task_id, path, .. } => {
+                    format!("open:{task_id}:{}", path.display())
+                }
+                _ => return,
+            };
+            sink.borrow_mut().push(text);
+        })
+        .detach()
+    });
+    events
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn mode(path: &Path) -> u32 {
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::metadata(path).unwrap().permissions().mode() & 0o777
