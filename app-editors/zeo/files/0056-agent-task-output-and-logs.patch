+/// Reads a `_claude/tasks/output` result strictly: a missing or wrong-typed field is an
+/// error naming it, never a default value.
+fn parse_task_output(response: &serde_json::Value) -> Result<acp_thread::TaskOutput> {
+    let field = |name: &str| {
+        response
+            .get(name)
+            .ok_or_else(|| anyhow!("the response has no `{name}`"))
+    };
+    let content = field("content")?
+        .as_str()
+        .ok_or_else(|| anyhow!("`content` is not a string"))?
+        .to_string();
+    let total_bytes = field("totalBytes")?
+        .as_u64()
+        .ok_or_else(|| anyhow!("`totalBytes` is not a non-negative integer"))?;
+    let truncated = field("truncated")?
+        .as_bool()
+        .ok_or_else(|| anyhow!("`truncated` is not a boolean"))?;
+    Ok(acp_thread::TaskOutput {
+        content,
+        total_bytes,
+        truncated,
+    })
+}
