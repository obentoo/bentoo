+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn painted(selector: &'static str, cx: &mut VisualTestContext) -> bool {
+    draw(cx);
+    cx.debug_bounds(selector).is_some()
+}
+
+fn shell(id: &str, tail: Option<&[&str]>, started_at: u64) -> serde_json::Value {
+    let mut task = wire_task(id, "running", true, started_at);
+    task["tail"] = tail.map_or(json!(null), |lines| json!(lines));
+    task["hasOutput"] = json!(tail.is_some());
+    task
+}
+
+fn push_tool_call(thread: &Entity<AcpThread>, id: &str, title: &str, cx: &mut VisualTestContext) {
+    thread.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(
+                acp::SessionUpdate::ToolCall(acp::ToolCall::new(id.to_string(), title.to_string())),
+                cx,
+            )
+            .expect("tool call applies");
+    });
+    cx.run_until_parked();
+}
+
+fn aria_labels() -> Vec<String> {
+    RENDERED_ARIA_LABELS.with(|labels| labels.borrow().iter().map(|l| l.to_string()).collect())
+}
+
+fn reachable_by_tab(handle: &FocusHandle, cx: &mut VisualTestContext) -> bool {
+    for _ in 0..200 {
+        cx.update(|window, cx| window.focus_next(cx));
+        draw(cx);
+        if cx.update(|window, _| handle.is_focused(window)) {
+            return true;
+        }
+    }
+    false
+}
