+}
+
+// Hostile: each missing or mistyped field is an error naming it, never a default.
+#[gpui::test]
+async fn test_tasks_task_output_strict_response_names_the_missing_field(
+    cx: &mut gpui::TestAppContext,
+) {
+    let full = serde_json::json!({ "content": "x\n", "totalBytes": 2, "truncated": false });
+    for field in ["content", "totalBytes", "truncated"] {
+        let mut partial = full.clone();
+        partial.as_object_mut().unwrap().remove(field);
+        let peer = connect_task_actions_peer(
+            PLUS_ENTRY,
+            PLUS_NAME,
+            tasks_capability_v(2),
+            task_output_reply(partial),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+        let text = format!(
+            "{:#}",
+            fetch(&peer, &session_id, "b1", cx).await.unwrap_err()
+        );
+        assert!(text.contains(field), "missing {field}: {text}");
+    }
+    for bad in [
+        serde_json::json!({ "content": 5, "totalBytes": 2, "truncated": false }),
+        serde_json::json!({ "content": "x", "totalBytes": -1, "truncated": false }),
+        serde_json::json!({ "content": "x", "totalBytes": "2", "truncated": false }),
+        serde_json::json!({ "content": "x", "totalBytes": 2, "truncated": "no" }),
+    ] {
+        let peer = connect_task_actions_peer(
+            PLUS_ENTRY,
+            PLUS_NAME,
+            tasks_capability_v(2),
+            task_output_reply(bad.clone()),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+        assert!(fetch(&peer, &session_id, "b1", cx).await.is_err(), "{bad}");
+    }
+}
+
+// The thread delegates to its connection.
+#[gpui::test]
+async fn test_tasks_task_output_thread_delegates_to_the_connection(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(2),
