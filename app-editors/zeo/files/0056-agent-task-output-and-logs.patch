+/// A store over `name`'s database holding `finished` tasks, the ones in `archived` archived, and
+/// registered with the rig's real card. `on_fallback` stands for `db::ALL_FILE_DB_FAILED`.
+async fn seeded_store(
+    name: &'static str,
+    finished: &[(&str, &str)],
+    archived: &[(&str, &str)],
+    on_fallback: bool,
+    root: &Path,
+    cx: &mut TestAppContext,
+) -> (AgentTaskHistoryDb, Entity<TaskHistoryStore>, CardRig) {
+    let mut rig = card_rig(cx).await;
+    use_scratch_logs_root(root, cx);
+    let db = AgentTaskHistoryDb::open_test_db(name).await;
+    for (index, (session, task)) in finished.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    let keys: Vec<_> = archived.iter().map(|(s, t)| key(s, t)).collect();
+    db.set_archived(&keys, true).await.unwrap();
+    let store = rig
+        .cx
+        .new(|cx| TaskHistoryStore::with_fallback_flag(db.clone(), on_fallback, cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    (db, store, rig)
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn saved(
+    card: &Entity<agent_ui::TasksCard>,
+    session: &str,
+    task: &str,
+    bytes: u64,
+    cx: &mut VisualTestContext,
+) {
+    card.update(cx, |_, cx| {
+        cx.emit(TasksCardEvent::TaskLogSaved {
+            session_id: sid(session),
+            task_id: AgentTaskId::from(task.to_string()),
+            bytes: Some(bytes),
+        })
+    });
+    cx.run_until_parked();
+}
