diff --git a/crates/acp_thread/src/acp_thread_tasks_child_session_tests.rs b/crates/acp_thread/src/acp_thread_tasks_child_session_tests.rs
new file mode 100644
index 0000000..8e098f2
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_tasks_child_session_tests.rs
@@ -0,0 +1,153 @@
+// Story 064, task 2.1 (feed half) — `childSessionId` on a `_claude/tasks` entry (contract v3, story
+// 065): parsed into `AgentTask::child_session_id` when present, absent from v2 and earlier, and a
+// malformed value is ignored, never an error (R3.1, R3.2).
+//
+// Included at the end of `mod tests` in `acp_thread.rs`, AFTER the contract file:
+//
+//     include!("acp_thread_tasks_v2_tests.rs");
+//     include!("acp_thread_tasks_contract_v2_tests.rs");
+//     include!("acp_thread_tasks_child_session_tests.rs");
+//
+// so it shares story 012's helpers (`tasks_thread`, `tasks_send`, `tasks_snapshot`,
+// `tasks_wire_task`, `tasks_ids`) and `FakeAgentConnection`. Every name carries
+// `tasks_child_session` (filter `cargo test -p acp_thread tasks_child_session`).
+//
+// Contract (design.md §Data Models): `AgentTask` gains `child_session_id: Option<SessionId>`
+// (`acp_v2::SessionId`), parsed from the feed's `childSessionId` when present. Task 2.1's
+// objective: a malformed `childSessionId` is ignored, never an error.
+// Assumed beyond design.md: an empty string names no session and reads `None`, as an empty
+// `toolCallId` names no entry (`TaskRecord::new`).
+//
+// Hostile halves first: a malformed `childSessionId` must neither reject the snapshot (as a
+// malformed `tail` does) nor invent a child; two entries naming two children keep each its own;
+// then the benign v3 entry and the v2 entry without the key.
+
+fn tasks_child_session_entry(id: &str, child: serde_json::Value) -> serde_json::Value {
+    let mut task = tasks_wire_task(id, "running", 1_000);
+    task["type"] = serde_json::json!("subagent");
+    task["childSessionId"] = child;
+    task
+}
+
+fn tasks_child_session_of(
+    thread: &Entity<AcpThread>,
+    id: &str,
+    cx: &mut TestAppContext,
+) -> Option<String> {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .tasks()
+            .iter()
+            .find(|task| task.id.as_ref() == id)
+            .unwrap_or_else(|| panic!("task {id} is listed"))
+            .child_session_id
+            .as_ref()
+            .map(|child| child.to_string())
+    })
+}
+
+// A malformed value is ignored on its own entry: the snapshot is accepted whole, the entry is
+// listed with no child, and the well-formed entry beside it keeps its child.
+#[gpui::test]
+async fn test_tasks_child_session_malformed_value_is_ignored_not_an_error(cx: &mut TestAppContext) {
+    for bad in [
+        serde_json::json!(42),
+        serde_json::json!(true),
+        serde_json::json!({ "id": "c-1" }),
+        serde_json::json!(["c-1"]),
+        serde_json::json!(""),
+    ] {
+        let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+        tasks_send(
+            &thread,
+            tasks_snapshot(vec![
+                tasks_child_session_entry("bad", bad.clone()),
+                tasks_child_session_entry("good", serde_json::json!("c-good")),
+            ]),
+            cx,
+        );
+        assert_eq!(
+            tasks_ids(&thread, cx),
+            vec![
+                ("bad".to_string(), "running"),
+                ("good".to_string(), "running")
+            ],
+            "a malformed childSessionId never rejects the snapshot: {bad}"
+        );
+        assert_eq!(
+            events.borrow().updated,
+            1,
+            "the snapshot is applied and notified once: {bad}"
+        );
+        assert_eq!(
+            tasks_child_session_of(&thread, "bad", cx),
+            None,
+            "a malformed childSessionId names no child: {bad}"
+        );
+        assert_eq!(
+            tasks_child_session_of(&thread, "good", cx),
+            Some("c-good".to_string()),
+            "the entry beside it keeps its child: {bad}"
+        );
+    }
+}
+
+// Identity is the child's id, not the entry's shape: two entries with the same description name
+// two children, and an entry whose own id equals another child's id names only its own child.
+#[gpui::test]
+async fn test_tasks_child_session_each_entry_keeps_its_own_child(cx: &mut TestAppContext) {
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let mut first = tasks_child_session_entry("t1", serde_json::json!("c-a"));
+    let mut second = tasks_child_session_entry("c-a", serde_json::json!("c-b"));
+    first["description"] = serde_json::json!("Explore");
+    second["description"] = serde_json::json!("Explore");
+    tasks_send(&thread, tasks_snapshot(vec![first, second]), cx);
+
+    assert_eq!(
+        tasks_child_session_of(&thread, "t1", cx),
+        Some("c-a".to_string())
+    );
+    assert_eq!(
+        tasks_child_session_of(&thread, "c-a", cx),
+        Some("c-b".to_string()),
+        "an entry id that looks like a child id is still only an entry id"
+    );
+}
+
+// Benign: a v3 entry carries its child; a v2 entry (no key) and `null` carry none, and the rest of
+// the entry parses as before.
+#[gpui::test]
+async fn test_tasks_child_session_v3_value_parses_and_v2_entry_has_none(cx: &mut TestAppContext) {
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let v2_entry = tasks_wire_task("v2", "completed", 2_000);
+    assert!(
+        v2_entry.get("childSessionId").is_none(),
+        "precondition: a version 2 entry has no childSessionId key"
+    );
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![
+            tasks_child_session_entry("v3", serde_json::json!("c-native")),
+            tasks_child_session_entry("null", serde_json::json!(null)),
+            v2_entry,
+        ]),
+        cx,
+    );
+
+    assert_eq!(
+        tasks_child_session_of(&thread, "v3", cx),
+        Some("c-native".to_string())
+    );
+    assert_eq!(tasks_child_session_of(&thread, "null", cx), None);
+    assert_eq!(tasks_child_session_of(&thread, "v2", cx), None);
+    thread.read_with(cx, |thread, _| {
+        let v3 = thread
+            .tasks()
+            .iter()
+            .find(|task| task.id.as_ref() == "v3")
+            .expect("v3 is listed");
+        assert_eq!(v3.kind.as_ref(), "subagent");
+        assert_eq!(v3.description.as_ref(), "Task v3");
+        assert_eq!(v3.status, AgentTaskStatus::Running);
+    });
+}
diff --git a/crates/acp_thread/src/acp_thread_tasks_contract_v2_tests.rs b/crates/acp_thread/src/acp_thread_tasks_contract_v2_tests.rs
new file mode 100644
index 0000000..b4d0a51
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_tasks_contract_v2_tests.rs
@@ -0,0 +1,114 @@
+// Story 041, task 8.1 — the data-contract check between the adapter's fixtures and Zeo's wire
+// structs (R7.5, R3.1, R3.4; Q12). `scripts/status.sh` step 6 proves the two copies byte-identical;
+// this file proves the copy Zeo holds exercises every field Zeo reads, so a fixture that silently
+// lost a field (and still parsed, because the field defaults) cannot pass for a contract.
+//
+// Included at the end of `mod tests` in `acp_thread.rs`, after the version 2 file:
+//
+//     include!("acp_thread_tasks_v2_tests.rs");
+//     include!("acp_thread_tasks_contract_v2_tests.rs");
+//
+// so the private `WireTasksSnapshot` is reachable. Names carry `tasks_contract` (filter
+// `cargo test -p acp_thread tasks_contract`).
+//
+// The key lists below are what `WireTask` (camelCase) and the `_claude/tasks/output` parser read;
+// task 8.1 re-derives them from the code and records them in its commit body. If a field is added
+// to either reader, add it here, and to both fixtures.
+//
+// Hostile halves first: removing any REQUIRED key from a fixture task must make the snapshot fail
+// to parse (the fixture really carries it); the two DEFAULTED keys (`hasOutput`, `tail`) parse when
+// absent, so their presence in the version 2 fixture is asserted explicitly instead.
+
+const TASKS_CONTRACT_SNAPSHOT: &str = include_str!("test_data/claude_tasks_snapshot_v2.json");
+const TASKS_CONTRACT_OUTPUT: &str = include_str!("test_data/claude_tasks_output.json");
+
+// Re-derived from `WireTask` by task 8.1 (Run mode, 2026-10-12): the non-`Option` fields are
+// required; the five `Option` fields parse as `None` when absent (serde's rule for `Option`), so
+// they are nullable, not required; `hasOutput` and `tail` carry `#[serde(default)]`.
+const TASKS_CONTRACT_REQUIRED: &[&str] = &[
+    "id",
+    "type",
+    "description",
+    "background",
+    "depth",
+    "status",
+    "startedAt",
+];
+const TASKS_CONTRACT_NULLABLE: &[&str] = &["toolCallId", "endedAt", "usage", "lastTool", "summary"];
+const TASKS_CONTRACT_DEFAULTED: &[&str] = &["hasOutput", "tail"];
+const TASKS_CONTRACT_OUTPUT_KEYS: &[&str] = &["content", "totalBytes", "truncated"];
+
+fn tasks_contract_doc() -> serde_json::Value {
+    serde_json::from_str(TASKS_CONTRACT_SNAPSHOT).expect("the snapshot fixture is JSON")
+}
+
+#[test]
+fn tasks_contract_every_fixture_task_carries_every_key_zeo_reads() {
+    let doc = tasks_contract_doc();
+    for task in doc["tasks"].as_array().expect("tasks is a list") {
+        let object = task.as_object().expect("a task is an object");
+        for key in TASKS_CONTRACT_REQUIRED
+            .iter()
+            .chain(TASKS_CONTRACT_NULLABLE)
+            .chain(TASKS_CONTRACT_DEFAULTED)
+        {
+            assert!(object.contains_key(*key), "{} lacks {key}", task["id"]);
+        }
+        let mut keys: Vec<&str> = object.keys().map(String::as_str).collect();
+        keys.sort_unstable();
+        let mut expected: Vec<&str> = TASKS_CONTRACT_REQUIRED
+            .iter()
+            .chain(TASKS_CONTRACT_NULLABLE)
+            .chain(TASKS_CONTRACT_DEFAULTED)
+            .copied()
+            .collect();
+        expected.sort_unstable();
+        assert_eq!(keys, expected, "no key Zeo does not read");
+    }
+}
+
+// Hostile: each required key, removed from one task, breaks the parse.
+#[test]
+fn tasks_contract_removing_a_required_key_breaks_the_parse() {
+    assert!(serde_json::from_value::<WireTasksSnapshot>(tasks_contract_doc()).is_ok());
+    for key in TASKS_CONTRACT_REQUIRED {
+        let mut doc = tasks_contract_doc();
+        doc["tasks"][0].as_object_mut().unwrap().remove(*key);
+        assert!(
+            serde_json::from_value::<WireTasksSnapshot>(doc).is_err(),
+            "the parse must need {key}"
+        );
+    }
+    // Converse: the nullable and defaulted keys are optional on the wire (version 1
+    // compatibility, R3.2); their presence in the fixture is asserted by the test above.
+    for key in TASKS_CONTRACT_NULLABLE
+        .iter()
+        .chain(TASKS_CONTRACT_DEFAULTED)
+    {
+        let mut doc = tasks_contract_doc();
+        doc["tasks"][0].as_object_mut().unwrap().remove(*key);
+        assert!(
+            serde_json::from_value::<WireTasksSnapshot>(doc).is_ok(),
+            "{key} defaults"
+        );
+    }
+}
+
+#[test]
+fn tasks_contract_output_fixture_has_exactly_the_keys_the_parser_reads() {
+    let output: serde_json::Value =
+        serde_json::from_str(TASKS_CONTRACT_OUTPUT).expect("the output fixture is JSON");
+    let mut keys: Vec<&str> = output
+        .as_object()
+        .expect("an object")
+        .keys()
+        .map(String::as_str)
+        .collect();
+    keys.sort_unstable();
+    let mut expected = TASKS_CONTRACT_OUTPUT_KEYS.to_vec();
+    expected.sort_unstable();
+    assert_eq!(keys, expected);
+    assert!(output["content"].is_string());
+    assert!(output["totalBytes"].is_u64());
+    assert!(output["truncated"].is_boolean());
+}
diff --git a/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs b/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs
new file mode 100644
index 0000000..bc94905
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs
@@ -0,0 +1,280 @@
+// Story 041, task 4.2 — `_claude/tasks` version 2 in `AcpThread`: `tail` and `has_output` on
+// `AgentTask`, the version 2 and version 1 fixtures, the malformed tail (R3.1, R3.2, R3.3, R7.5;
+// Q12). Also the trait default of `fetch_task_output` (task 4.3's R3.5, which lives in this crate).
+//
+// Included at the end of `mod tests` in `acp_thread.rs`, AFTER `acp_thread_tasks_tests.rs`:
+//
+//     include!("acp_thread_tasks_tests.rs");
+//     include!("acp_thread_tasks_review_tests.rs");
+//     include!("acp_thread_tasks_v2_tests.rs");
+//
+// so it shares that module's imports, `FakeAgentConnection`, and story 012's helpers
+// (`tasks_thread`, `tasks_send`, `tasks_snapshot`, `tasks_update`, `tasks_wire_task`,
+// `tasks_ids`). Every test name carries `tasks` (filter `cargo test -p acp_thread tasks`).
+//
+// Contract (design.md §`AcpThread` task model): `AgentTask::has_output: bool`,
+// `AgentTask::tail: Option<Arc<[SharedString]>>`; `AcpThread::fetch_task_output(&self, task_id:
+// &AgentTaskId, cx) -> Task<Result<TaskOutput>>`. Fixtures under `src/test_data/`:
+// `claude_tasks_snapshot_v2.json` (version 2, new in this patch, byte-identical to the adapter's
+// `claude-tasks-snapshot.json`) and `claude_tasks_snapshot.json` (version 1, as patch 0034 created it).
+//
+// Hostile halves first: a malformed `tail` or `hasOutput` must keep the previous list (and not
+// read as "no tail"); a version 1 snapshot must still parse; a repeated identical tail must not
+// notify again while a changed one must.
+
+const TASKS_V2_FIXTURE: &str = include_str!("test_data/claude_tasks_snapshot_v2.json");
+const TASKS_V1_FIXTURE: &str = include_str!("test_data/claude_tasks_snapshot.json");
+
+fn tasks_v2_tail(
+    thread: &Entity<AcpThread>,
+    id: &str,
+    cx: &mut TestAppContext,
+) -> Option<Vec<String>> {
+    thread.read_with(cx, |thread, _| {
+        let task = thread
+            .tasks()
+            .iter()
+            .find(|task| task.id.as_ref() == id)
+            .unwrap_or_else(|| panic!("task {id} is listed"));
+        task.tail
+            .as_ref()
+            .map(|lines| lines.iter().map(|line| line.to_string()).collect())
+    })
+}
+
+fn tasks_v2_has_output(thread: &Entity<AcpThread>, id: &str, cx: &mut TestAppContext) -> bool {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .tasks()
+            .iter()
+            .find(|task| task.id.as_ref() == id)
+            .unwrap_or_else(|| panic!("task {id} is listed"))
+            .has_output
+    })
+}
+
+fn tasks_v2_shell(
+    id: &str,
+    tail: serde_json::Value,
+    has_output: serde_json::Value,
+) -> serde_json::Value {
+    let mut task = tasks_wire_task(id, "running", 1_000);
+    task["tail"] = tail;
+    task["hasOutput"] = has_output;
+    task
+}
+
+// ---- R3.3 — hostile first: a malformed field keeps the previous list ----------------------
+
+#[gpui::test]
+async fn test_tasks_v2_malformed_tail_keeps_the_previous_list(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!(["line 1"]),
+            serde_json::json!(true),
+        )]),
+        cx,
+    );
+    assert_eq!(events.borrow().updated, 1);
+
+    for bad in [
+        tasks_v2_shell("b1", serde_json::json!("line 2"), serde_json::json!(true)),
+        tasks_v2_shell("b1", serde_json::json!([1, 2]), serde_json::json!(true)),
+        tasks_v2_shell(
+            "b1",
+            serde_json::json!(["ok", null]),
+            serde_json::json!(true),
+        ),
+        tasks_v2_shell(
+            "b1",
+            serde_json::json!({ "0": "x" }),
+            serde_json::json!(true),
+        ),
+        tasks_v2_shell(
+            "b1",
+            serde_json::json!(["line 2"]),
+            serde_json::json!("yes"),
+        ),
+    ] {
+        tasks_send(&thread, tasks_snapshot(vec![bad.clone()]), cx);
+        assert_eq!(
+            tasks_v2_tail(&thread, "b1", cx),
+            Some(vec!["line 1".to_string()]),
+            "a malformed snapshot is rejected whole: {bad}"
+        );
+        assert!(tasks_v2_has_output(&thread, "b1", cx));
+    }
+    assert_eq!(
+        events.borrow().updated,
+        1,
+        "a rejected snapshot notifies nobody"
+    );
+}
+
+// Converse: `null` and an empty list are well-formed tails.
+#[gpui::test]
+async fn test_tasks_v2_null_and_empty_tails_are_accepted(cx: &mut TestAppContext) {
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!(null),
+            serde_json::json!(false),
+        )]),
+        cx,
+    );
+    assert_eq!(tasks_v2_tail(&thread, "b1", cx), None);
+    assert!(!tasks_v2_has_output(&thread, "b1", cx));
+
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!([]),
+            serde_json::json!(true),
+        )]),
+        cx,
+    );
+    assert_eq!(tasks_v2_tail(&thread, "b1", cx), Some(Vec::new()));
+    assert!(tasks_v2_has_output(&thread, "b1", cx));
+}
+
+// ---- R3.2 — a version 1 snapshot still parses -----------------------------------------------
+
+#[gpui::test]
+async fn test_tasks_v2_version_1_snapshot_parses_with_no_tail_and_no_output(
+    cx: &mut TestAppContext,
+) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let payload: serde_json::Value =
+        serde_json::from_str(TASKS_V1_FIXTURE).expect("the version 1 fixture is JSON");
+    for task in payload["tasks"].as_array().expect("tasks is a list") {
+        assert!(
+            task.get("hasOutput").is_none() && task.get("tail").is_none(),
+            "{task}"
+        );
+    }
+    tasks_send(&thread, tasks_update(payload.clone()), cx);
+
+    let ids: Vec<String> = payload["tasks"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|task| task["id"].as_str().unwrap().to_string())
+        .collect();
+    assert_eq!(
+        tasks_ids(&thread, cx)
+            .into_iter()
+            .map(|(id, _)| id)
+            .collect::<Vec<_>>(),
+        ids,
+        "every version 1 task is held"
+    );
+    for id in &ids {
+        assert_eq!(tasks_v2_tail(&thread, id, cx), None);
+        assert!(!tasks_v2_has_output(&thread, id, cx));
+    }
+    assert_eq!(events.borrow().updated, 1);
+}
+
+// ---- R3.1 — the version 2 fixture and the fields on the model ------------------------------
+
+#[gpui::test]
+async fn test_tasks_v2_contract_fixture_parses_with_tail_and_output(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let payload: serde_json::Value =
+        serde_json::from_str(TASKS_V2_FIXTURE).expect("the version 2 fixture is JSON");
+    tasks_send(&thread, tasks_update(payload.clone()), cx);
+    assert_eq!(events.borrow().updated, 1);
+
+    let mut roles = (0, 0, 0);
+    for task in payload["tasks"].as_array().expect("tasks is a list") {
+        let id = task["id"].as_str().unwrap();
+        let expected_tail: Option<Vec<String>> = task["tail"].as_array().map(|lines| {
+            lines
+                .iter()
+                .map(|line| line.as_str().unwrap().to_string())
+                .collect()
+        });
+        assert_eq!(tasks_v2_tail(&thread, id, cx), expected_tail, "{id}");
+        assert_eq!(
+            tasks_v2_has_output(&thread, id, cx),
+            task["hasOutput"]
+                .as_bool()
+                .expect("hasOutput is a boolean in version 2"),
+            "{id}"
+        );
+        match (
+            task["type"].as_str().unwrap(),
+            task["status"].as_str().unwrap(),
+        ) {
+            ("shell", "running") => {
+                roles.0 += 1;
+                assert!(expected_tail.is_some_and(|t| !t.is_empty()));
+            }
+            ("shell", _) => roles.1 += 1,
+            ("subagent", _) => {
+                roles.2 += 1;
+                assert!(!task["hasOutput"].as_bool().unwrap());
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        roles,
+        (1, 1, 1),
+        "one running shell, one ended shell, one subagent"
+    );
+}
+
+// Hostile: the same tail again is no change; a new line is.
+#[gpui::test]
+async fn test_tasks_v2_a_changed_tail_notifies_and_the_same_tail_does_not(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let snapshot = |tail: serde_json::Value| {
+        tasks_snapshot(vec![tasks_v2_shell("b1", tail, serde_json::json!(true))])
+    };
+    tasks_send(&thread, snapshot(serde_json::json!(["line 1"])), cx);
+    tasks_send(&thread, snapshot(serde_json::json!(["line 1"])), cx);
+    assert_eq!(
+        events.borrow().updated,
+        1,
+        "an identical snapshot is not news"
+    );
+
+    tasks_send(
+        &thread,
+        snapshot(serde_json::json!(["line 1", "line 2"])),
+        cx,
+    );
+    assert_eq!(events.borrow().updated, 2, "a tail that grew is news");
+    assert_eq!(
+        tasks_v2_tail(&thread, "b1", cx),
+        Some(vec!["line 1".to_string(), "line 2".to_string()])
+    );
+}
+
+// ---- R3.5 (task 4.3) — the trait default answers "unsupported" ------------------------------
+
+#[gpui::test]
+async fn test_tasks_v2_fetch_output_is_unsupported_for_an_agent_without_it(
+    cx: &mut TestAppContext,
+) {
+    // FakeAgentConnection does not override `fetch_task_output`: the trait default answers.
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    let error = thread
+        .update(cx, |thread, cx| {
+            thread.fetch_task_output(&AgentTaskId::from("b1".to_string()), cx)
+        })
+        .await
+        .expect_err("reading output is unsupported");
+    let text = error.to_string().to_lowercase();
+    assert!(
+        text.contains("not supported") || text.contains("unsupported"),
+        "{text}"
+    );
+}
