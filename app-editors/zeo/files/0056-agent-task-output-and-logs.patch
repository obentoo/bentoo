+// Story 041, task 5.1 — `task_log`: where a task's log lives, how it is written (mode 0600 in
+// 0700 directories, replaced atomically), the 1 MiB cap, delete and the orphan sweep (R6.2, R6.3,
+// R6.4, R6.6, R6.7; Q4, Q15, Q18).
+//
+// Wired in `src/tasks_card/task_log.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "task_log_tests.rs"]
+//     mod tests;
+//
+// (a `#[path]` in the non-mod-rs file `tasks_card/task_log.rs` resolves next to it), so every test
+// path is `tasks_card::task_log::tests::…` (filter `cargo test -p agent_ui task_log`).
+//
+// Contract (design.md §`task_log`): `LOG_MAX_BYTES`, `logs_root()`, `log_path(root, session_id,
+// task_id) -> PathBuf`, `render_log(&TaskOutput) -> String`, `write_log(path, text) ->
+// Result<u64>`, `delete_log(root, session_id, task_id) -> Result<()>`, `sweep(root, &HashSet<(String,
+// String)>) -> Result<SweepReport>`. Plain `#[test]`s over a private temp directory; nothing here
+// touches `paths::data_dir()` except the one `logs_root` assertion, which only computes a path.
+//
+// Hostile halves first, and one of them is aimed at a value the design DERIVES: `component()`
+// keeps an id that matches `^[A-Za-z0-9_-]{1,128}$` and writes any other as `x` + lowercase hex,
+// cut to 200 characters. A third id can reach the same rendered name by another route:
+//   - `..` escapes to `x2e2e`, and the id `x2e2e` is a valid bare name that renders as itself;
+//   - two 129-character ids differing only in their last character both escape to 259
+//     characters and are cut to the same 200.
+// Two different ids must never share a file — the record of one would open, or delete, the log
+// of the other. These tests fail against design.md's `component()` as written; that is the point.
+
+use std::collections::HashSet;
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime};
+
+/// A `newer_than` after every file a test writes, so the age guard keeps nothing by itself.
+fn later() -> SystemTime {
+    SystemTime::now() + Duration::from_secs(3600)
+}
+
+use acp_thread::TaskOutput;
+
+use super::*;
+
+/// A private directory removed on drop (no extra dev-dependency).
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-task-log-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn mode(path: &Path) -> u32 {
+    fs::metadata(path).expect("metadata").permissions().mode() & 0o777
+}
+
+fn names_in(dir: &Path) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(dir)
+        .map(|entries| {
+            entries
+                .filter_map(|entry| entry.ok())
+                .map(|entry| entry.file_name().to_string_lossy().into_owned())
+                .collect()
+        })
+        .unwrap_or_default();
+    names.sort();
+    names
+}
+
+fn output(content: &str, total_bytes: u64, truncated: bool) -> TaskOutput {
+    TaskOutput {
+        content: content.to_string(),
+        total_bytes,
+        truncated,
+    }
+}
+
+// ---- log_path: ids never collide, never escape the root ------------------------------------
+
+fn assert_inside(root: &Path, path: &Path) {
+    let relative = path
+        .strip_prefix(root)
+        .unwrap_or_else(|_| panic!("{path:?} is outside {root:?}"));
+    let parts: Vec<_> = relative.components().collect();
+    assert_eq!(parts.len(), 2, "root/<session>/<task>.log, got {path:?}");
+    for part in parts {
+        let text = part.as_os_str().to_string_lossy();
+        assert!(
+            !text.contains('/') && text != ".." && text != ".",
+            "{path:?}"
+        );
+    }
+    assert!(path.to_string_lossy().ends_with(".log"), "{path:?}");
+}
+
+// Hostile (derived value): a third id must not reach another id's rendered name.
+#[test]
+fn task_log_ids_that_look_like_each_others_escape_get_distinct_files() {
+    let root = PathBuf::from("/logs");
+    let long = |last: char| format!("{}{last}", "a".repeat(128));
+    let ids: Vec<String> = vec![
+        "..".into(),
+        "x2e2e".into(), // the hex escape of ".." spelled as a valid bare id
+        ".".into(),
+        "x2e".into(), // the hex escape of "."
+        "a/b".into(),
+        "a_b".into(),
+        "a%2Fb".into(),
+        "x612f62".into(), // the hex escape of "a/b"
+        "tâche".into(),
+        "".into(),
+        long('b'), // 129 characters: escaped, then cut
+        long('c'),
+        format!("{}/1", "z".repeat(150)),
+        format!("{}/2", "z".repeat(150)),
+    ];
+    let mut seen: HashSet<PathBuf> = HashSet::new();
+    for id in &ids {
+        let path = log_path(&root, "session", id);
+        assert_inside(&root, &path);
+        assert!(seen.insert(path.clone()), "{id:?} collides at {path:?}");
+    }
+    // The same for session ids: the directory level must not collide either.
+    let mut sessions: HashSet<PathBuf> = HashSet::new();
+    for id in &ids {
+        let path = log_path(&root, id, "t1");
+        assert_inside(&root, &path);
+        assert!(
+            sessions.insert(path.parent().unwrap().to_path_buf()),
+            "session {id:?} collides"
+        );
+    }
+}
+
+#[test]
+fn task_log_path_is_deterministic_and_plain_ids_stay_readable() {
+    let root = PathBuf::from("/logs");
+    let path = log_path(&root, "6f1c2d3e-aaaa-bbbb", "b7k2m9x1q");
+    assert_eq!(path, root.join("6f1c2d3e-aaaa-bbbb").join("b7k2m9x1q.log"));
+    assert_eq!(path, log_path(&root, "6f1c2d3e-aaaa-bbbb", "b7k2m9x1q"));
+}
+
+#[test]
+fn task_log_root_is_agent_task_logs_in_the_data_dir() {
+    assert_eq!(logs_root(), paths::data_dir().join("agent_task_logs"));
+}
+
+// ---- render_log: the cap (R6.2) ------------------------------------------------------------
+
+#[test]
+fn task_log_render_keeps_untruncated_output_verbatim() {
+    assert_eq!(render_log(&output("a\nb\n", 4, false)), "a\nb\n");
+}
+
+#[test]
+fn task_log_render_names_the_dropped_bytes_on_its_first_line() {
+    let content = "line 2\nline 3\n";
+    let rendered = render_log(&output(content, 2_097_152, true));
+    let dropped = 2_097_152 - content.len() as u64;
+    assert_eq!(
+        rendered,
+        format!("[earlier output truncated: {dropped} bytes]\n{content}")
+    );
+}
+
+// Hostile: an agent that sends more than the cap is cut again, at a line boundary.
+#[test]
+fn task_log_render_caps_an_oversized_answer_at_a_line_boundary() {
+    let line = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdé\n";
+    let content = line.repeat((3 * LOG_MAX_BYTES) / line.len());
+    let total = content.len() as u64;
+    let rendered = render_log(&output(&content, total, false));
+
+    let (header, body) = rendered.split_once('\n').expect("a header line");
+    assert!(
+        header.starts_with("[earlier output truncated: "),
+        "{header}"
+    );
+    let dropped = total - body.len() as u64;
+    assert_eq!(
+        header,
+        format!("[earlier output truncated: {dropped} bytes]")
+    );
+    assert!(body.len() <= LOG_MAX_BYTES);
+    assert!(
+        body.starts_with(line),
+        "the kept part starts at a line boundary"
+    );
+    assert!(content.ends_with(body));
+    assert_eq!(LOG_MAX_BYTES, 1_048_576);
+}
+
+// Hostile: the raw cut `len - LOG_MAX_BYTES` lands inside a two-byte character and no newline
+// follows it, so only whole characters may be kept.
+#[test]
+fn task_log_cap_without_a_newline_keeps_whole_multibyte_characters() {
+    let content = "é".repeat(LOG_MAX_BYTES / 2 + 1) + "x";
+    assert!(!content.is_char_boundary(content.len() - LOG_MAX_BYTES));
+
+    let body = cap_at_line_boundary(&content);
+
+    assert_eq!(body.len(), LOG_MAX_BYTES - 1);
+    assert!(body.starts_with('é'));
+    assert!(content.ends_with(body));
+}
+
+// Hostile: the adapter decodes invalid bytes as U+FFFD (three bytes each), so a capped log can
+// exceed LOG_MAX_BYTES with the raw cut inside a replacement character. The kept part must
+// still start on the next line.
+#[test]
+fn task_log_cap_inside_a_replacement_character_starts_on_the_next_line() {
+    let line = "\u{FFFD}".repeat(9) + "\n";
+    let content = line.repeat((2 * LOG_MAX_BYTES) / line.len()) + "\u{FFFD}\u{FFFD}";
+    assert!(!content.is_char_boundary(content.len() - LOG_MAX_BYTES));
+
+    let body = cap_at_line_boundary(&content);
+
+    assert!(body.len() <= LOG_MAX_BYTES);
+    assert!(body.starts_with(&line));
+    assert!(content.ends_with(body));
+    let cut = content.len() - body.len();
+    assert_eq!(&content[cut - 1..cut], "\n");
+    assert!(cut - (content.len() - LOG_MAX_BYTES) < line.len());
+}
+
+#[test]
+fn task_log_cap_of_ascii_lines_is_unchanged() {
+    let line = "0123456789\n";
+    let content = "x".repeat(5) + &line.repeat((2 * LOG_MAX_BYTES) / line.len());
+    let start = content.len() - LOG_MAX_BYTES;
+    let expected = &content[start + content[start..].find('\n').map_or(0, |i| i + 1)..];
+    assert_eq!(cap_at_line_boundary(&content), expected);
+
+    let aligned = "y".repeat(LOG_MAX_BYTES) + "\n" + &"z".repeat(LOG_MAX_BYTES - 1) + "\n";
+    assert_eq!(
+        cap_at_line_boundary(&aligned),
+        "z".repeat(LOG_MAX_BYTES - 1) + "\n"
+    );
+}
+
+// ---- write_log: modes, replace, failure (R6.3, R6.4, Q18) ---------------------------------
+
+#[test]
+fn task_log_write_creates_0600_in_0700_directories_and_returns_its_size() {
+    let scratch = Scratch::new("modes");
+    let root = scratch.root();
+    let path = log_path(&root, "s1", "t1");
+
+    let bytes = write_log(&path, "hello\n").expect("write succeeds");
+
+    assert_eq!(bytes, 6);
+    assert_eq!(fs::read_to_string(&path).unwrap(), "hello\n");
+    assert_eq!(mode(&path), 0o600);
+    assert_eq!(mode(path.parent().unwrap()), 0o700);
+    assert_eq!(mode(&root), 0o700);
+}
+
+// Hostile: a root that already exists world-readable is tightened, not trusted.
+#[test]
+fn task_log_write_tightens_an_existing_root() {
+    let scratch = Scratch::new("tighten");
+    let root = scratch.root();
+    fs::create_dir_all(root.join("s1")).unwrap();
+    fs::set_permissions(&root, fs::Permissions::from_mode(0o755)).unwrap();
+    fs::set_permissions(root.join("s1"), fs::Permissions::from_mode(0o755)).unwrap();
+
+    write_log(&log_path(&root, "s1", "t1"), "x\n").expect("write succeeds");
+    assert_eq!(mode(&root), 0o700);
+    assert_eq!(mode(&root.join("s1")), 0o700);
+}
+
+#[test]
+fn task_log_write_again_replaces_the_one_file_and_leaves_no_temporary() {
+    let scratch = Scratch::new("replace");
+    let root = scratch.root();
+    let path = log_path(&root, "s1", "t1");
+    write_log(&path, "first\n").unwrap();
+    write_log(&path, "second\n").unwrap();
+
+    assert_eq!(fs::read_to_string(&path).unwrap(), "second\n");
+    assert_eq!(names_in(path.parent().unwrap()), vec!["t1.log".to_string()]);
+    assert_eq!(mode(&path), 0o600);
+}
+
+// Q18: the write cannot complete (the target is occupied by a non-empty directory, so the final
+// rename fails after the temporary file was written). The error names the ids, carries no text,
+// the temporary file is gone, and what occupied the target is untouched — the target is never
+// written in place.
+#[test]
+fn task_log_failed_write_leaves_the_target_untouched_and_no_temporary() {
+    let scratch = Scratch::new("failed");
+    let root = scratch.root();
+    let path = log_path(&root, "s1", "t1");
+    fs::create_dir_all(&path).unwrap();
+    fs::write(path.join("previous"), "previous content").unwrap();
+
+    let error = write_log(&path, "SECRET-OUTPUT\n").expect_err("the rename cannot succeed");
+    let text = format!("{error:#}");
+    assert!(text.contains("s1") && text.contains("t1"), "{text}");
+    assert!(!text.contains("SECRET-OUTPUT"), "{text}");
+    assert_eq!(
+        fs::read_to_string(path.join("previous")).unwrap(),
+        "previous content"
+    );
+    assert_eq!(
+        names_in(path.parent().unwrap()),
+        vec!["t1.log".to_string()],
+        "no temporary file is left behind"
+    );
+}
+
+// ---- delete_log (R6.5's file half) --------------------------------------------------------
+
+// Hostile: deleting (s1, t1) must not touch (s1, t10) or (s2, t1).
+#[test]
+fn task_log_delete_removes_only_its_own_file() {
+    let scratch = Scratch::new("delete");
+    let root = scratch.root();
+    for (session, task) in [("s1", "t1"), ("s1", "t10"), ("s2", "t1")] {
+        write_log(&log_path(&root, session, task), "x\n").unwrap();
+    }
+
+    delete_log(&root, "s1", "t1").expect("delete succeeds");
+
+    assert!(!log_path(&root, "s1", "t1").exists());
+    assert!(log_path(&root, "s1", "t10").exists());
+    assert!(log_path(&root, "s2", "t1").exists());
+}
+
+#[test]
+fn task_log_delete_of_a_missing_file_succeeds_and_an_emptied_session_dir_goes() {
+    let scratch = Scratch::new("delete-empty");
+    let root = scratch.root();
+    delete_log(&root, "s1", "never-written").expect("NotFound is success");
+
+    write_log(&log_path(&root, "s1", "t1"), "x\n").unwrap();
+    delete_log(&root, "s1", "t1").unwrap();
+    assert!(
+        !root.join("s1").exists(),
+        "the empty session directory is removed"
+    );
+}
+
+// ---- sweep (R6.6) -------------------------------------------------------------------------
+
+#[test]
+fn task_log_sweep_keeps_kept_keys_and_removes_orphans_and_their_temporaries() {
+    let scratch = Scratch::new("sweep");
+    let root = scratch.root();
+    let keep_ids = [("s1", "t1"), ("s/2", "a/b")]; // the second pair is stored escaped
+    for (session, task) in keep_ids.iter().chain([("s1", "t2"), ("s3", "t1")].iter()) {
+        write_log(&log_path(&root, session, task), "x\n").unwrap();
+    }
+    let orphan_tmp = log_path(&root, "s1", "t9").with_extension("log.tmp-1-2");
+    fs::write(&orphan_tmp, "partial").unwrap();
+    let stranger = root.join("s1").join("README");
+    fs::write(&stranger, "not a log").unwrap();
+
+    let keep: HashSet<(String, String)> = keep_ids
+        .iter()
+        .map(|(s, t)| (s.to_string(), t.to_string()))
+        .collect();
+    sweep(&root, &keep, later()).expect("sweep succeeds");
+
+    assert!(log_path(&root, "s1", "t1").exists());
+    assert!(
+        log_path(&root, "s/2", "a/b").exists(),
+        "an escaped kept key is mapped back"
+    );
+    assert!(!log_path(&root, "s1", "t2").exists());
+    assert!(!log_path(&root, "s3", "t1").exists());
+    assert!(!orphan_tmp.exists());
+    assert!(stranger.exists(), "a name it cannot map is left alone");
+}
+
+#[test]
+fn task_log_sweep_of_a_missing_root_does_nothing() {
+    let scratch = Scratch::new("sweep-missing");
+    let root = scratch.root();
+    sweep(&root, &HashSet::new(), later()).expect("nothing to sweep is not an error");
+    assert!(!root.exists(), "the sweep creates nothing");
+}
+
+// Hostile (M1): a log saved while the history was loading belongs to no loaded key yet, but it is
+// newer than the load, so the sweep must leave it; an equally unkept older file still goes.
+#[test]
+fn task_log_sweep_keeps_a_file_written_after_the_load_began() {
+    let scratch = Scratch::new("sweep-newer");
+    let root = scratch.root();
+    write_log(&log_path(&root, "s1", "old"), "x\n").unwrap();
+    let old = log_path(&root, "s1", "old");
+    let past = SystemTime::now() - Duration::from_secs(600);
+    fs::File::options()
+        .write(true)
+        .open(&old)
+        .unwrap()
+        .set_modified(past)
+        .unwrap();
+    let loaded_at = SystemTime::now() - Duration::from_secs(60);
+    write_log(&log_path(&root, "s1", "fresh"), "x\n").unwrap();
+
+    sweep(&root, &HashSet::new(), loaded_at).expect("sweep succeeds");
+
+    assert!(
+        !old.exists(),
+        "an unkept file older than the load is an orphan"
+    );
+    assert!(
+        log_path(&root, "s1", "fresh").exists(),
+        "a file saved during the load is kept"
+    );
+}
