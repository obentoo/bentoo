index 0000000..c6f9be0
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/open_subagent_tests.rs
@@ -0,0 +1,197 @@
+// Story 041, task 6.3 — "Open Thread" on a subagent row: the subagent's own thread when the parent
+// knows it, else the parent thread at the subagent's tool call with a notice (R5.4, R5.5, R5.6;
+// Q16). Filter: `tasks_card::open_subagent`.
+//
+// Wired in `src/tasks_card.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/open_subagent_tests.rs"]
+//     mod open_subagent;
+//
+// Contract (design.md §`TasksCard` changes) and what this file assumes beyond it:
+//   - `TasksCard::open_subagent(session_id, task_id, window, cx)`, public like `open_task`, emitting
+//     `TasksCardEvent::OpenSubagent { session_id, task_id, tool_call_id }`; the agent panel resolves
+//     the subagent session from the root thread's tool call `subagent_session_info` and calls
+//     `ConversationView::navigate_to_thread`;
+//   - the parent thread learns a subagent session from the tool call's `_meta` under
+//     `acp_thread::SUBAGENT_SESSION_INFO_META_KEY` (the key `subagent_session_info_from_meta` reads;
+//     made `pub` if it is not);
+//   - debug selector `tasks-card-open-thread-{id}`;
+//   - the R5.6 notice is shown in the row's message slot (`TaskRow::error`, the card's only per-row
+//     text); if the implementation adds a separate notice field, read it in `row_message` only;
+//   - `crate::test_support::active_session_id` reports the session of the thread the panel shows.
+//
+// Hostile halves first: a shell row gets no "Open Thread"; a subagent whose tool call carries no
+// session info must not navigate to some other thread — it opens the parent at its own call and
+// says so; with two subagents, each opens its own session, never the other's.
+
+use acp_thread::AcpThread;
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::TaskRow;
+use super::test_helpers::*;
+use crate::AgentPanel;
+use crate::test_support::active_session_id;
+
+const NO_OWN_THREAD: &str =
+    "Opened the parent thread; this subagent has no thread of its own to show";
+
+fn subagent(id: &str, tool_call_id: &str) -> serde_json::Value {
+    let mut task = wire_task(id, "running", false, 1_000);
+    task["type"] = json!("subagent");
+    task["toolCallId"] = json!(tool_call_id);
+    task["hasOutput"] = json!(false);
+    task["tail"] = json!(null);
+    task
+}
+
+/// The Agent tool call that spawned a subagent; `subagent_session` fills its session info.
+fn push_agent_call(
+    panel: &Entity<AgentPanel>,
+    thread: &Entity<AcpThread>,
+    id: &str,
+    subagent_session: Option<&str>,
+    cx: &mut VisualTestContext,
+) {
+    let mut call = acp::ToolCall::new(id.to_string(), format!("Agent {id}"));
+    if let Some(session) = subagent_session {
+        let mut meta = serde_json::Map::new();
+        meta.insert(
+            acp_thread::SUBAGENT_SESSION_INFO_META_KEY.to_string(),
+            json!({ "session_id": session, "message_start_index": 0 }),
+        );
+        call = call.meta(meta);
+    }
+    thread.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(acp::SessionUpdate::ToolCall(call), cx)
+            .expect("tool call applies");
+    });
+    // Run-mode fix, story 041 6.3: load the subagent's session into the parent's conversation.
+    if let Some(session) = subagent_session {
+        let parent = thread.read_with(cx, |thread, _| thread.session_id().clone());
+        let conversation = panel
+            .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+            .expect("the parent's conversation is active");
+        conversation.update(cx, |view, cx| {
+            view.load_subagent_session_for_test(acp_v2::SessionId::new(session), parent, cx)
+        });
+    }
+    cx.run_until_parked();
+}
+
+fn row_message(row: &TaskRow) -> Option<String> {
+    row.error.as_ref().map(|message| message.to_string())
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+// ---- R5.4 — where "Open Thread" is offered ------------------------------------------------
+
+#[gpui::test]
+async fn test_open_subagent_is_offered_only_on_subagent_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let mut sh = wire_task("sh", "running", true, 1_000);
+    sh["hasOutput"] = json!(true);
+    sh["tail"] = json!(["x"]);
+    send_tasks(&a, vec![sh, subagent("sub", "toolu_sub")], &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-open-thread-sub").is_some());
+    assert!(cx.debug_bounds("tasks-card-open-thread-sh").is_none());
+}
+
+// ---- R5.6 — hostile first: no session info, no wrong navigation ---------------------------
+
+#[gpui::test]
+async fn test_open_subagent_without_its_session_opens_the_parent_and_says_so(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    // Another subagent call WITH a session sits in the same thread; it must not be borrowed.
+    push_agent_call(
+        &panel,
+        &a,
+        "toolu_other",
+        Some("other-subagent-session"),
+        &mut cx,
+    );
+    push_agent_call(&panel, &a, "toolu_sub", None, &mut cx);
+    send_tasks(&a, vec![subagent("sub", "toolu_sub")], &mut cx);
+    let sa = session_of(&a, &cx);
+    let _b = open_titled_thread(&panel, &connection, "B", &mut cx);
+
+    let card = card(&panel, &cx);
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_subagent(sa.clone(), "sub".into(), window, cx)
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        active_session_id(&panel, &cx),
+        sa,
+        "the parent thread is brought forward"
+    );
+    assert_ne!(
+        active_session_id(&panel, &cx),
+        acp_v2::SessionId::new("other-subagent-session")
+    );
+    let row = find_row(&card, &sa, "sub", &mut cx).expect("the row stays listed");
+    assert_eq!(row_message(&row).as_deref(), Some(NO_OWN_THREAD));
+}
+
+// ---- R5.5 — the subagent's own thread -----------------------------------------------------
+
+#[gpui::test]
+async fn test_open_subagent_shows_its_own_thread_in_this_window(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    push_agent_call(
+        &panel,
+        &a,
+        "toolu_one",
+        Some("subagent-session-one"),
+        &mut cx,
+    );
+    push_agent_call(
+        &panel,
+        &a,
+        "toolu_two",
+        Some("subagent-session-two"),
+        &mut cx,
+    );
+    send_tasks(
+        &a,
+        vec![subagent("one", "toolu_one"), subagent("two", "toolu_two")],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_subagent(sa.clone(), "two".into(), window, cx)
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        active_session_id(&panel, &cx),
+        acp_v2::SessionId::new("subagent-session-two"),
+        "its own session, not the other subagent's"
+    );
+    let row = find_row(&card, &sa, "two", &mut cx).expect("the row stays listed");
+    assert_eq!(
+        row_message(&row),
+        None,
+        "no notice when the thread was shown"
+    );
+}
