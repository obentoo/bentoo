+// Story 041, task 7.1 — "Open Log" on a history row of the Agent Tasks panel (R5.7, R5.8; Q16).
+// Module path: `panel::open_log`. Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/open_log_tests.rs"]
+//     mod open_log;
+//
+// Validation filter: `cargo test -p agent_tasks_panel open_log`.
+//
+// Contract (design.md §Agent Tasks panel) and what this file assumes beyond it:
+//   - `AgentTasksPanel::open_log(&key, window, cx)`, the same shape as story 023's `open_task`;
+//   - `PanelRow::can_open_log: bool`, true exactly when the entry has `log_bytes`, beside story
+//     014's `can_stop` / `can_archive`;
+//   - the log root seam shared with the card and store tests: `agent_ui::task_log::LogsRootOverride`
+//     as a gpui global, read through `task_log::logs_root_in(cx)`;
+//   - the existence check reads the real disk (`is_file()`), while the workspace opens through its
+//     project's FakeFs: so each test writes the real file AND seeds a FakeFs copy at the same path.
+//
+// Hostile halves first: a record without a log is not offered "Open Log"; with (s1, t1) logged
+// and (s1, t10) not, opening t1 shows t1's text; a record whose file is gone says "Log no longer
+// available" and opens nothing.
+
+use std::path::{Path, PathBuf};
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use agent_ui::task_log::{LogsRootOverride, log_path, write_log};
+use gpui::TestAppContext;
+
+use crate::test_helpers::*;
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-panel-log-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Records (s1, t1) with a log of `t1_text` and (s1, t10) without one, before the panel loads.
+async fn seed(root: &Path, t1_text: &str, cx: &mut TestAppContext) -> PathBuf {
+    let db = init_base(cx);
+    let root_owned = root.to_path_buf();
+    cx.update(|cx| cx.set_global(LogsRootOverride(root_owned)));
+    for (index, task) in ["t1", "t10"].iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record("s1", task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record("s1", task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    let path = log_path(root, "s1", "t1");
+    let bytes = write_log(&path, t1_text).expect("seed the log");
+    db.set_log_bytes(
+        &sid("s1"),
+        &AgentTaskId::from("t1".to_string()),
+        Some(bytes),
+    )
+    .await
+    .unwrap();
+    path
+}
+
+async fn seed_fake_copy(panels: &mut Panels, path: &Path, text: &str) {
+    let fs = panels.cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    // FakeFs::insert_file needs the parent directory to exist (Run-mode fix, story 041 7.1).
+    fs.create_dir(path.parent().expect("a log has a parent dir"))
+        .await
+        .unwrap();
+    fs.as_fake()
+        .insert_file(path, text.as_bytes().to_vec())
+        .await;
+}
+
+fn row(panels: &mut Panels, task: &str) -> crate::PanelRow {
+    find_row(panels, "s1", task).unwrap_or_else(|| panic!("s1/{task} is listed"))
+}
+
+fn active_editor(panels: &mut Panels) -> Option<(bool, String)> {
+    let workspace = panels.workspace.clone();
+    workspace.update(&mut panels.cx, |workspace, cx| {
+        workspace
+            .active_item_as::<editor::Editor>(cx)
+            .map(|editor| {
+                let editor = editor.read(cx);
+                (editor.read_only(cx), editor.text(cx))
+            })
+    })
+}
+
+fn open_log(panels: &mut Panels, task: &str) {
+    let panel = panels.tasks_panel.clone();
+    let key = key("s1", task);
+    panel.update_in(&mut panels.cx, |panel, window, cx| {
+        panel.open_log(&key, window, cx)
+    });
+    panels.cx.run_until_parked();
+}
+
+// Hostile first: only a record with a log is offered the action.
