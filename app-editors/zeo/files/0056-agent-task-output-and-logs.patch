+        false,
+        &scratch.root(),
+        cx,
+    )
+    .await;
+    let card = rig.card.clone();
+
+    saved(&card, "s1", "t1", 4_242, &mut rig.cx);
+
+    let view = entries(&store, &rig.cx);
+    assert_eq!(find(&view, "s1", "t1").unwrap().log_bytes, Some(4_242));
+    assert_eq!(
+        find(&view, "s1", "t10").unwrap().log_bytes,
