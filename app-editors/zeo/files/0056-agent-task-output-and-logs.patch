+    // R4.3: updated with each snapshot.
+    send_tasks(
+        &a,
+        vec![shell("t1", Some(&["line 1", "line 2", "line 3"]), 1_000)],
+        &mut cx,
+    );
+    let row = find_row(&card, &sa, "t1", &mut cx).unwrap();
+    let tail: Vec<String> = row
+        .task
+        .tail
+        .as_ref()
+        .unwrap()
+        .iter()
+        .map(|l| l.to_string())
+        .collect();
+    assert_eq!(tail, vec!["line 1", "line 2", "line 3"]);
+    assert!(row.expanded, "a snapshot does not collapse the row");
