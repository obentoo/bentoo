--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/delete_removed_tests.rs
@@ -0,0 +1,38 @@
+// Story 041, group 5 tech review (S1): `delete` reports only the rows it removed, so a record
+// whose archive write failed (still unarchived in the database) keeps its log file.
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use gpui::TestAppContext;
+
+use crate::AgentTaskHistoryDb;
+use crate::test_helpers::*;
+
+#[gpui::test]
+async fn history_db_delete_reports_only_the_archived_rows_it_removed(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_delete_reports_removed").await;
+    for (index, task) in ["archived", "still_open"].iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record("s1", task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record("s1", task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    let key = |task: &str| (sid("s1"), AgentTaskId::from(task.to_string()));
+    db.set_archived(&[key("archived")], true).await.unwrap();
+
+    let removed = db
+        .delete(&[key("archived"), key("still_open")])
+        .await
+        .unwrap();
+
+    assert_eq!(
+        removed,
+        vec![0],
+        "only the archived row is removed and reported"
+    );
+    let left = db.load_all().await.unwrap();
+    assert!(find(&left, "s1", "still_open").is_some());
+    assert!(find(&left, "s1", "archived").is_none());
+}
