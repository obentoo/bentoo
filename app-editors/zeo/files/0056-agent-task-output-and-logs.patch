--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/log_bytes_tests.rs
@@ -0,0 +1,196 @@
+// Story 041, task 5.2 (database half) — the history records each task's log size: one appended
+// migration step, `set_log_bytes`, `HistoryEntry::log_bytes` (R6.1, R6.9; Q14). Module path:
+// `history_db::log_bytes`. Wired in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/log_bytes_tests.rs"]
+//     mod log_bytes;
+//
+// Validation filter: `cargo test -p agent_tasks_panel` (names carry `history_db_log_bytes`).
+//
+// Contract (design.md §Task history): the LAST step of `HISTORY_MIGRATIONS` is `ALTER TABLE
+// agent_task_history ADD COLUMN log_bytes INTEGER;` (NULL = no log); `AgentTaskHistoryDb::
+// set_log_bytes(session_id, task_id, bytes: Option<u64>)`; `HistoryEntry::log_bytes: Option<u64>`.
+// The step's index is not pinned: a batch sibling may append before this story, so the tests pin
+// the three shipped steps and the last one, never the length. Argument types are adapted in `set`.
+//
+// Hostile halves first: a database written by the SHIPPED steps, holding records, must open with
+// the new list and keep every record with no log; a size set on (s1, t1) must not land on
+// (s1, t10) or (s2, t1).
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use db::sqlez::{connection::Connection, domain::Domain};
+use db::sqlez_macros::sql;
+use gpui::TestAppContext;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+/// Step 0 exactly as patch 0035 shipped it (story 023's test carries the same copy).
+const SHIPPED_STEP_0: &str = sql!(
+    CREATE TABLE IF NOT EXISTS agent_task_history(
+        session_id TEXT NOT NULL,
+        task_id TEXT NOT NULL,
+        thread_title TEXT,
+        project TEXT NOT NULL,
+        kind TEXT NOT NULL,
+        description TEXT NOT NULL,
+        background INTEGER NOT NULL,
+        status TEXT NOT NULL,
+        started_at INTEGER NOT NULL,
+        ended_at INTEGER,
+        tokens INTEGER,
+        tool_uses INTEGER,
+        archived INTEGER NOT NULL DEFAULT 0,
+        PRIMARY KEY(session_id, task_id)
+    ) STRICT;
+    CREATE INDEX IF NOT EXISTS agent_task_history_started ON agent_task_history(started_at);
+);
+const SHIPPED_STEP_1: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN label TEXT;);
+const SHIPPED_STEP_2: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN tool_call_id TEXT;);
+const LOG_BYTES_STEP: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN log_bytes INTEGER;);
+
+fn migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+/// One fixed SQL statement of this test (sqlez, not a process).
+fn run_sql_now(connection: &Connection, statement: &str) {
+    let mut run = connection.exec(statement).expect("statement prepares");
+    run().expect("statement runs");
+}
+
+async fn set(db: &AgentTaskHistoryDb, session: &str, task: &str, bytes: Option<u64>) {
+    db.set_log_bytes(&sid(session), &AgentTaskId::from(task.to_string()), bytes)
+        .await
+        .expect("set_log_bytes should succeed");
+}
+
+fn log_bytes_of(rows: &[HistoryEntry], session: &str, task: &str) -> Option<u64> {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+        .log_bytes
+}
+
+async fn seeded(name: &'static str, keys: &[(&str, &str)]) -> AgentTaskHistoryDb {
+    let db = AgentTaskHistoryDb::open_test_db(name).await;
+    for (index, (session, task)) in keys.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    db
+}
+
+// ── Migration (R6.9, Q14) ──────────────────────────────────────────────────
+
+// Hostile: a pre-story database with records opens, keeps every record, each with no log.
+#[test]
+fn history_db_log_bytes_pre_story_database_keeps_every_record_without_a_log() {
+    let connection = Connection::open_memory(Some("history_db_log_bytes_pre_story"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &[SHIPPED_STEP_0, SHIPPED_STEP_1, SHIPPED_STEP_2],
+            &mut |_, _, _| false,
+        )
+        .expect("the shipped steps apply");
+    for (session, task) in [("s-old", "t1"), ("s-old", "t2"), ("s-other", "t1")] {
+        run_sql_now(
+            &connection,
+            &format!(
+                "INSERT INTO agent_task_history \
+                 (session_id, task_id, thread_title, project, kind, description, background, \
+                  status, started_at, ended_at, archived, label, tool_call_id) \
+                 VALUES ('{session}', '{task}', 'Old', 'zeo', 'shell', 'Old task', 1, \
+                         'completed', 1000, 2000, 1, 'kept label', 'toolu_x')"
+            ),
+        );
+    }
+
+    migrate_all(&connection);
+    migrate_all(&connection);
+
+    let rows = connection
+        .select::<(String, String, Option<String>, Option<String>, Option<i64>)>(
+            "SELECT session_id, task_id, label, tool_call_id, log_bytes FROM agent_task_history \
+             ORDER BY session_id, task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(rows.len(), 3, "every record survives");
+    for (session, task, label, tool_call_id, log_bytes) in rows {
+        assert_eq!(label.as_deref(), Some("kept label"), "{session}/{task}");
+        assert_eq!(tool_call_id.as_deref(), Some("toolu_x"), "{session}/{task}");
+        assert_eq!(log_bytes, None, "{session}/{task} has no log");
+    }
+}
+
+#[test]
+fn history_db_log_bytes_is_appended_after_the_shipped_steps() {
+    let steps = AgentTaskHistoryDb::MIGRATIONS;
+    assert_eq!(steps[0], SHIPPED_STEP_0, "step 0 is never edited");
+    assert!(
+        steps[1] == SHIPPED_STEP_1,
+        "story 022's step is left as shipped"
+    );
+    assert!(
+        steps[2] == SHIPPED_STEP_2,
+        "story 023's step is left as shipped"
+    );
+    assert!(
+        *steps.last().unwrap() == LOG_BYTES_STEP,
+        "this story's step is the last one"
+    );
+    assert_eq!(
+        steps.iter().filter(|step| **step == LOG_BYTES_STEP).count(),
+        1,
+        "appended exactly once"
+    );
+}
+
+// ── set_log_bytes and load_all (R6.1) ──────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_log_bytes_fresh_records_have_no_log(_cx: &mut TestAppContext) {
+    let db = seeded("history_db_log_bytes_fresh", &[("s1", "t1")]).await;
+    assert_eq!(log_bytes_of(&load(&db).await, "s1", "t1"), None);
+}
+
+// Hostile (wrong collapse): only (s1, t1) carries the size.
+#[gpui::test]
+async fn history_db_log_bytes_set_touches_only_its_own_row(_cx: &mut TestAppContext) {
+    let db = seeded(
+        "history_db_log_bytes_own_row",
+        &[("s1", "t1"), ("s1", "t10"), ("s2", "t1")],
+    )
+    .await;
+
+    set(&db, "s1", "t1", Some(4_096)).await;
+
+    let rows = load(&db).await;
+    assert_eq!(log_bytes_of(&rows, "s1", "t1"), Some(4_096));
+    assert_eq!(log_bytes_of(&rows, "s1", "t10"), None);
+    assert_eq!(log_bytes_of(&rows, "s2", "t1"), None);
+}
+
+#[gpui::test]
+async fn history_db_log_bytes_replaces_and_clears(_cx: &mut TestAppContext) {
+    let db = seeded("history_db_log_bytes_replace", &[("s1", "t1")]).await;
+    set(&db, "s1", "t1", Some(10)).await;
+    set(&db, "s1", "t1", Some(1_048_620)).await;
+    assert_eq!(log_bytes_of(&load(&db).await, "s1", "t1"), Some(1_048_620));
+
+    set(&db, "s1", "t1", None).await;
+    assert_eq!(log_bytes_of(&load(&db).await, "s1", "t1"), None);
+}
