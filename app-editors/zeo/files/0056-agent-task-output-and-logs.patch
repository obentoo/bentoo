+// Story 041, task 7.2 — "Open Log" on a card row is refused in a remote project (R5.10; Q5, Q16).
+// Filter: `cargo test -p agent_ui tasks_card::open_log` (the module path is
+// `tasks_card::open_log_remote::…`, so the 6.2 filter selects these tests too).
+//
+// Wired in `src/tasks_card.rs`, beside 6.2's `open_log` module:
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/open_log_remote_tests.rs"]
+//     mod open_log_remote;
+//
+// The remote seam: a REAL remote project, not a predicate. `Project::remote` over
+// `remote::RemoteClient::fake_server` + `connect_mock` — the mock transport `terminal_view`'s
+// `init_remote_test` already uses — so `is_via_remote_server()` is true and `is_local()` false
+// through the same code a live SSH project takes. No `remote_server::HeadlessProject`: the server
+// side is a bare session with two handlers, `Ping` (the client pings once on connect) and
+// `GetPathMetadata`, which RECORDS every path the client asks about and answers "exists, a file"
+// — the impostor design.md names: "an unrelated remote file at the same path would open
+// instead". An unguarded open resolves the log path on the remote host through exactly that
+// request (`Project::resolve_abs_file_path_canonical`), so "the log path never crossed the wire"
+// is the observable proof that nothing was read or opened remotely.
+//
+// Dependencies this file uses, all already in agent_ui's Cargo.toml (checked 2026-10-12):
+// `remote` (test-support), `proto`, `workspace` (test-support, for `AppState::test`), `fs`,
+// `release_channel`, `semver`. No Cargo.toml change is needed.
+//
+// Contract (design.md §`TasksCard` changes, "Remote projects (R5.10)"; story.md R5.10, R6.1 and
+// Out of Scope "the copy on end still saves the log"), and what this file assumes beyond it —
+// all of it already true in the 6.2 build:
+//   - `TasksCard::open_log(session_id, task_id, window, cx)`, emitting `OpenLog`, handled by
+//     `AgentPanel` (`open_log_from_card`);
+//   - the row's message is read back through `TaskRow::error`;
+//   - `task_log::{LogsRootOverride, log_path, render_log}`.
+// The refusal text is pinned exactly: "Open Log is not available in remote projects".
+// Whether the card still fetches and saves before the panel refuses is NOT pinned.
+//
+// Order: hostile halves first —
+//   1. remote (wrong "open"): the row says the notice, no tab opens, the log path is never sent
+//      to the remote host, and a sibling row is not marked;
+//   2. remote (wrong over-reach): the refusal must not swallow the copy on end — an ended shell's
+//      log is still written locally, with no row message;
+// then the converse —
+//   3. local: the same row opens its log read-only with no message.
+//
+// Red, before 7.2: test 1 fails on its first assertion — the unguarded panel resolves the path on
+// the remote host (the recorder sees it) and the row shows "Could not open the log: …" or
+// nothing, never the notice. Tests 2 and 3 are guards against an over-broad fix and may already
+// pass; Red for 7.2 is test 1.
+
+use std::{
+    any::Any,
+    collections::HashMap,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::{Arc, Mutex},
+};
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection, TaskOutput};
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{App, AppContext as _, Entity, SharedString, Task, TestAppContext, VisualTestContext};
+use project::{AgentId, Project};
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList, Workspace};
+
+use super::task_log::{LogsRootOverride, log_path, render_log};
+use super::test_helpers::*;
+use crate::AgentPanel;
+use crate::conversation_view::tests::init_test;
+use crate::test_support::open_thread_with_custom_connection;
+
+const REMOTE_NOTICE: &str = "Open Log is not available in remote projects";
+
+// ---- A connection that answers `fetch_task_output` (a trimmed copy of 6.2's) -------------
+
+#[derive(Clone)]
+struct OutputConnection {
+    stub: StubAgentConnection,
+    next_session: Arc<Mutex<usize>>,
+    answers: Arc<Mutex<HashMap<(String, String), TaskOutput>>>,
+}
+
+impl OutputConnection {
+    fn new() -> Self {
+        Self {
+            stub: StubAgentConnection::new(),
+            next_session: Arc::new(Mutex::new(0)),
+            answers: Arc::default(),
+        }
+    }
+
+    fn answer(&self, session: &acp_v2::SessionId, task: &str, output: TaskOutput) {
+        self.answers
+            .lock()
+            .unwrap()
+            .insert((session.to_string(), task.to_string()), output);
+    }
+}
+
+impl AgentConnection for OutputConnection {
+    fn agent_id(&self) -> AgentId {
+        self.stub.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "open-log-remote-test".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let session_id = {
+            let mut next = self.next_session.lock().unwrap();
+            *next += 1;
+            acp_v2::SessionId::new(format!("open-log-remote-session-{}", *next))
+        };
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: acp_v2::AuthMethodId, _cx: &mut App) -> Task<Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: acp_v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        Task::ready(Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) -> Result<()> {
+        Ok(())
+    }
+
+    fn fetch_task_output(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<TaskOutput>> {
+        let key = (session_id.to_string(), task_id.to_string());
+        let answer = self.answers.lock().unwrap().get(&key).cloned();
+        Task::ready(answer.ok_or_else(|| {
+            anyhow!("_claude/tasks/output failed for {task_id}: no answer scripted")
+        }))
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+// ---- Rig -----------------------------------------------------------------------------------
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-open-log-remote-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// The remote host's side: every path the client asked `GetPathMetadata` about. The `anchor`
+/// owns the handlers; drop it and the server stops answering.
+struct RemoteHost {
+    asked: Arc<Mutex<Vec<String>>>,
+    _anchor: Entity<()>,
+}
+
+impl RemoteHost {
+    fn asked(&self) -> Vec<String> {
+        self.asked.lock().unwrap().clone()
+    }
+}
+
+/// A visible agent panel in a workspace window whose project is a real remote-server project
+/// over the mock transport.
+async fn setup_remote_card_panel(
+    cx: &mut TestAppContext,
+    server_cx: &mut TestAppContext,
+) -> (
+    Entity<AgentPanel>,
+    Entity<Workspace>,
+    RemoteHost,
+    VisualTestContext,
+) {
+    init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    server_cx.update(|cx| release_channel::init(semver::Version::new(0, 0, 0), cx));
+    // The client, user store, languages and node runtime for `Project::remote`, as
+    // `terminal_view`'s `init_remote_test` takes them. `AppState::test` installs its own FakeFs
+    // as the global; it is the one the project and the tests use.
+    let params = cx.update(workspace::AppState::test);
+
+    let (opts, server_session, connect_guard) = remote::RemoteClient::fake_server(cx, server_cx);
+    let anchor = server_cx.new(|_| ());
+    server_session
+        .add_request_handler::<proto::Ping, _, _, _>(anchor.downgrade(), |_, _, _| async {
+            Ok(proto::Ack {})
+        });
+    let asked: Arc<Mutex<Vec<String>>> = Arc::default();
+    let recorder = asked.clone();
+    server_session.add_request_handler::<proto::GetPathMetadata, _, _, _>(
+        anchor.downgrade(),
+        move |_, envelope, _| {
+            let recorder = recorder.clone();
+            async move {
+                let path = envelope.payload.path;
+                recorder.lock().unwrap().push(path.clone());
+                // The impostor: the remote host claims a file at whatever path is asked.
+                Ok(proto::GetPathMetadataResponse {
+                    exists: true,
+                    path,
+                    is_dir: false,
+                })
+            }
+        },
+    );
+    drop(connect_guard);
+
+    let remote_client = remote::RemoteClient::connect_mock(opts, cx).await;
+    let project = cx.update(|cx| {
+        Project::remote(
+            remote_client,
+            params.client.clone(),
+            params.node_runtime.clone(),
+            params.user_store.clone(),
+            params.languages.clone(),
+            params.fs.clone(),
+            false,
+            cx,
+        )
+    });
+    project.read_with(cx, |project, _| {
+        assert!(
+            project.is_via_remote_server() && !project.is_local(),
+            "the rig must build a remote-server project"
+        );
+    });
+
+    // `AppState::test` already registered a `WorkspaceStore` on `params.client`, and
+    // `MultiWorkspace::test_new` would register a second one on the project's (same) client —
+    // "registered handler for the same message proto::Follow twice". Build the workspace on
+    // `params`, as `terminal_view`'s `init_remote_test` does.
+    let multi_workspace = cx.add_window({
+        // Run-mode fix, story 041 7.2
+        let params = params.clone(); // Run-mode fix, story 041 7.2
+        move |window, cx| {
+            // Run-mode fix, story 041 7.2
+            window.activate_window(); // Run-mode fix, story 041 7.2
+            let workspace = // Run-mode fix, story 041 7.2
+                cx.new(|cx| Workspace::new(None, project, params, window, cx)); // Run-mode fix, story 041 7.2
+            MultiWorkspace::new(workspace, window, cx) // Run-mode fix, story 041 7.2
+        } // Run-mode fix, story 041 7.2
+    }); // Run-mode fix, story 041 7.2
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(800.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    (
+        panel,
+        workspace,
+        RemoteHost {
+            asked,
+            _anchor: anchor,
+        },
+        cx,
+    )
+}
+
+fn use_scratch_logs_root(root: &Path, cx: &mut VisualTestContext) {
+    let root = root.to_path_buf();
+    cx.update(|_, cx| cx.set_global(LogsRootOverride(root)));
+}
