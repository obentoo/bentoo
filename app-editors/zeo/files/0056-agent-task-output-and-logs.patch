+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-store-log-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn use_scratch_logs_root(root: &Path, cx: &mut TestAppContext) {
+    let root = root.to_path_buf();
+    cx.update(|cx| cx.set_global(LogsRootOverride(root)));
+}
+
+fn put_log(root: &Path, session: &str, task: &str) -> PathBuf {
+    let path = log_path(root, session, task);
+    write_log(&path, "log text\n").expect("seed log");
+    path
+}
