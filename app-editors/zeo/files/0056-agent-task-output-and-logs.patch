+fn shell(id: &str, status: &str) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, 1_000);
+    task["hasOutput"] = json!(true);
+    task["tail"] = json!(null);
+    task
+}
+
+fn out(content: &str) -> TaskOutput {
+    TaskOutput {
+        content: content.to_string(),
+        total_bytes: content.len() as u64,
+        truncated: false,
+    }
+}
+
+fn active_editor(
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Option<(bool, String)> {
+    workspace.update(cx, |workspace, cx| {
+        workspace
+            .active_item_as::<editor::Editor>(cx)
+            .map(|editor| {
+                let editor = editor.read(cx);
+                (editor.read_only(cx), editor.text(cx))
+            })
+    })
+}
+
+fn open_log(
+    card: &Entity<super::TasksCard>,
+    session: &acp_v2::SessionId,
+    task: &str,
+    cx: &mut VisualTestContext,
+) {
+    let task: acp_thread::AgentTaskId = task.to_string().into();
+    card.update_in(cx, |card, window, cx| {
+        card.open_log(session.clone(), task, window, cx)
+    });
+    cx.run_until_parked();
+}
