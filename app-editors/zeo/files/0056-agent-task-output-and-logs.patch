+// Story 041, task 6.2 — "Open Log" on a card row, and the copy of a shell's log when it ends
+// (R5.1, R5.2, R5.3, R6.1, R6.4, R6.7; Q4, Q16). Filter: `tasks_card::open_log`.
+//
+// Wired in `src/tasks_card.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/open_log_tests.rs"]
+//     mod open_log;
+//
+// Contract (design.md §`TasksCard` changes, §`task_log`) and what this file assumes beyond it:
+//   - `TasksCard::open_log(session_id, task_id, window, cx)`, public like `open_task`;
+//   - `TasksCardEvent::TaskLogSaved { session_id, task_id, bytes: Option<u64> }` then `TasksCardEvent::OpenLog
+//     { session_id, task_id, path }`; the agent panel opens `path` read-only;
+//   - debug selector `tasks-card-open-log-{id}`;
+//   - the test seam shared with the store and panel tests: the card reads the log root through
+//     `task_log::logs_root_in(cx)`, which honours the `task_log::LogsRootOverride(PathBuf)` gpui
+//     global (never set in production). Change `use_scratch_logs_root` only if the seam differs.
+//
+// The workspace in these tests runs on a FakeFs while `write_log` writes the real disk (the
+// design's std::fs code). So the opened tab is checked against a FakeFs copy seeded at the
+// path the card is expected to write, BEFORE the click; the real file is checked on disk. The
+// GUI proof (task 8.2) covers the real filesystem end to end.
+//
+// Hostile halves first: a shell without output and a subagent get no "Open Log"; a failed fetch
+// or write opens nothing and says why on the row; two threads' `t1` never share a log; an ended
+// shell without output, or a subagent, is never fetched; a failed copy on end shows nothing on
+// the row (nobody asked) and records nothing.
+
+use std::{
+    any::Any,
+    cell::RefCell,
+    collections::HashMap,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::{Arc, Mutex},
+};
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection, TaskOutput};
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{App, AppContext as _, Entity, SharedString, Task, TestAppContext, VisualTestContext};
+use project::{AgentId, Project};
+use serde_json::json;
+use workspace::PathList;
+
+use super::task_log::{LogsRootOverride, log_path, render_log};
+use super::test_helpers::*;
+use super::{TasksCard, TasksCardEvent};
+use crate::test_support::open_thread_with_custom_connection;
+
+// ---- A connection that answers `fetch_task_output` as scripted ------------------------------
+
+#[derive(Clone)]
+struct OutputConnection {
+    stub: StubAgentConnection,
+    next_session: Arc<Mutex<usize>>,
+    /// task id -> the answer; a missing id answers an error.
+    answers: Arc<Mutex<HashMap<(String, String), std::result::Result<TaskOutput, String>>>>,
+    fetches: Arc<Mutex<Vec<(String, String)>>>,
+}
+
+impl OutputConnection {
+    fn new() -> Self {
+        Self {
+            stub: StubAgentConnection::new(),
+            next_session: Arc::new(Mutex::new(0)),
+            answers: Arc::default(),
+            fetches: Arc::default(),
+        }
+    }
+
+    fn answer(
+        &self,
+        session: &acp_v2::SessionId,
+        task: &str,
+        answer: std::result::Result<TaskOutput, String>,
+    ) {
+        self.answers
+            .lock()
+            .unwrap()
+            .insert((session.to_string(), task.to_string()), answer);
+    }
+
+    fn fetches(&self) -> Vec<(String, String)> {
+        self.fetches.lock().unwrap().clone()
+    }
+}
+
+impl AgentConnection for OutputConnection {
+    fn agent_id(&self) -> AgentId {
+        self.stub.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "open-log-test".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let session_id = {
+            let mut next = self.next_session.lock().unwrap();
+            *next += 1;
+            acp_v2::SessionId::new(format!("open-log-session-{}", *next))
+        };
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: acp_v2::AuthMethodId, _cx: &mut App) -> Task<Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: acp_v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        Task::ready(Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) -> Result<()> {
+        Ok(())
+    }
+
+    fn fetch_task_output(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<TaskOutput>> {
+        let key = (session_id.to_string(), task_id.to_string());
+        self.fetches.lock().unwrap().push(key.clone());
+        let answer = self.answers.lock().unwrap().get(&key).cloned();
+        Task::ready(match answer {
+            Some(Ok(output)) => Ok(output),
+            Some(Err(message)) => Err(anyhow!(
+                "_claude/tasks/output failed for {task_id}: {message}"
+            )),
+            None => Err(anyhow!(
+                "_claude/tasks/output failed for {task_id}: no answer scripted"
+            )),
+        })
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+// ---- Rig ---------------------------------------------------------------------------------
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-open-log-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+    fn root(&self) -> PathBuf {
+        self.0.join("agent_task_logs")
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
