+// Story 041, group 5 tech review — regressions for what the review found in `task_log`:
+// B1 (a test build must never resolve the real data directory), S2 (a stale "no log" must not
+// delete a newer save), N1 (symlinks under the root are neither followed nor tightened).
+
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::PathBuf;
+use std::time::{Duration, SystemTime};
+
+use gpui::TestAppContext;
+
+use super::*;
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(name: &str) -> Self {
+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_nanos())
+            .unwrap_or_default();
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-task-log-review-{name}-{}-{nanos}",
+            std::process::id()
+        ));
+        fs::create_dir_all(&dir).expect("scratch dir");
+        Scratch(dir)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        fs::remove_dir_all(&self.0).ok();
+    }
+}
+
+// B1: without an override, a test build gets a private temp root, never `<data dir>/…`.
+#[gpui::test]
+fn task_log_review_test_build_never_resolves_the_real_data_dir(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let root = logs_root_in(cx);
+        assert!(root.starts_with(std::env::temp_dir()), "{root:?}");
+        assert!(!root.starts_with(paths::data_dir()), "{root:?}");
+
+        cx.set_global(LogsRootOverride(PathBuf::from("/override")));
+        assert_eq!(logs_root_in(cx), PathBuf::from("/override"));
+    });
+}
+
+// S2: a "no log" heard before a newer save leaves that save; one heard after deletes it.
+#[test]
+fn task_log_review_stale_no_log_keeps_a_newer_save_and_deletes_an_older_one() {
+    let scratch = Scratch::new("stale");
+    let root = scratch.0.join("logs");
+    let path = log_path(&root, "s1", "t1");
+    write_log(&path, "fresh\n").unwrap();
+
+    let before_the_save = SystemTime::now() - Duration::from_secs(60);
+    assert!(!delete_log_unless_newer(&root, "s1", "t1", before_the_save).unwrap());
+    assert!(path.exists(), "a save newer than the event is kept");
+
+    let after_the_save = SystemTime::now() + Duration::from_secs(60);
+    assert!(delete_log_unless_newer(&root, "s1", "t1", after_the_save).unwrap());
+    assert!(!path.exists());
+}
+
+// N1: a session entry that is a symlink to another directory is not swept into.
+#[test]
+fn task_log_review_sweep_does_not_follow_a_symlinked_session_directory() {
+    let scratch = Scratch::new("sweep-link");
+    let root = scratch.0.join("logs");
+    let outside = scratch.0.join("outside");
+    fs::create_dir_all(&root).unwrap();
+    fs::create_dir_all(&outside).unwrap();
+    fs::write(outside.join("precious.log"), "not ours").unwrap();
+    std::os::unix::fs::symlink(&outside, root.join("planted")).unwrap();
+
+    sweep(
+        &root,
+        &HashSet::new(),
+        SystemTime::now() + Duration::from_secs(3600),
+    )
+    .unwrap();
+
+    assert!(outside.join("precious.log").exists());
+}
+
+// N1: a session directory that is a symlink is refused, and its target's mode is left alone.
+#[test]
+fn task_log_review_write_refuses_a_symlinked_session_directory() {
+    let scratch = Scratch::new("write-link");
+    let root = scratch.0.join("logs");
+    let outside = scratch.0.join("outside");
+    fs::create_dir_all(&root).unwrap();
+    fs::create_dir_all(&outside).unwrap();
+    fs::set_permissions(&outside, fs::Permissions::from_mode(0o755)).unwrap();
+    std::os::unix::fs::symlink(&outside, root.join("s1")).unwrap();
+
+    let error = write_log(&log_path(&root, "s1", "t1"), "x\n").expect_err("a symlink is refused");
+    assert!(format!("{error:#}").contains("symlink"), "{error:#}");
+    let mode = fs::metadata(&outside).unwrap().permissions().mode() & 0o777;
+    assert_eq!(mode, 0o755);
+    assert!(
+        fs::read_dir(&outside).unwrap().next().is_none(),
+        "nothing written there"
+    );
+}
