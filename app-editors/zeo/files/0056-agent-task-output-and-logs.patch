+// Story 041, task 4.3 — `AcpConnection::fetch_task_output` against a fake ACP peer: the version
+// gate, the request it sends, the strict response parse, the agent's error (R3.4, R3.5; Q4, Q12).
+//
+// Included at the end of `mod tests` in `acp.rs`, AFTER the story 012 file whose fake peer it
+// reuses:
+//
+//     include!("acp_task_actions_tests.rs");
+//     include!("acp_task_output_tests.rs");
+//
+// so `connect_task_actions_peer`, `task_actions_session`, `task_actions_requests`,
+// `tasks_capability_v`, `PLUS_ENTRY` and `PLUS_NAME` are in scope. Every test name carries
+// `tasks` and `task_output` (filter `cargo test -p agent_servers tasks`).
+//
+// Contract (design.md §`AgentConnection::fetch_task_output`): `fn fetch_task_output(self: Rc<Self>,
+// session_id: &acp_v2::SessionId, task_id: &str, cx: &mut App) -> Task<Result<TaskOutput>>`, the
+// same shape as story 012's `stop_task`; `acp_thread::TaskOutput { content: String, total_bytes:
+// u64, truncated: bool }`; output needs `_claude/tasks` version >= 2 while stop keeps >= 1.
+// If the trait method's argument types differ, adapt `fetch` below only.
+//
+// Hostile halves first: a version 1 agent — one that stop and background still work with — must
+// be sent NOTHING for output; a response missing any one field must be an error naming it, never a
+// TaskOutput with a default value.
+
+const TASK_OUTPUT_FIXTURE: &str =
+    include_str!("../../acp_thread/src/test_data/claude_tasks_output.json");
+
+async fn fetch(
+    peer: &TaskActionsPeer,
+    session_id: &acp_v2::SessionId,
+    task_id: &str,
+    cx: &mut gpui::TestAppContext,
+) -> anyhow::Result<acp_thread::TaskOutput> {
+    cx.update(|cx| {
+        peer.connection
+            .clone()
+            .fetch_task_output(session_id, task_id, cx)
+    })
+    .await
+}
+
+fn task_output_reply(value: serde_json::Value) -> TaskActionsReply {
+    Arc::new(move |_method, _params| Ok(value.clone()))
+}
+
+fn task_output_fixture() -> serde_json::Value {
+    serde_json::from_str(TASK_OUTPUT_FIXTURE).expect("the output fixture is JSON")
+}
+
+// ---- R3.5 — hostile first: below version 2, nothing is sent --------------------------------
+
+#[gpui::test]
+async fn test_tasks_task_output_unsupported_below_version_2_and_sends_nothing(
+    cx: &mut gpui::TestAppContext,
+) {
+    for capability in [None, tasks_capability_v(0), tasks_capability_v(1)] {
+        let peer = connect_task_actions_peer(
+            PLUS_ENTRY,
+            PLUS_NAME,
+            capability.clone(),
+            task_output_reply(task_output_fixture()),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+        let error = fetch(&peer, &session_id, "b1", cx)
+            .await
+            .expect_err("output is unsupported below version 2");
+        let text = format!("{error:#}").to_lowercase();
+        assert!(text.contains("not supported"), "{capability:?}: {text}");
+        assert!(
+            task_actions_requests(&peer).is_empty(),
+            "{capability:?}: nothing reached the agent"
+        );
+    }
+}
+
+#[gpui::test]
+async fn test_tasks_task_output_unsupported_names_the_advertised_version(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        task_output_reply(task_output_fixture()),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+    let text = format!(
+        "{:#}",
+        fetch(&peer, &session_id, "b1", cx).await.unwrap_err()
+    );
+    assert!(text.contains("version 1"), "{text}");
+}
+
+// Converse: the version 1 gate of stop is unchanged by the new method.
+#[gpui::test]
+async fn test_tasks_task_output_version_1_agent_still_stops(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        task_actions_ok(),
+        cx,
+    )
