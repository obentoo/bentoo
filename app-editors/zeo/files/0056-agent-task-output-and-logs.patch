+            .pl_1()
+            .child(
+                Label::new("No output yet")
+                    .size(LabelSize::XSmall)
+                    .color(Color::Muted),
+            )
+            .into_any_element();
+    };
+    v_flex()
+        .debug_selector(move || format!("tasks-card-tail-{task_id}"))
+        .min_w_0()
+        .overflow_hidden()
+        .px_1()
+        .rounded_sm()
+        .bg(cx.theme().colors().editor_background)
+        .children(lines.iter().map(|line| {
+            Label::new(tail_line(line))
+                .size(LabelSize::XSmall)
+                .buffer_font(cx)
+                .single_line()
+                .truncate()
+        }))
+        .into_any_element()
+}
+
+/// The task kind whose rows show a tail (R4.3).
+const SHELL_KIND: &str = "shell";
+
+/// The task kind that runs in a thread of its own (R5.4).
+const SUBAGENT_KIND: &str = "subagent";
+
+/// A tail entry on one row of the block: `single_line` stops soft wrapping, but a line break
+/// inside the text would still start a new line and draw over the next entry.
+fn tail_line(line: &SharedString) -> SharedString {
+    if line.contains(['\n', '\r']) {
+        line.replace(['\n', '\r'], " ").into()
+    } else {
+        line.clone()
+    }
+}
+
+/// The label of the root thread's tool call that started `task` — the command line for a
+/// Bash call — else the task's description (R4.1). Only the task's own tool call counts.
+fn running_what(thread: &AcpThread, task: &AgentTask, cx: &App) -> SharedString {
+    task.tool_call_id
+        .as_ref()
+        .and_then(|id| thread.tool_call(id))
+        .map(|(_, tool_call)| tool_call.label.read(cx).source())
+        .filter(|label| !label.trim().is_empty())
+        .map(|label| SharedString::from(label.to_string()))
+        .unwrap_or_else(|| task.description.clone())
+}
