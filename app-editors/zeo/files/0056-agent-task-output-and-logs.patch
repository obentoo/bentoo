index 0000000..6323643
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/task_log.rs
@@ -0,0 +1,349 @@
+//! Where an agent task's saved log lives, and how it is written (story 041).
+//!
+//! A shell task's output is copied here when it ends, and when the operator opens its log, so the
+//! log outlives the agent's temporary file. A log can hold secrets, so it is written mode 0600
+//! inside directories of mode 0700, replaced atomically, capped at [`LOG_MAX_BYTES`], deleted with
+//! its task record and swept when its record is gone. No log line carries its content.
+
+use std::collections::HashSet;
+use std::fs;
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use acp_thread::TaskOutput;
+use anyhow::{Context as _, Result};
+use gpui::{App, Global};
+
+/// The most output a log keeps; an agent that sends more is cut again at a line boundary.
+pub const LOG_MAX_BYTES: usize = 1_048_576;
+
+/// What a row says when "Open Log" is asked in a remote project (R5.10, R5.11): a log is a local
+/// file, and opening it there would resolve its path on the remote host instead.
+pub const REMOTE_PROJECT_NOTICE: &str = "Open Log is not available in remote projects";
+
+const LOG_EXTENSION: &str = "log";
+const TEMP_MARKER: &str = ".log.tmp-";
+
+/// `<data dir>/agent_task_logs`.
+pub fn logs_root() -> PathBuf {
+    paths::data_dir().join("agent_task_logs")
+}
+
+/// Points [`logs_root_in`] somewhere else. Tests only: production never sets it.
+pub struct LogsRootOverride(pub PathBuf);
+
+impl Global for LogsRootOverride {}
+
+/// The logs root every caller uses: [`LogsRootOverride`] when a test set one, else
+/// [`logs_root`] scoped to this build's release channel.
+///
+/// Scoped by channel because the task history is: its database lives under
+/// `db/0-<channel>`, and the orphan sweep keeps only the logs of the records ONE history holds.
+/// A shared root would let a dev or preview build sweep the stable build's logs.
+///
+/// Test builds never resolve the real data directory: without an override they get a
+/// per-process directory under the system temp dir, so a test that builds a history store
+/// cannot sweep the operator's logs.
+pub fn logs_root_in(cx: &App) -> PathBuf {
+    if let Some(root) = cx.try_global::<LogsRootOverride>() {
+        return root.0.clone();
+    }
+    #[cfg(any(test, feature = "test-support"))]
+    {
+        std::env::temp_dir().join(format!("zeo-agent-task-logs-test-{}", std::process::id()))
+    }
+    #[cfg(not(any(test, feature = "test-support")))]
+    {
+        logs_root().join(release_channel::RELEASE_CHANNEL.dev_name())
+    }
+}
+
+/// `root/<session>/<task>.log`, with each id mapped to a file-name component that holds no
+/// separator and no `..`, and that no other id maps to.
+pub fn log_path(root: &Path, session_id: &str, task_id: &str) -> PathBuf {
+    root.join(component(session_id))
+        .join(format!("{}.{LOG_EXTENSION}", component(task_id)))
+}
+
+/// An id as a file-name component. Three forms that cannot meet:
+/// - a plain id (`^[A-Za-z0-9_-]{1,128}$`) is kept as it is, and never contains `@`;
+/// - any other id is `@` + the lowercase hex of its bytes, when that is at most 200 characters;
+/// - a longer one is `@h` + its FNV-1a 128-bit hash (`h` is not a hex digit).
+///
+/// The first two forms are injective. The hash form is not collision-resistant: two ids over
+/// 100 bytes crafted to collide would share a file. Ids come from the agent the operator runs,
+/// so this is accepted; nothing is ever cut, which would make collisions trivial.
+fn component(id: &str) -> String {
+    let plain = !id.is_empty()
+        && id.len() <= 128
+        && id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-');
+    if plain {
+        return id.to_string();
+    }
+    let hex: String = id.bytes().map(|byte| format!("{byte:02x}")).collect();
+    if hex.len() <= 200 {
+        format!("@{hex}")
+    } else {
+        format!("@h{:032x}", fnv1a_128(id.as_bytes()))
+    }
+}
+
+fn fnv1a_128(bytes: &[u8]) -> u128 {
+    const OFFSET_BASIS: u128 = 0x6c62272e07bb014262b821756295c58d;
+    const PRIME: u128 = 0x0000000001000000000000000000013b;
+    bytes.iter().fold(OFFSET_BASIS, |hash, byte| {
+        (hash ^ u128::from(*byte)).wrapping_mul(PRIME)
+    })
+}
+
+/// The log text for `output`: the content, capped at [`LOG_MAX_BYTES`] on a line boundary, under
+/// a `[earlier output truncated: N bytes]` header whenever bytes of the output are not in it.
+pub fn render_log(output: &TaskOutput) -> String {
+    let content = output.content.as_str();
+    let (body, cut) = if content.len() > LOG_MAX_BYTES {
+        (cap_at_line_boundary(content), true)
+    } else {
+        (content, false)
+    };
+    if !output.truncated && !cut {
+        return body.to_string();
+    }
+    let total = output.total_bytes.max(content.len() as u64);
+    let dropped = total.saturating_sub(body.len() as u64);
+    format!("[earlier output truncated: {dropped} bytes]\n{body}")
+}
+
+/// The last `LOG_MAX_BYTES` of `content`, starting on a line (never inside a line or a UTF-8
+/// sequence). A window with no newline keeps whatever whole characters fit.
+fn cap_at_line_boundary(content: &str) -> &str {
+    let start = content.len() - LOG_MAX_BYTES;
+    if content.as_bytes()[start - 1] == b'\n' {
+        return &content[start..];
+    }
+    // `start` is a byte offset and may fall inside a multibyte character (U+FFFD from the
+    // adapter's lossy decode is three bytes), so the newline is searched in bytes: the byte
+    // after a `\n` always begins a character.
+    match content.as_bytes()[start..]
+        .iter()
+        .position(|byte| *byte == b'\n')
+    {
+        Some(newline) => &content[start + newline + 1..],
+        None => {
+            let mut start = start;
+            while !content.is_char_boundary(start) {
+                start += 1;
+            }
+            &content[start..]
+        }
+    }
+}
+
+/// Writes `text` to `path` atomically, mode 0600, its directories tightened to 0700. Returns the
+/// bytes written. On failure the temporary file is removed and whatever was at `path` is left as
+/// it was; the error names the path, never the text.
+pub fn write_log(path: &Path, text: &str) -> Result<u64> {
+    write_log_inner(path, text).with_context(|| format!("writing task log {}", path.display()))
+}
+
+fn write_log_inner(path: &Path, text: &str) -> Result<u64> {
+    let session_dir = path
+        .parent()
+        .context("a task log path has a session directory")?;
+    let root = session_dir
+        .parent()
+        .context("a task log path has a root directory")?;
+    create_private_dirs(session_dir)?;
+    tighten(root)?;
+    tighten(session_dir)?;
+
+    let file_name = path
+        .file_name()
+        .context("a task log path has a file name")?
+        .to_string_lossy();
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_nanos())
+        .unwrap_or_default();
+    // Same directory as the target: `rename` is atomic only within one filesystem.
+    let temporary = session_dir.join(format!(
+        "{}{}{}-{nanos}",
+        file_name.trim_end_matches(".log"),
+        TEMP_MARKER,
+        std::process::id()
+    ));
+    let result = write_and_rename(&temporary, path, text.as_bytes());
+    if result.is_err() {
+        fs::remove_file(&temporary).ok();
+    }
+    result
+}
+
+fn write_and_rename(temporary: &Path, path: &Path, bytes: &[u8]) -> Result<u64> {
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt as _;
+        options.mode(0o600);
+    }
+    let mut file = options
+        .open(temporary)
+        .context("creating the temporary log file")?;
+    file.write_all(bytes)
+        .context("writing the temporary log file")?;
+    file.sync_all().context("syncing the temporary log file")?;
+    drop(file);
+    fs::rename(temporary, path).context("moving the log into place")?;
+    Ok(bytes.len() as u64)
+}
+
+/// Creates the directories at mode 0700 from the start, so none is ever wider in between.
+fn create_private_dirs(dir: &Path) -> Result<()> {
+    let mut builder = fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt as _;
+        builder.mode(0o700);
+    }
+    builder.create(dir).context("creating the log directories")
+}
+
+/// A directory that already existed may be wider than 0700. A symlink is refused rather than
+/// followed: `set_permissions` would change the mode of whatever it points to.
+fn tighten(dir: &Path) -> Result<()> {
+    let metadata =
+        fs::symlink_metadata(dir).with_context(|| format!("reading {}", dir.display()))?;
+    anyhow::ensure!(
+        !metadata.file_type().is_symlink(),
+        "{} is a symlink",
+        dir.display()
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt as _;
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o700))
+            .with_context(|| format!("restricting {} to 0700", dir.display()))?;
+    }
+    Ok(())
+}
+
+/// Deletes the log of `(session_id, task_id)`. A missing file is success; a session directory
+/// left empty is removed.
+pub fn delete_log(root: &Path, session_id: &str, task_id: &str) -> Result<()> {
+    let path = log_path(root, session_id, task_id);
+    match fs::remove_file(&path) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => {
+            return Err(error).with_context(|| format!("deleting task log {}", path.display()));
+        }
+    }
+    if let Some(session_dir) = path.parent()
+        && fs::read_dir(session_dir).is_ok_and(|mut entries| entries.next().is_none())
+    {
+        fs::remove_dir(session_dir).ok();
+    }
+    Ok(())
+}
+
+/// Like [`delete_log`], but leaves a file modified after `heard_at`: a "no log" decided before
+/// a newer successful save must not delete that save's file.
+pub fn delete_log_unless_newer(
+    root: &Path,
+    session_id: &str,
+    task_id: &str,
+    heard_at: SystemTime,
+) -> Result<bool> {
+    let path = log_path(root, session_id, task_id);
+    let newer = fs::metadata(&path)
+        .and_then(|metadata| metadata.modified())
+        .is_ok_and(|modified| modified > heard_at);
+    if newer {
+        return Ok(false);
+    }
+    delete_log(root, session_id, task_id).map(|()| true)
+}
+
+/// What [`sweep`] did.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct SweepReport {
+    pub removed: usize,
+    pub kept: usize,
+    pub other: usize,
+}
+
+/// Removes every log and temporary log under `root` that belongs to no key in `keep`, unless it
+/// was modified after `newer_than` (a log saved while the history was loading). Files with any
+/// other name are left alone and counted. A missing root is nothing to sweep.
+pub fn sweep(
+    root: &Path,
+    keep: &HashSet<(String, String)>,
+    newer_than: SystemTime,
+) -> Result<SweepReport> {
+    let mut report = SweepReport::default();
+    let sessions = match fs::read_dir(root) {
+        Ok(sessions) => sessions,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(report),
+        Err(error) => {
+            return Err(error).with_context(|| format!("reading {}", root.display()));
+        }
+    };
+    // Forward mapping: a hashed name cannot be mapped back to its id.
+    let kept_paths: HashSet<PathBuf> = keep
+        .iter()
+        .map(|(session, task)| log_path(root, session, task))
+        .collect();
+    for session in sessions.filter_map(|entry| entry.ok()) {
+        let session_dir = session.path();
+        // `DirEntry::file_type` does not follow symlinks: a link planted under the root must
+        // not lead the sweep into another directory.
+        if !session.file_type().is_ok_and(|kind| kind.is_dir()) {
+            report.other += 1;
+            continue;
+        }
+        let Ok(files) = fs::read_dir(&session_dir) else {
+            continue;
+        };
+        for file in files.filter_map(|entry| entry.ok()) {
+            let path = file.path();
+            let name = file.file_name().to_string_lossy().into_owned();
+            let is_file = file.file_type().is_ok_and(|kind| kind.is_file());
+            let is_log = is_file && (name.ends_with(".log") || name.contains(TEMP_MARKER));
+            if !is_log {
+                report.other += 1;
+                continue;
+            }
+            let fresh = file
+                .metadata()
+                .and_then(|metadata| metadata.modified())
+                .is_ok_and(|modified| modified > newer_than);
+            if kept_paths.contains(&path) || fresh {
+                report.kept += 1;
+                continue;
+            }
+            match fs::remove_file(&path) {
+                Ok(()) => report.removed += 1,
+                Err(error) => log::warn!(
+                    "agent_task_log event=failed path={} reason=sweep error={error:#}",
+                    path.display()
+                ),
+            }
+        }
+        if fs::read_dir(&session_dir).is_ok_and(|mut entries| entries.next().is_none()) {
+            fs::remove_dir(&session_dir).ok();
+        }
+    }
+    Ok(report)
+}
+
