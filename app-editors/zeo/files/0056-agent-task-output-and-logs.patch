+// ---- R4.1 — what the task runs -------------------------------------------------------------
+
+// Hostile: t2's tool call is not in the thread; its row must fall back to its description, not
+// take toolu_t1's title.
+#[gpui::test]
+async fn test_expand_running_what_comes_from_its_own_tool_call_or_the_description(
+    cx: &mut TestAppContext,
