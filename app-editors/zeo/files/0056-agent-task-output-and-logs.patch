+#[gpui::test]
+async fn test_open_log_fetches_saves_0600_and_opens_read_only(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let scratch = Scratch::new("open");
