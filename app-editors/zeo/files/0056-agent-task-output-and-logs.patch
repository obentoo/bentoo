+            PLUS_NAME,
+            tasks_capability_v(version),
+            task_output_reply(fixture.clone()),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+        let output = fetch(&peer, &session_id, "b1", cx)
+            .await
+            .unwrap_or_else(|error| panic!("v{version}: {error:#}"));
+
+        assert_eq!(output.content, fixture["content"].as_str().unwrap());
+        assert_eq!(output.total_bytes, fixture["totalBytes"].as_u64().unwrap());
+        assert_eq!(output.truncated, fixture["truncated"].as_bool().unwrap());
+        assert_eq!(
