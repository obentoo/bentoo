+use super::{core_id, fnv1a64, translate};
+
+#[test]
+fn the_hash_is_fnv1a_64_so_the_extractor_can_compute_the_same_ids() {
+    // Reference vectors of FNV-1a 64 (Fowler/Noll/Vo test suite).
+    assert_eq!(fnv1a64(""), 0xcbf2_9ce4_8422_2325);
+    assert_eq!(fnv1a64("a"), 0xaf63_dc4c_8601_ec8c);
+    assert_eq!(fnv1a64("foobar"), 0x8594_4171_f739_67e8);
+    assert_eq!(core_id("a"), "zed-af63dc4c8601ec8c");
+}
+
+#[test]
+fn english_leaves_every_text_alone() {
+    // Tests never call init or set_language, so the catalog is plain English
+    // and the translator must not touch anything, known or not.
+    assert_eq!(translate("Open Recent"), None);
+    assert_eq!(translate(""), None);
+}
+
+#[test]
+fn a_run_time_text_fits_its_template() {
+    use super::{Template, fill_template};
+    let about = Template::parse("zed-1", "About %1").unwrap();
+    assert_eq!(about.fit("About Zed Dev"), Some(vec!["Zed Dev"]));
+    assert_eq!(about.fit("About "), None, "a placeholder needs a value");
+    assert_eq!(about.fit("Abort Zed"), None);
+
+    let discard = Template::parse("zed-2", "Discard %1 to %2 files?").unwrap();
+    assert_eq!(discard.fit("Discard changes to 3 files?"), Some(vec!["changes", "3"]));
+    assert_eq!(
+        fill_template("Descartar %1 em %2 arquivos?", &["alterações", "3"]),
+        "Descartar alterações em 3 arquivos?"
+    );
+    // A translation may reorder the placeholders.
+    assert_eq!(fill_template("%2 arquivos: %1", &["a", "b"]), "b arquivos: a");
+    assert_eq!(fill_template("100%3 ok", &["a"]), "100%3 ok");
+
+    assert_eq!(Template::parse("zed-3", "No placeholder"), None);
+}
