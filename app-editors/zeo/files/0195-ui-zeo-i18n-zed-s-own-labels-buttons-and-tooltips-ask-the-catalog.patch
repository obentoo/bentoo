+        // Best first: command 3 by its English name, then by its shown name, then command 0.
+        let folded = fold_matches_per_command(vec![found(7, 9.0), found(6, 5.0), found(0, 1.0)]);
+        let ids: Vec<usize> = folded.iter().map(|m| m.candidate_id).collect();
+        assert_eq!(ids, [3, 0]);
+        assert!(folded[0].positions.is_empty(), "an English hit highlights nothing");
+        assert_eq!(folded[1].positions, [0, 1]);
+    }
