+//! The one place Zed's own UI text passes through on its way to the screen
+//! (zed-patches 0195). Zed has no translation system: its strings are English
+//! literals in hundreds of crates. Rather than edit each call site, the
+//! constructors that take display text — [`crate::Label::new`],
+//! [`crate::Button::new`], the [`crate::Tooltip`] titles — hand it to
+//! [`translate`], which asks the translator Zeo installs at startup and keeps
+//! the English when it has nothing.
+//!
+//! The `ui` crate knows nothing about catalogs: zeo_i18n registers a plain
+//! function with [`set_translator`] from `main`, so a test, which never does,
+//! renders exactly the English it always did.
+
+use std::sync::OnceLock;
+
+use gpui::SharedString;
+
+/// Returns the translation of an English UI text, or `None` to keep it.
+pub type Translator = fn(&str) -> Option<SharedString>;
+
+static TRANSLATOR: OnceLock<Translator> = OnceLock::new();
+
+/// Install the translator. Only the first call wins: the process has one UI
+/// language system, and swapping it mid-run would leave half the windows in
+/// another.
+pub fn set_translator(translator: Translator) {
+    if TRANSLATOR.set(translator).is_err() {
+        log::warn!("ui: a text translator was already installed; keeping the first");
+    }
+}
+
+/// `text` in the UI language, or `text` itself.
+pub fn translate(text: SharedString) -> SharedString {
+    match TRANSLATOR.get() {
+        Some(translator) => translator(&text).unwrap_or(text),
+        None => text,
+    }
+}
