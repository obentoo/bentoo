+/// `name` ("editor: go to definition") with the part after the namespace looked up in
+/// Zeo's catalog; the namespace is a module name and stays as it is.
+fn display_action_name(name: &SharedString) -> SharedString {
+    match name.split_once(": ") {
+        Some((namespace, action)) => {
+            let shown = ui::zeo_text::translate(SharedString::from(action.to_string()));
+            if shown.as_ref() == action {
+                name.clone()
+            } else {
+                SharedString::from(format!("{namespace}: {shown}"))
+            }
+        }
+        None => ui::zeo_text::translate(name.clone()),
+    }
+}
+
+/// Matches over the doubled candidates back to one per command, best score first: an
+/// id 2*ix is the shown name (its positions highlight it), 2*ix+1 the English one
+/// (nothing on screen to highlight).
+fn fold_matches_per_command(
+    matches: Vec<fuzzy_nucleo::StringMatch>,
+) -> Vec<fuzzy_nucleo::StringMatch> {
+    let mut seen = std::collections::HashSet::new();
+    matches
+        .into_iter()
+        .filter_map(|mut found| {
+            let command = found.candidate_id / 2;
+            if !seen.insert(command) {
+                return None;
+            }
+            if found.candidate_id % 2 == 1 {
+                found.positions.clear();
+            }
+            found.candidate_id = command;
+            Some(found)
+        })
+        .collect()
+}
+
 pub fn humanize_action_name(name: &str) -> String {
     let chars = name.chars().collect::<Vec<_>>();
     let capacity = name.len() + chars.iter().filter(|c| c.is_uppercase()).count();
