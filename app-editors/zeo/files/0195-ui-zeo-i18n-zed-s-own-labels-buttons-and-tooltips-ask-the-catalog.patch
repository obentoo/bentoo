index 0000000..96efb2f
--- /dev/null
+++ b/crates/zeo_i18n/src/core_text.rs
@@ -0,0 +1,249 @@
+//! Zed's own strings (zed-patches 0195). They reach the screen as English
+//! literals through `ui`'s constructors, which hand them to [`translate`]; the
+//! catalog finds each one under an id derived from the English itself —
+//! `zed-` and the FNV-1a 64 hash of its UTF-8 bytes in hex — in the generated
+//! `locales/<language>/zed-core.ftl` files (scripts/i18n-extract.py in
+//! zed-patches writes en-US's on every bump).
+//!
+//! An id is derived, not chosen, so no call site changes; the price is that a
+//! text built at run time (`format!`) has no id and stays English.
+
+use std::collections::HashMap;
+use std::io::Write as _;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{LazyLock, Mutex, PoisonError, RwLock};
+
+use fluent_bundle::{FluentResource, concurrent::FluentBundle};
+use gpui::SharedString;
+
+use crate::catalog::{FALLBACK_LANGUAGE, LocaleSource, build_bundle};
+
+/// Distinct texts remembered per language before the memo starts over: labels
+/// also carry file names and buffer text, which never repeat a catalog entry.
+const MEMO_LIMIT: usize = 50_000;
+
+/// Set while the catalog answers in something other than plain English, so the
+/// English UI pays one atomic load per label and nothing else.
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+/// Text -> its translation (`None`: keep the English), for the current language.
+static MEMO: LazyLock<RwLock<HashMap<SharedString, Option<SharedString>>>> =
+    LazyLock::new(|| RwLock::new(HashMap::new()));
+
+/// The English catalog alone, to confirm that an id really is this text's and
+/// not another's with the same hash.
+static ENGLISH: LazyLock<Option<FluentBundle<FluentResource>>> = LazyLock::new(|| {
+    crate::SHIPPED
+        .iter()
+        .find(|source| source.language == FALLBACK_LANGUAGE)
+        .map(|source: &LocaleSource| build_bundle(source, FALLBACK_LANGUAGE, None))
+});
+
+/// Where `ZEO_I18N_COVERAGE` asks to write one line per distinct text seen:
+/// `hit` (the catalog knows it) or `miss`, a tab, then the text.
+static COVERAGE: LazyLock<Option<Mutex<std::fs::File>>> = LazyLock::new(|| {
+    let path = std::env::var_os("ZEO_I18N_COVERAGE")?;
+    match std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+        Ok(file) => Some(Mutex::new(file)),
+        Err(error) => {
+            log::warn!("zeo_i18n: coverage file not opened path={path:?} error={error}");
+            None
+        }
+    }
+});
+
+/// A run-time text's template (`About %1`, from `format!("About {}", …)`): the literal
+/// pieces around its placeholders, which are numbered in the order they appear.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Template {
+    pub id: String,
+    pub english: String,
+    pub pieces: Vec<String>,
+}
+
+impl Template {
+    /// `None` unless `english` holds at least one `%<n>` placeholder.
+    pub fn parse(id: &str, english: &str) -> Option<Self> {
+        let mut pieces = vec![String::new()];
+        let mut chars = english.chars().peekable();
+        let mut placeholders = 0;
+        while let Some(c) = chars.next() {
+            if c == '%' && chars.peek().is_some_and(char::is_ascii_digit) {
+                while chars.peek().is_some_and(char::is_ascii_digit) {
+                    chars.next();
+                }
+                placeholders += 1;
+                pieces.push(String::new());
+            } else if let Some(piece) = pieces.last_mut() {
+                piece.push(c);
+            }
+        }
+        (placeholders > 0).then(|| Self {
+            id: id.to_string(),
+            english: english.to_string(),
+            pieces,
+        })
+    }
+
+    fn literal_len(&self) -> usize {
+        self.pieces.iter().map(String::len).sum()
+    }
+
+    /// The values `text` puts in the placeholders, if it is this template filled in.
+    /// Leftmost match for each piece; every value must be non-empty.
+    pub fn fit<'a>(&self, text: &'a str) -> Option<Vec<&'a str>> {
+        let (first, rest) = self.pieces.split_first()?;
+        let (last, middle) = rest.split_last()?;
+        let body = text.strip_prefix(first.as_str())?.strip_suffix(last.as_str())?;
+        let mut values = Vec::with_capacity(rest.len());
+        let mut remaining = body;
+        for piece in middle {
+            let at = remaining.find(piece.as_str()).filter(|&at| at > 0)?;
+            values.push(&remaining[..at]);
+            remaining = &remaining[at + piece.len()..];
+        }
+        if remaining.is_empty() {
+            return None;
+        }
+        values.push(remaining);
+        Some(values)
+    }
+}
+
+/// `%1`, `%2`… in `translated` replaced by `values`; a number with no value stays as written.
+pub fn fill_template(translated: &str, values: &[&str]) -> String {
+    let mut out = String::with_capacity(translated.len());
+    let mut chars = translated.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '%' && chars.peek().is_some_and(char::is_ascii_digit) {
+            let mut number = String::new();
+            while let Some(digit) = chars.next_if(char::is_ascii_digit) {
+                number.push(digit);
+            }
+            match number.parse::<usize>().ok().and_then(|n| values.get(n.wrapping_sub(1))) {
+                Some(value) => out.push_str(value),
+                None => {
+                    out.push('%');
+                    out.push_str(&number);
+                }
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+/// en-US's templates, most literal text first so the most specific one wins.
+static TEMPLATES: LazyLock<Vec<Template>> = LazyLock::new(|| {
+    let mut templates: Vec<Template> = crate::SHIPPED
+        .iter()
+        .filter(|source| source.language == FALLBACK_LANGUAGE)
+        .flat_map(|source| source.files.iter())
+        .filter(|(path, _)| path.ends_with("zed-core.ftl"))
+        .flat_map(|(_, text)| text.lines())
+        .filter_map(|line| {
+            let (id, english) = line.split_once(" = ")?;
+            if !id.starts_with("zed-") {
+                return None;
+            }
+            Template::parse(id, english)
+        })
+        .collect();
+    templates.sort_by_key(|template| std::cmp::Reverse(template.literal_len()));
+    templates
+});
+
+fn translate_by_template(text: &str) -> Option<Option<String>> {
+    TEMPLATES.iter().find_map(|template| {
+        let values = template.fit(text)?;
+        let translated = crate::format_current(&template.id)
+            .filter(|translated| *translated != template.english)
+            .map(|translated| fill_template(&translated, &values));
+        Some(translated)
+    })
+}
+
+/// FNV-1a, 64 bits: tiny, stable across builds and platforms, and easy to
+/// write the same way in the Python extractor.
+pub fn fnv1a64(text: &str) -> u64 {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for byte in text.as_bytes() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash
+}
+
+/// The catalog id of an English UI text.
+pub fn core_id(text: &str) -> String {
+    format!("zed-{:016x}", fnv1a64(text))
+}
+
+/// Called by zeo_i18n whenever the language changes.
+pub(crate) fn language_changed(language: &str) {
+    ACTIVE.store(language != FALLBACK_LANGUAGE, Ordering::Release);
+    MEMO.write().unwrap_or_else(PoisonError::into_inner).clear();
+}
+
+/// The translator `ui` calls for every label, button and tooltip text.
+pub fn translate(text: &str) -> Option<SharedString> {
+    if !ACTIVE.load(Ordering::Acquire) || text.is_empty() {
+        return None;
+    }
+    if let Some(known) = MEMO
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(text)
+    {
+        return known.clone();
+    }
+
+    let id = core_id(text);
+    let is_ours = ENGLISH
+        .as_ref()
+        .and_then(|english| english.get_message(&id))
+        .and_then(|message| message.value())
+        .zip(ENGLISH.as_ref())
+        .is_some_and(|(pattern, english)| {
+            let mut errors = Vec::new();
+            english.format_pattern(pattern, None, &mut errors) == text
+        });
+    // Not a literal of Zed's: maybe a run-time text built from one of its templates.
+    let (known, translated) = if is_ours {
+        let exact = crate::format_current(&id).filter(|translated| translated != text);
+        (true, exact)
+    } else {
+        match translate_by_template(text) {
+            Some(filled) => (true, filled),
+            None => (false, None),
+        }
+    };
+    let translated = translated
+        .filter(|translated| translated != text)
+        .map(SharedString::from);
+    record_coverage(known, text);
+
+    let mut memo = MEMO.write().unwrap_or_else(PoisonError::into_inner);
+    if memo.len() >= MEMO_LIMIT {
+        memo.clear();
+    }
+    memo.insert(SharedString::from(text.to_string()), translated.clone());
+    translated
+}
+
+fn record_coverage(is_ours: bool, text: &str) {
+    let Some(file) = COVERAGE.as_ref() else {
+        return;
+    };
+    let kind = if is_ours { "hit" } else { "miss" };
+    let line = format!("{kind}\t{}\n", text.replace(['\n', '\t'], " "));
+    let mut file = file.lock().unwrap_or_else(PoisonError::into_inner);
+    if let Err(error) = file.write_all(line.as_bytes()) {
+        log::debug!("zeo_i18n: coverage line not written error={error}");
+    }
+}
+
