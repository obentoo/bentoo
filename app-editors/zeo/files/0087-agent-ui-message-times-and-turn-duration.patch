+/// `_meta.claudeCode.timestamp`, the ISO 8601 time Claude Agent (Plus) stamps on each message
+/// chunk, live and on replay. Anything unparsable reads as absent.
+fn agent_message_time(
+    meta: &serde_json::Map<String, serde_json::Value>,
+) -> Option<chrono::DateTime<chrono::Utc>> {
+    let timestamp = meta.get("claudeCode")?.get("timestamp")?.as_str()?;
+    chrono::DateTime::parse_from_rfc3339(timestamp)
+        .ok()
+        .map(|time| time.with_timezone(&chrono::Utc))
+}
+
+/// When a user or agent message was sent (Zeo next proposal §6.4): its first and its latest
+/// chunk. `None` for an entry that is not a message, or whose time is unknown.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MessageTime {
+    pub first: chrono::DateTime<chrono::Utc>,
+    pub last: chrono::DateTime<chrono::Utc>,
+}
