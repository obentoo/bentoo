+    /// When the message at `entry_index` was sent (§6.4).
+    pub fn message_time(&self, entry_index: usize) -> Option<MessageTime> {
+        self.message_times.get(entry_index).copied().flatten()
+    }
+
+    /// How long the turn that starts with the user message at `entry_index` took: from that
+    /// message to the last agent message before the next user message (§6.4).
+    pub fn turn_duration(&self, entry_index: usize) -> Option<std::time::Duration> {
+        if !matches!(
+            self.entries.get(entry_index),
+            Some(AgentThreadEntry::UserMessage(_))
+        ) {
+            return None;
+        }
+        let sent = self.message_time(entry_index)?.first;
+        let next_turn = self
+            .entries
+            .iter()
+            .enumerate()
+            .skip(entry_index + 1)
+            .find(|(_, entry)| matches!(entry, AgentThreadEntry::UserMessage(_)))
+            .map(|(ix, _)| ix);
+        // The last turn is still being written while one runs: no duration until it ends.
+        if next_turn.is_none() && self.running_turn.is_some() {
+            return None;
+        }
+        let end = next_turn.unwrap_or(self.entries.len());
+        let replied = (entry_index + 1..end)
+            .rev()
+            .filter(|ix| matches!(self.entries[*ix], AgentThreadEntry::AssistantMessage(_)))
+            .find_map(|ix| self.message_time(ix))?
+            .last;
+        (replied - sent).to_std().ok()
+    }
+
+    /// Records a message chunk's time on the entry it went into: the agent's
+    /// `_meta.claudeCode.timestamp`, else the receive time while a turn runs. A replayed chunk
+    /// with no time of its own records nothing -- received now says nothing about when it was
+    /// sent.
+    fn note_message_time(
+        &mut self,
+        entry_index: usize,
+        meta: Option<&serde_json::Map<String, serde_json::Value>>,
+    ) {
+        if !matches!(
+            self.entries.get(entry_index),
+            Some(AgentThreadEntry::UserMessage(_) | AgentThreadEntry::AssistantMessage(_))
+        ) {
+            return;
+        }
+        let Some(time) = meta
+            .and_then(agent_message_time)
+            .or_else(|| self.running_turn.is_some().then(chrono::Utc::now))
+        else {
+            return;
+        };
+        if let Some(slot) = self.message_times.get_mut(entry_index) {
+            *slot = Some(match *slot {
+                Some(known) => MessageTime {
+                    first: known.first.min(time),
+                    last: known.last.max(time),
+                },
+                None => MessageTime {
+                    first: time,
+                    last: time,
+                },
+            });
+        }
+    }
+
+    /// note_message_time for the entry a v1 chunk just went into: always the last one, since a
+    /// v1 chunk merges into the last entry or pushes a new one.
+    fn note_last_message_time(
+        &mut self,
+        meta: Option<&serde_json::Map<String, serde_json::Value>>,
+    ) {
+        if let Some(entry_index) = self.entries.len().checked_sub(1) {
+            self.note_message_time(entry_index, meta);
+        }
+    }
