diff --git a/crates/acp_thread/src/acp_thread_message_times_tests.rs b/crates/acp_thread/src/acp_thread_message_times_tests.rs
new file mode 100644
index 0000000..2e2f466
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_message_times_tests.rs
@@ -0,0 +1,190 @@
+// Zeo next proposal §6.4 (ask 24): message times and turn duration.
+//
+// Each user and agent message records when it was sent: the agent's `_meta.claudeCode.timestamp`
+// (Claude Agent (Plus) >= 0.37.0 stamps every chunk, live and on replay), else the time Zeo
+// received it -- but only while a turn is running, because a replayed chunk received now says
+// nothing about when it was sent. A turn's duration runs from its user message to the last
+// agent message before the next user message.
+//
+// Included at the end of `mod tests` in `acp_thread.rs`.
+
+const T_SENT: &str = "2026-11-10T09:15:00Z";
+const T_REPLY: &str = "2026-11-10T09:15:20Z";
+const T_LAST: &str = "2026-11-10T09:16:30Z";
+
+fn message_times_meta(timestamp: &str) -> serde_json::Map<String, serde_json::Value> {
+    serde_json::Map::from_iter([(
+        "claudeCode".to_string(),
+        serde_json::json!({ "timestamp": timestamp }),
+    )])
+}
+
+fn message_times_at(timestamp: &str) -> chrono::DateTime<chrono::Utc> {
+    chrono::DateTime::parse_from_rfc3339(timestamp)
+        .expect("fixture timestamp")
+        .with_timezone(&chrono::Utc)
+}
+
+async fn message_times_thread(cx: &mut TestAppContext) -> Entity<AcpThread> {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let connection: Rc<dyn AgentConnection> = Rc::new(FakeAgentConnection::new());
+    cx.update(|cx| connection.new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx))
+        .await
+        .unwrap()
+}
+
+fn message_times_replay(
+    thread: &Entity<AcpThread>,
+    update: acp_v1::SessionUpdate,
+    cx: &mut TestAppContext,
+) {
+    thread.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(update, cx)
+            .expect("update applies")
+    });
+}
+
+#[gpui::test]
+async fn message_times_come_from_the_agents_meta_on_replay(cx: &mut TestAppContext) {
+    let thread = message_times_thread(cx).await;
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::UserMessageChunk(
+            acp_v1::ContentChunk::new("Fix the build".into()).meta(message_times_meta(T_SENT)),
+        ),
+        cx,
+    );
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(
+            acp_v1::ContentChunk::new("Looking.".into()).meta(message_times_meta(T_REPLY)),
+        ),
+        cx,
+    );
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(
+            acp_v1::ContentChunk::new(" Fixed.".into()).meta(message_times_meta(T_LAST)),
+        ),
+        cx,
+    );
+
+    thread.read_with(cx, |thread, _| {
+        let user = thread.message_time(0).expect("the user message has a time");
+        assert_eq!(
+            (user.first, user.last),
+            (message_times_at(T_SENT), message_times_at(T_SENT))
+        );
+        let reply = thread.message_time(1).expect("the reply has a time");
+        assert_eq!(reply.first, message_times_at(T_REPLY), "first chunk");
+        assert_eq!(reply.last, message_times_at(T_LAST), "last chunk");
+        assert_eq!(
+            thread.turn_duration(0),
+            Some(std::time::Duration::from_secs(90)),
+            "from the user message to the turn's last agent message"
+        );
+    });
+}
+
+#[gpui::test]
+async fn message_times_are_absent_for_a_replayed_chunk_without_one(cx: &mut TestAppContext) {
+    let thread = message_times_thread(cx).await;
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new("Fix it".into())),
+        cx,
+    );
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new("Done.".into())),
+        cx,
+    );
+
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(
+            thread.message_time(0),
+            None,
+            "received now is not when it was sent"
+        );
+        assert_eq!(thread.message_time(1), None);
+        assert_eq!(thread.turn_duration(0), None);
+    });
+}
+
+#[gpui::test]
+async fn message_times_stamp_a_live_turn_with_the_receive_time(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new("Done.".into()),
+    )]);
+    let session_connection: Rc<dyn AgentConnection> = connection.clone();
+    let thread = cx
+        .update(|cx| {
+            session_connection.new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx)
+        })
+        .await
+        .unwrap();
+    let before = chrono::Utc::now();
+
+    thread
+        .update(cx, |thread, cx| thread.send_raw("Fix it", cx))
+        .await
+        .expect("turn completes");
+
+    let after = chrono::Utc::now();
+    thread.read_with(cx, |thread, _| {
+        for ix in [0, 1] {
+            let time = thread
+                .message_time(ix)
+                .unwrap_or_else(|| panic!("entry {ix} stamped live"));
+            assert!(
+                before <= time.first && time.last <= after,
+                "entry {ix}: {time:?}"
+            );
+        }
+        assert!(thread.turn_duration(0).is_some());
+    });
+}
+
+#[gpui::test]
+async fn message_times_follow_a_rewind(cx: &mut TestAppContext) {
+    let thread = message_times_thread(cx).await;
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::UserMessageChunk(
+            acp_v1::ContentChunk::new("one".into()).meta(message_times_meta(T_SENT)),
+        ),
+        cx,
+    );
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(
+            acp_v1::ContentChunk::new("reply".into()).meta(message_times_meta(T_REPLY)),
+        ),
+        cx,
+    );
+
+    thread.update(cx, |thread, cx| thread.truncate_entries(1, cx));
+    message_times_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(
+            acp_v1::ContentChunk::new("again".into()).meta(message_times_meta(T_LAST)),
+        ),
+        cx,
+    );
+
+    thread.read_with(cx, |thread, _| {
+        let reply = thread.message_time(1).expect("the new reply has a time");
+        assert_eq!(
+            (reply.first, reply.last),
+            (message_times_at(T_LAST), message_times_at(T_LAST)),
+            "the truncated reply's times are gone"
+        );
+    });
+}
