+// Zeo next proposal §6.4 (ask 24): each user message shows when it was sent, and each completed
+// turn's last agent message shows when it ended and how long the turn took, with the full date
+// in a tooltip. Times come from acp_thread's message_time (the agent's timestamp, else the
+// receive time live); a message without one shows nothing.
+
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::TestAppContext;
+
+use super::elicitation_decline_harness::*;
+
+fn message_time_meta(timestamp: &str) -> serde_json::Map<String, serde_json::Value> {
+    serde_json::Map::from_iter([(
+        "claudeCode".to_string(),
+        serde_json::json!({ "timestamp": timestamp }),
+    )])
+}
+
+fn message_time_replay(
+    thread: &gpui::Entity<acp_thread::AcpThread>,
+    update: acp_v1::SessionUpdate,
+    cx: &mut gpui::VisualTestContext,
+) {
+    thread.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(update, cx)
+            .expect("update applies")
+    });
+}
+
+#[gpui::test]
+async fn a_turn_shows_its_times_and_duration(cx: &mut TestAppContext) {
+    let (_view, thread, mut cx) = setup(cx).await;
+    message_time_replay(
+        &thread,
+        acp_v1::SessionUpdate::UserMessageChunk(
+            acp_v1::ContentChunk::new("Fix the build".into())
+                .meta(message_time_meta("2026-11-10T09:15:00Z")),
+        ),
+        &mut cx,
+    );
+    message_time_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(
+            acp_v1::ContentChunk::new("Fixed.".into())
+                .meta(message_time_meta("2026-11-10T09:16:30Z")),
+        ),
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    assert!(
+        cx.debug_bounds("message-time-0").is_some(),
+        "the user message shows its time"
+    );
+    assert!(
+        cx.debug_bounds("message-time-1").is_some(),
+        "the turn's last reply shows its time"
+    );
+    assert!(
+        cx.debug_bounds("message-time-1-duration").is_some(),
+        "and the turn's duration"
+    );
+}
+
+#[gpui::test]
+async fn a_message_without_a_time_shows_none(cx: &mut TestAppContext) {
+    let (_view, thread, mut cx) = setup(cx).await;
+    message_time_replay(
+        &thread,
+        acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new("Fix it".into())),
+        &mut cx,
+    );
+    message_time_replay(
+        &thread,
+        acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new("Done.".into())),
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    assert!(cx.debug_bounds("message-time-0").is_none());
+    assert!(cx.debug_bounds("message-time-1").is_none());
+}
