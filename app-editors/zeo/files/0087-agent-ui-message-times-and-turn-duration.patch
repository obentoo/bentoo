 impl ThreadView {
+    /// The time line under a message (Zeo next proposal §6.4): a user message's send time, and
+    /// under a completed turn's last agent message, when it ended and how long the turn took.
+    fn render_message_time(&self, entry_ix: usize, cx: &Context<Self>) -> Option<AnyElement> {
+        let thread = self.thread.read(cx);
+        let entries = thread.entries();
+        let entry = entries.get(entry_ix)?;
+        if entry.is_indented() {
+            return None;
+        }
+        let (time, duration, is_user) = match entry {
+            AgentThreadEntry::UserMessage(_) => (thread.message_time(entry_ix)?.first, None, true),
+            AgentThreadEntry::AssistantMessage(_) => {
+                let next_turn = entries
+                    .iter()
+                    .enumerate()
+                    .skip(entry_ix + 1)
+                    .find(|(_, entry)| matches!(entry, AgentThreadEntry::UserMessage(_)))
+                    .map_or(entries.len(), |(ix, _)| ix);
+                // Only the turn's last agent message, and only once the turn has ended.
+                let later_reply = entries[entry_ix + 1..next_turn]
+                    .iter()
+                    .any(|entry| matches!(entry, AgentThreadEntry::AssistantMessage(_)));
+                let still_running =
+                    next_turn == entries.len() && thread.status() != ThreadStatus::Idle;
+                if later_reply || still_running {
+                    return None;
+                }
+                let turn_start = entries[..entry_ix]
+                    .iter()
+                    .rposition(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)));
+                (
+                    thread.message_time(entry_ix)?.last,
+                    turn_start.and_then(|ix| thread.turn_duration(ix)),
+                    false,
+                )
+            }
+            _ => return None,
+        };
+
+        let local = time.with_timezone(&chrono::Local);
+        let full_date: SharedString = local.format("%A, %-d %B %Y, %H:%M:%S").to_string().into();
+        Some(
+            h_flex()
+                .id(("message-time", entry_ix))
+                .debug_selector(move || format!("message-time-{entry_ix}"))
+                .w_full()
+                .px_5()
+                .gap_1()
+                .when(is_user, |this| this.justify_end())
+                .child(
+                    Label::new(local.format("%H:%M").to_string())
+                        .size(LabelSize::XSmall)
+                        .color(Color::Muted),
+                )
+                .when_some(duration, |this, duration| {
+                    this.child(
+                        div()
+                            .debug_selector(move || format!("message-time-{entry_ix}-duration"))
+                            .child(
+                                Label::new(format!("· {}", duration_alt_display(duration)))
+                                    .size(LabelSize::XSmall)
+                                    .color(Color::Muted),
+                            ),
+                    )
+                })
+                .tooltip(Tooltip::text(full_date))
+                .into_any_element(),
+        )
+    }
+
