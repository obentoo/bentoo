+#[cfg(test)]
+mod zeo_agent_tests {
+    use super::*;
+
+    fn npx(id: &str, package: &str) -> RegistryAgent {
+        RegistryAgent::Npx(RegistryNpxAgent {
+            metadata: RegistryAgentMetadata {
+                id: AgentId(id.to_string().into()),
+                name: id.to_string().into(),
+                description: "".into(),
+                version: "1.0.0".into(),
+                repository: None,
+                website: None,
+                license_url: None,
+                icon_path: None,
+            },
+            package: package.to_string().into(),
+            args: Vec::new(),
+            env: HashMap::default(),
+        })
+    }
+
+    /// With no registry at all -- first start, offline -- both adapters exist.
+    #[test]
+    fn zeo_agents_exist_without_a_registry() {
+        let agents = with_zeo_agents(Vec::new());
+        let ids: Vec<&str> = agents.iter().map(|agent| agent.id().0.as_ref()).collect();
+        assert_eq!(ids, vec![ZEO_PLUS_AGENT_ID, ZEO_TUI_AGENT_ID]);
+        for agent in &agents {
+            let RegistryAgent::Npx(agent) = agent else {
+                panic!("{} should be an npx agent", agent.id().0);
+            };
+            assert!(agent.package.ends_with("@latest"), "{}", agent.package);
+            assert!(agent.package.starts_with("@lucascouts/"), "{}", agent.package);
+        }
+    }
+
+    /// The public registry's entries are kept, and one that already uses a Zeo
+    /// id wins over Zeo's built-in instead of being duplicated.
+    #[test]
+    fn registry_entries_are_kept_and_win_on_the_same_id() {
+        let agents = with_zeo_agents(vec![
+            npx("claude-acp", "@agentclientprotocol/claude-agent-acp@1.0.0"),
+            npx(ZEO_PLUS_AGENT_ID, "registry-provided@1.0.0"),
+        ]);
+        let ids: Vec<&str> = agents.iter().map(|agent| agent.id().0.as_ref()).collect();
+        assert_eq!(ids, vec!["claude-acp", ZEO_PLUS_AGENT_ID, ZEO_TUI_AGENT_ID]);
+        let RegistryAgent::Npx(plus) = &agents[1] else {
+            panic!("plus should be an npx agent");
+        };
+        assert_eq!(plus.package.as_ref(), "registry-provided@1.0.0");
+    }
+}
