+/// The two Claude adapters Zeo ships with, as npx registry agents.
+///
+/// They are not in the public ACP registry, so Zeo adds them to whatever the
+/// registry returned -- and to an empty list, so they exist before the first
+/// fetch and with no network at all. `@latest` makes every launch run
+/// `npm install <package>@latest`, which is how they track the newest
+/// published adapter without a Zeo rebuild (`bounded_npm_package_spec` leaves a
+/// non-semver tag alone). assets/settings/default.json enables both.
+pub const ZEO_PLUS_AGENT_ID: &str = "claude-agent-acp-plus";
+pub const ZEO_TUI_AGENT_ID: &str = "claude-agent-tui";
+
+fn zeo_agents() -> Vec<RegistryAgent> {
+    let agent = |id: &str, name: &str, description: &str, package: &str, repository: &str| {
+        RegistryAgent::Npx(RegistryNpxAgent {
+            metadata: RegistryAgentMetadata {
+                id: AgentId(id.to_string().into()),
+                name: name.to_string().into(),
+                description: description.to_string().into(),
+                version: "latest".into(),
+                repository: Some(repository.to_string().into()),
+                website: None,
+                license_url: None,
+                icon_path: None,
+            },
+            package: format!("{package}@latest").into(),
+            args: Vec::new(),
+            env: HashMap::default(),
+        })
+    };
+    vec![
+        agent(
+            ZEO_PLUS_AGENT_ID,
+            "Claude Agent (Plus)",
+            "Claude Code over ACP, with Zeo's agent-panel integration",
+            "@lucascouts/claude-agent-acp-plus",
+            "https://github.com/zeo-workspace/claude-agent-acp-plus",
+        ),
+        agent(
+            ZEO_TUI_AGENT_ID,
+            "Claude Agent TUI",
+            "The Claude Code terminal UI in the agent panel (needs the claude CLI installed)",
+            "@lucascouts/claude-agent-tui",
+            "https://github.com/zeo-workspace/claude-agent-tui",
+        ),
+    ]
+}
+
+/// Whether `agent` carries one of the ids `zeo_agents()` ships.
+fn is_zeo_agent(agent: &RegistryAgent) -> bool {
+    let id = agent.id().0.as_ref();
+    id == ZEO_PLUS_AGENT_ID || id == ZEO_TUI_AGENT_ID
+}
+
+/// `agents` plus Zeo's own, unless the registry already lists an agent with the
+/// same id -- the registry's entry then wins.
+fn with_zeo_agents(mut agents: Vec<RegistryAgent>) -> Vec<RegistryAgent> {
+    for zeo_agent in zeo_agents() {
+        if !agents.iter().any(|agent| agent.id() == zeo_agent.id()) {
+            agents.push(zeo_agent);
+        }
+    }
+    agents
+}
+
 struct RegistryFetchResult {
     index: RegistryIndex,
     raw_body: Vec<u8>,
@@ -683,3 +749,57 @@ struct RegistryNpxDistribution {
