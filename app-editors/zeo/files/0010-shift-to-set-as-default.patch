+                                        .icon_size(IconSize::Small)
+                                        .tooltip(Tooltip::text(tooltip))
+                                        .on_click(move |event, window, cx| {
+                                            (handle_click)(event, window, cx)
+                                        }),
+                                )
+                            }
+                        }),
+                )
             })
     }
 }
