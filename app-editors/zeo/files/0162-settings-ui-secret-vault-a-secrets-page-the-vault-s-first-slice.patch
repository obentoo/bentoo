+// Hub docs/SECRETS-VAULT-PAGE.md: what the Secrets page saves and shows. Filter: `secrets_page`.
+
+use secret_vault::{SecretRef, VaultEntry};
+
+use super::{reference_to_save, row_text};
+
+#[test]
+fn secrets_page_saves_under_the_trimmed_reference_or_says_why_not() {
+    assert_eq!(
+        reference_to_save(" github ", "token").unwrap(),
+        SecretRef::new("github", "token").unwrap()
+    );
+    assert!(reference_to_save("", "token").is_err());
+    assert!(reference_to_save("a/b", "token").is_err());
+}
+
+#[test]
+fn secrets_page_rows_show_the_reference_and_only_the_tail() {
+    let entry = VaultEntry {
+        reference: SecretRef::new("figma", "api-key").unwrap(),
+        tail: "x9z".into(),
+    };
+    assert_eq!(
+        row_text(&entry),
+        ("secret://figma/api-key".to_string(), "•••x9z".to_string())
+    );
+    let locked = VaultEntry {
+        tail: String::new(),
+        ..entry
+    };
+    assert_eq!(row_text(&locked).1, "locked");
+}
