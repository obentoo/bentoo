diff --git a/crates/settings_ui/src/pages/secrets_page.rs b/crates/settings_ui/src/pages/secrets_page.rs
new file mode 100644
index 0000000..4268559
--- /dev/null
+++ b/crates/settings_ui/src/pages/secrets_page.rs
@@ -0,0 +1,258 @@
+//! The "Secrets" sub-page (hub `docs/SECRETS-VAULT-PAGE.md`, the operator's ask (i) of
+//! 2026-11-22): the vault's secrets, stored in the Secret Service under the attributes azukari
+//! resolves. A row shows the reference and the last three characters of the value, never more;
+//! the value is readable only while it is typed, and the field clears on Save.
+
+use editor::Editor;
+use gpui::{ClipboardItem, Entity, ScrollHandle, Task};
+use secret_vault::{SecretRef, VaultEntry, azukari_command};
+use ui::{Banner, Severity, prelude::*};
+
+use crate::SettingsWindow;
+use crate::components::SettingsSectionHeader;
+
+pub(crate) const INTRO: &str = "Secrets are kept in the system keyring, never in settings. Zeo shows only their last three characters. An MCP server reads one through azukari: put the reference in the server's env and start it with the command below.";
+const EMPTY: &str = "No secrets yet.";
+
+/// What the page holds: the listing, the three fields, and the last outcome. The fields are the
+/// page's own editors, read when Save is clicked: a field that confirmed only on focus-out lost
+/// what was typed in it when the click went straight to another field (the Xvfb proof,
+/// 2026-11-23).
+pub(crate) struct SecretsPage {
+    entries: Vec<VaultEntry>,
+    service: Entity<Editor>,
+    account: Entity<Editor>,
+    value: Entity<Editor>,
+    status: Option<(Severity, String)>,
+    loading: bool,
+    _task: Option<Task<()>>,
+}
+
+/// What Save does with the typed fields: a reference to store under, or why not.
+pub(crate) fn reference_to_save(service: &str, account: &str) -> Result<SecretRef, String> {
+    SecretRef::new(service.trim(), account.trim()).map_err(|error| error.to_string())
+}
+
+/// A row's text: the reference and the value's tail behind dots.
+pub(crate) fn row_text(entry: &VaultEntry) -> (String, String) {
+    let tail = if entry.tail.is_empty() {
+        "locked".to_string()
+    } else {
+        format!("•••{}", entry.tail)
+    };
+    (entry.reference.uri(), tail)
+}
+
+impl SecretsPage {
+    fn new(window: &mut Window, cx: &mut Context<Self>) -> Self {
+        let field = |placeholder: &'static str, window: &mut Window, cx: &mut Context<Self>| {
+            cx.new(|cx| {
+                let mut editor = Editor::single_line(window, cx);
+                editor.set_placeholder_text(placeholder, window, cx);
+                editor
+            })
+        };
+        let mut page = Self {
+            entries: Vec::new(),
+            service: field("service (e.g. github)", window, cx),
+            account: field("account (e.g. token)", window, cx),
+            value: field("value (visible while typed)", window, cx),
+            status: None,
+            loading: true,
+            _task: None,
+        };
+        page.refresh(cx);
+        page
+    }
+
+    fn refresh(&mut self, cx: &mut Context<Self>) {
+        self.loading = true;
+        let list = cx.background_spawn(secret_vault::list());
+        self._task = Some(cx.spawn(async move |this, cx| {
+            let result = list.await;
+            this.update(cx, |page, cx| {
+                page.loading = false;
+                match result {
+                    Ok(entries) => page.entries = entries,
+                    Err(error) => {
+                        log::warn!("settings_ui event=secrets_list_failed error={error:#}");
+                        page.status = Some((Severity::Error, format!("{error:#}")));
+                    }
+                }
+                cx.notify();
+            })
+            .ok();
+        }));
+        cx.notify();
+    }
+
+    fn save(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let value = self.value.read(cx).text(cx);
+        // The value leaves the field at once, saved or not: it is visible only while typed.
+        self.value.update(cx, |editor, cx| editor.clear(window, cx));
+        let service = self.service.read(cx).text(cx);
+        let account = self.account.read(cx).text(cx);
+        let reference = match reference_to_save(&service, &account) {
+            Ok(reference) => reference,
+            Err(why) => {
+                self.status = Some((Severity::Warning, why));
+                cx.notify();
+                return;
+            }
+        };
+        if value.is_empty() {
+            self.status = Some((Severity::Warning, "Type the value first.".into()));
+            cx.notify();
+            return;
+        }
+        let store = cx.background_spawn({
+            let reference = reference.clone();
+            async move { secret_vault::store(&reference, &value).await }
+        });
+        self._task =
+            Some(cx.spawn(async move |this, cx| {
+                let result = store.await;
+                this.update(cx, |page, cx| {
+                match result {
+                    Ok(()) => {
+                        log::info!("settings_ui event=secret_stored reference={}", reference.uri());
+                        page.status =
+                            Some((Severity::Success, format!("Saved {}.", reference.uri())));
+                    }
+                    Err(error) => {
+                        log::warn!(
+                            "settings_ui event=secret_store_failed reference={} error={error:#}",
+                            reference.uri()
+                        );
+                        page.status = Some((Severity::Error, format!("{error:#}")));
+                    }
+                }
+                page.refresh(cx);
+            })
+            .ok();
+            }));
+    }
+
+    fn delete(&mut self, reference: SecretRef, cx: &mut Context<Self>) {
+        let delete = cx.background_spawn({
+            let reference = reference.clone();
+            async move { secret_vault::delete(&reference).await }
+        });
+        self._task = Some(cx.spawn(async move |this, cx| {
+            let result = delete.await;
+            this.update(cx, |page, cx| {
+                page.status = Some(match result {
+                    Ok(()) => {
+                        log::info!(
+                            "settings_ui event=secret_deleted reference={}",
+                            reference.uri()
+                        );
+                        (Severity::Success, format!("Deleted {}.", reference.uri()))
+                    }
+                    Err(error) => (Severity::Error, format!("{error:#}")),
+                });
+                page.refresh(cx);
+            })
+            .ok();
+        }));
+    }
+}
+
+impl Render for SecretsPage {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let this = cx.entity();
+        let boxed = |editor: &Entity<Editor>| {
+            div()
+                .px_2()
+                .py_1()
+                .border_1()
+                .border_color(cx.theme().colors().border)
+                .rounded_sm()
+                .child(editor.clone())
+        };
+        let save = Button::new("secrets-save", "Save").on_click({
+            let this = this.clone();
+            move |_, window, cx| {
+                this.update(cx, |page, cx| page.save(window, cx));
+            }
+        });
+
+        let mut list = v_flex().gap_1();
+        if self.loading {
+            list = list.child(Label::new("Loading…").color(Color::Muted));
+        } else if self.entries.is_empty() {
+            list = list.child(Label::new(EMPTY).color(Color::Muted));
+        }
+        for (ix, entry) in self.entries.iter().enumerate() {
+            let (uri, tail) = row_text(entry);
+            let reference = entry.reference.clone();
+            list = list.child(
+                h_flex()
+                    .gap_2()
+                    .child(Label::new(uri.clone()).buffer_font(cx))
+                    .child(Label::new(tail).color(Color::Muted).buffer_font(cx))
+                    .child(div().flex_1())
+                    .child(Button::new(("secret-copy", ix), "Copy Reference").on_click(
+                        move |_, _, cx| {
+                            cx.write_to_clipboard(ClipboardItem::new_string(uri.clone()));
+                        },
+                    ))
+                    .child(Button::new(("secret-delete", ix), "Delete").on_click({
+                        let this = this.clone();
+                        move |_, _, cx| {
+                            let reference = reference.clone();
+                            this.update(cx, |page, cx| page.delete(reference, cx));
+                        }
+                    })),
+            );
+        }
+
+        let mut page = v_flex()
+            .gap_3()
+            .child(SettingsSectionHeader::new("Secrets"))
+            .child(Label::new(INTRO).color(Color::Muted).size(LabelSize::Small))
+            .child(
+                Label::new(azukari_command("NAME", "<server command>"))
+                    .buffer_font(cx)
+                    .size(LabelSize::Small),
+            );
+        if let Some((severity, message)) = &self.status {
+            page = page.child(Banner::new().severity(*severity).child(message.clone()));
+        }
+        page.child(list).child(
+            v_flex()
+                .gap_1()
+                .child(Label::new("Add or replace").size(LabelSize::Small))
+                .child(boxed(&self.service))
+                .child(boxed(&self.account))
+                .child(boxed(&self.value))
+                .child(h_flex().child(save)),
+        )
+    }
+}
+
+pub(crate) fn render_secrets_page(
+    _settings_window: &SettingsWindow,
+    scroll_handle: &ScrollHandle,
+    window: &mut Window,
+    cx: &mut Context<SettingsWindow>,
+) -> AnyElement {
+    let page: Entity<SecretsPage> = window.use_keyed_state("secrets-page", cx, |window, cx| {
+        SecretsPage::new(window, cx)
+    });
+    v_flex()
+        .id("secrets-page")
+        .debug_selector(|| "secrets-page".into())
+        .size_full()
+        .pt_2p5()
+        .px_8()
+        .pb_16()
+        .overflow_y_scroll()
+        .track_scroll(scroll_handle)
+        .child(page)
+        .into_any_element()
+}
