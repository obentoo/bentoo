--- /dev/null
+++ b/crates/secret_vault/src/secret_vault.rs
@@ -0,0 +1,186 @@
+//! Zeo's secret vault, first slice (hub `docs/SECRETS-VAULT-PAGE.md`, proposal §6.53).
+//!
+//! A secret is a value in the Secret Service (KWallet, GNOME Keyring, oo7-daemon) stored under the
+//! attributes azukari resolves -- `service` and `account` -- so a `secret://SERVICE/ACCOUNT`
+//! reference in an MCP server's `env` reaches it through `azukari --env NAME -- <server>` with no
+//! other step. `zeo-vault=1` marks the items Zeo made, which are the only ones its page lists or
+//! deletes. Saving over the same service and account replaces the item: azukari refuses a
+//! reference two items answer, so the vault never makes a second one.
+//!
+//! The value is never kept: a save hands it to the keyring and drops it, and a listing keeps only
+//! its last three characters ([`tail`]), the page's way of telling two values apart.
+
+use anyhow::{Result, bail};
+
+/// The URI scheme azukari resolves.
+pub const SCHEME: &str = "secret://";
+/// Marks an item Zeo created.
+pub const VAULT_ATTRIBUTE: &str = "zeo-vault";
+/// The label the keyring shows for an item, before `SERVICE/ACCOUNT`.
+pub const LABEL_PREFIX: &str = "Zeo vault: ";
+/// Characters of the value a listing keeps.
+pub const TAIL_LEN: usize = 3;
+
+/// Where a secret lives: azukari's `service` and `account` attributes.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct SecretRef {
+    pub service: String,
+    pub account: String,
+}
+
+impl SecretRef {
+    /// A reference whose two parts are non-empty and whose service has no `/` (the first `/`
+    /// after the scheme separates them, so an account may hold more). Whitespace around either
+    /// part is refused rather than trimmed: an attribute with a space is a different item.
+    pub fn new(service: &str, account: &str) -> Result<Self> {
+        if service.is_empty() || account.is_empty() {
+            bail!("a secret needs a service and an account");
+        }
+        if service.contains('/') {
+            bail!("a service cannot contain '/'");
+        }
+        for part in [service, account] {
+            if part.trim() != part || part.chars().any(char::is_control) {
+                bail!("{part:?} has surrounding spaces or control characters");
+            }
+        }
+        Ok(Self {
+            service: service.to_string(),
+            account: account.to_string(),
+        })
+    }
+
+    /// `secret://SERVICE/ACCOUNT`, as azukari reads it.
+    pub fn uri(&self) -> String {
+        format!("{SCHEME}{}/{}", self.service, self.account)
+    }
+
+    /// The inverse of [`Self::uri`].
+    pub fn parse(uri: &str) -> Result<Self> {
+        let Some(rest) = uri.strip_prefix(SCHEME) else {
+            bail!("{uri:?} is not a {SCHEME} reference");
+        };
+        let Some((service, account)) = rest.split_once('/') else {
+            bail!("{uri:?} has no account");
+        };
+        Self::new(service, account)
+    }
+
+    /// The attributes the item is stored and found under.
+    pub fn attributes(&self) -> [(&'static str, &str); 3] {
+        [
+            ("service", self.service.as_str()),
+            ("account", self.account.as_str()),
+            (VAULT_ATTRIBUTE, "1"),
+        ]
+    }
+
+    pub fn label(&self) -> String {
+        format!("{LABEL_PREFIX}{}/{}", self.service, self.account)
+    }
+}
+
+/// The last [`TAIL_LEN`] characters of `value`, or all of a shorter one -- by characters, so a
+/// multi-byte value is never cut inside one.
+pub fn tail(value: &str) -> String {
+    let count = value.chars().count();
+    value.chars().skip(count.saturating_sub(TAIL_LEN)).collect()
+}
+
+/// One listed secret.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VaultEntry {
+    pub reference: SecretRef,
+    /// [`tail`] of the value; empty when the item could not be read (locked).
+    pub tail: String,
+}
+
+/// The MCP server `command` line that hands a secret to `server` through azukari, with `name` the
+/// variable the server reads (set to the reference in the entry's `env`).
+pub fn azukari_command(name: &str, server: &str) -> String {
+    format!("azukari --env {name} -- {server}")
+}
+
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+mod keyring {
+    use super::*;
+    use anyhow::Context as _;
+
+    async fn open() -> Result<oo7::Keyring> {
+        let keyring = oo7::Keyring::new()
+            .await
+            .context("cannot reach the Secret Service")?;
+        keyring.unlock().await.context("the keyring is locked")?;
+        Ok(keyring)
+    }
+
+    /// Store `value` under `reference`, replacing an item Zeo made there before.
+    pub async fn store(reference: &SecretRef, value: &str) -> Result<()> {
+        let keyring = open().await?;
+        let attributes = reference.attributes().to_vec();
+        keyring
+            .create_item(&reference.label(), &attributes, value.as_bytes(), true)
+            .await
+            .with_context(|| format!("cannot store {}", reference.uri()))
+    }
+
+    /// Every item Zeo made, by reference, with the tail of its value.
+    pub async fn list() -> Result<Vec<VaultEntry>> {
+        let keyring = open().await?;
+        let items = keyring
+            .search_items(&vec![(VAULT_ATTRIBUTE, "1")])
+            .await
+            .context("cannot list the vault")?;
+        let mut out = Vec::new();
+        for item in items {
+            let attributes = item.attributes().await?;
+            let (Some(service), Some(account)) =
+                (attributes.get("service"), attributes.get("account"))
+            else {
+                continue;
+            };
+            let Ok(reference) = SecretRef::new(service, account) else {
+                continue;
+            };
+            let tail = match item.secret().await {
+                Ok(secret) => tail(&String::from_utf8_lossy(&secret)),
+                Err(_) => String::new(),
+            };
+            out.push(VaultEntry { reference, tail });
+        }
+        out.sort_by(|a, b| a.reference.cmp(&b.reference));
+        Ok(out)
+    }
+
+    /// Delete what Zeo stored under `reference`; nothing else matches the vault attribute.
+    pub async fn delete(reference: &SecretRef) -> Result<()> {
+        let keyring = open().await?;
+        keyring
+            .delete(&reference.attributes().to_vec())
+            .await
+            .with_context(|| format!("cannot delete {}", reference.uri()))
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+pub use keyring::{delete, list, store};
+
+#[cfg(not(any(target_os = "linux", target_os = "freebsd")))]
+mod keyring_unsupported {
+    use super::*;
+    pub async fn store(_: &SecretRef, _: &str) -> Result<()> {
+        bail!("the vault needs the Secret Service (Linux)")
+    }
+    pub async fn list() -> Result<Vec<VaultEntry>> {
+        Ok(Vec::new())
+    }
+    pub async fn delete(_: &SecretRef) -> Result<()> {
+        bail!("the vault needs the Secret Service (Linux)")
+    }
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "freebsd")))]
+pub use keyring_unsupported::{delete, list, store};
+
+#[cfg(test)]
+mod secret_vault_tests;
