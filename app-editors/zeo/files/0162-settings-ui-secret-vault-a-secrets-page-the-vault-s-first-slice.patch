+// Hub docs/SECRETS-VAULT-PAGE.md: the vault's pure rules. Filter: `secret_vault`.
+
+use super::*;
+
+#[test]
+fn secret_vault_reference_round_trips_and_keeps_slashes_in_the_account() {
+    let r = SecretRef::new("github", "org/bot").unwrap();
+    assert_eq!(r.uri(), "secret://github/org/bot");
+    assert_eq!(SecretRef::parse(&r.uri()).unwrap(), r);
+}
+
+#[test]
+fn secret_vault_refuses_what_azukari_could_not_resolve_the_same_way() {
+    for (service, account) in [
+        ("", "a"),
+        ("s", ""),
+        ("a/b", "c"),
+        (" s", "a"),
+        ("s", "a "),
+        ("s", "a\n"),
+    ] {
+        assert!(
+            SecretRef::new(service, account).is_err(),
+            "{service:?}/{account:?}"
+        );
+    }
+    for uri in ["github/token", "secret://github", "secret:///token"] {
+        assert!(SecretRef::parse(uri).is_err(), "{uri}");
+    }
+}
+
+#[test]
+fn secret_vault_attributes_are_azukaris_plus_the_vault_mark() {
+    let r = SecretRef::new("figma", "api-key").unwrap();
+    assert_eq!(
+        r.attributes(),
+        [
+            ("service", "figma"),
+            ("account", "api-key"),
+            ("zeo-vault", "1")
+        ]
+    );
+    assert_eq!(r.label(), "Zeo vault: figma/api-key");
+}
+
+#[test]
+fn secret_vault_tail_keeps_three_characters_by_character() {
+    assert_eq!(tail("ghp_abcdef"), "def");
+    assert_eq!(tail("ab"), "ab");
+    assert_eq!(tail(""), "");
+    assert_eq!(tail("xyzçãé"), "çãé");
+}
+
+#[test]
+fn secret_vault_azukari_command_names_the_variable_and_the_server() {
+    assert_eq!(
+        azukari_command("FIGMA_API_KEY", "npx figma-developer-mcp --stdio"),
+        "azukari --env FIGMA_API_KEY -- npx figma-developer-mcp --stdio"
+    );
+}
