+//! The vault against a running Secret Service (hub docs/SECRETS-VAULT-PAGE.md). Ignored by
+//! default: it needs a throwaway `oo7-daemon` on a private bus, which the lab's azukari image
+//! provides (`dbus-run-session` + `oo7-daemon --login`), and must never meet the operator's
+//! keyring. Run with `ZEO_VAULT_LIVE=1 cargo test -p secret_vault -- --ignored`.
+
+use secret_vault::{SecretRef, delete, list, store};
+
+fn live() -> bool {
+    std::env::var_os("ZEO_VAULT_LIVE").is_some_and(|v| v == "1")
+}
+
+#[test]
+#[ignore = "needs a throwaway oo7-daemon (ZEO_VAULT_LIVE=1)"]
+fn secret_vault_stores_lists_replaces_and_deletes_on_a_real_keyring() {
+    assert!(live(), "set ZEO_VAULT_LIVE=1 on a throwaway bus only");
+    smol::block_on(async {
+        let a = SecretRef::new("zeo-test", "token").unwrap();
+        let b = SecretRef::new("zeo-test", "org/bot").unwrap();
+        store(&a, "first-value-abc").await.unwrap();
+        store(&b, "second-xyz").await.unwrap();
+        let listed = list().await.unwrap();
+        let tails: Vec<_> = listed
+            .iter()
+            .filter(|e| e.reference.service == "zeo-test")
+            .map(|e| (e.reference.account.clone(), e.tail.clone()))
+            .collect();
+        assert_eq!(
+            tails,
+            vec![
+                ("org/bot".to_string(), "xyz".to_string()),
+                ("token".to_string(), "abc".to_string())
+            ]
+        );
+
+        // Saving again replaces: azukari would refuse two items under one reference.
+        store(&a, "replaced-value-QRS").await.unwrap();
+        let again = list().await.unwrap();
+        let same: Vec<_> = again.iter().filter(|e| e.reference == a).collect();
+        assert_eq!(same.len(), 1, "{again:?}");
+        assert_eq!(same[0].tail, "QRS");
+
+        delete(&a).await.unwrap();
+        delete(&b).await.unwrap();
+        let after = list().await.unwrap();
+        assert!(
+            after.iter().all(|e| e.reference.service != "zeo-test"),
+            "{after:?}"
+        );
+    });
+}
