+// Zeo next proposal §6.20 (ask 40): the panel lists its rows in pages, 10 by default, with
+// a footer to turn them and to change the size. GPUI integration tests over the real store.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Modifiers, TestAppContext};
+
+use crate::TaskFilter;
+use crate::test_helpers::*;
+
+async fn seed(db: &crate::AgentTaskHistoryDb, count: usize) {
+    for ix in 0..count {
+        let finished = record(
+            "s",
+            &format!("t{ix:02}"),
+            AgentTaskStatus::Completed,
+            ix as i64 * 1_000,
+        );
+        let mut running = finished.clone();
+        running.status = AgentTaskStatus::Running;
+        running.ended_at_ms = None;
+        running.tokens = None;
+        running.tool_uses = None;
+        db.insert_started(&running).await.unwrap();
+        db.update_ended(&finished).await.unwrap();
+    }
+}
+
+fn shown_count(panels: &mut Panels) -> usize {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel
+            .shown_groups(cx)
+            .iter()
+            .map(|group| group.rows.len())
+            .sum()
+    })
+}
+
+fn label(panels: &mut Panels) -> String {
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.page_label(cx))
+}
+
+/// Hostile: 23 rows are 10, 10 and 3 -- never all 23, and never a page past the end.
+#[gpui::test]
+async fn the_panel_shows_ten_rows_a_page_and_turns_pages(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, 23).await;
+    let mut panels = open_panels(cx).await;
+
+    assert_eq!(
+        visible_keys(&mut panels).len(),
+        23,
+        "the filters still list all"
+    );
+    assert_eq!(shown_count(&mut panels), 10);
+    assert_eq!(label(&mut panels), "1\u{2013}10 of 23");
+
+    for _ in 0..5 {
+        panels
+            .tasks_panel
+            .update(&mut panels.cx, |panel, cx| panel.turn_page(1, cx));
+    }
+    panels.cx.update(|window, _| window.refresh());
+    panels.cx.run_until_parked();
+    assert_eq!(shown_count(&mut panels), 3, "clamped to the last page");
+    assert_eq!(label(&mut panels), "21\u{2013}23 of 23");
+
+    // A filter change returns to page 1.
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Failed, true, cx)
+    });
+    panels.cx.run_until_parked();
+    assert_eq!(label(&mut panels), "1\u{2013}10 of 23");
+}
+
+/// The footer's buttons turn the page, and the size changes back to page 1.
+#[gpui::test]
+async fn the_pager_turns_pages_and_changes_the_size(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, 23).await;
+    let mut panels = open_panels(cx).await;
+    panels
+        .workspace
+        .update_in(&mut panels.cx, |workspace, window, cx| {
+            workspace.focus_panel::<crate::AgentTasksPanel>(window, cx);
+        });
+    panels.cx.update(|window, _| window.refresh());
+    panels.cx.run_until_parked();
+
+    let next = panels
+        .cx
+        .debug_bounds("agent-tasks-page-next")
+        .expect("the pager is painted");
+    panels.cx.simulate_click(next.center(), Modifiers::none());
+    panels.cx.run_until_parked();
+    assert_eq!(label(&mut panels), "11\u{2013}20 of 23");
+
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.set_page_size(25, cx));
+    panels.cx.run_until_parked();
+    assert_eq!(label(&mut panels), "1\u{2013}23 of 23");
+    assert_eq!(shown_count(&mut panels), 23);
+    panels
+        .tasks_panel
