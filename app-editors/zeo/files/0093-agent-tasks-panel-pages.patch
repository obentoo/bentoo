index 0000000..0aa0e12
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/pagination.rs
@@ -0,0 +1,191 @@
+//! Zeo next proposal §6.20 (ask 40): the Agent Tasks panel lists its rows in visible pages,
+//! 10 per page by default, with the size changeable. A page counts task rows, not thread
+//! headers: a thread whose rows run across a page break shows its header on both pages, so
+//! no row is ever drawn without the thread it belongs to.
+//!
+//! Pages slice what the filters already chose, in the order the panel already sorts it --
+//! newest first -- so a task that starts lands on page 1. The store still loads every row;
+//! this is about the reader, not the memory.
+
+use super::PanelGroup;
+
+/// The page sizes the footer offers, smallest first.
+pub(crate) const PAGE_SIZES: [usize; 4] = [10, 25, 50, 100];
+pub(crate) const DEFAULT_PAGE_SIZE: usize = PAGE_SIZES[0];
+
+/// Where the list stands: which page, how big, out of how many rows.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Page {
+    /// Zero-based, and always a page that exists (clamped).
+    pub index: usize,
+    pub size: usize,
+    pub total_rows: usize,
+}
+
+impl Page {
+    /// How many pages there are; one, even for an empty list.
+    pub(crate) fn count(&self) -> usize {
+        self.total_rows.div_ceil(self.size).max(1)
+    }
+
+    pub(crate) fn has_previous(&self) -> bool {
+        self.index > 0
+    }
+
+    pub(crate) fn has_next(&self) -> bool {
+        self.index + 1 < self.count()
+    }
+
+    /// "11–20 of 134"; "0 of 0" for nothing.
+    pub(crate) fn range_label(&self) -> String {
+        if self.total_rows == 0 {
+            return "0 of 0".to_string();
+        }
+        let first = self.index * self.size + 1;
+        let last = ((self.index + 1) * self.size).min(self.total_rows);
+        format!("{first}\u{2013}{last} of {}", self.total_rows)
+    }
+}
+
+/// A saved size the footer still offers, else the default: a value from an older or
+/// hand-edited store must not leave the picker showing nothing.
+pub(crate) fn page_size_or_default(saved: Option<usize>) -> usize {
+    saved
+        .filter(|size| PAGE_SIZES.contains(size))
+        .unwrap_or(DEFAULT_PAGE_SIZE)
+}
+
+/// The rows of page `index` (clamped to the last page), each under its thread's header.
+pub(crate) fn paginate(
+    groups: Vec<PanelGroup>,
+    index: usize,
+    size: usize,
+) -> (Vec<PanelGroup>, Page) {
+    let size = size.max(1);
+    let total_rows = groups.iter().map(|group| group.rows.len()).sum();
+    let mut page = Page {
+        index,
+        size,
+        total_rows,
+    };
+    page.index = page.index.min(page.count() - 1);
+    let start = page.index * size;
+    let end = start + size;
+
+    let mut seen = 0;
+    let mut shown = Vec::new();
+    for mut group in groups {
+        let group_start = seen;
+        seen += group.rows.len();
+        if seen <= start || group_start >= end {
+            continue;
+        }
+        let from = start.saturating_sub(group_start);
+        let to = (end - group_start).min(group.rows.len());
+        group.rows = group.rows.drain(from..to).collect();
+        shown.push(group);
+    }
+    (shown, page)
+}
+
+#[cfg(test)]
+mod tests {
+    use acp_thread::AgentTaskStatus;
+
+    use super::*;
+    use crate::test_helpers::{record, sid};
+    use crate::{HistoryEntry, TaskOrigin};
+
+    fn group(session: &str, rows: usize) -> PanelGroup {
+        PanelGroup {
+            session_id: sid(session),
+            title: session.to_string().into(),
+            rows: (0..rows)
+                .map(|ix| {
+                    let entry = HistoryEntry {
+                        record: record(
+                            session,
+                            &format!("{session}{ix}"),
+                            AgentTaskStatus::Completed,
+                            ix as i64,
+                        ),
+                        archived: false,
+                        label: None,
+                        log_bytes: None,
+                        origin: TaskOrigin::Adapter,
+                    };
+                    super::super::panel_row(&entry, None, false, None, None)
+                })
+                .collect(),
+        }
+    }
+
+    fn shape(groups: &[PanelGroup]) -> Vec<(String, Vec<String>)> {
+        groups
+            .iter()
+            .map(|group| {
+                (
+                    group.session_id.to_string(),
+                    group
+                        .rows
+                        .iter()
+                        .map(|row| row.entry.record.task_id.as_ref().to_string())
+                        .collect(),
+                )
+            })
+            .collect()
+    }
+
+    /// Hostile: a thread across the break shows its header on both pages, and a page counts
+    /// rows, never headers.
+    #[test]
+    fn a_page_counts_rows_and_repeats_a_split_threads_header() {
+        let groups = vec![group("a", 3), group("b", 4), group("c", 2)];
+        let (first, page) = paginate(groups.clone(), 0, 5);
+        assert_eq!(
+            shape(&first),
+            vec![
+                ("a".into(), vec!["a0".into(), "a1".into(), "a2".into()]),
+                ("b".into(), vec!["b0".into(), "b1".into()]),
+            ]
+        );
+        assert_eq!(
+            (page.count(), page.range_label()),
+            (2, "1\u{2013}5 of 9".to_string())
+        );
+        let (second, page) = paginate(groups, 1, 5);
+        assert_eq!(
+            shape(&second),
+            vec![
+                ("b".into(), vec!["b2".into(), "b3".into()]),
+                ("c".into(), vec!["c0".into(), "c1".into()]),
+            ]
+        );
+        assert_eq!(page.range_label(), "6\u{2013}9 of 9");
+        assert!(page.has_previous() && !page.has_next());
+    }
+
+    /// A page past the end -- rows were deleted under it -- shows the last page.
+    #[test]
+    fn a_page_past_the_end_is_the_last_page() {
+        let (shown, page) = paginate(vec![group("a", 12)], 7, 10);
+        assert_eq!(page.index, 1);
+        assert_eq!(shown[0].rows.len(), 2);
+    }
+
+    #[test]
+    fn an_empty_list_is_one_empty_page() {
+        let (shown, page) = paginate(Vec::new(), 3, 10);
+        assert!(shown.is_empty());
+        assert_eq!((page.index, page.count()), (0, 1));
+        assert_eq!(page.range_label(), "0 of 0");
+        assert!(!page.has_previous() && !page.has_next());
+    }
+
+    #[test]
+    fn a_saved_size_the_footer_does_not_offer_falls_back_to_ten() {
+        assert_eq!(page_size_or_default(Some(25)), 25);
+        assert_eq!(page_size_or_default(Some(7)), 10);
+        assert_eq!(page_size_or_default(None), 10);
+    }
+}
