diff --git a/crates/agent_ui/src/tasks_card/purpose_tests.rs b/crates/agent_ui/src/tasks_card/purpose_tests.rs
new file mode 100644
index 0000000..80b125c
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/purpose_tests.rs
@@ -0,0 +1,58 @@
+// Zeo next proposal §6.2 (ask 30): a task carries a purpose tag -- CI, Test, Build or Watch --
+// that Claude Agent (Plus) reads from the command (the command itself never reaches Zeo). The
+// card shows it as a chip beside the Foreground/Background one. Filter: `tasks_card::purpose`.
+
+use gpui::{TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn tagged(id: &str, purpose: serde_json::Value) -> serde_json::Value {
+    let mut task = wire_task(id, "running", true, 1_000);
+    task["purpose"] = purpose;
+    task
+}
+
+/// Hostile: an unknown purpose (a newer adapter's) is dropped on its own task, without failing
+/// the snapshot, and a task without one gets no chip.
+#[gpui::test]
+async fn test_purpose_shows_as_a_chip_and_an_unknown_one_is_ignored(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            tagged("t1", serde_json::json!("test")),
+            tagged("t2", serde_json::json!("deploy")),
+            wire_task("t3", "running", true, 1_002),
+            tagged("t4", serde_json::json!("ci")),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    assert_eq!(
+        rows_of(&card, &sa, &mut cx).len(),
+        4,
+        "the snapshot still parsed"
+    );
+    assert!(cx.debug_bounds("tasks-card-purpose-t1").is_some(), "Test");
+    assert!(cx.debug_bounds("tasks-card-purpose-t4").is_some(), "CI");
+    assert!(
+        cx.debug_bounds("tasks-card-purpose-t2").is_none(),
+        "unknown: no chip"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-purpose-t3").is_none(),
+        "none sent: no chip"
+    );
+    let purpose = find_row(&card, &sa, "t1", &mut cx).unwrap().task.purpose;
+    assert_eq!(purpose, Some(acp_thread::AgentTaskPurpose::Test));
+}
