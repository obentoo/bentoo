From 8498e13c88439a1a05280970bff6f4c09f89a21f Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Wed, 11 Nov 2026 00:31:55 -0300
Subject: [PATCH] agent_ui: a background task carries a purpose tag
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo next proposal §6.2 (ask 30). The tasks card told a task's kind
and whether it ran in the foreground or the background, and its
description, but not what it was for: a `cargo test` and a
`gh run watch` in the background looked alike. A shell task now
carries a chip beside its Foreground/Background one -- CI, Test, Build
or Watch.

The tag is decided by Claude Agent (Plus), not here. Plus reads the
command with a small rule table (task-purpose.ts: whole words, after
`cd … &&`, `VAR=value` and `sudo`; a CI run beats what it runs, a
watcher beats the test or build it repeats) and sends only the word,
under `purpose` on the `_claude/tasks` entry. The command itself never
reaches Zeo, because a command line can carry a secret, and keeping it
in the adapter keeps the feed's rule that no command goes on the wire.
An unclassified task has no field at all, so its bytes are unchanged.

AgentTaskPurpose knows four words. WireTask reads the field raw, as it
does child_session_id: a word this build does not know (a newer
adapter's) or a value of the wrong type is dropped on its own task
instead of failing the whole snapshot, which is what a typed field of
the wrong type would do. A subagent row built from the subagents RFD
(merge.rs) has no command and carries none.

Tests: tasks_card::purpose (the chip appears for "test" and "ci", not
for an unknown word nor for a task that sent none, and the snapshot
still parses with the unknown word in it; the row's AgentTask holds
AgentTaskPurpose::Test). Seen failing with parse() made to return None.
---

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index ebe0ef1..348897b 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -4028,6 +4028,40 @@ pub struct AgentTaskUsage {
     pub duration: Duration,
 }
 
+/// What a task is for, as the agent tagged it from its command (Zeo next §6.2). Claude Agent
+/// (Plus) reads the command and sends only the tag; the command never reaches Zeo.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum AgentTaskPurpose {
+    Ci,
+    Test,
+    Build,
+    Watch,
+}
+
+impl AgentTaskPurpose {
+    /// The wire's word; `None` for one this build does not know (a newer adapter's), which is
+    /// dropped on its own task.
+    fn parse(text: &str) -> Option<Self> {
+        match text {
+            "ci" => Some(Self::Ci),
+            "test" => Some(Self::Test),
+            "build" => Some(Self::Build),
+            "watch" => Some(Self::Watch),
+            _ => None,
+        }
+    }
+
+    /// The chip's text.
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Ci => "CI",
+            Self::Test => "Test",
+            Self::Build => "Build",
+            Self::Watch => "Watch",
+        }
+    }
+}
+
 /// A unit of agent work that can outlive the turn that started it: a background shell,
 /// a subagent, a monitor.
 #[derive(Debug, Clone, PartialEq)]
@@ -4053,6 +4087,8 @@ pub struct AgentTask {
     /// `_claude/tasks` version 3: the ACP session of the subagent this entry describes, so
     /// the task surfaces show one row per child whichever source names it (story 064).
     pub child_session_id: Option<acp_v2::SessionId>,
+    /// The agent's tag for the task, if it sent one this build knows (Zeo next §6.2).
+    pub purpose: Option<AgentTaskPurpose>,
 }
 
 /// The end of a task's output, as `_claude/tasks/output` answers it.
@@ -4094,6 +4130,10 @@ struct WireTask {
     // of failing the whole snapshot, which is what a wrong-typed `tail` does.
     #[serde(default)]
     child_session_id: Option<serde_json::Value>,
+    // Zeo next §6.2, optional. Raw for the same reason as `child_session_id`: a value of the
+    // wrong type, or a word this build does not know, is dropped on its own task.
+    #[serde(default)]
+    purpose: Option<serde_json::Value>,
 }
 
 #[derive(Deserialize)]
@@ -4165,6 +4205,11 @@ impl From<WireTask> for AgentTask {
                 .tail
                 .map(|lines| lines.into_iter().map(SharedString::from).collect()),
             child_session_id,
+            purpose: task
+                .purpose
+                .as_ref()
+                .and_then(serde_json::Value::as_str)
+                .and_then(AgentTaskPurpose::parse),
         }
     }
 }
