     }
 
+    /// Zeo (zed-patches 0205): the pixel offset of a list position, and scrolling to one, as an
+    /// animated scroll uses them -- with no scroll handler called, so a handler hears only the
+    /// user.
+    #[gpui::test]
+    fn test_pixel_offsets_and_scrolling_to_one(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+        let state = ListState::new(10, crate::ListAlignment::Top, px(10.));
+        let handled = std::rc::Rc::new(std::cell::Cell::new(0));
+        state.set_scroll_handler({
+            let handled = handled.clone();
+            move |_, _, _| handled.set(handled.get() + 1)
+        });
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(60.)), |_, cx| {
+            cx.new(|_| TestListView(state.clone())).into_any_element()
+        });
+
+        // Twenty-pixel items: item 3 starts at 60.
+        assert_eq!(state.pixel_offset_of(list_offset(3, 5.)), px(65.));
+        assert_eq!(state.scroll_top_pixel_offset(), px(0.));
+
+        state.scroll_to_pixel_offset(px(45.));
+        assert_eq!(state.logical_scroll_top(), list_offset(2, 5.));
+        assert_eq!(state.scroll_top_pixel_offset(), px(45.));
+
+        state.scroll_to_pixel_offset(px(-30.));
+        assert_eq!(state.logical_scroll_top(), list_offset(0, 0.));
+        assert_eq!(
+            handled.get(),
+            0,
+            "no scroll handler for a scroll the program made"
+        );
+    }
+
