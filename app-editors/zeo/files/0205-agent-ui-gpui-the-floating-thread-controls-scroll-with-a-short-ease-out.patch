@@ -0,0 +1,115 @@
+//! Zeo next §6.52 (zed-patches 0205): the floating controls' animated scroll. The list is a
+//! plain GPUI list of 20 px rows, so every pixel is known.
+//!
+//! Not covered here: a wheel event ending the animation inside a thread view (the handler
+//! clears it; an Xvfb run is where that is seen), and frame timing.
+
+use std::time::Duration;
+
+use gpui::{
+    AppContext as _, Context, IntoElement, ListAlignment, ListOffset, ListState, Render,
+    Styled as _, TestAppContext, Window, div, list, point, px, size,
+};
+
+use super::*;
+
+struct Rows(ListState);
+
+impl Render for Rows {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        list(self.0.clone(), |_, _, _| {
+            div().h(px(20.)).w_full().into_any_element()
+        })
+        .w_full()
+        .h_full()
+    }
+}
+
+fn offset(item_ix: usize) -> ListOffset {
+    ListOffset {
+        item_ix,
+        offset_in_item: px(0.),
+    }
+}
+
+#[test]
+fn a_short_jump_starts_where_the_list_is() {
+    assert_eq!(start_from(px(100.), px(150.), px(100.)), px(100.));
+    assert_eq!(start_from(px(150.), px(100.), px(100.)), px(150.));
+}
+
+#[test]
+fn a_long_jump_starts_one_viewport_short_on_the_side_it_comes_from() {
+    assert_eq!(start_from(px(0.), px(800.), px(100.)), px(700.));
+    assert_eq!(start_from(px(800.), px(0.), px(100.)), px(100.));
+}
+
+#[test]
+fn reduce_motion_and_following_the_tail_do_not_animate() {
+    let message = ScrollTarget::Offset(offset(3));
+    assert!(animates(message, false, false));
+    assert!(
+        animates(message, false, true),
+        "a message while writing still animates"
+    );
+    assert!(!animates(message, true, false), "reduce motion");
+    assert!(animates(ScrollTarget::End, false, false));
+    assert!(
+        !animates(ScrollTarget::End, false, true),
+        "the tail is being followed"
+    );
+}
+
+#[gpui::test]
+fn the_animation_moves_frame_by_frame_and_lands_on_scroll_to(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let state = ListState::new(50, ListAlignment::Top, px(2048.));
+    cx.draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, cx| {
+        cx.new(|_| Rows(state.clone())).into_any_element()
+    });
+    let start = std::time::Instant::now();
+
+    let animation = ScrollAnimation::start(&state, ScrollTarget::Offset(offset(40)), start)
+        .expect("800 px to go");
+    assert_eq!(
+        state.scroll_top_pixel_offset(),
+        px(700.),
+        "a jump of 800 px starts one 100 px viewport short"
+    );
+
+    assert!(animation.step(&state, start + SCROLL_ANIMATION / 4));
+    let early = state.scroll_top_pixel_offset();
+    assert!(
+        early > px(700.) && early < px(800.),
+        "on its way: {early:?}"
+    );
+    assert!(animation.step(&state, start + SCROLL_ANIMATION / 2));
+    assert!(
+        state.scroll_top_pixel_offset() >= early,
+        "it never moves back"
+    );
+
+    assert!(!animation.step(&state, start + SCROLL_ANIMATION + Duration::from_millis(1)));
+    assert_eq!(
+        state.logical_scroll_top(),
+        offset(40),
+        "it lands exactly where scroll_to puts it"
+    );
+}
+
+#[gpui::test]
+fn nothing_to_animate_when_already_there(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let state = ListState::new(50, ListAlignment::Top, px(2048.));
+    cx.draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, cx| {
+        cx.new(|_| Rows(state.clone())).into_any_element()
+    });
+    assert!(
+        ScrollAnimation::start(
+            &state,
+            ScrollTarget::Offset(offset(0)),
+            std::time::Instant::now()
+        )
+        .is_none()
+    );
+}
diff --git a/crates/gpui/src/elements/list.rs b/crates/gpui/src/elements/list.rs
index eecfd76..cc181d7 100644
--- a/crates/gpui/src/elements/list.rs
+++ b/crates/gpui/src/elements/list.rs
@@ -675,6 +675,40 @@ impl ListState {
         state.set_scroll_anchor(Some(scroll_top));
     }
 
+    /// The distance of `offset` from the top of the list, by the heights measured so far: an
+    /// item not measured yet counts as its size hint, or nothing. What an animated scroll
+    /// interpolates between (Zeo, zed-patches 0205); exact only where the items are measured,
+    /// which is why such a scroll ends on [`Self::scroll_to`] rather than on a pixel value.
+    pub fn pixel_offset_of(&self, offset: ListOffset) -> Pixels {
+        self.0.borrow().scroll_top(&offset)
+    }
+
+    /// The current [`Self::logical_scroll_top`] as a distance from the top of the list.
+    pub fn scroll_top_pixel_offset(&self) -> Pixels {
+        let state = self.0.borrow();
+        state.scroll_top(&state.logical_scroll_top())
+    }
+
+    /// Scroll so the top of the viewport sits `pixels` from the top of the list, by the
+    /// heights measured so far, clamped at the top. Like [`Self::scroll_to`], it stops
+    /// following the tail; unlike a wheel event, it calls no scroll handler, so a handler can
+    /// tell the user's scrolling from the program's (Zeo, zed-patches 0205).
+    pub fn scroll_to_pixel_offset(&self, pixels: Pixels) {
+        let state = &mut *self.0.borrow_mut();
+        let (start, ..) =
+            state
+                .items
+                .find::<ListItemSummary, _>((), &Height(pixels.max(px(0.))), Bias::Right);
+        let scroll_top = ListOffset {
+            item_ix: start.count,
+            offset_in_item: pixels.max(px(0.)) - start.height,
+        };
+        if scroll_top.item_ix < state.items.summary().count {
+            state.follow_state.stop_following();
+        }
+        state.set_scroll_anchor(Some(scroll_top));
+    }
+
     /// Scroll the list to the given item, such that the item is fully visible.
     pub fn scroll_to_reveal_item(&self, ix: usize) {
         let state = &mut *self.0.borrow_mut();
@@ -3871,6 +3905,39 @@ mod test {
