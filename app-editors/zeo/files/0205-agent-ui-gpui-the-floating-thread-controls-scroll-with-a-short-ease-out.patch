+++ b/crates/agent_ui/src/conversation_view/thread_view/scroll_animation.rs
@@ -0,0 +1,107 @@
+//! The floating thread controls scroll with a short ease-out instead of jumping (Zeo next
+//! §6.52, second step; operator, 2026-11-26).
+//!
+//! A jump to a message, the top or the end moves the list's top over [`SCROLL_ANIMATION`],
+//! one step per frame, from where it is to where `scroll_to` would put it, and ends on that
+//! very `scroll_to` -- so where it lands is exactly where the jump landed before, whatever the
+//! pixel steps on the way were. The steps are pixels by the heights GPUI has measured
+//! (`ListState::pixel_offset_of`, zed-patches 0205), and the list measures only around the
+//! viewport (2048 px of overdraw), so a jump longer than a viewport starts one viewport short of
+//! its target, inside measured items, instead of sliding through rows it would have to lay out
+//! on every frame.
+//!
+//! It is the floating controls' four buttons only: every other `scroll_to` (sending, restoring a
+//! position, opening at a task) stays instant, since nobody asked to watch those move. No
+//! animation under reduce motion, and none to the end while the agent is writing -- following
+//! the tail is a scroll of its own, and two would fight. A wheel event ends the animation where
+//! it stands: the thread's scroll handler hears only the user, since `scroll_to_pixel_offset`
+//! calls no handler.
+
+use std::time::{Duration, Instant};
+
+use gpui::{ListOffset, ListState, Pixels, ease_out_quint, px};
+
+/// Long enough to see where the view went, short enough not to wait for it.
+pub(crate) const SCROLL_ANIMATION: Duration = Duration::from_millis(200);
+
+/// Where a floating control scrolls to.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum ScrollTarget {
+    Offset(ListOffset),
+    End,
+}
+
+/// Whether a jump to `target` is animated: not under reduce motion, and not to the end while
+/// the agent is writing.
+pub(crate) fn animates(target: ScrollTarget, reduce_motion: bool, generating: bool) -> bool {
+    !reduce_motion && !(target == ScrollTarget::End && generating)
+}
+
+/// Where the animation starts: where the list is, unless the target is more than a viewport
+/// away, then one viewport short of it, on the side the list is coming from.
+pub(crate) fn start_from(current: Pixels, to: Pixels, viewport: Pixels) -> Pixels {
+    if to - current > viewport {
+        (to - viewport).max(px(0.))
+    } else if current - to > viewport {
+        to + viewport
+    } else {
+        current
+    }
+}
+
+/// A scroll in progress.
+pub(crate) struct ScrollAnimation {
+    from: Pixels,
+    to: Pixels,
+    target: ScrollTarget,
+    started: Instant,
+}
+
+impl ScrollAnimation {
+    /// The animation from where `list` is to `target`, or `None` when there is less than a
+    /// pixel to go -- the caller lands at once.
+    pub(crate) fn start(list: &ListState, target: ScrollTarget, now: Instant) -> Option<Self> {
+        let to = match target {
+            ScrollTarget::Offset(offset) => list.pixel_offset_of(offset),
+            ScrollTarget::End => list.max_offset_for_scrollbar().y,
+        };
+        let viewport = list.viewport_bounds().size.height;
+        let from = start_from(list.scroll_top_pixel_offset(), to, viewport);
+        if (to - from).abs() < px(1.) {
+            return None;
+        }
+        list.scroll_to_pixel_offset(from);
+        Some(Self {
+            from,
+            to,
+            target,
+            started: now,
+        })
+    }
+
+    /// Moves `list` to where the animation is at `now`. `false` once it has landed on the
+    /// target, which is then exactly where `scroll_to` puts it.
+    pub(crate) fn step(&self, list: &ListState, now: Instant) -> bool {
+        let elapsed = now.saturating_duration_since(self.started);
+        let progress = elapsed.as_secs_f32() / SCROLL_ANIMATION.as_secs_f32();
+        if progress >= 1. {
+            land(list, self.target);
+            return false;
+        }
+        let eased = ease_out_quint()(progress.clamp(0., 1.));
+        list.scroll_to_pixel_offset(self.from + (self.to - self.from) * eased);
+        true
+    }
+}
+
+/// Puts `list` exactly where a jump to `target` puts it without an animation.
+pub(crate) fn land(list: &ListState, target: ScrollTarget) {
+    match target {
+        ScrollTarget::Offset(offset) => list.scroll_to(offset),
+        ScrollTarget::End => list.scroll_to_end(),
+    }
+}
+
+#[cfg(test)]
+#[path = "scroll_animation_tests.rs"]
+mod tests;
