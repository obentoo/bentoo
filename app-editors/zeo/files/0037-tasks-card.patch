new file mode 100644
index 0000000..54bdc62
--- /dev/null
+++ b/crates/agent_settings/src/agent_settings_tasks_card_tests.rs
@@ -0,0 +1,74 @@
+// Story 013 / task 3.1 — `agent.tasks_card.{enabled, position}` (R2.3, R2.4).
+//
+// Included at the end of `mod tests` in `agent_settings.rs`:
+//
+//     include!("agent_settings_tasks_card_tests.rs");
+//
+// Filter: `cargo test -p agent_settings tasks_card`.
+
+#[gpui::test]
+fn test_tasks_card_defaults_to_enabled_in_the_top_right(cx: &mut gpui::App) {
+    let store = SettingsStore::test(cx);
+    cx.set_global(store);
+    project::DisableAiSettings::register(cx);
+    AgentSettings::register(cx);
+
+    let tasks_card = &AgentSettings::get_global(cx).tasks_card;
+    assert!(tasks_card.enabled);
+    assert_eq!(tasks_card.position, settings::TasksCardPosition::TopRight);
+}
+
+#[gpui::test]
+fn test_tasks_card_follows_user_settings_one_key_at_a_time(cx: &mut gpui::App) {
+    use settings::TasksCardPosition;
+
+    let store = SettingsStore::test(cx);
+    cx.set_global(store);
+    project::DisableAiSettings::register(cx);
+    AgentSettings::register(cx);
+
+    // Each key is independent: setting one must not reset the other to a
+    // zero value (`enabled: false`, or the first corner).
+    for (content, enabled, position) in [
+        (
+            r#"{"agent": {"tasks_card": {"position": "bottom_left"}}}"#,
+            true,
+            TasksCardPosition::BottomLeft,
+        ),
+        (
+            r#"{"agent": {"tasks_card": {"enabled": false}}}"#,
+            false,
+            TasksCardPosition::TopRight,
+        ),
+        (
+            r#"{"agent": {"tasks_card": {"enabled": false, "position": "top_left"}}}"#,
+            false,
+            TasksCardPosition::TopLeft,
+        ),
+        (
+            r#"{"agent": {"tasks_card": {"position": "bottom_right"}}}"#,
+            true,
+            TasksCardPosition::BottomRight,
+        ),
+        (
+            r#"{"agent": {"tasks_card": {"position": "top_right"}}}"#,
+            true,
+            TasksCardPosition::TopRight,
+        ),
+        (
+            r#"{"agent": {"tasks_card": {}}}"#,
+            true,
+            TasksCardPosition::TopRight,
+        ),
+        (r#"{"agent": {}}"#, true, TasksCardPosition::TopRight),
+    ] {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(content, cx)
+                .expect("user settings should load");
+        });
+        let tasks_card = &AgentSettings::get_global(cx).tasks_card;
+        assert_eq!(tasks_card.enabled, enabled, "{content}");
+        assert_eq!(tasks_card.position, position, "{content}");
+    }
+}
