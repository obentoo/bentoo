+    fn row_focus_handle(
+        &mut self,
+        key: &TaskKey,
+        control: RowControl,
+        cx: &mut Context<Self>,
+    ) -> FocusHandle {
+        self.row_focus_handles
+            .entry((key.clone(), control))
+            .or_insert_with(|| control_focus_handle(cx))
+            .clone()
+    }
+
+    fn forget_focus_of_rows_gone(&mut self, groups: &[ThreadGroup]) {
+        let on_show: HashSet<TaskKey> = groups
+            .iter()
+            .flat_map(|group| {
+                group
+                    .rows
+                    .iter()
+                    .map(|row| (group.session_id.clone(), row.task.id.clone()))
+            })
+            .collect();
+        self.row_focus_handles
+            .retain(|(key, _), _| on_show.contains(key));
+        self.group_focus_handles
+            .retain(|session_id, _| groups.iter().any(|group| &group.session_id == session_id));
+    }
+}
