+// Story 013 / task 5.2 — Send to Background (R4.4, R4.5, R4.7).
+// Filter: `tasks_card::background`.
+
+use gpui::{TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Offered on a foreground row, and only there — a background row has nothing to
+/// move.
+#[gpui::test]
+async fn test_send_to_background_is_offered_only_on_foreground_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("bg", "running", true, 1_000),
+            wire_task("fg", "running", false, 2_000),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-row-bg").is_some());
+    assert!(cx.debug_bounds("tasks-card-background-bg").is_none());
+    assert!(cx.debug_bounds("tasks-card-background-fg").is_some());
+}
+
+/// Foreground is not enough: a foreground task with no tool call id has nothing to
+/// address the action to, so it offers no button either.
+#[gpui::test]
+async fn test_send_to_background_needs_a_tool_call_id(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let mut no_call = wire_task("nocall", "running", false, 1_000);
+    no_call["toolCallId"] = serde_json::Value::Null;
+    send_tasks(
+        &a,
+        vec![no_call, wire_task("fg", "running", false, 2_000)],
+        &mut cx,
+    );
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-row-nocall").is_some());
+    assert!(cx.debug_bounds("tasks-card-background-nocall").is_none());
+    assert!(cx.debug_bounds("tasks-card-background-fg").is_some());
+}
+
+#[gpui::test]
+async fn test_send_to_background_sends_without_a_prompt(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("fg", "running", false, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "fg", &mut cx).unwrap().task.id;
+
+    card.update(&mut cx, |card, cx| {
+        card.send_to_background(sa.clone(), id, cx)
+    });
+    cx.run_until_parked();
+    assert!(
+        !cx.has_pending_prompt(),
+        "moving to the background loses no work: no prompt"
+    );
+    // The action is addressed by the task's tool call.
+    assert_eq!(
+        connection.backgrounds(),
+        vec![(sa.to_string(), "toolu_fg".to_string())]
+    );
+    assert!(find_row(&card, &sa, "fg", &mut cx).unwrap().error.is_none());
+}
+
+#[gpui::test]
+async fn test_background_error_and_nothing_moved_show_on_the_row(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("fg", "running", false, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "fg", &mut cx).unwrap().task.id;
+
+    // An error from the action.
+    *connection.background_answer.lock().unwrap() =
+        BackgroundAnswer::Err("background failed for task toolu_fg: busy");
+    card.update(&mut cx, |card, cx| {
+        card.send_to_background(sa.clone(), id.clone(), cx)
+    });
+    cx.run_until_parked();
+    let error = find_row(&card, &sa, "fg", &mut cx)
+        .unwrap()
+        .error
+        .expect("error on the row");
+    assert!(error.contains("busy"), "row error was {error:?}");
+
+    // `Ok(false)`: the call succeeded and moved nothing — that is not silent success.
+    *connection.background_answer.lock().unwrap() = BackgroundAnswer::NothingMoved;
+    card.update(&mut cx, |card, cx| {
+        card.send_to_background(sa.clone(), id, cx)
+    });
+    cx.run_until_parked();
+    let error = find_row(&card, &sa, "fg", &mut cx)
+        .unwrap()
+        .error
+        .expect("error on the row");
+    assert_eq!(error.to_string(), "Nothing was moved to the background");
+}
diff --git a/crates/agent_ui/src/tasks_card/group_open_tests.rs b/crates/agent_ui/src/tasks_card/group_open_tests.rs
new file mode 100644
index 0000000..f35dd10
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/group_open_tests.rs
@@ -0,0 +1,162 @@
+// Story 013 / task 9.1 — activating a thread group's header opens the thread at
+// its oldest running task's tool call, or only opens it when no running task has
+// one (R4.8). Filter: `tasks_card::group_open`.
+
+use acp_thread::{AcpThread, AgentThreadEntry};
+use agent_client_protocol::schema::v1 as acp;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{Entity, Modifiers, TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+use crate::test_support::active_session_id;
+
+/// Fills `thread` with forty user/agent messages before, between and after each
+/// of `tool_calls`, so every one of them sits at its own index and scrolling to
+/// it moves the list.
+fn fill_around_tool_calls(
+    thread: &Entity<AcpThread>,
+    tool_calls: &[&str],
+    cx: &mut VisualTestContext,
+) {
+    thread.update(cx, |thread, cx| {
+        let mut push = |update: acp::SessionUpdate| {
+            thread
+                .handle_session_update(update, cx)
+                .expect("entry applies");
+        };
+        push_messages(&mut push);
+        for tool_call in tool_calls {
+            push(acp::SessionUpdate::ToolCall(acp::ToolCall::new(
+                tool_call.to_string(),
+                format!("Run {tool_call}"),
+            )));
+            push_messages(&mut push);
+        }
+    });
+    cx.run_until_parked();
+}
+
+fn push_messages(push: &mut dyn FnMut(acp::SessionUpdate)) {
+    for i in 0..20 {
+        push(acp::SessionUpdate::UserMessageChunk(
+            acp::ContentChunk::new(format!("question {i}").into()),
+        ));
+        push(acp::SessionUpdate::AgentMessageChunk(
+            acp::ContentChunk::new(format!("answer {i}").into()),
+        ));
+    }
+}
+
+fn tool_call_index(thread: &Entity<AcpThread>, id: &str, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .position(|entry| matches!(entry, AgentThreadEntry::ToolCall(call) if call.id.to_string() == id))
+            .expect("the tool call is an entry")
+    })
+}
+
+fn scroll_top(panel: &Entity<crate::AgentPanel>, cx: &mut VisualTestContext) -> usize {
+    let view = panel.read_with(cx, |panel, cx| panel.active_thread_view(cx).unwrap());
+    view.read_with(cx, |view, _| view.list_state.logical_scroll_top().item_ix)
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Clicks the painted header of `session`'s group, as the user does.
+fn click_group_header(session: &acp_v2::SessionId, cx: &mut VisualTestContext) {
+    draw(cx);
+    // `debug_bounds` takes a `&'static str`; the selector carries the session id.
+    let selector: &'static str = format!("tasks-card-open-group-{}", session.0).leak();
+    let header = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(header.center(), Modifiers::none());
+    cx.run_until_parked();
+}
+
+fn without_tool_call(mut task: serde_json::Value) -> serde_json::Value {
+    task["toolCallId"] = serde_json::Value::Null;
+    task
+}
+
+/// Hostile on three fronts: the older task's tool call sits *later* in the
+/// thread than the newer one's, the snapshot lists the newer task first, and an
+/// even older running task has no tool call at all — so only "the oldest running
+/// task that has one" lands on `toolu_old`. Another thread is in front, too.
+#[gpui::test]
+async fn test_group_header_scrolls_to_the_oldest_running_tool_call(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    fill_around_tool_calls(&a, &["toolu_new", "toolu_old"], &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("new", "running", true, 3_000),
+            wire_task("old", "running", true, 2_000),
+            without_tool_call(wire_task("oldest", "running", true, 1_000)),
+        ],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let older = tool_call_index(&a, "toolu_old", &cx);
+    let newer = tool_call_index(&a, "toolu_new", &cx);
+    assert!(newer > 0 && older > newer, "distinct, non-zero indexes");
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 4_000)], &mut cx);
+    assert_eq!(active_session_id(&panel, &cx), session_of(&b, &cx));
+
+    click_group_header(&sa, &mut cx);
+
+    assert_eq!(active_session_id(&panel, &cx), sa);
+    assert_eq!(
+        scroll_top(&panel, &mut cx),
+        older,
+        "the header opens at the OLDEST running task's tool call"
+    );
+}
+
+/// No running task of the group has a tool call: the header brings the thread
+/// forward and leaves its scroll where it was — not at an unrelated tool call.
+#[gpui::test]
+async fn test_group_header_without_a_tool_call_opens_the_thread_only(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    fill_around_tool_calls(&a, &["toolu_unrelated"], &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            without_tool_call(wire_task("t1", "running", true, 1_000)),
+            without_tool_call(wire_task("t2", "running", true, 2_000)),
+        ],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let unrelated = tool_call_index(&a, "toolu_unrelated", &cx);
+    let before = scroll_top(&panel, &mut cx);
+    assert_ne!(
+        before, unrelated,
+        "the fixture starts away from the tool call"
+    );
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    assert_eq!(active_session_id(&panel, &cx), session_of(&b, &cx));
+
+    click_group_header(&sa, &mut cx);
+
+    assert_eq!(
+        active_session_id(&panel, &cx),
+        sa,
+        "the header brings the thread forward"
+    );
+    assert_eq!(
+        scroll_top(&panel, &mut cx),
+        before,
+        "opened without scrolling"
+    );
+}
diff --git a/crates/agent_ui/src/tasks_card/live_tests.rs b/crates/agent_ui/src/tasks_card/live_tests.rs
new file mode 100644
index 0000000..31f7327
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/live_tests.rs
@@ -0,0 +1,101 @@
+// Story 013 / task 4.2 — live progress and the elapsed-time tick (R1.4, R1.5).
+// Filter: `tasks_card::live`.
+
+use std::{cell::Cell, rc::Rc, time::Duration};
+
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::TasksCard;
+use super::test_helpers::*;
+
+/// Counts the card's `cx.notify()` calls — each one is a repaint request.
+fn count_notifies(card: &Entity<TasksCard>, cx: &mut VisualTestContext) -> Rc<Cell<usize>> {
+    let count = Rc::new(Cell::new(0));
+    let sink = count.clone();
+    cx.update(|_, cx| {
+        cx.observe(card, move |_, _| sink.set(sink.get() + 1))
+            .detach();
+    });
+    count
+}
+
+fn progress_task(tokens: u64, tool_uses: u64, last_tool: &str, summary: &str) -> serde_json::Value {
+    let mut task = wire_task("t1", "running", true, 1_000);
+    task["usage"] = json!({ "tokens": tokens, "toolUses": tool_uses, "durationMs": 1_000 });
+    task["lastTool"] = json!(last_tool);
+    task["summary"] = json!(summary);
+    task
+}
+
+#[gpui::test]
+async fn test_a_progress_snapshot_updates_the_row_without_user_action(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let sa = session_of(&a, &cx);
+    send_tasks(&a, vec![progress_task(10, 1, "Read", "Reading")], &mut cx);
+    let card = card(&panel, &cx);
+    let notifies = count_notifies(&card, &mut cx);
+
+    send_tasks(
+        &a,
+        vec![progress_task(250, 4, "Grep", "Searching the tree")],
+        &mut cx,
+    );
+    assert!(notifies.get() >= 1, "a changed snapshot repaints the card");
+    let row = find_row(&card, &sa, "t1", &mut cx).unwrap();
+    assert_eq!(
+        row.task.last_tool.as_ref().map(|s| s.to_string()),
+        Some("Grep".into())
+    );
+    assert_eq!(
+        row.task.summary.as_ref().map(|s| s.to_string()),
+        Some("Searching the tree".into())
+    );
+    let usage = format!("{:?}", row.task.usage);
+    assert!(usage.contains("250"), "tokens reach the row: {usage}");
+}
+
+/// The tick runs only while the card is expanded AND a task runs — a timer that
+/// never sleeps is the failure this guards against, in both directions.
+#[gpui::test]
+async fn test_elapsed_tick_runs_only_while_expanded_with_a_running_task(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let card = card(&panel, &cx);
+    let notifies = count_notifies(&card, &mut cx);
+
+    // Expanded and running: one repaint per second, with no snapshot arriving.
+    for _ in 0..3 {
+        advance(&mut cx, Duration::from_secs(1));
+    }
+    assert!(
+        notifies.get() >= 3,
+        "ticked {} times in 3 s",
+        notifies.get()
+    );
+
+    // Minimized: the timer is gone.
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    cx.run_until_parked();
+    notifies.set(0);
+    advance(&mut cx, Duration::from_secs(5));
+    assert_eq!(notifies.get(), 0, "no tick while minimized");
+
+    // Expanded again: it comes back.
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    cx.run_until_parked();
+    notifies.set(0);
+    advance(&mut cx, Duration::from_secs(2));
+    assert!(notifies.get() >= 2);
+
+    // Idle (the task ended and its row expired): the timer stops.
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    advance(&mut cx, Duration::from_secs(11));
+    notifies.set(0);
+    advance(&mut cx, Duration::from_secs(5));
+    assert_eq!(notifies.get(), 0, "no tick with nothing running");
+}
diff --git a/crates/agent_ui/src/tasks_card/model_tests.rs b/crates/agent_ui/src/tasks_card/model_tests.rs
new file mode 100644
index 0000000..61bf722
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/model_tests.rs
@@ -0,0 +1,412 @@
+// Story 013 / task 3.2 — the TasksCard state and its `rows()` projection
+// (R1.2, R1.3, R1.6, R1.7, R1.8, R2.5, R3.1, R3.3). Filter: `tasks_card::model`.
+
+use std::time::Duration;
+
+use acp_thread::AgentTaskStatus;
+use agent_settings::{AgentSettings, TasksCardSettings};
+use gpui::{AppContext as _, TestAppContext};
+use settings::{Settings as _, TasksCardPosition};
+
+use super::TasksCard;
+use super::test_helpers::*;
+
+// ---- R1.3 — grouping, hostile halves first --------------------------------------
+
+/// Wrongly collapse: two threads with the SAME title, each running a task with the
+/// SAME id and description, are two groups — a thread is its session, not its title.
+#[gpui::test]
+async fn test_rows_two_threads_with_same_titled_tasks_stay_apart(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+
+    let card = card(&panel, &cx);
+    let groups = rows(&card, &mut cx);
+    assert_eq!(
+        groups.len(),
+        2,
+        "one group per thread, even with equal titles"
+    );
+    let sessions: Vec<_> = groups.iter().map(|g| g.session_id.clone()).collect();
+    assert!(sessions.contains(&session_of(&a, &cx)));
+    assert!(sessions.contains(&session_of(&b, &cx)));
+    for group in &groups {
+        assert_eq!(row_ids(&group.rows), vec!["t1".to_string()]);
+    }
+}
+
+/// Wrongly split: two tasks of ONE thread are one group with two rows.
+#[gpui::test]
+async fn test_rows_two_tasks_of_one_thread_share_one_group(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Only thread", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("fg", "running", false, 1_000),
+            wire_task("bg", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+
+    let card = card(&panel, &cx);
+    let groups = rows(&card, &mut cx);
+    assert_eq!(groups.len(), 1);
+    let mut ids = row_ids(&groups[0].rows);
+    ids.sort();
+    assert_eq!(ids, vec!["bg".to_string(), "fg".to_string()]);
+}
+
+/// Groups are ordered by the start time of their oldest RUNNING task — not by
+/// thread open order, and not by an ended task that started earlier.
+#[gpui::test]
+async fn test_rows_order_threads_by_oldest_running_task(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let first_opened = open_titled_thread(&panel, &connection, "First opened", &mut cx);
+    // Its only running task started late; an ended task started earliest of all.
+    send_tasks(
+        &first_opened,
+        vec![
+            wire_task("old-ended", "completed", true, 100),
+            wire_task("late", "running", true, 5_000),
+        ],
+        &mut cx,
+    );
+    let second_opened = open_titled_thread(&panel, &connection, "Second opened", &mut cx);
+    send_tasks(
+        &second_opened,
+        vec![wire_task("early", "running", true, 1_000)],
+        &mut cx,
+    );
+
+    let card = card(&panel, &cx);
+    let order: Vec<_> = rows(&card, &mut cx)
+        .into_iter()
+        .map(|group| group.session_id)
+        .collect();
+    assert_eq!(
+        order,
+        vec![
+            session_of(&second_opened, &cx),
+            session_of(&first_opened, &cx)
+        ]
+    );
+}
+
+/// Threads holding only ended rows go AFTER every thread with a running task —
+/// even when their tasks started earlier — and among themselves the most recent
+/// ending comes first.
+#[gpui::test]
+async fn test_rows_put_ended_only_threads_last_most_recent_ending_first(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    // Ended early, started earliest of all.
+    let ended_first = open_titled_thread(&panel, &connection, "Ended first", &mut cx);
+    send_tasks(
+        &ended_first,
+        vec![wire_task("e1", "running", true, 100)],
+        &mut cx,
+    );
+    send_tasks(
+        &ended_first,
+        vec![wire_task("e1", "completed", true, 100)],
+        &mut cx,
+    );
+    // Running, started latest of all.
+    let running = open_titled_thread(&panel, &connection, "Running", &mut cx);
+    send_tasks(
+        &running,
+        vec![wire_task("r1", "running", true, 90_000)],
+        &mut cx,
+    );
+    // Ended later than `ended_first`.
+    let ended_last = open_titled_thread(&panel, &connection, "Ended last", &mut cx);
+    send_tasks(
+        &ended_last,
+        vec![wire_task("e2", "running", true, 200)],
+        &mut cx,
+    );
+    send_tasks(
+        &ended_last,
+        vec![wire_task("e2", "failed", true, 200)],
+        &mut cx,
+    );
+
+    let card = card(&panel, &cx);
+    let order: Vec<_> = rows(&card, &mut cx)
+        .into_iter()
+        .map(|group| group.session_id)
+        .collect();
+    assert_eq!(
+        order,
+        vec![
+            session_of(&running, &cx),
+            session_of(&ended_last, &cx),
+            session_of(&ended_first, &cx),
+        ]
+    );
+}
+
+// ---- R1.2 -------------------------------------------------------------------------
+
+#[gpui::test]
+async fn test_rows_carry_thread_title_project_and_task_fields(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Bump the series", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("fg", "running", false, 1_000),
+            wire_task("bg", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+
+    let card = card(&panel, &cx);
+    let groups = rows(&card, &mut cx);
+    let group = &groups[0];
+    assert_eq!(group.title.as_ref(), "Bump the series");
+    assert_eq!(group.project.as_ref(), "project");
+    let fg = group
+        .rows
+        .iter()
+        .find(|r| r.task.id.as_ref() == "fg")
+        .unwrap();
+    let bg = group
+        .rows
+        .iter()
+        .find(|r| r.task.id.as_ref() == "bg")
+        .unwrap();
+    assert_eq!(fg.task.kind.to_string(), "shell");
+    assert_eq!(fg.task.description.to_string(), "Task fg");
+    assert!(!fg.task.background);
+    assert!(bg.task.background);
+    assert_eq!(fg.task.status, AgentTaskStatus::Running);
+}
+
+// ---- R1.1 / R1.7 / R1.6 -------------------------------------------------------------
+
+#[gpui::test]
+async fn test_card_visible_only_while_a_task_runs_or_an_ended_row_shows(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let card = card(&panel, &cx);
+    assert!(!visible(&card, &mut cx), "no task, no card");
+
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    assert!(visible(&card, &mut cx));
+
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    assert!(visible(&card, &mut cx), "an ended row keeps the card up");
+
+    advance(&mut cx, Duration::from_secs(11));
+    assert!(
+        !visible(&card, &mut cx),
+        "nothing running and nothing on show"
+    );
+}
+
+#[gpui::test]
+async fn test_ended_row_shows_its_final_status_for_ten_seconds_then_goes(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let sid = session_of(&a, &cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "running", true, 1_000),
+            wire_task("t2", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "failed", true, 1_000),
+            wire_task("t2", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+    let card = card(&panel, &cx);
+    let ended = find_row(&card, &sid, "t1", &mut cx).expect("the ended row is still listed");
+    assert_eq!(ended.task.status, AgentTaskStatus::Failed);
+
+    // Hostile half: the adapter drops the ended task from the next snapshot; the
+    // row must not vanish before its 10 s are up.
+    send_tasks(&a, vec![wire_task("t2", "running", true, 2_000)], &mut cx);
+    advance(&mut cx, Duration::from_secs(9));
+    assert!(
+        find_row(&card, &sid, "t1", &mut cx).is_some(),
+        "still on show at 9 s"
+    );
+
+    advance(&mut cx, Duration::from_secs(2));
+    assert!(
+        find_row(&card, &sid, "t1", &mut cx).is_none(),
+        "gone after 10 s"
+    );
+    // The running neighbour is untouched by the expiry.
+    assert!(find_row(&card, &sid, "t2", &mut cx).is_some());
+}
+
+// ---- R1.8 -------------------------------------------------------------------------
+
+#[gpui::test]
+async fn test_closing_a_thread_removes_its_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let card = card(&panel, &cx);
+    assert_eq!(rows(&card, &mut cx).len(), 2);
+
+    // The panel now holds only B.
+    let b_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&b_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+
+    let groups = rows(&card, &mut cx);
+    assert_eq!(groups.len(), 1);
+    assert_eq!(groups[0].session_id, session_of(&b, &cx));
+
+    // And A's later snapshots no longer reach the card.
+    send_tasks(&a, vec![wire_task("t9", "running", true, 3_000)], &mut cx);
+    assert_eq!(rows(&card, &mut cx).len(), 1);
+}
+
+// ---- R3.1 / R3.3 ------------------------------------------------------------------
+
+/// Hostile half first: watching task `t1` of thread A must not watch task `t1` of
+/// thread B — the watch key is the pair (session, task), not the task id.
+#[gpui::test]
+async fn test_watch_is_keyed_by_thread_and_task(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let (sa, sb) = (session_of(&a, &cx), session_of(&b, &cx));
+    let card = card(&panel, &cx);
+
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), id.clone(), cx)
+    });
+    assert!(find_row(&card, &sa, "t1", &mut cx).unwrap().watched);
+    assert!(!find_row(&card, &sb, "t1", &mut cx).unwrap().watched);
+
+    // Toggling again unmarks it.
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), id.clone(), cx)
+    });
+    assert!(!find_row(&card, &sa, "t1", &mut cx).unwrap().watched);
+}
+
+#[gpui::test]
+async fn test_a_new_card_starts_with_nothing_watched(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let old = card(&panel, &cx);
+    let id = find_row(&old, &sa, "t1", &mut cx).unwrap().task.id;
+    old.update(&mut cx, |card, cx| card.toggle_watch(sa.clone(), id, cx));
+
+    // A fresh card (what a Zeo restart builds) shares nothing with the old one.
+    let a_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    let fresh = cx.update(|_, cx| cx.new(|cx| TasksCard::new(cx)));
+    fresh.update(&mut cx, |card, cx| {
+        card.sync_threads([&a_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+    let row = find_row(&fresh, &sa, "t1", &mut cx).expect("the fresh card lists the task");
+    assert!(!row.watched);
+    assert!(!fresh.read_with(&cx, |card, _| card.is_minimized()));
+}
+
+// ---- R2.5 -------------------------------------------------------------------------
+
+/// The minimized state is the session's, not the visibility's: the card hiding
+/// (nothing running) and showing again must not reset it.
+#[gpui::test]
+async fn test_minimized_state_survives_the_card_hiding_and_showing(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    assert!(card.read_with(&cx, |card, _| card.is_minimized()));
+
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    advance(&mut cx, Duration::from_secs(11));
+    assert!(!visible(&card, &mut cx));
+
+    send_tasks(&a, vec![wire_task("t2", "running", true, 20_000)], &mut cx);
+    assert!(visible(&card, &mut cx));
+    assert!(
+        card.read_with(&cx, |card, _| card.is_minimized()),
+        "still minimized"
+    );
+}
+
+// ---- the card keeps its model while not painting -------------------------------------
+
+/// Disabled, hidden or minimized only stops painting: threads keep syncing and
+/// endings keep landing, so the moment the card shows again (and story 014's
+/// history) it is current.
+#[gpui::test]
+async fn test_card_keeps_syncing_while_disabled_or_minimized(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    // The card exists before any thread, created with the panel.
+    let card = card(&panel, &cx);
+    assert!(rows(&card, &mut cx).is_empty());
+
+    cx.update(|_, cx| {
+        AgentSettings::override_global(
+            AgentSettings {
+                tasks_card: TasksCardSettings {
+                    enabled: false,
+                    position: TasksCardPosition::TopRight,
+                },
+                ..AgentSettings::get_global(cx).clone()
+            },
+            cx,
+        );
+    });
+    let connection = TaskActionsConnection::new();
+    // A thread opened while disabled is still synced.
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    assert!(!visible(&card, &mut cx), "disabled: nothing is shown");
+    assert!(
+        find_row(&card, &sa, "t1", &mut cx).is_some(),
+        "but the row is known"
+    );
+
+    // Minimized: an ending still lands as an ended row.
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    send_tasks(&a, vec![wire_task("t1", "failed", true, 1_000)], &mut cx);
+    let row = find_row(&card, &sa, "t1", &mut cx).expect("the ending was received");
+    assert_eq!(row.task.status, AgentTaskStatus::Failed);
+}
diff --git a/crates/agent_ui/src/tasks_card/open_tests.rs b/crates/agent_ui/src/tasks_card/open_tests.rs
new file mode 100644
index 0000000..3eea8da
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/open_tests.rs
@@ -0,0 +1,169 @@
+// Story 013 / task 5.3 — open the thread at the task's tool call (R4.6).
+// Filter: `tasks_card::open`.
+
+use acp_thread::{AcpThread, AgentThreadEntry};
+use agent_client_protocol::schema::v1 as acp;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::test_helpers::*;
+use crate::test_support::active_session_id;
+
+/// Fills `thread` with alternating user/agent messages around the tool call
+/// `toolu_t1`, so scrolling to it moves the list.
+fn fill_with_entries(thread: &Entity<AcpThread>, cx: &mut VisualTestContext) {
+    thread.update(cx, |thread, cx| {
+        let mut push = |update: acp::SessionUpdate| {
+            thread
+                .handle_session_update(update, cx)
+                .expect("entry applies");
+        };
+        for i in 0..20 {
+            push(acp::SessionUpdate::UserMessageChunk(
+                acp::ContentChunk::new(format!("question {i}").into()),
+            ));
+            push(acp::SessionUpdate::AgentMessageChunk(
+                acp::ContentChunk::new(format!("answer {i}").into()),
+            ));
+        }
+        push(acp::SessionUpdate::ToolCall(acp::ToolCall::new(
+            "toolu_t1",
+            "Run the suite",
+        )));
+        for i in 20..40 {
+            push(acp::SessionUpdate::UserMessageChunk(
+                acp::ContentChunk::new(format!("question {i}").into()),
+            ));
+            push(acp::SessionUpdate::AgentMessageChunk(
+                acp::ContentChunk::new(format!("answer {i}").into()),
+            ));
+        }
+    });
+    cx.run_until_parked();
+}
+
+fn tool_call_index(thread: &Entity<AcpThread>, id: &str, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .position(|entry| matches!(entry, AgentThreadEntry::ToolCall(call) if call.id.to_string() == id))
+            .expect("the tool call is an entry")
+    })
+}
+
+fn scroll_top(panel: &Entity<crate::AgentPanel>, cx: &mut VisualTestContext) -> usize {
+    let view = panel.read_with(cx, |panel, cx| panel.active_thread_view(cx).unwrap());
+    view.read_with(cx, |view, _| view.list_state.logical_scroll_top().item_ix)
+}
+
+/// Hostile half first: with another thread in front, opening A's task must bring
+/// A forward — not leave the active thread in place.
+#[gpui::test]
+async fn test_open_task_brings_its_thread_forward(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let (sa, sb) = (session_of(&a, &cx), session_of(&b, &cx));
+    assert_eq!(active_session_id(&panel, &cx), sb);
+
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_task(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(active_session_id(&panel, &cx), sa);
+}
+
+#[gpui::test]
+async fn test_open_task_scrolls_to_the_tool_call_that_started_it(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    fill_with_entries(&a, &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let expected = tool_call_index(&a, "toolu_t1", &cx);
+    assert!(expected > 0);
+
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_task(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(scroll_top(&panel, &mut cx), expected);
+}
+
+/// A nested subagent's task whose tool call is not among the root thread's
+/// entries opens the thread only — no scroll to a wrong entry, no panic.
+#[gpui::test]
+async fn test_open_task_without_a_root_tool_call_opens_the_thread_only(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    fill_with_entries(&a, &mut cx);
+    let mut nested = wire_task("n1", "running", true, 1_000);
+    nested["toolCallId"] = json!("toolu_not_in_root");
+    nested["type"] = json!("subagent");
+    nested["depth"] = json!(1);
+    send_tasks(&a, vec![nested], &mut cx);
+    let sa = session_of(&a, &cx);
+    let _b = open_titled_thread(&panel, &connection, "B", &mut cx);
+
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "n1", &mut cx).unwrap().task.id;
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_task(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(active_session_id(&panel, &cx), sa);
+    let toolu_t1 = tool_call_index(&a, "toolu_t1", &cx);
+    assert_ne!(
+        scroll_top(&panel, &mut cx),
+        toolu_t1,
+        "no scroll to an unrelated tool call"
+    );
+}
+
+/// A failed open shows its error on the row. Injection: the row belongs to a thread
+/// held by a SECOND panel (same workspace, never docked) that this panel's card was
+/// synced to; this panel cannot open that session (its agent is not registered
+/// here), so `open_task` fails. If the implementation makes this injection succeed,
+/// change the injection, not the assertion.
+#[gpui::test]
+async fn test_a_failed_open_shows_its_error_on_the_row(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let other = workspace.update_in(&mut cx, |workspace, window, cx| {
+        cx.new(|cx| crate::AgentPanel::new(workspace, window, cx))
+    });
+    let connection = TaskActionsConnection::new();
+    let foreign = open_titled_thread(&other, &connection, "Elsewhere", &mut cx);
+    send_tasks(
+        &foreign,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    let sf = session_of(&foreign, &cx);
+    let foreign_view = other.read_with(&cx, |other, _| {
+        other.active_conversation_view().cloned().unwrap()
+    });
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&foreign_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+    let id = find_row(&card, &sf, "t1", &mut cx).unwrap().task.id;
+    card.update_in(&mut cx, |card, window, cx| {
+        card.open_task(sf.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+
+    let row = find_row(&card, &sf, "t1", &mut cx).expect("the row stays listed");
+    assert!(row.error.is_some(), "the failed open reaches the row");
+}
diff --git a/crates/agent_ui/src/tasks_card/panel_close_tests.rs b/crates/agent_ui/src/tasks_card/panel_close_tests.rs
new file mode 100644
index 0000000..2c4f9cd
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/panel_close_tests.rs
@@ -0,0 +1,86 @@
+// Story 013 / task 3.2 review — R1.8 through the panel's own close paths, not a
+// hand-made `sync_threads` call. Filter: `tasks_card::panel_close`.
+
+use gpui::TestAppContext;
+
+use super::test_helpers::*;
+use crate::thread_metadata_store::ThreadMetadataStore;
+
+/// Opens A then B, each with a running task; B ends up active and A retained.
+///
+/// The threads are returned strong and must be held to the end of the test: a
+/// released thread already drops out of `rows()` through its dead weak handle,
+/// which would let a missing sync pass unnoticed. Something else holding a closed
+/// thread (its connection's session map) is the case the sync exists for.
+async fn two_threads_with_tasks(
+    cx: &mut TestAppContext,
+) -> (
+    gpui::Entity<crate::AgentPanel>,
+    gpui::VisualTestContext,
+    crate::thread_metadata_store::ThreadId,
+    [gpui::Entity<acp_thread::AcpThread>; 2],
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let a_thread_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let card = card(&panel, &cx);
+    assert_eq!(rows(&card, &mut cx).len(), 2, "both threads listed first");
+    (panel, cx, a_thread_id, [a, b])
+}
+
+fn sessions(
+    panel: &gpui::Entity<crate::AgentPanel>,
+    cx: &mut gpui::VisualTestContext,
+) -> Vec<agent_client_protocol::schema::v2::SessionId> {
+    let card = card(panel, cx);
+    rows(&card, cx)
+        .into_iter()
+        .map(|group| group.session_id)
+        .collect()
+}
+
+#[gpui::test]
+async fn test_removing_a_retained_thread_from_the_panel_removes_its_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx, a_thread_id, [a, b]) = two_threads_with_tasks(cx).await;
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.remove_thread(a_thread_id, window, cx)
+    });
+    cx.run_until_parked();
+
+    assert_eq!(sessions(&panel, &mut cx), vec![session_of(&b, &cx)]);
+    // And A's later snapshots no longer reach the card.
+    send_tasks(&a, vec![wire_task("t9", "running", true, 3_000)], &mut cx);
+    assert_eq!(sessions(&panel, &mut cx), vec![session_of(&b, &cx)]);
+}
+
+#[gpui::test]
+async fn test_archiving_a_retained_thread_removes_its_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx, a_thread_id, [a, b]) = two_threads_with_tasks(cx).await;
+
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(a_thread_id, None, cx))
+    });
+    cx.run_until_parked();
+
+    assert_eq!(sessions(&panel, &mut cx), vec![session_of(&b, &cx)]);
+    drop(a);
+}
+
+#[gpui::test]
+async fn test_removing_the_active_thread_from_the_panel_removes_its_rows(cx: &mut TestAppContext) {
+    let (panel, mut cx, _a_thread_id, [a, b]) = two_threads_with_tasks(cx).await;
+    let b_thread_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.remove_thread(b_thread_id, window, cx)
+    });
+    cx.run_until_parked();
+
+    assert_eq!(sessions(&panel, &mut cx), vec![session_of(&a, &cx)]);
+    drop(b);
+}
diff --git a/crates/agent_ui/src/tasks_card/placement_tests.rs b/crates/agent_ui/src/tasks_card/placement_tests.rs
new file mode 100644
index 0000000..96d03f4
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/placement_tests.rs
@@ -0,0 +1,167 @@
+// Story 013 / task 4.1, review fixes — where the card may sit: inside the agent
+// panel however small it is, and clear of the toolbar above and the message
+// editor below. Filter: `tasks_card::placement`.
+
+use agent_client_protocol::schema::v1 as acp;
+use agent_settings::{AgentSettings, TasksCardSettings};
+use gpui::{Bounds, Pixels, TestAppContext, VisualTestContext, px, size};
+use settings::{Settings as _, TasksCardPosition};
+use workspace::dock::PanelSizeState;
+
+use super::test_helpers::*;
+use crate::AgentPanel;
+
+const ALL_CORNERS: [TasksCardPosition; 4] = [
+    TasksCardPosition::TopRight,
+    TasksCardPosition::TopLeft,
+    TasksCardPosition::BottomRight,
+    TasksCardPosition::BottomLeft,
+];
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn set_position(position: TasksCardPosition, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        AgentSettings::override_global(
+            AgentSettings {
+                tasks_card: TasksCardSettings {
+                    enabled: true,
+                    position,
+                },
+                ..AgentSettings::get_global(cx).clone()
+            },
+            cx,
+        );
+    });
+    draw(cx);
+}
+
+fn contains(outer: Bounds<Pixels>, inner: Bounds<Pixels>) -> bool {
+    inner.left() >= outer.left()
+        && inner.right() <= outer.right()
+        && inner.top() >= outer.top()
+        && inner.bottom() <= outer.bottom()
+}
+
+fn many_running_tasks() -> Vec<serde_json::Value> {
+    (0..12)
+        .map(|ix| wire_task(&format!("t{ix}"), "running", true, 1_000 + ix))
+        .collect()
+}
+
+/// A narrow, short panel: the card shrinks to it — narrower than its usual width,
+/// its list scrolling — instead of spilling over the editor or the status bar.
+#[gpui::test]
+async fn test_the_card_stays_inside_a_small_panel(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    // The dock keeps its width share of a wide window, so the window itself is
+    // made narrow as well as short.
+    cx.simulate_resize(size(px(300.), px(260.)));
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.set_panel_size_state::<AgentPanel>(
+            PanelSizeState {
+                size: Some(px(240.)),
+                flex: None,
+            },
+            window,
+            cx,
+        );
+    });
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, many_running_tasks(), &mut cx);
+    draw(&mut cx);
+
+    let panel_bounds = cx.debug_bounds("agent-panel").expect("panel painted");
+    assert!(
+        panel_bounds.size.width < px(300.),
+        "the panel is narrower than the card's usual width: {panel_bounds:?}"
+    );
+    for position in ALL_CORNERS {
+        set_position(position, &mut cx);
+        let card = cx.debug_bounds("tasks-card").expect("card painted");
+        assert!(
+            contains(panel_bounds, card),
+            "{position:?}: card {card:?} outside the panel {panel_bounds:?}"
+        );
+    }
+}
+
+/// The free area of an empty thread is the editor's text area: the bottom
+/// corners stay above the editor's controls, the top corners below the toolbar.
+#[gpui::test]
+async fn test_the_card_keeps_clear_of_the_toolbar_and_the_message_editor(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let panel_bounds = cx.debug_bounds("agent-panel").expect("panel painted");
+    let toolbar_height = cx.update(|_, cx| ui::Tab::container_height(cx));
+    let editor = panel.read_with(&cx, |panel, cx| {
+        panel
+            .active_thread_view(cx)
+            .and_then(|view| {
+                view.read(cx)
+                    .message_editor
+                    .read(cx)
+                    .editor()
+                    .read(cx)
+                    .last_bounds()
+                    .copied()
+            })
+            .expect("the message editor was painted")
+    });
+    for position in ALL_CORNERS {
+        set_position(position, &mut cx);
+        let card = cx.debug_bounds("tasks-card").expect("card painted");
+        assert!(
+            card.bottom() <= editor.bottom(),
+            "{position:?}: card {card:?} reaches below the editor's text {editor:?}"
+        );
+        assert!(
+            card.top() >= panel_bounds.top() + toolbar_height,
+            "{position:?}: card {card:?} covers the toolbar"
+        );
+    }
+}
+
+/// With a conversation on screen, the card sits over the conversation's entries
+/// only — not over the editor or the callouts under them.
+#[gpui::test]
+async fn test_the_card_sits_over_the_conversation(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    a.update(&mut cx, |thread, cx| {
+        thread.handle_session_update(
+            acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(
+                "a response long enough to be an entry".into(),
+            )),
+            cx,
+        )
+    })
+    .expect("the agent message applies");
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let viewport = panel.read_with(&cx, |panel, cx| {
+        let view = panel.active_thread_view(cx).expect("a thread view");
+        let view = view.read(cx);
+        assert!(view.list_state.item_count() > 0, "the thread has an entry");
+        view.list_state.viewport_bounds()
+    });
+    assert!(!viewport.is_empty(), "the conversation was laid out");
+    for position in ALL_CORNERS {
+        set_position(position, &mut cx);
+        let card = cx.debug_bounds("tasks-card").expect("card painted");
+        assert!(
+            contains(viewport, card),
+            "{position:?}: card {card:?} outside the conversation {viewport:?}"
+        );
+    }
+}
