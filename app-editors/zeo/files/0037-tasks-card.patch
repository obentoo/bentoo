+    /// Marks or unmarks one thread's task as watched (R3.1).
+    pub fn toggle_watch(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        task_id: AgentTaskId,
+        cx: &mut Context<Self>,
+    ) {
+        let key = (session_id, task_id);
+        if !self.watched.remove(&key) {
+            self.watched.insert(key);
+        }
+        cx.notify();
+    }
+
+    /// Asks before stopping one thread's running task, naming it, and stops it only
+    /// on an explicit Stop (R4.1, R4.2). A prompt dropped unanswered — its window
+    /// closed — is a Cancel, never a Stop.
+    pub fn request_stop(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        task_id: AgentTaskId,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let key = (session_id, task_id);
+        let Some(description) = self
+            .running_task(&key, cx)
+            .map(|task| task.description.clone())
+        else {
+            log::debug!(
+                "tasks card: stop requested for task {} of session {}, which is not running",
+                key.1,
+                key.0
+            );
+            return;
+        };
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            "Stop this task?",
+            Some(description.as_ref()),
+            &["Stop", "Cancel"],
+            cx,
+        );
+        cx.spawn(async move |card, cx| {
+            // Index 0 is "Stop"; `Err` is a prompt whose sender was dropped.
+            if !matches!(answer.await, Ok(0)) {
+                return;
+            }
+            card.update(cx, |card, cx| card.stop(key, cx)).ok();
+        })
+        .detach();
+    }
+
+    /// Sends the stop for a confirmed task, unless it ended while the prompt was
+    /// open: that race is not the user's error, so it sends nothing and shows none.
+    fn stop(&mut self, key: TaskKey, cx: &mut Context<Self>) {
+        let Some(thread) = self.thread_running(&key, cx) else {
+            log::debug!(
+                "tasks card: task {} of session {} ended before its stop was confirmed; \
+                 nothing sent",
+                key.1,
+                key.0
+            );
+            return;
+        };
+        let request = thread.update(cx, |thread, cx| thread.stop_task(key.1.as_ref(), cx));
+        cx.spawn(async move |card, cx| {
+            let Err(error) = request.await else {
+                return;
+            };
+            // The agent's own text sits under the connection's context, so the
+            // whole chain is what both the check and the row read.
+            let message = format!("{error:#}");
+            let (session_id, task_id) = &key;
+            if message.contains("is not running") {
+                log::debug!(
+                    "tasks card: task {task_id} of session {session_id} was no longer \
+                     running when its stop arrived: {message}"
+                );
+                return;
+            }
+            log::error!(
+                "tasks card: stopping task {task_id} of session {session_id} failed: {message}"
+            );
+            card.update(cx, |card, cx| card.set_row_error(key, message.into(), cx))
+                .ok();
+        })
+        .detach();
+    }
+
+    /// Moves one thread's foreground task to the background (R4.5). It asks
+    /// nothing first: the task keeps running, so no work is lost. An error, or an
+    /// answer that nothing moved, is shown on the row (R4.7).
+    pub fn send_to_background(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        task_id: AgentTaskId,
+        cx: &mut Context<Self>,
+    ) {
+        let key = (session_id, task_id);
+        let tool_call_id = self
+            .running_task(&key, cx)
+            .and_then(background_target)
+            .cloned();
+        let (Some(tool_call_id), Some(thread)) = (tool_call_id, self.thread_running(&key, cx))
+        else {
+            log::debug!(
+                "tasks card: background requested for task {} of session {}, which is not \
+                 a running foreground task with a tool call; nothing sent",
+                key.1,
+                key.0
+            );
+            return;
+        };
+        let request = thread.update(cx, |thread, cx| {
+            thread.background_task(tool_call_id.0.as_ref(), cx)
+        });
+        cx.spawn(async move |card, cx| {
+            let (session_id, task_id) = &key;
+            let message: SharedString = match request.await {
+                Ok(true) => return,
+                Ok(false) => {
+                    log::warn!(
+                        "tasks card: sending task {task_id} of session {session_id} \
+                         (tool call {tool_call_id}) to the background moved nothing"
+                    );
+                    "Nothing was moved to the background".into()
+                }
+                Err(error) => {
+                    // As for a stop: the agent's own text sits under the
+                    // connection's context, so the row shows the whole chain.
+                    let message = format!("{error:#}");
+                    log::error!(
+                        "tasks card: sending task {task_id} of session {session_id} \
+                         (tool call {tool_call_id}) to the background failed: {message}"
+                    );
+                    message.into()
+                }
+            };
+            card.update(cx, |card, cx| card.set_row_error(key, message, cx))
+                .ok();
+        })
+        .detach();
+    }
+
+    /// Asks the hosting panel to open one thread's task at the tool call that
+    /// started it (R4.6). An ended row still on show opens the same way.
+    pub fn open_task(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        task_id: AgentTaskId,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let key = (session_id, task_id);
+        let tool_call_id = self
+            .task_on_show(&key, cx)
+            .and_then(|task| task.tool_call_id.clone());
+        self.emit_open(key, tool_call_id, cx);
+    }
+
+    /// Opens a group's thread at its oldest running task's tool call, or just
+    /// opens it when no running task has one. A failure shows on the row whose
+    /// task was targeted — the oldest running, else the oldest on show.
+    fn open_group(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let rows = self
+            .rows(cx)
+            .into_iter()
+            .find(|group| group.session_id == session_id)
+            .map(|group| group.rows)
+            .unwrap_or_default();
+        let running = || rows.iter().filter(|row| row.task.status.is_running());
+        if let Some(row) = running().find(|row| row.task.tool_call_id.is_some()) {
+            let task_id = row.task.id.clone();
+            self.open_task(session_id, task_id, window, cx);
+            return;
+        }
+        let Some(row) = running().next().or_else(|| rows.first()) else {
+            log::debug!(
+                "tasks card: open requested for the group of session {session_id}, which \
+                 has no row on show"
+            );
+            return;
+        };
+        let key = (session_id, row.task.id.clone());
+        self.emit_open(key, None, cx);
+    }
+
+    fn emit_open(
+        &mut self,
+        (session_id, task_id): TaskKey,
+        tool_call_id: Option<acp_v2::ToolCallId>,
+        cx: &mut Context<Self>,
+    ) {
+        cx.emit(TasksCardEvent::OpenTask {
+            session_id,
+            task_id,
+            tool_call_id,
+        });
+    }
+
+    /// Shows `message` on a row until a snapshot changes its task (R4.3, R4.7).
+    pub(crate) fn set_row_error(
+        &mut self,
+        key: TaskKey,
+        message: SharedString,
+        cx: &mut Context<Self>,
+    ) {
+        let task = self.current_task(&key, cx).cloned();
+        self.row_errors.insert(key, RowError { message, task });
+        cx.notify();
+    }
+
+    fn row(&self, session_id: &acp_v2::SessionId, task: AgentTask) -> TaskRow {
+        let key = (session_id.clone(), task.id.clone());
+        TaskRow {
+            watched: self.watched.contains(&key),
+            error: self.row_errors.get(&key).map(|error| error.message.clone()),
+            task,
+        }
+    }
+
+    fn hold_view(view: &Entity<ConversationView>, cx: &mut Context<Self>) -> HeldView {
+        let view_id = view.entity_id();
+        let thread = view
+            .read(cx)
+            .root_thread(cx)
+            .map(|thread| Self::hold_thread(&thread, cx));
+        let _observation = cx.observe(view, move |card, view, cx| {
+            card.refresh_view(view_id, &view, cx);
+        });
+        HeldView {
+            view_id,
+            thread,
+            _observation,
+        }
+    }
+
+    fn hold_thread(thread: &Entity<AcpThread>, cx: &mut Context<Self>) -> HeldThread {
+        let _subscription = cx.subscribe(thread, |card, thread, event, cx| match event {
+            AcpThreadEvent::TasksUpdated => card.handle_tasks_updated(&thread, cx),
+            AcpThreadEvent::TaskEnded { task_id, .. } => {
+                card.handle_task_ended(&thread, task_id, cx)
+            }
+            AcpThreadEvent::TitleUpdated => cx.notify(),
+            _ => {}
+        });
+        HeldThread {
+            thread: thread.downgrade(),
+            thread_id: thread.entity_id(),
+            session_id: thread.read(cx).session_id().clone(),
+            _subscription,
+        }
+    }
+
+    /// A held view changed: subscribe to its root thread if it now has a new one.
+    fn refresh_view(
+        &mut self,
+        view_id: EntityId,
+        view: &Entity<ConversationView>,
+        cx: &mut Context<Self>,
+    ) {
+        // A view between threads (loading again) keeps the last one: its weak
+        // handle tells whether it is still alive.
+        let Some(root) = view.read(cx).root_thread(cx) else {
+            return;
+        };
+        let Some(held) = self.views.iter_mut().find(|held| held.view_id == view_id) else {
+            return;
+        };
+        if held
+            .thread
+            .as_ref()
+            .is_some_and(|held| held.thread_id == root.entity_id())
+        {
+            return;
+        }
+        held.thread = Some(Self::hold_thread(&root, cx));
+        self.forget_unheld_sessions(cx);
+        self.update_tick(cx);
+        cx.notify();
+    }
+
+    fn handle_tasks_updated(&mut self, thread: &Entity<AcpThread>, cx: &mut Context<Self>) {
+        let thread = thread.read(cx);
+        let session_id = thread.session_id();
+        let tasks = thread.tasks();
+        // A task that runs again under its old id (a resumed subagent) is no longer
+        // ended; one the adapter still lists ended keeps its newest copy.
+        self.ended.retain(|(ended_session, task_id), ended| {
+            if ended_session != session_id {
+                return true;
+            }
+            match tasks.iter().find(|task| &task.id == task_id) {
+                Some(task) if task.status.is_running() => false,
+                Some(task) => {
+                    ended.task = task.clone();
+                    true
+                }
+                None => true,
+            }
+        });
+        // A snapshot that changes a task with an error on its row — a new status,
+        // new progress, or the task gone — clears that error.
+        self.row_errors.retain(|(error_session, task_id), error| {
+            error_session != session_id
+                || tasks.iter().find(|task| &task.id == task_id) == error.task.as_ref()
+        });
+        // A background task can run for minutes between snapshots, so a snapshot
+        // re-arms the tick as well as expanding the card does.
+        self.update_tick(cx);
+        cx.notify();
+    }
+
+    fn handle_task_ended(
+        &mut self,
+        thread: &Entity<AcpThread>,
+        task_id: &AgentTaskId,
+        cx: &mut Context<Self>,
+    ) {
+        let thread = thread.read(cx);
+        let session_id = thread.session_id().clone();
+        let Some(task) = thread
+            .tasks()
+            .iter()
+            .find(|task| &task.id == task_id)
+            .cloned()
+        else {
+            log::debug!(
+                "tasks card: ended task {task_id} is not in the snapshot of session {session_id}; \
+                 no ended row shown"
+            );
+            return;
+        };
+        let now = cx.background_executor().now();
+        self.endings_seen += 1;
+        self.ended.insert(
+            (session_id, task.id.clone()),
+            EndedRow {
+                task,
+                expires_at: now.checked_add(ENDED_ROW_TTL).unwrap_or(now),
+                sequence: self.endings_seen,
+            },
+        );
+        self.schedule_expiry(cx);
+        cx.notify();
+    }
+
+    /// Keeps one wake pending, at the earliest expiry; none when nothing is ended.
+    fn schedule_expiry(&mut self, cx: &mut Context<Self>) {
+        let Some(earliest) = self.ended.values().map(|ended| ended.expires_at).min() else {
+            self._expiry = None;
+            return;
+        };
+        let delay = earliest.saturating_duration_since(cx.background_executor().now());
+        self._expiry = Some(cx.spawn(async move |card, cx| {
+            cx.background_executor().timer(delay).await;
+            card.update(cx, |card, cx| card.expire_ended_rows(cx)).ok();
+        }));
+    }
+
+    fn expire_ended_rows(&mut self, cx: &mut Context<Self>) {
+        let now = cx.background_executor().now();
+        let expired: Vec<TaskKey> = self
+            .ended
+            .iter()
+            .filter(|(_, ended)| ended.expires_at <= now)
+            .map(|(key, _)| key.clone())
+            .collect();
+        for key in expired {
+            self.ended.remove(&key);
+            // A task that went back to running keeps its watch and its error.
+            if !self.is_running(&key, cx) {
+                self.watched.remove(&key);
+                self.row_errors.remove(&key);
+            }
+        }
+        self.schedule_expiry(cx);
+        cx.notify();
+    }
+
+    /// Arms the elapsed-time tick when it should run and is not running yet, and
+    /// drops it when it should not run.
+    fn update_tick(&mut self, cx: &mut Context<Self>) {
+        if !self.should_tick(cx) {
+            self._tick = None;
+            return;
+        }
+        if self._tick.is_some() {
+            return;
+        }
+        self._tick = Some(cx.spawn(async move |card, cx| {
+            loop {
+                cx.background_executor().timer(ELAPSED_TICK).await;
+                let ticking = card.update(cx, |card, cx| {
+                    if card.should_tick(cx) {
+                        cx.notify();
+                        true
+                    } else {
+                        // Minimized, disabled or idle since the last wake: stop, and
+                        // leave the slot empty so the next expand or snapshot re-arms.
+                        card._tick = None;
+                        false
+                    }
+                });
+                if !matches!(ticking, Ok(true)) {
+                    break;
+                }
+            }
+        }));
+    }
+
+    fn should_tick(&self, cx: &App) -> bool {
+        !self.minimized && AgentSettings::get_global(cx).tasks_card.enabled && self.any_running(cx)
+    }
+
+    fn any_running(&self, cx: &App) -> bool {
+        self.held_threads()
+            .filter_map(|held| held.thread.upgrade())
+            .any(|thread| {
+                thread
+                    .read(cx)
+                    .tasks()
+                    .iter()
+                    .any(|task| task.status.is_running())
+            })
+    }
+
+    fn held_threads(&self) -> impl Iterator<Item = &HeldThread> {
+        self.views.iter().filter_map(|held| held.thread.as_ref())
+    }
+
+    fn is_running(&self, key: &TaskKey, cx: &App) -> bool {
+        self.thread_running(key, cx).is_some()
+    }
+
+    /// The held thread in which the task is running, if it is.
+    fn thread_running(
+        &self,
+        (session_id, task_id): &TaskKey,
+        cx: &App,
+    ) -> Option<Entity<AcpThread>> {
+        self.held_threads()
+            .filter(|held| &held.session_id == session_id)
+            .filter_map(|held| held.thread.upgrade())
+            .find(|thread| {
+                thread
+                    .read(cx)
+                    .tasks()
+                    .iter()
+                    .any(|task| &task.id == task_id && task.status.is_running())
+            })
+    }
+
+    fn running_task<'a>(&self, key: &TaskKey, cx: &'a App) -> Option<&'a AgentTask> {
+        self.current_task(key, cx)
+            .filter(|task| task.status.is_running())
+    }
+
+    /// The task as its thread holds it now, else the final copy of an ended row
+    /// the adapter has already dropped from its snapshot.
+    fn task_on_show<'a>(&'a self, key: &TaskKey, cx: &'a App) -> Option<&'a AgentTask> {
+        self.current_task(key, cx)
+            .or_else(|| self.ended.get(key).map(|ended| &ended.task))
+    }
+
+    /// The task as its thread holds it now, whatever its status.
+    fn current_task<'a>(
+        &self,
+        (session_id, task_id): &TaskKey,
+        cx: &'a App,
+    ) -> Option<&'a AgentTask> {
+        self.held_threads()
+            .filter(|held| &held.session_id == session_id)
+            .filter_map(|held| held.thread.upgrade())
+            .find_map(|thread| {
+                thread
+                    .read(cx)
+                    .tasks()
+                    .iter()
+                    .find(|task| &task.id == task_id)
+            })
+    }
+
+    /// Drops every piece of state that belongs to a thread the card no longer holds.
+    fn forget_unheld_sessions(&mut self, cx: &mut Context<Self>) {
+        let held: HashSet<acp_v2::SessionId> = self
+            .held_threads()
+            .map(|held| held.session_id.clone())
+            .collect();
+        self.ended
+            .retain(|(session_id, _), _| held.contains(session_id));
+        self.watched
+            .retain(|(session_id, _)| held.contains(session_id));
+        self.row_errors
+            .retain(|(session_id, _), _| held.contains(session_id));
+        self.schedule_expiry(cx);
+    }
+}
+
+impl Render for TasksCard {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let groups = self.rows(cx);
+        self.forget_focus_of_rows_gone(&groups);
+        // `AgentPanel` only hosts the card while it is visible; this keeps a stray
+        // render of a hidden or disabled card from painting anything either.
+        if !AgentSettings::get_global(cx).tasks_card.enabled || groups.is_empty() {
+            return gpui::Empty.into_any_element();
+        }
+        if self.is_minimized() {
+            return self.render_pill(running_count(&groups), cx);
+        }
+        self.render_expanded(groups, cx)
+    }
+}
