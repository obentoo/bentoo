+/// The tool call a "Send to Background" for `task` is addressed to; `None` when
+/// the task is already in the background or has no tool call to address (R4.4).
+fn background_target(task: &AgentTask) -> Option<&acp_v2::ToolCallId> {
+    task.tool_call_id.as_ref().filter(|_| !task.background)
+}
+
+/// A focus handle for one of the card's controls. An element given its own handle
+/// ignores its `tab_index` / `tab_stop` styling — GPUI applies those only to a
+/// handle it creates itself — so the handle carries them, or Tab never reaches it.
+fn control_focus_handle(cx: &mut App) -> FocusHandle {
+    cx.focus_handle().tab_stop(true).tab_index(0)
+}
+
+/// A text tooltip like `Tooltip::text`, whose text carries the debug selector
+/// `tasks-card-tooltip-{name}`, so tests can tell which control raised it (Q14).
+fn card_tooltip(
+    name: SharedString,
+    text: SharedString,
+) -> impl Fn(&mut Window, &mut App) -> AnyView {
+    move |_, cx| {
+        let name = name.clone();
+        let text = text.clone();
+        cx.new(|_| {
+            Tooltip::new_element(move |_, _| {
+                div()
+                    .debug_selector({
+                        let name = name.clone();
+                        move || format!("tasks-card-tooltip-{name}")
+                    })
+                    .child(text.clone())
+                    .into_any_element()
+            })
+        })
+        .into()
+    }
+}
