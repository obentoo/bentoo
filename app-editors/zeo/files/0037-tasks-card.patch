+    // An ended row still opens its thread.
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-open-t1").is_some());
+}
