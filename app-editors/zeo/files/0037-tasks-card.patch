+//! The tasks card: one floating list of the live tasks of every conversation the
+//! agent panel holds (story 013, patch `0037`).
+//!
+//! The card owns only the state that belongs to no thread — minimized, watched,
+//! ended rows still on show, per-row errors. The tasks themselves are read live
+//! from each root `AcpThread` (story 012's feed), so the card never holds a copy
+//! that could drift, except for an ended task, which the adapter may drop from its
+//! next snapshot while the card still has to show it for `ENDED_ROW_TTL`.
+//!
+//! Disabled, hidden or minimized only stops painting: the card keeps syncing
+//! threads and receiving their events in every state.
+
+use std::{
+    cmp::Reverse,
+    time::{Duration, Instant, SystemTime},
+};
+
+use acp_thread::{AcpThread, AcpThreadEvent, AgentTask, AgentTaskId, AgentTaskStatus};
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_settings::AgentSettings;
+use collections::{HashMap, HashSet};
+use gpui::{
+    AnyElement, AnyView, App, AvailableSpace, Bounds, Context, Element, Entity, EntityId,
+    EventEmitter, FocusHandle, GlobalElementId, InspectorElementId, LayoutId, Pixels, PromptLevel,
+    Render, SharedString, Style, Subscription, Task, WeakEntity, Window, point, size,
+};
+use settings::{Settings as _, SettingsStore, TasksCardPosition};
+use ui::{ButtonLike, Chip, CommonAnimationExt as _, Tooltip, prelude::*};
+
+use crate::DEFAULT_THREAD_TITLE;
+use crate::conversation_view::ConversationView;
+
+#[cfg(test)]
+mod test_helpers;
+
+#[cfg(test)]
+#[path = "tasks_card/model_tests.rs"]
+mod model;
+
+#[cfg(test)]
+#[path = "tasks_card/panel_close_tests.rs"]
+mod panel_close;
+
+#[cfg(test)]
+#[path = "tasks_card/render_tests.rs"]
+mod render;
+
+#[cfg(test)]
+#[path = "tasks_card/placement_tests.rs"]
+mod placement;
+
+#[cfg(test)]
+#[path = "tasks_card/accessibility_tests.rs"]
+mod accessibility;
+
+#[cfg(test)]
+#[path = "tasks_card/live_tests.rs"]
+mod live;
+
+#[cfg(test)]
+#[path = "tasks_card/stop_tests.rs"]
+mod stop;
+
+#[cfg(test)]
+#[path = "tasks_card/background_tests.rs"]
+mod background;
+
+#[cfg(test)]
+#[path = "tasks_card/row_error_tests.rs"]
+mod row_error;
+
+#[cfg(test)]
+#[path = "tasks_card/open_tests.rs"]
+mod open;
+
+#[cfg(test)]
+#[path = "tasks_card/group_open_tests.rs"]
+mod group_open;
+
+/// How long an ended task's final status stays on the card (R1.6).
+pub(crate) const ENDED_ROW_TTL: Duration = Duration::from_secs(10);
+
+/// How often a running row's elapsed time is repainted (R1.4).
+const ELAPSED_TICK: Duration = Duration::from_secs(1);
+
+/// A task is named by its thread and its id: two threads may run tasks with the
+/// same id, and the adapter only promises uniqueness within a session.
+pub(crate) type TaskKey = (acp::SessionId, AgentTaskId);
+
+/// What the card asks of the agent panel that hosts it. The card holds no handle
+/// to the panel — the panel owns the card — so it asks through an event the panel
+/// subscribes to, which also reaches exactly the panel that owns this card.
+#[derive(Clone, Debug)]
+pub enum TasksCardEvent {
+    /// Bring the task's thread forward and, when `tool_call_id` is given and the
+    /// root thread holds that tool call, scroll to it (R4.6). A failure comes back
+    /// through `set_row_error` on the task's row.
+    OpenTask {
+        session_id: acp_v2::SessionId,
+        task_id: AgentTaskId,
+        tool_call_id: Option<acp_v2::ToolCallId>,
+    },
+}
+
+impl EventEmitter<TasksCardEvent> for TasksCard {}
+
+/// The rows of one thread, as the card lists them.
+#[derive(Clone, Debug)]
+pub struct ThreadGroup {
+    pub session_id: acp_v2::SessionId,
+    pub title: SharedString,
+    /// The last component of the thread's first work directory, or empty.
+    pub project: SharedString,
+    pub rows: Vec<TaskRow>,
+}
+
+/// One task on the card: a running task, or an ended one still on show.
+#[derive(Clone, Debug)]
+pub struct TaskRow {
+    pub task: AgentTask,
+    pub watched: bool,
+    pub error: Option<SharedString>,
+}
+
+pub struct TasksCard {
+    /// One entry per conversation the panel holds, in the order it handed them over.
+    views: Vec<HeldView>,
+    /// Kept for the whole Zeo session, never persisted (R2.5).
+    minimized: bool,
+    /// In memory only, so a restart starts with nothing watched (R3.3).
+    watched: HashSet<TaskKey>,
+    /// The final copy of each task whose ending reached the card, until it expires.
+    ended: HashMap<TaskKey, EndedRow>,
+    /// The last stop or background error of a row (R4.3, R4.7).
+    row_errors: HashMap<TaskKey, RowError>,
+    /// Counts endings as they reach the card, to order ended-only groups.
+    endings_seen: u64,
+    /// The single wake scheduled at the earliest expiry of `ended`.
+    _expiry: Option<Task<()>>,
+    /// Repaints the elapsed times every second; only exists while the card is
+    /// expanded and enabled with a task running, so an idle card never wakes.
+    _tick: Option<Task<()>>,
+    /// Re-evaluates the tick when the card is enabled or disabled in settings.
+    _settings_observation: Subscription,
+    minimize_focus_handle: FocusHandle,
+    pill_focus_handle: FocusHandle,
+    /// One per control of each row on show, kept across renders so keyboard focus
+    /// survives a repaint (Q14); a row's handles go when the row does.
+    row_focus_handles: HashMap<(TaskKey, RowControl), FocusHandle>,
+    /// The same for each group header's Open control; it goes with its group.
+    group_focus_handles: HashMap<acp_v2::SessionId, FocusHandle>,
+}
+
+/// A per-row control that takes keyboard focus.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum RowControl {
+    Watch,
+    Stop,
+    Background,
+    Open,
+}
+
+/// An error shown on a row, with the task as it was when the error arrived: the
+/// error lasts until a snapshot changes that task.
+#[derive(Clone, Debug)]
+struct RowError {
+    message: SharedString,
+    task: Option<AgentTask>,
+}
+
+/// A conversation the panel holds. Its root thread may arrive after the view
+/// itself (a thread still loading), so the view is observed until it does.
+struct HeldView {
+    view_id: EntityId,
+    thread: Option<HeldThread>,
+    _observation: Subscription,
+}
+
+struct HeldThread {
+    thread: WeakEntity<AcpThread>,
+    thread_id: EntityId,
+    session_id: acp_v2::SessionId,
+    _subscription: Subscription,
+}
+
+#[derive(Clone, Debug)]
+struct EndedRow {
+    task: AgentTask,
+    expires_at: Instant,
+    /// Higher means the ending reached the card more recently.
+    sequence: u64,
+}
+
+/// Groups with a running task come first, oldest running task first; then the
+/// groups holding only ended rows, most recent ending first (R1.3).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum GroupOrder {
+    Running(SystemTime),
+    EndedOnly(Reverse<u64>),
+}
+
+impl TasksCard {
+    pub fn new(cx: &mut Context<Self>) -> Self {
+        Self {
+            views: Vec::new(),
+            minimized: false,
+            watched: HashSet::default(),
+            ended: HashMap::default(),
+            row_errors: HashMap::default(),
+            endings_seen: 0,
+            _expiry: None,
+            _tick: None,
+            _settings_observation: cx
+                .observe_global::<SettingsStore>(|card, cx| card.update_tick(cx)),
+            minimize_focus_handle: control_focus_handle(cx),
+            pill_focus_handle: control_focus_handle(cx),
+            row_focus_handles: HashMap::default(),
+            group_focus_handles: HashMap::default(),
+        }
+    }
+
+    /// Makes the card follow exactly `views`: new conversations are subscribed to,
+    /// conversations no longer held are dropped with their rows (R1.8).
+    pub fn sync_threads<'a>(
+        &mut self,
+        views: impl Iterator<Item = &'a Entity<ConversationView>>,
+        cx: &mut Context<Self>,
+    ) {
+        let mut previous = std::mem::take(&mut self.views);
+        let mut held = Vec::new();
+        let mut seen = HashSet::default();
+        for view in views {
+            let view_id = view.entity_id();
+            if !seen.insert(view_id) {
+                continue;
+            }
+            match previous.iter().position(|held| held.view_id == view_id) {
+                Some(ix) => held.push(previous.swap_remove(ix)),
+                None => held.push(Self::hold_view(view, cx)),
+            }
+        }
+        // Dropping what is left of `previous` drops its subscriptions.
+        self.views = held;
+        self.forget_unheld_sessions(cx);
+        self.update_tick(cx);
+        cx.notify();
+    }
+
+    /// The card's projection: the running tasks of every held thread plus the
+    /// unexpired ended rows, grouped by thread and ordered per R1.3.
+    pub fn rows(&self, cx: &App) -> Vec<ThreadGroup> {
+        let now = cx.background_executor().now();
+        let mut seen_sessions = HashSet::default();
+        let mut groups = Vec::new();
+
+        for thread in self.held_threads().filter_map(|held| held.thread.upgrade()) {
+            let thread = thread.read(cx);
+            let session_id = thread.session_id();
+            // One thread held through two views is still one group.
+            if !seen_sessions.insert(session_id.clone()) {
+                continue;
+            }
+
+            let running: Vec<&AgentTask> = thread
+                .tasks()
+                .iter()
+                .filter(|task| task.status.is_running())
+                .collect();
+            // A task running again under an ended id is listed once, as running.
+            let ended: Vec<&EndedRow> = self
+                .ended
+                .iter()
+                .filter(|((ended_session, task_id), ended)| {
+                    ended_session == session_id
+                        && ended.expires_at > now
+                        && !running.iter().any(|task| &task.id == task_id)
+                })
+                .map(|(_, ended)| ended)
+                .collect();
+
+            let oldest_running = running.iter().map(|task| task.started_at).min();
+            let latest_ending = ended.iter().map(|ended| ended.sequence).max();
+            let mut rows: Vec<TaskRow> = running
+                .into_iter()
+                .chain(ended.into_iter().map(|ended| &ended.task))
+                .map(|task| self.row(session_id, task.clone()))
+                .collect();
+
+            let order = match (oldest_running, latest_ending) {
+                (Some(oldest), _) => GroupOrder::Running(oldest),
+                (None, Some(latest)) => GroupOrder::EndedOnly(Reverse(latest)),
+                (None, None) => continue,
+            };
+            rows.sort_by_key(|row| row.task.started_at);
+            groups.push((
+                order,
+                ThreadGroup {
+                    session_id: session_id.clone(),
+                    title: thread
+                        .title()
+                        .unwrap_or_else(|| SharedString::new_static(DEFAULT_THREAD_TITLE)),
+                    project: project_name(thread),
+                    rows,
+                },
+            ));
+        }
+
+        // The session id only breaks ties, so equal start times list the same way
+        // on every render.
+        groups.sort_by(|(a_order, a), (b_order, b)| {
+            a_order
+                .cmp(b_order)
+                .then_with(|| a.session_id.0.cmp(&b.session_id.0))
+        });
+        groups.into_iter().map(|(_, group)| group).collect()
+    }
+
+    /// Whether the card (or its pill) is on screen: enabled, and something is
+    /// running or an ended row is still on show (R1.1, R1.7, R2.4).
