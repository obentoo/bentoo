+// Story 013 / task 4.1 — the card painted over the agent panel
+// (R1.1, R1.2, R1.7, R2.1, R2.2, R2.3, R2.4, R3.2). Filter: `tasks_card::render`.
+//
+// Elements are found through debug selectors (see test_helpers.rs for the list).
+
+use std::time::Duration;
+
+use agent_settings::{AgentSettings, TasksCardSettings};
+use gpui::{Modifiers, TestAppContext, VisualTestContext};
+use settings::{Settings as _, TasksCardPosition};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn set_card_settings(enabled: bool, position: TasksCardPosition, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        AgentSettings::override_global(
+            AgentSettings {
+                tasks_card: TasksCardSettings { enabled, position },
+                ..AgentSettings::get_global(cx).clone()
+            },
+            cx,
+        );
+    });
+    draw(cx);
+}
+
+#[gpui::test]
+async fn test_nothing_is_painted_while_no_task_runs(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card").is_none());
+    assert!(cx.debug_bounds("tasks-card-pill").is_none());
+
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card").is_some(),
+        "a running task shows the card"
+    );
+    assert!(cx.debug_bounds("tasks-card-row-t1").is_some());
+
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    advance(&mut cx, Duration::from_secs(11));
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card").is_none(),
+        "hidden once idle (R1.7)"
+    );
+}
+
+#[gpui::test]
+async fn test_card_sits_in_the_configured_corner(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+
+    // The default corner is top_right.
+    draw(&mut cx);
+    let default = cx.debug_bounds("tasks-card").expect("card painted");
+
+    set_card_settings(true, TasksCardPosition::BottomLeft, &mut cx);
+    let bottom_left = cx.debug_bounds("tasks-card").expect("card painted");
+    set_card_settings(true, TasksCardPosition::TopRight, &mut cx);
+    let top_right = cx.debug_bounds("tasks-card").expect("card painted");
+    set_card_settings(true, TasksCardPosition::TopLeft, &mut cx);
+    let top_left = cx.debug_bounds("tasks-card").expect("card painted");
+    set_card_settings(true, TasksCardPosition::BottomRight, &mut cx);
+    let bottom_right = cx.debug_bounds("tasks-card").expect("card painted");
+
+    assert_eq!(default, top_right, "top_right is the default corner");
+    assert!(
+        top_right.origin.x > top_left.origin.x,
+        "right is right of left"
+    );
+    assert!(bottom_right.origin.x > bottom_left.origin.x);
+    assert!(
+        bottom_left.origin.y > top_left.origin.y,
+        "bottom is below top"
+    );
+    assert!(bottom_right.origin.y > top_right.origin.y);
+}
+
+#[gpui::test]
+async fn test_disabled_setting_paints_neither_card_nor_pill(cx: &mut TestAppContext) {
