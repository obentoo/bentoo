+pub(crate) const TASKS_KEY: &str = "_claude/tasks";
+
+/// What a scripted task action answers.
+#[derive(Clone, Debug)]
+pub(crate) enum StopAnswer {
+    Ok,
+    Err(&'static str),
+}
+
+#[derive(Clone, Debug)]
+pub(crate) enum BackgroundAnswer {
+    Moved,
+    NothingMoved,
+    Err(&'static str),
+}
+
+/// An agent connection that records the task actions it is asked for, and answers
+/// them as scripted. Everything else delegates to `StubAgentConnection`, except
+/// `new_session`, which builds the thread on *this* connection so the thread's
+/// `stop_task` / `background_task` reach it.
+#[derive(Clone)]
+pub(crate) struct TaskActionsConnection {
+    stub: StubAgentConnection,
+    /// Threads created without a work directory (a thread opened outside a project).
+    without_work_dirs: bool,
+    next_session: Arc<Mutex<usize>>,
+    pub stops: Arc<Mutex<Vec<(String, String)>>>,
+    pub backgrounds: Arc<Mutex<Vec<(String, String)>>>,
+    pub stop_answer: Arc<Mutex<StopAnswer>>,
+    pub background_answer: Arc<Mutex<BackgroundAnswer>>,
+}
+
+impl TaskActionsConnection {
+    pub(crate) fn new() -> Self {
+        Self {
+            stub: StubAgentConnection::new(),
+            without_work_dirs: false,
+            next_session: Arc::new(Mutex::new(0)),
+            stops: Arc::default(),
+            backgrounds: Arc::default(),
+            stop_answer: Arc::new(Mutex::new(StopAnswer::Ok)),
+            background_answer: Arc::new(Mutex::new(BackgroundAnswer::Moved)),
+        }
+    }
+
+    pub(crate) fn without_work_dirs() -> Self {
+        Self {
+            without_work_dirs: true,
+            ..Self::new()
+        }
+    }
+
+    pub(crate) fn stops(&self) -> Vec<(String, String)> {
+        self.stops.lock().unwrap().clone()
+    }
+
+    pub(crate) fn backgrounds(&self) -> Vec<(String, String)> {
+        self.backgrounds.lock().unwrap().clone()
+    }
+}
+
+impl AgentConnection for TaskActionsConnection {
+    fn agent_id(&self) -> AgentId {
+        self.stub.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "tasks-card-test".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let session_id = {
+            let mut next = self.next_session.lock().unwrap();
+            *next += 1;
+            acp_v2::SessionId::new(format!("tasks-card-session-{}", *next))
+        };
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                (!self.without_work_dirs).then_some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(agent_client_protocol::schema::v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[agent_client_protocol::schema::v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: agent_client_protocol::schema::v2::AuthMethodId, _cx: &mut App) -> Task<Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: agent_client_protocol::schema::v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        Task::ready(Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) {}
+
+    // Story 012's task actions (AgentConnection, design.md of 012).
+    fn stop_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<()>> {
+        self.stops
+            .lock()
+            .unwrap()
+            .push((session_id.to_string(), task_id.to_string()));
+        match self.stop_answer.lock().unwrap().clone() {
+            StopAnswer::Ok => Task::ready(Ok(())),
+            StopAnswer::Err(message) => Task::ready(Err(anyhow!(message))),
+        }
+    }
+
+    fn background_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        tool_call_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<bool>> {
+        self.backgrounds
+            .lock()
+            .unwrap()
+            .push((session_id.to_string(), tool_call_id.to_string()));
+        match self.background_answer.lock().unwrap().clone() {
+            BackgroundAnswer::Moved => Task::ready(Ok(true)),
+            BackgroundAnswer::NothingMoved => Task::ready(Ok(false)),
+            BackgroundAnswer::Err(message) => Task::ready(Err(anyhow!(message))),
+        }
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+/// A visible agent panel in a workspace window, as the user sees it.
+pub(crate) async fn setup_card_panel(
+    cx: &mut TestAppContext,
+) -> (Entity<AgentPanel>, VisualTestContext) {
+    let (panel, _workspace, cx) = setup_card_panel_in_workspace(cx).await;
+    (panel, cx)
+}
+
+/// Same, also returning the workspace (to build a second, undocked panel).
+pub(crate) async fn setup_card_panel_in_workspace(
+    cx: &mut TestAppContext,
+) -> (Entity<AgentPanel>, Entity<Workspace>, VisualTestContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(800.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    (panel, workspace, cx)
+}
+
+/// Opens a new thread on `connection`, titles it, and returns its root thread.
+pub(crate) fn open_titled_thread(
+    panel: &Entity<AgentPanel>,
+    connection: &TaskActionsConnection,
+    title: &str,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    open_thread_with_custom_connection(panel, connection.clone(), cx);
+    let thread = panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    send_info(&thread, acp::SessionInfoUpdate::new().title(title), cx);
+    thread
+}
+
+pub(crate) fn session_of(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> acp_v2::SessionId {
+    thread.read_with(cx, |thread, _| thread.session_id().clone())
+}
+
+/// One `_claude/tasks` wire task, in the adapter's camelCase shape (story 012).
+pub(crate) fn wire_task(
+    id: &str,
+    status: &str,
+    background: bool,
+    started_at_ms: u64,
+) -> serde_json::Value {
+    let ended = status != "running";
+    json!({
+        "id": id,
+        "toolCallId": format!("toolu_{id}"),
+        "type": "shell",
+        "description": format!("Task {id}"),
+        "background": background,
+        "depth": 0,
+        "status": status,
+        "startedAt": started_at_ms,
+        "endedAt": if ended { Some(started_at_ms + 1_000) } else { None },
+        "usage": null,
+        "lastTool": null,
+        "summary": null,
+    })
+}
+
+pub(crate) fn send_info(
+    thread: &Entity<AcpThread>,
+    update: acp::SessionInfoUpdate,
+    cx: &mut VisualTestContext,
+) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(acp::SessionUpdate::SessionInfoUpdate(update), cx)
+        })
+        .expect("session info update should apply");
+    cx.run_until_parked();
+}
+
+/// Feeds a `_claude/tasks` snapshot (a level, replacing the list) to `thread`.
+pub(crate) fn send_tasks(
+    thread: &Entity<AcpThread>,
+    tasks: Vec<serde_json::Value>,
+    cx: &mut VisualTestContext,
+) {
+    let mut meta = serde_json::Map::new();
+    meta.insert(TASKS_KEY.to_string(), json!({ "tasks": tasks }));
+    send_info(thread, acp::SessionInfoUpdate::new().meta(meta), cx);
+}
+
+pub(crate) fn card(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Entity<TasksCard> {
+    panel.read_with(cx, |panel, _| panel.tasks_card().clone())
+}
+
+pub(crate) fn rows(card: &Entity<TasksCard>, cx: &mut VisualTestContext) -> Vec<ThreadGroup> {
+    card.update(cx, |card, cx| card.rows(cx))
+}
+
+pub(crate) fn visible(card: &Entity<TasksCard>, cx: &mut VisualTestContext) -> bool {
+    card.update(cx, |card, cx| card.is_visible(cx))
+}
+
+/// The rows of the group for `session` (empty when the thread has no group).
+pub(crate) fn rows_of(
+    card: &Entity<TasksCard>,
+    session: &acp_v2::SessionId,
+    cx: &mut VisualTestContext,
+) -> Vec<TaskRow> {
+    rows(card, cx)
+        .into_iter()
+        .find(|group| &group.session_id == session)
+        .map(|group| group.rows)
+        .unwrap_or_default()
+}
+
+pub(crate) fn row_ids(rows: &[TaskRow]) -> Vec<String> {
+    rows.iter().map(|row| row.task.id.to_string()).collect()
+}
+
+pub(crate) fn find_row(
+    card: &Entity<TasksCard>,
+    session: &acp_v2::SessionId,
+    task_id: &str,
+    cx: &mut VisualTestContext,
+) -> Option<TaskRow> {
+    rows_of(card, session, cx)
+        .into_iter()
+        .find(|row| row.task.id.as_ref() == task_id)
+}
+
+/// A prompt view whose answer never comes: once its window goes, the view is
+/// released and the prompt's sender with it — the "dropped receiver" case.
+pub(crate) struct SilentPrompt {
+    focus_handle: FocusHandle,
+}
+
+impl EventEmitter<PromptResponse> for SilentPrompt {}
+
+impl Focusable for SilentPrompt {
+    fn focus_handle(&self, _cx: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl Render for SilentPrompt {
+    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        gpui::div()
+    }
+}
+
+/// Routes every prompt of this app to a `SilentPrompt` instead of the test
+/// platform's queue (which keeps its sender alive for ever).
+pub(crate) fn use_silent_prompts(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        cx.set_prompt_builder(|_level, _message, _detail, _buttons, handle, window, cx| {
+            let view = cx.new(|cx| SilentPrompt {
+                focus_handle: cx.focus_handle(),
+            });
+            handle.with_view(view, window, cx)
+        });
+    });
+}
+
+pub(crate) fn advance(cx: &mut VisualTestContext, duration: Duration) {
+    cx.executor().advance_clock(duration);
+    cx.run_until_parked();
+}
