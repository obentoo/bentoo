+// Story 013 — shared fixtures for the tasks card tests (patch 0033/0034).
+//
+// Declared in `src/tasks_card.rs` as:
+//
+//     #[cfg(test)]
+//     mod test_helpers;
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/model_tests.rs"]
+//     mod model;
+//     #[cfg(test)]
+//     #[path = "tasks_card/render_tests.rs"]
+//     mod render;
+//     #[cfg(test)]
+//     #[path = "tasks_card/live_tests.rs"]
+//     mod live;
+//     #[cfg(test)]
+//     #[path = "tasks_card/stop_tests.rs"]
+//     mod stop;
+//     #[cfg(test)]
+//     #[path = "tasks_card/background_tests.rs"]
+//     mod background;
+//     #[cfg(test)]
+//     #[path = "tasks_card/open_tests.rs"]
+//     mod open;
+//
+// and in `src/tasks_card/tray.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "tray/decision_tests.rs"]
+//     mod decision;
+//     #[cfg(test)]
+//     #[path = "tray/send_tests.rs"]
+//     mod send_tests;
+//
+// so each test's path carries its Validation filter (`tasks_card::model`, ...,
+// `tasks_card::tray::send` — matched as a substring of `tasks_card::tray::send_tests`,
+// a name chosen so the module does not shadow `tray::send` the function).
+//
+// Contract assumed beyond design.md's signatures (the card's projection types):
+//   - the card is created in `AgentPanel::new`; `AgentPanel::tasks_card(&self) -> &Entity<TasksCard>`
+//   - `ThreadGroup { session_id: acp_v2::SessionId, title: SharedString, project: SharedString, rows: Vec<TaskRow> }`
+//   - `TaskRow { task: AgentTask, watched: bool, error: Option<SharedString> }`
+//   - `TasksCard::is_minimized(&self) -> bool`
+//   - actions keyed by `(acp_v2::SessionId, AgentTaskId)` (012: `pub type AgentTaskId = SharedString`):
+//     `toggle_watch(sid, id, cx)`, `toggle_minimized(cx)`, `request_stop(sid, id, window, cx)`,
+//     `send_to_background(sid, id, cx)`, `open_task(sid, id, window, cx)`
+//   - debug selectors: `tasks-card`, `tasks-card-pill`, `tasks-card-row-{task_id}`,
+//     `tasks-card-details-{task_id}`, `tasks-card-background-{task_id}`,
+//     `tasks-card-elapsed-{task_id}` (running row), `tasks-card-ended-{task_id}` (an ended
+//     row's final status and duration)
+//   - tray: `datagram_for(task: &AgentTask, session_id: &acp_v2::SessionId, work_dir: Option<&Path>,
+//     thread_title: Option<&str>, now: SystemTime) -> Option<TaskOutcomeDatagram>`
+
