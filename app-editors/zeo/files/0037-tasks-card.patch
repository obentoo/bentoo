+    assert!(
+        cx.debug_bounds("tasks-card").is_none(),
+        "the card is collapsed"
+    );
+    let pill = cx
+        .debug_bounds("tasks-card-pill")
+        .expect("the pill is painted");
+    // Same corner (top_right): the pill hugs the card's right and top edges.
+    assert!((pill.right() - expanded.right()).abs() < gpui::px(1.));
+    assert!((pill.top() - expanded.top()).abs() < gpui::px(1.));
+
+    cx.simulate_click(pill.center(), Modifiers::none());
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card").is_some(),
+        "clicking the pill expands"
+    );
+    assert!(cx.debug_bounds("tasks-card-pill").is_none());
+}
+
+/// A watched row is expanded with its progress details; every other row is one line.
+#[gpui::test]
+async fn test_only_watched_rows_show_their_details(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "running", true, 1_000),
+            wire_task("t2", "running", true, 2_000),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-details-t1").is_none());
+    assert!(cx.debug_bounds("tasks-card-details-t2").is_none());
+
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
