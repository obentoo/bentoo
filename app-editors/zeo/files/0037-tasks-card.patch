+// Story 013 / task 5.1 — Stop with confirmation (R4.1, R4.2, R4.3).
+// Filter: `tasks_card::stop`.
+
+use acp_thread::AgentTaskStatus;
+use gpui::TestAppContext;
+
+use super::test_helpers::*;
+
+/// Hostile half first: the prompt names the task, and Cancel sends nothing.
+#[gpui::test]
+async fn test_stop_asks_naming_the_task_and_cancel_sends_nothing(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(cx.has_pending_prompt(), "Stop asks before sending");
+    assert!(
+        connection.stops().is_empty(),
+        "nothing is sent while the prompt is open"
+    );
+    let (message, detail) = cx.pending_prompt().unwrap();
+    assert!(
+        format!("{message} {detail}").contains("Task t1"),
+        "the prompt names the task's description: {message:?} / {detail:?}"
+    );
+
+    cx.simulate_prompt_answer("Cancel");
+    cx.run_until_parked();
+    assert!(connection.stops().is_empty(), "Cancel sends nothing");
+    let row = find_row(&card, &sa, "t1", &mut cx).unwrap();
+    assert_eq!(row.task.status, AgentTaskStatus::Running);
+    assert!(row.error.is_none());
+}
+
+/// Confirmed: the stop goes to THAT task of THAT thread — two threads holding a
+/// task with the same id must not both be stopped, nor the wrong one.
+#[gpui::test]
+async fn test_confirmed_stop_sends_only_for_that_threads_task(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "Same title", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+
+    assert_eq!(connection.stops(), vec![(sa.to_string(), "t1".to_string())]);
+}
+
+#[gpui::test]
+async fn test_a_failed_stop_shows_on_the_row_and_the_task_stays_running(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    *connection.stop_answer.lock().unwrap() = StopAnswer::Err("stop failed for task t1: boom");
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+
+    assert_eq!(connection.stops().len(), 1);
+    let row = find_row(&card, &sa, "t1", &mut cx).expect("the task is still listed");
+    assert_eq!(row.task.status, AgentTaskStatus::Running);
+    let error = row.error.expect("the error reaches the row");
+    assert!(error.contains("boom"), "row error was {error:?}");
+}
+
+/// A prompt whose receiver is dropped (its window closed) is a Cancel. The hostile
+/// reading is "no answer = the first button", and the first button is Stop.
+#[gpui::test]
+async fn test_a_dropped_prompt_counts_as_cancel(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    use_silent_prompts(&mut cx);
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(connection.stops().is_empty());
+
+    // The window goes, and the prompt view and its sender with it.
+    cx.update(|window, _| window.remove_window());
+    cx.executor().run_until_parked();
+    assert!(
+        connection.stops().is_empty(),
+        "a dropped prompt must not stop the task"
+    );
+}
+
+/// The task ends while the prompt is open; answering Stop afterwards sends nothing
+/// and leaves no error on the (ended) row.
+#[gpui::test]
+async fn test_a_task_that_ends_while_the_prompt_is_open_is_not_stopped(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+
+    assert!(
+        connection.stops().is_empty(),
+        "an ended task is not stopped"
+    );
+    let row = find_row(&card, &sa, "t1", &mut cx).expect("the ended row is on show");
+    assert_eq!(row.task.status, AgentTaskStatus::Completed);
+    assert!(
+        row.error.is_none(),
+        "no error for a race the user did not cause"
+    );
+}
