+
+/// A running row paints its elapsed time; once ended, the row paints its final
+/// status and duration instead — until it expires.
+#[gpui::test]
+async fn test_an_ended_row_paints_its_final_status_until_it_expires(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-elapsed-t1").is_some());
+    assert!(cx.debug_bounds("tasks-card-ended-t1").is_none());
+
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card-ended-t1").is_some(),
+        "final status on show"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-elapsed-t1").is_none(),
+        "no ticking clock once ended"
+    );
+
+    advance(&mut cx, Duration::from_secs(9));
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card-ended-t1").is_some(),
+        "still on show at 9 s"
+    );
+
+    advance(&mut cx, Duration::from_secs(2));
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-ended-t1").is_none());
+    assert!(cx.debug_bounds("tasks-card-row-t1").is_none());
+}
diff --git a/crates/agent_ui/src/tasks_card/row_error_tests.rs b/crates/agent_ui/src/tasks_card/row_error_tests.rs
new file mode 100644
index 0000000..7371783
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/row_error_tests.rs
@@ -0,0 +1,182 @@
+// Story 013 / task 5.2 — the row-error lifecycle owed by 5.1 (R4.3, R4.7).
+// Filter: `tasks_card::row_error`.
+
+use std::{any::Any, rc::Rc};
+
+use acp_thread::{AcpThread, AgentConnection};
+use agent_client_protocol::schema::v1 as acp;
+use agent_client_protocol::schema::v2 as acp_v2;
+use anyhow::{Context as _, Result, anyhow};
+use gpui::{App, AppContext as _, Entity, SharedString, Task, TestAppContext};
+use project::{AgentId, Project};
+use workspace::PathList;
+
+use super::test_helpers::*;
+use crate::test_support::open_thread_with_custom_connection;
+
+/// A row error lasts while snapshots leave its task unchanged, and goes with the
+/// first snapshot that changes it. A snapshot identical to the last one never
+/// reaches the card (`AcpThread` emits no `TasksUpdated` for it), so the step that
+/// reaches the card's own check is the one that changes only another task.
+#[gpui::test]
+async fn test_a_row_error_survives_an_identical_snapshot_and_clears_on_a_change(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    *connection.stop_answer.lock().unwrap() = StopAnswer::Err("stop failed for task t1: boom");
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let t1 = wire_task("t1", "running", true, 1_000);
+    let t2 = wire_task("t2", "running", true, 2_000);
+    send_tasks(&a, vec![t1.clone(), t2.clone()], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+    assert!(find_row(&card, &sa, "t1", &mut cx).unwrap().error.is_some());
+
+    send_tasks(&a, vec![t1.clone(), t2.clone()], &mut cx);
+    let error = find_row(&card, &sa, "t1", &mut cx).unwrap().error;
+    assert!(
+        error.is_some_and(|error| error.contains("boom")),
+        "an identical snapshot keeps the error"
+    );
+
+    let mut t2_progressed = t2;
+    t2_progressed["lastTool"] = "Read".into();
+    send_tasks(&a, vec![t1.clone(), t2_progressed.clone()], &mut cx);
+    let error = find_row(&card, &sa, "t1", &mut cx).unwrap().error;
+    assert!(
+        error.is_some_and(|error| error.contains("boom")),
+        "a snapshot that changes only another task keeps the error"
+    );
+
+    let mut t1_progressed = t1;
+    t1_progressed["lastTool"] = "Bash".into();
+    send_tasks(&a, vec![t1_progressed, t2_progressed], &mut cx);
+    assert!(
+        find_row(&card, &sa, "t1", &mut cx).unwrap().error.is_none(),
+        "a snapshot that changes the task clears the error"
+    );
+}
+
+/// The real connection wraps the agent's text under its own context, so "is not
+/// running" sits in the cause, not in the outer message.
+#[gpui::test]
+async fn test_a_stop_refused_as_not_running_leaves_no_row_error(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = NotRunningStopConnection {
+        inner: TaskActionsConnection::new(),
+    };
+    open_thread_with_custom_connection(&panel, connection.clone(), &mut cx);
+    let a = panel.read_with(&cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    send_info(&a, acp::SessionInfoUpdate::new().title("A"), &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.request_stop(sa.clone(), id, window, cx)
+    });
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+
+    assert_eq!(
+        connection.inner.stops(),
+        vec![(sa.to_string(), "t1".to_string())]
+    );
+    let row = find_row(&card, &sa, "t1", &mut cx).unwrap();
+    assert!(
+        row.error.is_none(),
+        "a task that already ended is not the user's error: {:?}",
+        row.error
+    );
+}
+
+/// Answers every stop with `stop failed for task {id}` wrapping `task {id} is not
+/// running`; everything else is `TaskActionsConnection`'s.
+#[derive(Clone)]
+struct NotRunningStopConnection {
+    inner: TaskActionsConnection,
+}
+
+impl AgentConnection for NotRunningStopConnection {
+    fn agent_id(&self) -> AgentId {
+        self.inner.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        self.inner.telemetry_id()
+    }
+
+    // Builds the thread on this connection, so the thread's `stop_task` reaches it.
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                acp_v2::SessionId::new("tasks-card-not-running-session"),
+                watch::Receiver::constant(agent_client_protocol::schema::v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[agent_client_protocol::schema::v2::AuthMethod] {
+        self.inner.auth_methods()
+    }
+
+    fn authenticate(&self, method: agent_client_protocol::schema::v2::AuthMethodId, cx: &mut App) -> Task<Result<()>> {
+        self.inner.authenticate(method, cx)
+    }
+
+    fn prompt(
+        &self,
+        params: agent_client_protocol::schema::v2::PromptRequest,
+        cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        self.inner.prompt(params, cx)
+    }
+
+    fn cancel(&self, session_id: &acp_v2::SessionId, cx: &mut App) {
+        self.inner.cancel(session_id, cx)
+    }
+
+    fn stop_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<()>> {
+        self.inner
+            .stops
+            .lock()
+            .unwrap()
+            .push((session_id.to_string(), task_id.to_string()));
+        let refused: Result<()> = Err(anyhow!("task {task_id} is not running"));
+        Task::ready(refused.with_context(|| format!("stop failed for task {task_id}")))
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
