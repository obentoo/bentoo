+/// Places the tasks card in its corner of the free area of the agent panel.
+///
+/// The free area is only known once the panel's content has been laid out — the
+/// message editor grows as the user types, callouts come and go above it — so
+/// the card is laid out here, at prepaint, inside a frame the size of that area.
+/// Wrapped in `deferred`, this prepaint runs after the rest of the window's, so
+/// the bounds it measures belong to the frame being drawn, not the previous one.
+pub(crate) struct TasksCardOverlay {
+    card: AnyView,
+    position: TasksCardPosition,
+    /// The gap kept between the card and the edges of the free area.
+    inset: Pixels,
+    /// The free area in window coordinates, given the panel content's bounds.
+    free_area: Box<dyn Fn(Bounds<Pixels>, &App) -> Bounds<Pixels>>,
+}
+
+impl TasksCardOverlay {
+    pub(crate) fn new(
+        card: Entity<TasksCard>,
+        position: TasksCardPosition,
+        inset: Pixels,
+        free_area: impl Fn(Bounds<Pixels>, &App) -> Bounds<Pixels> + 'static,
+    ) -> Self {
+        Self {
+            card: card.into(),
+            position,
+            inset,
+            free_area: Box::new(free_area),
+        }
+    }
+}
+
+impl Element for TasksCardOverlay {
+    type RequestLayoutState = ();
+    type PrepaintState = Option<AnyElement>;
+
+    fn id(&self) -> Option<ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        // Covers the panel's content without taking part in its flow.
+        let mut style = Style::default();
+        style.position = gpui::Position::Absolute;
+        style.inset.top = px(0.).into();
+        style.inset.right = px(0.).into();
+        style.inset.bottom = px(0.).into();
+        style.inset.left = px(0.).into();
+        (window.request_layout(style, None, cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        _request_layout: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Option<AnyElement> {
+        // Never outside the panel, whatever the free area claims.
+        let area = (self.free_area)(bounds, cx).intersect(&bounds);
+        let frame_size = size(
+            (area.size.width - self.inset * 2.).max(px(0.)),
+            (area.size.height - self.inset * 2.).max(px(0.)),
+        );
+        let frame_origin = point(area.left() + self.inset, area.top() + self.inset);
+
+        // A frame of exactly the free area's size, so the card's `max_w_full` /
+        // `max_h_full` bound it there, and its alignment picks the corner.
+        let frame = div()
+            .flex()
+            .flex_col()
+            .w(frame_size.width)
+            .h(frame_size.height)
+            .map(|frame| match self.position {
+                TasksCardPosition::TopRight => frame.justify_start().items_end(),
+                TasksCardPosition::TopLeft => frame.justify_start().items_start(),
+                TasksCardPosition::BottomRight => frame.justify_end().items_end(),
+                TasksCardPosition::BottomLeft => frame.justify_end().items_start(),
+            })
+            .child(self.card.clone());
+        let mut frame = frame.into_any_element();
+        frame.layout_as_root(frame_size.map(AvailableSpace::Definite), window, cx);
+        frame.prepaint_at(frame_origin, window, cx);
+        Some(frame)
+    }
+
+    fn paint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        _bounds: Bounds<Pixels>,
+        _request_layout: &mut (),
+        frame: &mut Option<AnyElement>,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        if let Some(frame) = frame {
+            frame.paint(window, cx);
+        }
+    }
+}
+
+impl IntoElement for TasksCardOverlay {
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
+
+/// The count the pill and the card's header show: ended rows on show excluded.
+fn running_count(groups: &[ThreadGroup]) -> usize {
+    groups
+        .iter()
+        .flat_map(|group| &group.rows)
+        .filter(|row| row.task.status.is_running())
+        .count()
+}
+
+/// A watched row's progress details (R3.2): tokens, tool uses, last tool, summary.
+fn render_details(task: &AgentTask, task_id: &AgentTaskId) -> AnyElement {
+    let usage = match &task.usage {
+        Some(usage) => format!("{} tokens · {} tool uses", usage.tokens, usage.tool_uses),
+        None => "No usage reported yet".to_string(),
+    };
+    v_flex()
+        .debug_selector({
+            let task_id = task_id.clone();
+            move || format!("tasks-card-details-{task_id}")
+        })
+        .pl_1()
+        .gap_0p5()
+        .child(
+            Label::new(usage)
+                .size(LabelSize::XSmall)
+                .color(Color::Muted),
+        )
+        .when_some(task.last_tool.clone(), |this, last_tool| {
+            this.child(
+                Label::new(format!("Last tool: {last_tool}"))
+                    .size(LabelSize::XSmall)
+                    .color(Color::Muted),
+            )
+        })
+        .when_some(task.summary.clone(), |this, summary| {
+            this.child(Label::new(summary).size(LabelSize::XSmall))
+        })
+        .into_any_element()
+}
+
+/// How long an ended task ran: its own end time, else the adapter's measured
+/// duration; `None` when the adapter reported neither.
+fn ended_duration(task: &AgentTask) -> Option<Duration> {
+    task.ended_at
+        .and_then(|ended_at| ended_at.duration_since(task.started_at).ok())
+        .or_else(|| task.usage.as_ref().map(|usage| usage.duration))
+}
+
+fn status_label(status: AgentTaskStatus) -> &'static str {
+    match status {
+        AgentTaskStatus::Running => "Running",
+        AgentTaskStatus::Completed => "Completed",
+        AgentTaskStatus::Failed => "Failed",
+        AgentTaskStatus::Stopped => "Stopped",
+        AgentTaskStatus::Interrupted => "Interrupted",
+    }
+}
+
+fn status_color(status: AgentTaskStatus) -> Color {
+    match status {
+        AgentTaskStatus::Running => Color::Muted,
+        AgentTaskStatus::Completed => Color::Success,
+        AgentTaskStatus::Failed => Color::Error,
+        AgentTaskStatus::Stopped | AgentTaskStatus::Interrupted => Color::Warning,
+    }
+}
+
+/// `42s`, `3m 07s`, `2h 05m`.
+fn format_duration(duration: Duration) -> String {
+    let seconds = duration.as_secs();
+    let (hours, minutes) = (seconds / 3600, (seconds % 3600) / 60);
+    if hours > 0 {
+        format!("{hours}h {minutes:02}m")
+    } else if minutes > 0 {
+        format!("{minutes}m {:02}s", seconds % 60)
+    } else {
+        format!("{seconds}s")
+    }
+}
+
+/// The last component of the thread's first work directory, or empty for a thread
+/// opened outside a project.
+fn project_name(thread: &AcpThread) -> SharedString {
+    thread
+        .work_dirs()
+        .and_then(|dirs| dirs.paths().first())
+        .and_then(|path| path.file_name())
+        .map(|name| SharedString::from(name.to_string_lossy().into_owned()))
+        .unwrap_or_default()
+}
diff --git a/crates/agent_ui/src/tasks_card/accessibility_tests.rs b/crates/agent_ui/src/tasks_card/accessibility_tests.rs
new file mode 100644
index 0000000..3ee252b
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/accessibility_tests.rs
@@ -0,0 +1,310 @@
+// Story 013 / task 4.1, Q14 — every card control carries a tooltip naming its
+// action and is reachable by keyboard, and minimizing or expanding the card does
+// not drop keyboard focus. Filter: `tasks_card::accessibility`.
+
+use std::time::Duration;
+
+use gpui::{FocusHandle, Modifiers, Point, TestAppContext, VisualTestContext, px};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Hovers the element painted under `selector` long enough for a tooltip, and
+/// returns whether the tooltip painted under `tooltip` showed.
+fn tooltip_shows(
+    selector: &'static str,
+    tooltip: &'static str,
+    cx: &mut VisualTestContext,
+) -> bool {
+    // Off every control first, so the previous tooltip is gone.
+    cx.simulate_mouse_move(Point::new(px(1.), px(1.)), None, Modifiers::none());
+    advance(cx, Duration::from_millis(100));
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    advance(cx, Duration::from_secs(1));
+    draw(cx);
+    cx.debug_bounds(tooltip).is_some()
+}
+
+fn is_focused(handle: &FocusHandle, cx: &mut VisualTestContext) -> bool {
+    cx.update(|window, _| handle.is_focused(window))
+}
+
+/// Walks the window's tab order, one stop at a time, until `handle` has focus.
+fn reachable_by_tab(handle: &FocusHandle, cx: &mut VisualTestContext) -> bool {
+    for _ in 0..200 {
+        cx.update(|window, cx| window.focus_next(cx));
+        draw(cx);
+        if is_focused(handle, cx) {
+            return true;
+        }
+    }
+    false
+}
+
+#[gpui::test]
+async fn test_every_card_control_has_a_tooltip(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    assert!(tooltip_shows(
+        "tasks-card-minimize",
+        "tasks-card-tooltip-minimize",
+        &mut cx
+    ));
+    assert!(tooltip_shows(
+        "tasks-card-watch-t1",
+        "tasks-card-tooltip-watch-t1",
+        &mut cx
+    ));
+    // Not a control, but a one-word chip whose meaning the tooltip spells out.
+    assert!(tooltip_shows(
+        "tasks-card-mode-t1",
+        "tasks-card-tooltip-mode-t1",
+        &mut cx
+    ));
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    draw(&mut cx);
+    assert!(tooltip_shows(
+        "tasks-card-pill",
+        "tasks-card-tooltip-pill",
+        &mut cx
+    ));
+}
+
+#[gpui::test]
+async fn test_every_card_control_is_reachable_by_keyboard(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let session = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let (minimize, pill, watch) = card.read_with(&cx, |card, _| {
+        (
+            card.minimize_focus_handle().clone(),
+            card.pill_focus_handle().clone(),
+            card.watch_focus_handle(&session, &"t1".into()),
+        )
+    });
+    let watch = watch.expect("the painted row has a focus handle for its watch toggle");
+
+    assert!(
+        reachable_by_tab(&minimize, &mut cx),
+        "Minimize is a tab stop"
+    );
+    assert!(
+        reachable_by_tab(&watch, &mut cx),
+        "the watch toggle is a tab stop"
+    );
+
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    draw(&mut cx);
+    assert!(reachable_by_tab(&pill, &mut cx), "the pill is a tab stop");
+}
+
+/// Minimize and the pill replace each other on screen; focus moves with them.
+#[gpui::test]
+async fn test_minimize_and_expand_hand_focus_over(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let card = card(&panel, &cx);
+    let (minimize, pill) = card.read_with(&cx, |card, _| {
+        (
+            card.minimize_focus_handle().clone(),
+            card.pill_focus_handle().clone(),
+        )
+    });
+
+    cx.update(|window, cx| window.focus(&minimize, cx));
+    draw(&mut cx);
+    let button = cx
+        .debug_bounds("tasks-card-minimize")
+        .expect("Minimize is painted");
+    cx.simulate_click(button.center(), Modifiers::none());
+    draw(&mut cx);
+    assert!(card.read_with(&cx, |card, _| card.is_minimized()));
+    assert!(
+        is_focused(&pill, &mut cx),
+        "minimizing hands focus to the pill"
+    );
+
+    let pill_bounds = cx
+        .debug_bounds("tasks-card-pill")
+        .expect("the pill is painted");
+    cx.simulate_click(pill_bounds.center(), Modifiers::none());
+    draw(&mut cx);
+    assert!(!card.read_with(&cx, |card, _| card.is_minimized()));
+    assert!(
+        is_focused(&minimize, &mut cx),
+        "expanding hands focus back to Minimize"
+    );
+}
+
+/// The converse: focus that is not on the card stays where it is.
+#[gpui::test]
+async fn test_toggling_does_not_take_focus_it_did_not_have(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let card = card(&panel, &cx);
+    let (minimize, pill) = card.read_with(&cx, |card, _| {
+        (
+            card.minimize_focus_handle().clone(),
+            card.pill_focus_handle().clone(),
+        )
+    });
+    assert!(!is_focused(&minimize, &mut cx));
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.toggle_minimized_keeping_focus(window, cx)
+    });
+    draw(&mut cx);
+    assert!(!is_focused(&pill, &mut cx), "the pill does not grab focus");
+
+    card.update_in(&mut cx, |card, window, cx| {
+        card.toggle_minimized_keeping_focus(window, cx)
+    });
+    draw(&mut cx);
+    assert!(
+        !is_focused(&minimize, &mut cx),
+        "Minimize does not grab focus"
+    );
+}
+
+/// Task 5.1: the Stop button a running row gains meets the same bar (Q14).
+#[gpui::test]
+async fn test_the_stop_button_has_a_tooltip_and_is_reachable_by_keyboard(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    assert!(tooltip_shows(
+        "tasks-card-stop-t1",
+        "tasks-card-tooltip-stop-t1",
+        &mut cx
+    ));
+
+    let session = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let stop = card
+        .read_with(&cx, |card, _| {
+            card.stop_focus_handle(&session, &"t1".into())
+        })
+        .expect("the painted running row has a focus handle for its Stop button");
+    assert!(
+        reachable_by_tab(&stop, &mut cx),
+        "the Stop button is a tab stop"
+    );
+
+    // An ended row offers nothing to stop.
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-row-t1").is_some());
+    assert!(cx.debug_bounds("tasks-card-stop-t1").is_none());
+}
+
+/// Task 5.2: the Send to Background button a foreground row gains meets the same
+/// bar (Q14).
+#[gpui::test]
+async fn test_the_background_button_has_a_tooltip_and_is_reachable_by_keyboard(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", false, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    assert!(tooltip_shows(
+        "tasks-card-background-t1",
+        "tasks-card-tooltip-background-t1",
+        &mut cx
+    ));
+
+    let session = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let background = card
+        .read_with(&cx, |card, _| {
+            card.background_focus_handle(&session, &"t1".into())
+        })
+        .expect("the painted foreground row has a focus handle for its button");
+    assert!(
+        reachable_by_tab(&background, &mut cx),
+        "the Send to Background button is a tab stop"
+    );
+}
+
+/// Task 5.3: each row's Open button, and the group header that opens its thread,
+/// meet the same bar (Q14).
+#[gpui::test]
+async fn test_the_open_controls_have_a_tooltip_and_are_reachable_by_keyboard(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+
+    let session = session_of(&a, &cx);
+    // The group's selectors carry its session id, which this connection numbers.
+    assert_eq!(session.0.as_ref(), "tasks-card-session-1");
+
+    assert!(tooltip_shows(
+        "tasks-card-open-t1",
+        "tasks-card-tooltip-open-t1",
+        &mut cx
+    ));
+    assert!(tooltip_shows(
+        "tasks-card-open-group-tasks-card-session-1",
+        "tasks-card-tooltip-open-group-tasks-card-session-1",
+        &mut cx
+    ));
+
+    let card = card(&panel, &cx);
+    let open = card
+        .read_with(&cx, |card, _| {
+            card.open_focus_handle(&session, &"t1".into())
+        })
+        .expect("the painted row has a focus handle for its Open button");
+    assert!(
+        reachable_by_tab(&open, &mut cx),
+        "the Open button is a tab stop"
+    );
+    let open_group = card
+        .read_with(&cx, |card, _| card.group_open_focus_handle(&session))
+        .expect("the painted group has a focus handle for its header");
+    assert!(
+        reachable_by_tab(&open_group, &mut cx),
+        "the group header is a tab stop"
+    );
