+    /// The Minimize button and the pill replace each other, so whichever of them
+    /// held keyboard focus hands it to the other instead of dropping it (Q14).
+    fn toggle_minimized_keeping_focus(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let (source, target) = if self.minimized {
+            (&self.pill_focus_handle, &self.minimize_focus_handle)
+        } else {
+            (&self.minimize_focus_handle, &self.pill_focus_handle)
+        };
+        let target = source.is_focused(window).then(|| target.clone());
+        self.toggle_minimized(cx);
+        if let Some(target) = target {
+            window.focus(&target, cx);
+        }
+    }
