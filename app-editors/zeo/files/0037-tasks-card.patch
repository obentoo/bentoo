+
+#[gpui::test]
+async fn test_minimize_collapses_to_a_pill_and_clicking_it_expands(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    let expanded = cx.debug_bounds("tasks-card").expect("card painted");
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
