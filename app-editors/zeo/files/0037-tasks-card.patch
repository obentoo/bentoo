+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-details-t1").is_some());
+    assert!(cx.debug_bounds("tasks-card-details-t2").is_none());
+    let watched = cx.debug_bounds("tasks-card-row-t1").unwrap();
+    let plain = cx.debug_bounds("tasks-card-row-t2").unwrap();
+    assert!(
+        watched.size.height > plain.size.height,
