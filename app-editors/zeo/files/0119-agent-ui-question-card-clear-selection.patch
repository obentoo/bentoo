@@ -0,0 +1,88 @@
+// Zeo next proposal §6.42 (ask 66): Clear on a question of the question card.
+// Filter: `clear_selection`.
+use gpui::TestAppContext;
+
+use super::*;
+
+/// A free-text box paired with `question_id`, as the adapter emits beside every question.
+fn other_box(question_id: &str) -> acp::StringPropertySchema {
+    let mut schema = acp::StringPropertySchema::new().title("Other");
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY.to_string(),
+        serde_json::json!({ "questionId": question_id, "isCustomAnswer": true }),
+    );
+    schema.meta = Some(meta);
+    schema
+}
+
+/// One single-select and one multi-select question, each with its own "Other" box.
+fn two_questions() -> acp::ElicitationSchema {
+    acp::ElicitationSchema::new()
+        .property(
+            "pick",
+            acp::StringPropertySchema::new().enum_values(vec!["a".into(), "b".into()]),
+            true,
+        )
+        .property("pick_other", other_box("pick"), false)
+        .property(
+            "many",
+            acp::MultiSelectPropertySchema::new(vec!["x".into(), "y".into()]),
+            false,
+        )
+        .property("many_other", other_box("many"), false)
+}
+
+fn names(names: &[&str]) -> Vec<String> {
+    names.iter().map(|name| name.to_string()).collect()
+}
+
+#[test]
+fn a_question_is_cleared_with_its_own_other_box_only() {
+    let schema = two_questions();
+    assert_eq!(
+        clear_targets(&schema, "pick"),
+        names(&["pick", "pick_other"])
+    );
+    assert_eq!(
+        clear_targets(&schema, "many"),
+        names(&["many", "many_other"])
+    );
+}
+
+#[gpui::test]
+fn clear_takes_a_question_back_to_unanswered(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    let cx = cx.add_empty_window();
+    cx.update(|window, cx| {
+        let schema = two_questions();
+        let mut form = ElicitationFormState::new(&schema, window, cx);
+        let pick = clear_targets(&schema, "pick");
+        let many = clear_targets(&schema, "many");
+
+        form.set_single_select("pick", "b".into());
+        form.set_multi_select("many", "x".into(), true);
+        if let Some(ElicitationFieldState::Text(editor)) = form.fields.get("pick_other") {
+            editor.update(cx, |editor, cx| editor.set_text("mine", window, cx));
+        }
+        assert!(form.has_answer(&pick, cx));
+        assert!(form.has_answer(&many, cx));
+
+        form.clear_answers(&pick, window, cx);
+        assert!(
+            !form.has_answer(&pick, cx),
+            "the radio and its Other box are empty"
+        );
+        assert!(
+            form.has_answer(&many, cx),
+            "another question keeps its answer"
+        );
+        assert!(matches!(
+            form.fields.get("pick"),
+            Some(ElicitationFieldState::SingleSelect { value: None })
+        ));
+
+        form.clear_answers(&many, window, cx);
+        assert!(!form.has_answer(&many, cx));
+    });
+}
