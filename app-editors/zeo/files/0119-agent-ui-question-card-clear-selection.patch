@@ -0,0 +1,101 @@
+//! "Clear" on a question of the question card (Zeo next proposal §6.42, ask 66).
+//!
+//! A single-select question is a radio group: once an option is picked there was no way back to
+//! no answer, and a multi-select could only be undone box by box. Clear takes the question back
+//! to unanswered -- the select and its own "Other" box together, the pair a page already keeps
+//! together -- so a required question fails validation again exactly as an untouched one does.
+
+use super::*;
+use ui::Tooltip;
+
+/// What a Clear on a question resets, by field name: the question and the custom-answer box
+/// that names it.
+pub(super) type ClearSelectionHandler =
+    Rc<dyn Fn(ElicitationEntryId, Vec<String>, &mut Window, &mut App)>;
+
+/// The question `field_name` and every custom-answer companion that belongs to it, in schema
+/// order.
+pub(super) fn clear_targets(schema: &acp::ElicitationSchema, field_name: &str) -> Vec<String> {
+    let mut targets = vec![field_name.to_string()];
+    targets.extend(
+        schema
+            .properties
+            .iter()
+            .filter(|(_, property)| custom_answer_companion_of(property) == Some(field_name))
+            .map(|(name, _)| name.clone()),
+    );
+    targets
+}
+
+impl ElicitationFormState {
+    /// Whether any of `fields` holds an answer Clear would remove.
+    pub(crate) fn has_answer(&self, fields: &[String], cx: &App) -> bool {
+        fields.iter().any(|name| match self.fields.get(name) {
+            Some(ElicitationFieldState::SingleSelect { value }) => value.is_some(),
+            Some(ElicitationFieldState::MultiSelect(values)) => !values.is_empty(),
+            Some(ElicitationFieldState::Text(editor)) => !editor.read(cx).text(cx).is_empty(),
+            Some(ElicitationFieldState::Boolean(_)) | None => false,
+        })
+    }
+
+    /// Takes `fields` back to unanswered, and drops their validation errors.
+    pub(crate) fn clear_answers(&mut self, fields: &[String], window: &mut Window, cx: &mut App) {
+        for name in fields {
+            match self.fields.get_mut(name) {
+                Some(ElicitationFieldState::SingleSelect { value }) => *value = None,
+                Some(ElicitationFieldState::MultiSelect(values)) => values.clear(),
+                Some(ElicitationFieldState::Text(editor)) => {
+                    editor.update(cx, |editor, cx| editor.set_text("", window, cx))
+                }
+                Some(ElicitationFieldState::Boolean(_)) | None => {}
+            }
+            self.field_errors.remove(name.as_str());
+        }
+    }
+}
+
+impl ElicitationCard<'_> {
+    /// The question's Clear, while it has an answer; `None` on any other field.
+    pub(super) fn render_clear_selection(
+        &self,
+        field_name: &str,
+        field: &ElicitationFieldState,
+        schema: &acp::ElicitationSchema,
+        cx: &App,
+    ) -> Option<AnyElement> {
+        if !matches!(
+            field,
+            ElicitationFieldState::SingleSelect { .. } | ElicitationFieldState::MultiSelect(_)
+        ) {
+            return None;
+        }
+        let targets = clear_targets(schema, field_name);
+        if !self.form_state?.has_answer(&targets, cx) {
+            return None;
+        }
+        let on_clear = self.handlers.on_clear_selection.clone();
+        let elicitation_id = self.elicitation.id.clone();
+        let button_id = format!("elicitation-clear-{}-{field_name}", self.entry_ix);
+        Some(
+            div()
+                .debug_selector({
+                    let field_name = field_name.to_string();
+                    move || format!("elicitation-clear-{field_name}")
+                })
+                .child(
+                    Button::new(button_id, "Clear")
+                        .label_size(LabelSize::Small)
+                        .color(Color::Muted)
+                        .tooltip(Tooltip::text("Clear This Answer"))
+                        .on_click(move |_, window, cx| {
+                            on_clear(elicitation_id.clone(), targets.clone(), window, cx)
+                        }),
+                )
+                .into_any_element(),
+        )
+    }
+}
+
+#[cfg(test)]
+#[path = "clear_selection_tests.rs"]
+mod tests;
