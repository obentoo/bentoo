+pub(super) fn reported(
+    store: &Entity<ThreadOrganizationStore>,
+    thread_id: ThreadId,
+    cx: &TestAppContext,
+) -> Reported {
+    store.read_with(cx, |store, _| {
+        let organization = store.organization(thread_id);
+        Reported {
+            pinned_position: organization.and_then(|o| o.pinned_position),
+            manual_position: organization.and_then(|o| o.manual_position),
+            list_id: organization.and_then(|o| o.list_id),
+            parent: organization.and_then(|o| o.parent),
+            tags: store
+                .tags(thread_id)
+                .into_iter()
+                .map(|tag| (tag.key.to_string(), tag.display.to_string()))
+                .collect(),
+        }
+    })
+}
