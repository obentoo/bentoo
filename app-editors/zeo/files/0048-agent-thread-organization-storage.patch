+    store.update(cx, |store, cx| {
+        store.pin(a, cx).unwrap();
+        store.pin(b, cx).unwrap();
+        store.pin(c, cx).unwrap();
+    });
+
+    let result = store.update(cx, |store, cx| store.pin(a, cx));
+    assert!(result.is_ok(), "re-pinning reports success: {result:?}");
+    assert_eq!(
+        pinned(&store, cx),
+        vec![c, b, a],
+        "the pinned order is unchanged"
+    );
+    let store = restart(store, &db, cx);
+    assert_eq!(pinned(&store, cx), vec![c, b, a]);
+}
+
+// R2.3, R2.4 — moving a pinned thread rewrites the positions densely (no gap, no duplicate),
+// in memory and on disk; an index past the end places it last.
+#[gpui::test]
+async fn store_order_move_pinned_rewrites_dense_positions_and_clamps(cx: &mut TestAppContext) {
+    init(cx);
+    let (a, b, c) = (thread(cx), thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_order_move").await;
+    let store = open_store(&db, cx);
+    store.update(cx, |store, cx| {
+        store.pin(a, cx).unwrap();
+        store.pin(b, cx).unwrap();
+        store.pin(c, cx).unwrap();
+    });
+
+    store
+        .update(cx, |store, cx| store.move_pinned(a, 0, cx))
+        .unwrap();
+    assert_eq!(pinned(&store, cx), vec![a, c, b]);
+    assert_eq!(
+        pinned_positions(&store, &[a, c, b], cx),
+        vec![Some(0), Some(1), Some(2)]
+    );
+
+    store
+        .update(cx, |store, cx| store.move_pinned(c, 99, cx))
+        .unwrap();
+    assert_eq!(pinned(&store, cx), vec![a, b, c], "past the end means last");
+    assert_eq!(
+        pinned_positions(&store, &[a, b, c], cx),
+        vec![Some(0), Some(1), Some(2)]
+    );
+
+    cx.run_until_parked();
+    let on_disk: Vec<i64> = db
+        .select::<i64>(
+            "SELECT pinned_position FROM thread_organization \
+             WHERE pinned_position IS NOT NULL ORDER BY pinned_position",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(on_disk, vec![0, 1, 2], "dense on disk too");
+}
+
+// R2.5 — unpinning removes the thread and keeps the rest in their relative order; a thread with
+// nothing else stored leaves no row behind (design.md: an all-NULL row is deleted).
