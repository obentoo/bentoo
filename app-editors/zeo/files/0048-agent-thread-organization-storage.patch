+fn pinned_positions(
+    store: &gpui::Entity<super::ThreadOrganizationStore>,
+    threads: &[ThreadId],
+    cx: &TestAppContext,
+) -> Vec<Option<u32>> {
+    threads
+        .iter()
+        .map(|thread| reported(store, *thread, cx).pinned_position)
+        .collect()
+}
+
+fn manual_positions(
+    store: &gpui::Entity<super::ThreadOrganizationStore>,
+    threads: &[ThreadId],
+    cx: &TestAppContext,
+) -> Vec<Option<u32>> {
+    store.read_with(cx, |store, _| {
+        threads
+            .iter()
+            .map(|thread| store.manual_position(*thread))
+            .collect()
+    })
+}
