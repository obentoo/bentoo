+}
+
+// R4.5 (hostile half first) — deleting a list touches only that list's membership: a thread of
+// ANOTHER list keeps its list, and the deleted list's thread keeps its pin, tags, manual
+// position and parent link — in memory, on disk (no dangling list_id), after a restart.
+#[gpui::test]
+async fn store_lists_tags_deleting_a_list_keeps_everything_else(cx: &mut TestAppContext) {
+    init(cx);
+    let parent = thread_in(PROJECT_A, cx);
+    let t = thread_in(PROJECT_A, cx);
+    let u = thread_in(PROJECT_A, cx);
+    let db = open_db("thread_organization_store_lists_tags_delete_list").await;
+    let parent_hex = parent.to_key_string().replace('-', "");
+    let t_hex = t.to_key_string().replace('-', "");
+    run_sql(
+        &db,
+        format!(
+            "INSERT INTO thread_organization (thread_id, parent_thread_id, fork_kind) \
+             VALUES (X'{t_hex}', X'{parent_hex}', 'with_context')"
+        ),
+    )
+    .await;
+    let store = open_store(&db, cx);
+    let (doomed, other) = store.update(cx, |store, cx| {
+        let doomed = store.create_list("Doomed", cx).unwrap();
+        let other = store.create_list("Other", cx).unwrap();
+        store.set_list(t, Some(doomed), cx).unwrap();
+        store.set_list(u, Some(other), cx).unwrap();
+        store.pin(t, cx).unwrap();
+        store.add_tag(t, "Rust", cx).unwrap();
+        store
+            .set_manual_order(project(&[PROJECT_A]), &[u, t], cx)
+            .unwrap();
+        (doomed, other)
+    });
+    let before = reported(&store, t, cx);
+    assert_eq!(before.parent, Some((parent, ForkKind::WithContext)));
+
+    store
+        .update(cx, |store, cx| store.delete_list(doomed, cx))
+        .unwrap();
+
+    let check = |store: &gpui::Entity<super::ThreadOrganizationStore>, cx: &TestAppContext| {
+        assert_eq!(list_ids(store, cx), vec![other]);
+        assert_eq!(
+            in_list(store, other, cx),
+            vec![u],
+            "another list keeps its thread"
+        );
+        let after = reported(store, t, cx);
+        assert_eq!(after.list_id, None);
+        assert_eq!(after.pinned_position, before.pinned_position);
+        assert_eq!(after.manual_position, before.manual_position);
+        assert_eq!(after.parent, before.parent);
+        assert_eq!(after.tags, before.tags);
+        assert_eq!(pinned(store, cx), vec![t]);
+        store.read_with(cx, |store, _| {
+            assert_eq!(store.sort_mode(&project(&[PROJECT_A])), SortMode::Manual);
+        });
+    };
+    check(&store, cx);
+
+    cx.run_until_parked();
+    assert_eq!(
+        count(
+            &db,
+            "SELECT COUNT(*) FROM thread_organization WHERE list_id IS NOT NULL \
+             AND list_id NOT IN (SELECT id FROM thread_lists)"
+        ),
+        0,
+        "no row points at the deleted list"
+    );
+    let store = restart(store, &db, cx);
+    check(&store, cx);
+}
