@@ -0,0 +1,173 @@
+// Story 031, task 2.3 — `ProjectKey::from_group` (R3.4, R3.5).
+//
+// Materialize with, in `src/thread_organization.rs`:
+//     #[cfg(test)]
+//     #[path = "thread_organization/project_key_tests.rs"]
+//     mod project_key;
+// Filter: `cargo test -p agent_ui thread_organization::project_key`.
+//
+// Contract: two project groups are the same project exactly when they have the same set of main
+// worktree paths (order irrelevant) on the same host identity — the identity
+// `remote::same_remote_connection_identity` compares, so runtime-only fields such as an SSH
+// nickname or password never split a project. Hostile halves first: keys that must stay APART
+// (including derived renderings that could coincide), then keys that must come TOGETHER.
+
+use std::path::Path;
+
+use project::ProjectGroupKey;
+use remote::{RemoteConnectionOptions, SshConnectionOptions, WslConnectionOptions};
+use workspace::PathList;
+
+use super::ProjectKey;
+
+fn key(host: Option<RemoteConnectionOptions>, paths: &[&str]) -> ProjectKey {
+    let paths: Vec<&Path> = paths.iter().map(Path::new).collect();
+    ProjectKey::from_group(&ProjectGroupKey::new(host, PathList::new(&paths)))
+}
+
+fn local(paths: &[&str]) -> ProjectKey {
+    key(None, paths)
+}
+
+fn ssh(host: &str, username: Option<&str>, port: Option<u16>) -> Option<RemoteConnectionOptions> {
+    Some(RemoteConnectionOptions::Ssh(SshConnectionOptions {
+        host: host.into(),
+        username: username.map(str::to_string),
+        port,
+        ..Default::default()
+    }))
+}
+
+fn wsl(distro: &str, user: Option<&str>) -> Option<RemoteConnectionOptions> {
+    Some(RemoteConnectionOptions::Wsl(WslConnectionOptions {
+        distro_name: distro.to_string(),
+        user: user.map(str::to_string),
+    }))
+}
+
+// R3.4 (hostile: must NOT collapse) — different folder sets are different projects, even when
+// one set contains the other or their joined text looks alike.
+#[test]
+fn project_key_keeps_projects_with_different_folders_apart() {
+    assert_ne!(local(&["/a"]), local(&["/a", "/b"]));
+    assert_ne!(local(&["/a/b"]), local(&["/a", "/b"]));
+    assert_ne!(local(&["/a"]), local(&["/b"]));
+    assert_ne!(local(&["/work/zed"]), local(&["/work/zed-patches"]));
+}
+
+// Derived value (hostile: a THIRD element colliding with the rendered key) — the key is a
+// rendering of a folder list. A single folder whose name holds the rendering's separator must not
+// render byte-identical to two folders: Linux allows a newline in a file name, so `"/a\n/b"` is
+// one real folder, not `/a` and `/b`.
+#[test]
+fn project_key_keeps_a_folder_whose_name_holds_the_separator_apart_from_two_folders() {
+    assert_ne!(local(&["/a\n/b"]), local(&["/a", "/b"]));
+    assert_ne!(local(&["/a\n/b", "/c"]), local(&["/a", "/b\n/c"]));
+}
+
+// R3.5 (hostile: must NOT collapse) — the same folders on different hosts are different
+// projects: local against remote, two remote hosts, and the same host under a field that
+// `same_remote_connection_identity` compares (user, port, WSL user, transport).
+#[test]
+fn project_key_keeps_the_same_folders_on_different_hosts_apart() {
+    let paths = ["/srv/app"];
+    let keys = [
+        key(None, &paths),
+        key(ssh("alpha.example.com", None, None), &paths),
+        key(ssh("beta.example.com", None, None), &paths),
+        key(ssh("alpha.example.com", Some("deploy"), None), &paths),
+        key(ssh("alpha.example.com", None, Some(2222)), &paths),
+        key(wsl("Ubuntu", None), &paths),
+        key(wsl("Ubuntu", Some("root")), &paths),
+        key(wsl("Debian", None), &paths),
+    ];
+    for (i, left) in keys.iter().enumerate() {
+        for right in &keys[i + 1..] {
+            assert_ne!(
+                left, right,
+                "different hosts must give different project keys"
+            );
+        }
+    }
+}
+
+// Derived value (hostile: a THIRD element colliding with the local rendering) — a remote host
+// literally named like the local marker is still a remote host.
+#[test]
+fn project_key_keeps_a_remote_host_named_local_apart_from_the_local_machine() {
+    let paths = ["/srv/app"];
+    assert_ne!(key(None, &paths), key(ssh("local", None, None), &paths));
+    assert_ne!(key(None, &paths), key(wsl("local", None), &paths));
+}
+
+// R3.4 (hostile: must NOT split) — the order the folders were added in is not identity, locally
+// or on a remote host.
+#[test]
+fn project_key_treats_projects_that_differ_only_in_folder_order_as_one() {
+    assert_eq!(local(&["/b", "/a"]), local(&["/a", "/b"]));
+    assert_eq!(local(&["/c", "/a", "/b"]), local(&["/b", "/c", "/a"]));
+    let host = ssh("alpha.example.com", Some("deploy"), Some(22));
+    assert_eq!(
+        key(host.clone(), &["/srv/b", "/srv/a"]),
+        key(host, &["/srv/a", "/srv/b"])
+    );
+}
+
+// R3.5's converse (hostile: must NOT split) — fields `same_remote_connection_identity` ignores
+// (nickname, password, extra args, timeout) never make the same host a second project.
+#[test]
+fn project_key_ignores_remote_fields_that_are_not_host_identity() {
+    let plain = Some(RemoteConnectionOptions::Ssh(SshConnectionOptions {
+        host: "alpha.example.com".into(),
+        username: Some("deploy".to_string()),
+        port: Some(2222),
+        ..Default::default()
+    }));
+    let decorated = Some(RemoteConnectionOptions::Ssh(SshConnectionOptions {
+        host: "alpha.example.com".into(),
+        username: Some("deploy".to_string()),
+        port: Some(2222),
+        password: Some("secret".to_string()),
+        args: Some(vec!["-v".to_string()]),
+        connection_timeout: Some(30),
+        nickname: Some("work".to_string()),
+        upload_binary_over_ssh: true,
+        ..Default::default()
+    }));
+    assert!(remote::same_remote_connection_identity(
+        plain.as_ref(),
+        decorated.as_ref()
+    ));
+    assert_eq!(key(plain, &["/srv/app"]), key(decorated, &["/srv/app"]));
+}
+
+// The key is a pure function of the group: deriving it twice gives the same key.
+#[test]
+fn project_key_is_stable_for_the_same_group() {
+    assert_eq!(local(&["/a", "/b"]), local(&["/a", "/b"]));
+    assert_eq!(
+        key(ssh("alpha.example.com", None, None), &["/srv/app"]),
+        key(ssh("alpha.example.com", None, None), &["/srv/app"])
+    );
+}
+
+// Tech review L1 — the stored form itself is pinned, so a change in how the key is rendered (a
+// serde_json feature reordering object keys, a refactor) fails here instead of silently losing
+// every project's Manual mode on the next start.
+#[test]
+fn project_key_stored_form_is_pinned() {
+    assert_eq!(local(&["/b", "/a"]).0.as_ref(), r#"[null,["/a","/b"]]"#);
+    assert_eq!(
+        key(
+            ssh("alpha.example.com", Some("deploy"), Some(2222)),
+            &["/srv/app"]
+        )
+        .0
+        .as_ref(),
+        r#"[["ssh","alpha.example.com","deploy",2222],["/srv/app"]]"#
+    );
+    assert_eq!(
+        key(wsl("Ubuntu", None), &["/home/u"]).0.as_ref(),
+        r#"[["wsl","Ubuntu",null],["/home/u"]]"#
+    );
+}
diff --git a/crates/agent_ui/src/thread_organization/store_admission_tests.rs b/crates/agent_ui/src/thread_organization/store_admission_tests.rs
new file mode 100644
index 0000000..a418330
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/store_admission_tests.rs
@@ -0,0 +1,329 @@
+// Story 031, task 3.4 — the sub-thread parent link and what the store accepts
+// (R1.6, R6.1–R6.3, R7.1–R7.5, Q4, Q12).
+//
+// Materialize with, in `src/thread_organization.rs` (with `test_helpers`):
+//     #[cfg(test)]
+//     #[path = "thread_organization/store_admission_tests.rs"]
+//     mod store_admission;
+// Filter: `cargo test -p agent_ui thread_organization::store_admission`.
+//
+// Threads are created through upstream's real `ThreadMetadataStore`: a draft is a known thread
+// with no session; an unknown thread is a `ThreadId` that store never saw.
+
+use gpui::{Entity, TestAppContext};
+
+use super::test_helpers::*;
+use super::{ForkKind, OrganizeError, SortMode, ThreadOrganizationDb, ThreadOrganizationStore};
+use crate::thread_metadata_store::ThreadId;
+
+fn children(
+    store: &Entity<ThreadOrganizationStore>,
+    parent: ThreadId,
+    cx: &TestAppContext,
+) -> Vec<ThreadId> {
+    let mut children = store.read_with(cx, |store, _| store.children(parent));
+    children.sort_by_key(|id| id.to_key_string());
+    children
+}
+
+fn sorted(mut ids: Vec<ThreadId>) -> Vec<ThreadId> {
+    ids.sort_by_key(|id| id.to_key_string());
+    ids
+}
+
+fn parent_of(
+    store: &Entity<ThreadOrganizationStore>,
+    child: ThreadId,
+    cx: &TestAppContext,
+) -> Option<(ThreadId, ForkKind)> {
+    store.read_with(cx, |store, _| store.parent(child))
+}
+
+/// Nothing at all is stored for `thread_id` in any of the store's tables.
+fn nothing_on_disk_for(db: &ThreadOrganizationDb, thread_id: ThreadId) {
+    assert_eq!(rows_of(db, "thread_organization", thread_id), 0);
+    assert_eq!(rows_of(db, "thread_tags", thread_id), 0);
+}
+
+// R6.1, R1.6 — a sub-thread reports its parent and kind and is listed among the parent's
+// sub-threads; another thread's children do not leak in; both kinds survive a restart.
+#[gpui::test]
+async fn store_admission_records_a_parent_link_with_its_kind(cx: &mut TestAppContext) {
+    init(cx);
+    let (parent, with_context, clean) = (thread(cx), thread(cx), thread(cx));
+    let (other_parent, other_child) = (thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_admission_parent").await;
+    let store = open_store(&db, cx);
+
+    store.update(cx, |store, cx| {
+        store
+            .set_parent(with_context, parent, ForkKind::WithContext, cx)
+            .unwrap();
+        store
+            .set_parent(clean, parent, ForkKind::Clean, cx)
+            .unwrap();
+        store
+            .set_parent(other_child, other_parent, ForkKind::Clean, cx)
+            .unwrap();
+    });
+
+    let check = |store: &Entity<ThreadOrganizationStore>, cx: &TestAppContext| {
+        assert_eq!(
+            parent_of(store, with_context, cx),
+            Some((parent, ForkKind::WithContext))
+        );
+        assert_eq!(parent_of(store, clean, cx), Some((parent, ForkKind::Clean)));
+        assert_eq!(
+            children(store, parent, cx),
+            sorted(vec![with_context, clean])
+        );
+        assert_eq!(children(store, other_parent, cx), vec![other_child]);
+        assert_eq!(
+            parent_of(store, parent, cx),
+            None,
+            "the parent has no parent"
+        );
+        assert!(children(store, with_context, cx).is_empty());
+    };
+    check(&store, cx);
+    let store = restart(store, &db, cx);
+    check(&store, cx);
+}
+
+// R6.2, R6.3 — a second parent and a thread as its own parent are refused; the existing link is
+// unchanged.
+#[gpui::test]
+async fn store_admission_refuses_a_second_parent_and_a_self_parent(cx: &mut TestAppContext) {
+    init(cx);
+    let (parent, other, child) = (thread(cx), thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_admission_parent_rules").await;
+    let store = open_store(&db, cx);
+    store
+        .update(cx, |store, cx| {
+            store.set_parent(child, parent, ForkKind::Clean, cx)
+        })
+        .unwrap();
+
+    let second = store.update(cx, |store, cx| {
+        store.set_parent(child, other, ForkKind::WithContext, cx)
+    });
+    assert!(
+        matches!(second, Err(OrganizeError::AlreadyHasParent { .. })),
+        "{second:?}"
+    );
+    let own = store.update(cx, |store, cx| {
+        store.set_parent(other, other, ForkKind::Clean, cx)
+    });
+    assert!(
+        matches!(own, Err(OrganizeError::SelfParent { .. })),
+        "{own:?}"
+    );
+
+    assert_eq!(
+        parent_of(&store, child, cx),
+        Some((parent, ForkKind::Clean))
+    );
+    assert_eq!(parent_of(&store, other, cx), None);
+    assert!(children(&store, other, cx).is_empty());
+}
+
+// R7.1, R7.4 (hostile half first: a refused write must not be applied in PART) — a manual order
+// mixing an accepted thread with a draft stores nothing for either; then every kind of write on
+// a draft is refused with Draft, emits nothing, and leaves memory and disk empty for it.
+#[gpui::test]
+async fn store_admission_refuses_every_write_on_a_draft_and_stores_nothing(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let accepted = thread_in(PROJECT_A, cx);
+    let draft = draft_in(PROJECT_A, cx);
+    let parent = thread_in(PROJECT_A, cx);
+    let db = open_db("thread_organization_store_admission_draft").await;
+    let store = open_store(&db, cx);
+    let list = store.update(cx, |store, cx| store.create_list("Inbox", cx).unwrap());
+    let changes = count_changes(&store, cx);
+
+    let mixed = store.update(cx, |store, cx| {
+        store.set_manual_order(project(&[PROJECT_A]), &[accepted, draft], cx)
+    });
+    assert!(
+        matches!(mixed, Err(OrganizeError::Draft { .. })),
+        "{mixed:?}"
+    );
+    store.read_with(cx, |store, _| {
+        assert_eq!(
+            store.sort_mode(&project(&[PROJECT_A])),
+            SortMode::Recent,
+            "the refused order did not flip the project"
+        );
+        assert_eq!(store.manual_position(accepted), None, "nor half-applied");
+    });
+
+    store.update(cx, |store, cx| {
+        let results = [
+            ("pin", store.pin(draft, cx)),
+            ("set_list", store.set_list(draft, Some(list), cx)),
+            ("add_tag", store.add_tag(draft, "draft-tag", cx)),
+            (
+                "set_parent",
+                store.set_parent(draft, parent, ForkKind::Clean, cx),
+            ),
+        ];
+        for (write, result) in results {
+            assert!(
+                matches!(result, Err(OrganizeError::Draft { .. })),
+                "{write} on a draft: {result:?}"
+            );
+        }
+    });
+
+    assert_eq!(changes.get(), 0, "refused writes emit no event");
+    assert!(!has_organization(&store, draft, cx));
+    assert!(pinned(&store, cx).is_empty());
+    assert!(in_list(&store, list, cx).is_empty());
+    assert!(
+        known_tags(&store, cx).is_empty(),
+        "the refused tag is not offered"
+    );
+    assert!(children(&store, parent, cx).is_empty());
+
+    cx.run_until_parked();
+    nothing_on_disk_for(&db, draft);
+    nothing_on_disk_for(&db, accepted);
+    assert_eq!(count(&db, "SELECT COUNT(*) FROM project_sort_mode"), 0);
+    assert_eq!(count(&db, "SELECT COUNT(*) FROM tags"), 0);
+
+    let store = restart(store, &db, cx);
+    assert!(!has_organization(&store, draft, cx));
+    assert!(pinned(&store, cx).is_empty());
+}
+
+// R7.2 — once the draft's first message gives it a session, the SAME ThreadId is organizable.
+#[gpui::test]
+async fn store_admission_accepts_a_draft_once_it_has_a_message(cx: &mut TestAppContext) {
+    init(cx);
+    let draft = draft_in(PROJECT_A, cx);
+    let db = open_db("thread_organization_store_admission_promoted").await;
+    let store = open_store(&db, cx);
+    let refused = store.update(cx, |store, cx| store.pin(draft, cx));
+    assert!(
+        matches!(refused, Err(OrganizeError::Draft { .. })),
+        "{refused:?}"
+    );
+
+    send_first_message(draft, cx);
+
+    store.update(cx, |store, cx| {
+        store
+            .pin(draft, cx)
+            .expect("the promoted thread can be pinned");
+        store.add_tag(draft, "promoted", cx).expect("and tagged");
+    });
+    assert_eq!(pinned(&store, cx), vec![draft]);
+    let store = restart(store, &db, cx);
+    assert_eq!(pinned(&store, cx), vec![draft]);
+    assert_eq!(tag_displays(&store, draft, cx), ["promoted"]);
+}
+
+// R7.3 — a ThreadId Zeo does not know is refused as the subject of any write, and as a parent.
+#[gpui::test]
+async fn store_admission_refuses_a_thread_zeo_does_not_know(cx: &mut TestAppContext) {
+    init(cx);
+    let known = thread(cx);
+    let unknown = ThreadId::new();
+    let db = open_db("thread_organization_store_admission_unknown").await;
+    let store = open_store(&db, cx);
+    let list = store.update(cx, |store, cx| store.create_list("Inbox", cx).unwrap());
+
+    store.update(cx, |store, cx| {
+        let results = [
+            ("pin", store.pin(unknown, cx)),
+            ("set_list", store.set_list(unknown, Some(list), cx)),
+            ("add_tag", store.add_tag(unknown, "ghost", cx)),
+            (
+                "set_manual_order",
+                store.set_manual_order(project(&[PROJECT_A]), &[unknown], cx),
+            ),
+            (
+                "set_parent child",
+                store.set_parent(unknown, known, ForkKind::Clean, cx),
+            ),
+            (
+                "set_parent parent",
+                store.set_parent(known, unknown, ForkKind::Clean, cx),
+            ),
+        ];
+        for (write, result) in results {
+            assert!(
+                matches!(result, Err(OrganizeError::UnknownThread { .. })),
+                "{write} naming an unknown thread: {result:?}"
+            );
+        }
+    });
+    assert!(!has_organization(&store, unknown, cx));
+    assert_eq!(parent_of(&store, known, cx), None);
+    assert!(known_tags(&store, cx).is_empty());
+    cx.run_until_parked();
+    nothing_on_disk_for(&db, unknown);
+}
+
+// R7.4 — refused writes on an ORGANIZED thread leave every reported value as it was, emit
+// nothing, and leave disk as it was (checked after a restart).
+#[gpui::test]
+async fn store_admission_a_refused_write_changes_neither_memory_nor_disk(cx: &mut TestAppContext) {
+    init(cx);
+    let (t, parent, other) = (thread_in(PROJECT_A, cx), thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_admission_unchanged").await;
+    let store = open_store(&db, cx);
+    let gone = store.update(cx, |store, cx| {
+        let list = store.create_list("Kept", cx).unwrap();
+        let gone = store.create_list("Gone", cx).unwrap();
+        store.pin(t, cx).unwrap();
+        store.set_list(t, Some(list), cx).unwrap();
+        store.add_tag(t, "Rust", cx).unwrap();
+        store
+            .set_parent(t, parent, ForkKind::WithContext, cx)
+            .unwrap();
+        store
+            .set_manual_order(project(&[PROJECT_A]), &[t], cx)
+            .unwrap();
+        store.delete_list(gone, cx).unwrap();
+        gone
+    });
+    let before = reported(&store, t, cx);
+    let changes = count_changes(&store, cx);
+
+    store.update(cx, |store, cx| {
+        assert!(store.add_tag(t, "two words", cx).is_err());
+        assert!(store.set_list(t, Some(gone), cx).is_err());
+        assert!(store.set_parent(t, other, ForkKind::Clean, cx).is_err());
+        assert!(store.set_parent(t, t, ForkKind::Clean, cx).is_err());
+    });
+    assert_eq!(reported(&store, t, cx), before);
+    assert_eq!(changes.get(), 0);
+
+    let store = restart(store, &db, cx);
+    assert_eq!(reported(&store, t, cx), before);
+}
+
+// R7.5 — an archived thread can be organized.
+#[gpui::test]
+async fn store_admission_accepts_an_archived_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let (archived, parent) = (thread(cx), thread(cx));
+    archive(archived, cx);
+    let db = open_db("thread_organization_store_admission_archived").await;
+    let store = open_store(&db, cx);
+
+    store.update(cx, |store, cx| {
+        store.pin(archived, cx).expect("pin an archived thread");
+        store
+            .add_tag(archived, "later", cx)
+            .expect("tag an archived thread");
+        store
+            .set_parent(archived, parent, ForkKind::Clean, cx)
+            .expect("give an archived thread a parent");
+    });
+    assert_eq!(pinned(&store, cx), vec![archived]);
+    assert_eq!(tag_displays(&store, archived, cx), ["later"]);
+}
diff --git a/crates/agent_ui/src/thread_organization/store_clear_list_tests.rs b/crates/agent_ui/src/thread_organization/store_clear_list_tests.rs
new file mode 100644
index 0000000..a787b94
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/store_clear_list_tests.rs
@@ -0,0 +1,321 @@
+// Story 032, task 2.1 — deleting a list clears it from every stored row, including a row this
+// build skipped at load (R7.1, R7.2, Q4).
+//
+// Materialize with, in `src/thread_organization.rs` (beside the other test modules, after
+// `test_helpers`):
+//     #[cfg(test)]
+//     #[path = "thread_organization/store_clear_list_tests.rs"]
+//     mod store_clear_list;
+// Filter: `cargo test -p agent_ui --lib thread_organization::store_clear_list`.
+//
+// A "skipped row" is the one story 031 defines (R9.5 there): a stored row carrying a value this
+// build does not recognize — here `fork_kind = 'sideways'`, written with CHECK constraints off as a
+// newer schema step could. The store does not load it, so only a statement run against the table
+// can reach it.
+//
+// Hostile halves first: a skipped row of ANOTHER list must keep its list (the clear must not fire
+// on it), and every other column of the skipped row must survive (the clear must not widen into a
+// row reset or a delete). Only then the benign case: the deleted list's own skipped row loses it.
+
+use gpui::TestAppContext;
+
+use super::test_helpers::*;
+use super::{ListId, ThreadOrganizationDb, ThreadOrganizationStore};
+use crate::thread_metadata_store::ThreadId;
+
+/// Every column of one `thread_organization` row, as stored.
+#[derive(Debug, PartialEq)]
+struct StoredRow {
+    pinned_position: Option<i64>,
+    manual_position: Option<i64>,
+    manual_project_key: Option<String>,
+    list_id: Option<i64>,
+    /// Lowercase hex of the stored BLOB.
+    parent_thread_id: Option<String>,
+    fork_kind: Option<String>,
+}
+
+fn hex(thread_id: ThreadId) -> String {
+    thread_id.to_key_string().replace('-', "")
+}
+
+/// Runs `sql` with CHECK constraints off, as a newer schema step could have written it.
+async fn write_unchecked(db: &ThreadOrganizationDb, sql: String) {
+    db.write(move |connection| {
+        for statement in [
+            "PRAGMA ignore_check_constraints = ON",
+            sql.as_str(),
+            "PRAGMA ignore_check_constraints = OFF",
+        ] {
+            connection
+                .exec(statement)
+                .unwrap_or_else(|error| panic!("{statement} should prepare: {error:?}"))(
+            )
+            .unwrap_or_else(|error| panic!("{statement} should run: {error:?}"));
+        }
+    })
+    .await;
+}
+
+/// A row as a newer Zeo could have written it: every column set, and a `fork_kind` this build
+/// does not recognize.
+async fn insert_skipped_row(
+    db: &ThreadOrganizationDb,
+    thread_id: ThreadId,
+    parent: ThreadId,
+    list: ListId,
+    pinned_position: i64,
+) {
+    write_unchecked(
+        db,
+        format!(
+            "INSERT INTO thread_organization \
+             (thread_id, pinned_position, manual_position, manual_project_key, list_id, \
+              parent_thread_id, fork_kind) \
+             VALUES (X'{}', {pinned_position}, 7, 'a-newer-builds-project-key', {}, X'{}', \
+              'sideways')",
+            hex(thread_id),
+            list.0,
+            hex(parent),
+        ),
+    )
+    .await;
+}
+
+fn stored_row(db: &ThreadOrganizationDb, thread_id: ThreadId) -> Option<StoredRow> {
+    db.select_row_bound::<ThreadId, (
+        Option<i64>,
+        Option<i64>,
+        Option<String>,
+        Option<i64>,
+        Option<String>,
+        Option<String>,
+    )>(
+        "SELECT pinned_position, manual_position, manual_project_key, list_id, \
+         lower(hex(parent_thread_id)), fork_kind FROM thread_organization WHERE thread_id = ?",
+    )
+    .expect("select should prepare")(thread_id)
+    .expect("select should run")
+    .map(
+        |(pinned_position, manual_position, manual_project_key, list_id, parent, fork_kind)| {
+            StoredRow {
+                pinned_position,
+                manual_position,
+                manual_project_key,
+                list_id,
+                parent_thread_id: parent,
+                fork_kind,
+            }
+        },
+    )
+}
+
+fn list_rows(db: &ThreadOrganizationDb, list: ListId) -> i64 {
+    count(
+        db,
+        &format!("SELECT COUNT(*) FROM thread_lists WHERE id = {}", list.0),
+    )
+}
+
+/// Two lists on disk, a skipped row in each, a loaded thread in the first, and an unrecognized
+/// sort-mode row; the store is restarted after the raw inserts so it skips both rows at load.
+struct Fixture {
+    db: ThreadOrganizationDb,
+    store: gpui::Entity<ThreadOrganizationStore>,
+    doomed: ListId,
+    other: ListId,
+    parent: ThreadId,
+    skipped_in_doomed: ThreadId,
+    skipped_in_other: ThreadId,
+    loaded_in_doomed: ThreadId,
+}
+
+async fn fixture(name: &'static str, cx: &mut TestAppContext) -> Fixture {
+    init(cx);
+    let parent = thread(cx);
+    let skipped_in_doomed = thread(cx);
+    let skipped_in_other = thread(cx);
+    let loaded_in_doomed = thread(cx);
+    let db = open_db(name).await;
+    let store = open_store(&db, cx);
+    let (doomed, other) = store.update(cx, |store, cx| {
+        let doomed = store.create_list("Doomed", cx).expect("first list");
+        let other = store.create_list("Other", cx).expect("second list");
+        store
+            .set_list(loaded_in_doomed, Some(doomed), cx)
+            .expect("a loaded thread joins the doomed list");
+        (doomed, other)
+    });
+    cx.run_until_parked();
+
+    insert_skipped_row(&db, skipped_in_doomed, parent, doomed, 3).await;
+    insert_skipped_row(&db, skipped_in_other, parent, other, 4).await;
+    write_unchecked(
+        &db,
+        "INSERT INTO project_sort_mode (project_key, mode) \
+         VALUES ('a-newer-builds-project-key', 'by_tag')"
+            .to_string(),
+    )
+    .await;
+    let store = restart(store, &db, cx);
+    assert!(
+        !has_organization(&store, skipped_in_doomed, cx)
+            && !has_organization(&store, skipped_in_other, cx),
+        "fixture: both rows carry an unrecognized fork_kind, so this build skips them at load"
+    );
+    assert_eq!(
+        in_list(&store, doomed, cx),
+        vec![loaded_in_doomed],
+        "fixture: the loaded thread is in the doomed list"
+    );
+
+    Fixture {
+        db,
+        store,
+        doomed,
+        other,
+        parent,
+        skipped_in_doomed,
+        skipped_in_other,
+        loaded_in_doomed,
+    }
+}
+
+// R7.1/R7.2 hostile half — the clear must not fire on a skipped row of ANOTHER list, and a skipped
+// row of the deleted list must not be deleted or reset: every column but `list_id` stays,
+// including the parent link and the unrecognized `fork_kind` a newer build owns; the unrecognized
+// `project_sort_mode` row is untouched.
+#[gpui::test]
+async fn store_clear_list_leaves_other_lists_and_every_other_column_alone(cx: &mut TestAppContext) {
+    let f = fixture("thread_organization_store_clear_list_hostile", cx).await;
+
+    f.store
+        .update(cx, |store, cx| store.delete_list(f.doomed, cx))
+        .expect("deleting a known list succeeds");
+    cx.run_until_parked();
+
+    assert_eq!(
+        stored_row(&f.db, f.skipped_in_other),
+        Some(StoredRow {
+            pinned_position: Some(4),
+            manual_position: Some(7),
+            manual_project_key: Some("a-newer-builds-project-key".into()),
+            list_id: Some(f.other.0),
+            parent_thread_id: Some(hex(f.parent)),
+            fork_kind: Some("sideways".into()),
+        }),
+        "a skipped row of another list keeps that list and everything else"
+    );
+    assert_eq!(
+        stored_row(&f.db, f.skipped_in_doomed),
+        Some(StoredRow {
+            pinned_position: Some(3),
+            manual_position: Some(7),
+            manual_project_key: Some("a-newer-builds-project-key".into()),
+            list_id: None,
+            parent_thread_id: Some(hex(f.parent)),
+            fork_kind: Some("sideways".into()),
+        }),
+        "the skipped row of the deleted list is updated, never deleted: only list_id changes"
+    );
+    assert_eq!(
+        strings(
+            &f.db,
+            "SELECT mode FROM project_sort_mode WHERE project_key = 'a-newer-builds-project-key'"
+        ),
+        vec!["by_tag".to_string()],
+        "an unrecognized sort-mode row is not touched by a list delete"
+    );
+    assert_eq!(list_rows(&f.db, f.other), 1, "the other list stays");
+}
+
+// R7.1 benign half — the deleted list is gone from the skipped row on disk, from the loaded thread
+// in memory and on disk, and from the lists table; after a restart nothing names it.
+#[gpui::test]
+async fn store_clear_list_clears_the_deleted_list_from_a_skipped_row(cx: &mut TestAppContext) {
+    let f = fixture("thread_organization_store_clear_list_benign", cx).await;
+
+    f.store
+        .update(cx, |store, cx| store.delete_list(f.doomed, cx))
+        .expect("deleting a known list succeeds");
+    cx.run_until_parked();
+
+    assert_eq!(
+        stored_row(&f.db, f.skipped_in_doomed).map(|row| row.list_id),
+        Some(None),
+        "the skipped row no longer names the deleted list"
+    );
+    assert_eq!(
+        count(
+            &f.db,
+            &format!(
+                "SELECT COUNT(*) FROM thread_organization WHERE list_id = {}",
+                f.doomed.0
+            )
+        ),
+        0,
+        "no stored row names the deleted list"
+    );
+    assert_eq!(list_rows(&f.db, f.doomed), 0);
+    assert_eq!(
+        reported(&f.store, f.loaded_in_doomed, cx).list_id,
+        None,
+        "the loaded thread leaves the list in memory, as before this fix"
+    );
+
+    let store = restart(f.store, &f.db, cx);
+    assert_eq!(list_ids(&store, cx), vec![f.other]);
+    assert_eq!(reported(&store, f.loaded_in_doomed, cx).list_id, None);
+}
+
+// design.md "Change::ClearList" — the clear and the list delete are one write: when the clear
+// cannot be applied, the list row stays on disk too (no list deleted while a row still names it),
+// and the existing writer logs the operation and the list id, never the list's name.
+#[gpui::test]
+async fn store_clear_list_commits_with_the_list_delete_or_not_at_all(cx: &mut TestAppContext) {
+    let f = fixture("thread_organization_store_clear_list_atomic", cx).await;
+    // The loaded member leaves the list first (its now-empty row is deleted, not updated), so the
+    // only UPDATE of thread_organization the list delete can issue is the clear of the skipped row.
+    f.store
+        .update(cx, |store, cx| store.set_list(f.loaded_in_doomed, None, cx))
+        .expect("leaving a list succeeds");
+    cx.run_until_parked();
+    run_sql(
+        &f.db,
+        "CREATE TRIGGER refuse_row_updates BEFORE UPDATE ON thread_organization \
+         BEGIN SELECT RAISE(ABORT, 'sabotaged by the test'); END"
+            .to_string(),
+    )
+    .await;
+    capture_logs();
+
+    f.store
+        .update(cx, |store, cx| store.delete_list(f.doomed, cx))
+        .expect("the in-memory delete succeeds; the disk write fails later");
+    cx.run_until_parked();
+
+    assert_eq!(
+        list_rows(&f.db, f.doomed),
+        1,
+        "the list row is kept when the clear of a skipped row fails in the same write"
+    );
+    assert_eq!(
+        stored_row(&f.db, f.skipped_in_doomed).map(|row| row.list_id),
+        Some(Some(f.doomed.0)),
+        "the skipped row is unchanged by the failed write"
+    );
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("delete_list")
+                && line.contains(&format!("list {}", f.doomed.0))),
+        "the failed write is logged with its operation and list id: {errors:?}"
+    );
+    assert!(
+        all_lines_lowercased()
+            .iter()
+            .all(|line| !line.contains("doomed")),
+        "a list's name never reaches a log line"
+    );
+}
