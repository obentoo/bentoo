+// design.md "Writes" — set_sort_mode(Manual) switches the project to Manual and keeps whatever
+// positions it has; on a project with none it is Ok and reports Manual with no position.
+#[gpui::test]
+async fn store_order_set_manual_mode_keeps_positions(cx: &mut TestAppContext) {
