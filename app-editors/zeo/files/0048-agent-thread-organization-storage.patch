+
+// R4.1, R4.7, R1.3 — lists are appended last, can be renamed and reordered densely (an index past
+// the end means last), and names and order survive a restart.
+#[gpui::test]
+async fn store_lists_tags_lists_append_rename_reorder_and_survive_restart(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("thread_organization_store_lists_tags_lists").await;
+    let store = open_store(&db, cx);
+
+    let (personal, work, reading) = store.update(cx, |store, cx| {
+        (
+            store.create_list("Personal", cx).unwrap(),
+            store.create_list("Work", cx).unwrap(),
+            store.create_list("Reading", cx).unwrap(),
+        )
+    });
+    assert_eq!(list_names(&store, cx), ["Personal", "Work", "Reading"]);
+    assert_ne!(personal, work);
+    assert_ne!(work, reading);
+
+    store.update(cx, |store, cx| {
+        store.rename_list(work, "Day job", cx).unwrap();
+        store.move_list(reading, 0, cx).unwrap();
+    });
+    assert_eq!(list_names(&store, cx), ["Reading", "Personal", "Day job"]);
+    store
+        .update(cx, |store, cx| store.move_list(reading, 99, cx))
+        .unwrap();
+    assert_eq!(list_names(&store, cx), ["Personal", "Day job", "Reading"]);
+    assert_eq!(list_ids(&store, cx), vec![personal, work, reading]);
+
+    cx.run_until_parked();
+    let positions: Vec<i64> = db
+        .select::<i64>("SELECT position FROM thread_lists ORDER BY position")
+        .expect("select")()
+    .expect("run");
+    assert_eq!(positions, vec![0, 1, 2], "list positions are dense on disk");
+
+    let store = restart(store, &db, cx);
+    assert_eq!(list_names(&store, cx), ["Personal", "Day job", "Reading"]);
+    assert_eq!(list_ids(&store, cx), vec![personal, work, reading]);
+}
+
+// R4.2, R4.3 (hostile half first) — names that differ by more than case are two lists; then an
+// empty or over-long name, and a name equal to another list's ignoring case (non-ASCII too, on
+// create and on rename), are refused with nothing changed and no event.
+#[gpui::test]
+async fn store_lists_tags_refuses_invalid_and_duplicate_list_names(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("thread_organization_store_lists_tags_list_names").await;
+    let store = open_store(&db, cx);
+
+    let work = store.update(cx, |store, cx| {
+        store.create_list("Rust", cx).unwrap();
+        store
+            .create_list("Rust projects", cx)
+            .expect("a longer name is another list");
+        store.create_list("Ação", cx).unwrap();
+        store.create_list("Work", cx).unwrap()
+    });
+    let before = list_names(&store, cx);
+    let changes = count_changes(&store, cx);
+
+    store.update(cx, |store, cx| {
+        for name in ["", "   ", &"a".repeat(65)] {
+            let result = store.create_list(name, cx);
+            assert!(
+                matches!(result, Err(OrganizeError::InvalidListName { .. })),
+                "{name:?}: {result:?}"
+            );
+        }
+        for name in ["rust", "RUST", "  Rust  ", "AÇÃO", "ação"] {
+            let result = store.create_list(name, cx);
+            assert!(
+                matches!(result, Err(OrganizeError::DuplicateListName { .. })),
+                "{name:?} equals an existing list ignoring case: {result:?}"
+            );
+        }
+        let result = store.rename_list(work, "rust projects", cx);
+        assert!(
+            matches!(result, Err(OrganizeError::DuplicateListName { .. })),
+            "renaming onto another list's name: {result:?}"
+        );
+        let result = store.rename_list(work, " ", cx);
+        assert!(
+            matches!(result, Err(OrganizeError::InvalidListName { .. })),
+            "{result:?}"
+        );
+    });
+    assert_eq!(
+        list_names(&store, cx),
+        before,
+        "a refused name changes nothing"
+    );
+    assert_eq!(changes.get(), 0, "a refused write emits no event");
+
+    let store = restart(store, &db, cx);
+    assert_eq!(list_names(&store, cx), before, "nor anything on disk");
+}
+
+// R4.4, R1.4 — a thread is in at most one list: putting it in another moves it; `None` takes it
+// out; membership survives a restart.
+#[gpui::test]
+async fn store_lists_tags_a_thread_is_in_one_list_at_a_time(cx: &mut TestAppContext) {
+    init(cx);
+    let (t, u) = (thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_lists_tags_membership").await;
+    let store = open_store(&db, cx);
+    let (first, second) = store.update(cx, |store, cx| {
+        (
+            store.create_list("First", cx).unwrap(),
+            store.create_list("Second", cx).unwrap(),
+        )
+    });
+
+    store.update(cx, |store, cx| {
+        store.set_list(t, Some(first), cx).unwrap();
+        store.set_list(u, Some(first), cx).unwrap();
+        store.set_list(t, Some(second), cx).unwrap();
+    });
+    assert_eq!(in_list(&store, first, cx), vec![u]);
+    assert_eq!(in_list(&store, second, cx), vec![t]);
+    assert_eq!(reported(&store, t, cx).list_id, Some(second));
+
+    let store = restart(store, &db, cx);
+    assert_eq!(in_list(&store, first, cx), vec![u]);
+    assert_eq!(in_list(&store, second, cx), vec![t]);
+
+    store
+        .update(cx, |store, cx| store.set_list(u, None, cx))
+        .unwrap();
+    assert!(in_list(&store, first, cx).is_empty());
+    assert_eq!(reported(&store, u, cx).list_id, None);
+}
+
+// R4.6 — a list that does not exist (here: one that was deleted) is refused, nothing changes.
+#[gpui::test]
+async fn store_lists_tags_refuses_an_unknown_list(cx: &mut TestAppContext) {
+    init(cx);
+    let t = thread(cx);
+    let db = open_db("thread_organization_store_lists_tags_unknown_list").await;
+    let store = open_store(&db, cx);
+    let (kept, gone) = store.update(cx, |store, cx| {
+        let kept = store.create_list("Kept", cx).unwrap();
+        let gone = store.create_list("Gone", cx).unwrap();
+        store.set_list(t, Some(kept), cx).unwrap();
+        store.delete_list(gone, cx).unwrap();
+        (kept, gone)
+    });
+
+    let result = store.update(cx, |store, cx| store.set_list(t, Some(gone), cx));
+    assert!(
+        matches!(result, Err(OrganizeError::UnknownList { .. })),
