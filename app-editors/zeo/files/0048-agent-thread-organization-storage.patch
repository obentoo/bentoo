+// Story 031, task 3.2 — pinned order and per-project Recent/Manual mode
+// (R1.1, R1.2, R2.1–R2.5, R3.1–R3.5, Q12).
+//
+// Materialize with, in `src/thread_organization.rs` (with `test_helpers`):
+//     #[cfg(test)]
+//     #[path = "thread_organization/store_order_tests.rs"]
+//     mod store_order;
+// Filter: `cargo test -p agent_ui thread_organization::store_order`.
+//
+// Threads live in real projects: `thread_in(PROJECT_A)` is a thread whose main worktree is
+// `/project-a`, and `project(&[PROJECT_A])` is that project's key.
+
+use gpui::TestAppContext;
