+
+    store.update(cx, |store, cx| {
+        store.pin(a, cx).unwrap();
+        store.pin(b, cx).unwrap();
+        store.pin(c, cx).unwrap();
+    });
+    assert_eq!(pinned(&store, cx), vec![c, b, a]);
+    assert_eq!(
+        pinned_positions(&store, &[c, b, a], cx),
+        vec![Some(0), Some(1), Some(2)]
+    );
+}
