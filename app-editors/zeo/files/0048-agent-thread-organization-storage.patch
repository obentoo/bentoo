+/// Everything the store reports about one thread, for "unchanged" comparisons.
+#[derive(Debug, PartialEq)]
+pub(super) struct Reported {
+    pub pinned_position: Option<u32>,
+    pub manual_position: Option<u32>,
+    pub list_id: Option<ListId>,
+    pub parent: Option<(ThreadId, ForkKind)>,
+    pub tags: Vec<(String, String)>,
+}
