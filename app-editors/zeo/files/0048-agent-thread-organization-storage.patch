+// R5.4 — a 21st tag is refused; R5.5's converse at the limit (hostile: must NOT refuse) —
+// re-adding a tag the thread already has is still a success when it has 20.
+#[gpui::test]
+async fn store_lists_tags_refuses_a_twenty_first_tag(cx: &mut TestAppContext) {
+    init(cx);
+    let t = thread(cx);
+    let db = open_db("thread_organization_store_lists_tags_limit").await;
+    let store = open_store(&db, cx);
+    store.update(cx, |store, cx| {
+        for n in 0..20 {
+            store.add_tag(t, &format!("tag{n}"), cx).unwrap();
+        }
+    });
+
+    let again = store.update(cx, |store, cx| store.add_tag(t, "TAG7", cx));
+    assert!(
+        again.is_ok(),
+        "a tag the thread already has is not a 21st: {again:?}"
+    );
+    let result = store.update(cx, |store, cx| store.add_tag(t, "tag20", cx));
+    assert!(
+        matches!(result, Err(OrganizeError::TooManyTags { .. })),
+        "{result:?}"
+    );
+    assert_eq!(tag_displays(&store, t, cx).len(), 20);
+    assert!(
+        !known_tags(&store, cx).iter().any(|(key, _)| key == "tag20"),
+        "the refused tag is not offered either"
+    );
+}
+
+// R5.6 — a tag stays known while any thread uses it and stops being offered when the last use
+// goes (removal matches case-insensitively), in memory and on disk; once gone, a new first
+// spelling is the display (the derived display is not resurrected).
+#[gpui::test]
+async fn store_lists_tags_last_use_removed_forgets_the_tag(cx: &mut TestAppContext) {
+    init(cx);
+    let (t, u) = (thread(cx), thread(cx));
+    let db = open_db("thread_organization_store_lists_tags_last_use").await;
+    let store = open_store(&db, cx);
+    store.update(cx, |store, cx| {
+        store.add_tag(t, "php", cx).unwrap();
+        store.add_tag(u, "php", cx).unwrap();
+        store.add_tag(u, "keep", cx).unwrap();
+    });
+
+    store
+        .update(cx, |store, cx| store.remove_tag(t, "PHP", cx))
+        .unwrap();
+    assert!(tag_displays(&store, t, cx).is_empty());
+    assert!(
+        known_tags(&store, cx).iter().any(|(key, _)| key == "php"),
+        "still used by u"
+    );
+
+    store
+        .update(cx, |store, cx| store.remove_tag(u, "php", cx))
+        .unwrap();
+    assert_eq!(
+        known_tags(&store, cx),
+        vec![("keep".to_string(), "keep".to_string())]
+    );
+    cx.run_until_parked();
+    assert_eq!(
+        strings(&db, "SELECT tag_key FROM tags ORDER BY tag_key"),
+        ["keep"]
+    );
+
+    let store = restart(store, &db, cx);
+    assert_eq!(
+        known_tags(&store, cx),
+        vec![("keep".to_string(), "keep".to_string())]
+    );
+    store
+        .update(cx, |store, cx| store.add_tag(t, "PHP", cx))
+        .unwrap();
+    assert_eq!(tag_displays(&store, t, cx), ["PHP"]);
+}
+
+// R9.4 — a failed write of a tag or a list is logged at error level naming the thread, and the
+// tag or list TEXT never reaches any log line.
+#[gpui::test]
+async fn store_lists_tags_failed_writes_never_log_tag_or_list_text(cx: &mut TestAppContext) {
+    init(cx);
+    let t = thread(cx);
+    let db = open_db("thread_organization_store_lists_tags_redaction").await;
+    let store = open_store(&db, cx);
+    let list = store.update(cx, |store, cx| store.create_list("Visible", cx).unwrap());
+    for table in ["thread_tags", "tags", "thread_lists"] {
+        sabotage(&db, table).await;
+    }
+    capture_logs();
+
+    store.update(cx, |store, cx| {
+        store.add_tag(t, "SecretTag", cx).unwrap();
+        store.create_list("Hidden List Name", cx).unwrap();
+        store.rename_list(list, "Private Rename", cx).unwrap();
