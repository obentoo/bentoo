+// R5.3 — an invalid tag is refused with nothing changed and no event.
+#[gpui::test]
+async fn store_lists_tags_refuses_an_invalid_tag(cx: &mut TestAppContext) {
+    init(cx);
+    let t = thread(cx);
+    let db = open_db("thread_organization_store_lists_tags_invalid_tag").await;
+    let store = open_store(&db, cx);
+    store
+        .update(cx, |store, cx| store.add_tag(t, "kept", cx))
+        .unwrap();
+    let changes = count_changes(&store, cx);
+
+    store.update(cx, |store, cx| {
