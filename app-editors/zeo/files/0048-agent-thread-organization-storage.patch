+
+    let errors = error_lines();
+    assert!(
+        errors.iter().any(|line| line.contains(&id_text(t))),
+        "the failed tag write names the thread: {errors:?}"
+    );
+    assert!(errors.len() >= 3, "each failed write is logged: {errors:?}");
+    for line in all_lines_lowercased() {
+        for text in ["secrettag", "hidden list name", "private rename"] {
