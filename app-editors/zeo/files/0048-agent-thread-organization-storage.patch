diff --git a/crates/agent_ui/src/thread_organization.rs b/crates/agent_ui/src/thread_organization.rs
new file mode 100644
index 0000000..fc86555
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization.rs
@@ -0,0 +1,1374 @@
+//! How the user organized their threads: pinned order, a per-project manual order, lists, tags
+//! and a sub-thread's parent link.
+//!
+//! This lives in a `sqlez` domain of its own rather than in `ThreadMetadataDb`, because migrations
+//! are positional per domain and a changed step aborts startup ("Migration changed for {domain} at
+//! step {index}"): a step appended to upstream's list would be overtaken by upstream's next one.
+//! The list below is append-only — never edit a step that has shipped.
+//!
+//! The store loads every row once and answers from memory; writes go to disk in order through one
+//! background writer. Upstream calls [`forget`] from `ThreadMetadataStore::delete`, the funnel of
+//! every thread deletion.
+
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+use std::fmt;
+use std::sync::atomic::Ordering;
+
+use anyhow::{Context as _, Result};
+use db::{
+    sqlez::{domain::Domain, thread_safe_connection::ThreadSafeConnection},
+    sqlez_macros::sql,
+};
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{App, AppContext as _, Context, Entity, EventEmitter, Global, SharedString, Task};
+use project::ProjectGroupKey;
+use remote::{RemoteConnectionIdentity, RemoteConnectionOptions, remote_connection_identity};
+
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+const MAX_TAG_CHARS: usize = 32;
+const MAX_LIST_NAME_CHARS: usize = 64;
+const MAX_TAGS_PER_THREAD: usize = 20;
+
+struct ThreadOrganizationDb(ThreadSafeConnection);
+
+// One `static` so the list registered with `inventory` and `MIGRATIONS` are the same allocation.
+// A plain string rather than `sql!`: the CHECK constraints need single-quoted string literals,
+// which are not Rust tokens.
+static ORGANIZATION_MIGRATIONS: [&str; 1] = ["CREATE TABLE thread_organization(
+    thread_id BLOB PRIMARY KEY NOT NULL,
+    pinned_position INTEGER,
+    manual_position INTEGER,
+    manual_project_key TEXT,
+    list_id INTEGER,
+    parent_thread_id BLOB,
+    fork_kind TEXT CHECK (fork_kind IN ('with_context', 'clean'))
+) STRICT;
+CREATE INDEX thread_organization_list ON thread_organization(list_id);
+CREATE INDEX thread_organization_parent ON thread_organization(parent_thread_id);
+CREATE TABLE thread_lists(
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    name TEXT NOT NULL,
+    name_key TEXT NOT NULL UNIQUE,
+    position INTEGER NOT NULL
+) STRICT;
+CREATE TABLE thread_tags(
+    thread_id BLOB NOT NULL,
+    tag_key TEXT NOT NULL,
+    PRIMARY KEY(thread_id, tag_key)
+) STRICT;
+CREATE TABLE tags(
+    tag_key TEXT PRIMARY KEY NOT NULL,
+    display TEXT NOT NULL
+) STRICT;
+CREATE TABLE project_sort_mode(
+    project_key TEXT PRIMARY KEY NOT NULL,
+    mode TEXT NOT NULL CHECK (mode IN ('manual'))
+) STRICT;"];
+
+impl Domain for ThreadOrganizationDb {
+    const NAME: &str = stringify!(ThreadOrganizationDb);
+    const MIGRATIONS: &[&str] = &ORGANIZATION_MIGRATIONS;
+}
+
+db::static_connection!(ThreadOrganizationDb, []);
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ThreadOrganization {
+    pub pinned_position: Option<u32>,
+    /// Read through [`ThreadOrganizationStore::manual_position_in`]: a position only means
+    /// something in the project it was given in.
+    manual_position: Option<u32>,
+    pub list_id: Option<ListId>,
+    pub parent: Option<(ThreadId, ForkKind)>,
+    /// The project `manual_position` belongs to, so going back to Recent finds the position even
+    /// when the thread's folders changed since.
+    manual_project: Option<ProjectKey>,
+}
+
+impl ThreadOrganization {
+    fn is_empty(&self) -> bool {
+        self.pinned_position.is_none()
+            && self.manual_position.is_none()
+            && self.list_id.is_none()
+            && self.parent.is_none()
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SortMode {
+    Recent,
+    Manual,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum ForkKind {
+    WithContext,
+    Clean,
+}
+
+impl ForkKind {
+    fn as_str(self) -> &'static str {
+        match self {
+            ForkKind::WithContext => "with_context",
+            ForkKind::Clean => "clean",
+        }
+    }
+
+    fn parse(text: &str) -> Option<Self> {
+        match text {
+            "with_context" => Some(ForkKind::WithContext),
+            "clean" => Some(ForkKind::Clean),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct ListId(i64);
+
+impl fmt::Display for ListId {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}", self.0)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ThreadList {
+    pub id: ListId,
+    pub name: SharedString,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Tag {
+    /// The normalized form: identity, and what a `#tag` filter matches.
+    pub key: SharedString,
+    /// The first spelling ever typed for this key.
+    pub display: SharedString,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct ProjectKey(SharedString);
+
+impl ProjectKey {
+    /// JSON rather than a separator-joined string: a folder whose name holds the separator would
+    /// otherwise collide with two folders, and a remote host with the local marker.
+    pub fn from_group(group: &ProjectGroupKey) -> Self {
+        let host = group.host().map(|options| host_identity(&options));
+        let mut paths: Vec<String> = group
+            .path_list()
+            .paths()
+            .iter()
+            .map(|path| path.to_string_lossy().into_owned())
+            .collect();
+        paths.sort();
+        Self(serde_json::json!([host, paths]).to_string().into())
+    }
+}
+
+/// Built from exactly the fields `remote::same_remote_connection_identity` compares, so a
+/// nickname or a password never makes the same host a second project.
+fn host_identity(options: &RemoteConnectionOptions) -> serde_json::Value {
+    // Arrays, not objects: an object's key order depends on serde_json's `preserve_order`
+    // feature, and a key that changed with a feature flag would silently lose every remote
+    // project's Manual mode.
+    match remote_connection_identity(options) {
+        RemoteConnectionIdentity::Ssh {
+            host,
+            username,
+            port,
+        } => serde_json::json!(["ssh", host, username, port]),
+        RemoteConnectionIdentity::Wsl { distro_name, user } => {
+            serde_json::json!(["wsl", distro_name, user])
+        }
+        RemoteConnectionIdentity::Docker {
+            container_id,
+            name,
+            remote_user,
+        } => serde_json::json!(["docker", container_id, name, remote_user]),
+        // Only the test-support `Mock` variant reaches this arm; which builds have it depends on
+        // `remote`'s features, so a `cfg` here could not match them reliably.
+        #[allow(unreachable_patterns)]
+        other => serde_json::json!(["other", other.persistence_key()]),
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum OrganizeError {
+    Draft { thread_id: ThreadId },
+    UnknownThread { thread_id: ThreadId },
+    UnknownList { list_id: ListId },
+    InvalidListName,
+    DuplicateListName { list_id: ListId },
+    InvalidTag,
+    TooManyTags { thread_id: ThreadId },
+    AlreadyHasParent { thread_id: ThreadId },
+    SelfParent { thread_id: ThreadId },
+}
+
+// Names ids only: tag and list text is the user's and never reaches an error or a log line.
+impl fmt::Display for OrganizeError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            OrganizeError::Draft { thread_id } => write!(
+                formatter,
+                "thread {} has no message yet and cannot be organized",
+                thread_id.to_key_string()
+            ),
+            OrganizeError::UnknownThread { thread_id } => {
+                write!(formatter, "thread {} is unknown", thread_id.to_key_string())
+            }
+            OrganizeError::UnknownList { list_id } => {
+                write!(formatter, "list {list_id} is unknown")
+            }
+            OrganizeError::InvalidListName => write!(
+                formatter,
+                "a list name must be 1 to {MAX_LIST_NAME_CHARS} characters"
+            ),
+            OrganizeError::DuplicateListName { list_id } => {
+                write!(formatter, "list {list_id} already has this name")
+            }
+            OrganizeError::InvalidTag => write!(
+                formatter,
+                "a tag must be 1 to {MAX_TAG_CHARS} characters with no space, '#' or ','"
+            ),
+            OrganizeError::TooManyTags { thread_id } => write!(
+                formatter,
+                "thread {} already has {MAX_TAGS_PER_THREAD} tags",
+                thread_id.to_key_string()
+            ),
+            OrganizeError::AlreadyHasParent { thread_id } => write!(
+                formatter,
+                "thread {} already has a parent",
+                thread_id.to_key_string()
+            ),
+            OrganizeError::SelfParent { thread_id } => write!(
+                formatter,
+                "thread {} cannot be its own parent",
+                thread_id.to_key_string()
+            ),
+        }
+    }
+}
+
+impl std::error::Error for OrganizeError {}
+
+/// Returns `(key, display)`. Folded with `str::to_lowercase`, never SQL `LOWER()`, which folds
+/// ASCII only and would keep `É` and `é` apart.
+pub fn normalize_tag(input: &str) -> Result<(SharedString, SharedString), OrganizeError> {
+    let display = input.trim();
+    let length = display.chars().count();
+    if length == 0
+        || length > MAX_TAG_CHARS
+        || display
+            .chars()
+            .any(|character| character.is_whitespace() || character == '#' || character == ',')
+    {
+        return Err(OrganizeError::InvalidTag);
+    }
+    Ok((display.to_lowercase().into(), display.to_string().into()))
+}
+
+/// Returns `(key, display)`, with the same case folding as [`normalize_tag`].
+fn normalize_list_name(input: &str) -> Result<(SharedString, SharedString), OrganizeError> {
+    let display = input.trim();
+    let length = display.chars().count();
+    if length == 0 || length > MAX_LIST_NAME_CHARS {
+        return Err(OrganizeError::InvalidListName);
+    }
+    Ok((display.to_lowercase().into(), display.to_string().into()))
+}
+
+/// Consumers watch the store with `cx.observe`, as they watch `ThreadMetadataStore`; the event
+/// stays for the tests that pin R1.7.
+enum ThreadOrganizationEvent {
+    Changed,
+}
+
+struct GlobalThreadOrganizationStore(Entity<ThreadOrganizationStore>);
+
+impl Global for GlobalThreadOrganizationStore {}
+
+pub fn init(cx: &mut App) {
+    let db = ThreadOrganizationDb::global(cx);
+    let store = cx.new(|cx| ThreadOrganizationStore::new(db, cx));
+    cx.set_global(GlobalThreadOrganizationStore(store));
+}
+
+/// Called by `ThreadMetadataStore::delete` while that store is being updated, so this must not
+/// read it. A thread with nothing stored queues nothing: drafts are deleted all the time.
+pub fn forget(thread_id: ThreadId, cx: &mut App) {
+    if let Some(store) = ThreadOrganizationStore::try_global(cx) {
+        store.update(cx, |store, cx| store.forget_thread(thread_id, cx));
+    }
+}
+
+pub struct ThreadOrganizationStore {
+    threads: HashMap<ThreadId, ThreadOrganization>,
+    thread_tags: HashMap<ThreadId, BTreeSet<SharedString>>,
+    tag_displays: BTreeMap<SharedString, SharedString>,
+    lists: Vec<ThreadList>,
+    manual_projects: HashSet<ProjectKey>,
+    /// Rows on disk holding a value this build does not recognize (a later Zeo wrote them). They
+    /// are not loaded, and their own columns are only ever cleared, never deleted, so the data a
+    /// newer build owns survives this one.
+    foreign_rows: HashSet<ThreadId>,
+    /// Never reuses an id, not even across restarts (`AUTOINCREMENT`), so a `ListId` a view holds
+    /// never names a different list.
+    next_list_id: i64,
+    /// `None` when loading failed: writing beside rows that were never read would duplicate
+    /// positions and list names, so the session stays in memory.
+    writes: Option<mpsc::UnboundedSender<DbWrite>>,
+    _writer: Task<()>,
+}
+
+impl EventEmitter<ThreadOrganizationEvent> for ThreadOrganizationStore {}
+
+/// Every write that names a thread reads `ThreadMetadataStore` to refuse drafts and unknown
+/// threads, so a write must not be called from inside a `ThreadMetadataStore` update (that entity
+/// would be read while borrowed), and a thread is unknown until that store's first load finishes
+/// (`ThreadMetadataStore::reload_task`).
+impl ThreadOrganizationStore {
+    pub fn global(cx: &App) -> Entity<Self> {
+        cx.global::<GlobalThreadOrganizationStore>().0.clone()
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalThreadOrganizationStore>()
+            .map(|global| global.0.clone())
+    }
+
+    /// `static_connection!` never reports an open failure: it falls back to an in-memory database
+    /// and raises `db::ALL_FILE_DB_FAILED`, which is the only signal left.
+    fn new(db: ThreadOrganizationDb, cx: &mut Context<Self>) -> Self {
+        let on_fallback = db::ALL_FILE_DB_FAILED.load(Ordering::Acquire);
+        Self::with_fallback_flag(db, on_fallback, cx)
+    }
+
+    fn with_fallback_flag(
+        db: ThreadOrganizationDb,
+        on_fallback: bool,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        if on_fallback {
+            log::warn!("thread_organization: database unavailable, organization will not persist");
+        }
+        let mut store = Self {
+            threads: HashMap::default(),
+            thread_tags: HashMap::default(),
+            tag_displays: BTreeMap::default(),
+            lists: Vec::new(),
+            manual_projects: HashSet::default(),
+            foreign_rows: HashSet::default(),
+            next_list_id: 1,
+            writes: None,
+            _writer: Task::ready(()),
+        };
+        match load_with_retries(&db) {
+            Ok(loaded) => store.apply_loaded(loaded),
+            Err(error) => {
+                log::warn!(
+                    "thread_organization: loading failed, organization will not persist this \
+                     session: {error:#}"
+                );
+                return store;
+            }
+        }
+        let (writes, mut queue) = mpsc::unbounded::<DbWrite>();
+        store.writes = Some(writes);
+        store._writer = cx.background_spawn(async move {
+            while let Some(write) = queue.next().await {
+                let operation = write.operation;
+                let subjects = write.subjects();
+                if let Err(error) = db.write(move |connection| write.apply(connection)).await {
+                    log::error!(
+                        "thread_organization: {operation} failed for {subjects}: {error:#}"
+                    );
+                }
+            }
+        });
+        store
+    }
+
+    fn apply_loaded(&mut self, loaded: Loaded) {
+        self.threads = loaded.threads;
+        self.thread_tags = loaded.thread_tags;
+        self.tag_displays = loaded.tag_displays;
+        self.lists = loaded.lists;
+        self.manual_projects = loaded.manual_projects;
+        self.foreign_rows = loaded.foreign_rows;
+        self.next_list_id = self
+            .lists
+            .iter()
+            .map(|list| list.id.0)
+            .chain(loaded.highest_list_id)
+            .max()
+            .unwrap_or(0)
+            + 1;
+        // Positions read from disk are made dense again, in memory only: the next reorder writes
+        // them back.
+        let pinned = self.pinned().collect::<Vec<_>>();
+        for (position, thread_id) in pinned.into_iter().enumerate() {
+            if let Some(organization) = self.threads.get_mut(&thread_id) {
+                organization.pinned_position = Some(position as u32);
+            }
+        }
+    }
+
+    pub fn organization(&self, thread_id: ThreadId) -> Option<&ThreadOrganization> {
+        self.threads.get(&thread_id)
+    }
+
+    pub fn pinned(&self) -> impl Iterator<Item = ThreadId> + '_ {
+        let mut pinned: Vec<(u32, ThreadId)> = self
+            .threads
+            .iter()
+            .filter_map(|(thread_id, organization)| {
+                organization
+                    .pinned_position
+                    .map(|position| (position, *thread_id))
+            })
+            .collect();
+        pinned.sort_by_key(|(position, thread_id)| (*position, thread_id.to_key_string()));
+        pinned.into_iter().map(|(_, thread_id)| thread_id)
+    }
+
+    pub fn sort_mode(&self, project: &ProjectKey) -> SortMode {
+        if self.manual_projects.contains(project) {
+            SortMode::Manual
+        } else {
+            SortMode::Recent
+        }
+    }
+
+    /// `None` when the thread has no slot in `project`, including a slot it still holds in the
+    /// project it was ordered in before its folders changed: the sidebar then places it like a
+    /// new thread, instead of colliding with a thread that owns that slot here.
+    pub fn manual_position_in(&self, thread_id: ThreadId, project: &ProjectKey) -> Option<u32> {
+        self.threads
+            .get(&thread_id)
+            .filter(|organization| organization.manual_project.as_ref() == Some(project))
+            .and_then(|organization| organization.manual_position)
+    }
+
+    fn manual_position(&self, thread_id: ThreadId) -> Option<u32> {
+        self.threads
+            .get(&thread_id)
+            .and_then(|organization| organization.manual_position)
+    }
+
+    pub fn lists(&self) -> &[ThreadList] {
+        &self.lists
+    }
+
+    pub fn threads_in_list(&self, list: ListId) -> Vec<ThreadId> {
+        self.threads_where(|organization| organization.list_id == Some(list))
+    }
+
+    pub fn tags(&self, thread_id: ThreadId) -> Vec<Tag> {
+        self.thread_tags
+            .get(&thread_id)
+            .into_iter()
+            .flatten()
+            .map(|key| self.tag(key))
+            .collect()
+    }
+
+    pub fn all_tags(&self) -> Vec<Tag> {
+        self.tag_displays
+            .iter()
+            .map(|(key, display)| Tag {
+                key: key.clone(),
+                display: display.clone(),
+            })
+            .collect()
+    }
+
+    pub fn parent(&self, thread_id: ThreadId) -> Option<(ThreadId, ForkKind)> {
+        self.threads
+            .get(&thread_id)
+            .and_then(|organization| organization.parent)
+    }
+
+    pub fn children(&self, thread_id: ThreadId) -> Vec<ThreadId> {
+        self.threads_where(|organization| {
+            organization
+                .parent
+                .is_some_and(|(parent, _)| parent == thread_id)
+        })
+    }
+
+    /// Every thread with a parent link, the deleted parent's included: what a history-wide view
+    /// lists without asking each thread [`Self::parent`].
+    pub fn sub_threads(&self) -> Vec<ThreadId> {
+        self.threads_where(|organization| organization.parent.is_some())
+    }
+
+    pub fn pin(
+        &mut self,
+        thread_id: ThreadId,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        if self.pinned_position(thread_id).is_some() {
+            return Ok(());
+        }
+        let mut order = vec![thread_id];
+        order.extend(self.pinned());
+        let mut write = DbWrite::new("pin");
+        self.set_pinned_order(&order, &mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn unpin(
+        &mut self,
+        thread_id: ThreadId,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        if self.pinned_position(thread_id).is_none() {
+            return Ok(());
+        }
+        let mut write = DbWrite::new("unpin");
+        self.update_thread(thread_id, &mut write, |organization| {
+            organization.pinned_position = None
+        });
+        let order: Vec<ThreadId> = self.pinned().collect();
+        self.set_pinned_order(&order, &mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn move_pinned(
+        &mut self,
+        thread_id: ThreadId,
+        to_index: usize,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        if self.pinned_position(thread_id).is_none() {
+            return Ok(());
+        }
+        let mut order: Vec<ThreadId> = self
+            .pinned()
+            .filter(|pinned| *pinned != thread_id)
+            .collect();
+        order.insert(to_index.min(order.len()), thread_id);
+        let mut write = DbWrite::new("move_pinned");
+        self.set_pinned_order(&order, &mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    /// Replaces the project's manual order: a thread left out of `ordered` loses its slot rather
+    /// than keeping a stale one that could duplicate a new thread's.
+    pub fn set_manual_order(
+        &mut self,
+        project: ProjectKey,
+        ordered: &[ThreadId],
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        for thread_id in ordered {
+            admit(*thread_id, cx)?;
+        }
+        let mut write = DbWrite::new("set_manual_order");
+        write.changes.push(Change::ClearManual(project.clone()));
+        self.clear_manual_positions(&project, &mut write);
+        let mut seen = HashSet::new();
+        let mut left_projects = HashSet::new();
+        let mut position = 0;
+        for thread_id in ordered {
+            if !seen.insert(*thread_id) {
+                continue;
+            }
+            if let Some(previous) = self
+                .threads
+                .get(thread_id)
+                .and_then(|organization| organization.manual_project.clone())
+            {
+                left_projects.insert(previous);
+            }
+            let project = project.clone();
+            self.update_thread(*thread_id, &mut write, |organization| {
+                organization.manual_position = Some(position);
+                organization.manual_project = Some(project);
+            });
+            position += 1;
+        }
+        // A thread taken from another project's order leaves a gap there; close it.
+        for left in left_projects {
+            self.compact_manual_order(&left, &mut write);
+        }
+        self.manual_projects.insert(project.clone());
+        write.changes.push(Change::ProjectMode(project, true));
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    /// Manual keeps whatever positions the project has; Recent clears them.
+    pub fn set_sort_mode(
+        &mut self,
+        project: ProjectKey,
+        mode: SortMode,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        let mut write = DbWrite::new("set_sort_mode");
+        match mode {
+            SortMode::Manual => {
+                if !self.manual_projects.insert(project.clone()) {
+                    return Ok(());
+                }
+                write.changes.push(Change::ProjectMode(project, true));
+            }
+            SortMode::Recent => {
+                let was_manual = self.manual_projects.remove(&project);
+                self.clear_manual_positions(&project, &mut write);
+                if !was_manual && write.changes.is_empty() {
+                    return Ok(());
+                }
+                // Also reaches rows this build did not load.
+                write
+                    .changes
+                    .insert(0, Change::ClearManual(project.clone()));
+                write.changes.push(Change::ProjectMode(project, false));
+            }
+        }
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn create_list(
+        &mut self,
+        name: &str,
+        cx: &mut Context<Self>,
+    ) -> Result<ListId, OrganizeError> {
+        let (key, display) = normalize_list_name(name)?;
+        if let Some(existing) = self.list_with_key(&key) {
+            return Err(OrganizeError::DuplicateListName { list_id: existing });
+        }
+        let id = ListId(self.next_list_id);
+        self.next_list_id += 1;
+        self.lists.push(ThreadList { id, name: display });
+        let mut write = DbWrite::new("create_list");
+        self.write_list_positions(&mut write);
+        self.commit(write, cx);
+        Ok(id)
+    }
+
+    pub fn rename_list(
+        &mut self,
+        list: ListId,
+        name: &str,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        let index = self.list_index(list)?;
+        let (key, display) = normalize_list_name(name)?;
+        if let Some(existing) = self
+            .list_with_key(&key)
+            .filter(|existing| *existing != list)
+        {
+            return Err(OrganizeError::DuplicateListName { list_id: existing });
+        }
+        if self.lists[index].name == display {
+            return Ok(());
+        }
+        self.lists[index].name = display;
+        let mut write = DbWrite::new("rename_list");
+        self.write_list_positions(&mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn move_list(
+        &mut self,
+        list: ListId,
+        to_index: usize,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        let index = self.list_index(list)?;
+        let moved = self.lists.remove(index);
+        let to_index = to_index.min(self.lists.len());
+        self.lists.insert(to_index, moved);
+        if index == to_index {
+            return Ok(());
+        }
+        let mut write = DbWrite::new("move_list");
+        self.write_list_positions(&mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    /// The list's threads keep everything else and simply lose `list_id`.
+    pub fn delete_list(
+        &mut self,
+        list: ListId,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        let index = self.list_index(list)?;
+        self.lists.remove(index);
+        let mut write = DbWrite::new("delete_list");
+        for thread_id in self.threads_in_list(list) {
+            self.update_thread(thread_id, &mut write, |organization| {
+                organization.list_id = None
+            });
+        }
+        // Also reaches rows this build did not load.
+        write.changes.push(Change::ClearList(list));
+        write.changes.push(Change::DeleteList(list));
+        self.write_list_positions(&mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn set_list(
+        &mut self,
+        thread_id: ThreadId,
+        list: Option<ListId>,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        if let Some(list) = list {
+            self.list_index(list)?;
+        }
+        if self
+            .threads
+            .get(&thread_id)
+            .and_then(|organization| organization.list_id)
+            == list
+        {
+            return Ok(());
+        }
+        let mut write = DbWrite::new("set_list");
+        self.update_thread(thread_id, &mut write, |organization| {
+            organization.list_id = list
+        });
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn add_tag(
+        &mut self,
+        thread_id: ThreadId,
+        tag: &str,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        let (key, display) = normalize_tag(tag)?;
+        let tags = self.thread_tags.entry(thread_id).or_default();
+        if tags.contains(&key) {
+            return Ok(());
+        }
+        if tags.len() >= MAX_TAGS_PER_THREAD {
+            return Err(OrganizeError::TooManyTags { thread_id });
+        }
+        tags.insert(key.clone());
+        let mut write = DbWrite::new("add_tag");
+        if !self.tag_displays.contains_key(&key) {
+            self.tag_displays.insert(key.clone(), display.clone());
+            write.changes.push(Change::Tag(key.clone(), Some(display)));
+        }
+        write.changes.push(Change::ThreadTag(thread_id, key, true));
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn remove_tag(
+        &mut self,
+        thread_id: ThreadId,
+        tag: &str,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        let (key, _) = normalize_tag(tag)?;
+        let Some(tags) = self.thread_tags.get_mut(&thread_id) else {
+            return Ok(());
+        };
+        if !tags.remove(&key) {
+            return Ok(());
+        }
+        if tags.is_empty() {
+            self.thread_tags.remove(&thread_id);
+        }
+        let mut write = DbWrite::new("remove_tag");
+        write
+            .changes
+            .push(Change::ThreadTag(thread_id, key.clone(), false));
+        self.forget_unused_tag(&key, &mut write);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    pub fn set_parent(
+        &mut self,
+        child: ThreadId,
+        parent: ThreadId,
+        kind: ForkKind,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        if child == parent {
+            return Err(OrganizeError::SelfParent { thread_id: child });
+        }
+        admit(child, cx)?;
+        admit(parent, cx)?;
+        // A row this build skipped carries a newer build's link; it must not be overwritten.
+        if self.parent(child).is_some() || self.foreign_rows.contains(&child) {
+            return Err(OrganizeError::AlreadyHasParent { thread_id: child });
+        }
+        let mut write = DbWrite::new("set_parent");
+        self.update_thread(child, &mut write, |organization| {
+            organization.parent = Some((parent, kind))
+        });
+        write.changes.push(Change::SetParent(child, parent, kind));
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    /// Children keep their link to a deleted parent: the requester decided sub-threads outlive it.
+    fn forget_thread(&mut self, thread_id: ThreadId, cx: &mut Context<Self>) {
+        let organization = self.threads.remove(&thread_id);
+        let tags = self.thread_tags.remove(&thread_id);
+        let foreign = self.foreign_rows.remove(&thread_id);
+        if organization.is_none() && tags.is_none() && !foreign {
+            return;
+        }
+        let mut write = DbWrite::new("forget");
+        write.changes.push(Change::DeleteThread(thread_id));
+        write.changes.push(Change::ForgetThreadTags(thread_id));
+        for key in tags.into_iter().flatten() {
+            self.forget_unused_tag(&key, &mut write);
+        }
+        if let Some(organization) = organization {
+            if organization.pinned_position.is_some() {
+                let order: Vec<ThreadId> = self.pinned().collect();
+                self.set_pinned_order(&order, &mut write);
+            }
+            if let Some(project) = organization.manual_project {
+                self.compact_manual_order(&project, &mut write);
+            }
+        }
+        self.commit(write, cx);
+    }
+
+    fn tag(&self, key: &SharedString) -> Tag {
+        Tag {
+            key: key.clone(),
+            display: self
+                .tag_displays
+                .get(key)
+                .cloned()
+                .unwrap_or_else(|| key.clone()),
+        }
+    }
+
+    fn threads_where(&self, predicate: impl Fn(&ThreadOrganization) -> bool) -> Vec<ThreadId> {
+        let mut threads: Vec<ThreadId> = self
+            .threads
+            .iter()
+            .filter(|(_, organization)| predicate(organization))
+            .map(|(thread_id, _)| *thread_id)
+            .collect();
+        threads.sort_by_key(|thread_id| thread_id.to_key_string());
+        threads
+    }
+
+    fn pinned_position(&self, thread_id: ThreadId) -> Option<u32> {
+        self.threads
+            .get(&thread_id)
+            .and_then(|organization| organization.pinned_position)
+    }
+
+    fn manual_order(&self, project: &ProjectKey) -> Vec<ThreadId> {
+        let mut order: Vec<(u32, ThreadId)> = self
+            .threads
+            .iter()
+            .filter(|(_, organization)| organization.manual_project.as_ref() == Some(project))
+            .filter_map(|(thread_id, organization)| {
+                organization
+                    .manual_position
+                    .map(|position| (position, *thread_id))
+            })
+            .collect();
+        order.sort_by_key(|(position, thread_id)| (*position, thread_id.to_key_string()));
+        order.into_iter().map(|(_, thread_id)| thread_id).collect()
+    }
+
+    fn set_pinned_order(&mut self, order: &[ThreadId], write: &mut DbWrite) {
+        for (position, thread_id) in order.iter().enumerate() {
+            let position = Some(position as u32);
+            if self.pinned_position(*thread_id) != position {
+                self.update_thread(*thread_id, write, |organization| {
+                    organization.pinned_position = position
+                });
+            }
+        }
+    }
+
+    fn compact_manual_order(&mut self, project: &ProjectKey, write: &mut DbWrite) {
+        for (position, thread_id) in self.manual_order(project).into_iter().enumerate() {
+            let position = Some(position as u32);
+            if self.manual_position(thread_id) != position {
+                self.update_thread(thread_id, write, |organization| {
+                    organization.manual_position = position
+                });
+            }
+        }
+    }
+
+    fn clear_manual_positions(&mut self, project: &ProjectKey, write: &mut DbWrite) {
+        for thread_id in self.manual_order(project) {
+            self.update_thread(thread_id, write, |organization| {
+                organization.manual_position = None;
+                organization.manual_project = None;
+            });
+        }
+    }
+
+    /// Applies `change` to the thread's row in memory and queues the row as it now stands;
+    /// a row left with nothing in it is deleted.
+    fn update_thread(
+        &mut self,
+        thread_id: ThreadId,
+        write: &mut DbWrite,
+        change: impl FnOnce(&mut ThreadOrganization),
+    ) {
+        let organization = self.threads.entry(thread_id).or_default();
+        change(organization);
+        let row = if !organization.is_empty() {
+            Change::UpsertThread(thread_id, organization.clone())
+        } else {
+            self.threads.remove(&thread_id);
+            if self.foreign_rows.contains(&thread_id) {
+                Change::ClearThread(thread_id)
+            } else {
+                Change::DeleteThread(thread_id)
+            }
+        };
+        write.changes.retain(|queued| match queued {
+            Change::UpsertThread(queued_id, _)
+            | Change::DeleteThread(queued_id)
+            | Change::ClearThread(queued_id) => *queued_id != thread_id,
+            _ => true,
+        });
+        write.changes.push(row);
+    }
+
+    fn forget_unused_tag(&mut self, key: &SharedString, write: &mut DbWrite) {
+        let still_used = self.thread_tags.values().any(|tags| tags.contains(key));
+        if !still_used && self.tag_displays.remove(key).is_some() {
+            write.changes.push(Change::Tag(key.clone(), None));
+        }
+    }
+
+    fn list_index(&self, list: ListId) -> Result<usize, OrganizeError> {
+        self.lists
+            .iter()
+            .position(|existing| existing.id == list)
+            .ok_or(OrganizeError::UnknownList { list_id: list })
+    }
+
+    fn list_with_key(&self, key: &SharedString) -> Option<ListId> {
+        // A stored name is already trimmed, so its key is its lowercase form.
+        self.lists
+            .iter()
+            .find(|list| list.name.to_lowercase() == key.as_ref())
+            .map(|list| list.id)
+    }
+
+    fn write_list_positions(&self, write: &mut DbWrite) {
+        // Rewritten whole: a list keeps its id and name, and positions stay dense.
+        write.changes.push(Change::ListPositions(
+            self.lists
+                .iter()
+                .enumerate()
+                .map(|(position, list)| (list.id, list.name.clone(), position as u32))
+                .collect(),
+        ));
+    }
+
+    fn commit(&mut self, write: DbWrite, cx: &mut Context<Self>) {
+        if write.changes.is_empty() {
+            return;
+        }
+        if let Some(writes) = &self.writes
+            && let Err(error) = writes.unbounded_send(write)
+        {
+            log::error!("thread_organization: the writer stopped, a change was not saved: {error}");
+        }
+        cx.emit(ThreadOrganizationEvent::Changed);
+        cx.notify();
+    }
+}
+
+/// Every write whose subject is a thread names one `ThreadMetadataStore` knows and that has a
+/// session: a draft is created and discarded constantly and is not organized.
+fn admit(thread_id: ThreadId, cx: &App) -> Result<(), OrganizeError> {
+    let Some(metadata) = ThreadMetadataStore::try_global(cx) else {
+        return Err(OrganizeError::UnknownThread { thread_id });
+    };
+    match metadata.read(cx).entry(thread_id) {
+        None => Err(OrganizeError::UnknownThread { thread_id }),
+        Some(entry) if entry.is_draft() => Err(OrganizeError::Draft { thread_id }),
+        Some(_) => Ok(()),
+    }
+}
+
+enum Change {
+    /// Writes only the columns this build owns, so a later step's columns and a parent link
+    /// written by a newer build survive.
+    UpsertThread(ThreadId, ThreadOrganization),
+    DeleteThread(ThreadId),
+    /// For a row this build did not load: its own columns go, the row stays.
+    ClearThread(ThreadId),
+    SetParent(ThreadId, ThreadId, ForkKind),
+    ClearManual(ProjectKey),
+    /// Clears a deleted list from every stored row, loaded or not.
+    ClearList(ListId),
+    ForgetThreadTags(ThreadId),
+    ThreadTag(ThreadId, SharedString, bool),
+    Tag(SharedString, Option<SharedString>),
+    DeleteList(ListId),
+    ListPositions(Vec<(ListId, SharedString, u32)>),
+    ProjectMode(ProjectKey, bool),
+}
+
+/// One user action's changes, applied to disk in one transaction.
+struct DbWrite {
+    operation: &'static str,
+    changes: Vec<Change>,
+}
+
+impl DbWrite {
+    fn new(operation: &'static str) -> Self {
+        Self {
+            operation,
+            changes: Vec::new(),
+        }
+    }
+
+    /// The ids involved, for the log: never tag text, list names or project paths.
+    fn subjects(&self) -> String {
+        let mut threads = BTreeSet::new();
+        let mut lists = BTreeSet::new();
+        for change in &self.changes {
+            match change {
+                Change::UpsertThread(thread_id, _)
+                | Change::DeleteThread(thread_id)
+                | Change::ClearThread(thread_id)
+                | Change::SetParent(thread_id, _, _)
+                | Change::ForgetThreadTags(thread_id)
+                | Change::ThreadTag(thread_id, _, _) => {
+                    threads.insert(thread_id.to_key_string());
+                }
+                Change::ClearList(list_id) | Change::DeleteList(list_id) => {
+                    lists.insert(*list_id);
+                }
+                Change::ListPositions(positions) => {
+                    lists.extend(positions.iter().map(|(list_id, _, _)| *list_id));
+                }
+                Change::Tag(..) | Change::ProjectMode(..) | Change::ClearManual(..) => {}
+            }
+        }
+        let mut subjects: Vec<String> = threads
+            .into_iter()
+            .map(|thread_id| format!("thread {thread_id}"))
+            .collect();
+        subjects.extend(lists.into_iter().map(|list_id| format!("list {list_id}")));
+        if subjects.is_empty() {
+            "no thread or list".to_string()
+        } else {
+            subjects.join(", ")
+        }
+    }
+
+    fn apply(self, connection: &db::sqlez::connection::Connection) -> Result<()> {
+        connection.with_savepoint("thread_organization", || {
+            for change in self.changes {
+                apply_change(connection, change)?;
+            }
+            Ok(())
+        })
+    }
+}
+
+fn apply_change(connection: &db::sqlez::connection::Connection, change: Change) -> Result<()> {
+    match change {
+        Change::DeleteThread(thread_id) => connection.exec_bound::<ThreadId>(sql!(
+            DELETE FROM thread_organization WHERE thread_id = ?
+        ))?(thread_id),
+        Change::ClearThread(thread_id) => connection.exec_bound::<ThreadId>(sql!(
+            UPDATE thread_organization SET
+                pinned_position = NULL,
+                manual_position = NULL,
+                manual_project_key = NULL,
+                list_id = NULL
+            WHERE thread_id = ?
+        ))?(thread_id),
+        Change::UpsertThread(thread_id, organization) => connection.exec_bound::<(
+            ThreadId,
+            Option<i64>,
+            Option<i64>,
+            Option<String>,
+            Option<i64>,
+        )>(sql!(
+            INSERT INTO thread_organization(
+                thread_id, pinned_position, manual_position, manual_project_key, list_id
+            ) VALUES (?, ?, ?, ?, ?)
+            ON CONFLICT(thread_id) DO UPDATE SET
+                pinned_position = excluded.pinned_position,
+                manual_position = excluded.manual_position,
+                manual_project_key = excluded.manual_project_key,
+                list_id = excluded.list_id
+        ))?((
+            thread_id,
+            organization.pinned_position.map(i64::from),
+            organization.manual_position.map(i64::from),
+            organization
+                .manual_project
+                .as_ref()
+                .map(|project| project.0.to_string()),
+            organization.list_id.map(|list_id| list_id.0),
+        )),
+        // An upsert, so the link lands whether or not the row's own upsert ran before it.
+        Change::SetParent(thread_id, parent, kind) => {
+            connection.exec_bound::<(ThreadId, ThreadId, &str)>(sql!(
+                INSERT INTO thread_organization(thread_id, parent_thread_id, fork_kind)
+                VALUES (?, ?, ?)
+                ON CONFLICT(thread_id) DO UPDATE SET
+                    parent_thread_id = excluded.parent_thread_id,
+                    fork_kind = excluded.fork_kind
+            ))?((thread_id, parent, kind.as_str()))
+        }
+        Change::ClearManual(project) => connection.exec_bound::<String>(sql!(
+            UPDATE thread_organization SET manual_position = NULL, manual_project_key = NULL
+            WHERE manual_project_key = ?
+        ))?(project.0.to_string()),
+        Change::ClearList(list_id) => connection.exec_bound::<i64>(sql!(
+            UPDATE thread_organization SET list_id = NULL WHERE list_id = ?
+        ))?(list_id.0),
+        Change::ForgetThreadTags(thread_id) => connection
+            .exec_bound::<ThreadId>(sql!(DELETE FROM thread_tags WHERE thread_id = ?))?(
+            thread_id
+        ),
+        Change::ThreadTag(thread_id, key, true) => connection.exec_bound::<(ThreadId, &str)>(
+            sql!(INSERT OR IGNORE INTO thread_tags(thread_id, tag_key) VALUES (?, ?)),
+        )?((thread_id, key.as_ref())),
+        Change::ThreadTag(thread_id, key, false) => connection.exec_bound::<(ThreadId, &str)>(
+            sql!(DELETE FROM thread_tags WHERE thread_id = ? AND tag_key = ?),
+        )?((thread_id, key.as_ref())),
+        Change::Tag(key, Some(display)) => connection.exec_bound::<(&str, &str)>(sql!(
+            INSERT OR REPLACE INTO tags(tag_key, display) VALUES (?, ?)
+        ))?((key.as_ref(), display.as_ref())),
+        Change::Tag(key, None) => {
+            connection.exec_bound::<&str>(sql!(DELETE FROM tags WHERE tag_key = ?))?(key.as_ref())
+        }
+        Change::DeleteList(list_id) => {
+            connection.exec_bound::<i64>(sql!(DELETE FROM thread_lists WHERE id = ?))?(list_id.0)
+        }
+        Change::ListPositions(positions) => {
+            // Rewrites the table from memory, so a rename or delete that failed earlier cannot
+            // leave a stale `name_key` that every later write would collide with. A placeholder
+            // key starts with a space, which a trimmed name never does.
+            let kept = positions
+                .iter()
+                .map(|(list_id, _, _)| list_id.0.to_string())
+                .collect::<Vec<_>>()
+                .join(", ");
+            connection.exec(&format!(
+                "DELETE FROM thread_lists WHERE id NOT IN ({kept})"
+            ))?()?;
+            connection.exec("UPDATE thread_lists SET name_key = ' ' || id")?()?;
+            for (list_id, name, position) in positions {
+                let key = name.to_lowercase();
+                connection.exec_bound::<(i64, &str, String, i64)>(sql!(
+                    INSERT INTO thread_lists(id, name, name_key, position) VALUES (?, ?, ?, ?)
+                    ON CONFLICT(id) DO UPDATE SET
+                        name = excluded.name,
+                        name_key = excluded.name_key,
+                        position = excluded.position
+                ))?((list_id.0, name.as_ref(), key, i64::from(position)))?;
+            }
+            Ok(())
+        }
+        Change::ProjectMode(project, true) => connection.exec_bound::<String>(
+            "INSERT OR REPLACE INTO project_sort_mode(project_key, mode) VALUES (?, 'manual')",
+        )?(project.0.to_string()),
+        Change::ProjectMode(project, false) => connection.exec_bound::<String>(sql!(
+            DELETE FROM project_sort_mode WHERE project_key = ?
+        ))?(project.0.to_string()),
+    }
+}
+
+#[derive(Default)]
+struct Loaded {
+    threads: HashMap<ThreadId, ThreadOrganization>,
+    thread_tags: HashMap<ThreadId, BTreeSet<SharedString>>,
+    tag_displays: BTreeMap<SharedString, SharedString>,
+    lists: Vec<ThreadList>,
+    manual_projects: HashSet<ProjectKey>,
+    foreign_rows: HashSet<ThreadId>,
+    highest_list_id: Option<i64>,
+}
+
+/// The foreground read connection has no busy timeout, so a read that meets a writer is retried
+/// before the session gives up persisting.
+fn load_with_retries(db: &ThreadOrganizationDb) -> Result<Loaded> {
+    const ATTEMPTS: u32 = 3;
+    let mut attempt = 1;
+    loop {
+        match load(db) {
+            Ok(loaded) => return Ok(loaded),
+            Err(error) if attempt < ATTEMPTS => {
+                log::warn!(
+                    "thread_organization: load attempt {attempt} failed, retrying: {error:#}"
+                );
+                std::thread::sleep(std::time::Duration::from_millis(25));
+                attempt += 1;
+            }
+            Err(error) => return Err(error),
+        }
+    }
+}
+
+fn load(db: &ThreadOrganizationDb) -> Result<Loaded> {
+    let mut loaded = Loaded::default();
+
+    let rows = db.select::<(
+        ThreadId,
+        Option<i64>,
+        Option<i64>,
+        Option<String>,
+        Option<i64>,
+    )>(sql!(
+        SELECT thread_id, pinned_position, manual_position, manual_project_key, list_id
+        FROM thread_organization
+    ))?()
+    .context("reading thread_organization")?;
+    for (thread_id, pinned_position, manual_position, manual_project, list_id) in rows {
+        loaded.threads.insert(
+            thread_id,
+            ThreadOrganization {
+                pinned_position: pinned_position.and_then(|position| u32::try_from(position).ok()),
+                manual_position: manual_position.and_then(|position| u32::try_from(position).ok()),
+                list_id: list_id.map(ListId),
+                parent: None,
+                manual_project: manual_project.map(|project| ProjectKey(project.into())),
+            },
+        );
+    }
+
+    let links = db.select::<(ThreadId, ThreadId, Option<String>)>(sql!(
+        SELECT thread_id, parent_thread_id, fork_kind
+        FROM thread_organization WHERE parent_thread_id IS NOT NULL
+    ))?()
+    .context("reading sub-thread links")?;
+    for (thread_id, parent, kind) in links {
+        match kind.as_deref().and_then(ForkKind::parse) {
+            Some(kind) => {
+                if let Some(organization) = loaded.threads.get_mut(&thread_id) {
+                    organization.parent = Some((parent, kind));
+                }
+            }
+            None => {
+                log::warn!(
+                    "thread_organization: skipping thread {} with an unrecognized sub-thread kind",
+                    thread_id.to_key_string()
+                );
+                loaded.threads.remove(&thread_id);
+                loaded.foreign_rows.insert(thread_id);
+            }
+        }
+    }
+    loaded
+        .threads
+        .retain(|_, organization| !organization.is_empty());
+
+    let lists = db.select::<(i64, String)>(sql!(
+        SELECT id, name FROM thread_lists ORDER BY position, id
+    ))?()
+    .context("reading thread_lists")?;
+    loaded.highest_list_id =
+        db.select_row::<i64>("SELECT seq FROM sqlite_sequence WHERE name = 'thread_lists'")?()
+            .context("reading the highest list id")?;
+    loaded.lists = lists
+        .into_iter()
+        .map(|(id, name)| ThreadList {
+            id: ListId(id),
+            name: name.into(),
+        })
+        .collect();
+
+    let tags = db.select::<(String, String)>(sql!(SELECT tag_key, display FROM tags))?()
+        .context("reading tags")?;
+    loaded.tag_displays = tags
+        .into_iter()
+        .map(|(key, display)| (key.into(), display.into()))
+        .collect();
+
+    let thread_tags = db.select::<(ThreadId, String)>(sql!(
+        SELECT thread_id, tag_key FROM thread_tags
+    ))?()
+    .context("reading thread_tags")?;
+    for (thread_id, key) in thread_tags {
+        let key = SharedString::from(key);
+        loaded
+            .tag_displays
+            .entry(key.clone())
+            .or_insert_with(|| key.clone());
+        loaded.thread_tags.entry(thread_id).or_default().insert(key);
+    }
+
+    let modes = db.select::<(String, String)>(sql!(
+        SELECT project_key, mode FROM project_sort_mode
+    ))?()
+    .context("reading project_sort_mode")?;
+    for (project, mode) in modes {
+        if mode == "manual" {
+            loaded.manual_projects.insert(ProjectKey(project.into()));
+        } else {
+            log::warn!("thread_organization: skipping a project with an unrecognized sort mode");
+        }
+    }
+
+    Ok(loaded)
+}
