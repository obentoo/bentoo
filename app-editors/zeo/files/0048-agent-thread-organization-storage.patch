+// Story 031, task 2.1 — the `ThreadOrganizationDb` domain and its step 0 (R9.1, R9.2, R9.6, Q11).
+//
+// Materialize with, in `src/thread_organization.rs`:
+//     #[cfg(test)]
+//     #[path = "thread_organization/migration_tests.rs"]
+//     mod migration;
+// Filter: `cargo test -p agent_ui thread_organization::migration`.
+//
+// Plain `#[test]`s over `Connection::open_memory`, the pattern of patch 0035's
+// `history_db::migration`. Uniqueness rules are checked hostile half first: the rows that
+// must stay apart are inserted before the duplicate that must be refused.
+
+use db::sqlez::{connection::Connection, domain::Domain as _};
+
+use super::ThreadOrganizationDb;
+use crate::thread_metadata_store::{ThreadId, run_thread_metadata_migrations};
+
+const TABLES: [&str; 5] = [
+    "project_sort_mode",
+    "tags",
+    "thread_lists",
+    "thread_organization",
+    "thread_tags",
+];
+
+fn migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            ThreadOrganizationDb::NAME,
+            ThreadOrganizationDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the thread organization migrations should apply");
+}
+
+fn fresh(name: &str) -> Connection {
+    let connection = Connection::open_memory(Some(name));
+    migrate_all(&connection);
+    connection
+}
+
+fn run(connection: &Connection, sql: &str) -> anyhow::Result<()> {
+    connection.exec(sql).and_then(|mut statement| statement())
+}
+
+fn strings(connection: &Connection, sql: &str) -> Vec<String> {
+    connection
+        .select::<String>(sql)
+        .expect("query should prepare")()
+    .expect("query should run")
+}
+
+fn count(connection: &Connection, sql: &str) -> i64 {
+    connection
+        .select_row::<i64>(sql)
+        .expect("count should prepare")()
+    .expect("count should run")
+    .expect("count returns a row")
+}
+
+fn columns(connection: &Connection, table: &str) -> Vec<String> {
+    let mut names = strings(
+        connection,
+        &format!("SELECT name FROM pragma_table_info('{table}')"),
+    );
+    names.sort();
+    names
+}
+
+/// The columns of the indexes created explicitly on `table` (origin `c`), leaving out the
+/// automatic ones SQLite adds for a primary key or a UNIQUE constraint.
+fn explicit_index_columns(connection: &Connection, table: &str) -> Vec<String> {
+    let mut indexed = strings(
+        connection,
+        &format!(
+            "SELECT info.name FROM pragma_index_list('{table}') AS list \
+             JOIN pragma_index_info(list.name) AS info \
+             WHERE list.origin = 'c'"
+        ),
+    );
+    indexed.sort();
+    indexed
+}
+
+fn insert_thread_row(
+    connection: &Connection,
+    thread_id: ThreadId,
+    fork_kind: &str,
+) -> anyhow::Result<()> {
+    let sql = format!(
+        "INSERT INTO thread_organization (thread_id, pinned_position, fork_kind) \
+         VALUES (?, 0, {fork_kind})"
+    );
+    connection.exec_bound::<ThreadId>(&sql)?(thread_id)
+}
+
+// R9.1, R9.6 — a domain of its own: its own name, registered once, after no upstream domain,
+// and the registered list is the very list `MIGRATIONS` names (one `static` allocation).
+#[test]
+fn migration_domain_is_its_own_registered_once_with_no_dependency() {
+    assert_eq!(ThreadOrganizationDb::NAME, "ThreadOrganizationDb");
+    assert!(
+        !ThreadOrganizationDb::MIGRATIONS.is_empty(),
+        "the domain has at least its step 0"
+    );
+    let registered: Vec<&db::DomainMigration> = db::inventory::iter::<db::DomainMigration>
+        .into_iter()
+        .filter(|migration| migration.name == ThreadOrganizationDb::NAME)
+        .collect();
+    assert_eq!(
+        registered.len(),
+        1,
+        "the domain is registered exactly once (static_connection!)"
+    );
+    assert!(
+        registered[0].dependencies.is_empty(),
+        "the organization domain must not depend on any upstream domain, got {:?}",
+        registered[0].dependencies
+    );
+    assert!(
+        std::ptr::eq(registered[0].migrations, ThreadOrganizationDb::MIGRATIONS),
+        "the registered list is the domain's own list, not a copy"
+    );
+}
+
+// Q11 — step 0 alone creates every table of design.md "Data Models", with exactly its columns,
+// and the two indexes.
+#[test]
+fn migration_step_zero_creates_every_table_with_its_columns() {
+    let connection = Connection::open_memory(Some("thread_organization_migration_step_zero"));
+    connection
+        .migrate(
+            ThreadOrganizationDb::NAME,
+            &ThreadOrganizationDb::MIGRATIONS[..1],
+            &mut |_, _, _| false,
+        )
+        .expect("step 0 alone should apply");
+
+    let mut tables = strings(
+        &connection,
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' \
+         AND name != 'migrations'",
+    );
+    tables.sort();
+    assert_eq!(tables, TABLES.map(String::from).to_vec());
+
+    assert_eq!(
+        columns(&connection, "thread_organization"),
+        [
+            "fork_kind",
+            "list_id",
+            "manual_position",
+            "manual_project_key",
+            "parent_thread_id",
+            "pinned_position",
+            "thread_id",
+        ]
+        .map(String::from)
+        .to_vec()
+    );
+    assert_eq!(
+        columns(&connection, "thread_lists"),
+        ["id", "name", "name_key", "position"]
+            .map(String::from)
+            .to_vec()
+    );
+    assert_eq!(
+        columns(&connection, "thread_tags"),
+        ["tag_key", "thread_id"].map(String::from).to_vec()
+    );
+    assert_eq!(
+        columns(&connection, "tags"),
+        ["display", "tag_key"].map(String::from).to_vec()
+    );
+    assert_eq!(
+        columns(&connection, "project_sort_mode"),
+        ["mode", "project_key"].map(String::from).to_vec()
+    );
+    assert_eq!(
+        explicit_index_columns(&connection, "thread_organization"),
+        ["list_id", "parent_thread_id"].map(String::from).to_vec(),
+        "a deleted list's threads and a parent's children are looked up by index"
+    );
+    for table in TABLES {
+        assert_eq!(
+            count(&connection, &format!("SELECT COUNT(*) FROM {table}")),
+            0,
+            "{table} starts empty"
+        );
+    }
+}
+
+// The keys of design.md "Data Models", hostile half first: rows that are different things must
+// all be accepted before the same thing twice is shown to be refused.
+#[test]
+fn migration_keys_keep_distinct_rows_apart_and_refuse_the_same_row_twice() {
+    let connection = fresh("thread_organization_migration_keys");
+    let thread = ThreadId::new();
+    let other_thread = ThreadId::new();
+
+    // thread_tags: the key is the (thread, tag) pair.
+    let tag = |thread_id: ThreadId, key: &str| -> anyhow::Result<()> {
+        connection.exec_bound::<(ThreadId, &str)>(
+            "INSERT INTO thread_tags (thread_id, tag_key) VALUES (?, ?)",
+        )?((thread_id, key))
+    };
+    tag(thread, "rust").expect("first tag");
+    tag(thread, "rust-lang").expect("another tag on the same thread is another row");
+    tag(other_thread, "rust").expect("the same tag on another thread is another row");
+    assert!(
+        tag(thread, "rust").is_err(),
+        "the same (thread_id, tag_key) twice must violate the primary key"
+    );
+
+    // tags: one row per key.
+    run(
+        &connection,
+        "INSERT INTO tags (tag_key, display) VALUES ('rust', 'Rust')",
+    )
+    .expect("tag");
+    run(
+        &connection,
+        "INSERT INTO tags (tag_key, display) VALUES ('rust-lang', 'rust-lang')",
+    )
+    .expect("a different key is another tag");
+    assert!(
+        run(
+            &connection,
+            "INSERT INTO tags (tag_key, display) VALUES ('rust', 'RUST')"
+        )
+        .is_err(),
+        "a second display for an existing key must be refused by the key"
+    );
+
+    // thread_lists: unique by normalized name.
+    run(
+        &connection,
+        "INSERT INTO thread_lists (name, name_key, position) VALUES ('Personal', 'personal', 0)",
+    )
+    .expect("list");
+    run(
+        &connection,
+        "INSERT INTO thread_lists (name, name_key, position) \
+         VALUES ('Personal projects', 'personal projects', 1)",
+    )
+    .expect("a list whose key only starts the same is another list");
+    assert!(
+        run(
+            &connection,
+            "INSERT INTO thread_lists (name, name_key, position) \
+             VALUES ('PERSONAL', 'personal', 2)",
+        )
+        .is_err(),
+        "two lists with the same name_key must be refused"
+    );
+
+    // thread_organization: one row per thread.
+    insert_thread_row(&connection, thread, "NULL").expect("organization row");
+    insert_thread_row(&connection, other_thread, "NULL").expect("another thread's row");
+    assert!(
+        insert_thread_row(&connection, thread, "NULL").is_err(),
+        "a second row for the same thread must violate the primary key"
+    );
+
+    // project_sort_mode: one row per project key.
+    let mode = |key: &str| -> anyhow::Result<()> {
+        connection.exec_bound::<&str>(
+            "INSERT INTO project_sort_mode (project_key, mode) VALUES (?, 'manual')",
+        )?(key)
+    };
+    mode("local\n/a").expect("mode");
+    mode("local\n/b").expect("another project's mode");
+    assert!(
+        mode("local\n/a").is_err(),
+        "a second mode row for the same project must be refused"
+    );
+}
+
+// design.md "Data Models": CHECK constraints on `fork_kind` and `mode`. Every value the design
+// names is accepted before an unknown one is shown to be refused.
+#[test]
+fn migration_checks_accept_the_known_values_and_refuse_others() {
+    let connection = fresh("thread_organization_migration_checks");
+
+    insert_thread_row(&connection, ThreadId::new(), "'with_context'").expect("with_context");
+    insert_thread_row(&connection, ThreadId::new(), "'clean'").expect("clean");
+    insert_thread_row(&connection, ThreadId::new(), "NULL").expect("not a sub-thread");
+    assert!(
+        insert_thread_row(&connection, ThreadId::new(), "'sideways'").is_err(),
+        "an unknown fork_kind must be refused by the CHECK constraint"
+    );
+
+    run(
+        &connection,
+        "INSERT INTO project_sort_mode (project_key, mode) VALUES ('k1', 'manual')",
+    )
+    .expect("manual");
+    assert!(
+        run(
+            &connection,
+            "INSERT INTO project_sort_mode (project_key, mode) VALUES ('k2', 'alphabetical')"
+        )
+        .is_err(),
+        "an unknown mode must be refused by the CHECK constraint"
+    );
+}
+
+// R9.1, R9.6 — beside upstream's real thread database and a stand-in upstream domain that grows
+// a step later: this domain's data survives, upstream's tables and data are untouched.
+#[test]
+fn migration_beside_upstream_domains_that_grow_keeps_both_sides_intact() {
+    let connection = Connection::open_memory(Some("thread_organization_migration_upstream"));
+    run_thread_metadata_migrations(&connection);
+    let upstream: &[&str] =
+        &["CREATE TABLE upstream_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT;"];
+    connection
+        .migrate("UpstreamStandInDb", upstream, &mut |_, _, _| false)
+        .expect("stand-in upstream step 0");
+    run(
+        &connection,
+        "INSERT INTO upstream_items (id, name) VALUES (1, 'kept')",
+    )
+    .expect("upstream row");
+
+    migrate_all(&connection);
+    let thread = ThreadId::new();
+    insert_thread_row(&connection, thread, "NULL").expect("an organization row");
+
+    // Upstream appends a step to its own list: positional migrations are per domain.
+    let upstream_grown: &[&str] = &[
+        upstream[0],
+        "ALTER TABLE upstream_items ADD COLUMN note TEXT;",
+    ];
+    connection
+        .migrate("UpstreamStandInDb", upstream_grown, &mut |_, _, _| false)
+        .expect("a grown upstream list still applies");
+    run_thread_metadata_migrations(&connection);
+    migrate_all(&connection);
+
+    assert_eq!(
+        strings(&connection, "SELECT name FROM upstream_items WHERE id = 1"),
+        vec!["kept".to_string()]
+    );
+    assert_eq!(
+        strings(
+            &connection,
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'sidebar_threads'"
+        ),
+        vec!["sidebar_threads".to_string()],
+        "upstream's thread table is still there"
+    );
+    let kept = connection
+        .select_row_bound::<ThreadId, i64>(
+            "SELECT pinned_position FROM thread_organization WHERE thread_id = ?",
+        )
+        .expect("select")(thread)
+    .expect("run");
+    assert_eq!(
+        kept,
+        Some(0),
+        "this domain's row survives upstream's growth"
+    );
+}
+
+// R9.2, Q11 — append-only: a database written by step 0 only opens under the full list, keeps
+// its rows, and re-running the full list is a no-op rather than "Migration changed".
+#[test]
+fn migration_opens_a_database_created_by_its_first_step() {
+    let connection = Connection::open_memory(Some("thread_organization_migration_first"));
+    connection
+        .migrate(
+            ThreadOrganizationDb::NAME,
+            &ThreadOrganizationDb::MIGRATIONS[..1],
+            &mut |_, _, _| false,
+        )
+        .expect("step 0 alone should apply");
+    let thread = ThreadId::new();
+    let parent = ThreadId::new();
+    connection
+        .exec_bound::<(ThreadId, ThreadId)>(
+            "INSERT INTO thread_organization \
+             (thread_id, pinned_position, manual_position, list_id, parent_thread_id, fork_kind) \
+             VALUES (?, 3, 1, NULL, ?, 'clean')",
+        )
+        .expect("prepare")((thread, parent))
+    .expect("a row written by step 0's schema");
+    run(
+        &connection,
+        "INSERT INTO tags (tag_key, display) VALUES ('rust', 'Rust')",
+    )
+    .expect("tag");
+
+    migrate_all(&connection);
+    migrate_all(&connection);
+
+    let row = connection
+        .select_row_bound::<ThreadId, (i64, i64, ThreadId, String)>(
+            "SELECT pinned_position, manual_position, parent_thread_id, fork_kind \
+             FROM thread_organization WHERE thread_id = ?",
+        )
+        .expect("select")(thread)
+    .expect("run");
+    assert_eq!(row, Some((3, 1, parent, "clean".to_string())));
+    assert_eq!(
+        strings(
+            &connection,
+            "SELECT display FROM tags WHERE tag_key = 'rust'"
+        ),
+        vec!["Rust".to_string()]
+    );
+}
diff --git a/crates/agent_ui/src/thread_organization/normalize_tests.rs b/crates/agent_ui/src/thread_organization/normalize_tests.rs
new file mode 100644
index 0000000..57fa672
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/normalize_tests.rs
@@ -0,0 +1,200 @@
+// Story 031, task 2.2 — tag and list-name normalization (R4.2, R5.1, R5.2, R5.3, R5.7).
+//
+// Materialize with, in `src/thread_organization.rs`:
+//     #[cfg(test)]
+//     #[path = "thread_organization/normalize_tests.rs"]
+//     mod normalize;
+// Filter: `cargo test -p agent_ui thread_organization::normalize`.
+//
+// Contract (design.md "Validation rules"): trimmed; a tag is 1–32 characters with no
+// whitespace, `#` or `,`; a list name is 1–64 characters; the key is Unicode
+// `str::to_lowercase()` of the trimmed text; the display is the trimmed text as typed.
+// Identity is tested hostile half first: spellings that must stay TWO tags come before
+// spellings that must collapse into ONE.
+
+use super::{OrganizeError, normalize_list_name, normalize_tag};
+
+fn tag(input: &str) -> (String, String) {
+    let (key, display) = normalize_tag(input)
+        .unwrap_or_else(|error| panic!("{input:?} should be a valid tag, got {error:?}"));
+    (key.to_string(), display.to_string())
+}
+
+fn tag_key(input: &str) -> String {
+    tag(input).0
+}
+
+fn list(input: &str) -> (String, String) {
+    let (key, display) = normalize_list_name(input)
+        .unwrap_or_else(|error| panic!("{input:?} should be a valid list name, got {error:?}"));
+    (key.to_string(), display.to_string())
+}
+
+fn list_key(input: &str) -> String {
+    list(input).0
+}
+
+fn assert_invalid_tag(input: &str) {
+    let result = normalize_tag(input);
+    assert!(
+        matches!(result, Err(OrganizeError::InvalidTag { .. })),
+        "{input:?} must be refused with InvalidTag, got {:?}",
+        result.map(|(key, display)| (key.to_string(), display.to_string()))
+    );
+}
+
+fn assert_invalid_list_name(input: &str) {
+    let result = normalize_list_name(input);
+    assert!(
+        matches!(result, Err(OrganizeError::InvalidListName { .. })),
+        "{input:?} must be refused with InvalidListName, got {:?}",
+        result.map(|(key, display)| (key.to_string(), display.to_string()))
+    );
+}
+
+// R5.2 (hostile: must NOT collapse) — tags that differ by anything other than letter case stay
+// two, including a dotted capital İ against a plain I and an accent against no accent: a fold
+// that strips marks or maps İ to i would merge them.
+#[test]
+fn normalize_tag_keeps_tags_that_differ_by_more_than_case_apart() {
+    for (left, right) in [
+        ("rust", "rust-lang"),
+        ("rust", "rusty"),
+        ("go", "go2"),
+        ("c", "c++"),
+        ("ação", "acao"),
+        ("İstanbul", "Istanbul"),
+        ("Σίσυφος", "Σισυφος"),
+    ] {
+        assert_ne!(
+            tag_key(left),
+            tag_key(right),
+            "{left:?} and {right:?} differ by more than case and must be two tags"
+        );
+    }
+}
+
+// R5.1, R5.7 (hostile: must NOT split) — spellings that differ only by letter case are one tag,
+// including non-ASCII letters SQLite's ASCII-only LOWER() would leave apart, and a final capital
+// sigma, which a character-by-character fold lowers to σ instead of ς.
+#[test]
+fn normalize_tag_collapses_spellings_that_differ_only_by_case() {
+    for spellings in [
+        &["Rust", "rust", "RUST", "rUsT"][..],
+        &["Ação", "AÇÃO", "ação"][..],
+        &["Émile", "ÉMILE", "émile"][..],
+        &["İstanbul", "İSTANBUL"][..],
+        &["ΣΊΣΥΦΟΣ", "Σίσυφος", "σίσυφος"][..],
+    ] {
+        let keys: Vec<String> = spellings.iter().map(|spelling| tag_key(spelling)).collect();
+        assert!(
+            keys.windows(2).all(|pair| pair[0] == pair[1]),
+            "{spellings:?} differ only by case and must share one key, got {keys:?}"
+        );
+    }
+    assert_eq!(
+        tag_key("AÇÃO"),
+        "ação",
+        "the key is the Unicode lowercase form"
+    );
+}
+
+// Trimming is part of identity (hostile: must NOT split): surrounding blanks never make a
+// second tag, and the display is the trimmed spelling exactly as typed.
+#[test]
+fn normalize_tag_trims_before_keying_and_displays_the_spelling_as_typed() {
+    assert_eq!(tag("  Rust  "), ("rust".to_string(), "Rust".to_string()));
+    assert_eq!(tag_key(" rust"), tag_key("rust "));
+    assert_eq!(tag("PHP").1, "PHP", "the display keeps the user's case");
+    assert_eq!(tag("c++").1, "c++");
+}
+
+// R5.3 — empty, whitespace inside (any Unicode whitespace), `#` and `,` are refused.
+#[test]
+fn normalize_tag_refuses_empty_text_whitespace_hash_and_comma() {
+    for input in [
+        "",
+        "   ",
+        "\t\n",
+        "rust lang",
+        "rust\tlang",
+        "rust\u{a0}lang",
+        "rust\u{3000}lang",
+        "#rust",
+        "rust#",
+        "c#",
+        "rust,go",
+        ",",
+    ] {
+        assert_invalid_tag(input);
+    }
+}
+
+// R5.3 — the 32-character limit counts characters after trimming, not bytes: 32 two-byte
+// letters are accepted, 33 are not, and surrounding blanks do not count.
+#[test]
+fn normalize_tag_counts_characters_after_trimming_not_bytes() {
+    assert_eq!(tag(&"a".repeat(32)).1.chars().count(), 32);
+    assert_invalid_tag(&"a".repeat(33));
+    assert_eq!(
+        tag(&"ç".repeat(32)).1,
+        "ç".repeat(32),
+        "64 bytes, 32 characters"
+    );
+    assert_invalid_tag(&"ç".repeat(33));
+    assert_eq!(
+        tag(&format!("   {}   ", "a".repeat(32))).1,
+        "a".repeat(32),
+        "blanks around the text are trimmed before counting"
+    );
+}
+
+// R4.2, R4.3 (hostile: must NOT collapse) — list names that differ by more than case stay apart.
+#[test]
+fn normalize_list_name_keeps_names_that_differ_by_more_than_case_apart() {
+    for (left, right) in [
+        ("Personal", "Personal projects"),
+        ("Work", "Work 2"),
+        ("Ação", "Acao"),
+    ] {
+        assert_ne!(list_key(left), list_key(right), "{left:?} vs {right:?}");
+    }
+}
+
+// R4.3 (hostile: must NOT split) — list names that differ only by case or surrounding blanks
+// share one key, non-ASCII included; the display is the trimmed name as typed.
+#[test]
+fn normalize_list_name_collapses_case_and_surrounding_blanks() {
+    assert_eq!(list_key("Personal projects"), list_key("PERSONAL PROJECTS"));
+    assert_eq!(
+        list_key("  personal projects "),
+        list_key("Personal projects")
+    );
+    assert_eq!(list_key("AÇÃO"), list_key("ação"));
+    assert_eq!(
+        list("  Personal projects  "),
+        (
+            "personal projects".to_string(),
+            "Personal projects".to_string()
+        )
+    );
+}
+
+// R4.2 — a list name is free text of 1–64 characters: inner spaces, `#` and `,` are fine (the
+// tag rules do not apply), empty and over-long names are refused, characters are counted.
+#[test]
+fn normalize_list_name_accepts_free_text_within_its_length_and_refuses_the_rest() {
+    assert_eq!(list("Work, misc #2").1, "Work, misc #2");
+    assert_eq!(list(&"a".repeat(64)).1.chars().count(), 64);
+    assert_eq!(
+        list(&"é".repeat(64)).1,
+        "é".repeat(64),
+        "128 bytes, 64 characters"
+    );
+    assert_eq!(list(&format!("  {}  ", "a".repeat(64))).1, "a".repeat(64));
+    for input in ["", "   ", "\t"] {
+        assert_invalid_list_name(input);
+    }
+    assert_invalid_list_name(&"a".repeat(65));
+    assert_invalid_list_name(&"é".repeat(65));
+}
