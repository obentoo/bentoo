+// Story 031, task 4.2 — a thread's organization across delete, archive and unarchive
+// (R6.4, R8.1–R8.4, Q4, Q12).
+//
+// Materialize with, in `src/thread_organization.rs` (with `test_helpers`):
+//     #[cfg(test)]
+//     #[path = "thread_organization/lifecycle_tests.rs"]
+//     mod lifecycle;
+// Filter: `cargo test -p agent_ui thread_organization::lifecycle`.
+//
+// The store is the real global (`thread_organization::init`) over the per-test AppDatabase, and
+// threads are deleted through upstream's funnel — `ThreadMetadataStore::delete` and
+// `delete_all` — never by calling `forget` directly, except in the one test that proves a bare
+// `forget` of an unorganized thread queues nothing (R8.4). A `forget` that read
+// `ThreadMetadataStore` would panic here (it runs inside that store's update).
+
+use gpui::{Entity, TestAppContext};
+
+use super::test_helpers::*;
+use super::{ForkKind, SortMode, ThreadOrganizationDb, ThreadOrganizationStore};
+use crate::thread_metadata_store::ThreadId;
+
+const TABLES: [&str; 5] = [
+    "thread_organization",
+    "thread_lists",
+    "thread_tags",
+    "tags",
+    "project_sort_mode",
+];
+
+/// The app with the organization store installed as Zed installs it.
+fn init_with_store(
+    cx: &mut TestAppContext,
+) -> (Entity<ThreadOrganizationStore>, ThreadOrganizationDb) {
+    init(cx);
+    cx.update(|cx| super::init(cx));
+    cx.run_until_parked();
+    cx.update(|cx| {
+        (
+            ThreadOrganizationStore::global(cx),
+            ThreadOrganizationDb::global(cx),
+        )
+    })
+}
+
+/// A second store loading the same database: what a restart would report.
+fn after_restart(
+    db: &ThreadOrganizationDb,
+    cx: &mut TestAppContext,
+) -> Entity<ThreadOrganizationStore> {
+    cx.run_until_parked();
+    open_store(db, cx)
+}
+
+fn parent_of(
+    store: &Entity<ThreadOrganizationStore>,
+    child: ThreadId,
+    cx: &TestAppContext,
+) -> Option<(ThreadId, ForkKind)> {
+    store.read_with(cx, |store, _| store.parent(child))
+}
+
+// R8.1 (hostile half first: what must SURVIVE the deletion) — a sibling sharing the deleted
+// thread's list and a tag keeps both, its pin and the shared tag; the deleted thread's parent
+// keeps its own pin. Then everything of the deleted thread is gone — pin, manual position, list
+// membership, tags (an orphaned tag stops being offered) and parent link — in memory, on disk
+// and after a restart.
+#[gpui::test]
+async fn lifecycle_deleting_a_thread_removes_all_of_its_organization(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let parent = thread_in(PROJECT_A, cx);
+    let doomed = thread_in(PROJECT_A, cx);
+    let sibling = thread_in(PROJECT_A, cx);
+    let list = store.update(cx, |store, cx| {
+        let list = store.create_list("Shared", cx).unwrap();
+        store.pin(parent, cx).unwrap();
+        store.pin(sibling, cx).unwrap();
+        store.pin(doomed, cx).unwrap();
+        store
+            .set_manual_order(project(&[PROJECT_A]), &[doomed, sibling], cx)
+            .unwrap();
+        store.set_list(doomed, Some(list), cx).unwrap();
+        store.set_list(sibling, Some(list), cx).unwrap();
+        store.add_tag(doomed, "Rust", cx).unwrap();
+        store.add_tag(doomed, "solo", cx).unwrap();
+        store.add_tag(sibling, "rust", cx).unwrap();
+        store
+            .set_parent(doomed, parent, ForkKind::WithContext, cx)
+            .unwrap();
+        list
+    });
+    cx.run_until_parked();
+
+    delete_thread(doomed, cx);
+
+    let check = |store: &Entity<ThreadOrganizationStore>, cx: &TestAppContext| {
+        assert_eq!(
+            pinned(store, cx),
+            vec![sibling, parent],
+            "the others keep their pins"
+        );
+        assert_eq!(in_list(store, list, cx), vec![sibling]);
+        assert_eq!(tag_displays(store, sibling, cx), ["Rust"]);
+        assert_eq!(
+            known_tags(store, cx),
+            vec![("rust".to_string(), "Rust".to_string())],
+            "the shared tag stays, the orphaned one goes"
+        );
+        assert!(!has_organization(store, doomed, cx));
+        assert!(tag_displays(store, doomed, cx).is_empty());
+        store.read_with(cx, |store, _| {
+            assert_eq!(store.manual_position(doomed), None);
+            assert_eq!(store.parent(doomed), None);
+            assert!(store.children(parent).is_empty());
+        });
+    };
+    check(&store, cx);
+
+    cx.run_until_parked();
+    assert_eq!(rows_of(&db, "thread_organization", doomed), 0);
+    assert_eq!(rows_of(&db, "thread_tags", doomed), 0);
+    assert_eq!(strings(&db, "SELECT tag_key FROM tags"), ["rust"]);
+    let restarted = after_restart(&db, cx);
+    check(&restarted, cx);
+}
+
+// R8.1 — the worktree-archive path deletes through `delete_all`; it forgets every thread.
+#[gpui::test]
+async fn lifecycle_delete_all_forgets_every_deleted_thread(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let (first, second, survivor) = (thread(cx), thread(cx), thread(cx));
+    store.update(cx, |store, cx| {
+        for thread in [first, second, survivor] {
+            store.pin(thread, cx).unwrap();
+            store.add_tag(thread, "batch", cx).unwrap();
+        }
+    });
+    cx.run_until_parked();
+
+    delete_threads(vec![first, second], cx);
+
+    assert_eq!(pinned(&store, cx), vec![survivor]);
+    for thread in [first, second] {
+        assert!(!has_organization(&store, thread, cx));
+        assert_eq!(rows_of(&db, "thread_organization", thread), 0);
+        assert_eq!(rows_of(&db, "thread_tags", thread), 0);
+    }
+    assert_eq!(tag_displays(&store, survivor, cx), ["batch"]);
+}
+
+// R6.4 — deleting a parent leaves its sub-threads' link pointing at the deleted id, with its kind,
+// and the sub-thread's own organization untouched — after a restart too.
+#[gpui::test]
+async fn lifecycle_deleting_a_parent_keeps_the_childs_dangling_link(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let (parent, child) = (thread(cx), thread(cx));
+    store.update(cx, |store, cx| {
+        store
+            .set_parent(child, parent, ForkKind::Clean, cx)
+            .unwrap();
+        store.pin(child, cx).unwrap();
+        store.pin(parent, cx).unwrap();
+    });
+    cx.run_until_parked();
+
+    delete_thread(parent, cx);
+
+    assert_eq!(
+        parent_of(&store, child, cx),
+        Some((parent, ForkKind::Clean))
+    );
+    assert_eq!(pinned(&store, cx), vec![child]);
+    let restarted = after_restart(&db, cx);
+    assert_eq!(
+        parent_of(&restarted, child, cx),
+        Some((parent, ForkKind::Clean))
+    );
+    assert_eq!(pinned(&restarted, cx), vec![child]);
+}
+
+// R8.2, R8.3 — archiving keeps every piece of organization; unarchiving reports what the thread
+// had before; a restart in between changes nothing.
+#[gpui::test]
+async fn lifecycle_archive_keeps_and_unarchive_restores_the_organization(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let (t, parent) = (thread_in(PROJECT_A, cx), thread(cx));
+    store.update(cx, |store, cx| {
+        let list = store.create_list("Later", cx).unwrap();
+        store.pin(t, cx).unwrap();
+        store
+            .set_manual_order(project(&[PROJECT_A]), &[t], cx)
+            .unwrap();
+        store.set_list(t, Some(list), cx).unwrap();
+        store.add_tag(t, "Rust", cx).unwrap();
+        store
+            .set_parent(t, parent, ForkKind::WithContext, cx)
+            .unwrap();
+    });
+    cx.run_until_parked();
+    let before = reported(&store, t, cx);
+
+    archive(t, cx);
+    assert_eq!(
+        reported(&store, t, cx),
+        before,
+        "archiving keeps everything"
+    );
+    assert_eq!(reported(&after_restart(&db, cx), t, cx), before);
+
+    unarchive(t, cx);
+    assert_eq!(
+        reported(&store, t, cx),
+        before,
+        "unarchiving reports it all back"
+    );
+    store.read_with(cx, |store, _| {
+        assert_eq!(store.sort_mode(&project(&[PROJECT_A])), SortMode::Manual);
+    });
+}
+
+// R8.4 — deleting a thread with no organization writes nothing for it: not for a discarded draft
+// (the frequent case), not for an unorganized thread, not for a bare `forget`. The probe: every
+// table of the store is dropped, so ANY statement the store ran would fail and be logged at error
+// level naming the thread (R9.4). Positive control: deleting an ORGANIZED thread under the same
+// probe does log, proving the probe would have seen a write.
+#[gpui::test]
+async fn lifecycle_forgetting_an_unorganized_thread_writes_nothing(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let organized = thread(cx);
+    let draft = draft_in(PROJECT_A, cx);
+    let unorganized = thread(cx);
+    let never_organized = thread(cx);
+    store
+        .update(cx, |store, cx| store.pin(organized, cx))
+        .unwrap();
+    cx.run_until_parked();
+    for table in TABLES {
+        run_sql(&db, format!("DROP TABLE {table}")).await;
+    }
+    capture_logs();
+
+    delete_thread(draft, cx);
+    delete_thread(unorganized, cx);
+    cx.update(|cx| super::forget(never_organized, cx));
+    cx.run_until_parked();
+
+    let errors = error_lines();
+    for quiet in [draft, unorganized, never_organized] {
+        assert!(
+            !errors.iter().any(|line| line.contains(&id_text(quiet))),
+            "no write was attempted for an unorganized thread: {errors:?}"
+        );
+    }
+    assert_eq!(pinned(&store, cx), vec![organized]);
+
+    delete_thread(organized, cx);
+    let errors = error_lines();
+    assert!(
+        errors.iter().any(|line| line.contains(&id_text(organized))),
+        "control: forgetting an organized thread does write (and fails on the dropped tables): \
+         {errors:?}"
+    );
+    assert!(pinned(&store, cx).is_empty());
+}
+
+// The store is the one Zed installs: `init` makes `global` and `try_global` answer.
+#[gpui::test]
+async fn lifecycle_init_installs_the_global_store(cx: &mut TestAppContext) {
+    init(cx);
+    assert!(
+        cx.update(|cx| ThreadOrganizationStore::try_global(cx))
+            .is_none()
+    );
+    cx.update(|cx| super::init(cx));
+    cx.run_until_parked();
+    let (global, try_global) = cx.update(|cx| {
+        (
+            ThreadOrganizationStore::global(cx),
+            ThreadOrganizationStore::try_global(cx),
+        )
+    });
+    assert_eq!(
+        Some(global.entity_id()),
+        try_global.map(|store| store.entity_id())
+    );
+    let t = thread(cx);
+    global.update(cx, |store, cx| store.pin(t, cx)).unwrap();
+    assert_eq!(pinned(&global, cx), vec![t]);
+}
+
+// Task 5.1 (consumer contract) — a history-wide view (the tasks panel) lists sub-threads without
+// a parent in hand: `sub_threads` names every thread with a parent link, one whose parent was
+// deleted included (R6.4), and drops a sub-thread once it is deleted itself — after a restart too.
+#[gpui::test]
+async fn lifecycle_sub_threads_lists_every_linked_thread(cx: &mut TestAppContext) {
+    let (store, db) = init_with_store(cx);
+    let (parent, other_parent) = (thread(cx), thread(cx));
+    let (child, sibling, unlinked) = (thread(cx), thread(cx), thread(cx));
+    store.update(cx, |store, cx| {
+        store
+            .set_parent(child, parent, ForkKind::WithContext, cx)
+            .unwrap();
+        store
+            .set_parent(sibling, other_parent, ForkKind::Clean, cx)
+            .unwrap();
+        store.pin(unlinked, cx).unwrap();
+    });
+    let sorted = |mut threads: Vec<ThreadId>| {
+        threads.sort_by_key(|thread_id| thread_id.to_key_string());
+        threads
+    };
+    let sub_threads = |store: &Entity<ThreadOrganizationStore>, cx: &TestAppContext| {
+        store.read_with(cx, |store, _| store.sub_threads())
+    };
+    assert_eq!(sub_threads(&store, cx), sorted(vec![child, sibling]));
+
+    delete_thread(parent, cx);
+    assert_eq!(
+        sub_threads(&store, cx),
+        sorted(vec![child, sibling]),
+        "a deleted parent leaves its sub-thread listed"
+    );
+
+    delete_thread(sibling, cx);
+    assert_eq!(sub_threads(&store, cx), vec![child]);
+    assert_eq!(sub_threads(&after_restart(&db, cx), cx), vec![child]);
+}
