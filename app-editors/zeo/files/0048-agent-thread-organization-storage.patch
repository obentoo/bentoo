+// R3.2, R3.4, R3.5 (hostile halves first) — a manual order makes ONLY that project Manual: not
+// another project, not the same folders on another host; while the same folders listed in
+// another order are the same project.
+#[gpui::test]
+async fn store_order_manual_order_applies_to_that_project_only(cx: &mut TestAppContext) {
+    init(cx);
+    let (a, b, c) = (
+        thread_in(PROJECT_A, cx),
+        thread_in(PROJECT_A, cx),
+        thread_in(PROJECT_A, cx),
+    );
+    let other = thread_in(PROJECT_B, cx);
+    let db = open_db("thread_organization_store_order_manual").await;
+    let store = open_store(&db, cx);
+
+    store
+        .update(cx, |store, cx| {
+            store.set_manual_order(project(&[PROJECT_A]), &[b, a, c], cx)
+        })
+        .unwrap();
+
+    store.read_with(cx, |store, _| {
