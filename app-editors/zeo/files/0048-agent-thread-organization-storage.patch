+// ── The database, read and sabotaged directly ──────────────────────────────
+
+pub(super) async fn run_sql(db: &ThreadOrganizationDb, sql: String) {
+    db.write(move |connection| {
+        connection
+            .exec(&sql)
+            .unwrap_or_else(|error| panic!("{sql} should prepare: {error:?}"))()
+        .unwrap_or_else(|error| panic!("{sql} should run: {error:?}"))
+    })
+    .await;
+}
+
+/// Rows of `table` whose `thread_id` is `thread_id`.
+pub(super) fn rows_of(db: &ThreadOrganizationDb, table: &str, thread_id: ThreadId) -> i64 {
+    db.select_row_bound::<ThreadId, i64>(&format!(
+        "SELECT COUNT(*) FROM {table} WHERE thread_id = ?"
+    ))
+    .expect("count should prepare")(thread_id)
+    .expect("count should run")
+    .expect("count returns a row")
+}
+
+pub(super) fn count(db: &ThreadOrganizationDb, sql: &str) -> i64 {
+    db.select_row::<i64>(sql).expect("count should prepare")()
+        .expect("count should run")
+        .expect("count returns a row")
+}
+
+pub(super) fn strings(db: &ThreadOrganizationDb, sql: &str) -> Vec<String> {
+    db.select::<String>(sql).expect("query should prepare")().expect("query should run")
+}
+
+/// Makes every INSERT, UPDATE and DELETE on `table` fail, row by row, until `repair`.
+pub(super) async fn sabotage(db: &ThreadOrganizationDb, table: &str) {
+    for operation in ["INSERT", "UPDATE", "DELETE"] {
+        run_sql(
+            db,
+            format!(
+                "CREATE TRIGGER sabotage_{table}_{operation} BEFORE {operation} ON {table} \
+                 BEGIN SELECT RAISE(ABORT, 'sabotaged by the test'); END"
+            ),
+        )
+        .await;
+    }
+}
+
+pub(super) async fn repair(db: &ThreadOrganizationDb, table: &str) {
+    for operation in ["INSERT", "UPDATE", "DELETE"] {
+        run_sql(db, format!("DROP TRIGGER sabotage_{table}_{operation}")).await;
+    }
+}
