+// R2.2 (hostile: a repeated pin must NOT move the thread to the top) — pinning a pinned thread
+// succeeds and changes nothing.
+#[gpui::test]
+async fn store_order_pinning_a_pinned_thread_changes_nothing(cx: &mut TestAppContext) {
+    init(cx);
