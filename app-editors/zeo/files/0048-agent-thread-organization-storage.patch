+// ── Log capture (R9.3–R9.5, Q4) ────────────────────────────────────────────
+//
+// The capture of patch 0035's `agent_tasks_panel::test_helpers`, which agent_ui has no copy of:
+// a process-wide logger recording into a thread-local buffer, so parallel tests do not see each
+// other's lines. GPUI test executors run spawned work on the test's own thread.
+
+thread_local! {
+    static CAPTURED: RefCell<Vec<(log::Level, String)>> = const { RefCell::new(Vec::new()) };
+}
+
+struct CaptureLogger;
+
+impl log::Log for CaptureLogger {
+    fn enabled(&self, _metadata: &log::Metadata) -> bool {
+        true
+    }
+
+    fn log(&self, record: &log::Record) {
+        let mut line = record.args().to_string();
+        struct Collect<'a>(&'a mut String);
+        impl<'kvs> log::kv::VisitSource<'kvs> for Collect<'_> {
+            fn visit_pair(
+                &mut self,
+                key: log::kv::Key<'kvs>,
+                value: log::kv::Value<'kvs>,
+            ) -> Result<(), log::kv::Error> {
+                self.0.push_str(&format!(" {key}={value}"));
+                Ok(())
+            }
+        }
+        let _ = record.key_values().visit(&mut Collect(&mut line));
+        CAPTURED.with(|captured| captured.borrow_mut().push((record.level(), line)));
+    }
+
+    fn flush(&self) {}
+}
+
+static INSTALL: Once = Once::new();
+
+/// Starts capturing log lines on this thread. Panics when another logger owns the process,
+/// rather than letting a log assertion pass or fail for the wrong reason.
+pub(super) fn capture_logs() {
+    INSTALL.call_once(|| {
+        log::set_boxed_logger(Box::new(CaptureLogger))
+            .expect("another logger is installed; the log capture cannot run");
+        log::set_max_level(log::LevelFilter::Trace);
+    });
+    CAPTURED.with(|captured| captured.borrow_mut().clear());
+}
+
+fn lines_at(level: log::Level) -> Vec<String> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .filter(|(line_level, _)| *line_level == level)
+            .map(|(_, line)| line.clone())
+            .collect()
+    })
+}
+
+pub(super) fn error_lines() -> Vec<String> {
+    lines_at(log::Level::Error)
+}
+
+pub(super) fn warn_lines() -> Vec<String> {
+    lines_at(log::Level::Warn)
+}
+
+/// Every captured line, any level, lowercased — for "this text never reaches a log".
+pub(super) fn all_lines_lowercased() -> Vec<String> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .map(|(_, line)| line.to_lowercase())
+            .collect()
+    })
+}
+
+/// The form a log line names a thread in: its hyphenated uuid, which both `ThreadId`'s `Debug`
+/// and `to_key_string()` contain.
+pub(super) fn id_text(thread_id: ThreadId) -> String {
+    thread_id.to_key_string()
+}
