@@ -0,0 +1,332 @@
+//! The harness of `mcp_over_acp_tests` (Zeo next proposal §6.69 step 3): a scripted ACP agent
+//! on the SDK's in-memory channel talks to the real `AcpConnection` and the production client
+//! handler set; the context server behind it is a `ScriptedTransport`, so every message the
+//! server sees is recorded.
+use std::sync::Mutex;
+
+use super::*;
+use crate::acp::mcp_over_acp::McpOverAcp;
+use context_server::test::{ScriptedTransport, SentMessages};
+use context_server::{ContextServer, ContextServerId};
+use futures::StreamExt as _;
+use gpui::UpdateGlobal as _;
+use project::project_settings::{ContextServerSettings, ProjectSettings};
+use serde_json::{Value, json};
+use settings::{ContextServerCommand, Settings as _};
+
+pub(super) const SERVER: &str = "files";
+const META_VERSION: &str = "io.modelcontextprotocol/protocolVersion";
+
+pub(super) struct ProxyAgent {
+    pub(super) connection: Rc<AcpConnection>,
+    pub(super) project: Entity<Project>,
+    /// The `mcpServers` of every `session/new`, in order.
+    new_sessions: Arc<Mutex<Vec<Vec<acp::McpServer>>>>,
+    /// The agent's end of the connection, to send `mcp/message` from.
+    agent: Arc<Mutex<Option<agent_client_protocol::v1::ConnectionTo<Client>>>>,
+    pub(super) notifications: Arc<Mutex<Vec<acp::MessageMcpNotification>>>,
+    /// Every message the context server was sent.
+    pub(super) server_saw: SentMessages,
+    _keep_alive: Task<()>,
+}
+
+/// The server's answers: `tools/call` echoes, fails on `name: "broken"`, reports progress when
+/// asked to, and never answers `name: "slow"`.
+fn script(message: &Value) -> Vec<Value> {
+    let id = message["id"].clone();
+    if message["method"] != "tools/call" {
+        return Vec::new();
+    }
+    let params = &message["params"];
+    match params["name"].as_str() {
+        Some("slow") => Vec::new(),
+        Some("broken") => vec![json!({ "jsonrpc": "2.0", "id": id,
+            "error": { "code": -32602, "message": "bad arguments", "data": { "field": "path" } } })],
+        _ => {
+            let mut replies = Vec::new();
+            if let Some(token) = params["_meta"].get("progressToken") {
+                replies.push(
+                    json!({ "jsonrpc": "2.0", "method": "notifications/progress",
+                    "params": { "progressToken": token, "progress": 1, "total": 2 } }),
+                );
+            }
+            replies.push(json!({ "jsonrpc": "2.0", "id": id, "result": {
+                "content": [{ "type": "text", "text": "echo" }],
+                "structuredContent": { "args": params["arguments"] },
+            } }));
+            replies
+        }
+    }
+}
+
+impl ProxyAgent {
+    pub(super) async fn connect(advertises_acp: bool, cx: &mut gpui::TestAppContext) -> Self {
+        Self::connect_with(advertises_acp, json!({ "a": {} }), |_| {}, cx).await
+    }
+
+    /// With `files` as the file system's root and `user_settings` applied before anything
+    /// starts: a settings change later recomputes the project settings and drops the context
+    /// server this harness configures.
+    pub(super) async fn connect_with(
+        advertises_acp: bool,
+        files: Value,
+        user_settings: impl FnOnce(&mut settings::SettingsContent),
+        cx: &mut gpui::TestAppContext,
+    ) -> Self {
+        cx.update(|cx| {
+            let store = settings::SettingsStore::test(cx);
+            cx.set_global(store);
+            cx.set_global(db::AppDatabase::test_new());
+            settings::SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, user_settings);
+            });
+        });
+        let fs = fs::FakeFs::new(cx.executor());
+        fs.insert_tree("/", files).await;
+        let project = project::Project::test(fs, [std::path::Path::new("/a")], cx).await;
+
+        let new_sessions: Arc<Mutex<Vec<Vec<acp::McpServer>>>> = Arc::default();
+        let agent: Arc<Mutex<Option<agent_client_protocol::v1::ConnectionTo<Client>>>> =
+            Arc::default();
+        let notifications: Arc<Mutex<Vec<acp::MessageMcpNotification>>> = Arc::default();
+        let (client_transport, agent_transport) = agent_client_protocol::Channel::duplex();
+        let agent_future = Agent
+            .v1()
+            .name("proxy-agent")
+            .on_receive_request(
+                async move |req: acp::InitializeRequest, responder, _cx| {
+                    let mut mcp = acp::McpCapabilities::new();
+                    mcp.acp = advertises_acp;
+                    responder.respond(
+                        acp::InitializeResponse::new(req.protocol_version).agent_capabilities(
+                            acp::AgentCapabilities::default().mcp_capabilities(mcp),
+                        ),
+                    )
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let new_sessions = new_sessions.clone();
+                    let agent = agent.clone();
+                    async move |req: acp::NewSessionRequest, responder, cx| {
+                        *agent.lock().expect("agent slot") = Some(cx);
+                        let mut sessions = new_sessions.lock().expect("new sessions");
+                        sessions.push(req.mcp_servers);
+                        let id = format!("session-{}", sessions.len());
+                        responder.respond(acp::NewSessionResponse::new(acp::SessionId::new(id)))
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_notification(
+                {
+                    let notifications = notifications.clone();
+                    async move |notification: acp::MessageMcpNotification, _cx| {
+                        notifications
+                            .lock()
+                            .expect("notifications")
+                            .push(notification);
+                        Ok(())
+                    }
+                },
+                agent_client_protocol::on_receive_notification!(),
+            )
+            .connect_to(agent_transport);
+        let agent_io_task = cx.background_spawn(agent_future);
+
+        let sessions: Rc<RefCell<HashMap<acp_v2::SessionId, AcpSession>>> =
+            Rc::new(RefCell::new(HashMap::default()));
+        let (dispatch_tx, dispatch_rx) = mpsc::unbounded::<ForegroundWork>();
+        let (connection_tx, connection_rx) = futures::channel::oneshot::channel();
+        let client_future = connect_client_future(
+            "zed-test",
+            client_transport,
+            dispatch_tx.clone(),
+            connection_tx,
+            futures::future::pending(),
+        );
+        let client_io_task = cx.background_spawn(async move {
+            client_future.await.ok();
+        });
+        let client_conn: ConnectionTo<Agent> = connection_rx.await.expect("connection handle");
+        let response = client_conn
+            .send_request(acp::InitializeRequest::new(ProtocolVersion::V1))
+            .block_task()
+            .await
+            .expect("initialize");
+
+        let router = Rc::new(McpOverAcp::default());
+        router.set_connection(client_conn.clone());
+        let request_elicitations = cx.new(|_| ElicitationStore::default());
+        let dispatch_context = ClientContext {
+            auth_status: Default::default(),
+            sessions: sessions.clone(),
+            pending_session_updates: None,
+            accepts_subagent_updates: false,
+            mcp_over_acp: Some(router.clone()),
+            session_list: Rc::new(RefCell::new(None)),
+            request_elicitations: request_elicitations.clone(),
+            active_request_scopes: None,
+        };
+        let dispatch_task = cx.spawn(move |cx| async move {
+            let mut cx = cx;
+            let mut dispatch_rx = dispatch_rx;
+            while let Some(work) = dispatch_rx.next().await {
+                work.run(&mut cx, &dispatch_context);
+            }
+        });
+        let agent_server_store =
+            project.read_with(cx, |project, _| project.agent_server_store().downgrade());
+        let mut connection = cx.update(|cx| {
+            AcpConnection::new_for_test(
+                client_conn,
+                sessions,
+                response.agent_capabilities,
+                false,
+                request_elicitations,
+                agent_server_store,
+                client_io_task,
+                dispatch_tx,
+                dispatch_task,
+                cx,
+            )
+        });
+        connection.mcp_over_acp = router;
+        let keep_alive = cx.background_spawn(async move {
+            agent_io_task.await.ok();
+        });
+
+        let transport = ScriptedTransport::new(Some("Read before you write."), script);
+        let server_saw = transport.sent();
+        start_context_server(&project, transport, cx);
+
+        Self {
+            connection: Rc::new(connection),
+            project,
+            new_sessions,
+            agent,
+            notifications,
+            server_saw,
+            _keep_alive: keep_alive,
+        }
+    }
+
+    pub(super) async fn new_session(&self, cx: &mut gpui::TestAppContext) -> Vec<acp::McpServer> {
+        let task = cx.update(|cx| {
+            self.connection.clone().new_session(
+                self.project.clone(),
+                PathList::new(&[std::path::Path::new("/a")]),
+                cx,
+            )
+        });
+        task.await.expect("session/new succeeds");
+        self.new_sessions
+            .lock()
+            .expect("new sessions")
+            .last()
+            .cloned()
+            .expect("the agent saw session/new")
+    }
+
+    /// The `serverId` the last `session/new` declared for `SERVER`.
+    pub(super) fn declared_id(&self) -> String {
+        let sessions = self.new_sessions.lock().expect("new sessions");
+        let servers = sessions.last().expect("a session");
+        servers
+            .iter()
+            .find_map(|server| match server {
+                acp::McpServer::Acp(acp) if acp.name == SERVER => Some(acp.server_id.0.to_string()),
+                _ => None,
+            })
+            .expect("SERVER declared as acp")
+    }
+
+    pub(super) fn agent(&self) -> agent_client_protocol::v1::ConnectionTo<Client> {
+        self.agent
+            .lock()
+            .expect("agent slot")
+            .clone()
+            .expect("a session was created")
+    }
+
+    pub(super) async fn mcp(
+        &self,
+        server_id: &str,
+        request_id: &str,
+        method: &str,
+        params: Value,
+    ) -> Result<acp::MessageMcpResponse, agent_client_protocol::Error> {
+        self.agent()
+            .send_request(mcp_request(server_id, request_id, method, params))
+            .block_task()
+            .await
+    }
+}
+
+pub(super) fn mcp_request(
+    server_id: &str,
+    request_id: &str,
+    method: &str,
+    params: Value,
+) -> acp::MessageMcpRequest {
+    let Value::Object(params) = params else {
+        panic!("params are an object");
+    };
+    acp::MessageMcpRequest::new(server_id.to_string(), request_id.to_string(), method)
+        .params(params)
+}
+
+/// Binding metadata as Plus's `McpOverAcpCaller` adds it to every request.
+pub(super) fn with_binding_meta(mut params: Value) -> Value {
+    let meta = params
+        .as_object_mut()
+        .expect("params are an object")
+        .entry("_meta")
+        .or_insert_with(|| json!({}));
+    meta[META_VERSION] = json!("2026-07-28");
+    meta["io.modelcontextprotocol/clientCapabilities"] = json!({});
+    params
+}
+
+fn start_context_server(
+    project: &Entity<Project>,
+    transport: ScriptedTransport,
+    cx: &mut gpui::TestAppContext,
+) {
+    cx.update(|cx| {
+        let mut settings = ProjectSettings::get_global(cx).clone();
+        settings.context_servers.insert(
+            SERVER.into(),
+            ContextServerSettings::Stdio {
+                enabled: true,
+                remote: false,
+                command: ContextServerCommand {
+                    path: "/usr/bin/files-mcp".into(),
+                    args: vec!["--api-key".into(), "SECRET".into()],
+                    env: None,
+                    timeout: None,
+                },
+            },
+        );
+        ProjectSettings::override_global(settings, cx);
+    });
+    let store = project.read_with(cx, |project, _| project.context_server_store());
+    store.update(cx, |store, cx| {
+        store.start_server(
+            Arc::new(ContextServer::new(
+                ContextServerId(SERVER.into()),
+                Arc::new(transport),
+            )),
+            cx,
+        )
+    });
+    cx.run_until_parked();
+}
+
+pub(super) fn result_of(response: acp::MessageMcpResponse) -> Value {
+    match response {
+        acp::MessageMcpResponse::Result { result, .. } => result,
+        other => panic!("expected an inner result, got {other:?}"),
+    }
+}
diff --git a/crates/agent_servers/src/acp/v1/mcp_over_acp_tests.rs b/crates/agent_servers/src/acp/v1/mcp_over_acp_tests.rs
new file mode 100644
index 0000000..d32740c
--- /dev/null
+++ b/crates/agent_servers/src/acp/v1/mcp_over_acp_tests.rs
@@ -0,0 +1,260 @@
+//! Zeo next proposal §6.69 step 3: Zeo's running MCP servers reach an agent that advertises
+//! `mcpCapabilities.acp` as `acp` declarations, and its `mcp/message` requests are answered by
+//! the copy Zeo runs. Harness: `mcp_over_acp_harness`. Filter: `mcp_over_acp_tests`.
+
+use super::mcp_over_acp_harness::{ProxyAgent, SERVER, mcp_request, result_of, with_binding_meta};
+use super::*;
+use crate::acp::mcp_over_acp::McpOverAcp;
+use agent_client_protocol::mcp_server::MCP_SERVER_UNAVAILABLE;
+use serde_json::json;
+
+#[gpui::test]
+async fn a_running_server_is_declared_as_acp_with_no_command_line(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    let servers = agent.new_session(cx).await;
+
+    assert_eq!(
+        servers.len(),
+        1,
+        "one entry for the one server: {servers:?}"
+    );
+    let acp::McpServer::Acp(declared) = &servers[0] else {
+        panic!("declared over ACP, not as its command line: {servers:?}");
+    };
+    assert_eq!(declared.name, SERVER, "the agent names it as Zeo does");
+    assert!(
+        !format!("{servers:?}").contains("SECRET"),
+        "the server's argv no longer reaches the agent"
+    );
+}
+
+#[gpui::test]
+async fn an_agent_without_the_capability_still_gets_the_command(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(false, cx).await;
+    let servers = agent.new_session(cx).await;
+
+    assert!(
+        matches!(&servers[..], [acp::McpServer::Stdio(stdio)] if stdio.name == SERVER),
+        "today's mapping for every other agent: {servers:?}"
+    );
+}
+
+#[gpui::test]
+async fn the_setting_off_keeps_the_command(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect_with(
+        true,
+        json!({ "a": {} }),
+        |settings| settings.agent.get_or_insert_default().mcp_servers_over_acp = Some(false),
+        cx,
+    )
+    .await;
+    let servers = agent.new_session(cx).await;
+
+    assert!(
+        matches!(&servers[..], [acp::McpServer::Stdio(_)]),
+        "agent.mcp_servers_over_acp: false is today's behaviour: {servers:?}"
+    );
+}
+
+#[gpui::test]
+async fn the_server_id_is_the_same_for_every_session(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+    let first = agent.declared_id();
+    agent.new_session(cx).await;
+
+    assert_eq!(
+        agent.declared_id(),
+        first,
+        "Plus fingerprints a session by its servers: a new id per session would recreate it"
+    );
+}
+
+#[gpui::test]
+async fn discover_answers_from_the_servers_own_handshake(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+    let id = agent.declared_id();
+
+    let result = result_of(
+        agent
+            .mcp(&id, "d-1", "server/discover", with_binding_meta(json!({})))
+            .await
+            .expect("discover is served"),
+    );
+
+    assert_eq!(result["supportedVersions"], json!(["2026-07-28"]));
+    assert_eq!(result["serverInfo"]["name"], "scripted");
+    assert!(result["capabilities"]["tools"].is_object(), "{result}");
+    assert_eq!(result["instructions"], "Read before you write.");
+}
+
+#[gpui::test]
+async fn tools_call_round_trips_through_the_running_server(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+    let id = agent.declared_id();
+
+    let params = with_binding_meta(json!({ "name": "read", "arguments": { "path": "a.txt" } }));
+    let result = result_of(
+        agent
+            .mcp(&id, "c-1", "tools/call", params)
+            .await
+            .expect("served"),
+    );
+    assert_eq!(
+        result["structuredContent"]["args"]["path"], "a.txt",
+        "{result}"
+    );
+
+    let error = agent
+        .mcp(
+            &id,
+            "c-2",
+            "tools/call",
+            with_binding_meta(json!({ "name": "broken" })),
+        )
+        .await
+        .expect("an inner MCP error is a successful ACP response");
+    let acp::MessageMcpResponse::Error { error, .. } = error else {
+        panic!("expected the server's error, got {error:?}");
+    };
+    assert_eq!(
+        (error.code, error.message.as_str()),
+        (-32602, "bad arguments")
+    );
+
+    let saw = agent.server_saw.snapshot();
+    let call = saw
+        .iter()
+        .find(|message| message["method"] == "tools/call")
+        .expect("the server got the call");
+    assert!(
+        call["params"].get("_meta").is_none(),
+        "the binding's metadata does not reach a stateful server: {call}"
+    );
+}
+
+#[gpui::test]
+async fn progress_reaches_the_agent_under_its_own_token(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+    let id = agent.declared_id();
+
+    let mut params = with_binding_meta(json!({ "name": "read" }));
+    params["_meta"]["progressToken"] = json!("agent-token-7");
+    agent
+        .mcp(&id, "p-1", "tools/call", params)
+        .await
+        .expect("served");
+    cx.run_until_parked();
+
+    let notifications = agent.notifications.lock().expect("notifications");
+    let [progress] = &notifications[..] else {
+        panic!("one progress notification: {notifications:?}");
+    };
+    assert_eq!(progress.method, "notifications/progress");
+    assert_eq!(progress.server_id.0.as_ref(), id);
+    assert_eq!(progress.request_id.0.as_ref(), "p-1");
+    let params = progress.params.as_ref().expect("progress params");
+    assert_eq!(
+        params["progressToken"], "agent-token-7",
+        "the agent's token, not Zeo's"
+    );
+    let saw = agent.server_saw.snapshot();
+    let sent_token = saw
+        .iter()
+        .find(|message| message["method"] == "tools/call")
+        .map(|message| message["params"]["_meta"]["progressToken"].clone())
+        .expect("the call");
+    assert_ne!(
+        sent_token,
+        json!("agent-token-7"),
+        "the server sees a token unique to Zeo"
+    );
+}
+
+#[gpui::test]
+async fn cancelling_tells_the_server_and_answers_cancelled(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+    let id = agent.declared_id();
+
+    let (result_tx, result_rx) = futures::channel::oneshot::channel();
+    let request = agent.agent().prepare_request(mcp_request(
+        &id,
+        "s-1",
+        "tools/call",
+        with_binding_meta(json!({ "name": "slow" })),
+    ));
+    let cancellation = request.cancellation_handle();
+    request
+        .on_receiving_result(async move |result: Result<acp::MessageMcpResponse, _>| {
+            result_tx.send(result).ok();
+            Ok(())
+        })
+        .expect("sent");
+    cx.run_until_parked();
+    cancellation.cancel().expect("cancel sent");
+    let result = result_rx.await.expect("an answer");
+    // The agent may stop waiting before Zeo has told the server: let Zeo finish.
+    cx.run_until_parked();
+
+    let error = result.expect_err("a cancelled request is an outer error");
+    assert_eq!(error.code, agent_client_protocol::ErrorCode::new(-32800));
+    let saw = agent.server_saw.snapshot();
+    let call_id = saw
+        .iter()
+        .find(|message| message["method"] == "tools/call")
+        .map(|message| message["id"].clone())
+        .expect("the call reached the server");
+    assert!(
+        saw.iter()
+            .any(|message| message["method"] == "notifications/cancelled"
+                && message["params"]["requestId"] == call_id),
+        "the server is told to stop: {saw:?}"
+    );
+}
+
+#[gpui::test]
+async fn an_undeclared_server_id_is_unavailable(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    agent.new_session(cx).await;
+
+    let error = agent
+        .mcp(
+            "zeo-0-nobody",
+            "u-1",
+            "tools/list",
+            with_binding_meta(json!({})),
+        )
+        .await
+        .expect_err("an outer error");
+    assert_eq!(error.code, MCP_SERVER_UNAVAILABLE);
+}
+
+#[gpui::test]
+async fn a_policy_proxies_only_the_servers_it_names(cx: &mut gpui::TestAppContext) {
+    let agent = ProxyAgent::connect(true, cx).await;
+    let stdio = || {
+        vec![acp::McpServer::Stdio(acp::McpServerStdio::new(
+            SERVER,
+            "/usr/bin/files-mcp",
+        ))]
+    };
+    let router = McpOverAcp::default();
+    let (none, named) = cx.update(|cx| {
+        (
+            router.declare(&agent.project, stdio(), &McpProxyPolicy::only([]), cx),
+            router.declare(
+                &agent.project,
+                stdio(),
+                &McpProxyPolicy::only([SERVER.to_string()]),
+                cx,
+            ),
+        )
+    });
+
+    assert!(matches!(&none[..], [acp::McpServer::Stdio(_)]), "{none:?}");
+    assert!(matches!(&named[..], [acp::McpServer::Acp(_)]), "{named:?}");
+}
