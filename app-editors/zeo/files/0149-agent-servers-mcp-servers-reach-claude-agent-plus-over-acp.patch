new file mode 100644
index 0000000..b663b46
--- /dev/null
+++ b/crates/agent_servers/src/acp/mcp_over_acp.rs
@@ -0,0 +1,199 @@
+//! MCP-over-ACP, Zeo's half (next proposal §6.69 step 3, with §6.13).
+//!
+//! Without it every MCP server Zeo runs reaches an external agent as its command line or URL,
+//! so each Claude session starts a copy of its own: on 2026-11-22 one extension server ran as 18
+//! processes, about 1.7 GB, each holding the server's API key in its argv. And a jailed agent
+//! could not start an extension server at all, its binary being outside the jail.
+//!
+//! With it, an agent that advertises `mcpCapabilities.acp` (Claude Agent (Plus) since its
+//! `mcp-over-acp` release) is handed `McpServer::Acp { name, serverId }` for every server Zeo
+//! is running, and sends each MCP request back over its own ACP connection as `mcp/message`.
+//! Zeo answers from the copy it already runs. The binding is MCP 2026-07-28, which is stateless
+//! (no `initialize`): `server/discover` is answered from the handshake Zeo did when it started
+//! the server, and every other request is forwarded into that existing session.
+//!
+//! The `serverId` is a function of the project and the server's name, so it is the same on
+//! every `session/new`, `load`, `resume` and `fork` of one connection. Plus folds it into the
+//! session's fingerprint: an id minted per request would tear the session down on each reload.
+//!
+//! Not carried, as on Plus's side: change notifications (`list_changed`) and server-to-client
+//! requests (sampling, elicitation), which keep landing on Zeo's own MCP client.
+
+use std::cell::RefCell;
+use std::sync::Arc;
+
+use agent_client_protocol::mcp_server::MCP_SERVER_UNAVAILABLE;
+use agent_client_protocol::v1::{ConnectionTo, Responder};
+use agent_client_protocol::{Agent, v1::schema as acp};
+use collections::{HashMap, HashSet};
+use context_server::ContextServerId;
+use gpui::{App, AsyncApp, Entity, WeakEntity};
+use project::Project;
+use project::context_server_store::ContextServerStatus;
+use settings::SettingsStore;
+
+use super::{ClientContext, respond_err};
+
+#[path = "mcp_over_acp_forward.rs"]
+mod forward;
+
+/// Which of Zeo's servers the sessions of one connection may reach through the proxy.
+///
+/// The hook a sandboxed launch narrows: a proxied server runs on the host, outside the jail,
+/// so a jail reaches only the servers its own opt-in list names (§6.64). Unjailed: all.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) enum McpProxyPolicy {
+    #[default]
+    All,
+    Only(Arc<HashSet<String>>),
+}
+
+impl McpProxyPolicy {
+    pub(crate) fn only(names: impl IntoIterator<Item = String>) -> Self {
+        Self::Only(Arc::new(names.into_iter().collect()))
+    }
+
+    pub(crate) fn allows(&self, name: &str) -> bool {
+        match self {
+            Self::All => true,
+            Self::Only(names) => names.contains(name),
+        }
+    }
+}
+
+/// One declared server: where its requests go.
+#[derive(Clone)]
+struct Route {
+    name: String,
+    project: WeakEntity<Project>,
+    server: ContextServerId,
+}
+
+/// Per-connection state of the proxy: the servers declared so far, by `serverId`, and the
+/// connection that relays request-scoped notifications (progress) back to the agent.
+#[derive(Default)]
+pub(crate) struct McpOverAcp {
+    routes: RefCell<HashMap<String, Route>>,
+    connection: RefCell<Option<ConnectionTo<Agent>>>,
+    /// `(serverId, requestId)` of the requests being served: the binding rejects a second
+    /// active request with the same pair.
+    active: RefCell<HashSet<(String, String)>>,
+}
+
+impl McpOverAcp {
+    pub(crate) fn set_connection(&self, connection: ConnectionTo<Agent>) {
+        *self.connection.borrow_mut() = Some(connection);
+    }
+
+    /// `servers` with every entry naming a context server Zeo is running (or starting) turned
+    /// into an `acp` declaration, when `policy` lets the connection reach it. Anything else
+    /// keeps its stdio or http form, so a stopped server still behaves as before.
+    pub(crate) fn declare(
+        &self,
+        project: &Entity<Project>,
+        servers: Vec<acp::McpServer>,
+        policy: &McpProxyPolicy,
+        cx: &App,
+    ) -> Vec<acp::McpServer> {
+        // A remote project's servers run on the remote host, behind Zeo's proto client; the
+        // proxy is not proven there, so they keep today's forwarding.
+        if !project.read(cx).is_local() {
+            return servers;
+        }
+        let store = project.read(cx).context_server_store().read(cx);
+        servers
+            .into_iter()
+            .map(|server| {
+                let name = match &server {
+                    acp::McpServer::Stdio(stdio) => stdio.name.clone(),
+                    acp::McpServer::Http(http) => http.name.clone(),
+                    _ => return server,
+                };
+                let id = ContextServerId(name.as_str().into());
+                let running = matches!(
+                    store.status_for_server(&id),
+                    Some(ContextServerStatus::Running | ContextServerStatus::Starting)
+                );
+                if !running || !policy.allows(&name) {
+                    return server;
+                }
+                let server_id = server_id_for(project, &name);
+                self.routes.borrow_mut().insert(
+                    server_id.clone(),
+                    Route {
+                        name: name.clone(),
+                        project: project.downgrade(),
+                        server: id,
+                    },
+                );
+                acp::McpServer::Acp(acp::McpServerAcp::new(name, server_id))
+            })
+            .collect()
+    }
+
+    fn route(&self, server_id: &str) -> Option<Route> {
+        self.routes.borrow().get(server_id).cloned()
+    }
+}
+
+/// Stable for one (connection, project, server): see the module comment.
+fn server_id_for(project: &Entity<Project>, name: &str) -> String {
+    format!("zeo-{}-{name}", project.entity_id().as_u64())
+}
+
+/// `agent.mcp_servers_over_acp`, default on. A test app may run without a settings store.
+pub(crate) fn enabled(cx: &App) -> bool {
+    cx.try_global::<SettingsStore>()
+        .and_then(|store| store.merged_settings().agent.as_ref()?.mcp_servers_over_acp)
+        .unwrap_or(true)
+}
+
+/// `mcp/message` from the agent: one MCP request for a server Zeo declared.
+pub(super) fn handle_mcp_message(
+    request: acp::MessageMcpRequest,
+    responder: Responder<acp::MessageMcpResponse>,
+    cx: &mut AsyncApp,
+    ctx: &ClientContext,
+) {
+    let server_id = request.server_id.0.to_string();
+    let Some((router, route)) = ctx
+        .mcp_over_acp
+        .clone()
+        .and_then(|router| Some((router.clone(), router.route(&server_id)?)))
+    else {
+        log::warn!("mcp_over_acp event=request server_id={server_id:?} outcome=unavailable");
+        return respond_err(
+            responder,
+            agent_client_protocol::Error::new(
+                MCP_SERVER_UNAVAILABLE,
+                format!("no MCP server is declared as {server_id} on this connection"),
+            ),
+        );
+    };
+    let key = (server_id.clone(), request.request_id.0.to_string());
+    if !router.active.borrow_mut().insert(key.clone()) {
+        return respond_err(
+            responder,
+            agent_client_protocol::Error::invalid_params()
+                .data(format!("MCP request {} is already active", key.1)),
+        );
+    }
+    let notifier = router.connection.borrow().clone();
+    let cancellation = responder.cancellation();
+    cx.spawn(async move |cx| {
+        let started = std::time::Instant::now();
+        let method = request.method.clone();
+        let result = forward::serve(&route, request, notifier, cancellation, cx).await;
+        router.active.borrow_mut().remove(&key);
+        forward::log_outcome(&route.name, &server_id, &method, &result, started.elapsed());
+        match result {
+            Ok(response) => {
+                if let Err(error) = responder.respond(response) {
+                    log::warn!("mcp_over_acp event=reply-dropped server_id={server_id:?}: {error}");
+                }
+            }
+            Err(error) => respond_err(responder, error),
+        }
+    })
+    .detach();
+}
diff --git a/crates/agent_servers/src/acp/mcp_over_acp_forward.rs b/crates/agent_servers/src/acp/mcp_over_acp_forward.rs
new file mode 100644
index 0000000..69a5db1
--- /dev/null
+++ b/crates/agent_servers/src/acp/mcp_over_acp_forward.rs
@@ -0,0 +1,245 @@
+//! How one `mcp/message` reaches the context server Zeo runs (see `mcp_over_acp.rs`).
+
+use std::pin::pin;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use agent_client_protocol::mcp_server::{MCP_BACKEND_FAILURE, MCP_SERVER_UNAVAILABLE};
+use agent_client_protocol::v1::ConnectionTo;
+use agent_client_protocol::{Agent, RequestCancellation, v1::schema as acp};
+use context_server::client::RequestCanceled;
+use context_server::protocol::InitializedContextServerProtocol;
+use futures::FutureExt as _;
+use gpui::AsyncApp;
+use project::context_server_store::ContextServerStatus;
+use serde_json::{Map, Value, json};
+
+use super::Route;
+
+/// The one MCP revision the binding speaks (ACP SDK `MCP_PROTOCOL_VERSION`).
+const BINDING_MCP_VERSION: &str = "2026-07-28";
+/// The per-request keys the binding adds to `params._meta`. Zeo's servers were initialized
+/// with stateful MCP and know none of them, so they are taken off before forwarding.
+const BINDING_META_PREFIX: &str = "io.modelcontextprotocol/";
+/// How long a request waits for a server that is still starting (declared while `Starting`).
+const STARTING_WAIT: Duration = Duration::from_secs(30);
+const STARTING_POLL: Duration = Duration::from_millis(100);
+
+/// Unique across every connection: two agents may forward the same progress token to one
+/// shared server, so the token the server sees is Zeo's, and is mapped back on the way out.
+static NEXT_PROGRESS_TOKEN: AtomicU64 = AtomicU64::new(1);
+
+pub(super) async fn serve(
+    route: &Route,
+    request: acp::MessageMcpRequest,
+    notifier: Option<ConnectionTo<Agent>>,
+    cancellation: RequestCancellation,
+    cx: &mut AsyncApp,
+) -> Result<acp::MessageMcpResponse, agent_client_protocol::Error> {
+    let client = running_client(route, cx).await?;
+    match request.method.as_str() {
+        "server/discover" => Ok(acp::MessageMcpResponse::success(discovery(&client))),
+        "ping" => Ok(acp::MessageMcpResponse::success(json!({}))),
+        _ => forward(route, &client, request, notifier, cancellation).await,
+    }
+}
+
+/// The running server's client, waiting while it is still starting.
+async fn running_client(
+    route: &Route,
+    cx: &mut AsyncApp,
+) -> Result<Arc<InitializedContextServerProtocol>, agent_client_protocol::Error> {
+    let unavailable = |why: &str| {
+        agent_client_protocol::Error::new(
+            MCP_SERVER_UNAVAILABLE,
+            format!("MCP server {} {why}", route.name),
+        )
+    };
+    let mut waited = Duration::ZERO;
+    loop {
+        let (client, status) = route
+            .project
+            .read_with(cx, |project, cx| {
+                let store = project.context_server_store().read(cx);
+                (
+                    store
+                        .get_running_server(&route.server)
+                        .and_then(|server| server.client()),
+                    store.status_for_server(&route.server),
+                )
+            })
+            .map_err(|_| unavailable("belongs to a project that is closed"))?;
+        if let Some(client) = client {
+            return Ok(client);
+        }
+        if !matches!(status, Some(ContextServerStatus::Starting)) || waited >= STARTING_WAIT {
+            return Err(unavailable("is not running"));
+        }
+        cx.background_executor().timer(STARTING_POLL).await;
+        waited += STARTING_POLL;
+    }
+}
+
+/// What the stateless revision has instead of the handshake: the answer the server gave Zeo
+/// when it started, projected onto the binding's one version.
+fn discovery(client: &InitializedContextServerProtocol) -> Value {
+    let initialize = &client.initialize;
+    let mut result = json!({
+        "supportedVersions": [BINDING_MCP_VERSION],
+        "capabilities": initialize.capabilities,
+        "serverInfo": initialize.server_info,
+    });
+    if let Some(instructions) = &initialize.instructions {
+        result["instructions"] = instructions.clone().into();
+    }
+    result
+}
+
+async fn forward(
+    route: &Route,
+    client: &InitializedContextServerProtocol,
+    request: acp::MessageMcpRequest,
+    notifier: Option<ConnectionTo<Agent>>,
+    cancellation: RequestCancellation,
+) -> Result<acp::MessageMcpResponse, agent_client_protocol::Error> {
+    let acp::MessageMcpRequest {
+        server_id,
+        request_id,
+        method,
+        params,
+        ..
+    } = request;
+    let mut params = params.map(strip_binding_meta);
+    // Held until the call ends: dropping it ends the relay.
+    let mut progress_relay = None;
+    if let (Some(params), Some(notifier)) = (params.as_mut(), notifier)
+        && let Some(original) = progress_token(params)
+    {
+        let token = format!(
+            "zeo-acp-{}",
+            NEXT_PROGRESS_TOKEN.fetch_add(1, Ordering::Relaxed)
+        );
+        set_progress_token(params, Value::String(token.clone()));
+        progress_relay = Some(relay_progress(
+            client, token, original, notifier, server_id, request_id,
+        ));
+    }
+
+    let (cancel_tx, cancel_rx) = futures::channel::oneshot::channel();
+    let mut call = pin!(
+        client
+            .request_raw(&method, params.map(Value::Object), Some(cancel_rx))
+            .fuse()
+    );
+    let mut cancelled = pin!(cancellation.cancelled().fuse());
+    let outcome = futures::select_biased! {
+        outcome = call => outcome,
+        _ = cancelled => {
+            // The client tells the server (`notifications/cancelled`) and ends the call.
+            cancel_tx.send(()).ok();
+            call.await
+        }
+    };
+    drop(progress_relay);
+
+    match outcome {
+        Ok(Ok(result)) => Ok(acp::MessageMcpResponse::success(result)),
+        Ok(Err(error)) => {
+            let mut inner = acp::McpError::new(error.code, error.message);
+            if let Some(data) = error.data {
+                inner = inner.data(data);
+            }
+            Ok(acp::MessageMcpResponse::error(inner))
+        }
+        Err(error) if error.downcast_ref::<RequestCanceled>().is_some() => {
+            Err(agent_client_protocol::Error::request_cancelled())
+        }
+        Err(error) => Err(agent_client_protocol::Error::new(
+            MCP_BACKEND_FAILURE,
+            format!("MCP server {}: {error:#}", route.name),
+        )),
+    }
+}
+
+/// Relays the server's progress for one forwarded request until the returned subscription is
+/// dropped, restoring the agent's own token.
+fn relay_progress(
+    client: &InitializedContextServerProtocol,
+    token: String,
+    original: Value,
+    notifier: ConnectionTo<Agent>,
+    server_id: acp::McpServerAcpId,
+    request_id: acp::McpRequestId,
+) -> context_server::client::NotificationSubscription {
+    client.on_notification(
+        "notifications/progress",
+        Box::new(move |params: Value, _cx: AsyncApp| {
+            let Value::Object(mut params) = params else {
+                return;
+            };
+            if params.get("progressToken").and_then(Value::as_str) != Some(token.as_str()) {
+                return;
+            }
+            params.insert("progressToken".into(), original.clone());
+            let notification = acp::MessageMcpNotification::new(
+                server_id.clone(),
+                request_id.clone(),
+                "notifications/progress",
+            )
+            .params(params);
+            if let Err(error) = notifier.send_notification(notification) {
+                log::debug!("mcp_over_acp event=progress-dropped: {error}");
+            }
+        }),
+    )
+}
+
+fn strip_binding_meta(mut params: Map<String, Value>) -> Map<String, Value> {
+    if let Some(Value::Object(meta)) = params.get_mut("_meta") {
+        meta.retain(|key, _| !key.starts_with(BINDING_META_PREFIX));
+        if meta.is_empty() {
+            params.remove("_meta");
+        }
+    }
+    params
+}
+
+fn progress_token(params: &Map<String, Value>) -> Option<Value> {
+    params
+        .get("_meta")?
+        .get("progressToken")
+        .filter(|token| token.is_string() || token.is_number())
+        .cloned()
+}
+
+fn set_progress_token(params: &mut Map<String, Value>, token: Value) {
+    if let Some(Value::Object(meta)) = params.get_mut("_meta") {
+        meta.insert("progressToken".into(), token);
+    }
+}
+
+/// One line per request, at the boundary: never the params or the result, which may carry
+/// whatever the tool reads.
+pub(super) fn log_outcome(
+    name: &str,
+    server_id: &str,
+    method: &str,
+    result: &Result<acp::MessageMcpResponse, agent_client_protocol::Error>,
+    elapsed: Duration,
+) {
+    let ms = elapsed.as_millis();
+    match result {
+        Ok(acp::MessageMcpResponse::Error { error, .. }) => log::debug!(
+            "mcp_over_acp event=request server={name:?} server_id={server_id:?} method={method:?} outcome=error code={} ms={ms}",
+            error.code
+        ),
+        Ok(_) => log::debug!(
+            "mcp_over_acp event=request server={name:?} server_id={server_id:?} method={method:?} outcome=result ms={ms}"
+        ),
+        Err(error) => log::warn!(
+            "mcp_over_acp event=request server={name:?} server_id={server_id:?} method={method:?} outcome=failed code={} ms={ms}",
+            i32::from(error.code)
+        ),
+    }
+}
