From 2d9c8b5bd3944b3a3589a9071d91ac4b69e28db8 Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Fri, 27 Nov 2026 09:27:10 -0300
Subject: [PATCH] settings_ui: a jail's Capabilities offer zeo-terminals
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo next §6.71, the jail half of 0214. A jail reaches a proxied MCP
server only when its Capabilities choose it (0152), so `zeo-terminals`
is listed there beside `zeo-lsp`, off by default, with a note saying it
reads only the terminals the operator shared from their tab. It is
offered while `agent.zeo_terminals` is on, or when a jail already chose
it, so the choice can be undone.

The note is in the nine languages.
---

diff --git a/crates/settings_ui/src/pages/agent_jail_capabilities.rs b/crates/settings_ui/src/pages/agent_jail_capabilities.rs
index ffbc059..225fc7c 100644
--- a/crates/settings_ui/src/pages/agent_jail_capabilities.rs
+++ b/crates/settings_ui/src/pages/agent_jail_capabilities.rs
@@ -29,6 +29,8 @@ use super::{JailPageState, reveal};
 
 /// `agent_servers::acp::zeo_lsp::ZEO_LSP_SERVER_NAME`, which this crate cannot reach.
 pub(crate) const ZEO_LSP: &str = "zeo-lsp";
+/// `agent_servers::acp::zeo_terminals::ZEO_TERMINALS_SERVER_NAME` (§6.71), likewise.
+pub(crate) const ZEO_TERMINALS: &str = "zeo-terminals";
 
 /// The anchor `OpenSettingsAt { path: "agent_sandbox#capabilities" }` reveals (the jail notice).
 pub(crate) const CAPABILITIES_ANCHOR: &str = "capabilities";
@@ -178,7 +180,24 @@ fn rows_from_store(
         .try_global::<SettingsStore>()
         .and_then(|store| store.merged_settings().agent.as_ref()?.zeo_lsp)
         .unwrap_or(true);
-    server_rows(servers, chosen, zeo_lsp)
+    let mut rows = server_rows(servers, chosen, zeo_lsp);
+    // §6.71: the terminals the operator shares, when `agent.zeo_terminals` is on (default) or a
+    // jail already chose them, so the choice can still be undone.
+    let zeo_terminals = cx
+        .try_global::<SettingsStore>()
+        .and_then(|store| store.merged_settings().agent.as_ref()?.zeo_terminals)
+        .unwrap_or(true);
+    let chosen_terminals = chosen.iter().any(|name| name == ZEO_TERMINALS);
+    if (zeo_terminals || chosen_terminals) && !rows.iter().any(|row| row.name == ZEO_TERMINALS) {
+        rows.push(ServerRow {
+            name: ZEO_TERMINALS.to_string(),
+            note: t!("agent-sandbox-mcp-zeo-terminals"),
+            secrets: Vec::new(),
+            chosen: chosen_terminals,
+        });
+        rows.sort_by(|a, b| a.name.cmp(&b.name));
+    }
+    rows
 }
 
 /// The Capabilities block of the project section.
