+// Story 023, task 2.1 — a running row shows its last tool and tool count beside the
+// elapsed time, watched or not (R1.1, R1.2, R1.3, R1.4, R1.5). Wired in
+// `src/tasks_card.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/progress_tests.rs"]
+//     mod progress;
+//
+// Validation filter: `tasks_card_progress_`.
+//
+// Contract beyond the planned selector `tasks-card-progress-{task_id}`: GPUI's test window
+// records painted BOUNDS (debug selectors), not painted TEXT, so the text a running row
+// paints is read through `super::progress_label(&AgentTask, SystemTime) -> Option<_>`
+// (`Some("<last tool> · <N> tools · <elapsed>")` or `Some("starting · <elapsed>")` for a
+// running task, `None` once it ended), with `<elapsed>` in the card's existing duration
+// format. If the implementation names it differently, adjust `progress_text` below only.
+//
+// Hostile halves first: progress must NOT drag the watched-only details (tokens, summary)
+// into an unwatched row, and must NOT outlive the task's end.
+
+use std::time::{Duration, SystemTime};
+
+use acp_thread::AgentTask;
+use gpui::{TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::test_helpers::*;
+
+fn progress_text(task: &AgentTask, now: SystemTime) -> Option<String> {
+    super::progress_label(task, now).map(|text| text.to_string())
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// A running wire task that has reported progress: its last tool, a tool count, a token
+/// count and a summary.
+fn busy_task(id: &str, last_tool: &str, tool_uses: u64) -> serde_json::Value {
+    let mut task = wire_task(id, "running", true, 1_000);
+    task["lastTool"] = json!(last_tool);
+    task["usage"] = json!({ "tokens": 4_321, "toolUses": tool_uses, "durationMs": 9_000 });
+    task["summary"] = json!(format!("Summary of {id}"));
+    task
+}
+
+fn task_of(
+    panel: &gpui::Entity<crate::AgentPanel>,
+    session: &agent_client_protocol::schema::v2::SessionId,
+    id: &str,
+    cx: &mut VisualTestContext,
+) -> AgentTask {
+    let card = card(panel, cx);
+    find_row(&card, session, id, cx)
+        .unwrap_or_else(|| panic!("task {id} is on the card"))
+        .task
+}
+
+// R1.1, R1.5 (hostile half) — an unwatched running row paints its progress, on the same line
+// as its elapsed time; tokens and summary stay watched-only.
+#[gpui::test]
+async fn tasks_card_progress_is_painted_on_an_unwatched_running_row(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![busy_task("t1", "Bash", 3)], &mut cx);
+    draw(&mut cx);
+    let sa = session_of(&a, &cx);
+
+    let row = find_row(&card(&panel, &cx), &sa, "t1", &mut cx).unwrap();
+    assert!(!row.watched, "precondition: nobody watches the row");
+    let progress = cx
+        .debug_bounds("tasks-card-progress-t1")
+        .expect("an unwatched running row paints its progress");
+    assert!(
+        cx.debug_bounds("tasks-card-details-t1").is_none(),
+        "tokens and summary stay watched-only"
+    );
+    let row_bounds = cx.debug_bounds("tasks-card-row-t1").expect("the row");
+    assert!(
+        progress.top() >= row_bounds.top() && progress.bottom() <= row_bounds.bottom(),
+        "the progress is painted on its own row: {progress:?} in {row_bounds:?}"
+    );
+    if let Some(elapsed) = cx.debug_bounds("tasks-card-elapsed-t1") {
+        assert!(
+            progress.top() < elapsed.bottom() && elapsed.top() < progress.bottom(),
+            "beside the elapsed time, on the same line: {progress:?} vs {elapsed:?}"
+        );
+    }
+
+    let task = row.task;
+    let now = task.started_at + Duration::from_secs(65);
+    assert_eq!(
+        progress_text(&task, now).as_deref(),
+        Some("Bash · 3 tools · 1m 05s")
+    );
+}
+
+// R1.3 — before the first tool the row says "starting", whether the feed sent no usage at all
+// or a usage with zero tool uses; a tool count of 0 is never shown as a last tool.
+#[gpui::test]
+async fn tasks_card_progress_says_starting_before_the_first_tool(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let mut zero = wire_task("t2", "running", true, 1_000);
+    zero["usage"] = json!({ "tokens": 12, "toolUses": 0, "durationMs": 500 });
+    send_tasks(
+        &a,
+        vec![wire_task("t1", "running", true, 1_000), zero],
+        &mut cx,
+    );
+    draw(&mut cx);
+    let sa = session_of(&a, &cx);
+
+    for id in ["t1", "t2"] {
+        let task = task_of(&panel, &sa, id, &mut cx);
+        let now = task.started_at + Duration::from_secs(7);
+        assert_eq!(
+            progress_text(&task, now).as_deref(),
+            Some("starting · 7s"),
+            "task {id} has used no tool yet"
+        );
+    }
+    assert!(cx.debug_bounds("tasks-card-progress-t1").is_some());
+    assert!(cx.debug_bounds("tasks-card-progress-t2").is_some());
+}
+
+// R1.2 — a new snapshot moves the row's last tool and tool count with nobody watching or
+// expanding it.
+#[gpui::test]
+async fn tasks_card_progress_follows_the_feed_without_watching(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let sa = session_of(&a, &cx);
+    send_tasks(&a, vec![busy_task("t1", "Read", 2)], &mut cx);
+    draw(&mut cx);
+    let first = task_of(&panel, &sa, "t1", &mut cx);
+    let now = first.started_at + Duration::from_secs(3);
+    assert_eq!(
+        progress_text(&first, now).as_deref(),
+        Some("Read · 2 tools · 3s")
+    );
+
+    send_tasks(&a, vec![busy_task("t1", "WebFetch", 12)], &mut cx);
+    draw(&mut cx);
+    let row = find_row(&card(&panel, &cx), &sa, "t1", &mut cx).unwrap();
+    assert!(!row.watched, "still unwatched");
+    assert_eq!(
+        progress_text(&row.task, now).as_deref(),
+        Some("WebFetch · 12 tools · 3s"),
+        "the row follows the newest snapshot"
+    );
+    assert!(cx.debug_bounds("tasks-card-progress-t1").is_some());
+    assert!(cx.debug_bounds("tasks-card-details-t1").is_none());
+}
+
+// R1.4 (hostile half) — once the task ends, its row shows its status and duration as today,
+// and no progress line survives the end.
+#[gpui::test]
+async fn tasks_card_progress_is_gone_once_the_task_ends(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let sa = session_of(&a, &cx);
+    send_tasks(&a, vec![busy_task("t1", "Bash", 4)], &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-progress-t1").is_some());
+
+    let mut done = busy_task("t1", "Bash", 4);
+    done["status"] = json!("completed");
+    done["endedAt"] = json!(4_000);
+    send_tasks(&a, vec![done], &mut cx);
+    draw(&mut cx);
+
+    assert!(
+        cx.debug_bounds("tasks-card-ended-t1").is_some(),
+        "the final status and duration are painted, as today"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-progress-t1").is_none(),
+        "no progress line on an ended row"
+    );
+    let task = task_of(&panel, &sa, "t1", &mut cx);
+    assert_eq!(
+        progress_text(&task, task.started_at + Duration::from_secs(60)),
+        None,
+        "an ended task has no progress text"
+    );
+}
+
+// R1.5 — a watched row keeps its details (tokens, last tool, summary) and gains the progress
+// line; the unwatched neighbour gets the progress line only.
+#[gpui::test]
+async fn tasks_card_progress_keeps_the_watched_details(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let sa = session_of(&a, &cx);
+    send_tasks(
+        &a,
+        vec![busy_task("t1", "Bash", 3), busy_task("t2", "Edit", 5)],
+        &mut cx,
+    );
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update(&mut cx, |card, cx| card.toggle_watch(sa.clone(), id, cx));
+    draw(&mut cx);
+
+    assert!(
+        cx.debug_bounds("tasks-card-details-t1").is_some(),
+        "watched: details"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-progress-t1").is_some(),
+        "watched: progress"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-details-t2").is_none(),
+        "unwatched: no details"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-progress-t2").is_some(),
+        "unwatched: progress"
+    );
+    let watched = cx.debug_bounds("tasks-card-row-t1").unwrap();
+    let plain = cx.debug_bounds("tasks-card-row-t2").unwrap();
+    assert!(
+        watched.size.height > plain.size.height,
+        "the watched row is still the expanded one"
+    );
+}
