diff --git a/crates/agent_tasks_panel/src/panel/open_at_task_tests.rs b/crates/agent_tasks_panel/src/panel/open_at_task_tests.rs
new file mode 100644
index 0000000..fde4ef3
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/open_at_task_tests.rs
@@ -0,0 +1,300 @@
+// Story 023, task 4.2 — "Open at Task": a history row opens its thread in its project's
+// window (story 024's routing) scrolled to the tool call that started the task (R3.1, R3.2,
+// R3.3, R3.4, R3.5). Module path: `panel::open_at_task`. Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/open_at_task_tests.rs"]
+//     mod open_at_task;
+//
+// Validation filter: `open_at_task_`. Fixtures: `test_helpers.rs` (story-024 and story-023
+// blocks). A routing failure's notice and WARN line are story 024's
+// `panel_actions_open_failure_shows_the_reason`, not repeated here.
+//
+// Hostile halves first: a nested subagent's call must not scroll the root thread to a wrong
+// entry (its parent call); a task with no id must not scroll to some other tool call; a
+// vanished thread keeps its own notice even when the record carries an id.
+
+use acp_thread::AgentTaskStatus;
+use gpui::TestAppContext;
+
+use crate::test_helpers::*;
+
+// R3.3 — hostile: the nested subagent's call (`toolu_parent_child`) is not a root entry; the
+// root holds the call that spawned it (`toolu_parent`). The thread opens in A, unscrolled to
+// that parent, and the row says there was no entry to jump to.
+#[gpui::test]
+async fn open_at_task_of_a_nested_subagent_opens_without_a_jump_and_says_so(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let thread = thread_with_calls(
+        &mut a,
+        "Thread of A",
+        &["toolu_parent"],
+        vec![wire_task_with_call(
+            "nested-task",
+            "running",
+            1_000,
+            Some("toolu_parent_child"),
+            1,
+        )],
+    );
+    let session = session_of(&thread, &a.cx);
+    let parent = tool_call_index(&thread, "toolu_parent", &a.cx);
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let tasks_panel_b = b.tasks_panel().clone();
+
+    open_from(
+        &tasks_panel_b,
+        &key(&session.to_string(), "nested-task"),
+        &mut b.cx,
+    );
+    a.cx.run_until_parked();
+
+    let agent_panel_a = a.agent_panel().clone();
+    assert_eq!(
+        shown_session(&agent_panel_a, &a.cx),
+        Some(session.clone()),
+        "the thread still opens, in its project's window"
+    );
+    assert_ne!(
+        scroll_top(&agent_panel_a, &mut a.cx),
+        parent,
+        "never scrolled to the subagent's parent call"
+    );
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "nested-task", &mut b.cx).as_deref(),
+        Some(NO_ENTRY_NOTICE)
+    );
+}
+
+// R3.3 — hostile: a task the feed gave no tool call id opens its thread and stays off the
+// thread's only tool call; the row says there was no entry to jump to.
+#[gpui::test]
+async fn open_at_task_without_a_tool_call_id_opens_without_a_jump_and_says_so(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let thread = thread_with_calls(
+        &mut a,
+        "Thread of A",
+        &["toolu_someone_else"],
+        vec![wire_task_with_call("no-id-task", "running", 1_000, None, 0)],
+    );
+    let session = session_of(&thread, &a.cx);
+    let other = tool_call_index(&thread, "toolu_someone_else", &a.cx);
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let recorded = find_record(&tasks_panel_b, &session, "no-id-task", &mut b.cx);
+    assert_eq!(
+        recorded, None,
+        "precondition: the record has no tool call id"
+    );
+
+    open_from(
+        &tasks_panel_b,
+        &key(&session.to_string(), "no-id-task"),
+        &mut b.cx,
+    );
+    a.cx.run_until_parked();
+
+    let agent_panel_a = a.agent_panel().clone();
+    assert_eq!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert_ne!(scroll_top(&agent_panel_a, &mut a.cx), other);
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "no-id-task", &mut b.cx).as_deref(),
+        Some(NO_ENTRY_NOTICE)
+    );
+}
+
+// R3.4 — hostile: a record that carries a tool call id but whose thread no longer exists
+// opens nothing and says "Thread no longer exists" — not the no-entry notice.
+#[gpui::test]
+async fn open_at_task_of_a_vanished_thread_opens_nothing(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    db.insert_started(&record_with_call(
+        "gone-session",
+        "gone-task",
+        AgentTaskStatus::Completed,
+        1_000,
+        Some("toolu_gone"),
+    ))
+    .await
+    .unwrap();
+    let mut panels = open_panels(cx).await;
+    let here = open_live_thread(&mut panels, "Still here");
+    let here = session_of(&here, &panels.cx);
+    let windows = window_count(&mut panels.cx);
+
+    let tasks_panel = panels.tasks_panel.clone();
+    open_from(
+        &tasks_panel,
+        &key("gone-session", "gone-task"),
+        &mut panels.cx,
+    );
+
+    let notice = find_row(&mut panels, "gone-session", "gone-task")
+        .expect("the row is still listed")
+        .notice
+        .expect("the row says why nothing opened");
+    assert!(notice.contains("Thread no longer exists"), "got {notice:?}");
+    assert!(!notice.contains("no entry to jump to"), "got {notice:?}");
+    assert_eq!(active_session(&panels), Some(here), "nothing else opened");
+    assert_eq!(window_count(&mut panels.cx), windows, "no window opened");
+}
+
+// R3.1, R3.2, R3.5 — benign: from window B, the task opens in A, scrolled to the tool call
+// that started it; no notice; one log line names the session, the task and the tool call.
+#[gpui::test]
+async fn open_at_task_from_another_window_lands_on_its_tool_call(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let thread = thread_with_calls(
+        &mut a,
+        "Thread of A",
+        &["toolu_before", "toolu_jump_23", "toolu_after"],
+        vec![wire_task_with_call(
+            "task-jump-23",
+            "running",
+            1_000,
+            Some("toolu_jump_23"),
+            0,
+        )],
+    );
+    let session = session_of(&thread, &a.cx);
+    let start = tool_call_index(&thread, "toolu_jump_23", &a.cx);
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let tasks_panel_b = b.tasks_panel().clone();
+
+    capture_logs();
+    open_from(
+        &tasks_panel_b,
+        &key(&session.to_string(), "task-jump-23"),
+        &mut b.cx,
+    );
+    a.cx.run_until_parked();
+
+    let agent_panel_a = a.agent_panel().clone();
+    assert_eq!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(a.any_window()),
+        "A is raised"
+    );
+    assert_eq!(
+        scroll_top(&agent_panel_a, &mut a.cx),
+        start,
+        "the thread is scrolled to the task's starting tool call"
+    );
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "task-jump-23", &mut b.cx),
+        None
+    );
+    let session_text = session.to_string();
+    let lines: Vec<String> = log_lines()
+        .into_iter()
+        .filter(|line| {
+            line.contains(&session_text)
+                && line.contains("task-jump-23")
+                && line.contains("toolu_jump_23")
+        })
+        .collect();
+    assert_eq!(
+        lines.len(),
+        1,
+        "one log line names the session, the task and the tool call: {:?}",
+        log_lines()
+    );
+}
+
+/// The tool call id the panel's row holds for `task`.
+fn find_record(
+    panel: &gpui::Entity<crate::AgentTasksPanel>,
+    session: &agent_client_protocol::schema::v2::SessionId,
+    task: &str,
+    cx: &mut gpui::VisualTestContext,
+) -> Option<String> {
+    panel
+        .update(cx, |panel, cx| panel.groups(cx))
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .find(|row| {
+            &row.entry.record.session_id == session && row.entry.record.task_id.as_ref() == task
+        })
+        .expect("the task is listed")
+        .entry
+        .record
+        .tool_call_id
+        .map(|id| id.to_string())
+}
+
+// Review follow-up: the no-entry notice reads as an outcome, not a failure, and a later jump
+// that lands clears whatever notice the row carried.
+#[test]
+fn open_at_task_no_entry_notice_is_not_drawn_as_an_error() {
+    assert_eq!(super::notice_color(NO_ENTRY_NOTICE), ui::Color::Muted);
+    assert_eq!(
+        super::notice_color("Thread no longer exists"),
+        ui::Color::Error
+    );
+}
+
+#[gpui::test]
+async fn open_at_task_a_landed_jump_clears_an_earlier_notice(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let thread = thread_with_calls(
+        &mut a,
+        "Thread of A",
+        &["toolu_clear"],
+        vec![wire_task_with_call(
+            "task-clear",
+            "running",
+            1_000,
+            Some("toolu_clear"),
+            0,
+        )],
+    );
+    let session = session_of(&thread, &a.cx);
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let task_key = key(&session.to_string(), "task-clear");
+    tasks_panel_b.update(&mut b.cx, |panel, cx| {
+        panel.set_notice(&task_key, NO_ENTRY_NOTICE, cx)
+    });
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "task-clear", &mut b.cx).as_deref(),
+        Some(NO_ENTRY_NOTICE),
+        "precondition: the row carries a notice"
+    );
+
+    open_from(&tasks_panel_b, &task_key, &mut b.cx);
+    a.cx.run_until_parked();
+
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "task-clear", &mut b.cx),
+        None,
+        "the jump landed, so the row's notice is gone"
+    );
+}
