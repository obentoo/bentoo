+pub(crate) fn scroll_to_root_tool_call(
+    conversation: &Entity<ConversationView>,
+    tool_call_id: &acp_v2::ToolCallId,
+    cx: &mut App,
+) -> Option<usize> {
+    let thread_view = conversation.read(cx).root_thread_view()?;
+    let item_ix = thread_view
+        .read(cx)
+        .thread
+        .read(cx)
+        .entries()
+        .iter()
+        .position(|entry| {
+            matches!(entry, acp_thread::AgentThreadEntry::ToolCall(call) if &call.id == tool_call_id)
+        })?;
+    // A subagent shown full screen would hide the root list: the scroll would be reported
+    // but never seen.
+    conversation.update(cx, |conversation, cx| conversation.show_root_thread(cx));
+    thread_view.update(cx, |thread_view, cx| {
+        thread_view.list_state.scroll_to(gpui::ListOffset {
+            item_ix,
+            offset_in_item: px(0.),
+        });
+        cx.notify();
+    });
+    Some(item_ix)
+}
