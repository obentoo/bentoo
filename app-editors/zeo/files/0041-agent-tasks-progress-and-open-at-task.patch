+/// What a running row paints beside its controls: `<last tool> · <N> tools · <elapsed>`,
+/// or `starting · <elapsed>` before the first tool; `None` once the task ended (R1.1–R1.4).
+/// The row paints the same two parts as separate labels, on its second line; GPUI test windows report painted
+/// bounds, not text, so the tests read the text through this.
+#[cfg(test)]
+pub(crate) fn progress_label(task: &AgentTask, now: SystemTime) -> Option<SharedString> {
+    if !task.status.is_running() {
+        return None;
+    }
+    let elapsed = now.duration_since(task.started_at).unwrap_or_default();
+    Some(format!("{} · {}", progress_activity(task), format_duration(elapsed)).into())
+}
+
+/// The last tool and the tool count, or `starting` while the feed reports no tool use.
+fn progress_activity(task: &AgentTask) -> String {
+    let tool_uses = task.usage.as_ref().map_or(0, |usage| usage.tool_uses);
+    match &task.last_tool {
+        Some(last_tool) if tool_uses > 0 => {
+            let noun = if tool_uses == 1 { "tool" } else { "tools" };
+            format!("{last_tool} · {tool_uses} {noun}")
+        }
+        _ => "starting".to_string(),
+    }
+}
+
