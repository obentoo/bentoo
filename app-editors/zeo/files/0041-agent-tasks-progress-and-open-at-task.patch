diff --git a/crates/agent_tasks_panel/src/store/tool_call_id_tests.rs b/crates/agent_tasks_panel/src/store/tool_call_id_tests.rs
new file mode 100644
index 0000000..42632a6
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/tool_call_id_tests.rs
@@ -0,0 +1,266 @@
+// Story 023, task 3.2 — the tool call id travels from the feed to the record, and a later
+// report fills a missing one in, in memory and on disk (R2.1, R2.3, Q4). Module path:
+// `store::tool_call_id`. Wired in `src/store.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "store/tool_call_id_tests.rs"]
+//     mod tool_call_id;
+//
+// Validation filter: `store_tool_call_id_`.
+//
+// Hostile halves first: a later report carrying a DIFFERENT id must not overwrite the stored
+// one (wrong overwrite), and a fill must not land on another task of the session, nor on the
+// same task id of another session (wrong collapse). Only then the benign fill.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+fn registered_store(db: &AgentTaskHistoryDb, rig: &mut CardRig) -> Entity<TaskHistoryStore> {
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    store
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn call_of(rows: &[HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+        .record
+        .tool_call_id
+        .as_ref()
+        .map(|id| id.to_string())
+}
+
+// Hostile (wrong overwrite): a replayed start and an ending that carry a different id leave
+// the first id in memory and on disk.
+#[gpui::test]
+async fn store_tool_call_id_never_overwrites_a_different_id(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_tool_call_id_no_overwrite").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    let first = record_with_call(
+        "s1",
+        "t1",
+        AgentTaskStatus::Running,
+        1_000,
+        Some("toolu_first"),
+    );
+    emit(&card, started(&first), &mut rig.cx);
+    let replay = record_with_call(
+        "s1",
+        "t1",
+        AgentTaskStatus::Running,
+        1_000,
+        Some("toolu_second"),
+    );
+    emit(&card, started(&replay), &mut rig.cx);
+    let end = record_with_call(
+        "s1",
+        "t1",
+        AgentTaskStatus::Completed,
+        1_000,
+        Some("toolu_third"),
+    );
+    emit(&card, ended(&end), &mut rig.cx);
+
+    assert_eq!(
+        call_of(&entries(&store, &rig.cx), "s1", "t1").as_deref(),
+        Some("toolu_first"),
+        "memory keeps the first id"
+    );
+    assert_eq!(
+        call_of(&load(&db).await, "s1", "t1").as_deref(),
+        Some("toolu_first"),
+        "the database keeps the first id"
+    );
+}
+
+// Hostile (wrong collapse): a report of (s1, t1) with an id fills that record only.
+#[gpui::test]
+async fn store_tool_call_id_fill_touches_only_its_own_task(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_tool_call_id_own_task").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    for (session, task) in [("s1", "t1"), ("s1", "t2"), ("s2", "t1")] {
+        emit(
+            &card,
+            started(&record(session, task, AgentTaskStatus::Running, 1_000)),
+            &mut rig.cx,
+        );
+    }
+    emit(
+        &card,
+        started(&record_with_call(
+            "s1",
+            "t1",
+            AgentTaskStatus::Running,
+            1_000,
+            Some("toolu_s1_t1"),
+        )),
+        &mut rig.cx,
+    );
+
+    for rows in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(call_of(&rows, "s1", "t1").as_deref(), Some("toolu_s1_t1"));
+        assert_eq!(
+            call_of(&rows, "s1", "t2"),
+            None,
+            "another task of the session"
+        );
+        assert_eq!(
+            call_of(&rows, "s2", "t1"),
+            None,
+            "the same task id in another session"
+        );
+    }
+}
+
+// R2.3 — benign: a task recorded without an id (as a pre-story row, or a feed that had none
+// yet) gets it from a later start replay, or from its ending; memory and disk agree.
+#[gpui::test]
+async fn store_tool_call_id_fills_a_missing_id_from_a_later_report(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_tool_call_id_fill").await;
+    // A pre-story row: recorded before this story, so with no id.
+    db.insert_started(&record("s0", "legacy", AgentTaskStatus::Completed, 500))
+        .await
+        .unwrap();
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record_with_call(
+            "s0",
+            "legacy",
+            AgentTaskStatus::Completed,
+            500,
+            Some("toolu_legacy"),
+        )),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        started(&record("s1", "ends", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        ended(&record_with_call(
+            "s1",
+            "ends",
+            AgentTaskStatus::Completed,
+            1_000,
+            Some("toolu_ends"),
+        )),
+        &mut rig.cx,
+    );
+
+    for rows in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(
+            call_of(&rows, "s0", "legacy").as_deref(),
+            Some("toolu_legacy")
+        );
+        assert_eq!(call_of(&rows, "s1", "ends").as_deref(), Some("toolu_ends"));
+    }
+}
+
+// R2.1 — through the real feed: `TaskRecord::new` keeps the snapshot's `toolCallId`, and a
+// task the feed gives none to is recorded with none (never an empty string).
+#[gpui::test]
+async fn store_tool_call_id_records_the_id_the_feed_provides(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Feed thread");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task_with_call("with", "running", 1_000, Some("toolu_feed_01"), 0),
+            wire_task_with_call("without", "running", 2_000, None, 0),
+        ],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+
+    let memory = panels
+        .cx
+        .update(|_, cx| TaskHistoryStore::global(cx).read(cx).records().to_vec());
+    assert_eq!(
+        call_of(&memory, &session, "with").as_deref(),
+        Some("toolu_feed_01")
+    );
+    assert_eq!(call_of(&memory, &session, "without"), None);
+    let stored = load(&db).await;
+    assert_eq!(
+        call_of(&stored, &session, "with").as_deref(),
+        Some("toolu_feed_01")
+    );
+    assert_eq!(call_of(&stored, &session, "without"), None);
+}
+
+// Q4 — a fill the database refuses is logged at error level with the session and task ids,
+// like the other history writes, and memory keeps the id.
+#[gpui::test]
+async fn store_tool_call_id_failed_fill_is_logged_and_kept_in_memory(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_tool_call_id_failed_fill").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record(
+            "session-fill",
+            "task-fill",
+            AgentTaskStatus::Running,
+            1_000,
+        )),
+        &mut rig.cx,
+    );
+    run_sql(
+        &db,
+        "CREATE TRIGGER refuse_fill BEFORE UPDATE OF tool_call_id ON agent_task_history \
+         BEGIN SELECT RAISE(ABORT, 'fill refused'); END",
+    )
+    .await;
+
+    capture_logs();
+    emit(
+        &card,
+        started(&record_with_call(
+            "session-fill",
+            "task-fill",
+            AgentTaskStatus::Running,
+            1_000,
+            Some("toolu_refused"),
+        )),
+        &mut rig.cx,
+    );
+
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("session-fill") && line.contains("task-fill")),
+        "the failed fill is logged at error level with its ids: {errors:?}"
+    );
+    assert_eq!(
+        call_of(&entries(&store, &rig.cx), "session-fill", "task-fill").as_deref(),
+        Some("toolu_refused"),
+        "memory keeps the id"
+    );
+    assert_eq!(
+        call_of(&load(&db).await, "session-fill", "task-fill"),
+        None,
+        "the refused write left the row as it was"
+    );
+}
