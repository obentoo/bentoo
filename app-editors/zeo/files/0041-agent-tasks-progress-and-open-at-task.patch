+// Story 023, task 4.1 — `open_agent_session` with a tool call id scrolls the opened ROOT
+// thread to that tool call once the thread is held, and reports whether it did (R3.2, R3.3).
+// Wired in `src/agent_session_router.rs` (story 024's module) as
+//
+//     #[cfg(test)]
+//     #[path = "agent_session_router/scroll_tests.rs"]
+//     mod scroll;
+//
+// Validation filter: `agent_session_router_scroll_`.
+//
+// Contract: story 024's `crate::{open_agent_session, OpenAgentSessionOptions,
+// OpenedAgentSession}` with `OpenAgentSessionOptions::tool_call_id: Option<acp_v2::ToolCallId>`,
+// plus this story's `OpenedAgentSession::scrolled_to_tool_call: bool`. The window rig is a
+// trimmed copy of story 024's `routing_tests.rs` fixtures (private to that module).
+//
+// Hostile halves first, for "the entry that IS this tool call":
+//   - wrongly COLLAPSE: a nested subagent's id that extends a root call's id
+//     (`toolu_parent_child` vs `toolu_parent`), and a prefix of it (`toolu_paren`), must not
+//     scroll to `toolu_parent`; a root call `toolu_t10` placed BEFORE `toolu_t1` must not be
+//     taken for `toolu_t1`.
+//   - the benign case: the exact id, from another window, lands on its entry.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use acp_thread::{AcpThread, AgentThreadEntry, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp;
+use agent_client_protocol::schema::v2 as acp_v2;
+use fs::FakeFs;
+use gpui::{
+    AnyWindowHandle, AppContext as _, Entity, TestAppContext, VisualTestContext, WindowHandle,
+};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::{AgentPanel, OpenAgentSessionOptions, OpenedAgentSession, open_agent_session};
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext, roots: &[&str]) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    for root in roots {
+        fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    }
+    fs
+}
+
+struct Win {
+    window: WindowHandle<MultiWorkspace>,
+    workspace: Entity<Workspace>,
+    panel: Entity<AgentPanel>,
+    cx: VisualTestContext,
+}
+
+impl Win {
+    fn any(&self) -> AnyWindowHandle {
+        self.window.into()
+    }
+}
+
+async fn window(fs: &Arc<FakeFs>, roots: &[&str], cx: &mut TestAppContext) -> Win {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    vcx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    Win {
+        window,
+        workspace,
+        panel,
+        cx: vcx,
+    }
+}
+
+/// A live, persisted thread in `win` whose root entries are twenty message pairs, then each
+/// of `calls` followed by twenty more pairs. Returns the thread and its session.
+fn thread_with_calls(win: &mut Win, calls: &[&str]) -> (Entity<AcpThread>, acp_v2::SessionId) {
+    crate::test_support::open_thread_with_connection(
+        &win.panel,
+        StubAgentConnection::new(),
+        &mut win.cx,
+    );
+    crate::test_support::send_message(&win.panel, &mut win.cx);
+    win.cx.run_until_parked();
+    let thread = win
+        .panel
+        .read_with(&win.cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    thread.update(&mut win.cx, |thread, cx| {
+        let mut push = |update: acp::SessionUpdate| {
+            thread
+                .handle_session_update(update, cx)
+                .expect("entry applies");
+        };
+        let mut block = 0;
+        let mut pairs = |push: &mut dyn FnMut(acp::SessionUpdate)| {
+            for i in 0..20 {
+                push(acp::SessionUpdate::UserMessageChunk(
+                    acp::ContentChunk::new(format!("question {block}.{i}").into()),
+                ));
+                push(acp::SessionUpdate::AgentMessageChunk(
+                    acp::ContentChunk::new(format!("answer {block}.{i}").into()),
+                ));
+            }
+            block += 1;
+        };
+        pairs(&mut push);
+        for call in calls {
+            push(acp::SessionUpdate::ToolCall(acp::ToolCall::new(
+                call.to_string(),
+                format!("Run {call}"),
+            )));
+            pairs(&mut push);
+        }
+    });
+    win.cx.run_until_parked();
+    let session = crate::test_support::active_session_id(&win.panel, &win.cx);
+    (thread, session)
+}
+
+/// A second thread brought to the front, so the first is held but not shown.
+fn later_thread(win: &mut Win) {
+    crate::test_support::open_thread_with_connection(
+        &win.panel,
+        StubAgentConnection::new(),
+        &mut win.cx,
+    );
+    crate::test_support::send_message(&win.panel, &mut win.cx);
+    win.cx.run_until_parked();
+}
+
+fn index_of(thread: &Entity<AcpThread>, id: &str, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .position(|entry| {
+                matches!(entry, AgentThreadEntry::ToolCall(call) if call.id.to_string() == id)
+            })
+            .unwrap_or_else(|| panic!("{id} is a root entry"))
+    })
+}
+
+fn scroll_top(panel: &Entity<AgentPanel>, cx: &mut VisualTestContext) -> usize {
+    let view = panel.read_with(cx, |panel, cx| panel.active_thread_view(cx).unwrap());
+    view.read_with(cx, |view, _| view.list_state.logical_scroll_top().item_ix)
+}
+
+fn shown_session(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Option<acp_v2::SessionId> {
+    panel.read_with(cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().clone())
+    })
+}
+
+fn activate(win: &mut Win) {
+    win.cx.update(|window, _| window.activate_window());
+    win.cx.run_until_parked();
+}
+
+async fn route(
+    session: &acp_v2::SessionId,
+    tool_call_id: Option<&str>,
+    caller: &Win,
+    cx: &mut TestAppContext,
+) -> OpenedAgentSession {
+    let app_state = caller
+        .workspace
+        .read_with(cx, |workspace, _| workspace.app_state().clone());
+    let fallback_window = caller.any();
+    let session = session.clone();
+    let tool_call_id = tool_call_id.map(|id| acp_v2::ToolCallId::new(id.to_string()));
+    let routing = cx.update(|cx| {
+        open_agent_session(
+            session,
+            OpenAgentSessionOptions {
+                cwd: None::<PathBuf>,
+                fallback_window: Some(fallback_window),
+                tool_call_id,
+                task_id: None,
+            },
+            app_state,
+            cx,
+        )
+    });
+    cx.run_until_parked();
+    routing.await.expect("the session opens")
+}
+
+// R3.3 — hostile (wrong collapse): a nested subagent's call is not a root entry. Neither its
+// id (which extends the root call `toolu_parent` that spawned the subagent) nor a prefix of
+// that root id scrolls anywhere; no id at all scrolls nowhere either. Never an error.
+#[gpui::test]
+async fn agent_session_router_scroll_ignores_a_call_that_is_not_a_root_entry(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = window(&fs, &["/work/zed"], cx).await;
+    let (thread, session) = thread_with_calls(&mut a, &["toolu_parent"]);
+    let parent = index_of(&thread, "toolu_parent", &a.cx);
+    let mut b = window(&fs, &["/work/zed-patches"], cx).await;
+
+    for asked in [None, Some("toolu_parent_child"), Some("toolu_paren")] {
+        later_thread(&mut a);
+        activate(&mut b);
+        let opened = route(&session, asked, &b, cx).await;
+        a.cx.run_until_parked();
+
+        assert_eq!(opened.window, a.any(), "{asked:?}: the thread's own window");
+        assert_eq!(shown_session(&a.panel, &a.cx), Some(session.clone()));
+        assert!(
+            !opened.scrolled_to_tool_call,
+            "{asked:?} is not a root entry: no scroll is reported"
+        );
+        assert_ne!(
+            scroll_top(&a.panel, &mut a.cx),
+            parent,
+            "{asked:?} must not land on the subagent's parent call"
+        );
+    }
+}
+
+// R3.2 — hostile (wrong collapse): `toolu_t10` comes first in the thread and starts with
+// `toolu_t1`; asking for `toolu_t1` lands on `toolu_t1`.
+#[gpui::test]
+async fn agent_session_router_scroll_lands_on_the_exact_entry_not_a_lookalike(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = window(&fs, &["/work/zed"], cx).await;
+    let (thread, session) = thread_with_calls(&mut a, &["toolu_t10", "toolu_t1", "toolu_t100"]);
+    let lookalike = index_of(&thread, "toolu_t10", &a.cx);
+    let exact = index_of(&thread, "toolu_t1", &a.cx);
+    assert!(lookalike < exact, "precondition: the lookalike comes first");
+    later_thread(&mut a);
+    let mut b = window(&fs, &["/work/zed-patches"], cx).await;
+    activate(&mut b);
+
+    let opened = route(&session, Some("toolu_t1"), &b, cx).await;
+    a.cx.run_until_parked();
+
+    assert!(opened.scrolled_to_tool_call);
+    assert_eq!(scroll_top(&a.panel, &mut a.cx), exact);
+}
+
+// R3.2 — benign: from another window, the held thread comes forward in its own window and,
+// once it is shown, is scrolled to the tool call — not left where showing it put it.
+#[gpui::test]
+async fn agent_session_router_scroll_to_the_tool_call_from_another_window(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut a = window(&fs, &["/work/zed"], cx).await;
+    let (thread, session) = thread_with_calls(&mut a, &["toolu_start"]);
+    let start = index_of(&thread, "toolu_start", &a.cx);
+    assert!(start > 0);
+    later_thread(&mut a);
+    let mut b = window(&fs, &["/work/zed-patches"], cx).await;
+    activate(&mut b);
+
+    let opened = route(&session, Some("toolu_start"), &b, cx).await;
+    a.cx.run_until_parked();
+
+    assert_eq!(opened.window, a.any());
+    assert_eq!(opened.workspace, a.workspace);
+    assert_eq!(shown_session(&a.panel, &a.cx), Some(session));
+    assert!(opened.scrolled_to_tool_call, "the scroll is reported");
+    assert_eq!(scroll_top(&a.panel, &mut a.cx), start);
+}
