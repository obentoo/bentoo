@@ -0,0 +1,211 @@
+// Story 023, task 8.1 — a running row's progress reads on a second line below its
+// description, so the description keeps the row's width; an ended row keeps its status and
+// duration on line 1 and gains no second line (R1.1, R1.4, R1.6). Wired in
+// `src/tasks_card.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/progress_line_tests.rs"]
+//     mod progress_line;
+//
+// Validation filter: `tasks_card_progress_line_`.
+//
+// Contract: the selectors of story 013/023 stay as they are — `tasks-card-row-{id}`,
+// `tasks-card-label-{id}` (the description), `tasks-card-mode-{id}` (the chip),
+// `tasks-card-open-{id}` / `tasks-card-stop-{id}` (controls), `tasks-card-progress-{id}`
+// holding `tasks-card-elapsed-{id}` (running), `tasks-card-ended-{id}` (ended). GPUI's test
+// window records painted bounds per debug selector; every assertion here is on those bounds.
+//
+// Hostile halves first: the progress must NOT share the description's line (which is what
+// squeezes the description to "Run…"), and the converse — an ended row must NOT be split
+// onto a second line it has nothing to put on.
+
+use gpui::{Bounds, Pixels, TestAppContext, VisualTestContext, px};
+use serde_json::json;
+
+use super::test_helpers::*;
+
+const LONG_DESCRIPTION: &str = "Run the whole workspace test suite and collect every failing \
+     test into a report grouped by crate";
+const LONG_TOOL: &str = "mcp__playwright__browser_take_screenshot_of_the_full_page";
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// A running wire task with a long description that has reported progress through a tool
+/// with a long name: today's one-line layout gives that progress up to half the line.
+fn busy_described(id: &str) -> serde_json::Value {
+    let mut task = wire_task(id, "running", true, 1_000);
+    task["description"] = json!(LONG_DESCRIPTION);
+    task["lastTool"] = json!(LONG_TOOL);
+    task["usage"] = json!({ "tokens": 4_321, "toolUses": 17, "durationMs": 9_000 });
+    task
+}
+
+/// An ended wire task with the same long description.
+fn ended_described(id: &str, status: &str) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, 1_000);
+    task["description"] = json!(LONG_DESCRIPTION);
+    task["lastTool"] = json!(LONG_TOOL);
+    task["usage"] = json!({ "tokens": 4_321, "toolUses": 17, "durationMs": 9_000 });
+    task
+}
+
+fn bounds(selector: &'static str, cx: &mut VisualTestContext) -> Bounds<Pixels> {
+    cx.debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"))
+}
+
+fn same_line(a: Bounds<Pixels>, b: Bounds<Pixels>) -> bool {
+    a.top() < b.bottom() && b.top() < a.bottom()
+}
+
+fn inside(inner: Bounds<Pixels>, outer: Bounds<Pixels>) -> bool {
+    inner.left() >= outer.left()
+        && inner.right() <= outer.right()
+        && inner.top() >= outer.top()
+        && inner.bottom() <= outer.bottom()
+}
+
+// R1.6 (hostile half: the progress must not share the description's line) — on a running
+// row the progress is painted below the description, under it, inside the row; the kind,
+// chip and controls stay on the description's line, and the elapsed time stays inside the
+// progress (R1.1).
+#[gpui::test]
+async fn tasks_card_progress_line_is_painted_below_the_description(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![busy_described("t1")], &mut cx);
+    draw(&mut cx);
+    let sa = session_of(&a, &cx);
+    assert!(
+        find_row(&card(&panel, &cx), &sa, "t1", &mut cx).is_some(),
+        "precondition: t1 is on the card"
+    );
+
+    let row = bounds("tasks-card-row-t1", &mut cx);
+    let label = bounds("tasks-card-label-t1", &mut cx);
+    let progress = bounds("tasks-card-progress-t1", &mut cx);
+    let elapsed = bounds("tasks-card-elapsed-t1", &mut cx);
+
+    assert!(
+        progress.top() >= label.bottom(),
+        "the progress sits on a line below the description: \
+         progress {progress:?}, description {label:?}"
+    );
+    assert!(
+        inside(progress, row),
+        "the progress line is inside its row: {progress:?} in {row:?}"
+    );
+    assert!(
+        progress.left() >= label.left(),
+        "the progress line is indented under the description, not under the kind: \
+         progress {progress:?}, description {label:?}"
+    );
+    assert!(
+        inside(elapsed, progress) && same_line(progress, elapsed),
+        "the elapsed time is part of the progress line: {elapsed:?} in {progress:?}"
+    );
+    for control in [
+        "tasks-card-mode-t1",
+        "tasks-card-open-t1",
+        "tasks-card-stop-t1",
+    ] {
+        let control_bounds = bounds(control, &mut cx);
+        assert!(
+            same_line(control_bounds, label),
+            "{control} stays on the description's line: {control_bounds:?} vs {label:?}"
+        );
+        assert!(
+            !same_line(control_bounds, progress),
+            "{control} is not on the progress line: {control_bounds:?} vs {progress:?}"
+        );
+    }
+}
+
+// R1.6 — with the progress moved off line 1, a long description on a running row keeps
+// the whole of line 1 that the kind, the chip and the controls leave: it reaches the chip,
+// and nothing but the row's gap stands between the chip and the first control, however long
+// the last tool's name is.
+//
+// Not "wider than half the row": measured on 2026-10-06, the test card's row is 292px and
+// kind (~26px), chip (~61px) and three controls (~68px) leave the description ~118px even
+// with no progress on line 1, so a half-the-row bound would fail a correct layout. Today the
+// progress takes ~118px of line 1 and the description is painted 0px wide.
+#[gpui::test]
+async fn tasks_card_progress_line_leaves_the_description_the_whole_line(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![busy_described("t1")], &mut cx);
+    draw(&mut cx);
+
+    assert!(
+        cx.debug_bounds("tasks-card-progress-t1").is_some(),
+        "precondition: the running row paints its progress"
+    );
+    let label = bounds("tasks-card-label-t1", &mut cx);
+    let chip = bounds("tasks-card-mode-t1", &mut cx);
+    let open = bounds("tasks-card-open-t1", &mut cx);
+    // `gap_1` is 4px; one gap plus rounding, never a whole element.
+    let one_gap = px(8.);
+    assert!(
+        open.left() - chip.right() <= one_gap,
+        "nothing but a gap between the chip and the first control on line 1: \
+         chip {chip:?}, open {open:?}"
+    );
+    assert!(
+        chip.left() - label.right() <= one_gap,
+        "the description reaches the chip: description {label:?}, chip {chip:?}"
+    );
+    assert!(
+        label.size.width > px(0.),
+        "the description is not squeezed away: {label:?}"
+    );
+}
+
+// R1.4 (converse hostile half: an ended row must not be split onto a second line) — an
+// ended row paints no progress, keeps its status and duration on the description's line,
+// and stays one line tall: as tall as another ended row, shorter than a running row whose
+// progress takes a second line.
+#[gpui::test]
+async fn tasks_card_progress_line_is_absent_from_an_ended_row(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            ended_described("t1", "completed"),
+            ended_described("t2", "failed"),
+            busy_described("t3"),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    assert!(
+        cx.debug_bounds("tasks-card-progress-t1").is_none(),
+        "no progress on an ended row"
+    );
+    let label = bounds("tasks-card-label-t1", &mut cx);
+    let ended = bounds("tasks-card-ended-t1", &mut cx);
+    assert!(
+        same_line(ended, label),
+        "status and duration stay on the description's line: {ended:?} vs {label:?}"
+    );
+
+    let ended_row = bounds("tasks-card-row-t1", &mut cx);
+    let other_ended_row = bounds("tasks-card-row-t2", &mut cx);
+    let running_row = bounds("tasks-card-row-t3", &mut cx);
+    assert_eq!(
+        ended_row.size.height, other_ended_row.size.height,
+        "every ended row is one line tall"
+    );
+    assert!(
+        ended_row.size.height < running_row.size.height,
+        "only a running row gains the progress line: ended {ended_row:?}, running {running_row:?}"
+    );
+}
