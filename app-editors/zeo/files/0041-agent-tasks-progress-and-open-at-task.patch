--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/tool_call_id_contract_tests.rs
@@ -0,0 +1,168 @@
+// Story 023, task 5.1 — one tool call id, end to end: the feed's `toolCallId` (acp) becomes
+// the record's `SharedString`, the database's TEXT, the reloaded record, and the router's
+// `acp::ToolCallId` — and the scroll lands on the entry with that exact spelling (R2.1, R3.2,
+// R3.3). Module path: `panel::tool_call_id_contract`. Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/tool_call_id_contract_tests.rs"]
+//     mod tool_call_id_contract;
+//
+// Validation filter: `tool_call_id_contract_`.
+//
+// The id is a value this story DERIVES at three type boundaries, so its hostile half is a
+// THIRD element: decoy ids that differ from it only by case, by an ASCII-folded letter, or by
+// a trailing space. Any normalisation on the way (lowercasing, folding, trimming) makes the
+// target collide with a decoy; the decoys sit BEFORE the target in the thread so that a
+// "first match" lands on them.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, TestAppContext};
+
+use crate::TaskHistoryStore;
+use crate::test_helpers::*;
+
+const EXACT: &str = "toolu_01Ab:Cd/é-9";
+const LOWER: &str = "toolu_01ab:cd/é-9";
+const FOLDED: &str = "toolu_01Ab:Cd/e-9";
+const SPACED: &str = "toolu_01Ab:Cd/é-9 ";
+
+fn call_of(rows: &[crate::HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+        .record
+        .tool_call_id
+        .as_ref()
+        .map(|id| id.to_string())
+}
+
+// R2.1 — feed → memory → disk → reload: each task keeps its own id byte for byte, decoys
+// included, through a restart of the store over the same database.
+#[gpui::test]
+async fn tool_call_id_contract_feed_to_disk_keeps_the_exact_spelling(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Contract thread");
+    let ids = [
+        ("lower", LOWER),
+        ("folded", FOLDED),
+        ("spaced", SPACED),
+        ("exact", EXACT),
+    ];
+    send_tasks(
+        &thread,
+        ids.iter()
+            .enumerate()
+            .map(|(n, (task, id))| {
+                wire_task_with_call(task, "running", 1_000 + n as u64, Some(id), 0)
+            })
+            .collect(),
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+
+    let memory = panels
+        .cx
+        .update(|_, cx| TaskHistoryStore::global(cx).read(cx).records().to_vec());
+    let stored = load(&db).await;
+    let reloaded_store = panels
+        .cx
+        .update(|_, cx| cx.new(|cx| TaskHistoryStore::new(db.clone(), cx)));
+    panels.cx.run_until_parked();
+    let reloaded = reloaded_store.read_with(&panels.cx, |store, _| store.records().to_vec());
+
+    for (rows, stage) in [(memory, "memory"), (stored, "disk"), (reloaded, "reload")] {
+        for (task, id) in ids {
+            assert_eq!(
+                call_of(&rows, &session, task).as_deref(),
+                Some(id),
+                "{stage}: task {task} keeps its own id"
+            );
+        }
+    }
+}
+
+// R3.2, R3.3 — disk → scroll: a record whose id reaches the panel ONLY through the database
+// (the live feed lists no task) scrolls the root thread, from another window, to the entry
+// with exactly that spelling — past three lookalikes placed before it. A nested record of the
+// same thread falls back to the no-entry notice.
+#[gpui::test]
+async fn tool_call_id_contract_disk_to_scroll_lands_on_the_exact_entry(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    // Window A first, without the Agent Tasks panel: the history is not loaded yet.
+    let mut a = project_window(&fs, &["/work/zed"], true, false, cx).await;
+    let thread = thread_with_calls(
+        &mut a,
+        "Thread of A",
+        &[LOWER, FOLDED, SPACED, EXACT],
+        vec![],
+    );
+    let session = session_of(&thread, &a.cx);
+    let exact = tool_call_index(&thread, EXACT, &a.cx);
+    for decoy in [LOWER, FOLDED, SPACED] {
+        assert!(
+            tool_call_index(&thread, decoy, &a.cx) < exact,
+            "precondition: {decoy:?} first"
+        );
+    }
+    let session_text = session.to_string();
+    db.insert_started(&record_with_call(
+        &session_text,
+        "contract-task",
+        AgentTaskStatus::Completed,
+        1_000,
+        Some(EXACT),
+    ))
+    .await
+    .unwrap();
+    db.insert_started(&record_with_call(
+        &session_text,
+        "contract-nested",
+        AgentTaskStatus::Completed,
+        2_000,
+        Some("toolu_contract_nested"),
+    ))
+    .await
+    .unwrap();
+    // Now the history loads, from disk.
+    cx.update(|cx| crate::init(cx));
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let tasks_panel_b = b.tasks_panel().clone();
+
+    open_from(
+        &tasks_panel_b,
+        &key(&session_text, "contract-task"),
+        &mut b.cx,
+    );
+    a.cx.run_until_parked();
+
+    let agent_panel_a = a.agent_panel().clone();
+    assert_eq!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert_eq!(
+        scroll_top(&agent_panel_a, &mut a.cx),
+        exact,
+        "the exact spelling's entry, not a lookalike"
+    );
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "contract-task", &mut b.cx),
+        None
+    );
+
+    let _later_again = thread_with_task(&mut a, "Another thread of A", "v");
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    open_from(
+        &tasks_panel_b,
+        &key(&session_text, "contract-nested"),
+        &mut b.cx,
+    );
+    a.cx.run_until_parked();
+    assert_eq!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert_eq!(
+        notice_of(&tasks_panel_b, &session, "contract-nested", &mut b.cx).as_deref(),
+        Some(NO_ENTRY_NOTICE)
+    );
+}
