+
+// ── Story 023 — tool call ids, root entries, the scroll position, log lines ──
+//
+// Contract assumed: `TaskRecord::tool_call_id: Option<SharedString>`; the panel's open action
+// is still `AgentTasksPanel::open_task(&key, window, cx)` (now "Open at Task"); the thread
+// view the agent panel shows is `AgentPanel::active_thread_view(cx)` with its `list_state`.
+
+/// The notice a row shows when its thread opened but there is no entry to jump to (R3.3).
+pub(crate) const NO_ENTRY_NOTICE: &str = "Opened the thread; this task has no entry to jump to";
+
+/// `record`, carrying the tool call that started the task.
+pub(crate) fn record_with_call(
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    started_ms: i64,
+    tool_call_id: Option<&str>,
+) -> TaskRecord {
+    let mut record = record(session, task, status, started_ms);
+    record.tool_call_id = tool_call_id.map(|id| SharedString::from(id.to_string()));
+    record
+}
+
+/// `wire_task`, with an explicit `toolCallId` (`None` sends `null`), depth and type.
+pub(crate) fn wire_task_with_call(
+    id: &str,
+    status: &str,
+    started_at_ms: u64,
+    tool_call_id: Option<&str>,
+    depth: u32,
+) -> serde_json::Value {
+    let mut task = wire_task(id, status, started_at_ms, None);
+    task["toolCallId"] = json!(tool_call_id);
+    task["depth"] = json!(depth);
+    if depth > 0 {
+        task["type"] = json!("subagent");
+    }
+    task
+}
+
+/// Pushes into `thread`'s ROOT entries twenty question/answer pairs, then each tool call of
+/// `calls` followed by twenty more pairs — so scrolling to any of them moves the list.
+pub(crate) fn push_tool_calls(
+    thread: &Entity<AcpThread>,
+    calls: &[&str],
+    cx: &mut VisualTestContext,
+) {
+    thread.update(cx, |thread, cx| {
+        let mut push = |update: acp::SessionUpdate| {
+            thread
+                .handle_session_update(update, cx)
+                .expect("entry applies");
+        };
+        let pairs = |push: &mut dyn FnMut(acp::SessionUpdate), from: usize| {
+            for i in from..from + 20 {
+                push(acp::SessionUpdate::UserMessageChunk(
+                    acp::ContentChunk::new(format!("question {i}").into()),
+                ));
+                push(acp::SessionUpdate::AgentMessageChunk(
+                    acp::ContentChunk::new(format!("answer {i}").into()),
+                ));
+            }
+        };
+        pairs(&mut push, 0);
+        for (n, call) in calls.iter().enumerate() {
+            push(acp::SessionUpdate::ToolCall(acp::ToolCall::new(
+                call.to_string(),
+                format!("Tool call {n}"),
+            )));
+            pairs(&mut push, (n + 1) * 20);
+        }
+    });
+    cx.run_until_parked();
+}
+
+/// The index of the root entry that is the tool call `id`, compared byte for byte.
+pub(crate) fn tool_call_index(
+    thread: &Entity<AcpThread>,
+    id: &str,
+    cx: &VisualTestContext,
+) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .position(|entry| {
+                matches!(entry, acp_thread::AgentThreadEntry::ToolCall(call) if call.id.to_string() == id)
+            })
+            .unwrap_or_else(|| panic!("{id:?} is a root entry"))
+    })
+}
+
+/// The first entry `agent_panel`'s shown thread is scrolled to.
+pub(crate) fn scroll_top(agent_panel: &Entity<AgentPanel>, cx: &mut VisualTestContext) -> usize {
+    let view = agent_panel.read_with(cx, |panel, cx| {
+        panel
+            .active_thread_view(cx)
+            .expect("the agent panel shows a thread")
+    });
+    view.read_with(cx, |view, _| view.list_state.logical_scroll_top().item_ix)
+}
+
+/// Every captured line, any level.
+pub(crate) fn log_lines() -> Vec<String> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .map(|(_, line)| line.clone())
+            .collect()
+    })
+}
+
+/// A live thread of `window`'s project whose root entries hold `calls`, listing `tasks`;
+/// returns the thread.
+pub(crate) fn thread_with_calls(
+    window: &mut ProjectWindow,
+    title: &str,
+    calls: &[&str],
+    tasks: Vec<serde_json::Value>,
+) -> Entity<AcpThread> {
+    let agent_panel = window.agent_panel().clone();
+    let thread = open_thread_on(&agent_panel, StopConnection::new(), title, &mut window.cx);
+    push_tool_calls(&thread, calls, &mut window.cx);
+    send_tasks(&thread, tasks, &mut window.cx);
+    thread
+}
