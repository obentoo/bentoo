diff --git a/crates/agent_tasks_panel/src/history_db/tool_call_id_tests.rs b/crates/agent_tasks_panel/src/history_db/tool_call_id_tests.rs
new file mode 100644
index 0000000..5c7fc30
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/tool_call_id_tests.rs
@@ -0,0 +1,297 @@
+// Story 023, task 3.1 — the history stores the tool call that started each task, migrates a
+// pre-story database without losing a record, and fills a missing id in (R2.1, R2.2, R2.3,
+// Q11). Module path: `history_db::tool_call_id`. Wired in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/tool_call_id_tests.rs"]
+//     mod tool_call_id;
+//
+// Validation filter: `history_db`.
+//
+// Contract: `HISTORY_MIGRATIONS[2]` adds the column (after story 022's label step); `TaskRecord::tool_call_id:
+// Option<SharedString>`; `AgentTaskHistoryDb::fill_tool_call_id(session_id, task_id,
+// tool_call_id)` — the argument types are adapted in `fill` below only.
+//
+// Hostile halves first. "The id of THIS task" must not wrongly COLLAPSE onto another row (a
+// fill of (s1, t1) touching (s1, t2) or (s2, t1)), and must not wrongly OVERWRITE (a later
+// different id replacing the one already stored). And step 0 as SHIPPED must still open —
+// an implementation that edits step 0 instead of appending passes every test that migrates
+// with `MIGRATIONS[..1]`, because that slice is the edited text.
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use agent_ui::TaskRecord;
+use db::sqlez::{connection::Connection, domain::Domain};
+use db::sqlez_macros::sql;
+use gpui::{SharedString, TestAppContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+/// Step 0 exactly as patch 0035 shipped it (the same tokens through the same macro), so a
+/// database created by a released Zeo is reproduced here byte for byte.
+const SHIPPED_STEP_0: &str = sql!(
+    CREATE TABLE IF NOT EXISTS agent_task_history(
+        session_id TEXT NOT NULL,
+        task_id TEXT NOT NULL,
+        thread_title TEXT,
+        project TEXT NOT NULL,
+        kind TEXT NOT NULL,
+        description TEXT NOT NULL,
+        background INTEGER NOT NULL,
+        status TEXT NOT NULL,
+        started_at INTEGER NOT NULL,
+        ended_at INTEGER,
+        tokens INTEGER,
+        tool_uses INTEGER,
+        archived INTEGER NOT NULL DEFAULT 0,
+        PRIMARY KEY(session_id, task_id)
+    ) STRICT;
+    CREATE INDEX IF NOT EXISTS agent_task_history_started ON agent_task_history(started_at);
+);
+
+async fn fill(db: &AgentTaskHistoryDb, session: &str, task: &str, tool_call_id: &str) {
+    db.fill_tool_call_id(
+        &sid(session),
+        &AgentTaskId::from(task.to_string()),
+        tool_call_id,
+    )
+    .await
+    .expect("fill_tool_call_id should succeed");
+}
+
+fn with_call(mut record: TaskRecord, id: &str) -> TaskRecord {
+    record.tool_call_id = Some(SharedString::from(id.to_string()));
+    record
+}
+
+fn call_of(rows: &[HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+        .record
+        .tool_call_id
+        .as_ref()
+        .map(|id| id.to_string())
+}
+
+fn migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+fn run_raw(connection: &Connection, statement: &str) {
+    connection
+        .exec(statement)
+        .and_then(|mut run| run())
+        .expect("raw statement should run");
+}
+
+fn columns(connection: &Connection) -> Vec<String> {
+    connection
+        .select::<String>("SELECT name FROM pragma_table_info('agent_task_history')")
+        .expect("table_info should prepare")()
+    .expect("table_info should run")
+}
+
+// ── Migration (R2.2, Q11) ──────────────────────────────────────────────────
+
+// Hostile: a database created by the SHIPPED step 0, holding records, opens with the new list
+// — no "Migration changed" — keeps every record and gives each no tool call id.
+#[test]
+fn history_db_tool_call_id_pre_story_database_keeps_every_record() {
+    let connection = Connection::open_memory(Some("history_db_tool_call_id_pre_story"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &[SHIPPED_STEP_0],
+            &mut |_, _, _| false,
+        )
+        .expect("the shipped step 0 applies");
+    for (session, task, status) in [
+        ("s-old", "t-done", "completed"),
+        ("s-old", "t-failed", "failed"),
+        ("s-other", "t-done", "interrupted"),
+    ] {
+        run_raw(
+            &connection,
+            &format!(
+                "INSERT INTO agent_task_history \
+                 (session_id, task_id, thread_title, project, kind, description, background, \
+                  status, started_at, ended_at, tokens, tool_uses, archived) \
+                 VALUES ('{session}', '{task}', 'Old thread', 'zeo', 'shell', 'Old task', 1, \
+                         '{status}', 1000, 2000, 10, 2, 1)"
+            ),
+        );
+    }
+
+    migrate_all(&connection);
+    migrate_all(&connection);
+
+    assert!(
+        columns(&connection)
+            .iter()
+            .any(|column| column == "tool_call_id"),
+        "the column is added: {:?}",
+        columns(&connection)
+    );
+    let rows = connection
+        .select::<(String, String, String, i64, Option<String>)>(
+            "SELECT session_id, task_id, status, archived, tool_call_id FROM agent_task_history \
+             ORDER BY session_id, task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows,
+        vec![
+            ("s-old".into(), "t-done".into(), "completed".into(), 1, None),
+            ("s-old".into(), "t-failed".into(), "failed".into(), 1, None),
+            (
+                "s-other".into(),
+                "t-done".into(),
+                "interrupted".into(),
+                1,
+                None
+            ),
+        ],
+        "every record survives, unchanged, with no tool call id"
+    );
+}
+
+// Q11 — the step is appended: step 0 is the shipped text, and a fresh database has the column.
+#[test]
+fn history_db_tool_call_id_is_one_step_appended_after_the_shipped_one() {
+    assert_eq!(
+        AgentTaskHistoryDb::MIGRATIONS[0],
+        SHIPPED_STEP_0,
+        "step 0 is never edited"
+    );
+    // Story 022's label step (0039) landed before this story: this story's step is the third.
+    assert!(
+        AgentTaskHistoryDb::MIGRATIONS[1]
+            == sql!(ALTER TABLE agent_task_history ADD COLUMN label TEXT;),
+        "the label step before it is left as shipped"
+    );
+    assert_eq!(
+        AgentTaskHistoryDb::MIGRATIONS.len(),
+        3,
+        "exactly one step is appended"
+    );
+    assert!(
+        AgentTaskHistoryDb::MIGRATIONS[2]
+            == sql!(ALTER TABLE agent_task_history ADD COLUMN tool_call_id TEXT;),
+        "the appended step adds the column"
+    );
+    let connection = Connection::open_memory(Some("history_db_tool_call_id_fresh"));
+    migrate_all(&connection);
+    assert!(
+        columns(&connection)
+            .iter()
+            .any(|column| column == "tool_call_id")
+    );
+}
+
+// ── fill_tool_call_id (R2.3) ───────────────────────────────────────────────
+
+// Hostile (wrong collapse): filling (s1, t1) leaves the other task of s1 and the same task id
+// of s2 without an id.
+#[gpui::test]
+async fn history_db_tool_call_id_fill_touches_only_its_own_task(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tool_call_id_fill_own").await;
+    for (session, task) in [("s1", "t1"), ("s1", "t2"), ("s2", "t1")] {
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, 1_000))
+            .await
+            .unwrap();
+    }
+
+    fill(&db, "s1", "t1", "toolu_s1_t1").await;
+
+    let rows = load(&db).await;
+    assert_eq!(call_of(&rows, "s1", "t1").as_deref(), Some("toolu_s1_t1"));
+    assert_eq!(
+        call_of(&rows, "s1", "t2"),
+        None,
+        "another task of the session"
+    );
+    assert_eq!(
+        call_of(&rows, "s2", "t1"),
+        None,
+        "the same task id in another session"
+    );
+}
+
+// Hostile (wrong overwrite): an id already stored is never replaced by a different one.
+#[gpui::test]
+async fn history_db_tool_call_id_fill_never_overwrites_a_stored_id(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tool_call_id_no_overwrite").await;
+    db.insert_started(&with_call(
+        record("s1", "t1", AgentTaskStatus::Running, 1_000),
+        "toolu_first",
+    ))
+    .await
+    .unwrap();
+
+    fill(&db, "s1", "t1", "toolu_second").await;
+
+    assert_eq!(
+        call_of(&load(&db).await, "s1", "t1").as_deref(),
+        Some("toolu_first")
+    );
+}
+
+// R2.1, R2.2, R2.3 — benign: an id the record carries round-trips; a record without one reads
+// back as none (also a row written with the shipped columns only); a fill gives it one.
+#[gpui::test]
+async fn history_db_tool_call_id_round_trips_and_fills_a_missing_one(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tool_call_id_round_trip").await;
+    db.insert_started(&with_call(
+        record("s1", "with", AgentTaskStatus::Running, 1_000),
+        "toolu_01Ab:Cd/é-9",
+    ))
+    .await
+    .unwrap();
+    db.insert_started(&record("s1", "without", AgentTaskStatus::Running, 2_000))
+        .await
+        .unwrap();
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at) \
+         VALUES ('s0', 'legacy', 'zeo', 'shell', 'Legacy task', 0, 'completed', 500)",
+    )
+    .await;
+
+    let rows = load(&db).await;
+    assert_eq!(
+        call_of(&rows, "s1", "with").as_deref(),
+        Some("toolu_01Ab:Cd/é-9"),
+        "stored and read back byte for byte"
+    );
+    assert_eq!(call_of(&rows, "s1", "without"), None);
+    assert_eq!(
+        call_of(&rows, "s0", "legacy"),
+        None,
+        "a pre-story row has none"
+    );
+
+    fill(&db, "s1", "without", "toolu_late").await;
+    fill(&db, "s0", "legacy", "toolu_legacy").await;
+    let rows = load(&db).await;
+    assert_eq!(
+        call_of(&rows, "s1", "without").as_deref(),
+        Some("toolu_late")
+    );
+    assert_eq!(
+        call_of(&rows, "s0", "legacy").as_deref(),
+        Some("toolu_legacy")
+    );
+    assert_eq!(
+        call_of(&rows, "s1", "with").as_deref(),
+        Some("toolu_01Ab:Cd/é-9"),
+        "the other row is untouched"
+    );
+}
