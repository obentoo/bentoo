+
+// ── Defect 1 of the upstream-native review — Waiting is live work ──────────
+
+/// A child waiting for the user shows its pending permission inside its card, as upstream
+/// shows a running child's: upstream embeds the prompt only while `status == Running`, and
+/// R5.2's `Waiting` -- reported by Claude Agent (Plus) before each permission request of a
+/// child -- had made it vanish exactly while a prompt was pending.
+#[gpui::test]
+async fn test_rfd_waiting_child_shows_its_permission_in_the_card(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let alpha = rig.spawn_child("alpha", "Alpha", true);
+    let alpha_card = rig.message("to-alpha", "alpha", false);
+    rig.report(
+        &alpha,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+    );
+    let (_request_id, _outcome) = rig.cx.update(|_, cx| {
+        alpha.update(cx, |thread, cx| {
+            thread
+                .request_tool_call_authorization_with_id(
+                    acp_v1::ToolCall::new(acp_v1::ToolCallId::new("alpha-call"), "Edit a file")
+                        .kind(acp_v1::ToolKind::Edit)
+                        .into(),
+                    PermissionOptions::Flat(vec![acp_v2::PermissionOption::new(
+                        acp_v2::PermissionOptionId::new("allow"),
+                        "Allow",
+                        acp_v2::PermissionOptionKind::AllowOnce,
+                    )]),
+                    acp_thread::AuthorizationKind::PermissionGrant,
+                    cx,
+                )
+                .expect("the request installs")
+        })
+    });
+    rig.cx.run_until_parked();
+
+    assert!(rig.painted(message_card(alpha_card)), "fixture: the card");
+    assert!(
+        rig.painted(card_permission(alpha_card)),
+        "the waiting child's pending permission is drawn inside its card"
+    );
+}
+
+/// Full screen opens a Waiting card where its subagent is, following its latest entries, as it
+/// does for a running one; only a card whose work has stopped opens at the start of its part.
+#[test]
+fn waiting_card_full_screen_follows_the_latest_entries() {
+    let card = |status| SubagentCardState {
+        label: None,
+        label_wins: true,
+        status,
+        error: None,
+        can_stop: false,
+        entries: None,
+    };
+    assert_eq!(card(SubagentStatus::Running).fullscreen_entry(), None);
+    assert_eq!(
+        card(SubagentStatus::Waiting).fullscreen_entry(),
+        None,
+        "a waiting subagent is live, so full screen follows it"
+    );
+    assert_eq!(card(SubagentStatus::Completed).fullscreen_entry(), Some(0));
+}
