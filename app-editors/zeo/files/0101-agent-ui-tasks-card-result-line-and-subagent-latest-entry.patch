@@ -0,0 +1,80 @@
+// Zeo next proposal §6.1: a subagent row says what the child is doing -- the last line it said,
+// else the tool it last called. Filter: `subagent_rows::latest_tests`.
+
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::TestAppContext;
+
+use super::one_line;
+use super::test_support::*;
+
+fn say(
+    child: &gpui::Entity<crate::AcpThread>,
+    update: acp_v1::SessionUpdate,
+    cx: &mut TestAppContext,
+) {
+    child.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(update, cx)
+            .expect("update applies")
+    });
+}
+
+#[gpui::test]
+async fn a_child_with_nothing_said_has_no_latest_entry(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    subagent_rows_child(&rig, "child-1", Some("Explore"), cx);
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(subagent_rows_find(&rows, "child-1").latest_entry, None);
+}
+
+#[gpui::test]
+async fn the_latest_entry_is_the_last_line_the_child_said(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let child = subagent_rows_child(&rig, "child-1", Some("Explore"), cx);
+    say(
+        &child,
+        acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(
+            "Looking at the crate.\n\nFound three callers.\n".into(),
+        )),
+        cx,
+    );
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&rows, "child-1").latest_entry.as_deref(),
+        Some("Found three callers.")
+    );
+}
+
+/// Hostile: a thought is not something the child said, and must not stand in for it.
+#[gpui::test]
+async fn a_thought_is_skipped(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let child = subagent_rows_child(&rig, "child-1", Some("Explore"), cx);
+    say(
+        &child,
+        acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new("Said this.".into())),
+        cx,
+    );
+    say(
+        &child,
+        acp_v1::SessionUpdate::AgentThoughtChunk(acp_v1::ContentChunk::new(
+            "secret reasoning".into(),
+        )),
+        cx,
+    );
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&rows, "child-1").latest_entry.as_deref(),
+        Some("Said this.")
+    );
+}
+
+#[test]
+fn one_line_keeps_the_last_non_blank_line_and_cuts_it() {
+    assert_eq!(one_line("a\n\n  b  \n\n").as_deref(), Some("b"));
+    assert_eq!(one_line(" \n\t\n"), None);
+    let long = "x".repeat(300);
+    let cut = one_line(&long).unwrap();
+    assert_eq!(cut.chars().count(), 201, "200 characters and an ellipsis");
+    assert!(cut.ends_with('…'));
+}
