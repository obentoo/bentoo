From 66d1e4fdabb01d79c605af5828efd92cec9345d5 Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Wed, 11 Nov 2026 20:04:53 -0300
Subject: [PATCH] agent_ui, acp_thread: an ended shell keeps its result line; a
 subagent row its latest entry
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo next proposal §6.1, the tasks card's two additions (asks 3, 13).

An expanded shell row lost everything under its details the moment
the task ended: the tail block is for running rows, and the adapter
sends `tail: null` once it stops reading the file. How the build ended
-- "Finished release", "2 tests failed" -- took opening the log. The
thread now keeps the last tail an ended task had when the ending
snapshot carries none (only then: a running task's null is the
adapter's word, and a task that never had a tail gains none), and the
card shows that tail's last non-blank line under the details of an
expanded ended shell, in the tail's monospace style.

A native subagent row (subagents RFD) showed its label and nothing of
what it was doing. SubagentRow gains latest_entry: the child's newest
entry that says something -- the last non-blank line of an assistant
message, else a tool call's label -- cut to 200 characters. Thoughts
are skipped, as are the operator's messages and bookkeeping entries.
The card's native row carries it where a feed task carries its summary,
so the expanded details show it with no new rendering path. A feed
subagent already shows its last tool.

Still open in §6.1: a subagent's transcript served by plus for jailed
and remote sessions.

Tests: acp_thread tests::test_tasks_v2_an_ended_shell_keeps_its_last_tail
and ..._only_an_ended_task_inherits_a_tail (a running null stands; a
task with no tail gains none); subagent_rows::latest_tests (nothing
said, no entry; the last line said; a thought is skipped; one_line
keeps the last non-blank line and cuts at 200 with an ellipsis);
tasks_card::result_line (a running row shows its tail, not a result;
ended, the result line shows; none without a non-blank line). Seen
failing with the tail not carried, the result line never rendered, and
latest_entry always None.
---

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index 8145123..4a1ff2c 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -5810,6 +5810,17 @@ impl AcpThread {
         }
         tasks.sort_by_key(|task| task.started_at);
 
+        // An ended shell arrives without its tail (the adapter stops reading the file). Keep
+        // the last one it had, so the card can still show how the task ended (Zeo next §6.1).
+        for task in &mut tasks {
+            if task.status.is_running() || task.tail.is_some() {
+                continue;
+            }
+            if let Some(previous) = self.tasks.iter().find(|previous| previous.id == task.id) {
+                task.tail = previous.tail.clone();
+            }
+        }
+
         // Forget an ending once its id leaves the list, or comes back running:
         // a resumed subagent restarts under the same id, and its next ending
         // is news again.
diff --git a/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs b/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs
index bc94905..21cb471 100644
--- a/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs
+++ b/crates/acp_thread/src/acp_thread_tasks_v2_tests.rs
@@ -278,3 +278,67 @@ async fn test_tasks_v2_fetch_output_is_unsupported_for_an_agent_without_it(
         "{text}"
     );
 }
+
+// ---- Zeo next §6.1 — an ended shell keeps its last tail -------------------------------------
+
+/// The adapter sends `tail: null` once a shell ends; the thread keeps the last tail it had, so
+/// the card can still show how the task ended.
+#[gpui::test]
+async fn test_tasks_v2_an_ended_shell_keeps_its_last_tail(cx: &mut TestAppContext) {
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!(["Compiling zeo", "Finished release in 3m"]),
+            serde_json::json!(true),
+        )]),
+        cx,
+    );
+    let mut ended = tasks_wire_task("b1", "completed", 1_000);
+    ended["tail"] = serde_json::json!(null);
+    ended["hasOutput"] = serde_json::json!(true);
+    tasks_send(&thread, tasks_snapshot(vec![ended]), cx);
+    assert_eq!(
+        tasks_v2_tail(&thread, "b1", cx),
+        Some(vec![
+            "Compiling zeo".to_string(),
+            "Finished release in 3m".to_string()
+        ])
+    );
+}
+
+/// Hostile: a running task's `null` tail is the adapter's word and is not overridden, and a task
+/// that never had a tail does not gain one.
+#[gpui::test]
+async fn test_tasks_v2_only_an_ended_task_inherits_a_tail(cx: &mut TestAppContext) {
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!(["line"]),
+            serde_json::json!(true),
+        )]),
+        cx,
+    );
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_v2_shell(
+            "b1",
+            serde_json::json!(null),
+            serde_json::json!(false),
+        )]),
+        cx,
+    );
+    assert_eq!(
+        tasks_v2_tail(&thread, "b1", cx),
+        None,
+        "running: the adapter's null stands"
+    );
+
+    let mut ended = tasks_wire_task("b2", "completed", 2_000);
+    ended["tail"] = serde_json::json!(null);
+    tasks_send(&thread, tasks_snapshot(vec![ended]), cx);
+    assert_eq!(tasks_v2_tail(&thread, "b2", cx), None);
+}
diff --git a/crates/acp_thread/src/subagent_rows.rs b/crates/acp_thread/src/subagent_rows.rs
index 75fb83f..b06bd86 100644
--- a/crates/acp_thread/src/subagent_rows.rs
+++ b/crates/acp_thread/src/subagent_rows.rs
@@ -7,7 +7,7 @@ use std::time::{Instant, SystemTime};
 use agent_client_protocol::v2::schema as acp_v2;
 use gpui::{App, SharedString};
 
-use crate::{AcpThread, ForegroundActivity};
+use crate::{AcpThread, AgentThreadEntry, AssistantMessageChunk, ForegroundActivity};
 
 /// Six outcomes, because the card's four (`Running`, `Completed`, `Failed`, `Canceled`) fold
 /// `RequiresAction` into Running and an unconfirmed state into the idle default — and both
@@ -42,6 +42,9 @@ pub struct SubagentRow {
     pub error: Option<SharedString>,
     /// Wall-clock, like `AgentTask::started_at`, so merged rows sort and persist alike.
     pub started_at: Option<SystemTime>,
+    /// The child's latest entry as one line -- the last thing it said, else the tool it last
+    /// called -- for the task surfaces to show what it is doing (Zeo next §6.1).
+    pub latest_entry: Option<SharedString>,
 }
 
 /// What a thread's children add to its own state in the sidebar. Waiting outranks Running:
@@ -58,7 +61,7 @@ pub enum ChildActivity {
 pub fn subagent_rows(parent: &AcpThread, cx: &App) -> Vec<SubagentRow> {
     parent
         .subagents()
-        .map(|child| subagent_row(child.read(cx)))
+        .map(|child| subagent_row(child.read(cx), cx))
         .collect()
 }
 
@@ -74,7 +77,7 @@ pub fn any_child_active(parent: &AcpThread, cx: &App) -> ChildActivity {
     activity
 }
 
-fn subagent_row(child: &AcpThread) -> SubagentRow {
+fn subagent_row(child: &AcpThread, cx: &App) -> SubagentRow {
     let association = child.subagent_association();
     // The parent's label describes the child in the parent's view, so it wins (R1.2).
     let label = association
@@ -89,9 +92,46 @@ fn subagent_row(child: &AcpThread) -> SubagentRow {
         can_cancel: association.is_some_and(|association| association.can_cancel),
         error,
         started_at: child.activity_started_at().map(wall_clock),
+        latest_entry: latest_entry(child, cx),
     }
 }
 
+/// The longest latest entry kept, in characters; the surfaces truncate further to fit.
+const LATEST_ENTRY_MAX_CHARS: usize = 200;
+
+/// The child's newest entry that says something: an assistant message's last line, or a tool
+/// call's label. Thoughts, the operator's messages and bookkeeping entries are skipped.
+fn latest_entry(child: &AcpThread, cx: &App) -> Option<SharedString> {
+    child.entries().iter().rev().find_map(|entry| match entry {
+        AgentThreadEntry::AssistantMessage(message) => {
+            message.chunks.iter().rev().find_map(|chunk| match chunk {
+                AssistantMessageChunk::Message { block, .. } => one_line(&block.to_markdown(cx)),
+                AssistantMessageChunk::Thought { .. } => None,
+            })
+        }
+        AgentThreadEntry::ToolCall(call) => one_line(call.label.read(cx).source()),
+        _ => None,
+    })
+}
+
+/// The last non-blank line of `text`, trimmed and cut to [`LATEST_ENTRY_MAX_CHARS`].
+fn one_line(text: &str) -> Option<SharedString> {
+    let line = text
+        .lines()
+        .rev()
+        .map(str::trim)
+        .find(|line| !line.is_empty())?;
+    let cut: String = line.chars().take(LATEST_ENTRY_MAX_CHARS).collect();
+    Some(
+        if cut.len() < line.len() {
+            format!("{cut}…")
+        } else {
+            cut
+        }
+        .into(),
+    )
+}
+
 fn subagent_row_status(child: &AcpThread) -> (SubagentRowStatus, Option<SharedString>) {
     match child.foreground_activity() {
         ForegroundActivity::Running => (SubagentRowStatus::Running, None),
@@ -148,6 +188,9 @@ pub fn idle_outcome(idle: &acp_v2::IdleStateUpdate) -> (SubagentRowStatus, Optio
