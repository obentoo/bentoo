diff --git a/crates/agent_ui/src/tasks_card/result_line_tests.rs b/crates/agent_ui/src/tasks_card/result_line_tests.rs
new file mode 100644
index 0000000..67105a0
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/result_line_tests.rs
@@ -0,0 +1,91 @@
+// Zeo next proposal §6.1: an expanded shell row that has ended keeps its result line -- the last
+// line of output it had -- instead of losing everything below its details when the tail stops.
+// Filter: `tasks_card::result_line`.
+
+use gpui::{TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn painted(selector: &'static str, cx: &mut VisualTestContext) -> bool {
+    draw(cx);
+    cx.debug_bounds(selector).is_some()
+}
+
+fn shell(id: &str, status: &str, tail: serde_json::Value) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, 1_000);
+    task["tail"] = tail;
+    task["hasOutput"] = json!(true);
+    task
+}
+
+#[gpui::test]
+async fn an_ended_shell_keeps_its_last_line(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![shell(
+            "t1",
+            "running",
+            json!(["Compiling zeo", "Finished release", ""]),
+        )],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.toggle_expanded(sa.clone(), "t1".into(), cx)
+    });
+    assert!(painted("tasks-card-tail-t1", &mut cx));
+    assert!(
+        !painted("tasks-card-result-t1", &mut cx),
+        "a running row shows its tail, not a result"
+    );
+
+    send_tasks(&a, vec![shell("t1", "completed", json!(null))], &mut cx);
+    assert!(
+        !painted("tasks-card-tail-t1", &mut cx),
+        "the tail block is for running rows"
+    );
+    assert!(painted("tasks-card-result-t1", &mut cx));
+}
+
+/// Hostile: a shell that ended with no output at all, or only blank lines, has no result line.
+#[gpui::test]
+async fn no_result_line_without_a_non_blank_line(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            shell("t1", "running", json!(["", "  "])),
+            shell("t2", "running", json!(null)),
+        ],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    send_tasks(
+        &a,
+        vec![
+            shell("t1", "completed", json!(null)),
+            shell("t2", "completed", json!(null)),
+        ],
+        &mut cx,
+    );
+    for id in ["t1", "t2"] {
+        card.update(&mut cx, |card, cx| {
+            card.toggle_expanded(sa.clone(), id.into(), cx)
+        });
+    }
+    assert!(!painted("tasks-card-result-t1", &mut cx));
+    assert!(!painted("tasks-card-result-t2", &mut cx));
+}
