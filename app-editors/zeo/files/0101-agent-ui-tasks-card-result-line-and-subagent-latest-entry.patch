         .when(shows_tail, |this| this.child(render_tail(task, cx)))
+        .children(render_result_line(task, cx))
         .into_any_element()
 }
 
+/// An ended shell's last line of output, kept from its last tail (Zeo next §6.1): how the
+/// task ended -- "Finished release", "2 tests failed" -- without opening its log.
+fn render_result_line(task: &AgentTask, cx: &App) -> Option<AnyElement> {
+    if task.kind != SHELL_KIND || task.status.is_running() {
+        return None;
+    }
+    let line = task
+        .tail
+        .as_deref()?
+        .iter()
+        .rev()
+        .find(|line| !line.trim().is_empty())?;
+    let task_id = task.id.clone();
+    Some(
+        div()
+            .debug_selector(move || format!("tasks-card-result-{task_id}"))
+            .min_w_0()
+            .px_1()
+            .rounded_sm()
+            .bg(cx.theme().colors().editor_background)
+            .child(
+                Label::new(tail_line(line))
+                    .size(LabelSize::XSmall)
+                    .buffer_font(cx)
+                    .single_line()
+                    .truncate(),
+            )
+            .into_any_element(),
+    )
+}
+
 /// A running shell's tail, one entry per line in a monospace block, or "No output yet"
 /// before the agent has sent any (R4.3, R4.4).
 fn render_tail(task: &AgentTask, cx: &App) -> AnyElement {
