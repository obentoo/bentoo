+    /// A repository link under the version rows (Zeo next §6.18).
+    fn about_link(id: &'static str, label: &'static str, url: &'static str) -> Button {
+        Button::new(id, label)
+            .style(ButtonStyle::Subtle)
+            .label_size(LabelSize::Small)
+            .start_icon(Icon::new(IconName::Github).size(IconSize::Small))
+            .tooltip(Tooltip::text(url))
+            .on_click(move |_, _, cx| cx.open_url(url))
+    }
