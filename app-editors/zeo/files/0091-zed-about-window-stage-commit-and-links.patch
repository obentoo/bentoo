+    /// Zeo next §6.18: the title names the stage, and the Zed row the packaged commit.
+    #[test]
+    fn test_about_window_title_and_zed_row() {
+        use super::{about_title, upstream_version_label};
+        assert_eq!(
+            about_title("Zeo", Some("0.9.1_p20261109"), "0.9.1"),
+            "Zeo (\u{3b1}lpha)"
+        );
+        assert_eq!(
+            about_title("Zeo", None, "0.9.1"),
+            "Zeo 0.9.1",
+            "a development build keeps its version in the title"
+        );
+        let version: semver::Version = "1.29.0+zeo".parse().expect("fixture");
+        assert_eq!(
+            upstream_version_label(&version, Some("f0d896f2c18a543335eb155f729d36b624695591")),
+            "1.29.0+f0d896f"
+        );
+        assert_eq!(upstream_version_label(&version, None), "1.29.0+zeo");
+        assert_eq!(
+            upstream_version_label(&version, Some("")),
+            "1.29.0+zeo",
+            "an empty variable is no commit"
+        );
+    }
