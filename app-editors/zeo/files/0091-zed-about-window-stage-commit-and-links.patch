+/// Zeo's release stage, which the About window's title names (Zeo next §6.18).
+const ZEO_STAGE: &str = "\u{3b1}lpha";
+const ZEO_REPOSITORY_URL: &str = "https://github.com/zeo-workspace/zeo";
+const ZED_REPOSITORY_URL: &str = "https://github.com/zed-industries/zed";
+
+/// The About window's title: `Zeo (αlpha)` for a Zeo package, whose version has a row
+/// of its own, else the channel and the version as upstream shows them.
+fn about_title(channel_name: &str, package_version: Option<&str>, version: &str) -> String {
+    match package_version {
+        Some(_) => format!("{channel_name} ({ZEO_STAGE})"),
+        None => format!("{channel_name} {version}"),
+    }
+}
+
+/// The About window's Zed row: Zed's `X.Y.Z` with the packaged upstream commit,
+/// shortened (`1.29.0+f0d896f`), when the package passes ZEO_UPSTREAM_COMMIT; else
+/// AppVersion as it is (`1.29.0+zeo`). AppVersion itself is left alone: extensions
+/// check compatibility against it.
+fn upstream_version_label(app_version: &semver::Version, upstream_commit: Option<&str>) -> String {
+    match upstream_commit
+        .map(str::trim)
+        .filter(|commit| !commit.is_empty())
+    {
+        Some(commit) => format!(
+            "{}.{}.{}+{}",
+            app_version.major,
+            app_version.minor,
+            app_version.patch,
+            commit.chars().take(7).collect::<String>()
+        ),
+        None => app_version.to_string(),
+    }
+}
+
