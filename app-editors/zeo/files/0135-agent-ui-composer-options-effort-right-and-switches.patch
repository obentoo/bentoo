new file mode 100644
index 0000000..05a86a5
--- /dev/null
+++ b/crates/agent_ui/src/config_options/switch_row.rs
@@ -0,0 +1,220 @@
+//! Zeo: the Agent Options menu draws an on/off option as a row with a switch.
+//!
+//! An agent offers an on/off choice in two shapes: a boolean option, or a select
+//! whose only values are `on` and `off`. The second is the ACP boolean-option RFD's
+//! fallback spelling, and it is also how Claude Agent (Plus) models Thinking
+//! (`thinking-option.ts`), which stays a select even for a client that takes
+//! booleans. Upstream drew the first as a check-marked entry with a side panel for
+//! its description, and the second as a submenu opening a picker of its own. Both
+//! are now the same row: the name, whose tooltip is the description, and a switch.
+//! A click anywhere on the row flips it, and the menu stays open on the new state.
+
+use std::rc::Rc;
+
+use acp_thread::AgentSessionConfigOptions;
+use agent_client_protocol::v2::schema as acp;
+use gpui::{App, Window};
+use ui::{ContextMenuItem, Switch, Tooltip, prelude::*};
+
+use super::set_config_option_for_thread;
+
+/// The value ids of the select fallback, as the RFD spells them.
+const SWITCH_ON: &str = "on";
+const SWITCH_OFF: &str = "off";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) struct SwitchState {
+    pub on: bool,
+    /// False for a select that offers only one of the two values -- Thinking on a
+    /// model that always thinks: the switch shows the state and cannot move.
+    pub can_toggle: bool,
+}
+
+/// The switch an option is drawn as, or `None` when it is not an on/off choice.
+pub(super) fn switch_state(option: &acp::SessionConfigOption) -> Option<SwitchState> {
+    match &option.kind {
+        acp::SessionConfigKind::Boolean(boolean) => Some(SwitchState {
+            on: boolean.current_value,
+            can_toggle: true,
+        }),
+        acp::SessionConfigKind::Select(select) => {
+            let acp::SessionConfigSelectOptions::Ungrouped(values) = &select.options else {
+                return None;
+            };
+            let is_switch_value = |id: &str| id == SWITCH_ON || id == SWITCH_OFF;
+            if values.is_empty() || !values.iter().all(|value| is_switch_value(&value.value.0)) {
+                return None;
+            }
+            let current = select.current_value.0.as_ref();
+            if !is_switch_value(current) {
+                return None;
+            }
+            let offers = |id: &str| values.iter().any(|value| value.value.0.as_ref() == id);
+            Some(SwitchState {
+                on: current == SWITCH_ON,
+                can_toggle: offers(SWITCH_ON) && offers(SWITCH_OFF),
+            })
+        }
+        _ => None,
+    }
+}
+
+/// The value that flips a switch, in the option's own shape.
+pub(super) fn flipped_value(
+    option: &acp::SessionConfigOption,
+    state: SwitchState,
+) -> acp::SessionConfigOptionValue {
+    match &option.kind {
+        acp::SessionConfigKind::Boolean(_) => acp::SessionConfigOptionValue::boolean(!state.on),
+        _ => acp::SessionConfigOptionValue::id(if state.on { SWITCH_OFF } else { SWITCH_ON }),
+    }
+}
+
+/// Flips the option for this session only, as every boolean already is (0059):
+/// a switch has no default to set. The state is read again here rather than
+/// captured when the menu was built, so a stale row cannot send the old value.
+fn toggle_switch_option(
+    config_options: Rc<dyn AgentSessionConfigOptions>,
+    config_id: acp::SessionConfigId,
+    window: &Window,
+    cx: &mut App,
+) {
+    if config_options.is_read_only() {
+        return;
+    }
+    let Some(option) = config_options
+        .config_options()
+        .into_iter()
+        .find(|option| option.config_id == config_id)
+    else {
+        return;
+    };
+    let Some(state) = switch_state(&option).filter(|state| state.can_toggle) else {
+        return;
+    };
+    let value = flipped_value(&option, state);
+    set_config_option_for_thread(config_options, config_id, value, window, cx)
+        .detach_and_log_err(cx);
+}
+
+/// The menu row for an on/off option.
+pub(super) fn switch_row(
+    config_options: Rc<dyn AgentSessionConfigOptions>,
+    option: &acp::SessionConfigOption,
+    state: SwitchState,
+) -> ContextMenuItem {
+    let name = SharedString::from(option.name.clone());
+    let description = option.description.clone().map(SharedString::from);
+    let config_id = option.config_id.clone();
+    let element_id = SharedString::from(format!("config-switch-{}", option.config_id));
+    ContextMenuItem::CustomEntry {
+        entry_render: Box::new(move |_, _| {
+            let selector_name = name.clone();
+            h_flex()
+                .w_full()
+                .gap_4()
+                .justify_between()
+                .debug_selector(move || format!("CONFIG_SWITCH-{selector_name}"))
+                .child(
+                    div()
+                        .id(element_id.clone())
+                        .min_w_0()
+                        .child(
+                            Label::new(name.clone())
+                                .when(!state.can_toggle, |label| label.color(Color::Muted)),
+                        )
+                        .when_some(description.clone(), |this, description| {
+                            this.tooltip(Tooltip::text(description))
+                        }),
+                )
+                // No click handler of its own: a click on the switch reaches the row,
+                // which flips it once. A handler here would flip it twice.
+                .child(
+                    Switch::new(
+                        SharedString::from(format!("{element_id}-switch")),
+                        state.on.into(),
+                    )
+                    .disabled(!state.can_toggle),
+                )
+                .into_any_element()
+        }),
+        handler: Rc::new(move |_, window, cx| {
+            toggle_switch_option(config_options.clone(), config_id.clone(), window, cx);
+        }),
+        selectable: state.can_toggle,
+        documentation_aside: None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn select(current: &str, values: &[&str]) -> acp::SessionConfigOption {
+        acp::SessionConfigOption::select(
+            "thinking",
+            "Thinking",
+            current.to_string(),
+            values
+                .iter()
+                .map(|value| acp::SessionConfigSelectOption::new(value.to_string(), *value))
+                .collect::<Vec<_>>(),
+        )
+    }
+
+    #[test]
+    fn a_boolean_is_a_switch() {
+        let option = acp::SessionConfigOption::boolean("fast", "Fast mode", true);
+        let on = SwitchState {
+            on: true,
+            can_toggle: true,
+        };
+        assert_eq!(switch_state(&option), Some(on));
+        assert_eq!(
+            flipped_value(&option, on),
+            acp::SessionConfigOptionValue::boolean(false)
+        );
+    }
+
+    #[test]
+    fn an_on_off_select_is_a_switch_and_flips_by_value_id() {
+        let option = select("off", &["on", "off"]);
+        let state = switch_state(&option);
+        assert_eq!(
+            state,
+            Some(SwitchState {
+                on: false,
+                can_toggle: true
+            })
+        );
+        assert_eq!(
+            flipped_value(
+                &option,
+                SwitchState {
+                    on: false,
+                    can_toggle: true
+                }
+            ),
+            acp::SessionConfigOptionValue::id("on")
+        );
+    }
+
+    #[test]
+    fn an_on_only_select_is_a_switch_that_cannot_move() {
+        assert_eq!(
+            switch_state(&select("on", &["on"])),
+            Some(SwitchState {
+                on: true,
+                can_toggle: false
+            })
+        );
+    }
+
+    #[test]
+    fn other_selects_stay_submenus() {
+        assert_eq!(switch_state(&select("high", &["low", "high"])), None);
+        assert_eq!(switch_state(&select("on", &["on", "off", "auto"])), None);
+        assert_eq!(switch_state(&select("auto", &["on", "off"])), None);
+        assert_eq!(switch_state(&select("on", &[])), None);
+    }
+}
