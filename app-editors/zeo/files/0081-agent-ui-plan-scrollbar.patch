+    /// The expanded item plan with its scrollbar always drawn (§5.1). `None` when the plan
+    /// is collapsed, empty or not an item list; the activity bar then renders as before.
+    fn render_scrollable_plan_items(
+        &self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        if !self.plan_expanded {
+            return None;
+        }
+        let list = {
+            let thread = self.thread.read(cx);
+            let plan = thread.plan().filter(|plan| !plan.is_empty(cx))?;
+            let PlanContent::Items(entries) = &plan.content else {
+                return None;
+            };
+            self.render_plan_entries(entries, window, cx)
+                .track_scroll(&self.plan_items_scroll)
+        };
+        Some(
+            div()
+                .child(list)
+                .custom_scrollbars(
+                    Scrollbars::always_visible(ScrollAxes::Vertical)
+                        .tracked_scroll_handle(&self.plan_items_scroll),
+                    window,
+                    cx,
+                )
+                .into_any_element(),
+        )
+    }
+
     fn render_plan_entries(
         &self,
         entries: &[acp_thread::PlanEntry],
         window: &mut Window,
