@@ -40,6 +40,8 @@ pub(super) fn first_line(text: &str) -> &str {
 
 impl ThreadView {
     pub(super) fn render_pinned_user_message(&self, cx: &mut Context<Self>) -> Option<AnyElement> {
+        // Nothing floats over the top until the header below is prepainted again.
+        self.top_overlay_bottom.set(None);
         let thread = self.thread.read(cx);
         let entries = thread.entries();
         let ix = pinned_user_message_ix(
@@ -127,6 +129,20 @@ impl ThreadView {
                                 })),
                         ),
                 )
+                // The header reports where it ends, so what shares the top of the conversation
+                // with it -- the tasks card -- sits below instead of over it. Its height is
+                // only known here: minimized, expanded, or wrapped at the panel's width.
+                .child({
+                    let top_overlay_bottom = self.top_overlay_bottom.clone();
+                    canvas(
