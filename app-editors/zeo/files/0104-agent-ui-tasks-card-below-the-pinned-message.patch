diff --git a/crates/agent_ui/src/tasks_card.rs b/crates/agent_ui/src/tasks_card.rs
index 8276b67..9399eef 100644
--- a/crates/agent_ui/src/tasks_card.rs
+++ b/crates/agent_ui/src/tasks_card.rs
@@ -3035,6 +3035,20 @@ fn card_tooltip(
     }
 }
 
+/// `area` without the strip an overlay takes at its top: the thread's pinned user message
+/// floats over the first lines of the conversation, and the card shares that corner. An
+/// overlay that ends above the area, or past its bottom, never moves the area outside itself.
+pub(crate) fn below_top_overlay(
+    area: Bounds<Pixels>,
+    overlay_bottom: Option<Pixels>,
+) -> Bounds<Pixels> {
+    let Some(overlay_bottom) = overlay_bottom else {
+        return area;
+    };
+    let top = overlay_bottom.clamp(area.top(), area.bottom());
+    Bounds::from_corners(point(area.left(), top), area.bottom_right())
+}
+
 /// Places the tasks card in its corner of the free area of the agent panel.
 ///
 /// The free area is only known once the panel's content has been laid out — the
diff --git a/crates/agent_ui/src/tasks_card/placement_tests.rs b/crates/agent_ui/src/tasks_card/placement_tests.rs
index f8b3ea1..40f86bb 100644
--- a/crates/agent_ui/src/tasks_card/placement_tests.rs
+++ b/crates/agent_ui/src/tasks_card/placement_tests.rs
@@ -239,3 +239,30 @@ async fn test_the_card_keeps_clear_of_a_child_threads_titlebar(cx: &mut TestAppC
         );
     }
 }
+
+// ── The pinned user message (Zeo 0.10.2) ───────────────────────────────────
+
+fn area() -> Bounds<Pixels> {
+    Bounds::new(gpui::point(px(10.), px(100.)), size(px(300.), px(400.)))
+}
+
+#[test]
+fn the_free_area_starts_below_an_overlay_at_its_top() {
+    let below = crate::tasks_card::below_top_overlay(area(), Some(px(130.)));
+    assert_eq!(below.top(), px(130.));
+    assert_eq!(below.bottom(), area().bottom());
+    assert_eq!(below.left(), area().left());
+    assert_eq!(below.size.width, area().size.width);
+    assert_eq!(crate::tasks_card::below_top_overlay(area(), None), area());
+}
+
+/// Hostile: an overlay reported above the area or past its end never moves the area outside
+/// itself, so the card cannot be laid out over the toolbar or the editor.
+#[test]
+fn an_overlay_outside_the_area_never_moves_it_out() {
+    let above = crate::tasks_card::below_top_overlay(area(), Some(px(40.)));
+    assert_eq!(above, area());
+    let past = crate::tasks_card::below_top_overlay(area(), Some(px(900.)));
+    assert_eq!(past.top(), area().bottom());
+    assert_eq!(past.size.height, px(0.));
+}
