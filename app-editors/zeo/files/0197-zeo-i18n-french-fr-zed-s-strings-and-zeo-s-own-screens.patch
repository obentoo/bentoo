+agent-memory-no-pages = Aucune page pour l'instant.
+agent-memory-forget = Oublier { $path }
+agent-memory-forget-failed = Impossible d'oublier { $path } : { $error }
+agent-memory-save-failed = Impossible d'enregistrer le réglage de mémoire de l'agent : { $error }
