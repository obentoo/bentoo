+agent-memory-scope = { $source ->
+    [marker] Portée : { $scope } (d'après .ai-memory.toml)
+    [upstream] Portée : { $scope } (d'après le dépôt distant upstream)
+    [origin] Portée : { $scope } (d'après le dépôt distant origin)
+   *[folder] Portée : { $scope } (d'après le nom du dossier ; ajoutez .ai-memory.toml pour en choisir une autre)
+}
+agent-memory-asking = Interrogation d'ai-memory…
+agent-memory-refresh = Actualiser
+    .tooltip = Interroger à nouveau ai-memory
