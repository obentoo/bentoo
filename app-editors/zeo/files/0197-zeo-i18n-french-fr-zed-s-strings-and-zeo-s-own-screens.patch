+### Zeo UI strings (voice.ftl) in French (fr).
+### Drafted with Lara Translate and revised; not reviewed by a native speaker.
+### Glossary: "jail", "sandbox" and "thread" stay in English.
+
+voice-label = Saisie vocale
+voice-read-only = Le compositeur est en lecture seule
+voice-busy = La saisie vocale est occupée dans un autre thread
+voice-awaiting-consent = La saisie vocale attend la confirmation du téléchargement du modèle
+voice-downloading = La saisie vocale télécharge le modèle vocal
+voice-stop-recording = Arrêter l'enregistrement
+voice-stop-recording-elapsed = Arrêter l'enregistrement ({ $elapsed })
+voice-transcribing = Transcription…
+voice-transcribing-aria = Transcription de la saisie vocale
+voice-with-remote = { $text } — distant : { $host }
+voice-consent = La saisie vocale a besoin du modèle vocal { $model } ({ $size }), depuis { $host }. Le télécharger ?
+voice-consent-decline = Pas maintenant
+voice-consent-download = Télécharger
+voice-download-title = Téléchargement du modèle vocal
+voice-download-cancel = Annuler
+voice-discarded = Transcription abandonnée : le thread a été fermé
+voice-no-microphone = Aucun microphone disponible : { $reason }
+voice-microphone-stopped = Le microphone s'est arrêté : { $reason }
+voice-limit-reached = Enregistrement arrêté à la limite de 2 minutes
+voice-no-speech = Aucune parole n'a été reconnue
+voice-cpu-unsupported = La saisie vocale nécessite un CPU avec { $level }
+voice-model-missing = Le modèle vocal { $model } est absent ; cliquez sur le microphone pour le télécharger à nouveau
+voice-model-unreadable = Le modèle vocal était illisible : { $source }
+voice-model-unreadable-redownload = Le modèle vocal était illisible ; il sera de nouveau téléchargé à la prochaine utilisation
+voice-model-undeletable = Le modèle vocal était illisible et n'a pas pu être supprimé ({ $path }) : { $error }
+voice-local-failed = Échec de la transcription locale
+voice-download-mismatch = Le modèle vocal { $model } ne correspondait pas à sa somme de contrôle et a été supprimé
+voice-download-failed = Impossible de télécharger le modèle vocal { $model } : { $source }
+voice-download-cancelled = Le téléchargement du modèle vocal { $model } a été annulé
+voice-remote-url-unset = L'URL vocale distante n'est pas définie (voice_input.remote.url)
+voice-remote-url-invalid = L'URL vocale distante n'est pas une URL valide
+voice-remote-url-not-loopback = L'URL vocale distante doit utiliser https : { $scheme }://{ $host } n'est pas une adresse de boucle locale
+voice-remote-url-scheme = L'URL vocale distante doit utiliser https, et non { $scheme } ({ $host })
+voice-remote-url-proxy = L'URL vocale distante utilise http en clair alors qu'un proxy est configuré ; utilisez https
+voice-remote-key-invalid = La clé d'API vocale distante n'est pas une valeur d'en-tête HTTP valide
+voice-remote-timeout = La transcription distante a expiré après { $seconds } s ({ $host })
+voice-remote-unreachable = Échec de la transcription distante : impossible de joindre { $host } : { $error }
+voice-remote-http = Échec de la transcription distante : HTTP { $status } de { $host }
+voice-remote-http-excerpt = Échec de la transcription distante : HTTP { $status } de { $host } : { $excerpt }
+voice-remote-read = Échec de la transcription distante : lecture de la réponse de { $host } : { $error }
+voice-remote-too-large = Échec de la transcription distante : la réponse de transcription de { $host } dépasse 1 Mio
+voice-remote-no-text = Échec de la transcription distante : { $host } n'a pas répondu avec un champ JSON `text`
