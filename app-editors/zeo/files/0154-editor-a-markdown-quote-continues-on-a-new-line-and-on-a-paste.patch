@@ -717,6 +717,18 @@ fn edit_for_markdown_paste<'a>(
     to_insert_is_url: bool,
 ) -> (Range<MultiBufferOffset>, Cow<'a, str>) {
     if !to_insert_is_url {
+        // Zeo (operator, 2026-11-22): a multi-line paste into a `>` quote stays in the quote.
+        let start = range.start.to_point(buffer);
+        if let Some((line_snapshot, line_range)) =
+            buffer.buffer_line_for_row(MultiBufferRow(start.row))
+        {
+            let line = line_snapshot.text_for_range(line_range).collect::<String>();
+            if let Some(quoted) =
+                crate::markdown_quote::quoted_paste(&line, start.column as usize, to_insert)
+            {
+                return (range, Cow::Owned(quoted));
+            }
+        }
         return (range, Cow::Borrowed(to_insert));
     };
 
