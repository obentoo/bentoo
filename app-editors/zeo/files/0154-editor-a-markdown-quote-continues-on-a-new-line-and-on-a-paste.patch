--- /dev/null
+++ b/crates/editor/src/markdown_quote.rs
@@ -0,0 +1,111 @@
+//! Markdown quotes continue (Zeo, operator 2026-11-22): a new line in a `>` quote starts with the
+//! quote's markers, and so does every line of a multi-line paste into one, the way upstream
+//! already continues `- ` and `1. ` lists. An empty quote line ends one level of the quote, as an
+//! empty list item ends the list.
+//!
+//! Before this, a quote held one line: the next line began bare, and a pasted paragraph left the
+//! quote after its first line. Markdown's lazy continuation would read that bare line as part of
+//! the quote, but the agent composer's block look (and most readers' eyes) follows the markers.
+
+use std::sync::Arc;
+
+use language::Point;
+use multi_buffer::{MultiBufferRow, MultiBufferSnapshot};
+
+use crate::input::NewlineConfig;
+
+/// A line's quote markers: one `>` per level, each with at most one space after it, behind up to
+/// three spaces of indent (CommonMark §5.1).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct QuoteMarkers {
+    /// The byte column where the markers end and the quoted text begins.
+    pub end: usize,
+    /// How deep the quote is: `> >` is two.
+    pub depth: usize,
+}
+
+impl QuoteMarkers {
+    /// The markers a continued line starts with, normalised to `> ` per level.
+    pub fn continuation(depth: usize) -> String {
+        "> ".repeat(depth)
+    }
+}
+
+/// `line`'s quote markers, if it is a quote line.
+pub(crate) fn quote_markers(line: &str) -> Option<QuoteMarkers> {
+    let indent = line.len() - line.trim_start_matches(' ').len();
+    if indent > 3 {
+        return None;
+    }
+    let mut rest = &line[indent..];
+    let mut end = indent;
+    let mut depth = 0;
+    while let Some(after) = rest.strip_prefix('>') {
+        depth += 1;
+        end += 1;
+        rest = after;
+        if let Some(after) = rest.strip_prefix(' ') {
+            end += 1;
+            rest = after;
+        }
+    }
+    (depth > 0).then_some(QuoteMarkers { end, depth })
+}
+
+/// What a newline at `column` of `line` does to its quote: `Ok(Some(markers))` continues it with
+/// them, `Ok(None)` inserts a plain newline, and `Err(outer)` ends one level of an empty quote
+/// line, leaving `outer` (empty for the last level) on that line instead of a newline.
+pub(crate) fn quote_newline(line: &str, column: usize) -> Result<Option<String>, String> {
+    let Some(markers) = quote_markers(line) else {
+        return Ok(None);
+    };
+    if column < markers.end {
+        return Ok(None);
+    }
+    if line[markers.end..].trim().is_empty() {
+        return Err(QuoteMarkers::continuation(markers.depth - 1));
+    }
+    Ok(Some(QuoteMarkers::continuation(markers.depth)))
+}
+
+/// `text` pasted at `column` of `line`, with the line's quote markers after each of its newlines,
+/// when the paste lands in the quoted text of a quote line. `None` leaves the paste unchanged.
+pub(crate) fn quoted_paste(line: &str, column: usize, text: &str) -> Option<String> {
+    if !text.contains('\n') {
+        return None;
+    }
+    let markers = quote_markers(line)?;
+    if column < markers.end {
+        return None;
+    }
+    let continuation = QuoteMarkers::continuation(markers.depth);
+    Some(text.replace('\n', &format!("\n{continuation}")))
+}
+
+/// `Editor::newline`'s quote step, for a Markdown buffer: the delimiter to continue the quote
+/// with, or `None` after setting `newline_config` to end an empty quote line's last level.
+pub(crate) fn quote_delimiter_for_newline(
+    start_point: &Point,
+    buffer: &MultiBufferSnapshot,
+    newline_config: &mut NewlineConfig,
+) -> Option<Arc<str>> {
+    let (snapshot, range) = buffer.buffer_line_for_row(MultiBufferRow(start_point.row))?;
+    let line = snapshot.text_for_range(range).collect::<String>();
+    match quote_newline(&line, start_point.column as usize) {
+        Ok(continuation) => continuation.map(Into::into),
+        Err(outer) if outer.is_empty() => {
+            *newline_config = NewlineConfig::ClearCurrentLine;
+            None
+        }
+        Err(outer) => {
+            *newline_config = NewlineConfig::UnindentCurrentLine {
+                continuation: outer.into(),
+            };
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "markdown_quote_tests.rs"]
+mod tests;
diff --git a/crates/editor/src/markdown_quote_tests.rs b/crates/editor/src/markdown_quote_tests.rs
new file mode 100644
index 0000000..bf7e6ad
--- /dev/null
+++ b/crates/editor/src/markdown_quote_tests.rs
@@ -0,0 +1,129 @@
+// Zeo (operator, 2026-11-22): Markdown quotes continue on a newline and on a multi-line paste.
+// Filter: `markdown_quote`.
+
+use gpui::{ClipboardItem, TestAppContext};
+use indoc::indoc;
+use pretty_assertions::assert_eq;
+
+use super::*;
+use crate::editor_tests::init_test;
+use crate::test::editor_test_context::EditorTestContext;
+use crate::{Newline, Paste};
+
+#[test]
+fn quote_markers_count_levels_behind_up_to_three_spaces() {
+    assert_eq!(
+        quote_markers("> text"),
+        Some(QuoteMarkers { end: 2, depth: 1 })
+    );
+    assert_eq!(
+        quote_markers(">text"),
+        Some(QuoteMarkers { end: 1, depth: 1 })
+    );
+    assert_eq!(
+        quote_markers("   > > text"),
+        Some(QuoteMarkers { end: 7, depth: 2 })
+    );
+    assert_eq!(quote_markers(">>"), Some(QuoteMarkers { end: 2, depth: 2 }));
+    assert_eq!(quote_markers("    > code"), None, "four spaces is code");
+    assert_eq!(quote_markers("text > not"), None);
+}
+
+#[test]
+fn a_newline_continues_a_quote_and_ends_an_empty_level() {
+    assert_eq!(quote_newline("> text", 6), Ok(Some("> ".into())));
+    assert_eq!(quote_newline(">> text", 7), Ok(Some("> > ".into())));
+    // Inside the markers: a plain newline.
+    assert_eq!(quote_newline("> text", 1), Ok(None));
+    assert_eq!(quote_newline("text", 4), Ok(None));
+    // An empty quote line ends one level.
+    assert_eq!(quote_newline("> ", 2), Err(String::new()));
+    assert_eq!(quote_newline("> > ", 4), Err("> ".into()));
+}
+
+#[test]
+fn a_paste_into_quoted_text_quotes_every_line() {
+    assert_eq!(
+        quoted_paste("> ", 2, "one\ntwo\nthree").as_deref(),
+        Some("one\n> two\n> three")
+    );
+    assert_eq!(
+        quoted_paste("> > a", 5, "b\nc").as_deref(),
+        Some("b\n> > c")
+    );
+    assert_eq!(quoted_paste("> a", 3, "one line"), None);
+    assert_eq!(quoted_paste("plain", 5, "one\ntwo"), None);
+    assert_eq!(
+        quoted_paste("> a", 0, "one\ntwo"),
+        None,
+        "before the markers"
+    );
+}
+
+async fn markdown(cx: &mut TestAppContext) -> EditorTestContext {
+    init_test(cx, |_| {});
+    let markdown_language = languages::language("markdown", tree_sitter_md::LANGUAGE.into());
+    let mut cx = EditorTestContext::new(cx).await;
+    cx.update_buffer(|buffer, cx| buffer.set_language(Some(markdown_language), cx));
+    cx
+}
+
+#[gpui::test]
+async fn newline_in_a_markdown_quote_continues_it(cx: &mut TestAppContext) {
+    let mut cx = markdown(cx).await;
+
+    cx.set_state("> quotedˇ");
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("> quoted\n> ˇ");
+
+    // A second newline on the empty quote line ends the quote.
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("> quoted\nˇ");
+
+    cx.set_state("> > nestedˇ");
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("> > nested\n> > ˇ");
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("> > nested\n> ˇ");
+}
+
+#[gpui::test]
+async fn newline_outside_a_markdown_quote_is_unchanged(cx: &mut TestAppContext) {
+    let mut cx = markdown(cx).await;
+    cx.set_state("plain textˇ");
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("plain text\nˇ");
+
+    // Lists keep upstream's continuation.
+    cx.set_state("- itemˇ");
+    cx.update_editor(|e, window, cx| e.newline(&Newline, window, cx));
+    cx.wait_for_autoindent_applied().await;
+    cx.assert_editor_state("- item\n- ˇ");
+}
+
+#[gpui::test]
+async fn a_multi_line_paste_into_a_markdown_quote_stays_in_it(cx: &mut TestAppContext) {
+    let mut cx = markdown(cx).await;
+    cx.set_state("> ˇ");
+    cx.update_editor(|editor, window, cx| {
+        cx.write_to_clipboard(ClipboardItem::new_string("one\ntwo\nthree".to_string()));
+        editor.paste(&Paste, window, cx);
+    });
+    cx.assert_editor_state(indoc! {"
+        > one
+        > two
+        > threeˇ"});
+
+    // Outside a quote, the paste is unchanged.
+    cx.set_state("ˇ");
+    cx.update_editor(|editor, window, cx| {
+        cx.write_to_clipboard(ClipboardItem::new_string("one\ntwo".to_string()));
+        editor.paste(&Paste, window, cx);
+    });
+    cx.assert_editor_state("one\ntwoˇ");
+}
