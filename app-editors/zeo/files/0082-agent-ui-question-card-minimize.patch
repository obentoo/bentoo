+    /// The minimized question card: one line above the composer (§5.5). The questions stay
+    /// pending and 0043's Enter rule is unchanged; this only frees the space they took.
+    fn render_question_card_bar(pending_count: usize, cx: &Context<Self>) -> AnyElement {
+        let label = if pending_count == 1 {
+            "Question pending".to_string()
+        } else {
+            format!("Question pending · {pending_count} questions")
+        };
+        h_flex()
+            .id("question-card-bar")
+            .debug_selector(|| "question-card-bar".into())
+            .w_full()
+            .px_2()
+            .py_1()
+            .gap_2()
+            .justify_between()
+            .border_t_1()
+            .border_color(cx.theme().colors().border)
+            .bg(cx.theme().colors().editor_background)
+            .child(
+                h_flex()
+                    .gap_1p5()
+                    .child(
+                        Icon::new(IconName::Info)
+                            .size(IconSize::Small)
+                            .color(Color::Accent),
+                    )
+                    .child(Label::new(label).size(LabelSize::Small)),
+            )
+            .child(
+                IconButton::new("expand-question-card", IconName::ChevronUp)
+                    .icon_size(IconSize::Small)
+                    .icon_color(Color::Muted)
+                    .aria_label("Show the pending question")
+                    .tooltip(Tooltip::for_action_title(
+                        "Show Question",
+                        &crate::ToggleQuestionCard,
+                    ))
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.toggle_question_card(&crate::ToggleQuestionCard, cx)
+                    })),
+            )
+            .into_any_element()
+    }
+
+    pub(crate) fn toggle_question_card(
+        &mut self,
+        _: &crate::ToggleQuestionCard,
+        cx: &mut Context<Self>,
+    ) {
+        self.question_card_minimized = !self.question_card_minimized;
+        cx.notify();
+    }
