+// Zeo next proposal §5.5 (ask 9): the pending question card minimizes to a one-line bar and
+// comes back; the state is per thread and returns to open once no question is pending.
+
+use gpui::TestAppContext;
+
+use super::elicitation_decline_harness::*;
+
+const BAR: &str = "question-card-bar";
+
+#[gpui::test]
+async fn the_question_card_minimizes_to_a_bar_and_comes_back(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    ask(&thread, one_question(), "First?", &mut cx);
+    ask(&thread, one_question(), "Second?", &mut cx);
+    draw(&mut cx);
+    assert!(cx.debug_bounds(BAR).is_none(), "the card starts open");
+
+    view.update(&mut cx, |view, cx| {
+        view.toggle_question_card(&crate::ToggleQuestionCard, cx)
+    });
+    draw(&mut cx);
+    assert!(cx.debug_bounds(BAR).is_some(), "minimized: the bar shows");
+
+    view.update(&mut cx, |view, cx| {
+        view.toggle_question_card(&crate::ToggleQuestionCard, cx)
+    });
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds(BAR).is_none(),
+        "restored: the card shows again"
+    );
+}
+
+#[gpui::test]
+async fn a_minimized_card_opens_again_once_nothing_is_pending(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    let question = ask(&thread, one_question(), "Only?", &mut cx);
+    draw(&mut cx);
+    view.update(&mut cx, |view, cx| {
+        view.toggle_question_card(&crate::ToggleQuestionCard, cx)
+    });
+    draw(&mut cx);
+
+    let id = question.id;
+    view.update_in(&mut cx, |view, window, cx| {
+        view.cancel_elicitation(id, window, cx)
+    });
+    settle(&mut cx);
+    draw(&mut cx);
+
+    assert!(
+        !view.read_with(&cx, |view, _| view.question_card_minimized),
+        "the next question must not arrive hidden"
+    );
+}
