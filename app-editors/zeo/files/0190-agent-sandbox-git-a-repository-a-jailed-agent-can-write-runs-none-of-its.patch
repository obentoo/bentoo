@@ -0,0 +1,210 @@
+//! Patch 0190 against real git: a repository a jailed agent configured runs none of its drivers.
+//!
+//! Each fixture repository routes every file through a clean filter and a textconv that touch a
+//! marker, then changes a tracked file without changing its size, more than a second later, so
+//! `git status` has to read the content again: that is when git runs the clean filter.
+
+use crate::agent_reach::{AgentReach, AgentReachCheck};
+use crate::repository::{GitRepository as _, RealGitRepository};
+use gpui::TestAppContext;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::Arc;
+
+#[allow(clippy::disallowed_methods)]
+fn git(dir: &Path, args: &[&str]) {
+    let output = Command::new("git")
+        .current_dir(dir)
+        .env("GIT_CONFIG_GLOBAL", "")
+        .env("GIT_CONFIG_SYSTEM", "")
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(
+        output.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+fn disable_git_global_config() {
+    // SAFETY: the same calls `repository::tests` makes; every test here sets the same values.
+    unsafe {
+        std::env::set_var("GIT_CONFIG_GLOBAL", "");
+        std::env::set_var("GIT_CONFIG_SYSTEM", "");
+    }
+}
+
+struct Fixture {
+    _dir: tempfile::TempDir,
+    repo_dir: PathBuf,
+    filter_marker: PathBuf,
+    textconv_marker: PathBuf,
+}
+
+/// A repository whose own config names `driver` as a filter and a diff driver, both touching a
+/// marker, with `f.txt` staged and then changed. `include` puts the drivers in a file of the
+/// working tree that `.git/config` includes, which a jailed agent can write even when `.git` is
+/// read-only.
+fn repository_with_drivers(driver: &str, include: bool) -> Fixture {
+    let dir = tempfile::tempdir().unwrap();
+    let repo_dir = dir.path().join("repo");
+    std::fs::create_dir(&repo_dir).unwrap();
+    git(&repo_dir, &["init", "-q", "-b", "main"]);
+    std::fs::write(repo_dir.join("f.txt"), "one").unwrap();
+    std::fs::write(
+        repo_dir.join(".gitattributes"),
+        format!("* filter={driver} diff={driver}\n"),
+    )
+    .unwrap();
+    let off_clean = format!("filter.{driver}.clean=");
+    git(
+        &repo_dir,
+        &["-c", &off_clean, "add", "f.txt", ".gitattributes"],
+    );
+    let identity = ["-c", "user.name=test", "-c", "user.email=test@zed.dev"];
+    git(
+        &repo_dir,
+        &[
+            &identity[..],
+            &["-c", &off_clean, "commit", "-q", "-m", "initial"],
+        ]
+        .concat(),
+    );
+
+    let filter_marker = dir.path().join("filter-ran");
+    let textconv_marker = dir.path().join("textconv-ran");
+    let clean = format!("touch '{}'; cat", filter_marker.display());
+    let textconv = format!(
+        "sh -c 'touch \"{}\"; cat \"$0\"'",
+        textconv_marker.display()
+    );
+    if include {
+        let body = format!(
+            "[filter \"{driver}\"]\n\tclean = {clean}\n[diff \"{driver}\"]\n\ttextconv = {textconv}\n"
+        );
+        std::fs::write(repo_dir.join("shared.gitconfig"), body).unwrap();
+        git(
+            &repo_dir,
+            &["config", "include.path", "../shared.gitconfig"],
+        );
+    } else {
+        git(
+            &repo_dir,
+            &["config", &format!("filter.{driver}.clean"), &clean],
+        );
+        git(
+            &repo_dir,
+            &["config", &format!("diff.{driver}.textconv"), &textconv],
+        );
+    }
+
+    std::thread::sleep(std::time::Duration::from_millis(1100));
+    std::fs::write(repo_dir.join("f.txt"), "two").unwrap();
+    Fixture {
+        _dir: dir,
+        repo_dir,
+        filter_marker,
+        textconv_marker,
+    }
+}
+
+fn open(
+    fixture: &Fixture,
+    reach: Option<AgentReach>,
+    cx: &mut TestAppContext,
+) -> RealGitRepository {
+    let repo = RealGitRepository::new(
+        &fixture.repo_dir.join(".git"),
+        None,
+        Some("git".into()),
+        cx.executor(),
+    )
+    .unwrap();
+    repo.set_trusted(true);
+    if let Some(reach) = reach {
+        let check: AgentReachCheck = Arc::new(move |_, _| reach);
+        repo.set_agent_reach_check(check);
+    }
+    repo
+}
+
+async fn status_and_diff(repo: &RealGitRepository) -> anyhow::Result<usize> {
+    let status = repo.status(&[]).await?;
+    repo.diff(crate::repository::DiffType::HeadToWorktree)
+        .await
+        .ok();
+    Ok(status.entries.len())
+}
+
+/// Hostile baseline: with no reach the drivers run, so the fixture really reproduces the attack.
+#[gpui::test]
+async fn test_without_a_reach_check_the_drivers_run(cx: &mut TestAppContext) {
+    disable_git_global_config();
+    cx.executor().allow_parking();
+    let fixture = repository_with_drivers("x", false);
+    let repo = open(&fixture, None, cx);
+    status_and_diff(&repo).await.unwrap();
+    assert!(
+        fixture.filter_marker.exists(),
+        "the fixture must trigger the filter"
+    );
+    assert!(
+        fixture.textconv_marker.exists(),
+        "the fixture must trigger the textconv"
+    );
+}
+
+#[gpui::test]
+async fn test_a_writable_repository_runs_none_of_its_drivers(cx: &mut TestAppContext) {
+    disable_git_global_config();
+    cx.executor().allow_parking();
+    for include in [false, true] {
+        let fixture = repository_with_drivers("x", include);
+        let repo = open(&fixture, Some(AgentReach::Writable), cx);
+        let entries = status_and_diff(&repo).await.unwrap();
+        assert!(entries > 0, "include={include}: status still answers");
+        assert!(
+            !fixture.filter_marker.exists(),
+            "include={include}: filter ran"
+        );
+        assert!(
+            !fixture.textconv_marker.exists(),
+            "include={include}: textconv ran"
+        );
+    }
+}
+
+#[gpui::test]
+async fn test_the_root_git_dir_runs_none_of_its_drivers(cx: &mut TestAppContext) {
+    disable_git_global_config();
+    cx.executor().allow_parking();
+    for include in [false, true] {
+        let fixture = repository_with_drivers("x", include);
+        let repo = open(&fixture, Some(AgentReach::RootGitDir), cx);
+        status_and_diff(&repo).await.unwrap();
+        assert!(
+            !fixture.filter_marker.exists(),
+            "include={include}: filter ran"
+        );
+        assert!(
+            !fixture.textconv_marker.exists(),
+            "include={include}: textconv ran"
+        );
+    }
+}
+
+/// Hostile: a driver name `-c` cannot address refuses the command instead of running it.
+#[gpui::test]
+async fn test_an_unaddressable_driver_name_refuses_the_command(cx: &mut TestAppContext) {
+    disable_git_global_config();
+    cx.executor().allow_parking();
+    let fixture = repository_with_drivers("a=b", false);
+    let repo = open(&fixture, Some(AgentReach::Writable), cx);
+    let refused = repo.status(&[]).await;
+    assert!(refused.is_err(), "{refused:?}");
+    assert!(
+        !fixture.filter_marker.exists(),
+        "the filter must not have run"
+    );
+}
