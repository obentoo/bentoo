diff --git a/crates/agent_sandbox/src/git_reach.rs b/crates/agent_sandbox/src/git_reach.rs
new file mode 100644
index 0000000..1599831
--- /dev/null
+++ b/crates/agent_sandbox/src/git_reach.rs
@@ -0,0 +1,161 @@
+//! Which repositories a jailed agent can write, for the git screen of patch 0190.
+//!
+//! The jail maps the project root writable but for `<root>/.git` and `<root>/.zed`, plus the
+//! project's writable folders. A repository under either is one the agent may have configured,
+//! and git run on it by the unjailed editor runs whatever drivers that config names, on the host
+//! (security audit 2026-11-21, confirmed 2026-11-26). `git::agent_reach` switches those drivers
+//! off; this module tells it which repositories need that, from the settings and the open
+//! projects, so it applies before the agent's first launch too — a repository planted in an
+//! earlier session is screened from the first `git status`.
+
+use git::agent_reach::{AgentReach, AgentReachCheck};
+use gpui::{App, Global, WeakEntity};
+use project::Project;
+use project::git_store::GitAgentReach;
+use settings::{Settings as _, SettingsStore};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, RwLock};
+
+use crate::AgentSandboxSettings;
+use crate::validate::expand_tilde;
+
+/// The jailed project roots and writable folders, each as written and, when it resolves, as its
+/// canonical path: repositories reach the screen spelled either way.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct JailReach {
+    pub roots: Vec<PathBuf>,
+    pub writable_folders: Vec<PathBuf>,
+}
+
+impl JailReach {
+    /// How far a jailed agent reaches the repository working in `work_dir` with the common git
+    /// directory `common_dir`. A repository under several entries gets the widest reach.
+    pub fn classify(&self, work_dir: &Path, common_dir: &Path) -> AgentReach {
+        let under = |base: &Path| work_dir.starts_with(base) || common_dir.starts_with(base);
+        if self.writable_folders.iter().any(|folder| under(folder)) {
+            return AgentReach::Writable;
+        }
+        let mut reach = AgentReach::None;
+        for root in &self.roots {
+            let own_git_dir = common_dir == root.join(".git");
+            if own_git_dir {
+                reach = reach.max(AgentReach::RootGitDir);
+            } else if under(root) {
+                return AgentReach::Writable;
+            }
+        }
+        reach
+    }
+
+    fn push(list: &mut Vec<PathBuf>, path: PathBuf) {
+        if let Ok(canonical) = std::fs::canonicalize(&path)
+            && !list.contains(&canonical)
+        {
+            list.push(canonical);
+        }
+        if !list.contains(&path) {
+            list.push(path);
+        }
+    }
+}
+
+struct GitReachState {
+    reach: Arc<RwLock<JailReach>>,
+    projects: Vec<WeakEntity<Project>>,
+}
+
+impl Global for GitReachState {}
+
+/// Registers the screen with the git store and keeps it current. Call once, before a project
+/// opens.
+pub fn init(cx: &mut App) {
+    let reach = Arc::new(RwLock::new(JailReach::default()));
+    let check: AgentReachCheck = Arc::new({
+        let reach = reach.clone();
+        move |work_dir, common_dir| {
+            let reach = reach
+                .read()
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+            reach.classify(work_dir, common_dir)
+        }
+    });
+    cx.set_global(GitAgentReach(check));
+    cx.set_global(GitReachState {
+        reach,
+        projects: Vec::new(),
+    });
+
+    cx.observe_global::<SettingsStore>(refresh).detach();
+    cx.observe_new(|_: &mut Project, _, cx| {
+        let project = cx.entity();
+        cx.defer(move |cx| {
+            cx.global_mut::<GitReachState>()
+                .projects
+                .push(project.downgrade());
+            cx.subscribe(&project, |_, event: &project::Event, cx| {
+                if matches!(
+                    event,
+                    project::Event::WorktreeAdded(_)
+                        | project::Event::WorktreeRemoved(_)
+                        | project::Event::WorktreeOrderChanged
+                ) {
+                    refresh(cx);
+                }
+            })
+            .detach();
+            refresh(cx);
+        });
+    })
+    .detach();
+}
+
+/// Recomputes [`JailReach`] from the settings and every open local project.
+fn refresh(cx: &mut App) {
+    let Some(state) = cx.try_global::<GitReachState>() else {
+        return;
+    };
+    let projects: Vec<_> = state
+        .projects
+        .iter()
+        .filter_map(WeakEntity::upgrade)
+        .collect();
+    let reach = state.reach.clone();
+    let settings = AgentSandboxSettings::get_global(cx);
+    let home = paths::home_dir();
+
+    let mut next = JailReach::default();
+    for project in &projects {
+        if !project.read(cx).is_local() {
+            continue;
+        }
+        let Some(root) = crate::launch::project_root(project, cx) else {
+            continue;
+        };
+        if !settings.effective_enabled(&root) {
+            continue;
+        }
+        for folder in settings.project_policy(&root).rw_maps {
+            JailReach::push(&mut next.writable_folders, expand_tilde(&folder, home));
+        }
+        JailReach::push(&mut next.roots, root);
+    }
+
+    let counts = (next.roots.len(), next.writable_folders.len());
+    let changed = {
+        let mut current = reach
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let changed = *current != next;
+        *current = next;
+        changed
+    };
+    if changed {
+        log::debug!(
+            "agent sandbox git reach: updated roots={} writable_folders={}",
+            counts.0,
+            counts.1
+        );
+    }
+    let live = projects.iter().map(|project| project.downgrade()).collect();
+    cx.global_mut::<GitReachState>().projects = live;
+}
diff --git a/crates/agent_sandbox/src/git_reach_tests.rs b/crates/agent_sandbox/src/git_reach_tests.rs
new file mode 100644
index 0000000..ecfba94
--- /dev/null
+++ b/crates/agent_sandbox/src/git_reach_tests.rs
@@ -0,0 +1,192 @@
+// Patch 0190 — which repositories a jailed agent can write, and the git screen end to end.
+// Wired in the crate root `src/agent_sandbox.rs`. Validation filter: `git_reach`.
+//
+// Hostile halves:
+//   - classify, wrongly COLLAPSE: a repository beside the root (`/w/app2`) is not under `/w/app`;
+//     the root's own `.git` is not `Writable`, but a nested one is.
+//   - end to end: the fixture of the 2026-11-26 probe — a nested repository planted while the
+//     project is open, its clean filter touching a marker — runs the filter with the jail off
+//     (the control) and does not with the jail on.
+
+use git::agent_reach::AgentReach;
+use gpui::{TestAppContext, UpdateGlobal as _};
+use project::Project;
+use serde_json::json;
+use settings::SettingsStore;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use worktree::WorktreeModelHandle as _;
+
+use crate::git_reach::JailReach;
+
+fn reach(roots: &[&str], folders: &[&str]) -> JailReach {
+    JailReach {
+        roots: roots.iter().map(PathBuf::from).collect(),
+        writable_folders: folders.iter().map(PathBuf::from).collect(),
+    }
+}
+
+#[test]
+fn git_reach_classify_tells_the_root_git_dir_from_a_writable_repository() {
+    let jail = reach(&["/w/app"], &["/data/shared"]);
+    let classify = |work: &str, common: &str| jail.classify(Path::new(work), Path::new(common));
+    assert_eq!(classify("/w/app", "/w/app/.git"), AgentReach::RootGitDir);
+    assert_eq!(
+        classify("/w/app/sub", "/w/app/sub/.git"),
+        AgentReach::Writable
+    );
+    // A linked worktree of the root shares its read-only common directory.
+    assert_eq!(classify("/w/app/wt", "/w/app/.git"), AgentReach::RootGitDir);
+    // A `.git` file pointing a repository inside the project at a git dir outside it.
+    assert_eq!(
+        classify("/w/app/sub", "/elsewhere/.git"),
+        AgentReach::Writable
+    );
+    // A repository outside every jail, one whose name only starts like the root's, one whose
+    // git dir merely lives in the project.
+    assert_eq!(classify("/w/other", "/w/other/.git"), AgentReach::None);
+    assert_eq!(classify("/w/app2", "/w/app2/.git"), AgentReach::None);
+    assert_eq!(
+        classify("/w/other", "/w/app/hidden.git"),
+        AgentReach::Writable
+    );
+    assert_eq!(
+        classify("/data/shared/repo", "/data/shared/repo/.git"),
+        AgentReach::Writable
+    );
+}
+
+#[test]
+fn git_reach_classify_takes_the_widest_reach() {
+    // `/w/app/inner` is a jailed root of its own, inside the jailed `/w/app`.
+    let jail = reach(&["/w/app/inner", "/w/app"], &[]);
+    assert_eq!(
+        jail.classify(Path::new("/w/app/inner"), Path::new("/w/app/inner/.git")),
+        AgentReach::Writable
+    );
+    assert_eq!(
+        JailReach::default().classify(Path::new("/w/app"), Path::new("/w/app/.git")),
+        AgentReach::None
+    );
+}
+
+#[allow(clippy::disallowed_methods)]
+fn git(dir: &Path, args: &[&str]) {
+    let output = Command::new("git")
+        .current_dir(dir)
+        .env("GIT_CONFIG_GLOBAL", "")
+        .env("GIT_CONFIG_SYSTEM", "")
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(
+        output.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+fn init(cx: &mut TestAppContext) {
+    // SAFETY: every git test of the workspace sets the same two values.
+    unsafe {
+        std::env::set_var("GIT_CONFIG_GLOBAL", "");
+        std::env::set_var("GIT_CONFIG_SYSTEM", "");
+    }
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        crate::init(cx);
+    });
+}
+
+fn set_jail(root: &Path, enabled: bool, cx: &mut TestAppContext) {
+    let settings = json!({
+        "agent_sandbox": { "projects": { root.to_string_lossy(): { "enabled": enabled } } }
+    });
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&settings.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// Opens a project on a committed repository, lets the jailed "agent" (plain processes here)
+/// plant `sub/.git` with a clean filter while it is open, and answers whether the editor's scan
+/// ran that filter on the host.
+async fn planted_filter_runs(jailed: bool, cx: &mut TestAppContext) -> bool {
+    init(cx);
+    cx.executor().allow_parking();
+    let dir = tempfile::tempdir().unwrap();
+    let root = std::fs::canonicalize(dir.path()).unwrap().join("project");
+    std::fs::create_dir(&root).unwrap();
+    git(&root, &["init", "-q", "-b", "main"]);
+    std::fs::write(root.join("a.txt"), "a").unwrap();
+    let identity = ["-c", "user.name=test", "-c", "user.email=test@zed.dev"];
+    git(&root, &["add", "a.txt"]);
+    git(
+        &root,
+        &[&identity[..], &["commit", "-q", "-m", "initial"]].concat(),
+    );
+    set_jail(&root, jailed, cx);
+
+    let project = Project::test(fs::RealFs::new(None, cx.executor()), [root.as_path()], cx).await;
+    let tree = project.read_with(cx, |project, cx| project.worktrees(cx).next().unwrap());
+    tree.flush_fs_events(cx).await;
+    project
+        .update(cx, |project, cx| project.git_scans_complete(cx))
+        .await;
+    cx.run_until_parked();
+
+    let marker = dir.path().join("FILTER-RAN");
+    let sub = root.join("sub");
+    std::fs::create_dir(&sub).unwrap();
+    git(&sub, &["init", "-q", "-b", "main"]);
+    std::fs::write(sub.join("f.txt"), "one").unwrap();
+    git(&sub, &["add", "f.txt"]);
+    git(
+        &sub,
+        &[&identity[..], &["commit", "-q", "-m", "sub"]].concat(),
+    );
+    let clean = format!("touch '{}'; cat", marker.display());
+    git(&sub, &["config", "filter.x.clean", &clean]);
+    std::fs::write(sub.join(".gitattributes"), "* filter=x\n").unwrap();
+    std::thread::sleep(std::time::Duration::from_millis(1100));
+    std::fs::write(sub.join("f.txt"), "two").unwrap();
+
+    let mut sub_seen = false;
+    for _ in 0..20 {
+        tree.flush_fs_events(cx).await;
+        project
+            .update(cx, |project, cx| project.git_scans_complete(cx))
+            .await;
+        cx.run_until_parked();
+        sub_seen = project.read_with(cx, |project, cx| {
+            project
+                .repositories(cx)
+                .values()
+                .any(|repo| repo.read(cx).work_directory_abs_path.ends_with("sub"))
+        });
+        if marker.exists() || (sub_seen && jailed) {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(250));
+    }
+    assert!(sub_seen, "the scan must find the planted repository");
+    marker.exists()
+}
+
+/// The control: with the jail off the fixture does run the filter on the host.
+#[gpui::test]
+async fn git_reach_a_planted_filter_runs_when_the_jail_is_off(cx: &mut TestAppContext) {
+    assert!(planted_filter_runs(false, cx).await);
+}
+
+#[gpui::test]
+async fn git_reach_a_planted_filter_does_not_run_in_a_jailed_project(cx: &mut TestAppContext) {
+    assert!(!planted_filter_runs(true, cx).await);
+}
diff --git a/crates/git/src/agent_reach.rs b/crates/git/src/agent_reach.rs
new file mode 100644
index 0000000..be0b254
--- /dev/null
+++ b/crates/git/src/agent_reach.rs
@@ -0,0 +1,216 @@
+//! Git run on a repository a jailed agent can write.
+//!
+//! A jail (ai-jail, `agent_sandbox`) keeps the agent away from the host, but the project it
+//! works in stays writable, all but `<root>/.git` and `<root>/.zed`. A repository there is
+//! therefore one the agent may have configured: it can `git init sub`, name a program in
+//! `filter.<name>.clean` and select it from `.gitattributes`, and the unjailed editor runs that
+//! program on the host the next time it asks for `git status` — no click needed (security audit
+//! 2026-11-21, confirmed 2026-11-26; PROPOSAL §6.61 in the hub).
+//!
+//! What is done about it, decided by the operator on 2026-11-26 (options 1 and 3):
+//!
+//! - every repository the agent can write runs as an untrusted one (Zed's own overrides of
+//!   hooks, ssh, credential helpers and external diff), and with every filter and diff driver
+//!   its own config defines switched off, and with commit signing pinned to git's defaults;
+//! - the project root's own `.git`, read-only inside the jail, keeps its trust, but still has its
+//!   own drivers switched off: the jail cannot stop the agent from creating `<root>/.git` when the
+//!   project had none, nor from writing a file that config includes.
+//!
+//! A driver is switched off with an empty command, which is how git spells "no driver" (the
+//! Claude Code VS Code extension does the same before `git worktree add`). Measured on git
+//! 2.56.1: `-c filter.<n>.clean=` and `-c diff.<n>.textconv=` stop both programs from running in
+//! `status` and `diff`. What it costs: a file such a driver converts (an LFS pointer, a
+//! git-crypt blob) reads as modified in a jailed project. Global and system config are the
+//! user's own and are left alone.
+
+use std::path::Path;
+use std::sync::Arc;
+
+/// How far a jailed agent reaches a repository.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+pub enum AgentReach {
+    /// No jailed project contains it.
+    #[default]
+    None,
+    /// The jailed project root's own `.git`: read-only in the jail, but possibly created, or
+    /// configured through an included file, by the agent.
+    RootGitDir,
+    /// Anything else under a jailed project or one of its writable folders.
+    Writable,
+}
+
+/// Answers [`AgentReach`] for a repository, from its working directory (its git directory for a
+/// bare one) and its common git directory. Asked on every command, so it always reflects the
+/// current settings; it must be cheap and must not block.
+pub type AgentReachCheck = Arc<dyn Fn(&Path, &Path) -> AgentReach + Send + Sync>;
+
+/// The pattern for the config keys that name a program git runs on its own while reading the
+/// working tree: filter drivers (`status`, `add`, `checkout`) and diff drivers (`diff`).
+pub(crate) const DRIVER_KEYS_PATTERN: &str =
+    r"^(filter|diff)\..+\.(clean|smudge|process|textconv|command)$";
+
+/// Commit signing, pinned for a writable repository: each of these names a program git runs.
+pub(crate) const WRITABLE_SIGNING_OVERRIDES: &[&str] = &[
+    "gpg.program=gpg",
+    "gpg.ssh.program=ssh-keygen",
+    "gpg.x509.program=gpgsm",
+    "gpg.ssh.defaultKeyCommand=",
+];
+
+/// Why the drivers could not be listed. The command is then refused rather than run unscreened.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UnscreenableDrivers {
+    /// A driver name git's `-c` could not address (it holds `=` or a newline).
+    UnaddressableName(String),
+    /// The listing itself failed.
+    Listing(String),
+}
+
+impl std::fmt::Display for UnscreenableDrivers {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::UnaddressableName(name) => write!(
+                f,
+                "a driver name `{}` cannot be switched off with -c",
+                name.escape_debug()
+            ),
+            Self::Listing(detail) => write!(f, "the driver listing failed: {detail}"),
+        }
+    }
+}
+
+/// The `-c` arguments switching off every driver in `listing`, the output of
+/// `git config --includes --show-scope --name-only --get-regexp DRIVER_KEYS_PATTERN`. Only the
+/// repository's own scopes count (`local`, `worktree`; an included file reports the scope of the
+/// file that includes it).
+pub(crate) fn driver_overrides(listing: &str) -> Result<Vec<String>, UnscreenableDrivers> {
+    let mut drivers: Vec<(String, String)> = Vec::new();
+    for line in listing.lines() {
+        let Some((scope, name)) = line.split_once('\t') else {
+            continue;
+        };
+        if !matches!(scope, "local" | "worktree") {
+            continue;
+        }
+        let (Some(first_dot), Some(last_dot)) = (name.find('.'), name.rfind('.')) else {
+            continue;
+        };
+        if last_dot <= first_dot + 1 {
+            continue;
+        }
+        let section = name[..first_dot].to_ascii_lowercase();
+        let driver = &name[first_dot + 1..last_dot];
+        if driver.contains('=') || driver.contains('\n') {
+            return Err(UnscreenableDrivers::UnaddressableName(driver.to_string()));
+        }
+        let entry = (section, driver.to_string());
+        if !drivers.contains(&entry) {
+            drivers.push(entry);
+        }
+    }
+
+    let mut args = Vec::new();
+    for (section, driver) in drivers {
+        let keys: &[&str] = match section.as_str() {
+            "filter" => &["clean=", "smudge=", "process=", "required=false"],
+            "diff" => &["textconv=", "command="],
+            _ => continue,
+        };
+        for key in keys {
+            args.push("-c".to_string());
+            args.push(format!("{section}.{driver}.{key}"));
+        }
+    }
+    Ok(args)
+}
+
+/// Lists the drivers the repository at `working_directory` defines and returns the `-c`
+/// arguments that switch them off. Runs `git config` synchronously: it reads files and starts no
+/// program the repository names.
+#[allow(clippy::disallowed_methods)]
+pub(crate) fn list_driver_overrides(
+    git_binary_path: &Path,
+    working_directory: &Path,
+    envs: &collections::HashMap<String, String>,
+) -> Result<Vec<String>, UnscreenableDrivers> {
+    let output = std::process::Command::new(git_binary_path)
+        .current_dir(working_directory)
+        .envs(envs)
+        .env("LC_ALL", "C")
+        .args([
+            "config",
+            "--includes",
+            "--show-scope",
+            "--name-only",
+            "--get-regexp",
+            DRIVER_KEYS_PATTERN,
+        ])
+        .output()
+        .map_err(|error| UnscreenableDrivers::Listing(error.to_string()))?;
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    match output.status.code() {
+        Some(0) => driver_overrides(&String::from_utf8_lossy(&output.stdout)),
+        // `--get-regexp` exits 1 when nothing matches.
+        Some(1) if stderr.trim().is_empty() => Ok(Vec::new()),
+        _ => Err(UnscreenableDrivers::Listing(format!(
+            "git config exited with {:?}: {}",
+            output.status.code(),
+            stderr.trim()
+        ))),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_driver_overrides_switches_off_local_and_worktree_drivers_only() {
+        let listing = "local\tfilter.x.clean\n\
+                       local\tfilter.x.smudge\n\
+                       worktree\tdiff.t.textconv\n\
+                       global\tfilter.lfs.clean\n\
+                       system\tdiff.sys.textconv\n";
+        assert_eq!(
+            driver_overrides(listing).unwrap(),
+            [
+                "-c",
+                "filter.x.clean=",
+                "-c",
+                "filter.x.smudge=",
+                "-c",
+                "filter.x.process=",
+                "-c",
+                "filter.x.required=false",
+                "-c",
+                "diff.t.textconv=",
+                "-c",
+                "diff.t.command=",
+            ]
+        );
+    }
+
+    #[test]
+    fn test_driver_overrides_keeps_a_dotted_driver_name_whole() {
+        assert_eq!(
+            driver_overrides("local\tfilter.My.Driver.process\n").unwrap()[1],
+            "filter.My.Driver.clean="
+        );
+    }
+
+    #[test]
+    fn test_driver_overrides_refuses_a_name_dash_c_cannot_address() {
+        assert_eq!(
+            driver_overrides("local\tfilter.a=b.clean\n"),
+            Err(UnscreenableDrivers::UnaddressableName("a=b".to_string()))
+        );
+    }
+
+    #[test]
+    fn test_driver_overrides_ignores_what_is_not_a_driver() {
+        assert_eq!(
+            driver_overrides("local\tfilter.clean\nlocal\tnot-a-line\n\n").unwrap(),
+            Vec::<String>::new()
+        );
+    }
+}
