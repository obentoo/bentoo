+#[gpui::test]
+async fn test_is_open_as_project_looks_at_every_window(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    for folder in ["/open-here", "/open-elsewhere", "/listed-only", "/not-open"] {
+        fs.insert_tree(folder, serde_json::json!({ "src": {} }))
+            .await;
+    }
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+
+    let here = project::Project::test(fs.clone(), [Path::new("/open-here")], cx).await;
+    let elsewhere = project::Project::test(fs.clone(), [Path::new("/open-elsewhere")], cx).await;
+    cx.add_window(|window, cx| MultiWorkspace::test_new(here, window, cx));
+    let other_window = cx.add_window(|window, cx| MultiWorkspace::test_new(elsewhere, window, cx));
+    // A group the sidebar lists without any workspace open for it.
+    other_window
+        .update(cx, |mw, _window, _cx| {
+            mw.test_add_project_group(workspace::ProjectGroup {
+                key: ProjectGroupKey::new(None, PathList::new(&[Path::new("/listed-only")])),
+                workspaces: Vec::new(),
+                expanded: true,
+            });
+        })
+        .unwrap();
+    cx.run_until_parked();
+
+    cx.update(|cx| {
+        assert!(is_open_as_project(Path::new("/open-here"), cx));
+        assert!(is_open_as_project(Path::new("/open-elsewhere"), cx));
+        assert!(is_open_as_project(Path::new("/listed-only"), cx));
+        assert!(!is_open_as_project(Path::new("/not-open"), cx));
+        // A folder nested in an open project is a project of its own.
+        assert!(!is_open_as_project(Path::new("/open-here/src"), cx));
+    });
+}
+
+#[gpui::test]
+async fn test_dropped_folders_open_as_projects(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/current", serde_json::json!({ "src": {} }))
+        .await;
+    fs.insert_tree("/new-one", serde_json::json!({ "src": {} }))
+        .await;
+    fs.insert_tree("/new-two", serde_json::json!({ "notes.md": "" }))
+        .await;
+    fs.insert_tree("/other-window", serde_json::json!({ "src": {} }))
+        .await;
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+
+    let other = project::Project::test(fs.clone(), [Path::new("/other-window")], cx).await;
+    cx.add_window(|window, cx| MultiWorkspace::test_new(other, window, cx));
+    let project = project::Project::test(fs.clone(), [Path::new("/current")], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+
+    let dropped = ExternalPaths(
+        vec![
+            PathBuf::from("/current"),
+            PathBuf::from("/other-window"),
+            PathBuf::from("/new-one"),
+            PathBuf::from("/new-two/notes.md"),
+            PathBuf::from("/new-two"),
+            PathBuf::from("/new-one"),
+        ]
+        .into(),
+    );
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.handle_external_paths_drop(&dropped, window, cx);
+    });
+    cx.run_until_parked();
+
+    let mut groups = multi_workspace.read_with(cx, |mw, _cx| {
+        mw.project_group_keys()
+            .into_iter()
+            .map(|key| key.path_list().paths().to_vec())
+            .collect::<Vec<_>>()
+    });
+    groups.sort();
+    assert_eq!(
+        groups,
+        vec![
+            vec![PathBuf::from("/current")],
+            vec![PathBuf::from("/new-one")],
+            vec![PathBuf::from("/new-two")],
+        ]
+    );
+}
