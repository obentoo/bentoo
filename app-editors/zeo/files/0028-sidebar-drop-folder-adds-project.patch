 }
 
+/// Whether `folder` is already a local project in any window — a group listed
+/// in a sidebar, or an open workspace rooted at exactly that folder.
+fn is_open_as_project(folder: &Path, cx: &App) -> bool {
+    let path_list = PathList::new(&[folder]);
+    cx.windows()
+        .into_iter()
+        .filter_map(|window| window.downcast::<MultiWorkspace>())
+        .any(|window| {
+            window.read(cx).is_ok_and(|multi_workspace| {
+                multi_workspace
+                    .project_group_keys()
+                    .iter()
+                    .any(|key| key.host().is_none() && *key.path_list() == path_list)
+                    || multi_workspace
+                        .workspace_for_paths(&path_list, None, cx)
+                        .is_some()
+            })
+        })
+}
+
 fn linked_worktree_path_lists_for_workspaces(
     workspaces: &[Entity<Workspace>],
     cx: &App,
@@ -1303,6 +1323,44 @@ impl Sidebar {
         }
     }
 
+    /// Opens every folder dropped on the sidebar as a project of its own.
+    ///
+    /// Files are skipped, and so is a folder that is already a project here or
+    /// in another window. The check runs right before each open rather than
+    /// once up front, so the same folder dropped twice is opened once.
+    fn handle_external_paths_drop(
+        &mut self,
+        paths: &ExternalPaths,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(window_handle) = window.window_handle().downcast::<MultiWorkspace>() else {
+            return;
+        };
+        let dropped = paths.paths().to_vec();
+        let fs = <dyn fs::Fs>::global(cx);
+
+        cx.spawn(async move |_this, cx| {
+            for path in dropped {
+                if !fs.is_dir(&path).await {
+                    continue;
+                }
+                if cx.update(|cx| is_open_as_project(&path, cx)) {
+                    log::info!("sidebar drop skipped: already open as a project path={path:?}");
+                    continue;
+                }
+                let open = window_handle.update(cx, |multi_workspace, window, cx| {
+                    multi_workspace.open_project(vec![path.clone()], OpenMode::Activate, window, cx)
+                })?;
+                if let Err(error) = open.await {
+                    log::error!("sidebar drop failed to open project path={path:?}: {error:#}");
+                }
+            }
+            anyhow::Ok(())
+        })
+        .detach_and_log_err(cx);
+    }
+
     /// Opens a new workspace for a group that has no open workspaces.
     fn open_workspace_for_group(
         &mut self,
@@ -7953,6 +8011,9 @@ impl Render for Sidebar {
 
         let color = cx.theme().colors();
         let bg = color.background.blend(color.panel_background);
+        // drop_target_background is translucent: blended over the sidebar's
+        // own background, not in place of it, or the window shows through.
+        let drop_bg = bg.blend(color.drop_target_background);
 
         let no_open_projects = !self.contents.has_open_projects;
         let no_search_results = self.contents.entries.is_empty();
@@ -7989,6 +8050,8 @@ impl Render for Sidebar {
                 this.recent_projects_popover_handle.toggle(window, cx);
             }))
             .font(ui_font)
+            .drag_over::<ExternalPaths>(move |style, _, _, _| style.bg(drop_bg))
+            .on_drop(cx.listener(Self::handle_external_paths_drop))
             .map(|el| {
                 let on_left = self.side(cx) == SidebarSide::Left;
                 match window.window_decorations() {
