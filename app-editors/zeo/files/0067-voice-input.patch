@@ -0,0 +1,150 @@
+// Story 044, task 2.1 — the pinned model table and the on-disk check (R6.1, R6.8). Wired in the
+// crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod models_tests;
+//
+// Validation filter: `models` (every test path is `models_tests::…`).
+//
+// Contract (design.md C1.2, Data Models). Assumed: `ModelPresence::{Present(PathBuf), Missing}`
+// with `PartialEq + Debug`; `spec`, `url`, `models_dir`, `model_on_disk`, `human_size` public in
+// `crate::models`.
+//
+// Hostile halves: a file of exactly the pinned size is Present AND one byte short or one byte long
+// is Missing (R6.8); a directory with the model's name is Missing, not Present; the URL carries the
+// pinned commit AND never a moving ref (`main`).
+
+use std::fs;
+
+use crate::models::{ModelPresence, VoiceModel, human_size, model_on_disk, models_dir, spec, url};
+
+const PREFIX: &str = "https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/";
+
+#[test]
+fn models_table_is_pinned_byte_for_byte() {
+    let rows = [
+        (
+            VoiceModel::Tiny,
+            "ggml-tiny.bin",
+            77_691_713u64,
+            "be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21",
+        ),
+        (
+            VoiceModel::Base,
+            "ggml-base.bin",
+            147_951_465,
+            "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe",
+        ),
+        (
+            VoiceModel::Small,
+            "ggml-small.bin",
+            487_601_967,
+            "1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b",
+        ),
+    ];
+    for (model, file, size, sha) in rows {
+        let s = spec(model);
+        assert_eq!(s.model, model);
+        assert_eq!(s.file, file);
+        assert_eq!(s.size, size, "{file}");
+        assert_eq!(s.sha256, sha, "{file}");
+        assert_eq!(s.sha256.len(), 64);
+        assert!(
+            s.sha256
+                .chars()
+                .all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase())
+        );
+    }
+}
+
+#[test]
+fn models_url_pins_the_commit() {
+    for model in [VoiceModel::Tiny, VoiceModel::Base, VoiceModel::Small] {
+        let s = spec(model);
+        let u = url(s);
+        assert_eq!(u, format!("{PREFIX}{}", s.file));
+        assert!(
+            !u.contains("/main/") && !u.contains("/resolve/main"),
+            "never a moving ref: {u}"
+        );
+        assert!(
+            u.starts_with("https://huggingface.co/"),
+            "R6.1 the named host"
+        );
+    }
+}
+
+#[test]
+fn models_dir_is_voice_models_under_the_data_dir() {
+    let dir = models_dir();
+    assert!(dir.ends_with("voice/models"), "{}", dir.display());
+    assert!(dir.starts_with(paths::data_dir()), "{}", dir.display());
+}
+
+#[test]
+fn models_exact_size_is_present() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let s = spec(VoiceModel::Tiny);
+    let path = tmp.path().join(s.file);
+    // A sparse file: the size is what is checked, not the bytes (the hash is checked at download).
+    fs::File::create(&path)
+        .and_then(|f| f.set_len(s.size))
+        .expect("sparse file");
+    assert_eq!(model_on_disk(tmp.path(), s), ModelPresence::Present(path));
+}
+
+#[test]
+fn models_one_byte_short_or_long_is_missing() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let s = spec(VoiceModel::Tiny);
+    let path = tmp.path().join(s.file);
+    for len in [s.size - 1, s.size + 1, 0] {
+        fs::File::create(&path)
+            .and_then(|f| f.set_len(len))
+            .expect("sparse file");
+        assert_eq!(
+            model_on_disk(tmp.path(), s),
+            ModelPresence::Missing,
+            "R6.8 {len} bytes"
+        );
+    }
+}
+
+#[test]
+fn models_absent_file_or_a_directory_is_missing() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let s = spec(VoiceModel::Base);
+    assert_eq!(model_on_disk(tmp.path(), s), ModelPresence::Missing);
+    fs::create_dir(tmp.path().join(s.file)).expect("dir");
+    assert_eq!(
+        model_on_disk(tmp.path(), s),
+        ModelPresence::Missing,
+        "a directory is not a model"
+    );
+    assert_eq!(
+        model_on_disk(&tmp.path().join("nope"), s),
+        ModelPresence::Missing
+    );
+}
+
+#[test]
+fn models_another_models_file_does_not_count() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let tiny = spec(VoiceModel::Tiny);
+    fs::File::create(tmp.path().join(tiny.file))
+        .and_then(|f| f.set_len(tiny.size))
+        .expect("file");
+    assert_eq!(
+        model_on_disk(tmp.path(), spec(VoiceModel::Base)),
+        ModelPresence::Missing
+    );
+}
+
+#[test]
+fn models_human_size_rounds_decimal_megabytes() {
+    assert_eq!(human_size(77_691_713), "78 MB");
+    assert_eq!(human_size(147_951_465), "148 MB");
+    assert_eq!(human_size(487_601_967), "488 MB");
+    assert_eq!(human_size(1_499_999), "1 MB");
+    assert_eq!(human_size(1_500_000), "2 MB");
+}
