--- /dev/null
+++ b/crates/agent_ui/src/voice_events_more_tests.rs
@@ -0,0 +1,59 @@
+// Story 044, task 5.4 fix round 1 (tech review L3) — `VoiceEvent::Changed` re-renders the thread
+// view, and an event meant for another owner does not. Wired in the crate root `src/agent_ui.rs`.
+// Validation filter: `voice_events` (every test path is `voice_events_more_tests::…`).
+//
+// A view re-renders when it is notified, so the test counts the thread view's notifications.
+
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+use gpui::{AppContext as _, TestAppContext};
+use voice_input::{VoiceEvent, VoiceInput};
+
+use crate::voice_keys_tests::{REMOTE_SETTINGS, answering, init_voice, open_thread};
+
+fn emit(event: VoiceEvent, cx: &mut TestAppContext) {
+    let voice = cx.update(|cx| VoiceInput::global(cx));
+    voice.update(cx, |_, cx| cx.emit(event));
+    cx.run_until_parked();
+}
+
+#[gpui::test]
+async fn voice_events_changed_rerenders_the_thread_view(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering("{}"), cx);
+    let thread = open_thread(cx).await;
+    let view = thread.view(cx);
+    let notified = Arc::new(AtomicUsize::new(0));
+    let _observation = cx.update({
+        let notified = notified.clone();
+        |cx| {
+            cx.observe(&view, move |_, _| {
+                notified.fetch_add(1, Ordering::SeqCst);
+            })
+        }
+    });
+    cx.run_until_parked();
+
+    let stranger = cx.update(|cx| cx.new(|_| ()));
+    let before = notified.load(Ordering::SeqCst);
+    emit(
+        VoiceEvent::Notify {
+            owner: stranger.entity_id(),
+            message: "nobody's".into(),
+        },
+        cx,
+    );
+    assert_eq!(
+        notified.load(Ordering::SeqCst),
+        before,
+        "another owner's event does not re-render this view"
+    );
+
+    emit(VoiceEvent::Changed, cx);
+    assert!(
+        notified.load(Ordering::SeqCst) > before,
+        "Changed re-renders the thread view"
+    );
+}
diff --git a/crates/agent_ui/src/voice_events_tests.rs b/crates/agent_ui/src/voice_events_tests.rs
new file mode 100644
index 0000000..5b158c1
--- /dev/null
+++ b/crates/agent_ui/src/voice_events_tests.rs
@@ -0,0 +1,223 @@
+// Story 044, task 5.4 — the thread view acts only on `VoiceInput` events for its own owner (R4.1,
+// R4.7, R5.1; design.md C1.10 `VoiceEvent`, C2). Wired in the crate root `src/agent_ui.rs` as
+//
+//     #[cfg(test)]
+//     mod voice_events_tests;
+//
+// Validation filter: `voice_events` (every test path is `voice_events_tests::…`).
+//
+// Harness: `crate::voice_keys_tests::{init_voice, open_thread, …}` (same assumed seams). The owner of
+// a thread view is its `ThreadView` entity id (design C2: `owner == cx.entity_id()`), carried as
+// `voice_input::state::Owner(id.as_u64())` in inputs and as the `EntityId` in `VoiceEvent`.
+// Events are injected with `cx.emit` on the global entity for the routing tests; the closed-composer
+// test (R4.7) runs a real recording whose remote answer is held until the composer is gone.
+//
+// Hostile halves: an Insert for A lands in A AND not in B, and the converse; a Notify for A shows in
+// A's workspace AND an event for an owner nobody holds changes no composer; a transcript arriving
+// after its composer closed is discarded with a notification AND does not land in the other one.
+
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use futures::channel::oneshot;
+use gpui::{AppContext as _, EntityId, TestAppContext};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use voice_input::state::{Input, Owner};
+use voice_input::{VoiceEvent, VoiceInput};
+
+use crate::voice_keys_tests::{REMOTE_SETTINGS, Thread, answering, init_voice, open_thread};
+
+fn owner_of(thread: &Thread, cx: &TestAppContext) -> EntityId {
+    thread.view(cx).entity_id()
+}
+
+fn text_of(thread: &Thread, cx: &mut TestAppContext) -> String {
+    let editor = thread.editor(cx);
+    cx.read(|cx| editor.read(cx).text(cx))
+}
+
+fn notifications(thread: &Thread, cx: &mut TestAppContext) -> usize {
+    thread
+        .workspace
+        .read_with(cx, |w, _| w.notification_ids().len())
+}
+
+fn emit(event: VoiceEvent, cx: &mut TestAppContext) {
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    vi.update(cx, |_, cx| cx.emit(event));
+    cx.run_until_parked();
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[gpui::test]
+async fn voice_events_insert_lands_only_in_its_owner(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering("{}"), cx);
+    let a = open_thread(cx).await;
+    let b = open_thread(cx).await;
+    let (ida, idb) = (owner_of(&a, cx), owner_of(&b, cx));
+
+    emit(
+        VoiceEvent::Insert {
+            owner: ida,
+            text: "for A".into(),
+        },
+        cx,
+    );
+    assert_eq!(text_of(&a, cx), "for A", "R4.1");
+    assert_eq!(text_of(&b, cx), "", "B ignores A's transcript");
+
+    emit(
+        VoiceEvent::Insert {
+            owner: idb,
+            text: "for B".into(),
+        },
+        cx,
+    );
+    assert_eq!(text_of(&b, cx), "for B");
+    assert_eq!(text_of(&a, cx), "for A", "A ignores B's transcript");
+}
+
+#[gpui::test]
+async fn voice_events_unknown_owner_changes_nothing(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering("{}"), cx);
+    let a = open_thread(cx).await;
+    let stranger = cx.update(|cx| {
+        use gpui::AppContext as _;
+        cx.new(|_| ())
+    });
+    let before = notifications(&a, cx);
+    emit(
+        VoiceEvent::Insert {
+            owner: stranger.entity_id(),
+            text: "nobody's".into(),
+        },
+        cx,
+    );
+    emit(
+        VoiceEvent::Notify {
+            owner: stranger.entity_id(),
+            message: "nobody's".into(),
+        },
+        cx,
+    );
+    assert_eq!(text_of(&a, cx), "");
+    assert_eq!(
+        notifications(&a, cx),
+        before,
+        "A's workspace shows nothing for another owner"
+    );
+}
+
+#[gpui::test]
+async fn voice_events_notify_shows_in_the_owners_workspace(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering("{}"), cx);
+    let a = open_thread(cx).await;
+    let b = open_thread(cx).await;
+    let (before_a, before_b) = (notifications(&a, cx), notifications(&b, cx));
+    emit(
+        VoiceEvent::Notify {
+            owner: owner_of(&a, cx),
+            message: "Voice input is busy in another thread".into(),
+        },
+        cx,
+    );
+    assert_eq!(
+        notifications(&a, cx),
+        before_a + 1,
+        "R5.1 the owner is told"
+    );
+    assert_eq!(notifications(&b, cx), before_b, "not the other composer");
+}
+
+#[gpui::test]
+async fn voice_events_insert_into_a_read_only_composer_is_refused_visibly(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering("{}"), cx);
+    let a = open_thread(cx).await;
+    let editor = a.editor(cx);
+    editor.update(cx, |me, cx| me.set_read_only(true, cx));
+    let before = notifications(&a, cx);
+    emit(
+        VoiceEvent::Insert {
+            owner: owner_of(&a, cx),
+            text: "lost".into(),
+        },
+        cx,
+    );
+    assert_eq!(
+        text_of(&a, cx),
+        "",
+        "nothing inserted into a read-only composer"
+    );
+    assert_eq!(
+        notifications(&a, cx),
+        before + 1,
+        "the refusal is shown, not swallowed"
+    );
+}
+
+#[gpui::test]
+async fn voice_events_transcript_for_a_closed_composer_is_discarded(cx: &mut TestAppContext) {
+    let gate: Arc<Mutex<Option<oneshot::Receiver<()>>>> = Arc::default();
+    let (release, held) = oneshot::channel();
+    *gate.lock().expect("lock") = Some(held);
+    let g = gate.clone();
+    let http: Arc<dyn HttpClient> = FakeHttpClient::create(move |_req| {
+        let held = g.lock().expect("lock").take();
+        async move {
+            if let Some(held) = held {
+                let _ = held.await;
+            }
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from(r#"{"text": "orphan transcript"}"#))?)
+        }
+    });
+    let voice = init_voice(REMOTE_SETTINGS, http, cx);
+    let a = open_thread(cx).await;
+    let b = open_thread(cx).await;
+    let ida = Owner(owner_of(&a, cx).as_u64());
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+
+    vi.update(cx, |vi, cx| vi.handle(Input::Click { owner: ida }, cx));
+    wait_until(cx, "recording", |_| {
+        voice.mic.starts.load(std::sync::atomic::Ordering::SeqCst) == 1
+    });
+    vi.update(cx, |vi, cx| vi.handle(Input::Click { owner: ida }, cx));
+    wait_until(cx, "the stop", |_| {
+        voice.mic.stops.load(std::sync::atomic::Ordering::SeqCst) == 1
+    });
+
+    // Close A: remove its window and drop every strong handle the test holds, so the thread view
+    // (and its subscription) is really gone.
+    let workspace_a = a.workspace.clone();
+    let count = move |b: &Thread, cx: &mut TestAppContext| {
+        workspace_a.read_with(cx, |w, _| w.notification_ids().len()) + notifications(b, cx)
+    };
+    let before = count(&b, cx);
+    cx.update_window(a.window, |_, window, _| window.remove_window())
+        .expect("close A");
+    drop(a);
+    cx.run_until_parked();
+    let _ = release.send(());
+    wait_until(cx, "the discard notice", |cx| count(&b, cx) > before);
+    assert_eq!(
+        text_of(&b, cx),
+        "",
+        "R4.7 never delivered to another composer"
+    );
+}
diff --git a/crates/agent_ui/src/voice_insert_more_tests.rs b/crates/agent_ui/src/voice_insert_more_tests.rs
new file mode 100644
index 0000000..0024066
--- /dev/null
+++ b/crates/agent_ui/src/voice_insert_more_tests.rs
@@ -0,0 +1,184 @@
+// Story 044, task 5.1, fix round 1 — `MessageEditor::insert_transcript` with a selection, with
+// several cursors, and next to typed text (R4.1, R4.2, R4.4; tech review of 5.1).
+//
+// Decision (orchestrator): dictation replaces a non-empty selection exactly like typing, and one
+// undo restores the selected text. With several cursors only the newest receives the transcript.
+//
+// Validation filter: `voice_insert` (every test path is `voice_insert_more_tests::…`).
+//
+// The text buffer does not group transactions under `cfg(test)` (its group interval is zero), so
+// the back-to-back tests opt in to production-like grouping; without that they would pass even if
+// `insert_transcript` merged into the neighbouring undo step.
+
+use std::path::Path;
+use std::time::Duration;
+
+use editor::{EditorMode, MultiBufferOffset};
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use util::path;
+use workspace::MultiWorkspace;
+
+use crate::message_editor::MessageEditor;
+use crate::test_support::init_test;
+
+async fn setup(cx: &mut TestAppContext) -> (Entity<MessageEditor>, &mut VisualTestContext) {
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs, [Path::new(path!("/project"))], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let editor = cx.update(|window, cx| {
+        cx.new(|cx| {
+            MessageEditor::new(
+                workspace.downgrade(),
+                project.downgrade(),
+                None,
+                Default::default(),
+                "Test Agent".into(),
+                "Test",
+                EditorMode::AutoHeight {
+                    min_lines: 1,
+                    max_lines: None,
+                },
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (editor, cx)
+}
+
+/// Sets the text as its own undo step and selects `ranges` (bytes); the last range is the newest.
+fn prepare(
+    editor: &Entity<MessageEditor>,
+    text: &str,
+    ranges: &[std::ops::Range<usize>],
+    cx: &mut VisualTestContext,
+) {
+    editor.update_in(cx, |me, window, cx| {
+        me.set_text(text, window, cx);
+        me.editor().update(cx, |e, cx| {
+            e.buffer()
+                .update(cx, |b, cx| b.finalize_last_transaction(cx));
+            e.change_selections(Default::default(), window, cx, |s| {
+                s.select_ranges(
+                    ranges
+                        .iter()
+                        .map(|r| MultiBufferOffset(r.start)..MultiBufferOffset(r.end)),
+                )
+            });
+        });
+    });
+}
+
+/// Groups edits made within a minute of each other into one undo step, as the 300 ms production
+/// interval does for edits made back to back.
+fn group_like_production(editor: &Entity<MessageEditor>, cx: &mut VisualTestContext) {
+    editor.update(cx, |me, cx| {
+        me.editor().update(cx, |e, cx| {
+            e.buffer().update(cx, |b, cx| {
+                b.set_group_interval(Duration::from_secs(60), cx)
+            })
+        });
+    });
+}
+
+/// Types `typed` at the cursor the way the editor does, with no finalize around it.
+fn type_text(editor: &Entity<MessageEditor>, typed: &str, cx: &mut VisualTestContext) {
+    editor.update_in(cx, |me, window, cx| {
+        me.editor().update(cx, |e, cx| e.insert(typed, window, cx))
+    });
+}
+
+fn insert(editor: &Entity<MessageEditor>, transcript: &str, cx: &mut VisualTestContext) {
+    editor
+        .update_in(cx, |me, window, cx| {
+            me.insert_transcript(transcript, window, cx)
+        })
+        .expect("inserted");
+    cx.run_until_parked();
+}
+
+fn undo(editor: &Entity<MessageEditor>, cx: &mut VisualTestContext) {
+    editor.update_in(cx, |me, window, cx| {
+        me.editor()
+            .update(cx, |e, cx| e.undo(&editor::actions::Undo, window, cx))
+    });
+}
+
+fn text(editor: &Entity<MessageEditor>, cx: &mut VisualTestContext) -> String {
+    editor.update(cx, |me, cx| me.text(cx))
+}
+
+#[gpui::test]
+async fn voice_insert_replaces_a_forward_selection_with_one_space(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, cx) = setup(cx).await;
+    // "world" selected left to right: the head is after the `d` the insert removes.
+    prepare(&editor, "Hello world", &[6..11], cx);
+    insert(&editor, "there", cx);
+    assert_eq!(
+        text(&editor, cx),
+        "Hello there",
+        "R4.2 one space, selection replaced"
+    );
+    undo(&editor, cx);
+    assert_eq!(
+        text(&editor, cx),
+        "Hello world",
+        "R4.4 one undo restores the selection"
+    );
+}
+
+#[gpui::test]
+async fn voice_insert_with_two_cursors_lands_once_at_the_newest(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, cx) = setup(cx).await;
+    // The cursor at 5 is the newest although it comes first in the text.
+    prepare(&editor, "Hello world", &[11..11, 5..5], cx);
+    insert(&editor, "there", cx);
+    assert_eq!(
+        text(&editor, cx),
+        "Hello there world",
+        "R4.1 once, at the newest cursor"
+    );
+    undo(&editor, cx);
+    assert_eq!(text(&editor, cx), "Hello world", "R4.4 one undo");
+}
+
+#[gpui::test]
+async fn voice_insert_right_after_typing_undoes_only_the_transcript(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, cx) = setup(cx).await;
+    group_like_production(&editor, cx);
+    type_text(&editor, "Typed by hand", cx);
+    insert(&editor, "then dictated", cx);
+    assert_eq!(text(&editor, cx), "Typed by hand then dictated");
+    undo(&editor, cx);
+    assert_eq!(
+        text(&editor, cx),
+        "Typed by hand",
+        "R4.4 the typed text survives"
+    );
+}
+
+#[gpui::test]
+async fn voice_insert_then_typing_undoes_only_the_typing(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, cx) = setup(cx).await;
+    group_like_production(&editor, cx);
+    insert(&editor, "Dictated words", cx);
+    type_text(&editor, " and typed", cx);
+    assert_eq!(text(&editor, cx), "Dictated words and typed");
+    undo(&editor, cx);
+    assert_eq!(
+        text(&editor, cx),
+        "Dictated words",
+        "R4.4 the transcript is its own step"
+    );
+}
diff --git a/crates/agent_ui/src/voice_insert_tests.rs b/crates/agent_ui/src/voice_insert_tests.rs
new file mode 100644
index 0000000..12319c8
--- /dev/null
+++ b/crates/agent_ui/src/voice_insert_tests.rs
@@ -0,0 +1,179 @@
+// Story 044, task 5.1 — `MessageEditor::insert_transcript` (R4.1, R4.2, R4.4; design.md C2 and the
+// last Error Handling row). Wired in the crate root `src/agent_ui.rs` as
+//
+//     #[cfg(test)]
+//     mod voice_insert_tests;
+//
+// Validation filter: `voice_insert` (every test path is `voice_insert_tests::…`).
+//
+// Contract: `insert_transcript(&mut self, text: &str, window, cx) -> anyhow::Result<()>` — refuses a
+// read-only composer, puts one space before the transcript after a non-whitespace character, is one
+// undo step, never sends. The setup mirrors `message_editor::tests::setup_message_editor` (private
+// there); on the series tip, copy its current `MessageEditor::new` arguments if they moved.
+//
+// Hostile halves: one undo removes the whole transcript (space included) AND only the transcript —
+// what was typed before survives; a space after a letter AND none after a space, a newline or at the
+// start; insertion happens at the cursor, not at the end; a read-only composer is untouched AND the
+// refusal says why; no Send/SendImmediately event, ever.
+
+use std::path::Path;
+use std::sync::{Arc, Mutex};
+
+use editor::{EditorMode, MultiBufferOffset};
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use util::path;
+use workspace::MultiWorkspace;
+
+use crate::message_editor::{MessageEditor, MessageEditorEvent};
+use crate::test_support::init_test;
+
+async fn setup(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<MessageEditor>,
+    Arc<Mutex<Vec<String>>>,
+    &mut VisualTestContext,
+) {
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs, [Path::new(path!("/project"))], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let editor = cx.update(|window, cx| {
+        cx.new(|cx| {
+            MessageEditor::new(
+                workspace.downgrade(),
+                project.downgrade(),
+                None,
+                Default::default(),
+                "Test Agent".into(),
+                "Test",
+                EditorMode::AutoHeight {
+                    min_lines: 1,
+                    max_lines: None,
+                },
+                window,
+                cx,
+            )
+        })
+    });
+    let sent: Arc<Mutex<Vec<String>>> = Arc::default();
+    let sink = sent.clone();
+    cx.update(|_, cx| {
+        cx.subscribe(&editor, move |_, event: &MessageEditorEvent, _| {
+            if matches!(
+                event,
+                MessageEditorEvent::Send | MessageEditorEvent::SendImmediately
+            ) {
+                sink.lock().expect("lock").push(format!("{event:?}"));
+            }
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+    (editor, sent, cx)
+}
+
+/// Sets the text as its own undo step and puts the cursor at `cursor` (bytes).
+fn prepare(editor: &Entity<MessageEditor>, text: &str, cursor: usize, cx: &mut VisualTestContext) {
+    editor.update_in(cx, |me, window, cx| {
+        me.set_text(text, window, cx);
+        me.editor().update(cx, |e, cx| {
+            e.buffer()
+                .update(cx, |b, cx| b.finalize_last_transaction(cx));
+            e.change_selections(Default::default(), window, cx, |s| {
+                s.select_ranges([MultiBufferOffset(cursor)..MultiBufferOffset(cursor)])
+            });
+        });
+    });
+}
+
+fn insert(
+    editor: &Entity<MessageEditor>,
+    transcript: &str,
+    cx: &mut VisualTestContext,
+) -> anyhow::Result<()> {
+    let result = editor.update_in(cx, |me, window, cx| {
+        me.insert_transcript(transcript, window, cx)
+    });
+    cx.run_until_parked();
+    result
+}
+
+fn text(editor: &Entity<MessageEditor>, cx: &mut VisualTestContext) -> String {
+    editor.update(cx, |me, cx| me.text(cx))
+}
+
+#[gpui::test]
+async fn voice_insert_into_an_empty_composer_has_no_leading_space(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, sent, cx) = setup(cx).await;
+    insert(&editor, "Refactor the parser", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "Refactor the parser");
+    assert!(sent.lock().expect("lock").is_empty(), "R4.1 nothing sent");
+}
+
+#[gpui::test]
+async fn voice_insert_after_a_letter_adds_one_space(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, sent, cx) = setup(cx).await;
+    prepare(&editor, "Fix the bug", 11, cx);
+    insert(&editor, "in the lexer", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "Fix the bug in the lexer", "R4.2");
+    assert!(sent.lock().expect("lock").is_empty());
+}
+
+#[gpui::test]
+async fn voice_insert_after_whitespace_adds_no_space(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, _sent, cx) = setup(cx).await;
+    prepare(&editor, "Fix: ", 5, cx);
+    insert(&editor, "the lexer", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "Fix: the lexer");
+    prepare(&editor, "line one\n", 9, cx);
+    insert(&editor, "line two", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "line one\nline two");
+}
+
+#[gpui::test]
+async fn voice_insert_goes_to_the_cursor_not_the_end(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, _sent, cx) = setup(cx).await;
+    prepare(&editor, "Hello world", 5, cx);
+    insert(&editor, "there", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "Hello there world", "R4.1 at the cursor");
+}
+
+#[gpui::test]
+async fn voice_insert_is_one_undo_step_and_only_that(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, _sent, cx) = setup(cx).await;
+    prepare(&editor, "Typed by hand", 13, cx);
+    insert(&editor, "and then dictated words", cx).expect("inserted");
+    assert_eq!(text(&editor, cx), "Typed by hand and then dictated words");
+    editor.update_in(cx, |me, window, cx| {
+        me.editor()
+            .update(cx, |e, cx| e.undo(&editor::actions::Undo, window, cx))
+    });
+    assert_eq!(
+        text(&editor, cx),
+        "Typed by hand",
+        "R4.4 one undo removes the transcript and its space"
+    );
+}
+
+#[gpui::test]
+async fn voice_insert_refuses_a_read_only_composer(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (editor, sent, cx) = setup(cx).await;
+    prepare(&editor, "frozen", 6, cx);
+    editor.update(cx, |me, cx| me.set_read_only(true, cx));
+    let err = insert(&editor, "should not land", cx).expect_err("read-only refuses");
+    assert!(format!("{err:#}").contains("read-only"), "{err:#}");
+    assert_eq!(text(&editor, cx), "frozen", "untouched");
+    assert!(sent.lock().expect("lock").is_empty());
+}
diff --git a/crates/agent_ui/src/voice_keyless_tests.rs b/crates/agent_ui/src/voice_keyless_tests.rs
new file mode 100644
index 0000000..eb2de11
--- /dev/null
+++ b/crates/agent_ui/src/voice_keyless_tests.rs
@@ -0,0 +1,183 @@
+// Story 044, task 8.3 (refine v3) — a toggle run from the command palette is a tap (R2.3, R2.7,
+// R3.2; design.md C2 "v3, keyless dispatch"). Wired in the crate root `src/agent_ui.rs` beside
+// `voice_keys_tests`, whose harness it reuses:
+//
+//     #[cfg(test)]
+//     mod voice_keyless_tests;
+//
+// Validation filter: `voice_keyless` (every test path is `voice_keyless_tests::…`).
+//
+// Contract: `ToggleRecording` dispatched with no keystroke (the command palette's way in) acts as
+// a click: from idle it starts a toggle recording, on a running toggle it stops and transcribes,
+// and nothing is left waiting for a key release. The keyed paths are unchanged: a tap toggles, a
+// press held past 300 ms is a hold, a key repeat is ignored.
+//
+// `window.dispatch_action` runs the action with no keystroke behind it, so the keystroke observer
+// never sees it — exactly the palette's case.
+//
+// Hostile halves, the wrong collapse first: a keyless start is not a press still held — time
+// passing and a stray key-up of the shortcut's key do not stop it as a hold, and the next press
+// (keyless or keyed) is not taken for a key repeat; then the wrong split: a keyed tap and a keyed
+// hold still behave as before, including after a keyless toggle; then the plain case.
+
+use std::time::Duration;
+
+use gpui::{TestAppContext, VisualTestContext};
+use voice_input::{ToggleRecording, ViewState, VoiceInput};
+
+use crate::voice_keys_tests::{
+    REMOTE_SETTINGS, Thread, answering, counts, focused_thread, init_voice, press, release,
+};
+
+/// Longer than the 300 ms tap window.
+const PAST_THE_TAP_WINDOW: Duration = Duration::from_millis(400);
+
+fn keyless(vcx: &mut VisualTestContext) {
+    vcx.dispatch_action(ToggleRecording);
+    vcx.run_until_parked();
+}
+
+fn recording(thread: &Thread, cx: &TestAppContext) -> bool {
+    let owner = thread.view(cx).entity_id();
+    cx.read(|cx| {
+        matches!(
+            VoiceInput::global(cx).read(cx).view_state(owner),
+            ViewState::Recording { .. }
+        )
+    })
+}
+
+// ── the wrong collapse: a keyless start is no held press ───────────────────
+
+#[gpui::test]
+async fn voice_keyless_start_is_a_toggle_that_time_and_a_key_up_do_not_stop(
+    cx: &mut TestAppContext,
+) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (thread, mut vcx) = focused_thread(cx).await;
+
+    keyless(&mut vcx);
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.7 a keyless toggle starts recording"
+    );
+
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 0, 0), "still recording past 300 ms");
+    std::thread::sleep(Duration::from_millis(1_600));
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 0, 0), "still recording at 2 s");
+
+    // A key-up of the shortcut's key, with no press behind it: a toggle waits for no release, so
+    // it cannot be one.
+    release(&mut vcx, "v");
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.7 never waits for a key release: a stray key-up does not end it as a hold"
+    );
+    assert!(recording(&thread, cx), "the toggle recording runs on");
+}
+
+#[gpui::test]
+async fn voice_keyless_second_dispatch_stops_it(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    keyless(&mut vcx);
+    assert_eq!(counts(&voice.mic), (1, 0, 0));
+    keyless(&mut vcx);
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R2.3/R2.7 the second keyless toggle stops and transcribes: it is not a key repeat"
+    );
+}
+
+#[gpui::test]
+async fn voice_keyless_start_then_a_keyed_tap_stops_it(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    keyless(&mut vcx);
+    assert_eq!(counts(&voice.mic), (1, 0, 0));
+    // Straight away, inside 300 ms of the keyless start.
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R2.3/R3.2 the shortcut pressed after a keyless start stops it: not taken for a repeat"
+    );
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 1, 0), "its release changes nothing");
+}
+
+// ── the wrong split: the keyed paths are unchanged ─────────────────────────
+
+#[gpui::test]
+async fn voice_keyless_keyed_tap_still_toggles(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.2 a keyed tap keeps recording"
+    );
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R2.3 the next press stops it"
+    );
+}
+
+#[gpui::test]
+async fn voice_keyless_keyed_hold_still_stops_on_release(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    press(&mut vcx); // a key repeat while held
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    assert_eq!(counts(&voice.mic), (1, 0, 0), "R3.2 the repeat is ignored");
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R3.1 the release ends the hold"
+    );
+}
+
+#[gpui::test]
+async fn voice_keyless_toggle_leaves_the_keyed_hold_working(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    keyless(&mut vcx);
+    keyless(&mut vcx);
+    // Lets the transcription finish, so the next press can start again.
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 1, 0), "a keyless start and stop");
+
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (2, 1, 0),
+        "a fresh press after a keyless toggle starts: nothing was left held"
+    );
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (2, 2, 0), "R3.1 and is a hold");
+}
diff --git a/crates/agent_ui/src/voice_keymap_v3_tests.rs b/crates/agent_ui/src/voice_keymap_v3_tests.rs
new file mode 100644
index 0000000..82a742c
--- /dev/null
+++ b/crates/agent_ui/src/voice_keymap_v3_tests.rs
@@ -0,0 +1,364 @@
+// Story 044, task 8.2 (refine v3) — Escape yields to an open completion menu, and vim binds the
+// voice toggle per OS (R2.2, R2.5, R6.7; design.md C3 "As built (v3)"). Wired in the crate root
+// `src/agent_ui.rs` beside `voice_keys_tests`, whose harness it reuses:
+//
+//     #[cfg(test)]
+//     mod voice_keymap_v3_tests;
+//
+// Validation filter: `voice_keymap_v3` (every test path is `voice_keymap_v3_tests::…`).
+//
+// Contract: with a completion menu open in the composer, Escape resolves as it would with no
+// voice state at all (the editor's own Escape closes the menu), and the recording or the consent
+// stays; with no menu, Escape in the composer is `voice_input::CancelRecording` while recording and
+// `voice_input::DismissDownload` while the consent is asked. `vim.json` binds ToggleRecording
+// twice: `cmd-alt-v` under `AcpThread && os == macos`, `ctrl-alt-v` under `AcpThread && os !=
+// macos`. The thread view's `AcpThread` key context carries `os`.
+//
+// The resolution tests build the context stack by hand — [Workspace, AcpThread (+ voice key),
+// Editor (+ voice key, + menu and showing_completions when the menu shows)] — and resolve
+// `escape` against each keymap (vim.json layered over default-linux, as Zed loads it). The
+// expected action with the menu open is read from the same keymap with the voice keys removed,
+// so the test does not hard-code which editor action closes a menu in each keymap.
+//
+// Hostile halves, the wrong collapse first: the voice blocks do not swallow the Escape that closes
+// a menu (the first Escape cancels nothing), and on Linux vim does not bind `cmd-alt-v`; then the
+// wrong split: with no menu, Escape still cancels the recording and declines the consent, and the
+// second Escape (menu closed) cancels; then the plain case.
+
+use gpui::{KeyBinding, KeyContext, Keymap, Keystroke, TestAppContext, VisualTestContext};
+use voice_input::ToggleRecording;
+
+use crate::test_support::init_test;
+use crate::voice_keys_tests::{
+    REMOTE_SETTINGS, Thread, answering, counts, focused_thread, init_voice, press, release,
+};
+
+const DEFAULT_KEYMAPS: [&str; 3] = [
+    "keymaps/default-linux.json",
+    "keymaps/default-windows.json",
+    "keymaps/default-macos.json",
+];
+const VIM: &str = "keymaps/vim.json";
+
+const CANCEL_RECORDING: &str = "voice_input::CancelRecording";
+const DISMISS_DOWNLOAD: &str = "voice_input::DismissDownload";
+
+fn load(asset: &str, cx: &mut TestAppContext) -> Vec<KeyBinding> {
+    cx.update(|cx| {
+        settings::KeymapFile::load_asset_allow_partial_failure(asset, cx).expect("keymap loads")
+    })
+}
+
+/// Every keymap under test, vim.json on top of the Linux default as Zed loads it.
+fn keymaps(cx: &mut TestAppContext) -> Vec<(String, Keymap)> {
+    let mut keymaps: Vec<(String, Keymap)> = DEFAULT_KEYMAPS
+        .iter()
+        .map(|name| (name.to_string(), Keymap::new(load(name, cx))))
+        .collect();
+    let mut vim = load("keymaps/default-linux.json", cx);
+    vim.extend(load(VIM, cx));
+    keymaps.push((format!("{VIM} over default-linux"), Keymap::new(vim)));
+    keymaps
+}
+
+#[derive(Clone, Copy)]
+struct Stack {
+    voice: Option<&'static str>,
+    menu: bool,
+    vim_insert: bool,
+}
+
+// Linux on every host: the stacks are resolved against default-linux.json and vim.json's
+// `os != macos` arm, so the os they carry is part of the fixture, not the host's.
+fn stack(spec: Stack) -> Vec<KeyContext> {
+    let mut workspace = KeyContext::new_with_defaults(gpui::OperatingSystem::Linux);
+    workspace.add("Workspace");
+    let mut thread = KeyContext::new_with_defaults(gpui::OperatingSystem::Linux);
+    thread.add("AcpThread");
+    let mut editor = KeyContext::new_with_defaults(gpui::OperatingSystem::Linux);
+    editor.add("Editor");
+    editor.set("mode", "auto_height");
+    if let Some(voice) = spec.voice {
+        thread.add(voice);
+        editor.add(voice);
+    }
+    if spec.menu {
+        editor.add("menu");
+        editor.add("showing_completions");
+    }
+    if spec.vim_insert {
+        editor.add("VimControl");
+        editor.set("vim_mode", "insert");
+    }
+    vec![workspace, thread, editor]
+}
+
+fn escape_in(keymap: &Keymap, spec: Stack) -> Option<String> {
+    let escape = Keystroke::parse("escape").expect("keystroke");
+    keymap
+        .bindings_for_input(&[escape], &stack(spec))
+        .0
+        .first()
+        .map(|binding| binding.action().name().to_string())
+}
+
+// ── the wrong collapse: an open menu takes the first Escape ────────────────
+
+#[gpui::test]
+fn voice_keymap_v3_escape_with_a_menu_open_resolves_as_without_voice(cx: &mut TestAppContext) {
+    init_test(cx);
+    for (name, keymap) in keymaps(cx) {
+        for vim_insert in [false, true] {
+            let without_voice = escape_in(
+                &keymap,
+                Stack {
+                    voice: None,
+                    menu: true,
+                    vim_insert,
+                },
+            );
+            assert!(
+                without_voice
+                    .as_deref()
+                    .is_some_and(|action| !action.starts_with("voice_input::")),
+                "{name} (vim insert: {vim_insert}): precondition, Escape over a menu is the editor's: {without_voice:?}"
+            );
+            for voice in ["voice_recording", "voice_consent"] {
+                let with_voice = escape_in(
+                    &keymap,
+                    Stack {
+                        voice: Some(voice),
+                        menu: true,
+                        vim_insert,
+                    },
+                );
+                assert_eq!(
+                    with_voice, without_voice,
+                    "{name} (vim insert: {vim_insert}): R2.5 under {voice} with a completion menu open, \
+                     the first Escape closes the menu"
+                );
+            }
+        }
+    }
+}
+
+#[gpui::test]
+fn voice_keymap_v3_default_keymaps_close_the_menu_with_editor_cancel(cx: &mut TestAppContext) {
+    init_test(cx);
+    for (name, keymap) in keymaps(cx) {
+        let action = escape_in(
+            &keymap,
+            Stack {
+                voice: Some("voice_recording"),
+                menu: true,
+                vim_insert: false,
+            },
+        );
+        assert_eq!(
+            action.as_deref(),
+            Some("editor::Cancel"),
+            "{name}: Escape over the composer's completion menu is editor::Cancel while recording"
+        );
+    }
+}
+
+// ── the wrong split: with no menu, Escape is the voice strip's ─────────────
+
+#[gpui::test]
+fn voice_keymap_v3_escape_without_a_menu_cancels_or_declines(cx: &mut TestAppContext) {
+    init_test(cx);
+    for (name, keymap) in keymaps(cx) {
+        for vim_insert in [false, true] {
+            for (voice, expected) in [
+                ("voice_recording", CANCEL_RECORDING),
+                ("voice_consent", DISMISS_DOWNLOAD),
+            ] {
+                let action = escape_in(
+                    &keymap,
+                    Stack {
+                        voice: Some(voice),
+                        menu: false,
+                        vim_insert,
+                    },
+                );
+                assert_eq!(
+                    action.as_deref(),
+                    Some(expected),
+                    "{name} (vim insert: {vim_insert}): R2.5/R6.7 Escape under {voice} with no menu"
+                );
+            }
+        }
+    }
+}
+
+// ── vim binds the toggle per OS ─────────────────────────────────────────────
+
+fn toggle_blocks(content: &str) -> Vec<(String, String)> {
+    let sections =
+        settings::parse_json_with_comments::<Vec<serde_json::Value>>(content).expect("keymap JSON");
+    let mut found = Vec::new();
+    for section in sections {
+        let context = section
+            .get("context")
+            .and_then(|context| context.as_str())
+            .unwrap_or("")
+            .split_whitespace()
+            .collect::<Vec<_>>()
+            .join(" ");
+        let Some(bindings) = section.get("bindings").and_then(|b| b.as_object()) else {
+            continue;
+        };
+        for (keys, action) in bindings {
+            if action.as_str() == Some("voice_input::ToggleRecording") {
+                found.push((context.clone(), keys.clone()));
+            }
+        }
+    }
+    found
+}
+
+#[test]
+fn voice_keymap_v3_vim_binds_the_toggle_once_per_os() {
+    let found = toggle_blocks(include_str!("../../../assets/keymaps/vim.json"));
+    assert_eq!(
+        found.len(),
+        2,
+        "vim.json binds ToggleRecording exactly twice: {found:?}"
+    );
+    assert!(
+        found.iter().any(|(context, keys)| keys == "cmd-alt-v"
+            && context.contains("AcpThread")
+            && context.contains("os == macos")),
+        "cmd-alt-v under AcpThread && os == macos: {found:?}"
+    );
+    assert!(
+        found.iter().any(|(context, keys)| keys == "ctrl-alt-v"
+            && context.contains("AcpThread")
+            && context.contains("os != macos")),
+        "ctrl-alt-v under AcpThread && os != macos: {found:?}"
+    );
+}
+
+fn is_chord(binding: &KeyBinding, chord: &'static str) -> bool {
+    let chord = Keystroke::parse(chord).expect("keystroke");
+    binding.keystrokes().len() == 1
+        && binding.keystrokes()[0].inner().modifiers == chord.modifiers
+        && binding.keystrokes()[0].inner().key == chord.key
+}
+
+#[gpui::test]
+async fn voice_keymap_v3_thread_context_carries_the_os(cx: &mut TestAppContext) {
+    let _voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    // The host os the app reports, which is what the thread's context is built from.
+    let expected = vcx.update(|_, cx| {
+        KeyContext::new_with_defaults(cx.platform_info().os)
+            .get("os")
+            .cloned()
+    });
+    let thread_os = vcx.update(|window, _| {
+        window
+            .context_stack()
+            .into_iter()
+            .find(|context| context.contains("AcpThread"))
+            .map(|context| context.get("os").cloned())
+    });
+    assert_eq!(
+        thread_os,
+        Some(expected),
+        "the AcpThread key context names the os, so `AcpThread && os == …` can match"
+    );
+}
+
+#[gpui::test]
+async fn voice_keymap_v3_vim_on_this_os_binds_only_its_own_chord(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    cx.update(|cx| {
+        let vim = settings::KeymapFile::load_asset_allow_partial_failure(VIM, cx)
+            .expect("vim keymap loads");
+        cx.bind_keys(vim);
+    });
+    let (thread, mut vcx) = focused_thread(cx).await;
+    let focus = composer_focus(&thread, &mut vcx);
+    let bindings = vcx.update(|window, _| window.bindings_for_action_in(&ToggleRecording, &focus));
+    let (own, other) = if cfg!(target_os = "macos") {
+        ("cmd-alt-v", "ctrl-alt-v")
+    } else {
+        ("ctrl-alt-v", "cmd-alt-v")
+    };
+    assert!(
+        bindings.iter().any(|binding| is_chord(binding, own)),
+        "{own} is bound in the composer with vim.json loaded"
+    );
+    assert!(
+        !bindings.iter().any(|binding| is_chord(binding, other)),
+        "{other} is not bound on this OS with vim.json loaded"
+    );
+    if !cfg!(target_os = "macos") {
+        press(&mut vcx);
+        release(&mut vcx, "ctrl-alt-v");
+        vcx.run_until_parked();
+        assert_eq!(
+            counts(&voice.mic),
+            (1, 0, 0),
+            "R2.2 the vim user's ctrl-alt-v records"
+        );
+    }
+}
+
+fn composer_focus(thread: &Thread, vcx: &mut VisualTestContext) -> gpui::FocusHandle {
+    let editor = thread.editor(vcx);
+    editor.read_with(vcx, |editor, cx| gpui::Focusable::focus_handle(editor, cx))
+}
+
+// ── a live completion menu in a recording thread ───────────────────────────
+
+#[gpui::test]
+async fn voice_keymap_v3_first_escape_closes_the_menu_and_the_second_cancels(
+    cx: &mut TestAppContext,
+) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "precondition: a toggle recording runs"
+    );
+
+    // `@` opens the composer's mention menu.
+    vcx.simulate_input("@");
+    vcx.run_until_parked();
+    let message_editor = thread.editor(&vcx);
+    let menu_open = |vcx: &mut VisualTestContext| {
+        message_editor.read_with(vcx, |message_editor, cx| {
+            message_editor
+                .editor()
+                .read(cx)
+                .has_visible_completions_menu()
+        })
+    };
+    assert!(
+        menu_open(&mut vcx),
+        "precondition: the harness opened the completion menu"
+    );
+
+    vcx.simulate_keystrokes("escape");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.5 the first Escape closes the menu: the recording goes on, nothing cancelled"
+    );
+    assert!(!menu_open(&mut vcx), "the first Escape closed the menu");
+
+    vcx.simulate_keystrokes("escape");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 1),
+        "R2.5 with the menu closed, Escape cancels the recording"
+    );
+}
diff --git a/crates/agent_ui/src/voice_keys_fix_tests.rs b/crates/agent_ui/src/voice_keys_fix_tests.rs
new file mode 100644
index 0000000..f992177
--- /dev/null
+++ b/crates/agent_ui/src/voice_keys_fix_tests.rs
@@ -0,0 +1,381 @@
+// Story 044, task 5.3 fix round 1 — the three findings of the 5.3 tech review (R2.3, R2.5, R3.1,
+// R3.2). Wired in the crate root `src/agent_ui.rs` beside `voice_keys_tests`, whose harness it
+// reuses. Validation filter: `voice_keys_fix` (every test path is `voice_keys_fix_tests::…`).
+//
+// M1: Escape is claimed by the voice strip only while the consent is asked, never while the
+// model downloads: during the download it keeps its usual meaning and the download goes on.
+// M2: on macOS the key-up of `v` is not delivered while Cmd is held, so letting go of the
+// shortcut's modifiers is a release too; a key-up arriving afterwards changes nothing.
+// L1: the release is matched against every binding of `ToggleRecording`, not only the binding of
+// highest precedence.
+
+use std::{sync::Arc, time::Duration};
+
+use gpui::{
+    Focusable as _, KeyBinding, KeyDownEvent, Keystroke, Modifiers, TestAppContext,
+    VisualTestContext,
+};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use voice_input::state::Input;
+use voice_input::{DismissDownload, ToggleRecording, ViewState, VoiceInput};
+
+use crate::voice_button::send;
+use crate::voice_keys_tests::{
+    REMOTE_SETTINGS, Thread, answering, counts, focused_thread, init_voice, press, release,
+};
+
+/// Longer than the 300 ms tap window, so a release past it ends a push-to-talk hold (R3.1).
+const PAST_THE_TAP_WINDOW: Duration = Duration::from_millis(400);
+
+/// Local mode with no model on disk: the first press asks for the download (R6.1).
+const LOCAL_SETTINGS: &str = r#"{ "voice_input": { "model": "tiny" } }"#;
+
+/// An HTTP client whose every request stays in flight: a download started with it keeps running
+/// for as long as the test needs.
+fn never_answering() -> Arc<dyn HttpClient> {
+    FakeHttpClient::create(|_req| futures::future::pending::<anyhow::Result<Response<AsyncBody>>>())
+}
+
+fn view_state(thread: &Thread, cx: &TestAppContext) -> ViewState {
+    let owner = thread.view(cx).entity_id();
+    cx.read(|cx| VoiceInput::global(cx).read(cx).view_state(owner))
+}
+
+fn composer_names_voice_consent(vcx: &mut VisualTestContext) -> bool {
+    vcx.update(|window, _| {
+        window
+            .context_stack()
+            .iter()
+            .any(|context| context.contains("voice_consent"))
+    })
+}
+
+fn tap(vcx: &mut VisualTestContext) {
+    press(vcx);
+    release(vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+}
+
+// ── M1: Escape and the model download ───────────────────────────────────────
+
+#[gpui::test]
+async fn voice_keys_fix_escape_declines_the_consent_but_leaves_a_download_running(
+    cx: &mut TestAppContext,
+) {
+    let voice = init_voice(LOCAL_SETTINGS, never_answering(), cx);
+    let (thread, mut vcx) = focused_thread(cx).await;
+
+    // The consent the user just triggered: Escape declines it.
+    tap(&mut vcx);
+    assert!(
+        matches!(view_state(&thread, cx), ViewState::AwaitingConsent { .. }),
+        "a press with no model asks for the download: {:?}",
+        view_state(&thread, cx)
+    );
+    assert!(
+        composer_names_voice_consent(&mut vcx),
+        "the composer names voice_consent while the consent is asked"
+    );
+    vcx.simulate_keystrokes("escape");
+    vcx.run_until_parked();
+    assert!(
+        matches!(view_state(&thread, cx), ViewState::Idle { .. }),
+        "Escape declines the consent: {:?}",
+        view_state(&thread, cx)
+    );
+
+    // The download, once consented to, runs in the background while the user keeps typing.
+    tap(&mut vcx);
+    assert!(
+        matches!(view_state(&thread, cx), ViewState::AwaitingConsent { .. }),
+        "{:?}",
+        view_state(&thread, cx)
+    );
+    vcx.update(|_, cx| send(Input::ConsentGiven, cx));
+    vcx.run_until_parked();
+    assert!(
+        matches!(view_state(&thread, cx), ViewState::Downloading { .. }),
+        "the consent starts the download: {:?}",
+        view_state(&thread, cx)
+    );
+    assert!(
+        !composer_names_voice_consent(&mut vcx),
+        "the composer does not name voice_consent while the model downloads"
+    );
+    let editor_focus = thread
+        .editor(cx)
+        .read_with(&vcx, |editor, cx| editor.focus_handle(cx));
+    let dismiss_bindings = vcx.update(|window, _| {
+        window
+            .bindings_for_action_in(&DismissDownload, &editor_focus)
+            .len()
+    });
+    assert_eq!(
+        dismiss_bindings, 0,
+        "no key reaches DismissDownload from the composer while the model downloads"
+    );
+    vcx.simulate_keystrokes("escape");
+    vcx.run_until_parked();
+    assert!(
+        matches!(view_state(&thread, cx), ViewState::Downloading { .. }),
+        "Escape in the composer keeps its usual meaning: the download is not cancelled: {:?}",
+        view_state(&thread, cx)
+    );
+    assert_eq!(
+        counts(&voice.mic),
+        (0, 0, 0),
+        "no recording was ever involved"
+    );
+}
+
+// ── M2: letting go of the modifiers releases the shortcut ───────────────────
+
+#[gpui::test]
+async fn voice_keys_fix_releasing_the_modifiers_ends_a_hold_without_a_key_up(
+    cx: &mut TestAppContext,
+) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+
+    // A hold: `v` is let go of while Cmd is down, so its key-up never comes (macOS).
+    press(&mut vcx);
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.simulate_modifiers_change(Modifiers::none());
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R3.1 releasing the shortcut's modifiers ends the hold"
+    );
+
+    // The key-up arriving afterwards is the same release, seen twice: nothing more happens.
+    release(&mut vcx, "v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "a key-up after the modifiers release neither starts nor stops anything"
+    );
+
+    // A tap released by the modifiers alone is a release too: the next press is a fresh one.
+    press(&mut vcx);
+    vcx.run_until_parked();
+    vcx.simulate_modifiers_change(Modifiers::none());
+    release(&mut vcx, "v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (2, 1, 0),
+        "R2.2 a tap keeps recording after its release"
+    );
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (2, 2, 0),
+        "R2.3/R3.2 the press after a modifiers release is not taken for a repeat: it stops"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_fix_a_modifier_still_held_does_not_release(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    // Ctrl let go of, Alt still down, `v` still down: the shortcut is still held.
+    vcx.simulate_modifiers_change(Modifiers::alt());
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "one of the shortcut's modifiers is still held"
+    );
+    vcx.simulate_modifiers_change(Modifiers::none());
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "the last of them let go of releases the hold"
+    );
+}
+
+// ── L1: every binding of the shortcut releases ──────────────────────────────
+
+#[gpui::test]
+async fn voice_keys_fix_every_binding_of_the_shortcut_releases(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    // A user's own second binding, on a different final key. User keymaps load after the
+    // defaults, so it takes precedence over `ctrl-alt-v`. Not `f9`: the default keymap binds it
+    // to `editor::ToggleBreakpoint` in the composer's deeper `Editor` context.
+    cx.update(|cx| {
+        cx.bind_keys([KeyBinding::new(
+            "ctrl-alt-m",
+            ToggleRecording,
+            Some("AcpThread"),
+        )]);
+    });
+    let (_thread, mut vcx) = focused_thread(cx).await;
+
+    vcx.simulate_keystrokes("ctrl-alt-m");
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    release(&mut vcx, "ctrl-alt-m");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R3.1 the release of ctrl-alt-m ends its hold"
+    );
+    // Lets the transcription finish, so the next press starts again.
+    vcx.run_until_parked();
+
+    press(&mut vcx);
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (2, 2, 0),
+        "R3.1 the release of v ends a ctrl-alt-v hold, though ctrl-alt-m is the binding shown"
+    );
+}
+
+// ── Fix round 1b ─────────────────────────────────────────────────────────────
+//
+// M-1: gpui's Wayland client repeats a held key on the client side by replaying the keystroke it
+// captured at the press, `is_held: true`, until that key's key-up; letting go of Ctrl and Alt
+// changes neither. After a release through the modifiers, those replays are not fresh presses.
+
+fn stale_repeat(vcx: &mut VisualTestContext) {
+    vcx.simulate_event(KeyDownEvent {
+        keystroke: Keystroke::parse("ctrl-alt-v").expect("keystroke"),
+        is_held: true,
+        prefer_character_input: false,
+    });
+}
+
+#[gpui::test]
+async fn voice_keys_fix_repeats_after_a_modifiers_release_start_nothing(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.simulate_modifiers_change(Modifiers::none());
+    // Lets the transcription finish, so a press read as fresh would start a new recording.
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "the modifiers release ended the hold"
+    );
+
+    stale_repeat(&mut vcx);
+    stale_repeat(&mut vcx);
+    vcx.run_until_parked();
+    release(&mut vcx, "v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "a key still repeating after its modifiers were let go of starts no recording"
+    );
+
+    // The key-up ended the stale repeat: the next press is a fresh one again.
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic).0,
+        2,
+        "a press after the key-up starts recording"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_fix_a_chord_pressed_again_after_a_modifiers_release_counts(
+    cx: &mut TestAppContext,
+) {
+    // macOS: no key-up of `v` ever comes while Cmd is held, so pressing a modifier of the chord
+    // again is what makes the next press a fresh one.
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.simulate_modifiers_change(Modifiers::none());
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 1, 0));
+
+    vcx.simulate_modifiers_change(Modifiers::control());
+    vcx.simulate_modifiers_change(Modifiers::control() | Modifiers::alt());
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic).0,
+        2,
+        "the chord's modifiers pressed again make the next press a fresh one"
+    );
+}
+
+// L-3: the order users usually type — `v` up inside the tap window, the modifiers let go of later.
+
+#[gpui::test]
+async fn voice_keys_fix_a_tap_is_not_ended_by_a_later_modifiers_release(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.simulate_modifiers_change(Modifiers::none());
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.2 the tap keeps recording: the later modifiers release is not a second release"
+    );
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R2.3 the next press stops the toggle"
+    );
+}
+
+// L-1: the keystroke observer is app-wide. A press without a key (the command palette) leaves a
+// view waiting for its keystroke; a chord pressed in another window must not be recorded as its.
+
+#[gpui::test]
+async fn voice_keys_fix_a_press_in_another_window_is_not_recorded_as_this_views(
+    cx: &mut TestAppContext,
+) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_other, mut other_vcx) = focused_thread(cx).await;
+    let (_thread, mut vcx) = focused_thread(cx).await;
+
+    // No keystroke: the command palette's way in. This view's recording starts and waits.
+    vcx.dispatch_action(ToggleRecording);
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 0, 0));
+
+    // The chord in the other window: the machine takes it for a repeat of the held press.
+    press(&mut other_vcx);
+    other_vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (1, 0, 0));
+
+    // Shift alone in this window holds none of that chord's modifiers. Had this view recorded the
+    // other window's chord as its own, this would be its release, and end the recording.
+    std::thread::sleep(PAST_THE_TAP_WINDOW);
+    vcx.simulate_modifiers_change(Modifiers::shift());
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "a chord pressed in another window is not this view's to release"
+    );
+}
diff --git a/crates/agent_ui/src/voice_keys_tests.rs b/crates/agent_ui/src/voice_keys_tests.rs
new file mode 100644
index 0000000..b063f1d
--- /dev/null
+++ b/crates/agent_ui/src/voice_keys_tests.rs
@@ -0,0 +1,475 @@
+// Story 044, task 5.3 — shortcut press, release, Escape and focus loss in the composer (R1.2, R2.2,
+// R2.3, R2.5, R3.2, R3.3; design.md C2, C3). Wired in the crate root `src/agent_ui.rs` as
+//
+//     #[cfg(test)]
+//     mod voice_keys_tests;
+//
+// Validation filter: `voice_keys` (every test path is `voice_keys_tests::…`). The harness below is
+// `pub(crate)` because `voice_events_tests` reuses it.
+//
+// Contract: design.md C3 (the two bindings in all four keymaps), C2 (`ToggleRecording` → ShortcutDown,
+// key-up of the binding's non-modifier key → ShortcutUp, `CancelRecording` → Cancel, window
+// deactivation → WindowDeactivated, `voice_recording` key context while recording).
+// Assumed voice_input seams (see voice_input/src/entity_tests.rs): `voice_input::init_in(http,
+// models_dir, capture, cx)`, `voice_input::capture::{CaptureBackend, ActiveCapture, CaptureEvent,
+// Recording, Ended}`. The thread view is built like `conversation_view::tests::
+// setup_conversation_view` (private there), as the root of its own window; on the series tip, copy
+// its current `ConversationView::new` arguments if they moved. Remote mode on a loopback URL, so no
+// consent strip and no model are involved; the microphone is always the fake.
+//
+// Hostile halves: key-down repeats while held are ignored AND a fresh press after the release stops
+// the toggle; the release of an unrelated key does not count AND the release of `v` with whatever
+// modifiers are still down does; Escape cancels while recording AND is not claimed while idle (the
+// binding is only live under `voice_recording`); focus loss stops a held recording AND leaves a
+// toggle running; the shortcut does nothing when the setting is off.
+
+use std::{
+    path::PathBuf,
+    rc::Rc,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+
+use agent::ThreadStore;
+use fs::FakeFs;
+use gpui::{
+    AnyWindowHandle, AppContext as _, Entity, KeyUpEvent, Keystroke, TestAppContext,
+    UpdateGlobal as _, VisualContext as _, VisualTestContext,
+};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use project::Project;
+use settings::SettingsStore;
+use voice_input::capture::{ActiveCapture, CaptureBackend, CaptureEventSender, Ended, Recording};
+use voice_input::{CancelRecording, ToggleRecording};
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::agent_connection_store::AgentConnectionStore;
+use crate::conversation_view::ConversationView;
+use crate::conversation_view::thread_view::ThreadView;
+use crate::message_editor::MessageEditor;
+use crate::test_support::{StubAgentServer, init_test};
+use crate::{Agent, AgentThreadSource};
+
+// ── shared harness ──────────────────────────────────────────────────────────
+
+#[derive(Default)]
+pub(crate) struct FakeMic {
+    pub starts: AtomicUsize,
+    pub stops: AtomicUsize,
+    pub cancels: AtomicUsize,
+    pub events: Mutex<Option<CaptureEventSender>>,
+}
+
+struct Backend(Arc<FakeMic>);
+struct Active(Arc<FakeMic>);
+
+impl CaptureBackend for Backend {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        events: CaptureEventSender,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        self.0.starts.fetch_add(1, Ordering::SeqCst);
+        *self.0.events.lock().expect("lock") = Some(events);
+        Ok(Box::new(Active(self.0.clone())))
+    }
+}
+
+impl ActiveCapture for Active {
+    fn stop(self: Box<Self>) -> Recording {
+        self.0.stops.fetch_add(1, Ordering::SeqCst);
+        let samples = (0..48_000).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: 48_000,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {
+        self.0.cancels.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+pub(crate) const REMOTE_SETTINGS: &str = r#"{ "voice_input": { "remote": { "enabled": true,
+    "url": "http://127.0.0.1:9/v1/audio/transcriptions", "api_key_env": "ZEO_VOICE_TEST_UNSET_044_9F3C" } } }"#;
+
+pub(crate) struct Voice {
+    pub mic: Arc<FakeMic>,
+    pub _models: tempfile::TempDir,
+}
+
+/// init_test + the default Linux keymap + user settings + `voice_input::init_in` with fakes +
+/// `agent_ui::init`'s voice notices.
+pub(crate) fn init_voice(
+    settings_json: &str,
+    http: Arc<dyn HttpClient>,
+    cx: &mut TestAppContext,
+) -> Voice {
+    init_test(cx);
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(settings_json, cx)
+                .result()
+                .expect("settings parse");
+        });
+        let bindings = settings::KeymapFile::load_asset_allow_partial_failure(
+            "keymaps/default-linux.json",
+            cx,
+        )
+        .expect("the default keymap loads");
+        cx.bind_keys(bindings);
+    });
+    let mic = Arc::new(FakeMic::default());
+    let models = tempfile::tempdir().expect("tempdir");
+    let backend: Arc<dyn CaptureBackend> = Arc::new(Backend(mic.clone()));
+    let dir: PathBuf = models.path().join("voice").join("models");
+    cx.update(|cx| {
+        voice_input::init_in(http, dir, backend, cx);
+        // What `agent_ui::init` adds for voice input, in production's order (after the entity).
+        crate::voice_notice::init(cx);
+    });
+    Voice {
+        mic,
+        _models: models,
+    }
+}
+
+pub(crate) fn answering(text_json: &'static str) -> Arc<dyn HttpClient> {
+    FakeHttpClient::create(move |_req| async move {
+        Ok(Response::builder()
+            .status(200)
+            .body(AsyncBody::from(text_json))?)
+    })
+}
+
+pub(crate) struct Thread {
+    pub window: AnyWindowHandle,
+    pub conversation: Entity<ConversationView>,
+    pub workspace: Entity<Workspace>,
+}
+
+impl Thread {
+    pub fn view(&self, cx: &TestAppContext) -> Entity<ThreadView> {
+        cx.read(|cx| {
+            self.conversation
+                .read(cx)
+                .active_thread()
+                .expect("an active thread")
+                .clone()
+        })
+    }
+    pub fn editor(&self, cx: &TestAppContext) -> Entity<MessageEditor> {
+        let view = self.view(cx);
+        cx.read(|cx| view.read(cx).message_editor.clone())
+    }
+    pub fn vcx(&self, cx: &mut TestAppContext) -> VisualTestContext {
+        VisualTestContext::from_window(self.window, cx)
+    }
+}
+
+/// A thread view as the root of its own window, sharing one workspace window per call.
+pub(crate) async fn open_thread(cx: &mut TestAppContext) -> Thread {
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let mw = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = mw
+        .read_with(cx, |mw, _| mw.workspace().clone())
+        .expect("workspace");
+    let thread_store = cx.new(|cx| ThreadStore::new(cx));
+    let connection_store = cx.new(|cx| AgentConnectionStore::new(project.clone(), cx));
+    let window = cx.add_window(|window, cx| {
+        ConversationView::new(
+            Rc::new(StubAgentServer::default_response()),
+            connection_store,
+            Agent::Custom { id: "Test".into() },
+            None,
+            None,
+            None,
+            None,
+            None,
+            workspace.downgrade(),
+            project,
+            Some(thread_store),
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        )
+    });
+    let conversation = window.root(cx).expect("root view");
+    cx.run_until_parked();
+    Thread {
+        window: window.into(),
+        conversation,
+        workspace,
+    }
+}
+
+pub(crate) async fn focused_thread(cx: &mut TestAppContext) -> (Thread, VisualTestContext) {
+    let thread = open_thread(cx).await;
+    let editor = thread.editor(cx);
+    let mut vcx = thread.vcx(cx);
+    // A focused composer sits in the active window; the test platform activates none by itself.
+    vcx.update(|window, _| window.activate_window());
+    vcx.focus(&editor);
+    vcx.run_until_parked();
+    (thread, vcx)
+}
+
+pub(crate) fn press(vcx: &mut VisualTestContext) {
+    vcx.simulate_keystrokes("ctrl-alt-v"); // key-down only: the key stays "held"
+}
+
+pub(crate) fn release(vcx: &mut VisualTestContext, keystroke: &'static str) {
+    vcx.simulate_event(KeyUpEvent {
+        keystroke: Keystroke::parse(keystroke).expect("keystroke"),
+    });
+}
+
+pub(crate) fn counts(mic: &FakeMic) -> (usize, usize, usize) {
+    (
+        mic.starts.load(Ordering::SeqCst),
+        mic.stops.load(Ordering::SeqCst),
+        mic.cancels.load(Ordering::SeqCst),
+    )
+}
+
+// ── keymaps (C3; also 6.1's "every action name resolves") ───────────────────
+
+const KEYMAPS: [(&str, &str, &str); 4] = [
+    (
+        "keymaps/default-linux.json",
+        include_str!("../../../assets/keymaps/default-linux.json"),
+        "ctrl-alt-v",
+    ),
+    (
+        "keymaps/default-windows.json",
+        include_str!("../../../assets/keymaps/default-windows.json"),
+        "ctrl-alt-v",
+    ),
+    (
+        "keymaps/default-macos.json",
+        include_str!("../../../assets/keymaps/default-macos.json"),
+        "cmd-alt-v",
+    ),
+    (
+        "keymaps/vim.json",
+        include_str!("../../../assets/keymaps/vim.json"),
+        "",
+    ),
+];
+
+fn sections(content: &str) -> Vec<serde_json::Value> {
+    settings::parse_json_with_comments::<Vec<serde_json::Value>>(content).expect("keymap JSON")
+}
+
+fn bound(content: &str, action: &str) -> Vec<(String, String)> {
+    let mut found = Vec::new();
+    for section in sections(content) {
+        let context = section
+            .get("context")
+            .and_then(|c| c.as_str())
+            .unwrap_or("")
+            .to_string();
+        if let Some(bindings) = section.get("bindings").and_then(|b| b.as_object()) {
+            for (keys, value) in bindings {
+                if value.as_str() == Some(action) {
+                    found.push((context.clone(), keys.clone()));
+                }
+            }
+        }
+    }
+    found
+}
+
+#[test]
+fn voice_keys_all_four_keymaps_bind_toggle_in_acp_thread() {
+    for (name, content, key) in KEYMAPS {
+        let found = bound(content, "voice_input::ToggleRecording");
+        assert!(
+            found.iter().any(|(ctx, keys)| ctx.contains("AcpThread")
+                && (keys == key
+                    || (key.is_empty() && (keys == "ctrl-alt-v" || keys == "cmd-alt-v")))),
+            "{name}: ToggleRecording on {key:?} in AcpThread, found {found:?}"
+        );
+    }
+}
+
+#[test]
+fn voice_keys_escape_cancels_only_under_voice_recording() {
+    for (name, content, _) in KEYMAPS {
+        let found = bound(content, "voice_input::CancelRecording");
+        assert!(
+            found
+                .iter()
+                .any(|(ctx, keys)| keys == "escape" && ctx.contains("voice_recording")),
+            "{name}: escape → CancelRecording under voice_recording, found {found:?}"
+        );
+        assert!(
+            found.iter().all(|(ctx, _)| ctx.contains("voice_recording")),
+            "{name}: never an unconditional Escape: {found:?}"
+        );
+    }
+}
+
+#[gpui::test]
+fn voice_keys_action_names_resolve_in_every_keymap(cx: &mut TestAppContext) {
+    init_test(cx);
+    for (name, _, _) in KEYMAPS {
+        let names: Vec<String> = cx.update(|cx| {
+            settings::KeymapFile::load_asset_allow_partial_failure(name, cx)
+                .expect("loads")
+                .iter()
+                .map(|b| b.action().name().to_string())
+                .collect()
+        });
+        for action in [
+            "voice_input::ToggleRecording",
+            "voice_input::CancelRecording",
+        ] {
+            assert!(
+                names.iter().any(|n| n == action),
+                "{name}: {action} resolves to an action"
+            );
+        }
+    }
+}
+
+// ── key handling in a real thread view ──────────────────────────────────────
+
+#[gpui::test]
+async fn voice_keys_tap_toggles_and_the_next_press_stops(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R2.2 a tap keeps recording after the release"
+    );
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic).1,
+        1,
+        "R2.3 a fresh press stops the toggle"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_repeats_while_held_are_ignored(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    for _ in 0..4 {
+        press(&mut vcx);
+    }
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "R3.2 one start, no stop from repeats"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_unrelated_key_up_does_not_release_the_shortcut(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "x");
+    press(&mut vcx); // still held as far as the machine knows: a repeat
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "an unrelated key-up is not the shortcut's release"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_release_of_v_counts_whatever_modifiers_remain(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "alt-v"); // ctrl let go first; X11 sends no key-up for the modifier itself
+    press(&mut vcx);
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic).1,
+        1,
+        "the release was seen, so the next press stops the toggle"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_escape_cancels_while_recording_and_is_free_while_idle(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    let idle_bindings = vcx.update(|window, _| window.bindings_for_action(&CancelRecording).len());
+    assert_eq!(
+        idle_bindings, 0,
+        "Escape is not claimed while idle (no voice_recording context)"
+    );
+
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    let live = vcx.update(|window, _| window.bindings_for_action(&CancelRecording).len());
+    assert!(
+        live > 0,
+        "voice_recording is in the composer's key context while recording"
+    );
+    vcx.simulate_keystrokes("escape");
+    vcx.run_until_parked();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 1),
+        "R2.5 cancelled, not stopped: nothing is transcribed"
+    );
+    let after = vcx.update(|window, _| window.bindings_for_action(&CancelRecording).len());
+    assert_eq!(after, 0, "the context is gone after the cancel");
+}
+
+#[gpui::test]
+async fn voice_keys_focus_loss_stops_a_hold_but_not_a_toggle(cx: &mut TestAppContext) {
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx); // held, not released
+    vcx.deactivate_window();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 1, 0),
+        "R3.3 a held recording stops and is transcribed"
+    );
+
+    let voice = init_voice(REMOTE_SETTINGS, answering(r#"{"text":"ok"}"#), cx);
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.deactivate_window();
+    assert_eq!(
+        counts(&voice.mic),
+        (1, 0, 0),
+        "a toggle keeps recording without focus"
+    );
+}
+
+#[gpui::test]
+async fn voice_keys_shortcut_does_nothing_when_disabled(cx: &mut TestAppContext) {
+    let voice = init_voice(
+        r#"{ "voice_input": { "enabled": false } }"#,
+        answering("{}"),
+        cx,
+    );
+    let (_thread, mut vcx) = focused_thread(cx).await;
+    press(&mut vcx);
+    release(&mut vcx, "ctrl-alt-v");
+    vcx.run_until_parked();
+    assert_eq!(counts(&voice.mic), (0, 0, 0), "R1.2 the shortcut is inert");
+    let _ = ToggleRecording; // the action type exists even when disabled
+}
diff --git a/crates/agent_ui/src/voice_notice.rs b/crates/agent_ui/src/voice_notice.rs
new file mode 100644
index 0000000..277a0f4
--- /dev/null
+++ b/crates/agent_ui/src/voice_notice.rs
@@ -0,0 +1,107 @@
+//! What voice input tells the user, as workspace toasts (design.md C1.10, C2; R4.7, R5.1).
+//!
+//! A composer's own notices go to its thread view's workspace; a transcript whose composer was
+//! closed has no view left to show it, so `agent_ui::init` turns it into a toast in the active
+//! workspace instead.
+
+use std::borrow::Cow;
+
+use gpui::{App, Entity, EntityId, Global, Subscription, WeakEntity};
+use voice_input::{VoiceEvent, VoiceInput};
+use workspace::{MultiWorkspace, Toast, Workspace, notifications::NotificationId};
+
+/// The notice for a transcript that arrived after its composer was closed (R4.7).
+pub const DISCARDED: &str = "Transcript discarded: the thread was closed";
+
+/// Every voice notice shares one id, so a newer notice replaces the previous one in a workspace
+/// instead of stacking under it.
+struct VoiceToast;
+
+/// Shows `message` as a toast in `workspace`. A workspace closed under a pending notice loses
+/// only that notice, so it is logged as degraded (never with the message, which may quote a
+/// transcription error), not as an error.
+pub fn show_toast(
+    workspace: &WeakEntity<Workspace>,
+    message: impl Into<Cow<'static, str>>,
+    cx: &mut App,
+) {
+    let shown = workspace.update(cx, |workspace, cx| {
+        workspace.show_toast(
+            Toast::new(NotificationId::unique::<VoiceToast>(), message),
+            cx,
+        )
+    });
+    if shown.is_err() {
+        log::warn!("voice_input event=notice_dropped reason=workspace_released");
+    }
+}
+
+/// Subscribes once, app-wide, to the voice input entity and turns `Discarded` into a toast in the
+/// active workspace (R4.7). Covers both orders: an entity that already exists, and one created
+/// later (a re-initialisation creates a new entity).
+pub fn init(cx: &mut App) {
+    if let Some(voice) = VoiceInput::try_global(cx) {
+        watch(&voice, cx);
+    }
+    cx.observe_new(|_: &mut VoiceInput, _, cx| {
+        let voice = cx.entity();
+        watch(&voice, cx);
+    })
+    .detach();
+}
+
+/// The one app-wide subscription, to the current voice input entity.
+struct DiscardNotices {
+    voice: EntityId,
+    _subscription: Subscription,
+}
+
+impl Global for DiscardNotices {}
+
+/// An entity created in the same update as `init` is seen by both of its paths; the second
+/// subscription would show every notice twice.
+fn watch(voice: &Entity<VoiceInput>, cx: &mut App) {
+    let voice_id = voice.entity_id();
+    if cx
+        .try_global::<DiscardNotices>()
+        .is_some_and(|notices| notices.voice == voice_id)
+    {
+        return;
+    }
+    let subscription = cx.subscribe(voice, |_, event, cx| on_voice_event(event, cx));
+    cx.set_global(DiscardNotices {
+        voice: voice_id,
+        _subscription: subscription,
+    });
+}
+
+fn on_voice_event(event: &VoiceEvent, cx: &mut App) {
+    if let VoiceEvent::Discarded { owner } = event {
+        notify_discarded(*owner, cx);
+    }
+}
+
+fn notify_discarded(owner: EntityId, cx: &mut App) {
+    match active_workspace(cx) {
+        Some(workspace) => show_toast(&workspace.downgrade(), DISCARDED, cx),
+        None => log::warn!(
+            "voice_input event=discard_notice_dropped owner={} reason=no_workspace",
+            owner.as_u64()
+        ),
+    }
+}
+
+/// The workspace of the active window; when the active window holds no workspace (or there is
+/// none), the frontmost window that does.
+fn active_workspace(cx: &App) -> Option<Entity<Workspace>> {
+    let stack = cx.window_stack().unwrap_or_default();
+    cx.active_window()
+        .into_iter()
+        .chain(stack)
+        .chain(cx.windows())
+        .find_map(|window| {
+            let multi_workspace = window.downcast::<MultiWorkspace>()?;
+            let multi_workspace = multi_workspace.read(cx).ok()?;
+            Some(multi_workspace.workspace().clone())
+        })
+}
diff --git a/crates/agent_ui/src/voice_refused_log_tests.rs b/crates/agent_ui/src/voice_refused_log_tests.rs
new file mode 100644
index 0000000..e91c83e
--- /dev/null
+++ b/crates/agent_ui/src/voice_refused_log_tests.rs
@@ -0,0 +1,194 @@
+// Story 044, task 8.7 (refine v3) — a transcript refused by a read-only composer is logged as
+// refused (R4.7, R10.1, R10.3; design.md C2 "v3, refused insert"). Wired in the crate root
+// `src/agent_ui.rs` beside `voice_keys_tests`, whose harness it reuses:
+//
+//     #[cfg(test)]
+//     mod voice_refused_log_tests;
+//
+// Validation filter: `voice_refused_log` (every test path is `voice_refused_log_tests::…`).
+//
+// Contract: when `MessageEditor::insert_transcript` refuses (the composer turned read-only while
+// the transcript was on its way), the thread view shows its toast as before and calls
+// `VoiceInput::report_insert_refused(owner)`, so the recording's R10.1 line says
+// `outcome=refused`; a writable composer's line says `outcome=inserted`.
+//
+// The line is read through a process-wide logger. CAUTION for full-suite runs: this binary
+// already installs one in `conversation_view/thread_view.rs` (`FileLinkWarningCapture`, which
+// panics when another is set). The two never meet under the story's filters (`voice`,
+// `voice_refused_log`), but a full `cargo test -p agent_ui` runs both in one process; whichever
+// installs second fails. The executor must reconcile them (one shared capture, or nextest).
+//
+// Hostile halves, the wrong collapse first: a refused insert is not logged as inserted, and the
+// refusal still shows its toast and leaves the composer's text as it was; then the wrong split: a
+// writable composer's transcript is still logged as inserted; then the plain case.
+
+use std::sync::{Mutex, OnceLock};
+use std::thread::ThreadId;
+use std::time::{Duration, Instant};
+
+use gpui::TestAppContext;
+use voice_input::state::{Input, Owner};
+use voice_input::{ViewState, VoiceInput};
+
+use crate::voice_keys_tests::{REMOTE_SETTINGS, Thread, answering, init_voice, open_thread};
+
+const TRANSCRIPT: &str = "Dictated private words";
+
+struct Capture(Mutex<Vec<(ThreadId, String)>>);
+
+impl log::Log for Capture {
+    fn enabled(&self, _: &log::Metadata) -> bool {
+        true
+    }
+    fn log(&self, record: &log::Record) {
+        self.0
+            .lock()
+            .expect("lock")
+            .push((std::thread::current().id(), record.args().to_string()));
+    }
+    fn flush(&self) {}
+}
+
+fn capture() -> &'static Capture {
+    static CAPTURE: OnceLock<&'static Capture> = OnceLock::new();
+    CAPTURE.get_or_init(|| {
+        let capture: &'static Capture = Box::leak(Box::new(Capture(Mutex::new(Vec::new()))));
+        log::set_logger(capture).expect(
+            "another logger owns this test binary (thread_view.rs FileLinkWarningCapture): \
+             run with `cargo test -p agent_ui voice_refused_log`",
+        );
+        log::set_max_level(log::LevelFilter::Trace);
+        capture
+    })
+}
+
+fn recording_lines(capture: &Capture) -> Vec<String> {
+    let me = std::thread::current().id();
+    capture
+        .0
+        .lock()
+        .expect("lock")
+        .iter()
+        .filter(|(thread, line)| *thread == me && line.starts_with("voice_input event=recording "))
+        .map(|(_, line)| line.clone())
+        .collect()
+}
+
+fn outcome(line: &str) -> Option<&str> {
+    line.split(' ')
+        .find_map(|field| field.strip_prefix("outcome="))
+}
+
+fn text_of(thread: &Thread, cx: &mut TestAppContext) -> String {
+    let editor = thread.editor(cx);
+    cx.read(|cx| editor.read(cx).text(cx))
+}
+
+fn notifications(thread: &Thread, cx: &mut TestAppContext) -> usize {
+    thread
+        .workspace
+        .read_with(cx, |w, _| w.notification_ids().len())
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+/// Starts a toggle recording in `thread`'s composer; `before_stop` runs while it records.
+fn record(
+    thread: &Thread,
+    cx: &mut TestAppContext,
+    before_stop: impl FnOnce(&Thread, &mut TestAppContext),
+) {
+    let id = thread.view(cx).entity_id();
+    let owner = Owner(id.as_u64());
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    vi.update(cx, |vi, cx| vi.handle(Input::Click { owner }, cx));
+    wait_until(cx, "recording", |cx| {
+        matches!(
+            vi.read_with(cx, |vi, _| vi.view_state(id)),
+            ViewState::Recording { .. }
+        )
+    });
+    before_stop(thread, cx);
+    vi.update(cx, |vi, cx| vi.handle(Input::Click { owner }, cx));
+}
+
+#[gpui::test]
+async fn voice_refused_log_read_only_composer_logs_refused_and_shows_the_toast(
+    cx: &mut TestAppContext,
+) {
+    let capture = capture();
+    let answer: &'static str = Box::leak(format!(r#"{{"text": "{TRANSCRIPT}"}}"#).into_boxed_str());
+    let _voice = init_voice(REMOTE_SETTINGS, answering(answer), cx);
+    let thread = open_thread(cx).await;
+    let toasts_before = notifications(&thread, cx);
+
+    // Writable when the recording starts (a read-only composer starts nothing, R1.3), read-only
+    // by the time its transcript arrives.
+    record(&thread, cx, |thread, cx| {
+        let editor = thread.editor(cx);
+        editor.update(cx, |editor, cx| editor.set_read_only(true, cx));
+    });
+    wait_until(cx, "the refusal toast", |cx| {
+        notifications(&thread, cx) > toasts_before
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        text_of(&thread, cx),
+        "",
+        "R4.1 nothing inserted into a read-only composer"
+    );
+    assert_eq!(
+        notifications(&thread, cx),
+        toasts_before + 1,
+        "the refusal is shown, once"
+    );
+    let lines = recording_lines(capture);
+    assert_eq!(
+        lines.len(),
+        1,
+        "R10.1 one line for the recording: {lines:?}"
+    );
+    assert_eq!(
+        outcome(&lines[0]),
+        Some("refused"),
+        "R10.1 a refused insert is logged as refused, not inserted: {lines:?}"
+    );
+    assert!(
+        !lines[0].contains("Dictated") && !lines[0].contains("private"),
+        "R10.3 no transcript in the line: {}",
+        lines[0]
+    );
+}
+
+#[gpui::test]
+async fn voice_refused_log_writable_composer_logs_inserted(cx: &mut TestAppContext) {
+    let capture = capture();
+    let answer: &'static str = Box::leak(format!(r#"{{"text": "{TRANSCRIPT}"}}"#).into_boxed_str());
+    let _voice = init_voice(REMOTE_SETTINGS, answering(answer), cx);
+    let thread = open_thread(cx).await;
+
+    record(&thread, cx, |_, _| {});
+    wait_until(cx, "the transcript in the composer", |cx| {
+        !text_of(&thread, cx).is_empty()
+    });
+    cx.run_until_parked();
+
+    let lines = recording_lines(capture);
+    assert_eq!(lines.len(), 1, "{lines:?}");
+    assert_eq!(outcome(&lines[0]), Some("inserted"), "{lines:?}");
+}
