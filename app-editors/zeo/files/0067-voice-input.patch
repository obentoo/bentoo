diff --git a/crates/reqwest_client/src/reqwest_client_loopback_pin_tests.rs b/crates/reqwest_client/src/reqwest_client_loopback_pin_tests.rs
new file mode 100644
index 0000000..3f911e9
--- /dev/null
+++ b/crates/reqwest_client/src/reqwest_client_loopback_pin_tests.rs
@@ -0,0 +1,69 @@
+// Story 044, task 8.4 fix round 1 (tech review L1) — the proxy-less client resolves `localhost`
+// to the loopback addresses itself, so a plain-http request admitted as loopback never asks the
+// system resolver, which on some hosts sends `localhost` to DNS with a search domain appended.
+//
+// The built `reqwest::Client` does not show its DNS overrides (its `Debug` lists only request
+// settings), so the pin is read from the builder `without_proxy` builds from. That the URL's own
+// port is still used (the override's port 0) is checked by a request to a real loopback server.
+
+use std::io::{BufRead as _, BufReader, Write as _};
+use std::net::TcpListener;
+use std::sync::mpsc;
+use std::time::Duration;
+
+use http_client::{AsyncBody, HttpClient, Request as HttpRequest};
+use reqwest::header::HeaderValue;
+
+use crate::ReqwestClient;
+
+const USER_AGENT: &str = "Zeo-voice-test/0.0";
+
+#[test]
+fn without_proxy_loopback_pin_maps_localhost_to_both_loopback_addresses() {
+    let builder = format!(
+        "{:?}",
+        ReqwestClient::without_proxy_builder(&HeaderValue::from_static(USER_AGENT))
+    );
+    assert!(
+        builder.contains(r#"dns_overrides: {"localhost": [[::1]:0, 127.0.0.1:0]}"#),
+        "localhost is pinned to ::1 and 127.0.0.1, never resolved by the system: {builder}"
+    );
+}
+
+#[test]
+fn without_proxy_loopback_pin_keeps_the_port_the_url_names() {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+    let port = listener.local_addr().expect("address").port();
+    let (request_line_tx, request_line_rx) = mpsc::channel::<String>();
+    let server = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("accept");
+        let mut reader = BufReader::new(stream.try_clone().expect("clone"));
+        let mut request_line = String::new();
+        reader.read_line(&mut request_line).expect("read");
+        loop {
+            let mut line = String::new();
+            if reader.read_line(&mut line).expect("read") == 0 || line == "\r\n" {
+                break;
+            }
+        }
+        request_line_tx.send(request_line).ok();
+        stream
+            .write_all(b"HTTP/1.1 200 OK\r\ncontent-length: 0\r\nconnection: close\r\n\r\n")
+            .expect("write");
+    });
+
+    let client = ReqwestClient::without_proxy(USER_AGENT).expect("client");
+    let request = HttpRequest::get(format!("http://localhost:{port}/v1/audio/transcriptions"))
+        .body(AsyncBody::default())
+        .expect("request");
+    let response = futures::executor::block_on(client.send(request)).expect("sent");
+    assert!(response.status().is_success());
+    let request_line = request_line_rx
+        .recv_timeout(Duration::from_secs(5))
+        .expect("the server on 127.0.0.1 at the URL's port got the request");
+    server.join().expect("server");
+    assert!(
+        request_line.starts_with("GET /v1/audio/transcriptions"),
+        "{request_line:?}"
+    );
+}
diff --git a/crates/reqwest_client/src/reqwest_client_without_proxy_tests.rs b/crates/reqwest_client/src/reqwest_client_without_proxy_tests.rs
