+    h.send(Input::Cancel { owner: o(a) }, cx);
+    cx.run_until_parked();
+    assert_eq!(h.capture.cancels.load(Ordering::SeqCst), 1, "R2.5");
+    assert_eq!(h.capture.stops.load(Ordering::SeqCst), 0);
+    assert!(h.requests().is_empty() && h.inserts().is_empty());
+}
+
+// ── R10.1 / R10.3: one recording line, nothing private in it ────────────────
+
+mod log_capture {
+    use std::sync::{Mutex, OnceLock};
+    use std::thread::ThreadId;
+
+    pub struct Capture(pub Mutex<Vec<(ThreadId, String)>>);
+    impl log::Log for Capture {
+        fn enabled(&self, _: &log::Metadata) -> bool {
+            true
+        }
+        fn log(&self, r: &log::Record) {
+            self.0
+                .lock()
+                .expect("lock")
+                .push((std::thread::current().id(), r.args().to_string()));
+        }
+        fn flush(&self) {}
+    }
+    pub fn install() -> &'static Capture {
+        static C: OnceLock<&'static Capture> = OnceLock::new();
+        C.get_or_init(|| {
+            let c: &'static Capture = Box::leak(Box::new(Capture(Mutex::new(Vec::new()))));
+            log::set_logger(c)
+                .expect("no other logger is installed in the voice_input test binary");
+            log::set_max_level(log::LevelFilter::Trace);
+            c
+        })
+    }
+    pub fn mine(c: &Capture) -> Vec<String> {
+        let me = std::thread::current().id();
+        c.0.lock()
+            .expect("lock")
+            .iter()
+            .filter(|(t, _)| *t == me)
+            .map(|(_, l)| l.clone())
+            .collect()
+    }
+}
+
+#[gpui::test]
+async fn entity_logs_one_recording_line_without_private_fields(cx: &mut TestAppContext) {
+    let capture = log_capture::install();
+    let settings = r#"{ "voice_input": { "remote": { "enabled": true,
+        "url": "http://127.0.0.1:9/v1/t?token=QUERYSECRET", "api_key_env": "ZEO_VOICE_TEST_UNSET_044_9F3C" } } }"#;
+    let h = setup(
+        settings,
+        http(200, r#"{"text": "Transcript words here"}"#),
+        cx,
+    );
+    record_and_stop(&h, h.owner(0), cx);
+    wait_until(cx, "the insert", |_| !h.inserts().is_empty());
+    let lines: Vec<String> = log_capture::mine(capture)
+        .into_iter()
+        .filter(|l| l.starts_with("voice_input "))
+        .collect();
+    let recording: Vec<&String> = lines
+        .iter()
+        .filter(|l| l.contains("mode=") && l.contains("backend="))
+        .collect();
+    assert_eq!(
+        recording.len(),
+        1,
+        "R10.1 one line per recording: {lines:?}"
+    );
+    let line = recording[0];
+    for key in [
+        "mode=toggle",
+        "backend=remote",
+        "outcome=",
+        "audio",
+        "transcribe",
+        "model=",
+    ] {
+        assert!(line.contains(key), "R10.1 {key}: {line}");
+    }
+    for line in &lines {
+        assert!(line.starts_with("voice_input event="), "Q14: {line}");
+        for leaked in ["Transcript words", "QUERYSECRET", "token="] {
+            assert!(!line.contains(leaked), "R10.3 {leaked:?} in {line}");
+        }
+    }
+}
diff --git a/crates/voice_input/src/local.rs b/crates/voice_input/src/local.rs
new file mode 100644
index 0000000..d9f1b39
--- /dev/null
+++ b/crates/voice_input/src/local.rs
@@ -0,0 +1,253 @@
+//! Local transcription with whisper.cpp. Runs on a background thread, never on the UI thread.
+
+use std::ffi::c_int;
+use std::fmt;
+use std::path::{Path, PathBuf};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use anyhow::Context as _;
+use whisper_rs::{
+    FullParams, SamplingStrategy, WhisperContext, WhisperContextParameters, WhisperState,
+};
+
+use crate::Language;
+use crate::download::model_name;
+use crate::models::VoiceModel;
+
+/// How long a loaded model stays in memory after its last use.
+const IDLE_RELEASE: Duration = Duration::from_secs(5 * 60);
+const MAX_THREADS: usize = 8;
+#[cfg(target_arch = "x86_64")]
+const X86_64_V3: &str = "x86-64-v3 (AVX2, FMA, F16C, BMI2)";
+
+#[derive(Debug)]
+pub enum LocalError {
+    /// whisper.cpp refused the model file; the caller deletes it so the next use downloads it again.
+    Unreadable {
+        model: VoiceModel,
+        path: PathBuf,
+        source: anyhow::Error,
+    },
+    Inference(anyhow::Error),
+}
+
+impl fmt::Display for LocalError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        // The model and the path are named by the source's context, so `{:#}` names them once.
+        match self {
+            Self::Unreadable { .. } => write!(
+                f,
+                "The speech model was unreadable; it will be downloaded again on the next use"
+            ),
+            Self::Inference(_) => write!(f, "Local transcription failed"),
+        }
+    }
+}
+
+impl std::error::Error for LocalError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Unreadable { source, .. } => Some(source.as_ref()),
+            Self::Inference(source) => Some(source.as_ref()),
+        }
+    }
+}
+
+/// Routes whisper.cpp's and ggml's own output, which they would otherwise write to stderr,
+/// through `log`. Idempotent.
+pub fn install_logging() {
+    whisper_rs::install_logging_hooks();
+}
+
+pub struct LocalTranscriber {
+    loaded: Option<Loaded>,
+    last_used: Instant,
+}
+
+struct Loaded {
+    model: VoiceModel,
+    context: WhisperContext,
+    /// Kept between calls: creating a state allocates the KV caches and compute buffers again
+    /// (and logs them). Dropped after a failed call, so the next one starts from a fresh state.
+    state: Option<WhisperState>,
+}
+
+impl Default for LocalTranscriber {
+    fn default() -> Self {
+        Self {
+            loaded: None,
+            last_used: Instant::now(),
+        }
+    }
+}
+
+impl LocalTranscriber {
+    /// Transcribes 16 kHz mono f32 samples in [-1, 1] with `model`, loading it from `path` when
+    /// a different model (or none) is loaded.
+    pub fn transcribe(
+        &mut self,
+        model: VoiceModel,
+        path: &Path,
+        language: &Language,
+        pcm16k: &[f32],
+    ) -> Result<String, LocalError> {
+        self.last_used = Instant::now();
+        let name = model_name(model);
+        let loaded = self.loaded_for(model, path)?;
+
+        let mut state = match loaded.state.take() {
+            Some(state) => state,
+            None => loaded
+                .context
+                .create_state()
+                .with_context(|| format!("creating a whisper state for speech model {name}"))
+                .map_err(LocalError::Inference)?,
+        };
+
+        let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+        params.set_print_special(false);
+        params.set_print_progress(false);
+        params.set_print_realtime(false);
+        params.set_print_timestamps(false);
+        params.set_no_context(true);
+        params.set_suppress_blank(true);
+        params.set_suppress_nst(true);
+        params.set_n_threads(thread_count(
+            thread::available_parallelism().map_or(1, |count| count.get()),
+        ));
+        params.set_language(Some(language_param(language)));
+
+        state
+            .full(params, pcm16k)
+            .with_context(|| format!("transcribing with speech model {name}"))
+            .map_err(LocalError::Inference)?;
+
+        // Joined as bytes and decoded once: a multibyte character split across two segments
+        // would make each half invalid UTF-8 on its own.
+        let mut bytes = Vec::new();
+        for segment in state.as_iter() {
+            let segment_bytes = segment
+                .to_bytes()
+                .with_context(|| {
+                    format!(
+                        "reading segment {} of the transcript from speech model {name}",
+                        segment.segment_index()
+                    )
+                })
+                .map_err(LocalError::Inference)?;
+            bytes.extend_from_slice(segment_bytes);
+        }
+        let text = String::from_utf8_lossy(&bytes).into_owned();
+
+        loaded.state = Some(state);
+        self.last_used = Instant::now();
+        Ok(text)
+    }
+
+    /// Drops the loaded model once it has been unused for five minutes.
+    pub fn release_if_idle(&mut self, now: Instant) {
+        if now.saturating_duration_since(self.last_used) < IDLE_RELEASE {
+            return;
+        }
+        if let Some(loaded) = self.loaded.take() {
+            log::debug!(
+                "voice_input event=model_released model={}",
+                model_name(loaded.model)
+            );
+        }
+    }
+
+    fn loaded_for(&mut self, model: VoiceModel, path: &Path) -> Result<&mut Loaded, LocalError> {
+        Ok(match self.loaded.take() {
+            Some(loaded) if loaded.model == model => self.loaded.insert(loaded),
+            previous => {
+                // Free the previous model before loading the next, so two never sit in memory at once.
+                drop(previous);
+                self.loaded.insert(Loaded {
+                    model,
+                    context: load(model, path)?,
+                    state: None,
+                })
+            }
+        })
+    }
+}
+
+fn load(model: VoiceModel, path: &Path) -> Result<WhisperContext, LocalError> {
+    let started = Instant::now();
+    let name = model_name(model);
+    let context = WhisperContext::new_with_params(path, WhisperContextParameters::default())
+        .with_context(|| format!("loading speech model {name} from {}", path.display()))
+        .map_err(|source| LocalError::Unreadable {
+            model,
+            path: path.to_path_buf(),
+            source,
+        })?;
+    log::info!(
+        "voice_input event=model_loaded model={name} elapsed_ms={}",
+        started.elapsed().as_millis()
+    );
+    Ok(context)
+}
+
+/// Half the available cores (whisper.cpp gains little from hyper-threads), between 1 and 8.
+fn thread_count(available: usize) -> c_int {
+    let threads = (available / 2).clamp(1, MAX_THREADS);
+    c_int::try_from(threads).unwrap_or(1)
+}
+
+/// The configured language code when whisper knows it, `None` to let whisper detect it.
+///
+/// The settings parser admits any two lowercase letters, and whisper.cpp does not fail on a code
+/// it does not know: it decodes with a corrupt prompt. So an unknown code falls back to detection.
+pub fn known_language_code(language: &Language) -> Option<&str> {
+    let Language::Code(code) = language else {
+        return None;
+    };
+    // Scanning the table rather than calling `whisper_rs::get_lang_id`: whisper.cpp logs an
+    // unknown code verbatim at error level, and the configured value is never logged.
+    let known = (0..=whisper_rs::get_lang_max_id())
+        .filter_map(whisper_rs::get_lang_str)
+        .any(|known| known == code);
+    if known {
+        Some(code)
+    } else {
+        log::warn!("voice_input event=language_unknown");
+        None
+    }
+}
+
+/// What whisper is told to transcribe in: the configured code, or `"auto"` to detect it.
+pub fn language_param(language: &Language) -> &str {
+    known_language_code(language).unwrap_or("auto")
+}
+
+/// Refuses before whisper.cpp runs on a CPU lacking the instruction-set level it was compiled
+/// for, which would otherwise die with SIGILL. Only the portable build sets a baseline; a source
+/// build is compiled for the user's own `-march`.
+pub fn cpu_supported() -> Result<(), &'static str> {
+    if option_env!("ZEO_VOICE_CPU_BASELINE") == Some("x86-64-v3") {
+        return x86_64_v3_supported();
+    }
+    Ok(())
+}
+
+#[cfg(target_arch = "x86_64")]
+fn x86_64_v3_supported() -> Result<(), &'static str> {
+    if std::arch::is_x86_feature_detected!("avx2")
+        && std::arch::is_x86_feature_detected!("fma")
+        && std::arch::is_x86_feature_detected!("f16c")
+        && std::arch::is_x86_feature_detected!("bmi2")
+    {
+        Ok(())
+    } else {
+        Err(X86_64_V3)
+    }
+}
+
+// An x86-64 baseline means nothing to a build for another architecture.
+#[cfg(not(target_arch = "x86_64"))]
+fn x86_64_v3_supported() -> Result<(), &'static str> {
+    Ok(())
+}
