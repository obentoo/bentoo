@@ -0,0 +1,89 @@
+//! Audio preparation for speech-to-text: 16 kHz mono PCM, the silence gate and the WAV
+//! encoding sent to a remote server (R4.6, R8.2).
+
+use rodio::buffer::SamplesBuffer;
+use rodio::nz;
+use rodio::source::UniformSourceIterator;
+use std::num::NonZero;
+
+/// The sample rate whisper expects.
+const WHISPER_RATE: NonZero<u32> = nz!(16_000);
+/// Whisper takes one channel.
+const MONO: NonZero<u16> = nz!(1);
+/// 0.5 s at 16 kHz (R4.6).
+const MIN_SAMPLES: usize = 8_000;
+/// About -50 dBFS (R4.6).
+const MIN_RMS: f32 = 0.003;
+/// Size of the canonical RIFF/WAVE header with a 16-byte PCM `fmt ` chunk.
+const WAV_HEADER_LEN: usize = 44;
+
+/// Resamples mono `samples` recorded at `rate` Hz to 16 kHz mono, clamped to [-1, 1].
+/// A `rate` of 0 or an empty input returns an empty vector.
+pub fn to_whisper_pcm(samples: &[f32], rate: u32) -> Vec<f32> {
+    let Some(rate) = NonZero::new(rate) else {
+        return Vec::new();
+    };
+    if samples.is_empty() {
+        return Vec::new();
+    }
+    let source = SamplesBuffer::new(MONO, rate, samples.to_vec());
+    UniformSourceIterator::new(source, MONO, WHISPER_RATE)
+        .map(|sample| {
+            if sample.is_nan() {
+                0.0
+            } else {
+                sample.clamp(-1.0, 1.0)
+            }
+        })
+        .collect()
+}
+
+/// Root mean square level of `samples`; 0 for an empty slice.
+pub fn rms(samples: &[f32]) -> f32 {
+    if samples.is_empty() {
+        return 0.0;
+    }
+    let sum_of_squares: f64 = samples
+        .iter()
+        .map(|&sample| f64::from(sample) * f64::from(sample))
+        .sum();
+    (sum_of_squares / samples.len() as f64).sqrt() as f32
+}
+
+/// True when 16 kHz `pcm16k` is shorter than 0.5 s or quieter than RMS 0.003 (R4.6).
+pub fn speechless(pcm16k: &[f32]) -> bool {
+    pcm16k.len() < MIN_SAMPLES || rms(pcm16k) < MIN_RMS
+}
+
+/// Encodes 16 kHz mono `pcm16k` as a 16-bit PCM WAV file (R8.2).
+pub fn wav_pcm16(pcm16k: &[f32]) -> Vec<u8> {
+    const CHANNELS: u16 = MONO.get();
+    const BITS_PER_SAMPLE: u16 = 16;
+    const BLOCK_ALIGN: u16 = CHANNELS * BITS_PER_SAMPLE / 8;
+    const BYTE_RATE: u32 = WHISPER_RATE.get() * BLOCK_ALIGN as u32;
+
+    // A recording long enough to overflow these fields (37 hours) is far past the recording
+    // limit; saturate rather than panic.
+    let data_len = u32::try_from(pcm16k.len() * usize::from(BLOCK_ALIGN)).unwrap_or(u32::MAX);
+    let riff_len = data_len.saturating_add((WAV_HEADER_LEN - 8) as u32);
+
+    let mut wav = Vec::with_capacity(WAV_HEADER_LEN + pcm16k.len() * usize::from(BLOCK_ALIGN));
+    wav.extend_from_slice(b"RIFF");
+    wav.extend_from_slice(&riff_len.to_le_bytes());
+    wav.extend_from_slice(b"WAVE");
+    wav.extend_from_slice(b"fmt ");
+    wav.extend_from_slice(&16u32.to_le_bytes());
+    wav.extend_from_slice(&1u16.to_le_bytes());
+    wav.extend_from_slice(&CHANNELS.to_le_bytes());
+    wav.extend_from_slice(&WHISPER_RATE.get().to_le_bytes());
+    wav.extend_from_slice(&BYTE_RATE.to_le_bytes());
+    wav.extend_from_slice(&BLOCK_ALIGN.to_le_bytes());
+    wav.extend_from_slice(&BITS_PER_SAMPLE.to_le_bytes());
+    wav.extend_from_slice(b"data");
+    wav.extend_from_slice(&data_len.to_le_bytes());
+    for &sample in pcm16k {
+        let value = (sample.clamp(-1.0, 1.0) * f32::from(i16::MAX)).round() as i16;
+        wav.extend_from_slice(&value.to_le_bytes());
+    }
+    wav
+}
diff --git a/crates/voice_input/src/audio_prep_tests.rs b/crates/voice_input/src/audio_prep_tests.rs
new file mode 100644
index 0000000..8b272d1
--- /dev/null
+++ b/crates/voice_input/src/audio_prep_tests.rs
@@ -0,0 +1,139 @@
+// Story 044, task 2.2 — audio preparation (R4.6, R8.2). Wired in the crate root
+// `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod audio_prep_tests;
+//
+// Validation filter: `audio_prep` (every test path is `audio_prep_tests::…`).
+//
+// Contract (design.md C1.5): `to_whisper_pcm(&[f32], u32) -> Vec<f32>` (16 kHz mono, clamped to
+// [-1, 1]), `rms(&[f32]) -> f32`, `speechless(&[f32]) -> bool` (`len < 8_000 || rms < 0.003`),
+// `wav_pcm16(&[f32]) -> Vec<u8>` (RIFF/WAVE, PCM, 1 channel, 16 000 Hz, 16-bit).
+//
+// Hostile halves: 7 999 samples are speechless AND 8 000 are not; RMS 0.0029 is speechless AND
+// 0.0031 is not; 48 kHz input shrinks to a third AND 16 kHz input keeps its length (feeding 48 kHz
+// to whisper gives fluent nonsense, not an error); out-of-range samples clamp AND in-range ones pass.
+
+use crate::audio_prep::{rms, speechless, to_whisper_pcm, wav_pcm16};
+
+fn tone(len: usize, rate: u32, amplitude: f32) -> Vec<f32> {
+    (0..len)
+        .map(|i| amplitude * (2.0 * std::f32::consts::PI * 440.0 * i as f32 / rate as f32).sin())
+        .collect()
+}
+
+fn constant(len: usize, value: f32) -> Vec<f32> {
+    vec![value; len]
+}
+
+#[test]
+fn audio_prep_48k_resamples_to_a_third() {
+    let input = tone(48_000, 48_000, 0.5); // one second
+    let out = to_whisper_pcm(&input, 48_000);
+    let expected = 16_000i64;
+    assert!(
+        (out.len() as i64 - expected).abs() <= 16,
+        "len {} ≈ {expected}",
+        out.len()
+    );
+}
+
+#[test]
+fn audio_prep_16k_keeps_its_length() {
+    let input = tone(16_000, 16_000, 0.5);
+    let out = to_whisper_pcm(&input, 16_000);
+    assert!((out.len() as i64 - 16_000).abs() <= 4, "len {}", out.len());
+}
+
+#[test]
+fn audio_prep_44k1_resamples_proportionally() {
+    let out = to_whisper_pcm(&tone(44_100, 44_100, 0.5), 44_100);
+    assert!((out.len() as i64 - 16_000).abs() <= 16, "len {}", out.len());
+}
+
+#[test]
+fn audio_prep_clamps_out_of_range_samples() {
+    let out = to_whisper_pcm(&constant(16_000, 3.0), 16_000);
+    assert!(
+        out.iter().all(|s| (-1.0..=1.0).contains(s)),
+        "clamped to [-1, 1]"
+    );
+    let quiet = to_whisper_pcm(&constant(16_000, 0.25), 16_000);
+    let mid = quiet[quiet.len() / 2];
+    assert!(
+        (mid - 0.25).abs() < 0.01,
+        "in-range samples pass through: {mid}"
+    );
+}
+
+#[test]
+fn audio_prep_zero_rate_or_empty_input_is_empty() {
+    assert!(to_whisper_pcm(&[0.1, 0.2], 0).is_empty());
+    assert!(to_whisper_pcm(&[], 48_000).is_empty());
+}
+
+#[test]
+fn audio_prep_rms_of_known_signals() {
+    assert_eq!(rms(&[]), 0.0);
+    assert!((rms(&constant(100, 0.5)) - 0.5).abs() < 1e-6);
+    assert!(
+        (rms(&constant(100, -0.5)) - 0.5).abs() < 1e-6,
+        "sign does not matter"
+    );
+    let sine = tone(16_000, 16_000, 1.0);
+    assert!((rms(&sine) - std::f32::consts::FRAC_1_SQRT_2).abs() < 0.01);
+}
+
+#[test]
+fn audio_prep_half_second_gate() {
+    assert!(speechless(&constant(7_999, 0.1)), "R4.6 under 0.5 s");
+    assert!(
+        !speechless(&constant(8_000, 0.1)),
+        "exactly 0.5 s is enough"
+    );
+}
+
+#[test]
+fn audio_prep_minus_50_dbfs_gate() {
+    assert!(speechless(&constant(16_000, 0.0029)), "R4.6 below 0.003");
+    assert!(!speechless(&constant(16_000, 0.0031)), "above 0.003");
+    assert!(speechless(&constant(16_000, 0.0)), "silence");
+}
+
+#[test]
+fn audio_prep_wav_header_bytes() {
+    let pcm = [0.0f32, 1.0, -1.0, 0.5];
+    let wav = wav_pcm16(&pcm);
+    assert_eq!(wav.len(), 44 + pcm.len() * 2);
+    let u32_at = |i: usize| u32::from_le_bytes(wav[i..i + 4].try_into().expect("4 bytes"));
+    let u16_at = |i: usize| u16::from_le_bytes(wav[i..i + 2].try_into().expect("2 bytes"));
+    assert_eq!(&wav[0..4], b"RIFF");
+    assert_eq!(u32_at(4) as usize, wav.len() - 8, "RIFF chunk size");
+    assert_eq!(&wav[8..12], b"WAVE");
+    assert_eq!(&wav[12..16], b"fmt ");
+    assert_eq!(u32_at(16), 16, "PCM fmt chunk size");
+    assert_eq!(u16_at(20), 1, "PCM");
+    assert_eq!(u16_at(22), 1, "mono");
+    assert_eq!(u32_at(24), 16_000, "16 kHz");
+    assert_eq!(u32_at(28), 32_000, "byte rate");
+    assert_eq!(u16_at(32), 2, "block align");
+    assert_eq!(u16_at(34), 16, "16-bit");
+    assert_eq!(&wav[36..40], b"data");
+    assert_eq!(u32_at(40) as usize, pcm.len() * 2);
+    let sample = |n: usize| i16::from_le_bytes(wav[44 + 2 * n..46 + 2 * n].try_into().expect("2"));
+    assert_eq!(sample(0), 0);
+    assert!(sample(1) >= 32_766, "full scale positive: {}", sample(1));
+    assert!(sample(2) <= -32_767, "full scale negative: {}", sample(2));
+    assert!(
+        (sample(3) as i32 - 16_384).abs() <= 1,
+        "half scale: {}",
+        sample(3)
+    );
+}
+
+#[test]
+fn audio_prep_wav_of_nothing_is_a_bare_header() {
+    let wav = wav_pcm16(&[]);
+    assert_eq!(wav.len(), 44);
+    assert_eq!(&wav[36..40], b"data");
+}
diff --git a/crates/voice_input/src/capture.rs b/crates/voice_input/src/capture.rs
new file mode 100644
index 0000000..4ad6af4
--- /dev/null
+++ b/crates/voice_input/src/capture.rs
@@ -0,0 +1,562 @@
+//! Microphone capture on a dedicated thread.
+//!
+//! cpal's `Stream` is `!Send`, so it is created, played and dropped on the `voice-capture`
+//! thread; only samples (through a shared buffer) and [`CaptureEvent`]s leave that thread.
+//! `audio::open_input_stream` is deliberately not used: rodio's `Microphone` iterator blocks
+//! and has no error callback, so a stalled device would hang the reader and hide the failure.
+
+use std::{
+    sync::{
+        Arc, Mutex, PoisonError,
+        atomic::{AtomicBool, AtomicU8, Ordering},
+        mpsc,
+    },
+    thread::JoinHandle,
+    time::Duration,
+};
+
+use anyhow::{Context as _, Result, anyhow};
+use cpal::{
+    DeviceId, ErrorKind, SampleFormat, SizedSample, StreamConfig,
+    traits::{DeviceTrait as _, StreamTrait as _},
+};
+
+/// The longest recording kept, in seconds (R2.6).
+const MAX_SECONDS: usize = 120;
+
+/// How long `start` waits for the device to open before giving up (R9.1).
+const OPEN_TIMEOUT: Duration = Duration::from_secs(10);
+
+const THREAD_NAME: &str = "voice-capture";
+
+/// Whether a `voice-capture` thread is alive. A thread whose open timed out is detached, not
+/// joined, and may still hold cpal's process-wide ALSA lock: no second thread is started until it
+/// has exited.
+static CAPTURE_THREAD_LIVE: AtomicBool = AtomicBool::new(false);
+
+/// Clears [`CAPTURE_THREAD_LIVE`] when the capture thread exits, however it exits.
+struct LiveGuard;
+
+impl Drop for LiveGuard {
+    fn drop(&mut self) {
+        CAPTURE_THREAD_LIVE.store(false, Ordering::SeqCst);
+    }
+}
+
+/// Why a recording ended early; the entity maps these to state-machine inputs.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum CaptureEvent {
+    /// 120 s of audio are held; nothing more is appended (R2.6).
+    Limit,
+    /// The device stopped delivering audio; the reason is shown to the user (R9.2).
+    DeviceError(String),
+}
+
+/// Why a recording ended. The entity learns of an early end through [`CaptureEvent`]; this is
+/// what the recording itself remembers.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Ended {
+    /// Stopped by the user (or by the entity on the user's behalf).
+    #[default]
+    User,
+    /// The 120 s limit was reached (R2.6).
+    Limit,
+    /// The device stopped delivering audio (R9.2).
+    DeviceError,
+}
+
+impl Ended {
+    fn to_u8(self) -> u8 {
+        match self {
+            Self::User => 0,
+            Self::Limit => 1,
+            Self::DeviceError => 2,
+        }
+    }
+
+    fn from_u8(value: u8) -> Self {
+        match value {
+            1 => Self::Limit,
+            2 => Self::DeviceError,
+            _ => Self::User,
+        }
+    }
+}
+
+/// The first early end seen by the stream's callbacks, shared with the [`Recorder`].
+#[derive(Clone, Default)]
+struct EndFlag(Arc<AtomicU8>);
+
+impl EndFlag {
+    /// Records `ended` unless an earlier end is already recorded.
+    fn set(&self, ended: Ended) {
+        // Losing the race means an earlier end is already recorded, which is the one kept.
+        let _ = self.0.compare_exchange(
+            Ended::User.to_u8(),
+            ended.to_u8(),
+            Ordering::SeqCst,
+            Ordering::SeqCst,
+        );
+    }
+
+    fn get(&self) -> Ended {
+        Ended::from_u8(self.0.load(Ordering::SeqCst))
+    }
+}
+
+/// What a finished recording hands back: mono samples at the device rate.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Recording {
+    pub samples: Vec<f32>,
+    pub sample_rate: u32,
+    pub ended: Ended,
+}
+
+/// The channel a capture reports its events on. Named here so a fake backend in another crate
+/// does not need its own `smol` dependency.
+pub type CaptureEventSender = smol::channel::Sender<CaptureEvent>;
+
+/// The seam the entity starts a recording through; tests inject a fake.
+pub trait CaptureBackend: Send + Sync {
+    /// Opens `device` (or the system default input) and starts recording. Returns only once
+    /// the stream is playing, or with the reason it could not be opened (R9.1).
+    fn start(
+        &self,
+        device: Option<DeviceId>,
+        events: CaptureEventSender,
+    ) -> Result<Box<dyn ActiveCapture>>;
+}
+
+/// A recording in progress.
+pub trait ActiveCapture: Send {
+    /// Stops recording and returns what was captured.
+    fn stop(self: Box<Self>) -> Recording;
+    /// Stops recording and discards the audio.
+    fn cancel(self: Box<Self>);
+}
+
+/// The production backend: cpal on a dedicated thread.
+pub struct Cpal;
+
+impl CaptureBackend for Cpal {
+    fn start(
+        &self,
+        device: Option<DeviceId>,
+        events: smol::channel::Sender<CaptureEvent>,
+    ) -> Result<Box<dyn ActiveCapture>> {
+        let requested = requested_label(device.as_ref());
+        if CAPTURE_THREAD_LIVE
+            .compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst)
+            .is_err()
+        {
+            log::warn!("voice_input event=capture_refused reason=previous_thread_alive");
+            return Err(anyhow!(
+                "a previous recording has not released the input device yet"
+            ));
+        }
+        let samples = Arc::new(Mutex::new(Vec::new()));
+        let ended = EndFlag::default();
+        let (ready_tx, ready_rx) = mpsc::sync_channel::<Result<u32>>(1);
+        let (stop_tx, stop_rx) = mpsc::channel::<()>();
+
+        let thread_samples = samples.clone();
+        let thread_ended = ended.clone();
+        let spawned = std::thread::Builder::new()
+            .name(THREAD_NAME.into())
+            .spawn(move || {
+                let _live = LiveGuard;
+                capture_thread(
+                    device,
+                    events,
+                    thread_samples,
+                    thread_ended,
+                    ready_tx,
+                    stop_rx,
+                )
+            });
+        let thread = match spawned {
+            Ok(thread) => thread,
+            Err(error) => {
+                CAPTURE_THREAD_LIVE.store(false, Ordering::SeqCst);
+                return Err(error).context("could not start the capture thread");
+            }
+        };
+
+        let mut recorder = Recorder {
+            stop: Some(stop_tx),
+            thread: Some(thread),
+            samples,
+            sample_rate: 0,
+            ended,
+        };
+        match ready_rx.recv_timeout(OPEN_TIMEOUT) {
+            Ok(Ok(sample_rate)) => {
+                recorder.sample_rate = sample_rate;
+                Ok(Box::new(recorder))
+            }
+            Ok(Err(err)) => {
+                log::warn!(
+                    "voice_input event=capture_failed device={requested:?} reason={:?}",
+                    format!("{err:#}")
+                );
+                Err(err)
+            }
+            Err(mpsc::RecvTimeoutError::Timeout) => {
+                // The thread is left to finish on its own: dropping `recorder` would join it,
+                // and joining a thread stuck inside the device would hang the caller instead.
+                recorder.thread = None;
+                log::warn!("voice_input event=capture_open_timeout device={requested:?}");
+                Err(anyhow!(
+                    "{requested} did not open within {} s",
+                    OPEN_TIMEOUT.as_secs()
+                ))
+            }
+            Err(mpsc::RecvTimeoutError::Disconnected) => {
+                log::warn!("voice_input event=capture_thread_died device={requested:?}");
+                Err(anyhow!(
+                    "the capture thread for {requested} stopped unexpectedly"
+                ))
+            }
+        }
+    }
+}
+
+/// Handle to the `voice-capture` thread; dropping it stops the thread.
+pub struct Recorder {
+    /// Dropping this sender is the stop signal: the thread drops its stream and exits.
+    stop: Option<mpsc::Sender<()>>,
+    thread: Option<JoinHandle<()>>,
+    samples: Arc<Mutex<Vec<f32>>>,
+    sample_rate: u32,
+    ended: EndFlag,
+}
+
+impl Recorder {
+    /// Stops the thread and waits for it, so the stream's callback can no longer append.
+    fn shutdown(&mut self) {
+        drop(self.stop.take());
+        if let Some(thread) = self.thread.take()
+            && thread.join().is_err()
+        {
+            log::warn!("voice_input event=capture_thread_panicked");
+        }
+    }
+
+    fn take_samples(&self) -> Vec<f32> {
+        std::mem::take(&mut *self.samples.lock().unwrap_or_else(PoisonError::into_inner))
+    }
+}
+
+impl ActiveCapture for Recorder {
+    fn stop(mut self: Box<Self>) -> Recording {
+        self.shutdown();
+        let samples = self.take_samples();
+        log::info!(
+            "voice_input event=capture_stopped samples={} rate={}",
+            samples.len(),
+            self.sample_rate
+        );
+        Recording {
+            samples,
+            sample_rate: self.sample_rate,
+            ended: self.ended.get(),
+        }
+    }
+
+    fn cancel(mut self: Box<Self>) {
+        self.shutdown();
+        drop(self.take_samples());
+        log::info!("voice_input event=capture_cancelled");
+    }
+}
+
+impl Drop for Recorder {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+/// The body of the `voice-capture` thread: open, report, wait for stop, drop the stream.
+fn capture_thread(
+    device: Option<DeviceId>,
+    events: smol::channel::Sender<CaptureEvent>,
+    samples: Arc<Mutex<Vec<f32>>>,
+    ended: EndFlag,
+    ready: mpsc::SyncSender<Result<u32>>,
+    stop: mpsc::Receiver<()>,
+) {
+    let (stream, sample_rate) = match open_stream(device.as_ref(), events, samples, ended) {
+        Ok(opened) => opened,
+        Err(err) => {
+            if ready.send(Err(err)).is_err() {
+                log::debug!("voice_input event=capture_open_unreported");
+            }
+            return;
+        }
+    };
+    if ready.send(Ok(sample_rate)).is_err() {
+        // `start` gave up waiting; nobody owns this recording.
+        return;
+    }
+    match stop.recv() {
+        // The recorder never sends: dropping its sender is the stop signal, so a disconnect
+        // is the expected way out, not a failure.
+        Ok(()) | Err(mpsc::RecvError) => drop(stream),
+    }
+}
+
+/// Resolves the device and builds a playing input stream for its default config.
+/// Runs on the capture thread only: the returned stream is `!Send`.
+fn open_stream(
+    device: Option<&DeviceId>,
+    events: smol::channel::Sender<CaptureEvent>,
+    samples: Arc<Mutex<Vec<f32>>>,
+    ended: EndFlag,
+) -> Result<(cpal::Stream, u32)> {
+    let requested = requested_label(device);
+    let device = audio::resolve_device(device, true)
+        .with_context(|| format!("could not open {requested}"))?;
+    let name = device_label(&device);
+    let supported = device
+        .default_input_config()
+        .with_context(|| format!("could not read the input format of {name:?}"))?;
+    let format = supported.sample_format();
+    check_format(format).with_context(|| format!("{name:?} cannot be recorded"))?;
+
+    let sample_rate = supported.sample_rate();
+    let channels = supported.channels();
+    let limit = limit_samples(sample_rate);
+    samples
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .reserve_exact(limit);
+    let sink = Sink {
+        samples,
+        channels,
+        limit,
+        events: events.clone(),
+        ended: ended.clone(),
+        stopped: false,
+        // Reserved here so the first real-time callback does not allocate.
+        scratch: Vec::with_capacity(16_384),
+    };
+
+    let config = supported.config();
+    let stream = match format {
+        SampleFormat::F32 => build::<f32>(&device, config, sink, events, ended, |s| s),
+        SampleFormat::I16 => build::<i16>(&device, config, sink, events, ended, i16_to_f32),
+        SampleFormat::U16 => build::<u16>(&device, config, sink, events, ended, u16_to_f32),
+        SampleFormat::I24 => build::<cpal::I24>(&device, config, sink, events, ended, i24_to_f32),
+        SampleFormat::I32 => build::<i32>(&device, config, sink, events, ended, i32_to_f32),
+        other => return Err(unsupported_format(other)),
+    }
+    .with_context(|| format!("could not open an input stream on {name:?}"))?;
+    stream
+        .play()
+        .with_context(|| format!("could not start recording from {name:?}"))?;
+
+    log::info!(
+        "voice_input event=capture_started device={name:?} rate={sample_rate} channels={channels} format={:?}",
+        format.to_string()
+    );
+    Ok((stream, sample_rate))
+}
+
+fn build<T: SizedSample + 'static>(
+    device: &cpal::Device,
+    config: StreamConfig,
+    mut sink: Sink,
+    events: smol::channel::Sender<CaptureEvent>,
+    ended: EndFlag,
+    convert: fn(T) -> f32,
+) -> std::result::Result<cpal::Stream, cpal::Error> {
+    let mut reported = false;
+    device.build_input_stream::<T, _, _>(
+        config,
+        move |data: &[T], _info| sink.push(data, convert),
+        move |err: cpal::Error| {
+            if !is_fatal(err.kind()) {
+                log::debug!(
+                    "voice_input event=capture_glitch reason={:?}",
+                    err.to_string()
+                );
+                return;
+            }
+            if !reported {
+                reported = true;
+                ended.set(Ended::DeviceError);
+                send(&events, CaptureEvent::DeviceError(err.to_string()));
+            }
+        },
+        // A finite poll timeout keeps cpal's ALSA worker re-checking for a device that vanished
+        // without a hang-up event; `None` would wait forever and the recording would go silent.
+        Some(Duration::from_millis(500)),
+    )
+}
+
+/// The data callback's state: converts, downmixes and appends, then signals `Limit` once.
+struct Sink {
+    samples: Arc<Mutex<Vec<f32>>>,
+    channels: u16,
+    limit: usize,
+    events: smol::channel::Sender<CaptureEvent>,
+    ended: EndFlag,
+    /// Set once the limit is reached or the buffer is unusable; later callbacks do nothing.
+    stopped: bool,
+    /// Reused across callbacks so the audio thread allocates only while it grows.
+    scratch: Vec<f32>,
+}
+
+impl Sink {
+    fn push<T: Copy>(&mut self, data: &[T], convert: fn(T) -> f32) {
+        if self.stopped {
+            return;
+        }
+        self.scratch.clear();
+        self.scratch.extend(data.iter().copied().map(convert));
+        let reached = match self.samples.lock() {
+            Ok(mut buf) => append_mono(&mut buf, &self.scratch, self.channels, self.limit),
+            Err(_) => {
+                self.stopped = true;
+                self.ended.set(Ended::DeviceError);
+                send(
+                    &self.events,
+                    CaptureEvent::DeviceError("the recording buffer was poisoned".into()),
+                );
+                return;
+            }
+        };
+        if reached {
+            self.stopped = true;
+            self.ended.set(Ended::Limit);
+            send(&self.events, CaptureEvent::Limit);
+        }
+    }
+}
+
+fn send(events: &smol::channel::Sender<CaptureEvent>, event: CaptureEvent) {
+    if events.try_send(event).is_err() {
+        log::debug!("voice_input event=capture_event_dropped");
+    }
+}
+
+/// Whether a stream error means the device stopped delivering audio (R9.2). An xrun, a
+/// reroute to a new default device or a refused real-time promotion leave the stream running.
+fn is_fatal(kind: ErrorKind) -> bool {
+    !matches!(
+        kind,
+        ErrorKind::Xrun | ErrorKind::DeviceChanged | ErrorKind::RealtimeDenied
+    )
+}
+
+fn requested_label(device: Option<&DeviceId>) -> String {
+    match device {
+        Some(id) => format!("the input device {:?}", id.to_string()),
+        None => "the default input device".to_string(),
+    }
+}
+
+fn device_label(device: &cpal::Device) -> String {
+    match device.description() {
+        Ok(description) => description.name().to_string(),
+        Err(_) => match device.id() {
+            Ok(id) => id.to_string(),
+            Err(_) => "unknown input device".to_string(),
+        },
+    }
+}
+
+fn unsupported_format(format: SampleFormat) -> anyhow::Error {
+    anyhow!("unsupported sample format {format}")
+}
+
+/// The number of mono samples held at most: 120 s at `rate` (R2.6).
+pub fn limit_samples(rate: u32) -> usize {
+    (rate as usize).saturating_mul(MAX_SECONDS)
+}
+
+/// Averages each interleaved frame of `channels` samples into one mono sample appended to
+/// `buf`, never growing `buf` past `limit`. Returns `true` only on the call that makes
+/// `buf.len()` reach `limit`. A trailing partial frame is ignored.
+pub fn append_mono(buf: &mut Vec<f32>, interleaved: &[f32], channels: u16, limit: usize) -> bool {
+    if channels == 0 || buf.len() >= limit {
+        return false;
+    }
+    let room = limit - buf.len();
+    let divisor = f32::from(channels);
+    buf.extend(
+        interleaved
+            .chunks_exact(usize::from(channels))
+            .take(room)
+            .map(|frame| frame.iter().sum::<f32>() / divisor),
+    );
+    buf.len() >= limit
+}
+
+/// Maps a signed 16-bit sample to [-1, 1).
+pub fn i16_to_f32(s: i16) -> f32 {
+    f32::from(s) / 32_768.0
+}
+
+/// Maps an unsigned 16-bit sample (origin 32 768) to [-1, 1).
+pub fn u16_to_f32(s: u16) -> f32 {
+    (f32::from(s) - 32_768.0) / 32_768.0
+}
+
+/// Full scale of a signed 24-bit sample: 2^23.
+const I24_SCALE: f64 = 8_388_608.0;
+
+/// Full scale of a signed 32-bit sample: 2^31.
+const I32_SCALE: f64 = 2_147_483_648.0;
+
+/// Maps a signed 24-bit sample (cpal's `I24`: 24 significant bits in an `i32`) to [-1, 1).
+///
+/// cpal passes S24_LE words through as read, and the top byte is not promised to be a sign
+/// extension (PulseAudio's S24_32 writer zero-fills it), so the sign is taken from bit 23: the
+/// left shift drops the top byte and the arithmetic right shift extends bit 23 over it. The
+/// result is always in -2^23..=2^23-1, so no clamp is needed.
+pub fn i24_to_f32(s: cpal::I24) -> f32 {
+    let value = (s.inner() << 8) >> 8;
+    (f64::from(value) / I24_SCALE) as f32
+}
+
+/// Maps a signed 32-bit sample to [-1, 1].
+pub fn i32_to_f32(s: i32) -> f32 {
+    (f64::from(s) / I32_SCALE).clamp(-1.0, 1.0) as f32
+}
+
+/// `F32`, `I16`, `U16`, `I24` and `I32` are recorded; any other format is refused by name.
+pub fn check_format(format: SampleFormat) -> Result<()> {
+    match format {
+        SampleFormat::F32
+        | SampleFormat::I16
+        | SampleFormat::U16
+        | SampleFormat::I24
+        | SampleFormat::I32 => Ok(()),
+        other => Err(unsupported_format(other)),
+    }
+}
+
+#[cfg(test)]
+mod fatal_tests {
+    use super::*;
+
+    #[test]
+    fn capture_glitches_do_not_stop_the_recording() {
+        for kind in [
+            ErrorKind::Xrun,
+            ErrorKind::DeviceChanged,
+            ErrorKind::RealtimeDenied,
+        ] {
+            assert!(!is_fatal(kind), "{kind:?}");
+        }
+        for kind in [
+            ErrorKind::DeviceNotAvailable,
+            ErrorKind::StreamInvalidated,
+            ErrorKind::BackendError,
+            ErrorKind::Other,
+        ] {
+            assert!(is_fatal(kind), "{kind:?}");
+        }
+    }
+}
diff --git a/crates/voice_input/src/capture_formats_tests.rs b/crates/voice_input/src/capture_formats_tests.rs
new file mode 100644
index 0000000..145f1b7
--- /dev/null
+++ b/crates/voice_input/src/capture_formats_tests.rs
@@ -0,0 +1,141 @@
+// Story 044, task 8.6 (refine v3) — I24 and I32 microphones are recorded (R9.1, MODIFIED in v3;
+// design.md C1.4). Wired in the crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod capture_formats_tests;
+//
+// Validation filter: `capture` (every test path is `capture_formats_tests::…`).
+//
+// Contract: `capture::check_format(cpal::SampleFormat) -> anyhow::Result<()>` accepts F32, I16,
+// U16, I24 and I32 and refuses anything else naming the format; `capture::i24_to_f32(cpal::I24)
+// -> f32` divides by 2^23 and `capture::i32_to_f32(i32) -> f32` by 2^31, both within [-1, 1].
+//
+// Hostile halves, the wrong collapse first: U24 and U32 sit next to I24 and I32 (same width,
+// unsigned) and stay refused, as do I8, I64, F64, U8 and the DSD containers; then the accepted
+// five. For the scale, a value each converter would map wrongly if it borrowed the other's
+// divisor: 2^22 in a 24-bit sample is half scale, and 2^23 in a 32-bit sample is 1/256 — a
+// 24-bit divisor applied to I32 would clip it to full scale, a 31-bit divisor applied to I24
+// would leave it near silence.
+
+use cpal::{I24, SampleFormat};
+
+use crate::capture::{check_format, i24_to_f32, i32_to_f32};
+
+const EPSILON: f32 = 1e-6;
+
+fn i24(value: i32) -> I24 {
+    I24::new(value).expect("a value inside the 24-bit range")
+}
+
+#[test]
+fn capture_formats_unsigned_and_other_widths_are_refused_by_name() {
+    for bad in [
+        SampleFormat::U24,
+        SampleFormat::U32,
+        SampleFormat::I8,
+        SampleFormat::I64,
+        SampleFormat::F64,
+        SampleFormat::U8,
+        SampleFormat::U64,
+        SampleFormat::DsdU8,
+        SampleFormat::DsdU32,
+    ] {
+        let error = check_format(bad).expect_err("refused");
+        let shown = format!("{error:#}").to_lowercase();
+        let name = format!("{bad:?}").to_lowercase();
+        assert!(
+            shown.contains(&name),
+            "R9.1 the error names {name}: {shown}"
+        );
+    }
+}
+
+#[test]
+fn capture_formats_accepts_f32_i16_u16_i24_and_i32() {
+    for ok in [
+        SampleFormat::F32,
+        SampleFormat::I16,
+        SampleFormat::U16,
+        SampleFormat::I24,
+        SampleFormat::I32,
+    ] {
+        assert!(
+            check_format(ok).is_ok(),
+            "R9.1 {ok:?} is recorded: {:?}",
+            check_format(ok)
+        );
+    }
+}
+
+#[test]
+fn capture_formats_i32_spans_the_unit_range() {
+    assert_eq!(
+        i32_to_f32(i32::MIN),
+        -1.0,
+        "i32::MIN is full negative scale"
+    );
+    assert!(
+        (i32_to_f32(i32::MAX) - 1.0).abs() < EPSILON,
+        "i32::MAX ≈ 1: {}",
+        i32_to_f32(i32::MAX)
+    );
+    assert_eq!(i32_to_f32(0), 0.0, "0 is silence");
+}
+
+#[test]
+fn capture_formats_i24_spans_the_unit_range() {
+    let min = -(1 << 23);
+    let max = (1 << 23) - 1;
+    assert_eq!(i24_to_f32(i24(min)), -1.0, "-2^23 is full negative scale");
+    assert!(
+        (i24_to_f32(i24(max)) - 1.0).abs() < 1e-6,
+        "2^23-1 ≈ 1: {}",
+        i24_to_f32(i24(max))
+    );
+    assert_eq!(i24_to_f32(i24(0)), 0.0, "0 is silence");
+}
+
+#[test]
+fn capture_formats_each_width_uses_its_own_divisor() {
+    assert!(
+        (i24_to_f32(i24(1 << 22)) - 0.5).abs() < EPSILON,
+        "2^22 in a 24-bit sample is half scale, not near silence: {}",
+        i24_to_f32(i24(1 << 22))
+    );
+    assert!(
+        (i32_to_f32(1 << 30) - 0.5).abs() < EPSILON,
+        "2^30 in a 32-bit sample is half scale: {}",
+        i32_to_f32(1 << 30)
+    );
+    assert!(
+        (i32_to_f32(1 << 23) - 1.0 / 256.0).abs() < EPSILON,
+        "2^23 in a 32-bit sample is 1/256, not clipped to full scale: {}",
+        i32_to_f32(1 << 23)
+    );
+}
+
+#[test]
+fn capture_formats_keep_the_sign() {
+    for value in [-1, -12_345, -(1 << 20)] {
+        assert!(i24_to_f32(i24(value)) < 0.0, "I24 {value} stays negative");
+        assert!(i32_to_f32(value) < 0.0, "I32 {value} stays negative");
+        assert!(
+            i24_to_f32(i24(-value)) > 0.0,
+            "I24 {} stays positive",
+            -value
+        );
+        assert!(i32_to_f32(-value) > 0.0, "I32 {} stays positive", -value);
+    }
+}
+
+#[test]
+fn capture_formats_stay_within_the_unit_range() {
+    for value in [i32::MIN, i32::MIN + 1, -1, 0, 1, i32::MAX - 1, i32::MAX] {
+        let sample = i32_to_f32(value);
+        assert!((-1.0..=1.0).contains(&sample), "I32 {value} → {sample}");
+    }
+    for value in [-(1 << 23), -(1 << 23) + 1, 0, (1 << 23) - 2, (1 << 23) - 1] {
+        let sample = i24_to_f32(i24(value));
+        assert!((-1.0..=1.0).contains(&sample), "I24 {value} → {sample}");
+    }
+}
diff --git a/crates/voice_input/src/capture_i24_sign_tests.rs b/crates/voice_input/src/capture_i24_sign_tests.rs
new file mode 100644
index 0000000..9ff5c08
--- /dev/null
+++ b/crates/voice_input/src/capture_i24_sign_tests.rs
@@ -0,0 +1,61 @@
+// Story 044, task 8.6, fix round 1 — an I24 sample is sign-extended from bit 23 (R9.1).
+//
+// cpal hands S24_LE over as raw 32-bit words, and the top byte is not promised to be a sign
+// extension: PulseAudio's S24_32 writer zero-fills it. Read as-is, every negative sample would
+// land in [2^23, 2^24) and turn into +1.0, so the converter must look at the low 24 bits only.
+
+use cpal::I24;
+
+use crate::capture::i24_to_f32;
+
+const EPSILON: f32 = 1e-6;
+
+fn raw(word: i32) -> I24 {
+    I24::new_unchecked(word)
+}
+
+#[test]
+fn capture_i24_zero_filled_minus_one_is_negative() {
+    let sample = i24_to_f32(raw(0x00FF_FFFF));
+    let expected = -1.0 / 8_388_608.0;
+    assert!(sample < 0.0, "0x00FF_FFFF is -1 in 24 bits: {sample}");
+    assert!(
+        (sample - expected).abs() < EPSILON,
+        "0x00FF_FFFF ≈ -1/2^23: {sample}"
+    );
+}
+
+#[test]
+fn capture_i24_zero_filled_minimum_is_full_negative_scale() {
+    assert_eq!(
+        i24_to_f32(raw(0x0080_0000)),
+        -1.0,
+        "0x0080_0000 is -2^23 in 24 bits"
+    );
+}
+
+#[test]
+fn capture_i24_maximum_is_just_under_full_scale() {
+    let sample = i24_to_f32(raw(0x007F_FFFF));
+    assert!(
+        sample > 0.0 && sample <= 1.0,
+        "0x007F_FFFF in (0, 1]: {sample}"
+    );
+    assert!((sample - 1.0).abs() < EPSILON, "0x007F_FFFF ≈ 1: {sample}");
+}
+
+#[test]
+fn capture_i24_ignores_the_top_byte() {
+    for (garbage, clean) in [
+        (0x12FF_FFFF_u32 as i32, 0x00FF_FFFF),
+        (0xFFFF_FFFF_u32 as i32, 0x00FF_FFFF),
+        (0x5580_0000_u32 as i32, 0x0080_0000),
+        (0xAB00_1234_u32 as i32, 0x0000_1234),
+    ] {
+        assert_eq!(
+            i24_to_f32(raw(garbage)),
+            i24_to_f32(raw(clean)),
+            "top byte of {garbage:#010x} is ignored"
+        );
+    }
+}
diff --git a/crates/voice_input/src/capture_tests.rs b/crates/voice_input/src/capture_tests.rs
new file mode 100644
index 0000000..737cff3
--- /dev/null
+++ b/crates/voice_input/src/capture_tests.rs
@@ -0,0 +1,106 @@
+// Story 044, task 3.2 — the pure helpers of the capture thread (R2.6, R9.1, R9.2). Wired in the
+// crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod capture_tests;
+//
+// Validation filter: `capture` (every test path is `capture_tests::…`).
+//
+// No device is opened here: a unit test must never touch the operator's microphone. The device
+// path (`start`, the `!Send` stream) is exercised by the GUI proof (7.3) and, through a fake
+// backend, by `entity_tests`.
+//
+// Contract: design.md C1.4 (downmix by averaging, a 120 s cap that signals `Limit` once, `F32`/
+// `I16`/`U16` accepted and any other format refused by name). Assumed helper signatures — the
+// cpal callback is a thin shell over them; adjust the `use` only:
+//   - `capture::limit_samples(rate: u32) -> usize`                        — 120 s × rate (mono)
+//   - `capture::append_mono(buf: &mut Vec<f32>, interleaved: &[f32], channels: usize,
+//                           limit: usize) -> bool`  — averages each frame into `buf`, never past
+//     `limit`; returns `true` only on the call that makes `buf.len()` reach `limit`
+//   - `capture::i16_to_f32(i16) -> f32`, `capture::u16_to_f32(u16) -> f32`
+//   - `capture::check_format(cpal::SampleFormat) -> anyhow::Result<()>`
+//
+// Hostile halves: a stereo frame of +1/-1 averages to 0 (not the left channel); the limit is
+// signalled once AND later callbacks neither append nor signal again; F32/I16/U16 are accepted AND
+// I32/F64/U8 are refused with their name.
+
+use crate::capture::{append_mono, check_format, i16_to_f32, limit_samples, u16_to_f32};
+
+#[test]
+fn capture_limit_is_120_seconds_of_mono() {
+    assert_eq!(limit_samples(48_000), 5_760_000);
+    assert_eq!(limit_samples(44_100), 5_292_000);
+    assert_eq!(limit_samples(16_000), 1_920_000);
+}
+
+#[test]
+fn capture_downmix_averages_each_frame() {
+    let mut buf = Vec::new();
+    let reached = append_mono(&mut buf, &[1.0, -1.0, 0.5, 0.25, 0.0, 1.0], 2, 1_000);
+    assert!(!reached);
+    assert_eq!(buf, vec![0.0, 0.375, 0.5]);
+}
+
+#[test]
+fn capture_mono_passes_through_and_three_channels_average() {
+    let mut buf = Vec::new();
+    append_mono(&mut buf, &[0.1, -0.2, 0.3], 1, 1_000);
+    assert_eq!(buf, vec![0.1, -0.2, 0.3]);
+    let mut buf = Vec::new();
+    append_mono(&mut buf, &[0.3, 0.3, 0.3, 0.9, 0.0, 0.0], 3, 1_000);
+    assert!(
+        (buf[0] - 0.3).abs() < 1e-6 && (buf[1] - 0.3).abs() < 1e-6,
+        "{buf:?}"
+    );
+}
+
+#[test]
+fn capture_limit_signals_once_and_stops_appending() {
+    let mut buf = Vec::new();
+    assert!(!append_mono(&mut buf, &[0.1; 6], 1, 8));
+    assert!(
+        append_mono(&mut buf, &[0.2; 6], 1, 8),
+        "the call that reaches the limit signals"
+    );
+    assert_eq!(buf.len(), 8, "truncated exactly at the limit");
+    assert!(!append_mono(&mut buf, &[0.3; 6], 1, 8), "no second Limit");
+    assert_eq!(buf.len(), 8, "nothing appended after the limit");
+}
+
+#[test]
+fn capture_limit_reached_exactly_by_a_whole_chunk() {
+    let mut buf = Vec::new();
+    assert!(append_mono(&mut buf, &[0.1; 4], 1, 4));
+    assert_eq!(buf.len(), 4);
+}
+
+#[test]
+fn capture_zero_channels_appends_nothing() {
+    let mut buf = Vec::new();
+    assert!(!append_mono(&mut buf, &[0.1, 0.2], 0, 10));
+    assert!(buf.is_empty());
+}
+
+#[test]
+fn capture_integer_samples_convert_to_unit_range() {
+    assert_eq!(i16_to_f32(0), 0.0);
+    assert!((i16_to_f32(i16::MIN) + 1.0).abs() < 1e-4);
+    assert!((i16_to_f32(i16::MAX) - 1.0).abs() < 1e-4);
+    assert!((u16_to_f32(32_768)).abs() < 1e-4, "u16 midpoint is silence");
+    assert!((u16_to_f32(0) + 1.0).abs() < 1e-4);
+    assert!((u16_to_f32(u16::MAX) - 1.0).abs() < 1e-4);
+}
+
+#[test]
+fn capture_accepts_f32_i16_u16_and_names_any_other_format() {
+    use cpal::SampleFormat;
+    for ok in [SampleFormat::F32, SampleFormat::I16, SampleFormat::U16] {
+        assert!(check_format(ok).is_ok(), "{ok:?}");
+    }
+    for bad in [SampleFormat::F64, SampleFormat::U8] {
+        let err = check_format(bad).expect_err("refused");
+        let shown = format!("{err:#}").to_lowercase();
+        let name = format!("{bad:?}").to_lowercase();
+        assert!(shown.contains(&name), "the error names {name}: {shown}");
+    }
+}
diff --git a/crates/voice_input/src/deliver_tests.rs b/crates/voice_input/src/deliver_tests.rs
new file mode 100644
index 0000000..31cc34e
--- /dev/null
+++ b/crates/voice_input/src/deliver_tests.rs
@@ -0,0 +1,271 @@
+// Story 044, task 5.4 fix round 1 — a finished transcript is delivered to its composer only when
+// that composer is still open, and the decision survives the gap between the transcript arriving
+// and its delivery (R4.7; tech review 5.4 L1, L4). Wired in the crate root `src/voice_input.rs`.
+//
+// Both tests run the decisive steps inside one `cx.update`, so gpui flushes effects (and releases
+// dropped entities) only when that update ends — the same-flush interleaving the review describes.
+
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+use std::time::{Duration, Instant};
+
+use futures::channel::oneshot;
+use gpui::{AnyWeakEntity, AppContext as _, Entity, EntityId, TestAppContext, UpdateGlobal as _};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use settings::SettingsStore;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Ended, Recording};
+use crate::state::{Input, Owner};
+use crate::{ViewState, VoiceEvent, VoiceInput, init_in};
+
+const REMOTE: &str = r#"{ "voice_input": { "remote": { "enabled": true,
+    "url": "http://127.0.0.1:9/v1/audio/transcriptions", "api_key_env": "ZEO_VOICE_TEST_UNSET_044_D1" } } }"#;
+
+#[derive(Default)]
+struct Mic {
+    starts: AtomicUsize,
+    stops: AtomicUsize,
+}
+
+struct FakeBackend(Arc<Mic>);
+struct FakeActive(Arc<Mic>);
+
+impl CaptureBackend for FakeBackend {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        self.0.starts.fetch_add(1, Ordering::SeqCst);
+        Ok(Box::new(FakeActive(self.0.clone())))
+    }
+}
+
+impl ActiveCapture for FakeActive {
+    fn stop(self: Box<Self>) -> Recording {
+        self.0.stops.fetch_add(1, Ordering::SeqCst);
+        let rate = 48_000;
+        let samples = (0..rate).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: rate,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {}
+}
+
+struct Harness {
+    vi: Entity<VoiceInput>,
+    events: Arc<Mutex<Vec<VoiceEvent>>>,
+    /// Answers the held remote request; the tests deliver their own `Transcribed` instead.
+    release: Option<oneshot::Sender<()>>,
+    _tmp: tempfile::TempDir,
+}
+
+impl Harness {
+    fn delivered(&self, owner: EntityId) -> (usize, usize) {
+        let events = self.events.lock().expect("lock");
+        let inserts = events
+            .iter()
+            .filter(|e| matches!(e, VoiceEvent::Insert { owner: o, .. } if *o == owner))
+            .count();
+        let discards = events
+            .iter()
+            .filter(|e| matches!(e, VoiceEvent::Discarded { owner: o } if *o == owner))
+            .count();
+        (inserts, discards)
+    }
+}
+
+impl Drop for Harness {
+    fn drop(&mut self) {
+        if let Some(release) = self.release.take() {
+            release.send(()).ok();
+        }
+    }
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn setup(cx: &mut TestAppContext) -> Harness {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(REMOTE, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+    let (release, held) = oneshot::channel::<()>();
+    let held = Arc::new(Mutex::new(Some(held)));
+    let http: Arc<dyn HttpClient> = FakeHttpClient::create(move |_req| {
+        let held = held.lock().expect("lock").take();
+        async move {
+            if let Some(held) = held {
+                held.await.ok();
+            }
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from(r#"{"text": "late"}"#))?)
+        }
+    });
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let backend: Arc<dyn CaptureBackend> = Arc::new(FakeBackend(Arc::default()));
+    cx.update(|cx| init_in(http, tmp.path().join("models"), backend, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    Harness {
+        vi,
+        events,
+        release: Some(release),
+        _tmp: tmp,
+    }
+}
+
+/// Records for `owner` and stops, leaving the remote request held: the phase is `Transcribing`.
+fn transcribing(h: &Harness, owner: EntityId, alive: AnyWeakEntity, cx: &mut TestAppContext) {
+    let o = Owner(owner.as_u64());
+    h.vi.update(cx, |vi, _| vi.register_owner(o, alive));
+    h.vi.update(cx, |vi, cx| vi.handle(Input::Click { owner: o }, cx));
+    wait_until(cx, "recording", |cx| {
+        matches!(
+            h.vi.read_with(cx, |vi, _| vi.view_state(owner)),
+            ViewState::Recording { .. }
+        )
+    });
+    h.vi.update(cx, |vi, cx| vi.handle(Input::Click { owner: o }, cx));
+    wait_until(cx, "transcribing", |cx| {
+        matches!(
+            h.vi.read_with(cx, |vi, _| vi.view_state(owner)),
+            ViewState::Transcribing
+        )
+    });
+}
+
+/// L1: the transcript arrives (the machine is `Idle` again), the composer closes, and a new
+/// composer registers — which prunes closed owners while `Idle` — all before the delivery runs.
+#[gpui::test]
+async fn deliver_closed_owner_pruned_before_delivery_is_discarded(cx: &mut TestAppContext) {
+    let h = setup(cx);
+    let a = cx.new(|_| ());
+    let b = cx.new(|_| ());
+    let ida = a.entity_id();
+    transcribing(&h, ida, a.downgrade().into(), cx);
+
+    let vi = h.vi.clone();
+    let b_alive: AnyWeakEntity = b.downgrade().into();
+    let idb = Owner(b.entity_id().as_u64());
+    cx.update(move |cx| {
+        vi.update(cx, |vi, cx| {
+            vi.handle(
+                Input::Transcribed {
+                    text: "for A".into(),
+                },
+                cx,
+            )
+        });
+        drop(a);
+        vi.update(cx, |vi, _| vi.register_owner(idb, b_alive));
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        h.delivered(ida),
+        (0, 1),
+        "R4.7: discarded, not inserted into a closed composer"
+    );
+}
+
+struct Parent {
+    _thread_view: Entity<()>,
+}
+
+/// L4: the composer is held by a parent whose last handle is dropped in the same update the
+/// transcript arrives in. The composer itself still upgrades until the flush releases the parent,
+/// so only a delivery decided after that flush sees it closed.
+#[gpui::test]
+async fn deliver_owner_released_with_its_parent_in_the_same_update_is_discarded(
+    cx: &mut TestAppContext,
+) {
+    let h = setup(cx);
+    let child = cx.new(|_| ());
+    let id = child.entity_id();
+    let alive: AnyWeakEntity = child.downgrade().into();
+    let parent = cx.new(|_| Parent {
+        _thread_view: child,
+    });
+    transcribing(&h, id, alive.clone(), cx);
+
+    let vi = h.vi.clone();
+    cx.update(move |cx| {
+        drop(parent);
+        assert!(
+            alive.upgrade().is_some(),
+            "the child outlives its parent until the flush"
+        );
+        vi.update(cx, |vi, cx| {
+            vi.handle(
+                Input::Transcribed {
+                    text: "for the child".into(),
+                },
+                cx,
+            )
+        });
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        h.delivered(id),
+        (0, 1),
+        "R4.7: discarded once its parent is released"
+    );
+}
+
+/// The hostile half: an owner still open receives its transcript, once.
+#[gpui::test]
+async fn deliver_open_owner_receives_the_transcript(cx: &mut TestAppContext) {
+    let h = setup(cx);
+    let a = cx.new(|_| ());
+    let ida = a.entity_id();
+    transcribing(&h, ida, a.downgrade().into(), cx);
+    h.vi.update(cx, |vi, cx| {
+        vi.handle(
+            Input::Transcribed {
+                text: "for A".into(),
+            },
+            cx,
+        )
+    });
+    cx.run_until_parked();
+    assert_eq!(h.delivered(ida), (1, 0));
+    drop(a);
+}
diff --git a/crates/voice_input/src/download.rs b/crates/voice_input/src/download.rs
new file mode 100644
index 0000000..0ea4130
--- /dev/null
+++ b/crates/voice_input/src/download.rs
@@ -0,0 +1,442 @@
+//! Model download: fetch one model from its pinned URL, verify it, move it into place.
+
+use std::fmt;
+use std::fs;
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use anyhow::Context as _;
+use futures::channel::oneshot;
+use futures::{AsyncReadExt as _, FutureExt as _};
+use http_client::{AsyncBody, HttpClient};
+use sha2::{Digest as _, Sha256};
+
+use crate::models::{ModelSpec, VoiceModel, url};
+
+const CHUNK: usize = 64 * 1024;
+const PROGRESS_INTERVAL: Duration = Duration::from_millis(250);
+/// How long the server may take to send the response headers, or the body may stay connected
+/// without delivering a byte, before the download fails.
+pub const STALL_TIMEOUT: Duration = Duration::from_secs(30);
+/// Every staging file's name starts with this; [`sweep_staging`] matches nothing else.
+const STAGING_PREFIX: &str = ".download-";
+
+#[derive(Debug)]
+pub enum DownloadError {
+    Cancelled,
+    Http(anyhow::Error),
+    Io(anyhow::Error),
+    Mismatch {
+        model: VoiceModel,
+        expected: &'static str,
+        got: String,
+        bytes: u64,
+    },
+}
+
+impl DownloadError {
+    fn outcome(&self) -> &'static str {
+        match self {
+            Self::Cancelled => "cancelled",
+            Self::Http(_) => "http",
+            Self::Io(_) => "io",
+            Self::Mismatch { .. } => "mismatch",
+        }
+    }
+}
+
+impl fmt::Display for DownloadError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Cancelled => write!(f, "the voice model download was cancelled"),
+            Self::Http(error) => write!(f, "could not download the voice model: {error:#}"),
+            Self::Io(error) => write!(f, "could not save the voice model: {error:#}"),
+            Self::Mismatch {
+                model,
+                expected,
+                got,
+                bytes,
+            } => write!(
+                f,
+                "the downloaded {} voice model did not match its checksum and was deleted \
+                 (expected SHA-256 {expected}, got {got} over {bytes} bytes)",
+                model_name(*model)
+            ),
+        }
+    }
+}
+
+impl std::error::Error for DownloadError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Http(error) | Self::Io(error) => Some(error.as_ref()),
+            Self::Cancelled | Self::Mismatch { .. } => None,
+        }
+    }
+}
+
+pub(crate) fn model_name(model: VoiceModel) -> &'static str {
+    match model {
+        VoiceModel::Tiny => "tiny",
+        VoiceModel::Base => "base",
+        VoiceModel::Small => "small",
+    }
+}
+
+/// Logs exactly one `model_download` line when the download ends — including when the future is
+/// dropped mid-download, which is reported as `cancelled` (R10.2).
+struct DownloadLog {
+    model: VoiceModel,
+    started: Instant,
+    bytes: u64,
+    outcome: &'static str,
+}
+
+impl Drop for DownloadLog {
+    fn drop(&mut self) {
+        let level = match self.outcome {
+            "ok" | "cancelled" => log::Level::Info,
+            _ => log::Level::Warn,
+        };
+        log::log!(
+            level,
+            "voice_input event=model_download model={} bytes={} duration_ms={} outcome={}",
+            model_name(self.model),
+            self.bytes,
+            self.started.elapsed().as_millis(),
+            self.outcome
+        );
+    }
+}
+
+/// Downloads `spec` from its pinned URL into `dir/<file>`, verifying its size and SHA-256 first.
+///
+/// The bytes are staged in `dir/.download-<file>-<random>` — the same directory as the final
+/// path, so the closing `rename` never crosses filesystems. The staging file is removed on every
+/// path but success, including this future being dropped mid-download (R6.5, R6.6).
+///
+/// `progress` receives the bytes received so far, at most every 250 ms, never past `spec.size`.
+/// Sending on `cancel` stops the download with [`DownloadError::Cancelled`]; dropping its sender
+/// only means it can no longer be cancelled that way. A server that sends no response headers, or
+/// a body that stays connected but delivers no byte, for [`STALL_TIMEOUT`] fails with
+/// [`DownloadError::Http`] (R6.13).
+///
+/// The file I/O is blocking `std::fs` — a write per 64 KiB chunk and an `fsync` of up to 488 MB —
+/// so this future must run on a background executor (`cx.background_spawn`), never on the
+/// foreground thread.
+pub async fn download_model(
+    http: Arc<dyn HttpClient>,
+    spec: &'static ModelSpec,
+    dir: PathBuf,
+    progress: impl Fn(u64) + Send + 'static,
+    cancel: oneshot::Receiver<()>,
+) -> Result<PathBuf, DownloadError> {
+    download_model_with_stall(http, spec, dir, progress, cancel, STALL_TIMEOUT).await
+}
+
+/// [`download_model`] with the stall timeout as a parameter, so a test need not wait 30 s.
+#[doc(hidden)]
+pub async fn download_model_with_stall(
+    http: Arc<dyn HttpClient>,
+    spec: &'static ModelSpec,
+    dir: PathBuf,
+    progress: impl Fn(u64) + Send + 'static,
+    cancel: oneshot::Receiver<()>,
+    stall: Duration,
+) -> Result<PathBuf, DownloadError> {
+    let mut log = DownloadLog {
+        model: spec.model,
+        started: Instant::now(),
+        bytes: 0,
+        outcome: "cancelled",
+    };
+    let result = download(
+        http.as_ref(),
+        spec,
+        &dir,
+        progress,
+        cancel,
+        stall,
+        &mut log.bytes,
+    )
+    .await;
+    log.outcome = match &result {
+        Ok(_) => "ok",
+        Err(error) => error.outcome(),
+    };
+    result
+}
+
+async fn download(
+    http: &dyn HttpClient,
+    spec: &'static ModelSpec,
+    dir: &Path,
+    progress: impl Fn(u64),
+    cancel: oneshot::Receiver<()>,
+    stall: Duration,
+    received: &mut u64,
+) -> Result<PathBuf, DownloadError> {
+    fs::create_dir_all(dir)
+        .with_context(|| format!("creating the models directory {dir:?}"))
+        .map_err(DownloadError::Io)?;
+
+    let url = url(spec);
+    let mut cancel = cancel.fuse();
+    // Hugging Face answers `resolve/` URLs with a redirect to its CDN: follow it.
+    let mut request = http.get(&url, AsyncBody::empty(), true).fuse();
+    // A server that accepts the connection but never answers would otherwise hold the download
+    // forever: the app's client sets no read timeout (R6.13).
+    #[allow(clippy::disallowed_methods)]
+    let mut no_response = smol::Timer::after(stall).fuse();
+    let answered = loop {
+        futures::select_biased! {
+            cancelled = cancel => match cancelled {
+                Ok(()) => return Err(DownloadError::Cancelled),
+                Err(oneshot::Canceled) => continue,
+            },
+            answered = request => break answered,
+            _ = no_response => {
+                return Err(DownloadError::Http(anyhow::anyhow!(
+                    "no response from {url} within {} s",
+                    stall.as_secs_f64()
+                )));
+            }
+        }
+    };
+    let mut response = answered
+        .with_context(|| format!("requesting {url}"))
+        .map_err(DownloadError::Http)?;
+    let status = response.status();
+    if !status.is_success() {
+        return Err(DownloadError::Http(anyhow::anyhow!(
+            "{url} answered {status}"
+        )));
+    }
+
+    // `NamedTempFile` is the drop guard: it removes the staging file whenever it is dropped
+    // without being persisted, whichever way this function returns or stops being polled.
+    let mut staging = tempfile::Builder::new()
+        .prefix(&format!("{STAGING_PREFIX}{}-", spec.file))
+        .tempfile_in(dir)
+        .with_context(|| format!("creating a staging file in {dir:?}"))
+        .map_err(DownloadError::Io)?;
+    // Held until the rename (dropping the file releases it): it tells another Zeo's
+    // `sweep_staging` this file is live, which its age cannot (R6.12). The file was just created
+    // under a random name, so a failure means the filesystem has no locks: the age rule is then
+    // the only guard, and the download goes on.
+    if let Err(error) = staging.as_file().try_lock() {
+        log::warn!(
+            "voice_input event=staging_lock_failed path={:?} error={:?}",
+            staging.path().display().to_string(),
+            error.to_string()
+        );
+    }
+
+    let mut hasher = Sha256::new();
+    let mut buffer = vec![0; CHUNK];
+    let mut last_progress: Option<Instant> = None;
+    let body = response.body_mut();
+    loop {
+        // The app's client sets no read timeout, and HTTP/2 keep-alive only catches a dead peer,
+        // not a live one that stops sending. `smol::Timer` because this future runs outside gpui
+        // and takes no executor.
+        #[allow(clippy::disallowed_methods)]
+        let mut stalled = smol::Timer::after(stall).fuse();
+        let read = futures::select_biased! {
+            cancelled = cancel => match cancelled {
+                Ok(()) => return Err(DownloadError::Cancelled),
+                // The sender is gone: nobody can cancel any more, so keep reading.
+                Err(oneshot::Canceled) => continue,
+            },
+            read = body.read(&mut buffer).fuse() => read,
+            _ = stalled => {
+                return Err(DownloadError::Http(anyhow::anyhow!(
+                    "no data received for {} s from {url}",
+                    stall.as_secs_f64()
+                )));
+            }
+        };
+        let n = read
+            .with_context(|| format!("reading the body of {url}"))
+            .map_err(DownloadError::Http)?;
+        if n == 0 {
+            break;
+        }
+        *received += n as u64;
+        hasher.update(&buffer[..n]);
+        // The pinned size, never `Content-Length`: the header can be absent after the redirect,
+        // and a body longer than the pinned size cannot be the pinned file.
+        if *received > spec.size {
+            return Err(mismatch(spec, hasher, *received));
+        }
+        staging
+            .as_file_mut()
+            .write_all(&buffer[..n])
+            .with_context(|| format!("writing {:?}", staging.path()))
+            .map_err(DownloadError::Io)?;
+        if last_progress.is_none_or(|at| at.elapsed() >= PROGRESS_INTERVAL) {
+            progress(*received);
+            last_progress = Some(Instant::now());
+        }
+    }
+
+    let got = hex(hasher.clone());
+    if *received != spec.size || got != spec.sha256 {
+        return Err(mismatch(spec, hasher, *received));
+    }
+
+    staging
+        .as_file()
+        .sync_all()
+        .with_context(|| format!("syncing {:?}", staging.path()))
+        .map_err(DownloadError::Io)?;
+    let destination = dir.join(spec.file);
+    staging
+        .persist(&destination)
+        .map_err(|error| {
+            // Dropping `error.file` removes the staging file.
+            anyhow::Error::new(error.error).context(format!(
+                "renaming {:?} to {destination:?}",
+                error.file.path()
+            ))
+        })
+        .map_err(DownloadError::Io)?;
+    sync_directory(dir);
+    Ok(destination)
+}
+
+/// Deletes the staging files a crashed or killed download left in `dir`, and returns how many.
+///
+/// A file goes only when all three hold: it is a regular file named `.download-*` (a symlink or a
+/// directory with that name is not a staging file, and a symlink is never followed); its last
+/// write is older than `older_than`; and its exclusive lock can be taken. A running download holds
+/// that lock from the staging file's creation until its rename, so a live file is kept however old
+/// its mtime looks — the final fsync does not move it, and a suspend moves the wall clock without
+/// the writer's stall timer (R6.12). On a filesystem without locks, the age rule decides alone:
+/// in the body loop a live download writes at least every [`STALL_TIMEOUT`], but not during its
+/// final fsync and rename. A file that cannot be read, locked or deleted is logged and skipped.
+/// Blocking `std::fs`: run it on a background executor.
+pub fn sweep_staging(dir: &Path, older_than: Duration) -> usize {
+    let entries = match fs::read_dir(dir) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return 0,
+        Err(error) => {
+            warn_sweep(dir, &error);
+            return 0;
+        }
+    };
+    let mut removed = 0;
+    for entry in entries {
+        let entry = match entry {
+            Ok(entry) => entry,
+            Err(error) => {
+                warn_sweep(dir, &error);
+                continue;
+            }
+        };
+        if !entry
+            .file_name()
+            .to_str()
+            .is_some_and(|name| name.starts_with(STAGING_PREFIX))
+        {
+            continue;
+        }
+        let path = entry.path();
+        let stale = fs::symlink_metadata(&path).and_then(|metadata| {
+            if !metadata.file_type().is_file() {
+                return Ok(false);
+            }
+            let modified = metadata.modified()?;
+            // A modification time in the future reads as fresh: it is kept.
+            Ok(modified.elapsed().is_ok_and(|age| age > older_than))
+        });
+        match stale {
+            Ok(false) => {}
+            Ok(true) if !unlocked(&path) => {}
+            Ok(true) => match fs::remove_file(&path) {
+                Ok(()) => removed += 1,
+                // Another Zeo swept it first.
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                Err(error) => warn_sweep(&path, &error),
+            },
+            Err(error) => warn_sweep(&path, &error),
+        }
+    }
+    if removed > 0 {
+        log::info!("voice_input event=staging_swept count={removed}");
+    }
+    removed
+}
+
+/// Whether no running download holds `path`'s lock. The probe lock is released before this
+/// returns, so the caller can delete the file on every platform.
+fn unlocked(path: &Path) -> bool {
+    let mut options = fs::OpenOptions::new();
+    options.read(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt as _;
+        // Swapped for a symlink since its metadata was read: fail rather than follow it.
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    let file = match options.open(path) {
+        Ok(file) => file,
+        // Another Zeo swept it first.
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return false,
+        Err(error) => {
+            warn_sweep(path, &error);
+            return false;
+        }
+    };
+    match file.try_lock() {
+        Ok(()) => true,
+        Err(fs::TryLockError::WouldBlock) => false,
+        // No locks here, so no writer holds one either: the age rule decides.
+        Err(fs::TryLockError::Error(error)) if error.kind() == std::io::ErrorKind::Unsupported => {
+            true
+        }
+        Err(fs::TryLockError::Error(error)) => {
+            warn_sweep(path, &error);
+            false
+        }
+    }
+}
+
+fn warn_sweep(path: &Path, error: &std::io::Error) {
+    log::warn!(
+        "voice_input event=staging_sweep_failed path={:?} error={:?}",
+        path.display().to_string(),
+        error.to_string()
+    );
+}
+
+/// Makes the rename durable. A failure is logged, not returned: the verified model is already in
+/// place, and if a power loss undoes the rename, `model_on_disk` reports it missing and the user
+/// is asked to download it again.
+fn sync_directory(dir: &Path) {
+    #[cfg(unix)]
+    if let Err(error) = fs::File::open(dir).and_then(|directory| directory.sync_all()) {
+        log::warn!(
+            "voice_input event=models_dir_sync_failed path={:?} error={:?}",
+            dir.display().to_string(),
+            error.to_string()
+        );
+    }
+    #[cfg(not(unix))]
+    let _ = dir;
+}
+
+fn mismatch(spec: &'static ModelSpec, hasher: Sha256, bytes: u64) -> DownloadError {
+    DownloadError::Mismatch {
+        model: spec.model,
+        expected: spec.sha256,
+        got: hex(hasher),
+        bytes,
+    }
+}
+
+fn hex(hasher: Sha256) -> String {
+    format!("{:x}", hasher.finalize())
+}
