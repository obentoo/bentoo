+// Story 044, task 3.1 — model download with progress, cancel and verification (R6.2, R6.4, R6.5,
+// R6.6, R6.9, R10.2; Q17). Integration test: `cargo test -p voice_input --test download`.
+//
+// Contract (design.md C1.3): `voice_input::download::download_model(http: Arc<dyn HttpClient>,
+// spec: &'static ModelSpec, dir: PathBuf, progress: impl Fn(u64) + Send + 'static,
+// cancel: oneshot::Receiver<()>) -> Result<PathBuf, DownloadError>`, with
+// `DownloadError::{Cancelled, Http(_), Io(_), Mismatch { model, expected, got, bytes }}` and a
+// `Display` naming the model. The URL is `models::url(spec)`. Assumed public paths — adjust the
+// `use` only. Dev-dependencies: `http_client/test-support`, `tempfile`, `sha2` (normal dep).
+//
+// Driven with `futures::executor::block_on`: `download_model` takes no executor, so nothing here
+// depends on gpui's scheduler. A watchdog thread turns a hang into a failure.
+//
+// Hostile halves: the exact body is accepted AND the same size with one byte changed is refused;
+// one byte short AND one byte long are refused; an oversize body is aborted as soon as it passes the
+// pinned size (a body that never ends must not hang the download); a cancel halfway AND a future
+// dropped halfway (the "kill") leave neither the final file nor a staging file (Q17); redirects are
+// followed (Hugging Face answers 302 to its CDN).
+
+use std::{
+    path::Path,
+    pin::Pin,
+    sync::{Arc, Mutex},
+    task::{Context, Poll},
+    thread,
+    time::Duration,
+};
+
+use futures::{AsyncRead, FutureExt as _, channel::oneshot, future::Either};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Method, RedirectPolicy, Response};
+use sha2::{Digest as _, Sha256};
+use voice_input::download::{DownloadError, download_model};
+use voice_input::models::{ModelSpec, VoiceModel, url};
+
+const FILE: &str = "ggml-test.bin";
+
+fn body(len: usize) -> Vec<u8> {
+    (0..len).map(|i| (i * 31 % 251) as u8).collect()
+}
+
+fn sha_hex(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+
+fn test_spec(bytes: &[u8]) -> &'static ModelSpec {
+    Box::leak(Box::new(ModelSpec {
+        model: VoiceModel::Tiny,
+        file: FILE,
+        size: bytes.len() as u64,
+        sha256: Box::leak(sha_hex(bytes).into_boxed_str()),
+    }))
+}
+
+#[derive(Clone, Debug)]
+struct Seen {
+    uri: String,
+    method: Method,
+    redirects: Option<RedirectPolicy>,
+}
+
+type Log = Arc<Mutex<Vec<Seen>>>;
+
+fn client(
+    status: u16,
+    make_body: impl Fn() -> AsyncBody + Send + Sync + 'static,
+) -> (Arc<dyn HttpClient>, Log) {
+    let log: Log = Arc::default();
+    let seen = log.clone();
+    let make_body = Arc::new(make_body);
+    let http = FakeHttpClient::create(move |req| {
+        seen.lock().expect("lock").push(Seen {
+            uri: req.uri().to_string(),
+            method: req.method().clone(),
+            redirects: req.extensions().get::<RedirectPolicy>().cloned(),
+        });
+        let make_body = make_body.clone();
+        async move { Ok(Response::builder().status(status).body(make_body())?) }
+    });
+    (http, log)
+}
+
+fn serving(bytes: Vec<u8>) -> (Arc<dyn HttpClient>, Log) {
+    client(200, move || AsyncBody::from(bytes.clone()))
+}
+
+/// Yields `data`, then pends forever (never EOF) after signalling `reached`.
+struct Stalling {
+    data: Vec<u8>,
+    pos: usize,
+    reached: Option<oneshot::Sender<()>>,
+}
+
+impl AsyncRead for Stalling {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        buf: &mut [u8],
+    ) -> Poll<std::io::Result<usize>> {
+        if self.pos < self.data.len() {
+            let n = buf.len().min(self.data.len() - self.pos).min(4096);
+            let start = self.pos;
+            buf[..n].copy_from_slice(&self.data[start..start + n]);
+            self.pos += n;
+            return Poll::Ready(Ok(n));
+        }
+        if let Some(tx) = self.reached.take() {
+            let _ = tx.send(());
+        }
+        Poll::Pending
+    }
+}
+
+fn stalling_client(data: Vec<u8>) -> (Arc<dyn HttpClient>, Log, oneshot::Receiver<()>) {
+    let (tx, rx) = oneshot::channel();
+    let tx = Arc::new(Mutex::new(Some(tx)));
+    let (http, log) = client(200, move || {
+        AsyncBody::from_reader(Stalling {
+            data: data.clone(),
+            pos: 0,
+            reached: tx.lock().expect("lock").take(),
+        })
+    });
+    (http, log, rx)
+}
+
+fn block_on_with_watchdog<T>(fut: impl std::future::Future<Output = T>) -> T {
+    let (tx, rx) = oneshot::channel::<()>();
+    thread::spawn(move || {
+        thread::sleep(Duration::from_secs(20));
+        let _ = tx.send(());
+    });
+    match futures::executor::block_on(futures::future::select(Box::pin(fut), rx)) {
+        Either::Left((out, _)) => out,
+        Either::Right(_) => panic!("the download hung for 20 s"),
+    }
+}
+
+fn leftovers(dir: &Path) -> Vec<String> {
+    match std::fs::read_dir(dir) {
+        Ok(entries) => entries
+            .filter_map(|e| e.ok())
+            .map(|e| e.file_name().to_string_lossy().into_owned())
+            .collect(),
+        Err(_) => Vec::new(),
+    }
+}
+
+fn never_cancelled() -> oneshot::Receiver<()> {
+    let (tx, rx) = oneshot::channel();
+    std::mem::forget(tx);
+    rx
+}
+
+#[test]
+fn download_success_verifies_and_renames_into_place() {
+    let bytes = body(300_000);
+    let spec = test_spec(&bytes);
+    let (http, log) = serving(bytes.clone());
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let dir = tmp.path().join("voice").join("models"); // created by the download
+    let progress: Arc<Mutex<Vec<u64>>> = Arc::default();
+    let p = progress.clone();
+    let path = block_on_with_watchdog(download_model(
+        http,
+        spec,
+        dir.clone(),
+        move |n| p.lock().expect("lock").push(n),
+        never_cancelled(),
+    ))
+    .expect("the pinned bytes are accepted");
+
+    assert_eq!(path, dir.join(FILE));
+    assert_eq!(std::fs::read(&path).expect("final file"), bytes);
+    assert_eq!(
+        leftovers(&dir),
+        vec![FILE.to_string()],
+        "no staging file left"
+    );
+    let seen = log.lock().expect("lock").clone();
+    assert_eq!(seen.len(), 1, "one request");
+    assert_eq!(seen[0].uri, url(spec), "the pinned URL");
+    assert_eq!(seen[0].method, Method::GET);
+    assert_eq!(
+        seen[0].redirects,
+        Some(RedirectPolicy::FollowAll),
+        "the CDN redirect is followed"
+    );
+    let progress = progress.lock().expect("lock").clone();
+    assert!(
+        progress.windows(2).all(|w| w[0] <= w[1]),
+        "monotonic: {progress:?}"
+    );
+    assert!(
+        progress.iter().all(|n| *n <= spec.size),
+        "never past the pinned size: {progress:?}"
+    );
+}
+
+#[test]
+fn download_same_size_wrong_digest_is_a_mismatch_and_deleted() {
