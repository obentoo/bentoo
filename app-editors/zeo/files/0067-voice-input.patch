index 0000000..c4394f2
--- /dev/null
+++ b/crates/voice_input/src/transcript.rs
@@ -0,0 +1,56 @@
+//! Transcript cleaning and spacing before insertion into the composer (R4.2, R4.3).
+
+/// Removes whisper's non-speech annotations (`[BLANK_AUDIO]`, `[Music]`, `(music)`,
+/// `(silence)`), collapses runs of whitespace to one space and trims (R4.3).
+///
+/// A bracketed or parenthesised span counts as an annotation only when it stands alone in a
+/// segment: it opens at the start of the transcript, after sentence-ending punctuation or after
+/// another annotation, and it is followed by whitespace or the end. Brackets that are part of
+/// speech ("array [i]", "f(x)") are kept.
+pub fn clean(raw: &str) -> String {
+    let mut kept = String::with_capacity(raw.len());
+    let mut at_segment_start = true;
+    let mut rest = raw;
+    while let Some(c) = rest.chars().next() {
+        if at_segment_start && let Some(len) = annotation_len(rest) {
+            rest = &rest[len..];
+            continue;
+        }
+        if !c.is_whitespace() {
+            at_segment_start = matches!(c, '.' | '!' | '?' | '…');
+        }
+        kept.push(c);
+        rest = &rest[c.len_utf8()..];
+    }
+    kept.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+/// Byte length of the annotation `text` starts with: a `[...]` or `(...)` span with non-blank,
+/// unnested content, followed by whitespace or the end of `text`.
+fn annotation_len(text: &str) -> Option<usize> {
+    let close = match text.chars().next()? {
+        '[' => ']',
+        '(' => ')',
+        _ => return None,
+    };
+    let inner_end = 1 + text[1..].find(close)?;
+    let inner = &text[1..inner_end];
+    if inner.trim().is_empty() || inner.contains(['[', '(', ']', ')']) {
+        return None;
+    }
+    let len = inner_end + close.len_utf8();
+    match text[len..].chars().next() {
+        None => Some(len),
+        Some(next) if next.is_whitespace() => Some(len),
+        Some(_) => None,
+    }
+}
+
+/// Prefixes one space when the character before the cursor is not whitespace (R4.2). An empty
+/// transcript stays empty, so nothing is inserted (R4.6).
+pub fn for_insertion(previous: Option<char>, cleaned: &str) -> String {
+    match previous {
+        Some(c) if !c.is_whitespace() && !cleaned.is_empty() => format!(" {cleaned}"),
+        _ => cleaned.to_string(),
+    }
+}
