+
+/// What this view knows of the voice shortcut that a key press left held.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum VoiceShortcut {
+    #[default]
+    Released,
+    /// `ToggleRecording` ran; the keystroke observer, which runs right after the action, says
+    /// which chord pressed it.
+    Pressed,
+    /// Held with these modifiers: letting go of every one of them is a release too.
+    Held(gpui::Modifiers),
+    /// Released by letting go of these modifiers while the key may still be down. Wayland
+    /// repeats a held key by replaying the keystroke of its press, modifiers included, until the
