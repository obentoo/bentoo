+        let client = Self::without_proxy_builder(&user_agent).build()?;
+        let mut client: ReqwestClient = client.into();
+        client.user_agent = Some(user_agent);
+        Ok(client)
+    }
+
+    /// The configuration of [`ReqwestClient::without_proxy`], before it is built.
+    fn without_proxy_builder(user_agent: &HeaderValue) -> reqwest::ClientBuilder {
+        let mut map = HeaderMap::new();
+        map.insert(http::header::USER_AGENT, user_agent.clone());
+        // `localhost` is answered here rather than by the system resolver, which on some hosts
+        // sends it to DNS with a search domain appended. Port 0 keeps the URL's own port.
+        let loopback = [
+            SocketAddr::from((Ipv6Addr::LOCALHOST, 0)),
+            SocketAddr::from((Ipv4Addr::LOCALHOST, 0)),
+        ];
+        Self::builder(None)
+            .no_proxy()
+            .resolve_to_addrs("localhost", &loopback)
+            .default_headers(map)
+            .use_preconfigured_tls(http_client_tls::tls_config())
+    }
 }
 
