+}
diff --git a/crates/agent_ui/src/voice_download_adopt_ui_tests.rs b/crates/agent_ui/src/voice_download_adopt_ui_tests.rs
new file mode 100644
index 0000000..494af2c
--- /dev/null
+++ b/crates/agent_ui/src/voice_download_adopt_ui_tests.rs
@@ -0,0 +1,232 @@
+// Story 044, task 8.5 fix round 1 — the tech review's I1 (.draft/reports/8.5-tech-review-rust-gpui.md):
+// R6.15 must be reachable from the real composer, not only through an input sent to the entity.
+// Wired in the crate root `src/agent_ui.rs` beside the other voice suites. Validation filter:
+// `voice_download_adopt_ui` (every test path is `voice_download_adopt_ui_tests::…`).
+//
+// A disabled button delivers no click (`button_like.rs` filters `on_click` on `disabled`), so a
+// composer showing `Busy` for a download whose thread is gone could never adopt it with the mouse.
+// Once the confirming composer is closed, every other composer shows the download's progress and
+// its Cancel, and that Cancel cancels it.
+//
+// Hostile halves: while the confirming thread is open, another composer is still busy (no strip);
+// once it is closed, the other composer draws the progress strip AND its Cancel, clicked with the
+// mouse, ends the download (the body reader is dropped, one request, idle again).
+
+use std::{
+    collections::VecDeque,
+    pin::Pin,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    task::{Context, Poll, Waker},
+    time::{Duration, Instant},
+};
+
+use futures::AsyncRead;
+use gpui::{AppContext as _, Modifiers, TestAppContext, VisualTestContext};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use voice_input::state::Input;
+use voice_input::{ViewState, VoiceInput};
+
+use crate::voice_button::{send, voice_owner};
+use crate::voice_keys_tests::{Thread, init_voice, open_thread};
+
+/// Local mode with no model on disk: the first press asks for the download (R6.1).
+const LOCAL_SETTINGS: &str = r#"{ "voice_input": { "model": "tiny" } }"#;
+const CANCEL: &str = "voice-input-download-cancel";
+/// Longer than the download's 250 ms progress interval, so the next bytes are reported.
+const PROGRESS_INTERVAL: Duration = Duration::from_millis(300);
+
+// ── a download body fed by the test ─────────────────────────────────────────
+
+#[derive(Default)]
+struct Feed {
+    queue: VecDeque<u8>,
+    waker: Option<Waker>,
+    read: u64,
+    dropped: bool,
+}
+
+#[derive(Clone, Default)]
+struct Body(Arc<Mutex<Feed>>);
+
+impl Body {
+    fn push(&self, bytes: usize) {
+        let mut feed = self.0.lock().expect("lock");
+        feed.queue.extend(std::iter::repeat_n(0x5a, bytes));
+        if let Some(waker) = feed.waker.take() {
+            waker.wake();
+        }
+    }
+    fn read(&self) -> u64 {
+        self.0.lock().expect("lock").read
+    }
+    fn dropped(&self) -> bool {
+        self.0.lock().expect("lock").dropped
+    }
+}
+
+struct Reader(Body);
+
+impl AsyncRead for Reader {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut [u8],
+    ) -> Poll<std::io::Result<usize>> {
+        let mut feed = (self.0).0.lock().expect("lock");
+        if feed.queue.is_empty() {
+            feed.waker = Some(cx.waker().clone());
+            return Poll::Pending;
+        }
+        let count = buf.len().min(feed.queue.len());
+        for (slot, byte) in buf.iter_mut().zip(feed.queue.drain(..count)) {
+            *slot = byte;
+        }
+        feed.read += count as u64;
+        Poll::Ready(Ok(count))
+    }
+}
+
+impl Drop for Reader {
+    fn drop(&mut self) {
+        if let Ok(mut feed) = (self.0).0.lock() {
+            feed.dropped = true;
+        }
+    }
+}
+
+fn fed_download(body: &Body, requests: &Arc<AtomicUsize>) -> Arc<dyn HttpClient> {
+    let body = body.clone();
+    let requests = requests.clone();
+    FakeHttpClient::create(move |_| {
+        requests.fetch_add(1, Ordering::SeqCst);
+        let reader = Reader(body.clone());
+        async move {
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from_reader(reader))?)
+        }
+    })
+}
+
+// ── helpers ─────────────────────────────────────────────────────────────────
+
+fn view_state(thread: &Thread, cx: &TestAppContext) -> ViewState {
+    let owner = thread.view(cx).entity_id();
+    cx.read(|cx| VoiceInput::global(cx).read(cx).view_state(owner))
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+/// Feeds `bytes` and waits until the download has read them; each read is a progress update,
+/// which re-renders every composer.
+fn feed(body: &Body, bytes: usize, cx: &mut TestAppContext) {
+    let target = body.read() + bytes as u64;
+    body.push(bytes);
+    wait_until(cx, "the download to read the fed bytes", |_| {
+        body.read() >= target
+    });
+}
+
+// ── I1 ──────────────────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn voice_download_adopt_ui_a_closed_threads_download_shows_its_cancel_in_another_composer(
+    cx: &mut TestAppContext,
+) {
+    let body = Body::default();
+    let requests = Arc::new(AtomicUsize::new(0));
+    let _voice = init_voice(LOCAL_SETTINGS, fed_download(&body, &requests), cx);
+
+    // Thread A asks for the model and the user confirms there.
+    let a = open_thread(cx).await;
+    let owner_a = voice_owner(a.view(cx).entity_id());
+    cx.update(|cx| send(Input::Click { owner: owner_a }, cx));
+    cx.run_until_parked();
+    assert!(
+        matches!(view_state(&a, cx), ViewState::AwaitingConsent { .. }),
+        "precondition: A is asked for consent: {:?}",
+        view_state(&a, cx)
+    );
+    cx.update(|cx| send(Input::ConsentGiven, cx));
+    wait_until(cx, "the download request", |_| {
+        requests.load(Ordering::SeqCst) == 1
+    });
+    feed(&body, 64 * 1024, cx);
+    assert!(
+        matches!(view_state(&a, cx), ViewState::Downloading { .. }),
+        "precondition: A's download runs: {:?}",
+        view_state(&a, cx)
+    );
+
+    // While A is open, B is busy: the download is A's.
+    let b = open_thread(cx).await;
+    let mut vcx_b: VisualTestContext = b.vcx(cx);
+    vcx_b.run_until_parked();
+    assert!(
+        matches!(view_state(&b, cx), ViewState::Busy),
+        "R5.1 B is busy while A, open, downloads: {:?}",
+        view_state(&b, cx)
+    );
+    assert!(
+        vcx_b.debug_bounds(CANCEL).is_none(),
+        "no strip in B while A owns the download"
+    );
+
+    // A is closed: its window removed and every strong handle the test holds dropped.
+    let a_view = a.view(cx).downgrade();
+    cx.update_window(a.window, |_, window, _| window.remove_window())
+        .expect("close A");
+    drop(a);
+    // The released window's entities go at the next effect flush.
+    cx.update(|_| {});
+    cx.run_until_parked();
+    assert!(
+        a_view.upgrade().is_none(),
+        "precondition: A's thread view is released"
+    );
+    // Progress is reported at most every 250 ms; the next report re-renders every composer.
+    std::thread::sleep(PROGRESS_INTERVAL);
+    feed(&body, 64 * 1024, cx);
+
+    assert!(
+        matches!(view_state(&b, cx), ViewState::Downloading { .. }),
+        "R6.15 B shows the kept download, not busy for a thread that is gone: {:?}",
+        view_state(&b, cx)
+    );
+    vcx_b.run_until_parked();
+    let cancel = vcx_b
+        .debug_bounds(CANCEL)
+        .expect("R6.3 B's strip draws the download's Cancel");
+    assert!(!body.dropped(), "R6.14 the download still runs");
+
+    vcx_b.simulate_click(cancel.center(), Modifiers::default());
+    vcx_b.run_until_parked();
+    wait_until(cx, "the download to stop", |_| body.dropped());
+    assert!(
+        matches!(view_state(&b, cx), ViewState::Idle { .. }),
+        "R6.6 idle after B's Cancel: {:?}",
+        view_state(&b, cx)
+    );
+    assert_eq!(
+        requests.load(Ordering::SeqCst),
+        1,
+        "one request, never restarted"
+    );
+}
diff --git a/crates/agent_ui/src/voice_events_more_tests.rs b/crates/agent_ui/src/voice_events_more_tests.rs
