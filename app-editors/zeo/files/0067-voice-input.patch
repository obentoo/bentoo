index 0000000..9ab0e6a
--- /dev/null
+++ b/crates/voice_input/src/state.rs
@@ -0,0 +1,401 @@
+//! The voice-input state machine: what every input means, with no I/O and no gpui.
+
+use std::time::{Duration, Instant};
+
+/// The composer a request belongs to; the entity builds it from `EntityId::as_u64()`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct Owner(pub u64);
+
+/// How a recording stops: `Pending` until a shortcut press is resolved into a tap or a hold.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Mode {
+    Pending(Instant),
+    Toggle,
+    Hold,
+}
+
+/// What started the recording while the device is being opened.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Via {
+    Click,
+    Shortcut { pressed_at: Instant, released: bool },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Phase {
+    Idle,
+    AwaitingConsent {
+        owner: Owner,
+    },
+    Downloading {
+        owner: Owner,
+        bytes: u64,
+    },
+    Starting {
+        owner: Owner,
+        via: Via,
+    },
+    Recording {
+        owner: Owner,
+        mode: Mode,
+        started: Instant,
+    },
+    Transcribing {
+        owner: Owner,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Input {
+    Click { owner: Owner },
+    ShortcutDown { owner: Owner },
+    ShortcutUp { owner: Owner },
+    Cancel { owner: Owner },
+    WindowDeactivated { owner: Owner },
+    CaptureStarted,
+    CaptureFailed(String),
+    CaptureLimit,
+    CaptureDeviceError(String),
+    Transcribed { text: String },
+    TranscribeFailed(String),
+    ConsentGiven,
+    ConsentDeclined,
+    DownloadProgress(u64),
+    DownloadDone,
+    DownloadFailed(String),
+    DownloadCancel,
+    AdoptDownload { owner: Owner },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Effect {
+    StartCapture,
+    StopCapture,
+    CancelCapture,
+    AskConsent,
+    StartDownload,
+    CancelDownload,
+    Transcribe { mode: Mode },
+    Insert { owner: Owner, text: String },
+    Notify { owner: Owner, message: String },
+    Busy { owner: Owner },
+    Render,
+}
+
+/// What the entity knows about the requesting composer and the settings at input time.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Ctx {
+    pub enabled: bool,
+    pub remote: bool,
+    /// `resolve_model(..).is_some()` for the configured local model.
+    pub model_present: bool,
+    pub composer_read_only: bool,
+}
+
+#[derive(Debug)]
+pub struct Machine {
+    phase: Phase,
+    shortcut_down: bool,
+}
+
+impl Default for Machine {
+    fn default() -> Self {
+        Self {
+            phase: Phase::Idle,
+            shortcut_down: false,
+        }
+    }
+}
+
+/// A shortcut released within this long of its press is a tap (toggle); longer is a hold (R2.2, R3.1).
+pub const TAP_WINDOW: Duration = Duration::from_millis(300);
+
+const NO_MICROPHONE: &str = "No microphone available";
+const MICROPHONE_STOPPED: &str = "The microphone stopped";
+const LIMIT_REACHED: &str = "Recording stopped at the 2-minute limit";
+const NO_SPEECH: &str = "No speech was recognised";
+
+impl Machine {
+    pub fn phase(&self) -> &Phase {
+        &self.phase
+    }
+
+    /// Applies one input and returns what the caller must do. Inputs that do not apply to the
+    /// current phase return no effect. A `Render` is appended whenever the phase changed.
+    pub fn on(&mut self, input: Input, now: Instant, ctx: &Ctx) -> Vec<Effect> {
+        let before = self.phase.clone();
+        let mut effects = self.apply(input, now, ctx);
+        if self.phase != before && !effects.contains(&Effect::Render) {
+            effects.push(Effect::Render);
+        }
+        effects
+    }
+
+    fn apply(&mut self, input: Input, now: Instant, ctx: &Ctx) -> Vec<Effect> {
+        match input {
+            Input::Click { owner } => self.start_input(owner, Via::Click, ctx),
+            Input::ShortcutDown { owner } => {
+                // X11 delivers auto-repeat as fresh key-downs with `is_held: false`, so the
+                // machine, not the event, knows whether the key is already down (R3.2).
+                if self.shortcut_down {
+                    return Vec::new();
+                }
+                self.shortcut_down = true;
+                let via = Via::Shortcut {
+                    pressed_at: now,
+                    released: false,
+                };
+                self.start_input(owner, via, ctx)
+            }
+            Input::ShortcutUp { .. } => {
+                self.shortcut_down = false;
+                self.shortcut_released(now)
+            }
+            Input::Cancel { owner } => match self.phase {
+                Phase::Recording { owner: current, .. } if current == owner => {
+                    self.phase = Phase::Idle;
+                    vec![Effect::CancelCapture]
+                }
+                _ => Vec::new(),
+            },
+            Input::WindowDeactivated { owner } => {
+                // The key-up of a shortcut held across the focus loss goes to another window,
+                // so the next press here is a fresh one, not a repeat (R3.2, R3.3).
+                self.shortcut_down = false;
+                self.window_deactivated(owner, now)
+            }
+            Input::CaptureStarted => match self.phase {
+                Phase::Starting { owner, via } => {
+                    let mode = match via {
+                        Via::Shortcut {
+                            pressed_at,
+                            released: false,
+                        } => Mode::Pending(pressed_at),
+                        // A tap released before the device opened is still a tap (R2.2).
+                        Via::Shortcut { released: true, .. } | Via::Click => Mode::Toggle,
+                    };
+                    self.phase = Phase::Recording {
+                        owner,
+                        mode,
+                        started: now,
+                    };
+                    Vec::new()
+                }
+                _ => Vec::new(),
+            },
+            Input::CaptureFailed(reason) => match self.phase {
+                Phase::Starting { owner, .. } => {
+                    self.phase = Phase::Idle;
+                    vec![notify(owner, format!("{NO_MICROPHONE}: {reason}"))]
+                }
+                _ => Vec::new(),
+            },
+            Input::CaptureLimit => self.stop_with_notice(now, LIMIT_REACHED.to_string()),
+            Input::CaptureDeviceError(reason) => {
+                self.stop_with_notice(now, format!("{MICROPHONE_STOPPED}: {reason}"))
+            }
+            Input::Transcribed { text } => match self.phase {
+                Phase::Transcribing { owner } => {
+                    self.phase = Phase::Idle;
+                    let text = crate::transcript::clean(&text);
+                    if text.is_empty() {
+                        vec![notify(owner, NO_SPEECH.to_string())]
+                    } else {
+                        vec![Effect::Insert { owner, text }]
+                    }
+                }
+                _ => Vec::new(),
+            },
+            Input::TranscribeFailed(message) => match self.phase {
+                Phase::Transcribing { owner } => {
+                    self.phase = Phase::Idle;
+                    vec![notify(owner, message)]
+                }
+                _ => Vec::new(),
+            },
+            Input::ConsentGiven => match self.phase {
+                Phase::AwaitingConsent { owner } => {
+                    self.phase = Phase::Downloading { owner, bytes: 0 };
+                    vec![Effect::StartDownload]
+                }
+                _ => Vec::new(),
+            },
+            Input::ConsentDeclined => match self.phase {
+                Phase::AwaitingConsent { .. } => {
+                    self.phase = Phase::Idle;
+                    Vec::new()
+                }
+                _ => Vec::new(),
+            },
+            Input::DownloadProgress(downloaded) => match &mut self.phase {
+                Phase::Downloading { bytes, .. } => {
+                    *bytes = downloaded;
+                    vec![Effect::Render]
+                }
+                _ => Vec::new(),
+            },
+            Input::DownloadDone => match self.phase {
+                // Recording is not started here: the moment of consent is not the moment the
+                // user is ready to speak.
+                Phase::Downloading { .. } => {
+                    self.phase = Phase::Idle;
+                    vec![Effect::Render]
+                }
+                _ => Vec::new(),
+            },
+            Input::DownloadFailed(message) => match self.phase {
+                Phase::Downloading { owner, .. } => {
+                    self.phase = Phase::Idle;
+                    vec![notify(owner, message)]
+                }
+                _ => Vec::new(),
+            },
+            Input::DownloadCancel => match self.phase {
+                Phase::Downloading { .. } => {
+                    self.phase = Phase::Idle;
+                    vec![Effect::CancelDownload]
+                }
+                _ => Vec::new(),
+            },
+            Input::AdoptDownload { owner } => match &mut self.phase {
+                // The download outlives the composer that confirmed it: the next composer to
+                // start voice input takes it over, progress and all (R6.14, R6.15).
+                Phase::Downloading { owner: current, .. } => {
+                    *current = owner;
+                    vec![Effect::Render]
+                }
+                _ => Vec::new(),
+            },
+        }
+    }
+
+    /// A click or a fresh shortcut press: starts from `Idle`, stops a running toggle, and is
+    /// refused as busy for any other owner (R5.1).
+    fn start_input(&mut self, owner: Owner, via: Via, ctx: &Ctx) -> Vec<Effect> {
+        // A composer can turn read-only, or the feature be disabled, while its own recording
+        // runs; the guard below refuses starts only, so the owner can still stop (R1.3, R2.3).
+        if let Phase::Recording {
+            owner: current,
+            mode,
+            ..
+        } = self.phase
+            && current == owner
+        {
+            // Only a click reaches `Pending` here (a shortcut press there is a repeat), and it
+            // stops like a toggle stop (R2.3).
+            let mode = match mode {
+                Mode::Hold => Mode::Hold,
+                Mode::Pending(_) | Mode::Toggle => Mode::Toggle,
+            };
+            return self.stop(owner, mode);
+        }
+        if !ctx.enabled || ctx.composer_read_only {
+            return Vec::new();
+        }
+        match self.phase {
+            Phase::Idle => {
+                if !ctx.remote && !ctx.model_present {
+                    self.phase = Phase::AwaitingConsent { owner };
+                    vec![Effect::AskConsent]
+                } else {
+                    self.phase = Phase::Starting { owner, via };
+                    vec![Effect::StartCapture]
+                }
+            }
+            Phase::AwaitingConsent { owner: current }
+            | Phase::Downloading { owner: current, .. }
+            | Phase::Starting { owner: current, .. }
+            | Phase::Transcribing { owner: current }
+                if current != owner =>
+            {
+                vec![Effect::Busy { owner }]
+            }
+            // The owner's own recording was stopped above.
+            Phase::Recording { .. } => vec![Effect::Busy { owner }],
+            // The owner's own start while consenting, downloading, opening the device or
+            // transcribing changes nothing (R5.2).
+            Phase::AwaitingConsent { .. }
+            | Phase::Downloading { .. }
+            | Phase::Starting { .. }
+            | Phase::Transcribing { .. } => Vec::new(),
+        }
+    }
+
+    fn shortcut_released(&mut self, now: Instant) -> Vec<Effect> {
+        match &mut self.phase {
+            Phase::Starting {
+                via: Via::Shortcut { released, .. },
+                ..
+            } => {
+                *released = true;
+                Vec::new()
+            }
+            Phase::Recording {
+                owner,
+                mode: mode @ Mode::Pending(_),
+                ..
+            } => match settled(*mode, now) {
+                Mode::Hold => {
+                    let owner = *owner;
+                    self.stop(owner, Mode::Hold)
+                }
+                settled_mode => {
+                    *mode = settled_mode;
+                    Vec::new()
+                }
+            },
+            Phase::Recording {
+                owner,
+                mode: Mode::Hold,
+                ..
+            } => {
+                let owner = *owner;
+                self.stop(owner, Mode::Hold)
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn window_deactivated(&mut self, owner: Owner, now: Instant) -> Vec<Effect> {
+        match self.phase {
+            Phase::Recording {
+                owner: current,
+                mode: mode @ (Mode::Pending(_) | Mode::Hold),
+                ..
+            } if current == owner => self.stop(current, settled(mode, now)),
+            _ => Vec::new(),
+        }
+    }
+
+    fn stop(&mut self, owner: Owner, mode: Mode) -> Vec<Effect> {
+        self.phase = Phase::Transcribing { owner };
+        vec![Effect::StopCapture, Effect::Transcribe { mode }]
+    }
+
+    fn stop_with_notice(&mut self, now: Instant, message: String) -> Vec<Effect> {
+        match self.phase {
+            Phase::Recording { owner, mode, .. } => {
+                let mut effects = self.stop(owner, settled(mode, now));
+                effects.push(notify(owner, message));
+                effects
+            }
+            _ => Vec::new(),
+        }
+    }
+}
+
+/// Resolves a `Pending` press into the mode it has become by `now`: within the tap window it is
+/// a toggle, past it a hold.
+fn settled(mode: Mode, now: Instant) -> Mode {
+    match mode {
+        Mode::Pending(pressed_at) if now.saturating_duration_since(pressed_at) <= TAP_WINDOW => {
+            Mode::Toggle
+        }
+        Mode::Pending(_) => Mode::Hold,
+        mode => mode,
+    }
+}
+
+fn notify(owner: Owner, message: String) -> Effect {
+    Effect::Notify { owner, message }
+}
diff --git a/crates/voice_input/src/state_release_tests.rs b/crates/voice_input/src/state_release_tests.rs
new file mode 100644
index 0000000..2f5e8e0
--- /dev/null
+++ b/crates/voice_input/src/state_release_tests.rs
@@ -0,0 +1,105 @@
+// Story 044, task 5.3 fix round 1 — a release seen twice. The thread view sends `ShortcutUp` both
+// for the key-up of the shortcut's key and for its modifiers being let go of (macOS delivers no
+// key-up while Cmd is held), so one physical release can arrive as two inputs. The second must
+// change nothing, whatever phase the first left behind (R2.2, R2.3, R3.1, R3.2).
+
+use std::time::{Duration, Instant};
+
+use crate::state::{Ctx, Effect, Input, Machine, Mode, Owner, Phase};
+
+const A: Owner = Owner(1);
+
+fn ready() -> Ctx {
+    Ctx {
+        enabled: true,
+        remote: false,
+        model_present: true,
+        composer_read_only: false,
+    }
+}
+
+fn ms(t0: Instant, n: u64) -> Instant {
+    t0 + Duration::from_millis(n)
+}
+
+fn stops(effects: &[Effect]) -> bool {
+    effects
+        .iter()
+        .any(|effect| matches!(effect, Effect::StopCapture))
+}
+
+#[test]
+fn state_release_seen_twice_after_a_hold_changes_nothing() {
+    let t0 = Instant::now();
+    let mut machine = Machine::default();
+    machine.on(Input::ShortcutDown { owner: A }, t0, &ready());
+    machine.on(Input::CaptureStarted, t0, &ready());
+    let first = machine.on(Input::ShortcutUp { owner: A }, ms(t0, 800), &ready());
+    assert!(stops(&first), "the first release ends the hold: {first:?}");
+    let second = machine.on(Input::ShortcutUp { owner: A }, ms(t0, 810), &ready());
+    assert!(
+        second.is_empty(),
+        "the second release is a no-op: {second:?}"
+    );
+    assert!(
+        matches!(machine.phase(), Phase::Transcribing { owner } if *owner == A),
+        "{:?}",
+        machine.phase()
+    );
+}
+
+#[test]
+fn state_release_seen_twice_after_a_tap_keeps_the_toggle() {
+    let t0 = Instant::now();
+    let mut machine = Machine::default();
+    machine.on(Input::ShortcutDown { owner: A }, t0, &ready());
+    machine.on(Input::CaptureStarted, t0, &ready());
+    machine.on(Input::ShortcutUp { owner: A }, ms(t0, 100), &ready());
+    // Past the tap window: a second release read as a hold's would stop the toggle.
+    let second = machine.on(Input::ShortcutUp { owner: A }, ms(t0, 900), &ready());
+    assert!(
+        second.is_empty(),
+        "the second release is a no-op: {second:?}"
+    );
+    assert!(
+        matches!(
+            machine.phase(),
+            Phase::Recording {
+                mode: Mode::Toggle,
+                ..
+            }
+        ),
+        "{:?}",
+        machine.phase()
+    );
+    let press = machine.on(Input::ShortcutDown { owner: A }, ms(t0, 3000), &ready());
+    assert!(
+        stops(&press),
+        "the next press is a fresh one and stops: {press:?}"
+    );
+}
+
+#[test]
+fn state_release_seen_twice_before_the_device_opened_is_still_a_tap() {
+    let t0 = Instant::now();
+    let mut machine = Machine::default();
+    machine.on(Input::ShortcutDown { owner: A }, t0, &ready());
+    machine.on(Input::ShortcutUp { owner: A }, ms(t0, 50), &ready());
+    let second = machine.on(Input::ShortcutUp { owner: A }, ms(t0, 60), &ready());
+    assert!(
+        second.is_empty(),
+        "the second release is a no-op: {second:?}"
+    );
+    machine.on(Input::CaptureStarted, ms(t0, 400), &ready());
+    assert!(
+        matches!(
+            machine.phase(),
+            Phase::Recording {
+                mode: Mode::Toggle,
+                ..
+            }
+        ),
+        "{:?}",
+        machine.phase()
+    );
+}
diff --git a/crates/voice_input/src/state_stop_tests.rs b/crates/voice_input/src/state_stop_tests.rs
new file mode 100644
index 0000000..1bfef03
--- /dev/null
+++ b/crates/voice_input/src/state_stop_tests.rs
@@ -0,0 +1,217 @@
+// Story 044, task 5.3 — a stop is never refused (R1.3, R2.3, R3.1). Wired in the crate root
+// `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod state_stop_tests;
+//
+// Validation filter: `state` (every test path is `state_stop_tests::…`).
+//
+// A composer can turn read-only, or the feature be disabled, while its own recording runs. The
+// read-only/disabled guard refuses starts only: a click or a fresh press from the recording owner,
+// and the release of a held shortcut, still stop and transcribe. A press after a focus loss is a
+// fresh press: the release of the held shortcut went to another window.
+//
+// Hostile halves: the owner's stop goes through while read-only AND a start from idle is still
+// refused; the owner's stop goes through while disabled AND another owner's input stays busy, not
+// a stop.
+
+use std::time::{Duration, Instant};
+
+use crate::state::{Ctx, Effect, Input, Machine, Mode, Owner, Phase};
+
+const A: Owner = Owner(1);
+const B: Owner = Owner(2);
+
+fn ready() -> Ctx {
+    Ctx {
+        enabled: true,
+        remote: false,
+        model_present: true,
+        composer_read_only: false,
+    }
+}
+
+fn read_only() -> Ctx {
+    Ctx {
+        composer_read_only: true,
+        ..ready()
+    }
+}
+
+fn disabled() -> Ctx {
+    Ctx {
+        enabled: false,
+        ..ready()
+    }
+}
+
+fn ms(t0: Instant, n: u64) -> Instant {
+    t0 + Duration::from_millis(n)
+}
+
+fn stops(effects: &[Effect]) -> bool {
+    effects.iter().any(|e| matches!(e, Effect::StopCapture))
+        && effects
+            .iter()
+            .any(|e| matches!(e, Effect::Transcribe { .. }))
+}
+
+fn starts(effects: &[Effect]) -> bool {
+    effects
+        .iter()
+        .any(|e| matches!(e, Effect::StartCapture | Effect::AskConsent))
+}
+
+/// A toggle recording for `A`, started while the composer was writable.
+fn toggle_recording(t0: Instant) -> Machine {
+    let mut m = Machine::default();
+    m.on(Input::Click { owner: A }, t0, &ready());
+    m.on(Input::CaptureStarted, t0, &ready());
+    assert!(
+        matches!(
+            m.phase(),
+            Phase::Recording {
+                mode: Mode::Toggle,
+                ..
+            }
+        ),
+        "{:?}",
+        m.phase()
+    );
+    m
+}
+
+/// A held shortcut for `A` (still `Pending`), started while the composer was writable.
+fn held_recording(t0: Instant) -> Machine {
+    let mut m = Machine::default();
+    m.on(Input::ShortcutDown { owner: A }, t0, &ready());
+    m.on(Input::CaptureStarted, t0, &ready());
+    assert!(
+        matches!(
+            m.phase(),
+            Phase::Recording {
+                mode: Mode::Pending(_),
+                ..
+            }
+        ),
+        "{:?}",
+        m.phase()
+    );
+    m
+}
+
+#[test]
+fn state_click_stops_a_recording_whose_composer_turned_read_only() {
+    let t0 = Instant::now();
+    let mut m = toggle_recording(t0);
+    let e = m.on(Input::Click { owner: A }, ms(t0, 2000), &read_only());
+    assert!(
+        stops(&e),
+        "the owner's click stops even when read-only: {e:?}"
+    );
+    assert!(
+        matches!(m.phase(), Phase::Transcribing { owner } if *owner == A),
+        "{:?}",
+        m.phase()
+    );
+}
+
+#[test]
+fn state_fresh_press_stops_a_toggle_whose_composer_turned_read_only() {
+    let t0 = Instant::now();
+    let mut m = Machine::default();
+    m.on(Input::ShortcutDown { owner: A }, t0, &ready());
+    m.on(Input::CaptureStarted, t0, &ready());
+    m.on(Input::ShortcutUp { owner: A }, ms(t0, 100), &ready());
+    let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, 3000), &read_only());
+    assert!(
+        stops(&e),
+        "a fresh press stops the toggle even when read-only: {e:?}"
+    );
+}
+
+#[test]
+fn state_release_stops_a_hold_whose_composer_turned_read_only() {
+    let t0 = Instant::now();
+    let mut m = held_recording(t0);
+    let e = m.on(Input::ShortcutUp { owner: A }, ms(t0, 1500), &read_only());
+    assert!(
+        stops(&e),
+        "releasing a hold stops even when read-only: {e:?}"
+    );
+}
+
+#[test]
+fn state_click_stops_a_recording_after_the_feature_was_disabled() {
+    let t0 = Instant::now();
+    let mut m = toggle_recording(t0);
+    let e = m.on(Input::Click { owner: A }, ms(t0, 2000), &disabled());
+    assert!(
+        stops(&e),
+        "the owner's click stops even when disabled: {e:?}"
+    );
+}
+
+#[test]
+fn state_read_only_or_disabled_still_refuses_a_start() {
+    let t0 = Instant::now();
+    for ctx in [read_only(), disabled()] {
+        let mut m = Machine::default();
+        let e = m.on(Input::Click { owner: A }, t0, &ctx);
+        assert!(!starts(&e), "{ctx:?}: {e:?}");
+        let e = m.on(Input::ShortcutDown { owner: A }, t0, &ctx);
+        assert!(!starts(&e), "{ctx:?}: {e:?}");
+        assert!(matches!(m.phase(), Phase::Idle), "{:?}", m.phase());
+
+        // After a stop, the next start is refused again.
+        let mut m = toggle_recording(t0);
+        m.on(Input::Click { owner: A }, ms(t0, 1000), &ctx);
+        m.on(
+            Input::Transcribed {
+                text: "hello".into(),
+            },
+            ms(t0, 1100),
+            &ctx,
+        );
+        let e = m.on(Input::Click { owner: A }, ms(t0, 1200), &ctx);
+        assert!(!starts(&e), "{ctx:?}: a start after the stop: {e:?}");
+    }
+}
+
+#[test]
+fn state_another_owner_read_only_is_not_a_stop() {
+    let t0 = Instant::now();
+    let mut m = toggle_recording(t0);
+    for ctx in [read_only(), disabled()] {
+        let e = m.on(Input::Click { owner: B }, ms(t0, 1000), &ctx);
+        assert!(!stops(&e), "{ctx:?}: B cannot stop A's recording: {e:?}");
+    }
+    assert!(
+        matches!(m.phase(), Phase::Recording { owner, .. } if *owner == A),
+        "{:?}",
+        m.phase()
+    );
+}
+
+// The release of a shortcut held while the window lost focus goes to another application, so
+// the next press in Zeo is a fresh press, not a repeat of one still held (R3.2, R3.3).
+#[test]
+fn state_press_after_focus_loss_is_not_taken_for_a_repeat() {
+    let t0 = Instant::now();
+    let mut m = held_recording(t0);
+    let e = m.on(
+        Input::WindowDeactivated { owner: A },
+        ms(t0, 1000),
+        &ready(),
+    );
+    assert!(stops(&e), "focus loss stops the hold: {e:?}");
+    m.on(
+        Input::Transcribed {
+            text: "hello".into(),
+        },
+        ms(t0, 1100),
+        &ready(),
+    );
+    let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, 5000), &ready());
+    assert!(starts(&e), "the next press starts a new recording: {e:?}");
+}
diff --git a/crates/voice_input/src/state_tests.rs b/crates/voice_input/src/state_tests.rs
new file mode 100644
index 0000000..c6ee814
--- /dev/null
+++ b/crates/voice_input/src/state_tests.rs
@@ -0,0 +1,671 @@
+// Story 044, task 2.3 — the pure state machine (R2.1, R2.2, R2.3, R2.5, R2.6, R3.1, R3.2, R3.3,
+// R4.6, R5.1, R5.2, R6.1, R6.7, R9.1, R9.2). Wired in the crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod state_tests;
+//
+// Validation filter: `state` (every test path is `state_tests::…`).
+//
+// Contract (design.md C1.9). Assumed shapes — adjust the `use` only:
+//   - `Machine::default()`, `Machine::on(&mut self, Input, Instant, &Ctx) -> Vec<Effect>`,
+//     `Machine::phase(&self) -> &Phase` (read-only accessor for tests and `view_state`).
+//   - `Owner` is a `Copy + Eq + Debug` newtype `Owner(pub u64)` (the machine has no gpui; the
+//     entity maps `EntityId::as_u64()` onto it).
+//   - `Mode { Pending(Instant), Toggle, Hold }`, used by `Phase::Recording { mode, .. }` and
+//     `Effect::Transcribe { mode }`.
+//   - `Ctx { enabled, remote, model_present, composer_read_only }`, all `bool`.
+//
+// Hostile halves: the 300 ms rule at 299/300/301 ms; key repeats ignored AND a fresh press after
+// the release accepted; a non-owner's start refused as busy AND the owner's own click stopping;
+// a tap released before the capture has even started still toggles; Cancel from another owner
+// does not discard this owner's audio; focus loss stops a hold AND leaves a toggle running.
+
+use std::time::{Duration, Instant};
+
+use crate::state::{Ctx, Effect, Input, Machine, Mode, Owner, Phase};
+
+const A: Owner = Owner(1);
+const B: Owner = Owner(2);
+
+fn local_ready() -> Ctx {
+    Ctx {
+        enabled: true,
+        remote: false,
+        model_present: true,
+        composer_read_only: false,
+    }
+}
+
+fn ms(t0: Instant, n: u64) -> Instant {
+    t0 + Duration::from_millis(n)
+}
+
+fn has(effects: &[Effect], pred: impl Fn(&Effect) -> bool) -> bool {
+    effects.iter().any(pred)
+}
+
+fn starts_capture(e: &[Effect]) -> bool {
+    has(e, |e| matches!(e, Effect::StartCapture))
+}
+fn stops_capture(e: &[Effect]) -> bool {
+    has(e, |e| matches!(e, Effect::StopCapture))
+}
+fn transcribes(e: &[Effect]) -> bool {
+    has(e, |e| matches!(e, Effect::Transcribe { .. }))
+}
+fn notify_text(e: &[Effect], owner: Owner) -> Option<String> {
+    e.iter().find_map(|e| match e {
+        Effect::Notify { owner: o, message } if *o == owner => Some(message.to_string()),
+        _ => None,
+    })
+}
+
+fn is_idle(m: &Machine) -> bool {
+    matches!(m.phase(), Phase::Idle)
+}
+fn recording_mode(m: &Machine) -> Option<String> {
+    match m.phase() {
+        Phase::Recording { mode, .. } => Some(match mode {
+            Mode::Pending(_) => "pending".into(),
+            Mode::Toggle => "toggle".into(),
+            Mode::Hold => "hold".into(),
+        }),
+        _ => None,
+    }
+}
+
+/// Shortcut pressed at t0 and the capture reported started at t0; returns the machine in Pending.
+fn pressed(t0: Instant, ctx: &Ctx) -> Machine {
+    let mut m = Machine::default();
+    let e = m.on(Input::ShortcutDown { owner: A }, t0, ctx);
+    assert!(
+        starts_capture(&e),
+        "a press while idle starts the capture: {e:?}"
+    );
+    m.on(Input::CaptureStarted, t0, ctx);
+    assert_eq!(
+        recording_mode(&m).as_deref(),
+        Some("pending"),
+        "{:?}",
+        m.phase()
+    );
+    m
+}
+
+/// Clicked at t0, capture started: Toggle.
+fn clicked(t0: Instant, ctx: &Ctx) -> Machine {
+    let mut m = Machine::default();
+    let e = m.on(Input::Click { owner: A }, t0, ctx);
+    assert!(
+        starts_capture(&e),
+        "a click while idle starts the capture: {e:?}"
+    );
+    m.on(Input::CaptureStarted, t0, ctx);
+    assert_eq!(
+        recording_mode(&m).as_deref(),
+        Some("toggle"),
+        "{:?}",
+        m.phase()
+    );
+    m
+}
+
+// ── R2.2 / R3.1: the 300 ms boundary, hostile first ─────────────────────────
+
+#[test]
+fn state_release_at_301_ms_is_hold_and_stops() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    let e = m.on(Input::ShortcutUp { owner: A }, ms(t0, 301), &ctx);
+    assert!(
+        stops_capture(&e) && transcribes(&e),
+        "301 ms is a hold: stop + transcribe: {e:?}"
+    );
+    assert!(
+        has(&e, |e| matches!(e, Effect::Transcribe { mode: Mode::Hold })),
+        "the transcription is tagged hold: {e:?}"
+    );
+    assert!(
+        matches!(m.phase(), Phase::Transcribing { owner } if *owner == A),
+        "{:?}",
+        m.phase()
+    );
+}
+
+#[test]
+fn state_release_at_300_ms_is_still_toggle() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    let e = m.on(Input::ShortcutUp { owner: A }, ms(t0, 300), &ctx);
+    assert!(
+        !stops_capture(&e),
+        "300 ms is the inclusive toggle edge: keep recording: {e:?}"
+    );
+    assert_eq!(recording_mode(&m).as_deref(), Some("toggle"));
+}
+
+#[test]
+fn state_release_at_299_ms_is_toggle() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    let e = m.on(Input::ShortcutUp { owner: A }, ms(t0, 299), &ctx);
+    assert!(!stops_capture(&e) && !transcribes(&e), "{e:?}");
+    assert_eq!(recording_mode(&m).as_deref(), Some("toggle"));
+}
+
+// ── R3.2: key repeat ignored, a fresh press after the release accepted ──────
+
+#[test]
+fn state_repeated_shortcut_down_while_held_is_ignored() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    // X11 auto-repeat arrives as fresh key-downs (is_held: false): none may toggle or stop.
+    for n in [30, 60, 90, 400, 900] {
+        let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, n), &ctx);
+        assert!(
+            e.iter().all(|e| matches!(e, Effect::Render)),
+            "repeat at {n} ms: {e:?}"
+        );
+    }
+    assert_eq!(
+        recording_mode(&m).as_deref(),
+        Some("pending"),
+        "still recording, not stopped"
+    );
+    let e = m.on(Input::ShortcutUp { owner: A }, ms(t0, 1000), &ctx);
+    assert!(
+        stops_capture(&e) && transcribes(&e),
+        "the release after a long hold stops: {e:?}"
+    );
+}
+
+#[test]
+fn state_fresh_press_after_release_stops_a_toggle() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    m.on(Input::ShortcutUp { owner: A }, ms(t0, 100), &ctx);
+    let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, 5000), &ctx);
+    assert!(
+        stops_capture(&e) && transcribes(&e),
+        "R2.3 a new press stops the toggle: {e:?}"
+    );
+    assert!(
+        has(&e, |e| matches!(
+            e,
+            Effect::Transcribe { mode: Mode::Toggle }
+        )),
+        "tagged toggle: {e:?}"
+    );
+}
+
+#[test]
+fn state_after_a_stop_the_next_press_starts_again() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
+    m.on(Input::ShortcutUp { owner: A }, ms(t0, 800), &ctx); // hold stop
+    m.on(
+        Input::Transcribed {
+            text: "hello".into(),
+        },
+        ms(t0, 900),
+        &ctx,
+    );
+    assert!(is_idle(&m), "{:?}", m.phase());
+    let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, 1000), &ctx);
+    assert!(
+        starts_capture(&e),
+        "a fresh press after the release starts a new recording: {e:?}"
+    );
+}
+
+// R2.2 derived: a tap released before the device has opened must still toggle.
+#[test]
+fn state_tap_released_before_capture_started_still_toggles() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = Machine::default();
+    m.on(Input::ShortcutDown { owner: A }, t0, &ctx);
+    m.on(Input::ShortcutUp { owner: A }, ms(t0, 80), &ctx);
+    m.on(Input::CaptureStarted, ms(t0, 120), &ctx);
+    assert!(
+        recording_mode(&m).is_some(),
+        "recording after the release: {:?}",
+        m.phase()
+    );
+    let e = m.on(Input::ShortcutDown { owner: A }, ms(t0, 3000), &ctx);
+    assert!(
+        stops_capture(&e) && transcribes(&e),
+        "the next press stops it (toggle): {e:?}"
+    );
+}
+
+// ── R2.1 / R2.3: click ───────────────────────────────────────────────────────
+
+#[test]
+fn state_click_toggles_on_and_off() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = clicked(t0, &ctx);
+    let e = m.on(Input::Click { owner: A }, ms(t0, 4000), &ctx);
+    assert!(stops_capture(&e) && transcribes(&e), "{e:?}");
+}
+
+#[test]
+fn state_click_while_pending_stops() {
+    let t0 = Instant::now();
+    let ctx = local_ready();
+    let mut m = pressed(t0, &ctx);
