+++ b/crates/voice_input/src/settings.rs
@@ -0,0 +1,84 @@
+use settings::{RegisterSetting, Settings, SettingsContent, VoiceModelContent};
+
+use crate::VoiceModel;
+
+/// The `voice_input` settings section.
+#[derive(Clone, Debug, PartialEq, Eq, RegisterSetting)]
+pub struct VoiceInputSettings {
+    /// Whether the composer shows the microphone button and binds the voice shortcut.
+    pub enabled: bool,
+    /// The local Whisper model.
+    pub model: VoiceModel,
+    /// The spoken language, or `Auto` to let the model detect it.
+    pub language: Language,
+    /// The optional remote transcription service.
+    pub remote: RemoteSettings,
+}
+
+/// The `voice_input.remote` settings subsection.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RemoteSettings {
+    /// Whether audio goes to the remote service instead of the local model. Off by default.
+    pub enabled: bool,
+    /// The transcription endpoint; `None` when unset.
+    pub url: Option<String>,
+    /// The model name sent to the remote service.
+    pub model: String,
+    /// The environment variable holding the API key (the key itself is never in settings).
+    pub api_key_env: String,
+}
+
+/// The language Whisper transcribes in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Language {
+    /// The model detects the spoken language.
+    Auto,
+    /// A two-letter lowercase language code, such as `en` or `pt`.
+    Code(String),
+}
+
+impl Language {
+    /// Parses `"auto"` or two ASCII lowercase letters. Anything else falls back to `Auto`
+    /// with one warning; the refused value is not logged.
+    pub fn parse(raw: &str) -> Self {
+        if raw == "auto" {
+            return Self::Auto;
+        }
+        if raw.len() == 2 && raw.bytes().all(|byte| byte.is_ascii_lowercase()) {
+            return Self::Code(raw.to_owned());
+        }
+        log::warn!("voice_input event=setting_invalid key=language");
+        Self::Auto
+    }
+}
+
+// The defaults below repeat `assets/settings/default.json`, so an embedder whose defaults lack
+// the section still gets the design's values.
+const DEFAULT_ENABLED: bool = true;
+const DEFAULT_MODEL: VoiceModelContent = VoiceModelContent::Base;
+const DEFAULT_LANGUAGE: &str = "auto";
+const DEFAULT_REMOTE_ENABLED: bool = false;
+const DEFAULT_REMOTE_MODEL: &str = "whisper-1";
+const DEFAULT_REMOTE_API_KEY_ENV: &str = "ZEO_VOICE_API_KEY";
+
+impl Settings for VoiceInputSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        let section = content.voice_input.clone().unwrap_or_default();
+        let remote = section.remote.unwrap_or_default();
+        Self {
+            enabled: section.enabled.unwrap_or(DEFAULT_ENABLED),
+            model: section.model.unwrap_or(DEFAULT_MODEL).into(),
+            language: Language::parse(section.language.as_deref().unwrap_or(DEFAULT_LANGUAGE)),
+            remote: RemoteSettings {
+                enabled: remote.enabled.unwrap_or(DEFAULT_REMOTE_ENABLED),
+                url: remote.url,
+                model: remote
+                    .model
+                    .unwrap_or_else(|| DEFAULT_REMOTE_MODEL.to_owned()),
+                api_key_env: remote
+                    .api_key_env
+                    .unwrap_or_else(|| DEFAULT_REMOTE_API_KEY_ENV.to_owned()),
+            },
+        }
+    }
+}
diff --git a/crates/voice_input/src/settings_tests.rs b/crates/voice_input/src/settings_tests.rs
new file mode 100644
index 0000000..38bfa41
--- /dev/null
+++ b/crates/voice_input/src/settings_tests.rs
@@ -0,0 +1,132 @@
+// Story 044, task 1.2 — the `voice_input` settings section (R1.2, R7.2, R7.4, R8.1). Wired in the
+// crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod settings_tests;
+//
+// Validation filter: `settings` (every test path is `settings_tests::…`).
+//
+// Contract (design.md C1.1, Data Models). Assumed shapes — adjust the `use` only:
+//   - `VoiceInputSettings { enabled, model, language, remote }` implements `settings::Settings`
+//     (`#[derive(RegisterSetting)]`, so `SettingsStore::test` knows it).
+//   - `RemoteSettings { enabled, url: Option<String>, model: String, api_key_env: String }`.
+//   - `Language::{Auto, Code(String)}` with `Language::parse(&str) -> Language`.
+//   - `VoiceModel::{Tiny, Base, Small}`; `PartialEq + Debug` on `VoiceModel` and `Language`.
+//
+// Hostile halves: a value in the user's settings.json is READ (a field missing from
+// `flattened_deserialize!` or `vscode_import.rs` is silently ignored — 0052's lesson), AND an absent
+// value falls back to the default; the language parser accepts two lowercase letters AND refuses
+// near misses (uppercase, three letters, digits, empty), which fall back to Auto.
+
+use gpui::{TestAppContext, UpdateGlobal as _};
+use settings::{Settings as _, SettingsStore};
+
+use crate::{Language, VoiceInputSettings, VoiceModel};
+
+fn init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+}
+
+fn set_user_settings(json: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(json, cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+}
+
+fn current(cx: &mut TestAppContext) -> VoiceInputSettings {
+    cx.update(|cx| VoiceInputSettings::get_global(cx).clone())
+}
+
+#[gpui::test]
+fn settings_defaults_match_the_design(cx: &mut TestAppContext) {
+    init(cx);
+    let s = current(cx);
+    assert!(s.enabled, "voice_input.enabled defaults to true");
+    assert_eq!(s.model, VoiceModel::Base, "the default model is base");
+    assert_eq!(s.language, Language::Auto);
+    assert!(
+        !s.remote.enabled,
+        "R8.1 the remote service is off by default"
+    );
+    assert_eq!(s.remote.url, None);
+    assert_eq!(s.remote.model, "whisper-1");
+    assert_eq!(s.remote.api_key_env, "ZEO_VOICE_API_KEY");
+}
+
+#[gpui::test]
+fn settings_user_values_are_read_not_ignored(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        r#"{ "voice_input": {
+            "enabled": false,
+            "model": "small",
+            "language": "pt",
+            "remote": { "enabled": true, "url": "https://stt.example/v1/audio/transcriptions",
+                        "model": "large-v3", "api_key_env": "MY_STT_KEY" }
+        } }"#,
+        cx,
+    );
+    let s = current(cx);
+    assert!(
+        !s.enabled,
+        "R1.2 a user `enabled: false` reaches the setting"
+    );
+    assert_eq!(s.model, VoiceModel::Small);
+    assert_eq!(s.language, Language::Code("pt".into()), "R7.2");
+    assert!(s.remote.enabled);
+    assert_eq!(
+        s.remote.url.as_deref(),
+        Some("https://stt.example/v1/audio/transcriptions")
+    );
+    assert_eq!(s.remote.model, "large-v3");
+    assert_eq!(s.remote.api_key_env, "MY_STT_KEY");
+}
+
+#[gpui::test]
+fn settings_partial_user_section_keeps_other_defaults(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        r#"{ "voice_input": { "remote": { "enabled": true } } }"#,
+        cx,
+    );
+    let s = current(cx);
+    assert!(s.enabled && s.remote.enabled);
+    assert_eq!(s.model, VoiceModel::Base);
+    assert_eq!(s.remote.model, "whisper-1");
+    assert_eq!(s.remote.api_key_env, "ZEO_VOICE_API_KEY");
+}
+
+#[gpui::test]
+fn settings_tiny_model_parses(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    assert_eq!(current(cx).model, VoiceModel::Tiny);
+}
+
+#[test]
+fn settings_language_auto_and_two_lowercase_letters() {
+    assert_eq!(Language::parse("auto"), Language::Auto, "R7.4");
+    assert_eq!(Language::parse("en"), Language::Code("en".into()), "R7.2");
+    assert_eq!(Language::parse("pt"), Language::Code("pt".into()));
+}
+
+#[test]
+fn settings_language_near_misses_fall_back_to_auto() {
+    for raw in [
+        "EN", "Pt", "por", "p", "", " en", "en ", "e1", "12", "pt-BR", "AUTO", "ée",
+    ] {
+        assert_eq!(
+            Language::parse(raw),
+            Language::Auto,
+            "{raw:?} is not a two-letter code"
+        );
+    }
+}
