+const BUTTON_ID: &str = "voice-input";
+const LABEL: &str = "Voice input";
+const READ_ONLY: &str = "The composer is read-only";
+const BUSY: &str = "Voice input is busy in another thread";
+const MODEL_HOST: &str = "huggingface.co";
