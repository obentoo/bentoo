+
+#[test]
+fn download_oversize_aborts_without_waiting_for_the_end() {
+    let bytes = body(40_000);
+    let spec = test_spec(&bytes);
+    // spec.size + 1 bytes, then a body that never ends: only an early abort returns.
+    let (http, _, _reached) = stalling_client(body(40_001));
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let result = block_on_with_watchdog(download_model(
+        http,
+        spec,
+        tmp.path().into(),
+        |_| {},
+        never_cancelled(),
+    ));
+    assert!(
+        matches!(result, Err(DownloadError::Mismatch { .. })),
+        "{result:?}"
+    );
+    assert!(
+        leftovers(tmp.path()).is_empty(),
+        "{:?}",
+        leftovers(tmp.path())
+    );
+}
+
+#[test]
+fn download_cancel_halfway_leaves_nothing() {
+    let bytes = body(200_000);
+    let spec = test_spec(&bytes);
+    let (http, _, reached) = stalling_client(bytes[..100_000].to_vec());
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let (cancel_tx, cancel_rx) = oneshot::channel();
+    let dir = tmp.path().to_path_buf();
+    let result = block_on_with_watchdog(async move {
+        let download = download_model(http, spec, dir, |_| {}, cancel_rx).fuse();
+        let trigger = async move {
+            let _ = reached.await;
+            let _ = cancel_tx.send(());
+            futures::future::pending::<()>().await;
+        }
+        .fuse();
+        futures::pin_mut!(download, trigger);
+        futures::select! {
+            r = download => r,
+            _ = trigger => unreachable!(),
+        }
+    });
+    assert!(
+        matches!(result, Err(DownloadError::Cancelled)),
+        "{result:?}"
+    );
+    assert!(
+        !tmp.path().join(FILE).exists(),
+        "Q17 no file at the final path"
+    );
+    assert!(
+        leftovers(tmp.path()).is_empty(),
+        "R6.6 partial file deleted: {:?}",
+        leftovers(tmp.path())
+    );
+}
+
+#[test]
+fn download_dropped_halfway_leaves_nothing() {
+    let bytes = body(200_000);
+    let spec = test_spec(&bytes);
+    let (http, _, reached) = stalling_client(bytes[..100_000].to_vec());
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let dir = tmp.path().to_path_buf();
+    block_on_with_watchdog(async move {
+        let download = download_model(http, spec, dir, |_| {}, never_cancelled()).fuse();
+        futures::pin_mut!(download);
+        let mut reached = reached.fuse();
+        futures::select! {
+            r = download => panic!("a stalled body cannot finish: {r:?}"),
+            _ = reached => {}
+        }
+        // `download` is dropped here, halfway: the "kill".
+    });
+    assert!(
+        !tmp.path().join(FILE).exists(),
+        "Q17 no file at the final path"
+    );
+    assert!(
+        leftovers(tmp.path()).is_empty(),
+        "the drop guard removed the staging file: {:?}",
+        leftovers(tmp.path())
+    );
+}
+
+#[test]
+fn download_http_404_is_an_http_error_and_writes_nothing() {
