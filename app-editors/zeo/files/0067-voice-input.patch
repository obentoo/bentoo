+            owner: o(b.entity_id()),
+        },
+        cx,
+    );
+
+    assert_eq!(
+        h.notices_for(b.entity_id()),
+        vec!["Voice input is busy in another thread".to_string()],
+        "R5.1 B is refused while A, still open, downloads"
+    );
+    assert!(matches!(h.view(b.entity_id(), cx), ViewState::Busy));
+    assert!(
+        matches!(h.view(a.entity_id(), cx), ViewState::Downloading { .. }),
+        "A keeps its download: {:?}",
+        h.view(a.entity_id(), cx)
+    );
+    assert!(!h.body.dropped(), "the download is not cancelled");
+}
+
+#[gpui::test]
+async fn download_owner_a_third_composer_is_busy_after_the_adoption(cx: &mut TestAppContext) {
+    let h = setup(cx);
+    let a = a_downloading(&h, cx);
+    let b = cx.new(|_| ());
+    let c = cx.new(|_| ());
+    h.register(&b, cx);
+    h.register(&c, cx);
+    drop(a);
+    cx.run_until_parked();
+    h.send(
+        Input::Click {
+            owner: o(b.entity_id()),
+        },
+        cx,
+    );
+    assert!(
+        matches!(h.view(b.entity_id(), cx), ViewState::Downloading { .. }),
+        "R6.15 B shows the download it adopted: {:?}",
+        h.view(b.entity_id(), cx)
+    );
+
+    h.send(
+        Input::Click {
+            owner: o(c.entity_id()),
+        },
+        cx,
+    );
+    assert_eq!(
+        h.notices_for(c.entity_id()),
+        vec!["Voice input is busy in another thread".to_string()],
+        "R5.1 C is refused: B, open, now owns the download"
+    );
+    h.send(
+        Input::Click {
+            owner: o(b.entity_id()),
+        },
+        cx,
+    );
+    assert!(
+        h.notices_for(b.entity_id()).is_empty(),
+        "B's own click while its download runs changes nothing: {:?}",
+        h.notices_for(b.entity_id())
+    );
+    assert!(matches!(
+        h.view(b.entity_id(), cx),
+        ViewState::Downloading { .. }
+    ));
+    assert!(!h.body.dropped(), "still the one download");
+    assert_eq!(h.requests.load(Ordering::SeqCst), 1);
+}
+
+// ── the wrong split: the next composer takes the download over ─────────────
+
+#[gpui::test]
+async fn download_owner_the_next_composer_adopts_a_download_whose_owner_closed(
+    cx: &mut TestAppContext,
+) {
+    let h = setup(cx);
+    let a = a_downloading(&h, cx);
+    let staged = h.staging_len().expect("a staging file while downloading");
+    drop(a);
+    cx.run_until_parked();
+
+    let b = cx.new(|_| ());
+    h.register(&b, cx);
+    h.send(
+        Input::Click {
+            owner: o(b.entity_id()),
+        },
+        cx,
+    );
+
+    assert!(
+        matches!(h.view(b.entity_id(), cx), ViewState::Downloading { .. }),
+        "R6.15 B sees the running download's progress and Cancel: {:?}",
+        h.view(b.entity_id(), cx)
+    );
+    assert!(
+        h.notices_for(b.entity_id()).is_empty(),
+        "B is not told busy: {:?}",
+        h.notices_for(b.entity_id())
+    );
+    assert!(!h.body.dropped(), "R6.14 the download was not cancelled");
+    assert_eq!(
+        h.requests.load(Ordering::SeqCst),
+        1,
+        "one request, never restarted"
+    );
+
+    h.feed(64 * 1024, cx);
+    let grown = h.staging_len().expect("the staging file is still there");
+    assert!(
+        grown > staged,
+        "the staging file keeps growing: {staged} → {grown}"
+    );
+
+    // R6.3: B's Cancel cancels the download it adopted.
+    h.send(Input::DownloadCancel, cx);
+    wait_until(cx, "the download to stop", |_| h.body.dropped());
+    wait_until(cx, "the staging file to go", |_| {
+        staging_files(&h.models).is_empty()
+    });
+    assert!(
+        matches!(h.view(b.entity_id(), cx), ViewState::Idle { .. }),
+        "R6.6 idle after the cancel: {:?}",
+        h.view(b.entity_id(), cx)
+    );
+}
+
+#[gpui::test]
+async fn download_owner_a_download_whose_owner_closed_runs_to_its_end_and_notifies_nobody(
+    cx: &mut TestAppContext,
+) {
+    let h = setup(cx);
+    let a = a_downloading(&h, cx);
+    drop(a);
+    cx.run_until_parked();
+
+    h.feed(256 * 1024, cx);
+    assert!(
+        !h.body.dropped(),
+        "R6.14 the download keeps running without its composer"
+    );
+    // A body shorter than the pinned model: the download ends on its own, as a mismatch.
+    h.body.end();
+    wait_until(cx, "the download to reach its end", |_| {
+        h.body.eof_returned()
+    });
+    wait_until(cx, "the staging file to go", |_| {
+        staging_files(&h.models).is_empty()
+    });
+    let other = cx.new(|_| ()).entity_id();
+    wait_until(cx, "idle", |cx| {
+        matches!(h.view(other, cx), ViewState::Idle { .. })
+    });
+    assert_eq!(h.requests.load(Ordering::SeqCst), 1);
+    assert!(
+        h.notices().is_empty(),
+        "the end of a download whose composer closed notifies nobody (A is gone): {:?}",
+        h.notices()
+    );
+}
+
+// ── the plain cases ────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn download_owner_disabling_the_feature_cancels_a_running_download(cx: &mut TestAppContext) {
+    let h = setup(cx);
+    let a = a_downloading(&h, cx);
+    set_settings(r#"{ "voice_input": { "enabled": false } }"#, cx);
+    wait_until(cx, "the download to stop", |_| h.body.dropped());
+    wait_until(cx, "the staging file to go", |_| {
+        staging_files(&h.models).is_empty()
+    });
+    assert!(matches!(h.view(a.entity_id(), cx), ViewState::Hidden));
+}
+
+// ── the machine ────────────────────────────────────────────────────────────
+
+const CTX: Ctx = Ctx {
+    enabled: true,
+    remote: false,
+    model_present: false,
+    composer_read_only: false,
+};
+
+/// A machine in `Downloading { owner: 1, bytes: 4096 }`, through the inputs that lead there.
+fn downloading() -> Machine {
+    let mut machine = Machine::default();
+    let now = Instant::now();
+    machine.on(Input::Click { owner: Owner(1) }, now, &CTX);
+    machine.on(Input::ConsentGiven, now, &CTX);
+    machine.on(Input::DownloadProgress(4096), now, &CTX);
+    assert_eq!(
+        machine.phase(),
+        &Phase::Downloading {
+            owner: Owner(1),
+            bytes: 4096
+        },
+        "precondition"
+    );
+    machine
+}
+
+#[test]
+fn download_owner_adopt_download_changes_the_owner_and_keeps_the_progress() {
+    let mut machine = downloading();
+    let effects = machine.on(
+        Input::AdoptDownload { owner: Owner(2) },
+        Instant::now(),
+        &CTX,
+    );
+    assert_eq!(
+        machine.phase(),
+        &Phase::Downloading {
+            owner: Owner(2),
+            bytes: 4096
+        },
+        "R6.15 the new owner, the same download"
+    );
+    assert_eq!(
+        effects,
+        vec![Effect::Render],
+        "re-render only: nothing cancelled, nothing restarted"
+    );
+}
+
+#[test]
+fn download_owner_adopt_download_outside_downloading_changes_nothing() {
+    let now = Instant::now();
+    let idle = Machine::default();
+    let mut consent = Machine::default();
+    consent.on(Input::Click { owner: Owner(1) }, now, &CTX);
+    let remote = Ctx {
+        remote: true,
+        ..CTX
+    };
+    let mut starting = Machine::default();
+    starting.on(Input::Click { owner: Owner(1) }, now, &remote);
+    let mut recording = Machine::default();
+    recording.on(Input::Click { owner: Owner(1) }, now, &remote);
+    recording.on(Input::CaptureStarted, now, &remote);
+    let mut transcribing = Machine::default();
+    transcribing.on(Input::Click { owner: Owner(1) }, now, &remote);
+    transcribing.on(Input::CaptureStarted, now, &remote);
+    transcribing.on(Input::Click { owner: Owner(1) }, now, &remote);
+
+    for (name, mut machine) in [
+        ("idle", idle),
+        ("consent", consent),
+        ("starting", starting),
+        ("recording", recording),
+        ("transcribing", transcribing),
+    ] {
+        let before = machine.phase().clone();
+        let effects = machine.on(Input::AdoptDownload { owner: Owner(2) }, now, &CTX);
+        assert_eq!(machine.phase(), &before, "{name}: the phase is unchanged");
+        assert!(effects.is_empty(), "{name}: no effect: {effects:?}");
+    }
+}
diff --git a/crates/voice_input/src/entity_hardening_tests.rs b/crates/voice_input/src/entity_hardening_tests.rs
new file mode 100644
index 0000000..67e1576
--- /dev/null
+++ b/crates/voice_input/src/entity_hardening_tests.rs
@@ -0,0 +1,492 @@
+// Story 044, task 4.1 fix round 1: the `VoiceInput` entity, hardened after the tech review
+// (.draft/reports/4.1-tech-review-rust-gpui.md, findings 1-5). Mounted in the crate root under
+// `cfg(test)`. Validation filter: `entity` (every test path is `entity_hardening_tests::…`).
+//
+// The fakes repeat entity_tests.rs's: that file is frozen, and its fakes are private to it.
+//
+// Hostile halves:
+// - a composer closed while it owns the machine (consent strip or a toggle recording) neither
+//   blocks the other composers nor keeps the microphone open, and inserts nothing;
+// - turning the feature off mid-recording closes the microphone and inserts nothing;
+// - a packaged model whose verdict is not cached is never hashed inside `handle` (the UI thread),
+//   yet the machine still gets its answer once the background hash returns;
+// - a plain-http URL is refused whenever a proxy is configured (client or environment), and
+//   allowed when none is or over https;
+// - a press held behind a hash keeps the time it arrived, so a hold stays a hold.
+
+use std::{
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use gpui::{AppContext as _, Entity, EntityId, TestAppContext, UpdateGlobal as _};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, Response};
+use settings::SettingsStore;
+use url::Url;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Ended, Recording};
+use crate::models::{VoiceModel, spec};
+use crate::remote::proxy_refusal;
+use crate::state::{Input, Owner};
+use crate::{ViewState, VoiceEvent, VoiceInput, init_in};
+
+#[derive(Default)]
+struct Mic {
+    starts: AtomicUsize,
+    stops: AtomicUsize,
+    cancels: AtomicUsize,
+}
+
+struct Backend(Arc<Mic>);
+struct Active(Arc<Mic>);
+
+impl CaptureBackend for Backend {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        self.0.starts.fetch_add(1, Ordering::SeqCst);
+        Ok(Box::new(Active(self.0.clone())))
+    }
+}
+
+impl ActiveCapture for Active {
+    fn stop(self: Box<Self>) -> Recording {
+        self.0.stops.fetch_add(1, Ordering::SeqCst);
+        let samples = (0..48_000).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: 48_000,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {
+        self.0.cancels.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+struct Harness {
+    vi: Entity<VoiceInput>,
+    mic: Arc<Mic>,
+    requests: Arc<AtomicUsize>,
+    events: Arc<Mutex<Vec<VoiceEvent>>>,
+    models: PathBuf,
+    _tmp: tempfile::TempDir,
+}
+
+impl Harness {
+    fn send(&self, input: Input, cx: &mut TestAppContext) {
+        self.vi.update(cx, |vi, cx| vi.handle(input, cx));
+    }
+    fn view(&self, owner: EntityId, cx: &mut TestAppContext) -> ViewState {
+        self.vi.read_with(cx, |vi, _| vi.view_state(owner))
+    }
+    fn notices(&self, owner: EntityId) -> Vec<String> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|event| match event {
+                VoiceEvent::Notify { owner: o, message } if *o == owner => Some(message.clone()),
+                _ => None,
+            })
+            .collect()
+    }
+    fn inserts(&self) -> usize {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter(|event| matches!(event, VoiceEvent::Insert { .. }))
+            .count()
+    }
+    fn register(&self, owner: &Entity<()>, cx: &mut TestAppContext) {
+        let id = owner.entity_id();
+        let weak = owner.downgrade().into();
+        self.vi
+            .update(cx, |vi, _| vi.register_owner(Owner(id.as_u64()), weak));
+    }
+}
+
+fn set_settings(json: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+}
+
+fn setup(settings_json: &str, cx: &mut TestAppContext) -> Harness {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    set_settings(settings_json, cx);
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models = tmp.path().join("voice").join("models");
+    let mic = Arc::new(Mic::default());
+    let requests = Arc::new(AtomicUsize::new(0));
+    let counter = requests.clone();
+    let http: Arc<dyn HttpClient> = FakeHttpClient::create(move |_| {
+        counter.fetch_add(1, Ordering::SeqCst);
+        async move {
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from(r#"{"text": "words"}"#))?)
+        }
+    });
+    let backend: Arc<dyn CaptureBackend> = Arc::new(Backend(mic.clone()));
+    cx.update(|cx| init_in(http, models.clone(), backend, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+    Harness {
+        vi,
+        mic,
+        requests,
+        events,
+        models,
+        _tmp: tmp,
+    }
+}
+
+fn o(id: EntityId) -> Owner {
+    Owner(id.as_u64())
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn place_sparse_model(dir: &Path, model: VoiceModel) -> PathBuf {
+    std::fs::create_dir_all(dir).expect("dir");
+    let s = spec(model);
+    let path = dir.join(s.file);
+    std::fs::File::create(&path)
+        .and_then(|f| f.set_len(s.size))
+        .expect("sparse model");
+    path
+}
+
+const REMOTE: &str = r#"{ "voice_input": { "remote": { "enabled": true,
+    "url": "http://127.0.0.1:9/v1/audio/transcriptions", "api_key_env": "ZEO_VOICE_TEST_UNSET_044_9F3C" } } }"#;
+
+// ── finding 1: a closed owner does not wedge the machine ───────────────────
+
+#[gpui::test]
+async fn entity_hardening_closed_owner_in_consent_does_not_block_others(cx: &mut TestAppContext) {
+    let h = setup("{}", cx);
+    let closed = cx.new(|_| ());
+    let other = cx.new(|_| ());
+    let (a, b) = (closed.entity_id(), other.entity_id());
+    h.register(&closed, cx);
+    h.send(Input::Click { owner: o(a) }, cx);
+    cx.run_until_parked();
+    assert!(
+        matches!(h.view(b, cx), ViewState::Busy),
+        "precondition: A owns the consent strip"
+    );
+
+    drop(closed);
+    cx.run_until_parked();
+    h.send(Input::Click { owner: o(b) }, cx);
+    cx.run_until_parked();
+    assert!(
+        matches!(h.view(b, cx), ViewState::AwaitingConsent { .. }),
+        "B gets its own consent strip: {:?}",
+        h.view(b, cx)
+    );
+    assert!(
+        h.notices(b).is_empty(),
+        "B is not told busy: {:?}",
+        h.notices(b)
+    );
+    assert_eq!(
+        h.requests.load(Ordering::SeqCst),
+        0,
+        "R6.9 nothing downloaded"
+    );
+}
+
+#[gpui::test]
+async fn entity_hardening_closed_owner_while_recording_closes_the_mic_within_a_second(
+    cx: &mut TestAppContext,
+) {
+    let h = setup(REMOTE, cx);
+    let closed = cx.new(|_| ());
+    let a = closed.entity_id();
+    h.register(&closed, cx);
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(a, cx), ViewState::Recording { .. })
+    });
+
+    drop(closed);
+    cx.run_until_parked();
+    cx.executor().advance_clock(Duration::from_millis(1_100));
+    cx.run_until_parked();
+    assert_eq!(
+        h.mic.cancels.load(Ordering::SeqCst),
+        1,
+        "the microphone is closed"
+    );
+    assert_eq!(
+        h.mic.stops.load(Ordering::SeqCst),
+        0,
+        "nothing is transcribed"
+    );
+    assert_eq!(h.inserts(), 0);
+    assert_eq!(
+        h.requests.load(Ordering::SeqCst),
+        0,
+        "no audio leaves the machine"
+    );
+    let other = cx.new(|_| ()).entity_id();
+    assert!(
+        matches!(h.view(other, cx), ViewState::Idle { .. }),
+        "the others are free again: {:?}",
+        h.view(other, cx)
+    );
+}
+
+#[gpui::test]
+async fn entity_hardening_closed_owner_while_recording_is_cancelled_by_another_click(
+    cx: &mut TestAppContext,
+) {
+    let h = setup(REMOTE, cx);
+    let closed = cx.new(|_| ());
+    let other = cx.new(|_| ());
+    let (a, b) = (closed.entity_id(), other.entity_id());
+    h.register(&closed, cx);
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(a, cx), ViewState::Recording { .. })
+    });
+
+    drop(closed);
+    cx.run_until_parked();
+    h.send(Input::Click { owner: o(b) }, cx);
+    wait_until(cx, "B recording", |cx| {
+        matches!(h.view(b, cx), ViewState::Recording { .. })
+    });
+    assert_eq!(
+        h.mic.cancels.load(Ordering::SeqCst),
+        1,
+        "A's recording is dropped"
+    );
+    assert!(
+        h.notices(b).is_empty(),
+        "B is not told busy: {:?}",
+        h.notices(b)
+    );
+}
+
+// ── finding 2: disabling mid-recording; the backend is the one at start ────
+
+#[gpui::test]
+async fn entity_hardening_disabling_mid_recording_closes_the_mic(cx: &mut TestAppContext) {
+    let h = setup(REMOTE, cx);
+    let a = cx.new(|_| ()).entity_id();
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(a, cx), ViewState::Recording { .. })
+    });
+
+    set_settings(r#"{ "voice_input": { "enabled": false } }"#, cx);
+    cx.run_until_parked();
+    assert_eq!(
+        h.mic.cancels.load(Ordering::SeqCst),
+        1,
+        "the microphone is closed"
+    );
+    assert_eq!(h.mic.stops.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        h.inserts(),
+        0,
+        "nothing reaches a composer whose feature is off"
+    );
+    assert_eq!(h.requests.load(Ordering::SeqCst), 0);
+    assert!(matches!(h.view(a, cx), ViewState::Hidden));
+}
+
+#[gpui::test]
+async fn entity_hardening_backend_is_the_one_chosen_at_recording_start(cx: &mut TestAppContext) {
+    let h = setup(REMOTE, cx);
+    let a = cx.new(|_| ()).entity_id();
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(a, cx), ViewState::Recording { .. })
+    });
+
+    // Switched to local (with no model) while recording: the audio recorded under the remote
+    // setting still goes to the remote service it was recorded for.
+    set_settings("{}", cx);
+    cx.run_until_parked();
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "the insert", |_| h.inserts() == 1);
+    assert_eq!(h.requests.load(Ordering::SeqCst), 1);
+}
+
+// ── findings 3 and 4: no hash on the UI path; an isolated system dir ───────
+
+#[gpui::test]
+async fn entity_hardening_cold_packaged_model_is_hashed_off_the_ui_path(cx: &mut TestAppContext) {
+    let h = setup(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    // `init_in`'s packaged-model directory is `<models_dir>/system`. The model is placed after
+    // init, so the init warm-up found nothing and the verdict cache is cold.
+    place_sparse_model(&h.models.join("system"), VoiceModel::Tiny);
+    let a = cx.new(|_| ()).entity_id();
+
+    // `handle` runs on the UI thread. Counted inside the same update, before the executor runs
+    // anything else: a hash computed here would be a hash computed on the UI thread.
+    let hashed_in_handle = h.vi.update(cx, |vi, cx| {
+        vi.handle(Input::Click { owner: o(a) }, cx);
+        vi.hash_cache().hashes_computed()
+    });
+    assert_eq!(hashed_in_handle, 0, "no SHA-256 inside handle");
+
+    // The background hash then answers: zeros are not the pinned file, no downloaded copy
+    // exists, so the machine asks for consent.
+    wait_until(cx, "the consent strip", |cx| {
+        matches!(h.view(a, cx), ViewState::AwaitingConsent { .. })
+    });
+    let hashed =
+        h.vi.read_with(cx, |vi, _| vi.hash_cache().hashes_computed());
+    assert_eq!(
+        hashed, 1,
+        "the packaged file was hashed once, in the background"
+    );
+    assert_eq!(h.mic.starts.load(Ordering::SeqCst), 0);
+}
+
+#[gpui::test]
+async fn entity_hardening_init_in_reads_its_own_system_dir(cx: &mut TestAppContext) {
+    // A valid packaged model cannot be faked (it must hash to the pinned value), so this proves
+    // the seam the other way: a size-correct file in `<models_dir>/system` is looked at (and
+    // hashed), which it never is when the entity reads `/usr/share/whisper-models`.
+    let h = setup(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    place_sparse_model(&h.models.join("system"), VoiceModel::Tiny);
+    let a = cx.new(|_| ()).entity_id();
+    h.send(Input::Click { owner: o(a) }, cx);
+    wait_until(cx, "the consent strip", |cx| {
+        matches!(h.view(a, cx), ViewState::AwaitingConsent { .. })
+    });
+    let hashed =
+        h.vi.read_with(cx, |vi, _| vi.hash_cache().hashes_computed());
+    assert_eq!(hashed, 1, "the isolated system dir was consulted");
+}
+
+// ── finding 5: a plain-http URL and a proxy ─────────────────────────────────
+
+fn url(raw: &str) -> Url {
+    Url::parse(raw).expect("url")
+}
+
+const NO_PROXY_ENV: [Option<String>; 6] = [None, None, None, None, None, None];
+
+fn env_with(name: &str, value: &str) -> [Option<String>; 6] {
+    crate::remote::PROXY_ENV_VARS.map(|var| (var == name).then(|| value.to_string()))
+}
+
+#[test]
+fn entity_hardening_plain_http_through_a_proxy_is_refused() {
+    let proxy = url("http://proxy.corp:3128");
+    let loopback = url("http://127.0.0.1:9/v1/t");
+    let refusal = proxy_refusal(&loopback, Some(&proxy), &NO_PROXY_ENV)
+        .expect("refused when the client has a proxy");
+    assert_eq!(
+        refusal,
+        "The remote voice URL uses plain http while a proxy is configured; use https"
+    );
+    // reqwest reads these itself, even when Zed could not parse them into `proxy()`: a
+    // scheme-less `10.0.0.1:3128` is one such value.
+    for name in crate::remote::PROXY_ENV_VARS {
+        assert!(
+            proxy_refusal(&loopback, None, &env_with(name, "10.0.0.1:3128")).is_some(),
+            "{name} set"
+        );
+    }
+    assert!(
+        proxy_refusal(&url("http://localhost:8080/t"), Some(&proxy), &NO_PROXY_ENV).is_some(),
+        "NO_PROXY is not consulted: reqwest's matching differs from any copy of it"
+    );
+}
+
+#[test]
+fn entity_hardening_plain_http_without_a_proxy_or_over_https_is_allowed() {
+    let proxy = url("http://proxy.corp:3128");
+    let loopback = url("http://127.0.0.1:9/v1/t");
+    assert_eq!(
+        proxy_refusal(&loopback, None, &NO_PROXY_ENV),
+        None,
+        "no proxy"
+    );
+    assert_eq!(
+        proxy_refusal(&loopback, None, &env_with("HTTP_PROXY", "  ")),
+        None,
+        "a blank variable is no proxy"
+    );
+    assert_eq!(
+        proxy_refusal(
+            &url("https://stt.example/t"),
+            Some(&proxy),
+            &env_with("ALL_PROXY", "p:1")
+        ),
+        None,
+        "https is tunnelled, never readable by the proxy"
+    );
+}
+
+// ── re-review R2: a held press keeps its arrival time ──────────────────────
+
+#[gpui::test]
+async fn entity_hardening_press_held_behind_a_hash_keeps_its_press_time(cx: &mut TestAppContext) {
+    let h = setup(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    // A packaged file that will fail its hash (cold cache, so the press is held) and a
+    // downloaded copy, so the replayed press finds a model and records.
+    place_sparse_model(&h.models.join("system"), VoiceModel::Tiny);
+    place_sparse_model(&h.models, VoiceModel::Tiny);
+    let a = cx.new(|_| ()).entity_id();
+
+    h.send(Input::ShortcutDown { owner: o(a) }, cx);
+    // Held for longer than the tap window before the executor even runs the hash.
+    std::thread::sleep(Duration::from_millis(450));
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(a, cx), ViewState::Recording { .. })
+    });
+    h.send(Input::ShortcutUp { owner: o(a) }, cx);
+    cx.run_until_parked();
+    assert_eq!(
+        h.mic.stops.load(Ordering::SeqCst),
+        1,
+        "a 450 ms press is a hold (R3.1): its release stops the recording"
+    );
+}
diff --git a/crates/voice_input/src/entity_tests.rs b/crates/voice_input/src/entity_tests.rs
new file mode 100644
index 0000000..03dc65b
--- /dev/null
+++ b/crates/voice_input/src/entity_tests.rs
@@ -0,0 +1,753 @@
+// Story 044, task 4.1 — the `VoiceInput` entity runs the machine's effects (R2.1, R2.6, R4.6, R5.1,
+// R6.1, R6.5, R6.6, R6.7, R6.9, R7.1, R7.3, R8.2, R8.3, R8.4, R8.5, R8.6, R8.7, R8.8, R9.1, R9.2,
+// R10.1, R10.3). Wired in the crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod entity_tests;
+//
+// Validation filter: `entity` (every test path is `entity_tests::…`).
+//
+// Contract: design.md C1.10 (`handle`, `view_state`, `VoiceEvent`), C1.9 (`Input`).
+// ASSUMED TEST SEAMS (not in design.md) — a test must never open the operator's microphone nor
+// write into the real `paths::data_dir()` (a process-wide OnceLock):
+//   - `crate::init_in(http: Arc<dyn HttpClient>, models_dir: PathBuf,
+//                     capture: Arc<dyn capture::CaptureBackend>, cx: &mut App)`;
+//     `init(http, cx)` is `init_in(http, models::models_dir(), Arc::new(capture::Cpal), cx)`.
+//   - `capture::CaptureBackend: Send + Sync` with `fn start(&self, device: Option<cpal::DeviceId>,
+//     events: smol::channel::Sender<CaptureEvent>) -> anyhow::Result<Box<dyn ActiveCapture>>`, and
+//     `capture::ActiveCapture: Send` with `fn stop(self: Box<Self>) -> Recording` and
+//     `fn cancel(self: Box<Self>)` (`Recorder` implements it).
+//   - `VoiceInput::global(cx: &App) -> Entity<VoiceInput>`.
+//   - `state::Owner(pub u64)`, built from `EntityId::as_u64()`; `VoiceEvent: Clone + Debug`.
+//   - `ViewState::AwaitingConsent { model: VoiceModel, size: String-like }`,
+//     `ViewState::Idle { remote_host: Option<String> }`.
+//
+// Hostile halves: nothing is downloaded before consent AND exactly one pinned GET after it; remote
+// mode never asks for a model AND local mode never opens a connection, even when the model fails to
+// load; a key in the named env var is sent as a bearer AND an unset one sends no header; a remote
+// failure is shown AND never falls back to local; a recording too short or too quiet sends nothing.
+
+use std::{
+    path::{Path, PathBuf},
+    str::FromStr as _,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
