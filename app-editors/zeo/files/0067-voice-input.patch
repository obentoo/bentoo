+use crate::{ViewState, VoiceEvent, VoiceInput, init_in};
+
+// ── a body fed by the test ─────────────────────────────────────────────────
+
+#[derive(Default)]
+struct Feed {
+    queue: VecDeque<u8>,
+    ended: bool,
+    waker: Option<Waker>,
+    read: u64,
+    eof_returned: bool,
+    dropped: bool,
+}
+
+#[derive(Clone, Default)]
+struct Body(Arc<Mutex<Feed>>);
+
+impl Body {
+    fn push(&self, bytes: usize) {
+        let mut feed = self.0.lock().expect("lock");
+        feed.queue.extend(std::iter::repeat_n(0x5a, bytes));
+        if let Some(waker) = feed.waker.take() {
+            waker.wake();
+        }
+    }
+    fn end(&self) {
+        let mut feed = self.0.lock().expect("lock");
+        feed.ended = true;
+        if let Some(waker) = feed.waker.take() {
+            waker.wake();
+        }
+    }
+    fn read(&self) -> u64 {
+        self.0.lock().expect("lock").read
+    }
+    fn dropped(&self) -> bool {
+        self.0.lock().expect("lock").dropped
+    }
+    fn eof_returned(&self) -> bool {
+        self.0.lock().expect("lock").eof_returned
+    }
+}
+
+struct Reader(Body);
+
+impl AsyncRead for Reader {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut [u8],
+    ) -> Poll<std::io::Result<usize>> {
+        let mut feed = (self.0).0.lock().expect("lock");
+        if !feed.queue.is_empty() {
+            let n = buf.len().min(feed.queue.len());
+            for (slot, byte) in buf.iter_mut().zip(feed.queue.drain(..n)) {
+                *slot = byte;
+            }
+            feed.read += n as u64;
+            return Poll::Ready(Ok(n));
+        }
+        if feed.ended {
+            feed.eof_returned = true;
+            return Poll::Ready(Ok(0));
+        }
+        feed.waker = Some(cx.waker().clone());
+        Poll::Pending
+    }
+}
+
+impl Drop for Reader {
+    fn drop(&mut self) {
+        if let Ok(mut feed) = (self.0).0.lock() {
+            feed.dropped = true;
+        }
+    }
+}
+
+// ── harness ────────────────────────────────────────────────────────────────
+
+struct NoMicrophone;
+
+impl CaptureBackend for NoMicrophone {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        anyhow::bail!("no microphone: these tests never record")
+    }
+}
+
+struct Harness {
+    vi: Entity<VoiceInput>,
+    body: Body,
+    requests: Arc<AtomicUsize>,
+    events: Arc<Mutex<Vec<VoiceEvent>>>,
+    models: std::path::PathBuf,
+    _tmp: tempfile::TempDir,
+}
+
+impl Harness {
+    fn send(&self, input: Input, cx: &mut TestAppContext) {
+        self.vi.update(cx, |vi, cx| vi.handle(input, cx));
+        cx.run_until_parked();
+    }
+    fn view(&self, owner: EntityId, cx: &mut TestAppContext) -> ViewState {
+        self.vi.read_with(cx, |vi, _| vi.view_state(owner))
+    }
+    fn notices(&self) -> Vec<(EntityId, String)> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|event| match event {
+                VoiceEvent::Notify { owner, message } => Some((*owner, message.clone())),
+                _ => None,
+            })
+            .collect()
+    }
+    fn notices_for(&self, owner: EntityId) -> Vec<String> {
+        self.notices()
+            .into_iter()
+            .filter(|(o, _)| *o == owner)
+            .map(|(_, message)| message)
+            .collect()
+    }
+    fn register(&self, owner: &Entity<()>, cx: &mut TestAppContext) {
+        let id = owner.entity_id();
+        let weak = owner.downgrade().into();
+        self.vi
+            .update(cx, |vi, _| vi.register_owner(Owner(id.as_u64()), weak));
+    }
+    fn staging_len(&self) -> Option<u64> {
+        staging_files(&self.models)
+            .first()
+            .and_then(|path| std::fs::metadata(path).ok())
+            .map(|metadata| metadata.len())
+    }
+    /// Feeds `bytes` and waits until the download has read them.
+    fn feed(&self, bytes: usize, cx: &mut TestAppContext) {
+        let target = self.body.read() + bytes as u64;
+        self.body.push(bytes);
+        wait_until(cx, "the download to read the fed bytes", |_| {
+            self.body.read() >= target
+        });
+    }
+}
+
+fn staging_files(dir: &Path) -> Vec<std::path::PathBuf> {
+    std::fs::read_dir(dir)
+        .map(|read| {
+            read.filter_map(|entry| entry.ok())
+                .map(|entry| entry.path())
+                .filter(|path| {
+                    path.file_name()
+                        .is_some_and(|name| name.to_string_lossy().starts_with(".download-"))
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+fn set_settings(json: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+}
+
+/// Local mode, the tiny model missing: a click asks for consent, and the consent downloads from a
+/// body the test feeds.
+fn setup(cx: &mut TestAppContext) -> Harness {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    set_settings(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models = tmp.path().join("voice").join("models");
+    let body = Body::default();
+    let requests = Arc::new(AtomicUsize::new(0));
+    let http: Arc<dyn HttpClient> = {
+        let body = body.clone();
+        let requests = requests.clone();
+        FakeHttpClient::create(move |_| {
+            requests.fetch_add(1, Ordering::SeqCst);
+            let reader = Reader(body.clone());
+            async move {
+                Ok(Response::builder()
+                    .status(200)
+                    .body(AsyncBody::from_reader(reader))?)
+            }
+        })
+    };
+    let capture: Arc<dyn CaptureBackend> = Arc::new(NoMicrophone);
+    cx.update(|cx| init_in(http, models.clone(), capture, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+    Harness {
+        vi,
+        body,
+        requests,
+        events,
+        models,
+        _tmp: tmp,
+    }
+}
+
+fn o(id: EntityId) -> Owner {
+    Owner(id.as_u64())
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+/// A consents and its download has read its first 64 KiB.
+fn a_downloading(h: &Harness, cx: &mut TestAppContext) -> Entity<()> {
+    let a = cx.new(|_| ());
+    h.register(&a, cx);
+    h.send(
+        Input::Click {
+            owner: o(a.entity_id()),
+        },
+        cx,
+    );
+    assert!(
+        matches!(h.view(a.entity_id(), cx), ViewState::AwaitingConsent { .. }),
+        "precondition: A is asked for consent: {:?}",
+        h.view(a.entity_id(), cx)
+    );
+    h.send(Input::ConsentGiven, cx);
+    wait_until(cx, "the download request", |_| {
+        h.requests.load(Ordering::SeqCst) == 1
+    });
+    h.feed(64 * 1024, cx);
+    assert!(
+        matches!(h.view(a.entity_id(), cx), ViewState::Downloading { .. }),
+        "precondition: A's download runs: {:?}",
+        h.view(a.entity_id(), cx)
+    );
+    a
+}
+
+// ── the wrong collapse: adoption only when the owner is gone ───────────────
+
+#[gpui::test]
+async fn download_owner_another_composer_is_busy_while_the_owner_is_open(cx: &mut TestAppContext) {
+    let h = setup(cx);
+    let a = a_downloading(&h, cx);
+    let b = cx.new(|_| ());
+    h.register(&b, cx);
+
+    h.send(
