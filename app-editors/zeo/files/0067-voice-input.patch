+// R10.2: one key=value line per download, with model, bytes and outcome.
+mod log_capture {
+    use std::sync::{Mutex, OnceLock};
+    use std::thread::ThreadId;
+
+    pub struct Capture(pub Mutex<Vec<(ThreadId, String)>>);
+
+    impl log::Log for Capture {
+        fn enabled(&self, _: &log::Metadata) -> bool {
+            true
+        }
+        fn log(&self, record: &log::Record) {
+            self.0
+                .lock()
+                .expect("lock")
+                .push((std::thread::current().id(), record.args().to_string()));
+        }
+        fn flush(&self) {}
+    }
+
+    pub fn install() -> &'static Capture {
+        static CAPTURE: OnceLock<&'static Capture> = OnceLock::new();
+        CAPTURE.get_or_init(|| {
+            let capture: &'static Capture = Box::leak(Box::new(Capture(Mutex::new(Vec::new()))));
+            log::set_logger(capture).expect("no other logger in this test binary");
+            log::set_max_level(log::LevelFilter::Trace);
+            capture
+        })
+    }
+
+    pub fn lines_of_this_thread(capture: &Capture) -> Vec<String> {
+        let me = std::thread::current().id();
+        capture
+            .0
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter(|(t, _)| *t == me)
+            .map(|(_, l)| l.clone())
+            .collect()
+    }
+}
+
+#[test]
+fn download_logs_one_key_value_line_per_outcome() {
+    let capture = log_capture::install();
+    let bytes = body(10_000);
+    let spec = test_spec(&bytes);
+    let tmp = tempfile::tempdir().expect("tempdir");
+
+    let (http, _) = serving(bytes.clone());
+    block_on_with_watchdog(download_model(
+        http,
+        spec,
+        tmp.path().join("a"),
+        |_| {},
+        never_cancelled(),
+    ))
+    .expect("ok");
+    let (http, _) = serving(body(9_999));
+    let _ = block_on_with_watchdog(download_model(
+        http,
+        spec,
+        tmp.path().join("b"),
+        |_| {},
+        never_cancelled(),
+    ));
+
+    let lines: Vec<String> = log_capture::lines_of_this_thread(capture)
+        .into_iter()
+        .filter(|l| {
+            l.starts_with("voice_input event=")
+                && l.contains("model=tiny")
+                && l.contains("outcome=")
+        })
+        .collect();
+    assert_eq!(lines.len(), 2, "one line per download: {lines:?}");
+    assert!(lines[0].contains("bytes=10000"), "{}", lines[0]);
+    assert!(lines[1].contains("bytes=9999"), "{}", lines[1]);
+    assert_ne!(
+        lines[0].split("outcome=").nth(1),
+        lines[1].split("outcome=").nth(1),
+        "success and mismatch are distinguishable"
+    );
+    for line in &lines {
+        assert!(line.contains("duration"), "carries the duration: {line}");
+        for pair in line.split_whitespace().skip(1) {
+            assert!(pair.contains('='), "key=value only: {line}");
+        }
+    }
+}
