+// ── fakes ───────────────────────────────────────────────────────────────────
+
+#[derive(Default)]
+struct CaptureState {
+    devices: Mutex<Vec<Option<String>>>,
+    stops: AtomicUsize,
+    cancels: AtomicUsize,
+    fail_with: Mutex<Option<String>>,
+    samples: Mutex<(Vec<f32>, u32)>,
+    events: Mutex<Option<smol::channel::Sender<CaptureEvent>>>,
+}
+
+struct FakeBackend(Arc<CaptureState>);
+struct FakeActive(Arc<CaptureState>);
+
+impl CaptureBackend for FakeBackend {
+    fn start(
+        &self,
+        device: Option<cpal::DeviceId>,
+        events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        self.0
+            .devices
+            .lock()
+            .expect("lock")
+            .push(device.map(|d| format!("{d:?}")));
+        if let Some(reason) = self.0.fail_with.lock().expect("lock").clone() {
+            anyhow::bail!(reason);
+        }
+        *self.0.events.lock().expect("lock") = Some(events);
+        Ok(Box::new(FakeActive(self.0.clone())))
+    }
+}
+
+impl ActiveCapture for FakeActive {
+    fn stop(self: Box<Self>) -> Recording {
+        self.0.stops.fetch_add(1, Ordering::SeqCst);
+        let (samples, sample_rate) = self.0.samples.lock().expect("lock").clone();
+        Recording {
+            samples,
+            sample_rate,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {
+        self.0.cancels.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+fn speech(seconds: f32, rate: u32) -> (Vec<f32>, u32) {
+    let n = (seconds * rate as f32) as usize;
+    (
+        (0..n).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect(),
+        rate,
+    )
+}
+
+#[derive(Clone, Debug)]
+struct Seen {
+    method: Method,
+    uri: String,
+    authorization: Option<String>,
+}
+
+type Requests = Arc<Mutex<Vec<Seen>>>;
+
+fn http(status: u16, answer: &'static str) -> (Arc<dyn HttpClient>, Requests) {
+    let requests: Requests = Arc::default();
+    let log = requests.clone();
+    let client = FakeHttpClient::create(move |req| {
+        log.lock().expect("lock").push(Seen {
+            method: req.method().clone(),
+            uri: req.uri().to_string(),
+            authorization: req
+                .headers()
+                .get("authorization")
+                .and_then(|v| v.to_str().ok())
+                .map(str::to_string),
+        });
+        async move {
+            Ok(Response::builder()
+                .status(status)
+                .body(AsyncBody::from(answer))?)
+        }
+    });
+    (client, requests)
+}
+
+// ── harness ─────────────────────────────────────────────────────────────────
+
+struct Harness {
+    vi: Entity<VoiceInput>,
+    capture: Arc<CaptureState>,
+    requests: Requests,
+    events: Arc<Mutex<Vec<VoiceEvent>>>,
+    models: PathBuf,
+    _tmp: tempfile::TempDir,
+    owners: Vec<Entity<()>>,
+}
+
+impl Harness {
+    fn owner(&self, n: usize) -> EntityId {
+        self.owners[n].entity_id()
+    }
+    fn send(&self, input: Input, cx: &mut TestAppContext) {
+        self.vi.update(cx, |vi, cx| vi.handle(input, cx));
+    }
+    fn view(&self, owner: EntityId, cx: &mut TestAppContext) -> ViewState {
+        self.vi.read_with(cx, |vi, _| vi.view_state(owner))
+    }
+    fn notices(&self, owner: EntityId) -> Vec<String> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|e| match e {
+                VoiceEvent::Notify { owner: o, message } if *o == owner => {
+                    Some(message.to_string())
+                }
+                _ => None,
+            })
+            .collect()
+    }
+    fn inserts(&self) -> Vec<(EntityId, String)> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|e| match e {
+                VoiceEvent::Insert { owner, text } => Some((*owner, text.to_string())),
+                _ => None,
+            })
+            .collect()
+    }
+    fn requests(&self) -> Vec<Seen> {
+        self.requests.lock().expect("lock").clone()
+    }
+}
+
+fn setup(
+    settings_json: &str,
+    http_client: (Arc<dyn HttpClient>, Requests),
+    cx: &mut TestAppContext,
+) -> Harness {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(settings_json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models = tmp.path().join("voice").join("models");
+    let capture = Arc::new(CaptureState::default());
+    *capture.samples.lock().expect("lock") = speech(1.0, 48_000);
+    let (client, requests) = http_client;
+    let backend: Arc<dyn CaptureBackend> = Arc::new(FakeBackend(capture.clone()));
+    cx.update(|cx| init_in(client, models.clone(), backend, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    let owners = vec![cx.new(|_| ()), cx.new(|_| ())];
+    Harness {
+        vi,
+        capture,
+        requests,
+        events,
+        models,
+        _tmp: tmp,
+        owners,
+    }
+}
+
+fn o(id: EntityId) -> Owner {
+    Owner(id.as_u64())
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn record_and_stop(h: &Harness, owner: EntityId, cx: &mut TestAppContext) {
+    h.send(Input::Click { owner: o(owner) }, cx);
+    wait_until(cx, "the capture to start", |_| {
+        h.capture.devices.lock().expect("lock").len() == 1
+    });
+    wait_until(cx, "recording", |cx| {
+        matches!(h.view(owner, cx), ViewState::Recording { .. })
+    });
+    h.send(Input::Click { owner: o(owner) }, cx);
+}
+
+fn place_sparse_model(dir: &Path, model: VoiceModel) -> PathBuf {
+    std::fs::create_dir_all(dir).expect("dir");
+    let s = spec(model);
+    let path = dir.join(s.file);
+    std::fs::File::create(&path)
+        .and_then(|f| f.set_len(s.size))
+        .expect("sparse model");
+    path
+}
