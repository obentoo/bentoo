+++ b/crates/voice_input/src/remote.rs
@@ -0,0 +1,435 @@
+//! Remote transcription: an OpenAI-compatible `/audio/transcriptions` endpoint, opt-in.
+
+use std::cell::Cell;
+use std::hash::{BuildHasher as _, Hasher as _, RandomState};
+use std::net::Ipv6Addr;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use anyhow::{Context as _, anyhow, bail};
+use futures::{AsyncReadExt as _, FutureExt as _};
+use http_client::http::HeaderValue;
+use http_client::{AsyncBody, HttpClient, HttpRequestExt as _, Method, RedirectPolicy, Request};
+use serde::Deserialize;
+use url::{Host, Url};
+
+use crate::Language;
+
+/// How long the service has to answer, body included, before the request fails (R8.6).
+pub const REMOTE_TIMEOUT: Duration = Duration::from_secs(60);
+
+/// At most this much of a non-success answer's body is carried into the error.
+const ERROR_BODY_LIMIT: usize = 200;
+
+/// A success answer larger than this is refused: a two-minute transcript is a few KiB of JSON.
+const ANSWER_LIMIT: usize = 1024 * 1024;
+
+#[derive(Deserialize)]
+struct Answer {
+    text: String,
+}
+
+/// Accepts `https` to any host, and plain `http` only to `localhost`, `127.0.0.0/8` or `::1`.
+/// A URL carrying user-info is refused whatever its scheme: the key belongs in the environment.
+/// A fragment is refused too: it never reaches the server, but it would reach transport errors.
+pub fn validate_url(raw: &str) -> anyhow::Result<Url> {
+    // `raw` is never echoed: it may carry credentials.
+    let url = Url::parse(raw).context("The remote voice URL is not a valid URL")?;
+    let scheme = url.scheme();
+    let host = url
+        .host_str()
+        .filter(|host| !host.is_empty())
+        .unwrap_or("no host");
+    if !url.username().is_empty() || url.password().is_some() {
+        bail!(
+            "The remote voice URL must not carry credentials ({scheme}://…@{host}); \
+             the API key is read from the environment variable named by `api_key_env`"
+        );
+    }
+    if url.fragment().is_some() {
+        bail!("The remote voice URL must not carry a fragment ({scheme}://{host})");
+    }
+    // `scrub` cuts a query at the first `)`, which the `url` crate leaves unencoded.
+    if url.query().is_some_and(|query| query.contains(')')) {
+        bail!("The remote voice URL's query must not contain `)` ({scheme}://{host})");
+    }
+    let loopback = match url.host() {
+        Some(Host::Domain(domain)) => domain == "localhost",
+        Some(Host::Ipv4(address)) => address.is_loopback(),
+        Some(Host::Ipv6(address)) => address == Ipv6Addr::LOCALHOST,
+        None => false,
+    };
+    match scheme {
+        "https" => Ok(url),
+        "http" if loopback => Ok(url),
+        "http" => bail!(
+            "The remote voice URL must use https: {scheme}://{host} is not a loopback address"
+        ),
+        _ => bail!("The remote voice URL must use https, not {scheme} ({host})"),
+    }
+}
+
+/// The environment variables reqwest reads a proxy from on its own, whatever Zed's settings say.
+pub const PROXY_ENV_VARS: [&str; 6] = [
+    "HTTP_PROXY",
+    "http_proxy",
+    "HTTPS_PROXY",
+    "https_proxy",
+    "ALL_PROXY",
+    "all_proxy",
+];
+
+/// The refusal shown when a plain-http `url` would go through a proxy. `validate_url` admits
+/// plain http only because loopback traffic never leaves the machine; a proxy breaks that
+/// premise, and the audio and the bearer key would reach it unencrypted.
+///
+/// `client_proxy` is the HTTP client's own proxy; `proxy_env` holds the values of
+/// [`PROXY_ENV_VARS`], which reqwest also reads by itself (even ones Zed could not parse). Any
+/// proxy refuses plain http: `NO_PROXY` is deliberately not consulted, because predicting
+/// reqwest's exemption rules wrongly would leak, and refusing only costs a switch to https.
+pub fn proxy_refusal(
+    url: &Url,
+    client_proxy: Option<&Url>,
+    proxy_env: &[Option<String>],
+) -> Option<String> {
+    if url.scheme() != "http" {
+        return None;
+    }
+    let env_proxy = proxy_env
+        .iter()
+        .flatten()
+        .any(|value| !value.trim().is_empty());
+    if client_proxy.is_none() && !env_proxy {
+        return None;
+    }
+    Some("The remote voice URL uses plain http while a proxy is configured; use https".to_string())
+}
+
+/// The URL as it may be shown or logged: scheme, host, port and path, nothing else (R10.3).
+pub fn redacted(url: &Url) -> String {
+    let host = url.host_str().unwrap_or_default();
+    let port = url
+        .port()
+        .map(|port| format!(":{port}"))
+        .unwrap_or_default();
+    format!("{}://{host}{port}{}", url.scheme(), url.path())
+}
+
+/// A random multipart boundary that does not occur anywhere in `wav`.
+pub fn new_boundary(wav: &[u8]) -> String {
+    loop {
+        // `RandomState` is seeded randomly and every instance gets different keys, which is all a
+        // boundary needs: it must not collide with the payload, it need not be secret.
+        let high = RandomState::new().build_hasher().finish();
+        let low = RandomState::new().build_hasher().finish();
+        let boundary = format!("zeo-voice-{high:016x}{low:016x}");
+        if !contains(wav, boundary.as_bytes()) {
+            return boundary;
+        }
+    }
+}
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    haystack
+        .windows(needle.len())
+        .any(|window| window == needle)
+}
+
+/// The `multipart/form-data` body of a transcription request, delimited by `boundary`.
+pub fn multipart(boundary: &str, wav: &[u8], model: &str, language: &Language) -> Vec<u8> {
+    let mut body = Vec::with_capacity(wav.len() + 512);
+    body.extend_from_slice(
+        format!(
+            "--{boundary}\r\n\
+             Content-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\n\
+             Content-Type: audio/wav\r\n\r\n"
+        )
+        .as_bytes(),
+    );
+    body.extend_from_slice(wav);
+    body.extend_from_slice(b"\r\n");
+
+    let mut field = |name: &str, value: &str| {
+        body.extend_from_slice(
+            format!(
+                "--{boundary}\r\n\
+                 Content-Disposition: form-data; name=\"{name}\"\r\n\r\n\
+                 {value}\r\n"
+            )
+            .as_bytes(),
+        );
+    };
+    field("model", model);
+    field("response_format", "json");
+    // Without the field the service detects the language itself (R7.4).
+    if let Language::Code(code) = language {
+        field("language", code);
+    }
+
+    body.extend_from_slice(format!("--{boundary}--\r\n").as_bytes());
+    body
+}
+
+/// [`transcribe_within`] with the [`REMOTE_TIMEOUT`] of R8.6.
+pub async fn transcribe(
+    http: Arc<dyn HttpClient>,
+    url: &Url,
+    key: Option<String>,
+    body: Vec<u8>,
+    boundary: &str,
+) -> anyhow::Result<String> {
+    transcribe_within(http, url, key, body, boundary, REMOTE_TIMEOUT).await
+}
+
+/// Posts `body` (built by [`multipart`] with `boundary`) to `url` and returns the `text` of the
+/// answer. `key`, when present, is sent as a bearer token and nowhere else (R8.5, R8.8, R10.3).
+///
+/// The whole exchange, body included, must end within `timeout`. A non-success status is an
+/// error carrying the status and at most 200 bytes of the body (R8.6).
+pub async fn transcribe_within(
+    http: Arc<dyn HttpClient>,
+    url: &Url,
+    key: Option<String>,
+    body: Vec<u8>,
+    boundary: &str,
+    timeout: Duration,
+) -> anyhow::Result<String> {
+    let shown = redacted(url);
+    let log = RemoteLog {
+        url: shown.clone(),
+        started: Instant::now(),
+        status: Cell::new(None),
+        outcome: Cell::new("cancelled"),
+    };
+
+    let request = match build_request(url, key.as_deref(), body, boundary) {
+        Ok(request) => request,
+        Err(error) => {
+            log.outcome.set("request");
+            return Err(error.context(format!(
+                "building the remote transcription request for {shown}"
+            )));
+        }
+    };
+
+    // `smol::Timer` because this future runs outside gpui and takes no executor (as in
+    // `download.rs`); the tests drive it with `futures::executor::block_on`.
+    #[allow(clippy::disallowed_methods)]
+    let timer = smol::Timer::after(timeout);
+    let result = futures::select_biased! {
+        result = exchange(http.as_ref(), request, &shown, key.as_deref(), &log).fuse() => result,
+        _ = timer.fuse() => {
+            log.outcome.set("timeout");
+            Err(anyhow!(
+                "Remote transcription timed out after {} s ({shown})",
+                timeout.as_secs_f64()
+            ))
+        }
+    };
+    if result.is_ok() {
+        log.outcome.set("ok");
+    }
+    result
+}
+
+fn build_request(
+    url: &Url,
+    key: Option<&str>,
+    body: Vec<u8>,
+    boundary: &str,
+) -> anyhow::Result<Request<AsyncBody>> {
+    let authorization = match key {
+        Some(key) => {
+            // The `http` error does not carry the value, and neither does this one.
+            let mut value = HeaderValue::from_str(&format!("Bearer {key}")).map_err(|_| {
+                anyhow!("The remote voice API key is not a valid HTTP header value")
+            })?;
+            value.set_sensitive(true);
+            Some(value)
+        }
+        None => None,
+    };
+    Ok(Request::builder()
+        .method(Method::POST)
+        .uri(url.as_str())
+        // A redirect would carry the bearer token to whatever host it names.
+        .follow_redirects(RedirectPolicy::NoFollow)
+        .header(
+            "Content-Type",
+            format!("multipart/form-data; boundary={boundary}"),
+        )
+        .when_some(authorization, |builder, value| {
+            builder.header("Authorization", value)
+        })
+        .body(AsyncBody::from(body))?)
+}
+
+async fn exchange(
+    http: &dyn HttpClient,
+    request: Request<AsyncBody>,
+    shown: &str,
+    key: Option<&str>,
+    log: &RemoteLog,
+) -> anyhow::Result<String> {
+    let mut response = match http.send(request).await {
+        Ok(response) => response,
+        Err(error) => {
+            log.outcome.set("send");
+            return Err(anyhow!(
+                "Remote transcription failed: could not reach {shown}: {}",
+                scrub(&error, shown)
+            ));
+        }
+    };
+    let status = response.status();
+    log.status.set(Some(status.as_u16()));
+
+    if !status.is_success() {
+        log.outcome.set("http");
+        // Read past the limit by the key's length, so a key straddling the cut is still whole
+        // when it is redacted.
+        let limit = ERROR_BODY_LIMIT + key.map_or(0, str::len);
+        let mut head = Vec::new();
+        let read = response
+            .body_mut()
+            .take(limit as u64)
+            .read_to_end(&mut head)
+            .await;
+        // The body only decorates the status error; failing to read it leaves the status alone.
+        let excerpt = match read {
+            Ok(_) => body_excerpt(&head, key),
+            Err(_) => String::new(),
+        };
+        let status = status.as_u16();
+        if excerpt.is_empty() {
+            bail!("Remote transcription failed: HTTP {status} from {shown}");
+        }
+        bail!("Remote transcription failed: HTTP {status} from {shown}: {excerpt}");
+    }
+
+    let mut bytes = Vec::new();
+    let read = response
+        .body_mut()
+        .take(ANSWER_LIMIT as u64 + 1)
+        .read_to_end(&mut bytes)
+        .await;
+    if let Err(error) = read {
+        log.outcome.set("body");
+        return Err(anyhow!(
+            "Remote transcription failed: reading the answer of {shown}: {}",
+            scrub(&anyhow::Error::from(error), shown)
+        ));
+    }
+    if bytes.len() > ANSWER_LIMIT {
+        log.outcome.set("too_large");
+        bail!(
+            "Remote transcription failed: the transcription answer of {shown} is larger than 1 MiB"
+        );
+    }
+    match serde_json::from_slice::<Answer>(&bytes) {
+        Ok(answer) => Ok(answer.text),
+        Err(error) => {
+            log.outcome.set("parse");
+            Err(anyhow::Error::from(error).context(format!(
+                "Remote transcription failed: {shown} did not answer with a JSON `text` field"
+            )))
+        }
+    }
+}
+
+/// At most [`ERROR_BODY_LIMIT`] bytes of `head`, on one line, with no trace of `key` (R10.3):
+/// a service may echo the key it refused.
+fn body_excerpt(head: &[u8], key: Option<&str>) -> String {
+    let mut text = String::from_utf8_lossy(head).into_owned();
+    let key = key.filter(|key| !key.is_empty());
+    if let Some(key) = key {
+        text = text.replace(key, "[redacted]");
+    }
+    // One error, one log line (Q14): a service must not be able to break or forge a line.
+    let mut text: String = text
+        .chars()
+        .map(|character| {
+            if character.is_control() {
+                ' '
+            } else {
+                character
+            }
+        })
+        .collect();
+    let mut end = text.len().min(ERROR_BODY_LIMIT);
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    text.truncate(end);
+    // A key cut by the read limit or by the truncation survives the replace as a prefix of itself
+    // at the very end; redaction shortens what precedes it, so this can be any echo, not only the
+    // first.
+    if let Some(key) = key {
+        let partial = (1..key.len())
+            .rev()
+            .find(|&length| text.as_bytes().ends_with(&key.as_bytes()[..length]));
+        if let Some(length) = partial {
+            let cut = text.len() - length;
+            if text.is_char_boundary(cut) {
+                text.truncate(cut);
+            }
+        }
+    }
+    text.trim().to_owned()
+}
+
+/// The formatted error chain with the query (and any fragment) cut after every occurrence of the
+/// redacted URL. Transport errors name the URL they failed on, query included, and reqwest may
+/// already have rewritten part of it, so the URL cannot be matched as a whole (R10.3).
+fn scrub(error: &anyhow::Error, shown: &str) -> String {
+    let text = format!("{error:#}");
+    let mut scrubbed = String::with_capacity(text.len());
+    let mut rest = text.as_str();
+    while let Some(at) = rest.find(shown) {
+        let after = at + shown.len();
+        scrubbed.push_str(&rest[..after]);
+        rest = &rest[after..];
+        if rest.starts_with(['?', '#']) {
+            let end = rest
+                .find(|character: char| {
+                    character == ')' || character == '"' || character.is_whitespace()
+                })
+                .unwrap_or(rest.len());
+            rest = &rest[end..];
+        }
+    }
+    scrubbed.push_str(rest);
+    scrubbed
+}
+
+/// Logs exactly one `remote_transcribe` line when the request ends — including when the future is
+/// dropped mid-request, reported as `cancelled`. Only the redacted URL appears (R10.3).
+struct RemoteLog {
+    url: String,
+    started: Instant,
+    status: Cell<Option<u16>>,
+    outcome: Cell<&'static str>,
+}
+
+impl Drop for RemoteLog {
+    fn drop(&mut self) {
+        let outcome = self.outcome.get();
+        let level = match outcome {
+            "ok" | "cancelled" => log::Level::Info,
+            _ => log::Level::Warn,
+        };
+        let status = self
+            .status
+            .get()
+            .map(|status| status.to_string())
+            .unwrap_or_else(|| "none".to_owned());
+        log::log!(
+            level,
+            "voice_input event=remote_transcribe url={} status={} duration_ms={} outcome={}",
+            self.url,
+            status,
+            self.started.elapsed().as_millis(),
+            outcome
+        );
+    }
+}
diff --git a/crates/voice_input/src/remote_host_tests.rs b/crates/voice_input/src/remote_host_tests.rs
new file mode 100644
index 0000000..6586f6e
--- /dev/null
+++ b/crates/voice_input/src/remote_host_tests.rs
@@ -0,0 +1,173 @@
+// Story 044, task 5.2 fix round 1 (L2) — the host the button names while audio is in flight
+// (R8.3, R8.7). `VoiceInput::remote_host` answers the host of the recording in flight, which is the
+// backend it is transcribed by, and the configured host otherwise.
+//
+// Hostile halves: the host is named while recording AND while transcribing; it stays the
+// recording's own after the settings switch to local mid-recording AND it is `None` for a
+// recording made in local mode.
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use gpui::{AppContext as _, Entity, EntityId, TestAppContext, UpdateGlobal as _};
+use http_client::{FakeHttpClient, HttpClient};
+use settings::SettingsStore;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Ended, Recording};
+use crate::state::{Input, Owner};
+use crate::{ViewState, VoiceInput, init_in};
+
+const REMOTE: &str = r#"{ "voice_input": { "remote": { "enabled": true,
+    "url": "https://api.groq.com/openai/v1/audio/transcriptions",
+    "api_key_env": "ZEO_VOICE_TEST_UNSET_044_REMOTE_HOST" } } }"#;
+
+struct Backend(Arc<AtomicUsize>);
+struct Active;
+
+impl CaptureBackend for Backend {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Ok(Box::new(Active))
+    }
+}
+
+impl ActiveCapture for Active {
+    fn stop(self: Box<Self>) -> Recording {
+        let samples = (0..48_000).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: 48_000,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {}
+}
+
+fn set_settings(json: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+}
+
+/// A voice input whose remote service never answers, so a transcription stays in flight.
+fn setup(settings_json: &str, cx: &mut TestAppContext) -> (Entity<VoiceInput>, tempfile::TempDir) {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    set_settings(settings_json, cx);
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models = tmp.path().join("voice").join("models");
+    let http: Arc<dyn HttpClient> =
+        FakeHttpClient::create(|_| futures::future::pending::<anyhow::Result<_>>());
+    let backend: Arc<dyn CaptureBackend> = Arc::new(Backend(Arc::default()));
+    cx.update(|cx| init_in(http, models, backend, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    cx.run_until_parked();
+    (vi, tmp)
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn click(vi: &Entity<VoiceInput>, owner: EntityId, cx: &mut TestAppContext) {
+    vi.update(cx, |vi, cx| {
+        vi.handle(
+            Input::Click {
+                owner: Owner(owner.as_u64()),
+            },
+            cx,
+        )
+    });
+}
+
+fn view(vi: &Entity<VoiceInput>, owner: EntityId, cx: &mut TestAppContext) -> ViewState {
+    vi.read_with(cx, |vi, _| vi.view_state(owner))
+}
+
+fn host(vi: &Entity<VoiceInput>, cx: &mut TestAppContext) -> Option<String> {
+    vi.read_with(cx, |vi, _| vi.remote_host())
+}
+
+#[gpui::test]
+async fn remote_host_is_named_while_recording_and_transcribing(cx: &mut TestAppContext) {
+    let (vi, _tmp) = setup(REMOTE, cx);
+    let owner = cx.new(|_| ()).entity_id();
+    assert_eq!(
+        host(&vi, cx).as_deref(),
+        Some("api.groq.com"),
+        "idle, remote"
+    );
+
+    click(&vi, owner, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(view(&vi, owner, cx), ViewState::Recording { .. })
+    });
+    assert_eq!(host(&vi, cx).as_deref(), Some("api.groq.com"), "recording");
+
+    // Switched to local while recording: the audio still goes to the host it was recorded for.
+    set_settings("{}", cx);
+    cx.run_until_parked();
+    assert_eq!(
+        host(&vi, cx).as_deref(),
+        Some("api.groq.com"),
+        "the recording's own host"
+    );
+
+    click(&vi, owner, cx);
+    wait_until(cx, "transcribing", |cx| {
+        matches!(view(&vi, owner, cx), ViewState::Transcribing)
+    });
+    assert_eq!(
+        host(&vi, cx).as_deref(),
+        Some("api.groq.com"),
+        "transcribing"
+    );
+}
+
+#[gpui::test]
+async fn remote_host_is_none_for_a_local_recording(cx: &mut TestAppContext) {
+    let (vi, tmp) = setup(r#"{ "voice_input": { "model": "tiny" } }"#, cx);
+    // A sparse file of the pinned size counts as present, so the click records instead of asking.
+    let dir = tmp.path().join("voice").join("models");
+    std::fs::create_dir_all(&dir).expect("dir");
+    let spec = crate::models::spec(crate::models::VoiceModel::Tiny);
+    std::fs::File::create(dir.join(spec.file))
+        .and_then(|file| file.set_len(spec.size))
+        .expect("sparse model");
+
+    let owner = cx.new(|_| ()).entity_id();
+    click(&vi, owner, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(view(&vi, owner, cx), ViewState::Recording { .. })
+    });
+    assert_eq!(host(&vi, cx), None, "local mode names no host");
+}
diff --git a/crates/voice_input/src/remote_loopback_tests.rs b/crates/voice_input/src/remote_loopback_tests.rs
new file mode 100644
index 0000000..a50c495
--- /dev/null
+++ b/crates/voice_input/src/remote_loopback_tests.rs
@@ -0,0 +1,416 @@
+// Story 044, task 8.4 (refine v3) — plain http to a loopback host goes direct, and an empty key
+// name is no key (R8.4, R8.5, R8.8, R8.9; design.md C1.8, C1.10 `set_loopback_http`). Wired in
+// the crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod remote_loopback_tests;
+//
+// Validation filter: `remote_loopback` (every test path is `remote_loopback_tests::…`).
+//
+// Contract: `VoiceInput::set_loopback_http(&mut self, http: Arc<dyn HttpClient>)` sets a
+// proxy-less client. A plain-http (hence loopback, R8.4) remote URL is sent through it, even when
+// the app's client has a proxy; an https URL is sent through the app's client; with no proxy-less
+// client set, plain http behind a proxy is refused as today. `voice_input.remote.api_key_env: ""`
+// sends no Authorization header; a named variable that is set is still sent as a bearer (R8.5),
+// through either client.
+//
+// The app's client is a `FakeHttpClient` behind `HttpClientWithProxy` with a proxy URL, which is
+// what `proxy()` reports for Zed's configured proxy. `ReqwestClient::without_proxy` itself is
+// tested in `reqwest_client` (this crate cannot depend on it).
+// Gap: reqwest's own bypass of the environment proxies (`no_proxy()`) is not exercised against a
+// live proxy; that needs `set_var`, which is `unsafe` in edition 2024 and racy in a test binary.
+//
+// Hostile halves, the wrong collapse first: the proxy-less client is not a way around R8.4 — a
+// plain-http URL to a host that only looks like loopback (`127.0.0.1.example.com`) reaches
+// neither client — and it does not take https traffic away from the app's client; with no
+// proxy-less client the refusal stands. Then the wrong split: `localhost` and `[::1]`, spelled
+// differently from `127.0.0.1`, go direct too. Then the plain case.
+
+use std::{
+    path::PathBuf,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use gpui::{AppContext as _, Entity, EntityId, TestAppContext, UpdateGlobal as _};
+use http_client::{AsyncBody, FakeHttpClient, HttpClient, HttpClientWithProxy, Response, Url};
+use settings::SettingsStore;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Ended, Recording};
+use crate::state::{Input, Owner};
+use crate::{ViewState, VoiceEvent, VoiceInput, init_in};
+
+const PROXY_REFUSAL: &str =
+    "The remote voice URL uses plain http while a proxy is configured; use https";
+
+struct Mic;
+struct Active;
+
+impl CaptureBackend for Mic {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        Ok(Box::new(Active))
+    }
+}
+
+impl ActiveCapture for Active {
+    fn stop(self: Box<Self>) -> Recording {
+        let samples = (0..48_000).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: 48_000,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {}
+}
+
+/// What one fake client saw.
+#[derive(Clone, Default)]
+struct Seen {
+    requests: Arc<AtomicUsize>,
+    uris: Arc<Mutex<Vec<String>>>,
+    authorization: Arc<Mutex<Vec<Option<String>>>>,
+}
+
+impl Seen {
+    fn count(&self) -> usize {
+        self.requests.load(Ordering::SeqCst)
+    }
+    fn authorization(&self) -> Vec<Option<String>> {
+        self.authorization.lock().expect("lock").clone()
+    }
+}
+
+fn answering(seen: &Seen, text: &'static str) -> Arc<dyn HttpClient> {
+    let seen = seen.clone();
+    FakeHttpClient::create(move |request| {
+        seen.requests.fetch_add(1, Ordering::SeqCst);
+        seen.uris
+            .lock()
+            .expect("lock")
+            .push(request.uri().to_string());
+        seen.authorization.lock().expect("lock").push(
+            request
+                .headers()
+                .get("authorization")
+                .and_then(|value| value.to_str().ok())
+                .map(str::to_string),
+        );
+        async move {
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from(format!(r#"{{"text": "{text}"}}"#)))?)
+        }
+    })
+}
+
+struct Harness {
+    vi: Entity<VoiceInput>,
+    main: Seen,
+    loopback: Seen,
+    events: Arc<Mutex<Vec<VoiceEvent>>>,
+    _tmp: tempfile::TempDir,
+}
+
+impl Harness {
+    fn inserts(&self, owner: EntityId) -> Vec<String> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|event| match event {
+                VoiceEvent::Insert { owner: o, text } if *o == owner => Some(text.clone()),
+                _ => None,
+            })
+            .collect()
+    }
+    fn notices(&self, owner: EntityId) -> Vec<String> {
+        self.events
+            .lock()
+            .expect("lock")
+            .iter()
+            .filter_map(|event| match event {
+                VoiceEvent::Notify { owner: o, message } if *o == owner => Some(message.clone()),
+                _ => None,
+            })
+            .collect()
+    }
+    fn view(&self, owner: EntityId, cx: &mut TestAppContext) -> ViewState {
+        self.vi.read_with(cx, |vi, _| vi.view_state(owner))
+    }
+
+    /// Records one toggle recording for `owner` and waits until its transcript or notice arrives.
+    fn record(&self, owner: EntityId, cx: &mut TestAppContext) {
+        self.vi.update(cx, |vi, cx| {
+            vi.handle(
+                Input::Click {
+                    owner: Owner(owner.as_u64()),
+                },
+                cx,
+            )
+        });
+        wait_until(cx, "recording", |cx| {
+            matches!(self.view(owner, cx), ViewState::Recording { .. })
+        });
+        self.vi.update(cx, |vi, cx| {
+            vi.handle(
+                Input::Click {
+                    owner: Owner(owner.as_u64()),
+                },
+                cx,
+            )
+        });
+        wait_until(cx, "the transcript or a notice", |_| {
+            !self.inserts(owner).is_empty() || !self.notices(owner).is_empty()
+        });
+    }
+}
+
+fn remote_settings(url: &str, api_key_env: &str) -> String {
+    format!(
+        r#"{{ "voice_input": {{ "remote": {{ "enabled": true, "url": "{url}", "api_key_env": "{api_key_env}" }} }} }}"#
+    )
+}
+
+/// Remote mode on `url`; the app's client has a proxy; the proxy-less client is set when
+/// `with_loopback`.
+fn setup(url: &str, api_key_env: &str, with_loopback: bool, cx: &mut TestAppContext) -> Harness {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    let json = remote_settings(url, api_key_env);
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models: PathBuf = tmp.path().join("voice").join("models");
+    let main = Seen::default();
+    let loopback = Seen::default();
+    let proxy: Url = "http://proxy.corp:3128".parse().expect("proxy url");
+    let main_client: Arc<dyn HttpClient> = Arc::new(HttpClientWithProxy::new_url(
+        answering(&main, "through the main client"),
+        Some(proxy),
+    ));
+    assert!(
+        main_client.proxy().is_some(),
+        "precondition: the app's client has a proxy"
+    );
+    let capture: Arc<dyn CaptureBackend> = Arc::new(Mic);
+    cx.update(|cx| init_in(main_client, models, capture, cx));
+    let vi = cx.update(|cx| VoiceInput::global(cx));
+    if with_loopback {
+        let direct = answering(&loopback, "sent direct");
+        vi.update(cx, |vi, _| vi.set_loopback_http(direct));
+    }
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+    Harness {
+        vi,
+        main,
+        loopback,
+        events,
+        _tmp: tmp,
+    }
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+const UNSET_KEY: &str = "ZEO_VOICE_TEST_UNSET_044_LB";
+
+// ── the wrong collapse ──────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn remote_loopback_a_lookalike_host_reaches_neither_client(cx: &mut TestAppContext) {
+    let h = setup("http://127.0.0.1.example.com:9/v1/t", UNSET_KEY, true, cx);
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(
+        (h.main.count(), h.loopback.count()),
+        (0, 0),
+        "R8.4 nothing is sent for a plain-http URL whose host is not loopback"
+    );
+    assert!(h.inserts(a).is_empty());
+    let notices = h.notices(a);
+    assert!(
+        notices.iter().any(|notice| notice.contains("https")),
+        "R8.4 the user is told the URL must use https: {notices:?}"
+    );
+}
+
+#[gpui::test]
+async fn remote_loopback_https_still_goes_through_the_app_client(cx: &mut TestAppContext) {
+    let h = setup(
+        "https://stt.example/v1/audio/transcriptions",
+        UNSET_KEY,
+        true,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(
+        h.main.count(),
+        1,
+        "https uses the app's client, with its proxy"
+    );
+    assert_eq!(
+        h.loopback.count(),
+        0,
+        "the proxy-less client is for plain http only"
+    );
+    assert_eq!(h.inserts(a).len(), 1, "{:?}", h.notices(a));
+}
+
+#[gpui::test]
+async fn remote_loopback_without_a_proxy_less_client_the_refusal_stands(cx: &mut TestAppContext) {
+    let h = setup(
+        "http://127.0.0.1:9/v1/audio/transcriptions",
+        UNSET_KEY,
+        false,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(h.main.count(), 0, "nothing goes through the proxied client");
+    assert_eq!(h.notices(a), vec![PROXY_REFUSAL.to_string()]);
+    assert!(h.inserts(a).is_empty());
+}
+
+// ── the wrong split, then the plain case ───────────────────────────────────
+
+#[gpui::test]
+async fn remote_loopback_plain_http_to_127_0_0_1_goes_direct(cx: &mut TestAppContext) {
+    let h = setup(
+        "http://127.0.0.1:9/v1/audio/transcriptions",
+        UNSET_KEY,
+        true,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(
+        h.loopback.count(),
+        1,
+        "R8.9 the request reaches the proxy-less client: {:?}",
+        h.notices(a)
+    );
+    assert_eq!(h.main.count(), 0, "the proxied client sees nothing");
+    assert_eq!(
+        h.inserts(a).len(),
+        1,
+        "transcribed and inserted: {:?}",
+        h.notices(a)
+    );
+    assert!(
+        h.inserts(a)[0].to_lowercase().contains("sent direct"),
+        "the transcript is the loopback service's: {:?}",
+        h.inserts(a)
+    );
+}
+
+#[gpui::test]
+async fn remote_loopback_localhost_goes_direct(cx: &mut TestAppContext) {
+    let h = setup(
+        "http://localhost:8080/v1/audio/transcriptions",
+        UNSET_KEY,
+        true,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(
+        (h.loopback.count(), h.main.count()),
+        (1, 0),
+        "R8.9 localhost: {:?}",
+        h.notices(a)
+    );
+}
+
+#[gpui::test]
+async fn remote_loopback_ipv6_loopback_goes_direct(cx: &mut TestAppContext) {
+    let h = setup(
+        "http://[::1]:8080/v1/audio/transcriptions",
+        UNSET_KEY,
+        true,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(
+        (h.loopback.count(), h.main.count()),
+        (1, 0),
+        "R8.9 [::1]: {:?}",
+        h.notices(a)
+    );
+}
+
+// ── the key name ────────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn remote_loopback_an_empty_key_name_sends_no_authorization(cx: &mut TestAppContext) {
+    let h = setup("http://127.0.0.1:9/v1/audio/transcriptions", "", true, cx);
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(h.loopback.count(), 1, "sent: {:?}", h.notices(a));
+    assert_eq!(
+        h.loopback.authorization(),
+        vec![None],
+        "R8.8 api_key_env \"\" is no key"
+    );
+}
+
+#[gpui::test]
+async fn remote_loopback_a_set_key_is_still_sent_as_a_bearer(cx: &mut TestAppContext) {
+    // `PATH` is set in every test environment; setting a variable here would need `unsafe`.
+    let Ok(value) = std::env::var("PATH") else {
+        return;
+    };
+    let h = setup(
+        "http://127.0.0.1:9/v1/audio/transcriptions",
+        "PATH",
+        true,
+        cx,
+    );
+    let a = cx.new(|_| ()).entity_id();
+    h.record(a, cx);
+    assert_eq!(h.loopback.count(), 1, "sent: {:?}", h.notices(a));
+    assert_eq!(
+        h.loopback.authorization(),
+        vec![Some(format!("Bearer {value}"))],
+        "R8.5 the direct request carries the key too"
+    );
+}
diff --git a/crates/voice_input/src/remote_redirect_tests.rs b/crates/voice_input/src/remote_redirect_tests.rs
new file mode 100644
index 0000000..18a6e41
--- /dev/null
+++ b/crates/voice_input/src/remote_redirect_tests.rs
@@ -0,0 +1,197 @@
+// Story 044, task 8.4 fix round 1 (tech review L3) — the remote request never follows a redirect,
+// whichever client sends it (D22; `remote.rs` `build_request`). A redirect would carry the audio
+// and the bearer key to whatever host it names, and through the proxy-less client it would leave
+// the machine with no proxy in the way.
+//
+// `ReqwestClient::send` turns the request's `RedirectPolicy` into reqwest's per-request policy,
+// which wins over the client's default (`redirect::Policy::limited(10)`). A request without the
+// extension would therefore follow redirects: the test asserts the extension is present and is
+// `NoFollow`, on the app client (https) and on the proxy-less client (plain http to loopback).
+
+use std::{
+    path::PathBuf,
+    sync::{Arc, Mutex},
+    time::{Duration, Instant},
+};
+
+use gpui::{AppContext as _, Entity, EntityId, TestAppContext, UpdateGlobal as _};
+use http_client::{
+    AsyncBody, FakeHttpClient, HttpClient, HttpClientWithProxy, RedirectPolicy, Response, Url,
+};
+use settings::SettingsStore;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Ended, Recording};
+use crate::state::{Input, Owner};
+use crate::{ViewState, VoiceEvent, VoiceInput, init_in};
+
+struct Mic;
+struct Active;
+
+impl CaptureBackend for Mic {
+    fn start(
+        &self,
+        _device: Option<cpal::DeviceId>,
+        _events: smol::channel::Sender<CaptureEvent>,
+    ) -> anyhow::Result<Box<dyn ActiveCapture>> {
+        Ok(Box::new(Active))
+    }
+}
+
+impl ActiveCapture for Active {
+    fn stop(self: Box<Self>) -> Recording {
+        let samples = (0..48_000).map(|i| 0.2 * (i as f32 * 0.05).sin()).collect();
+        Recording {
+            samples,
+            sample_rate: 48_000,
+            ended: Ended::User,
+        }
+    }
+    fn cancel(self: Box<Self>) {}
+}
+
+/// The redirect policy of every request one fake client received.
+type Policies = Arc<Mutex<Vec<Option<RedirectPolicy>>>>;
+
+fn recording_policies(policies: &Policies) -> Arc<dyn HttpClient> {
+    let policies = policies.clone();
+    FakeHttpClient::create(move |request| {
+        policies
+            .lock()
+            .expect("lock")
+            .push(request.extensions().get::<RedirectPolicy>().cloned());
+        async move {
+            Ok(Response::builder()
+                .status(200)
+                .body(AsyncBody::from(r#"{"text": "hello"}"#.to_string()))?)
+        }
+    })
+}
+
+struct Sent {
+    main: Vec<Option<RedirectPolicy>>,
+    loopback: Vec<Option<RedirectPolicy>>,
+    inserts: usize,
+}
+
+/// One toggle recording in remote mode on `url`, with an app client behind a proxy and a
+/// proxy-less client set; returns what each client received.
+fn record_once(url: &str, cx: &mut TestAppContext) -> Sent {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+    let json = format!(
+        r#"{{ "voice_input": {{ "remote": {{ "enabled": true, "url": "{url}", "api_key_env": "" }} }} }}"#
+    );
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json, cx)
+                .result()
+                .expect("settings parse");
+        })
+    });
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let models: PathBuf = tmp.path().join("voice").join("models");
+    let main = Policies::default();
+    let loopback = Policies::default();
+    let proxy: Url = "http://proxy.corp:3128".parse().expect("proxy url");
+    let main_client: Arc<dyn HttpClient> = Arc::new(HttpClientWithProxy::new_url(
+        recording_policies(&main),
+        Some(proxy),
+    ));
+    let capture: Arc<dyn CaptureBackend> = Arc::new(Mic);
+    cx.update(|cx| init_in(main_client, models, capture, cx));
+    let vi: Entity<VoiceInput> = cx.update(|cx| VoiceInput::global(cx));
+    let direct = recording_policies(&loopback);
+    vi.update(cx, |vi, _| vi.set_loopback_http(direct));
+    let events: Arc<Mutex<Vec<VoiceEvent>>> = Arc::default();
+    let sink = events.clone();
+    cx.update(|cx| {
+        cx.subscribe(&vi, move |_, event: &VoiceEvent, _| {
+            sink.lock().expect("lock").push(event.clone())
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+
+    let owner: EntityId = cx.new(|_| ()).entity_id();
+    let click = |vi: &Entity<VoiceInput>, cx: &mut TestAppContext| {
+        vi.update(cx, |vi, cx| {
+            vi.handle(
+                Input::Click {
+                    owner: Owner(owner.as_u64()),
+                },
+                cx,
+            )
+        })
+    };
+    click(&vi, cx);
+    wait_until(cx, "recording", |cx| {
+        matches!(
+            vi.read_with(cx, |vi, _| vi.view_state(owner)),
+            ViewState::Recording { .. }
+        )
+    });
+    click(&vi, cx);
+    let answered = |events: &Mutex<Vec<VoiceEvent>>| {
+        events.lock().expect("lock").iter().any(|event| {
+            matches!(event, VoiceEvent::Insert { owner: o, .. } | VoiceEvent::Notify { owner: o, .. } if *o == owner)
+        })
+    };
+    wait_until(cx, "the transcript or a notice", |_| answered(&events));
+    let inserts = events
+        .lock()
+        .expect("lock")
+        .iter()
+        .filter(|event| matches!(event, VoiceEvent::Insert { owner: o, .. } if *o == owner))
+        .count();
+    let sent = Sent {
+        main: main.lock().expect("lock").clone(),
+        loopback: loopback.lock().expect("lock").clone(),
+        inserts,
+    };
+    drop(tmp);
+    sent
+}
+
+fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[gpui::test]
+async fn remote_redirect_the_app_client_request_follows_no_redirect(cx: &mut TestAppContext) {
+    let sent = record_once("https://stt.example/v1/audio/transcriptions", cx);
+    assert_eq!(sent.inserts, 1, "transcribed through the app client");
+    assert!(sent.loopback.is_empty(), "https stays on the app client");
+    assert_eq!(
+        sent.main,
+        vec![Some(RedirectPolicy::NoFollow)],
+        "D22 a redirect would carry the key to the host it names"
+    );
+}
+
+#[gpui::test]
+async fn remote_redirect_the_loopback_request_follows_no_redirect(cx: &mut TestAppContext) {
+    let sent = record_once("http://127.0.0.1:9/v1/audio/transcriptions", cx);
+    assert_eq!(sent.inserts, 1, "transcribed through the proxy-less client");
+    assert!(sent.main.is_empty(), "plain http to loopback goes direct");
+    assert_eq!(
+        sent.loopback,
+        vec![Some(RedirectPolicy::NoFollow)],
+        "D22 a loopback redirect would leave the machine with no proxy in the way"
+    );
+}
