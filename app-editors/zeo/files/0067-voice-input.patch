+            .start_icon(
+                Icon::new(IconName::Mic)
+                    .size(IconSize::Small)
+                    .color(Color::Error),
+            )
+            .label_size(LabelSize::Small)
+            .color(Color::Error)
+            .style(ButtonStyle::Tinted(TintColor::Error))
+            .width(RECORDING_WIDTH)
+            .aria_label(label)
+            .disabled(disabled)
+            .tooltip(Tooltip::text(tooltip))
+            .on_click(on_click)
+            .into_any_element(),
+        // R4.5/R5.2: a spinner, which takes no click and no focus.
+        ViewState::Transcribing => div()
+            .id(BUTTON_ID)
+            .px_1()
+            .role(Role::ProgressIndicator)
+            .aria_label(label)
+            .tooltip(Tooltip::text(tooltip))
+            .child(
+                Icon::new(IconName::LoadCircle)
+                    .size(IconSize::Small)
+                    .color(Color::Muted)
+                    .with_rotate_animation(2),
+            )
+            .into_any_element(),
+        ViewState::Idle { .. }
+        | ViewState::Busy
+        | ViewState::AwaitingConsent { .. }
+        | ViewState::Downloading { .. } => IconButton::new(BUTTON_ID, IconName::Mic)
+            .icon_size(IconSize::Small)
+            .icon_color(Color::Muted)
+            .aria_label(label)
+            .disabled(disabled)
+            .tooltip(Tooltip::text(tooltip))
+            .on_click(on_click)
+            .into_any_element(),
+    };
+    Some(element)
+}
+
+/// The voice shortcut the tooltip shows: the binding of highest precedence, preferring the
+/// bindings active where the composer has focus.
+pub fn toggle_binding(window: &Window, focus: &FocusHandle) -> Option<KeyBinding> {
+    window
+        .highest_precedence_binding_for_action_in(&ToggleRecording, focus)
+        .or_else(|| window.highest_precedence_binding_for_action(&ToggleRecording))
+}
+
+/// Every binding of the voice shortcut, with the same preference and fallback as
+/// [`toggle_binding`]. The key-up handler matches a release against all of them: a user's second
+/// binding on another key presses the shortcut, so its key-up has to release it.
+pub fn toggle_bindings(window: &Window, focus: &FocusHandle) -> Vec<KeyBinding> {
+    let bindings = window.bindings_for_action_in(&ToggleRecording, focus);
+    if bindings.is_empty() {
+        window.bindings_for_action(&ToggleRecording)
+    } else {
+        bindings
+    }
+}
+
+/// Whether `released` lets go of the shortcut `binding`: its last keystroke's non-modifier key,
+/// whatever modifiers are still down. The chord may be released in any order, and X11 sends no
+/// key-up for a modifier key itself.
+pub fn releases_binding(released: &Keystroke, binding: &KeyBinding) -> bool {
+    binding
+        .keystrokes()
+        .last()
+        .is_some_and(|keystroke| keystroke.inner().key.eq_ignore_ascii_case(&released.key))
+}
+
+/// The strip above the editor: the download consent (R6.1, R6.7) or the download's progress
+/// with its Cancel control (R6.3). Nothing in every other state.
+///
+/// Its controls are tab stops, so they can be reached and pressed without a mouse (M1). The
+/// border sits below it: the composer already draws the rule above.
+pub fn render_voice_strip(state: &ViewState, cx: &App) -> Option<AnyElement> {
+    match state {
+        // `Callout` draws its severity's icon; `.icon(..)` only turns it on.
+        ViewState::AwaitingConsent { model, size } => Some(
+            Callout::new()
+                .icon(IconName::Info)
+                .severity(Severity::Info)
+                .border_position(CalloutBorderPosition::Bottom)
+                .title(consent_text(*model, size))
+                .actions_slot(
+                    h_flex()
+                        .gap_1()
+                        .child(
+                            Button::new("voice-input-consent-decline", "Not now")
+                                .label_size(LabelSize::Small)
+                                .tab_index(0_isize)
+                                .on_click(|_, _, cx| send(Input::ConsentDeclined, cx)),
+                        )
+                        .child(
+                            Button::new("voice-input-consent-download", "Download")
+                                .label_size(LabelSize::Small)
+                                .style(ButtonStyle::Filled)
+                                .tab_index(0_isize)
+                                .on_click(|_, _, cx| send(Input::ConsentGiven, cx)),
+                        ),
+                )
+                .into_any_element(),
+        ),
+        ViewState::Downloading { percent } => Some(
+            Callout::new()
+                .icon(IconName::Info)
+                .severity(Severity::Info)
+                .border_position(CalloutBorderPosition::Bottom)
+                .title("Downloading the speech model")
+                .actions_slot(
+                    div()
+                        .debug_selector(|| "voice-input-download-cancel".into())
+                        .child(
+                            Button::new("voice-input-download-cancel", "Cancel")
+                                .label_size(LabelSize::Small)
+                                .tab_index(0_isize)
+                                .on_click(|_, _, cx| send(Input::DownloadCancel, cx)),
+                        ),
+                )
+                .description_slot(
+                    h_flex()
+                        .w_full()
+                        .gap_2()
+                        .child(div().flex_1().child(ProgressBar::new(
+                            "voice-input-download-progress",
+                            f32::from(*percent),
+                            100.,
+                            cx,
+                        )))
+                        .child(
+                            Label::new(format!("{percent}%"))
+                                .size(LabelSize::Small)
+                                .color(Color::Muted),
+                        ),
+                )
+                .into_any_element(),
+        ),
+        ViewState::Hidden
+        | ViewState::Idle { .. }
+        | ViewState::Busy
+        | ViewState::Recording { .. }
+        | ViewState::Transcribing => None,
+    }
+}
+
+/// The button's tooltip: the action and its shortcut (R1.1), the remote host when audio would
+/// leave the machine (R8.3), or why the button is disabled (R1.3, R5.1). Names the host only
+/// while idle, from the state itself; see [`tooltip_text_with_host`].
+pub fn tooltip_text(state: &ViewState, read_only: bool, binding: Option<&str>) -> String {
+    if read_only {
+        return READ_ONLY.to_string();
+    }
+    match state {
+        ViewState::Hidden => LABEL.to_string(),
+        ViewState::Idle { remote_host } => {
+            with_host(with_binding(LABEL, binding), remote_host.as_deref())
+        }
+        ViewState::Busy => BUSY.to_string(),
+        ViewState::AwaitingConsent { .. } => {
+            "Voice input is waiting for the model download to be confirmed".to_string()
+        }
+        ViewState::Downloading { .. } => "Voice input is downloading the speech model".to_string(),
+        ViewState::Recording { .. } => with_binding("Stop recording", binding),
+        ViewState::Transcribing => "Transcribing…".to_string(),
+    }
+}
+
+/// [`tooltip_text`], also naming `remote_host` while recording and transcribing, when the audio
+/// in flight goes to it (R8.3).
+pub fn tooltip_text_with_host(
+    state: &ViewState,
+    read_only: bool,
+    binding: Option<&str>,
+    remote_host: Option<&str>,
+) -> String {
+    let text = tooltip_text(state, read_only, binding);
+    if read_only {
+        return text;
+    }
+    match state {
+        ViewState::Recording { .. } | ViewState::Transcribing => with_host(text, remote_host),
+        ViewState::Hidden
+        | ViewState::Idle { .. }
+        | ViewState::Busy
+        | ViewState::AwaitingConsent { .. }
+        | ViewState::Downloading { .. } => text,
+    }
+}
+
+/// What a screen reader announces for the button: the control, not its bare time.
+pub fn aria_label(state: &ViewState) -> String {
+    match state {
+        ViewState::Recording { elapsed } => format!("Stop recording ({})", elapsed_label(*elapsed)),
+        ViewState::Transcribing => "Transcribing voice input".to_string(),
+        ViewState::Hidden
+        | ViewState::Idle { .. }
+        | ViewState::Busy
+        | ViewState::AwaitingConsent { .. }
+        | ViewState::Downloading { .. } => LABEL.to_string(),
+    }
+}
+
+/// Whether the button takes no click: read-only (R1.3), busy elsewhere (R5.1), transcribing
+/// (R4.5, R5.2), or while the strip is the control (consent, download). Idle and recording stay
+/// clickable — a click is what stops a recording (R2.3).
+pub fn is_disabled(state: &ViewState, read_only: bool) -> bool {
+    if read_only {
+        return true;
+    }
+    match state {
+        ViewState::Idle { .. } | ViewState::Recording { .. } => false,
+        ViewState::Hidden
+        | ViewState::Busy
+        | ViewState::AwaitingConsent { .. }
+        | ViewState::Downloading { .. }
+        | ViewState::Transcribing => true,
+    }
+}
+
+/// The elapsed recording time as `m:ss`, truncated to the whole second (R2.4).
+pub fn elapsed_label(elapsed: Duration) -> String {
+    let seconds = elapsed.as_secs();
+    format!("{}:{:02}", seconds / 60, seconds % 60)
+}
+
+/// The consent question: the model, its download size and the host it comes from (R6.1).
+pub fn consent_text(model: VoiceModel, size: &str) -> String {
+    format!(
+        "Voice input needs the speech model {} ({size}) from {MODEL_HOST}. Download it?",
+        model_name(model)
+    )
+}
+
+fn model_name(model: VoiceModel) -> &'static str {
+    match model {
+        VoiceModel::Tiny => "tiny",
+        VoiceModel::Base => "base",
+        VoiceModel::Small => "small",
+    }
+}
+
+fn with_binding(label: &str, binding: Option<&str>) -> String {
+    match binding {
+        Some(binding) => format!("{label} ({binding})"),
+        None => label.to_string(),
+    }
+}
+
+fn with_host(text: String, remote_host: Option<&str>) -> String {
+    match remote_host {
+        Some(host) => format!("{text} — remote: {host}"),
+        None => text,
+    }
+}
+
+/// The voice-input owner of the thread view `view`.
+pub fn voice_owner(view: EntityId) -> Owner {
+    Owner(view.as_u64())
+}
+
+/// Hands a click or a key to the app-wide voice input. The button, the strip and the key
+/// handlers are live only when it exists, so its absence here means it was torn down meanwhile.
+pub fn send(input: Input, cx: &mut App) {
+    match VoiceInput::try_global(cx) {
+        Some(voice) => voice.update(cx, |voice, cx| voice.handle(input, cx)),
+        None => log::warn!("voice_input event=input_dropped reason=not_initialized"),
+    }
+}
diff --git a/crates/agent_ui/src/voice_button_more_tests.rs b/crates/agent_ui/src/voice_button_more_tests.rs
new file mode 100644
index 0000000..0cf1871
--- /dev/null
+++ b/crates/agent_ui/src/voice_button_more_tests.rs
@@ -0,0 +1,122 @@
+// Story 044, task 5.2 fix round 1 — the tech review's M1, L1 and L2
+// (.draft/reports/5.2-tech-review-rust-gpui.md).
+//
+// Hostile halves: the strip's controls are tab stops for consent AND for download AND there is
+// none when no strip shows; the remote host is named while recording AND transcribing AND not in
+// local mode; the recording button is announced as a stop control AND not as its bare time.
+
+use std::time::Duration;
+
+use gpui::{Context, IntoElement, Render, TestAppContext, Window, div, prelude::*};
+use voice_input::{ViewState, VoiceModel};
+
+use crate::voice_button::{aria_label, render_voice_strip, tooltip_text_with_host};
+
+const HOST: &str = "api.groq.com";
+
+fn recording() -> ViewState {
+    ViewState::Recording {
+        elapsed: Duration::from_secs(5),
+    }
+}
+
+#[test]
+fn voice_button_more_remote_host_named_while_recording_and_transcribing() {
+    let shown = tooltip_text_with_host(&recording(), false, Some("ctrl-alt-v"), Some(HOST));
+    assert!(shown.contains("ctrl-alt-v"), "R1.1: {shown}");
+    assert!(
+        shown.contains("remote") && shown.contains(HOST),
+        "R8.3 recording: {shown}"
+    );
+
+    let shown = tooltip_text_with_host(&ViewState::Transcribing, false, None, Some(HOST));
+    assert!(
+        shown.contains("remote") && shown.contains(HOST),
+        "R8.3 transcribing: {shown}"
+    );
+
+    for state in [recording(), ViewState::Transcribing] {
+        let shown = tooltip_text_with_host(&state, false, Some("ctrl-alt-v"), None);
+        assert!(
+            !shown.is_empty() && !shown.contains("remote"),
+            "local {state:?}: {shown}"
+        );
+    }
+}
+
+#[test]
+fn voice_button_more_idle_keeps_its_own_host() {
+    let remote = ViewState::Idle {
+        remote_host: Some(HOST.into()),
+    };
+    let shown = tooltip_text_with_host(&remote, false, Some("ctrl-alt-v"), None);
+    assert!(shown.contains(HOST), "{shown}");
+    let local = ViewState::Idle { remote_host: None };
+    assert_eq!(
+        tooltip_text_with_host(&local, false, Some("ctrl-alt-v"), None),
+        "Voice input (ctrl-alt-v)"
+    );
+    assert_eq!(
+        tooltip_text_with_host(&recording(), true, None, Some(HOST)),
+        "The composer is read-only",
+        "R1.3 outranks the host"
+    );
+}
+
+#[test]
+fn voice_button_more_aria_labels() {
+    assert_eq!(
+        aria_label(&ViewState::Idle { remote_host: None }),
+        "Voice input"
+    );
+    assert_eq!(aria_label(&recording()), "Stop recording (0:05)");
+    let transcribing = aria_label(&ViewState::Transcribing);
+    assert!(transcribing.contains("Transcribing"), "{transcribing}");
+}
+
+struct StripHost(ViewState);
+
+impl Render for StripHost {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        div().children(render_voice_strip(&self.0, cx))
+    }
+}
+
+/// How many distinct elements Tab cycles through in a window showing the strip for `state`.
+fn tab_stops(state: ViewState, cx: &mut TestAppContext) -> usize {
+    let (_view, cx) = cx.add_window_view(|_, _| StripHost(state));
+    cx.run_until_parked();
+    let mut seen: Vec<gpui::FocusHandle> = Vec::new();
+    for _ in 0..4 {
+        let focused = cx.update(|window, cx| {
+            window.focus_next(cx);
+            window.focused(cx)
+        });
+        if let Some(handle) = focused
+            && !seen.contains(&handle)
+        {
+            seen.push(handle);
+        }
+    }
+    seen.len()
+}
+
+#[gpui::test]
+fn voice_button_more_strip_controls_are_tab_stops(cx: &mut TestAppContext) {
+    crate::test_support::init_test(cx);
+    let consent = ViewState::AwaitingConsent {
+        model: VoiceModel::Base,
+        size: "148 MB".into(),
+    };
+    assert_eq!(tab_stops(consent, cx), 2, "M1: Not now and Download");
+    assert_eq!(
+        tab_stops(ViewState::Downloading { percent: 42 }, cx),
+        1,
+        "M1: Cancel"
+    );
+    assert_eq!(
+        tab_stops(ViewState::Idle { remote_host: None }, cx),
+        0,
+        "no strip, no stop"
+    );
+}
diff --git a/crates/agent_ui/src/voice_button_tests.rs b/crates/agent_ui/src/voice_button_tests.rs
new file mode 100644
index 0000000..5a5921d
--- /dev/null
+++ b/crates/agent_ui/src/voice_button_tests.rs
@@ -0,0 +1,152 @@
+// Story 044, task 5.2 — what the microphone button and the strip show (R1.1, R1.3, R2.4, R4.5, R5.2,
+// R6.1, R6.3, R8.3). Wired in the crate root `src/agent_ui.rs` as
+//
+//     #[cfg(test)]
+//     mod voice_button_tests;
+//
+// Validation filter: `voice_button` (every test path is `voice_button_tests::…`).
+//
+// Contract: design.md C2 (`render_voice_button(view_state, focus, cx)`,
+// `render_voice_strip(view_state, cx) -> Option<AnyElement>`, the tooltips) and C1.10 `ViewState`.
+// A rendered `AnyElement` cannot be inspected, so the decisions are assumed to live in pure helpers
+// in `crate::voice_button` that the render functions call — adjust the `use` only:
+//   - `tooltip_text(state: &ViewState, read_only: bool, binding: Option<&str>) -> String`
+//   - `is_disabled(state: &ViewState, read_only: bool) -> bool`
+//   - `elapsed_label(elapsed: Duration) -> String`                       — `m:ss`
+//   - `consent_text(model: VoiceModel, size: &str) -> String`
+// Presence in the real toolbar is proven by the GUI proof (7.3).
+//
+// Hostile halves: `m:ss` pads seconds (1:05, not 1:5) AND rolls over at 60 (1:00, not 0:60); the
+// button is disabled while transcribing, busy or read-only AND enabled while idle or recording (the
+// stop click must work); the tooltip names the remote host only in remote mode; the strip exists
+// for consent and download AND not for idle or recording.
+
+use std::time::Duration;
+
+use gpui::TestAppContext;
+use voice_input::{ViewState, models::VoiceModel};
+
+use crate::voice_button::{
+    consent_text, elapsed_label, is_disabled, render_voice_strip, tooltip_text,
+};
+
+fn idle_local() -> ViewState {
+    ViewState::Idle { remote_host: None }
+}
+
+#[test]
+fn voice_button_elapsed_is_m_ss() {
+    for (secs, want) in [
+        (0, "0:00"),
+        (5, "0:05"),
+        (59, "0:59"),
+        (60, "1:00"),
+        (65, "1:05"),
+        (119, "1:59"),
+        (120, "2:00"),
+    ] {
+        assert_eq!(
+            elapsed_label(Duration::from_secs(secs)),
+            want,
+            "R2.4 {secs} s"
+        );
+    }
+    assert_eq!(
+        elapsed_label(Duration::from_millis(59_999)),
+        "0:59",
+        "truncates, never shows 0:60"
+    );
+}
+
+#[test]
+fn voice_button_tooltip_names_action_and_shortcut() {
+    assert_eq!(
+        tooltip_text(&idle_local(), false, Some("ctrl-alt-v")),
+        "Voice input (ctrl-alt-v)",
+        "R1.1"
+    );
+    let without = tooltip_text(&idle_local(), false, None);
+    assert!(without.starts_with("Voice input"), "{without}");
+}
+
+#[test]
+fn voice_button_tooltip_names_the_remote_host_only_when_remote() {
+    let remote = ViewState::Idle {
+        remote_host: Some("api.groq.com".into()),
+    };
+    let shown = tooltip_text(&remote, false, Some("ctrl-alt-v"));
+    assert!(
+        shown.contains("remote") && shown.contains("api.groq.com"),
+        "R8.3: {shown}"
+    );
+    assert!(!tooltip_text(&idle_local(), false, Some("ctrl-alt-v")).contains("remote"));
+}
+
+#[test]
+fn voice_button_read_only_and_busy_tooltips() {
+    assert_eq!(
+        tooltip_text(&idle_local(), true, Some("ctrl-alt-v")),
+        "The composer is read-only",
+        "R1.3"
+    );
+    assert_eq!(
+        tooltip_text(&ViewState::Busy, false, None),
+        "Voice input is busy in another thread",
+        "R5.1"
+    );
+}
+
+#[test]
+fn voice_button_disabled_states() {
+    assert!(
+        is_disabled(&ViewState::Transcribing, false),
+        "R4.5/R5.2 disabled while transcribing"
+    );
+    assert!(is_disabled(&ViewState::Busy, false), "busy elsewhere");
+    assert!(is_disabled(&idle_local(), true), "R1.3 read-only");
+    assert!(!is_disabled(&idle_local(), false), "idle is clickable");
+    assert!(
+        !is_disabled(
+            &ViewState::Recording {
+                elapsed: Duration::from_secs(3)
+            },
+            false
+        ),
+        "R2.3 recording must stay clickable to stop"
+    );
+}
+
+#[test]
+fn voice_button_consent_names_model_size_and_host() {
+    let text = consent_text(VoiceModel::Base, "148 MB");
+    for needle in ["base", "148 MB", "huggingface.co"] {
+        assert!(text.contains(needle), "R6.1 {needle}: {text}");
+    }
+}
+
+#[gpui::test]
+fn voice_button_strip_only_for_consent_and_download(cx: &mut TestAppContext) {
+    crate::test_support::init_test(cx);
+    let cx = cx.add_empty_window();
+    let consent = ViewState::AwaitingConsent {
+        model: VoiceModel::Base,
+        size: "148 MB".into(),
+    };
+    let downloading = ViewState::Downloading { percent: 42 };
+    for (state, present) in [
+        (consent, true),
+        (downloading, true),
+        (idle_local(), false),
+        (
+            ViewState::Recording {
+                elapsed: Duration::from_secs(1),
+            },
+            false,
+        ),
+        (ViewState::Transcribing, false),
+        (ViewState::Hidden, false),
+    ] {
+        let shown = cx.update(|_window, cx| render_voice_strip(&state, cx).is_some());
+        assert_eq!(shown, present, "R6.1/R6.3 strip for {state:?}");
+    }
+}
diff --git a/crates/agent_ui/src/voice_contract_tests.rs b/crates/agent_ui/src/voice_contract_tests.rs
new file mode 100644
index 0000000..49aa7e7
--- /dev/null
+++ b/crates/agent_ui/src/voice_contract_tests.rs
@@ -0,0 +1,110 @@
+// Story 044, task 6.1 — the contract between `voice_input` and the four keymaps. Every
+// `voice_input::` action a keymap names must resolve, so a misspelled name cannot sit unbound,
+// and `DismissDownload` (added by 5.3) is only ever claimed while the consent is asked.
+// Validation filter: `voice` (test paths are `voice_contract_tests::…`).
+
+use gpui::TestAppContext;
+
+use crate::test_support::init_test;
+
+const KEYMAPS: [(&str, &str); 4] = [
+    (
+        "keymaps/default-linux.json",
+        include_str!("../../../assets/keymaps/default-linux.json"),
+    ),
+    (
+        "keymaps/default-windows.json",
+        include_str!("../../../assets/keymaps/default-windows.json"),
+    ),
+    (
+        "keymaps/default-macos.json",
+        include_str!("../../../assets/keymaps/default-macos.json"),
+    ),
+    (
+        "keymaps/vim.json",
+        include_str!("../../../assets/keymaps/vim.json"),
+    ),
+];
+
+const ACTIONS: [&str; 3] = [
+    "voice_input::ToggleRecording",
+    "voice_input::CancelRecording",
+    "voice_input::DismissDownload",
+];
+
+/// Every `(context, keystroke, action)` whose action is in the `voice_input` namespace.
+fn voice_bindings(content: &str) -> Vec<(String, String, String)> {
+    let sections =
+        settings::parse_json_with_comments::<Vec<serde_json::Value>>(content).expect("keymap JSON");
+    let mut found = Vec::new();
+    for section in sections {
+        let context = section
+            .get("context")
+            .and_then(|c| c.as_str())
+            .unwrap_or("")
+            .to_string();
+        let Some(bindings) = section.get("bindings").and_then(|b| b.as_object()) else {
+            continue;
+        };
+        for (keys, value) in bindings {
+            if let Some(action) = value.as_str().filter(|a| a.starts_with("voice_input::")) {
+                found.push((context.clone(), keys.clone(), action.to_string()));
+            }
+        }
+    }
+    found
+}
+
+#[test]
+fn voice_contract_keymaps_name_only_known_voice_actions() {
+    for (name, content) in KEYMAPS {
+        for (context, keys, action) in voice_bindings(content) {
+            assert!(
+                ACTIONS.contains(&action.as_str()),
+                "{name}: {keys:?} in {context:?} names an unknown voice action {action}"
+            );
+        }
+    }
+}
+
+#[test]
+fn voice_contract_dismiss_download_is_escape_under_voice_consent_only() {
+    for (name, content) in KEYMAPS {
+        let dismiss: Vec<_> = voice_bindings(content)
+            .into_iter()
+            .filter(|(_, _, action)| action == "voice_input::DismissDownload")
+            .collect();
+        assert!(
+            dismiss
+                .iter()
+                .any(|(context, keys, _)| keys == "escape" && context.contains("Editor")),
+            "{name}: escape → DismissDownload in the composer, found {dismiss:?}"
+        );
+        assert!(
+            dismiss
+                .iter()
+                .all(|(context, keys, _)| keys == "escape" && context.contains("voice_consent")),
+            "{name}: DismissDownload only on escape under voice_consent, found {dismiss:?}"
+        );
+    }
+}
+
+#[gpui::test]
+fn voice_contract_every_voice_action_resolves_in_every_keymap(cx: &mut TestAppContext) {
+    init_test(cx);
+    for (name, _) in KEYMAPS {
