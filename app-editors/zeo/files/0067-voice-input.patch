@@ -0,0 +1,97 @@
+// Story 044, task 2.2 — transcript cleaning and spacing (R4.2, R4.3, R4.6). Wired in the crate root
+// `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod transcript_tests;
+//
+// Validation filter: `transcript` (every test path is `transcript_tests::…`).
+//
+// Contract (design.md C1.6): `transcript::clean(&str) -> String`,
+// `transcript::for_insertion(Option<char>, &str) -> String`.
+//
+// Hostile halves: an annotation standing alone is removed AND brackets that are part of speech
+// ("array [i]", "f(x)") survive; one space after a letter or punctuation AND none after whitespace,
+// a newline or at the start of the composer; Unicode letters count as non-whitespace and a
+// non-breaking space counts as whitespace.
+
+use crate::transcript::{clean, for_insertion};
+
+#[test]
+fn transcript_trims_and_collapses_whitespace() {
+    assert_eq!(clean("  Hello   world.\n\t"), "Hello world.");
+    assert_eq!(clean(""), "");
+    assert_eq!(clean("   \n "), "");
+}
+
+#[test]
+fn transcript_removes_standalone_annotations() {
+    assert_eq!(clean("[BLANK_AUDIO]"), "");
+    assert_eq!(clean("(music)"), "");
+    assert_eq!(clean(" [Music] Hello there. (silence) "), "Hello there.");
+    assert_eq!(clean("Hello. [BLANK_AUDIO] World."), "Hello. World.");
+    assert_eq!(
+        clean("[BLANK_AUDIO] (music) [Music]"),
+        "",
+        "R4.6 nothing but annotations is empty"
+    );
+}
+
+#[test]
+fn transcript_keeps_brackets_that_are_speech() {
+    assert_eq!(
+        clean("index the array [i] please"),
+        "index the array [i] please"
+    );
+    assert_eq!(clean("call f(x) twice"), "call f(x) twice");
+}
+
+#[test]
+fn transcript_keeps_unicode_text() {
+    assert_eq!(
+        clean("  Olá, ação concluída. [BLANK_AUDIO] "),
+        "Olá, ação concluída."
+    );
+    assert_eq!(clean("日本語 テスト"), "日本語 テスト");
+}
+
+#[test]
+fn transcript_spacing_after_non_whitespace() {
+    assert_eq!(
+        for_insertion(Some('a'), "hello"),
+        " hello",
+        "R4.2 after a letter"
+    );
+    assert_eq!(
+        for_insertion(Some('.'), "hello"),
+        " hello",
+        "after punctuation"
+    );
+    assert_eq!(
+        for_insertion(Some('ç'), "hello"),
+        " hello",
+        "after a non-ASCII letter"
+    );
+}
+
+#[test]
+fn transcript_no_spacing_after_whitespace_or_at_start() {
+    assert_eq!(
+        for_insertion(None, "hello"),
+        "hello",
+        "start of the composer"
+    );
+    assert_eq!(for_insertion(Some(' '), "hello"), "hello");
+    assert_eq!(for_insertion(Some('\n'), "hello"), "hello");
+    assert_eq!(for_insertion(Some('\t'), "hello"), "hello");
+    assert_eq!(
+        for_insertion(Some('\u{a0}'), "hello"),
+        "hello",
+        "NBSP is whitespace"
+    );
+}
+
+#[test]
+fn transcript_spacing_adds_exactly_one_space() {
+    assert_eq!(for_insertion(Some('x'), "a b"), " a b");
+    assert!(!for_insertion(Some('x'), "a").starts_with("  "));
+}
