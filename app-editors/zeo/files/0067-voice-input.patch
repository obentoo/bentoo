+    // A disabled feature costs no keymap walk on the composer's every render.
+    if matches!(state, ViewState::Hidden) {
+        return None;
+    }
+    let binding = toggle_binding(window, focus)
+        .map(|binding| text_for_keybinding_keystrokes(binding.keystrokes(), cx));
+    let tooltip = SharedString::from(tooltip_text_with_host(
+        state,
+        read_only,
