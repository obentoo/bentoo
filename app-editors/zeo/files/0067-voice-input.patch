+pub mod remote;
+mod settings;
+pub mod state;
+pub mod transcript;
+
+pub use crate::models::VoiceModel;
+pub use crate::settings::{Language, RemoteSettings, VoiceInputSettings};
+
+use std::{
+    collections::HashMap,
+    fs, io,
+    path::PathBuf,
+    sync::{Arc, Mutex, PoisonError},
+    time::{Duration, Instant},
+};
+
+use ::settings::{Settings as _, SettingsStore};
+use audio::AudioSettings;
+use futures::channel::oneshot;
+use gpui::{
+    AnyWeakEntity, App, AppContext as _, AsyncApp, Context, Entity, EntityId, EventEmitter, Global,
+    SharedString, Subscription, Task, actions,
+};
+use http_client::HttpClient;
+
+use crate::capture::{ActiveCapture, CaptureBackend, CaptureEvent, Recording};
+use crate::download::{DownloadError, download_model, model_name};
+use crate::local::{LocalError, LocalTranscriber};
+use crate::models::{CachedLookup, HashCache, ModelOrigin, ModelSpec, ResolvedModel};
+use crate::state::{Ctx, Effect, Input, Machine, Mode, Owner, Phase, TAP_WINDOW};
+
+actions!(
+    voice_input,
+    [
+        /// Starts recording, or stops it and transcribes what was said.
+        ToggleRecording,
+        /// Stops recording and discards the audio.
+        CancelRecording,
+        /// Declines the speech model download the voice strip asks for.
+        DismissDownload
+    ]
+);
+
+/// How often the recording's elapsed time is re-rendered.
+const TICK: Duration = Duration::from_secs(1);
+/// How often an idle local model is offered the chance to leave memory.
+const IDLE_CHECK: Duration = Duration::from_secs(60);
+/// Room for both early-end events of one recording (`Limit` and `DeviceError`).
+const CAPTURE_EVENT_CAPACITY: usize = 4;
+
+const BUSY: &str = "Voice input is busy in another thread";
+const NO_SPEECH: &str = "No speech was recognised";
+
+/// Registers the `voice_input` settings section and creates the app-wide [`VoiceInput`], with
+/// models downloaded to the user's data directory and the real microphone.
+pub fn init(http: Arc<dyn HttpClient>, cx: &mut App) {
+    let dirs = ModelDirs {
+        user: models::models_dir(),
+        system: models::system_models_dir(),
+    };
+    init_with(http, dirs, Arc::new(capture::Cpal), cx);
+}
+
+/// [`init`] with the models directory and the capture backend passed in, so a test never writes
+/// into the real data directory nor opens the operator's microphone. Packaged models are looked
+/// up in `<models_dir>/system`, never in the system's own directory, so an installed
+/// `whisper-models` package cannot change what a test sees.
+pub fn init_in(
+    http: Arc<dyn HttpClient>,
+    models_dir: PathBuf,
+    capture: Arc<dyn CaptureBackend>,
+    cx: &mut App,
+) {
+    let dirs = ModelDirs {
+        system: models_dir.join("system"),
+        user: models_dir,
+    };
+    init_with(http, dirs, capture, cx);
+}
+
+struct ModelDirs {
+    /// Read-only models installed by the package manager, preferred (R6.10).
+    system: PathBuf,
+    /// Where models are downloaded.
+    user: PathBuf,
+}
+
+fn init_with(
+    http: Arc<dyn HttpClient>,
+    dirs: ModelDirs,
+    capture: Arc<dyn CaptureBackend>,
+    cx: &mut App,
+) {
+    VoiceInputSettings::register(cx);
+    local::install_logging();
+    let entity = cx.new(|cx| VoiceInput::new(http, dirs, capture, cx));
+    cx.set_global(GlobalVoiceInput(entity));
+}
+
+struct GlobalVoiceInput(Entity<VoiceInput>);
+
+impl Global for GlobalVoiceInput {}
+
+/// What a composer's microphone button and strip render.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ViewState {
+    /// Voice input is disabled in the settings (R1.2).
+    Hidden,
+    /// Ready; names the remote host when audio would leave the machine (R8.3).
+    Idle {
+        remote_host: Option<String>,
+    },
+    /// Recording, transcribing or downloading for another composer (R5.1).
+    Busy,
+    /// The model is missing and the user is asked before anything is downloaded (R6.1).
+    /// `size` is the download size as shown, e.g. `148 MB`.
+    AwaitingConsent {
+        model: VoiceModel,
+        size: SharedString,
+    },
+    Downloading {
+        percent: u8,
+    },
+    Recording {
+        elapsed: Duration,
+    },
+    /// Transcribing, or still opening the device: the button is disabled either way.
+    Transcribing,
+}
+
+/// What the entity tells the composers. `owner` is the thread view the request came from.
+#[derive(Clone, Debug)]
+pub enum VoiceEvent {
+    Insert {
+        owner: EntityId,
+        text: String,
+    },
+    Notify {
+        owner: EntityId,
+        message: String,
+    },
+    /// The transcript was dropped because its composer had been closed (R4.7).
+    Discarded {
+        owner: EntityId,
+    },
+    /// Something every view shows has changed: re-render.
+    Changed,
+}
+
+#[derive(Default)]
+struct OwnerEntry {
+    /// `None` until the thread view registers itself; an unregistered owner counts as alive.
+    alive: Option<AnyWeakEntity>,
+    read_only: bool,
+}
+
+/// The R10.1 line of the recording in flight, filled as the recording moves along.
+struct RecordingLog {
+    mode: &'static str,
+    backend: &'static str,
+    model: String,
+    host: Option<String>,
+    audio_ms: u128,
+    transcribe_ms: u128,
+}
+
+impl RecordingLog {
+    fn emit(&self, outcome: &str) {
+        let host = self
+            .host
+            .as_ref()
+            .map(|host| format!(" host={host}"))
+            .unwrap_or_default();
+        let level = if outcome == "error" {
+            log::Level::Warn
+        } else {
+            log::Level::Info
+        };
+        log::log!(
+            level,
+            "voice_input event=recording mode={} audio_ms={} backend={} model={} transcribe_ms={} outcome={outcome}{host}",
+            self.mode,
+            self.audio_ms,
+            self.backend,
+            self.model,
+            self.transcribe_ms,
+        );
+    }
+}
+
+/// The app-wide voice input: runs the [`Machine`]'s effects and feeds every async result back
+/// into it as an [`Input`].
+pub struct VoiceInput {
+    machine: Machine,
+    settings: VoiceInputSettings,
+    /// The settings the current recording started under: it is transcribed by the backend it
+    /// was recorded for, whatever changed since (R7.1, R8.7).
+    recording_settings: Option<VoiceInputSettings>,
+    /// The remote host of the recording in flight, kept until the next start so the button names
+    /// it while transcribing too (R8.3), after `recording_settings` has been handed over.
+    in_flight_host: Option<String>,
+    http: Arc<dyn HttpClient>,
+    /// A client that never uses a proxy, for plain-http (hence loopback) remote URLs (R8.9).
+    loopback_http: Option<Arc<dyn HttpClient>>,
+    models_dir: PathBuf,
+    system_models_dir: PathBuf,
+    hash_cache: Arc<HashCache>,
+    /// Hashes a packaged model on the background executor; inputs wait in `deferred` meanwhile.
+    hash_check: Option<Task<()>>,
+    /// Inputs held, in order, until `hash_check` answers whether the packaged model is valid.
+    deferred: Vec<(Input, Instant)>,
+    /// Set while the held inputs are replayed: they no longer wait for a hash.
+    replaying: bool,
+    /// Set while the machine is told to drop the work of a composer that was closed.
+    abandoning: bool,
+    capture: Arc<dyn CaptureBackend>,
+    /// Bumped on every capture start, so a late result or event of an older start is ignored.
+    capture_generation: u64,
+    active: Option<Box<dyn ActiveCapture>>,
+    /// Resolves once the last stopped or cancelled capture has released its device; the next
+    /// start waits for it.
+    capture_closed: Option<oneshot::Receiver<()>>,
+    capture_opening: Option<Task<()>>,
+    capture_events: Option<Task<()>>,
+    /// The recording being handed back by `ActiveCapture::stop`, for the transcription.
+    stopping: Option<Task<Recording>>,
+    transcriber: Arc<Mutex<LocalTranscriber>>,
+    transcription: Option<Task<()>>,
+    download_cancel: Option<oneshot::Sender<()>>,
+    download: Option<(Task<()>, Task<()>)>,
+    /// The model being downloaded, which the progress is measured against.
+    download_spec: Option<&'static ModelSpec>,
+    owners: HashMap<Owner, OwnerEntry>,
+    recording_log: Option<RecordingLog>,
+    /// The R10.1 line of a transcript just handed to its composer, held until the next effect
+    /// flush so the composer can report a refusal (R10.1 `outcome=refused`).
+    pending_insert_log: Option<(Owner, RecordingLog)>,
+    ticker: Option<Task<()>>,
+    _idle_release: Task<()>,
+    _settings: Subscription,
+}
+
+impl EventEmitter<VoiceEvent> for VoiceInput {}
+
+impl VoiceInput {
+    /// The entity [`init`] created.
+    ///
+    /// Panics when [`init`] has not run; use [`VoiceInput::try_global`] where that can happen.
+    pub fn global(cx: &App) -> Entity<VoiceInput> {
+        cx.global::<GlobalVoiceInput>().0.clone()
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<VoiceInput>> {
+        cx.try_global::<GlobalVoiceInput>()
+            .map(|global| global.0.clone())
+    }
+
+    /// Sets the proxy-less client a plain-http (hence loopback) remote URL is sent through, so it
+    /// goes direct even when the app's client has a proxy (R8.9). Without one, plain http behind
+    /// a proxy is refused.
+    pub fn set_loopback_http(&mut self, http: Arc<dyn HttpClient>) {
+        self.loopback_http = Some(http);
+    }
+
+    fn new(
+        http: Arc<dyn HttpClient>,
+        dirs: ModelDirs,
+        capture: Arc<dyn CaptureBackend>,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let transcriber = Arc::new(Mutex::new(LocalTranscriber::default()));
+        let idle_transcriber = transcriber.clone();
+        let idle_release = cx.spawn(async move |_, cx| {
+            loop {
+                cx.background_executor().timer(IDLE_CHECK).await;
+                // A transcription in progress holds the lock and is, by definition, not idle.
+                if let Ok(mut transcriber) = idle_transcriber.try_lock() {
+                    transcriber.release_if_idle(Instant::now());
+                }
+            }
+        });
+        let settings_subscription = cx.observe_global::<SettingsStore>(|this, cx| {
+            let settings = VoiceInputSettings::get_global(cx).clone();
+            if settings != this.settings {
+                this.settings_changed(settings, cx);
+            }
+        });
+        // The user's directory only: the system one is the package manager's (R6.12).
+        let staging_dir = dirs.user.clone();
+        cx.background_spawn(async move {
+            download::sweep_staging(&staging_dir, 2 * download::STALL_TIMEOUT);
+        })
+        .detach();
+        let mut this = Self {
+            machine: Machine::default(),
+            settings: VoiceInputSettings::get_global(cx).clone(),
+            recording_settings: None,
+            in_flight_host: None,
+            http,
+            loopback_http: None,
+            models_dir: dirs.user,
+            system_models_dir: dirs.system,
+            hash_cache: Arc::default(),
+            hash_check: None,
+            deferred: Vec::new(),
+            replaying: false,
+            abandoning: false,
+            capture,
+            capture_generation: 0,
+            active: None,
+            capture_closed: None,
+            capture_opening: None,
+            capture_events: None,
+            stopping: None,
+            transcriber,
+            transcription: None,
+            download_cancel: None,
+            download: None,
+            download_spec: None,
+            owners: HashMap::default(),
+            recording_log: None,
+            pending_insert_log: None,
+            ticker: None,
+            _idle_release: idle_release,
+            _settings: settings_subscription,
+        };
+        this.warm_hash_cache(cx);
+        this
+    }
+
+    fn settings_changed(&mut self, settings: VoiceInputSettings, cx: &mut Context<Self>) {
+        let previous = std::mem::replace(&mut self.settings, settings);
+        if previous.enabled && !self.settings.enabled {
+            // The button is hidden and the shortcut unbound: nothing could stop this recording
+            // or answer this prompt any more (R1.2).
+            self.abandon_current_work(cx);
+        }
+        let needs_local_model = self.settings.enabled && !self.settings.remote.enabled;
+        let needed_before = previous.enabled && !previous.remote.enabled;
+        if needs_local_model && (!needed_before || previous.model != self.settings.model) {
+            self.warm_hash_cache(cx);
+        }
+        cx.emit(VoiceEvent::Changed);
+    }
+
+    /// The SHA-256 verdict cache for packaged models, for tests that count hashes.
+    #[cfg(test)]
+    pub(crate) fn hash_cache(&self) -> &HashCache {
+        &self.hash_cache
+    }
+
+    /// Records the thread view behind `owner`, so a transcript finishing after it closed is
+    /// discarded rather than delivered to nobody (R4.7).
+    pub fn register_owner(&mut self, owner: Owner, alive: AnyWeakEntity) {
+        // Closed composers are forgotten only while nothing is in flight: an in-flight owner's
+        // entry is what tells its transcript to be discarded.
+        if matches!(self.machine.phase(), Phase::Idle) {
+            self.owners.retain(|_, entry| {
+                entry
+                    .alive
+                    .as_ref()
+                    .is_none_or(|alive| alive.upgrade().is_some())
+            });
+        }
+        self.owners.entry(owner).or_default().alive = Some(alive);
+    }
+
+    /// Records whether `owner`'s composer is read-only; a read-only composer starts nothing
+    /// (R1.3).
+    pub fn set_composer_read_only(&mut self, owner: Owner, read_only: bool) {
+        self.owners.entry(owner).or_default().read_only = read_only;
+    }
+
+    /// Feeds one input to the machine and runs the effects it returns.
+    pub fn handle(&mut self, input: Input, cx: &mut Context<Self>) {
+        self.handle_at(input, Instant::now(), cx);
+    }
+
+    /// `now` is when the input arrived: a held input replays with it, so a press keeps the
+    /// time it was made (C1.9) however long the hash took.
+    fn handle_at(&mut self, input: Input, now: Instant, cx: &mut Context<Self>) {
+        if !self.deferred.is_empty() {
+            // Keeps the order: a key-up must not overtake the key-down held before it.
+            self.deferred.push((input, now));
+            return;
+        }
+        if let Input::Click { owner } | Input::ShortcutDown { owner } = input {
+            // A composer closed while it held the machine would otherwise make every other
+            // composer busy until a restart.
+            if self.abandon_closed_owner(Some(owner), cx) {
+                return;
+            }
+            if self.needs_hash_check() {
+                self.deferred.push((input, now));
+                self.warm_hash_cache(cx);
+                return;
+            }
+        }
+        self.run_at(input, now, cx);
+    }
+
+    fn run(&mut self, input: Input, cx: &mut Context<Self>) {
+        self.run_at(input, Instant::now(), cx);
+    }
+
+    fn run_at(&mut self, input: Input, now: Instant, cx: &mut Context<Self>) {
+        let finishing = matches!(
+            input,
+            Input::Transcribed { .. } | Input::TranscribeFailed(_)
+        ) && matches!(self.machine.phase(), Phase::Transcribing { .. });
+        // A download kept after its composer closed, and never adopted, ends with nobody to
+        // tell (R6.14); download.rs has already logged how it ended (R10.2).
+        let unowned_download_failed = matches!(input, Input::DownloadFailed(_))
+            && matches!(
+                self.machine.phase(),
+                Phase::Downloading { owner, .. } if self.owner_closed(*owner)
+            );
+        let before = self.machine.phase().clone();
+        let ctx = self.ctx(&input);
+        let effects = self.machine.on(input, now, &ctx);
+
+        let mut outcome = None;
+        for effect in effects {
+            match effect {
+                Effect::StartCapture => self.start_capture(cx),
+                Effect::StopCapture => self.stop_capture(cx),
+                Effect::CancelCapture => {
+                    self.cancel_capture(cx);
+                    let outcome = if self.abandoning {
+                        "discarded"
+                    } else {
+                        "cancelled"
+                    };
+                    self.log_cancelled(&before, now, outcome);
+                }
+                Effect::AskConsent | Effect::Render => cx.emit(VoiceEvent::Changed),
+                Effect::StartDownload => self.start_download(cx),
+                Effect::CancelDownload => {
+                    if let Some(cancel) = self.download_cancel.take()
+                        && cancel.send(()).is_err()
+                    {
+                        log::debug!("voice_input event=download_cancel_unheard");
+                    }
+                }
+                Effect::Transcribe { mode } => self.transcribe(mode, cx),
+                Effect::Insert { owner, text } => {
+                    // A thread view held by a parent whose last handle was dropped in this same
+                    // update still upgrades until the flush releases the parent. The decision is
+                    // deferred past that flush so such a composer is seen as closed (R4.7). The
+                    // handle is taken now: the machine is already `Idle`, so a `register_owner`
+                    // in the gap may prune the owner's entry.
+                    let alive = self
+                        .owners
+                        .get(&owner)
+                        .and_then(|entry| entry.alive.clone());
+                    let recording_log = if finishing {
+                        self.recording_log.take()
+                    } else {
+                        None
+                    };
+                    let this = cx.weak_entity();
+                    cx.defer(move |cx| {
+                        let delivered = this.update(cx, |this, cx| {
+                            this.deliver_transcript(owner, alive, text, recording_log, cx)
+                        });
+                        if delivered.is_err() {
+                            log::debug!(
+                                "voice_input event=transcript_dropped reason=voice_input_released"
+                            );
+                        }
+                    });
+                }
+                Effect::Notify { owner, .. } if unowned_download_failed => {
+                    self.owners.remove(&owner);
+                    log::info!("voice_input event=download_notice_dropped reason=owner_closed");
+                }
+                Effect::Notify { owner, message } => {
+                    if finishing {
+                        outcome = Some(if message == NO_SPEECH {
+                            "empty"
+                        } else {
+                            "error"
+                        });
+                    }
+                    cx.emit(VoiceEvent::Notify {
+                        owner: EntityId::from(owner.0),
+                        message,
+                    });
+                }
+                Effect::Busy { owner } => cx.emit(VoiceEvent::Notify {
+                    owner: EntityId::from(owner.0),
+                    message: BUSY.to_string(),
+                }),
+            }
+        }
+
+        if finishing && let Some(log) = self.recording_log.take() {
+            log.emit(outcome.unwrap_or("error"));
+        }
+        self.sync_ticker(cx);
+    }
+
+    /// Hands a finished transcript to its composer, or discards it when the composer is gone.
+    ///
+    /// `alive` is the owner's handle as registered when the transcript arrived; `None` (never
+    /// registered) counts as open.
+    fn deliver_transcript(
+        &mut self,
+        owner: Owner,
+        alive: Option<AnyWeakEntity>,
+        text: String,
+        recording_log: Option<RecordingLog>,
+        cx: &mut Context<Self>,
+    ) {
+        let id = EntityId::from(owner.0);
+        let closed = alive.is_some_and(|alive| alive.upgrade().is_none());
+        if closed {
+            self.owners.remove(&owner);
+            cx.emit(VoiceEvent::Discarded { owner: id });
+            if let Some(recording_log) = recording_log {
+                recording_log.emit("discarded");
+            }
+            return;
+        }
+        cx.emit(VoiceEvent::Insert { owner: id, text });
+        let Some(recording_log) = recording_log else {
+            return;
+        };
+        // The composer answers in its `Insert` handler, which runs in the flush this emit is
+        // part of; the fallback is queued behind it, so it sees whether a refusal was reported.
+        self.flush_pending_insert_log();
+        self.pending_insert_log = Some((owner, recording_log));
+        let this = cx.weak_entity();
+        cx.defer(move |cx| {
+            let flushed = this.update(cx, |this, _| this.flush_pending_insert_log());
+            if flushed.is_err() {
+                log::debug!("voice_input event=insert_log_dropped reason=voice_input_released");
+            }
+        });
+    }
+
+    /// Logs a pending R10.1 line nobody refused as `outcome=inserted`.
+    fn flush_pending_insert_log(&mut self) {
+        if let Some((_, recording_log)) = self.pending_insert_log.take() {
+            recording_log.emit("inserted");
+        }
+    }
+
+    /// Called by the composer whose `Insert` handler could not take the transcript (it turned
+    /// read-only while the transcript was on its way): the recording's R10.1 line says
+    /// `outcome=refused` instead of `inserted`. Does nothing for another owner, or when no line
+    /// is pending. The line carries no transcript or error text (R10.3).
+    pub fn report_insert_refused(&mut self, owner: Owner) {
+        match self.pending_insert_log.take() {
+            Some((pending, recording_log)) if pending == owner => recording_log.emit("refused"),
+            other => self.pending_insert_log = other,
+        }
+    }
+
+    /// Whether the `voice_input.enabled` setting is on: the composer binds the voice shortcut
+    /// only then (R1.2).
+    pub fn is_enabled(&self) -> bool {
+        self.settings.enabled
+    }
+
+    /// What `owner`'s button and strip show.
+    pub fn view_state(&self, owner: EntityId) -> ViewState {
+        if !self.settings.enabled {
+            return ViewState::Hidden;
+        }
+        let owner = Owner(owner.as_u64());
+        match self.machine.phase() {
+            Phase::Idle => ViewState::Idle {
+                remote_host: settings_remote_host(&self.settings),
+            },
+            // A download kept after its composer closed belongs to whoever looks at it: every
+            // composer shows its progress and Cancel (R6.14, R6.15). A busy button would take no
+            // click, so the mouse could never reach it.
+            Phase::Downloading { owner: current, .. }
+                if *current != owner && !self.owner_closed(*current) =>
+            {
+                ViewState::Busy
+            }
+            Phase::AwaitingConsent { owner: current }
+            | Phase::Starting { owner: current, .. }
+            | Phase::Recording { owner: current, .. }
+            | Phase::Transcribing { owner: current }
+                if *current != owner =>
+            {
+                ViewState::Busy
+            }
+            Phase::AwaitingConsent { .. } => {
+                let spec = models::spec(self.settings.model);
+                ViewState::AwaitingConsent {
+                    model: self.settings.model,
+                    size: models::human_size(spec.size).into(),
+                }
+            }
+            Phase::Downloading { bytes, .. } => {
+                let spec = self
+                    .download_spec
+                    .unwrap_or_else(|| models::spec(self.settings.model));
+                let size = spec.size.max(1);
+                let percent = bytes.saturating_mul(100) / size;
+                ViewState::Downloading {
+                    percent: u8::try_from(percent.min(100)).unwrap_or(100),
+                }
+            }
+            Phase::Recording { started, .. } => ViewState::Recording {
+                elapsed: Instant::now().saturating_duration_since(*started),
+            },
+            Phase::Starting { .. } | Phase::Transcribing { .. } => ViewState::Transcribing,
+        }
+    }
+
+    /// The host audio goes to, or `None` in local mode (R8.3). While a recording is in flight it
+    /// is that recording's host, since it is transcribed by the backend it was recorded for
+    /// (R8.7) whatever the settings say now.
+    pub fn remote_host(&self) -> Option<String> {
+        match self.machine.phase() {
+            Phase::Starting { .. } | Phase::Recording { .. } | Phase::Transcribing { .. } => {
+                self.in_flight_host.clone()
+            }
+            Phase::Idle | Phase::AwaitingConsent { .. } | Phase::Downloading { .. } => {
+                settings_remote_host(&self.settings)
+            }
+        }
+    }
+
+    fn ctx(&self, input: &Input) -> Ctx {
+        let owner = match input {
+            Input::Click { owner } | Input::ShortcutDown { owner } => Some(*owner),
+            _ => None,
+        };
+        let remote = self.settings.remote.enabled;
+        // Only a start input reads the model's presence, and remote mode never needs one (R8.7).
+        let model_present = owner.is_some() && !remote && self.model_present_cached();
+        let composer_read_only = owner
+            .and_then(|owner| self.owners.get(&owner))
+            .is_some_and(|entry| entry.read_only);
+        Ctx {
+            enabled: self.settings.enabled,
+            remote,
+            model_present,
+            composer_read_only,
+        }
+    }
+
+    fn lookup_model_cached(&self) -> CachedLookup {
+        models::lookup_model_cached(
+            models::spec(self.settings.model),
+            &self.system_models_dir,
+            &self.models_dir,
+            &self.hash_cache,
+        )
+    }
+
+    /// Never hashes: it runs inside `handle`, on the UI thread. An unverified packaged file only
+    /// reaches here while held inputs are replayed after a hash that did not settle it; it
+    /// counts by its size, and the transcription re-checks it off the UI thread.
+    fn model_present_cached(&self) -> bool {
+        match self.lookup_model_cached() {
+            CachedLookup::Resolved(resolved) => resolved.is_some(),
+            CachedLookup::Unverified => true,
+        }
+    }
+
+    /// Whether a start input must wait for a packaged model to be hashed: the machine is idle, a
+    /// local model is needed, and the packaged file changed since it was last hashed (or never
+    /// was) — on first use, after a package upgrade, after a switch from remote to local.
+    fn needs_hash_check(&self) -> bool {
+        !self.replaying
+            && self.settings.enabled
+            && !self.settings.remote.enabled
+            && matches!(self.machine.phase(), Phase::Idle)
+            && self.lookup_model_cached() == CachedLookup::Unverified
+    }
+
+    /// Hashes the configured packaged model on the background executor, at most one at a time,
+    /// then replays the inputs that waited for it.
+    fn warm_hash_cache(&mut self, cx: &mut Context<Self>) {
+        if self.hash_check.is_some() || self.settings.remote.enabled {
+            return;
+        }
+        let spec = models::spec(self.settings.model);
+        let system_dir = self.system_models_dir.clone();
+        let models_dir = self.models_dir.clone();
+        let cache = self.hash_cache.clone();
+        let hashing = cx.background_spawn(async move {
+            models::resolve_model_in(spec, &system_dir, &models_dir, &cache);
+        });
+        self.hash_check = Some(cx.spawn(async move |this, cx| {
+            hashing.await;
+            this.update(cx, |this, cx| {
+                this.hash_check = None;
+                this.replay_deferred(cx);
+            })
+            .ok();
+        }));
+    }
+
+    fn replay_deferred(&mut self, cx: &mut Context<Self>) {
+        let deferred = std::mem::take(&mut self.deferred);
+        self.replaying = true;
+        for (input, arrived) in deferred {
+            self.handle_at(input, arrived, cx);
+        }
+        self.replaying = false;
+    }
+
+    /// Drops the consent prompt or recording of a composer that has been closed. A running
+    /// download is kept instead (R6.14): `starter`, the composer whose start input is being
+    /// handled, adopts it (R6.15). Returns whether that start input was consumed by the adoption.
+    fn abandon_closed_owner(&mut self, starter: Option<Owner>, cx: &mut Context<Self>) -> bool {
+        let owner = match self.machine.phase() {
+            Phase::AwaitingConsent { owner }
+            | Phase::Downloading { owner, .. }
+            | Phase::Recording { owner, .. } => *owner,
+            _ => return false,
+        };
+        let downloading = matches!(self.machine.phase(), Phase::Downloading { .. });
+        // Without a starter the download simply runs on, and the closed owner's entry stays: it
+        // is what keeps the download's end from notifying anybody.
+        if !self.owner_closed(owner) || (downloading && starter.is_none()) {
+            return false;
+        }
+        log::info!(
+            "voice_input event=owner_closed phase={}",
+            phase_name(self.machine.phase())
+        );
+        let adopted = match starter {
+            Some(starter) if downloading => {
+                log::info!("voice_input event=download_adopted");
+                self.run(Input::AdoptDownload { owner: starter }, cx);
+                true
+            }
+            _ => {
+                self.abandon_current_work(cx);
+                false
+            }
+        };
+        self.owners.remove(&owner);
+        adopted
+    }
+
+    /// Ends the consent prompt, download or recording in progress with nothing inserted, through
+    /// the inputs the machine already has for it.
+    fn abandon_current_work(&mut self, cx: &mut Context<Self>) {
+        let input = match self.machine.phase() {
+            Phase::AwaitingConsent { .. } => Input::ConsentDeclined,
+            Phase::Downloading { .. } => Input::DownloadCancel,
+            Phase::Recording { owner, .. } => Input::Cancel { owner: *owner },
+            // A device still opening is cancelled once it has opened (`capture_opened`); a
+            // transcription finishes, and its insert is discarded if its composer is gone (R4.7).
+            Phase::Idle | Phase::Starting { .. } | Phase::Transcribing { .. } => return,
+        };
+        self.abandoning = true;
+        self.run(input, cx);
+        self.abandoning = false;
+    }
+
+    fn recording_owner_closed(&self) -> bool {
+        match self.machine.phase() {
+            Phase::Recording { owner, .. } => self.owner_closed(*owner),
+            _ => false,
+        }
+    }
+
+    fn owner_closed(&self, owner: Owner) -> bool {
+        self.owners
+            .get(&owner)
+            .and_then(|entry| entry.alive.as_ref())
+            .is_some_and(|alive| alive.upgrade().is_none())
+    }
+
+    fn start_capture(&mut self, cx: &mut Context<Self>) {
+        self.recording_settings = Some(self.settings.clone());
+        self.in_flight_host = settings_remote_host(&self.settings);
+        let device = AudioSettings::get_global(cx).input_audio_device.clone();
+        self.capture_generation += 1;
+        let generation = self.capture_generation;
+        let backend = self.capture.clone();
+        let previous = self.capture_closed.take();
+        let (events_tx, events_rx) = smol::channel::bounded(CAPTURE_EVENT_CAPACITY);
+        // `start` blocks until the device is open (or for up to its open timeout).
+        let opening = cx.background_spawn(async move {
+            if let Some(previous) = previous {
+                // Either answer means the previous capture has released the device.
+                previous.await.ok();
+            }
+            backend.start(device, events_tx)
+        });
+        self.capture_opening = Some(cx.spawn(async move |this, cx| {
+            let result = opening.await;
+            this.update(cx, |this, cx| {
+                this.capture_opened(generation, result, events_rx, cx)
+            })
+            .ok();
+        }));
+    }
+
+    fn capture_opened(
+        &mut self,
+        generation: u64,
+        result: anyhow::Result<Box<dyn ActiveCapture>>,
+        events: smol::channel::Receiver<CaptureEvent>,
+        cx: &mut Context<Self>,
+    ) {
+        let starting = matches!(self.machine.phase(), Phase::Starting { .. });
+        if generation != self.capture_generation || !starting {
+            if let Ok(active) = result {
+                self.release_capture(active, cx);
+            }
+            return;
+        }
+        match result {
+            Ok(active) => {
+                self.active = Some(active);
+                self.capture_events = Some(cx.spawn(async move |this, cx| {
+                    while let Ok(event) = events.recv().await {
+                        let input = match event {
+                            CaptureEvent::Limit => Input::CaptureLimit,
+                            CaptureEvent::DeviceError(reason) => Input::CaptureDeviceError(reason),
+                        };
+                        let delivered = this.update(cx, |this, cx| {
+                            if this.capture_generation == generation {
+                                this.handle(input, cx);
+                            }
+                        });
+                        if delivered.is_err() {
+                            break;
+                        }
+                    }
+                }));
+                self.run(Input::CaptureStarted, cx);
+                if !self.settings.enabled {
+                    // Disabled while the device was opening.
+                    self.abandon_current_work(cx);
+                }
+            }
+            Err(error) => self.run(Input::CaptureFailed(format!("{error:#}")), cx),
+        }
+    }
+
+    /// `stop` joins the capture thread, so it runs off the UI thread.
+    fn stop_capture(&mut self, cx: &mut Context<Self>) {
+        let Some(active) = self.active.take() else {
+            return;
+        };
+        let (closed_tx, closed_rx) = oneshot::channel();
+        self.capture_closed = Some(closed_rx);
+        self.stopping = Some(cx.background_spawn(async move {
+            let recording = active.stop();
+            closed_tx.send(()).ok();
+            recording
+        }));
+    }
+
+    fn cancel_capture(&mut self, cx: &mut Context<Self>) {
+        if let Some(active) = self.active.take() {
+            self.release_capture(active, cx);
+        }
+    }
+
+    /// Cancels `active` off the UI thread; the next start waits until it has let go.
+    fn release_capture(&mut self, active: Box<dyn ActiveCapture>, cx: &mut Context<Self>) {
+        let (closed_tx, closed_rx) = oneshot::channel();
+        self.capture_closed = Some(closed_rx);
+        cx.background_spawn(async move {
+            active.cancel();
+            closed_tx.send(()).ok();
+        })
+        .detach();
+    }
+
+    fn log_cancelled(&mut self, before: &Phase, now: Instant, outcome: &str) {
+        let Phase::Recording { mode, started, .. } = before else {
+            return;
+        };
+        let settings = self.take_recording_settings();
+        let mut log = recording_log_for(&settings, mode_label(*mode, now));
+        log.audio_ms = now.saturating_duration_since(*started).as_millis();
+        log.emit(outcome);
+    }
+
+    fn take_recording_settings(&mut self) -> VoiceInputSettings {
+        self.recording_settings
+            .take()
+            .unwrap_or_else(|| self.settings.clone())
+    }
+
+    fn transcribe(&mut self, mode: Mode, cx: &mut Context<Self>) {
+        let settings = self.take_recording_settings();
+        self.recording_log = Some(recording_log_for(
+            &settings,
+            mode_label(mode, Instant::now()),
+        ));
+        let stopping = self.stopping.take();
+        let job = TranscribeJob {
+            settings,
+            http: self.http.clone(),
+            loopback_http: self.loopback_http.clone(),
+            models_dir: self.models_dir.clone(),
+            system_models_dir: self.system_models_dir.clone(),
+            hash_cache: self.hash_cache.clone(),
+            transcriber: self.transcriber.clone(),
+        };
+        self.transcription = Some(cx.spawn(async move |this, cx| {
+            let recording = match stopping {
+                Some(stopping) => stopping.await,
+                None => Recording::default(),
+            };
+            let audio_ms = audio_ms(&recording);
+            let started = Instant::now();
+            let input = job.run(recording, cx).await;
+            let transcribe_ms = started.elapsed().as_millis();
+            this.update(cx, |this, cx| {
+                if let Some(log) = &mut this.recording_log {
+                    log.audio_ms = audio_ms;
+                    log.transcribe_ms = transcribe_ms;
+                }
+                this.handle(input, cx);
+            })
+            .ok();
+        }));
+    }
+
+    fn start_download(&mut self, cx: &mut Context<Self>) {
+        let spec = models::spec(self.settings.model);
+        self.download_spec = Some(spec);
+        let (cancel_tx, cancel_rx) = oneshot::channel();
+        self.download_cancel = Some(cancel_tx);
+        let (progress_tx, progress_rx) = smol::channel::unbounded::<u64>();
+        let progress = move |bytes: u64| {
+            // Closed only once the download has ended; a late figure is not needed then.
+            progress_tx.try_send(bytes).ok();
+        };
+        // `download_model` writes and syncs with blocking `std::fs`: background only.
+        let downloading = cx.background_spawn(download_model(
+            self.http.clone(),
+            spec,
+            self.models_dir.clone(),
+            progress,
+            cancel_rx,
+        ));
+        let forward = cx.spawn(async move |this, cx| {
+            while let Ok(bytes) = progress_rx.recv().await {
+                let delivered = this.update(cx, |this, cx| {
+                    this.handle(Input::DownloadProgress(bytes), cx)
+                });
+                if delivered.is_err() {
+                    break;
+                }
+            }
+        });
+        let finish = cx.spawn(async move |this, cx| {
+            let result = downloading.await;
+            this.update(cx, |this, cx| {
+                this.download_cancel = None;
+                match result {
+                    Ok(_) => this.handle(Input::DownloadDone, cx),
+                    // Cancelled by the user: the machine is already idle (R6.6).
+                    Err(DownloadError::Cancelled) => {}
+                    Err(error) => {
+                        this.handle(Input::DownloadFailed(download_message(spec, &error)), cx)
+                    }
+                }
+            })
+            .ok();
+        });
+        self.download = Some((forward, finish));
+    }
+
+    /// Re-renders every second while recording, for the elapsed time.
+    fn sync_ticker(&mut self, cx: &mut Context<Self>) {
+        let recording = matches!(self.machine.phase(), Phase::Recording { .. });
+        if !recording {
+            self.ticker = None;
+        } else if self.ticker.is_none() {
+            self.ticker = Some(cx.spawn(async move |this, cx| {
+                loop {
+                    cx.background_executor().timer(TICK).await;
+                    let ticked = this.update(cx, |this, cx| {
+                        if this.recording_owner_closed() {
+                            // Abandoned from a task of its own: the cancel drops this ticker,
+                            // which must not happen from inside the ticker's own poll.
+                            cx.spawn(async move |this, cx| {
+                                this.update(cx, |this, cx| {
+                                    this.abandon_closed_owner(None, cx);
+                                })
+                                .ok();
+                            })
+                            .detach();
+                        } else {
+                            cx.emit(VoiceEvent::Changed);
+                        }
+                    });
+                    if ticked.is_err() {
+                        break;
+                    }
+                }
+            }));
+        }
+    }
+}
+
+/// Everything a transcription needs, captured when it starts so a settings change mid-flight
+/// does not mix two configurations.
+struct TranscribeJob {
+    settings: VoiceInputSettings,
+    http: Arc<dyn HttpClient>,
+    loopback_http: Option<Arc<dyn HttpClient>>,
+    models_dir: PathBuf,
+    system_models_dir: PathBuf,
+    hash_cache: Arc<HashCache>,
+    transcriber: Arc<Mutex<LocalTranscriber>>,
+}
+
+impl TranscribeJob {
+    /// Turns the recording into the input the machine expects: `Transcribed` (empty when nothing
+    /// was said) or `TranscribeFailed` with the user-facing message.
+    async fn run(self, recording: Recording, cx: &mut AsyncApp) -> Input {
+        let pcm = cx
+            .background_spawn(async move {
+                audio_prep::to_whisper_pcm(&recording.samples, recording.sample_rate)
+            })
+            .await;
+        if audio_prep::speechless(&pcm) {
+            // Too short or too quiet: nothing is sent anywhere (R4.6).
+            return Input::Transcribed {
+                text: String::new(),
+            };
+        }
+        if self.settings.remote.enabled {
+            self.remote(pcm, cx).await
+        } else {
+            self.local(pcm, cx).await
+        }
+    }
+
+    async fn local(self, pcm: Vec<f32>, cx: &mut AsyncApp) -> Input {
+        if let Err(level) = local::cpu_supported() {
+            return Input::TranscribeFailed(format!("Voice input needs a CPU with {level}"));
+        }
+        let spec = models::spec(self.settings.model);
+        let language = self.settings.language;
+        let models_dir = self.models_dir;
+        let system_dir = self.system_models_dir;
+        let cache = self.hash_cache;
+        let transcriber = self.transcriber;
+        cx.background_spawn(async move {
+            let Some(resolved) = models::resolve_model_in(spec, &system_dir, &models_dir, &cache)
+            else {
+                return Input::TranscribeFailed(format!(
+                    "The speech model {} is missing; click the microphone to download it again",
+                    model_name(spec.model)
+                ));
+            };
+            let result = transcriber
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .transcribe(spec.model, &resolved.path, &language, &pcm);
+            match result {
+                Ok(text) => Input::Transcribed { text },
+                Err(error @ LocalError::Unreadable { .. }) => {
+                    Input::TranscribeFailed(unreadable_model(error, &resolved, spec))
+                }
+                Err(error) => Input::TranscribeFailed(format!("{error:#}")),
+            }
+        })
+        .await
+    }
+
+    async fn remote(self, pcm: Vec<f32>, cx: &mut AsyncApp) -> Input {
+        let remote = self.settings.remote;
+        let Some(raw) = remote.url.as_deref() else {
+            return Input::TranscribeFailed(
+                "The remote voice URL is not set (voice_input.remote.url)".to_string(),
+            );
+        };
+        let url = match remote::validate_url(raw) {
+            Ok(url) => url,
+            // Refused before a byte is sent (R8.4).
+            Err(error) => return Input::TranscribeFailed(format!("{error:#}")),
+        };
+        // `validate_url` admits plain http to loopback hosts only: with a proxy-less client it goes
+        // direct (R8.9), which ignores the environment's proxies too.
+        let (http, refusal) = match self.loopback_http {
+            Some(loopback) if url.scheme() == "http" => {
+                let refusal = remote::proxy_refusal(&url, loopback.proxy(), &[const { None }; 6]);
+                (loopback, refusal)
+            }
+            _ => {
+                let proxy_env = remote::PROXY_ENV_VARS.map(|name| std::env::var(name).ok());
+                let refusal = remote::proxy_refusal(&url, self.http.proxy(), &proxy_env);
+                (self.http, refusal)
+            }
+        };
+        if let Some(refusal) = refusal {
+            return Input::TranscribeFailed(refusal);
+        }
+        // Read per request and never stored. An empty name and an empty value are both no key
+        // (R8.5, R8.8).
+        let key = Some(remote.api_key_env.as_str())
+            .filter(|name| !name.is_empty())
+            .and_then(|name| std::env::var(name).ok())
+            .filter(|key| !key.is_empty());
+        let language = self.settings.language;
+        let model = remote.model;
+        let (body, boundary) = cx
+            .background_spawn(async move {
+                let wav = audio_prep::wav_pcm16(&pcm);
+                let boundary = remote::new_boundary(&wav);
+                let body = remote::multipart(&boundary, &wav, &model, &language);
+                (body, boundary)
+            })
+            .await;
+        // Awaited here rather than on the background executor: the request is non-blocking I/O,
+        // and `remote::transcribe`'s future is not `Send` (its log guard uses `Cell`).
+        let result = remote::transcribe(http, &url, key, body, &boundary).await;
+        match result {
+            Ok(text) => Input::Transcribed { text },
+            // No local fallback, in either direction (R8.6).
+            Err(error) => Input::TranscribeFailed(format!("{error:#}")),
+        }
+    }
+}
+
+/// Handles a model whisper.cpp could not load (R7.3). A downloaded model whose bytes no longer
+/// hash to the pinned value is deleted so the next use downloads it again; a model that still
+/// hashes right failed to load for another reason and is kept, and a packaged one is never
+/// touched (it belongs to the package manager). Runs on a background thread: it may hash.
+fn unreadable_model(error: LocalError, resolved: &ResolvedModel, spec: &ModelSpec) -> String {
+    let LocalError::Unreadable { source, .. } = &error else {
+        return format!("{error:#}");
+    };
+    let name = model_name(spec.model);
+    let path = resolved.path.display().to_string();
+    // Kept: the message names the failure without promising a download that will not happen.
+    let keep = |reason: &str| {
+        log::warn!(
+            "voice_input event=model_unreadable model={name} action=kept reason={reason} path={path:?}"
+        );
+        format!("The speech model was unreadable: {source:#}")
+    };
+    if resolved.origin == ModelOrigin::System {
+        return keep("system_package");
+    }
+    match models::matches_pinned_hash(&resolved.path, spec) {
+        Ok(true) => return keep("checksum_matches"),
+        Ok(false) => {}
+        Err(hash_error) if hash_error.kind() == io::ErrorKind::NotFound => {}
+        Err(hash_error) => {
+            log::warn!(
+                "voice_input event=model_hash_failed model={name} path={path:?} error={:?}",
+                hash_error.to_string()
+            );
+        }
+    }
+    match fs::remove_file(&resolved.path) {
+        Ok(()) => {
+            log::warn!(
+                "voice_input event=model_unreadable model={name} action=deleted path={path:?}"
+            );
+            format!("{error:#}")
+        }
+        Err(remove_error) if remove_error.kind() == io::ErrorKind::NotFound => format!("{error:#}"),
+        Err(remove_error) => {
+            log::warn!(
+                "voice_input event=model_delete_failed model={name} path={path:?} error={:?}",
+                remove_error.to_string()
+            );
+            format!(
+                "The speech model was unreadable and could not be deleted ({path}): {remove_error}"
+            )
+        }
+    }
+}
+
+/// The host audio goes to under `settings`, or `None` in local mode (R8.3).
+fn settings_remote_host(settings: &VoiceInputSettings) -> Option<String> {
+    if !settings.remote.enabled {
+        return None;
+    }
+    let url = url::Url::parse(settings.remote.url.as_deref()?).ok()?;
+    url.host_str().map(str::to_string)
+}
+
+fn recording_log_for(settings: &VoiceInputSettings, mode: &'static str) -> RecordingLog {
+    let remote = &settings.remote;
+    if remote.enabled {
+        let host = remote
+            .url
+            .as_deref()
+            .and_then(|raw| url::Url::parse(raw).ok())
+            .map(|url| redacted_host(&url))
+            .unwrap_or_else(|| "none".to_string());
+        RecordingLog {
+            mode,
+            backend: "remote",
+            model: format!("{:?}", remote.model),
+            host: Some(host),
+            audio_ms: 0,
+            transcribe_ms: 0,
+        }
+    } else {
+        RecordingLog {
+            mode,
+            backend: "local",
+            model: model_name(settings.model).to_string(),
+            host: None,
+            audio_ms: 0,
+            transcribe_ms: 0,
+        }
+    }
+}
+
+/// The R6.5/R6.6 message for a failed download, naming the model.
+fn download_message(spec: &ModelSpec, error: &DownloadError) -> String {
+    let name = model_name(spec.model);
+    match error {
+        DownloadError::Mismatch { .. } => {
+            format!("The speech model {name} did not match its checksum and was deleted")
+        }
+        DownloadError::Http(source) | DownloadError::Io(source) => {
+            format!("Could not download the speech model {name}: {source:#}")
+        }
+        DownloadError::Cancelled => {
+            format!("The download of the speech model {name} was cancelled")
+        }
+    }
+}
+
+/// `toggle` or `hold`; a press still pending is named by what it would become now.
+fn mode_label(mode: Mode, now: Instant) -> &'static str {
+    match mode {
+        Mode::Toggle => "toggle",
+        Mode::Hold => "hold",
+        Mode::Pending(pressed_at) if now.saturating_duration_since(pressed_at) <= TAP_WINDOW => {
+            "toggle"
+        }
+        Mode::Pending(_) => "hold",
+    }
+}
+
+fn phase_name(phase: &Phase) -> &'static str {
+    match phase {
+        Phase::Idle => "idle",
+        Phase::AwaitingConsent { .. } => "awaiting_consent",
+        Phase::Downloading { .. } => "downloading",
+        Phase::Starting { .. } => "starting",
+        Phase::Recording { .. } => "recording",
+        Phase::Transcribing { .. } => "transcribing",
+    }
+}
+
+fn audio_ms(recording: &Recording) -> u128 {
+    if recording.sample_rate == 0 {
+        return 0;
+    }
+    recording.samples.len() as u128 * 1000 / u128::from(recording.sample_rate)
+}
+
+/// Host and port only: never the user-info, path or query of the configured URL (R10.3).
+fn redacted_host(url: &url::Url) -> String {
+    let host = url.host_str().unwrap_or("none");
+    match url.port() {
+        Some(port) => format!("{host}:{port}"),
+        None => host.to_string(),
+    }
+}
