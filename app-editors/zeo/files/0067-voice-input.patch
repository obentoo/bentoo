index 0000000..1399f65
--- /dev/null
+++ b/crates/reqwest_client/src/reqwest_client_without_proxy_tests.rs
@@ -0,0 +1,91 @@
+// Story 044, task 8.4 (refine v3) — `ReqwestClient::without_proxy(user_agent)`, the proxy-less client
+// voice input sends plain-http loopback requests through (R8.9; design.md C1.10). Wired in
+// `crates/reqwest_client/src/reqwest_client.rs` as
+//
+//     #[cfg(test)]
+//     mod reqwest_client_without_proxy_tests;
+//
+// Validation filter: `without_proxy` (`cargo test -p reqwest_client without_proxy`).
+//
+// Contract: `ReqwestClient::without_proxy(user_agent: &str) -> anyhow::Result<ReqwestClient>`
+// reports no proxy, sends the given user agent like the app's client, and reaches a plain-http
+// loopback server directly.
+//
+// Gap: that it ignores HTTP_PROXY/ALL_PROXY (reqwest's `no_proxy()`) is not exercised: setting
+// them needs `set_var`, which is `unsafe` in edition 2024 and races every other test in the binary.
+//
+// Hostile half, the wrong collapse first: a proxy-less client is not a bare client — it still
+// carries the app's user agent (the request a loopback service sees names Zeo); then the plain
+// case: no proxy is reported, and the request arrives.
+
+use std::io::{BufRead as _, BufReader, Write as _};
+use std::net::TcpListener;
+use std::sync::mpsc;
+use std::time::Duration;
+
+use http_client::{AsyncBody, HttpClient, Request as HttpRequest};
+
+use crate::ReqwestClient;
+
+const USER_AGENT: &str = "Zeo-voice-test/0.0";
+
+#[test]
+fn without_proxy_reports_no_proxy_and_keeps_the_user_agent() {
+    let client = ReqwestClient::without_proxy(USER_AGENT).expect("client");
+    assert_eq!(
+        client.proxy(),
+        None,
+        "R8.9 the proxy-less client reports no proxy"
+    );
+    assert_eq!(
+        client.user_agent().and_then(|value| value.to_str().ok()),
+        Some(USER_AGENT),
+        "the same user agent as the app's client"
+    );
+}
+
+#[test]
+fn without_proxy_reaches_a_loopback_server_directly_with_its_user_agent() {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+    let address = listener.local_addr().expect("address");
+    let (headers_tx, headers_rx) = mpsc::channel::<Vec<String>>();
+    let server = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("accept");
+        let mut reader = BufReader::new(stream.try_clone().expect("clone"));
+        let mut headers = Vec::new();
+        loop {
+            let mut line = String::new();
+            if reader.read_line(&mut line).expect("read") == 0 || line == "\r\n" {
+                break;
+            }
+            headers.push(line.trim_end().to_string());
+        }
+        headers_tx.send(headers).ok();
+        stream
+            .write_all(b"HTTP/1.1 200 OK\r\ncontent-length: 0\r\nconnection: close\r\n\r\n")
+            .expect("write");
+    });
+
+    let client = ReqwestClient::without_proxy(USER_AGENT).expect("client");
+    let request = HttpRequest::get(format!("http://{address}/v1/audio/transcriptions"))
+        .body(AsyncBody::default())
+        .expect("request");
+    let response = futures::executor::block_on(client.send(request)).expect("sent");
+    assert!(response.status().is_success());
+    let headers = headers_rx
+        .recv_timeout(Duration::from_secs(5))
+        .expect("the loopback server got the request");
+    server.join().expect("server");
+
+    assert!(
+        headers
+            .first()
+            .is_some_and(|line| line.starts_with("GET /v1/audio/transcriptions")),
+        "a direct request names the path, not an absolute proxy URL: {headers:?}"
+    );
+    assert!(
+        headers.iter().any(|line| line.to_ascii_lowercase()
+            == format!("user-agent: {}", USER_AGENT.to_ascii_lowercase())),
+        "the request carries the app's user agent: {headers:?}"
+    );
+}
