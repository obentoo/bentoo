+            &voice,
+            window,
+            |this, _, event: &VoiceEvent, window, cx| match event {
+                VoiceEvent::Changed => cx.notify(),
+                VoiceEvent::Insert { owner, text } if *owner == cx.entity_id() => {
+                    this.insert_voice_transcript(text, window, cx)
+                }
+                VoiceEvent::Notify { owner, message } if *owner == cx.entity_id() => {
+                    voice_notice::show_toast(&this.workspace, message.clone(), cx)
