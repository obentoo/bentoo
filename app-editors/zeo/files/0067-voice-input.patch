--- /dev/null
+++ b/crates/voice_input/src/remote_tests.rs
@@ -0,0 +1,143 @@
+// Story 044, task 3.4 — remote URL rules, redaction and the multipart body (R8.2, R8.4, R10.3).
+// Wired in the crate root `src/voice_input.rs` as
+//
+//     #[cfg(test)]
+//     mod remote_tests;
+//
+// Validation filter: `remote` (every test path is `remote_tests::…`).
+//
+// Contract (design.md C1.8): `validate_url(&str) -> anyhow::Result<Url>`, `redacted(&Url) -> String`,
+// `multipart(boundary: &str, wav: &[u8], model: &str, language: &Language) -> Vec<u8>`.
+//
+// Hostile halves: https to any host is accepted AND http to a non-loopback host is refused AND http
+// to 127.0.0.0/8, ::1 and localhost is accepted; a loopback look-alike (`127.0.0.1.evil.example`,
+// `localhost.evil.example`, `0.0.0.0`, `::ffff:8.8.8.8`) is refused; user-info is refused even
+// with https; redaction drops user-info, query and fragment AND keeps scheme, host, port and path;
+// the language field is present for a code AND absent for Auto.
+
+use crate::Language;
+use crate::remote::{multipart, redacted, validate_url};
+
+#[test]
+fn remote_https_is_accepted_for_any_host() {
+    for raw in [
+        "https://api.openai.com/v1/audio/transcriptions",
+        "https://api.groq.com/openai/v1/audio/transcriptions",
+        "https://stt.example:8443/v1/audio/transcriptions",
+    ] {
+        let url = validate_url(raw).unwrap_or_else(|e| panic!("{raw}: {e:#}"));
+        assert_eq!(url.scheme(), "https");
+    }
+}
+
+#[test]
+fn remote_plain_http_to_a_remote_host_is_refused() {
+    for raw in [
+        "http://api.openai.com/v1/audio/transcriptions",
+        "http://192.168.1.10:8080/inference",
+        "http://127.0.0.1.evil.example/x",
+        "http://localhost.evil.example/x",
+        "http://0.0.0.0:8080/x",
+        "http://[::ffff:8.8.8.8]/x",
+    ] {
+        let err = validate_url(raw).expect_err(raw);
+        assert!(
+            format!("{err:#}").contains("https"),
+            "R8.4 says https is required: {err:#}"
+        );
+    }
+}
+
+#[test]
+fn remote_plain_http_to_loopback_is_accepted() {
+    for raw in [
+        "http://127.0.0.1:8080/inference",
+        "http://127.10.20.30/inference",
+        "http://[::1]:9000/v1/audio/transcriptions",
+        "http://localhost:8080/inference",
+    ] {
+        validate_url(raw).unwrap_or_else(|e| panic!("{raw}: {e:#}"));
+    }
+}
+
+#[test]
+fn remote_user_info_is_refused_even_with_https() {
+    for raw in [
+        "https://user:secret@api.example/v1",
+        "https://token@api.example/v1",
+        "http://u:p@127.0.0.1:8080/x",
+    ] {
+        let err = validate_url(raw).expect_err(raw);
+        assert!(
+            !format!("{err:#}").contains("secret"),
+            "the refusal does not echo credentials: {err:#}"
+        );
+    }
+}
+
+#[test]
+fn remote_other_schemes_and_garbage_are_refused() {
+    for raw in ["ftp://api.example/x", "file:///tmp/x", "not a url", ""] {
+        assert!(validate_url(raw).is_err(), "{raw:?}");
+    }
+}
+
+#[test]
+fn remote_redaction_keeps_only_scheme_host_port_path() {
+    let url = url::Url::parse(
+        "https://user:pw@stt.example:8443/v1/audio/transcriptions?api_key=SECRET#frag",
+    )
+    .expect("parse");
+    let shown = redacted(&url);
+    assert_eq!(shown, "https://stt.example:8443/v1/audio/transcriptions");
+    for leaked in ["user", "pw", "SECRET", "api_key", "frag", "?", "#", "@"] {
+        assert!(!shown.contains(leaked), "R10.3 {leaked:?} leaked: {shown}");
+    }
+    let plain = url::Url::parse("http://127.0.0.1/inference").expect("parse");
+    assert_eq!(redacted(&plain), "http://127.0.0.1/inference");
+}
+
+fn part<'a>(body: &'a str, name: &str) -> Option<&'a str> {
+    let marker = format!("name=\"{name}\"");
+    let start = body.find(&marker)?;
+    let rest = &body[start..];
+    let value_start = rest.find("\r\n\r\n")? + 4;
+    let value_end = rest[value_start..].find("\r\n--")?;
+    Some(&rest[value_start..value_start + value_end])
+}
+
+#[test]
+fn remote_multipart_has_file_model_format_and_language() {
+    let wav = crate::audio_prep::wav_pcm16(&[0.0, 0.5, -0.5]);
+    let boundary = "zeo-boundary-7f3a";
+    let body = multipart(boundary, &wav, "whisper-1", &Language::Code("pt".into()));
+    let text = String::from_utf8_lossy(&body).into_owned();
+
+    assert!(text.starts_with(&format!("--{boundary}\r\n")), "{text:.80}");
+    assert!(
+        text.trim_end().ends_with(&format!("--{boundary}--")),
+        "closing delimiter"
+    );
+    assert!(
+        text.contains("name=\"file\"; filename=\"audio.wav\""),
+        "{text:.200}"
+    );
+    assert!(text.contains("Content-Type: audio/wav"));
+    assert_eq!(part(&text, "model"), Some("whisper-1"));
+    assert_eq!(part(&text, "response_format"), Some("json"));
+    assert_eq!(part(&text, "language"), Some("pt"));
+    let at = body.windows(wav.len()).position(|w| w == wav.as_slice());
+    assert!(at.is_some(), "the WAV bytes are carried verbatim");
+}
+
+#[test]
+fn remote_multipart_omits_language_for_auto() {
+    let wav = crate::audio_prep::wav_pcm16(&[0.0; 4]);
+    let body = multipart("b", &wav, "whisper-1", &Language::Auto);
+    let text = String::from_utf8_lossy(&body);
+    assert!(
+        !text.contains("name=\"language\""),
+        "R7.4 Auto lets the service detect"
+    );
+    assert!(text.contains("name=\"model\""));
+}
