+    pub remote: Option<VoiceInputRemoteSettingsContent>,
+}
+
+/// The local Whisper models voice input can download and run.
+#[derive(
+    Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize, JsonSchema, MergeFrom,
+)]
+#[serde(rename_all = "lowercase")]
+pub enum VoiceModelContent {
+    Tiny,
+    #[default]
+    Base,
+    Small,
