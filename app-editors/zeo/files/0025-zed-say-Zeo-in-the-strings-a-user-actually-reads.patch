diff --git a/crates/title_bar/src/application_menu.rs b/crates/title_bar/src/application_menu.rs
index ced552d..9dbeabc 100644
--- a/crates/title_bar/src/application_menu.rs
+++ b/crates/title_bar/src/application_menu.rs
@@ -256,7 +256,14 @@ impl ApplicationMenu {
         _window: &mut Window,
         _cx: &mut Context<Self>,
     ) {
-        self.pending_menu_open = Some(action.0.clone());
+        // The application menu is named after the release channel, but keymaps
+        // name it "Zed" -- the default `f10` binding among them -- so that name
+        // keeps opening it.
+        let name = match self.entries.first() {
+            Some(entry) if action.0 == "Zed" => entry.menu.name.to_string(),
+            _ => action.0.clone(),
+        };
+        self.pending_menu_open = Some(name);
     }
 
     #[cfg(not(target_os = "macos"))]
@@ -568,4 +575,34 @@ mod tests {
             menu_entry(&app_menu.entries, "View").handle.is_deployed()
         }));
     }
+
+    /// 0025: the application menu is named after the channel ("Zeo"), but keymaps --
+    /// the default f10 binding among them -- still name it "Zed". That name must keep
+    /// opening it, or f10 silently stops working on Linux. Other names pass through.
+    #[cfg(not(target_os = "macos"))]
+    #[gpui::test]
+    fn test_open_menu_accepts_the_legacy_zed_name(cx: &mut TestAppContext) {
+        init_test(cx);
+        cx.update(|cx| {
+            cx.set_menus(vec![
+                Menu::new("Zeo").items([MenuItem::action(
+                    "Settings",
+                    OpenApplicationMenu(String::new()),
+                )]),
+                view_menu(true),
+            ]);
+        });
+        let (app_menu, cx) = cx.add_window_view(|window, cx| ApplicationMenu::new(window, cx));
+
+        for (asked, opened) in [("Zed", "Zeo"), ("View", "View")] {
+            app_menu.update_in(cx, |app_menu, window, cx| {
+                app_menu.open_menu(&OpenApplicationMenu(asked.into()), window, cx);
+                assert_eq!(
+                    app_menu.pending_menu_open.as_deref(),
+                    Some(opened),
+                    "OpenApplicationMenu({asked:?})"
+                );
+            });
+        }
+    }
 }
