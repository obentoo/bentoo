diff --git a/crates/settings_ui/src/pages/agent_jail_secrets.rs b/crates/settings_ui/src/pages/agent_jail_secrets.rs
new file mode 100644
index 0000000..a408551
--- /dev/null
+++ b/crates/settings_ui/src/pages/agent_jail_secrets.rs
@@ -0,0 +1,155 @@
+//! The Agent Sandbox page's Secrets block (Zeo proposal §6.53 step 3): which of the vault's
+//! secrets this project's jail receives. A secret is listed only once it declares its jail use
+//! on the Secrets page -- the variable the agent reads and the hosts the value may go to -- and
+//! the switch names both. A chosen reference the vault no longer answers, or that declares no
+//! use, stays listed so it can be turned off: the start refuses it until then.
+
+use std::path::Path;
+
+use agent_sandbox::AgentSandboxSettings;
+use agent_sandbox::capabilities::{reset_project_secrets, set_project_secret};
+use gpui::{AnyElement, App, Entity, ScrollHandle};
+use secret_vault::VaultEntry;
+use settings::Settings as _;
+use ui::{SwitchField, ToggleState, prelude::*};
+use zeo_i18n::t;
+
+use super::agent_jail_capabilities::source_row;
+use super::{JailPageState, reveal};
+
+/// One switch of the block.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct SecretRow {
+    /// The `secret://` reference the setting stores.
+    pub reference: String,
+    /// What the switch says: the variable and hosts, or the reference when there are none.
+    pub label: String,
+    pub note: String,
+    pub chosen: bool,
+}
+
+/// The block's rows: every vault secret with a jail use, then every chosen reference the vault
+/// does not answer with one. `None` is a vault still being read; `Err` one that could not be.
+pub(crate) fn secret_rows(
+    vault: Option<&Result<Vec<VaultEntry>, String>>,
+    chosen: &[String],
+) -> Vec<SecretRow> {
+    let entries: &[VaultEntry] = match vault {
+        Some(Ok(entries)) => entries,
+        _ => &[],
+    };
+    let mut rows = Vec::new();
+    for entry in entries {
+        let Some(jail_use) = &entry.jail_use else {
+            continue;
+        };
+        let reference = entry.reference.uri();
+        rows.push(SecretRow {
+            chosen: chosen.contains(&reference),
+            label: t!(
+                "secrets-jail-use",
+                name = jail_use.env_name.clone(),
+                hosts = jail_use.hosts.join(", ")
+            ),
+            note: reference.clone(),
+            reference,
+        });
+    }
+    // Only a vault that answered can say a reference is missing; while it is read or locked the
+    // chosen ones are shown as they are, still on.
+    let vault_answered = matches!(vault, Some(Ok(_)));
+    for reference in chosen {
+        if rows.iter().any(|row| row.reference == *reference) {
+            continue;
+        }
+        let note = if !vault_answered {
+            reference.clone()
+        } else if entries
+            .iter()
+            .any(|entry| entry.reference.uri() == *reference)
+        {
+            t!("agent-sandbox-secret-no-use", reference = reference.clone())
+        } else {
+            t!(
+                "agent-sandbox-secret-missing",
+                reference = reference.clone()
+            )
+        };
+        rows.push(SecretRow {
+            reference: reference.clone(),
+            label: reference.clone(),
+            note,
+            chosen: true,
+        });
+    }
+    rows
+}
+
+/// The Secrets block of the project section.
+pub(crate) fn render_secrets(
+    root: &Path,
+    key: Option<&str>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let chosen = sandbox.secrets_for_key(key).to_vec();
+    let vault = state.read(cx).vault.clone();
+    let rows = secret_rows(vault.as_ref(), &chosen);
+    let mut switches = Vec::with_capacity(rows.len());
+    for row in rows {
+        let id = format!("agent-jail-secret-{}", row.reference);
+        let switch = SwitchField::new(
+            SharedString::from(id.clone()),
+            Some(SharedString::from(row.label)),
+            Some(row.note.into()),
+            row.chosen,
+            {
+                let root = root.to_path_buf();
+                let reference = row.reference;
+                move |toggle, _, cx| {
+                    let on = *toggle == ToggleState::Selected;
+                    set_project_secret(&root, &reference, on, cx).detach();
+                }
+            },
+        )
+        .tab_index(0);
+        switches.push(reveal(state, id, scroll_handle, switch, cx));
+    }
+    let muted = |text: String| Label::new(text).size(LabelSize::Small).color(Color::Muted);
+    let source = source_row(
+        "agent-jail-secrets-reset",
+        t!("agent-sandbox-secrets.reset"),
+        sandbox.secrets_set_for_key(key),
+        {
+            let root = root.to_path_buf();
+            move |cx: &mut App| reset_project_secrets(&root, cx).detach()
+        },
+        state,
+        scroll_handle,
+        cx,
+    );
+    let status = match &vault {
+        Some(Err(error)) => Some(t!("agent-sandbox-secrets.locked", error = error.clone())),
+        Some(Ok(_)) if switches.is_empty() => Some(t!("agent-sandbox-secrets.none")),
+        _ => None,
+    };
+    v_flex()
+        .gap_2()
+        .debug_selector(|| "agent-jail-secrets".into())
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(Label::new(t!("agent-sandbox-secrets")).size(LabelSize::Small))
+                .child(muted(t!("agent-sandbox-secrets.note")))
+                .child(source),
+        )
+        .children(status.map(muted))
+        .children(switches)
+        .into_any_element()
+}
+
+#[cfg(test)]
+#[path = "agent_jail_secrets_tests.rs"]
+mod agent_jail_secrets_tests;
diff --git a/crates/settings_ui/src/pages/agent_jail_secrets_tests.rs b/crates/settings_ui/src/pages/agent_jail_secrets_tests.rs
new file mode 100644
index 0000000..8475115
--- /dev/null
+++ b/crates/settings_ui/src/pages/agent_jail_secrets_tests.rs
@@ -0,0 +1,72 @@
+//! The Secrets block's rows (§6.53 step 3): which vault secrets are listed, and how a chosen one
+//! the vault cannot hand over is shown so it can be turned off.
+
+use secret_vault::{JailUse, SecretRef, VaultEntry};
+
+use super::{SecretRow, secret_rows};
+
+fn entry(service: &str, account: &str, jail_use: Option<(&str, &[&str])>) -> VaultEntry {
+    VaultEntry {
+        reference: SecretRef::new(service, account).expect("reference"),
+        tail: "abcd".into(),
+        jail_use: jail_use.map(|(name, hosts)| JailUse::new(name, hosts).expect("jail use")),
+    }
+}
+
+fn vault() -> Result<Vec<VaultEntry>, String> {
+    Ok(vec![
+        entry("github", "push", Some(("GH_TOKEN", &["github.com"]))),
+        entry("plain", "note", None),
+    ])
+}
+
+fn references(rows: &[SecretRow]) -> Vec<(&str, bool)> {
+    rows.iter()
+        .map(|row| (row.reference.as_str(), row.chosen))
+        .collect()
+}
+
+#[test]
+fn only_secrets_with_a_jail_use_are_offered() {
+    let rows = secret_rows(Some(&vault()), &[]);
+    assert_eq!(references(&rows), [("secret://github/push", false)]);
+    assert!(rows[0].label.contains("GH_TOKEN"), "{}", rows[0].label);
+    assert!(rows[0].label.contains("github.com"), "{}", rows[0].label);
+}
+
+#[test]
+fn a_chosen_reference_the_vault_cannot_hand_over_stays_listed_and_says_why() {
+    let chosen = [
+        "secret://github/push".to_string(),
+        "secret://plain/note".to_string(),
+        "secret://gone/away".to_string(),
+    ];
+    let rows = secret_rows(Some(&vault()), &chosen);
+    assert_eq!(
+        references(&rows),
+        [
+            ("secret://github/push", true),
+            ("secret://plain/note", true),
+            ("secret://gone/away", true),
+        ]
+    );
+    assert_ne!(
+        rows[1].note, rows[2].note,
+        "no use and missing read differently"
+    );
+    assert!(rows[1].note.contains("secret://plain/note"));
+    assert!(rows[2].note.contains("secret://gone/away"));
+}
+
+#[test]
+fn while_the_vault_is_unread_or_locked_the_chosen_ones_show_as_they_are() {
+    let chosen = ["secret://github/push".to_string()];
+    for vault in [None, Some(Err("locked".to_string()))] {
+        let rows = secret_rows(vault.as_ref(), &chosen);
+        assert_eq!(references(&rows), [("secret://github/push", true)]);
+        assert_eq!(
+            rows[0].note, "secret://github/push",
+            "no claim it is missing"
+        );
+    }
+}
