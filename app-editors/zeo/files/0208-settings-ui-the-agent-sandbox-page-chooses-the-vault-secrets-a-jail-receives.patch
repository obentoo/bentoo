+/// Adds the vault secret `reference` (`secret://…`) to the project's own secret list, or takes
+/// it out (§6.53 step 3). The first change makes the list the project's own, starting from the
+/// default it replaces. No prompt: the secret's variable and hosts were declared on the Secrets
+/// page, and the switch names both. Resolves to `true` only when the file was saved.
+pub fn set_project_secret(root: &Path, reference: &str, on: bool, cx: &mut App) -> Task<bool> {
+    let defaults = AgentSandboxSettings::get_global(cx)
+        .capabilities
+        .secrets
+        .clone();
+    let reference = reference.to_string();
+    write_project(
+        root,
+        "capabilities.secrets",
+        move |own, _| {
+            let list = own.secrets.get_or_insert(defaults);
+            list.retain(|chosen| *chosen != reference);
+            if on {
+                list.push(reference);
+                list.sort();
+            }
+        },
+        cx,
+    )
+}
+
+/// Drops the project's own secret list: the default applies again.
+pub fn reset_project_secrets(root: &Path, cx: &mut App) -> Task<bool> {
+    write_project(
+        root,
+        "capabilities.secrets",
+        |own, _| own.secrets = None,
+        cx,
+    )
+}
