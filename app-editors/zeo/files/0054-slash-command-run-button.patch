diff --git a/crates/agent_ui/src/agent_panel/tests/run_prompt_tests.rs b/crates/agent_ui/src/agent_panel/tests/run_prompt_tests.rs
new file mode 100644
index 0000000..b448a4a
--- /dev/null
+++ b/crates/agent_ui/src/agent_panel/tests/run_prompt_tests.rs
@@ -0,0 +1,249 @@
+//! `AgentPanel::run_prompt_in_new_thread` (story 035, Task 2.2; R1.3, R1.5, R1.6, R1.7, Q4).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod run_prompt_tests;` beside story 020's `mod prefilled_prompt_tests;` (whose harness this
+//! reuses). Resolves to `crates/agent_ui/src/agent_panel/tests/run_prompt_tests.rs`.
+//! `slash_command_run_tests.rs` reuses `assert_sent_new_thread` below.
+//!
+//! Contract (Task 2.2 Objective): `pub fn run_prompt_in_new_thread(&mut self, agent: Agent,
+//! source_session: acp_v2::SessionId, text: String, window: &mut Window, cx: &mut Context<Self>)`
+//! opens a focused new thread for `agent` and SENDS `text` as its first message;
+//! `new_thread_with_prefilled_prompt` keeps its signature and stays unsent.
+//!
+//! Behaviour asserted: a new thread, same agent, exactly one user message equal to the text,
+//! the composer emptied by the send; the source thread unchanged and still kept; an unavailable
+//! agent raises one toast and opens and sends nothing. Converse (hostile half of R1.5): the
+//! prefill path, called beside the new one, still sends nothing.
+//!
+//! Not asserted (no log capture in these harnesses): R1.9's INFO line -- reviewed, not tested.
+//! The `Agent::Stub` server answers every prompt with "Default response", so a sent thread holds
+//! a user message followed by the agent's reply.
+
+use acp_thread::{AcpThread, AgentThreadEntry};
+use gpui::{Entity, TestAppContext, VisualTestContext};
+
+use super::prefilled_prompt_tests::*;
+use crate::{Agent, AgentPanel};
+
+/// The user messages of `thread`, as text.
+pub(super) fn user_messages(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> Vec<String> {
+    thread.read_with(cx, |thread, cx| {
+        thread
+            .entries()
+            .iter()
+            .filter_map(|entry| match entry {
+                AgentThreadEntry::UserMessage(message) => {
+                    Some(message.content.to_markdown(cx).trim().to_string())
+                }
+                _ => None,
+            })
+            .collect()
+    })
+}
+
+/// Asserts the active thread is a NEW one on `agent_id` whose only user message is exactly
+/// `command`, sent: the composer no longer holds it.
+pub(super) fn assert_sent_new_thread(
+    panel: &Entity<AgentPanel>,
+    source: &Entity<AcpThread>,
+    agent_id: &project::AgentId,
+    command: &str,
+    cx: &mut VisualTestContext,
+) {
+    let active = panel
+        .read_with(cx, |panel, cx| panel.active_agent_thread(cx))
+        .expect("a thread is active");
+    assert_ne!(
+        active.read_with(cx, |t, _| t.session_id().clone()),
+        source.read_with(cx, |t, _| t.session_id().clone()),
+        "R1.3: a NEW thread is active, not the source"
+    );
+    let conversation = panel
+        .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+        .expect("a conversation is active");
+    assert_eq!(
+        &conversation.read_with(cx, |view, _| view.agent_key().id()),
+        agent_id,
+        "R1.3: the new thread runs the same agent"
+    );
+    assert_eq!(
+        user_messages(&active, cx),
+        vec![command.to_string()],
+        "R1.3/R1.4: the command is the thread's first and only message, sent exactly once"
+    );
+    let new_thread_id = panel.read_with(cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    assert!(
+        panel
+            .read_with(cx, |panel, cx| panel.editor_text(new_thread_id, cx))
+            .unwrap_or_default()
+            .trim()
+            .is_empty(),
+        "R1.3: sending emptied the composer -- the command is not left waiting in it"
+    );
+}
+
+#[gpui::test]
+async fn test_run_prompt_opens_a_new_thread_and_sends_the_command(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "what next?", vec![agent_says("Run it.")], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_entries = entry_count(&source, &cx);
+    let source_messages = user_messages(&source, &cx);
+    let toasts = notification_count(&workspace, &cx);
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.run_prompt_in_new_thread(
+            Agent::Stub,
+            source_session.clone(),
+            COMMAND.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_sent_new_thread(&panel, &source, &Agent::Stub.id(), COMMAND, &mut cx);
+    assert_ne!(
+        panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap()),
+        source_id
+    );
+    // R1.7: the source thread is unchanged and still kept.
+    assert_eq!(
+        entry_count(&source, &cx),
+        source_entries,
+        "R1.7: source untouched"
+    );
+    assert_eq!(
+        user_messages(&source, &cx),
+        source_messages,
+        "R1.7: the command was not sent to the source thread"
+    );
+    assert!(
+        panel.read_with(&cx, |panel, _| panel
+            .retained_threads()
+            .contains_key(&source_id)),
+        "R1.7: the source thread is still kept"
+    );
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts,
+        "no toast on success"
+    );
+}
+
+#[gpui::test]
+async fn test_run_prompt_sends_the_text_verbatim(cx: &mut TestAppContext) {
+    // The panel does not reinterpret the text it is given.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let text = "/review  @src/main.rs /tmp/x";
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.run_prompt_in_new_thread(Agent::Stub, source_session, text.to_string(), window, cx);
+    });
+    settle(&mut cx);
+
+    assert_sent_new_thread(&panel, &source, &Agent::Stub.id(), text, &mut cx);
+}
+
+#[gpui::test]
+async fn test_run_prompt_for_an_unavailable_agent_toasts_and_opens_nothing(
+    cx: &mut TestAppContext,
+) {
+    // R1.6/Q4: the same toast 0045 shows; no thread opened; nothing sent anywhere.
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_conversation = panel
+        .read_with(&cx, |panel, _| panel.active_conversation_view().cloned())
+        .unwrap();
+    let source_entries = entry_count(&source, &cx);
+    let toasts = notification_count(&workspace, &cx);
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.run_prompt_in_new_thread(
+            Agent::Custom {
+                id: "retired-agent".into(),
+            },
+            source_session,
+            COMMAND.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts + 1,
+        "R1.6/Q4: exactly one error toast"
+    );
+    assert_eq!(
+        panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap()),
+        source_id,
+        "R1.6: no thread is opened -- the source stays active"
+    );
+    assert_eq!(
+        panel
+            .read_with(&cx, |panel, _| panel.active_conversation_view().cloned())
+            .map(|view| view.entity_id()),
+        Some(source_conversation.entity_id()),
+    );
+    assert!(
+        !panel
+            .read_with(&cx, |panel, cx| panel.retained_threads().values().any(
+                |view| view.read(cx).agent_key().id().as_ref() == "retired-agent"
+            )),
+        "R1.6: no thread for the unavailable agent is kept"
+    );
+    assert_eq!(
+        entry_count(&source, &cx),
+        source_entries,
+        "R1.6: nothing was sent to the source thread either"
+    );
+}
+
+#[gpui::test]
+async fn test_run_prompt_leaves_the_prefill_path_unsent(cx: &mut TestAppContext) {
+    // Hostile half of R1.5: once both paths exist, the prefill path must not start sending
+    // (e.g. a shared helper defaulting to auto-submit). Run once, then prefill: the prefilled
+    // thread holds the command in its composer with nothing sent.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.run_prompt_in_new_thread(
+            Agent::Stub,
+            source_session.clone(),
+            "/compact".to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+    let run_thread = panel
+        .read_with(&cx, |panel, cx| panel.active_agent_thread(cx))
+        .expect("the Run thread is active");
+
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            Agent::Stub,
+            source_session,
+            COMMAND.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_prefilled_new_thread(&panel, &run_thread, &Agent::Stub.id(), COMMAND, &mut cx);
+    assert_eq!(
+        user_messages(&run_thread, &cx),
+        vec!["/compact".to_string()],
+        "the Run thread received its own command once, and not the prefilled one"
+    );
+}
diff --git a/crates/agent_ui/src/agent_panel/tests/run_prompt_validation_tests.rs b/crates/agent_ui/src/agent_panel/tests/run_prompt_validation_tests.rs
