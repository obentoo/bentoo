index 0000000..16a5e5d
--- /dev/null
+++ b/crates/agent_ui/src/agent_panel/tests/run_prompt_validation_tests.rs
@@ -0,0 +1,386 @@
+//! Run's first message skips the slash-command check; nothing else does (story 035, Task 2.4;
+//! R1.10, R1.11, R1.3, Q4).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod run_prompt_validation_tests;` beside `mod run_prompt_tests;`. It reuses story 020's
+//! harness (`prefilled_prompt_tests`) and Task 2.2's `assert_sent_new_thread`/`user_messages`
+//! (`run_prompt_tests`), so both modules must stay declared.
+//!
+//! Every agent here advertises no commands and no skills: `StubAgentConnection` never sends
+//! `available_commands_update`, which is exactly a brand-new adapter session before
+//! `newSession` returns. So any leading `/name` fails the advertised-commands check.
+//!
+//! Observation: what reached the agent is read from the thread's user messages (`AcpThread`
+//! records a user message only when it sends the prompt to the connection), as in
+//! `run_prompt_tests.rs`. A refused send also leaves its text in the composer and shows a
+//! thread error -- both observed through public panel/conversation accessors.
+//!
+//! Order follows the hostile-half rule. First the sends that must NOT be treated as Run
+//! (wrong collapse): the composer, the prefill once sent, another `auto_submit` caller, the
+//! URL deep link, a second command in Run's own thread, and a thread opened after a Run.
+//! Then the send that must not be treated as an ordinary one (wrong split): Run itself, and a
+//! second Run (the third element: the skip belongs to each Run, not to the first one only).
+//!
+//! Red before Task 2.4: the two Run tests at the bottom (nothing is sent). Every other test is
+//! a regression guard and passes before the change.
+
+use acp_thread::AcpThread;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+
+use super::prefilled_prompt_tests::*;
+use super::run_prompt_tests::{assert_sent_new_thread, user_messages};
+use crate::{Agent, AgentInitialContent, AgentPanel, AgentThreadSource, ExternalSourcePrompt};
+
+/// A second leading command no agent advertised, distinct from `COMMAND`.
+const SECOND_COMMAND: &str = "/not-advertised again";
+/// Text without a leading slash: never subject to the command check.
+const PLAIN: &str = "plain words, no command";
+
+/// The text in the active thread's composer, trimmed.
+fn active_composer_text(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Option<String> {
+    panel.read_with(cx, |panel, cx| {
+        let thread_id = panel.active_thread_id(cx)?;
+        panel
+            .editor_text(thread_id, cx)
+            .map(|text| text.trim().to_string())
+    })
+}
+
+/// Whether the active conversation shows a thread error (the refused send's message).
+fn shows_thread_error(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> bool {
+    panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .and_then(|view| {
+                view.read(cx)
+                    .as_connected()
+                    .map(|connected| connected.has_thread_error(cx))
+            })
+            .unwrap_or(false)
+    })
+}
+
+fn active_thread(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Entity<AcpThread> {
+    panel
+        .read_with(cx, |panel, cx| panel.active_agent_thread(cx))
+        .expect("a thread is active")
+}
+
+/// Types `text` into the active thread's composer and sends it the normal way.
+fn send_from_composer(panel: &Entity<AgentPanel>, text: &str, cx: &mut VisualTestContext) {
+    let thread_view = panel
+        .read_with(cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("a thread view is active");
+    let message_editor = thread_view.read_with(cx, |view, _| view.message_editor.clone());
+    message_editor.update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    thread_view.update_in(cx, |view, window, cx| view.send(window, cx));
+    settle(cx);
+}
+
+/// The initial content every non-Run `auto_submit` caller builds today: the git panel's
+/// review/conflict actions and the `create_thread` tool. If Task 2.4 adds a field to
+/// `ContentBlock`, set it here to the value every non-Run constructor uses.
+fn auto_submit_text(text: &str) -> AgentInitialContent {
+    AgentInitialContent::ContentBlock {
+        blocks: vec![acp_v2::ContentBlock::Text(acp_v2::TextContent::new(
+            text.to_string(),
+        ))],
+        auto_submit: true,
+    }
+}
+
+/// Opens a focused new `Agent::Stub` thread through the panel's private `external_thread`
+/// funnel -- the one `run_prompt_in_new_thread`, the prefill and every `auto_submit` caller
+/// share (reachable here because this module descends from `agent_panel`). The source is
+/// `AgentPanel`, the same as Run's, so only "is this Run" tells the two apart.
+fn open_thread_with_content(
+    panel: &Entity<AgentPanel>,
+    content: AgentInitialContent,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    panel.update_in(cx, |panel, window, cx| {
+        panel.external_thread(
+            Some(Agent::Stub),
+            None,
+            None,
+            None,
+            Some(content),
+            true,
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        );
+    });
+    settle(cx);
+    active_thread(panel, cx)
+}
+
+fn run(
+    panel: &Entity<AgentPanel>,
+    source: &Entity<AcpThread>,
+    text: &str,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    let source_session = source.read_with(cx, |thread, _| thread.session_id().clone());
+    panel.update_in(cx, |panel, window, cx| {
+        panel.run_prompt_in_new_thread(Agent::Stub, source_session, text.to_string(), window, cx);
+    });
+    settle(cx);
+    active_thread(panel, cx)
+}
+
+/// Asserts a refused send: nothing new reached the agent, the text is still in the composer,
+/// and the thread shows an error.
+fn assert_refused(
+    panel: &Entity<AgentPanel>,
+    thread: &Entity<AcpThread>,
+    messages_before: &[String],
+    text: &str,
+    cx: &VisualTestContext,
+    why: &str,
+) {
+    assert_eq!(
+        user_messages(thread, cx),
+        messages_before.to_vec(),
+        "{why}: the command must not reach the agent"
+    );
+    assert_eq!(
+        active_composer_text(panel, cx).as_deref(),
+        Some(text),
+        "{why}: a refused send leaves the text in the composer"
+    );
+    assert!(
+        shows_thread_error(panel, cx),
+        "{why}: the refusal is shown as a thread error"
+    );
+}
+
+#[gpui::test]
+async fn test_composer_send_of_an_unadvertised_command_is_refused(cx: &mut TestAppContext) {
+    // R1.11: the composer keeps the check.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let thread = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let before = user_messages(&thread, &cx);
+
+    send_from_composer(&panel, COMMAND, &mut cx);
+    assert_refused(
+        &panel,
+        &thread,
+        &before,
+        COMMAND,
+        &cx,
+        "R1.11 composer send",
+    );
+
+    // Control: the same composer sends text without a leading command, so the refusal above
+    // is the command check and not a thread that cannot send.
+    send_from_composer(&panel, PLAIN, &mut cx);
+    let mut expected = before;
+    expected.push(PLAIN.to_string());
+    assert_eq!(user_messages(&thread, &cx), expected);
+}
