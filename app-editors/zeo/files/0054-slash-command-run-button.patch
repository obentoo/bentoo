+/// One of the buttons a code block holding a slash command gets; the buttons
+/// differ only in how the agent panel opens the new thread with the command.
+struct SlashCommandButton {
+    icon: IconName,
+    tooltip: &'static str,
+    /// Names the button in the log when there is no panel to open a thread in.
+    label: &'static str,
+    workspace: WeakEntity<Workspace>,
+    agent_id: AgentId,
+    session_id: acp_v2::SessionId,
+    open: fn(
+        &mut AgentPanel,
+        Agent,
+        acp_v2::SessionId,
+        String,
+        &mut Window,
+        &mut Context<AgentPanel>,
+    ),
+}
+
+impl SlashCommandButton {
+    fn into_action(self) -> markdown::CodeBlockAction {
+        let Self {
+            icon,
+            tooltip,
+            label,
+            workspace,
+            agent_id,
+            session_id,
+            open,
+        } = self;
+        markdown::CodeBlockAction {
+            icon,
+            tooltip: tooltip.into(),
+            on_click: Rc::new(move |code: &str, window: &mut Window, cx: &mut App| {
+                // Re-read from the code the click hands over, so a button only ever
+                // acts on its own block's command.
+                let Some(command) = slash_command_in_code_block(code) else {
+                    return;
+                };
+                let Some(panel) = workspace
+                    .upgrade()
+                    .and_then(|workspace| workspace.read(cx).panel::<AgentPanel>(cx))
+                else {
+                    log::warn!(
+                        "slash command {label} button: no agent panel to open a thread in (session {session_id})"
+                    );
+                    return;
+                };
+                let command = command.to_string();
+                panel.update(cx, |panel, cx| {
+                    open(
+                        panel,
+                        Agent::from(agent_id.clone()),
+                        session_id.clone(),
+                        command,
+                        window,
+                        cx,
+                    );
+                });
+            }),
+        }
+    }
+}
