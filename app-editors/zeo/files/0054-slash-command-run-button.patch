@@ -0,0 +1,253 @@
+//! The Run button beside story 020's new-thread button, end to end through a real agent message
+//! (story 035, Task 2.3; R1.1, R1.2, R1.3, R1.4, R1.5, R1.8, Q11, Q12).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod slash_command_run_tests;` beside `mod prefilled_prompt_tests;`,
+//! `mod slash_command_button_tests;` and `mod run_prompt_tests;` (whose harnesses this reuses).
+//! Resolves to `crates/agent_ui/src/agent_panel/tests/slash_command_run_tests.rs`.
+//!
+//! How the buttons are found: both are `ui::IconButton`s, painted under `ICON-{icon:?}`. Run is
+//! `IconName::PlayOutlined` (story assumption A4, painted nowhere else in agent_ui at the series
+//! tip); New Thread stays `IconName::ThreadFromSummary` (0045). The code-block row shows on
+//! hover, so `sweep_both` hovers a grid and records every distinct bounds of each, asserting on
+//! every frame that the two appear and disappear together (same row, Copy's visibility, R1.1).
+//!
+//! Every test carries a qualifying control block, so it needs the feature to pass.
+//! Not asserted: the tooltip text "Run in New Thread" (R1.8) and focusability by keyboard
+//! (Q12) -- tooltips need a hover delay these sweeps do not model; reviewed and GUI-captured.
+
+use std::collections::BTreeSet;
+
+use gpui::{Bounds, Modifiers, Pixels, Point, TestAppContext, VisualTestContext, px};
+
+use super::prefilled_prompt_tests::*;
+use super::run_prompt_tests::{assert_sent_new_thread, user_messages};
+use super::slash_command_button_tests::{ACTION, click};
+
+const RUN: &str = "ICON-PlayOutlined";
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn key(bounds: Bounds<Pixels>) -> (i32, i32) {
+    (
+        f32::from(bounds.origin.x).round() as i32,
+        f32::from(bounds.origin.y).round() as i32,
+    )
+}
+
+struct Pair {
+    runs: Vec<Bounds<Pixels>>,
+    news: Vec<Bounds<Pixels>>,
+}
+
+fn sweep_both(cx: &mut VisualTestContext) -> Pair {
+    cx.simulate_mouse_move(Point::new(px(1.), px(1.)), None, Modifiers::none());
+    draw(cx);
+    assert!(
+        cx.debug_bounds(RUN).is_none(),
+        "precondition: {RUN} must not be painted with the mouse away (icon collision?)"
+    );
+    let (mut seen_runs, mut seen_news) = (BTreeSet::new(), BTreeSet::new());
+    let (mut runs, mut news) = (Vec::new(), Vec::new());
+    for x in (60..1200).step_by(120) {
+        for y in (4..800).step_by(10) {
+            cx.simulate_mouse_move(
+                Point::new(px(x as f32), px(y as f32)),
+                None,
+                Modifiers::none(),
+            );
+            draw(cx);
+            let run = cx.debug_bounds(RUN);
+            let new = cx.debug_bounds(ACTION);
+            assert_eq!(
+                run.is_some(),
+                new.is_some(),
+                "R1.1: Run shows exactly when the new-thread button does (at {x},{y})"
+            );
+            if let (Some(run), Some(new)) = (run, new) {
+                assert!(
+                    run.origin.x < new.origin.x
+                        && (f32::from(run.origin.y) - f32::from(new.origin.y)).abs() < 1.,
+                    "A4: Run sits left of New Thread in the same row: run {run:?}, new {new:?}"
+                );
+                if seen_runs.insert(key(run)) {
+                    runs.push(run);
+                }
+                if seen_news.insert(key(new)) {
+                    news.push(new);
+                }
+            }
+        }
+    }
+    Pair { runs, news }
+}
+
+#[gpui::test]
+async fn test_slash_command_run_only_on_the_qualifying_block_and_sends(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let reply = concat!(
+        "Two options:\n\n",
+        "```\n/epic:epic stories run 014\n/epic:epic stories run 015\n```\n\n", // R1.2
+        "A shell line:\n\n",
+        "```sh\necho /epic:epic stories run 014\n```\n\n", // R1.2
+        "Next step:\n\n",
+        "```\n  /epic:epic stories run 014  \n```\n", // R1.1 -- the control
+    );
+    let source = open_source_thread(&panel, "what next?", vec![agent_says(reply)], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_entries = entry_count(&source, &cx);
+    let toasts = notification_count(&workspace, &cx);
+    draw(&mut cx);
+
+    let pair = sweep_both(&mut cx);
+    assert_eq!(
+        pair.runs.len(),
+        1,
+        "R1.1/R1.2: exactly one block carries Run"
+    );
+    assert_eq!(pair.news.len(), 1, "and the same block carries New Thread");
+
+    let source_agent = active_agent_id(&panel, &cx);
+    click(pair.runs[0], &mut cx);
+
+    // R1.3/R1.4: the predicate's trimmed command, sent once, in a new thread of the same agent.
+    assert_sent_new_thread(&panel, &source, &source_agent, COMMAND, &mut cx);
+    assert_eq!(
+        entry_count(&source, &cx),
+        source_entries,
+        "R1.7: source untouched"
+    );
+    assert!(
+        panel.read_with(&cx, |panel, _| panel
+            .retained_threads()
+            .contains_key(&source_id)),
+        "R1.7: the source thread is still kept"
+    );
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts,
+        "no error toast"
+    );
+}
+
+#[gpui::test]
+async fn test_slash_command_run_sends_the_clicked_block_not_another(cx: &mut TestAppContext) {
+    // Hostile half of R1.4: two qualifying blocks in ONE message. Two Run buttons with distinct
+    // bounds (R1.8: distinct ids), and the LOWER one -- the second block -- sends "/second",
+    // never "/first" (a captured first block, or a shared id routing the click upward).
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(
+        &panel,
+        "what next?",
+        vec![agent_says(
+            "Either:\n\n```\n/first\n```\n\nor:\n\n```\n/second\n```\n",
+        )],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let pair = sweep_both(&mut cx);
+    assert_eq!(pair.runs.len(), 2, "both blocks carry their own Run");
+    assert_eq!(pair.news.len(), 2, "both blocks carry their own New Thread");
+    let lower = pair
+        .runs
+        .iter()
+        .copied()
+        .max_by(|a, b| f32::from(a.origin.y).total_cmp(&f32::from(b.origin.y)))
+        .unwrap();
+
+    let source_agent = active_agent_id(&panel, &cx);
+    click(lower, &mut cx);
+    assert_sent_new_thread(&panel, &source, &source_agent, "/second", &mut cx);
+}
+
+#[gpui::test]
+async fn test_slash_command_run_sends_the_upper_block_when_it_is_clicked(cx: &mut TestAppContext) {
+    // The converse of the test above: the UPPER Run sends "/first" -- a fix that always took
+    // the last block would pass the other test and fail this one.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(
+        &panel,
+        "what next?",
+        vec![agent_says(
+            "Either:\n\n```\n/first\n```\n\nor:\n\n```\n/second\n```\n",
+        )],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let pair = sweep_both(&mut cx);
+    assert_eq!(pair.runs.len(), 2);
+    let upper = pair
+        .runs
+        .iter()
+        .copied()
+        .min_by(|a, b| f32::from(a.origin.y).total_cmp(&f32::from(b.origin.y)))
+        .unwrap();
+
+    let source_agent = active_agent_id(&panel, &cx);
+    click(upper, &mut cx);
+    assert_sent_new_thread(&panel, &source, &source_agent, "/first", &mut cx);
+}
+
+#[gpui::test]
+async fn test_slash_command_new_thread_beside_run_still_prefills_unsent(cx: &mut TestAppContext) {
+    // Hostile half of R1.5: with Run in the same row, the new-thread button must not send.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(
+        &panel,
+        "what next?",
+        vec![agent_says("Next:\n\n```\n/compact\n```\n")],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let pair = sweep_both(&mut cx);
+    assert_eq!(
+        pair.runs.len(),
+        1,
+        "precondition: Run is offered on the block"
+    );
+    assert_eq!(pair.news.len(), 1);
+    let source_agent = active_agent_id(&panel, &cx);
+    click(pair.news[0], &mut cx);
+
+    assert_prefilled_new_thread(&panel, &source, &source_agent, "/compact", &mut cx);
+    let active = panel
+        .read_with(&cx, |panel, cx| panel.active_agent_thread(cx))
+        .unwrap();
+    assert!(
+        user_messages(&active, &cx).is_empty(),
+        "R1.5: nothing was sent"
+    );
+}
+
+#[gpui::test]
+async fn test_slash_command_run_not_on_thinking_or_user_message(cx: &mut TestAppContext) {
+    // R1.2: a qualifying block in the thinking, and one in the operator's own message, carry no
+    // Run; the message's block (the control) does.
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(
+        &panel,
+        "Should I run\n\n```\n/help\n```\n",
+        vec![
+            agent_thinks("Maybe:\n\n```\n/init\n```\n"),
+            agent_says("No, run:\n\n```\n/compact\n```\n"),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let pair = sweep_both(&mut cx);
+    assert_eq!(
+        pair.runs.len(),
+        1,
+        "R1.2: only the agent message's block carries Run"
+    );
+    let source_agent = active_agent_id(&panel, &cx);
+    click(pair.runs[0], &mut cx);
+    assert_sent_new_thread(&panel, &source, &source_agent, "/compact", &mut cx);
+}
