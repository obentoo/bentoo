+
+#[test]
+fn secret_vault_jail_use_normalizes_its_hosts() {
+    let jail_use =
+        JailUse::new("GH_TOKEN", &["GitHub.com.", "api.github.com", "github.com"]).unwrap();
+    assert_eq!(jail_use.env_name, "GH_TOKEN");
+    assert_eq!(jail_use.hosts, ["api.github.com", "github.com"]);
+    assert_eq!(jail_use.hosts_attribute(), "api.github.com,github.com");
+}
+
+#[test]
+fn secret_vault_jail_use_refuses_what_the_proxy_could_not_bind() {
+    for name in ["", "1TOKEN", "GH-TOKEN", "GH TOKEN", "TOKEN="] {
+        assert!(JailUse::new(name, &["api.github.com"]).is_err(), "{name:?}");
+    }
+    for host in [
+        "https://api.github.com",
+        "api.github.com:443",
+        "api.github.com/v3",
+        "*.github.com",
+        "localhost",
+        "93.184.216.34",
+        "-bad.example.com",
+        "a..b",
+        "",
+    ] {
+        assert!(JailUse::new("TOKEN", &[host]).is_err(), "{host:?}");
+    }
+    assert!(JailUse::new("TOKEN", &[]).is_err());
+    let many: Vec<String> = (0..=MAX_HOSTS)
+        .map(|n| format!("h{n}.example.com"))
+        .collect();
+    let many: Vec<&str> = many.iter().map(String::as_str).collect();
+    assert!(JailUse::new("TOKEN", &many).is_err());
+}
+
+#[test]
+fn secret_vault_jail_use_parses_the_two_fields() {
+    assert_eq!(JailUse::parse("", "  ").unwrap(), None);
+    assert!(JailUse::parse("GH_TOKEN", "").is_err());
+    assert!(JailUse::parse("", "api.github.com").is_err());
+    assert_eq!(
+        JailUse::parse(
+            " GH_TOKEN ",
+            "api.github.com, github.com uploads.github.com"
+        )
+        .unwrap()
+        .unwrap()
+        .hosts,
+        ["api.github.com", "github.com", "uploads.github.com"]
+    );
+}
+
+#[test]
+fn secret_vault_item_attributes_carry_the_jail_use_and_read_back() {
+    let reference = SecretRef::new("github", "token").unwrap();
+    assert_eq!(
+        item_attributes(&reference, None).len(),
+        3,
+        "a secret no jail uses keeps azukari's attributes alone"
+    );
+    let jail_use = JailUse::new("GH_TOKEN", &["api.github.com"]).unwrap();
+    let attributes: std::collections::HashMap<String, String> =
+        item_attributes(&reference, Some(&jail_use))
+            .into_iter()
+            .collect();
+    assert_eq!(attributes["zeo-env"], "GH_TOKEN");
+    assert_eq!(attributes["zeo-hosts"], "api.github.com");
+    assert_eq!(JailUse::from_attributes(&attributes), Some(jail_use));
+
+    // Edited outside Zeo into something that does not read back: no jail receives it.
+    let mut edited = attributes;
+    edited.insert("zeo-hosts".into(), "https://evil.example".into());
+    assert_eq!(JailUse::from_attributes(&edited), None);
+    edited.remove("zeo-hosts");
+    assert_eq!(JailUse::from_attributes(&edited), None);
+}
