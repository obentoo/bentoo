+/// What a jail may do with a secret: the agent's environment carries `env_name` set to a
+/// placeholder, and ai-jail's egress proxy swaps the real value in only on requests to `hosts`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct JailUse {
+    pub env_name: String,
+    /// Lowercase host names, sorted and without duplicates.
+    pub hosts: Vec<String>,
+}
+
+impl JailUse {
+    /// A variable name of letters, digits and `_` that does not start with a digit, and one to
+    /// [`MAX_HOSTS`] host names. A host is a DNS name with at least one dot: no scheme, port,
+    /// path, wildcard or IP address, because the proxy mints a certificate for exactly that name
+    /// and ai-jail binds the secret to it.
+    pub fn new(env_name: &str, hosts: &[&str]) -> Result<Self> {
+        let valid_name = !env_name.is_empty()
+            && env_name.len() <= 128
+            && !env_name.starts_with(|c: char| c.is_ascii_digit())
+            && env_name
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || c == '_');
+        if !valid_name {
+            bail!("{env_name:?} is not a variable name (letters, digits and _, not first a digit)");
+        }
+        let mut normalized = Vec::new();
+        for host in hosts {
+            let host = host.trim_end_matches('.').to_ascii_lowercase();
+            if !is_host_name(&host) {
+                bail!("{host:?} is not a host name (like api.github.com: no scheme, port or path)");
+            }
+            normalized.push(host);
+        }
+        normalized.sort();
+        normalized.dedup();
+        if normalized.is_empty() {
+            bail!("a secret a jail uses needs at least one host");
+        }
+        if normalized.len() > MAX_HOSTS {
+            bail!("a secret may name at most {MAX_HOSTS} hosts");
+        }
+        Ok(Self {
+            env_name: env_name.to_string(),
+            hosts: normalized,
+        })
+    }
+
+    /// The page's two fields: both empty is no jail use, one of them alone is refused. Hosts are
+    /// separated by commas or spaces.
+    pub fn parse(env_name: &str, hosts_text: &str) -> Result<Option<Self>> {
+        let env_name = env_name.trim();
+        let hosts: Vec<&str> = hosts_text
+            .split(|c: char| c == ',' || c.is_whitespace())
+            .filter(|host| !host.is_empty())
+            .collect();
+        match (env_name.is_empty(), hosts.is_empty()) {
+            (true, true) => Ok(None),
+            (false, true) => bail!("name the hosts {env_name} may be sent to"),
+            (true, false) => bail!("name the variable a jailed agent sees"),
+            (false, false) => Self::new(env_name, &hosts).map(Some),
+        }
+    }
+
+    /// The `zeo-hosts` attribute's value.
+    pub fn hosts_attribute(&self) -> String {
+        self.hosts.join(",")
+    }
+
+    /// The declaration an item's attributes carry, if any. An item whose declaration does not
+    /// read back -- edited outside Zeo -- declares none, so a jail never receives it.
+    pub fn from_attributes(attributes: &HashMap<String, String>) -> Option<Self> {
+        let env_name = attributes.get(ENV_ATTRIBUTE)?;
+        let hosts: Vec<&str> = attributes.get(HOSTS_ATTRIBUTE)?.split(',').collect();
+        Self::new(env_name, &hosts).ok()
+    }
+}
+
+fn is_host_name(host: &str) -> bool {
+    host.len() <= 253
+        && host.contains('.')
+        && host.parse::<std::net::IpAddr>().is_err()
+        && host.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && !label.starts_with('-')
+                && !label.ends_with('-')
+                && label
+                    .chars()
+                    .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+        })
+}
+
+/// The attributes an item is stored under: the reference's, plus its jail use when it declares
+/// one.
+pub fn item_attributes(reference: &SecretRef, jail_use: Option<&JailUse>) -> Vec<(String, String)> {
+    let mut attributes: Vec<(String, String)> = reference
+        .attributes()
+        .iter()
+        .map(|(key, value)| (key.to_string(), value.to_string()))
+        .collect();
+    if let Some(jail_use) = jail_use {
+        attributes.push((ENV_ATTRIBUTE.to_string(), jail_use.env_name.clone()));
+        attributes.push((HOSTS_ATTRIBUTE.to_string(), jail_use.hosts_attribute()));
+    }
+    attributes
+}
