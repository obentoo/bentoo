 /// The last [`TAIL_LEN`] characters of `value`, or all of a shorter one -- by characters, so a
 /// multi-byte value is never cut inside one.
 pub fn tail(value: &str) -> String {
@@ -93,6 +216,8 @@ pub struct VaultEntry {
