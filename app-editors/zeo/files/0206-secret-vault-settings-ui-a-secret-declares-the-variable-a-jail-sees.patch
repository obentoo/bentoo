+        let wanted: HashMap<String, String> = attributes.into_iter().collect();
+        let items = keyring
+            .search_items(&reference.attributes().to_vec())
             .await
-            .with_context(|| format!("cannot store {}", reference.uri()))
+            .with_context(|| format!("cannot look up {}", reference.uri()))?;
+        for item in items {
+            let held = item.attributes().await?;
+            let same = [ENV_ATTRIBUTE, HOSTS_ATTRIBUTE]
+                .iter()
+                .all(|key| held.get(*key) == wanted.get(*key));
+            if !same {
+                item.delete()
+                    .await
+                    .with_context(|| format!("cannot replace {}", reference.uri()))?;
+            }
+        }
+        Ok(())
     }
 
-    /// Every item Zeo made, by reference, with the tail of its value.
+    /// Every item Zeo made, by reference, with the tail of its value and its jail use.
     pub async fn list() -> Result<Vec<VaultEntry>> {
         let keyring = open().await?;
         let items = keyring
@@ -146,12 +307,40 @@ mod keyring {
                 Ok(secret) => tail(&String::from_utf8_lossy(&secret)),
                 Err(_) => String::new(),
             };
-            out.push(VaultEntry { reference, tail });
+            let jail_use = JailUse::from_attributes(&attributes);
+            out.push(VaultEntry {
+                reference,
+                tail,
+                jail_use,
+            });
         }
         out.sort_by(|a, b| a.reference.cmp(&b.reference));
         Ok(out)
     }
 
+    /// The value Zeo stored under `reference`, in memory that is wiped when dropped. Refused when
+    /// no item or more than one answers: handing a jail the wrong credential is worse than none.
+    pub async fn read(reference: &SecretRef) -> Result<Zeroizing<String>> {
+        let keyring = open().await?;
+        let items = keyring
+            .search_items(&reference.attributes().to_vec())
+            .await
+            .with_context(|| format!("cannot look up {}", reference.uri()))?;
+        let item = match items.as_slice() {
+            [item] => item,
+            [] => bail!("{} is not in the vault", reference.uri()),
+            _ => bail!("more than one item answers {}", reference.uri()),
+        };
+        let secret = item
+            .secret()
+            .await
+            .with_context(|| format!("cannot read {}", reference.uri()))?;
+        match std::str::from_utf8(secret.as_bytes()) {
+            Ok(text) => Ok(Zeroizing::new(text.to_string())),
+            Err(_) => bail!("{} does not hold text", reference.uri()),
+        }
+    }
+
     /// Delete what Zeo stored under `reference`; nothing else matches the vault attribute.
     pub async fn delete(reference: &SecretRef) -> Result<()> {
         let keyring = open().await?;
