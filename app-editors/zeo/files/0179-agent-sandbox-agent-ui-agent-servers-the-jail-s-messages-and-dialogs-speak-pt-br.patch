+++ b/crates/zeo_i18n/locales/en-US/agent-jail.ftl
@@ -0,0 +1,160 @@
+### The jail's messages outside the settings page (patch 0179, USE ai-jail): why a start was
+### refused, why an entry was refused, the Turn Off / Forget / Allow dialogs, the thread's lock
+### and its tooltip, the quick modal, the paused controls and the MCP not-enabled notice. The
+### English is the code's own, byte for byte. These errors are Display texts, so a log line that
+### quotes one follows the UI language; its event= and key= fields stay English.
+###
+### $rule (a path a jail refuses): root, home, above_home, protected, link_target, runtime_dir,
+### incomplete -- with $path, $other (the symlink) and $stop (why a scan stopped) as they apply.
+
+## Why a scan of a protected folder stopped ($stop: too_many, too_deep, unreadable)
+
+agent-jail-walk-stop = { $stop ->
+    [too_many] it holds more than { $limit } entries
+    [too_deep] it is nested deeper than { $limit } levels
+   *[unreadable] it could not be read: { $kind }
+}
+
+## A refused start
+
+agent-jail-launch-no-root = The project has no local folder to run the agent in, and the agent sandbox is on.
+agent-jail-launch-root-colon = The project folder { $root } contains ':', which ai-jail reads as SOURCE:DEST, so its .git and .zed could not be kept read-only.
+agent-jail-launch-root-not-utf8 = The project folder { $root } is not valid UTF-8, so ai-jail cannot be given its .git and .zed.
+agent-jail-launch-root-forbidden = { $rule ->
+    [root] The project folder { $root } is the root directory /; the agent sandbox does not run an agent there.
+    [home] The project folder { $root } is the home directory; the agent sandbox does not run an agent there.
+    [above_home] The project folder { $root } contains the home directory { $path }; the agent sandbox does not run an agent there.
+    [protected] The project folder { $root } is, lies inside, or contains the protected path { $path }; the agent sandbox does not run an agent there.
+    [link_target] The project folder { $root } is, lies inside, or contains { $path }, the target of the symlink { $other } in a protected folder; the agent sandbox does not run an agent there.
+    [runtime_dir] The project folder { $root } is, lies inside, or contains the runtime directory { $path }, which holds Zeo's devtools socket; the agent sandbox does not run an agent there.
+   *[incomplete] The project folder { $root } cannot be checked: the protected folder { $path } was not fully scanned for symlinks ({ $stop }), so every folder is refused; the agent sandbox does not run an agent there.
+}
+agent-jail-launch-root-missing = The project folder { $root } no longer exists or is not a folder.
+agent-jail-launch-not-installed-at = ai-jail was not found at { $path } (agent_sandbox.ai_jail_path).
+agent-jail-launch-not-installed = ai-jail was not found on PATH; install it or set agent_sandbox.ai_jail_path.
+agent-jail-launch-version-unreadable = The version of ai-jail could not be read: { $error }.
+agent-jail-launch-claude-dir-invalid = The Claude config directory (agent_sandbox.claude_config_dir) cannot be mapped: { $error }
+agent-jail-launch-claude-dir-missing = The Claude config directory { $dir } does not exist. Create it and log in with `CLAUDE_CONFIG_DIR={ $dir } claude`.
+agent-jail-launch-nested-map = Writable folder { $inner } lies inside { $outer }, which the agent can write; it could swap the inner folder for a symlink before the jail starts. Keep the outer folder only.
+agent-jail-launch-env-key = The environment variable name "{ $name }" cannot be passed into the jail: a name has only letters, digits and '_', and does not start with a digit.
+agent-jail-launch-symlinked-mount = { $path } is a symlink; ai-jail cannot keep it read-only. Replace it with the folder itself.
+agent-jail-launch-dir-create = Could not create { $dir }: { $error }.
+agent-jail-launch-limits-unsupported = Resource limits are set for this project, and the installed ai-jail cannot apply them (it has no --memory). Install sys-apps/ai-jail 3.5.0-r1 or later, or clear agent_sandbox.limits.
+agent-jail-launch-mask-host-unsupported = The host view is on for this project (agent_sandbox.mask_host), and the installed ai-jail cannot give it (it has no --mask-host). Install sys-apps/ai-jail 3.5.0-r2 or later, or turn Hide the Host off on the Agent Sandbox page.
+agent-jail-launch-overlay-unsupported = Hide the Disks is on for this project (agent_sandbox.overlay_system), and the installed ai-jail cannot give it (it has no --overlay-system). Install sys-apps/ai-jail 3.5.0-r3 or later, or turn Hide the Disks off on the Agent Sandbox page.
+agent-jail-launch-syscall-view-unsupported = Hide the Kernel is on for this project (agent_sandbox.syscall_view), and the installed ai-jail cannot give it (it has no --syscall-view). Install sys-apps/ai-jail 3.5.0-r4 or later, or turn Hide the Kernel off on the Agent Sandbox page.
+agent-jail-launch-minimal-etc-unsupported = Hide the System Config is on for this project (agent_sandbox.minimal_etc), and the installed ai-jail cannot give it (it has no --minimal-etc). Install sys-apps/ai-jail 3.5.0-r5 or later, or turn Hide the System Config off on the Agent Sandbox page.
+agent-jail-launch-state-root-create = The project's jail state folder { $dir } could not be created: { $error }.
+agent-jail-launch-refused = Agent sandbox, project { $root }: { $cause } { $fail_closed }
+agent-jail-launch-refused-no-root = Agent sandbox: { $cause } { $fail_closed }
+agent-jail-fail-closed = The agent was not started without the sandbox.
+agent-jail-memory-endpoint-not-url = The ai-memory endpoint "{ $shown }" (agent_memory.endpoint) is not a URL.
+agent-jail-memory-port-unsupported = ai-memory is not reachable from inside the jail: this ai-jail has no --forward-port
+agent-jail-outdated = ai-jail { $version } is older than { $min } and is affected by GHSA-frgp-q3qc-g78p and GHSA-w976-gw52-hvx2. Update ai-jail to { $min } or newer.
+
+## A refused writable folder
+
+agent-jail-rw-map-empty = A writable folder entry is empty; it must be an absolute path.
+agent-jail-rw-map-not-absolute = Writable folder "{ $entry }" is not an absolute path; start it with / or ~/.
+agent-jail-rw-map-colon = Writable folder "{ $entry }" contains ':', which ai-jail reads as SOURCE:DEST.
+agent-jail-rw-map-missing = Writable folder "{ $entry }" does not exist or cannot be resolved ({ $kind }).
+agent-jail-rw-map-not-utf8 = Writable folder "{ $entry }" resolves to { $canonical }, which is not valid UTF-8 and cannot be passed to ai-jail.
+agent-jail-rw-map-colon-in-target = Writable folder "{ $entry }" resolves to { $canonical }, which contains ':', which ai-jail reads as SOURCE:DEST.
+agent-jail-rw-map-forbidden = { $rule ->
+    [root] Writable folder "{ $entry }" ({ $canonical }) is the root directory /.
+    [home] Writable folder "{ $entry }" ({ $canonical }) is the home directory.
+    [above_home] Writable folder "{ $entry }" ({ $canonical }) contains the home directory { $path }.
+    [protected] Writable folder "{ $entry }" ({ $canonical }) is, lies inside, or contains the protected path { $path }.
+    [link_target] Writable folder "{ $entry }" ({ $canonical }) is, lies inside, or contains { $path }, the target of the symlink { $other } in a protected folder.
+    [runtime_dir] Writable folder "{ $entry }" ({ $canonical }) is, lies inside, or contains the runtime directory { $path }, which holds Zeo's devtools socket.
+   *[incomplete] Writable folder "{ $entry }" ({ $canonical }) cannot be checked: the protected folder { $path } was not fully scanned for symlinks ({ $stop }), so every folder is refused.
+}
+agent-jail-rw-map-not-folder = Writable folder "{ $entry }" ({ $canonical }) is not a folder.
+
+## A refused allowed host ($shape: scheme, path, port, wildcard, upper_case, malformed)
+
+agent-jail-host-empty = An allowed host entry is empty.
+agent-jail-host-too-long = Allowed host "{ $entry }" is { $length } characters long; a DNS name has at most { $max }.
+agent-jail-host-ip = Allowed host "{ $entry }" is an IP address; only DNS names are allowed.
+agent-jail-host-localhost = Allowed host "{ $entry }" names localhost; loopback services are never allowed hosts.
+agent-jail-host-not-dns = { $shape ->
+    [scheme] Allowed host "{ $entry }" carries a scheme; write the bare host name.
+    [path] Allowed host "{ $entry }" carries a path; write the bare host name.
+    [port] Allowed host "{ $entry }" carries a port; write the bare host name.
+    [wildcard] Allowed host "{ $entry }" is a wildcard; list each host name.
+    [upper_case] Allowed host "{ $entry }" has upper-case letters; write it in lower case.
+   *[malformed] Allowed host "{ $entry }" is not a DNS name (two or more labels of a-z, 0-9 and inner '-', no trailing dot).
+}
+agent-jail-host-numeric-label = Allowed host "{ $entry }" ends in a numeric label, which resolves as an IP address; only DNS names are allowed.
+agent-jail-host-pattern-unavailable = Allowed host "{ $entry }" cannot be checked: the host-name pattern is unavailable.
+agent-jail-limit-rw-maps = Writable folder #{ $number } crosses the limit of { $max } writable folders per project ({ $count } configured).
+agent-jail-limit-hosts = Allowed host #{ $number } crosses the limit of { $max } allowed hosts per project ({ $count } configured).
+
+## Dialogs and notifications
+
+agent-jail-confirm-turn-off-project = Turn off the agent sandbox for { $name }?
+agent-jail-confirm-turn-off-default = Turn off the agent sandbox for projects without their own setting?
+agent-jail-confirm-turn-off-detail = The agent will run with your user's full access the next time it starts.
+agent-jail-confirm-forget = Forget { $path }?
+agent-jail-confirm-forget-detail = ai-memory deletes the page. This cannot be undone.
+agent-jail-button-cancel = Cancel
+agent-jail-button-turn-off = Turn Off
+agent-jail-button-forget = Forget
+agent-jail-button-allow = Allow
+agent-jail-root-not-utf8 = The agent sandbox cannot be configured for a project whose path is not valid UTF-8: { $path }
+agent-jail-secret-prompt = Allow "{ $server }" in this project's jail?
+    .detail = Its configuration carries a secret ({ $places }). Zeo never hands it to the jail as configured, so the secret stays outside: the agent reaches the server only through Zeo's own copy (Claude Agent (Plus)), and an agent that cannot (the TUI adapter) does not get it. The agent can still use the server's access.
+
+## ai-memory
+
+agent-jail-memory-unreachable = ai-memory is not reachable at { $endpoint }
+agent-jail-memory-timeout = ai-memory is not reachable at { $endpoint }: no answer within { $seconds } seconds
+agent-jail-memory-unknown-project = No memory recorded for { $scope } yet.
+agent-jail-memory-malformed = ai-memory sent an answer to { $tool } that Zeo cannot read
+
+## The MCP not-enabled notice in the thread
+
+agent-jail-notice-title = { $count ->
+    [one] 1 MCP server is not enabled for this project's jail
+   *[other] { $count } MCP servers are not enabled for this project's jail
+}
+agent-jail-notice-not-chosen = Not chosen: { $names }.
+agent-jail-notice-secret-cannot-proxy = Carries a secret, which reaches a jail only through Zeo's own copy, and this agent cannot use it (MCP over ACP): { $names }.
+agent-jail-notice-secret-not-running = Carries a secret, which reaches a jail only through Zeo's own copy, and that copy is not running: { $names }.
+agent-jail-notice-choose = Choose them under Capabilities on the Agent Sandbox page.
+agent-jail-notice-open = Open Capabilities
+
+## The thread's lock, its tooltip and the quick modal ($list: rw_maps, allow_hosts, forward_ports)
+
+agent-jail-status-title = Agent Sandbox
+agent-jail-status-on = Started inside the agent sandbox (ai-jail).
+agent-jail-status-off = Started without the agent sandbox.
+agent-jail-status-version = ai-jail version: { $version }
+agent-jail-status-version-unknown = unknown
+agent-jail-status-list = { $list ->
+    [rw_maps] Writable folders: { $items }
+    [allow_hosts] Allowed hosts: { $items }
+   *[forward_ports] Forwarded ports: { $items }
+}
+agent-jail-status-list-none = none
+agent-jail-status-remote = The agent sandbox is not available for remote projects.
+agent-jail-status-own-command = Sandboxed by its agent_servers command; not managed by Zeo.
+agent-jail-status-not-claude = Not a Claude agent: the agent sandbox applies only to the Claude adapters.
+agent-jail-status-drifted = Restart the agent to apply the new setting.
+agent-jail-status-pending-on = Sandbox on — restart the agent to apply it. Click to restart.
+agent-jail-status-pending-off = Sandbox off — restart the agent to apply it. Click to restart.
+agent-jail-status-reserved-cpus = Reserved CPUs: { $cpus }
+agent-jail-status-cpus-shared = Shares CPUs { $cpus } with another jail: too few cores were free when it started.
+    .label = Shares CPUs
+agent-jail-status-ai-jail-missing = The agent sandbox needs ai-jail, which is not installed. Install sys-apps/ai-jail 3.5.0-r2 or later, then start a new thread to turn the sandbox on.
+agent-jail-pause = Pause Agent: freeze the jail; Resume goes on with nothing lost
+agent-jail-stop = Stop Agent: end the jail and everything running in it
+agent-jail-paused = Paused
+agent-jail-paused-disk = Paused: disk quota
+agent-jail-resume = Resume
+    .operator = Let the agent go on where it stopped
+    .disk = Let the agent go on; it may grow by the quota again from here
+agent-jail-paused-stop = Stop
+    .tooltip = End the jail and everything running in it
+agent-jail-quick-hint = Applies when the agent restarts: click the lock again once it turns amber.
+agent-jail-quick-advanced = Advanced…
