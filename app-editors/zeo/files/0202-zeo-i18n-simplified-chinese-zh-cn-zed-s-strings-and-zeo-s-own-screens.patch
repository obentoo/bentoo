From 4e356634e31643e76d65b55af4723e46780b3ec8 Mon Sep 17 00:00:00 2001
From: zed-patches <zed-patches@localhost>
Date: Thu, 26 Nov 2026 11:27:38 -0300
Subject: [PATCH] zeo_i18n: Simplified Chinese (zh-CN) -- Zed's strings and
 Zeo's own screens
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

locales/zh-CN/: zed-core.ftl (Zed's strings, palette action names and run-time templates) and the ten files of Zeo's own screens; number selectors keep a single *[other] variant. Drafted with Lara (no_trace) and revised by hand; not reviewed by a native speaker. "agent" is 智能体 throughout (代理 also means proxy), with "Agent Client Protocol" and code identifiers kept; "jail", "sandbox" and "thread" stay in Latin script.

Ungrouped and new files only, so any USE set applies it; a build without a group ships that group's zh-CN messages unused.
---

diff --git a/crates/zeo_i18n/locales/zh-CN/agent-jail.ftl b/crates/zeo_i18n/locales/zh-CN/agent-jail.ftl
new file mode 100644
index 00000000..ef459600
--- /dev/null
+++ b/crates/zeo_i18n/locales/zh-CN/agent-jail.ftl
@@ -0,0 +1,155 @@
+### The jail's messages outside the settings page, in Simplified Chinese (zh-CN).
+### Drafted with Lara Translate and revised; not reviewed by a native speaker.
+### Glossary: "jail", "sandbox" and "thread" stay in English; "agent" is 智能体.
+
+## Why a scan of a protected folder stopped ($stop: too_many, too_deep, unreadable)
+
+agent-jail-walk-stop = { $stop ->
+    [too_many] 其中的条目超过{ $limit }个
+    [too_deep] 其嵌套深度超过{ $limit }层
+   *[unreadable] 无法读取：{ $kind }
+}
+
+## A refused start
+
+agent-jail-launch-no-root = 该项目没有可供智能体运行的本地文件夹，而智能体sandbox已开启。
+agent-jail-launch-root-colon = 项目文件夹{ $root }包含“:”，ai-jail会将其解读为SOURCE:DEST，因此无法将其.git和.zed保持为只读。
+agent-jail-launch-root-not-utf8 = 项目文件夹{ $root }不是有效的UTF-8，因此无法将其.git和.zed交给ai-jail。
+agent-jail-launch-root-forbidden = { $rule ->
+    [root] 项目文件夹{ $root }是根目录/；智能体sandbox不会在此运行智能体。
+    [home] 项目文件夹{ $root }是主目录；智能体sandbox不会在此运行智能体。
+    [above_home] 项目文件夹{ $root }包含主目录{ $path }；智能体sandbox不会在此运行智能体。
+    [protected] 项目文件夹{ $root }即是受保护路径{ $path }、位于其中或包含它；智能体sandbox不会在此运行智能体。
+    [link_target] 项目文件夹{ $root }即是{ $path }（受保护文件夹中符号链接{ $other }的目标）、位于其中或包含它；智能体sandbox不会在此运行智能体。
+    [runtime_dir] 项目文件夹{ $root }即是运行时目录{ $path }（存放Zeo的devtools socket）、位于其中或包含它；智能体sandbox不会在此运行智能体。
+   *[incomplete] 无法检查项目文件夹{ $root }：受保护文件夹{ $path }未能完整扫描符号链接（{ $stop }），因此所有文件夹均被拒绝；智能体sandbox不会在此运行智能体。
+}
+agent-jail-launch-root-missing = 项目文件夹{ $root }已不存在或不是文件夹。
+agent-jail-launch-not-installed-at = 在{ $path }未找到ai-jail（agent_sandbox.ai_jail_path）。
+agent-jail-launch-not-installed = 在PATH中未找到ai-jail；请安装它或设置agent_sandbox.ai_jail_path。
+agent-jail-launch-version-unreadable = 无法读取ai-jail的版本：{ $error }。
+agent-jail-launch-claude-dir-invalid = 无法映射Claude配置目录（agent_sandbox.claude_config_dir）：{ $error }
+agent-jail-launch-claude-dir-missing = Claude配置目录{ $dir }不存在。请创建该目录，并使用`CLAUDE_CONFIG_DIR={ $dir } claude`登录。
+agent-jail-launch-nested-map = 可写文件夹{ $inner }位于{ $outer }内，而智能体可以写入后者；它可能在jail启动前将内层文件夹替换为符号链接。请只保留外层文件夹。
+agent-jail-launch-env-key = 环境变量名“{ $name }”无法传入jail：名称只能包含字母、数字和“_”，且不能以数字开头。
+agent-jail-launch-symlinked-mount = { $path }是符号链接；ai-jail无法使其保持只读。请将其替换为文件夹本身。
+agent-jail-launch-dir-create = 无法创建{ $dir }：{ $error }。
+agent-jail-launch-limits-unsupported = 此项目设置了资源限制，但已安装的ai-jail无法应用（它没有--memory）。请安装sys-apps/ai-jail 3.5.0-r1或更高版本，或清除agent_sandbox.limits。
+agent-jail-launch-mask-host-unsupported = 此项目已开启主机视图（agent_sandbox.mask_host），但已安装的ai-jail无法提供（它没有--mask-host）。请安装sys-apps/ai-jail 3.5.0-r2或更高版本，或在Agent Sandbox页面关闭“隐藏主机”。
+agent-jail-launch-overlay-unsupported = 此项目已开启“隐藏磁盘”（agent_sandbox.overlay_system），但已安装的ai-jail无法提供（它没有--overlay-system）。请安装sys-apps/ai-jail 3.5.0-r3或更高版本，或在Agent Sandbox页面关闭“隐藏磁盘”。
+agent-jail-launch-syscall-view-unsupported = 此项目已开启“隐藏内核”（agent_sandbox.syscall_view），但已安装的ai-jail无法提供（它没有--syscall-view）。请安装sys-apps/ai-jail 3.5.0-r4或更高版本，或在Agent Sandbox页面关闭“隐藏内核”。
+agent-jail-launch-minimal-etc-unsupported = 此项目已开启“隐藏系统配置”（agent_sandbox.minimal_etc），但已安装的ai-jail无法提供（它没有--minimal-etc）。请安装sys-apps/ai-jail 3.5.0-r5或更高版本，或在Agent Sandbox页面关闭“隐藏系统配置”。
+agent-jail-launch-state-root-create = 无法创建项目的jail状态文件夹{ $dir }：{ $error }。
+agent-jail-launch-refused = 智能体sandbox，项目{ $root }：{ $cause }{ $fail_closed }
+agent-jail-launch-refused-no-root = 智能体sandbox：{ $cause }{ $fail_closed }
+agent-jail-fail-closed = 智能体未在sandbox之外启动。
+agent-jail-memory-endpoint-not-url = ai-memory端点“{ $shown }”（agent_memory.endpoint）不是URL。
+agent-jail-memory-port-unsupported = 无法从jail内部访问ai-memory：此ai-jail没有--forward-port
+agent-jail-outdated = ai-jail { $version }早于{ $min }，受GHSA-frgp-q3qc-g78p和GHSA-w976-gw52-hvx2影响。请将ai-jail更新到{ $min }或更高版本。
+
+## A refused writable folder
+
+agent-jail-rw-map-empty = 有一个可写文件夹条目为空；它必须是绝对路径。
+agent-jail-rw-map-not-absolute = 可写文件夹“{ $entry }”不是绝对路径；请以/或~/开头。
+agent-jail-rw-map-colon = 可写文件夹“{ $entry }”包含“:”，ai-jail会将其解读为SOURCE:DEST。
+agent-jail-rw-map-missing = 可写文件夹“{ $entry }”不存在或无法解析（{ $kind }）。
+agent-jail-rw-map-not-utf8 = 可写文件夹“{ $entry }”解析为{ $canonical }，它不是有效的UTF-8，无法传给ai-jail。
+agent-jail-rw-map-colon-in-target = 可写文件夹“{ $entry }”解析为{ $canonical }，其中包含“:”，ai-jail会将其解读为SOURCE:DEST。
+agent-jail-rw-map-forbidden = { $rule ->
+    [root] 可写文件夹“{ $entry }”（{ $canonical }）是根目录/。
+    [home] 可写文件夹“{ $entry }”（{ $canonical }）是主目录。
+    [above_home] 可写文件夹“{ $entry }”（{ $canonical }）包含主目录{ $path }。
+    [protected] 可写文件夹“{ $entry }”（{ $canonical }）即是受保护路径{ $path }、位于其中或包含它。
+    [link_target] 可写文件夹“{ $entry }”（{ $canonical }）即是{ $path }（受保护文件夹中符号链接{ $other }的目标）、位于其中或包含它。
+    [runtime_dir] 可写文件夹“{ $entry }”（{ $canonical }）即是运行时目录{ $path }（存放Zeo的devtools socket）、位于其中或包含它。
+   *[incomplete] 无法检查可写文件夹“{ $entry }”（{ $canonical }）：受保护文件夹{ $path }未能完整扫描符号链接（{ $stop }），因此所有文件夹均被拒绝。
+}
+agent-jail-rw-map-not-folder = 可写文件夹“{ $entry }”（{ $canonical }）不是文件夹。
+
+## A refused allowed host ($shape: scheme, path, port, wildcard, upper_case, malformed)
+
+agent-jail-host-empty = 有一个允许的主机条目为空。
+agent-jail-host-too-long = 允许的主机“{ $entry }”长{ $length }个字符；DNS名称最多{ $max }个字符。
+agent-jail-host-ip = 允许的主机“{ $entry }”是IP地址；只允许DNS名称。
+agent-jail-host-localhost = 允许的主机“{ $entry }”指向localhost；环回服务永远不能作为允许的主机。
+agent-jail-host-not-dns = { $shape ->
+    [scheme] 允许的主机“{ $entry }”带有协议；请只填写主机名。
+    [path] 允许的主机“{ $entry }”带有路径；请只填写主机名。
+    [port] 允许的主机“{ $entry }”带有端口；请只填写主机名。
+    [wildcard] 允许的主机“{ $entry }”是通配符；请逐一列出主机名。
+    [upper_case] 允许的主机“{ $entry }”包含大写字母；请使用小写。
+   *[malformed] 允许的主机“{ $entry }”不是DNS名称（需由两个或更多标签组成，标签由a-z、0-9和中间的“-”构成，末尾不带点）。
+}
+agent-jail-host-numeric-label = 允许的主机“{ $entry }”以数字标签结尾，会被解析为IP地址；只允许DNS名称。
+agent-jail-host-pattern-unavailable = 无法检查允许的主机“{ $entry }”：主机名模式不可用。
+agent-jail-limit-rw-maps = 第{ $number }个可写文件夹超出了每个项目{ $max }个可写文件夹的上限（已配置{ $count }个）。
+agent-jail-limit-hosts = 第{ $number }个允许的主机超出了每个项目{ $max }个允许主机的上限（已配置{ $count }个）。
+
+## Dialogs and notifications
+
+agent-jail-confirm-turn-off-project = 要关闭{ $name }的智能体sandbox吗？
+agent-jail-confirm-turn-off-default = 要为没有单独设置的项目关闭智能体sandbox吗？
+agent-jail-confirm-turn-off-detail = 智能体下次启动时将拥有你的用户的全部访问权限。
+agent-jail-confirm-forget = 要忘记{ $path }吗？
+agent-jail-confirm-forget-detail = ai-memory会删除该页面。此操作无法撤销。
+agent-jail-confirm-turn-on-project = 要为{ $name }开启智能体sandbox并重启智能体吗？
+agent-jail-confirm-turn-on-detail = 智能体将立即在jail中重启。thread会保留；正在进行的轮次会停止。
+agent-jail-button-cancel = 取消
+agent-jail-button-turn-off = 关闭
+agent-jail-button-forget = 忘记
+agent-jail-button-turn-on-restart = 开启并重启
+agent-jail-button-allow = 允许
+agent-jail-root-not-utf8 = 无法为路径不是有效UTF-8的项目配置智能体sandbox：{ $path }
+agent-jail-secret-prompt = 要在此项目的jail中允许“{ $server }”吗？
+    .detail = 其配置包含一个密钥（{ $places }）。Zeo绝不会将配置原样交给jail，因此密钥始终留在外部：智能体只能通过Zeo自己的副本（Claude Agent (Plus)）访问该服务器，无法这样做的智能体（TUI适配器）则无法使用它。智能体仍可使用该服务器的访问权限。
+
+## ai-memory
+
+agent-jail-memory-unreachable = 无法访问位于{ $endpoint }的ai-memory
+agent-jail-memory-timeout = 无法访问位于{ $endpoint }的ai-memory：{ $seconds }秒内无响应
+agent-jail-memory-unknown-project = 尚未为{ $scope }记录任何记忆。
+agent-jail-memory-malformed = ai-memory对{ $tool }返回了Zeo无法读取的响应
+
+## The MCP not-enabled notice in the thread
+
+agent-jail-notice-title = { $count ->
+   *[other] 有{ $count }个MCP服务器未在此项目的jail中启用
+}
+agent-jail-notice-not-chosen = 未选择：{ $names }。
+agent-jail-notice-secret-cannot-proxy = 包含密钥，密钥只能通过Zeo自己的副本到达jail，而此智能体无法使用该方式（MCP over ACP）：{ $names }。
+agent-jail-notice-secret-not-running = 包含密钥，密钥只能通过Zeo自己的副本到达jail，而该副本未在运行：{ $names }。
+agent-jail-notice-choose = 请在Agent Sandbox页面的“能力”下选择它们。
+agent-jail-notice-open = 打开“能力”
+
+## The thread's lock, its tooltip and the quick modal ($list: rw_maps, allow_hosts, forward_ports)
+
+agent-jail-status-title = Agent Sandbox
+agent-jail-status-on = 已在智能体sandbox（ai-jail）中启动。
+agent-jail-status-off = 未使用智能体sandbox启动。
+agent-jail-status-version = ai-jail版本：{ $version }
+agent-jail-status-version-unknown = 未知
+agent-jail-status-list = { $list ->
+    [rw_maps] 可写文件夹：{ $items }
+    [allow_hosts] 允许的主机：{ $items }
+   *[forward_ports] 转发的端口：{ $items }
+}
+agent-jail-status-list-none = 无
+agent-jail-status-remote = 智能体sandbox不适用于远程项目。
+agent-jail-status-own-command = 由其agent_servers命令置于sandbox中；不由Zeo管理。
+agent-jail-status-not-claude = 不是Claude智能体：智能体sandbox仅适用于Claude适配器。
+agent-jail-status-drifted = 重启智能体以应用新设置。
+agent-jail-status-pending-on = Sandbox已开启——重启智能体以应用。点击重启。
+agent-jail-status-pending-off = Sandbox已关闭——重启智能体以应用。点击重启。
+agent-jail-status-reserved-cpus = 预留的CPU：{ $cpus }
+agent-jail-status-cpus-shared = 与另一个jail共享CPU { $cpus }：启动时空闲的核心不足。
+    .label = 共享CPU
+agent-jail-status-ai-jail-missing = 智能体sandbox需要ai-jail，但它尚未安装。请安装sys-apps/ai-jail 3.5.0-r2或更高版本，然后新建一个thread以开启sandbox。
+agent-jail-pause = 暂停智能体：冻结jail；恢复后继续运行，不会丢失任何内容
+agent-jail-stop = 停止智能体：结束jail及其中运行的所有内容
+agent-jail-paused = 已暂停
+agent-jail-paused-disk = 已暂停：磁盘配额
+agent-jail-resume = 恢复
+    .operator = 让智能体从停止处继续
+    .disk = 让智能体继续；从现在起它可以再增长一个配额
+agent-jail-quick-hint = 开启前会先询问，然后在jail中重启智能体。
+agent-jail-quick-advanced = 高级…
diff --git a/crates/zeo_i18n/locales/zh-CN/agent-sandbox.ftl b/crates/zeo_i18n/locales/zh-CN/agent-sandbox.ftl
new file mode 100644
index 00000000..0d1516bd
--- /dev/null
+++ b/crates/zeo_i18n/locales/zh-CN/agent-sandbox.ftl
@@ -0,0 +1,172 @@
+### The Agent Sandbox (ai-jail) settings page, in Simplified Chinese (zh-CN).
+### Drafted with Lara Translate and revised; not reviewed by a native speaker.
+### Glossary: "jail", "sandbox" and "thread" stay in English; "agent" is 智能体.
+
+## Page: notices
+
+agent-sandbox-no-project = 请打开一个本地项目以进行配置。
+agent-sandbox-not-installed = 未安装ai-jail。请使用`emerge sys-apps/ai-jail`安装，或在`app-editors/zeo`上启用USE `ai-jail`。
+agent-sandbox-ai-jail-file = 此项目包含.ai-jail文件。ai-jail也会读取它，但只允许它收窄生成的jail，绝不允许放宽。
+agent-sandbox-preview-off = Sandbox已关闭：智能体在没有ai-jail的情况下启动。
+agent-sandbox-memory-endpoint-invalid = 没有端口转发到jail中：ai-memory端点不是有效的URL。
+agent-sandbox-memory-endpoint-remote = 没有为位于{ $host }的ai-memory向jail转发端口。请将{ $host }加入允许的主机，以便jail中的智能体访问它。
+agent-sandbox-restart-notice = 重启智能体以应用。
+agent-sandbox-restart-button = 重启智能体
+    .tooltip = 重启此项目中仍使用旧设置运行的智能体。正处于轮次中的thread会先询问。
+
+## Page: ai-jail binary
+
+agent-sandbox-binary-looking = 正在查找ai-jail…
+agent-sandbox-binary-not-found = 在{ $path }未找到（agent_sandbox.ai_jail_path）。
+agent-sandbox-binary-found = ai-jail { $version }，位于{ $path }
+agent-sandbox-binary-unreadable = 无法读取ai-jail的版本：{ $error }。
+
+## Page: this project
+
+agent-sandbox-this-project = 此项目
+agent-sandbox-project-enabled = 为此项目在ai-jail中运行智能体
+    .note = 在ai-jail中启动此项目的Claude智能体。关闭前会先询问。
+agent-sandbox-default-for-every-project = 所有项目的默认值
+agent-sandbox-set-for-this-project = 为此项目单独设置
+
+## Page: the two lists. $kind is rw_map or allow_host.
+
+agent-sandbox-rw-maps = 可写文件夹
+    .note = 除项目外，jail中的智能体还可以写入的文件夹，通过“选择文件夹”选取。每个文件夹都必须位于项目、Claude配置目录及其他所有可写文件夹之外。
+    .placeholder = 添加可写文件夹（例如~/data）…
+agent-sandbox-allow-hosts = 允许的主机
+    .note = jail中的智能体可以访问的主机。每项都是纯DNS名称：不带协议、端口、路径、通配符或IP地址。
+    .placeholder = 添加允许的主机（例如registry.npmjs.org）…
+agent-sandbox-list-add-to = 添加到{ $list }
+agent-sandbox-list-remove = 移除{ $entry }
+agent-sandbox-choose-folder = 选择文件夹…
+agent-sandbox-choose-folder-prompt = 添加可写文件夹
+agent-sandbox-entry-already-listed = { $kind ->
+    [rw_map] 可写文件夹“{ $raw }”已在列表中。
+   *[allow_host] 允许的主机“{ $raw }”已在列表中。
+}
+agent-sandbox-entry-is-claude-dir = 可写文件夹“{ $raw }”是Claude配置目录，jail总会映射该目录。
+agent-sandbox-entry-is-default = { $kind ->
+    [rw_map] 可写文件夹“{ $raw }”适用于所有项目；请从settings.json的agent_sandbox.{ $field }中移除它。
+   *[allow_host] 允许的主机“{ $raw }”适用于所有项目；请从settings.json的agent_sandbox.{ $field }中移除它。
+}
+agent-sandbox-entry-not-listed = { $kind ->
+    [rw_map] 可写文件夹“{ $raw }”不在此项目的列表中。
+   *[allow_host] 允许的主机“{ $raw }”不在此项目的列表中。
+}
+agent-sandbox-save-failed = 无法保存智能体sandbox设置：{ $error }
+
+## Page: limits. $field is memory, cpu_quota, max_tasks or disk_quota.
+
+agent-sandbox-limits = 资源限制
+    .note = 由ai-jail应用于整个jail。磁盘增长超出上限后，智能体会被暂停而不是停止。0表示对此项目关闭该限制。按住Shift步长更大，按住Alt步长更小；点击数值可直接输入。
+agent-sandbox-limit-title = { $field ->
+    [memory] 内存
+    [cpu_quota] CPU
+    [max_tasks] 进程
+   *[disk_quota] 磁盘增长
+}
+agent-sandbox-limit-reset = { $field ->
+    [memory] 使用默认内存
+    [cpu_quota] 使用默认CPU
+    [max_tasks] 使用默认进程数
+   *[disk_quota] 使用默认磁盘增长
+}
