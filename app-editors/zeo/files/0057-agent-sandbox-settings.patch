+// Story 043, task 5.1 — the turn-off and forget confirmations and the only two writers of the
+// switches (R4.1, R4.2, R4.3, R4.4, R6.4 text). Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod confirm_tests;
+//
+// Validation filter: `confirm` (every test path is `confirm_tests::…`).
+//
+// Contract (design.md §Confirmation). Assumed signatures — adjust the `use`/call only:
+//   - `crate::confirm::OffScope::{Project(String), Default}` (the project's display name)
+//   - `crate::confirm::confirm_turn_off(scope: OffScope, window: &mut Window, cx: &mut App) -> Task<bool>`
+//   - `crate::confirm::confirm_forget(path: &str, window: &mut Window, cx: &mut App) -> Task<bool>`
+//   - `crate::confirm::set_project_enabled(root: &Path, enabled: bool, window, cx) -> Task<_>`
+//   - `crate::confirm::set_default_enabled(enabled: bool, window, cx) -> Task<_>`
+//   Both setters write the user settings file through `update_settings_file` and the global
+//   `Fs`; the tests read that file back from `paths::settings_file()` on a FakeFs.
+//
+// Hostile halves first:
+//   - off without consent, wrongly WRITE: Cancel leaves the file byte-identical and the switch on.
+//   - consent, wrongly COLLAPSE scope: Turn Off for project A writes only A — not the default and
+//     not project B.
+//   - asking, wrongly ASK: turning on never prompts (R4.4); wrongly SKIP: turning off always does,
+//     for the default as well as for a project.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use fs::{FakeFs, Fs};
+use gpui::{TestAppContext, UpdateGlobal as _, VisualTestContext};
+use serde_json::{Value, json};
+use settings::{Settings as _, SettingsStore};
+
+use crate::AgentSandboxSettings;
+use crate::confirm::{
+    OffScope, confirm_forget, confirm_turn_off, set_default_enabled, set_project_enabled,
+};
+
+const DETAIL: &str = "The agent will run with your user's full access the next time it starts.";
+const ROOT: &str = "/w/app";
+const OTHER: &str = "/w/lib";
+
+async fn init(user: Value, cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        <dyn Fs>::set_global(fs.clone(), cx);
+        crate::init(cx);
+    });
+    fs.create_dir(paths::config_dir())
+        .await
+        .expect("the config dir");
+    fs.insert_file(paths::settings_file(), user.to_string().into_bytes())
+        .await;
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&user.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+    cx.run_until_parked();
+    fs
+}
+
+async fn file_text(fs: &Arc<FakeFs>) -> String {
+    fs.load(paths::settings_file())
+        .await
+        .expect("settings file")
+}
+
+async fn file_json(fs: &Arc<FakeFs>) -> Value {
+    serde_json_lenient::from_str(&file_text(fs).await).expect("settings JSON")
+}
+
+fn both_on() -> Value {
+    json!({ "agent_sandbox": { "enabled": true, "projects": {
+        ROOT: { "enabled": true }, OTHER: { "enabled": true }
+    } } })
+}
+
+fn window(cx: &mut TestAppContext) -> &mut VisualTestContext {
+    cx.add_empty_window()
+}
+
+// --- R4.3: Cancel writes nothing ------------------------------------------------------------------
+
+#[gpui::test]
+async fn confirm_cancel_leaves_the_file_and_the_switch(cx: &mut TestAppContext) {
+    let fs = init(both_on(), cx).await;
+    let before = file_text(&fs).await;
+    let cx = window(cx);
+    let task = cx.update(|window, cx| set_project_enabled(Path::new(ROOT), false, window, cx));
+    cx.run_until_parked();
+    assert!(cx.has_pending_prompt(), "turning off asks first");
+    cx.simulate_prompt_answer("Cancel");
+    let _ = task.await;
+    cx.run_until_parked();
+    assert_eq!(
+        file_text(&fs).await,
+        before,
+        "Cancel leaves the file byte-identical"
+    );
+    assert!(
+        cx.update(|_, cx| AgentSandboxSettings::get_global(cx).effective_enabled(Path::new(ROOT)))
+    );
+}
+
+#[gpui::test]
+async fn confirm_cancel_on_the_default_writes_nothing(cx: &mut TestAppContext) {
+    let fs = init(both_on(), cx).await;
+    let before = file_text(&fs).await;
+    let cx = window(cx);
+    let task = cx.update(|window, cx| set_default_enabled(false, window, cx));
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Cancel");
+    let _ = task.await;
+    cx.run_until_parked();
+    assert_eq!(file_text(&fs).await, before);
+}
+
+// --- R4.1/R4.2: the texts and Turn Off ------------------------------------------------------------
+
+#[gpui::test]
+async fn confirm_turn_off_writes_only_that_project(cx: &mut TestAppContext) {
+    let fs = init(both_on(), cx).await;
+    let cx = window(cx);
+    let task = cx.update(|window, cx| set_project_enabled(Path::new(ROOT), false, window, cx));
+    cx.run_until_parked();
+    let (message, detail) = cx.pending_prompt().expect("a prompt");
+    assert!(
+        message.starts_with("Turn off the agent sandbox for ") && message.ends_with('?'),
+        "{message}"
+    );
+    assert!(message.contains("app"), "names the project: {message}");
+    assert_eq!(detail, DETAIL);
+    cx.simulate_prompt_answer("Turn Off");
+    let _ = task.await;
+    cx.run_until_parked();
+    let written = file_json(&fs).await;
+    assert_eq!(
+        written["agent_sandbox"]["projects"][ROOT]["enabled"],
+        json!(false)
+    );
+    assert_eq!(
+        written["agent_sandbox"]["projects"][OTHER]["enabled"],
+        json!(true),
+        "project B untouched"
+    );
+    assert_eq!(
+        written["agent_sandbox"]["enabled"],
+        json!(true),
+        "the default untouched"
+    );
+}
+
+#[gpui::test]
+async fn confirm_default_off_names_projects_without_their_own_setting(cx: &mut TestAppContext) {
+    let fs = init(both_on(), cx).await;
+    let cx = window(cx);
+    let task = cx.update(|window, cx| set_default_enabled(false, window, cx));
+    cx.run_until_parked();
+    let (message, detail) = cx.pending_prompt().expect("a prompt");
+    assert_eq!(
+        message,
+        "Turn off the agent sandbox for projects without their own setting?"
+    );
+    assert_eq!(detail, DETAIL);
+    cx.simulate_prompt_answer("Turn Off");
+    let _ = task.await;
+    cx.run_until_parked();
+    let written = file_json(&fs).await;
+    assert_eq!(written["agent_sandbox"]["enabled"], json!(false));
+    assert_eq!(
+        written["agent_sandbox"]["projects"][ROOT]["enabled"],
+        json!(true)
+    );
+}
+
+// --- R4.4: on never asks ----------------------------------------------------------------------------
+
+#[gpui::test]
+async fn confirm_turning_on_saves_without_asking(cx: &mut TestAppContext) {
+    let fs = init(json!({ "agent_sandbox": { "enabled": false } }), cx).await;
+    let cx = window(cx);
+    let task = cx.update(|window, cx| set_project_enabled(Path::new(ROOT), true, window, cx));
+    cx.run_until_parked();
+    assert!(!cx.has_pending_prompt(), "turning on never asks");
+    let _ = task.await;
+    cx.run_until_parked();
+    assert_eq!(
+        file_json(&fs).await["agent_sandbox"]["projects"][ROOT]["enabled"],
+        json!(true)
+    );
+
+    let task = cx.update(|window, cx| set_default_enabled(true, window, cx));
+    cx.run_until_parked();
+    assert!(!cx.has_pending_prompt());
+    let _ = task.await;
+    cx.run_until_parked();
+    assert_eq!(
+        file_json(&fs).await["agent_sandbox"]["enabled"],
+        json!(true)
+    );
+}
+
+// --- the prompt helpers themselves ----------------------------------------------------------------
+
+#[gpui::test]
+async fn confirm_turn_off_is_true_only_for_turn_off(cx: &mut TestAppContext) {
+    init(both_on(), cx).await;
+    let cx = window(cx);
+    for (button, expected) in [("Cancel", false), ("Turn Off", true)] {
+        let task =
+            cx.update(|window, cx| confirm_turn_off(OffScope::Project("app".into()), window, cx));
+        cx.run_until_parked();
+        cx.simulate_prompt_answer(button);
+        assert_eq!(task.await, expected, "{button}");
+    }
+}
+
+#[gpui::test]
+async fn confirm_forget_text_and_answers(cx: &mut TestAppContext) {
+    init(both_on(), cx).await;
+    let cx = window(cx);
+    for (button, expected) in [("Cancel", false), ("Forget", true)] {
+        let task = cx.update(|window, cx| confirm_forget("gotchas/fs.md", window, cx));
+        cx.run_until_parked();
+        let (message, detail) = cx.pending_prompt().expect("a prompt");
+        assert_eq!(message, "Forget gotchas/fs.md?");
+        assert_eq!(detail, "ai-memory deletes the page. This cannot be undone.");
+        cx.simulate_prompt_answer(button);
+        assert_eq!(task.await, expected, "{button}");
+    }
+}
