+// Story 043, task 2.4 — the real ai-jail accepts the generated argv and enforces the boundary
+// (R1.2, R1.4, R1.5, R2.7, R2.11, R7.1, R7.4; Q12). Integration test of crate `agent_sandbox`
+// (`crates/agent_sandbox/tests/real_ai_jail.rs`).
+//
+// Validation:
+//   AI_JAIL_BIN=/usr/bin/ai-jail cargo test -p agent_sandbox --test real_ai_jail -- --nocapture
+//   AI_JAIL_BIN=/home/otaku/Projetos/Pessoais/zed/ai-jail/fork/target/release/ai-jail \
+//     cargo test -p agent_sandbox --test real_ai_jail -- --nocapture
+// Without `AI_JAIL_BIN` every test prints why it skipped and passes (the binary is a machine
+// fact, not a build fact).
+//
+// Contract (design.md §agent_sandbox::command): the public `agent_sandbox::command::{generate,
+// JailInputs}`, `agent_sandbox::probe::probe` and `project::agent_server_store::AgentServerCommand`.
+// The "agent" is `sh -c …`, so the jail's view is probed by the process the agent would be.
+//
+// Hostile halves first:
+//   - the boundary, wrongly OPEN: writes into `.git` and `.zed` fail, Zeo's settings file and the
+//     devtools bridge socket are not visible, the env value is not on argv; wrongly CLOSED: the
+//     project itself, a configured `--rw-map` and the Claude dir are writable and the writes
+//     persist on the host; the forwarded loopback port answers; the env value arrives by name; an
+//     ai-jail without `--forward-port` gets none and still starts.
+//
+// Every real (non `--dry-run`) run happens inside a tempdir project, with a tempdir Claude dir and
+// a throwaway env value.
+
+use std::io::{Read as _, Write as _};
+use std::net::TcpListener;
+use std::os::unix::fs::FileTypeExt as _;
+use std::os::unix::net::UnixListener;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use agent_sandbox::command::{
+    JailInputs, NO_PROXY_CARRIER, generate, keep_loopback_off_proxy, loopback_no_proxy,
+};
+use agent_sandbox::probe::{self, JailBinary};
+use collections::HashMap;
+use gpui::TestAppContext;
+use project::agent_server_store::AgentServerCommand;
+
+const SECRET: &str = "env-value-043-must-not-be-on-argv";
+
+/// ai-memory's default endpoint port, the one R7.1 forwards.
+const MEMORY_PORT: u16 = 49374;
+
+fn ai_jail() -> Option<PathBuf> {
+    match std::env::var_os("AI_JAIL_BIN") {
+        Some(path) => Some(PathBuf::from(path)),
+        None => {
+            eprintln!("skipped: AI_JAIL_BIN is not set (point it at an ai-jail >= 2.4.0)");
+            None
+        }
+    }
+}
