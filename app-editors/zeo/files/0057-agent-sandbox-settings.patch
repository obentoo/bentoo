+// --- authored at Run (3.1): review findings and v2 rules, Red first --------------------------------
+
+/// A launch for `agent` with `configured` as the names the agent's settings configure.
+async fn run_with(
+    agent: &str,
+    project: &Entity<Project>,
+    cmd: AgentServerCommand,
+    configured: &[&str],
+    cx: &mut TestAppContext,
+) -> LaunchDecision {
+    let mut async_cx = cx.to_async();
+    let configured: std::collections::HashSet<String> =
+        configured.iter().map(|name| name.to_string()).collect();
+    decide(
+        AgentId::new(agent),
+        project,
+        cmd,
+        &configured,
+        &mut async_cx,
+    )
+    .await
+}
+
+/// The refusal's text and its cause token.
+fn refusal(decision: LaunchDecision) -> (String, &'static str) {
+    match decision {
+        LaunchDecision::Refused(error) => {
+            let text = format!("{error:#}");
+            assert!(
+                text.trim_end()
+                    .ends_with("The agent was not started without the sandbox."),
+                "every refusal ends with the fail-closed sentence: {text}"
+            );
+            (text, error.cause.as_str())
+        }
+        LaunchDecision::Jailed(_, cmd) => panic!("expected Refused, got Jailed {:?}", cmd.args),
+        LaunchDecision::Unchanged(record) => {
+            panic!("expected Refused, got Unchanged {:?}", record.reason)
+        }
+    }
+}
+
+fn plain_cmd(path: &str, args: &[&str]) -> AgentServerCommand {
+    AgentServerCommand {
+        path: PathBuf::from(path),
+        args: args.iter().map(|arg| arg.to_string()).collect(),
+        env: None,
+    }
+}
+
+mod run_additions {
+    use super::*;
+    use crate::launch::{
+        LaunchCause, LaunchEnv, LaunchRegistry, MemoryPort, check_root, decide_in,
+    };
+    use crate::validate::ProtectedSet;
+
+    /// A home of its own under the fixture: `.config/zeo`, `.ssh`, `.claude-jailed`, `src/app`.
+    fn fake_home(f: &Fixture) -> PathBuf {
+        let home = f.base.join("home");
+        for dir in [".config/zeo", ".ssh", ".claude-jailed", "src/app/.git"] {
+            std::fs::create_dir_all(home.join(dir)).expect("home layout");
+        }
+        home
+    }
+
+    fn home_env(home: &Path) -> LaunchEnv {
+        LaunchEnv {
+            home: home.to_path_buf(),
+            config_dir: home.join(".config/zeo"),
+            runtime_dir: None,
+        }
+    }
+
+    fn home_settings(f: &Fixture, claude_dir: &str) -> Value {
+        json!({
+            "agent_sandbox": {
+                "enabled": true,
+                "ai_jail_path": f.ai_jail,
+                "claude_config_dir": claude_dir,
+                "rw_maps": [],
+                "allow_hosts": ["anthropic.com"],
+                "projects": {},
+            },
+            "agent_memory": memory_off(),
+        })
+    }
+
+    async fn project_at(root: &Path, cx: &mut TestAppContext) -> Entity<Project> {
+        let fs = RealFs::new(None, cx.executor());
+        let project = Project::test(fs, [root], cx).await;
