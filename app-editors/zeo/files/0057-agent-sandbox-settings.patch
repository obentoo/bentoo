@@ -0,0 +1,1672 @@
+//! The "Agent Sandbox (ai-jail)" sub-page (R3, R4, R7.3): the jail switches, the writable folders
+//! and allowed hosts of the active local project, the ai-jail binary, and the generated command.
+//! Below them, and alone on the "Agent Memory (ai-memory)" sub-page, the Memory section (R6).
+//!
+//! The switches are written by `agent_sandbox::confirm` only, which asks before turning the jail
+//! off. The lists are written here, without asking (R4.4), after the checks a start would make.
+
+use std::cell::Cell;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::sync::{Arc, OnceLock};
+
+use agent_sandbox::command::{self, JailInputs};
+use agent_sandbox::confirm::{self, non_utf8_root_message, target_project_key};
+use agent_sandbox::launch::{self, MEMORY_PORT_UNSUPPORTED, MemoryPort};
+use agent_sandbox::memory::{
+    self, MemoryClient, MemoryScope, MemoryStatus, RecentPage, ResolvedBy, display_endpoint,
+};
+use agent_sandbox::probe::{self, JailBinary};
+use agent_sandbox::validate::{self, ProtectedSet, expand_tilde};
+use agent_sandbox::{
+    AgentMemorySettings, AgentSandboxSettings, LaunchRegistry, ProjectPolicy, lexical_match,
+    resolve_project_key,
+};
+use collections::HashMap;
+use fs::Fs;
+use futures::channel::oneshot;
+use gpui::{
+    AsyncApp, BackgroundExecutor, Bounds, ClipboardItem, Entity, FocusHandle, Pixels, ScrollHandle,
+    Subscription, Task, WeakEntity, point,
+};
+use project::agent_server_store::AgentServerCommand;
+use semver::Version;
+use settings::{AgentSandboxProjectSettingsContent, Settings as _, SettingsStore};
+use ui::{Banner, Divider, Severity, SwitchField, ToggleState, Tooltip, prelude::*};
+use util::ResultExt as _;
+
+use crate::SettingsWindow;
+use crate::components::{SettingsInputField, SettingsSectionHeader};
+
+const NO_PROJECT_NOTICE: &str = "Open a local project to configure it.";
+const NOT_INSTALLED: &str = "ai-jail is not installed. Install it with `emerge sys-apps/ai-jail`, or enable USE `ai-jail` on `app-editors/zeo`.";
+const AI_JAIL_FILE_NOTICE: &str = "This project has an .ai-jail file. ai-jail reads it too, and lets it only narrow the generated jail, never widen it.";
+const PREVIEW_OFF: &str = "Sandbox off: the agent starts without ai-jail.";
+const INVALID_ENDPOINT_NOTE: &str =
+    "No port is forwarded into the jail: the ai-memory endpoint is not a valid URL.";
+const RESTART_NOTICE: &str = "Restart the agent to apply.";
+/// The adapter the preview wraps; a start wraps whichever Claude adapter the agent runs.
+const PREVIEW_AGENT: &str = "claude-agent-acp-plus";
+
+/// One of the two editable lists of a project.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum EntryKind {
+    RwMap,
+    AllowHost,
+}
+
+impl EntryKind {
+    fn noun(self) -> &'static str {
+        match self {
+            Self::RwMap => "Writable folder",
+            Self::AllowHost => "Allowed host",
+        }
+    }
+
+    fn field(self) -> &'static str {
+        match self {
+            Self::RwMap => "rw_maps",
+            Self::AllowHost => "allow_hosts",
+        }
+    }
+
+    fn id(self) -> &'static str {
+        match self {
+            Self::RwMap => "rw-map",
+            Self::AllowHost => "allow-host",
+        }
+    }
+
+    fn list(self, entry: &agent_sandbox::AgentSandboxProjectSettings) -> &[String] {
+        match self {
+            Self::RwMap => &entry.rw_maps,
+            Self::AllowHost => &entry.allow_hosts,
+        }
+    }
+
+    fn defaults(self, sandbox: &AgentSandboxSettings) -> &[String] {
+        match self {
+            Self::RwMap => &sandbox.rw_maps,
+            Self::AllowHost => &sandbox.allow_hosts,
+        }
+    }
+
+    fn list_mut(self, entry: &mut AgentSandboxProjectSettingsContent) -> &mut Vec<String> {
+        match self {
+            Self::RwMap => entry.rw_maps.get_or_insert_default(),
+            Self::AllowHost => entry.allow_hosts.get_or_insert_default(),
+        }
+    }
+}
+
+/// Where the protected folders are, for a writable folder's checks. Tests substitute a home.
+pub(crate) struct EntryEnv {
+    pub home: PathBuf,
+    pub config_dir: PathBuf,
+}
+
+impl EntryEnv {
+    fn from_process() -> Self {
+        Self {
+            home: paths::home_dir().clone(),
+            config_dir: paths::config_dir().clone(),
+        }
+    }
+}
+
+/// The R3.6 banner when ai-jail was not found (`None`), the R3.5 warning when it is older than
+/// 2.4.0, and nothing for a safe version.
+pub(crate) fn banner_text(installed: Option<&Version>) -> Option<String> {
+    match installed {
+        None => Some(NOT_INSTALLED.to_string()),
+        Some(version) if probe::is_outdated(version) => Some(probe::outdated_warning(version)),
+        Some(_) => None,
+    }
+}
+
+/// The R3.3 text when no local project is active.
+pub(crate) fn project_notice(root: Option<&Path>) -> Option<&'static str> {
+    root.is_none().then_some(NO_PROJECT_NOTICE)
+}
+
+/// The R3.9 notice, only when `root/.ai-jail` is a file: a folder of that name is not what
+/// ai-jail reads.
+pub(crate) async fn ai_jail_file_notice(fs: &dyn Fs, root: &Path) -> Option<&'static str> {
+    let path = root.join(".ai-jail");
+    match fs.metadata(&path).await {
+        Ok(Some(metadata)) if !metadata.is_dir => Some(AI_JAIL_FILE_NOTICE),
+        Ok(_) => None,
+        Err(error) => {
+            log::warn!(
+                "agent_sandbox event=ai_jail_file_check_failed path={:?} error={:?}",
+                path.to_string_lossy(),
+                first_line(&error)
+            );
+            None
+        }
+    }
+}
+
+/// The R3.10 sentence, only when memory is on, the endpoint is loopback and this ai-jail has no
+/// `--forward-port`: the same decision a start makes (R7.4).
+pub(crate) fn forward_port_notice(
+    memory: &AgentMemorySettings,
+    supports_forward_port: bool,
+) -> Option<&'static str> {
+    matches!(
+        launch::memory_port(memory, supports_forward_port),
+        Ok(MemoryPort::Unsupported)
+    )
+    .then_some(MEMORY_PORT_UNSUPPORTED)
+}
+
+/// The R7.3 note while memory is on and the endpoint is not loopback. It names the host only:
+/// the endpoint may carry a token in its userinfo or query, and an unparsable one is never shown.
+pub(crate) fn memory_endpoint_note(memory: &AgentMemorySettings) -> Option<String> {
+    match launch::memory_port(memory, true) {
+        Ok(MemoryPort::NonLoopback) => {
+            let host = url::Url::parse(&memory.endpoint)
+                .ok()
+                .and_then(|endpoint| endpoint.host_str().map(str::to_string));
+            Some(match host {
+                Some(host) => format!(
+                    "No port is forwarded into the jail for ai-memory at {host}. Add {host} to the allowed hosts for the jailed agent to reach it."
+                ),
+                None => INVALID_ENDPOINT_NOTE.to_string(),
+            })
+        }
+        Ok(MemoryPort::Forwarded(_) | MemoryPort::Unsupported | MemoryPort::Off) => None,
+        Err(_) => Some(INVALID_ENDPOINT_NOTE.to_string()),
+    }
+}
+
+/// What the command block says instead of a command while the sandbox is off for the project.
+pub(crate) fn preview_off_notice(enabled: bool) -> Option<&'static str> {
+    (!enabled).then_some(PREVIEW_OFF)
+}
+
+/// The `projects` key the page shows for `root`: the lexical match, else `resolved` (the key the
+/// background resolution found through a symlink) while the settings still hold it. Reads no
+/// file system.
+pub(crate) fn page_key<'a>(
+    sandbox: &'a AgentSandboxSettings,
+    root: &Path,
+    resolved: Option<&str>,
+) -> Option<&'a str> {
+    lexical_match(sandbox.project_keys(), root).or_else(|| {
+        resolved
+            .and_then(|key| sandbox.projects.get_key_value(key))
+            .map(|(key, _)| key.as_str())
+    })
+}
+
+/// The command a jailed start of the project would run, from [`command::generate`]. Reads no file
+/// system: folders are shown as written with `~` expanded, while a start canonicalizes them.
+/// `--forward-port` appears only when [`launch::memory_port`] forwards one, and then the agent runs
+/// through [`command::keep_loopback_off_proxy`]'s `/bin/sh`, as a start runs it (R7.1).
+pub(crate) fn preview_command(
+    policy: &ProjectPolicy,
+    root: &Path,
+    claude_config_dir: &str,
+    ai_jail: Option<&Path>,
+    memory: &AgentMemorySettings,
+    supports_forward_port: bool,
+) -> String {
+    let home = paths::home_dir();
+    let claude_dir = expand_tilde(claude_config_dir, home);
+    let mut rw_maps: Vec<PathBuf> = Vec::with_capacity(policy.rw_maps.len());
+    for raw in &policy.rw_maps {
+        let map = expand_tilde(raw, home);
+        if map != claude_dir && !rw_maps.contains(&map) {
+            rw_maps.push(map);
+        }
+    }
+    let forward_ports = match launch::memory_port(memory, supports_forward_port) {
+        Ok(MemoryPort::Forwarded(port)) => vec![port],
+        Ok(MemoryPort::Unsupported | MemoryPort::Off | MemoryPort::NonLoopback) | Err(_) => {
+            Vec::new()
+        }
+    };
+    let inputs = JailInputs {
+        ai_jail: ai_jail.unwrap_or(Path::new("ai-jail")),
+        project_root: root,
+        claude_dir: &claude_dir,
+        rw_maps: &rw_maps,
+        allow_hosts: &policy.allow_hosts,
+        forward_ports: &forward_ports,
+        env_names: Vec::new(),
+    };
+    let agent = AgentServerCommand {
+        path: PathBuf::from(PREVIEW_AGENT),
+        args: Vec::new(),
+        env: None,
+    };
+    let jailed = command::generate(agent, &inputs);
+    if forward_ports.is_empty() {
+        command::preview(&jailed)
+    } else {
+        command::preview(&command::keep_loopback_off_proxy(jailed))
+    }
+}
+
+/// Adds `raw` to the project's list after the checks a start makes (R2.4–R2.6 and the nesting
+/// rule), without asking (R4.4). On a refusal the rule text is returned and nothing is written.
+pub(crate) fn add_entry(
+    kind: EntryKind,
+    root: &Path,
+    raw: &str,
+    cx: &mut App,
+) -> Task<Result<(), String>> {
+    add_entry_in(kind, root, raw, EntryEnv::from_process(), cx)
+}
+
+pub(crate) fn add_entry_in(
+    kind: EntryKind,
+    root: &Path,
+    raw: &str,
+    env: EntryEnv,
+    cx: &mut App,
+) -> Task<Result<(), String>> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        return Task::ready(Err(non_utf8_root_message(root)));
+    };
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let check = cx.background_spawn({
+        let root = root.to_path_buf();
+        let raw = raw.to_string();
+        async move { check_new_entry(kind, &root, &raw, &sandbox, &env) }
+    });
+    let raw = raw.to_string();
+    cx.spawn(async move |cx| {
+        let resolved = check.await?;
+        write_list(kind, root_text, resolved, ListEdit::Add(raw), cx).await
+    })
+}
+
+/// Removes `raw` from the project's own list, without asking (R4.4). The project's entry stays,
+/// `enabled` with it; an emptied list is written as `[]`.
+pub(crate) fn remove_entry(
+    kind: EntryKind,
+    root: &Path,
+    raw: &str,
+    cx: &mut App,
+) -> Task<Result<(), String>> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        return Task::ready(Err(non_utf8_root_message(root)));
+    };
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let check = cx.background_spawn({
+        let root = root.to_path_buf();
+        let raw = raw.to_string();
+        async move { check_removal(kind, &root, &raw, &sandbox) }
+    });
+    let raw = raw.to_string();
+    cx.spawn(async move |cx| {
+        let resolved = check.await?;
+        write_list(kind, root_text, Some(resolved), ListEdit::Remove(raw), cx).await
+    })
+}
+
+/// The checks of an added entry, in a start's order. Blocking: it canonicalizes paths and scans
+/// the protected folders. Returns the `projects` key `root` resolves to.
+fn check_new_entry(
+    kind: EntryKind,
+    root: &Path,
+    raw: &str,
+    sandbox: &AgentSandboxSettings,
+    env: &EntryEnv,
+) -> Result<Option<String>, String> {
+    let resolved = resolve_project_key(sandbox.project_keys(), root).map(str::to_string);
+    let policy = sandbox.policy_for_key(resolved.as_deref());
+    let already_listed = || format!("{} \"{raw}\" is already in the list.", kind.noun());
+    match kind {
+        EntryKind::AllowHost => {
+            let host = validate::validate_host(raw).map_err(|error| error.to_string())?;
+            validate::check_limits(0, policy.allow_hosts.len() + 1)
+                .map_err(|error| error.to_string())?;
+            if policy.allow_hosts.contains(&host) {
+                return Err(already_listed());
+            }
+        }
+        EntryKind::RwMap => {
+            let set = ProtectedSet::from_env(&env.home, &env.config_dir);
+            let map =
+                validate::validate_rw_map_with(raw, &set).map_err(|error| error.to_string())?;
+            // An invalid Claude dir refuses every start anyway; its spelled path still nests.
+            let claude_dir = validate::validate_rw_map_with(&sandbox.claude_config_dir, &set)
+                .unwrap_or_else(|_| expand_tilde(&sandbox.claude_config_dir, &env.home));
+            let mut maps: Vec<PathBuf> = Vec::with_capacity(policy.rw_maps.len() + 1);
+            for existing in &policy.rw_maps {
+                if existing == raw {
+                    return Err(already_listed());
+                }
+                if let Ok(existing) = validate::validate_rw_map_with(existing, &set)
+                    && existing != claude_dir
+                    && !maps.contains(&existing)
+                {
+                    maps.push(existing);
+                }
+            }
+            if map == claude_dir {
+                return Err(format!(
+                    "Writable folder \"{raw}\" is the Claude config directory, which the jail always maps."
+                ));
+            }
+            if maps.contains(&map) {
+                return Err(already_listed());
+            }
+            maps.push(map);
+            validate::check_limits(maps.len(), 0).map_err(|error| error.to_string())?;
+            let canonical_root = root.canonicalize().unwrap_or_else(|_| root.to_path_buf());
+            launch::check_nesting(&canonical_root, &claude_dir, &maps)
+                .map_err(|error| error.to_string())?;
+        }
+    }
+    Ok(resolved)
+}
+
+/// A removal names an entry of the project's own list; a default is edited in settings.json.
+/// Blocking. Returns the `projects` key holding the entry.
+fn check_removal(
+    kind: EntryKind,
+    root: &Path,
+    raw: &str,
+    sandbox: &AgentSandboxSettings,
+) -> Result<String, String> {
+    let resolved = resolve_project_key(sandbox.project_keys(), root);
+    if let Some(key) = resolved
+        && sandbox
+            .projects
+            .get(key)
+            .is_some_and(|entry| kind.list(entry).iter().any(|entry| entry == raw))
+    {
+        return Ok(key.to_string());
+    }
+    if kind.defaults(sandbox).iter().any(|entry| entry == raw) {
+        return Err(format!(
+            "{} \"{raw}\" applies to every project; remove it from agent_sandbox.{} in settings.json.",
+            kind.noun(),
+            kind.field()
+        ));
+    }
+    Err(format!(
+        "{} \"{raw}\" is not in this project's list.",
+        kind.noun()
+    ))
+}
+
+enum ListEdit {
+    Add(String),
+    Remove(String),
+}
+
+/// Writes one list of the project's entry and nothing else: the key is chosen with
+/// [`confirm::target_project_key`], as the switch writer does, so an edit through a symlinked
+/// root never adds a second key without `enabled`.
+async fn write_list(
+    kind: EntryKind,
+    root_text: String,
+    resolved: Option<String>,
+    edit: ListEdit,
+    cx: &mut AsyncApp,
+) -> Result<(), String> {
+    let written_key = Arc::new(OnceLock::new());
+    let receiver = cx.update(|cx| {
+        let written_key = written_key.clone();
+        cx.global::<SettingsStore>()
+            .update_settings_file_with_completion(<dyn Fs>::global(cx), move |content, _| {
+                let projects = content
+                    .agent_sandbox
+                    .get_or_insert_default()
+                    .projects
+                    .get_or_insert_default();
+                let key = target_project_key(
+                    projects.keys(),
+                    &root_text,
+                    resolved.as_deref().map(Path::new),
+                );
+                written_key
+                    .set(format!("agent_sandbox.projects[{key}].{}", kind.field()))
+                    .ok();
+                match edit {
+                    ListEdit::Add(raw) => {
+                        let list = kind.list_mut(projects.entry(key).or_default());
+                        if !list.contains(&raw) {
+                            list.push(raw);
+                        }
+                    }
+                    ListEdit::Remove(raw) => {
+                        if let Some(entry) = projects.get_mut(&key) {
+                            kind.list_mut(entry).retain(|entry| *entry != raw);
+                        }
+                    }
+                }
+            })
+    });
+    let error = match receiver.await {
+        Ok(Ok(())) => return Ok(()),
+        Ok(Err(error)) => error,
+        Err(oneshot::Canceled) => anyhow::anyhow!("the settings writer stopped before saving"),
+    };
+    let key = written_key
+        .get()
+        .cloned()
+        .unwrap_or_else(|| format!("agent_sandbox.projects.{}", kind.field()));
+    let error = first_line(&error);
+    log::error!("agent_sandbox event=settings_write_failed key={key:?} error={error:?}");
+    Err(format!("Could not save the agent sandbox setting: {error}"))
+}
+
+fn first_line(error: &anyhow::Error) -> String {
+    format!("{error:#}")
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .to_string()
+}
+
+/// The page's Tab stops, each wrapped so that the page scrolls it into view when it takes focus.
+/// On a settings sub-page Tab only calls `focus_next`, and an `overflow_y_scroll` container does not
+/// follow focus, so without this every control below the fold is focused out of sight (Q16).
+#[derive(Default)]
+struct RevealOnFocus {
+    controls: HashMap<SharedString, RevealedControl>,
+}
+
+#[derive(Clone)]
+struct RevealedControl {
+    /// Never a tab stop: it only tells whether focus is inside the wrapped control.
+    focus_handle: FocusHandle,
+    /// Set once the control was scrolled into view for its current focus, so that scrolling
+    /// away with the wheel while it keeps focus is not undone on the next frame.
+    revealed: Rc<Cell<bool>>,
+}
+
+impl RevealOnFocus {
+    fn wrap(
+        &mut self,
+        key: impl Into<SharedString>,
+        scroll_handle: &ScrollHandle,
+        control: impl IntoElement,
+        cx: &mut App,
+    ) -> AnyElement {
+        let key = key.into();
+        let RevealedControl {
+            focus_handle,
+            revealed,
+        } = self
+            .controls
+            .entry(key.clone())
+            .or_insert_with(|| RevealedControl {
+                focus_handle: cx.focus_handle().tab_stop(false),
+                revealed: Rc::default(),
+            })
+            .clone();
+        let scroll_handle = scroll_handle.clone();
+        div()
+            .track_focus(&focus_handle)
+            .debug_selector({
+                let key = key.clone();
+                move || key.to_string()
+            })
+            .child(control)
+            .on_children_prepainted(move |bounds, window, cx| {
+                let focused = focus_handle.contains_focused(window, cx);
+                #[cfg(test)]
+                record_focused_control(&key, focused);
+                if !focused {
+                    revealed.set(false);
+                    return;
+                }
+                if revealed.replace(true) {
+                    return;
+                }
+                if let Some(bounds) = bounds.first()
+                    && scroll_into_view(&scroll_handle, *bounds)
+                {
+                    window.request_animation_frame();
+                }
+            })
+            .into_any_element()
+    }
+}
+
+/// Scrolls `scroll_handle` the least that brings `control` inside its viewport, or to the
+/// control's top when it is taller than the viewport. Returns whether the offset changed.
+fn scroll_into_view(scroll_handle: &ScrollHandle, control: Bounds<Pixels>) -> bool {
+    let viewport = scroll_handle.bounds();
+    if viewport.size.height <= Pixels::ZERO {
+        return false;
+    }
+    // The offset is negative once scrolled down: a control below the viewport needs a lower one.
+    let delta = if control.top() < viewport.top() {
+        viewport.top() - control.top()
+    } else if control.bottom() > viewport.bottom() {
+        (viewport.bottom() - control.bottom()).max(viewport.top() - control.top())
+    } else {
+        return false;
+    };
+    let offset = scroll_handle.offset();
+    let y = (offset.y + delta).clamp(-scroll_handle.max_offset().y, Pixels::ZERO);
+    if y == offset.y {
+        return false;
+    }
+    scroll_handle.set_offset(point(offset.x, y));
+    true
+}
+
+#[cfg(test)]
+thread_local! {
+    static FOCUSED_CONTROL: std::cell::RefCell<Option<SharedString>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+#[cfg(test)]
+fn record_focused_control(key: &SharedString, focused: bool) {
+    FOCUSED_CONTROL.with_borrow_mut(|current| {
+        if focused {
+            *current = Some(key.clone());
+        } else if current.as_ref() == Some(key) {
+            *current = None;
+        }
+    });
+}
+
+/// The wrapped control that held focus at the last frame, by its key: the tests' only view of
+/// which element GPUI focused, since an element's own focus handle is internal to it.
+#[cfg(test)]
+pub(crate) fn focused_control() -> Option<SharedString> {
+    FOCUSED_CONTROL.with_borrow(Clone::clone)
+}
+
+/// What the background probe found.
+#[derive(Clone)]
+enum JailProbe {
+    Pending,
+    Missing { configured: Option<PathBuf> },
+    Found { path: PathBuf, binary: JailBinary },
+    Unreadable { path: PathBuf, error: String },
+}
+
+/// Locates and probes ai-jail as a start does.
+async fn probe_jail(configured: Option<PathBuf>, executor: BackgroundExecutor) -> JailProbe {
+    let path = match probe::locate(configured.as_deref()) {
+        Some(path) if path.is_file() => path,
+        located => {
+            return JailProbe::Missing {
+                configured: located.filter(|_| configured.is_some()),
+            };
+        }
+    };
+    match probe::probe(&path, &executor).await {
+        Ok(binary) => JailProbe::Found { path, binary },
+        Err(error) => JailProbe::Unreadable {
+            path,
+            error: error.to_string(),
+        },
+    }
+}
+
+/// Everything the page reads from disk, refreshed in the background whenever the settings change,
+/// so rendering does no I/O.
+struct JailPageState {
+    root: Option<PathBuf>,
+    jail: JailProbe,
+    /// The `projects` key the root resolves to through a symlink, once resolved.
+    resolved_key: Option<String>,
+    ai_jail_file: Option<&'static str>,
+    rw_map_error: Option<String>,
+    host_error: Option<String>,
+    controls: RevealOnFocus,
+    refresh_task: Task<()>,
+    _settings_subscription: Subscription,
+}
+
+impl JailPageState {
+    fn new(root: Option<PathBuf>, cx: &mut Context<Self>) -> Self {
+        let settings_subscription = cx.observe_global::<SettingsStore>(|this, cx| this.refresh(cx));
+        let mut this = Self {
+            root,
+            jail: JailProbe::Pending,
+            resolved_key: None,
+            ai_jail_file: None,
+            rw_map_error: None,
+            host_error: None,
+            controls: RevealOnFocus::default(),
+            refresh_task: Task::ready(()),
+            _settings_subscription: settings_subscription,
+        };
+        this.refresh(cx);
+        this
+    }
+
+    fn refresh(&mut self, cx: &mut Context<Self>) {
+        let sandbox = AgentSandboxSettings::get_global(cx).clone();
+        let root = self.root.clone();
+        let fs = <dyn Fs>::global(cx);
+        let executor = cx.background_executor().clone();
+        self.refresh_task = cx.spawn(async move |this, cx| {
+            let jail = cx.background_spawn(probe_jail(sandbox.ai_jail_path.clone(), executor));
+            let (resolved_key, ai_jail_file) = match root {
+                Some(root) => {
+                    let resolved = cx.background_spawn({
+                        let root = root.clone();
+                        async move {
+                            resolve_project_key(sandbox.project_keys(), &root).map(str::to_string)
+                        }
+                    });
+                    let notice = ai_jail_file_notice(fs.as_ref(), &root).await;
+                    (resolved.await, notice)
+                }
+                None => (None, None),
+            };
+            let jail = jail.await;
+            this.update(cx, |this, cx| {
+                this.jail = jail;
+                this.resolved_key = resolved_key;
+                this.ai_jail_file = ai_jail_file;
+                cx.notify();
+            })
+            .log_err();
+        });
+    }
+
+    fn error_mut(&mut self, kind: EntryKind) -> &mut Option<String> {
+        match kind {
+            EntryKind::RwMap => &mut self.rw_map_error,
+            EntryKind::AllowHost => &mut self.host_error,
+        }
+    }
+
+    fn add(&mut self, kind: EntryKind, raw: String, cx: &mut Context<Self>) {
+        let Some(root) = self.root.clone() else {
+            return;
+        };
+        let task = add_entry(kind, &root, &raw, cx);
+        self.show_outcome(kind, task, cx);
+    }
+
+    fn remove(&mut self, kind: EntryKind, raw: String, cx: &mut Context<Self>) {
+        let Some(root) = self.root.clone() else {
+            return;
+        };
+        let task = remove_entry(kind, &root, &raw, cx);
+        self.show_outcome(kind, task, cx);
+    }
+
+    /// Shows the edit's error under its list's input, or clears it on success.
+    fn show_outcome(
+        &mut self,
+        kind: EntryKind,
+        task: Task<Result<(), String>>,
+        cx: &mut Context<Self>,
+    ) {
+        *self.error_mut(kind) = None;
+        cx.notify();
+        cx.spawn(async move |this, cx| {
+            let result = task.await;
+            this.update(cx, |this, cx| {
+                *this.error_mut(kind) = result.err();
+                cx.notify();
+            })
+            .log_err();
+        })
+        .detach();
+    }
+}
+
+pub(crate) fn render_agent_jail_page(
+    settings_window: &SettingsWindow,
+    scroll_handle: &ScrollHandle,
+    window: &mut Window,
+    cx: &mut Context<SettingsWindow>,
+) -> AnyElement {
+    let root = active_root(settings_window, cx);
+    let state_key = format!(
+        "agent-jail-page-{}",
+        root.as_deref()
+            .map(|root| root.to_string_lossy())
+            .unwrap_or_default()
+    );
+    let state = window.use_keyed_state(SharedString::from(state_key), cx, {
+        let root = root.clone();
+        move |_, cx| JailPageState::new(root, cx)
+    });
+    let memory_section = memory_section(root.clone(), scroll_handle, window, cx);
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let memory = AgentMemorySettings::get_global(cx).clone();
+    let (jail, resolved_key, ai_jail_file, rw_map_error, host_error) = {
+        let page = state.read(cx);
+        (
+            page.jail.clone(),
+            page.resolved_key.clone(),
+            page.ai_jail_file,
+            page.rw_map_error.clone(),
+            page.host_error.clone(),
+        )
+    };
+
+    let project_section = match root.as_deref() {
+        Some(root) => {
+            let key = page_key(&sandbox, root, resolved_key.as_deref());
+            let policy = sandbox.policy_for_key(key);
+            let own = key
+                .and_then(|key| sandbox.projects.get(key))
+                .cloned()
+                .unwrap_or_default();
+            let drifted = LaunchRegistry::for_root(root, cx)
+                .iter()
+                .any(|record| launch::drifted_now(record, cx));
+            let (ai_jail_path, supports_forward_port) = match &jail {
+                JailProbe::Found { path, binary } => {
+                    (Some(path.as_path()), Some(binary.supports_forward_port))
+                }
+                JailProbe::Unreadable { path, .. } => (Some(path.as_path()), None),
+                JailProbe::Pending | JailProbe::Missing { .. } => (None, None),
+            };
+            let preview = preview_command(
+                &policy,
+                root,
+                &sandbox.claude_config_dir,
+                ai_jail_path,
+                &memory,
+                supports_forward_port.unwrap_or(false),
+            );
+            // The R7.3 note is shown once, beside the Memory switch.
+            let memory_notices: Vec<String> = supports_forward_port
+                .and_then(|supports| forward_port_notice(&memory, supports))
+                .map(str::to_string)
+                .into_iter()
+                .collect();
+            let lists = [
+                (
+                    EntryKind::RwMap,
+                    "Writable Folders",
+                    "Folders the jailed agent may write besides the project. Each must be an absolute path to an existing folder, outside the project, the Claude config directory and every other writable folder.",
+                    "Add a writable folder (e.g. ~/data)…",
+                    policy.rw_maps.clone(),
+                    rw_map_error,
+                ),
+                (
+                    EntryKind::AllowHost,
+                    "Allowed Hosts",
+                    "Hosts the jailed agent may reach. Each is a bare DNS name: no scheme, port, path, wildcard or IP address.",
+                    "Add an allowed host (e.g. registry.npmjs.org)…",
+                    policy.allow_hosts.clone(),
+                    host_error,
+                ),
+            ]
+            .into_iter()
+            .map(
+                |(kind, title, description, placeholder, entries, error)| {
+                    render_list(
+                        kind,
+                        ListText {
+                            title,
+                            description,
+                            placeholder,
+                        },
+                        entries,
+                        kind.list(&own),
+                        error,
+                        &state,
+                        scroll_handle,
+                        cx,
+                    )
+                },
+            )
+            .collect::<Vec<_>>();
+            let project_switch = SwitchField::new(
+                "agent-jail-project-enabled",
+                Some("Run agents in ai-jail for this project"),
+                Some(
+                    "Start the Claude agents of this project inside ai-jail. Turning it off asks first."
+                        .into(),
+                ),
+                policy.enabled,
+                {
+                    let root = root.to_path_buf();
+                    move |toggle, window, cx| {
+                        confirm::set_project_enabled(
+                            &root,
+                            *toggle == ToggleState::Selected,
+                            window,
+                            cx,
+                        )
+                        .detach();
+                    }
+                },
+            )
+            .tab_index(0);
+            let project_switch = reveal(
+                &state,
+                "agent-jail-project-enabled",
+                scroll_handle,
+                project_switch,
+                cx,
+            );
+            let preview = render_preview(
+                preview_off_notice(policy.enabled),
+                preview,
+                memory_notices,
+                &state,
+                scroll_handle,
+                cx,
+            );
+
+            v_flex()
+                .gap_4()
+                .child(SettingsSectionHeader::new("This Project").no_padding(true))
+                .child(
+                    Label::new(root.to_string_lossy().into_owned())
+                        .size(LabelSize::Small)
+                        .color(Color::Muted)
+                        .buffer_font(cx),
+                )
+                .child(project_switch)
+                .when(drifted, |this| {
+                    this.child(
+                        Label::new(RESTART_NOTICE)
+                            .size(LabelSize::Small)
+                            .color(Color::Warning),
+                    )
+                })
+                .when_some(ai_jail_file, |this, notice| {
+                    this.child(
+                        Label::new(notice)
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    )
+                })
+                .children(lists)
+                .child(preview)
+                .into_any_element()
+        }
+        None => Label::new(project_notice(None).unwrap_or(NO_PROJECT_NOTICE))
+            .color(Color::Muted)
+            .into_any_element(),
+    };
+
+    let defaults = render_defaults(&sandbox, &state, scroll_handle, cx);
+    v_flex()
+        .id("agent-jail-page")
+        .debug_selector(|| "agent-jail-page".into())
+        .size_full()
+        .pt_2p5()
+        .px_8()
+        .pb_16()
+        .gap_6()
+        .overflow_y_scroll()
+        .track_scroll(scroll_handle)
+        .child(render_binary(&jail, cx))
+        .child(Divider::horizontal())
+        .child(project_section)
+        .child(Divider::horizontal())
+        .child(defaults)
+        .child(Divider::horizontal())
+        .child(memory_section)
+        .into_any_element()
+}
+
+/// `control`, wrapped by the page's [`RevealOnFocus`] under `key`.
+fn reveal(
+    state: &Entity<JailPageState>,
+    key: impl Into<SharedString>,
+    scroll_handle: &ScrollHandle,
+    control: impl IntoElement,
+    cx: &mut App,
+) -> AnyElement {
+    state.update(cx, |state, cx| {
+        state.controls.wrap(key, scroll_handle, control, cx)
+    })
+}
+
+/// The ai-jail path and version (R3.2), with the R3.5 or R3.6 banner.
+fn render_binary(jail: &JailProbe, cx: &App) -> AnyElement {
+    let warning = |text: String| {
+        Banner::new()
+            .severity(Severity::Warning)
+            .child(Label::new(text).size(LabelSize::Small))
+    };
+    let body = match jail {
+        JailProbe::Pending => Label::new("Looking for ai-jail…")
+            .size(LabelSize::Small)
+            .color(Color::Muted)
+            .into_any_element(),
+        JailProbe::Missing { configured } => v_flex()
+            .gap_1()
+            .when_some(banner_text(None), |this, text| this.child(warning(text)))
+            .when_some(configured.as_ref(), |this, path| {
+                this.child(
+                    Label::new(format!(
+                        "Not found at {} (agent_sandbox.ai_jail_path).",
+                        path.display()
+                    ))
+                    .size(LabelSize::Small)
+                    .color(Color::Muted),
+                )
+            })
+            .into_any_element(),
+        JailProbe::Found { path, binary } => v_flex()
+            .gap_1()
+            .child(
+                Label::new(format!("ai-jail {} at {}", binary.version, path.display()))
+                    .size(LabelSize::Small)
+                    .buffer_font(cx),
+            )
+            .when_some(banner_text(Some(&binary.version)), |this, text| {
+                this.child(warning(text))
+            })
+            .into_any_element(),
+        JailProbe::Unreadable { path, error } => v_flex()
+            .gap_1()
+            .child(
+                Label::new(path.to_string_lossy().into_owned())
+                    .size(LabelSize::Small)
+                    .buffer_font(cx),
+            )
+            .child(
+                Banner::new().severity(Severity::Error).child(
+                    Label::new(format!(
+                        "The version of ai-jail could not be read: {error}."
+                    ))
+                    .size(LabelSize::Small),
+                ),
+            )
+            .into_any_element(),
+    };
+    v_flex()
+        .gap_2()
+        .child(SettingsSectionHeader::new("ai-jail").no_padding(true))
+        .child(body)
+        .into_any_element()
+}
+
+struct ListText {
+    title: &'static str,
+    description: &'static str,
+    placeholder: &'static str,
+}
+
+/// One editable list: the merged entries, a remove button on the project's own ones, an add input
+/// and the refusal under it (R3.4).
+fn render_list(
+    kind: EntryKind,
+    text: ListText,
+    entries: Vec<String>,
+    own: &[String],
+    error: Option<String>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let mut rows = Vec::with_capacity(entries.len());
+    for (index, entry) in entries.into_iter().enumerate() {
+        let action = if own.contains(&entry) {
+            let remove_label = format!("Remove {}", entry);
+            let remove_id = format!("agent-jail-{}-remove-{index}", kind.id());
+            let button = IconButton::new(SharedString::from(remove_id.clone()), IconName::Trash)
+                .icon_size(IconSize::Small)
+                .icon_color(Color::Muted)
+                .tab_index(0_isize)
+                .aria_label(remove_label.clone())
+                .tooltip(Tooltip::text(remove_label))
+                .on_click({
+                    let state = state.clone();
+                    let entry = entry.clone();
+                    move |_, _, cx| {
+                        let entry = entry.clone();
+                        state.update(cx, |state, cx| state.remove(kind, entry, cx));
+                    }
+                });
+            reveal(state, remove_id, scroll_handle, button, cx)
+        } else {
+            Label::new("Default for every project")
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .into_any_element()
+        };
+        rows.push(
+            h_flex()
+                .gap_2()
+                .justify_between()
+                .child(Label::new(entry).size(LabelSize::Small).buffer_font(cx))
+                .child(action),
+        );
+    }
+    let input_id = format!("agent-jail-{}-new", kind.id());
+    let input = SettingsInputField::new(SharedString::from(input_id.clone()))
+        .with_placeholder(text.placeholder)
+        .aria_label(format!("Add to {}", text.title))
+        .tab_index(0)
+        .with_buffer_font()
+        .display_clear_button()
+        .display_confirm_button()
+        .clear_on_confirm()
+        .on_confirm({
+            let state = state.clone();
+            move |raw, _window, cx| {
+                let Some(raw) = raw else {
+                    return;
+                };
+                let raw = raw.trim().to_string();
+                if raw.is_empty() {
+                    return;
+                }
+                state.update(cx, |state, cx| state.add(kind, raw, cx));
+            }
+        });
+    let input = reveal(state, input_id, scroll_handle, input, cx);
+    v_flex()
+        .gap_0p5()
+        .child(Label::new(text.title))
+        .child(
+            Label::new(text.description)
+                .size(LabelSize::Small)
+                .color(Color::Muted),
+        )
+        .child(v_flex().mt_2().gap_1p5().children(rows).child(input))
+        .when_some(error, |this, error| {
+            this.child(Label::new(error).size(LabelSize::Small).color(Color::Error))
+        })
+        .into_any_element()
+}
+
