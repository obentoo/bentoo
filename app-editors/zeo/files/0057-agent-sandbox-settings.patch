+    }
+
+    async fn run_home(
+        home: &Path,
+        project: &Entity<Project>,
+        cx: &mut TestAppContext,
+    ) -> LaunchDecision {
+        let cmd = plain_cmd("/usr/bin/claude-agent-acp-plus", &["--acp"]);
