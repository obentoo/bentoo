+//! Runs the Claude agent adapters inside ai-jail.
+//!
+//! The `agent_sandbox` and `agent_memory` settings are fields of the user-level `SettingsContent`
+//! only, so a project's `.zed/settings.json` can neither switch the jail on or off nor turn
+//! memory off. [`init`] also watches each local project's settings file and logs one warning
+//! when it carries either key, so the ignored key does not go unnoticed.
+
+pub mod command;
+pub mod confirm;
+pub mod launch;
+pub mod memory;
+pub mod probe;
+mod project_keys;
+mod settings;
+pub mod validate;
+
+pub use crate::launch::LaunchRegistry;
+pub use crate::settings::{
+    AgentMemorySettings, AgentSandboxProjectSettings, AgentSandboxSettings, ProjectPolicy,
+    lexical_match, resolve_project_key,
+};
+
+use gpui::App;
+
+/// Sets up the launch registry and the project settings-file warning. Call once at startup.
+///
+/// Both settings register themselves through `RegisterSetting`.
+pub fn init(cx: &mut App) {
+    cx.set_global(LaunchRegistry::default());
+    project_keys::init(cx);
+}
+
+#[cfg(test)]
+mod command_tests;
+#[cfg(test)]
+mod confirm_tests;
+#[cfg(test)]
+mod launch_tests;
+#[cfg(test)]
+mod memory_tests;
+#[cfg(test)]
+mod probe_tests;
+#[cfg(test)]
+mod roundtrip_tests;
+#[cfg(test)]
+mod scope_tests;
+#[cfg(test)]
+mod settings_tests;
+#[cfg(test)]
+mod test_log_capture;
+#[cfg(test)]
+mod validate_tests;
