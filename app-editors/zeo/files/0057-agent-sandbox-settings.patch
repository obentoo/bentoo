+// Story 043, task 2.2 — locating ai-jail, reading its version, the outdated check (R1.9, R3.5,
+// R5.3; A3, A4; Q4). Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod probe_tests;
+//
+// Validation filter: `probe` (every test path is `probe_tests::…`).
+//
+// Contract (design.md §agent_sandbox::probe). Assumed signatures — adjust the `use`/call only:
+//   - `crate::probe::locate(setting: Option<&Path>) -> Option<PathBuf>`
+//   - `crate::probe::version(path: &Path) -> impl Future<Output = Result<semver::Version, ProbeError>>`
+//     (2 s timeout; cached per (path, mtime)). If the implementation needs an executor argument,
+//     pass `cx.background_executor.clone()` — the assertions stay.
+//   - `crate::probe::MIN_SAFE: semver::Version` (2.4.0), `crate::probe::is_outdated(&Version) -> bool`
+//   - `ProbeError: Display`, naming the path (and the exit code for a non-zero exit).
+//
+// Each test uses fake `ai-jail` shell scripts in its own tempdir; the cache is process-wide, so no
+// two tests share a script path.
+//
+// Hostile halves first:
+//   - version, wrongly ACCEPT: `ai-jailer 2.8.1` (another program), `ai-jail 2.8` (not semver),
+//     a hang, a non-zero exit printing a valid version.
+//   - outdated, wrongly COLLAPSE by string order: `10.0.0` is newer than `2.4.0`; a pre-release
+//     `2.4.0-rc.1` is older than the fixing release.
+//   - cache, wrongly COLLAPSE: a changed mtime re-probes; two paths with the same mtime do not
+//     share an answer. Wrongly SPLIT: the same (path, mtime) never spawns twice.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant, SystemTime};
+
+use gpui::TestAppContext;
+use semver::Version;
+
+use crate::probe::{MIN_SAFE, is_outdated, locate, version};
+
+fn script(dir: &Path, name: &str, body: &str) -> PathBuf {
+    let path = dir.join(name);
+    std::fs::write(&path, format!("#!/bin/sh\n{body}\n")).expect("write script");
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+    path
+}
+
+fn set_mtime(path: &Path, time: SystemTime) {
+    std::fs::File::options()
+        .write(true)
+        .open(path)
+        .expect("open script")
+        .set_modified(time)
+        .expect("set mtime");
+}
+
+fn v(text: &str) -> Version {
+    Version::parse(text).expect("test version")
+}
+
+// --- version: hostile ------------------------------------------------------------------------
+
+#[gpui::test]
+async fn probe_refuses_output_that_is_not_ai_jail_semver(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    for (name, output) in [
+        ("other", "echo 'ai-jailer 2.8.1'"),
+        ("short", "echo 'ai-jail 2.8'"),
+        ("garbage", "echo 'hello'"),
+        ("empty", "true"),
+    ] {
+        let path = script(tmp.path(), name, output);
+        let error = version(&path, &cx.executor())
+            .await
+            .expect_err(&format!("{name}: {output} must not parse as a version"));
+        assert!(
+            error.to_string().contains(&path.display().to_string())
+                || error.to_string().contains(name),
+            "{name}: the error names the binary: {error}"
+        );
+    }
+}
+
+#[gpui::test]
+async fn probe_refuses_a_non_zero_exit_even_with_a_version(cx: &mut TestAppContext) {
