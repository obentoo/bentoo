+const STATUS_FIXTURE: &str = r#"{"counts":{"pages_latest":69,"pages_all":169,"sessions":118,"observations":26887,"evidence_rows":0},"scope":{"workspace":"default","project":"zeo-workspace-zed-workspace","resolved_by":"explicit"}}"#;
+const RECENT_FIXTURE: &str = r#"{"hits":[{"id":"01a12878-aaaa","path":"sessions/b1e7.md","title":"Session b1e7","snippet":"17 completed tool calls, over 1s.","rank":1.79e15},{"id":"02b2","path":"gotchas/fs.md","title":"FS gotcha","snippet":"PAGE-TEXT-MUST-NOT-BE-LOGGED","rank":1.2e15}]}"#;
