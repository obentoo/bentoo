+
+fn json_response(body: Value) -> anyhow::Result<Response<AsyncBody>> {
+    Ok(Response::builder()
+        .status(200)
+        .header("Content-Type", "application/json")
+        .body(AsyncBody::from(body.to_string().into_bytes()))
+        .expect("response"))
+}
