+// --- version: benign -------------------------------------------------------------------------
+
+#[gpui::test]
+async fn probe_reads_the_installed_version_shapes(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    for (name, output, expected) in [
+        ("a", "echo 'ai-jail 2.8.1'", "2.8.1"),
+        ("b", "printf 'ai-jail 2.7.0\\n'", "2.7.0"),
+        ("c", "echo 'ai-jail 2.3.9'", "2.3.9"),
+    ] {
+        let path = script(tmp.path(), name, output);
+        assert_eq!(
+            version(&path, &cx.executor()).await.expect(name),
+            v(expected),
+            "{name}"
+        );
+    }
+}
