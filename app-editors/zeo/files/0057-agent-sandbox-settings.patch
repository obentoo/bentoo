+#[derive(Clone)]
+enum Answer {
+    Text(&'static str),
+    ToolError(&'static str),
+    RpcError(i64, &'static str),
+    Delayed(Duration, &'static str),
+    Never,
+    Refused,
+}
+
+struct FakeMemory {
+    seen: Arc<Mutex<Vec<Seen>>>,
+}
+
+impl FakeMemory {
+    fn tools_calls(&self) -> Vec<Seen> {
+        self.seen
+            .lock()
+            .iter()
+            .filter(|seen| seen.method == "tools/call")
+            .cloned()
+            .collect()
+    }
+    fn requests(&self) -> Vec<Seen> {
+        self.seen.lock().clone()
+    }
