+        let client =
+            MemoryClient::new(endpoint.clone(), None, http, &cx.to_async()).expect("client");
+        let status = client.status(&scope("p")).await.expect("status");
+        assert_eq!(status.endpoint.as_str(), "http://127.0.0.1:49374/mcp");
+        assert!(!format!("{client:?}").contains("SECRET"), "{client:?}");
+
+        let (http, _) = fake(Arc::new(|_, _| Err(anyhow::anyhow!("Connection refused"))));
+        let client = MemoryClient::new(endpoint, None, http, &cx.to_async()).expect("client");
+        let error = client.status(&scope("p")).await.expect_err("refused");
+        assert_eq!(
+            error.to_string(),
+            "ai-memory is not reachable at http://127.0.0.1:49374/mcp"
+        );
+    }
+
+    // L4: a server's error text is shown as its first line, at most 200 characters.
+    #[gpui::test]
+    async fn rpc_and_tool_error_texts_are_bounded(cx: &mut TestAppContext) {
