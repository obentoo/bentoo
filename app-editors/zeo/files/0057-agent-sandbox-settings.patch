+#[gpui::test]
+async fn probe_times_out_a_hanging_binary(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let path = script(tmp.path(), "ai-jail", "exec sleep 30");
+    let started = Instant::now();
+    let task = cx.executor().spawn({
+        let path = path.clone();
+        let executor = cx.executor();
+        async move { version(&path, &executor).await }
+    });
+    // Poll once so an executor-timer timeout is registered, then move the fake clock past 2 s.
+    // A real-time timeout (smol) simply elapses during the await.
+    cx.executor().run_until_parked();
+    cx.executor().advance_clock(Duration::from_secs(3));
+    let result = task.await;
+    assert!(result.is_err(), "a hang is an error, got {result:?}");
+    assert!(
+        started.elapsed() < Duration::from_secs(15),
+        "the probe gave up instead of waiting for the 30 s sleep"
+    );
+}
