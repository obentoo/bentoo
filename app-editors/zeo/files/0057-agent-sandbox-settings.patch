+    // --- authored at Run (8.1), Red first -----------------------------------------------------
+
+    // Status, wrongly CALL: with memory off nothing reaches ai-memory, and the user is told so.
+    #[gpui::test]
+    async fn agent_sandbox_actions_status_with_memory_off_makes_no_call(cx: &mut TestAppContext) {
+        use crate::agent_sandbox_actions::{MEMORY_OFF, MemoryStatusToast, Status};
+        use std::sync::atomic::{AtomicUsize, Ordering};
+
+        let fs = init(cx);
+        let requests = Arc::new(AtomicUsize::new(0));
+        cx.update({
+            let requests = requests.clone();
+            move |cx| {
+                cx.set_http_client(http_client::FakeHttpClient::create(move |_| {
+                    requests.fetch_add(1, Ordering::SeqCst);
+                    async { anyhow::bail!("no request is expected while memory is off") }
+                }));
+            }
+        });
+        user_settings(&fs, json!({ "agent_memory": { "enabled": false } }), cx).await;
+        let mut win = workspace_window(&fs, &["/w/app"], cx).await;
+        let notifications_before = win
+            .workspace
+            .read_with(&win.cx, |w, _| w.notification_ids().len());
+        win.cx.dispatch_action(Status);
+        win.cx.run_until_parked();
