diff --git a/crates/agent_servers/src/sandbox_hook_v2_tests.rs b/crates/agent_servers/src/sandbox_hook_v2_tests.rs
new file mode 100644
index 0000000..c3c77b0
--- /dev/null
+++ b/crates/agent_servers/src/sandbox_hook_v2_tests.rs
@@ -0,0 +1,289 @@
+// A jailed start when acp-beta is on: `acp::connect` tries ACP v2 first and falls back to v1
+// on a version mismatch. Both attempts must start ai-jail the way story 043 starts it -- in the
+// launch root, with only the configured env, never through a login shell -- and the launch
+// record must follow the process that is actually kept. Zeo forces acp-beta on (0001), so
+// this is the path every jailed start takes.
+//
+// Behaviour-level, like `sandbox_hook_lifecycle_tests`: a fake ai-jail on the real filesystem
+// that logs every spawn and answers `initialize` itself.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::time::Duration;
+
+use acp_thread::AgentConnection;
+use agent_sandbox::launch::LaunchRegistry;
+use fs::RealFs;
+use gpui::{TestAppContext, UpdateGlobal as _};
+use project::Project;
+use project::agent_server_store::AgentId;
+use serde_json::json;
+use settings::SettingsStore;
+
+use crate::acp::{AcpConnection, AcpV2Connection};
+use crate::custom::CustomAgentServer;
+use crate::{AgentServer as _, AgentServerDelegate};
+
+const AGENT: &str = "jailed-v2-agent";
+
+const V1_RESULT: &str = r#""result":{"protocolVersion":1,"agentCapabilities":{},"agentInfo":{"name":"jailed-v1","version":"1"}}"#;
+const V2_RESULT: &str = r#""result":{"protocolVersion":2,"info":{"name":"jailed-v2","version":"1"},"capabilities":{"session":{}}}"#;
+
+/// What `sandbox_jail_process_gets_only_the_configured_env_and_zeos_base` allows: the entry's
+/// env, Zeo's base, and what the fake's own /bin/sh sets.
+const ALLOWED_ENV: &[&str] = &[
+    "ZEO_THREAD",
+    "HOOK_SECRET",
+    "PATH",
+    "HOME",
+    "XDG_RUNTIME_DIR",
+    "LANG",
+    "PWD",
+    "OLDPWD",
+    "SHLVL",
+    "_",
+    "NO_PROXY",
+    "NO_BROWSER",
+];
+
+struct JailFixture {
+    _tmp: tempfile::TempDir,
+    base: PathBuf,
+    root: PathBuf,
+}
+
+impl JailFixture {
+    /// `v2_result` is what the fake answers to a v2 `initialize`; a v1 one is always answered.
+    fn new(v2_result: &str) -> Self {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = tmp.path().canonicalize().expect("canonical");
+        let root = base.join("app");
+        std::fs::create_dir_all(root.join(".git")).expect("project");
+        std::fs::create_dir_all(base.join("claude-jailed")).expect("claude dir");
+        std::fs::create_dir_all(base.join("bin")).expect("bin");
+        let script = r#"#!/bin/sh
+if [ "$1" = --version ]; then echo 'ai-jail 2.8.1'; exit 0; fi
+# The capability probe (`--help`) is not a start of the agent.
+if [ "$1" = --help ]; then exit 0; fi
+printf '%s %s\n' "$$" "$(pwd)" >> 'BASE/spawns.log'
+env > "BASE/jail.env.$$"
+while IFS= read -r request; do
+    case "$request" in
+        *'"method":"initialize"'*)
+            id=${request#*\"id\":}; id=${id%%,*}
+            case "$request" in
+                *'"protocolVersion":2'*) printf '{"jsonrpc":"2.0","id":%s,%s}\n' "$id" 'V2_RESULT' ;;
+                *) printf '{"jsonrpc":"2.0","id":%s,%s}\n' "$id" 'V1_RESULT' ;;
+            esac
+            ;;
+    esac
+done
+"#
+        .replace("BASE", &base.display().to_string())
+        .replace("V2_RESULT", v2_result)
+        .replace("V1_RESULT", V1_RESULT);
+        let ai_jail = base.join("bin/ai-jail");
+        std::fs::write(&ai_jail, script).expect("write ai-jail");
+        std::fs::set_permissions(&ai_jail, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+        // The jailed command names the agent; ai-jail is a fake, so it never runs.
+        let agent = base.join("bin/claude-agent-acp-plus");
+        std::fs::write(&agent, "#!/bin/sh\nexit 9\n").expect("write agent");
+        std::fs::set_permissions(&agent, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+        let settings = json!({
+            "agent_servers": {
+                AGENT: {
+                    "type": "custom",
+                    "command": agent,
+                    "args": [],
+                    "env": { "HOOK_SECRET": "hook-secret-value" }
+                }
+            },
+            "agent_sandbox": {
+                "enabled": true,
+                "ai_jail_path": ai_jail,
+                "claude_config_dir": base.join("claude-jailed"),
+            },
+            "agent_memory": { "enabled": false }
+        });
+        std::fs::write(base.join("settings.json"), settings.to_string()).expect("settings");
+        Self {
+            _tmp: tmp,
+            base,
+            root,
+        }
+    }
+
+    /// Every spawn of the fake, in order: (pid, working directory).
+    fn spawns(&self) -> Vec<(String, String)> {
+        std::fs::read_to_string(self.base.join("spawns.log"))
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|line| line.split_once(' '))
+            .map(|(pid, cwd)| (pid.to_string(), cwd.to_string()))
+            .collect()
+    }
+
+    fn assert_cleared_env(&self, pid: &str) {
+        let dump = std::fs::read_to_string(self.base.join(format!("jail.env.{pid}")))
+            .expect("the fake dumped its env");
+        for name in dump
+            .lines()
+            .filter_map(|line| line.split_once('='))
+            .map(|(n, _)| n)
+        {
+            assert!(
+                ALLOWED_ENV.contains(&name),
+                "{name} reached ai-jail (pid {pid})"
+            );
+        }
+        assert!(dump.contains("HOOK_SECRET=hook-secret-value"));
+    }
+}
+
+fn init(f: &JailFixture, cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let settings = std::fs::read_to_string(f.base.join("settings.json")).expect("settings");
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        agent_sandbox::init(cx);
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&settings, cx)
+                .result()
+                .expect("user settings parse");
+        });
+    });
+}
+
+async fn start(f: &JailFixture, cx: &mut TestAppContext) -> Rc<dyn AgentConnection> {
+    let project = Project::test(RealFs::new(None, cx.executor()), [f.root.as_path()], cx).await;
+    cx.run_until_parked();
+    let store = project.read_with(cx, |project, _| project.agent_server_store().clone());
+    let delegate = AgentServerDelegate::new(store, None, None);
+    let server = CustomAgentServer::new(AgentId::new(AGENT));
+    let connect = cx.update(|cx| server.connect(delegate, project.clone(), cx));
+    let timeout = cx.background_executor.timer(Duration::from_secs(10));
+    let result = futures::select! {
+        result = futures::FutureExt::fuse(connect) => result,
+        _ = futures::FutureExt::fuse(timeout) => panic!("timed out starting the agent"),
+    };
+    cx.run_until_parked();
+    result.expect("the jailed start connects")
+}
+
+fn has_record(f: &JailFixture, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| LaunchRegistry::get(&AgentId::new(AGENT), &f.root, cx).is_some())
+}
+
+/// Gone or a zombie: a killed child is not always reaped at once, and a zombie runs nothing.
+fn process_is_gone(pid: &str) -> bool {
+    match std::fs::read_to_string(Path::new("/proc").join(pid).join("stat")) {
+        Err(_) => true,
+        Ok(stat) => stat
+            .rsplit_once(')')
+            .is_some_and(|(_, rest)| rest.trim_start().starts_with('Z')),
+    }
+}
+
+async fn wait_until(
+    cx: &mut TestAppContext,
+    what: &str,
+    mut done: impl FnMut(&mut TestAppContext) -> bool,
+) {
+    for _ in 0..50 {
+        cx.run_until_parked();
+        if done(cx) {
+            return;
+        }
+        cx.background_executor
+            .timer(Duration::from_millis(100))
+            .await;
+    }
+    panic!("{what}");
+}
+
+#[gpui::test]
+async fn jailed_v2_start_spawns_once_in_the_root_with_the_cleared_env(cx: &mut TestAppContext) {
+    let f = JailFixture::new(V2_RESULT);
+    init(&f, cx);
+    let connection = start(&f, cx).await;
+    assert!(
+        connection.clone().downcast::<AcpV2Connection>().is_some(),
+        "the agent speaks v2, so the v2 connection is kept"
+    );
+
+    let spawns = f.spawns();
+    assert_eq!(spawns.len(), 1, "exactly one spawn: {spawns:?}");
+    let (pid, cwd) = &spawns[0];
+    assert_eq!(
+        cwd,
+        &f.root.display().to_string(),
+        "spawned in the launch root"
+    );
+    f.assert_cleared_env(pid);
+    assert!(
+        has_record(&f, cx),
+        "registered while the v2 connection lives"
+    );
+
+    drop(connection);
+    wait_until(cx, "the launch record outlived its v2 connection", |cx| {
+        !has_record(&f, cx)
+    })
+    .await;
+    wait_until(cx, "the v2 process outlived its connection", |_| {
+        process_is_gone(pid)
+    })
+    .await;
+}
+
+#[gpui::test]
+async fn jailed_v1_fallback_replaces_the_v2_attempt_and_keeps_the_record(cx: &mut TestAppContext) {
+    // A v1-only agent (the Plus adapter today) answers a v2 `initialize` with protocol 1.
+    let f = JailFixture::new(V1_RESULT);
+    init(&f, cx);
+    let connection = start(&f, cx).await;
+    assert!(
+        connection.clone().downcast::<AcpConnection>().is_some(),
+        "the v1 fallback is kept"
+    );
+
+    let spawns = f.spawns();
+    assert_eq!(
+        spawns.len(),
+        2,
+        "the v2 attempt, then the v1 retry: {spawns:?}"
+    );
+    let ((first, first_cwd), (second, second_cwd)) = (&spawns[0], &spawns[1]);
+    assert_ne!(first, second, "the fallback is a fresh process");
+    for (pid, cwd) in [(first, first_cwd), (second, second_cwd)] {
+        assert_eq!(
+            cwd,
+            &f.root.display().to_string(),
+            "pid {pid} in the launch root"
+        );
+        f.assert_cleared_env(pid);
+    }
+    wait_until(cx, "the refused v2 attempt is still running", |_| {
+        process_is_gone(first)
+    })
+    .await;
+    assert!(!process_is_gone(second), "the kept v1 process runs");
+    assert!(
+        has_record(&f, cx),
+        "the record follows the live v1 process, not the refused attempt"
+    );
+
+    drop(connection);
+    wait_until(cx, "the launch record outlived its v1 connection", |cx| {
+        !has_record(&f, cx)
+    })
+    .await;
+    wait_until(cx, "the v1 process outlived its connection", |_| {
+        process_is_gone(second)
+    })
+    .await;
+}
