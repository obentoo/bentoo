+        let mut async_cx = cx.to_async();
+        plan_in(
+            AgentId::new(agent),
+            project,
+            cmd,
+            &configured,
+            env,
+            &mut async_cx,
+        )
+        .await
+    }
+
+    fn spawn_of(plan: LaunchPlan) -> (LaunchRecord, AgentServerCommand, JailSpawn) {
+        let spawn = plan.jail_spawn.clone();
+        let (record, cmd) = jailed(plan.decision);
+        (
+            record,
+            cmd,
+            spawn.expect("a jailed start carries its spawn"),
+        )
+    }
+
+    // F1: ai-jail copies proxies, `LC_*` and `XDG_*` from its own environment into the jail and
+    // finds its configuration through HOME, so its environment is only what was configured plus
+    // a base from Zeo's own process.
+    #[gpui::test]
+    async fn launch_jail_env_is_only_the_configured_names_and_zeos_base(cx: &mut TestAppContext) {
+        init(cx);
+        let f = fixture("ai-jail 2.8.1");
+        set_user_settings(sandbox(&f, true, Value::Null, memory_off()), cx);
+        let project = project(&f, cx).await;
+        let home = f.base.join("zeo-home");
+        let runtime = f.base.join("runtime");
+        let mut cmd = plain_cmd("/usr/bin/claude-agent-acp-plus", &["--acp"]);
+        cmd.env = Some(HashMap::from_iter(
+            [
+                ("HTTPS_PROXY", "http://user:s3cr3t@proxy.example:3128"),
+                ("XDG_FAKE_TOKEN", "xdg-token-value"),
+                ("LC_SECRET", "lc-secret-value"),
+                ("HOME", "/home/from-the-shell"),
+                ("AI_JAIL_FAKE", "steer"),
+                ("BWRAP_BIN", "/tmp/fake-bwrap"),
+                ("HOOK_SECRET", "hook-secret-value"),
+            ]
+            .map(|(name, value)| (name.to_string(), value.to_string())),
+        ));
+        let env = LaunchEnv {
+            home: home.clone(),
+            config_dir: home.join(".config/zeo"),
+            runtime_dir: Some(runtime.clone()),
+        };
+        let (_, cmd, spawn) = spawn_of(
+            plan_with(
+                ZEO_PLUS_AGENT_ID,
+                &project,
+                cmd,
+                &["HOOK_SECRET", "HOME"],
+                env,
+                cx,
+            )
+            .await,
+        );
+        let names: Vec<&str> = spawn.env.iter().map(|(name, _)| name.as_str()).collect();
+        for name in &names {
+            assert!(
+                ["HOOK_SECRET", "HOME", "PATH", "XDG_RUNTIME_DIR", "LANG"].contains(name),
+                "{name} reached ai-jail: {names:?}"
+            );
+        }
+        let value = |name: &str| {
+            spawn
+                .env
+                .iter()
+                .find(|(key, _)| key == name)
+                .map(|(_, value)| value.clone())
+        };
+        assert_eq!(value("HOOK_SECRET").as_deref(), Some("hook-secret-value"));
+        assert_eq!(
+            value("HOME"),
+            Some(home.display().to_string()),
+            "HOME is Zeo's, even when the agent's settings set one"
+        );
+        assert_eq!(
+            value("XDG_RUNTIME_DIR"),
+            Some(runtime.display().to_string())
+        );
+        assert_eq!(value("PATH"), std::env::var("PATH").ok(), "Zeo's own PATH");
+        assert!(
+            spawn.env.iter().all(|(_, value)| !value.contains("s3cr3t")),
+            "{:?}",
+            spawn.env
+        );
+        assert_eq!(count(&cmd.args, "--env", "HOOK_SECRET"), 1);
+        assert_eq!(count(&cmd.args, "--env", "HTTPS_PROXY"), 0);
+    }
+
+    // F3: `check_root` approves the resolved root; the jail's cwd and its read-only maps must be
+    // that path, not the spelling a symlink could re-point after the check.
+    #[gpui::test]
+    async fn launch_jail_runs_in_the_resolved_root(cx: &mut TestAppContext) {
+        init(cx);
+        let f = fixture("ai-jail 2.8.1");
+        let link = f.base.join("app-link");
+        symlink(&f.root, &link).expect("symlink");
+        set_user_settings(sandbox(&f, true, Value::Null, memory_off()), cx);
+        let project = Project::test(RealFs::new(None, cx.executor()), [link.as_path()], cx).await;
+        cx.run_until_parked();
+        let spelled = cx
+            .update(|cx| crate::launch::project_root(&project, cx))
+            .expect("a root");
+        let env = LaunchEnv {
+            home: f.base.join("zeo-home"),
+            config_dir: f.base.join("zeo-home/.config/zeo"),
+            runtime_dir: None,
+        };
+        let (record, cmd, spawn) = spawn_of(
+            plan_with(
+                ZEO_PLUS_AGENT_ID,
+                &project,
+                plain_cmd("/usr/bin/claude-agent-acp-plus", &["--acp"]),
+                &[],
+                env,
+                cx,
+            )
+            .await,
+        );
+        assert_eq!(spawn.cwd, f.root, "the jail runs in the resolved root");
+        let git = f.root.join(".git").display().to_string();
+        assert_eq!(count(&cmd.args, "--map", &git), 1, "{:?}", cmd.args);
+        let spelled_git = spelled.join(".git").display().to_string();
+        if spelled != f.root {
+            assert_eq!(count(&cmd.args, "--map", &spelled_git), 0, "{:?}", cmd.args);
+        }
+        assert_eq!(
+            record.project_root, spelled,
+            "the record keeps the project's spelling for the registry and the UI"
+        );
+    }
+
+    // F2: a custom entry that starts the adapter through a shell string is the adapter.
+    #[gpui::test]
+    async fn launch_recognises_an_adapter_started_through_a_shell_string(cx: &mut TestAppContext) {
+        init(cx);
+        let f = fixture("ai-jail 2.8.1");
+        set_user_settings(sandbox(&f, true, Value::Null, memory_off()), cx);
+        let project = project(&f, cx).await;
+        for (shell, script) in [
+            ("bash", "npx -y @lucascouts/claude-agent-acp-plus"),
+            ("bash", "npx -y '@lucascouts/claude-agent-tui@1.2.3' --acp"),
+            ("sh", "exec claude-agent-acp-plus --acp"),
+            ("sh", "cd /tmp && /usr/bin/claude-agent-acp-tui"),
+            ("sh", "exec claude-agent-acp-plus;"),
+        ] {
+            let cmd = plain_cmd(&format!("/bin/{shell}"), &["-lc", script]);
+            let (record, cmd) = jailed(run_with("my-shell-agent", &project, cmd, &[], cx).await);
+            assert_eq!(record.reason, Reason::On, "{script}");
+            assert_eq!(cmd.path, f.ai_jail, "{script} is wrapped");
+        }
+        for script in [
+            "my-claude-agent-acp-plus --acp",
+            "npx -y @lucascouts/claude-agent-acp-plus-fork",
+            "exec claude-agent-acp-plus2",
+            "npx -y @someone/claude-agent-acp-plusplus",
+        ] {
+            let cmd = plain_cmd("/bin/bash", &["-lc", script]);
+            let record = unchanged(run_with("my-shell-agent", &project, cmd, &[], cx).await);
+            assert_eq!(record.reason, Reason::NotClaude, "{script} is a look-alike");
+        }
+    }
+}
+
+// Fix round of 10.3 (live proof, defect #1): with filtered egress ai-jail exports its own proxy and
+// forces `no_proxy`/`NO_PROXY` empty AFTER every `--env` (measured on the fork 2.7.0), so a client
+// honouring the proxy variables sends `http://127.0.0.1:<memory port>` to ai-jail's proxy (HTTP
+// 405) instead of the forwarded port. A forwarded memory port therefore carries the exclusion in
+// `ZEO_NO_PROXY` (loopback merged with the configured values, never on argv) and restores it inside
+// the jail, after ai-jail's forced values, in front of the agent.
+//
+// Hostile halves first:
+//   - loopback, wrongly PROXIED: memory forwarded → the spawn env carries `ZEO_NO_PROXY` with
+//     127.0.0.1, localhost and ::1, forwarded once by name, and the agent runs behind the wrapper
+//     that exports it as `no_proxy` and `NO_PROXY`.
+//   - user entries, wrongly DROPPED: a configured `no_proxy`/`NO_PROXY` is merged in, in order,
+//     without duplicates, and its value never reaches argv.
+//   - wrapper, wrongly ADDED: memory off, or an ai-jail without `--forward-port`, leaves the agent
+//     right after `--` and adds no `ZEO_NO_PROXY`.
+mod loopback_off_the_jail_proxy {
+    use super::*;
+    use crate::launch::{JailSpawn, LaunchEnv, LaunchPlan, plan_in};
+
+    const AGENT: &str = "/usr/bin/claude-agent-acp-plus";
+
+    fn forward_port_fixture() -> Fixture {
+        let f = fixture("ai-jail 2.8.1");
+        write_script(
+            &f.ai_jail,
+            "case \"$1\" in --help) printf '    --forward-port <PORT>  Forward a host port\\n' ;; *) echo 'ai-jail 2.8.1' ;; esac",
+        );
+        f
+    }
+
+    async fn plan_for(
+        f: &Fixture,
+        memory: Value,
+        cmd: AgentServerCommand,
+        configured: &[&str],
+        cx: &mut TestAppContext,
+    ) -> (AgentServerCommand, JailSpawn) {
+        set_user_settings(sandbox(f, true, Value::Null, memory), cx);
+        let project = project(f, cx).await;
+        let configured: std::collections::HashSet<String> =
+            configured.iter().map(|name| name.to_string()).collect();
+        let env = LaunchEnv {
+            home: f.base.join("zeo-home"),
+            config_dir: f.base.join("zeo-home/.config/zeo"),
+            runtime_dir: None,
+        };
+        let mut async_cx = cx.to_async();
+        let plan: LaunchPlan = plan_in(
+            AgentId::new(ZEO_PLUS_AGENT_ID),
+            &project,
+            cmd,
+            &configured,
+            env,
+            &mut async_cx,
+        )
+        .await;
+        let spawn = plan
+            .jail_spawn
+            .clone()
+            .expect("a jailed start carries its spawn");
+        (jailed(plan.decision).1, spawn)
+    }
+
+    fn memory_on() -> Value {
+        json!({ "enabled": true, "endpoint": "http://127.0.0.1:49374/mcp" })
+    }
+
+    fn after_separator(args: &[String]) -> &[String] {
+        let at = args
+            .iter()
+            .position(|arg| arg == "--")
+            .expect("a `--` before the agent");
+        &args[at + 1..]
+    }
+
+    fn value<'a>(spawn: &'a JailSpawn, name: &str) -> Option<&'a str> {
+        spawn
+            .env
+            .iter()
+            .find(|(key, _)| key == name)
+            .map(|(_, value)| value.as_str())
+    }
+
+    #[gpui::test]
+    async fn launch_memory_forwarded_keeps_loopback_off_the_jail_proxy(cx: &mut TestAppContext) {
+        init(cx);
+        let f = forward_port_fixture();
+        let mut cmd = plain_cmd(AGENT, &["--acp"]);
+        cmd.env = Some(HashMap::from_iter(
+            [
+                ("no_proxy", "corp.example, localhost,,"),
+                ("NO_PROXY", "corp.example,internal.example"),
+            ]
+            .map(|(name, value)| (name.to_string(), value.to_string())),
+        ));
+        let (cmd, spawn) = plan_for(&f, memory_on(), cmd, &["no_proxy", "NO_PROXY"], cx).await;
+
+        assert_eq!(
+            value(&spawn, "ZEO_NO_PROXY"),
+            Some("127.0.0.1,localhost,::1,corp.example,internal.example"),
+            "loopback first, then the configured entries, deduplicated: {:?}",
+            spawn.env
+        );
+        assert_eq!(
+            count(&cmd.args, "--forward-port", "49374"),
+            1,
+            "{:?}",
+            cmd.args
+        );
+        assert_eq!(
+            count(&cmd.args, "--env", "ZEO_NO_PROXY"),
+            1,
+            "{:?}",
+            cmd.args
+        );
+        assert!(
+            !cmd.args.iter().any(|arg| arg.contains("corp.example")),
+            "a configured value never reaches argv: {:?}",
+            cmd.args
+        );
+        let agent = after_separator(&cmd.args);
+        assert_eq!(
+            &agent[..2],
+            &["/bin/sh".to_string(), "-c".to_string()],
+            "{agent:?}"
+        );
+        let script = &agent[2];
+        for name in [
+            "no_proxy=",
+            "NO_PROXY=",
+            "ZEO_NO_PROXY",
+            "127.0.0.1,localhost,::1",
+        ] {
+            assert!(
+                script.contains(name),
+                "{name} missing from the wrapper: {script}"
+            );
+        }
+        assert!(
+            script.ends_with("exec \"$@\""),
+            "the agent replaces the shell: {script}"
+        );
+        assert_eq!(
+            &agent[3..],
+            &["sh".to_string(), AGENT.to_string(), "--acp".to_string()],
+            "the agent and its arguments follow unchanged: {agent:?}"
+        );
+    }
+
+    #[gpui::test]
+    async fn launch_memory_forwarded_without_a_configured_value_is_loopback_only(
+        cx: &mut TestAppContext,
+    ) {
+        init(cx);
+        let f = forward_port_fixture();
+        let (cmd, spawn) = plan_for(&f, memory_on(), plain_cmd(AGENT, &["--acp"]), &[], cx).await;
+        assert_eq!(
+            value(&spawn, "ZEO_NO_PROXY"),
+            Some("127.0.0.1,localhost,::1")
+        );
+        assert_eq!(
+            count(&cmd.args, "--env", "ZEO_NO_PROXY"),
+            1,
+            "{:?}",
+            cmd.args
+        );
+    }
+
+    #[gpui::test]
+    async fn launch_memory_not_forwarded_adds_no_proxy_exclusion(cx: &mut TestAppContext) {
+        init(cx);
+        // Memory off with a binary that offers --forward-port, then memory on with one that does
+        // not (Unsupported): neither forwards a port, so neither wraps the agent.
+        for (fixture, memory) in [
+            (forward_port_fixture(), memory_off()),
+            (fixture("ai-jail 2.8.1"), memory_on()),
+        ] {
+            let (cmd, spawn) =
+                plan_for(&fixture, memory, plain_cmd(AGENT, &["--acp"]), &[], cx).await;
+            assert_eq!(value(&spawn, "ZEO_NO_PROXY"), None, "{:?}", spawn.env);
+            assert_eq!(
+                count(&cmd.args, "--env", "ZEO_NO_PROXY"),
+                0,
+                "{:?}",
+                cmd.args
+            );
+            assert_eq!(
+                after_separator(&cmd.args),
+                &[AGENT.to_string(), "--acp".to_string()],
+                "the agent sits right after `--`: {:?}",
+                cmd.args
+            );
+        }
+    }
+}
