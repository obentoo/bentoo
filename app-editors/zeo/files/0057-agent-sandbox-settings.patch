+// Fix round of 10.3 (live proof, defect #1): with filtered egress (`--allow-host`) ai-jail exports
+// its own `http_proxy` and forces `no_proxy` empty, so plain HTTP to a forwarded loopback port went
+// to ai-jail's proxy (HTTP 405) unless the client was told `--noproxy`. Wrapped the way a launch
+// with memory forwarded wraps it, a client honouring the proxy variables reaches the port directly.
+#[gpui::test]
+async fn real_ai_jail_forwarded_loopback_http_bypasses_the_jail_proxy(cx: &mut TestAppContext) {
+    let Some(bin) = ai_jail() else { return };
+    let binary = probed(&bin, cx).await;
+    if !binary.supports_forward_port {
+        eprintln!(
+            "skipped: {} ({}) offers no --forward-port, so no loopback port is forwarded and no \
+             proxy exclusion is added",
+            bin.display(),
+            binary.version
+        );
+        return;
+    }
+    let listener = TcpListener::bind("127.0.0.1:0").expect("listen");
+    let port = listener.local_addr().expect("addr").port();
+    // Never joined: before the fix the request goes to ai-jail's proxy and nothing connects here.
+    std::thread::spawn(move || {
+        if let Ok((mut stream, _)) = listener.accept() {
+            let mut request = [0u8; 1024];
+            let _ = stream.read(&mut request);
+            let _ = stream.write_all(
+                b"HTTP/1.1 200 OK\r\nContent-Length: 11\r\nConnection: close\r\n\r\nloopback-ok",
+            );
+        }
+    });
+    let p = project(true);
+    // No `--noproxy`: curl honours the jail's proxy variables, as an MCP HTTP client would.
+    let script = format!(
+        "env | grep -i proxy >&2; \
+         body=$(curl -s --max-time 10 http://127.0.0.1:{port}/mcp); \
+         test \"$body\" = loopback-ok && echo LOOPBACK-OK || {{ echo \"BOUNDARY: got [$body]\" >&2; exit 1; }}"
+    );
+    let mut cmd = keep_loopback_off_proxy(jailed(&bin, &p, &script, &[port], false));
+    cmd.env
+        .get_or_insert_with(HashMap::default)
+        .insert(NO_PROXY_CARRIER.to_string(), loopback_no_proxy([]));
+    let output = run(&p, &cmd);
+    let text = report("forwarded loopback HTTP run", &output);
+    assert!(output.status.success(), "{text}");
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("LOOPBACK-OK"),
+        "{text}"
+    );
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(
+        stderr.contains("http_proxy=http://127.0.0.1:"),
+        "the jail's proxy is still set (filtered egress), so the bypass is what was proved: {text}"
+    );
+}
