 //! Materialize with `#[cfg(test)] mod test_log_capture;` in `agent_servers.rs`.
 //! The `log` crate accepts one logger per process; nothing else in this crate's
 //! test binary installs one (the e2e helpers that call `env_logger::try_init`
-//! are `#[ignore]`d without the `e2e` feature).
+//! are `#[ignore]`d without the `e2e` feature). A test that needs its own view
+//! of the log (story 043's launch line) registers a forwarding target with
+//! [`install_forwarding`] instead of installing a second logger.
 
 use std::sync::{Mutex, Once};
 
 struct Capture;
 
 static RECORDS: Mutex<Vec<(log::Level, String)>> = Mutex::new(Vec::new());
+static FORWARDS: Mutex<Vec<&'static dyn log::Log>> = Mutex::new(Vec::new());
+/// Serialises every change of the process-wide level, which is only ever raised: tests run in
+/// parallel, and a test lowering it would silence another test's capture.
+static LEVEL: Mutex<()> = Mutex::new(());
 static CAPTURE: Capture = Capture;
 
 impl log::Log for Capture {
     fn enabled(&self, metadata: &log::Metadata) -> bool {
-        metadata.level() <= log::Level::Warn
+        metadata.level() <= log::max_level()
     }
 
     fn log(&self, record: &log::Record) {
-        if self.enabled(record.metadata()) {
+        if record.level() <= log::Level::Warn {
             RECORDS
                 .lock()
                 .unwrap_or_else(|poisoned| poisoned.into_inner())
                 .push((record.level(), record.args().to_string()));
         }
+        let forwards = FORWARDS
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .clone();
+        for forward in forwards {
+            forward.log(record);
+        }
     }
 
     fn flush(&self) {}
 }
 
-/// Installs the capturing logger once for the whole test process.
-pub(crate) fn install() {
+fn install_logger() {
     static ONCE: Once = Once::new();
     ONCE.call_once(|| {
         log::set_logger(&CAPTURE)
             .expect("another logger was installed before the thread-config log capture");
-        log::set_max_level(log::LevelFilter::Warn);
     });
 }
 
+fn raise_max_level(level: log::LevelFilter) {
+    let _guard = LEVEL
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if log::max_level() < level {
+        log::set_max_level(level);
+    }
+}
+
+/// Installs the capturing logger once for the whole test process.
+pub(crate) fn install() {
+    install_logger();
+    raise_max_level(log::LevelFilter::Warn);
+}
+
+/// Installs the capturing logger and forwards every record, at every level, to `logger` too.
+/// Registering the same logger twice forwards once.
+pub(crate) fn install_forwarding(logger: &'static dyn log::Log) {
+    install_logger();
+    {
+        let mut forwards = FORWARDS
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if !forwards
+            .iter()
+            .any(|known| std::ptr::addr_eq(*known as *const dyn log::Log, logger))
+        {
+            forwards.push(logger);
+        }
+    }
+    raise_max_level(log::LevelFilter::Trace);
+}
+
