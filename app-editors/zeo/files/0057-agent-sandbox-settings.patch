+//! A minimal MCP client for ai-memory's three tools (R6.1, R6.5, R6.6, R6.8, R6.9, R9.3, R9.4).
+//!
+//! It speaks JSON-RPC over `context_server`'s `HttpTransport` itself instead of going through
+//! `context_server::Client`: that client trace-logs every message it receives, which here would
+//! put page text in the log (R9.4).
+
+use std::fmt;
+use std::net::{Ipv4Addr, Ipv6Addr};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use context_server::transport::{HttpTransport, Transport as _, TransportError};
+use context_server::types::{self, CallToolResponse, ToolResponseContent};
+use futures::{FutureExt as _, Stream, StreamExt as _};
+use gpui::{AsyncApp, BackgroundExecutor};
+use http_client::HttpClient;
+use serde::Deserialize;
+use serde::de::DeserializeOwned;
+use serde_json::{Value, json};
+use url::{Host, Url};
+
+use super::MemoryScope;
+
+/// How long one call may take, session start included (R6.6).
+pub const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);
+
+const TOOL_STATUS: &str = "memory_status";
+const TOOL_RECENT: &str = "memory_recent";
+const TOOL_DELETE: &str = "memory_delete_page";
+
+const REJECTED_TOKEN: &str = "ai-memory rejected the auth token (HTTP 401)";
+const TOKEN_REQUIRED: &str =
+    "ai-memory requires an auth token (HTTP 401): set AI_MEMORY_AUTH_TOKEN";
+
+/// A server's error text can be a proxy's whole HTML page or a traceback: only its first line
+/// is shown.
+const ERROR_TEXT_MAX_CHARS: usize = 200;
+
+/// What the Memory section shows about the server and the scope (R6.1).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MemoryStatus {
+    pub server_version: String,
+    /// The endpoint without its userinfo, query and fragment.
+    pub endpoint: Url,
+    pub scope: MemoryScope,
+    /// `counts.pages_latest`: the live pages, not every stored version.
+    pub pages: u64,
+    pub sessions: u64,
+}
+
+/// One of the most recently updated pages (R6.3).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RecentPage {
+    pub title: String,
+    pub path: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum MemoryError {
+    /// The connection failed (R6.6).
+    Unreachable { endpoint: String },
+    /// No answer within [`REQUEST_TIMEOUT`] (R6.6).
+    Timeout { endpoint: String },
+    /// ai-memory has no such project in the workspace (R6.8).
+    UnknownProject { scope: MemoryScope },
+    /// The server's own error text (R6.6).
+    Server(String),
+    /// An answer Zeo cannot read. The parse error is not kept: it can quote the page text.
+    Malformed { tool: &'static str },
+}
+
+impl fmt::Display for MemoryError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            MemoryError::Unreachable { endpoint } => {
+                write!(f, "ai-memory is not reachable at {endpoint}")
+            }
+            MemoryError::Timeout { endpoint } => write!(
+                f,
+                "ai-memory is not reachable at {endpoint}: no answer within {} seconds",
+                REQUEST_TIMEOUT.as_secs()
+            ),
+            MemoryError::UnknownProject { scope } => {
+                write!(f, "No memory recorded for {scope} yet.")
+            }
+            MemoryError::Server(text) => f.write_str(text),
+            MemoryError::Malformed { tool } => {
+                write!(f, "ai-memory sent an answer to {tool} that Zeo cannot read")
+            }
+        }
+    }
+}
+
+impl std::error::Error for MemoryError {}
+
+impl MemoryError {
+    fn outcome(&self) -> &'static str {
+        match self {
+            MemoryError::Unreachable { .. } => "unreachable",
+            MemoryError::Timeout { .. } => "timeout",
+            MemoryError::UnknownProject { .. } => "unknown_project",
+            MemoryError::Server(_) => "server_error",
+            MemoryError::Malformed { .. } => "malformed",
+        }
+    }
+}
+
+/// The port to forward into the jail: only for `127.0.0.1`, `::1` and `localhost`, which are
+/// the hosts that mean "this machine" inside the jail too (R7.1, R7.3).
+pub fn forward_port(endpoint: &Url) -> Option<u16> {
+    is_loopback(endpoint)
+        .then(|| endpoint.port_or_known_default())
+        .flatten()
+}
+
+/// The endpoint as it may be shown or logged: without its userinfo, query and fragment, which
+/// can each carry a credential.
+pub fn display_endpoint(endpoint: &Url) -> String {
+    shown_endpoint(endpoint).to_string()
+}
+
+fn is_loopback(endpoint: &Url) -> bool {
+    match endpoint.host() {
+        Some(Host::Ipv4(address)) => address == Ipv4Addr::LOCALHOST,
+        Some(Host::Ipv6(address)) => address == Ipv6Addr::LOCALHOST,
+        Some(Host::Domain(domain)) => domain == "localhost",
+        None => false,
+    }
+}
+
+fn shown_endpoint(endpoint: &Url) -> Url {
+    let mut stripped = endpoint.clone();
+    stripped.set_query(None);
+    stripped.set_fragment(None);
+    // Both fail only for a URL without a host, which carries no userinfo either.
+    stripped.set_password(None).ok();
+    stripped.set_username("").ok();
+    stripped
+}
+
+/// The static request headers. `Debug` prints names only: the values carry the token.
+#[derive(Clone, Default)]
+struct RequestHeaders(Vec<(String, String)>);
+
+impl fmt::Debug for RequestHeaders {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_map()
+            .entries(self.0.iter().map(|(name, _)| (name, "<redacted>")))
+            .finish()
+    }
+}
+
+/// A client for one ai-memory endpoint. The MCP session starts on the first call and is dropped
+/// after a timeout or a transport failure, so the next call (a Refresh) starts a fresh one.
+pub struct MemoryClient {
+    endpoint: Url,
+    display_endpoint: String,
+    headers: RequestHeaders,
+    has_token: bool,
+    http_client: Arc<dyn HttpClient>,
+    executor: BackgroundExecutor,
+    session: futures::lock::Mutex<Option<Session>>,
+    next_id: AtomicU64,
+}
+
+impl fmt::Debug for MemoryClient {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("MemoryClient")
+            .field("endpoint", &self.display_endpoint)
+            .finish_non_exhaustive()
+    }
+}
+
+struct Session {
+    transport: HttpTransport,
+    responses: Pin<Box<dyn Stream<Item = String> + Send>>,
+    errors: Pin<Box<dyn Stream<Item = String> + Send>>,
+    server_version: String,
+}
+
+/// A failed call, and whether the session it ran on is still usable.
+struct Failure {
+    error: MemoryError,
+    drop_session: bool,
+}
+
+impl Failure {
+    fn keep(error: MemoryError) -> Self {
+        Self {
+            error,
+            drop_session: false,
+        }
+    }
+
+    fn drop_session(error: MemoryError) -> Self {
+        Self {
+            error,
+            drop_session: true,
+        }
+    }
+}
+
+#[derive(Deserialize)]
+struct RpcFrame {
+    id: Option<Value>,
+    method: Option<String>,
+    result: Option<Value>,
+    error: Option<RpcErrorBody>,
+}
+
+#[derive(Deserialize)]
+struct RpcErrorBody {
+    #[serde(default)]
+    message: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct InitializeAnswer {
+    protocol_version: String,
+    server_info: ServerInfo,
+}
+
+#[derive(Deserialize)]
+struct ServerInfo {
+    version: String,
+}
+
+#[derive(Deserialize)]
+struct StatusAnswer {
+    counts: StatusCounts,
+}
+
+#[derive(Deserialize)]
+struct StatusCounts {
+    pages_latest: u64,
+    sessions: u64,
+}
+
+#[derive(Deserialize)]
+struct RecentAnswer {
+    hits: Vec<RecentHit>,
+}
+
+#[derive(Deserialize)]
+struct RecentHit {
+    title: String,
+    path: String,
+}
+
+impl MemoryClient {
+    /// `auth_token` is the caller's `AI_MEMORY_AUTH_TOKEN`; it is sent as a bearer token and
+    /// never shown or logged (R6.9, R9.4).
+    pub fn new(
+        endpoint: Url,
+        auth_token: Option<String>,
+        http_client: Arc<dyn HttpClient>,
+        cx: &AsyncApp,
+    ) -> anyhow::Result<Self> {
+        let display_endpoint = display_endpoint(&endpoint);
+        if auth_token.is_some() && endpoint.scheme() == "http" && !is_loopback(&endpoint) {
+            anyhow::bail!(
+                "refusing to send the ai-memory auth token in clear text to {display_endpoint}: \
+                 use https or a loopback endpoint"
+            );
+        }
+        let has_token = auth_token.is_some();
+        let mut headers = RequestHeaders::default();
+        if let Some(token) = auth_token {
+            headers
+                .0
+                .push(("Authorization".to_string(), format!("Bearer {token}")));
+        }
+        Ok(Self {
+            endpoint,
+            display_endpoint,
+            headers,
+            has_token,
+            http_client,
+            executor: cx.background_executor().clone(),
+            session: futures::lock::Mutex::new(None),
+            next_id: AtomicU64::new(1),
+        })
+    }
+
+    /// The server version, the endpoint and the scope's page and session counts (R6.1).
+    pub async fn status(&self, scope: &MemoryScope) -> Result<MemoryStatus, MemoryError> {
+        let arguments = json!({ "workspace": scope.workspace, "project": scope.project });
+        let (answer, server_version) = self
+            .call::<StatusAnswer>(TOOL_STATUS, arguments, scope)
+            .await?;
+        Ok(MemoryStatus {
+            server_version,
+            endpoint: shown_endpoint(&self.endpoint),
+            scope: scope.clone(),
+            pages: answer.counts.pages_latest,
+            sessions: answer.counts.sessions,
+        })
+    }
+
+    /// The scope's most recently updated pages, in the server's order (R6.3).
+    pub async fn recent(
+        &self,
+        scope: &MemoryScope,
+        limit: usize,
+    ) -> Result<Vec<RecentPage>, MemoryError> {
+        let arguments =
+            json!({ "workspace": scope.workspace, "project": scope.project, "limit": limit });
+        let (answer, _) = self
+            .call::<RecentAnswer>(TOOL_RECENT, arguments, scope)
+            .await?;
+        Ok(answer
+            .hits
+            .into_iter()
+            .map(|hit| RecentPage {
+                title: hit.title,
+                path: hit.path,
+            })
+            .collect())
+    }
+
+    /// Deletes exactly `path` in `scope` (R6.5).
+    pub async fn delete(&self, scope: &MemoryScope, path: &str) -> Result<(), MemoryError> {
+        let arguments =
+            json!({ "path": path, "workspace": scope.workspace, "project": scope.project });
+        self.call::<Value>(TOOL_DELETE, arguments, scope).await?;
+        Ok(())
+    }
+
+    /// One tool call under one [`REQUEST_TIMEOUT`] timer, session start included, logged as one
+    /// line that carries no argument, answer or token (R9.3, R9.4).
+    async fn call<T: DeserializeOwned>(
+        &self,
+        tool: &'static str,
+        arguments: Value,
+        scope: &MemoryScope,
+    ) -> Result<(T, String), MemoryError> {
+        let started = self.executor.now();
+        let timeout = self.executor.timer(REQUEST_TIMEOUT);
+        let result = futures::select_biased! {
+            result = self.call_in_session(tool, arguments, scope).fuse() => result,
+            _ = timeout.fuse() => Err(Failure::drop_session(MemoryError::Timeout {
+                endpoint: self.display_endpoint.clone(),
+            })),
+        };
+        let elapsed_ms = self
+            .executor
+            .now()
+            .saturating_duration_since(started)
+            .as_millis();
+        match result {
+            Ok(answer) => {
+                log::info!("agent_memory event=call tool={tool} outcome=ok ms={elapsed_ms}");
+                Ok(answer)
+            }
+            Err(failure) => {
+                if failure.drop_session {
+                    *self.session.lock().await = None;
+                }
+                log::warn!(
+                    "agent_memory event=call tool={tool} outcome={} ms={elapsed_ms}",
+                    failure.error.outcome()
+                );
+                Err(failure.error)
+            }
+        }
+    }
+
+    async fn call_in_session<T: DeserializeOwned>(
+        &self,
+        tool: &'static str,
+        arguments: Value,
+        scope: &MemoryScope,
+    ) -> Result<(T, String), Failure> {
+        let mut guard = self.session.lock().await;
+        let session = match &mut *guard {
+            Some(session) => session,
+            empty => empty.insert(self.start_session(tool).await?),
+        };
+        let params = json!({ "name": tool, "arguments": arguments });
+        let result = match self.request(session, "tools/call", params, tool).await? {
+            Ok(result) => result,
+            Err(message) => return Err(Failure::keep(self.tool_rpc_error(message, scope))),
+        };
+        let answer = parse_tool_result(tool, result)?;
+        Ok((answer, session.server_version.clone()))
+    }
+
+    async fn start_session(&self, tool: &'static str) -> Result<Session, Failure> {
+        let transport = HttpTransport::new(
+            self.http_client.clone(),
+            self.endpoint.to_string(),
+            self.headers.0.iter().cloned().collect(),
+            self.executor.clone(),
+        );
+        let mut session = Session {
+            responses: transport.receive(),
+            errors: transport.receive_err(),
+            transport,
+            server_version: String::new(),
+        };
+        let params = json!({
+            "protocolVersion": types::LATEST_PROTOCOL_VERSION,
+            "capabilities": {},
+            "clientInfo": { "name": "zeo-agent-memory", "version": env!("CARGO_PKG_VERSION") },
+        });
+        let result = match self
+            .request(&mut session, "initialize", params, tool)
+            .await?
+        {
+            Ok(result) => result,
+            Err(message) => {
+                return Err(Failure::drop_session(MemoryError::Server(bounded(
+                    &message,
+                ))));
+            }
+        };
+        let answer: InitializeAnswer = serde_json::from_value(result)
+            .map_err(|_| Failure::drop_session(MemoryError::Malformed { tool }))?;
+        session
+            .transport
+            .set_protocol_version(&answer.protocol_version);
+        session.server_version = answer.server_info.version;
+        let initialized = json!({ "jsonrpc": "2.0", "method": "notifications/initialized" });
+        session
+            .transport
+            .send(initialized.to_string())
+            .await
+            .map_err(|error| self.transport_failure(error))?;
+        // The transport queues an HTTP error on a notification instead of returning it; left
+        // there, it would be blamed on the first tool call.
+        if let Some(Some(error)) = session.errors.next().now_or_never() {
+            return Err(self.http_failure(&error));
+        }
+        Ok(session)
+    }
+
+    /// Sends one request and waits for the answer with its id. `Ok(Err(message))` is a JSON-RPC
+    /// error from the server.
+    async fn request(
+        &self,
+        session: &mut Session,
+        method: &str,
+        params: Value,
+        tool: &'static str,
+    ) -> Result<Result<Value, String>, Failure> {
+        drop_stale_errors(session);
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        let message = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        session
+            .transport
+            .send(message.to_string())
+            .await
+            .map_err(|error| self.transport_failure(error))?;
+        loop {
+            futures::select_biased! {
+                frame = session.responses.next().fuse() => {
+                    let Some(frame) = frame else {
+                        return Err(Failure::drop_session(MemoryError::Unreachable {
+                            endpoint: self.display_endpoint.clone(),
+                        }));
+                    };
+                    let frame: RpcFrame = serde_json::from_str(&frame)
+                        .map_err(|_| Failure::keep(MemoryError::Malformed { tool }))?;
+                    if frame.method.is_some() || frame.id != Some(Value::from(id)) {
+                        continue;
+                    }
+                    if let Some(error) = frame.error {
+                        return Ok(Err(error.message));
+                    }
+                    return frame
+                        .result
+                        .map(Ok)
+                        .ok_or(Failure::keep(MemoryError::Malformed { tool }));
+                }
+                error = session.errors.next().fuse() => {
+                    let Some(error) = error else {
+                        return Err(Failure::drop_session(MemoryError::Unreachable {
+                            endpoint: self.display_endpoint.clone(),
+                        }));
+                    };
+                    return Err(self.http_failure(&error));
+                }
+            }
+        }
+    }
+
+    fn transport_failure(&self, error: anyhow::Error) -> Failure {
+        if let Some(TransportError::AuthRequired { .. }) = error.downcast_ref::<TransportError>() {
+            return Failure::drop_session(self.unauthorized());
+        }
+        Failure::drop_session(MemoryError::Unreachable {
+            endpoint: self.display_endpoint.clone(),
+        })
+    }
+
+    fn tool_rpc_error(&self, message: String, scope: &MemoryScope) -> MemoryError {
+        // ai-memory's text is "project '<p>' not found in workspace '<w>'"; a page or a workspace
+        // that is not found is a server error, not "no memory recorded" (R6.8).
+        if message.starts_with("project '") && message.contains("not found in workspace") {
+            MemoryError::UnknownProject {
+                scope: scope.clone(),
+            }
+        } else {
+            MemoryError::Server(bounded(&message))
+        }
+    }
+
+    /// A 401 blames the token only when one was sent.
+    fn unauthorized(&self) -> MemoryError {
+        MemoryError::Server(
+            if self.has_token {
+                REJECTED_TOKEN
+            } else {
+                TOKEN_REQUIRED
+            }
+            .to_string(),
+        )
+    }
+
+    /// The transport's id-less `HTTP <status>: <body>` error. The session is dropped.
+    fn http_failure(&self, error: &str) -> Failure {
+        let Some((status, body)) = error
+            .strip_prefix("HTTP ")
+            .and_then(|rest| rest.split_once(": "))
+        else {
+            return Failure::drop_session(MemoryError::Server(bounded(error)));
+        };
+        let code = status.split_whitespace().next().unwrap_or(status);
+        if code == "401" {
+            return Failure::drop_session(self.unauthorized());
+        }
+        Failure::drop_session(MemoryError::Server(bounded(&format!(
+            "HTTP {code}: {body}"
+        ))))
+    }
+}
+
+/// `isError` is the server's text; otherwise `content[0].text` is the tool's JSON answer
+/// (ai-memory sends no `structuredContent`).
+fn parse_tool_result<T: DeserializeOwned>(tool: &'static str, result: Value) -> Result<T, Failure> {
+    let malformed = || Failure::keep(MemoryError::Malformed { tool });
+    let response: CallToolResponse = serde_json::from_value(result).map_err(|_| malformed())?;
+    if response.is_error == Some(true) {
+        return Err(Failure::keep(MemoryError::Server(bounded(
+            &response.text_contents(),
+        ))));
+    }
+    let Some(ToolResponseContent::Text { text }) = response.content.first() else {
+        return Err(malformed());
+    };
+    serde_json::from_str(text).map_err(|_| malformed())
+}
+
+/// Discards transport errors queued before this request: an id-less error cannot be matched to
+/// a request, so one left over would be blamed on the next call.
+fn drop_stale_errors(session: &mut Session) {
+    let mut dropped = 0;
+    while let Some(Some(_)) = session.errors.next().now_or_never() {
+        dropped += 1;
+    }
+    if dropped > 0 {
+        log::debug!("agent_memory event=stale_transport_errors dropped={dropped}");
+    }
+}
+
+/// The first line, at most [`ERROR_TEXT_MAX_CHARS`] characters.
+fn bounded(text: &str) -> String {
+    text.lines()
+        .next()
+        .unwrap_or_default()
+        .trim_end()
+        .chars()
+        .take(ERROR_TEXT_MAX_CHARS)
+        .collect()
+}
