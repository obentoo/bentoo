+// --- outdated (A3) ------------------------------------------------------------------------------
+
+#[test]
+fn probe_outdated_compares_semver_not_strings() {
+    assert_eq!(MIN_SAFE, v("2.4.0"));
+    assert!(!is_outdated(&v("10.0.0")), "10.0.0 is newer than 2.4.0");
+    assert!(
+        is_outdated(&v("2.4.0-rc.1")),
+        "a pre-release precedes the fixing release"
+    );
+    assert!(is_outdated(&v("2.3.9")));
+    assert!(!is_outdated(&v("2.4.0")));
+    assert!(!is_outdated(&v("2.7.0")));
+    assert!(!is_outdated(&v("2.8.1")));
+}
