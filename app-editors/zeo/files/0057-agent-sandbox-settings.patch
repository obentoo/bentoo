+
+/// How many recent pages the section lists (R6.3).
+const RECENT_LIMIT: usize = 10;
+const MEMORY_OFF: &str = "Memory is off.";
+const MEMORY_NO_PROJECT: &str = "Open a local project to see its memory.";
+const MEMORY_INVALID_ENDPOINT: &str =
+    "The ai-memory endpoint in agent_memory.endpoint is not a valid URL.";
+const FORWARD_PORT_EXPOSURE_NOTE: &str = "While the jail is on, --forward-port exposes the whole ai-memory service to the jailed agent, not only this project's pages.";
+
+/// The Memory section (R6, R7.3): the `agent_memory.enabled` switch, ai-memory's status for the
+/// project's scope, its recent pages, and Forget. While memory is off it makes no call at all.
+pub(crate) struct AgentMemorySection {
+    root: Option<PathBuf>,
+    /// The settings the section last loaded with; a change to them reloads it.
+    memory: AgentMemorySettings,
+    scope: Option<MemoryScope>,
+    status: Option<MemoryStatus>,
+    pages: Vec<RecentPage>,
+    loading: bool,
+    error: Option<String>,
+    forgetting: Option<String>,
+    forget_error: Option<String>,
+    write_error: Option<String>,
+    /// Built inside the load task, for the endpoint it names, and reused until that changes.
+    client: Option<(String, Arc<MemoryClient>)>,
+    load_task: Option<Task<()>>,
+    forget_task: Option<Task<()>>,
+    write_task: Option<Task<()>>,
+    /// The scroll container of the page rendering the section, set on each render of the page.
+    scroll_handle: ScrollHandle,
+    controls: RevealOnFocus,
+    _settings_subscription: Subscription,
+}
+
+impl AgentMemorySection {
+    pub(crate) fn new(root: Option<PathBuf>, _window: &mut Window, cx: &mut Context<Self>) -> Self {
+        let settings_subscription = cx.observe_global::<SettingsStore>(|this, cx| {
+            if *AgentMemorySettings::get_global(cx) != this.memory {
+                this.refresh(cx);
+            }
+        });
+        let mut this = Self {
+            root,
+            memory: AgentMemorySettings::get_global(cx).clone(),
+            scope: None,
+            status: None,
+            pages: Vec::new(),
+            loading: false,
+            error: None,
+            forgetting: None,
+            forget_error: None,
+            write_error: None,
+            client: None,
+            load_task: None,
+            forget_task: None,
+            write_task: None,
+            scroll_handle: ScrollHandle::new(),
+            controls: RevealOnFocus::default(),
+            _settings_subscription: settings_subscription,
+        };
+        this.refresh(cx);
+        this
+    }
+
+    /// Asks ai-memory for the status and the recent pages, once. Nothing retries on its own: an
+    /// error stays shown until the next Refresh or settings change (R6.6).
+    pub(crate) fn refresh(&mut self, cx: &mut Context<Self>) {
+        self.memory = AgentMemorySettings::get_global(cx).clone();
+        self.forget_error = None;
+        if !self.memory.enabled {
+            self.turn_off();
+            cx.notify();
+            return;
+        }
+        let Some(root) = self.root.clone() else {
+            self.load_task = None;
+            self.loading = false;
+            cx.notify();
+            return;
+        };
+        self.loading = true;
+        cx.notify();
+        let fs = <dyn Fs>::global(cx);
+        let scope = cx.background_spawn(async move { memory::resolve_scope(&root, fs).await });
+        let endpoint = self.memory.endpoint.clone();
+        self.load_task = Some(cx.spawn(async move |this, cx| {
+            let scope = scope.await;
+            let client = client_for(&this, &endpoint, cx);
+            let outcome = match client {
+                Ok(client) => match client.status(&scope).await {
+                    Ok(status) => {
+                        let pages = client.recent(&scope, RECENT_LIMIT).await;
+                        Ok((status, pages))
+                    }
+                    Err(error) => Err(error.to_string()),
+                },
+                Err(error) => Err(error),
+            };
+            this.update(cx, |this, cx| {
+                this.scope = Some(scope);
+                this.loading = false;
+                match outcome {
+                    Ok((status, Ok(pages))) => {
+                        this.status = Some(status);
+                        this.pages = pages;
+                        this.error = None;
+                    }
+                    Ok((status, Err(error))) => {
+                        this.status = Some(status);
+                        this.pages.clear();
+                        this.error = Some(error.to_string());
+                    }
+                    Err(error) => {
+                        this.status = None;
+                        this.pages.clear();
+                        this.error = Some(error);
+                    }
+                }
+                cx.notify();
+            })
+            .log_err();
+        }));
+    }
+
+    /// Asks "Forget <path>?" and deletes the page in the scope shown, only on Forget (R6.4,
+    /// R6.5, R6.10), then reloads the list.
+    pub(crate) fn forget(&mut self, path: &str, window: &mut Window, cx: &mut Context<Self>) {
+        if self.forgetting.is_some() {
+            return;
+        }
+        let Some(scope) = self.scope.clone() else {
+            return;
+        };
+        let answer = confirm::confirm_forget(path, window, cx);
+        let path = path.to_string();
+        self.forgetting = Some(path.clone());
+        self.forget_error = None;
+        cx.notify();
+        self.forget_task = Some(cx.spawn(async move |this, cx| {
+            let confirmed = answer.await;
+            // Memory may have been turned off while the prompt was open.
+            let memory = cx.update(|cx| AgentMemorySettings::get_global(cx).clone());
+            let outcome = if confirmed && memory.enabled {
+                match client_for(&this, &memory.endpoint, cx) {
+                    Ok(client) => Some(
+                        client
+                            .delete(&scope, &path)
+                            .await
+                            .map_err(|error| error.to_string()),
+                    ),
+                    Err(error) => Some(Err(error)),
+                }
+            } else {
+                None
+            };
+            this.update(cx, |this, cx| {
+                this.forgetting = None;
+                match outcome {
+                    Some(Ok(())) => this.refresh(cx),
+                    Some(Err(error)) => {
+                        this.forget_error = Some(format!("Could not forget {path}: {error}"));
+                    }
+                    None => {}
+                }
+                cx.notify();
+            })
+            .log_err();
+        }));
+    }
+
+    /// What the section shows about the server and the scope (R6.1), once ai-memory answered.
+    pub(crate) fn status_line(&self) -> Option<String> {
+        self.status.as_ref().map(|status| {
+            format!(
+                "ai-memory {} at {} · {}: {} pages, {} sessions",
+                status.server_version,
+                display_endpoint(&status.endpoint),
+                status.scope,
+                status.pages,
+                status.sessions
+            )
+        })
+    }
+
+    /// The R6.6/R6.8 text of the last load, shown in place.
+    pub(crate) fn error_line(&self) -> Option<String> {
+        self.error.clone()
+    }
+
+    pub(crate) fn pages(&self) -> &[RecentPage] {
+        &self.pages
+    }
+
+    /// The R7.3 note, beside the switch.
+    pub(crate) fn endpoint_note(&self) -> Option<String> {
+        memory_endpoint_note(&self.memory)
+    }
+
+    /// Drops the client and every call in flight, so nothing reaches ai-memory while off (R6.2).
+    fn turn_off(&mut self) {
+        self.client = None;
+        self.load_task = None;
+        self.forget_task = None;
+        self.loading = false;
+        self.forgetting = None;
+        self.scope = None;
+        self.status = None;
+        self.pages.clear();
+        self.error = None;
+        self.forget_error = None;
+    }
+
+    /// Writes `agent_memory.enabled`. Turning memory off asks nothing: unlike the jail, it only
+    /// stops the agents from reading and writing memory, and turning it back on restores them.
+    fn set_enabled(&mut self, enabled: bool, cx: &mut Context<Self>) {
+        self.write_error = None;
+        let receiver = cx
+            .global::<SettingsStore>()
+            .update_settings_file_with_completion(<dyn Fs>::global(cx), move |content, _| {
+                content.agent_memory.get_or_insert_default().enabled = Some(enabled);
+            });
+        self.write_task = Some(cx.spawn(async move |this, cx| {
+            let error = match receiver.await {
+                Ok(Ok(())) => return,
+                Ok(Err(error)) => error,
+                Err(oneshot::Canceled) => {
+                    anyhow::anyhow!("the settings writer stopped before saving")
+                }
+            };
+            let error = first_line(&error);
+            log::error!(
+                "agent_memory event=settings_write_failed key=\"agent_memory.enabled\" error={error:?}"
+            );
+            this.update(cx, |this, cx| {
+                this.write_error = Some(format!("Could not save the agent memory setting: {error}"));
+                cx.notify();
+            })
+            .log_err();
+        }));
+        cx.notify();
+    }
+
+    /// `control`, wrapped by the section's [`RevealOnFocus`] under `key`.
+    fn reveal(
+        &mut self,
+        key: impl Into<SharedString>,
+        control: impl IntoElement,
+        cx: &mut App,
+    ) -> AnyElement {
+        let scroll_handle = self.scroll_handle.clone();
+        self.controls.wrap(key, &scroll_handle, control, cx)
+    }
+
+    fn render_body(&mut self, cx: &mut Context<Self>) -> AnyElement {
+        if !self.memory.enabled {
+            return muted_label(MEMORY_OFF).into_any_element();
+        }
+        if self.root.is_none() {
+            return muted_label(MEMORY_NO_PROJECT).into_any_element();
+        }
+        let scope_line = self.scope.as_ref().map(|scope| {
+            let source = match scope.resolved_by {
+                ResolvedBy::Marker => "from .ai-memory.toml",
+                ResolvedBy::Upstream => "from the upstream remote",
+                ResolvedBy::Origin => "from the origin remote",
+                ResolvedBy::Folder => "from the folder name; add .ai-memory.toml to choose another",
+            };
+            format!("Scope: {scope} ({source})")
+        });
+        let state_line = match (self.loading, self.status_line()) {
+            (_, Some(status)) => Some(status),
+            (true, None) => Some("Asking ai-memory…".to_string()),
+            (false, None) => None,
+        };
+        let mut rows = Vec::with_capacity(self.pages.len());
+        for (index, page) in self.pages.clone().into_iter().enumerate() {
+            let forget_label = format!("Forget {}", page.path);
+            let forget_id = format!("agent-memory-forget-{index}");
+            let forget = IconButton::new(SharedString::from(forget_id.clone()), IconName::Trash)
+                .icon_size(IconSize::Small)
+                .icon_color(Color::Muted)
+                .tab_index(0_isize)
+                .disabled(self.forgetting.is_some())
+                .aria_label(forget_label.clone())
+                .tooltip(Tooltip::text(forget_label))
+                .on_click(cx.listener({
+                    let path = page.path.clone();
+                    move |this, _, window, cx| this.forget(&path, window, cx)
+                }));
+            let forget = self.reveal(forget_id, forget, cx);
+            rows.push(
+                h_flex()
+                    .gap_2()
+                    .justify_between()
+                    .child(
+                        v_flex()
+                            .min_w_0()
+                            .child(Label::new(page.title).size(LabelSize::Small))
+                            .child(
+                                Label::new(page.path)
+                                    .size(LabelSize::Small)
+                                    .color(Color::Muted)
+                                    .buffer_font(cx),
+                            ),
+                    )
+                    .child(forget),
+            );
+        }
+        let refresh = Button::new("agent-memory-refresh", "Refresh")
+            .label_size(LabelSize::Small)
+            .tab_index(0_isize)
+            .tooltip(Tooltip::text("Ask ai-memory again"))
+            .on_click(cx.listener(|this, _, _, cx| this.refresh(cx)));
+        let refresh = self.reveal("agent-memory-refresh", refresh, cx);
+        let has_pages = !self.pages().is_empty();
+        let error = self.error_line();
+        v_flex()
+            .gap_2()
+            .when_some(state_line, |this, line| {
+                this.child(Label::new(line).size(LabelSize::Small).buffer_font(cx))
+            })
+            .when_some(scope_line, |this, line| this.child(muted_label(line)))
+            .when_some(error.clone(), |this, error| {
+                this.child(Label::new(error).size(LabelSize::Small).color(Color::Error))
+            })
+            .child(
+                h_flex()
+                    .justify_between()
+                    .child(Label::new("Recent Pages"))
+                    .child(refresh),
+            )
+            .child(
+                v_flex()
+                    .gap_1p5()
+                    .children(rows)
+                    .when(!has_pages && !self.loading && error.is_none(), |this| {
+                        this.child(muted_label("No pages yet."))
+                    }),
+            )
+            .when_some(self.forget_error.clone(), |this, error| {
+                this.child(Label::new(error).size(LabelSize::Small).color(Color::Error))
+            })
+            .into_any_element()
+    }
+}
+
+/// The client for `endpoint`: the one already built, or a new one, built here because it needs
+/// the async context. An unparsable endpoint is never echoed: it may carry a token.
+fn client_for(
+    this: &WeakEntity<AgentMemorySection>,
+    endpoint: &str,
+    cx: &mut AsyncApp,
+) -> Result<Arc<MemoryClient>, String> {
+    let cached = this
+        .read_with(cx, |this, _| {
+            this.client
+                .as_ref()
+                .filter(|(built_for, _)| built_for == endpoint)
+                .map(|(_, client)| client.clone())
+        })
+        .map_err(|error| error.to_string())?;
+    if let Some(client) = cached {
+        return Ok(client);
+    }
+    let url = url::Url::parse(endpoint).map_err(|_| MEMORY_INVALID_ENDPOINT.to_string())?;
+    let http_client = cx.update(|cx| cx.http_client());
+    let auth_token = std::env::var("AI_MEMORY_AUTH_TOKEN").ok();
+    let client = Arc::new(
+        MemoryClient::new(url, auth_token, http_client, cx).map_err(|error| first_line(&error))?,
+    );
+    this.update(cx, |this, _| {
+        this.client = Some((endpoint.to_string(), client.clone()));
+    })
+    .map_err(|error| error.to_string())?;
+    Ok(client)
+}
+
+fn muted_label(text: impl Into<SharedString>) -> Label {
+    Label::new(text).size(LabelSize::Small).color(Color::Muted)
+}
+
+impl Render for AgentMemorySection {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let body = self.render_body(cx);
+        let memory_switch = SwitchField::new(
+            "agent-memory-enabled",
+            Some("Let the agents use ai-memory"),
+            Some(
+                "The Claude agents read and write this project's ai-memory pages. Turning it off asks nothing: it is not the jail."
+                    .into(),
+            ),
+            self.memory.enabled,
+            cx.listener(|this, toggle: &ToggleState, _, cx| {
+                this.set_enabled(*toggle == ToggleState::Selected, cx)
+            }),
+        )
+        .tab_index(0);
+        let memory_switch = self.reveal("agent-memory-enabled", memory_switch, cx);
+        v_flex()
+            .gap_4()
+            .child(SettingsSectionHeader::new("Memory").no_padding(true))
+            .child(memory_switch)
+            .child(muted_label(FORWARD_PORT_EXPOSURE_NOTE))
+            .when_some(self.endpoint_note(), |this, note| {
+                this.child(
+                    Label::new(note)
+                        .size(LabelSize::Small)
+                        .color(Color::Warning),
+                )
+            })
+            .when_some(self.write_error.clone(), |this, error| {
+                this.child(Label::new(error).size(LabelSize::Small).color(Color::Error))
+            })
+            .child(body)
+    }
+}
+
+/// The section of `root`, kept across frames of whichever page renders it.
+fn memory_section(
+    root: Option<PathBuf>,
+    scroll_handle: &ScrollHandle,
+    window: &mut Window,
+    cx: &mut App,
+) -> Entity<AgentMemorySection> {
+    let key = format!(
+        "agent-memory-section-{}",
+        root.as_deref()
+            .map(|root| root.to_string_lossy())
+            .unwrap_or_default()
+    );
+    let section = window.use_keyed_state(SharedString::from(key), cx, move |window, cx| {
+        AgentMemorySection::new(root, window, cx)
+    });
+    section.update(cx, |section, _| {
+        section.scroll_handle = scroll_handle.clone();
+    });
+    section
+}
+
+/// The root of the settings window's active local project.
+fn active_root(settings_window: &SettingsWindow, cx: &App) -> Option<PathBuf> {
+    settings_window
+        .active_project(cx)
+        .filter(|project| project.read(cx).is_local())
+        .and_then(|project| launch::project_root(&project, cx))
+}
+
+/// The "Agent Memory (ai-memory)" sub-page: the Memory section alone, so that
+/// `OpenSettingsAt { path: "agent_memory" }` lands on it (a sub-page cannot scroll to a section).
+pub(crate) fn render_agent_memory_page(
+    settings_window: &SettingsWindow,
+    scroll_handle: &ScrollHandle,
+    window: &mut Window,
+    cx: &mut Context<SettingsWindow>,
+) -> AnyElement {
+    let section = memory_section(active_root(settings_window, cx), scroll_handle, window, cx);
+    v_flex()
+        .id("agent-memory-page")
+        .debug_selector(|| "agent-memory-page".into())
+        .size_full()
+        .pt_2p5()
+        .px_8()
+        .pb_16()
+        .overflow_y_scroll()
+        .track_scroll(scroll_handle)
+        .child(section)
+        .into_any_element()
+}
