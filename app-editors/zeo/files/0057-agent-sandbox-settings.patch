+    #[test]
+    fn agent_jail_page_preview_keeps_loopback_off_the_proxy_only_when_forwarded() {
+        let policy = agent_sandbox::ProjectPolicy {
+            enabled: true,
+            rw_maps: Vec::new(),
+            allow_hosts: vec!["anthropic.com".to_string()],
+        };
+        let jail = Path::new("/usr/bin/ai-jail");
+        let preview = |memory: &AgentMemorySettings, supports: bool| {
+            preview_command(
+                &policy,
+                Path::new(ROOT),
+                "/home/u/.claude-jailed",
+                Some(jail),
+                memory,
+                supports,
+            )
+        };
+        let forwarded = preview(&memory(true, LOOPBACK), true);
+        for needle in [
+            "--forward-port 49374",
+            "--env ZEO_NO_PROXY",
