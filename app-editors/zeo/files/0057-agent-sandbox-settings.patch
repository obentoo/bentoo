@@ -0,0 +1,366 @@
+// Story 043, task 1.2 — user-only settings, defaults and the per-project policy (R2.1, R2.2,
+// R2.3, R9.4; A1, A5, A6, A8). Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod settings_tests;
+//
+// Validation filter: `settings` (every test path is `settings_tests::…`).
+//
+// Contract (design.md §agent_sandbox::settings, §Data Models). Assumed signatures — adjust the
+// `use` and field access only, never the assertions:
+//   - `crate::AgentSandboxSettings: settings::Settings`, `get_global(cx)`, with
+//     `project_policy(&self, root: &Path) -> ProjectPolicy` and
+//     `effective_enabled(&self, root: &Path) -> bool`; public `ai_jail_path: Option<_>` and
+//     `claude_config_dir` (String or PathBuf).
+//   - `crate::ProjectPolicy { enabled: bool, rw_maps: Vec<String|PathBuf>, allow_hosts: Vec<String> }`
+//     holding the raw (unvalidated) merge of the defaults with `projects[root]`.
+//   - `crate::AgentMemorySettings: settings::Settings` with `enabled: bool` and `endpoint`
+//     (String or Url; compared through `to_string()`).
+//   - `crate::init(cx)` registers both settings and the R2.2 project-file watcher.
+//
+// Hostile halves first:
+//   - project key, wrongly COLLAPSE: an entry for `/w/app` must not switch on `/w/app2` (string
+//     prefix) nor `/w/app/sub` (a child path is another root).
+//   - merge, wrongly COLLAPSE: `api.anthropic.com` beside `anthropic.com` stays two entries;
+//     wrongly SPLIT: a host or map listed in both the defaults and the project appears once.
+//   - project file, both directions: a project `.zed/settings.json` can neither turn the jail on
+//     nor off, nor turn memory off; the warning fires for `agent_sandbox`/`agent_memory` only,
+//     not for look-alike keys (`agent_sandboxes`, `agent_memory_notes`, `agent_servers`).
+
+use std::ffi::OsStr;
+use std::path::Path;
+use std::sync::Arc;
+
+use fs::FakeFs;
+use gpui::{TestAppContext, UpdateGlobal as _};
+use project::Project;
+use serde_json::json;
+use settings::{Settings as _, SettingsStore};
+
+use crate::test_log_capture::LogCapture;
+use crate::{AgentMemorySettings, AgentSandboxSettings};
+
+fn init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        crate::init(cx);
+    });
+}
+
+fn set_user_settings(json: serde_json::Value, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn strs<T: AsRef<OsStr>>(items: &[T]) -> Vec<String> {
+    items
+        .iter()
+        .map(|item| item.as_ref().to_string_lossy().into_owned())
+        .collect()
+}
+
+fn enabled_for(root: &str, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| AgentSandboxSettings::get_global(cx).effective_enabled(Path::new(root)))
+}
+
+fn hosts_for(root: &str, cx: &mut TestAppContext) -> Vec<String> {
+    cx.update(|cx| {
+        strs(
+            &AgentSandboxSettings::get_global(cx)
+                .project_policy(Path::new(root))
+                .allow_hosts,
+        )
+    })
+}
+
+fn maps_for(root: &str, cx: &mut TestAppContext) -> Vec<String> {
+    cx.update(|cx| {
+        strs(
+            &AgentSandboxSettings::get_global(cx)
+                .project_policy(Path::new(root))
+                .rw_maps,
+        )
+    })
+}
+
+// ---------------------------------------------------------------------------------------------
+// R2.3 — keyed by the absolute root; a project without an entry follows the default
+// ---------------------------------------------------------------------------------------------
+
+#[gpui::test]
+fn settings_project_entry_does_not_leak_to_prefix_or_child_roots(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": { "enabled": false, "projects": { "/w/app": { "enabled": true } } } }),
+        cx,
+    );
+    assert!(
+        !enabled_for("/w/app2", cx),
+        "an entry for /w/app must not apply to /w/app2 (string prefix)"
+    );
+    assert!(
+        !enabled_for("/w/app/sub", cx),
+        "an entry for /w/app must not apply to the root /w/app/sub"
+    );
+    assert!(enabled_for("/w/app", cx), "the keyed project itself is on");
+}
+
+#[gpui::test]
+fn settings_project_entry_off_overrides_default_on(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": { "enabled": true, "projects": { "/w/app": { "enabled": false } } } }),
+        cx,
+    );
+    assert!(!enabled_for("/w/app", cx), "the project's own off wins");
+    assert!(
+        enabled_for("/w/other", cx),
+        "a project without an entry follows the default (on)"
+    );
+}
+
+#[gpui::test]
+fn settings_fresh_install_defaults(cx: &mut TestAppContext) {
+    init(cx);
+    assert!(
+        !enabled_for("/w/app", cx),
+        "the default switch is off on a fresh install (R2.3)"
+    );
+    assert_eq!(
+        hosts_for("/w/app", cx),
+        vec![
+            "anthropic.com".to_string(),
+            "platform.claude.com".to_string()
+        ],
+        "allowed-host defaults are the measured login minimum (A8), in this order"
+    );
+    assert!(
+        maps_for("/w/app", cx).is_empty(),
+        "no writable folder by default"
+    );
+    cx.update(|cx| {
+        let sandbox = AgentSandboxSettings::get_global(cx);
+        assert!(
+            sandbox.ai_jail_path.is_none(),
+            "null ai_jail_path → PATH lookup"
+        );
+        assert!(
+            sandbox.claude_config_dir.ends_with(".claude-jailed"),
+            "the Claude config dir defaults to ~/.claude-jailed (A5)"
+        );
+        let memory = AgentMemorySettings::get_global(cx);
+        assert!(memory.enabled, "memory is on by default (A6)");
+        assert_eq!(memory.endpoint.to_string(), "http://127.0.0.1:49374/mcp");
+    });
+}
+
+// ---------------------------------------------------------------------------------------------
+// R2.3/R1.3 — defaults ∪ project, without duplicates, in the configured order
+// ---------------------------------------------------------------------------------------------
+
+#[gpui::test]
+fn settings_merge_keeps_near_identical_entries_apart(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": {
+            "allow_hosts": ["anthropic.com"],
+            "rw_maps": ["/data/shared"],
+            "projects": { "/w/app": {
+                "allow_hosts": ["api.anthropic.com"],
+                "rw_maps": ["/data/shared-2"]
+            } }
+        } }),
+        cx,
+    );
+    assert_eq!(
+        hosts_for("/w/app", cx),
+        vec!["anthropic.com".to_string(), "api.anthropic.com".to_string()]
+    );
+    assert_eq!(
+        maps_for("/w/app", cx),
+        vec!["/data/shared".to_string(), "/data/shared-2".to_string()]
+    );
+}
+
+#[gpui::test]
+fn settings_merge_collapses_entries_listed_twice(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": {
+            "allow_hosts": ["anthropic.com", "platform.claude.com"],
+            "rw_maps": ["/data/shared"],
+            "projects": { "/w/app": {
+                "allow_hosts": ["registry.npmjs.org", "anthropic.com", "registry.npmjs.org"],
+                "rw_maps": ["/data/shared", "/data/cache"]
+            } }
+        } }),
+        cx,
+    );
+    assert_eq!(
+        hosts_for("/w/app", cx),
+        vec![
+            "anthropic.com".to_string(),
+            "platform.claude.com".to_string(),
+            "registry.npmjs.org".to_string()
+        ],
+        "defaults first, then the project's own, each once"
+    );
+    assert_eq!(
+        maps_for("/w/app", cx),
+        vec!["/data/shared".to_string(), "/data/cache".to_string()]
+    );
+}
+
+#[gpui::test]
+fn settings_merge_keeps_configured_order_not_sorted(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": {
+            "allow_hosts": [],
+            "projects": { "/w/app": { "allow_hosts": ["z.example.com", "a.example.com"] } }
+        } }),
+        cx,
+    );
+    assert_eq!(
+        hosts_for("/w/app", cx),
+        vec!["z.example.com".to_string(), "a.example.com".to_string()]
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// R2.1/R2.2 — project files cannot feed the keys; one warning per file naming it
+// ---------------------------------------------------------------------------------------------
+
+async fn project_with(
+    fs: &Arc<FakeFs>,
+    roots: &[&str],
+    cx: &mut TestAppContext,
+) -> gpui::Entity<Project> {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    cx.run_until_parked();
+    project
+}
+
+#[gpui::test]
+async fn settings_project_file_cannot_turn_the_jail_on(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/w/app",
+        json!({ ".zed": { "settings.json": r#"{ "agent_sandbox": { "enabled": true, "projects": { "/w/app": { "enabled": true } } } }"# } }),
+    )
+    .await;
+    let _project = project_with(&fs, &["/w/app"], cx).await;
+    assert!(
+        !enabled_for("/w/app", cx),
+        "a project settings file must not switch its own jail on (R2.1)"
+    );
+}
+
+#[gpui::test]
+async fn settings_project_file_cannot_turn_the_jail_or_memory_off(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": { "projects": { "/w/app": { "enabled": true } } } }),
+        cx,
+    );
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/w/app",
+        json!({ ".zed": { "settings.json": r#"{ "agent_sandbox": { "enabled": false, "projects": { "/w/app": { "enabled": false } } }, "agent_memory": { "enabled": false } }"# } }),
+    )
+    .await;
+    let _project = project_with(&fs, &["/w/app"], cx).await;
+    assert!(
+        enabled_for("/w/app", cx),
+        "a jailed agent that writes .zed/settings.json must not loosen its jail (A1)"
+    );
+    assert!(
+        cx.update(|cx| AgentMemorySettings::get_global(cx).enabled),
+        "agent_memory is read from the user file only"
+    );
+}
+
+#[gpui::test]
+async fn settings_lookalike_project_keys_do_not_warn(cx: &mut TestAppContext) {
+    init(cx);
+    let logs = LogCapture::start();
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/w/app",
+        json!({ ".zed": { "settings.json": r#"{ "agent_sandboxes": 1, "agent_memory_notes": "x", "agent_servers": {}, "languages": { "Rust": { "agent_sandbox": true } } }"# } }),
+    )
+    .await;
+    let _project = project_with(&fs, &["/w/app"], cx).await;
+    assert!(
+        logs.matching("event=project_key_ignored").is_empty(),
+        "only the exact top-level keys warn, got {:?}",
+        logs.matching("project_key_ignored")
+    );
+}
+
+#[gpui::test]
+async fn settings_project_key_warns_once_per_file_naming_it(cx: &mut TestAppContext) {
+    init(cx);
+    let logs = LogCapture::start();
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/w/app",
+        json!({ ".zed": { "settings.json": r#"{ "agent_sandbox": { "enabled": true, "claude_config_dir": "/secret/marker-value-1" } }"# } }),
+    )
+    .await;
+    fs.insert_tree(
+        "/w/lib",
+        json!({ ".zed": { "settings.json": r#"{ "agent_memory": { "enabled": false } }"# } }),
+    )
+    .await;
+    let _project = project_with(&fs, &["/w/app", "/w/lib"], cx).await;
+    cx.run_until_parked();
+
+    let warnings = logs.matching("event=project_key_ignored");
+    let app: Vec<_> = warnings
+        .iter()
+        .filter(|(_, line)| line.contains("/w/app/.zed/settings.json"))
+        .collect();
+    let lib: Vec<_> = warnings
+        .iter()
+        .filter(|(_, line)| line.contains("/w/lib/.zed/settings.json"))
+        .collect();
+    assert_eq!(
+        app.len(),
+        1,
+        "one warning for /w/app's file, got {warnings:?}"
+    );
+    assert_eq!(
+        lib.len(),
+        1,
+        "a second file gets its own warning, got {warnings:?}"
+    );
+    assert!(
+        warnings.iter().all(|(level, _)| *level == log::Level::Warn),
+        "logged at warn level"
+    );
+    assert!(
+        !logs.all_text().contains("marker-value-1"),
+        "the warning names the file, never a value from it (R9.4)"
+    );
+
+    // Unrelated activity does not repeat the warning for an unchanged file.
+    set_user_settings(json!({ "agent_sandbox": { "enabled": false } }), cx);
+    cx.run_until_parked();
+    assert_eq!(
+        logs.matching("/w/app/.zed/settings.json").len(),
+        1,
+        "still one warning for the unchanged file"
+    );
+}
diff --git a/crates/agent_sandbox/src/test_log_capture.rs b/crates/agent_sandbox/src/test_log_capture.rs
new file mode 100644
index 0000000..de75316
--- /dev/null
+++ b/crates/agent_sandbox/src/test_log_capture.rs
@@ -0,0 +1,97 @@
+// Story 043 — shared test helper (not a test module of its own). Captures `log` records on the
+// current thread so settings_tests (R2.2), memory_tests (R9.3) and launch_tests can assert the
+// structured lines. Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod test_log_capture;
+//
+// One logger per test binary: every agent_sandbox test file MUST use this helper instead of
+// installing its own, or `log::set_logger` fails for the second one. Run these tests without
+// `RUST_LOG`/`ZED_LOG`/`CI` set: `zlog::init_test` installs its logger when one of them is set.
+// gpui tests run their foreground and background tasks on the test thread, so a thread-local
+// buffer sees every line the code under test emits.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::Once;
+
+thread_local! {
+    static CAPTURED: RefCell<Option<Vec<(log::Level, String)>>> = const { RefCell::new(None) };
+}
+
+pub(crate) struct LogCapture {
+    _private: (),
+}
+
+impl LogCapture {
+    pub(crate) fn start() -> Self {
+        static INSTALL: Once = Once::new();
+        INSTALL.call_once(|| {
+            log::set_logger(&CaptureLogger).expect(
+                "agent_sandbox test logger: another logger is installed \
+                 (unset RUST_LOG, ZED_LOG and CI for these tests)",
+            );
+            // The level is process-wide while the buffer is per thread: raise it once and never
+            // lower it, or a parallel test's Drop silences this one mid-test.
+            log::set_max_level(log::LevelFilter::Trace);
+        });
+        CAPTURED.with_borrow_mut(|lines| *lines = Some(Vec::new()));
+        Self { _private: () }
+    }
+
+    /// Every captured line, in order.
+    pub(crate) fn lines(&self) -> Vec<(log::Level, String)> {
+        CAPTURED.with_borrow(|lines| lines.clone().unwrap_or_default())
+    }
+
+    /// Captured lines containing `needle`.
+    pub(crate) fn matching(&self, needle: &str) -> Vec<(log::Level, String)> {
+        self.lines()
+            .into_iter()
+            .filter(|(_, line)| line.contains(needle))
+            .collect()
+    }
+
+    /// The whole capture as one string, for "never logged" assertions.
+    pub(crate) fn all_text(&self) -> String {
+        self.lines()
+            .into_iter()
+            .map(|(_, line)| line)
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+}
+
+impl Drop for LogCapture {
+    fn drop(&mut self) {
+        CAPTURED.with_borrow_mut(|lines| *lines = None);
+    }
+}
+
+/// Parses the `key=value` tokens of a structured line (Q14). Tokens without `=` are skipped.
+pub(crate) fn kv(line: &str) -> HashMap<String, String> {
+    line.split_whitespace()
+        .filter_map(|token| {
+            let (key, value) = token.split_once('=')?;
+            Some((key.to_string(), value.to_string()))
+        })
+        .collect()
+}
+
+struct CaptureLogger;
+
+impl log::Log for CaptureLogger {
+    fn enabled(&self, metadata: &log::Metadata<'_>) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record<'_>) {
+        CAPTURED.with_borrow_mut(|lines| {
+            if let Some(lines) = lines {
+                lines.push((record.level(), record.args().to_string()));
+            }
+        });
+    }
+
+    fn flush(&self) {}
+}
diff --git a/crates/agent_sandbox/src/validate.rs b/crates/agent_sandbox/src/validate.rs
new file mode 100644
index 0000000..26b59d1
--- /dev/null
+++ b/crates/agent_sandbox/src/validate.rs
@@ -0,0 +1,678 @@
+//! Validation of the sandbox settings' entries: writable folders (R2.4), allowed hosts (R2.5)
+//! and their counts (R2.6). Every error's `Display` names the entry and the rule it breaks, so
+//! the settings page (R3.4) and a launch refusal show the same text.
+
+use std::collections::HashSet;
+use std::fmt;
+use std::fs;
+use std::io;
+use std::net::IpAddr;
+use std::path::{Component, Path, PathBuf};
+use std::str::FromStr;
+use std::sync::LazyLock;
+
+use regex::Regex;
+
+/// Most writable folders a project may end up with (R2.6).
+pub const MAX_RW_MAPS: usize = 32;
+/// Most allowed hosts a project may end up with (R2.6).
+pub const MAX_ALLOWED_HOSTS: usize = 64;
+const MAX_HOST_LENGTH: usize = 253;
+/// Linux's own limit on symlinks followed while resolving one path (`MAXSYMLINKS`).
+const MAX_SYMLINK_HOPS: usize = 40;
+
+const HOST_PATTERN: &str =
+    r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$";
+
+static HOST_REGEX: LazyLock<Option<Regex>> = LazyLock::new(|| match Regex::new(HOST_PATTERN) {
+    Ok(regex) => Some(regex),
+    Err(error) => {
+        // A pattern that does not compile is a build defect; every host is refused until fixed.
+        log::error!("agent_sandbox event=host_pattern_invalid error={error}");
+        None
+    }
+});
+
+/// Bounds on the scan of the protected folders for symlinks. The real `~/.claude` measured 75k
+/// entries, 17 levels deep (2026-10-12).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WalkLimits {
+    pub max_entries: usize,
+    pub max_depth: usize,
+}
+
+impl WalkLimits {
+    pub const DEFAULT: Self = Self {
+        max_entries: 250_000,
+        max_depth: 32,
+    };
+}
+
+/// Why the scan of a protected folder stopped before it was complete.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WalkStop {
+    TooManyEntries { limit: usize },
+    TooDeep { limit: usize },
+    Unreadable { kind: io::ErrorKind },
+}
+
+impl fmt::Display for WalkStop {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::TooManyEntries { limit } => {
+                write!(formatter, "it holds more than {limit} entries")
+            }
+            Self::TooDeep { limit } => write!(formatter, "it is nested deeper than {limit} levels"),
+            Self::Unreadable { kind } => write!(formatter, "it could not be read: {kind}"),
+        }
+    }
+}
+
+/// The rule that keeps a path out of the jail's writable set, or a project root out of the jail
+/// (R2.8). A path is refused when it is, lies inside, or contains a protected path.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ForbiddenRule {
+    Root,
+    Home,
+    AboveHome { home: PathBuf },
+    Protected { protected: PathBuf },
+    LinkTarget { target: PathBuf, link: PathBuf },
+    RuntimeDir { dir: PathBuf },
+    ProtectedSetIncomplete { dir: PathBuf, stop: WalkStop },
+}
+
+impl fmt::Display for ForbiddenRule {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Root => write!(formatter, "is the root directory /"),
+            Self::Home => write!(formatter, "is the home directory"),
+            Self::AboveHome { home } => {
+                write!(formatter, "contains the home directory {}", home.display())
+            }
+            Self::Protected { protected } => write!(
+                formatter,
+                "is, lies inside, or contains the protected path {}",
+                protected.display()
+            ),
+            Self::LinkTarget { target, link } => write!(
+                formatter,
+                "is, lies inside, or contains {}, the target of the symlink {} in a protected folder",
+                target.display(),
+                link.display()
+            ),
+            Self::RuntimeDir { dir } => write!(
+                formatter,
+                "is, lies inside, or contains the runtime directory {}, which holds Zeo's devtools socket",
+                dir.display()
+            ),
+            Self::ProtectedSetIncomplete { dir, stop } => write!(
+                formatter,
+                "cannot be checked: the protected folder {} was not fully scanned for symlinks ({stop}), so every folder is refused",
+                dir.display()
+            ),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum ProtectedKind {
+    Listed,
+    LinkTarget { link: PathBuf },
+    RuntimeDir,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ProtectedPath {
+    path: PathBuf,
+    kind: ProtectedKind,
+}
+
+/// The paths no writable folder and no project root may be, lie inside, or contain: Zeo's config
+/// directory, `~/.claude`, `~/.claude.json`, `~/.ssh`, `~/.gnupg`, the target of every symlink
+/// found inside them, and `$XDG_RUNTIME_DIR` (R2.11). `/` and the home directory are refused by
+/// equality, and the home directory's ancestors by their own rule. Build it once per launch: it
+/// scans the protected folders.
+#[derive(Clone, Debug)]
+pub struct ProtectedSet {
+    home: PathBuf,
+    canonical_home: PathBuf,
+    entries: Vec<ProtectedPath>,
+    incomplete: Option<(PathBuf, WalkStop)>,
+}
+
+impl ProtectedSet {
+    pub fn new(home: &Path, config_dir: &Path, runtime_dir: Option<&Path>) -> Self {
+        Self::with_limits(home, config_dir, runtime_dir, WalkLimits::DEFAULT)
+    }
+
+    /// Reads the runtime directory from `$XDG_RUNTIME_DIR`, skipped when unset or not absolute.
+    pub fn from_env(home: &Path, config_dir: &Path) -> Self {
+        let runtime_dir = std::env::var_os("XDG_RUNTIME_DIR")
+            .map(PathBuf::from)
+            .filter(|dir| dir.is_absolute());
+        Self::new(home, config_dir, runtime_dir.as_deref())
+    }
+
+    pub fn with_limits(
+        home: &Path,
+        config_dir: &Path,
+        runtime_dir: Option<&Path>,
+        limits: WalkLimits,
+    ) -> Self {
+        let mut set = Self {
+            home: home.to_path_buf(),
+            canonical_home: resolve_lenient(home),
+            entries: Vec::new(),
+            incomplete: None,
+        };
+        let listed = [
+            config_dir.to_path_buf(),
+            home.join(".claude"),
+            home.join(".claude.json"),
+            home.join(".ssh"),
+            home.join(".gnupg"),
+        ];
+        let mut walk_roots = Vec::new();
+        for path in &listed {
+            let resolved = resolve_lenient(path);
+            // A symlinked protected path is protected where it sits too: whoever can replace the
+            // link can point Zeo at a folder of their choosing.
+            set.insert(lexical_anchor(path), ProtectedKind::Listed);
+            set.insert(resolved.clone(), ProtectedKind::Listed);
+            walk_roots.push(resolved);
+        }
+        if let Some(runtime_dir) = runtime_dir {
+            // Sockets and FUSE mounts live here: protected in full, never walked.
+            set.insert(lexical_anchor(runtime_dir), ProtectedKind::RuntimeDir);
+            set.insert(resolve_lenient(runtime_dir), ProtectedKind::RuntimeDir);
+        }
+        set.walk(walk_roots, limits);
+        set
+    }
+
+    /// Every protected path, canonical where it exists.
+    pub fn paths(&self) -> impl Iterator<Item = &Path> {
+        self.entries.iter().map(|entry| entry.path.as_path())
+    }
+
+    /// The rule a canonical path breaks, if any. Also answers for a project root (R2.8).
+    pub fn rule_for(&self, canonical: &Path) -> Option<ForbiddenRule> {
+        if canonical == Path::new("/") {
+            return Some(ForbiddenRule::Root);
+        }
+        if canonical == self.canonical_home {
+            return Some(ForbiddenRule::Home);
+        }
+        if self.canonical_home.starts_with(canonical) {
+            return Some(ForbiddenRule::AboveHome {
+                home: self.canonical_home.clone(),
+            });
+        }
+        for entry in &self.entries {
+            if canonical.starts_with(&entry.path) || entry.path.starts_with(canonical) {
+                return Some(match &entry.kind {
+                    ProtectedKind::Listed => ForbiddenRule::Protected {
+                        protected: entry.path.clone(),
+                    },
+                    ProtectedKind::LinkTarget { link } => ForbiddenRule::LinkTarget {
+                        target: entry.path.clone(),
+                        link: link.clone(),
+                    },
+                    ProtectedKind::RuntimeDir => ForbiddenRule::RuntimeDir {
+                        dir: entry.path.clone(),
+                    },
+                });
+            }
+        }
+        self.incomplete
+            .as_ref()
+            .map(|(dir, stop)| ForbiddenRule::ProtectedSetIncomplete {
+                dir: dir.clone(),
+                stop: *stop,
+            })
+    }
+
+    fn insert(&mut self, path: PathBuf, kind: ProtectedKind) {
+        if !self.entries.iter().any(|entry| entry.path == path) {
+            self.entries.push(ProtectedPath { path, kind });
+        }
+    }
+
+    fn covers(&self, path: &Path) -> bool {
+        self.entries
+            .iter()
+            .any(|entry| path.starts_with(&entry.path))
+    }
+
+    /// Scans the protected folders without following symlinked directories. Every symlink found
+    /// protects its resolved target, and a directory target is scanned in turn unless it already
+    /// lies inside a protected path, which is what ends a cycle. A cap or an unreadable folder
+    /// leaves the set incomplete, and an incomplete set refuses every path.
+    fn walk(&mut self, roots: Vec<PathBuf>, limits: WalkLimits) {
+        let mut queue: Vec<(PathBuf, usize)> = roots
+            .into_iter()
+            .filter(|root| root.is_dir())
+            .map(|root| (root, 0))
+            .collect();
+        let mut walked = HashSet::new();
+        let mut entries = 0usize;
+        while let Some((dir, depth)) = queue.pop() {
+            if !walked.insert(dir.clone()) {
+                continue;
+            }
+            let read_dir = match fs::read_dir(&dir) {
+                Ok(read_dir) => read_dir,
+                Err(error) => return self.stop(dir, WalkStop::Unreadable { kind: error.kind() }),
+            };
+            for entry in read_dir {
+                let entry = match entry {
+                    Ok(entry) => entry,
+                    Err(error) => {
+                        return self.stop(dir, WalkStop::Unreadable { kind: error.kind() });
+                    }
+                };
+                entries += 1;
+                if entries > limits.max_entries {
+                    return self.stop(
+                        dir,
+                        WalkStop::TooManyEntries {
+                            limit: limits.max_entries,
+                        },
+                    );
+                }
+                let path = entry.path();
+                let file_type = match entry.file_type() {
+                    Ok(file_type) => file_type,
+                    Err(error) => {
+                        return self.stop(path, WalkStop::Unreadable { kind: error.kind() });
+                    }
+                };
+                if file_type.is_dir() {
+                    if depth + 1 > limits.max_depth {
+                        return self.stop(
+                            path,
+                            WalkStop::TooDeep {
+                                limit: limits.max_depth,
+                            },
+                        );
+                    }
+                    queue.push((path, depth + 1));
+                } else if file_type.is_symlink() {
+                    let target = resolve_lenient(&path);
+                    // A target inside a protected path is already covered, for equal, inside and
+                    // above alike, and is or will be scanned from there.
+                    if self.covers(&target) {
+                        continue;
+                    }
+                    self.insert(target.clone(), ProtectedKind::LinkTarget { link: path });
+                    if target.is_dir() {
+                        queue.push((target, 0));
+                    }
+                }
+            }
+        }
+    }
+
+    fn stop(&mut self, dir: PathBuf, stop: WalkStop) {
+        self.incomplete = Some((dir, stop));
+    }
+}
+
+/// Resolves a path that may not exist yet: dangling link chains are followed (up to Linux's 40
+/// hops), the deepest existing ancestor is canonicalized and the missing tail re-appended, so a
+/// protected path protects the place it will be created in.
+fn resolve_lenient(path: &Path) -> PathBuf {
+    let mut hops = MAX_SYMLINK_HOPS;
+    resolve_with_budget(path, &mut hops)
+}
+
+fn resolve_with_budget(path: &Path, hops: &mut usize) -> PathBuf {
+    if let Ok(canonical) = path.canonicalize() {
+        return canonical;
+    }
+    if *hops > 0
+        && fs::symlink_metadata(path).is_ok_and(|metadata| metadata.file_type().is_symlink())
+        && let Ok(target) = fs::read_link(path)
+    {
+        *hops -= 1;
+        let target = match path.parent() {
+            Some(parent) if target.is_relative() => parent.join(target),
+            _ => target,
+        };
+        return resolve_with_budget(&target, hops);
+    }
+    match (path.parent(), path.file_name()) {
+        (Some(parent), Some(name)) => resolve_with_budget(parent, hops).join(name),
+        _ => normalize_lexically(path),
+    }
+}
+
+/// The path itself, with its parent canonicalized: where a symlinked protected path sits.
+fn lexical_anchor(path: &Path) -> PathBuf {
+    match (path.parent(), path.file_name()) {
+        (Some(parent), Some(name)) => resolve_lenient(parent).join(name),
+        _ => resolve_lenient(path),
+    }
+}
+
+fn normalize_lexically(path: &Path) -> PathBuf {
+    let mut normalized = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                normalized.pop();
+            }
+            other => normalized.push(other),
+        }
+    }
+    normalized
+}
+
+/// Expands a leading `~` or `~/` against `home`; anything else is returned as written.
+pub fn expand_tilde(raw: &str, home: &Path) -> PathBuf {
+    if raw == "~" {
+        home.to_path_buf()
+    } else if let Some(rest) = raw.strip_prefix("~/") {
+        home.join(rest)
+    } else {
+        PathBuf::from(raw)
+    }
+}
+
+/// A writable folder that may not be mapped (R2.4).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum RwMapError {
+    NotAbsolute {
+        entry: String,
+    },
+    Colon {
+        entry: String,
+    },
+    Missing {
+        entry: String,
+        kind: io::ErrorKind,
+    },
+    NotUtf8 {
+        entry: String,
+        canonical: PathBuf,
+    },
+    ColonInTarget {
+        entry: String,
+        canonical: String,
+    },
+    Forbidden {
+        entry: String,
+        canonical: PathBuf,
+        rule: ForbiddenRule,
+    },
+    NotADirectory {
+        entry: String,
+        canonical: PathBuf,
+    },
+}
+
+impl fmt::Display for RwMapError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NotAbsolute { entry } if entry.is_empty() => write!(
+                formatter,
+                "A writable folder entry is empty; it must be an absolute path."
+            ),
+            Self::NotAbsolute { entry } => write!(
+                formatter,
+                "Writable folder \"{entry}\" is not an absolute path; start it with / or ~/."
+            ),
+            Self::Colon { entry } => write!(
+                formatter,
+                "Writable folder \"{entry}\" contains ':', which ai-jail reads as SOURCE:DEST."
+            ),
+            Self::Missing { entry, kind } => write!(
+                formatter,
+                "Writable folder \"{entry}\" does not exist or cannot be resolved ({kind})."
+            ),
+            Self::NotUtf8 { entry, canonical } => write!(
+                formatter,
+                "Writable folder \"{entry}\" resolves to {}, which is not valid UTF-8 and cannot be passed to ai-jail.",
+                canonical.display()
+            ),
+            Self::ColonInTarget { entry, canonical } => write!(
+                formatter,
+                "Writable folder \"{entry}\" resolves to {canonical}, which contains ':', which ai-jail reads as SOURCE:DEST."
+            ),
+            Self::Forbidden {
+                entry,
+                canonical,
+                rule,
+            } => write!(
+                formatter,
+                "Writable folder \"{entry}\" ({}) {rule}.",
+                canonical.display()
+            ),
+            Self::NotADirectory { entry, canonical } => write!(
+                formatter,
+                "Writable folder \"{entry}\" ({}) is not a folder.",
+                canonical.display()
+            ),
+        }
+    }
+}
+
+impl std::error::Error for RwMapError {}
+
+/// Validates one writable folder against the protected set built for `home` and `config_dir`
+/// (plus `$XDG_RUNTIME_DIR`), returning its canonical path. Build a [`ProtectedSet`] once and
+/// call [`validate_rw_map_with`] when validating several entries.
+pub fn validate_rw_map(raw: &str, home: &Path, config_dir: &Path) -> Result<PathBuf, RwMapError> {
+    validate_rw_map_with(raw, &ProtectedSet::from_env(home, config_dir))
+}
+
+pub fn validate_rw_map_with(raw: &str, set: &ProtectedSet) -> Result<PathBuf, RwMapError> {
+    let entry = || raw.to_string();
+    let expanded = expand_tilde(raw, &set.home);
+    if raw.is_empty() || !expanded.is_absolute() {
+        return Err(RwMapError::NotAbsolute { entry: entry() });
+    }
+    if raw.contains(':') || expanded.as_os_str().as_encoded_bytes().contains(&b':') {
+        return Err(RwMapError::Colon { entry: entry() });
+    }
+    let canonical = expanded
+        .canonicalize()
+        .map_err(|error| RwMapError::Missing {
+            entry: entry(),
+            kind: error.kind(),
+        })?;
+    let Some(text) = canonical.to_str() else {
+        return Err(RwMapError::NotUtf8 {
+            entry: entry(),
+            canonical,
+        });
+    };
+    // A symlink can resolve to a ':' target, and the canonical path is what reaches --rw-map.
+    if text.contains(':') {
+        return Err(RwMapError::ColonInTarget {
+            entry: entry(),
+            canonical: text.to_string(),
+        });
+    }
+    if let Some(rule) = set.rule_for(&canonical) {
+        return Err(RwMapError::Forbidden {
+            entry: entry(),
+            canonical,
+            rule,
+        });
+    }
+    if !canonical.is_dir() {
+        return Err(RwMapError::NotADirectory {
+            entry: entry(),
+            canonical,
+        });
+    }
+    Ok(canonical)
+}
+
+/// What makes an allowed host something other than a DNS name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HostShape {
+    Scheme,
+    Path,
+    Port,
+    Wildcard,
+    UpperCase,
+    Malformed,
+}
+
+/// An allowed host that is not a DNS name (R2.5).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum HostError {
+    Empty,
+    TooLong { entry: String, length: usize },
+    IpLiteral { entry: String },
+    Localhost { entry: String },
+    NotDnsName { entry: String, shape: HostShape },
+    NumericLastLabel { entry: String },
+    PatternUnavailable { entry: String },
+}
+
+impl fmt::Display for HostError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Empty => write!(formatter, "An allowed host entry is empty."),
+            Self::TooLong { entry, length } => write!(
+                formatter,
+                "Allowed host \"{entry}\" is {length} characters long; a DNS name has at most {MAX_HOST_LENGTH}."
+            ),
+            Self::IpLiteral { entry } => write!(
+                formatter,
+                "Allowed host \"{entry}\" is an IP address; only DNS names are allowed."
+            ),
+            Self::Localhost { entry } => write!(
+                formatter,
+                "Allowed host \"{entry}\" names localhost; loopback services are never allowed hosts."
+            ),
+            Self::NotDnsName { entry, shape } => {
+                let rule = match shape {
+                    HostShape::Scheme => "carries a scheme; write the bare host name",
+                    HostShape::Path => "carries a path; write the bare host name",
+                    HostShape::Port => "carries a port; write the bare host name",
+                    HostShape::Wildcard => "is a wildcard; list each host name",
+                    HostShape::UpperCase => "has upper-case letters; write it in lower case",
+                    HostShape::Malformed => {
+                        "is not a DNS name (two or more labels of a-z, 0-9 and inner '-', no trailing dot)"
+                    }
+                };
+                write!(formatter, "Allowed host \"{entry}\" {rule}.")
+            }
+            Self::NumericLastLabel { entry } => write!(
+                formatter,
+                "Allowed host \"{entry}\" ends in a numeric label, which resolves as an IP address; only DNS names are allowed."
+            ),
+            Self::PatternUnavailable { entry } => write!(
+                formatter,
+                "Allowed host \"{entry}\" cannot be checked: the host-name pattern is unavailable."
+            ),
+        }
+    }
+}
+
+impl std::error::Error for HostError {}
+
+pub fn validate_host(raw: &str) -> Result<String, HostError> {
+    let entry = || raw.to_string();
+    if raw.is_empty() {
+        return Err(HostError::Empty);
+    }
+    if raw.len() > MAX_HOST_LENGTH {
+        return Err(HostError::TooLong {
+            entry: entry(),
+            length: raw.len(),
+        });
+    }
+    let unbracketed = raw
+        .strip_prefix('[')
+        .and_then(|rest| rest.strip_suffix(']'))
+        .unwrap_or(raw);
+    if IpAddr::from_str(raw).is_ok() || IpAddr::from_str(unbracketed).is_ok() {
+        return Err(HostError::IpLiteral { entry: entry() });
+    }
+    let lower = raw.to_ascii_lowercase();
+    let name = lower.strip_suffix('.').unwrap_or(&lower);
+    if name == "localhost" || name.ends_with(".localhost") || name == "localhost.localdomain" {
+        return Err(HostError::Localhost { entry: entry() });
+    }
+    let shape = if raw.contains("://") {
+        Some(HostShape::Scheme)
+    } else if raw.contains('/') {
+        Some(HostShape::Path)
+    } else if raw.contains(':') {
+        Some(HostShape::Port)
+    } else if raw.contains('*') {
+        Some(HostShape::Wildcard)
+    } else if raw.chars().any(|character| character.is_uppercase()) {
+        Some(HostShape::UpperCase)
+    } else {
+        None
+    };
+    if let Some(shape) = shape {
+        return Err(HostError::NotDnsName {
+            entry: entry(),
+            shape,
+        });
+    }
+    let Some(regex) = HOST_REGEX.as_ref() else {
+        return Err(HostError::PatternUnavailable { entry: entry() });
+    };
+    if !regex.is_match(raw) {
+        return Err(HostError::NotDnsName {
+            entry: entry(),
+            shape: HostShape::Malformed,
+        });
+    }
+    // `127.1` and `0x7f.1` are not `IpAddr`s, yet the system resolver reads them as 127.0.0.1;
+    // an all-numeric final label is never a DNS name (RFC 3696 §2).
+    let last_label = raw.rsplit('.').next().unwrap_or(raw);
+    let numeric = last_label.bytes().all(|byte| byte.is_ascii_digit());
+    let hexadecimal = last_label.strip_prefix("0x").is_some_and(|digits| {
+        !digits.is_empty() && digits.bytes().all(|byte| byte.is_ascii_hexdigit())
+    });
+    if numeric || hexadecimal {
+        return Err(HostError::NumericLastLabel { entry: entry() });
+    }
+    Ok(raw.to_string())
+}
+
+/// A project that would cross a count limit (R2.6), naming the entry that crosses it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LimitError {
+    TooManyRwMaps { count: usize },
+    TooManyHosts { count: usize },
+}
+
+impl fmt::Display for LimitError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::TooManyRwMaps { count } => write!(
+                formatter,
+                "Writable folder #{} crosses the limit of {MAX_RW_MAPS} writable folders per project ({count} configured).",
+                MAX_RW_MAPS + 1
+            ),
+            Self::TooManyHosts { count } => write!(
+                formatter,
+                "Allowed host #{} crosses the limit of {MAX_ALLOWED_HOSTS} allowed hosts per project ({count} configured).",
+                MAX_ALLOWED_HOSTS + 1
+            ),
+        }
+    }
+}
+
+impl std::error::Error for LimitError {}
+
+pub fn check_limits(maps: usize, hosts: usize) -> Result<(), LimitError> {
+    if maps > MAX_RW_MAPS {
+        return Err(LimitError::TooManyRwMaps { count: maps });
+    }
+    if hosts > MAX_ALLOWED_HOSTS {
+        return Err(LimitError::TooManyHosts { count: hosts });
+    }
+    Ok(())
+}
