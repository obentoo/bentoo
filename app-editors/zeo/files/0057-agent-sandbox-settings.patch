+/// A fake ai-memory 2.6.2. `answer(tool)` decides each `tools/call`.
+fn fake_memory(
+    executor: BackgroundExecutor,
+    answer: impl Fn(&str) -> Answer + Send + Sync + 'static,
+) -> (Arc<dyn HttpClient>, FakeMemory) {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let answer = Arc::new(answer);
+    let client = http_client::FakeHttpClient::create({
+        let seen = seen.clone();
+        move |request| {
+            let seen = seen.clone();
+            let answer = answer.clone();
+            let executor = executor.clone();
+            async move {
+                let auth = request
+                    .headers()
+                    .get("Authorization")
+                    .and_then(|value| value.to_str().ok())
+                    .map(str::to_string);
+                let mut text = String::new();
+                request.into_body().read_to_string(&mut text).await?;
+                let message: Value = serde_json::from_str(&text).unwrap_or(Value::Null);
+                let method = message["method"].as_str().unwrap_or_default().to_string();
+                let tool = message["params"]["name"].as_str().map(str::to_string);
+                seen.lock().push(Seen {
+                    method: method.clone(),
+                    tool: tool.clone(),
+                    arguments: message["params"].get("arguments").cloned(),
+                    auth,
+                });
+                let id = message["id"].clone();
+                match method.as_str() {
+                    "initialize" => json_response(json!({
+                        "jsonrpc": "2.0", "id": id,
+                        "result": {
+                            "protocolVersion": message["params"]["protocolVersion"],
+                            "capabilities": { "tools": {} },
+                            "serverInfo": { "name": "ai-memory", "version": "2.6.2" }
+                        }
+                    })),
+                    "tools/call" => match answer(tool.as_deref().unwrap_or_default()) {
+                        Answer::Text(text) => json_response(json!({
+                            "jsonrpc": "2.0", "id": id,
+                            "result": { "content": [{ "type": "text", "text": text }] }
+                        })),
+                        Answer::ToolError(text) => json_response(json!({
+                            "jsonrpc": "2.0", "id": id,
+                            "result": { "content": [{ "type": "text", "text": text }], "isError": true }
+                        })),
+                        Answer::RpcError(code, text) => json_response(json!({
+                            "jsonrpc": "2.0", "id": id,
+                            "error": { "code": code, "message": text }
+                        })),
+                        Answer::Delayed(delay, text) => {
+                            executor.timer(delay).await;
+                            json_response(json!({
+                                "jsonrpc": "2.0", "id": id,
+                                "result": { "content": [{ "type": "text", "text": text }] }
+                            }))
+                        }
+                        Answer::Never => futures::future::pending().await,
+                        Answer::Refused => {
+                            Err(anyhow::anyhow!("Connection refused (os error 111)"))
+                        }
+                    },
+                    // Notifications (initialized, cancelled): accepted, no body.
+                    _ => Ok(Response::builder()
+                        .status(202)
+                        .body(AsyncBody::default())
+                        .expect("response")),
+                }
+            }
+        }
+    }) as Arc<dyn HttpClient>;
+    (client, FakeMemory { seen })
+}
+
+fn scope(project: &str) -> MemoryScope {
+    MemoryScope {
+        workspace: "default".to_string(),
+        project: project.to_string(),
+        resolved_by: ResolvedBy::Marker,
+    }
+}
