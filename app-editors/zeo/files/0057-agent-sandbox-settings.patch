+    }
+}
diff --git a/crates/agent_sandbox/src/project_keys.rs b/crates/agent_sandbox/src/project_keys.rs
new file mode 100644
index 0000000..01a3819
--- /dev/null
+++ b/crates/agent_sandbox/src/project_keys.rs
@@ -0,0 +1,115 @@
+//! R2.2: a project settings file carrying `agent_sandbox` or `agent_memory` gets one warning.
+//!
+//! The parsed project settings drop unknown keys without a trace, so the raw file is read.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use gpui::{App, AppContext as _, BorrowAppContext as _, Context, Global};
+use project::{Fs, MTime, PathChange, Project, UpdatedEntriesSet, WorktreeId};
+
+/// The top-level keys only the user settings file may carry.
+const USER_ONLY_KEYS: [&str; 2] = ["agent_sandbox", "agent_memory"];
+
+/// The mtime each settings file was last checked at, so an unchanged file never warns twice.
+/// One entry per file: a newer mtime replaces the older one.
+#[derive(Default)]
+struct CheckedProjectFiles(HashMap<PathBuf, Option<MTime>>);
+
+impl Global for CheckedProjectFiles {}
+
+pub(crate) fn init(cx: &mut App) {
+    cx.set_global(CheckedProjectFiles::default());
+    cx.observe_new(
+        |project: &mut Project, _window, cx: &mut Context<Project>| {
+            // A remote project's settings file lives on the remote host.
+            if !project.is_local() {
+                return;
+            }
+            cx.subscribe_self(|project: &mut Project, event: &project::Event, cx| {
+                if let project::Event::WorktreeUpdatedEntries(worktree_id, changes) = event {
+                    check_settings_files(project, *worktree_id, changes, cx);
+                }
+            })
+            .detach();
+        },
+    )
+    .detach();
+}
+
+fn check_settings_files(
+    project: &Project,
+    worktree_id: WorktreeId,
+    changes: &UpdatedEntriesSet,
+    cx: &mut Context<Project>,
+) {
+    let settings_file = paths::local_settings_file_relative_path();
+    let touched = changes
+        .iter()
+        .any(|(path, _, change)| path.as_ref() == settings_file && *change != PathChange::Removed);
+    if !touched {
+        return;
+    }
+    let Some(worktree) = project.worktree_for_id(worktree_id, cx) else {
+        return;
+    };
+    let worktree = worktree.read(cx);
+    let abs_path = worktree.absolutize(settings_file);
+    let mtime = worktree
+        .entry_for_path(settings_file)
+        .and_then(|entry| entry.mtime);
+    let first_check = cx.update_global(|checked: &mut CheckedProjectFiles, _| {
+        checked.0.insert(abs_path.clone(), mtime) != Some(mtime)
+    });
+    if !first_check {
+        return;
+    }
+    let fs: Arc<dyn Fs> = project.fs().clone();
+    cx.background_spawn(async move {
+        let text = match fs.load(&abs_path).await {
+            Ok(text) => text,
+            Err(error) => {
+                log::debug!(
+                    "agent_sandbox event=project_file_unreadable file={} error={error:#}",
+                    abs_path.display()
+                );
+                return;
+            }
+        };
+        let keys = match user_only_keys_in(&text) {
+            Ok(keys) => keys,
+            Err(error) => {
+                // A syntax error carries a position, never the text around it.
+                log::debug!(
+                    "agent_sandbox event=project_file_unparsed file={} error={error:#}",
+                    abs_path.display()
+                );
+                return;
+            }
+        };
+        if keys.is_empty() {
+            return;
+        }
+        // The file and the key names only: a value from the file is never logged.
+        log::warn!(
+            "agent_sandbox event=project_key_ignored file={} keys={} reason=\"user settings only\"",
+            abs_path.display(),
+            keys.join(",")
+        );
+    })
+    .detach();
+}
+
+/// The user-only keys present at the top level of a JSONC settings file, in a fixed order.
+fn user_only_keys_in(text: &str) -> anyhow::Result<Vec<&'static str>> {
+    let serde_json::Value::Object(object) =
+        settings::parse_json_with_comments::<serde_json::Value>(text)?
+    else {
+        return Ok(Vec::new());
+    };
+    Ok(USER_ONLY_KEYS
+        .into_iter()
+        .filter(|key| object.contains_key(*key))
+        .collect())
+}
diff --git a/crates/agent_sandbox/src/roundtrip_tests.rs b/crates/agent_sandbox/src/roundtrip_tests.rs
new file mode 100644
index 0000000..3cebda1
--- /dev/null
+++ b/crates/agent_sandbox/src/roundtrip_tests.rs
@@ -0,0 +1,313 @@
+// Story 043, task 9.1 — both ends of every wire: the page's writer → the settings file → the
+// reloaded settings → `decide` → the launch registry → drift (R1.1, R1.12, R3.2, R3.8, R5.2,
+// R5.4). Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod roundtrip_tests;
+//
+// Validation filter: `roundtrip` (every test path is `roundtrip_tests::…`).
+//
+// The icon's tooltip text from a registry record is asserted in agent_ui's
+// `agent_jail_status_tests` (it cannot be reached from this crate); this file proves that the
+// record the icon and the page read is exactly the one `decide` produced, keyed exactly.
+//
+// Contract (design.md §launch, §Confirmation, §Data Models). Assumed signatures — adjust the
+// `use`/call only:
+//   - `crate::confirm::set_project_enabled(root, enabled, window, cx) -> Task<_>` (the page's and
+//     the palette's only writer of the switch)
+//   - `crate::launch::{decide, drifted, LaunchDecision, LaunchRecord, Reason}` as in launch_tests
+//   - `crate::launch::LaunchRegistry::register(record: LaunchRecord, cx: &mut App)` and
+//     `LaunchRegistry::get(agent_id: &AgentId, root: &Path, cx: &App) -> Option<LaunchRecord>`
+//
+// Hostile halves first:
+//   - registry key, wrongly COLLAPSE: the record for (agent, root) is not returned for another
+//     root nor for another agent of the same root.
+//   - written shape, wrongly SPLIT: the file the writer produced reloads into the same policy that
+//     drives the argv (`projects["<absolute root>"]`), not a parallel key nobody reads.
+//   - R1.12: after the switch goes off, the registry still holds the record the agent started
+//     with, and drift reports it.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::PathBuf;
+
+use fs::{FakeFs, Fs, RealFs};
+use gpui::{TestAppContext, UpdateGlobal as _};
+use project::Project;
+use project::agent_server_store::{AgentId, AgentServerCommand};
+use serde_json::json;
+use settings::{Settings as _, SettingsStore};
+
+use crate::AgentSandboxSettings;
+use crate::confirm::set_project_enabled;
+use crate::launch::{LaunchDecision, LaunchRegistry, Reason, decide, drifted};
+
+fn reload_from(text: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(text, cx)
+                .result()
+                .expect("the written file parses back");
+        })
+    });
+    cx.run_until_parked();
+}
+
+#[gpui::test]
+async fn roundtrip_page_write_to_launch_to_registry_to_drift(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = tmp.path().canonicalize().expect("canonical");
+    let root = base.join("app");
+    let other_root = base.join("app2");
+    std::fs::create_dir_all(&root).expect("project");
+    std::fs::create_dir_all(&other_root).expect("other project");
+    let ai_jail = base.join("bin/ai-jail");
+    std::fs::create_dir_all(ai_jail.parent().expect("bin")).expect("bin");
+    std::fs::write(&ai_jail, "#!/bin/sh\necho 'ai-jail 2.8.1'\n").expect("script");
+    std::fs::set_permissions(&ai_jail, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+    let claude_dir = base.join("claude-jailed");
+    std::fs::create_dir_all(&claude_dir).expect("claude dir");
+
+    // The user file before the page touches it: sandbox off, a project host already listed.
+    let user = json!({
+        "agent_sandbox": {
+            "enabled": false,
+            "ai_jail_path": ai_jail,
+            "claude_config_dir": claude_dir,
+            "allow_hosts": ["anthropic.com"],
+            "projects": { root.display().to_string(): { "allow_hosts": ["registry.npmjs.org"] } }
+        },
+        "agent_memory": { "enabled": false }
+    });
+    let settings_fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        <dyn Fs>::set_global(settings_fs.clone(), cx);
+        crate::init(cx);
+    });
+    // The fake fs needs the settings file's parent before the writer can save into it.
+    settings_fs
+        .create_dir(paths::config_dir())
+        .await
+        .expect("config dir");
+    settings_fs
+        .insert_file(paths::settings_file(), user.to_string().into_bytes())
+        .await;
+    reload_from(&user.to_string(), cx);
+
+    // 1. The page's writer turns the project on (no prompt for on).
+    {
+        let vcx = cx.add_empty_window();
+        let task = vcx.update(|window, cx| set_project_enabled(&root, true, window, cx));
+        vcx.run_until_parked();
+        let _ = task.await;
+    }
+    let written = settings_fs
+        .load(paths::settings_file())
+        .await
+        .expect("file");
+    reload_from(&written, cx);
+    assert!(cx.update(|cx| AgentSandboxSettings::get_global(cx).effective_enabled(&root)));
+    assert!(
+        !cx.update(|cx| AgentSandboxSettings::get_global(cx).effective_enabled(&other_root)),
+        "the write is keyed by this root only"
+    );
+
+    // 2. The reloaded settings drive decide to the expected argv.
+    let project = Project::test(RealFs::new(None, cx.executor()), [root.as_path()], cx).await;
+    cx.run_until_parked();
+    let agent = AgentId::new("claude-acp");
+    let cmd = AgentServerCommand {
+        path: PathBuf::from("/usr/bin/claude-agent-acp-plus"),
+        args: vec![],
+        env: None,
+    };
+    let decision = {
+        let mut async_cx = cx.to_async();
+        // The agent's settings configure no variable: nothing is forwarded into the jail.
+        let configured_env = std::collections::HashSet::new();
+        decide(agent.clone(), &project, cmd, &configured_env, &mut async_cx).await
+    };
+    let (record, jailed) = match decision {
+        LaunchDecision::Jailed(record, jailed) => (record, jailed),
+        LaunchDecision::Unchanged(_) => panic!("expected Jailed, got Unchanged"),
+        LaunchDecision::Refused(error) => panic!("expected Jailed, got Refused: {error}"),
+    };
+    let hosts: Vec<&str> = jailed
+        .args
+        .windows(2)
+        .filter(|pair| pair[0] == "--allow-host")
+        .map(|pair| pair[1].as_str())
+        .collect();
+    assert_eq!(hosts, vec!["anthropic.com", "registry.npmjs.org"]);
+    assert_eq!(
+        record.allow_hosts,
+        vec![
+            "anthropic.com".to_string(),
+            "registry.npmjs.org".to_string()
+        ]
+    );
+    assert!(matches!(record.reason, Reason::On));
+
+    // 3. The registry returns exactly that record, for exactly that key.
+    cx.update(|cx| LaunchRegistry::register(record.clone(), cx));
+    cx.update(|cx| {
+        let stored = LaunchRegistry::get(&agent, &root, cx).expect("registered record");
+        assert!(matches!(stored.reason, Reason::On));
+        assert_eq!(stored.project_root, root);
+        assert_eq!(stored.ai_jail_version, record.ai_jail_version);
+        assert_eq!(stored.rw_maps, record.rw_maps);
+        assert_eq!(stored.allow_hosts, record.allow_hosts);
+        assert_eq!(stored.forward_ports, record.forward_ports);
+        assert!(
+            LaunchRegistry::get(&agent, &other_root, cx).is_none(),
+            "another root"
+        );
+        assert!(
+            LaunchRegistry::get(&AgentId::new("codex-acp"), &root, cx).is_none(),
+            "another agent of the same root"
+        );
+        assert!(
+            !drifted(&stored, AgentSandboxSettings::get_global(cx)),
+            "no drift yet"
+        );
+    });
+
+    // 4. The switch goes off through the confirmed writer; the running agent keeps its record.
+    {
+        let vcx = cx.add_empty_window();
+        let task = vcx.update(|window, cx| set_project_enabled(&root, false, window, cx));
+        vcx.run_until_parked();
+        vcx.simulate_prompt_answer("Turn Off");
+        let _ = task.await;
+    }
+    let written = settings_fs
+        .load(paths::settings_file())
+        .await
+        .expect("file");
+    reload_from(&written, cx);
+    cx.update(|cx| {
+        let stored = LaunchRegistry::get(&agent, &root, cx).expect("still registered");
+        assert!(
+            matches!(stored.reason, Reason::On),
+            "R1.12: the started state is kept"
+        );
+        assert!(
+            drifted(&stored, AgentSandboxSettings::get_global(cx)),
+            "and reported as drift"
+        );
+    });
+}
+
+// Added by the 9.1 run (not pre-authored): the shapes the icon (4.1), the page (5.2, 7.1) and the
+// palette (8.1) read, held by exhaustive literals and patterns — no `..` — so a field added to or
+// removed from a producer fails this compile until a consumer has been checked for it. The parsed
+// values are asserted from the captured ai-memory fixtures in `memory_tests`; the rendered text in
+// agent_ui's and settings_ui's own tests.
+#[gpui::test]
+fn roundtrip_contract_shapes_carry_every_field_the_consumers_read(cx: &mut TestAppContext) {
+    use crate::launch::{LaunchRecord, MemoryPort, drifted_now};
+    use crate::memory::{MemoryScope, MemoryStatus, RecentPage, ResolvedBy, display_endpoint};
+
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        crate::init(cx);
+    });
+
+    let root = PathBuf::from("/work/app");
+    let record = LaunchRecord {
+        agent_id: AgentId::new("claude-agent-acp-plus"),
+        project_root: root.clone(),
+        reason: Reason::On,
+        ai_jail_version: Some(semver::Version::new(2, 8, 1)),
+        ai_jail_path: Some(PathBuf::from("/usr/bin/ai-jail")),
+        rw_maps: vec![PathBuf::from("/home/u/.claude-jailed")],
+        allow_hosts: vec!["anthropic.com".to_string()],
+        forward_ports: vec![49374],
+        memory_port: MemoryPort::Forwarded(49374),
+        settings_fingerprint: 1,
+        memory_fingerprint: 2,
+        settings_key: Some("/work/app".to_string()),
+    };
+    cx.update(|cx| {
+        LaunchRegistry::register(record.clone(), cx);
+        let stored = LaunchRegistry::get(&record.agent_id, &root, cx).expect("registered");
+        assert_eq!(
+            stored, record,
+            "the registry keeps every field the launch wrote"
+        );
+        assert_eq!(LaunchRegistry::for_root(&root, cx), vec![record.clone()]);
+        // The icon's inputs (agent_jail_status::jail_status_summary) and the page's drift line.
+        let LaunchRecord {
+            agent_id: _,
+            project_root: _,
+            reason,
+            ai_jail_version,
+            ai_jail_path: _,
+            rw_maps,
+            allow_hosts,
+            forward_ports,
+            memory_port,
+            settings_fingerprint: _,
+            memory_fingerprint: _,
+            settings_key: _,
+        } = &stored;
+        assert_eq!(*reason, Reason::On);
+        assert_eq!(
+            ai_jail_version.as_ref().map(ToString::to_string).as_deref(),
+            Some("2.8.1")
+        );
+        assert_eq!(rw_maps.len(), 1);
+        assert_eq!(allow_hosts.len(), 1);
+        assert_eq!(forward_ports, &vec![49374]);
+        assert_eq!(*memory_port, MemoryPort::Forwarded(49374));
+        // The fingerprints are not those of the settings of now: drift is reported, not hidden.
+        assert!(drifted_now(&stored, cx));
+    });
+
+    // 7.1's status line: version, shown endpoint, scope, pages, sessions; its list: title, path.
+    let status = MemoryStatus {
+        server_version: "2.6.3".to_string(),
+        endpoint: url::Url::parse("http://user:secret@127.0.0.1:49374/mcp?token=t#f").expect("url"),
+        scope: MemoryScope {
+            workspace: "default".to_string(),
+            project: "zeo-workspace-zed-workspace".to_string(),
+            resolved_by: ResolvedBy::Marker,
+        },
+        pages: 77,
+        sessions: 129,
+    };
+    let MemoryStatus {
+        server_version,
+        endpoint,
+        scope,
+        pages,
+        sessions,
+    } = &status;
+    let line = format!(
+        "ai-memory {} at {} · {}: {} pages, {} sessions",
+        server_version,
+        display_endpoint(endpoint),
+        scope,
+        pages,
+        sessions
+    );
+    assert_eq!(
+        line,
+        "ai-memory 2.6.3 at http://127.0.0.1:49374/mcp · default/zeo-workspace-zed-workspace: \
+         77 pages, 129 sessions"
+    );
+    let page = RecentPage {
+        title: "FS gotcha".to_string(),
+        path: "gotchas/fs.md".to_string(),
+    };
+    let RecentPage { title, path } = &page;
+    assert_eq!(
+        (title.as_str(), path.as_str()),
+        ("FS gotcha", "gotchas/fs.md")
+    );
+}
diff --git a/crates/agent_sandbox/src/scope_tests.rs b/crates/agent_sandbox/src/scope_tests.rs
new file mode 100644
index 0000000..104c0e1
--- /dev/null
+++ b/crates/agent_sandbox/src/scope_tests.rs
@@ -0,0 +1,358 @@
+// Story 043, task 6.1 — ai-memory scope resolution (R6.7). Wired in the crate root
+// `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod scope_tests;
+//
+// Validation filter: `scope` (every test path is `scope_tests::…`).
+//
+// Contract (design.md §agent_sandbox::memory). Assumed signatures — adjust the `use`/call only:
+//   - `crate::memory::resolve_scope(root: &Path, fs: Arc<dyn Fs>) -> MemoryScope` (async; if it
+//     is sync or takes `&dyn Fs`, drop the `.await`/borrow — the assertions stay)
+//   - `MemoryScope { workspace: String, project: String, resolved_by: ResolvedBy }`
+//   - `ResolvedBy::{Marker, Upstream, Origin, Folder}`
+//
+// Repositories are real (`git init` + `git remote add`, test-only subprocesses) and read through
+// `RealFs`, so the remote lookup goes through the same git layer Zeo uses.
+//
+// Hostile halves first:
+//   - marker, wrongly FOUND: a marker in a sibling directory or below the root is not "at or
+//     above"; a malformed marker falls through instead of being trusted.
+//   - project name, wrongly SPLIT: the ssh, scp-like and https spellings of one repository give
+//     one project; wrongly COLLAPSE: `zeo-workspace/zed` and `zeo-workspace/zed-workspace` stay
+//     two; `.git` is dropped only as a suffix (`b.github.io` keeps its dots).
+//   - remote order: upstream wins over origin even when origin is added first.
+//
+// Known residue of the rule itself (reported, not asserted different): `a-b/c` and `a/b-c` both
+// render `a-b-c` — R6.7's `/`→`-` mapping makes them one scope by construction.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::Arc;
+
+use fs::{Fs, RealFs};
+use gpui::TestAppContext;
+
+use crate::memory::{MemoryScope, ResolvedBy, resolve_scope};
+
+#[allow(clippy::disallowed_methods)]
+fn git(dir: &Path, args: &[&str]) {
+    let status = Command::new("git")
+        .args(args)
+        .current_dir(dir)
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .status()
+        .expect("git runs");
+    assert!(status.success(), "git {args:?} in {}", dir.display());
+}
+
+fn repo(base: &Path, name: &str, remotes: &[(&str, &str)]) -> PathBuf {
+    let dir = base.join(name);
+    std::fs::create_dir_all(&dir).expect("mkdir");
+    git(&dir, &["init", "-q"]);
+    for (remote, url) in remotes {
+        git(&dir, &["remote", "add", remote, url]);
+    }
+    dir
+}
+
+async fn scope(root: &Path, cx: &mut TestAppContext) -> MemoryScope {
+    let fs: Arc<dyn Fs> = RealFs::new(None, cx.executor());
+    resolve_scope(root, fs).await
+}
+
+fn base(tmp: &tempfile::TempDir) -> PathBuf {
+    tmp.path().canonicalize().expect("canonical")
+}
+
+// --- marker -----------------------------------------------------------------------------------
+
+#[gpui::test]
+async fn scope_marker_in_sibling_or_below_is_ignored(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    let root = repo(&base, "w/app", &[("origin", "git@github.com:acme/app.git")]);
+    std::fs::create_dir_all(base.join("w/sibling")).expect("mkdir");
+    std::fs::write(
+        base.join("w/sibling/.ai-memory.toml"),
+        "workspace = \"wrong\"\nproject = \"wrong\"\n",
+    )
+    .expect("write");
+    std::fs::create_dir_all(root.join("sub")).expect("mkdir");
+    std::fs::write(
+        root.join("sub/.ai-memory.toml"),
+        "workspace = \"below\"\nproject = \"below\"\n",
+    )
+    .expect("write");
+    let resolved = scope(&root, cx).await;
+    assert_eq!(resolved.project, "acme-app");
+    assert_eq!(resolved.workspace, "default");
+    assert!(matches!(resolved.resolved_by, ResolvedBy::Origin));
+}
+
+#[gpui::test]
+async fn scope_malformed_marker_falls_through(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    let root = repo(
+        &base,
+        "app",
+        &[("origin", "https://github.com/acme/app.git")],
+    );
+    std::fs::write(root.join(".ai-memory.toml"), "workspace = = broken [").expect("write");
+    let resolved = scope(&root, cx).await;
+    assert!(
+        matches!(resolved.resolved_by, ResolvedBy::Origin),
+        "a broken marker is not trusted"
+    );
+    assert_eq!(resolved.project, "acme-app");
+}
+
+#[gpui::test]
+async fn scope_marker_at_or_above_the_root_wins(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    let root = repo(
+        &base,
+        "w/app",
+        &[("upstream", "git@github.com:acme/app.git")],
+    );
+    std::fs::write(
+        base.join("w/.ai-memory.toml"),
+        "workspace = \"team\"\nproject = \"shared\"\n",
+    )
+    .expect("write");
+    let above = scope(&root, cx).await;
+    assert_eq!(
+        (above.workspace.as_str(), above.project.as_str()),
+        ("team", "shared")
+    );
+    assert!(matches!(above.resolved_by, ResolvedBy::Marker));
+
+    std::fs::write(root.join(".ai-memory.toml"), "project = \"own\"\n").expect("write");
+    let nearest = scope(&root, cx).await;
+    assert_eq!(nearest.project, "own", "the nearest marker wins");
+    assert_eq!(
+        nearest.workspace, "default",
+        "a marker without workspace → default"
+    );
+}
+
+// --- remotes ----------------------------------------------------------------------------------
+
+#[gpui::test]
+async fn scope_upstream_wins_over_origin(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    let root = repo(
+        &base,
+        "fork",
+        &[
+            ("origin", "git@github.com:me/zed.git"),
+            ("upstream", "git@github.com:zed-industries/zed.git"),
+        ],
+    );
+    let resolved = scope(&root, cx).await;
+    assert_eq!(resolved.project, "zed-industries-zed");
+    assert!(matches!(resolved.resolved_by, ResolvedBy::Upstream));
+}
+
+#[gpui::test]
+async fn scope_spellings_of_one_repo_agree_and_near_names_differ(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    for (name, url, expected) in [
+        (
+            "near",
+            "git@github.com:zeo-workspace/zed.git",
+            "zeo-workspace-zed",
+        ),
+        (
+            "scp",
+            "git@github.com:zeo-workspace/zed-workspace.git",
+            "zeo-workspace-zed-workspace",
+        ),
+        (
+            "https",
+            "https://github.com/zeo-workspace/zed-workspace",
+            "zeo-workspace-zed-workspace",
+        ),
+        (
+            "https-git",
+            "https://github.com/zeo-workspace/zed-workspace.git",
+            "zeo-workspace-zed-workspace",
+        ),
+        (
+            "ssh",
+            "ssh://git@github.com/zeo-workspace/zed-workspace.git",
+            "zeo-workspace-zed-workspace",
+        ),
+        (
+            "dots",
+            "https://github.com/acme/acme.github.io.git",
+            "acme-acme.github.io",
+        ),
+        (
+            "nested",
+            "https://gitlab.com/group/sub/repo.git",
+            "group-sub-repo",
+        ),
+    ] {
+        let root = repo(&base, name, &[("origin", url)]);
+        let resolved = scope(&root, cx).await;
+        assert_eq!(resolved.project, expected, "{url}");
+        assert_eq!(resolved.workspace, "default", "{url}");
+    }
+}
+
+// --- folder fallback ----------------------------------------------------------------------------
+
+#[gpui::test]
+async fn scope_falls_back_to_the_folder_name(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = base(&tmp);
+    let plain = base.join("my-notes");
+    std::fs::create_dir_all(&plain).expect("mkdir");
+    let resolved = scope(&plain, cx).await;
+    assert_eq!(resolved.project, "my-notes");
+    assert_eq!(resolved.workspace, "default");
+    assert!(matches!(resolved.resolved_by, ResolvedBy::Folder));
+
+    let no_remote = repo(&base, "local-only", &[]);
+    let resolved = scope(&no_remote, cx).await;
+    assert_eq!(
+        resolved.project, "local-only",
+        "a repository without remotes → folder name"
+    );
+    assert!(matches!(resolved.resolved_by, ResolvedBy::Folder));
+}
+
+// --- review fixes -------------------------------------------------------------------------------
+
+mod review_fixes {
+    use std::time::{Duration, Instant};
+
+    use super::*;
+    use crate::test_log_capture::{LogCapture, kv};
+
+    #[allow(clippy::disallowed_methods)]
+    fn mkfifo(path: &Path) {
+        let status = Command::new("mkfifo")
+            .arg(path)
+            .status()
+            .expect("mkfifo runs");
+        assert!(status.success(), "mkfifo {}", path.display());
+    }
+
+    fn invalid_marker_reasons(logs: &LogCapture) -> Vec<(String, String)> {
+        logs.matching("event=marker_invalid")
+            .into_iter()
+            .filter(|(level, _)| *level == log::Level::Warn)
+            .map(|(_, line)| {
+                let fields = kv(&line);
+                (
+                    fields.get("file").cloned().unwrap_or_default(),
+                    fields.get("reason").cloned().unwrap_or_default(),
+                )
+            })
+            .collect()
+    }
+
+    // M1: a hostile clone can ship `.ai-memory.toml -> /dev/zero` (a character device reporting
+    // length 0) or a FIFO. Neither may be read; resolution falls through to the remote, quickly.
+    #[gpui::test]
+    async fn scope_marker_that_is_a_device_or_a_fifo_is_skipped(cx: &mut TestAppContext) {
+        cx.executor().allow_parking();
+        let logs = LogCapture::start();
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = base(&tmp);
+        let root = repo(&base, "w/app", &[("origin", "git@github.com:acme/app.git")]);
+        let device = root.join(".ai-memory.toml");
+        std::os::unix::fs::symlink("/dev/zero", &device).expect("symlink");
+        let fifo = base.join("w/.ai-memory.toml");
+        mkfifo(&fifo);
+
+        let started = Instant::now();
+        let resolved = scope(&root, cx).await;
+        assert!(
+            started.elapsed() < Duration::from_secs(10),
+            "resolution must not read a device or block on a FIFO"
+        );
+        assert_eq!(resolved.project, "acme-app");
+        assert_eq!(resolved.workspace, "default");
+        assert!(matches!(resolved.resolved_by, ResolvedBy::Origin));
+
+        let reasons = invalid_marker_reasons(&logs);
+        assert_eq!(
+            reasons,
+            vec![
+                (format!("{device:?}"), "not_a_regular_file".to_string()),
+                (format!("{fifo:?}"), "not_a_regular_file".to_string()),
+            ],
+            "one quoted warn line per skipped marker"
+        );
+    }
+
+    #[gpui::test]
+    async fn scope_marker_over_the_size_limit_is_skipped(cx: &mut TestAppContext) {
+        cx.executor().allow_parking();
+        let logs = LogCapture::start();
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = base(&tmp);
+        let root = repo(
+            &base,
+            "app",
+            &[("origin", "https://github.com/acme/app.git")],
+        );
+        let marker = root.join(".ai-memory.toml");
+        let mut text = "project = \"huge\"\n".to_string();
+        text.push_str(&"#".repeat(64 * 1024));
+        std::fs::write(&marker, text).expect("write");
+
+        let resolved = scope(&root, cx).await;
+        assert_eq!(resolved.project, "acme-app");
+        assert_eq!(
+            invalid_marker_reasons(&logs),
+            vec![(format!("{marker:?}"), "too_large".to_string())]
+        );
+    }
+
+    // L2: log values are quoted (Q14: one key=value line even for a path with spaces).
+    #[gpui::test]
+    async fn scope_log_values_are_quoted(cx: &mut TestAppContext) {
+        cx.executor().allow_parking();
+        let logs = LogCapture::start();
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = base(&tmp);
+        let root = base.join("my notes");
+        std::fs::create_dir_all(&root).expect("mkdir");
+        std::fs::write(root.join(".ai-memory.toml"), "workspace = [").expect("write");
+
+        let resolved = scope(&root, cx).await;
+        assert_eq!(resolved.project, "my notes");
+        let resolved_lines = logs.matching("event=scope_resolved");
+        assert_eq!(resolved_lines.len(), 1);
+        assert!(
+            resolved_lines[0]
+                .1
+                .contains("workspace=\"default\" project=\"my notes\""),
+            "{}",
+            resolved_lines[0].1
+        );
+        let invalid = logs.matching("event=marker_invalid");
+        assert_eq!(invalid.len(), 1);
+        let marker = root.join(".ai-memory.toml");
+        assert!(
+            invalid[0].1.contains(&format!("file={marker:?}")),
+            "{}",
+            invalid[0].1
+        );
+    }
+}
