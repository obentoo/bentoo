+/// One value of a `key=value` log field: whitespace, `=` and control characters become `_`,
+/// so a hostile agent id cannot forge a field (Q14).
+pub(crate) fn log_token(value: &str) -> String {
+    if value.is_empty() {
+        return "_".to_string();
+    }
+    value
+        .chars()
+        .map(|c| {
+            if c.is_whitespace() || c == '=' || c.is_control() {
+                '_'
+            } else {
+                c
+            }
+        })
+        .collect()
+}
+
+fn version_token(version: Option<&impl std::fmt::Display>) -> String {
+    version.map_or_else(
+        || "-".to_string(),
+        |version| log_token(&version.to_string()),
+    )
+}
+
+/// The R9.1 line of a start: counts and tokens only, never an env value, path or message text
+/// (R9.4).
+fn log_launch(record: &LaunchRecord, jailed: bool) {
+    log::info!(
+        "agent_sandbox event=launch agent={} jailed={jailed} reason={} ai_jail={} rw_maps={} hosts={} forward_ports={}",
+        log_token(&record.agent_id.0),
+        record.reason.as_str(),
+        version_token(record.ai_jail_version.as_ref()),
+        record.rw_maps.len(),
+        record.allow_hosts.len(),
+        record.forward_ports.len(),
+    );
+}
+
+/// The R9.2 line of a refused start: the R9.1 fields at error level, with the cause's token.
+fn log_refusal(error: &LaunchError) {
+    log::error!(
+        "agent_sandbox event=launch agent={} jailed=false reason=refused ai_jail={} rw_maps={} hosts={} forward_ports={} cause={}",
+        log_token(&error.agent_id.0),
+        version_token(error.ai_jail_version.as_ref()),
+        error.rw_maps,
+        error.allow_hosts,
+        error.forward_ports,
+        error.cause.as_str(),
+    );
+}
