+}
+
+#[test]
+fn validate_rw_map_refuses_a_symlink_into_the_protected_set() {
+    let h = home();
+    refused(&h, "~/link-to-ssh");
+}
+
+#[test]
+fn validate_rw_map_refuses_colon_before_existence() {
+    let h = home();
+    let text = refused(&h, "~/a:b");
+    assert!(text.contains(':'), "names the ':' rule: {text}");
+    match validate_rw_map("/does/not/exist:x", &h.home, &h.config) {
+        Ok(_) => panic!("a ':' path must be refused"),
+        Err(RwMapError::Missing { .. }) => {
+            panic!("':' is checked before existence; a missing ':' path is the ':' rule")
+        }
+        Err(_) => {}
+    }
+}
+
+#[test]
+fn validate_rw_map_refuses_relative_paths() {
+    let h = home();
+    for raw in ["cache", "./cache", "projects/app"] {
+        let text = refused(&h, raw);
+        assert!(
+            text.to_lowercase().contains("absolute"),
+            "names the absolute-path rule: {text}"
+        );
+    }
+    assert!(
+        validate_rw_map("", &h.home, &h.config).is_err(),
+        "empty is refused"
+    );
+}
+
+#[test]
+fn validate_rw_map_reports_missing_paths_as_missing() {
+    let h = home();
+    let raw = format!("{}/nope", h.home.display());
+    match validate_rw_map(&raw, &h.home, &h.config) {
+        Err(error @ RwMapError::Missing { .. }) => {
