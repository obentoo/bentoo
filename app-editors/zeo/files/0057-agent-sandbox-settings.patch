+// --- cache ------------------------------------------------------------------------------------
+
+#[gpui::test]
+async fn probe_cache_is_keyed_by_path_and_mtime(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let counter = tmp.path().join("spawns");
+    let body = |ver: &str| format!("echo x >> '{}'\necho 'ai-jail {ver}'", counter.display());
+    let spawns = || {
+        std::fs::read_to_string(&counter)
+            .map(|text| text.lines().count())
+            .unwrap_or(0)
+    };
+    let t0 = SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000);
+
+    let a = script(tmp.path(), "a-ai-jail", &body("2.8.1"));
+    set_mtime(&a, t0);
+    assert_eq!(
+        version(&a, &cx.executor()).await.expect("first probe"),
+        v("2.8.1")
+    );
+    assert_eq!(
+        version(&a, &cx.executor()).await.expect("cached probe"),
+        v("2.8.1")
+    );
+    assert_eq!(spawns(), 1, "the same (path, mtime) never spawns twice");
+
+    // Same path, new content, mtime restored: re-probed. The cache key is the binary's identity
+    // (dev, ino, len, mtime, ctime), so a replacement under an identical mtime (Nix sets mtime=1)
+    // must not serve the stale version (tech review, story 043 deviations.yaml 2.2).
+    std::fs::write(&a, format!("#!/bin/sh\n{}\n", body("2.3.9"))).expect("rewrite");
+    set_mtime(&a, t0);
+    assert_eq!(
+        version(&a, &cx.executor()).await.expect("re-probe"),
+        v("2.3.9"),
+        "new content under the same mtime re-probes"
+    );
+    assert_eq!(spawns(), 2);
+
+    // New mtime: re-probed.
+    set_mtime(&a, t0 + Duration::from_secs(60));
+    assert_eq!(
+        version(&a, &cx.executor()).await.expect("re-probe"),
+        v("2.3.9"),
+        "a changed mtime re-probes"
+    );
+    assert_eq!(spawns(), 3);
+
+    // Another path with the same mtime has its own answer.
+    let b = script(tmp.path(), "b-ai-jail", &body("2.7.0"));
+    set_mtime(&b, t0 + Duration::from_secs(60));
+    assert_eq!(
+        version(&b, &cx.executor()).await.expect("other path"),
+        v("2.7.0")
+    );
+    assert_eq!(spawns(), 4);
+}
