+// Story 043, task 2.1 — entry validation (R2.4, R2.5, R2.6, R3.4 message text, Q4). Wired in the
+// crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod validate_tests;
+//
+// Validation filter: `validate` (every test path is `validate_tests::…`).
+//
+// Contract (design.md §agent_sandbox::validate). Assumed signatures — adjust the `use` only:
+//   - `crate::validate::validate_rw_map(raw: &str, home: &Path, config_dir: &Path) -> Result<PathBuf, RwMapError>`
+//     returns the canonical path; a missing path is `RwMapError::Missing` (any payload).
+//   - `crate::validate::validate_host(raw: &str) -> Result<String, HostError>`
+//   - `crate::validate::check_limits(maps: usize, hosts: usize) -> Result<(), LimitError>`
+//   - every error implements `Display` naming the entry and the rule.
+//
+// Rule-wording assertions are deliberately loose (a keyword from the story's rule), so the
+// implementer chooses the sentence; the entry itself must always appear.
+//
+// Hostile halves first:
+//   - forbidden set, wrongly ACCEPT: a symlink whose target is inside `~/.ssh`; an ancestor of
+//     the config dir (`~/.config`); `~/.claude.json` itself.
+//   - forbidden set, wrongly REFUSE (string-prefix collapse): `~/.claude-jailed` (the default
+//     Claude config dir!), `~/.sshkeys`, `~/.config/zeo-other`, `~/.claude.json.d`.
+//   - canonical identity, wrongly SPLIT: `~/cache`, `<home>/cache/`, `<home>/cache/../cache` and
+//     a symlink to it all validate to the same PathBuf (the basis for R1.3 dedup).
+//   - hosts, wrongly ACCEPT: IP literals in every spelling, including `127.1` and `0x7f.1`, which
+//     the system resolver reads as 127.0.0.1 although `std::net::IpAddr` refuses them (an
+//     all-numeric final label is never a DNS name, RFC 3696 §2).
+//   - hosts, wrongly REFUSE: `1.2.3.4.example.com`, `localhost.example.com`, punycode,
+//     a name of exactly 253 characters.
+
+use std::os::unix::fs::symlink;
+use std::path::PathBuf;
+
+use crate::validate::{RwMapError, check_limits, validate_host, validate_rw_map};
+
+struct Home {
+    _tmp: tempfile::TempDir,
+    root: PathBuf,
+    home: PathBuf,
+    config: PathBuf,
+}
+
+fn home() -> Home {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let root = tmp.path().canonicalize().expect("canonical tempdir");
+    let home = root.join("home");
+    let config = home.join(".config/zeo");
+    for dir in [
+        ".config/zeo/themes",
+        ".config/zeo-other",
+        ".claude/projects",
+        ".claude-jailed",
+        ".claude.json.d",
+        ".ssh/sub",
+        ".sshkeys",
+        ".gnupg",
+        "projects/app",
+        "cache",
+        "a:b",
+    ] {
+        std::fs::create_dir_all(home.join(dir)).expect("fixture dir");
+    }
+    std::fs::write(home.join(".claude.json"), "{}").expect("fixture file");
+    std::fs::create_dir_all(root.join("outside/data")).expect("outside dir");
+    symlink(home.join(".ssh"), home.join("link-to-ssh")).expect("symlink");
+    symlink(home.join("cache"), home.join("link-to-cache")).expect("symlink");
+    Home {
+        _tmp: tmp,
+        root,
+        home,
+        config,
+    }
+}
+
+fn refused(h: &Home, raw: &str) -> String {
+    match validate_rw_map(raw, &h.home, &h.config) {
+        Ok(path) => panic!(
+            "{raw:?} must be refused, was accepted as {}",
+            path.display()
+        ),
+        Err(error) => {
+            let text = error.to_string();
+            assert!(
+                text.contains(raw),
+                "the error for {raw:?} must name the entry, got {text:?}"
+            );
+            text
+        }
+    }
+}
+
+fn accepted(h: &Home, raw: &str) -> PathBuf {
+    validate_rw_map(raw, &h.home, &h.config)
+        .unwrap_or_else(|error| panic!("{raw:?} must be accepted, got {error}"))
+}
+
+// --- R2.4: hostile, wrongly ACCEPT -----------------------------------------------------------
+
+#[test]
+fn validate_rw_map_refuses_inside_the_protected_set() {
+    let h = home();
+    for raw in [
+        "~/.ssh",
+        "~/.ssh/sub",
+        "~/.claude",
+        "~/.claude/projects",
+        "~/.gnupg",
+        "~/.config/zeo",
+        "~/.config/zeo/themes",
+        "~/.claude.json",
+    ] {
+        refused(&h, raw);
+    }
+    let absolute = format!("{}/.ssh/sub", h.home.display());
+    refused(&h, &absolute);
+}
+
+#[test]
+fn validate_rw_map_refuses_ancestors_of_the_protected_set() {
+    let h = home();
+    refused(&h, "~/.config");
+    let text = refused(&h, "~");
+    assert!(
+        text.to_lowercase().contains("home"),
+        "names the home rule: {text}"
+    );
+    refused(&h, &h.home.display().to_string());
