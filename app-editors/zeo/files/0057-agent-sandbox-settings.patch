index 0000000..999ac25
--- /dev/null
+++ b/crates/agent_sandbox/src/memory/scope.rs
@@ -0,0 +1,292 @@
+//! Resolves the ai-memory scope (workspace and project) of a project root (R6.7).
+//!
+//! The order mirrors ai-memory's own: the nearest valid `.ai-memory.toml` at or above the root,
+//! then the `upstream` remote, then `origin`, then the root folder's name. The workspace is
+//! [`DEFAULT_WORKSPACE`] unless a marker names one.
+//!
+//! Known limit of the rule: replacing `/` with `-` makes `a-b/c` and `a/b-c` one scope. A marker
+//! disambiguates them.
+
+use std::fmt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use gpui::{App, Entity, Task};
+use project::{Fs, Project};
+
+/// The marker file ai-memory reads, looked up at and above the project root.
+pub const MARKER_FILE_NAME: &str = ".ai-memory.toml";
+
+/// The workspace used when no marker names one.
+pub const DEFAULT_WORKSPACE: &str = "default";
+
+/// A marker larger than this is not a marker anybody wrote by hand; it is skipped unread.
+const MARKER_MAX_BYTES: u64 = 64 * 1024;
+
+/// The ai-memory scope of a project.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MemoryScope {
+    pub workspace: String,
+    pub project: String,
+    /// Where the project name came from.
+    pub resolved_by: ResolvedBy,
+}
+
+impl fmt::Display for MemoryScope {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}/{}", self.workspace, self.project)
+    }
+}
+
+/// The source of a [`MemoryScope`]'s project name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ResolvedBy {
+    /// The `project` key of the nearest valid `.ai-memory.toml`.
+    Marker,
+    /// The `upstream` remote of the nearest git repository.
+    Upstream,
+    /// The `origin` remote of the nearest git repository.
+    Origin,
+    /// The root folder's name.
+    Folder,
+}
+
+impl ResolvedBy {
+    fn as_str(self) -> &'static str {
+        match self {
+            ResolvedBy::Marker => "marker",
+            ResolvedBy::Upstream => "upstream",
+            ResolvedBy::Origin => "origin",
+            ResolvedBy::Folder => "folder",
+        }
+    }
+}
+
+/// [`resolve_scope`] with the project's `Fs`, on the background executor.
+pub fn resolve_project_scope(
+    root: &Path,
+    project: &Entity<Project>,
+    cx: &App,
+) -> Task<MemoryScope> {
+    let fs = project.read(cx).fs().clone();
+    let root = root.to_path_buf();
+    cx.background_executor()
+        .spawn(async move { resolve_scope(&root, fs).await })
+}
+
+/// Resolves the scope of `root` (R6.7). Never fails: every unreadable source falls through to
+/// the next one, ending at the folder name.
+///
+/// The repository is opened untrusted (Zeo's git layer then runs `git` with hooks, the ssh
+/// command and credential helpers disabled), and nothing is spawned here other than through it.
+pub async fn resolve_scope(root: &Path, fs: Arc<dyn Fs>) -> MemoryScope {
+    let marker = find_marker(root, fs.as_ref()).await;
+    let workspace = marker
+        .as_ref()
+        .and_then(|marker| marker.workspace.clone())
+        .unwrap_or_else(|| DEFAULT_WORKSPACE.to_string());
+
+    let (project, resolved_by) = match marker.and_then(|marker| marker.project) {
+        Some(project) => (project, ResolvedBy::Marker),
+        None => match project_from_remotes(root, &fs).await {
+            Some(found) => found,
+            None => (folder_name(root), ResolvedBy::Folder),
+        },
+    };
+
+    log::debug!(
+        "agent_memory event=scope_resolved workspace={workspace:?} project={project:?} by={}",
+        resolved_by.as_str()
+    );
+    MemoryScope {
+        workspace,
+        project,
+        resolved_by,
+    }
+}
+
+/// Derives ai-memory's project name from a git remote URL: the repository path without its
+/// host, with the query, fragment, surrounding slashes and a trailing `.git` dropped and `/`
+/// replaced by `-`. `git@host:a/b.git`, `https://host/a/b`, `ssh://git@host:22/a/b.git` all give
+/// `a-b`. A local-path remote (`/srv/x.git`, `../x`) gives `None`; `file:///srv/x.git` gives
+/// `srv-x`.
+pub fn project_from_remote_url(url: &str) -> Option<String> {
+    let url = url.trim();
+    let path = match url.split_once("://") {
+        Some((scheme, rest)) => {
+            let valid_scheme = !scheme.is_empty()
+                && scheme
+                    .chars()
+                    .all(|c| c.is_ascii_alphanumeric() || matches!(c, '+' | '-' | '.'));
+            if !valid_scheme {
+                return None;
+            }
+            // Everything up to the first `/` is the authority: userinfo, host and port.
+            rest.split_once('/').map_or("", |(_, path)| path)
+        }
+        None => {
+            // scp-like syntax: a `:` with no `/` before it. Anything else is a local path.
+            let (host, path) = url.split_once(':')?;
+            if host.is_empty() || host.contains('/') {
+                return None;
+            }
+            path
+        }
+    };
+
+    let path = path.split(['?', '#']).next().unwrap_or_default();
+    let mut segments: Vec<&str> = path.split('/').filter(|s| !s.is_empty()).collect();
+    if let Some(last) = segments.last_mut()
+        && let Some(stripped) = last.strip_suffix(".git")
+        && !stripped.is_empty()
+    {
+        *last = stripped;
+    }
+    if segments.is_empty() {
+        None
+    } else {
+        Some(segments.join("-"))
+    }
+}
+
+/// The keys of a valid marker. Either may be absent.
+struct Marker {
+    workspace: Option<String>,
+    project: Option<String>,
+}
+
+/// The nearest valid marker at or above `root`. An invalid one is logged and skipped, so the
+/// search continues upwards; a marker in a sibling or below the root is never looked at.
+async fn find_marker(root: &Path, fs: &dyn Fs) -> Option<Marker> {
+    for dir in root.ancestors() {
+        let path = dir.join(MARKER_FILE_NAME);
+        let Ok(Some(metadata)) = fs.metadata(&path).await else {
+            continue;
+        };
+        if metadata.is_dir {
+            continue;
+        }
+        let text = match read_marker(&path, fs).await {
+            Ok(text) => text,
+            Err(reason) => {
+                log_invalid_marker(&path, reason);
+                continue;
+            }
+        };
+        match parse_marker(&text) {
+            Ok(marker) => return Some(marker),
+            Err(reason) => log_invalid_marker(&path, reason),
+        }
+    }
+    None
+}
+
+/// Reads a marker, or returns the reason code it is not read. Only a regular file is opened
+/// (after following symlinks), so a marker that is a device (`-> /dev/zero`) or a FIFO, which a
+/// hostile clone can ship, is never read and never blocks; the read is also bounded, so a file
+/// swapped after the check cannot grow without limit either.
+async fn read_marker(path: &Path, fs: &dyn Fs) -> Result<String, &'static str> {
+    if fs.is_fake() {
+        // The fake file system has no devices or FIFOs.
+        return fs.load(path).await.map_err(|_| "read_error");
+    }
+    let path = path.to_path_buf();
+    smol::unblock(move || read_regular_file_bounded(&path)).await
+}
+
+fn read_regular_file_bounded(path: &Path) -> Result<String, &'static str> {
+    use std::io::Read as _;
+
+    let is_regular = |metadata: std::fs::Metadata| metadata.file_type().is_file();
+    if !std::fs::metadata(path).is_ok_and(is_regular) {
+        return Err("not_a_regular_file");
+    }
+    let file = std::fs::File::open(path).map_err(|_| "read_error")?;
+    // Checked again on the opened descriptor: the path may have been swapped since.
+    if !file.metadata().is_ok_and(is_regular) {
+        return Err("not_a_regular_file");
+    }
+    let mut bytes = Vec::new();
+    file.take(MARKER_MAX_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| "read_error")?;
+    if bytes.len() as u64 > MARKER_MAX_BYTES {
+        return Err("too_large");
+    }
+    String::from_utf8(bytes).map_err(|_| "parse_error")
+}
+
+/// Parses a marker, or returns the reason code it is invalid. The `toml` error is dropped on
+/// purpose: it quotes the offending line of the file.
+fn parse_marker(text: &str) -> Result<Marker, &'static str> {
+    let table = text.parse::<toml::Table>().map_err(|_| "parse_error")?;
+    Ok(Marker {
+        workspace: name_key(&table, "workspace").map_err(|()| "workspace_not_a_name")?,
+        project: name_key(&table, "project").map_err(|()| "project_not_a_name")?,
+    })
+}
+
+/// An absent key is `Ok(None)`; a key that is not a usable name is `Err`.
+fn name_key(table: &toml::Table, key: &str) -> Result<Option<String>, ()> {
+    match table.get(key) {
+        None => Ok(None),
+        Some(toml::Value::String(name)) if is_name(name) => Ok(Some(name.clone())),
+        Some(_) => Err(()),
+    }
+}
+
+/// A name is non-empty, carries no control character and no surrounding whitespace, so the
+/// scope shown before a Forget is exactly the one the server receives.
+fn is_name(name: &str) -> bool {
+    !name.is_empty() && name.trim() == name && !name.chars().any(char::is_control)
+}
+
+fn log_invalid_marker(path: &Path, reason: &str) {
+    log::warn!("agent_memory event=marker_invalid file={path:?} reason={reason}");
+}
+
+/// The project name from `upstream`, then `origin`, of the nearest repository at or above
+/// `root`. A remote that is a local path does not count.
+async fn project_from_remotes(root: &Path, fs: &Arc<dyn Fs>) -> Option<(String, ResolvedBy)> {
+    let dot_git = nearest_dot_git(root, fs.as_ref()).await?;
+    let git_binary = which::which("git").ok();
+    let repository = match fs.open_repo(&dot_git, git_binary.as_deref()) {
+        Ok(repository) => repository,
+        Err(error) => {
+            let error = format!("{error:#}");
+            let error = error.lines().next().unwrap_or_default();
+            log::warn!(
+                "agent_memory event=repository_unreadable dot_git={dot_git:?} error={error:?}"
+            );
+            return None;
+        }
+    };
+    let remotes = repository.remote_urls().await;
+    [
+        ("upstream", ResolvedBy::Upstream),
+        ("origin", ResolvedBy::Origin),
+    ]
+    .into_iter()
+    .find_map(|(name, resolved_by)| {
+        let project = project_from_remote_url(remotes.get(name)?)?;
+        Some((project, resolved_by))
+    })
+}
+
+/// The nearest `.git` at or above `root`; a `.git` file (a worktree or a submodule) counts.
+async fn nearest_dot_git(root: &Path, fs: &dyn Fs) -> Option<PathBuf> {
+    for dir in root.ancestors() {
+        let dot_git = dir.join(".git");
+        if let Ok(Some(_)) = fs.metadata(&dot_git).await {
+            return Some(dot_git);
+        }
+    }
+    None
+}
+
+/// The root folder's name; a root without one (`/`) falls back to [`DEFAULT_WORKSPACE`].
+fn folder_name(root: &Path) -> String {
+    root.file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+        .unwrap_or_else(|| DEFAULT_WORKSPACE.to_string())
+}
