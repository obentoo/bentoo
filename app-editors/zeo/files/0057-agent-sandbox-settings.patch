+    // --- Q16: Tab reaches every control, and the page scrolls to the focused one ---------------
+
+    /// The controls Tab walks through, in page order, with the selectors their bounds are
+    /// recorded under: the switches, the list inputs, Copy Command, the Memory switch, Refresh and
+    /// one Forget per recent page of the fake ai-memory.
+    const TAB_ORDER: [&str; 9] = [
+        "agent-jail-project-enabled",
+        "agent-jail-rw-map-new",
+        "agent-jail-allow-host-new",
+        "agent-jail-copy-command",
+        "agent-jail-default-enabled",
+        "agent-memory-enabled",
+        "agent-memory-refresh",
+        "agent-memory-forget-0",
+        "agent-memory-forget-1",
+    ];
+
+    #[gpui::test]
+    async fn agent_jail_page_tab_reaches_every_control_in_view(cx: &mut TestAppContext) {
+        use gpui::{AppContext as _, KeyBinding, px};
+        use project::Project;
+        use workspace::{MultiWorkspace, Workspace};
+
+        cx.update(|cx| {
+            crate::test::register_settings(cx);
+            agent_sandbox::init(cx);
+            // Zed binds Tab to `menu::SelectNext`; the settings window turns it into `focus_next`.
+            cx.bind_keys([KeyBinding::new("tab", menu::SelectNext, None)]);
+        });
+        let app_state = cx.update(|cx| {
+            let app_state = workspace::AppState::test(cx);
+            workspace::AppState::set_global(app_state.clone(), cx);
+            app_state
+        });
+        let user = json!({
+            "agent_sandbox": {
+                "ai_jail_path": "/nonexistent/ai-jail",
+                "projects": { "/project": { "enabled": true } }
+            },
+            "agent_memory": { "enabled": true }
+        });
+        cx.update(|cx| {
+            SettingsStore::update_global(cx, |store, cx| {
+                store
+                    .set_user_settings(&user.to_string(), cx)
+                    .result()
+                    .expect("settings");
+            })
+        });
+        let _calls =
+            super::agent_memory_section::fake_memory(super::agent_memory_section::Mode::Ok, cx);
+        app_state
+            .fs
+            .as_fake()
+            .insert_tree("/project", json!({ "main.rs": "fn main() {}" }))
+            .await;
+        let project = cx.update(|cx| {
+            Project::local(
+                app_state.client.clone(),
+                app_state.node_runtime.clone(),
+                app_state.user_store.clone(),
+                app_state.languages.clone(),
+                app_state.fs.clone(),
+                None,
+                project::LocalProjectFlags::default(),
+                cx,
+            )
+        });
+        project
+            .update(cx, |project, cx| {
+                project.find_or_create_worktree("/project", true, cx)
+            })
+            .await
+            .expect("the project worktree");
+        let (_multi_workspace, cx) = cx.add_window_view(|window, cx| {
+            let workspace = cx.new(|cx| {
+                Workspace::new(
+                    Default::default(),
+                    project.clone(),
+                    app_state.clone(),
+                    window,
+                    cx,
+                )
+            });
+            MultiWorkspace::new(workspace, window, cx)
+        });
+        let workspace_handle = cx
+            .window_handle()
+            .downcast::<MultiWorkspace>()
+            .expect("a multi-workspace window");
+        cx.run_until_parked();
+
+        let (settings_window, cx) = cx.add_window_view(|window, cx| {
+            crate::SettingsWindow::new(Some(workspace_handle), window, cx)
+        });
+        // The size of the settings window as it opens, at which the proof saw the gap.
+        cx.simulate_resize(gpui::size(px(900.), px(750.)));
+        cx.run_until_parked();
+        settings_window.update_in(cx, |settings_window, window, cx| {
+            settings_window.push_dynamic_sub_page(
+                "Agent Sandbox (ai-jail)",
+                "Agent Configuration",
+                Some("agent_sandbox"),
+                false,
+                super::super::render_agent_jail_page,
+                window,
+                cx,
+            );
+        });
+        let draw = |cx: &mut VisualTestContext| {
+            for _ in 0..3 {
+                cx.update(|window, cx| {
+                    window.simulate_next_frame(cx);
+                });
+                cx.run_until_parked();
+            }
+        };
+        draw(cx);
+        let viewport = cx
+            .debug_bounds("agent-jail-page")
+            .expect("the page's scroll container");
+        assert!(
+            viewport.bottom() <= px(750.),
+            "the page is clipped by the window: {viewport:?}"
+        );
+        let last = cx
+            .debug_bounds("agent-memory-forget-1")
+            .expect("the last Forget button");
+        assert!(
+            last.top() > viewport.bottom(),
+            "the fixture must start with controls below the fold: {last:?} vs {viewport:?}"
+        );
+
+        let mut reached: Vec<&'static str> = Vec::new();
+        for _ in 0..(TAB_ORDER.len() * 2 + 4) {
+            if let Some(control) = super::super::focused_control()
+                .and_then(|focused| TAB_ORDER.into_iter().find(|name| *name == focused.as_ref()))
+            {
+                let bounds = cx.debug_bounds(control).expect("the focused control");
+                assert!(
+                    bounds.top() >= viewport.top() && bounds.bottom() <= viewport.bottom(),
+                    "{control} is focused out of view: {bounds:?} outside {viewport:?}"
+                );
+                if !reached.contains(&control) {
+                    reached.push(control);
+                }
+            }
+            cx.simulate_keystrokes("tab");
+            draw(cx);
+        }
+        assert_eq!(
+            reached,
+            TAB_ORDER.to_vec(),
+            "Tab reaches every control once, in page order"
+        );
+    }
+}
