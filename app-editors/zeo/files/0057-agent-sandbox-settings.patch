+struct Project {
+    _tmp: tempfile::TempDir,
+    root: PathBuf,
+    claude_dir: PathBuf,
+    data: PathBuf,
+}
+
+fn project(with_dot_zed: bool) -> Project {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let base = tmp.path().canonicalize().expect("canonical");
+    let root = base.join("app");
+    std::fs::create_dir_all(root.join(".git")).expect("project");
+    if with_dot_zed {
+        std::fs::create_dir_all(root.join(".zed")).expect(".zed");
+    }
+    let claude_dir = base.join("claude-jailed");
+    let data = base.join("data");
+    std::fs::create_dir_all(&claude_dir).expect("claude dir");
+    std::fs::create_dir_all(&data).expect("data");
+    Project {
+        _tmp: tmp,
+        root,
+        claude_dir,
+        data,
+    }
+}
+
+fn jailed(
+    bin: &Path,
+    p: &Project,
+    script: &str,
+    ports: &[u16],
+    dry_run: bool,
+) -> AgentServerCommand {
+    let rw = [p.data.clone()];
+    let hosts = ["anthropic.com".to_string()];
+    let agent = AgentServerCommand {
+        path: PathBuf::from("/bin/sh"),
+        args: vec!["-c".into(), script.into()],
+        env: Some(HashMap::from_iter([(
+            "PROBE_SECRET".to_string(),
+            SECRET.to_string(),
+        )])),
+    };
+    let mut cmd = generate(
+        agent,
+        &JailInputs {
+            ai_jail: bin,
+            project_root: &p.root,
+            claude_dir: &p.claude_dir,
+            rw_maps: &rw,
+            allow_hosts: &hosts,
+            forward_ports: ports,
+            env_names: vec!["PROBE_SECRET".into()],
+        },
+    );
+    if dry_run {
+        assert_eq!(cmd.args[0], "--exec");
+        cmd.args.insert(1, "--dry-run".into());
+    }
+    cmd
+}
+
+fn run(p: &Project, cmd: &AgentServerCommand) -> std::process::Output {
+    assert!(
+        !cmd.args.iter().any(|arg| arg.contains(SECRET)),
+        "the env value is never on argv: {:?}",
+        cmd.args
+    );
+    let output = execute(p, &cmd.path, &cmd.args, cmd);
+    if !output.status.success() {
+        eprintln!("which flag broke: {}", which_flag_broke(p, cmd));
+    }
+    output
+}
+
+#[allow(
+    clippy::disallowed_methods,
+    reason = "a synchronous test helper: blocking until the jailed child exits is the point"
+)]
+fn execute(
+    p: &Project,
+    path: &Path,
+    args: &[String],
+    cmd: &AgentServerCommand,
+) -> std::process::Output {
+    Command::new(path)
+        .args(args)
+        .envs(cmd.env.clone().unwrap_or_default())
+        .current_dir(&p.root)
+        .output()
+        .expect("ai-jail runs")
+}
+
+/// Names the jail option ai-jail refuses, by re-running `--dry-run` without each option in turn.
+/// A dry run that accepts the whole argv means the failure happened inside the jail (the script's
+/// `BOUNDARY:` line says what).
+fn which_flag_broke(p: &Project, cmd: &AgentServerCommand) -> String {
+    let separator = cmd
+        .args
+        .iter()
+        .position(|arg| arg == "--")
+        .unwrap_or(cmd.args.len());
+    let (jail, agent) = cmd.args.split_at(separator);
+    let jail: Vec<&String> = jail.iter().filter(|arg| *arg != "--dry-run").collect();
+    let dry = |options: &[&String]| -> bool {
+        let mut args: Vec<String> = Vec::with_capacity(options.len() + agent.len() + 1);
+        args.push("--exec".into());
+        args.push("--dry-run".into());
+        args.extend(
+            options
+                .iter()
+                .filter(|arg| **arg != "--exec")
+                .map(|arg| (*arg).clone()),
+        );
+        args.extend(agent.iter().cloned());
+        execute(p, &cmd.path, &args, cmd).status.success()
+    };
+    if dry(&jail) {
+        return "none: ai-jail accepts the whole argv under --dry-run, so the failure is inside \
+                the jail (see the script's BOUNDARY: line)"
+            .into();
+    }
+    // Options are a flag, optionally followed by one value that does not start with `--`.
+    let mut options: Vec<(usize, usize)> = Vec::new();
+    let mut index = 0;
+    while index < jail.len() {
+        let takes_value = jail
+            .get(index + 1)
+            .is_some_and(|next| !next.starts_with("--"));
+        let end = if takes_value { index + 2 } else { index + 1 };
+        options.push((index, end));
+        index = end;
+    }
+    let culprits: Vec<String> = options
+        .iter()
+        .filter(|(start, _)| jail[*start] != "--exec")
+        .filter(|(start, end)| {
+            let without: Vec<&String> = jail[..*start]
+                .iter()
+                .chain(jail[*end..].iter())
+                .copied()
+                .collect();
+            dry(&without)
+        })
+        .map(|(start, end)| {
+            jail[*start..*end]
+                .iter()
+                .map(|arg| arg.as_str())
+                .collect::<Vec<_>>()
+                .join(" ")
+        })
+        .collect();
+    if culprits.is_empty() {
+        "unknown: no single jail option, removed alone, makes --dry-run accept the argv".into()
+    } else {
+        culprits.join(", ")
+    }
+}
+
+fn report(what: &str, output: &std::process::Output) -> String {
+    format!(
+        "{what}: status {:?}\n--- stdout\n{}\n--- stderr\n{}",
+        output.status.code(),
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    )
+}
+
+/// The boundary probe run as the agent. The env value is spelled in two quoted halves so the
+/// script itself never carries it whole and the argv guard in [`run`] stays meaningful.
+fn boundary_script(p: &Project) -> String {
+    r#"
+        fail() { echo "BOUNDARY: $1" >&2; exit 1; }
+        touch ./inside-probe || fail "project not writable"
+        touch "$DATA/rw-probe" || fail "--rw-map not writable"
+        touch "$CLAUDE/claude-probe" || fail "--claude-dir not writable"
+        if touch .git/git-probe 2>/dev/null; then fail ".git writable (--map .git)"; fi
+        if touch .zed/zed-probe 2>/dev/null; then fail ".zed writable (--map .zed)"; fi
+        if test -e "$HOME/.config/zeo/settings.json"; then fail "Zeo settings visible (R2.7)"; fi
+        test "$PROBE_SECRET" = "env-value-043-must-not-be-"'on-argv' || fail "--env NAME value missing"
+        echo BOUNDARY-OK
+    "#
+    .replace("$DATA", &p.data.display().to_string())
+    .replace("$CLAUDE", &p.claude_dir.display().to_string())
+}
