+/// Probes `bin` the way the launch path does: version and `--forward-port` support.
+async fn probed(bin: &Path, cx: &mut TestAppContext) -> JailBinary {
+    // A real child answers in real time; without parking the fake clock fires the 2 s timeout first.
+    cx.executor().allow_parking();
+    let binary = probe::probe(bin, &cx.executor())
+        .await
+        .unwrap_or_else(|error| panic!("probe {}: {error}", bin.display()));
+    eprintln!(
+        "probe: {} is ai-jail {}, --forward-port {}",
+        bin.display(),
+        binary.version,
+        if binary.supports_forward_port {
+            "offered"
+        } else {
+            "not offered"
+        }
+    );
+    binary
+}
+
+/// The ports R7.1/R7.4 forward for memory: `port` when the binary offers `--forward-port`, none
+/// otherwise.
+fn memory_ports(binary: &JailBinary, port: u16) -> Vec<u16> {
+    if binary.supports_forward_port {
+        vec![port]
+    } else {
+        Vec::new()
+    }
+}
