+
+/// Every name of the command's env, as if the agent's settings configured each one.
+fn configured_env(cmd: &AgentServerCommand) -> std::collections::HashSet<String> {
+    cmd.env.iter().flat_map(|env| env.keys().cloned()).collect()
+}
+
+fn jailed(decision: LaunchDecision) -> (LaunchRecord, AgentServerCommand) {
+    match decision {
+        LaunchDecision::Jailed(record, cmd) => (record, cmd),
+        LaunchDecision::Unchanged(_) => panic!("expected Jailed, got Unchanged"),
+        LaunchDecision::Refused(error) => panic!("expected Jailed, got Refused: {error}"),
+    }
+}
+
+fn unchanged(decision: LaunchDecision) -> LaunchRecord {
+    match decision {
+        LaunchDecision::Unchanged(record) => record,
+        LaunchDecision::Jailed(_, cmd) => panic!("expected Unchanged, got Jailed {:?}", cmd.args),
+        LaunchDecision::Refused(error) => panic!("expected Unchanged, got Refused: {error}"),
+    }
+}
+
+fn refused(decision: LaunchDecision) -> String {
+    match decision {
+        LaunchDecision::Refused(error) => {
+            let text = format!("{error:#}");
+            assert!(
+                text.trim_end()
+                    .ends_with("The agent was not started without the sandbox."),
+                "every refusal ends with the fail-closed sentence: {text}"
+            );
+            text
+        }
+        LaunchDecision::Jailed(_, cmd) => panic!("expected Refused, got Jailed {:?}", cmd.args),
+        LaunchDecision::Unchanged(_) => {
+            panic!("expected Refused, got Unchanged (an unjailed start)")
+        }
+    }
+}
+
+fn count(args: &[String], flag: &str, value: &str) -> usize {
+    args.windows(2)
+        .filter(|pair| pair[0] == flag && pair[1] == value)
+        .count()
+}
