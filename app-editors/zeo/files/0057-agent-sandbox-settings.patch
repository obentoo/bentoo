+//! The agent thread's jail icon (story 043, R5): how an external agent was started, read from
+//! the `LaunchRegistry` record of its (agent, root), drawn where Zed draws its native sandbox
+//! icon.
+
+use agent_sandbox::launch::{self, LaunchRecord, MemoryPort, Reason};
+use agent_sandbox::probe;
+use gpui::{AnyElement, SharedString};
+use ui::{Divider, Tooltip, prelude::*};
+
+const REMOTE: &str = "The agent sandbox is not available for remote projects.";
+const OWN_COMMAND: &str = "Sandboxed by its agent_servers command; not managed by Zeo.";
+const NOT_CLAUDE: &str =
+    "Not a Claude agent: the agent sandbox applies only to the Claude adapters.";
+const DRIFTED: &str = "Restart the agent to apply the new setting.";
+
+/// What the icon draws and what its tooltip says.
+#[derive(Clone, Debug, PartialEq)]
+pub struct JailStatusSummary {
+    pub icon: IconName,
+    pub color: Color,
+    pub lines: Vec<SharedString>,
+}
+
+/// The icon's presentation for `record`; `drifted` is whether the settings of now differ from
+/// those the agent was started with (R5.4).
+pub fn jail_status_summary(record: &LaunchRecord, drifted: bool) -> JailStatusSummary {
+    let mut lines: Vec<SharedString> = Vec::new();
+    let icon = match record.reason {
+        Reason::On => {
+            lines.push("Started inside the agent sandbox (ai-jail).".into());
+            lines.push(
+                format!(
+                    "ai-jail version: {}",
+                    record
+                        .ai_jail_version
+                        .as_ref()
+                        .map_or_else(|| "unknown".to_string(), ToString::to_string)
+                )
+                .into(),
+            );
+            lines.push(list_line(
+                "Writable folders",
+                record.rw_maps.iter().map(|path| path.display().to_string()),
+            ));
+            lines.push(list_line(
+                "Allowed hosts",
+                record.allow_hosts.iter().cloned(),
+            ));
+            lines.push(list_line(
+                "Forwarded ports",
+                record.forward_ports.iter().map(ToString::to_string),
+            ));
+            IconName::Lock
+        }
+        Reason::OwnCommand => {
+            lines.push(OWN_COMMAND.into());
+            IconName::Lock
+        }
+        Reason::Off => {
+            lines.push("Started without the agent sandbox.".into());
+            IconName::LockOff
+        }
+        Reason::Remote => {
+            lines.push(REMOTE.into());
+            IconName::LockOff
+        }
+        Reason::NotClaude => {
+            lines.push(NOT_CLAUDE.into());
+            IconName::LockOff
+        }
+    };
+
+    let outdated_version = record
+        .ai_jail_version
+        .as_ref()
+        .filter(|version| icon == IconName::Lock && probe::is_outdated(version));
+    if let Some(version) = outdated_version {
+        lines.push(probe::outdated_warning(version).into());
+    }
+    if record.memory_port == MemoryPort::Unsupported {
+        lines.push(launch::MEMORY_PORT_UNSUPPORTED.into());
+    }
+    if drifted {
+        lines.push(DRIFTED.into());
+    }
+
+    let color = if outdated_version.is_some() {
+        Color::Warning
+    } else if icon == IconName::Lock {
+        Color::Default
+    } else {
+        Color::Muted
+    };
+    JailStatusSummary { icon, color, lines }
+}
+
+fn list_line(label: &str, items: impl Iterator<Item = String>) -> SharedString {
+    let items: Vec<String> = items.collect();
+    if items.is_empty() {
+        format!("{label}: none").into()
+    } else {
+        format!("{label}: {}", items.join(", ")).into()
+    }
+}
+
+/// The toolbar button for `summary`: the lock, its tooltip and a divider, like
+/// `ThreadView::render_sandbox_status`. A click opens the Agent Sandbox settings page (R5.5).
+pub fn render_jail_status_button(summary: JailStatusSummary) -> AnyElement {
+    let JailStatusSummary { icon, color, lines } = summary;
+    h_flex()
+        .gap_1()
+        .child(
+            IconButton::new("agent-jail-status", icon)
+                .icon_size(IconSize::Small)
+                .icon_color(color)
+                .tooltip(Tooltip::element(move |_window, _cx| {
+                    v_flex()
+                        .w(rems_from_px(320_f32))
+                        .gap_1()
+                        .child(Label::new("Agent Sandbox"))
+                        .children(lines.iter().map(|line| {
+                            Label::new(line.clone())
+                                .size(LabelSize::Small)
+                                .color(Color::Muted)
+                        }))
+                        .into_any_element()
+                }))
+                .on_click(|_, window, cx| {
+                    window.dispatch_action(
+                        Box::new(zed_actions::OpenSettingsAt {
+                            path: zed_actions::AGENT_JAIL_SETTINGS_PATH.to_string(),
+                            target: None,
+                        }),
+                        cx,
+                    );
+                }),
+        )
+        .child(Divider::vertical())
+        .into_any_element()
+}
