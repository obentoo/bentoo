--- /dev/null
+++ b/crates/agent_sandbox/src/command.rs
@@ -0,0 +1,175 @@
+//! Builds the ai-jail command that wraps a Claude adapter, and its read-only preview.
+//!
+//! Pure: no I/O, no settings reads. Every input is validated by the caller (`validate`, `probe`)
+//! before it reaches [`generate`].
+
+use std::borrow::Cow;
+use std::path::{Path, PathBuf};
+
+use project::agent_server_store::AgentServerCommand;
+
+/// Everything [`generate`] needs besides the agent's own command. All paths are validated.
+pub struct JailInputs<'a> {
+    /// The ai-jail binary, located and version-checked by `probe`.
+    pub ai_jail: &'a Path,
+    /// The project root the agent is spawned in. ai-jail binds its cwd as the writable project,
+    /// so this must be the spawn's working directory; `.git` and `.zed` are mapped read-only from
+    /// it by absolute path, which survives a shell `cd` before ai-jail starts.
+    pub project_root: &'a Path,
+    /// The dedicated Claude config directory; validated and known to exist.
+    pub claude_dir: &'a Path,
+    /// Writable folders: defaults united with the project's entries, deduplicated, order kept.
+    pub rw_maps: &'a [PathBuf],
+    /// Hosts the jail may reach.
+    pub allow_hosts: &'a [String],
+    /// Loopback ports forwarded into the jail (ai-memory, R7). Empty when unsupported or off.
+    pub forward_ports: &'a [u16],
+    /// Names of the agent's environment variables. Values never reach argv.
+    pub env_names: Vec<String>,
+}
+
+/// Wraps `agent` in ai-jail.
+///
+/// The result runs `inputs.ai_jail` with the jail options, then `--`, then the agent's path and
+/// arguments unchanged. `env` is passed through untouched: ai-jail copies each `--env NAME` from
+/// its own process environment, so no value is ever on the command line (R1.4). The `--` is
+/// required: without it ai-jail refuses an agent argument that is also one of its flags, and drops
+/// the agent's own `--` (measured on 2.8.1 and 2.7.0). `--network` (incompatible with
+/// `--forward-port`) and `--agent-state` (no mount for these adapters) are never emitted.
+pub fn generate(agent: AgentServerCommand, inputs: &JailInputs) -> AgentServerCommand {
+    let claude_dir = path_arg(inputs.claude_dir);
+    let mut args: Vec<String> = [
+        // `--exec` first: without it ai-jail interposes a PTY proxy that corrupts the ACP stream.
+        "--exec",
+        "--no-save-config",
+        "--no-status-bar",
+        "--no-toolchains",
+    ]
+    .into_iter()
+    .map(String::from)
+    .collect();
+    for read_only in [".git", ".zed"] {
+        args.push("--map".into());
+        args.push(path_arg(&inputs.project_root.join(read_only)));
+    }
+    args.extend(["--claude-dir".into(), claude_dir.clone()]);
+    args.extend(["--rw-map".into(), claude_dir]);
+    for map in inputs.rw_maps {
+        args.extend(["--rw-map".into(), path_arg(map)]);
+    }
+    for host in inputs.allow_hosts {
+        args.extend(["--allow-host".into(), host.clone()]);
+    }
+    for port in inputs.forward_ports {
+        args.extend(["--forward-port".into(), port.to_string()]);
+    }
+    let mut env_names = inputs.env_names.clone();
+    env_names.sort();
+    for name in env_names {
+        args.extend(["--env".into(), name]);
+    }
+    args.push("--".into());
+    args.push(path_arg(&agent.path));
+    args.extend(agent.args);
+
+    AgentServerCommand {
+        path: inputs.ai_jail.to_path_buf(),
+        args,
+        env: agent.env,
+    }
+}
+
+/// The variable that carries the proxy exclusion into the jail, set in ai-jail's environment by
+/// the launch and forwarded with `--env` by [`keep_loopback_off_proxy`].
+pub const NO_PROXY_CARRIER: &str = "ZEO_NO_PROXY";
+
+/// The loopback names a forwarded port is reached through inside the jail.
+const LOOPBACK: [&str; 3] = ["127.0.0.1", "localhost", "::1"];
+
+/// Restores the loopback proxy exclusion inside the jail: exports `no_proxy` and `NO_PROXY` from
+/// the carrier (loopback alone when it is missing), drops the carrier, and execs the agent.
+const NO_PROXY_SCRIPT: &str = concat!(
+    r#"export no_proxy="${ZEO_NO_PROXY:-127.0.0.1,localhost,::1}" "#,
+    r#"NO_PROXY="${ZEO_NO_PROXY:-127.0.0.1,localhost,::1}"; "#,
+    r#"unset ZEO_NO_PROXY; exec "$@""#
+);
+
+/// The proxy exclusion a jail with a forwarded port needs: the loopback names first, then every
+/// entry of `configured` (comma lists, such as a configured `no_proxy` and `NO_PROXY`), trimmed,
+/// with empty and repeated entries dropped.
+pub fn loopback_no_proxy<'a>(configured: impl IntoIterator<Item = &'a str>) -> String {
+    let mut entries: Vec<&str> = LOOPBACK.to_vec();
+    for entry in configured
+        .into_iter()
+        .flat_map(|list| list.split(','))
+        .map(str::trim)
+    {
+        if !entry.is_empty() && !entries.contains(&entry) {
+            entries.push(entry);
+        }
+    }
+    entries.join(",")
+}
+
+/// Keeps loopback off ai-jail's egress proxy for a [`generate`]d command that forwards a port.
+///
+/// With filtered egress ai-jail exports its own `http_proxy`/`HTTPS_PROXY` and sets `no_proxy` and
+/// `NO_PROXY` empty after every `--env` (measured on the fork's 2.7.0), so a client honouring them
+/// sends `http://127.0.0.1:<port>` to the proxy instead of the forwarded port. A `--env no_proxy`
+/// cannot win; the agent is therefore started through `/bin/sh`, which exports the exclusion from
+/// [`NO_PROXY_CARRIER`] (forwarded here by name, so no value reaches argv) and then execs the agent
+/// with its arguments unchanged. Inside the jail's network namespace loopback reaches only
+/// ai-jail's own bridges, so the exclusion opens no route the proxy guards.
+pub fn keep_loopback_off_proxy(mut cmd: AgentServerCommand) -> AgentServerCommand {
+    // `generate` emits exactly one `--`, right before the agent; the jail options carry none.
+    let Some(separator) = cmd.args.iter().position(|arg| arg == "--") else {
+        return cmd;
+    };
+    let agent = cmd.args.split_off(separator + 1);
+    cmd.args.pop();
+    let carried = cmd
+        .args
+        .windows(2)
+        .any(|pair| pair[0] == "--env" && pair[1] == NO_PROXY_CARRIER);
+    if !carried {
+        cmd.args.extend(["--env".into(), NO_PROXY_CARRIER.into()]);
+    }
+    cmd.args.extend(
+        ["--", "/bin/sh", "-c", NO_PROXY_SCRIPT, "sh"]
+            .into_iter()
+            .map(String::from),
+    );
+    cmd.args.extend(agent);
+    cmd
+}
+
+/// Renders `cmd` as one shell line, each word quoted so that a shell split gives back the exact
+/// argv. Never reads `cmd.env`, so no value can appear (R3.7).
+pub fn preview(cmd: &AgentServerCommand) -> String {
+    let path = cmd.path.to_string_lossy();
+    std::iter::once(path.as_ref())
+        .chain(cmd.args.iter().map(String::as_str))
+        .map(quote)
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// A path as an argv word.
+///
+/// Invariant: every jail path reaching [`generate`] is UTF-8, because `validate` refuses a
+/// canonical path that is not, so the lossy conversion never alters one. The agent path is not
+/// validated there; a non-UTF-8 one would become a path that does not exist, and ai-jail would
+/// fail to start the agent (closed, never widened). Lossy instead of `expect`: a broken invariant
+/// degrades to a visibly wrong path, not a panic.
+fn path_arg(path: &Path) -> String {
+    path.to_string_lossy().into_owned()
+}
+
+/// Shell-quotes one word. `shlex` refuses only a NUL byte, which no shell word can carry; the
+/// fallback single-quotes the word and shows each NUL as `\0`, so the preview stays readable.
+fn quote(word: &str) -> Cow<'_, str> {
+    shlex::try_quote(word).unwrap_or_else(|_| {
+        let escaped = word.replace('\'', r"'\''").replace('\0', r"\0");
+        Cow::Owned(format!("'{escaped}'"))
+    })
+}
diff --git a/crates/agent_sandbox/src/command_tests.rs b/crates/agent_sandbox/src/command_tests.rs
