@@ -0,0 +1,387 @@
+//! Locating ai-jail, reading its version and whether it offers `--forward-port`.
+//!
+//! The answer is cached per binary identity, so an agent start costs one `stat` once warm.
+
+use std::collections::HashMap;
+use std::fmt;
+use std::io;
+use std::os::unix::fs::MetadataExt as _;
+use std::path::{Path, PathBuf};
+use std::pin::pin;
+use std::process::Stdio;
+use std::sync::{LazyLock, Mutex, PoisonError};
+use std::time::Duration;
+
+use futures::{AsyncReadExt as _, FutureExt as _};
+use gpui::BackgroundExecutor;
+use semver::Version;
+
+/// The first release with the fixes for GHSA-frgp-q3qc-g78p and GHSA-w976-gw52-hvx2.
+pub const MIN_SAFE: Version = Version::new(2, 4, 0);
+
+const TIMEOUT: Duration = Duration::from_secs(2);
+const MAX_OUTPUT_BYTES: u64 = 64 * 1024;
+const MAX_SHOWN_CHARS: usize = 120;
+const BUSY_RETRIES: usize = 20;
+const BUSY_BACKOFF: Duration = Duration::from_millis(10);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct JailBinary {
+    pub version: Version,
+    pub supports_forward_port: bool,
+}
+
+#[derive(Debug)]
+pub enum ProbeError {
+    Spawn { path: PathBuf, source: io::Error },
+    TimedOut { path: PathBuf },
+    Exited { path: PathBuf, code: Option<i32> },
+    Unparsable { path: PathBuf, first_line: String },
+}
+
+impl fmt::Display for ProbeError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Spawn { path, source } => {
+                write!(f, "could not run {}: {source}", path.display())
+            }
+            Self::TimedOut { path } => write!(
+                f,
+                "{} --version did not answer within {} seconds",
+                path.display(),
+                TIMEOUT.as_secs()
+            ),
+            Self::Exited {
+                path,
+                code: Some(code),
+            } => write!(f, "{} --version exited with code {code}", path.display()),
+            Self::Exited { path, code: None } => {
+                write!(f, "{} --version was ended by a signal", path.display())
+            }
+            Self::Unparsable { path, first_line } => write!(
+                f,
+                "{} --version printed {first_line:?}, not \"ai-jail X.Y.Z\"",
+                path.display()
+            ),
+        }
+    }
+}
+
+impl std::error::Error for ProbeError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Spawn { source, .. } => Some(source),
+            _ => None,
+        }
+    }
+}
+
+/// The `ai_jail_path` setting (`~` expanded, returned even when it does not exist, so the
+/// refusal names it), else `ai-jail` on `PATH`.
+pub fn locate(setting: Option<&Path>) -> Option<PathBuf> {
+    match setting {
+        Some(path) => Some(expand_home(path)),
+        None => which::which("ai-jail").ok(),
+    }
+}
+
+fn expand_home(path: &Path) -> PathBuf {
+    match path.strip_prefix("~") {
+        Ok(rest) => paths::home_dir().join(rest),
+        Err(_) => path.to_path_buf(),
+    }
+}
+
+pub fn is_outdated(version: &Version) -> bool {
+    *version < MIN_SAFE
+}
+
+/// The R3.5 warning, shared by the settings page and the status icon's tooltip.
+pub fn outdated_warning(version: &Version) -> String {
+    format!(
+        "ai-jail {version} is older than {MIN_SAFE} and is affected by GHSA-frgp-q3qc-g78p and \
+         GHSA-w976-gw52-hvx2. Update ai-jail to {MIN_SAFE} or newer."
+    )
+}
+
+/// Runs `<path> --version` (2 s timeout) and parses `ai-jail X.Y.Z`.
+pub async fn version(path: &Path, executor: &BackgroundExecutor) -> Result<Version, ProbeError> {
+    let identity = identify(path);
+    if let Some((key, identity)) = &identity
+        && let Some(entry) = cached(key, identity)
+    {
+        return Ok(entry.version);
+    }
+    let program = identity.as_ref().map_or(path, |(key, _)| key.as_path());
+    let version = read_version(path, program, executor).await?;
+    if let Some((key, identity)) = identity {
+        store(key, identity, version.clone(), None);
+    }
+    Ok(version)
+}
+
+/// [`version`], then `<path> --help` (same timeout) for `--forward-port`. A failing `--help`
+/// clears the flag; it is not a refusal.
+pub async fn probe(path: &Path, executor: &BackgroundExecutor) -> Result<JailBinary, ProbeError> {
+    let identity = identify(path);
+    let cached_entry = identity
+        .as_ref()
+        .and_then(|(key, identity)| cached(key, identity));
+    if let Some(CacheEntry {
+        version,
+        supports_forward_port: Some(supports_forward_port),
+        ..
+    }) = cached_entry
+    {
+        return Ok(JailBinary {
+            version,
+            supports_forward_port,
+        });
+    }
+    let program = identity.as_ref().map_or(path, |(key, _)| key.as_path());
+    let version = match cached_entry {
+        Some(entry) => entry.version,
+        None => read_version(path, program, executor).await?,
+    };
+    let supports_forward_port = match run(program, "--help", executor).await {
+        Ok(Output {
+            success: true,
+            stdout,
+            ..
+        }) => help_lists_forward_port(&String::from_utf8_lossy(&stdout)),
+        Ok(_) | Err(_) => false,
+    };
+    log::debug!(
+        "agent_sandbox event=probe path={} version={version} forward_port={supports_forward_port}",
+        path.display()
+    );
+    if let Some((key, identity)) = identity {
+        store(key, identity, version.clone(), Some(supports_forward_port));
+    }
+    Ok(JailBinary {
+        version,
+        supports_forward_port,
+    })
+}
+
+async fn read_version(
+    path: &Path,
+    program: &Path,
+    executor: &BackgroundExecutor,
+) -> Result<Version, ProbeError> {
+    let output = run(program, "--version", executor)
+        .await
+        .map_err(|failure| match failure {
+            RunFailure::Spawn(source) => ProbeError::Spawn {
+                path: path.to_path_buf(),
+                source,
+            },
+            RunFailure::TimedOut => ProbeError::TimedOut {
+                path: path.to_path_buf(),
+            },
+        })?;
+    if !output.success {
+        return Err(ProbeError::Exited {
+            path: path.to_path_buf(),
+            code: output.code,
+        });
+    }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let first_line = text.lines().next().unwrap_or_default().trim_end();
+    first_line
+        .strip_prefix("ai-jail ")
+        .and_then(|version| Version::parse(version).ok())
+        .ok_or_else(|| ProbeError::Unparsable {
+            path: path.to_path_buf(),
+            first_line: truncate(first_line),
+        })
+}
+
+/// A binary printing 64 KiB without a newline must not flood the settings page or the log.
+fn truncate(line: &str) -> String {
+    match line.char_indices().nth(MAX_SHOWN_CHARS) {
+        Some((cut, _)) => format!("{}…", &line[..cut]),
+        None => line.to_string(),
+    }
+}
+
+/// True when the option column of a help line is `--forward-port`; prose that mentions the flag
+/// and longer option names do not count.
+///
+/// The option column is the indentation of the first line that starts with `-`. Wrapped
+/// descriptions sit deeper and may themselves start with a flag (2.8.1's `--env` entry wraps
+/// onto a line beginning with `--env-from-file`), so deeper lines are never options.
+fn help_lists_forward_port(help: &str) -> bool {
+    let indentation = |line: &str| line.len() - line.trim_start().len();
+    let Some(option_column) = help
+        .lines()
+        .find(|line| line.trim_start().starts_with('-'))
+        .map(indentation)
+    else {
+        return false;
+    };
+    help.lines().any(|line| {
+        if indentation(line) > option_column {
+            return false;
+        }
+        let option = strip_short_flag(line.trim_start());
+        option
+            .strip_prefix("--forward-port")
+            .is_some_and(|rest| match rest.chars().next() {
+                None => true,
+                Some(next) => next.is_whitespace() || matches!(next, '<' | '=' | '['),
+            })
+    })
+}
+
+fn strip_short_flag(line: &str) -> &str {
+    let mut chars = line.chars();
+    match (chars.next(), chars.next(), chars.next()) {
+        (Some('-'), Some(letter), Some(',')) if letter.is_ascii_alphanumeric() => {
+            chars.as_str().trim_start()
+        }
+        _ => line,
+    }
+}
+
+struct Output {
+    success: bool,
+    code: Option<i32>,
+    stdout: Vec<u8>,
+}
+
+enum RunFailure {
+    Spawn(io::Error),
+    TimedOut,
+}
+
+async fn run(
+    program: &Path,
+    argument: &str,
+    executor: &BackgroundExecutor,
+) -> Result<Output, RunFailure> {
+    let mut work = pin!(run_untimed(program, argument, executor).fuse());
+    let mut timer = pin!(executor.timer(TIMEOUT).fuse());
+    futures::select_biased! {
+        output = work => output.map_err(RunFailure::Spawn),
+        () = timer => Err(RunFailure::TimedOut),
+    }
+}
+
+async fn run_untimed(
+    program: &Path,
+    argument: &str,
+    executor: &BackgroundExecutor,
+) -> io::Result<Output> {
+    let mut child = spawn(program, argument, executor).await?;
+    let mut stdout = Vec::new();
+    if let Some(pipe) = child.stdout.take() {
+        // Reading past the cap is never needed; dropping the pipe afterwards lets a chatty child
+        // finish instead of blocking on a full pipe.
+        pipe.take(MAX_OUTPUT_BYTES).read_to_end(&mut stdout).await?;
+    }
+    let status = child.status().await?;
+    Ok(Output {
+        success: status.success(),
+        code: status.code(),
+        stdout,
+    })
+}
+
+/// A binary being written — mid-upgrade, or held open by a sibling's fork — fails exec with
+/// ETXTBSY for a moment; wait it out instead of reporting ai-jail missing.
+async fn spawn(
+    program: &Path,
+    argument: &str,
+    executor: &BackgroundExecutor,
+) -> io::Result<smol::process::Child> {
+    let mut attempt = 0;
+    loop {
+        let mut command = smol::process::Command::new(program);
+        command
+            .arg(argument)
+            .env_clear()
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        // The probe child needs no secret: only what locating its interpreter takes.
+        for name in ["PATH", "HOME"] {
+            if let Some(value) = std::env::var_os(name) {
+                command.env(name, value);
+            }
+        }
+        match command.spawn() {
+            Err(error) if error.kind() == io::ErrorKind::ExecutableFileBusy => {
+                attempt += 1;
+                if attempt >= BUSY_RETRIES {
+                    return Err(error);
+                }
+                executor.timer(BUSY_BACKOFF).await;
+            }
+            result => return result,
+        }
+    }
+}
+
+/// What makes a cached answer stale: a replaced binary keeps neither its inode nor its ctime,
+/// even when its mtime is restored (Nix stores every file with mtime=1).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct BinaryIdentity {
+    dev: u64,
+    ino: u64,
+    len: u64,
+    mtime: i128,
+    ctime: i128,
+}
+
+#[derive(Clone)]
+struct CacheEntry {
+    identity: BinaryIdentity,
+    version: Version,
+    supports_forward_port: Option<bool>,
+}
+
+static CACHE: LazyLock<Mutex<HashMap<PathBuf, CacheEntry>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+fn identify(path: &Path) -> Option<(PathBuf, BinaryIdentity)> {
+    let canonical = std::fs::canonicalize(path).ok()?;
+    let metadata = std::fs::metadata(&canonical).ok()?;
+    let nanos = |seconds: i64, nanoseconds: i64| {
+        i128::from(seconds) * 1_000_000_000 + i128::from(nanoseconds)
+    };
+    let identity = BinaryIdentity {
+        dev: metadata.dev(),
+        ino: metadata.ino(),
+        len: metadata.len(),
+        mtime: nanos(metadata.mtime(), metadata.mtime_nsec()),
+        ctime: nanos(metadata.ctime(), metadata.ctime_nsec()),
+    };
+    Some((canonical, identity))
+}
+
+fn cached(key: &Path, identity: &BinaryIdentity) -> Option<CacheEntry> {
+    let cache = CACHE.lock().unwrap_or_else(PoisonError::into_inner);
+    cache
+        .get(key)
+        .filter(|entry| entry.identity == *identity)
+        .cloned()
+}
+
+fn store(
+    key: PathBuf,
+    identity: BinaryIdentity,
+    version: Version,
+    supports_forward_port: Option<bool>,
+) {
+    let mut cache = CACHE.lock().unwrap_or_else(PoisonError::into_inner);
+    cache.insert(
+        key,
+        CacheEntry {
+            identity,
+            version,
+            supports_forward_port,
+        },
+    );
+}
