+/// The devtools bridge socket on the host. A live Zeo's socket is used as-is and never touched;
+/// when there is none, a throwaway listener is created and only it (and the `zeo` dir, if this
+/// created it and it is empty) is removed on drop.
+struct BridgeSocket {
+    path: PathBuf,
+    owned: Option<(UnixListener, bool)>,
+}
+
+impl BridgeSocket {
+    fn at(runtime_dir: &Path) -> Self {
+        let dir = runtime_dir.join("zeo");
+        let path = dir.join("devtools.sock");
+        if path.exists() {
+            eprintln!("bridge: using the existing {} as-is", path.display());
+            return Self { path, owned: None };
+        }
+        let created_dir = !dir.exists();
+        if created_dir {
+            std::fs::create_dir(&dir).expect("create the zeo runtime dir");
+        }
+        let listener = UnixListener::bind(&path).expect("bind a throwaway bridge socket");
+        eprintln!("bridge: created a throwaway listener at {}", path.display());
+        Self {
+            path,
+            owned: Some((listener, created_dir)),
+        }
+    }
+}
+
+impl Drop for BridgeSocket {
+    fn drop(&mut self) {
+        let Some((listener, created_dir)) = self.owned.take() else {
+            return;
+        };
+        drop(listener);
+        if let Err(error) = std::fs::remove_file(&self.path) {
+            eprintln!("bridge: could not remove {}: {error}", self.path.display());
+        }
+        if created_dir && let Some(dir) = self.path.parent() {
+            // `remove_dir` refuses a non-empty dir, which is then someone else's and stays.
+            if let Err(error) = std::fs::remove_dir(dir) {
+                eprintln!("bridge: left {} in place: {error}", dir.display());
+            }
+        }
+    }
+}
+
+// Added in v2 (R2.11): the devtools bridge socket exists on the host and is not reachable from the
+// jail, so a jailed agent cannot drive an unjailed thread through it.
+#[gpui::test]
+async fn real_ai_jail_hides_the_devtools_bridge_socket(cx: &mut TestAppContext) {
+    let Some(bin) = ai_jail() else { return };
+    let Some(runtime_dir) = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from) else {
+        eprintln!("skipped: XDG_RUNTIME_DIR is not set, so there is no bridge socket path");
+        return;
+    };
+    let binary = probed(&bin, cx).await;
+    let bridge = BridgeSocket::at(&runtime_dir);
+    let file_type = std::fs::metadata(&bridge.path)
+        .expect("the bridge socket exists on the host")
+        .file_type();
+    assert!(
+        file_type.is_socket(),
+        "{} is a socket on the host",
+        bridge.path.display()
+    );
+    // The host path is spelled out: the jail's own environment need not carry XDG_RUNTIME_DIR.
+    let script = format!(
+        r#"
+        if test -S '{socket}' || test -e '{socket}'; then
+            echo "BOUNDARY: devtools bridge socket reachable (R2.11)" >&2; exit 1
+        fi
+        echo SOCKET-HIDDEN
+        "#,
+        socket = bridge.path.display()
+    );
+    let p = project(true);
+    let ports = memory_ports(&binary, MEMORY_PORT);
+    let output = run(&p, &jailed(&bin, &p, &script, &ports, false));
+    let text = report("bridge socket run", &output);
+    assert!(output.status.success(), "{text}");
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("SOCKET-HIDDEN"),
+        "{text}"
+    );
+    assert!(
+        bridge.path.exists(),
+        "the host socket is untouched by the run"
+    );
+}
