+#[gpui::test]
+async fn real_ai_jail_boundary_holds_inside_the_jail(cx: &mut TestAppContext) {
+    let Some(bin) = ai_jail() else { return };
+    let binary = probed(&bin, cx).await;
+    let p = project(true);
+    let script = boundary_script(&p);
+    let ports = memory_ports(&binary, MEMORY_PORT);
+    let output = run(&p, &jailed(&bin, &p, &script, &ports, false));
+    let text = report("boundary run", &output);
+    assert!(output.status.success(), "{text}");
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("BOUNDARY-OK"),
+        "{text}"
+    );
+    assert!(
+        p.root.join("inside-probe").exists(),
+        "the project write persists on the host"
+    );
+    assert!(
