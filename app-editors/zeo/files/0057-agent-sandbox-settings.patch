+// --- R2.6: limits -----------------------------------------------------------------------------
+
+#[test]
+fn validate_limits_refuse_the_entry_that_crosses() {
+    let maps = check_limits(33, 0).expect_err("33 writable folders cross the limit");
+    assert!(maps.to_string().contains("32"), "names the limit: {maps}");
+    let hosts = check_limits(0, 65).expect_err("65 hosts cross the limit");
+    assert!(hosts.to_string().contains("64"), "names the limit: {hosts}");
+}
+
+#[test]
+fn validate_limits_accept_exactly_the_limit() {
+    check_limits(32, 64).expect("32 folders and 64 hosts are allowed");
+    check_limits(0, 0).expect("empty is allowed");
+}
+
+// --- Review fixes (tech review of the first run, .draft/deviations.yaml task 2.1) -------------
+//
+// Authored at Run, Red first. They pin what the review found the static set missed: symlinks
+// inside a protected folder (stow-style dotfiles) re-expose their targets, the runtime dir holds
+// the devtools socket (R2.11), and a canonical path can still be unusable as a `--rw-map`.
+
+mod review_fixes {
+    use std::os::unix::ffi::OsStrExt as _;
+    use std::os::unix::fs::symlink;
+    use std::path::{Path, PathBuf};
+
+    use super::{Home, home};
+    use crate::validate::{
+        ForbiddenRule, HostError, ProtectedSet, RwMapError, WalkLimits, WalkStop, validate_host,
+        validate_rw_map, validate_rw_map_with,
+    };
+
+    fn set(h: &Home) -> ProtectedSet {
+        ProtectedSet::new(&h.home, &h.config, None)
+    }
+
+    fn forbidden(set: &ProtectedSet, raw: &str) -> ForbiddenRule {
+        match validate_rw_map_with(raw, set) {
+            Err(error @ RwMapError::Forbidden { .. }) => {
+                let text = error.to_string();
+                assert!(text.contains(raw), "names the entry: {text}");
+                match error {
+                    RwMapError::Forbidden { rule, .. } => rule,
+                    _ => unreachable!(),
+                }
+            }
+            Err(other) => panic!("{raw:?} must be refused by a forbidden rule, got {other}"),
+            Ok(path) => panic!("{raw:?} must be refused, accepted as {}", path.display()),
+        }
+    }
+
+    fn mkdir(path: &Path) {
+        std::fs::create_dir_all(path).expect("fixture dir");
+    }
+
+    #[test]
+    fn validate_review_stow_symlink_inside_config_protects_its_target() {
+        let h = home();
+        mkdir(&h.home.join("dotfiles/zeo"));
+        std::fs::write(h.home.join("dotfiles/zeo/settings.json"), "{}").expect("fixture file");
+        symlink(
+            h.home.join("dotfiles/zeo/settings.json"),
+            h.config.join("settings.json"),
+        )
+        .expect("symlink");
+        let set = set(&h);
+        for raw in ["~/dotfiles", "~/dotfiles/zeo"] {
+            match forbidden(&set, raw) {
+                ForbiddenRule::LinkTarget { target, link } => {
+                    assert_eq!(target, h.home.join("dotfiles/zeo/settings.json"));
+                    assert_eq!(link, h.config.join("settings.json"));
+                }
+                other => panic!("{raw:?}: expected LinkTarget, got {other:?}"),
+            }
+        }
+        validate_rw_map_with("~/projects/app", &set).expect("an unrelated folder stays accepted");
+        // The authored entry point builds the same set.
+        assert!(validate_rw_map("~/dotfiles", &h.home, &h.config).is_err());
+    }
+
+    #[test]
+    fn validate_review_symlinked_dirs_are_walked_for_further_links() {
+        let h = home();
+        mkdir(&h.home.join("store/plugins"));
+        mkdir(&h.home.join("vault/keys"));
+        symlink(h.home.join("store/plugins"), h.home.join(".claude/plugins")).expect("symlink");
+        symlink(h.home.join("vault/keys"), h.home.join("store/plugins/keys")).expect("symlink");
+        let set = set(&h);
+        forbidden(&set, "~/store");
+        forbidden(&set, "~/vault");
+        forbidden(&set, "~/vault/keys");
+    }
+
+    #[test]
+    fn validate_review_a_symlink_cycle_terminates() {
+        let h = home();
+        mkdir(&h.home.join("ring/a"));
+        mkdir(&h.home.join("ring/b"));
+        symlink(h.home.join("ring/a"), h.home.join(".ssh/to-a")).expect("symlink");
+        symlink(h.home.join("ring/b"), h.home.join("ring/a/to-b")).expect("symlink");
+        symlink(h.home.join("ring/a"), h.home.join("ring/b/to-a")).expect("symlink");
+        symlink(h.home.join(".ssh"), h.home.join("ring/b/to-ssh")).expect("symlink");
+        let set = set(&h);
+        forbidden(&set, "~/ring/b");
+        validate_rw_map_with("~/cache", &set).expect("the set completed");
+    }
+
+    #[test]
+    fn validate_review_a_protected_tree_too_large_or_too_deep_refuses_every_map() {
+        let h = home();
+        for index in 0..10 {
+            std::fs::write(h.home.join(format!(".claude/file-{index}")), "").expect("fixture file");
+        }
+        let large = ProtectedSet::with_limits(
+            &h.home,
+            &h.config,
+            None,
+            WalkLimits {
+                max_entries: 5,
+                max_depth: 32,
+            },
+        );
+        match forbidden(&large, "~/projects/app") {
+            ForbiddenRule::ProtectedSetIncomplete {
+                stop: WalkStop::TooManyEntries { limit: 5 },
+                ..
+            } => {}
+            other => panic!("expected TooManyEntries, got {other:?}"),
+        }
+
+        mkdir(&h.home.join(".gnupg/a/b/c/d"));
+        let deep = ProtectedSet::with_limits(
+            &h.home,
+            &h.config,
+            None,
+            WalkLimits {
+                max_entries: 1_000,
+                max_depth: 2,
+            },
+        );
+        match forbidden(&deep, "~/cache") {
+            ForbiddenRule::ProtectedSetIncomplete {
+                stop: WalkStop::TooDeep { limit: 2 },
+                ..
+            } => {}
+            other => panic!("expected TooDeep, got {other:?}"),
+        }
+        assert_eq!(WalkLimits::DEFAULT.max_entries, 250_000);
+        assert_eq!(WalkLimits::DEFAULT.max_depth, 32);
+    }
+
+    #[test]
+    fn validate_review_dangling_links_protect_their_future_target() {
+        let h = home();
+        symlink(
+            h.home.join("future/theme"),
+            h.config.join("themes/pending.json"),
+        )
+        .expect("symlink");
+        std::fs::remove_dir_all(h.home.join(".gnupg")).expect("remove .gnupg");
+        symlink(h.home.join("keys/gnupg"), h.home.join(".gnupg")).expect("symlink");
+        let set = set(&h);
+        mkdir(&h.home.join("future/theme"));
+        mkdir(&h.home.join("keys/gnupg"));
+        forbidden(&set, "~/future");
+        forbidden(&set, "~/keys");
+        forbidden(&set, "~/keys/gnupg");
+    }
+
+    #[test]
+    fn validate_review_ancestors_of_home_name_the_above_home_rule() {
+        let h = home();
+        let set = set(&h);
+        let above = h.root.display().to_string();
+        match forbidden(&set, &above) {
+            ForbiddenRule::AboveHome { home } => assert_eq!(home, h.home),
+            other => panic!("expected AboveHome, got {other:?}"),
+        }
+        assert_eq!(forbidden(&set, "/"), ForbiddenRule::Root);
+        assert_eq!(forbidden(&set, "~"), ForbiddenRule::Home);
+    }
+
+    #[test]
+    fn validate_review_unusable_canonical_paths_are_refused() {
+        let h = home();
+        let bad = h.root.join(std::ffi::OsStr::from_bytes(b"bad\xff"));
+        mkdir(&bad);
+        symlink(&bad, h.home.join("link-to-bad")).expect("symlink");
+        symlink(h.home.join("a:b"), h.home.join("link-to-colon")).expect("symlink");
+        let set = set(&h);
+        match validate_rw_map_with("~/link-to-bad", &set) {
+            Err(error @ RwMapError::NotUtf8 { .. }) => {
+                assert!(error.to_string().contains("~/link-to-bad"), "{error}")
+            }
+            other => panic!("expected NotUtf8, got {other:?}"),
+        }
+        match validate_rw_map_with("~/link-to-colon", &set) {
+            Err(error @ RwMapError::ColonInTarget { .. }) => {
+                assert!(error.to_string().contains("~/link-to-colon"), "{error}")
+            }
+            other => panic!("expected ColonInTarget, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn validate_review_a_file_is_refused_as_a_writable_folder() {
+        let h = home();
+        std::fs::write(h.home.join("notes.txt"), "").expect("fixture file");
+        match validate_rw_map_with("~/notes.txt", &set(&h)) {
+            Err(error @ RwMapError::NotADirectory { .. }) => {
+                let text = error.to_string();
+                assert!(text.contains("~/notes.txt"), "{text}");
+                assert!(text.contains("folder"), "names the rule: {text}");
+            }
+            other => panic!("expected NotADirectory, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn validate_review_missing_carries_the_io_kind() {
+        let h = home();
+        match validate_rw_map_with("~/nope", &set(&h)) {
+            Err(RwMapError::Missing { entry, kind }) => {
+                assert_eq!(entry, "~/nope");
+                assert_eq!(kind, std::io::ErrorKind::NotFound);
+            }
+            other => panic!("expected Missing, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn validate_review_localhost_names_are_refused() {
+        for raw in [
+            "foo.localhost",
+            "a.b.localhost",
+            "localhost.localdomain",
+            "LocalHost",
+            "app.LOCALHOST",
+        ] {
+            match validate_host(raw) {
+                Err(error @ HostError::Localhost { .. }) => {
+                    assert!(error.to_string().contains(raw), "{error}")
+                }
+                other => panic!("{raw:?}: expected Localhost, got {other:?}"),
+            }
+        }
+        validate_host("localhost.example.com").expect("a look-alike stays accepted");
+        validate_host("mylocalhost.dev").expect("a look-alike stays accepted");
+    }
+
+    #[test]
+    fn validate_review_runtime_dir_is_protected_in_full() {
+        let h = home();
+        let runtime = h.root.join("run/user/1000");
+        mkdir(&runtime.join("zeo"));
+        std::fs::write(runtime.join("zeo/devtools.sock"), "").expect("fixture file");
+        let set = ProtectedSet::new(&h.home, &h.config, Some(&runtime));
+        for raw in [
+            runtime.display().to_string(),
+            runtime.join("zeo").display().to_string(),
+            h.root.join("run").display().to_string(),
+        ] {
+            match forbidden(&set, &raw) {
+                ForbiddenRule::RuntimeDir { dir } => assert_eq!(dir, runtime),
+                other => panic!("{raw:?}: expected RuntimeDir, got {other:?}"),
+            }
+        }
+        assert!(set.paths().any(|path| path == runtime));
+    }
+
+    #[test]
+    fn validate_review_protected_set_answers_for_a_project_root() {
+        let h = home();
+        let set = set(&h);
+        assert_eq!(set.rule_for(&h.home.join("projects/app")), None);
+        assert_eq!(set.rule_for(&h.home), Some(ForbiddenRule::Home));
+        match set.rule_for(&h.home.join(".config")) {
+            Some(ForbiddenRule::Protected { protected }) => assert_eq!(protected, h.config),
+            other => panic!("expected Protected, got {other:?}"),
+        }
+        assert!(
+            set.rule_for(&h.home.join(".ssh/sub")).is_some(),
+            "a root inside the set is refused"
+        );
+        let paths: Vec<PathBuf> = set.paths().map(Path::to_path_buf).collect();
+        for expected in [
+            h.config.clone(),
+            h.home.join(".claude"),
+            h.home.join(".claude.json"),
+            h.home.join(".ssh"),
+            h.home.join(".gnupg"),
+        ] {
+            assert!(paths.contains(&expected), "{expected:?} in {paths:?}");
+        }
+    }
+
+    #[test]
+    fn validate_review_new_rules_have_their_own_variants_and_texts() {
+        let h = home();
+        let runtime = h.root.join("run");
+        mkdir(&runtime);
+        std::fs::write(h.home.join("notes.txt"), "").expect("fixture file");
+        let set = ProtectedSet::new(&h.home, &h.config, Some(&runtime));
+        let root = h.root.display().to_string();
+        let run = runtime.display().to_string();
+        let texts: Vec<String> = [
+            ("/", "root"),
+            ("~", "home"),
+            (root.as_str(), "home"),
+            ("~/.ssh", "protected"),
+            (run.as_str(), "runtime"),
+            ("~/notes.txt", "folder"),
+        ]
+        .into_iter()
+        .map(|(raw, keyword)| {
+            let text = validate_rw_map_with(raw, &set)
+                .expect_err("refused")
+                .to_string();
+            assert!(text.contains(raw), "names the entry: {text}");
+            assert!(
+                text.to_lowercase().contains(keyword),
+                "names the rule ({keyword}): {text}"
+            );
+            text
+        })
+        .collect();
+        for (index, text) in texts.iter().enumerate() {
+            for other in &texts[index + 1..] {
+                assert_ne!(text, other);
+            }
+        }
+    }
+}
