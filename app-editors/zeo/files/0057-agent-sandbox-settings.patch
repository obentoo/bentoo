index 0000000..31dc0ef
--- /dev/null
+++ b/crates/agent_sandbox/src/settings.rs
@@ -0,0 +1,205 @@
+//! The `agent_sandbox` and `agent_memory` settings, read from the user settings file only.
+
+use std::collections::BTreeMap;
+use std::path::{Component, Path, PathBuf};
+
+use settings::{RegisterSetting, Settings, SettingsContent};
+
+use crate::validate::expand_tilde;
+
+/// `agent_sandbox.claude_config_dir` when the defaults lack it; `default.json` says the same.
+const DEFAULT_CLAUDE_CONFIG_DIR: &str = "~/.claude-jailed";
+/// `agent_sandbox.allow_hosts` when the defaults lack it: the measured login minimum.
+const DEFAULT_ALLOW_HOSTS: [&str; 2] = ["anthropic.com", "platform.claude.com"];
+/// `agent_memory.endpoint` when the defaults lack it.
+const DEFAULT_MEMORY_ENDPOINT: &str = "http://127.0.0.1:49374/mcp";
+
+/// The `agent_sandbox` settings section.
+#[derive(Clone, Debug, PartialEq, Eq, RegisterSetting)]
+pub struct AgentSandboxSettings {
+    /// The switch for projects without an entry in `projects`. Default: `false`.
+    pub enabled: bool,
+    /// The ai-jail binary; `None` looks it up on `PATH`.
+    pub ai_jail_path: Option<PathBuf>,
+    /// The Claude config directory mapped into the jail, as written (`~` not expanded).
+    pub claude_config_dir: String,
+    /// Writable folders every jailed project gets, as written.
+    pub rw_maps: Vec<String>,
+    /// Hosts every jailed project may reach, as written.
+    pub allow_hosts: Vec<String>,
+    /// Per-project overrides, keyed by the absolute root path as written.
+    pub projects: BTreeMap<String, AgentSandboxProjectSettings>,
+}
+
+/// One project's entry in `agent_sandbox.projects`.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct AgentSandboxProjectSettings {
+    /// `None` follows `agent_sandbox.enabled`.
+    pub enabled: Option<bool>,
+    pub rw_maps: Vec<String>,
+    pub allow_hosts: Vec<String>,
+}
+
+/// The defaults merged with one project's entry, unvalidated.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ProjectPolicy {
+    pub enabled: bool,
+    /// The default folders, then the project's own, each once, in the configured order.
+    pub rw_maps: Vec<String>,
+    /// The default hosts, then the project's own, each once, in the configured order.
+    pub allow_hosts: Vec<String>,
+}
+
+impl AgentSandboxSettings {
+    /// The policy for the project rooted at `root`, keyed by [`lexical_match`]: neither a string
+    /// prefix (`/w/app` for `/w/app2`) nor a parent (`/w/app` for `/w/app/sub`) applies. Reads no
+    /// file system; a key spelled through a symlink is found by [`resolve_project_key`] instead.
+    pub fn project_policy(&self, root: &Path) -> ProjectPolicy {
+        self.policy_for_key(lexical_match(self.project_keys(), root))
+    }
+
+    /// The defaults merged with the entry under `key`; `None` (or a key without an entry) gives
+    /// the defaults alone.
+    pub fn policy_for_key(&self, key: Option<&str>) -> ProjectPolicy {
+        let Some(entry) = key.and_then(|key| self.projects.get(key)) else {
+            return ProjectPolicy {
+                enabled: self.enabled,
+                rw_maps: dedup_in_order(&self.rw_maps, &[]),
+                allow_hosts: dedup_in_order(&self.allow_hosts, &[]),
+            };
+        };
+        ProjectPolicy {
+            enabled: entry.enabled.unwrap_or(self.enabled),
+            rw_maps: dedup_in_order(&self.rw_maps, &entry.rw_maps),
+            allow_hosts: dedup_in_order(&self.allow_hosts, &entry.allow_hosts),
+        }
+    }
+
+    /// Whether the project rooted at `root` runs its agent jailed, keyed as [`Self::project_policy`].
+    pub fn effective_enabled(&self, root: &Path) -> bool {
+        lexical_match(self.project_keys(), root)
+            .and_then(|key| self.projects.get(key))
+            .and_then(|entry| entry.enabled)
+            .unwrap_or(self.enabled)
+    }
+
+    /// The keys of `projects`, in sorted order.
+    pub fn project_keys(&self) -> impl Iterator<Item = &str> {
+        self.projects.keys().map(String::as_str)
+    }
+}
+
+/// A `projects` key as a path: `~` expanded, `.` components and a trailing `/` dropped. `..` is
+/// kept: resolving it lexically would be wrong across a symlink.
+fn lexical_key(key: &str) -> PathBuf {
+    normalize(&expand_tilde(key, paths::home_dir()))
+}
+
+fn normalize(path: &Path) -> PathBuf {
+    path.components()
+        .filter(|component| !matches!(component, Component::CurDir))
+        .collect()
+}
+
+/// The `projects` key for `root` without touching the file system: the key spelled exactly as the
+/// root if there is one, else the smallest key equal to it after `~` expansion and dropping `.`
+/// components and a trailing `/`.
+pub fn lexical_match<'a>(keys: impl IntoIterator<Item = &'a str>, root: &Path) -> Option<&'a str> {
+    let exact = root.to_str();
+    let normalized_root = normalize(root);
+    let mut lexical: Option<&'a str> = None;
+    for key in keys {
+        if Some(key) == exact {
+            return Some(key);
+        }
+        if lexical.is_none_or(|best| key < best) && lexical_key(key) == normalized_root {
+            lexical = Some(key);
+        }
+    }
+    lexical
+}
+
+/// [`lexical_match`], else the smallest key that resolves to the same folder as `root` (a key or a
+/// root spelled through a symlink). Blocking: it canonicalizes every key, so call it on a
+/// background thread.
+pub fn resolve_project_key<'a>(
+    keys: impl IntoIterator<Item = &'a str>,
+    root: &Path,
+) -> Option<&'a str> {
+    let keys: Vec<&'a str> = keys.into_iter().collect();
+    if let Some(key) = lexical_match(keys.iter().copied(), root) {
+        return Some(key);
+    }
+    let canonical_root = root.canonicalize().ok()?;
+    keys.into_iter()
+        .filter(|key| {
+            lexical_key(key)
+                .canonicalize()
+                .is_ok_and(|canonical| canonical == canonical_root)
+        })
+        .min()
+}
+
+/// `defaults` then `own`, keeping the first occurrence of each entry.
+fn dedup_in_order(defaults: &[String], own: &[String]) -> Vec<String> {
+    let mut merged: Vec<String> = Vec::with_capacity(defaults.len() + own.len());
+    for entry in defaults.iter().chain(own) {
+        if !merged.contains(entry) {
+            merged.push(entry.clone());
+        }
+    }
+    merged
+}
+
+impl Settings for AgentSandboxSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        // `default.json` carries every default below; the fallbacks keep them when an
+        // embedder's defaults lack the section.
+        let sandbox = content.agent_sandbox.clone().unwrap_or_default();
+        Self {
+            enabled: sandbox.enabled.unwrap_or(false),
+            ai_jail_path: sandbox.ai_jail_path,
+            claude_config_dir: sandbox
+                .claude_config_dir
+                .unwrap_or_else(|| DEFAULT_CLAUDE_CONFIG_DIR.to_string()),
+            rw_maps: sandbox.rw_maps.unwrap_or_default(),
+            allow_hosts: sandbox
+                .allow_hosts
+                .unwrap_or_else(|| DEFAULT_ALLOW_HOSTS.map(str::to_string).to_vec()),
+            projects: sandbox
+                .projects
+                .unwrap_or_default()
+                .into_iter()
+                .map(|(root, project)| {
+                    let project = AgentSandboxProjectSettings {
+                        enabled: project.enabled,
+                        rw_maps: project.rw_maps.unwrap_or_default(),
+                        allow_hosts: project.allow_hosts.unwrap_or_default(),
+                    };
+                    (root, project)
+                })
+                .collect(),
+        }
+    }
+}
+
+/// The `agent_memory` settings section.
+#[derive(Clone, Debug, PartialEq, Eq, RegisterSetting)]
+pub struct AgentMemorySettings {
+    /// Whether the agents use ai-memory. Default: `true`.
+    pub enabled: bool,
+    /// The ai-memory MCP endpoint, as written.
+    pub endpoint: String,
+}
+
+impl Settings for AgentMemorySettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        let memory = content.agent_memory.clone().unwrap_or_default();
+        Self {
+            enabled: memory.enabled.unwrap_or(true),
+            endpoint: memory
+                .endpoint
+                .unwrap_or_else(|| DEFAULT_MEMORY_ENDPOINT.to_string()),
+        }
+    }
+}
