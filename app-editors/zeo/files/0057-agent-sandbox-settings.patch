+// Executor-authored (task 6.2, after the tech review): the hardening cases the authored tests
+// above do not reach. Each fake answers per JSON-RPC method, so an HTTP status can be put on any
+// leg of the handshake.
+mod review_fixes {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    use super::*;
+
+    type Respond = dyn Fn(&str, &Value) -> anyhow::Result<Response<AsyncBody>> + Send + Sync;
+
+    fn raw(status: u16, body: &str) -> anyhow::Result<Response<AsyncBody>> {
+        Ok(Response::builder()
+            .status(status)
+            .header("Content-Type", "text/html")
+            .body(AsyncBody::from(body.as_bytes().to_vec()))
+            .expect("response"))
+    }
+
+    fn initialized(message: &Value) -> anyhow::Result<Response<AsyncBody>> {
+        json_response(json!({
+            "jsonrpc": "2.0", "id": message["id"],
+            "result": {
+                "protocolVersion": message["params"]["protocolVersion"],
+                "capabilities": { "tools": {} },
+                "serverInfo": { "name": "ai-memory", "version": "2.6.2" }
+            }
+        }))
+    }
+
+    fn tool_text(message: &Value, text: &str) -> anyhow::Result<Response<AsyncBody>> {
+        json_response(json!({
+            "jsonrpc": "2.0", "id": message["id"],
+            "result": { "content": [{ "type": "text", "text": text }] }
+        }))
+    }
+
+    /// `respond(method, message)`; returns the methods seen, `tools/call` as `tools/call:<tool>`.
+    fn fake(respond: Arc<Respond>) -> (Arc<dyn HttpClient>, Arc<Mutex<Vec<String>>>) {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let client = http_client::FakeHttpClient::create({
+            let seen = seen.clone();
+            move |request| {
+                let seen = seen.clone();
+                let respond = respond.clone();
+                async move {
+                    let mut text = String::new();
+                    request.into_body().read_to_string(&mut text).await?;
+                    let message: Value = serde_json::from_str(&text).unwrap_or(Value::Null);
+                    let method = message["method"].as_str().unwrap_or_default().to_string();
+                    seen.lock().push(match message["params"]["name"].as_str() {
+                        Some(tool) if method == "tools/call" => format!("tools/call:{tool}"),
+                        _ => method.clone(),
+                    });
+                    respond(&method, &message)
+                }
+            }
+        }) as Arc<dyn HttpClient>;
+        (client, seen)
+    }
+
+    #[gpui::test]
+    async fn rejected_initialized_notification_fails_the_start_not_the_call(
+        cx: &mut TestAppContext,
+    ) {
+        let notifications = Arc::new(AtomicUsize::new(0));
+        let (http, seen) = fake(Arc::new({
+            let notifications = notifications.clone();
+            move |method, message| match method {
+                "initialize" => initialized(message),
+                "notifications/initialized" => {
+                    if notifications.fetch_add(1, Ordering::SeqCst) == 0 {
+                        raw(400, "Bad Request: no session")
+                    } else {
+                        raw(202, "")
+                    }
+                }
+                _ => tool_text(message, STATUS_FIXTURE),
+            }
+        }));
+        let client = client(http, None, cx);
+        let error = client
+            .status(&scope("p"))
+            .await
+            .expect_err("the start fails");
+        assert_eq!(
+            error,
+            MemoryError::Server("HTTP 400: Bad Request: no session".to_string())
+        );
+        assert!(
+            !seen
+                .lock()
+                .iter()
+                .any(|method| method.starts_with("tools/call")),
+            "no tool call on a failed start: {:?}",
+            seen.lock()
+        );
+
+        let status = client.status(&scope("p")).await.expect("a fresh session");
+        assert_eq!(status.pages, 69);
+        assert_eq!(
+            seen.lock()
+                .iter()
+                .filter(|method| *method == "initialize")
+                .count(),
+            2,
+            "the failed session was dropped: {:?}",
+            seen.lock()
+        );
+    }
+
+    #[gpui::test]
+    async fn token_over_plain_http_to_a_remote_host_is_refused(cx: &mut TestAppContext) {
