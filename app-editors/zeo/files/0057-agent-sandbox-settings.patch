+use project::Project;
+use project::agent_server_store::AgentId;
+use serde_json::{Value, json};
+use settings::SettingsStore;
+
+use crate::custom::CustomAgentServer;
+use crate::{AgentServer as _, AgentServerDelegate};
+
+const AGENT: &str = "lifecycle-agent";
+
+struct Fixture {
+    _tmp: tempfile::TempDir,
+    base: PathBuf,
+    root: PathBuf,
+    agent: PathBuf,
+}
+
+impl Fixture {
+    fn new() -> Self {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = tmp.path().canonicalize().expect("canonical");
+        let root = base.join("app");
+        std::fs::create_dir_all(root.join(".git")).expect("project");
+        std::fs::create_dir_all(base.join("claude-jailed")).expect("claude dir");
+        let agent = base.join("bin/claude-agent-acp-plus");
+        let initialize = serde_json::to_string(&acp::InitializeResponse::new(ProtocolVersion::V1))
+            .expect("serialize initialize response");
+        std::fs::create_dir_all(agent.parent().expect("parent")).expect("mkdir");
+        std::fs::write(
+            &agent,
+            format!(
+                r#"#!/bin/sh
+IFS= read -r request || exit 2
+id=$(printf '%s' "$request" | sed -n 's/.*"id":\("[^"]*"\|[0-9][0-9]*\).*/\1/p')
+test -n "$id" || exit 3
+printf '{{"jsonrpc":"2.0","id":%s,"result":%s}}\n' "$id" '{initialize}'
+exec cat >/dev/null
+"#
+            ),
