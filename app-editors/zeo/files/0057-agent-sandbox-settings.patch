+
+    // L1: the query and fragment can carry a key; nothing shown or logged keeps them.
+    #[gpui::test]
+    async fn shown_endpoint_drops_userinfo_query_and_fragment(cx: &mut TestAppContext) {
+        let raw_endpoint = "http://user:pw-SECRET@127.0.0.1:49374/mcp?key=q-SECRET#f-SECRET";
+        let endpoint = Url::parse(raw_endpoint).expect("url");
+        assert_eq!(
+            crate::memory::display_endpoint(&endpoint),
