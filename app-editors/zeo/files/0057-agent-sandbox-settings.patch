+fn record(root: &str, reason: Reason, version: Option<&str>) -> LaunchRecord {
+    LaunchRecord {
+        agent_id: AgentId::new("Test"),
+        project_root: PathBuf::from(root),
+        reason,
+        ai_jail_version: version.map(|v| semver::Version::parse(v).expect("version")),
+        ai_jail_path: None,
+        rw_maps: vec![
+            PathBuf::from("/h/.claude-jailed"),
+            PathBuf::from("/data/cache"),
+        ],
+        allow_hosts: vec!["anthropic.com".into(), "registry.npmjs.org".into()],
+        forward_ports: vec![49374],
