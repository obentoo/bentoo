+    // Tech review MEDIUM: the page shows the entry a start would use.
+    #[test]
+    fn agent_jail_page_reads_the_resolved_key() {
+        let mut sandbox = AgentSandboxSettings {
+            enabled: false,
+            ai_jail_path: None,
