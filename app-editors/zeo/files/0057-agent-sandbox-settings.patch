+        for (memory, supports) in [
+            (memory(true, LOOPBACK), false),
+            (memory(false, LOOPBACK), true),
+            (memory(true, "http://mem.example.com:8080/mcp"), true),
+        ] {
+            let preview = preview(&memory, supports);
+            assert!(!preview.contains("ZEO_NO_PROXY"), "{preview}");
