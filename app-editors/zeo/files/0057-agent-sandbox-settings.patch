+//! The launch decision for an external agent: jailed through ai-jail, started unchanged, or
+//! refused (R1, R2.6–R2.10, R7.4), and the registry of what each running agent was started with,
+//! read by the toolbar icon and the settings page.
+//!
+//! A refusal never falls back to an unjailed start: while the sandbox is on for a project, every
+//! Claude adapter of it starts through ai-jail or does not start (Q4).
+
+use std::collections::HashSet;
+use std::ffi::OsStr;
+use std::fmt;
+use std::hash::{DefaultHasher, Hash as _, Hasher as _};
+use std::io;
+use std::path::{Path, PathBuf};
+
+use gpui::{App, AsyncApp, BackgroundExecutor, Entity, Global};
+use project::Project;
+use project::agent_registry_store::{ZEO_PLUS_AGENT_ID, ZEO_TUI_AGENT_ID};
+use project::agent_server_store::{AgentId, AgentServerCommand};
+use semver::Version;
+use settings::Settings as _;
+
+use crate::command::{
+    JailInputs, NO_PROXY_CARRIER, generate, keep_loopback_off_proxy, loopback_no_proxy,
+};
+use crate::probe::{self, ProbeError};
+use crate::settings::{
+    AgentMemorySettings, AgentSandboxSettings, ProjectPolicy, lexical_match, resolve_project_key,
+};
+use crate::validate::{
+    self, ForbiddenRule, HostError, LimitError, ProtectedSet, RwMapError, expand_tilde,
+};
+
+/// The sentence every refusal ends with (R1.9).
+pub const FAIL_CLOSED: &str = "The agent was not started without the sandbox.";
+
+/// The R3.10 / R5.9 sentence: memory is on but this ai-jail cannot forward its port.
+pub const MEMORY_PORT_UNSUPPORTED: &str =
+    "ai-memory is not reachable from inside the jail: this ai-jail has no --forward-port";
+
+/// The binary and package names of the Claude adapters (R1.13). `claude-agent-tui` is the TUI
+/// package's npm bin; `claude-agent-acp-tui` is the system adapter's name.
+const ADAPTER_NAMES: [&str; 3] = [
+    "claude-agent-acp-plus",
+    "claude-agent-acp-tui",
+    "claude-agent-tui",
+];
+const ADAPTER_PACKAGES: [&str; 2] = [
+    "@lucascouts/claude-agent-acp-plus",
+    "@lucascouts/claude-agent-tui",
+];
+
+/// Why an agent started as it did, logged as `reason=` (R9.1).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Reason {
+    On,
+    Off,
+    OwnCommand,
+    Remote,
+    NotClaude,
+}
+
+impl Reason {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::On => "on",
+            Self::Off => "off",
+            Self::OwnCommand => "own_command",
+            Self::Remote => "remote",
+            Self::NotClaude => "not_claude",
+        }
+    }
+}
+
+/// What the icon (R5.9) and the page (R3.10) say about ai-memory inside the jail.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MemoryPort {
+    Forwarded(u16),
+    /// Memory on and loopback, but this ai-jail has no `--forward-port` (R7.4).
+    Unsupported,
+    Off,
+    NonLoopback,
+}
+
+/// What one agent was started with.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LaunchRecord {
+    pub agent_id: AgentId,
+    /// The checked root; a jailed start's working directory.
+    pub project_root: PathBuf,
+    pub reason: Reason,
+    pub ai_jail_version: Option<Version>,
+    pub ai_jail_path: Option<PathBuf>,
+    /// The Claude config directory first, then every other writable folder, canonical.
+    pub rw_maps: Vec<PathBuf>,
+    pub allow_hosts: Vec<String>,
+    pub forward_ports: Vec<u16>,
+    pub memory_port: MemoryPort,
+    /// [`drifted`] compares it with the settings of now.
+    pub settings_fingerprint: u64,
+    /// [`memory_drifted`] compares it with the memory settings of now.
+    pub memory_fingerprint: u64,
+    /// The `agent_sandbox.projects` key the start used, if any.
+    pub settings_key: Option<String>,
+}
+
+pub enum LaunchDecision {
+    Jailed(LaunchRecord, AgentServerCommand),
+    Unchanged(LaunchRecord),
+    Refused(LaunchError),
+}
+
+/// How a jailed start's process is spawned, besides its command.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct JailSpawn {
+    /// The resolved root `check_root` approved: ai-jail binds its working directory as the
+    /// writable project, so it must be the checked path, not a symlink that could be re-pointed.
+    pub cwd: PathBuf,
+    /// ai-jail's whole environment, sorted by name — the spawner clears everything else. Only the
+    /// configured names (with their values) and a base taken from Zeo's own process: ai-jail
+    /// copies part of its environment into the jail (proxies, `LC_*`, `XDG_*`, …) and reads
+    /// `HOME` and its own variables to find its configuration, so a login-shell environment
+    /// would leak into the jail and steer ai-jail.
+    pub env: Vec<(String, String)>,
+}
+
+/// A launch decision and, for a jailed start, how to spawn it.
+pub struct LaunchPlan {
+    pub decision: LaunchDecision,
+    /// `Some` exactly when `decision` is `Jailed`.
+    pub jail_spawn: Option<JailSpawn>,
+}
+
+impl LaunchPlan {
+    fn without_spawn(decision: LaunchDecision) -> Self {
+        Self {
+            decision,
+            jail_spawn: None,
+        }
+    }
+}
+
+/// Why a project root cannot be handed to ai-jail.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RootProblem {
+    /// ai-jail reads `--map` as `PATH|SOURCE:DEST`: `<root>/.git` would bind nothing.
+    Colon,
+    /// The path would reach argv through a lossy conversion as a path that does not exist.
+    NotUtf8,
+}
+
+/// Why an agent was refused. Each `Display` is one or more full sentences.
+#[derive(Debug)]
+pub enum LaunchCause {
+    NoRoot,
+    RootUnusable {
+        root: PathBuf,
+        problem: RootProblem,
+    },
+    RootForbidden {
+        root: PathBuf,
+        rule: ForbiddenRule,
+    },
+    RootMissing {
+        root: PathBuf,
+    },
+    NotInstalled {
+        /// The configured `ai_jail_path`, `~` expanded; `None` when looked up on `PATH`.
+        configured: Option<PathBuf>,
+    },
+    VersionUnreadable(ProbeError),
+    ClaudeDirInvalid(RwMapError),
+    ClaudeDirMissing {
+        dir: PathBuf,
+    },
+    InvalidMap(RwMapError),
+    InvalidHost(HostError),
+    Limit(LimitError),
+    NestedMap {
+        inner: PathBuf,
+        outer: PathBuf,
+    },
+    InvalidEnvKey {
+        /// The key up to its first `=`, so a `NAME=VALUE` key never shows its value.
+        shown: String,
+    },
+    SymlinkedMount {
+        path: PathBuf,
+    },
+    ZedDirCreate {
+        dir: PathBuf,
+        error: io::Error,
+    },
+    InvalidMemoryEndpoint(InvalidMemoryEndpoint),
+}
+
+impl LaunchCause {
+    /// The `cause=` token of the refusal's log line (R9.2).
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::NoRoot => "no_root",
+            Self::RootUnusable { .. } => "root_unusable",
+            Self::RootForbidden { .. } => "root_forbidden",
+            Self::RootMissing { .. } => "root_missing",
+            Self::NotInstalled { .. } => "not_installed",
+            Self::VersionUnreadable(_) => "version_unreadable",
+            Self::ClaudeDirInvalid(_) => "claude_dir_invalid",
+            Self::ClaudeDirMissing { .. } => "claude_dir_missing",
+            Self::InvalidMap(_) => "invalid_map",
+            Self::InvalidHost(_) => "invalid_host",
+            Self::Limit(_) => "limit",
+            Self::NestedMap { .. } => "nested_map",
+            Self::InvalidEnvKey { .. } => "invalid_env_key",
+            Self::SymlinkedMount { .. } => "symlinked_mount",
+            Self::ZedDirCreate { .. } => "zed_dir_create",
+            Self::InvalidMemoryEndpoint(_) => "invalid_memory_endpoint",
+        }
+    }
+}
+
+impl fmt::Display for LaunchCause {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NoRoot => write!(
+                f,
+                "The project has no local folder to run the agent in, and the agent sandbox is on."
+            ),
+            Self::RootUnusable {
+                root,
+                problem: RootProblem::Colon,
+            } => write!(
+                f,
+                "The project folder {} contains ':', which ai-jail reads as SOURCE:DEST, so its .git and .zed could not be kept read-only.",
+                root.display()
+            ),
+            Self::RootUnusable {
+                root,
+                problem: RootProblem::NotUtf8,
+            } => write!(
+                f,
+                "The project folder {} is not valid UTF-8, so ai-jail cannot be given its .git and .zed.",
+                root.display()
+            ),
+            Self::RootForbidden { root, rule } => write!(
+                f,
+                "The project folder {} {rule}; the agent sandbox does not run an agent there.",
+                root.display()
+            ),
+            Self::RootMissing { root } => write!(
+                f,
+                "The project folder {} no longer exists or is not a folder.",
+                root.display()
+            ),
+            Self::NotInstalled {
+                configured: Some(path),
+            } => write!(
+                f,
+                "ai-jail was not found at {} (agent_sandbox.ai_jail_path).",
+                path.display()
+            ),
+            Self::NotInstalled { configured: None } => write!(
+                f,
+                "ai-jail was not found on PATH; install it or set agent_sandbox.ai_jail_path."
+            ),
+            Self::VersionUnreadable(error) => {
+                write!(f, "The version of ai-jail could not be read: {error}.")
+            }
+            Self::ClaudeDirInvalid(error) => write!(
+                f,
+                "The Claude config directory (agent_sandbox.claude_config_dir) cannot be mapped: {error}"
+            ),
+            Self::ClaudeDirMissing { dir } => write!(
+                f,
+                "The Claude config directory {dir} does not exist. Create it and log in with `CLAUDE_CONFIG_DIR={dir} claude`.",
+                dir = dir.display()
+            ),
+            Self::InvalidMap(error) => write!(f, "{error}"),
+            Self::InvalidHost(error) => write!(f, "{error}"),
+            Self::Limit(error) => write!(f, "{error}"),
+            Self::NestedMap { inner, outer } => write!(
+                f,
+                "Writable folder {} lies inside {}, which the agent can write; it could swap the inner folder for a symlink before the jail starts. Keep the outer folder only.",
+                inner.display(),
+                outer.display()
+            ),
+            Self::InvalidEnvKey { shown } => write!(
+                f,
+                "The environment variable name \"{shown}\" cannot be passed into the jail: a name has only letters, digits and '_', and does not start with a digit."
+            ),
+            Self::SymlinkedMount { path } => write!(
+                f,
+                "{} is a symlink; ai-jail cannot keep it read-only. Replace it with the folder itself.",
+                path.display()
+            ),
+            Self::ZedDirCreate { dir, error } => {
+                write!(f, "Could not create {}: {error}.", dir.display())
+            }
+            Self::InvalidMemoryEndpoint(error) => write!(f, "{error}"),
+        }
+    }
+}
+
+/// A refused start: the root, the cause, and the R9.1 counts for the R9.2 log line.
+#[derive(Debug)]
+pub struct LaunchError {
+    pub agent_id: AgentId,
+    pub project_root: Option<PathBuf>,
+    pub cause: LaunchCause,
+    pub ai_jail_version: Option<Version>,
+    pub rw_maps: usize,
+    pub allow_hosts: usize,
+    pub forward_ports: usize,
+}
+
+impl fmt::Display for LaunchError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match &self.project_root {
+            Some(root) => write!(
+                f,
+                "Agent sandbox, project {}: {} {FAIL_CLOSED}",
+                root.display(),
+                self.cause
+            ),
+            None => write!(f, "Agent sandbox: {} {FAIL_CLOSED}", self.cause),
+        }
+    }
+}
+
+impl std::error::Error for LaunchError {}
+
+/// An `agent_memory.endpoint` that is not a URL, shown without userinfo, query or fragment.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct InvalidMemoryEndpoint {
+    pub shown: String,
+}
+
+impl fmt::Display for InvalidMemoryEndpoint {
