+}
+
+// --- R2.4: hostile, wrongly REFUSE -----------------------------------------------------------
+
+#[test]
+fn validate_rw_map_accepts_string_prefix_siblings_of_protected_paths() {
+    let h = home();
+    assert_eq!(
+        accepted(&h, "~/.claude-jailed"),
+        h.home.join(".claude-jailed")
