+}
+
+impl std::error::Error for InvalidMemoryEndpoint {}
+
+/// Where the protected paths are. Tests substitute a home of their own.
+pub(crate) struct LaunchEnv {
+    pub home: PathBuf,
+    pub config_dir: PathBuf,
+    pub runtime_dir: Option<PathBuf>,
+}
+
+impl LaunchEnv {
+    fn from_process() -> Self {
+        Self {
+            home: paths::home_dir().clone(),
+            config_dir: paths::config_dir().clone(),
+            runtime_dir: std::env::var_os("XDG_RUNTIME_DIR")
+                .map(PathBuf::from)
+                .filter(|dir| dir.is_absolute()),
+        }
+    }
+}
+
+/// The folder an agent of `project` is started in: the expression `spawn_stdio` uses, except
+/// that a project without a visible worktree has none (`default_path_list` would give home).
+pub fn project_root(project: &Entity<Project>, cx: &App) -> Option<PathBuf> {
+    let project = project.read(cx);
+    project.visible_worktrees(cx).next()?;
+    project
+        .default_path_list(cx)
+        .ordered_paths()
+        .next()
+        .cloned()
+}
+
+/// Decides how the agent `agent_id` of `project` starts. `configured_env` holds the names of the
+/// variables the agent's own settings configure: only those are forwarded into the jail.
+///
+/// Order: remote → own command → not a Claude adapter → no root → off → checks → jailed.
+pub async fn decide(
+    agent_id: AgentId,
+    project: &Entity<Project>,
+    cmd: AgentServerCommand,
+    configured_env: &HashSet<String>,
+    cx: &mut AsyncApp,
+) -> LaunchDecision {
+    decide_in(
+        agent_id,
+        project,
+        cmd,
+        configured_env,
+        LaunchEnv::from_process(),
+        cx,
+    )
+    .await
+}
+
+/// [`decide`], plus how a jailed start must be spawned. A spawner of a `Jailed` decision must use
+/// [`JailSpawn::cwd`] and only [`JailSpawn::env`].
+pub async fn plan(
+    agent_id: AgentId,
+    project: &Entity<Project>,
+    cmd: AgentServerCommand,
+    configured_env: &HashSet<String>,
+    cx: &mut AsyncApp,
+) -> LaunchPlan {
+    plan_in(
+        agent_id,
+        project,
+        cmd,
+        configured_env,
+        LaunchEnv::from_process(),
+        cx,
+    )
+    .await
+}
+
+pub(crate) async fn decide_in(
+    agent_id: AgentId,
+    project: &Entity<Project>,
+    cmd: AgentServerCommand,
+    configured_env: &HashSet<String>,
+    env: LaunchEnv,
+    cx: &mut AsyncApp,
+) -> LaunchDecision {
+    plan_in(agent_id, project, cmd, configured_env, env, cx)
+        .await
+        .decision
+}
+
+pub(crate) async fn plan_in(
+    agent_id: AgentId,
+    project: &Entity<Project>,
+    cmd: AgentServerCommand,
+    configured_env: &HashSet<String>,
+    env: LaunchEnv,
+    cx: &mut AsyncApp,
+) -> LaunchPlan {
+    let (is_local, root, sandbox, memory) = cx.update(|cx| {
+        (
+            project.read(cx).is_local(),
+            project_root(project, cx),
+            AgentSandboxSettings::get_global(cx).clone(),
+            AgentMemorySettings::get_global(cx).clone(),
+        )
+    });
+    let local = LocalLaunch {
+        agent_id,
+        root,
+        cmd,
+        configured_env: configured_env.clone(),
+        sandbox,
+        memory,
+        env,
+        executor: cx.background_executor().clone(),
+    };
+    if !is_local {
+        return LaunchPlan::without_spawn(LaunchDecision::Unchanged(
+            local.unmanaged_record(Reason::Remote),
+        ));
+    }
+    if local.cmd.path.file_name() == Some(OsStr::new("ai-jail")) {
+        return LaunchPlan::without_spawn(LaunchDecision::Unchanged(
+            local.unmanaged_record(Reason::OwnCommand),
+        ));
+    }
+    cx.background_executor().spawn(local.decide()).await
+}
+
+/// Everything a local decision needs, moved to the background executor: every blocking file
+/// system call of a launch happens there.
+struct LocalLaunch {
+    agent_id: AgentId,
+    root: Option<PathBuf>,
+    cmd: AgentServerCommand,
+    configured_env: HashSet<String>,
+    sandbox: AgentSandboxSettings,
+    memory: AgentMemorySettings,
+    env: LaunchEnv,
+    executor: BackgroundExecutor,
+}
+
+/// What the checks passed on to the generated command.
+struct Checked {
+    /// The resolved root `check_root` approved; the jail's cwd and the base of its maps.
+    root: PathBuf,
+    ai_jail: PathBuf,
+    version: Version,
+    claude_dir: PathBuf,
+    rw_maps: Vec<PathBuf>,
+    allow_hosts: Vec<String>,
+    forward_ports: Vec<u16>,
+    memory_port: MemoryPort,
+    env_names: Vec<String>,
+}
+
+impl LocalLaunch {
+    async fn decide(self) -> LaunchPlan {
+        if !is_claude_adapter(&self.agent_id, &self.cmd) && !resolves_to_adapter(&self.cmd.path) {
+            return LaunchPlan::without_spawn(LaunchDecision::Unchanged(
+                self.unmanaged_record(Reason::NotClaude),
+            ));
+        }
+        let Some(root) = self.root.clone() else {
+            let policy = self.sandbox.policy_for_key(None);
+            if policy.enabled {
+                return self.refuse(None, &policy, LaunchCause::NoRoot, None);
+            }
+            return LaunchPlan::without_spawn(LaunchDecision::Unchanged(self.record(
+                PathBuf::new(),
+                Reason::Off,
+                &policy,
+                None,
+            )));
+        };
+        let key = resolve_project_key(self.sandbox.project_keys(), &root).map(str::to_string);
+        let policy = self.sandbox.policy_for_key(key.as_deref());
+        if !policy.enabled {
+            return LaunchPlan::without_spawn(LaunchDecision::Unchanged(self.record(
+                root,
+                Reason::Off,
+                &policy,
+                key,
+            )));
+        }
+        let checked = match self.check(&root, &policy).await {
+            Ok(checked) => checked,
+            Err(refusal) => {
+                let (cause, version) = *refusal;
+                return self.refuse(Some(root), &policy, cause, version);
+            }
+        };
+        let forwarded = matches!(checked.memory_port, MemoryPort::Forwarded(_));
+        let jail_spawn = JailSpawn {
+            cwd: checked.root.clone(),
+            env: self.jail_env(&checked.env_names, forwarded),
+        };
+        // The record keeps the root as the project spells it: the registry and the UI look it
+        // up by that spelling.
+        let mut record = self.record(root, Reason::On, &policy, key);
+        let inputs = JailInputs {
+            ai_jail: &checked.ai_jail,
+            project_root: &checked.root,
+            claude_dir: &checked.claude_dir,
+            rw_maps: &checked.rw_maps,
+            allow_hosts: &checked.allow_hosts,
+            forward_ports: &checked.forward_ports,
+            env_names: checked.env_names.clone(),
+        };
+        let mut jailed = generate(self.cmd, &inputs);
+        if forwarded {
+            // ai-jail's filtered egress would send loopback HTTP to its proxy (R7.1).
+            jailed = keep_loopback_off_proxy(jailed);
+        }
+        record.ai_jail_version = Some(checked.version);
+        record.rw_maps = std::iter::once(checked.claude_dir)
+            .chain(checked.rw_maps)
+            .collect();
+        record.allow_hosts = checked.allow_hosts;
+        record.forward_ports = checked.forward_ports;
+        record.memory_port = checked.memory_port;
+        record.ai_jail_path = Some(checked.ai_jail);
+        LaunchPlan {
+            decision: LaunchDecision::Jailed(record, jailed),
+            jail_spawn: Some(jail_spawn),
+        }
+    }
+
+    /// ai-jail's whole environment: Zeo's own `PATH` and `LANG`, `XDG_RUNTIME_DIR`, the
+    /// forwarded names with their values from the command, then `HOME`. A configured name
+    /// overrides the base (an npm adapter's `PATH`), except `HOME`: ai-jail finds its global
+    /// configuration through it, so it is always Zeo's. With a forwarded memory port it also
+    /// carries the loopback proxy exclusion, merged with the forwarded `no_proxy`/`NO_PROXY`.
+    fn jail_env(&self, forwarded: &[String], memory_forwarded: bool) -> Vec<(String, String)> {
+        let mut env = std::collections::BTreeMap::new();
+        for name in ["PATH", "LANG"] {
+            if let Ok(value) = std::env::var(name) {
+                env.insert(name.to_string(), value);
+            }
+        }
+        if let Some(runtime_dir) = self.env.runtime_dir.as_ref().and_then(|dir| dir.to_str()) {
+            env.insert("XDG_RUNTIME_DIR".to_string(), runtime_dir.to_string());
+        }
+        if let Some(command_env) = &self.cmd.env {
+            for name in forwarded {
+                if let Some(value) = command_env.get(name) {
+                    env.insert(name.clone(), value.clone());
+                }
+            }
+        }
+        if memory_forwarded {
+            let configured = ["no_proxy", "NO_PROXY"]
+                .into_iter()
+                .filter_map(|name| env.get(name).map(String::as_str));
+            let exclusion = loopback_no_proxy(configured);
+            env.insert(NO_PROXY_CARRIER.to_string(), exclusion);
+        }
+        env.insert(
+            "HOME".to_string(),
+            self.env.home.to_string_lossy().into_owned(),
+        );
+        env.into_iter().collect()
+    }
+
+    /// The checks of a jailed start, in order; the first failure refuses it.
+    async fn check(
+        &self,
+        root: &Path,
+        policy: &ProjectPolicy,
+    ) -> Result<Checked, Box<(LaunchCause, Option<Version>)>> {
+        let no_version = |cause| Box::new((cause, None));
+        // One scan of the protected folders per launch: every check below shares it.
+        let set = ProtectedSet::new(
+            &self.env.home,
+            &self.env.config_dir,
+            self.env.runtime_dir.as_deref(),
+        );
+        let canonical_root = check_root(root, &set).map_err(no_version)?;
+
+        let configured = self.sandbox.ai_jail_path.as_deref();
+        let ai_jail = match probe::locate(configured) {
+            Some(path) if path.is_file() => path,
+            located => {
+                return Err(no_version(LaunchCause::NotInstalled {
+                    configured: located.filter(|_| configured.is_some()),
+                }));
+            }
+        };
+        let binary = probe::probe(&ai_jail, &self.executor)
+            .await
+            .map_err(|error| no_version(LaunchCause::VersionUnreadable(error)))?;
+        let refuse = |cause| Box::new((cause, Some(binary.version.clone())));
+
+        let claude_raw = self.sandbox.claude_config_dir.as_str();
+        let claude_dir = match validate::validate_rw_map_with(claude_raw, &set) {
+            Ok(dir) => dir,
+            Err(RwMapError::Missing { .. }) => {
+                return Err(refuse(LaunchCause::ClaudeDirMissing {
+                    dir: expand_tilde(claude_raw, &self.env.home),
+                }));
+            }
+            Err(error) => return Err(refuse(LaunchCause::ClaudeDirInvalid(error))),
+        };
+
+        let mut rw_maps: Vec<PathBuf> = Vec::with_capacity(policy.rw_maps.len());
+        for raw in &policy.rw_maps {
+            let map = validate::validate_rw_map_with(raw, &set)
+                .map_err(|error| refuse(LaunchCause::InvalidMap(error)))?;
+            if map != claude_dir && !rw_maps.contains(&map) {
+                rw_maps.push(map);
+            }
+        }
+        let mut allow_hosts = Vec::with_capacity(policy.allow_hosts.len());
+        for raw in &policy.allow_hosts {
+            let host = validate::validate_host(raw)
+                .map_err(|error| refuse(LaunchCause::InvalidHost(error)))?;
+            allow_hosts.push(host);
+        }
+        validate::check_limits(rw_maps.len(), allow_hosts.len())
+            .map_err(|error| refuse(LaunchCause::Limit(error)))?;
+        check_nesting(&canonical_root, &claude_dir, &rw_maps).map_err(refuse)?;
+
+        let env_names = self.forwarded_env_names().map_err(refuse)?;
+
+        let memory_port = memory_port(&self.memory, binary.supports_forward_port)
+            .map_err(|error| refuse(LaunchCause::InvalidMemoryEndpoint(error)))?;
+        let forward_ports = match memory_port {
+            MemoryPort::Forwarded(port) => vec![port],
+            MemoryPort::Unsupported | MemoryPort::Off | MemoryPort::NonLoopback => Vec::new(),
+        };
+
+        for mount in [".git", ".zed"] {
+            let path = canonical_root.join(mount);
+            if std::fs::symlink_metadata(&path).is_ok_and(|metadata| metadata.is_symlink()) {
+                return Err(refuse(LaunchCause::SymlinkedMount { path }));
+            }
+        }
+        // Not recursive: a root deleted since the check above is never recreated.
+        let dot_zed = canonical_root.join(".zed");
+        match std::fs::create_dir(&dot_zed) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+                if !dot_zed.is_dir() {
+                    return Err(refuse(LaunchCause::ZedDirCreate {
+                        dir: dot_zed,
+                        error: io::Error::new(
+                            io::ErrorKind::AlreadyExists,
+                            "it exists and is not a folder",
+                        ),
+                    }));
+                }
+            }
+            Err(error) => {
+                return Err(refuse(LaunchCause::ZedDirCreate {
+                    dir: dot_zed,
+                    error,
+                }));
+            }
+        }
+
+        Ok(Checked {
+            root: canonical_root,
+            ai_jail,
+            version: binary.version,
+            claude_dir,
+            rw_maps,
+            allow_hosts,
+            forward_ports,
+            memory_port,
+            env_names,
+        })
+    }
+
+    /// The configured names present in the command's env, sorted. A shell variable nobody
+    /// configured is neither forwarded nor validated.
+    fn forwarded_env_names(&self) -> Result<Vec<String>, LaunchCause> {
+        let Some(env) = &self.cmd.env else {
+            return Ok(Vec::new());
+        };
+        let mut names: Vec<String> = self
+            .configured_env
+            .iter()
+            .filter(|name| env.contains_key(*name))
+            .cloned()
+            .collect();
+        names.sort();
+        if let Some(bad) = names.iter().find(|name| !is_valid_env_key(name)) {
+            let shown = match bad.split_once('=') {
+                Some((name, _)) => format!("{name}=…"),
+                None => bad.clone(),
+            };
+            return Err(LaunchCause::InvalidEnvKey { shown });
+        }
+        Ok(names)
+    }
+
+    fn record(
+        &self,
+        root: PathBuf,
+        reason: Reason,
+        policy: &ProjectPolicy,
+        settings_key: Option<String>,
+    ) -> LaunchRecord {
+        LaunchRecord {
+            agent_id: self.agent_id.clone(),
+            project_root: root,
+            reason,
+            ai_jail_version: None,
+            ai_jail_path: None,
+            rw_maps: Vec::new(),
+            allow_hosts: Vec::new(),
+            forward_ports: Vec::new(),
+            memory_port: MemoryPort::Off,
+            settings_fingerprint: settings_fingerprint(&self.sandbox, policy),
+            memory_fingerprint: memory_fingerprint(&self.memory),
+            settings_key,
+        }
+    }
+
+    fn unmanaged_record(&self, reason: Reason) -> LaunchRecord {
+        LaunchRecord {
+            settings_fingerprint: 0,
+            memory_fingerprint: 0,
+            ..self.record(
+                self.root.clone().unwrap_or_default(),
+                reason,
+                &ProjectPolicy::default(),
+                None,
+            )
+        }
+    }
+
+    fn refuse(
+        &self,
+        root: Option<PathBuf>,
+        policy: &ProjectPolicy,
+        cause: LaunchCause,
+        ai_jail_version: Option<Version>,
+    ) -> LaunchPlan {
+        LaunchPlan::without_spawn(LaunchDecision::Refused(LaunchError {
+            agent_id: self.agent_id.clone(),
+            project_root: root,
+            cause,
+            ai_jail_version,
+            // The Claude config directory is always mapped.
+            rw_maps: policy.rw_maps.len() + 1,
+            allow_hosts: policy.allow_hosts.len(),
+            forward_ports: 0,
+        }))
+    }
+}
+
+/// Refuses a root ai-jail cannot keep `.git`/`.zed` read-only in (`:` or not UTF-8), a root that
+/// is not an existing folder, and one that breaks R2.8. Returns the canonical root.
+pub(crate) fn check_root(root: &Path, set: &ProtectedSet) -> Result<PathBuf, LaunchCause> {
+    let unusable = |problem| LaunchCause::RootUnusable {
+        root: root.to_path_buf(),
+        problem,
+    };
+    root_problem(root).map_or(Ok(()), |problem| Err(unusable(problem)))?;
+    if !std::fs::metadata(root).is_ok_and(|metadata| metadata.is_dir()) {
+        return Err(LaunchCause::RootMissing {
+            root: root.to_path_buf(),
+        });
+    }
+    let canonical = root.canonicalize().map_err(|_| LaunchCause::RootMissing {
+        root: root.to_path_buf(),
+    })?;
+    root_problem(&canonical).map_or(Ok(()), |problem| Err(unusable(problem)))?;
+    if let Some(rule) = set.rule_for(&canonical) {
+        return Err(LaunchCause::RootForbidden {
+            root: root.to_path_buf(),
+            rule,
+        });
+    }
+    Ok(canonical)
+}
+
+fn root_problem(path: &Path) -> Option<RootProblem> {
+    match path.to_str() {
+        None => Some(RootProblem::NotUtf8),
+        Some(text) if text.contains(':') => Some(RootProblem::Colon),
+        Some(_) => None,
+    }
+}
+
+/// Refuses a writable folder strictly inside the root, the Claude config directory or another
+/// folder, and the Claude config directory inside the root or a folder: the agent can write the
+/// outer one, so it could swap the inner one for a symlink before ai-jail binds it. All paths are
+/// canonical.
+pub fn check_nesting(
+    root: &Path,
+    claude_dir: &Path,
+    rw_maps: &[PathBuf],
+) -> Result<(), LaunchCause> {
+    let nested = |inner: &Path, outer: &Path| LaunchCause::NestedMap {
+        inner: inner.to_path_buf(),
+        outer: outer.to_path_buf(),
+    };
+    let strictly_inside = |inner: &Path, outer: &Path| inner != outer && inner.starts_with(outer);
+    if claude_dir.starts_with(root) {
+        return Err(nested(claude_dir, root));
+    }
+    if let Some(outer) = rw_maps.iter().find(|map| strictly_inside(claude_dir, map)) {
+        return Err(nested(claude_dir, outer));
+    }
+    for map in rw_maps {
+        for outer in [root, claude_dir]
+            .into_iter()
+            .chain(rw_maps.iter().map(PathBuf::as_path))
+        {
+            if strictly_inside(map, outer) {
+                return Err(nested(map, outer));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// ai-jail's own rule for an `--env` name: `^[A-Za-z_][A-Za-z0-9_]*$`.
+fn is_valid_env_key(name: &str) -> bool {
+    let mut chars = name.chars();
+    chars
+        .next()
+        .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
+        && chars.all(|next| next.is_ascii_alphanumeric() || next == '_')
+}
+
+/// Whether the agent is one of the Claude adapters by its registry id, its command's name, or an
+/// argument naming the adapter's file or npm package (R1.13). Reads no file system.
+fn is_claude_adapter(agent_id: &AgentId, cmd: &AgentServerCommand) -> bool {
+    let id: &str = agent_id.0.as_ref();
+    id == ZEO_PLUS_AGENT_ID
+        || id == ZEO_TUI_AGENT_ID
+        || names_adapter(&cmd.path)
+        || cmd.args.iter().any(|arg| {
+            arg_names_adapter(arg) || shell_words(arg).any(|word| arg_names_adapter(&word))
+        })
+}
+
+/// The words of `arg` read as a shell script (`bash -lc "npx -y <package>"`), each also split at
+/// the shell's control operators so `exec adapter;` yields `adapter`. An unbalanced quote falls
+/// back to splitting at whitespace.
+fn shell_words(arg: &str) -> impl Iterator<Item = String> + '_ {
+    let words =
+        shlex::split(arg).unwrap_or_else(|| arg.split_whitespace().map(str::to_string).collect());
+    words.into_iter().flat_map(|word| {
+        word.split([';', '&', '|', '(', ')', '`', '<', '>'])
+            .filter(|part| !part.is_empty())
+            .map(str::to_string)
+            .collect::<Vec<_>>()
+    })
+}
+
+/// The command resolved through `PATH` (a bare name) and symlinks names an adapter. Blocking.
+fn resolves_to_adapter(path: &Path) -> bool {
+    let bare = path.components().count() == 1 && !path.is_absolute();
+    let located = if bare {
+        which::which(path).ok()
+    } else {
+        Some(path.to_path_buf())
+    };
+    located
+        .and_then(|path| path.canonicalize().ok())
+        .is_some_and(|canonical| names_adapter(&canonical))
+}
+
+fn names_adapter(path: &Path) -> bool {
+    [path.file_name(), path.file_stem()]
+        .into_iter()
+        .flatten()
+        .any(|name| {
+            name.to_str()
+                .is_some_and(|name| ADAPTER_NAMES.contains(&name))
+        })
+}
+
+fn arg_names_adapter(arg: &str) -> bool {
+    let arg = arg.strip_prefix("--package=").unwrap_or(arg);
+    arg.split('/')
+        .any(|component| ADAPTER_NAMES.contains(&component))
+        || names_adapter(Path::new(arg))
+        || ADAPTER_PACKAGES
+            .iter()
+            .any(|package| holds_package(arg, package))
+}
+
+/// `package` at the start of `arg` or after a `/`, followed by nothing, a `/` or an `@version`.
+fn holds_package(arg: &str, package: &str) -> bool {
+    arg.match_indices(package).any(|(at, _)| {
+        let starts_component = at == 0 || arg[..at].ends_with('/');
+        let rest = &arg[at + package.len()..];
+        starts_component && (rest.is_empty() || rest.starts_with('/') || rest.starts_with('@'))
+    })
+}
+
+/// What happens to ai-memory inside the jail: memory off → `Off`; an endpoint that is not
+/// 127.0.0.1, ::1 or localhost → `NonLoopback`; an ai-jail without `--forward-port` →
+/// `Unsupported` (R7.4); else the port to forward. An unparsable endpoint while memory is on is an
+/// error. Shared by a start and the settings page, so both say the same.
+pub fn memory_port(
+    settings: &AgentMemorySettings,
+    supports_forward_port: bool,
+) -> Result<MemoryPort, InvalidMemoryEndpoint> {
+    if !settings.enabled {
+        return Ok(MemoryPort::Off);
+    }
+    let endpoint = url::Url::parse(&settings.endpoint).map_err(|_| InvalidMemoryEndpoint {
+        shown: redact_endpoint(&settings.endpoint),
+    })?;
+    let Some(port) = crate::memory::forward_port(&endpoint) else {
+        return Ok(MemoryPort::NonLoopback);
+    };
+    if !supports_forward_port {
+        return Ok(MemoryPort::Unsupported);
+    }
+    Ok(MemoryPort::Forwarded(port))
+}
+
+/// An unparsable endpoint as it may be shown: no query, no fragment, no userinfo, and no scheme
+/// that carries an `@` (a token pasted where the scheme goes).
+fn redact_endpoint(raw: &str) -> String {
+    let text = raw.split(['?', '#']).next().unwrap_or_default();
+    let (scheme, rest) = match text.split_once("://") {
+        Some((scheme, rest)) if !scheme.contains('@') => (format!("{scheme}://"), rest),
+        Some((_, rest)) => (String::new(), rest),
+        None => (String::new(), text),
+    };
+    let (authority, path) = match rest.find('/') {
+        Some(slash) => rest.split_at(slash),
+        None => (rest, ""),
+    };
+    let host = authority
+        .rsplit_once('@')
+        .map_or(authority, |(_, host)| host);
+    format!("{scheme}{host}{path}")
+}
+
+fn settings_fingerprint(sandbox: &AgentSandboxSettings, policy: &ProjectPolicy) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    policy.enabled.hash(&mut hasher);
+    policy.rw_maps.hash(&mut hasher);
+    policy.allow_hosts.hash(&mut hasher);
+    sandbox.claude_config_dir.hash(&mut hasher);
+    sandbox.ai_jail_path.hash(&mut hasher);
+    hasher.finish()
+}
+
+fn memory_fingerprint(memory: &AgentMemorySettings) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    memory.enabled.hash(&mut hasher);
+    memory.endpoint.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// Whether the sandbox settings of the record's project differ from those it was started with
+/// (R1.12, R3.8, R5.4). Never for an agent the sandbox does not manage.
+pub fn drifted(record: &LaunchRecord, settings: &AgentSandboxSettings) -> bool {
+    match record.reason {
+        Reason::OwnCommand | Reason::Remote | Reason::NotClaude => false,
+        Reason::On | Reason::Off => {
+            let key = record
+                .settings_key
+                .as_deref()
+                .filter(|key| settings.projects.contains_key(*key))
+                .or_else(|| lexical_match(settings.project_keys(), &record.project_root));
+            settings_fingerprint(settings, &settings.policy_for_key(key))
+                != record.settings_fingerprint
+        }
+    }
+}
+
+/// Whether the memory settings differ from those a jailed agent was started with.
+pub fn memory_drifted(record: &LaunchRecord, settings: &AgentMemorySettings) -> bool {
+    record.reason == Reason::On && memory_fingerprint(settings) != record.memory_fingerprint
+}
+
+/// [`drifted`] or [`memory_drifted`] against the settings of now.
+pub fn drifted_now(record: &LaunchRecord, cx: &App) -> bool {
+    drifted(record, AgentSandboxSettings::get_global(cx))
+        || memory_drifted(record, AgentMemorySettings::get_global(cx))
+}
+
+/// Whether the ai-jail a start would use now (`None`: not found) differs from the jailed
+/// record's. The caller probes; this never runs a process.
+pub fn binary_drifted(
+    record: &LaunchRecord,
+    path: Option<&Path>,
+    version: Option<&Version>,
+) -> bool {
+    record.reason == Reason::On
+        && (record.ai_jail_path.as_deref() != path || record.ai_jail_version.as_ref() != version)
+}
+
+/// One registered launch.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct LaunchId(u64);
+
+/// The launch records of the running agents, written when an agent starts and removed when its
+/// connection ends.
+#[derive(Debug, Default)]
+pub struct LaunchRegistry {
+    next_id: u64,
+    launches: Vec<(LaunchId, LaunchRecord)>,
+}
+
+impl Global for LaunchRegistry {}
+
+impl LaunchRegistry {
+    pub fn register(record: LaunchRecord, cx: &mut App) -> LaunchId {
+        let registry = cx.default_global::<Self>();
+        registry.next_id += 1;
+        let id = LaunchId(registry.next_id);
+        registry.launches.push((id, record));
+        id
+    }
+
+    /// The latest live launch of `agent_id` in `root`.
+    pub fn get(agent_id: &AgentId, root: &Path, cx: &App) -> Option<LaunchRecord> {
+        cx.try_global::<Self>()?
+            .launches
+            .iter()
+            .rev()
+            .find(|(_, record)| record.agent_id == *agent_id && record.project_root == root)
+            .map(|(_, record)| record.clone())
+    }
+
+    /// Removes every launch of `agent_id` in `root`. Test-only: a connection ends its own launch
+    /// with [`Self::remove_launch`], so a newer launch of the same agent and root survives.
+    #[cfg(test)]
+    pub fn remove(agent_id: &AgentId, root: &Path, cx: &mut App) {
+        if cx.has_global::<Self>() {
+            cx.global_mut::<Self>()
+                .launches
+                .retain(|(_, record)| record.agent_id != *agent_id || record.project_root != root);
+        }
+    }
+
+    /// Removes this launch only; a later launch of the same agent and root stays.
+    pub fn remove_launch(id: LaunchId, cx: &mut App) {
+        if cx.has_global::<Self>() {
+            cx.global_mut::<Self>()
+                .launches
+                .retain(|(launch, _)| *launch != id);
+        }
+    }
+
+    /// Every live launch in `root`, oldest first.
+    pub fn for_root(root: &Path, cx: &App) -> Vec<LaunchRecord> {
+        cx.try_global::<Self>()
+            .map(|registry| {
+                registry
+                    .launches
+                    .iter()
+                    .filter(|(_, record)| record.project_root == root)
+                    .map(|(_, record)| record.clone())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+}
