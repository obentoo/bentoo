+// Story 043, task 3.2 — the spawn hook in `CustomAgentServer::connect` and the launch log
+// (R1.1, R1.6, R1.7, R1.9, R9.1, R9.2, R9.4; Q4, Q14). Wired in the crate root
+// `src/agent_servers.rs` as
+//
+//     #[cfg(test)]
+//     mod sandbox_hook_tests;
+//
+// Validation filter: `sandbox` (every test path is `sandbox_hook_tests::…`).
+//
+// Behaviour-level: real processes on the real filesystem. A fake `ai-jail` records its argv, cwd
+// and environment and exits; a fake agent records that it ran and exits. `connect` then fails
+// the ACP handshake, which is expected — the assertions are on who was spawned, how, and what
+// was logged. The hook must not change the error path for a process that dies; only `Refused`
+// must carry the fail-closed text.
+//
+// Contract (design.md §Spawn hook, §launch): `CustomAgentServer::new(AgentId)` +
+// `AgentServer::connect(delegate, project, cx)`; the agent is a `custom` entry under the user
+// settings key `agent_servers`; the sandbox comes from the user key `agent_sandbox` (design
+// §Data Models); `crate::…` names are upstream's. The log line (R9.1):
+//   `agent_sandbox event=launch agent=<id> jailed=<bool> reason=<on|off|own_command|remote|refused>
+//    ai_jail=<ver|-> rw_maps=<n> hosts=<n> forward_ports=<n>` (+ `cause=` at error level).
+//
+// This file installs the crate's only test logger; run without RUST_LOG/ZED_LOG/CI.
+//
+// Hostile halves first:
+//   - refusal, wrongly START: with the sandbox on and no ai-jail, the agent process never runs
+//     and the error carries the fail-closed sentence and the project root.
+//   - own command, wrongly DOUBLE-WRAP: an agent whose command is `…/ai-jail` runs with exactly
+//     its configured argv; the managed ai-jail is never spawned.
+//   - secrets, wrongly LEAK: an agent env value reaches the jailed process's environment but is
+//     neither on its argv nor in any log line.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+
+use fs::RealFs;
+use gpui::{Entity, TestAppContext, UpdateGlobal as _};
+use project::Project;
+use project::agent_server_store::AgentId;
+use serde_json::{Value, json};
+use settings::SettingsStore;
+
+use crate::custom::CustomAgentServer;
+use crate::{AgentServer as _, AgentServerDelegate};
+
+const AGENT: &str = "fake-agent";
+const SECRET: &str = "secret-value-043-hook";
+
+// --- log capture (one logger for this test binary) ---------------------------------------------
+
+thread_local! {
+    static LINES: RefCell<Option<Vec<(log::Level, String)>>> = const { RefCell::new(None) };
+}
+
+struct Logs;
+
+impl Logs {
+    fn start() -> Self {
+        crate::test_log_capture::install_forwarding(&Capture);
+        LINES.with_borrow_mut(|lines| *lines = Some(Vec::new()));
+        Self
+    }
+    fn launch_lines(&self) -> Vec<(log::Level, String)> {
+        LINES.with_borrow(|lines| {
+            lines
+                .clone()
+                .unwrap_or_default()
+                .into_iter()
+                .filter(|(_, line)| line.contains("agent_sandbox event=launch"))
+                .collect()
+        })
+    }
+    fn all(&self) -> String {
+        LINES.with_borrow(|lines| {
+            lines
+                .clone()
+                .unwrap_or_default()
+                .into_iter()
+                .map(|(_, line)| line)
+                .collect::<Vec<_>>()
+                .join("\n")
+        })
+    }
+}
+
+impl Drop for Logs {
+    fn drop(&mut self) {
+        LINES.with_borrow_mut(|lines| *lines = None);
+    }
+}
+
+struct Capture;
+
+impl log::Log for Capture {
+    fn enabled(&self, metadata: &log::Metadata<'_>) -> bool {
+        metadata.level() <= log::max_level()
+    }
+    fn log(&self, record: &log::Record<'_>) {
+        LINES.with_borrow_mut(|lines| {
+            if let Some(lines) = lines {
+                lines.push((record.level(), record.args().to_string()));
+            }
+        });
+    }
+    fn flush(&self) {}
+}
+
+fn kv(line: &str) -> HashMap<String, String> {
+    line.split_whitespace()
+        .filter_map(|token| token.split_once('='))
+        .map(|(key, value)| (key.to_string(), value.to_string()))
+        .collect()
+}
+
+// --- fixture -------------------------------------------------------------------------------------
+
+struct Fixture {
+    _tmp: tempfile::TempDir,
+    base: PathBuf,
+    root: PathBuf,
+    ai_jail: PathBuf,
+    agent: PathBuf,
+    claude_dir: PathBuf,
+}
+
+fn script(path: &Path, body: &str) {
+    std::fs::create_dir_all(path.parent().expect("parent")).expect("mkdir");
+    std::fs::write(path, format!("#!/bin/sh\n{body}\n")).expect("write");
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+}
+
+impl Fixture {
+    fn new() -> Self {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = tmp.path().canonicalize().expect("canonical");
+        let root = base.join("app");
+        std::fs::create_dir_all(root.join(".git")).expect("project");
+        let ai_jail = base.join("bin/ai-jail");
+        script(
+            &ai_jail,
+            &format!(
+                "if [ \"$1\" = --version ]; then echo 'ai-jail 2.8.1'; exit 0; fi\n\
+                 printf '%s\\n' \"$@\" > '{out}/jail.argv'\n\
+                 pwd > '{out}/jail.cwd'\n\
+                 env > '{out}/jail.env'\n\
+                 exit 1",
+                out = base.display()
+            ),
+        );
+        let agent = base.join("bin/claude-agent-acp-plus");
+        script(
+            &agent,
+            &format!(
+                "printf '%s\\n' \"$@\" > '{}/agent.argv'\nexit 1",
+                base.display()
+            ),
+        );
+        let claude_dir = base.join("claude-jailed");
+        std::fs::create_dir_all(&claude_dir).expect("claude dir");
+        Self {
+            _tmp: tmp,
+            base,
+            root,
+            ai_jail,
+            agent,
+            claude_dir,
+        }
+    }
+
+    fn out(&self, name: &str) -> Option<String> {
+        std::fs::read_to_string(self.base.join(name)).ok()
+    }
+
+    fn settings(&self, sandbox_on: bool, ai_jail_path: &Path, agent_command: &Path) -> Value {
+        json!({
+            "agent_servers": {
+                AGENT: {
+                    "type": "custom",
+                    "command": agent_command,
+                    "args": ["--acp", "two words"],
+                    "env": { "HOOK_SECRET": SECRET }
+                }
+            },
+            "agent_sandbox": {
+                "enabled": sandbox_on,
+                "ai_jail_path": ai_jail_path,
+                "claude_config_dir": self.claude_dir,
+                "allow_hosts": ["anthropic.com", "platform.claude.com"],
+            },
+            "agent_memory": { "enabled": false }
+        })
+    }
+}
+
+fn init(settings: Value, cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        agent_sandbox::init(cx);
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&settings.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        });
+    });
+}
+
+async fn project(f: &Fixture, cx: &mut TestAppContext) -> Entity<Project> {
+    let project = Project::test(RealFs::new(None, cx.executor()), [f.root.as_path()], cx).await;
