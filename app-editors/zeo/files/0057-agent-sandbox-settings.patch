+++ b/crates/agent_sandbox/src/command_tests.rs
@@ -0,0 +1,325 @@
+// Story 043, task 2.3 — the generated jailed command and its preview (R1.1, R1.2, R1.3, R1.4,
+// R3.7, R7.1, R7.2; Q15). Wired in the crate root `src/agent_sandbox.rs` as
+//
+//     #[cfg(test)]
+//     mod command_tests;
+//
+// Validation filter: `command` (every test path is `command_tests::…`).
+//
+// Contract (design.md §agent_sandbox::command, quoted there as code). Assumed signatures — adjust
+// the `use` only:
+//   - `crate::command::JailInputs<'a> { ai_jail, project_root, claude_dir, rw_maps, allow_hosts, forward_ports, env_names }`
+//   - `crate::command::generate(agent: AgentServerCommand, inputs: &JailInputs) -> AgentServerCommand`
+//   - `crate::command::preview(cmd: &AgentServerCommand) -> String` (shell-quoted argv, no env values)
+//
+// Hostile halves first:
+//   - secrets, wrongly LEAK: an env value never appears in argv nor in the preview, even when the
+//     value looks like a flag; `--env NAME=VALUE` never appears.
+//   - flags, wrongly MERGE: agent arguments that look like ai-jail flags (`--rw-map /`,
+//     `--network`) stay after the agent path, untouched, behind a `--` that sits right before the
+//     agent path (measured on ai-jail 2.8.1 and 2.7.0: without it ai-jail refuses an agent argument
+//     that is also a jail flag); the jail options never gain `--network`, `--agent-state` or a `--`.
+//   - preview, wrongly SPLIT/JOIN: an argument with spaces, quotes or `$(…)` round-trips through
+//     a shell-word split to exactly one argument.
+
+use collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use project::agent_server_store::AgentServerCommand;
+
+use crate::command::{JailInputs, generate, preview};
+
+fn agent(env: Option<HashMap<String, String>>) -> AgentServerCommand {
+    AgentServerCommand {
+        path: PathBuf::from("/usr/bin/claude-agent-acp-plus"),
+        args: vec!["--acp".into(), "two words".into()],
+        env,
+    }
+}
+
+fn env(pairs: &[(&str, &str)]) -> HashMap<String, String> {
+    pairs
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect()
+}
+
+fn argv(cmd: &AgentServerCommand) -> Vec<String> {
+    cmd.args.clone()
+}
+
+fn s(items: &[&str]) -> Vec<String> {
+    items.iter().map(|item| item.to_string()).collect()
+}
+
+#[test]
+fn command_never_puts_env_values_on_argv() {
+    let rw: [PathBuf; 0] = [];
+    let hosts: [String; 0] = [];
+    let agent_env = env(&[
+        ("ANTHROPIC_API_KEY", "sk-ant-secret-1"),
+        ("WEIRD", "--rw-map=/"),
+    ]);
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[],
+        env_names: vec!["ANTHROPIC_API_KEY".into(), "WEIRD".into()],
+    };
+    let jailed = generate(agent(Some(agent_env.clone())), &inputs);
+    let joined = jailed.args.join("\u{1f}");
+    assert!(
+        !joined.contains("sk-ant-secret-1"),
+        "no env value on argv: {:?}",
+        jailed.args
+    );
+    assert!(
+        !joined.contains("--rw-map=/"),
+        "no env value on argv: {:?}",
+        jailed.args
+    );
+    assert!(
+        jailed
+            .args
+            .iter()
+            .all(|arg| !(arg.contains('=') && arg.starts_with("ANTHROPIC"))),
+        "never NAME=VALUE"
+    );
+    assert_eq!(
+        jailed.env,
+        Some(agent_env),
+        "the values travel in the process environment"
+    );
+    let shown = preview(&jailed);
+    assert!(
+        !shown.contains("sk-ant-secret-1"),
+        "no env value in the preview: {shown}"
+    );
+    assert!(
+        shown.contains("ANTHROPIC_API_KEY"),
+        "the env name is shown: {shown}"
+    );
+}
+
+#[test]
+fn command_keeps_agent_args_that_look_like_jail_flags_after_the_agent() {
+    let rw: [PathBuf; 0] = [];
+    let hosts: [String; 0] = [];
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[],
+        env_names: vec![],
+    };
+    let mut cmd = agent(None);
+    cmd.args = s(&["--rw-map", "/", "--network"]);
+    let jailed = generate(cmd, &inputs);
+    let args = argv(&jailed);
+    let agent_at = args
+        .iter()
+        .position(|arg| arg == "/usr/bin/claude-agent-acp-plus")
+        .expect("the agent path is on argv");
+    assert_eq!(
+        &args[agent_at + 1..],
+        &s(&["--rw-map", "/", "--network"])[..]
+    );
+    assert_eq!(
+        args[agent_at - 1],
+        "--",
+        "a `--` separates the jail options from the agent: {args:?}"
+    );
+    let jail_part = &args[..agent_at - 1];
+    for forbidden in ["--network", "--agent-state", "--"] {
+        assert!(
+            !jail_part.iter().any(|arg| arg == forbidden),
+            "the jail options never carry {forbidden}: {jail_part:?}"
+        );
+    }
+    assert!(
+        !jail_part.iter().any(|arg| arg == "/"),
+        "the agent's `/` never becomes a jail --rw-map"
+    );
+}
+
+#[test]
+fn command_exact_argv_shape() {
+    let rw = [PathBuf::from("/h/cache"), PathBuf::from("/data")];
+    let hosts = [
+        "anthropic.com".to_string(),
+        "platform.claude.com".to_string(),
+    ];
+    let agent_env = env(&[("A_NAME", "1"), ("B_NAME", "2")]);
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[49374],
+        env_names: vec!["A_NAME".into(), "B_NAME".into()],
+    };
+    let jailed = generate(agent(Some(agent_env.clone())), &inputs);
+    assert_eq!(jailed.path, PathBuf::from("/usr/bin/ai-jail"));
+    assert_eq!(
+        jailed.args,
+        s(&[
+            "--exec",
+            "--no-save-config",
+            "--no-status-bar",
+            "--no-toolchains",
+            "--map",
+            "/w/app/.git",
+            "--map",
+            "/w/app/.zed",
+            "--claude-dir",
+            "/h/.claude-jailed",
+            "--rw-map",
+            "/h/.claude-jailed",
+            "--rw-map",
+            "/h/cache",
+            "--rw-map",
+            "/data",
+            "--allow-host",
+            "anthropic.com",
+            "--allow-host",
+            "platform.claude.com",
+            "--forward-port",
+            "49374",
+            "--env",
+            "A_NAME",
+            "--env",
+            "B_NAME",
+            "--",
+            "/usr/bin/claude-agent-acp-plus",
+            "--acp",
+            "two words",
+        ])
+    );
+    assert_eq!(
+        jailed.args[0], "--exec",
+        "--exec first: no PTY proxy on the ACP stream"
+    );
+    assert_eq!(jailed.env, Some(agent_env));
+}
+
+#[test]
+fn command_without_memory_ports_or_env_adds_neither() {
+    let rw: [PathBuf; 0] = [];
+    let hosts = ["anthropic.com".to_string()];
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[],
+        env_names: vec![],
+    };
+    let jailed = generate(agent(None), &inputs);
+    assert!(
+        !jailed.args.iter().any(|arg| arg == "--forward-port"),
+        "R7.2"
+    );
+    assert!(!jailed.args.iter().any(|arg| arg == "--env"));
+    assert_eq!(jailed.env, None);
+    for required in [
+        "--exec",
+        "--no-save-config",
+        "--no-status-bar",
+        "--no-toolchains",
+    ] {
+        assert!(
+            jailed.args.iter().any(|arg| arg == required),
+            "{required} always present"
+        );
+    }
+}
+
+#[test]
+fn command_preview_round_trips_hostile_arguments() {
+    let rw = [PathBuf::from("/h/my cache")];
+    let hosts: [String; 0] = [];
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[],
+        env_names: vec![],
+    };
+    let mut cmd = agent(None);
+    cmd.args = s(&["it's", "$(rm -rf ~)", "a\"b", "semi;colon", ""]);
+    let jailed = generate(cmd, &inputs);
+    let shown = preview(&jailed);
+    let words = shlex::split(&shown).expect("the preview is valid shell words");
+    let mut expected = vec![jailed.path.display().to_string()];
+    expected.extend(jailed.args.iter().cloned());
+    assert_eq!(words, expected, "preview: {shown}");
+}
+
+// Fix round of 10.3 (live proof, defect #1): the loopback proxy exclusion for a forwarded port.
+// Hostile halves: the carrier is forwarded once even when the agent's settings configure it too;
+// the agent and its jail-flag-looking arguments stay after the wrapper, unchanged; the merge never
+// drops a configured entry and never repeats one.
+#[test]
+fn command_keep_loopback_off_proxy_wraps_the_agent_once() {
+    use crate::command::{NO_PROXY_CARRIER, keep_loopback_off_proxy, loopback_no_proxy};
+
+    let rw: [PathBuf; 0] = [];
+    let hosts = ["anthropic.com".to_string()];
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/w/app"),
+        claude_dir: Path::new("/h/.claude-jailed"),
+        rw_maps: &rw,
+        allow_hosts: &hosts,
+        forward_ports: &[49374],
+        env_names: vec![NO_PROXY_CARRIER.into()],
+    };
+    let mut cmd = agent(None);
+    cmd.args = s(&["--rw-map", "/", "--"]);
+    let wrapped = keep_loopback_off_proxy(generate(cmd, &inputs));
+    let args = argv(&wrapped);
+    let separator = args.iter().position(|arg| arg == "--").expect("a `--`");
+    assert_eq!(
+        args[..separator]
+            .windows(2)
+            .filter(|pair| pair[0] == "--env" && pair[1] == NO_PROXY_CARRIER)
+            .count(),
+        1,
+        "{args:?}"
+    );
+    assert_eq!(
+        &args[separator + 1..separator + 3],
+        &s(&["/bin/sh", "-c"])[..]
+    );
+    assert_eq!(
+        &args[separator + 4..],
+        &s(&[
+            "sh",
+            "/usr/bin/claude-agent-acp-plus",
+            "--rw-map",
+            "/",
+            "--"
+        ])[..]
+    );
+    let words = shlex::split(&preview(&wrapped)).expect("the preview splits");
+    assert_eq!(
+        &words[1..],
+        &args[..],
+        "the preview round-trips the wrapper"
+    );
+
+    assert_eq!(loopback_no_proxy([]), "127.0.0.1,localhost,::1");
+    assert_eq!(
+        loopback_no_proxy([" a.example ,::1,,", "A.example,a.example"]),
+        "127.0.0.1,localhost,::1,a.example,A.example"
+    );
+}
diff --git a/crates/agent_sandbox/src/confirm.rs b/crates/agent_sandbox/src/confirm.rs
new file mode 100644
index 0000000..c39d399
--- /dev/null
+++ b/crates/agent_sandbox/src/confirm.rs
@@ -0,0 +1,570 @@
+//! The confirmations the agent sandbox asks for, and the only two writers of its switches.
+//!
+//! Turning the jail off, for one project or for the default, always goes through
+//! [`confirm_turn_off`]; turning it on saves without asking (R4.1–R4.4). The settings page and the
+//! palette both call [`set_project_enabled`] and [`set_default_enabled`] and never write the
+//! switches themselves.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, OnceLock};
+
+use futures::channel::oneshot;
+use gpui::{App, AppContext as _, AsyncApp, PromptLevel, Task, Window};
+use project::Fs;
+use settings::{Settings as _, SettingsContent, SettingsStore};
+use workspace::notifications::simple_message_notification::MessageNotification;
+use workspace::notifications::{NotificationId, show_app_notification};
+
+use crate::settings::{AgentSandboxSettings, lexical_match, resolve_project_key};
+
+/// The R4.1 detail, shared by the project and the default prompt.
+pub const TURN_OFF_DETAIL: &str =
+    "The agent will run with your user's full access the next time it starts.";
+/// The R6.4 detail.
+pub const FORGET_DETAIL: &str = "ai-memory deletes the page. This cannot be undone.";
+/// Cancel comes first: Zed's prompt preselects the first button and Enter confirms it, so an Enter
+/// still held after the palette command lands on the harmless answer.
+pub const TURN_OFF_BUTTONS: [&str; 2] = ["Cancel", "Turn Off"];
+/// Cancel first, for the same reason as [`TURN_OFF_BUTTONS`].
+pub const FORGET_BUTTONS: [&str; 2] = ["Cancel", "Forget"];
+/// The index of the confirming button in both button arrays.
+const CONFIRM_INDEX: usize = 1;
+/// What the default switch's prompt names (R4.2).
+const DEFAULT_SCOPE: &str = "projects without their own setting";
+/// The settings key [`set_default_enabled`] writes, as logged.
+const DEFAULT_KEY: &str = "agent_sandbox.enabled";
+
+/// What a turn-off confirmation names.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum OffScope {
+    /// One project, by its display name.
+    Project(String),
+    /// The default switch, for projects without their own setting.
+    Default,
+}
+
+/// Asks "Turn off the agent sandbox for <scope>?" (R4.1, R4.2). `true` only for Turn Off; Cancel,
+/// a dismissed prompt and a dropped one are all `false` (R4.3).
+pub fn confirm_turn_off(scope: OffScope, window: &mut Window, cx: &mut App) -> Task<bool> {
+    let name = match &scope {
+        OffScope::Project(name) => name.as_str(),
+        OffScope::Default => DEFAULT_SCOPE,
+    };
+    let message = format!("Turn off the agent sandbox for {name}?");
+    ask(&message, TURN_OFF_DETAIL, &TURN_OFF_BUTTONS, window, cx)
+}
+
+/// Asks "Forget <path>?" (R6.4). `true` only for Forget.
+pub fn confirm_forget(path: &str, window: &mut Window, cx: &mut App) -> Task<bool> {
+    let message = format!("Forget {path}?");
+    ask(&message, FORGET_DETAIL, &FORGET_BUTTONS, window, cx)
+}
+
+fn ask(
+    message: &str,
+    detail: &str,
+    buttons: &[&str],
+    window: &mut Window,
+    cx: &mut App,
+) -> Task<bool> {
+    let answer = window.prompt(PromptLevel::Warning, message, Some(detail), buttons, cx);
+    cx.foreground_executor()
+        .spawn(async move { confirmed(answer.await) })
+}
+
+/// Only the second button confirms: the preselected first one, a dismissed prompt and a dropped
+/// one all count as Cancel.
+fn confirmed(answer: Result<usize, oneshot::Canceled>) -> bool {
+    answer == Ok(CONFIRM_INDEX)
+}
+
+/// Sets `agent_sandbox.projects[<root>].enabled`, asking first when `enabled` is `false`. Only
+/// `enabled` is touched; the entry's folders and hosts stay. Resolves to `true` only when the file
+/// was saved. A root that is not valid UTF-8 is refused before asking: no key could name it.
+pub fn set_project_enabled(
+    root: &Path,
+    enabled: bool,
+    window: &mut Window,
+    cx: &mut App,
+) -> Task<bool> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        refuse_non_utf8_root(root, cx);
+        return Task::ready(false);
+    };
+    let consent = if enabled {
+        Task::ready(true)
+    } else {
+        let name = root
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or(&root_text)
+            .to_string();
+        confirm_turn_off(OffScope::Project(name), window, cx)
+    };
+    let root = root.to_path_buf();
+    cx.spawn(async move |cx| {
+        if !consent.await {
+            return false;
+        }
+        let keys: Vec<String> = cx.update(|cx| {
+            AgentSandboxSettings::get_global(cx)
+                .projects
+                .keys()
+                .cloned()
+                .collect()
+        });
+        // Canonicalizing every key blocks, so it runs off the main thread.
+        let resolved = cx
+            .background_executor()
+            .spawn(async move {
+                resolve_project_key(keys.iter().map(String::as_str), &root).map(PathBuf::from)
+            })
+            .await;
+        let fallback = project_key_label(&root_text);
+        save(
+            cx,
+            move |content| {
+                let projects = content
+                    .agent_sandbox
+                    .get_or_insert_default()
+                    .projects
+                    .get_or_insert_default();
+                let key = target_project_key(projects.keys(), &root_text, resolved.as_deref());
+                let label = project_key_label(&key);
+                projects.entry(key).or_default().enabled = Some(enabled);
+                label
+            },
+            fallback,
+        )
+        .await
+    })
+}
+
+/// Sets `agent_sandbox.enabled`, the switch for projects without their own setting, asking first
+/// when `enabled` is `false`. Resolves to `true` only when the file was saved.
+pub fn set_default_enabled(enabled: bool, window: &mut Window, cx: &mut App) -> Task<bool> {
+    let consent = if enabled {
+        Task::ready(true)
+    } else {
+        confirm_turn_off(OffScope::Default, window, cx)
+    };
+    cx.spawn(async move |cx| {
+        if !consent.await {
+            return false;
+        }
+        save(
+            cx,
+            move |content| {
+                content.agent_sandbox.get_or_insert_default().enabled = Some(enabled);
+                DEFAULT_KEY.to_string()
+            },
+            DEFAULT_KEY.to_string(),
+        )
+        .await
+    })
+}
+
+/// The `projects` key to write for `root`: a key in the file that names it lexically
+/// ([`lexical_match`]), else `resolved` (the key [`resolve_project_key`] found through a symlink)
+/// when the file still holds it, else `root` as spelled. Writing beside an existing key instead
+/// would hide its folders and hosts behind a second entry.
+pub fn target_project_key<'a>(
+    keys: impl IntoIterator<Item = &'a String>,
+    root: &str,
+    resolved: Option<&Path>,
+) -> String {
+    let keys: Vec<&'a String> = keys.into_iter().collect();
+    if let Some(key) = lexical_match(keys.iter().map(|key| key.as_str()), Path::new(root)) {
+        return key.to_string();
+    }
+    let resolved = resolved.and_then(Path::to_str);
+    if let Some(key) = keys.iter().find(|key| Some(key.as_str()) == resolved) {
+        return key.to_string();
+    }
+    root.to_string()
+}
+
+/// The text shown when a root that is not valid UTF-8 is refused.
+pub fn non_utf8_root_message(root: &Path) -> String {
+    format!(
+        "The agent sandbox cannot be configured for a project whose path is not valid UTF-8: {}",
+        root.to_string_lossy()
+    )
+}
+
+fn refuse_non_utf8_root(root: &Path, cx: &mut App) {
+    log::warn!(
+        "agent_sandbox event=settings_write_refused reason=non_utf8_root root={:?}",
+        root.to_string_lossy()
+    );
+    notify(non_utf8_root_message(root), cx);
+}
+
+fn project_key_label(key: &str) -> String {
+    format!("agent_sandbox.projects[{key}].enabled")
+}
+
+/// Writes the user settings file through `update`, which returns the key it wrote for the log.
+/// `true` only when the file was saved; a failure is logged and shown, never dropped.
+async fn save(
+    cx: &mut AsyncApp,
+    update: impl 'static + Send + FnOnce(&mut SettingsContent) -> String,
+    fallback_key: String,
+) -> bool {
+    let written_key = Arc::new(OnceLock::new());
+    let receiver = cx.update(|cx| {
+        let written_key = written_key.clone();
+        cx.global::<SettingsStore>()
+            .update_settings_file_with_completion(<dyn Fs>::global(cx), move |content, _| {
+                written_key.set(update(content)).ok();
+            })
+    });
+    let error = match receiver.await {
+        Ok(Ok(())) => return true,
+        Ok(Err(error)) => error,
+        Err(oneshot::Canceled) => anyhow::anyhow!("the settings writer stopped before saving"),
+    };
+    let key = written_key.get().cloned().unwrap_or(fallback_key);
+    log::error!("{}", write_failure_log_line(&key, &error));
+    let message = format!(
+        "Could not save the agent sandbox setting: {}",
+        first_line(&error)
+    );
+    cx.update(|cx| notify(message, cx));
+    false
+}
+
+/// One `key=value` line (Q14): the key and the error's first line, both quoted.
+fn write_failure_log_line(key: &str, error: &anyhow::Error) -> String {
+    let error = first_line(error);
+    format!("agent_sandbox event=settings_write_failed key={key:?} error={error:?}")
+}
+
+fn first_line(error: &anyhow::Error) -> String {
+    format!("{error:#}")
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .to_string()
+}
+
+/// A toast in every open workspace. The settings window is not a workspace, so this goes through
+/// the app-wide notifications.
+fn notify(message: String, cx: &mut App) {
+    struct AgentSandboxSettingsNotification;
+    show_app_notification(
+        NotificationId::unique::<AgentSandboxSettingsNotification>(),
+        cx,
+        move |cx| {
+            let message = message.clone();
+            cx.new(|cx| MessageNotification::new(message, cx))
+        },
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::RefCell;
+    use std::path::Path;
+    use std::rc::Rc;
+    use std::sync::Arc;
+
+    use fs::{FakeFs, Fs};
+    use gpui::{
+        App, AppContext as _, Context, Entity, EventEmitter, FocusHandle, Focusable, IntoElement,
+        PromptResponse, Render, TestAppContext, UpdateGlobal as _, VisualTestContext, Window, div,
+    };
+    use serde_json::{Value, json};
+    use settings::SettingsStore;
+
+    use super::{
+        FORGET_BUTTONS, TURN_OFF_BUTTONS, confirm_forget, non_utf8_root_message,
+        set_default_enabled, set_project_enabled, target_project_key, write_failure_log_line,
+    };
+    use crate::test_log_capture::LogCapture;
+
+    async fn init(user: Value, cx: &mut TestAppContext) -> Arc<FakeFs> {
+        let fs = FakeFs::new(cx.executor());
+        cx.update(|cx| {
+            let store = SettingsStore::test(cx);
+            cx.set_global(store);
+            <dyn Fs>::set_global(fs.clone(), cx);
+            crate::init(cx);
+        });
+        fs.create_dir(paths::config_dir())
+            .await
+            .expect("the config dir");
+        fs.insert_file(paths::settings_file(), user.to_string().into_bytes())
+            .await;
+        cx.update(|cx| {
+            SettingsStore::update_global(cx, |store, cx| {
+                store
+                    .set_user_settings(&user.to_string(), cx)
+                    .result()
+                    .expect("user settings parse");
+            })
+        });
+        cx.run_until_parked();
+        fs
+    }
+
+    async fn file_text(fs: &Arc<FakeFs>) -> String {
+        fs.load(paths::settings_file())
+            .await
+            .expect("settings file")
+    }
+
+    async fn projects(fs: &Arc<FakeFs>) -> serde_json::Map<String, Value> {
+        let file: Value =
+            serde_json_lenient::from_str(&file_text(fs).await).expect("settings JSON");
+        file["agent_sandbox"]["projects"]
+            .as_object()
+            .cloned()
+            .expect("a projects map")
+    }
+
+    /// A prompt that records its buttons and is answered by index, the way Zed's own prompt
+    /// answers Enter with its preselected first button.
+    struct ByIndex {
+        focus: FocusHandle,
+    }
+
+    impl EventEmitter<PromptResponse> for ByIndex {}
+
+    impl Focusable for ByIndex {
+        fn focus_handle(&self, _: &App) -> FocusHandle {
+            self.focus.clone()
+        }
+    }
+
+    impl Render for ByIndex {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+        }
+    }
+
+    #[derive(Default)]
+    struct Prompts {
+        buttons: Vec<Vec<String>>,
+        open: Option<Entity<ByIndex>>,
+    }
+
+    fn prompts_by_index(cx: &mut VisualTestContext) -> Rc<RefCell<Prompts>> {
+        let prompts = Rc::new(RefCell::new(Prompts::default()));
+        let shared = prompts.clone();
+        cx.update(|_, cx| {
+            cx.set_prompt_builder(move |_, _, _, buttons, handle, window, cx| {
+                let view = cx.new(|cx| ByIndex {
+                    focus: cx.focus_handle(),
+                });
+                let mut prompts = shared.borrow_mut();
+                prompts
+                    .buttons
+                    .push(buttons.iter().map(|b| b.label().to_string()).collect());
+                prompts.open = Some(view.clone());
+                handle.with_view(view, window, cx)
+            })
+        });
+        prompts
+    }
+
+    fn press(prompts: &Rc<RefCell<Prompts>>, index: usize, cx: &mut VisualTestContext) {
+        let view = prompts.borrow_mut().open.take().expect("an open prompt");
+        cx.update(|_, cx| view.update(cx, |_, cx| cx.emit(PromptResponse(index))));
+        cx.run_until_parked();
+    }
+
+    #[gpui::test]
+    async fn confirm_writer_updates_the_lexically_matching_key(cx: &mut TestAppContext) {
+        let fs = init(
+            json!({ "agent_sandbox": { "enabled": true, "projects": { "/w/app/": {
+                "enabled": false, "rw_maps": ["/w/cache"], "allow_hosts": ["example.org"]
+            } } } }),
+            cx,
+        )
+        .await;
+        let cx = cx.add_empty_window();
+        let task =
+            cx.update(|window, cx| set_project_enabled(Path::new("/w/app"), true, window, cx));
+        cx.run_until_parked();
+        assert!(task.await, "saved");
+        let projects = projects(&fs).await;
+        assert_eq!(
+            projects.keys().collect::<Vec<_>>(),
+            ["/w/app/"],
+            "no second key"
+        );
+        assert_eq!(
+            projects["/w/app/"],
+            json!({ "enabled": true, "rw_maps": ["/w/cache"], "allow_hosts": ["example.org"] }),
+            "only enabled changes"
+        );
+    }
+
+    #[gpui::test]
+    async fn confirm_writer_updates_the_key_a_symlinked_root_resolves_to(cx: &mut TestAppContext) {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = tmp.path().canonicalize().expect("canonical");
+        let real = base.join("real");
+        let link = base.join("link");
+        std::fs::create_dir(&real).expect("project");
+        std::os::unix::fs::symlink(&real, &link).expect("symlink");
+        let real_key = real.to_str().expect("utf-8 tempdir").to_string();
+        let fs = init(
+            json!({ "agent_sandbox": { "enabled": true, "projects": {
+                real_key.clone(): { "enabled": false, "rw_maps": ["/w/cache"] }
+            } } }),
+            cx,
+        )
+        .await;
+        let cx = cx.add_empty_window();
+        let task = cx.update(|window, cx| set_project_enabled(&link, true, window, cx));
+        cx.run_until_parked();
+        assert!(task.await, "saved");
+        let projects = projects(&fs).await;
+        assert_eq!(
+            projects.keys().collect::<Vec<_>>(),
+            [&real_key],
+            "the resolved key, not the link"
+        );
+        assert_eq!(
+            projects[&real_key],
+            json!({ "enabled": true, "rw_maps": ["/w/cache"] })
+        );
+    }
+
+    #[test]
+    fn confirm_target_key_falls_back_to_the_root_as_spelled() {
+        let keys = ["/w/other".to_string()];
+        assert_eq!(
+            target_project_key(&keys, "/w/app", Some(Path::new("/w/gone"))),
+            "/w/app",
+            "a resolved key the file no longer holds is not written"
+        );
+        assert_eq!(
+            target_project_key(&keys, "/w/app", Some(Path::new("/w/other"))),
+            "/w/other"
+        );
+    }
+
+    #[cfg(unix)]
+    #[gpui::test]
+    async fn confirm_refuses_a_non_utf8_root_before_asking(cx: &mut TestAppContext) {
+        use std::ffi::OsStr;
+        use std::os::unix::ffi::OsStrExt as _;
+
+        let fs = init(json!({ "agent_sandbox": { "enabled": true } }), cx).await;
+        let before = file_text(&fs).await;
+        let root = Path::new(OsStr::from_bytes(b"/w/\xffapp"));
+        let log = LogCapture::start();
+        let cx = cx.add_empty_window();
+        for enabled in [false, true] {
+            let task = cx.update(|window, cx| set_project_enabled(root, enabled, window, cx));
+            cx.run_until_parked();
+            assert!(!cx.has_pending_prompt(), "refused before asking");
+            assert!(!task.await, "nothing saved");
+        }
+        assert_eq!(file_text(&fs).await, before, "no write");
+        let refused = log.matching("event=settings_write_refused");
+        assert_eq!(refused.len(), 2, "{refused:?}");
+        assert!(
+            refused
+                .iter()
+                .all(|(level, line)| *level == log::Level::Warn
+                    && line.contains("reason=non_utf8_root")
+                    && line.contains("root=\"/w/\u{FFFD}app\""))
+        );
+        assert_eq!(
+            non_utf8_root_message(root),
+            "The agent sandbox cannot be configured for a project whose path is not valid UTF-8: \
+             /w/\u{FFFD}app"
+        );
+    }
+
+    #[gpui::test]
+    async fn confirm_the_first_button_never_turns_anything_off(cx: &mut TestAppContext) {
+        let fs = init(
+            json!({ "agent_sandbox": { "enabled": true, "projects": { "/w/app": { "enabled": true } } } }),
+            cx,
+        )
+        .await;
+        let before = file_text(&fs).await;
+        let cx = cx.add_empty_window();
+        let prompts = prompts_by_index(cx);
+
+        let task =
+            cx.update(|window, cx| set_project_enabled(Path::new("/w/app"), false, window, cx));
+        cx.run_until_parked();
+        press(&prompts, 0, cx);
+        assert!(!task.await, "project: the first button cancels");
+
+        let task = cx.update(|window, cx| set_default_enabled(false, window, cx));
+        cx.run_until_parked();
+        press(&prompts, 0, cx);
+        assert!(!task.await, "default: the first button cancels");
+
+        let task = cx.update(|window, cx| confirm_forget("gotchas/fs.md", window, cx));
+        cx.run_until_parked();
+        press(&prompts, 0, cx);
+        assert!(!task.await, "forget: the first button cancels");
+
+        assert_eq!(file_text(&fs).await, before, "nothing written");
+        assert_eq!(TURN_OFF_BUTTONS, ["Cancel", "Turn Off"]);
+        assert_eq!(FORGET_BUTTONS, ["Cancel", "Forget"]);
+        assert_eq!(
+            prompts.borrow().buttons,
+            [
+                vec!["Cancel", "Turn Off"],
+                vec!["Cancel", "Turn Off"],
+                vec!["Cancel", "Forget"]
+            ],
+            "the buttons the user saw, in order"
+        );
+
+        let task =
+            cx.update(|window, cx| set_project_enabled(Path::new("/w/app"), false, window, cx));
+        cx.run_until_parked();
+        press(&prompts, 1, cx);
+        assert!(task.await, "the second button turns it off");
+        assert_eq!(projects(&fs).await["/w/app"], json!({ "enabled": false }));
+    }
+
+    #[gpui::test]
+    async fn confirm_write_failure_logs_one_key_value_line(cx: &mut TestAppContext) {
+        let fs = init(json!({ "agent_sandbox": { "enabled": false } }), cx).await;
+        // A directory where the settings file should be: loading it fails.
+        fs.remove_file(paths::settings_file(), Default::default())
+            .await
+            .expect("remove the file");
+        fs.create_dir(paths::settings_file())
+            .await
+            .expect("a directory in its place");
+        let log = LogCapture::start();
+        let cx = cx.add_empty_window();
+        let task = cx.update(|window, cx| set_default_enabled(true, window, cx));
+        cx.run_until_parked();
+        assert!(!task.await, "a failed write is not reported as saved");
+        let failed = log.matching("event=settings_write_failed");
+        assert_eq!(failed.len(), 1, "{failed:?}");
+        let (level, line) = &failed[0];
+        assert_eq!(*level, log::Level::Error);
+        assert!(!line.contains('\n'), "one line: {line}");
+        assert!(
+            line.starts_with(
+                "agent_sandbox event=settings_write_failed key=\"agent_sandbox.enabled\" error=\""
+            ) && line.ends_with('"'),
+            "{line}"
+        );
+    }
+
+    #[test]
+    fn confirm_failure_line_quotes_the_key_and_keeps_the_first_error_line() {
+        let error = anyhow::anyhow!("disk full\nsecond line").context("Failed to write settings");
+        assert_eq!(
+            write_failure_log_line("agent_sandbox.projects[/w/my app].enabled", &error),
+            "agent_sandbox event=settings_write_failed \
