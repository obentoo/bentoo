+        json!({
+            "agent_servers": {
+                AGENT: { "type": "custom", "command": self.agent, "args": [] }
+            },
+            "agent_sandbox": {
+                "enabled": sandbox_on,
+                "ai_jail_path": ai_jail_path,
+                "claude_config_dir": self.base.join("claude-jailed"),
+            },
+            "agent_memory": { "enabled": false }
+        })
+    }
+}
+
+fn init(settings: Value, cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        agent_sandbox::init(cx);
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&settings.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        });
+    });
+}
+
+async fn start(
+    f: &Fixture,
+    cx: &mut TestAppContext,
+) -> (Entity<Project>, anyhow::Result<Rc<dyn AgentConnection>>) {
+    let project = Project::test(RealFs::new(None, cx.executor()), [f.root.as_path()], cx).await;
+    cx.run_until_parked();
+    let store = project.read_with(cx, |project, _| project.agent_server_store().clone());
+    let delegate = AgentServerDelegate::new(store, None, None);
+    let server = CustomAgentServer::new(AgentId::new(AGENT));
+    let connect = cx.update(|cx| server.connect(delegate, project.clone(), cx));
+    let timeout = cx.background_executor.timer(Duration::from_secs(10));
+    let result = futures::select! {
+        result = futures::FutureExt::fuse(connect) => result,
+        _ = futures::FutureExt::fuse(timeout) => panic!("timed out starting the agent"),
+    };
+    cx.run_until_parked();
+    (project, result)
+}
+
+fn record_reason(f: &Fixture, cx: &mut TestAppContext) -> Option<Reason> {
+    cx.update(|cx| LaunchRegistry::get(&AgentId::new(AGENT), &f.root, cx))
+        .map(|record| record.reason)
+}
+
+// agent_ui shows a failed start as `err.to_string()`, the outermost context only. A context
+// added around the refusal would show instead of it, and the fail-closed sentence (R1.9) and
+// the root would never reach the user.
+#[gpui::test]
+async fn sandbox_refusal_message_is_the_top_level_text(cx: &mut TestAppContext) {
+    let f = Fixture::new();
+    init(f.settings(true, &f.base.join("nowhere/ai-jail")), cx);
+    let (_project, result) = start(&f, cx).await;
+    let Err(error) = result else {
+        panic!("a start without ai-jail must be refused");
+    };
+    let shown = error.to_string();
+    assert!(shown.contains(FAIL_CLOSED), "shown text: {shown}");
+    assert!(
+        shown.contains(&f.root.display().to_string()),
+        "shown text names the root: {shown}"
+    );
+    assert_eq!(
+        record_reason(&f, cx),
+        None,
+        "a refused start registers nothing"
+    );
+}
+
+// The icon and the settings page read the registry; a record that outlives its agent would
+// show a jail state for an agent that no longer runs.
+#[gpui::test]
+async fn sandbox_launch_record_lives_as_long_as_the_connection(cx: &mut TestAppContext) {
+    let f = Fixture::new();
+    init(f.settings(false, &f.base.join("nowhere/ai-jail")), cx);
+    let (_project, result) = start(&f, cx).await;
+    let connection = result.expect("the scripted agent initializes");
+    assert_eq!(
+        record_reason(&f, cx),
+        Some(Reason::Off),
+        "registered while the connection lives"
+    );
+
+    drop(connection);
+    for _ in 0..50 {
+        cx.run_until_parked();
+        if record_reason(&f, cx).is_none() {
+            return;
+        }
+        cx.background_executor
+            .timer(Duration::from_millis(100))
+            .await;
+    }
+    panic!("the launch record outlived its connection");
+}
+
+// Q14: an agent id is user text; one with a space or '=' must not add a field to the line.
+#[test]
+fn sandbox_log_token_cannot_forge_a_field() {
+    assert_eq!(
+        crate::custom::log_token("my agent jailed=true\n\u{7}"),
+        "my_agent_jailed_true__"
+    );
+    assert_eq!(crate::custom::log_token(""), "_");
+    assert_eq!(
+        crate::custom::log_token("claude-agent-acp-plus"),
+        "claude-agent-acp-plus"
+    );
+}
+
+// Group-3 review F1, end to end: the ai-jail process gets only the configured names and Zeo's
+// base, never the test process's own environment (which stands in for a login shell's).
+#[gpui::test]
+async fn sandbox_jail_process_gets_only_the_configured_env_and_zeos_base(cx: &mut TestAppContext) {
+    let f = Fixture::new();
+    let ai_jail = f.base.join("bin/ai-jail");
+    std::fs::write(
+        &ai_jail,
+        format!(
+            "#!/bin/sh\nif [ \"$1\" = --version ]; then echo 'ai-jail 2.8.1'; exit 0; fi\n\
+             env > '{}/jail.env'\nprintf '%s\\n' \"$@\" > '{}/jail.args'\nexit 1\n",
+            f.base.display(),
+            f.base.display()
+        ),
+    )
+    .expect("write ai-jail");
+    std::fs::set_permissions(&ai_jail, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+    let mut settings = f.settings(true, &ai_jail);
+    settings["agent_servers"][AGENT]["env"] = json!({ "HOOK_SECRET": "hook-secret-value" });
+    init(settings, cx);
+    let (_project, result) = start(&f, cx).await;
+    assert!(result.is_err(), "the fake ai-jail exits");
+
+    let dump = std::fs::read_to_string(f.base.join("jail.env")).expect("ai-jail was spawned");
+    let env: Vec<(&str, &str)> = dump
+        .lines()
+        .filter_map(|line| line.split_once('='))
+        .collect();
+    // PWD, SHLVL and _ are set by the fake ai-jail's own /bin/sh; NO_PROXY / NO_BROWSER /
+    // ZEO_THREAD are what Zeo itself adds for every agent.
+    let allowed = [
+        "ZEO_THREAD",
+        "HOOK_SECRET",
+        "PATH",
+        "HOME",
+        "XDG_RUNTIME_DIR",
+        "LANG",
+        "PWD",
+        "OLDPWD",
+        "SHLVL",
+        "_",
+        "NO_PROXY",
+        "NO_BROWSER",
+    ];
+    for (name, _) in &env {
+        assert!(allowed.contains(name), "{name} reached ai-jail");
+    }
+    assert!(env.contains(&("HOOK_SECRET", "hook-secret-value")));
+    assert!(
+        env.contains(&("ZEO_THREAD", "1")),
+        "the jailed agent is marked as Zeo's"
+    );
+    // ai-jail clears the environment and passes on only the names given with `--env`, so the
+    // marker reaching ai-jail's process is not enough: it has to be on that list too.
+    let args = std::fs::read_to_string(f.base.join("jail.args")).expect("ai-jail args");
+    let args: Vec<&str> = args.lines().collect();
+    assert!(
+        args.windows(2)
+            .any(|pair| pair[0] == "--env" && pair[1] == "ZEO_THREAD"),
+        "ZEO_THREAD is forwarded into the jail: {args:?}"
+    );
+    let home = paths::home_dir().display().to_string();
+    assert!(env.contains(&("HOME", home.as_str())), "HOME is Zeo's");
+}
+
+// Story 050: Claude Code hooks inherit the agent's environment, and the tray's hook offers to
+// reopen a session only when it carries this marker. A session Zeo never owned has no thread to
+// open, so the marker is how the tray tells the two apart.
+#[gpui::test]
+async fn unjailed_agent_carries_the_zeo_thread_marker(cx: &mut TestAppContext) {
+    let f = Fixture::new();
