+mod agent_memory_section {
+    use super::*;
+
+    const STATUS: &str = r#"{"counts":{"pages_latest":69,"pages_all":169,"sessions":118,"observations":1,"evidence_rows":0},"scope":{"workspace":"default","project":"app","resolved_by":"explicit"}}"#;
+    const RECENT: &str = r#"{"hits":[{"id":"1","path":"sessions/a.md","title":"Session a","snippet":"s","rank":2.0},{"id":"2","path":"gotchas/b.md","title":"Gotcha b","snippet":"s","rank":1.0}]}"#;
+
+    #[derive(Clone, Copy)]
+    pub(super) enum Mode {
+        Ok,
+        Refused,
+        UnknownProject,
+    }
+
+    /// Installs a fake ai-memory as the app's HTTP client; returns the tool names called.
+    pub(super) fn fake_memory(
+        mode: Mode,
+        cx: &mut TestAppContext,
+    ) -> Arc<Mutex<Vec<(String, Value)>>> {
+        let calls: Arc<Mutex<Vec<(String, Value)>>> = Arc::default();
+        let client = http_client::FakeHttpClient::create({
+            let calls = calls.clone();
+            move |request| {
+                let calls = calls.clone();
+                async move {
+                    if matches!(mode, Mode::Refused) {
+                        anyhow::bail!("Connection refused (os error 111)");
+                    }
+                    let mut text = String::new();
+                    request.into_body().read_to_string(&mut text).await?;
+                    let message: Value = serde_json::from_str(&text).unwrap_or(Value::Null);
+                    let id = message["id"].clone();
+                    let body = match message["method"].as_str().unwrap_or_default() {
+                        "initialize" => json!({ "jsonrpc": "2.0", "id": id, "result": {
+                            "protocolVersion": message["params"]["protocolVersion"],
+                            "capabilities": { "tools": {} },
+                            "serverInfo": { "name": "ai-memory", "version": "2.6.2" } } }),
+                        "tools/call" => {
+                            let tool = message["params"]["name"]
+                                .as_str()
+                                .unwrap_or_default()
+                                .to_string();
+                            calls
+                                .lock()
+                                .push((tool.clone(), message["params"]["arguments"].clone()));
+                            match (mode, tool.as_str()) {
+                                (Mode::UnknownProject, _) => {
+                                    json!({ "jsonrpc": "2.0", "id": id, "error": {
+                                    "code": -32602, "message": "project 'app' not found in workspace 'default'" } })
+                                }
+                                (_, "memory_status") => {
+                                    json!({ "jsonrpc": "2.0", "id": id, "result": {
+                                    "content": [{ "type": "text", "text": STATUS }] } })
+                                }
+                                (_, "memory_recent") => {
+                                    json!({ "jsonrpc": "2.0", "id": id, "result": {
+                                    "content": [{ "type": "text", "text": RECENT }] } })
+                                }
+                                _ => json!({ "jsonrpc": "2.0", "id": id, "result": {
+                                    "content": [{ "type": "text", "text": "{\"deleted\":true}" }] } }),
+                            }
+                        }
+                        _ => {
+                            return Ok(Response::builder()
+                                .status(202)
+                                .body(AsyncBody::default())
+                                .expect("202"));
+                        }
+                    };
+                    Ok(Response::builder()
+                        .status(200)
+                        .header("Content-Type", "application/json")
+                        .body(AsyncBody::from(body.to_string().into_bytes()))
+                        .expect("200"))
+                }
+            }
+        });
+        cx.update(|cx| cx.set_http_client(client as Arc<dyn HttpClient>));
+        calls
+    }
+
+    fn tools(calls: &Arc<Mutex<Vec<(String, Value)>>>) -> Vec<String> {
+        calls.lock().iter().map(|(tool, _)| tool.clone()).collect()
+    }
+
+    fn open_section(
+        cx: &mut TestAppContext,
+    ) -> (gpui::Entity<AgentMemorySection>, &mut VisualTestContext) {
+        let vcx = cx.add_empty_window();
+        let section = vcx.new_window_entity(|window, cx| {
+            AgentMemorySection::new(Some(PathBuf::from(ROOT)), window, cx)
+        });
+        vcx.run_until_parked();
+        (section, vcx)
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_off_makes_no_call(cx: &mut TestAppContext) {
+        init(json!({ "agent_memory": { "enabled": false } }), cx).await;
+        let calls = fake_memory(Mode::Ok, cx);
+        let (section, vcx) = open_section(cx);
+        section.update(vcx, |section, cx| section.refresh(cx));
+        vcx.run_until_parked();
+        assert!(
+            tools(&calls).is_empty(),
+            "memory off: Zeo stops calling ai-memory (R6.2)"
+        );
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_cancelled_forget_sends_nothing(cx: &mut TestAppContext) {
+        init(json!({ "agent_memory": { "enabled": true } }), cx).await;
+        let calls = fake_memory(Mode::Ok, cx);
+        let (section, vcx) = open_section(cx);
+        let before = tools(&calls).len();
+        section.update_in(vcx, |section, window, cx| {
+            section.forget("gotchas/b.md", window, cx)
+        });
+        vcx.run_until_parked();
+        let (message, detail) = vcx.pending_prompt().expect("the R6.4 confirmation");
+        assert_eq!(message, "Forget gotchas/b.md?");
+        assert_eq!(detail, "ai-memory deletes the page. This cannot be undone.");
+        vcx.simulate_prompt_answer("Cancel");
+        vcx.run_until_parked();
+        assert_eq!(tools(&calls).len(), before, "Cancel sends nothing");
+        assert!(!tools(&calls).contains(&"memory_delete_page".to_string()));
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_unreachable_is_shown_and_not_retried(cx: &mut TestAppContext) {
+        init(json!({ "agent_memory": { "enabled": true, "endpoint": "http://127.0.0.1:49374/mcp" } }), cx).await;
+        let _calls = fake_memory(Mode::Refused, cx);
+        let (section, vcx) = open_section(cx);
+        let error = section.read_with(vcx, |section, _| section.error_line());
+        assert_eq!(
+            error.as_deref(),
+            Some("ai-memory is not reachable at http://127.0.0.1:49374/mcp")
+        );
+        vcx.executor().advance_clock(Duration::from_secs(120));
+        vcx.run_until_parked();
+        assert_eq!(
+            section
+                .read_with(vcx, |section, _| section.error_line())
+                .as_deref(),
+            Some("ai-memory is not reachable at http://127.0.0.1:49374/mcp"),
+            "unchanged until Refresh"
+        );
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_unknown_project_text(cx: &mut TestAppContext) {
+        init(json!({ "agent_memory": { "enabled": true } }), cx).await;
+        let _calls = fake_memory(Mode::UnknownProject, cx);
+        let (section, vcx) = open_section(cx);
+        assert_eq!(
+            section
+                .read_with(vcx, |section, _| section.error_line())
+                .as_deref(),
+            Some("No memory recorded for default/app yet.")
+        );
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_lists_pages_and_forget_deletes_then_refreshes(
+        cx: &mut TestAppContext,
+    ) {
+        init(json!({ "agent_memory": { "enabled": true } }), cx).await;
+        let calls = fake_memory(Mode::Ok, cx);
+        let (section, vcx) = open_section(cx);
+        assert_eq!(
+            tools(&calls),
+            vec!["memory_status", "memory_recent"],
+            "once on open"
+        );
+        section.read_with(vcx, |section, _| {
+            let status = section.status_line().expect("status shown");
+            for needle in [
+                "2.6.2",
+                "http://127.0.0.1:49374/mcp",
+                "default",
+                "app",
+                "69",
+                "118",
+            ] {
+                assert!(status.contains(needle), "{needle} in {status}");
+            }
+            let pages: Vec<(&str, &str)> = section
+                .pages()
+                .iter()
+                .map(|page| (page.title.as_str(), page.path.as_str()))
+                .collect();
+            assert_eq!(
+                pages,
+                vec![("Session a", "sessions/a.md"), ("Gotcha b", "gotchas/b.md")]
+            );
+        });
+        let recent_args = calls
+            .lock()
+            .iter()
+            .find(|(tool, _)| tool == "memory_recent")
+            .map(|(_, a)| a.clone());
+        assert_eq!(recent_args.expect("recent")["limit"], json!(10));
+
+        section.update_in(vcx, |section, window, cx| {
+            section.forget("gotchas/b.md", window, cx)
+        });
+        vcx.run_until_parked();
+        vcx.simulate_prompt_answer("Forget");
+        vcx.run_until_parked();
+        let after = tools(&calls);
+        let delete_at = after
+            .iter()
+            .position(|tool| tool == "memory_delete_page")
+            .expect("delete sent after Forget");
+        assert_eq!(
+            after
+                .iter()
+                .filter(|tool| *tool == "memory_delete_page")
+                .count(),
+            1
+        );
+        assert!(
+            after[delete_at + 1..].contains(&"memory_recent".to_string()),
+            "the list refreshes after the delete: {after:?}"
+        );
+        let delete_args = calls.lock()[delete_at].1.clone();
+        assert_eq!(
+            delete_args,
+            json!({ "path": "gotchas/b.md", "workspace": "default", "project": "app" })
+        );
+    }
+
+    #[gpui::test]
+    async fn agent_memory_section_non_loopback_endpoint_note(cx: &mut TestAppContext) {
