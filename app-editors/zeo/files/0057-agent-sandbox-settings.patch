+// Story 043, task 3.2 — what the spawn hook leaves behind: the text a refused start shows, and
+// how long a start's launch record lives (R1.9, R5, review M1). Added after tech review; the
+// launch line and the spawn shapes are `sandbox_hook_tests`.
+//
+// Behaviour-level: real processes on the real filesystem. The agent is a shell script named
+// like the Plus adapter (R1.13) that answers ACP `initialize` and then waits on stdin, so the
+// connection stays up until it is dropped.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::time::Duration;
+
+use acp_thread::AgentConnection;
+use agent_client_protocol::schema::{ProtocolVersion, v1 as acp};
