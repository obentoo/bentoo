+    // A non-UTF-8 root has no key that could name it: refused, nothing written.
+    #[gpui::test]
+    async fn agent_jail_page_non_utf8_root_is_refused(cx: &mut TestAppContext) {
+        let fs = init(json!({ "agent_sandbox": { "enabled": true } }), cx).await;
+        let before = file_text(&fs).await;
+        let root = PathBuf::from(OsStr::from_bytes(b"/w/\xffapp"));
+        let expected = agent_sandbox::confirm::non_utf8_root_message(&root);
+        let task = cx.update(|cx| add_entry(EntryKind::AllowHost, &root, "registry.npmjs.org", cx));
+        cx.run_until_parked();
+        assert_eq!(task.await, Err(expected.clone()));
+        let task =
+            cx.update(|cx| remove_entry(EntryKind::AllowHost, &root, "registry.npmjs.org", cx));
+        cx.run_until_parked();
+        assert_eq!(task.await, Err(expected));
+        assert_eq!(file_text(&fs).await, before);
