diff --git a/crates/agent_ui/src/agent_sandbox_actions.rs b/crates/agent_ui/src/agent_sandbox_actions.rs
new file mode 100644
index 0000000..51b1d6b
--- /dev/null
+++ b/crates/agent_ui/src/agent_sandbox_actions.rs
@@ -0,0 +1,213 @@
+//! The palette commands of the agent sandbox and of ai-memory (R8.1–R8.4).
+
+use std::path::PathBuf;
+
+use agent_sandbox::memory::{self, MemoryClient, MemoryError, MemoryStatus, display_endpoint};
+use agent_sandbox::{
+    AgentMemorySettings, AgentSandboxSettings, confirm, launch, resolve_project_key,
+};
+use gpui::{App, AppContext as _, Context, TaskExt as _, Window, actions};
+use settings::Settings as _;
+use workspace::notifications::NotificationId;
+use workspace::{Toast, Workspace};
+
+actions!(
+    agent_sandbox,
+    [
+        /// Turns the agent sandbox on for the active project, or off after a confirmation.
+        Toggle,
+    ]
+);
+
+actions!(
+    agent_memory,
+    [
+        /// Shows whether ai-memory is reachable, and the active project's scope and page count.
+        Status,
+        /// Opens the ai-memory settings of the active project.
+        OpenProjectMemory,
+    ]
+);
+
+/// The id of the `agent sandbox: toggle` notification.
+pub(crate) struct SandboxToggleToast;
+/// The id of the `agent memory: status` notification; a new status replaces the last one.
+pub(crate) struct MemoryStatusToast;
+
+/// The R8.2 text.
+pub(crate) const NO_LOCAL_PROJECT: &str = "Open a local project to configure the agent sandbox.";
+pub(crate) const MEMORY_OFF: &str = "Memory is off.";
+const MEMORY_NO_PROJECT: &str = "Open a local project to see its memory.";
+const MEMORY_INVALID_ENDPOINT: &str =
+    "The ai-memory endpoint in agent_memory.endpoint is not a valid URL.";
+/// The settings sub-page "Agent Memory (ai-memory)" (7.1).
+const MEMORY_SETTINGS_PATH: &str = "agent_memory";
+
+pub(crate) fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _window, _cx| {
+        workspace
+            .register_action(toggle)
+            .register_action(status)
+            .register_action(|_workspace, _: &OpenProjectMemory, window, cx| {
+                window.dispatch_action(
+                    Box::new(zed_actions::OpenSettingsAt {
+                        path: MEMORY_SETTINGS_PATH.into(),
+                        target: None,
+                    }),
+                    cx,
+                );
+            });
+    })
+    .detach();
+}
+
+/// The root an agent of the active project starts in, unless the project is remote: neither the
+/// sandbox nor ai-memory's scope applies there.
+fn local_root(workspace: &Workspace, cx: &App) -> Option<PathBuf> {
+    let project = workspace.project();
+    if !project.read(cx).is_local() {
+        return None;
+    }
+    launch::project_root(project, cx)
+}
+
+fn toggle(workspace: &mut Workspace, _: &Toggle, window: &mut Window, cx: &mut Context<Workspace>) {
+    let Some(root) = local_root(workspace, cx) else {
+        workspace.show_toast(
+            Toast::new(
+                NotificationId::unique::<SandboxToggleToast>(),
+                NO_LOCAL_PROJECT,
+            ),
+            cx,
+        );
+        return;
+    };
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    cx.spawn_in(window, async move |_workspace, cx| {
+        // The same key the settings page shows: lexical first, then through a symlink, which
+        // canonicalizes and so blocks.
+        let enabled = cx
+            .background_spawn({
+                let root = root.clone();
+                async move {
+                    let key = resolve_project_key(sandbox.project_keys(), &root);
+                    sandbox.policy_for_key(key).enabled
+                }
+            })
+            .await;
+        // `set_project_enabled` confirms before turning the jail off and reports its own errors.
+        let saved = cx
+            .update(|window, cx| confirm::set_project_enabled(&root, !enabled, window, cx))?
+            .await;
+        log::info!(
+            "agent_sandbox event=palette_toggle enabled={} saved={saved}",
+            !enabled
+        );
+        anyhow::Ok(())
+    })
+    .detach_and_log_err(cx);
+}
+
+fn status(workspace: &mut Workspace, _: &Status, window: &mut Window, cx: &mut Context<Workspace>) {
+    let memory_settings = AgentMemorySettings::get_global(cx).clone();
+    if !memory_settings.enabled {
+        show_memory_status(workspace, MEMORY_OFF.to_string(), cx);
+        return;
+    }
+    let Some(root) = local_root(workspace, cx) else {
+        show_memory_status(workspace, MEMORY_NO_PROJECT.to_string(), cx);
+        return;
+    };
+    let scope = memory::resolve_project_scope(&root, workspace.project(), cx);
+    let http_client = cx.http_client();
+    cx.spawn_in(window, async move |workspace, cx| {
+        let scope = scope.await;
+        let text = match url::Url::parse(&memory_settings.endpoint) {
+            Err(_) => MEMORY_INVALID_ENDPOINT.to_string(),
+            Ok(endpoint) => {
+                let auth_token = std::env::var("AI_MEMORY_AUTH_TOKEN").ok();
+                match MemoryClient::new(endpoint, auth_token, http_client, cx) {
+                    Err(error) => first_line(&error),
+                    Ok(client) => status_text(&client.status(&scope).await),
+                }
+            }
+        };
+        workspace.update(cx, |workspace, cx| show_memory_status(workspace, text, cx))
+    })
+    .detach_and_log_err(cx);
+}
+
+/// The `agent memory: status` text (R8.3): the reachability, the scope and its page count, or
+/// the R6.6/R6.8 message.
+pub(crate) fn status_text(result: &Result<MemoryStatus, MemoryError>) -> String {
+    match result {
+        Ok(status) => format!(
+            "ai-memory {} is reachable at {} · {}: {} pages",
+            status.server_version,
+            display_endpoint(&status.endpoint),
+            status.scope,
+            status.pages
+        ),
+        Err(error) => error.to_string(),
+    }
+}
+
+fn show_memory_status(workspace: &mut Workspace, text: String, cx: &mut Context<Workspace>) {
+    workspace.show_toast(
+        Toast::new(NotificationId::unique::<MemoryStatusToast>(), text),
+        cx,
+    );
+}
+
+fn first_line(error: &anyhow::Error) -> String {
+    format!("{error:#}")
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .to_string()
+}
+
+#[cfg(test)]
+mod status_text_tests {
+    use super::*;
+    use agent_sandbox::memory::{MemoryScope, ResolvedBy};
+
+    fn scope() -> MemoryScope {
+        MemoryScope {
+            workspace: "zeo-workspace".into(),
+            project: "zed".into(),
+            resolved_by: ResolvedBy::Marker,
+        }
+    }
+
+    #[test]
+    fn agent_sandbox_actions_status_text_names_reachability_scope_and_pages() {
+        let status = MemoryStatus {
+            server_version: "2.6.3".into(),
+            endpoint: url::Url::parse("http://127.0.0.1:49374/mcp").expect("url"),
+            scope: scope(),
+            pages: 77,
+            sessions: 129,
+        };
+        assert_eq!(
+            status_text(&Ok(status)),
+            "ai-memory 2.6.3 is reachable at http://127.0.0.1:49374/mcp · zeo-workspace/zed: 77 pages"
+        );
+    }
+
+    #[test]
+    fn agent_sandbox_actions_status_text_shows_the_r6_messages() {
+        let unreachable = MemoryError::Unreachable {
+            endpoint: "http://127.0.0.1:49374/mcp".into(),
+        };
+        assert_eq!(
+            status_text(&Err(unreachable)),
+            "ai-memory is not reachable at http://127.0.0.1:49374/mcp"
+        );
+        let unknown = MemoryError::UnknownProject { scope: scope() };
+        assert_eq!(
+            status_text(&Err(unknown)),
+            "No memory recorded for zeo-workspace/zed yet."
+        );
+    }
+}
