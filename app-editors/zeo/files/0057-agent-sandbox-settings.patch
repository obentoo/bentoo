+    result.expect("the scripted agent initializes");
+
+    let dump = std::fs::read_to_string(&dump).expect("the agent was spawned");
+    let env: Vec<(&str, &str)> = dump
+        .lines()
+        .filter_map(|line| line.split_once('='))
+        .collect();
+    // Names only: the agent inherits the test process's environment, which can hold tokens.
+    let names: Vec<&str> = env.iter().map(|(name, _)| *name).collect();
+    assert!(
+        env.contains(&("ZEO_THREAD", "1")),
+        "agent env names: {names:?}"
+    );
+    assert!(
+        env.contains(&("HOOK_SECRET", "hook-secret-value")),
+        "the entry's own env still arrives beside the marker"
+    );
+}
