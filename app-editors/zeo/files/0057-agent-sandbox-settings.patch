+            requests.load(Ordering::SeqCst),
+            0,
+            "memory off calls nothing"
+        );
+        let ids = win
+            .workspace
+            .read_with(&win.cx, |w, _| w.notification_ids());
+        assert_eq!(ids.len(), notifications_before + 1);
+        assert!(
+            ids.contains(&workspace::notifications::NotificationId::unique::<
+                MemoryStatusToast,
+            >()),
+            "the status notification is the one shown"
+        );
+        assert_eq!(MEMORY_OFF, "Memory is off.");
+    }
+
+    // Toggle, wrongly SPLIT: a project opened through a symlink whose key is the canonical
+    // path reads and writes THAT key — it asks before turning off, and adds no second key.
+    #[gpui::test]
+    async fn agent_sandbox_actions_toggle_through_a_symlink_uses_the_canonical_key(
+        cx: &mut TestAppContext,
+    ) {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let base = tmp.path().canonicalize().expect("canonical");
+        let real = base.join("app");
+        let link = base.join("link");
+        std::fs::create_dir(&real).expect("project dir");
+        std::os::unix::fs::symlink(&real, &link).expect("symlink");
+        let real_key = real.to_str().expect("utf-8").to_string();
+        let link_root = link.to_str().expect("utf-8").to_string();
+
+        let fs = init(cx);
+        user_settings(
+            &fs,
+            json!({ "agent_sandbox": { "projects": {
+                real_key.clone(): { "enabled": true, "rw_maps": ["/data/cache"] }
+            } } }),
+            cx,
+        )
+        .await;
+        let mut win = workspace_window(&fs, &[link_root.as_str()], cx).await;
+        win.cx.dispatch_action(Toggle);
+        win.cx.run_until_parked();
+        let (message, _) = win
+            .cx
+            .pending_prompt()
+            .expect("the canonical key is on, so the toggle turns it off and asks");
+        assert!(
+            message.starts_with("Turn off the agent sandbox for "),
+            "{message}"
+        );
+        win.cx.simulate_prompt_answer("Turn Off");
+        win.cx.run_until_parked();
+        let written: serde_json::Value =
+            serde_json_lenient::from_str(&fs.load(paths::settings_file()).await.expect("file"))
+                .expect("json");
+        let projects = written["agent_sandbox"]["projects"]
+            .as_object()
+            .expect("projects");
+        assert_eq!(
+            projects.keys().cloned().collect::<Vec<_>>(),
+            vec![real_key.clone()],
+            "no second key for the symlink spelling"
+        );
+        assert_eq!(projects[&real_key]["enabled"], json!(false));
+        assert_eq!(projects[&real_key]["rw_maps"], json!(["/data/cache"]));
+    }
+}
