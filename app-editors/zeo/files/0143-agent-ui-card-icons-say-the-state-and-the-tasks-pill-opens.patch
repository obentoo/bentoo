+++ b/crates/agent_ui/src/tasks_card/pill_expand_tests.rs
@@ -0,0 +1,54 @@
+// Zeo proposal §6.67 (ask 93): the minimized tasks card ends in a Maximize icon -- the inverse of
+// the Minimize that made it -- after its count. The pill was icon and count only, so nothing on
+// screen said that a click opens it. Filter: `tasks_card::pill_expand`.
+
+use gpui::{Modifiers, TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+#[gpui::test]
+async fn the_pill_ends_in_an_expand_icon_and_still_opens_the_card(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card-pill-expand").is_none(),
+        "the expanded card shows no pill icon"
+    );
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| card.toggle_minimized(cx));
+    draw(&mut cx);
+    let pill = cx
+        .debug_bounds("tasks-card-pill")
+        .expect("the pill is painted");
+    let expand = cx
+        .debug_bounds("tasks-card-pill-expand")
+        .expect("the pill shows an expand icon");
+    let spinner = cx
+        .debug_bounds("tasks-card-pill-spinner")
+        .expect("a running task spins in the pill");
+    assert!(
+        expand.left() > spinner.right(),
+        "the expand icon {expand:?} trails the spinner and the count {spinner:?}"
+    );
+    assert!(
+        pill.left() <= expand.left() && expand.right() <= pill.right(),
+        "the icon {expand:?} sits inside the pill {pill:?}"
+    );
+
+    // The whole pill is still the click target: a click on the icon opens the card.
+    cx.simulate_click(expand.center(), Modifiers::none());
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card").is_some(),
+        "clicking the expand icon opens the card"
+    );
+}
