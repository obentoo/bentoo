-/// The state a click on the header steps to: collapsed, minimized, maximized, and round again. A
-/// card with no content has nothing to maximize, so it steps between the first two.
-pub(crate) fn next_display(current: ToolCardDisplay, has_content: bool) -> ToolCardDisplay {
+/// One button in a card's header: its icon, its tooltip and the state it moves the card to.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct HeaderControl {
+    pub icon: IconName,
+    pub tooltip: &'static str,
+    pub target: ToolCardDisplay,
+}
+
+/// The header's buttons for a card in `current` (§6.67, ask 90): the primary one, and the
+/// fold-to-one-line one where there is something to fold. The primary one opens a card one
+/// step, and from maximized goes back to minimized; collapsing is the fold's, so the steps are
+/// no longer a ring. A card with no content has nothing to maximize: minimized, it only folds. The icons are the pinned message's
+/// pair, `ExpandVertical` and its inside-out `FoldVertical`, with a chevron between them for the
+/// content: before, collapsed and minimized showed the same `ChevronDown`, which is also the tasks
+/// card's "Move to Bottom", so a card's state could not be read from its icon.
+pub(crate) fn header_controls(
+    current: ToolCardDisplay,
+    has_content: bool,
+) -> (HeaderControl, Option<HeaderControl>) {
+    let fold = HeaderControl {
+        icon: IconName::FoldVertical,
+        tooltip: "Collapse to One Line",
+        target: ToolCardDisplay::Collapsed,
+    };
     match current {
-        ToolCardDisplay::Collapsed => ToolCardDisplay::Minimized,
-        ToolCardDisplay::Minimized if has_content => ToolCardDisplay::Maximized,
-        ToolCardDisplay::Minimized | ToolCardDisplay::Maximized => ToolCardDisplay::Collapsed,
+        ToolCardDisplay::Collapsed => (
+            HeaderControl {
+                icon: IconName::ExpandVertical,
+                tooltip: "Show in Full",
+                target: ToolCardDisplay::Minimized,
+            },
+            None,
+        ),
+        ToolCardDisplay::Minimized if has_content => (
+            HeaderControl {
+                icon: IconName::ChevronDown,
+                tooltip: "Show Output",
+                target: ToolCardDisplay::Maximized,
+            },
+            Some(fold),
+        ),
+        ToolCardDisplay::Minimized => (fold, None),
+        ToolCardDisplay::Maximized => (
+            HeaderControl {
+                icon: IconName::ChevronUp,
+                tooltip: "Hide Output",
+                target: ToolCardDisplay::Minimized,
+            },
+            Some(fold),
+        ),
     }
 }
 
