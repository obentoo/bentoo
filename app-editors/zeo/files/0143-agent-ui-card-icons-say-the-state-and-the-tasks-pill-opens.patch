+    assert_eq!(collapse, None, "a collapsed card has nothing to fold");
+
+    let (primary, collapse) = header_controls(Minimized, true);
+    assert_eq!(
+        (primary.icon, primary.target),
+        (IconName::ChevronDown, Maximized)
+    );
+    let collapse = collapse.expect("a minimized card folds back to one line");
+    assert_eq!(
+        (collapse.icon, collapse.target),
+        (IconName::FoldVertical, Collapsed)
+    );
+
+    let (primary, collapse) = header_controls(Maximized, true);
+    assert_eq!(
+        (primary.icon, primary.target),
+        (IconName::ChevronUp, Minimized)
+    );
+    let collapse = collapse.expect("a maximized card folds back to one line");
+    assert_eq!(
+        (collapse.icon, collapse.target),
+        (IconName::FoldVertical, Collapsed)
+    );
+}
+
+/// Hostile: a card with nothing to maximize offers no chevron, only the fold.
+#[test]
+fn a_card_without_content_has_no_chevron() {
+    use ui::IconName;
+    let (primary, collapse) = header_controls(Minimized, false);
+    assert_eq!(
+        (primary.icon, primary.target),
+        (IconName::FoldVertical, Collapsed)
+    );
+    assert_eq!(collapse, None);
+    for display in DISPLAYS {
+        let (primary, collapse) = header_controls(display, false);
+        assert_ne!(
+            primary.target, Maximized,
+            "{display:?} offers to maximize nothing"
+        );
+        assert!(collapse.is_none_or(|control| control.target != Maximized));
+    }
+}
