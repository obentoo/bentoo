+use workspace::notifications::NotificationId;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::AgentPanel;
+use crate::devtools_delivery::{
+    AddedInBackground, DeliveryError, DeliveryOutcome, DevtoolsSelection, FailInsertion,
+    ImageState, InsertionFailed, deliver_devtools_selection,
+};
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(
+        "/p",
+        json!({ "app": { "src": { "a.tsx": "line 1\nline 2\nline 3\n" } } }),
+    )
+    .await;
+    fs.insert_tree("/q/other", json!({ "file.txt": "" })).await;
+    fs
+}
+
+struct Win {
+    workspace: Entity<Workspace>,
+    panel: Entity<AgentPanel>,
+    cx: VisualTestContext,
+}
+
+/// A window over `root` with an agent panel that was never shown and holds nothing.
+async fn window_with_panel(fs: &Arc<FakeFs>, root: &str, cx: &mut TestAppContext) -> Win {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window: WindowHandle<MultiWorkspace> =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    Win {
+        workspace,
+        panel,
+        cx: vcx,
+    }
+}
+
+/// A window over `root` whose agent panel shows a thread on a stub agent.
+async fn window_with_thread(fs: &Arc<FakeFs>, root: &str, cx: &mut TestAppContext) -> Win {
+    let mut win = window_with_panel(fs, root, cx).await;
+    crate::test_support::open_thread_with_connection(
+        &win.panel,
+        StubAgentConnection::new(),
+        &mut win.cx,
+    );
+    win
+}
+
+/// An agent whose connection waits for `gate` (`Ok`), or fails (`Err`).
+struct TestServer {
+    connect: Result<Shared<oneshot::Receiver<()>>, String>,
+}
+
+impl AgentServer for TestServer {
+    fn logo(&self) -> ui::IconName {
+        ui::IconName::ZedAgent
+    }
+
+    fn agent_id(&self) -> AgentId {
+        "devtools-test".into()
+    }
+
+    fn connect(
+        &self,
+        _delegate: AgentServerDelegate,
+        _project: Entity<Project>,
+        cx: &mut App,
+    ) -> Task<anyhow::Result<Rc<dyn AgentConnection>>> {
+        match self.connect.clone() {
+            Ok(gate) => cx.spawn(async move |_| {
+                gate.await.ok();
+                Ok(Rc::new(StubAgentConnection::new()) as Rc<dyn AgentConnection>)
+            }),
+            Err(reason) => Task::ready(Err(anyhow!(reason))),
+        }
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+fn open_with_server(win: &mut Win, server: TestServer) {
+    win.panel.update_in(&mut win.cx, |panel, window, cx| {
+        panel.open_external_thread_with_server(Rc::new(server), window, cx)
+    });
+    win.cx.run_until_parked();
+}
+
+async fn deliver(
+    req: DevtoolsSelection,
+    via: &Win,
+    cx: &mut TestAppContext,
+) -> (
+    Result<DeliveryOutcome, DeliveryError>,
+    Task<anyhow::Result<()>>,
+) {
+    let app_state = via
+        .workspace
+        .read_with(cx, |workspace, _| workspace.app_state().clone());
+    let (answer_tx, answer_rx) = oneshot::channel();
+    let task = cx.update(|cx| deliver_devtools_selection(req, app_state, answer_tx, cx));
+    cx.run_until_parked();
+    let answer = answer_rx.await.expect("delivery always sends an answer");
+    (answer, task)
+}
+
+fn notifications(win: &Win, id: NotificationId) -> usize {
+    win.workspace.read_with(&win.cx, |workspace, _| {
+        workspace
+            .notification_ids()
+            .into_iter()
+            .filter(|shown| *shown == id)
+            .count()
+    })
+}
+
+fn composer_focused(win: &mut Win) -> bool {
+    let Some(editor) = win.panel.read_with(&win.cx, |panel, cx| {
+        panel
+            .active_thread_view(cx)
+            .map(|view| view.read(cx).message_editor.clone())
+    }) else {
+        return false;
+    };
+    win.cx
+        .update(|window, cx| editor.read(cx).focus_handle(cx).is_focused(window))
+}
+
+fn selection(screenshot: bool) -> DevtoolsSelection {
+    let screenshot = if screenshot {
+        json!({
+            "mime": "image/png",
+            "data_b64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==",
+            "w": 1,
+            "h": 1
+        })
+    } else {
+        serde_json::Value::Null
+    };
+    serde_json::from_value(json!({
+        "v": 1,
+        "project_root": "/p/app",
+        "page_url": "http://localhost:5173/",
+        "items": [{
+            "src": { "file": "/p/app/src/a.tsx", "line": 2, "column": 1, "end_line": 2 },
+            "component": "Row",
+            "dom": {
+                "tag": "li", "id": null, "classes": [], "text": "Save", "attrs": {},
+                "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+            }
+        }],
+        "screenshot": screenshot
+    }))
+    .expect("DevtoolsSelection deserializes from the wire request")
+}
+
+fn insertion_failures(win: &Win) -> usize {
+    notifications(win, InsertionFailed::id())
+}
+
+fn composer_text(win: &Win) -> String {
+    win.panel.read_with(&win.cx, |panel, cx| {
+        let view = panel
+            .active_thread_view(cx)
+            .expect("precondition: an active thread");
+        view.read(cx).message_editor.read(cx).text(cx)
+    })
+}
+
+mod insert {
+    use super::*;
+
+    // R9.11: the answer already said "inserted", so the failure surfaces in the target window,
+    // not in the window the request happened to be handled from, and the task returns it.
+    #[gpui::test]
+    async fn insert_failure_after_the_answer_notifies_the_target_window(cx: &mut TestAppContext) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let target = window_with_thread(&fs, "/p/app", cx).await;
+        let mut other = window_with_thread(&fs, "/q/other", cx).await;
+        other.cx.update(|window, _| window.activate_window());
+        other.cx.run_until_parked();
+        assert_eq!(insertion_failures(&target), 0, "precondition");
+        cx.update(|cx| cx.set_global(FailInsertion("the composer refused the mention".into())));
+
+        let app_state = other
+            .workspace
+            .read_with(cx, |workspace, _| workspace.app_state().clone());
+        let (answer_tx, answer_rx) = futures::channel::oneshot::channel();
+        let task =
+            cx.update(|cx| deliver_devtools_selection(selection(true), app_state, answer_tx, cx));
+        cx.run_until_parked();
+        let answer = answer_rx
+            .await
+            .expect("delivery always sends an answer")
+            .expect("the answer went out before the failure");
+        let result = task.await;
+        cx.run_until_parked();
+
+        assert_eq!(
+            answer,
+            DeliveryOutcome::Inserted {
+                items: 1,
+                image: ImageState::Included
+            },
+            "the early answer stands"
+        );
+        let error = result.expect_err("the task returns the insertion error");
+        assert!(
+            format!("{error:#}").contains("the composer refused the mention"),
+            "the error names the reason: {error:#}"
+        );
+        assert_eq!(
+            insertion_failures(&target),
+            1,
+            "one notification, in the target window"
+        );
+        assert_eq!(insertion_failures(&other), 0, "none in the other window");
+        assert!(
+            !composer_text(&target).contains("dom-element"),
+            "nothing was inserted: {:?}",
+            composer_text(&target)
+        );
+    }
+
+    // M1: a conversation that failed to load is not a thread to deliver to: a new thread opens
+    // and holds the chip, instead of the delivery failing on the broken one.
+    #[gpui::test]
+    async fn insert_replaces_a_conversation_that_failed_to_load_with_a_new_thread(
+        cx: &mut TestAppContext,
+    ) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let mut target = window_with_panel(&fs, "/p/app", cx).await;
+        open_with_server(
+            &mut target,
+            TestServer {
+                connect: Err("the agent binary is missing".into()),
+            },
+        );
+        // Opening it made its agent the selected one; a new thread opens with the stub agent.
+        crate::test_support::set_stub_agent_connection(StubAgentConnection::new());
+        target.panel.update(&mut target.cx, |panel, _| {
+            panel.select_agent_for_tests(crate::Agent::Stub)
+        });
+        let failed = target.panel.read_with(&target.cx, |panel, cx| {
+            let conversation = panel
+                .active_conversation_view()
+                .cloned()
+                .expect("precondition: a conversation");
+            assert!(
+                conversation.read(cx).load_error().is_some(),
+                "precondition: it failed to load"
+            );
+            conversation
+        });
+
+        let (answer, task) = deliver(selection(false), &target, cx).await;
+        task.await.expect("the new thread receives the chip");
+        cx.run_until_parked();
+
+        assert!(
+            matches!(
+                answer,
+                Ok(DeliveryOutcome::OpenedNewThread { items: 1, .. })
+            ),
+            "{answer:?}"
+        );
+        let active = target
+            .panel
+            .read_with(&target.cx, |panel, _| {
+                panel.active_conversation_view().cloned()
+            })
+            .expect("a conversation is active");
+        assert_ne!(active, failed, "a new thread, not the failed one");
+        assert!(
+            composer_text(&target).contains("dom-element"),
+            "the chip is in the new thread: {:?}",
+            composer_text(&target)
+        );
+        assert_eq!(insertion_failures(&target), 0);
+        assert!(composer_focused(&mut target), "its composer is focused");
+    }
+
+    // M2: with a terminal as the panel's new entry, showing the never-shown panel must not
+    // create an initial terminal that would take the view from the new thread.
+    #[gpui::test]
+    async fn insert_into_a_never_shown_panel_whose_new_entry_is_a_terminal(
+        cx: &mut TestAppContext,
+    ) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let mut target = window_with_panel(&fs, "/p/app", cx).await;
+        target.panel.update(&mut target.cx, |panel, _| {
+            panel.make_terminal_the_new_entry_for_tests()
+        });
+
+        let (answer, task) = deliver(selection(false), &target, cx).await;
+        task.await.expect("the new thread receives the chip");
+        for _ in 0..4 {
+            cx.run_until_parked();
+        }
+
+        assert!(
+            matches!(answer, Ok(DeliveryOutcome::OpenedNewThread { .. })),
+            "{answer:?}"
+        );
+        target.panel.read_with(&target.cx, |panel, cx| {
+            assert!(panel.terminals(cx).is_empty(), "no initial terminal");
+            assert_eq!(
+                panel.active_terminal_id(),
+                None,
+                "the thread keeps the view"
+            );
+        });
+        assert!(composer_text(&target).contains("dom-element"));
+        assert!(composer_focused(&mut target), "its composer is focused");
+    }
+
+    // M3: the user moved to another Zeo window while the thread connected: the chip still lands,
+    // but the target is not raised, focus stays in the other window, and a notification in the
+    // target window says where the selection went.
+    #[gpui::test]
+    async fn insert_after_a_wait_does_not_pull_the_user_back_from_another_window(
+        cx: &mut TestAppContext,
+    ) {
+        init(cx);
+        cx.update(crate::devtools_delivery::track_window_activation);
+        let fs = shared_fs(cx).await;
+        let mut target = window_with_panel(&fs, "/p/app", cx).await;
+        let (gate_tx, gate_rx) = oneshot::channel();
+        open_with_server(
+            &mut target,
+            TestServer {
+                connect: Ok(gate_rx.shared()),
+            },
+        );
+        let mut other = window_with_thread(&fs, "/q/other", cx).await;
+
+        let other_focus_before = other.cx.update(|window, cx| window.focused(cx));
+        assert!(
+            other_focus_before.is_some(),
+            "precondition: focus in the other window"
+        );
+        let (answer, task) = deliver(selection(false), &target, cx).await;
+        assert!(
+            matches!(
+                answer,
+                Ok(DeliveryOutcome::Inserted {
+                    items: 1,
+                    image: ImageState::None
+                })
+            ),
+            "the connecting thread is the active one: {answer:?}"
+        );
+        other.cx.update(|window, _| window.activate_window());
+        other.cx.run_until_parked();
+        gate_tx.send(()).expect("the agent is still connecting");
+        cx.run_until_parked();
+        task.await.expect("the chip still lands");
+        cx.run_until_parked();
+
+        assert!(
+            composer_text(&target).contains("dom-element"),
+            "{:?}",
+            composer_text(&target)
+        );
+        assert_eq!(
+            cx.update(|cx| cx.active_window()),
+            Some(other.cx.update(|window, _| window.window_handle())),
+            "the other window keeps the front"
+        );
+        assert_eq!(
+            other.cx.update(|window, cx| window.focused(cx)),
+            other_focus_before,
+            "focus in the other window is left where the user put it"
+        );
+        assert_eq!(
+            notifications(&target, AddedInBackground::id()),
+            1,
+            "the target window says where the selection went"
+        );
+    }
+}
diff --git a/crates/agent_ui/src/devtools_delivery_recency_tests.rs b/crates/agent_ui/src/devtools_delivery_recency_tests.rs
new file mode 100644
index 0000000..73b1a4f
--- /dev/null
+++ b/crates/agent_ui/src/devtools_delivery_recency_tests.rs
@@ -0,0 +1,116 @@
+// Story 033, task 8.1 fix cycle 1: window resolution while Zeo has no focused window (R9.2 on
+// Wayland, where gpui has no window stack), and a worktree opened through a symlink (R9.1).
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use fs::FakeFs;
+use gpui::{AnyWindowHandle, TestAppContext, VisualTestContext, WindowHandle};
+use project::Project;
+use serde_json::json;
+use workspace::MultiWorkspace;
+
+use crate::devtools_delivery::{
+    canonical_worktree_roots, resolve_window_for_path, resolve_window_for_path_with,
+    track_window_activation,
+};
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(track_window_activation);
+}
+
+async fn shared_fs(cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/p", json!({ "app": { "src": { "a.tsx": "" } } }))
+        .await;
+    fs.insert_symlink("/link", PathBuf::from("/p/app")).await;
+    fs
+}
+
+struct Win {
+    window: WindowHandle<MultiWorkspace>,
+    cx: VisualTestContext,
+}
+
+impl Win {
+    fn any(&self) -> AnyWindowHandle {
+        self.window.into()
+    }
+
+    fn activate(&mut self) {
+        self.cx.update(|window, _| window.activate_window());
+        self.cx.run_until_parked();
+    }
+}
+
+async fn window(fs: &Arc<FakeFs>, root: &str, cx: &mut TestAppContext) -> Win {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let cx = VisualTestContext::from_window(window.into(), cx);
+    Win { window, cx }
+}
+
+fn resolved(root: &str, cx: &mut TestAppContext) -> Option<AnyWindowHandle> {
+    cx.update(|cx| resolve_window_for_path(Path::new(root), cx))
+        .ok()
+        .map(|(window, _workspace)| window)
+}
+
+// R9.2 with no Zeo window focused — the browser has focus — in both orders. The test platform,
+// like Wayland, has no window stack, so only Zeo's own activation record can rank them.
+#[gpui::test]
+async fn resolve_breaks_a_tie_by_activation_while_no_window_is_focused(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut first = window(&fs, "/p/app", cx).await;
+    let mut second = window(&fs, "/p/app", cx).await;
+
+    first.activate();
+    second.activate();
+    second.cx.deactivate_window();
+    assert_eq!(cx.update(|cx| cx.active_window()), None, "precondition");
+    assert_eq!(
+        resolved("/p/app", cx),
+        Some(second.any()),
+        "second, active last"
+    );
+
+    second.activate();
+    first.activate();
+    first.cx.deactivate_window();
+    assert_eq!(cx.update(|cx| cx.active_window()), None, "precondition");
+    assert_eq!(
+        resolved("/p/app", cx),
+        Some(first.any()),
+        "first, active last"
+    );
+}
+
+// R9.1: the bridge hands over the canonical root, and a worktree opened through a symlink keeps
+// the symlink's path; the canonical worktree roots join the two.
+#[gpui::test]
+async fn resolve_finds_a_worktree_opened_through_a_symlink(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let linked = window(&fs, "/link", cx).await;
+    assert_eq!(
+        resolved("/p/app", cx),
+        None,
+        "precondition: the worktree holds /link, which does not contain /p/app as written"
+    );
+
+    let canonical_roots = cx
+        .update(|cx| canonical_worktree_roots(fs.clone(), cx))
+        .await;
+    assert_eq!(
+        canonical_roots.get(Path::new("/link")),
+        Some(&PathBuf::from("/p/app"))
+    );
+    let found = cx
+        .update(|cx| resolve_window_for_path_with(Path::new("/p/app/src"), &canonical_roots, cx))
+        .ok()
+        .map(|(window, _workspace)| window);
+    assert_eq!(found, Some(linked.any()));
+}
diff --git a/crates/agent_ui/src/devtools_delivery_tests.rs b/crates/agent_ui/src/devtools_delivery_tests.rs
new file mode 100644
index 0000000..4671551
--- /dev/null
+++ b/crates/agent_ui/src/devtools_delivery_tests.rs
@@ -0,0 +1,597 @@
+// Story 033, tasks 8.1 and 8.2 — a validated devtools selection reaches the right window's
+// composer (R9.1, R9.2, R9.3, R9.4, R9.5, R9.6, R9.7, R9.8, R9.9, R9.10; Q4, Q13). Wired in the
+// crate root `src/agent_ui.rs` as
+//
+//     #[cfg(test)]
+//     mod devtools_delivery_tests;
+//
+// Test paths are `devtools_delivery_tests::resolve::…` and `devtools_delivery_tests::insert::…`,
+// so the Validation filters are `devtools_delivery_tests::resolve` and
+// `devtools_delivery_tests::insert` (tasks.md's `devtools_delivery::resolve` cannot match a test
+// module of this name); `cargo test -p agent_ui devtools` (Q5) still selects all of them.
+//
+// Contract (tasks.md 8.1/8.2 Objectives; design.md §B2; 2026-10-09 corrections). Assumed
+// signatures — adjust the `use` only:
+//   - `crate::devtools_delivery::resolve_window_for_path(root: &Path, cx: &App)
+//      -> Result<(AnyWindowHandle, Entity<Workspace>), DeliveryError>`
+//   - `crate::devtools_delivery::deliver_devtools_selection(req: DevtoolsSelection,
+//      app_state: Arc<AppState>, answer: oneshot::Sender<Result<DeliveryOutcome, DeliveryError>>,
+//      cx: &mut App) -> Task<Result<()>>`
+//   - `DevtoolsSelection` deserializes from the wire request (1-based lines), so this file pins
+//     the contract's field names, not a struct shape.
+//   - `DeliveryError` has variants `NoWindow`, `AiDisabled`, `NoAgentPanel` (any payload).
+//   - `DeliveryOutcome`'s `Debug` names the outcome (`Inserted` / `OpenedNewThread`) and the
+//     image state (`Included` / `SkippedUnsupported`), the Rust side of the wire's
+//     `image: included | skipped_unsupported | none | pending` (pending for a new thread).
+//
+// Hostile halves first:
+//   - window, wrongly COLLAPSE: `/p/app2` is not a worktree holding `/p/app`; a worktree deeper
+//     than the root (`/p/app/web/src`) does not hold `/p/app/web`.
+//   - window, wrongly SPLIT: `/p/app` holds `/p/app/web`; any worktree of a multi-root window
+//     counts; the deepest wins even when a shallower window was active last; a tie goes to the
+//     most recently active window, in both orders.
+//   - mentions: two elements on the same line differing only in tag stay two chips; request
+//     order is kept when it is not alphabetical; the image is skipped for an agent without
+//     image support AND included when it has it; delivery never sends.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use acp_thread::{MentionUri, StubAgentConnection};
+use fs::FakeFs;
+use gpui::{
+    AnyWindowHandle, AppContext as _, Entity, Focusable as _, TestAppContext, VisualTestContext,
+    WindowHandle,
+};
+use project::Project;
+use serde_json::{Value, json};
+use settings::Settings as _;
+use util::paths::PathStyle;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::AgentPanel;
+use crate::devtools_delivery::{
+    DeliveryError, DeliveryOutcome, DevtoolsSelection, deliver_devtools_selection,
+    resolve_window_for_path,
+};
+use crate::message_editor::MessageEditor;
+
+const PNG_1X1: &str = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==";
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    let source = "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\n";
+    fs.insert_tree(
+        "/p",
+        json!({
+            "app": {
+                "src": { "a.tsx": source, "m.tsx": source, "z.tsx": source },
+                "web": { "src": { "page.tsx": source } }
+            },
+            "app2": { "src": { "a.tsx": source } }
+        }),
+    )
+    .await;
+    fs.insert_tree("/q/other", json!({ "file.txt": "" })).await;
+    fs
+}
+
+struct Win {
+    window: WindowHandle<MultiWorkspace>,
+    workspace: Entity<Workspace>,
+    panel: Option<Entity<AgentPanel>>,
+    cx: VisualTestContext,
+}
+
+impl Win {
+    fn any(&self) -> AnyWindowHandle {
+        self.window.into()
+    }
+
+    fn panel(&self) -> Entity<AgentPanel> {
+        self.panel.clone().expect("this window has an agent panel")
+    }
+}
+
+enum Thread {
+    None,
+    NoPanel,
+    Stub(StubAgentConnection),
+}
+
+async fn window(fs: &Arc<FakeFs>, roots: &[&str], thread: Thread, cx: &mut TestAppContext) -> Win {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    let panel = match &thread {
+        Thread::NoPanel => None,
+        Thread::None | Thread::Stub(_) => {
+            let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+                let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+                workspace.add_panel(panel.clone(), window, cx);
+                panel
+            });
+            vcx.run_until_parked();
+            Some(panel)
+        }
+    };
+    if let (Thread::Stub(connection), Some(panel)) = (thread, &panel) {
+        crate::test_support::open_thread_with_connection(panel, connection, &mut vcx);
+    }
+    Win {
+        window,
+        workspace,
+        panel,
+        cx: vcx,
+    }
+}
+
+fn activate(win: &mut Win) {
+    win.cx.update(|window, _| window.activate_window());
+    win.cx.run_until_parked();
+}
+
+/// `(file, line, end_line, component, tag)`, wire form (1-based lines).
+type Item<'a> = (&'a str, u32, u32, Option<&'a str>, &'a str);
+
+fn selection(root: &str, items: &[Item], screenshot: bool) -> DevtoolsSelection {
+    let items: Vec<Value> = items
+        .iter()
+        .map(|(file, line, end_line, component, tag)| {
+            json!({
+                "src": { "file": file, "line": line, "column": 1, "end_line": end_line },
+                "component": component,
+                "dom": {
+                    "tag": tag, "id": null, "classes": [], "text": "Save", "attrs": {},
+                    "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+                }
+            })
+        })
+        .collect();
+    let screenshot = if screenshot {
+        json!({ "mime": "image/png", "data_b64": PNG_1X1, "w": 1, "h": 1 })
+    } else {
+        Value::Null
+    };
+    serde_json::from_value(json!({
+        "v": 1,
+        "project_root": root,
+        "page_url": "http://localhost:5173/",
+        "items": items,
+        "screenshot": screenshot
+    }))
+    .expect("DevtoolsSelection deserializes from the wire request")
+}
+
+fn windows(cx: &mut TestAppContext) -> usize {
+    cx.update(|cx| cx.windows().len())
+}
+
+mod resolve {
+    use super::*;
+
+    fn resolved(root: &str, cx: &mut TestAppContext) -> Result<AnyWindowHandle, DeliveryError> {
+        cx.update(|cx| resolve_window_for_path(Path::new(root), cx))
+            .map(|(window, _workspace)| window)
+    }
+
+    // R9.1 hostile (wrongly collapse): the prefix-named sibling, active last, is never taken.
+    #[gpui::test]
+    async fn resolve_never_takes_a_sibling_whose_name_extends_the_root(cx: &mut TestAppContext) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let app = window(&fs, &["/p/app"], Thread::None, cx).await;
+        let mut app2 = window(&fs, &["/p/app2"], Thread::None, cx).await;
+        activate(&mut app2);
+        assert_eq!(
+            resolved("/p/app", cx).expect("a window holds it"),
+            app.any()
+        );
+    }
+
+    // R9.1 (wrongly split, then wrongly collapse): a worktree holds a sub-directory root; a
+    // worktree deeper than the root does not hold it.
+    #[gpui::test]
+    async fn resolve_takes_the_worktree_that_contains_a_subdirectory_root(cx: &mut TestAppContext) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let app = window(&fs, &["/p/app"], Thread::None, cx).await;
+        let mut deeper = window(&fs, &["/p/app/web/src"], Thread::None, cx).await;
+        activate(&mut deeper);
+        assert_eq!(
+            resolved("/p/app/web", cx).expect("a window holds it"),
+            app.any()
+        );
+    }
+
+    // R9.1: depth beats recency.
+    #[gpui::test]
+    async fn resolve_picks_the_deepest_worktree_root(cx: &mut TestAppContext) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let app = window(&fs, &["/p/app"], Thread::None, cx).await;
+        let mut parent = window(&fs, &["/p"], Thread::None, cx).await;
+        activate(&mut parent);
+        assert_eq!(
+            resolved("/p/app/web", cx).expect("a window holds it"),
+            app.any()
+        );
+    }
+
+    // R9.2, both orders.
+    #[gpui::test]
+    async fn resolve_breaks_a_tie_by_the_most_recently_active_window(cx: &mut TestAppContext) {
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let mut first = window(&fs, &["/p/app"], Thread::None, cx).await;
+        let mut second = window(&fs, &["/p/app"], Thread::None, cx).await;
+        activate(&mut first);
+        activate(&mut second);
+        assert_eq!(
+            resolved("/p/app", cx).expect("tie"),
+            second.any(),
