+#[test]
+fn protocol_holds_styles_to_24_properties() {
+    let fx = fixture();
+    let req = request_with_item(&fx, |one| {
+        let styles: serde_json::Map<String, Value> = (0..25)
+            .map(|index| (format!("prop-{index}"), json!("1px")))
+            .collect();
+        one["dom"]["styles"] = Value::Object(styles);
+    });
+    assert_eq!(verdict(&fx.root, req), "bad_request");
+}
+
+// Hostile: every field is inside its own limit, but the serialized `dom` passes 4 KiB.
+#[test]
+fn protocol_refuses_a_dom_summary_over_4_kib_built_from_legal_fields() {
+    let fx = fixture();
+    let req = request_with_item(&fx, |one| {
+        one["dom"]["classes"] = json!((0..32).map(|_| "c".repeat(128)).collect::<Vec<_>>())
+    });
+    assert_eq!(verdict(&fx.root, req), "bad_request");
+    let req = request_with_item(&fx, |one| {
+        one["dom"]["classes"] = json!((0..16).map(|_| "c".repeat(128)).collect::<Vec<_>>());
+        one["dom"]["text"] = json!("t".repeat(500));
+    });
+    assert_eq!(verdict(&fx.root, req), "accepted", "about 2.6 KiB");
+}
+
+#[test]
+fn protocol_refuses_a_negative_line() {
+    let fx = fixture();
+    let req = request_with_item(&fx, |one| one["src"]["line"] = json!(-1));
+    assert_eq!(verdict(&fx.root, req), "bad_request");
+}
+
+// Unknown keys are refused, in particular a form value smuggled into the summary (R4.3).
+#[test]
+fn protocol_refuses_unknown_keys() {
+    let fx = fixture();
+    let mut req = request(&fx.root, vec![item(&fx.root.join("src/App.tsx"))]);
+    req["extra"] = json!(1);
+    assert_eq!(verdict(&fx.root, req), "bad_request", "top level");
+    let req = request_with_item(&fx, |one| one["dom"]["value"] = json!("hunter2"));
+    assert_eq!(verdict(&fx.root, req), "bad_request", "inside dom");
+    let req = request_with_item(&fx, |one| one["src"]["offset"] = json!(4));
+    assert_eq!(verdict(&fx.root, req), "bad_request", "inside src");
+}
+
+// ---- R8.5 screenshot ---------------------------------------------------------------------
+
+#[test]
+fn protocol_refuses_a_screenshot_that_is_not_png() {
+    let fx = fixture();
+    assert_eq!(
+        verdict(
+            &fx.root,
+            with_screenshot(&fx, "image/jpeg", &png(10, 10, 64), 10, 10)
+        ),
+        "bad_request",
+        "a JPEG mime"
+    );
+    let jpeg = [
+        0xff, 0xd8, 0xff, 0xe0, 0, 0x10, b'J', b'F', b'I', b'F', 0, 1, 1, 0, 0, 1,
+    ];
+    assert_eq!(
+        verdict(&fx.root, with_screenshot(&fx, "image/png", &jpeg, 10, 10)),
+        "bad_request",
+        "JPEG bytes under a PNG mime"
+    );
+}
+
+// Hostile: both orientations, so checking only the width is caught.
+#[test]
+fn protocol_holds_the_long_edge_to_1568_pixels() {
+    let fx = fixture();
+    for (w, h, expected) in [
+        (1569, 10, "bad_request"),
+        (10, 1569, "bad_request"),
+        (1568, 1568, "accepted"),
+    ] {
+        assert_eq!(
+            verdict(
+                &fx.root,
+                with_screenshot(&fx, "image/png", &png(w, h, 64), w, h)
+            ),
+            expected,
+            "{w}x{h}"
+        );
+    }
+}
+
+// Contract correction 2026-10-09: 4 MiB decoded (6 MiB could never fit the 8 MiB line once
+// base64-encoded).
+#[test]
+fn protocol_holds_the_decoded_screenshot_to_4_mib() {
+    let fx = fixture();
+    let limit = 4 * 1024 * 1024;
+    assert_eq!(
+        verdict(
+            &fx.root,
+            with_screenshot(&fx, "image/png", &png(100, 100, limit + 1), 100, 100)
+        ),
+        "bad_request",
+        "4 MiB + 1"
+    );
+    assert_eq!(
+        verdict(
+            &fx.root,
+            with_screenshot(&fx, "image/png", &png(100, 100, limit), 100, 100)
+        ),
+        "accepted",
+        "exactly 4 MiB"
+    );
+}
+
+// Hostile: reading IHDR at bytes 16–23 of a shorter buffer must refuse, never panic.
+#[test]
+fn protocol_refuses_a_truncated_png_without_panicking() {
+    let fx = fixture();
+    let magic_only = &png(10, 10, 0)[..8];
+    assert_eq!(
+        verdict(
+            &fx.root,
+            with_screenshot(&fx, "image/png", magic_only, 10, 10)
+        ),
+        "bad_request"
+    );
+    let partial_header = &png(10, 10, 0)[..20];
+    assert_eq!(
+        verdict(
+            &fx.root,
+            with_screenshot(&fx, "image/png", partial_header, 10, 10)
+        ),
+        "bad_request"
+    );
+}
+
+#[test]
+fn protocol_refuses_screenshot_data_that_is_not_base64() {
+    let fx = fixture();
+    let mut req = with_screenshot(&fx, "image/png", &png(10, 10, 64), 10, 10);
+    req["screenshot"]["data_b64"] = json!("!!! not base64 !!!");
+    assert_eq!(verdict(&fx.root, req), "bad_request");
+}
+
+// ---- R12.3 / Q4: an error never carries page content -------------------------------------
+
+#[test]
+fn protocol_errors_never_carry_dom_text_or_attribute_values() {
+    let fx = fixture();
+    let cases = [
+        request_with_item(&fx, |one| {
+            one["dom"]["text"] = json!(format!("SECRET-DOM-TEXT{}", "a".repeat(500)))
+        }),
+        request_with_item(&fx, |one| {
+            one["dom"]["attrs"] = json!({ "onclick": "SECRET-ATTR-VALUE" })
+        }),
+    ];
+    for req in cases {
+        let selection: DevtoolsSelection = match serde_json::from_value(req) {
+            Ok(selection) => selection,
+            // Refused by serde: the listener's own answer is checked in listener_tests.
+            Err(_) => continue,
+        };
+        let root_canon = fs::canonicalize(&fx.root).expect("the root exists");
+        let error = match validate(selection, &root_canon) {
+            Ok(_) => panic!("the request breaks a limit"),
+            Err(error) => error,
+        };
+        let shown = format!("{error} / {error:?}");
+        assert!(!shown.contains("SECRET-DOM-TEXT"), "no DOM text: {shown}");
+        assert!(
+            !shown.contains("SECRET-ATTR-VALUE"),
+            "no attribute value: {shown}"
+        );
+    }
+}
