+        }
+    }
+
+    fn success() -> DevtoolsResult {
+        DevtoolsResult::Success {
+            outcome: protocol::DeliveryOutcome::Inserted,
+            items: 1,
+            image: protocol::ImageState::None,
+        }
+    }
+
+    fn answering_handler() -> Handler {
+        Arc::new(|_selection: DevtoolsSelection| async { success() }.boxed())
+    }
+
+    fn valid_line(root: &Path) -> Vec<u8> {
+        let mut line = serde_json::to_vec(&json!({
+            "v": 1,
+            "project_root": root.to_string_lossy(),
+            "page_url": "http://localhost:5173/",
+            "items": [{
+                "src": {
+                    "file": root.join("src/App.tsx").to_string_lossy(),
+                    "line": 1, "column": 1, "end_line": 2
+                },
+                "component": "App",
+                "dom": {
+                    "tag": "div", "id": null, "classes": [], "text": "", "attrs": {},
+                    "styles": {}, "rect": { "x": 0, "y": 0, "w": 1, "h": 1 }
+                }
+            }],
+            "screenshot": null
+        }))
+        .expect("json");
+        line.push(b'\n');
+        line
+    }
+
+    fn send(dir: &Path, root: &Path) -> UnixStream {
+        let mut stream = UnixStream::connect(dir.join(SOCKET_NAME)).expect("a connection");
+        stream
+            .set_read_timeout(Some(Duration::from_secs(10)))
+            .expect("read timeout");
+        stream.write_all(&valid_line(root)).expect("the request");
+        stream
+    }
+
+    /// The answer line, or `None` when the bridge closed without one.
+    fn answer(stream: UnixStream) -> Option<Value> {
+        let mut reader = BufReader::new(stream);
+        let mut line = String::new();
+        match reader.read_line(&mut line) {
+            Ok(0) => None,
+            Ok(_) => Some(serde_json::from_str(line.trim_end()).expect("one JSON line")),
+            Err(error) if error.kind() == io::ErrorKind::ConnectionReset => None,
+            Err(error) => panic!("reading the answer failed: {error}"),
+        }
+    }
+
+    fn is_ok(answer: &Option<Value>) -> bool {
+        answer.as_ref().and_then(|value| value.get("ok")) == Some(&Value::Bool(true))
+    }
+
+    fn owned_by_another(result: Result<Listener>) -> bool {
+        matches!(result, Err(error) if error.is::<OwnedByAnother>())
+    }
+
+    #[test]
+    fn a_handler_answering_none_closes_without_an_answer() {
+        let fx = fixture();
+        let handler = RequestHandler::new(|_selection| async { None }.boxed());
+        let _listener = start(&fx.dir, handler).expect("it listens");
+
+        let started = Instant::now();
+        assert_eq!(
+            answer(send(&fx.dir, &fx.root)),
+            None,
+            "closed without an answer"
+        );
+        assert!(
+            started.elapsed() < Duration::from_secs(2),
+            "closed at once, not at a deadline: {:?}",
+            started.elapsed()
+        );
+    }
+
+    // Hostile: four handlers that never answer must not close the bridge for good.
+    #[test]
+    fn a_handler_that_never_answers_frees_its_slot_at_the_response_deadline() {
+        let fx = fixture();
+        let calls = Arc::new(AtomicUsize::new(0));
+        let handler: Handler = {
+            let calls = calls.clone();
+            Arc::new(move |_selection: DevtoolsSelection| {
+                if calls.fetch_add(1, Ordering::SeqCst) < MAX_CONNECTIONS {
+                    futures::future::pending().boxed()
+                } else {
+                    async { success() }.boxed()
+                }
+            })
+        };
+        let deadlines = Deadlines {
+            read: READ_DEADLINE,
+            response: Duration::from_millis(400),
+        };
+        let _listener = start_with_deadlines(&fx.dir, handler, deadlines).expect("it listens");
+
+        let started = Instant::now();
+        let hung: Vec<UnixStream> = (0..MAX_CONNECTIONS)
+            .map(|_| send(&fx.dir, &fx.root))
+            .collect();
+        for stream in hung {
+            assert_eq!(answer(stream), None, "closed without an answer");
+        }
+        let elapsed = started.elapsed();
+        assert!(
+            elapsed >= Duration::from_millis(350),
+            "not before: {elapsed:?}"
+        );
+        assert!(
+            elapsed < READ_DEADLINE,
+            "at the response deadline: {elapsed:?}"
+        );
+        assert_eq!(calls.load(Ordering::SeqCst), MAX_CONNECTIONS);
+
+        assert!(
+            is_ok(&answer(send(&fx.dir, &fx.root))),
+            "the freed slots serve the next request"
+        );
+    }
+
+    // Hostile: a live owner whose backlog is full must not hang the probe.
+    #[test]
+    fn a_live_owner_with_a_full_backlog_is_detected_without_blocking() {
+        let fx = fixture();
+        fs::create_dir_all(&fx.dir).expect("the dir");
+        let path = fx.dir.join(SOCKET_NAME);
+        let address = UnixAddr::new(&path).expect("an address");
+        let owner = socket(
+            AddressFamily::Unix,
+            SockType::Stream,
+            SockFlag::SOCK_CLOEXEC,
+            None,
+        )
+        .expect("the owner's socket");
+        bind(owner.as_raw_fd(), &address).expect("bound");
+        listen(&owner, Backlog::new(0).expect("backlog 0")).expect("listening, never accepting");
+
+        let mut fillers = Vec::new();
+        let mut full = false;
+        for _ in 0..64 {
+            let filler = socket(
+                AddressFamily::Unix,
+                SockType::Stream,
+                SockFlag::SOCK_NONBLOCK | SockFlag::SOCK_CLOEXEC,
+                None,
+            )
+            .expect("a filler");
+            match connect(filler.as_raw_fd(), &address) {
+                Ok(()) => fillers.push(filler),
+                Err(Errno::EAGAIN) => {
+                    full = true;
+                    break;
+                }
+                Err(errno) => panic!("filling the backlog: {errno}"),
+            }
+        }
+        assert!(full, "precondition: the backlog is full");
+
+        let (sender, receiver) = mpsc::channel();
+        let dir = fx.dir;
+        thread::spawn(move || {
+            let refused = owned_by_another(start(&dir, answering_handler()));
+            sender.send(refused).ok();
+        });
+        let refused = receiver
+            .recv_timeout(Duration::from_secs(3))
+            .expect("the probe returns instead of blocking");
+        assert!(refused, "a full backlog is a live owner");
+        drop(fillers);
+    }
+
+    #[test]
+    fn a_held_lock_means_another_owner_and_its_release_frees_the_directory() {
+        let fx = fixture();
+        fs::create_dir_all(&fx.dir).expect("the dir");
+        let held = File::create(fx.dir.join(LOCK_NAME)).expect("the lock file");
+        held.try_lock().expect("the test holds the lock");
+
+        assert!(
+            owned_by_another(start(&fx.dir, answering_handler())),
+            "a held lock is another owner"
+        );
+        assert!(!fx.dir.join(SOCKET_NAME).exists(), "nothing was bound");
+
+        drop(held);
+        let listener = start(&fx.dir, answering_handler()).expect("the released lock is taken");
+        let lock_mode = fs::metadata(fx.dir.join(LOCK_NAME))
+            .expect("the lock")
+            .mode();
+        assert_eq!(lock_mode & 0o777, 0o600, "lock file mode");
+        drop(listener);
+        let _again = start(&fx.dir, answering_handler()).expect("dropping released the lock");
+    }
+
+    // Hostile: two Zeos racing over a stale socket; exactly one may own it.
+    #[test]
+    fn two_starts_racing_over_a_stale_socket_leave_one_owner() {
+        let fx = fixture();
+        fs::create_dir_all(&fx.dir).expect("the dir");
+        drop(UnixListener::bind(fx.dir.join(SOCKET_NAME)).expect("a socket that goes stale"));
+
+        let barrier = Arc::new(Barrier::new(2));
+        let racers: Vec<_> = (0..2)
+            .map(|_| {
+                let barrier = barrier.clone();
+                let dir = fx.dir.clone();
+                thread::spawn(move || {
+                    barrier.wait();
+                    start(&dir, answering_handler())
+                })
+            })
+            .collect();
+        let results: Vec<Result<Listener>> = racers
+            .into_iter()
+            .map(|racer| racer.join().expect("a racer"))
+            .collect();
+        // The owner is kept alive to the end: dropping it would remove the socket.
+        let (owners, losers): (Vec<_>, Vec<_>) = results.into_iter().partition(Result::is_ok);
+        assert_eq!(owners.len(), 1, "exactly one owner");
+        let losers = losers
+            .into_iter()
+            .filter_map(|result| result.err())
+            .collect::<Vec<_>>();
+        assert!(
+            losers.iter().all(|error| error.is::<OwnedByAnother>()),
+            "the other is told another Zeo owns it: {losers:?}"
+        );
+        assert!(
+            is_ok(&answer(send(&fx.dir, &fx.root))),
+            "the owner's socket survived the loser"
+        );
+    }
+
+    #[test]
+    fn a_symlinked_or_non_directory_socket_dir_is_refused() {
+        let fx = fixture();
+        let target = fx.base.join("elsewhere");
+        fs::create_dir_all(&target).expect("the target");
+        fs::set_permissions(&target, fs::Permissions::from_mode(0o755)).expect("0755");
+        symlink(&target, &fx.dir).expect("the symlink");
+        let error = match start(&fx.dir, answering_handler()) {
+            Ok(_) => panic!("a symlinked directory must be refused"),
+            Err(error) => error,
+        };
+        assert!(format!("{error:#}").contains("symlink"), "{error:#}");
+        assert!(
+            !target.join(SOCKET_NAME).exists(),
+            "nothing bound behind it"
+        );
+        let target_mode = fs::metadata(&target)
+            .expect("the target")
+            .permissions()
+            .mode();
+        assert_eq!(
+            target_mode & 0o777,
+            0o755,
+            "the target's mode is not touched"
+        );
+
+        let file_dir = fx.base.join("a-file");
+        fs::write(&file_dir, "").expect("a file");
+        assert!(
+            start(&file_dir, answering_handler()).is_err(),
+            "a file is refused"
+        );
+    }
+
+    #[test]
+    fn accept_failures_back_off_and_only_the_first_of_a_run_warns() {
+        let mut backoff = AcceptBackoff::default();
+        let pauses: Vec<(Duration, bool)> = (0..8).map(|_| backoff.failed()).collect();
+        assert_eq!(pauses.first(), Some(&(ACCEPT_RETRY_FIRST, true)));
+        assert!(pauses.iter().skip(1).all(|(_, warns)| !warns), "{pauses:?}");
+        assert!(
+            pauses.windows(2).all(|pair| pair[0].0 <= pair[1].0),
+            "the pause grows: {pauses:?}"
+        );
+        assert_eq!(
+            pauses.last().map(|(pause, _)| *pause),
+            Some(ACCEPT_RETRY_MAX)
+        );
+        for _ in 0..100 {
+            backoff.failed();
+        }
+        assert_eq!(backoff.failed().0, ACCEPT_RETRY_MAX, "never past the cap");
+
+        assert_eq!(
+            backoff.succeeded(),
+            Some(109),
+            "the run's size is reported once"
+        );
+        assert_eq!(backoff.succeeded(), None);
+        assert_eq!(
+            backoff.failed(),
+            (ACCEPT_RETRY_FIRST, true),
+            "a new run starts over"
+        );
+    }
