+// ---- R8.3 item count and field limits ------------------------------------------------------
+
+#[test]
+fn protocol_holds_items_to_one_through_twenty() {
+    let fx = fixture();
+    let file = fx.root.join("src/App.tsx");
+    let items = |n: usize| (0..n).map(|_| item(&file)).collect::<Vec<_>>();
+    assert_eq!(
+        verdict(&fx.root, request(&fx.root, items(0))),
