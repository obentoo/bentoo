+//! The wire contract between a dev-server page (through the `zeo-devtools` relay) and Zeo.
+//!
+//! Field names and limits mirror `zeo-devtools/src/contract.ts`; both validators are held to
+//! the same fixture files (`zeo-devtools/test/contract/`), so a limit changed here must change
+//! there too.
+
+use std::fmt;
+use std::io;
+use std::path::Path;
+
+use base64::Engine as _;
+use indexmap::IndexMap;
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+pub const PROTOCOL_VERSION: u64 = 1;
+pub const MAX_ITEMS: usize = 20;
+pub const DOM_SUMMARY_MAX_BYTES: usize = 4096;
+pub const SCREENSHOT_MAX_EDGE: u32 = 1568;
+/// Decoded bytes.
+pub const SCREENSHOT_MAX_BYTES: usize = 4 * 1024 * 1024;
+
+const SCREENSHOT_MAX_BASE64_LEN: usize = SCREENSHOT_MAX_BYTES.div_ceil(3) * 4;
+const SCREENSHOT_MIME: &str = "image/png";
+const PNG_MAGIC: [u8; 8] = [0x89, b'P', b'N', b'G', b'\r', b'\n', 0x1a, b'\n'];
+
+const MIN_PATH_CHARS: usize = 2;
+const MAX_PATH_CHARS: usize = 4096;
+const MAX_PAGE_URL_CHARS: usize = 2048;
+const MAX_COMPONENT_CHARS: usize = 128;
+const MAX_TAG_CHARS: usize = 64;
+const MAX_ID_CHARS: usize = 128;
+const MAX_CLASSES: usize = 32;
+const MAX_CLASS_CHARS: usize = 128;
+const MAX_TEXT_CHARS: usize = 500;
+const MAX_ATTR_VALUE_CHARS: usize = 200;
+const MAX_STYLE_VALUE_CHARS: usize = 200;
+
+/// The computed styles a DOM summary may carry, in the order the page client reads them.
+pub const STYLE_KEYS: [&str; 24] = [
+    "display",
+    "position",
+    "box-sizing",
+    "width",
+    "height",
+    "margin",
+    "padding",
+    "border",
+    "border-radius",
+    "color",
+    "background-color",
+    "font-family",
+    "font-size",
+    "font-weight",
+    "line-height",
+    "text-align",
+    "gap",
+    "flex-direction",
+    "justify-content",
+    "align-items",
+    "grid-template-columns",
+    "opacity",
+    "z-index",
+    "overflow",
+];
+
+/// The socket request: one element selection, with absolute paths.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DevtoolsSelection {
+    pub v: u64,
+    pub project_root: String,
+    pub page_url: String,
+    pub items: Vec<SelectionItem>,
+    #[serde(deserialize_with = "required_nullable")]
+    pub screenshot: Option<Screenshot>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SelectionItem {
+    pub src: SourceLocation,
+    #[serde(deserialize_with = "required_nullable")]
+    pub component: Option<String>,
+    pub dom: DomSummary,
+}
+
+/// One-based positions, as the relay writes them.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourceLocation {
+    pub file: String,
+    pub line: u64,
+    pub column: u64,
+    pub end_line: u64,
+}
+
+/// Field order matches the zod schema, so the serialized summary is laid out as the page's
+/// `JSON.stringify` lays it out.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DomSummary {
+    pub tag: String,
+    #[serde(deserialize_with = "required_nullable")]
+    pub id: Option<String>,
+    pub classes: Vec<String>,
+    pub text: String,
+    pub attrs: IndexMap<String, String>,
+    pub styles: IndexMap<String, String>,
+    pub rect: Rect,
+}
+
+/// CSS pixels, relative to the viewport.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Rect {
+    #[serde(serialize_with = "serialize_js_number")]
+    pub x: f64,
+    #[serde(serialize_with = "serialize_js_number")]
+    pub y: f64,
+    #[serde(serialize_with = "serialize_js_number")]
+    pub w: f64,
+    #[serde(serialize_with = "serialize_js_number")]
+    pub h: f64,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Screenshot {
+    pub mime: String,
+    pub data_b64: String,
+    pub w: u32,
+    pub h: u32,
