+//! Delivers a devtools selection — elements picked in a dev-server page — to the
+//! agent thread composer of the Zeo window that holds the page's project.
+//!
+//! `agent_ui` owns these types; the devtools bridge validates the wire request
+//! and converts it into a [`DevtoolsSelection`], so the dependency points one
+//! way, bridge → `agent_ui`.
+//!
+//! Window resolution is keyed by path, not by session: it is a sibling of
+//! `agent_session_router`'s resolution rather than a bend of it, because a
+//! session belongs to exactly one set of folders while a page's project root may
+//! sit anywhere inside a worktree.
+
+use std::cmp::Reverse;
+use std::fmt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use acp_thread::{LoadError, MentionUri};
+use anyhow::{Context as _, Result, anyhow};
+use base64::Engine as _;
+use collections::HashMap;
+use fs::Fs;
+use futures::StreamExt as _;
+use futures::channel::oneshot;
+use gpui::{
+    AnyWindowHandle, App, AsyncApp, Context, Entity, Focusable as _, Global, Image, ImageFormat,
+    Task, WeakEntity, Window, WindowHandle,
+};
+use project::DisableAiSettings;
+use serde::{Deserialize, Serialize};
+use settings::Settings as _;
+use util::ResultExt as _;
+use workspace::notifications::NotificationId;
+use workspace::{AppState, MultiWorkspace, Toast, Workspace};
+
+use crate::AgentPanel;
+use crate::agent_session_router::{THREAD_LOAD_TIMEOUT, before};
+use crate::conversation_view::ConversationView;
+use crate::mention_set::DomSummary;
+use crate::message_editor::MessageEditor;
+
+/// A validated devtools selection. Paths are absolute: the bridge has already
+/// checked that every `src.file` is a regular file inside `project_root`.
+/// Deserializes from the socket request; the protocol version `v` is checked by
+/// the bridge and not kept here.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct DevtoolsSelection {
+    pub project_root: PathBuf,
+    /// Only the host is ever logged; the page is never fetched.
+    pub page_url: String,
+    pub items: Vec<DevtoolsSelectionItem>,
+    pub screenshot: Option<DevtoolsScreenshot>,
+}
+
+/// One picked element: where it is written, and what it looked like.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct DevtoolsSelectionItem {
+    pub src: DevtoolsSource,
+    pub component: Option<String>,
+    pub dom: DomSummary,
+}
+
+/// The element's source location, wire form: 1-based lines and column.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct DevtoolsSource {
+    pub file: PathBuf,
+    pub line: u32,
+    pub column: u32,
+    pub end_line: u32,
+}
+
+/// A viewport screenshot, still base64-encoded as it came off the wire.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct DevtoolsScreenshot {
+    pub mime: String,
+    pub data_b64: String,
+    pub w: u32,
+    pub h: u32,
+}
+
+// 8.2 types, defined with 8.1 so the shared test file compiles. Designed for
+// the delivery implementation to keep, not replace.
+
+/// What happened to the screenshot, the Rust side of the wire's `image` field.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ImageState {
+    /// Inserted into the composer after the elements.
+    Included,
+    /// Dropped because the thread's agent does not accept images.
+    SkippedUnsupported,
+    /// The request carried no screenshot.
+    None,
+    /// A new thread is still connecting, so its image support is not known yet.
+    Pending,
+}
+
+/// The early answer of a delivery that found its window and agent panel.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DeliveryOutcome {
+    /// The mentions went into the active thread's composer.
+    Inserted { items: usize, image: ImageState },
+    /// No thread was active, so a new one was opened to hold the mentions.
+    OpenedNewThread { items: usize, image: ImageState },
+}
+
+impl DeliveryOutcome {
+    pub fn items(&self) -> usize {
+        match self {
+            Self::Inserted { items, .. } | Self::OpenedNewThread { items, .. } => *items,
+        }
+    }
+
+    pub fn image(&self) -> ImageState {
+        match self {
+            Self::Inserted { image, .. } | Self::OpenedNewThread { image, .. } => *image,
+        }
+    }
+}
+
+/// Why a selection was not delivered. Each variant names the project root it
+/// was for, and never carries page content.
+///
+/// A failure after the answer went out — an insertion that fails once the
+/// window and its editor resolved — is not a `DeliveryError`: it is the
+/// delivery task's own `anyhow` error, shown as a workspace notification.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DeliveryError {
+    /// No window holds a local worktree containing the project root.
+    NoWindow { project_root: PathBuf },
+    /// The resolved window has no agent panel.
+    NoAgentPanel { project_root: PathBuf },
+    /// AI features are disabled, so no window has an agent panel to deliver to.
+    AiDisabled { project_root: PathBuf },
+}
+
+impl fmt::Display for DeliveryError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let (project_root, reason) = match self {
+            Self::NoWindow { project_root } => {
+                (project_root, "no Zeo window has this project open")
+            }
+            Self::NoAgentPanel { project_root } => {
+                (project_root, "the Zeo window holding it has no agent panel")
+            }
+            Self::AiDisabled { project_root } => (project_root, "AI features are disabled in Zeo"),
+        };
+        write!(
+            formatter,
+            "devtools selection for {}: {reason}",
+            project_root.display()
+        )
+    }
+}
+
+impl std::error::Error for DeliveryError {}
+
+/// The window, and the workspace inside it, a selection for `root` goes to.
+///
+/// Same as [`resolve_window_for_path_with`] with no canonical worktree roots:
+/// a worktree opened through a symlink only matches by its own path.
+pub fn resolve_window_for_path(
+    root: &Path,
+    cx: &App,
+) -> Result<(AnyWindowHandle, Entity<Workspace>), DeliveryError> {
+    resolve_window_for_path_with(root, &HashMap::default(), cx)
+}
+
+/// The window, and the workspace inside it, a selection for `root` goes to.
+///
+/// A candidate is any local workspace, in any window, with a visible worktree
+/// whose root contains `root`, as the worktree's own path or as its canonical
+/// form in `canonical_roots` (see [`canonical_worktree_roots`]); the bridge
+/// hands over a canonical `root`, while a worktree keeps the path it was opened
+/// by. The deepest worktree root wins; on a tie, the most recently active
+/// window wins (see [`WindowRecency`]). Containment is component-wise
+/// (`Path::starts_with`), so a worktree at `/p/app2` never holds `/p/app`.
+///
+/// Read-only: nothing is opened, activated or raised here, so `NoWindow` leaves
+/// the app exactly as it was. `AiDisabled` is answered before any window is
+/// looked at, the same refusal `open_agent_session` makes first.
+///
+/// Do not call it from inside a window update: a window being updated is
+/// leased, cannot be read, and is skipped as if it held nothing.
+pub fn resolve_window_for_path_with(
+    root: &Path,
+    canonical_roots: &HashMap<PathBuf, PathBuf>,
+    cx: &App,
+) -> Result<(AnyWindowHandle, Entity<Workspace>), DeliveryError> {
+    if DisableAiSettings::get_global(cx).disable_ai {
+        return Err(DeliveryError::AiDisabled {
+            project_root: root.to_path_buf(),
+        });
+    }
+
+    let recency = WindowRecency::new(cx);
+    let mut best: Option<(CandidateRank, AnyWindowHandle, Entity<Workspace>)> = None;
+    for window in cx.windows() {
+        let Some(multi_workspace) = window
+            .downcast::<MultiWorkspace>()
+            .and_then(|handle| handle.read(cx).ok())
+        else {
+            continue;
+        };
+        let displayed = multi_workspace.workspace();
+        for workspace in multi_workspace.workspaces() {
+            let Some(depth) = deepest_worktree_holding(root, workspace, canonical_roots, cx) else {
+                continue;
+            };
+            let rank = CandidateRank {
+                depth,
+                recency: recency.rank(window),
+                displayed: workspace == displayed,
+            };
+            // Strictly greater: an exact tie keeps the first one found, so the
+            // answer does not flip between two indistinguishable candidates.
+            if best.as_ref().is_none_or(|(best, _, _)| rank > *best) {
+                best = Some((rank, window, workspace.clone()));
+            }
+        }
+    }
+
+    best.map(|(_, window, workspace)| (window, workspace))
+        .ok_or_else(|| DeliveryError::NoWindow {
+            project_root: root.to_path_buf(),
+        })
+}
+
+/// The canonical form of every visible local worktree root, keyed by the
+/// worktree's own path, for [`resolve_window_for_path_with`].
+///
+/// The roots are collected on the foreground and canonicalized through `fs` on
+/// the background executor, so the main thread never touches the disk. A root
+/// that is already canonical, or that no longer resolves, is left out: it
+/// matches by its own path only.
+pub fn canonical_worktree_roots(fs: Arc<dyn Fs>, cx: &App) -> Task<HashMap<PathBuf, PathBuf>> {
+    let mut roots: Vec<PathBuf> = Vec::new();
+    for window in cx.windows() {
+        let Some(multi_workspace) = window
+            .downcast::<MultiWorkspace>()
+            .and_then(|handle| handle.read(cx).ok())
+        else {
+            continue;
+        };
+        for workspace in multi_workspace.workspaces() {
+            let project = workspace.read(cx).project().read(cx);
+            if !project.is_local() {
+                continue;
+            }
+            roots.extend(
+                project
+                    .visible_worktrees(cx)
+                    .map(|worktree| worktree.read(cx).abs_path().to_path_buf()),
+            );
+        }
+    }
+    roots.sort();
+    roots.dedup();
+
+    cx.background_executor().spawn(async move {
+        let mut canonical_roots = HashMap::default();
+        for root in roots {
+            match fs.canonicalize(&root).await {
+                Ok(canonical) if canonical != root => {
+                    canonical_roots.insert(root, canonical);
+                }
+                Ok(_) => {}
+                // The root may belong to another project, so neither it nor the error
+                // (which names it) is logged: R12.3.
+                Err(error) => {
+                    log::debug!(
+                        "devtools delivery: a worktree root does not canonicalize, matched by its own path: kind={:?}",
+                        error.downcast_ref::<std::io::Error>().map(|error| error.kind())
+                    );
+                }
+            }
+        }
+        canonical_roots
+    })
+}
+
+/// How good a candidate is; compared field by field, greatest wins.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct CandidateRank {
+    /// Component count of the worktree root holding the project root.
+    depth: usize,
+    recency: Recency,
+    /// Inside one window, the workspace it is showing beats a hidden one.
+    displayed: bool,
+}
+
+/// How recently a window was active; a later variant is more recent, and so
+/// is a greater value within one.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Recency {
+    Unranked,
+    /// Position in the platform's front-to-back stack, reversed.
+    Stacked(Reverse<usize>),
+    /// The window's latest stamp in [`WindowActivationOrder`].
+    Stamped(u64),
+    Active,
+}
+
+/// The component count of the deepest root among `workspace`'s visible local
+/// worktrees that contains `root`, or `None` when none does.
+///
+/// Only visible worktrees count, as in `agent_session_router`: an invisible one
+/// is a single file opened from outside the project, not a project folder.
+fn deepest_worktree_holding(
+    root: &Path,
+    workspace: &Entity<Workspace>,
+    canonical_roots: &HashMap<PathBuf, PathBuf>,
+    cx: &App,
+) -> Option<usize> {
+    let project = workspace.read(cx).project().read(cx);
+    // A remote project's worktree paths name directories on another host.
+    if !project.is_local() {
+        return None;
+    }
+    project
+        .visible_worktrees(cx)
+        .flat_map(|worktree| {
+            let worktree_root = worktree.read(cx).abs_path();
+            let canonical = canonical_roots.get(worktree_root.as_ref()).cloned();
+            [Some(worktree_root.to_path_buf()), canonical]
+        })
+        .flatten()
+        .filter(|worktree_root| root.starts_with(worktree_root))
+        .map(|worktree_root| worktree_root.components().count())
+        .max()
+}
+
+/// Window activations recorded by Zeo itself, as increasing stamps.
+///
+/// gpui alone cannot rank windows while another application has focus on
+/// Wayland: `active_window` is then `None` and `window_stack` is unimplemented
+/// there, so the record is kept here, in the order Zeo's windows gained focus.
+#[derive(Default)]
+struct WindowActivationOrder {
+    next: u64,
+    stamps: HashMap<AnyWindowHandle, u64>,
+}
+
+impl Global for WindowActivationOrder {}
+
+/// Starts recording window activations for [`resolve_window_for_path`].
+/// Without it, resolution falls back to what gpui tracks on its own.
+pub(crate) fn track_window_activation(cx: &mut App) {
+    if cx.has_global::<WindowActivationOrder>() {
+        return;
+    }
+    cx.set_global(WindowActivationOrder::default());
+    cx.observe_new(
+        |_: &mut MultiWorkspace, window: Option<&mut Window>, cx: &mut Context<MultiWorkspace>| {
+            let Some(window) = window else {
+                return;
+            };
+            stamp_window(window.window_handle(), cx);
+            cx.observe_window_activation(window, |_, window, cx| {
+                if window.is_window_active() {
+                    stamp_window(window.window_handle(), cx);
+                }
+            })
+            .detach();
+        },
+    )
+    .detach();
+    cx.on_window_closed(|cx, closed| {
+        if cx.has_global::<WindowActivationOrder>() {
+            cx.global_mut::<WindowActivationOrder>()
+                .stamps
+                .retain(|window, _| window.window_id() != closed);
+        }
+    })
+    .detach();
+}
+
+fn stamp_window(window: AnyWindowHandle, cx: &mut App) {
+    if cx.has_global::<WindowActivationOrder>() {
+        let order = cx.global_mut::<WindowActivationOrder>();
+        order.next += 1;
+        let stamp = order.next;
+        order.stamps.insert(window, stamp);
+    }
+}
+
+/// The window activation order, as the app tracks it:
+/// - `App::active_window` — the window focused now, always the most recent;
+/// - [`WindowActivationOrder`] — Zeo's own record of when each window last
+///   gained focus, which still ranks windows while the browser has focus;
+/// - `App::window_stack` — the platform's front-to-back z-order (X11's
+///   `_NET_CLIENT_LIST_STACKING`, macOS, Windows), used for a window the record
+///   does not hold. It is `None` on Wayland and on the test platform.
+struct WindowRecency {
+    active: Option<AnyWindowHandle>,
+    stamps: HashMap<AnyWindowHandle, u64>,
+    stack: Vec<AnyWindowHandle>,
+}
+
+impl WindowRecency {
+    fn new(cx: &App) -> Self {
+        Self {
+            active: cx.active_window(),
+            stamps: cx
+                .try_global::<WindowActivationOrder>()
+                .map(|order| order.stamps.clone())
+                .unwrap_or_default(),
+            stack: cx.window_stack().unwrap_or_default(),
+        }
+    }
+
+    fn rank(&self, window: AnyWindowHandle) -> Recency {
+        if self.active == Some(window) {
+            return Recency::Active;
+        }
+        if let Some(stamp) = self.stamps.get(&window) {
+            return Recency::Stamped(*stamp);
+        }
+        self.stack
+            .iter()
+            .position(|stacked| *stacked == window)
+            .map_or(Recency::Unranked, |position| {
+                Recency::Stacked(Reverse(position))
+            })
+    }
+}
+
+/// Delivers `req` into the composer of the window [`resolve_window_for_path`]
+/// picks, sending the early answer on `answer` and resolving once insertion
+/// has ended.
+///
+/// The answer goes out as soon as the window and its agent panel resolve,
+/// before any thread load, because a new thread may take up to
+/// [`THREAD_LOAD_TIMEOUT`] to connect and the relay waits far less. A refusal
+/// (`no_window`, `ai_disabled`, `no_agent_panel`) is the answer itself, and
+/// the task then resolves `Ok`. A failure after the answer is shown in the
+/// target window as a workspace notification, logged at `warn`, and returned.
+///
+/// Nothing is ever sent to the agent: the mentions wait in the composer. The
+/// caller must detach the task, never drop it: dropping it cancels insertion.
+pub fn deliver_devtools_selection(
+    req: DevtoolsSelection,
+    app_state: Arc<AppState>,
+    answer: oneshot::Sender<Result<DeliveryOutcome, DeliveryError>>,
+    cx: &mut App,
+) -> Task<Result<()>> {
+    let canonical_roots = canonical_worktree_roots(app_state.fs.clone(), cx);
+    cx.spawn(async move |cx| {
+        let canonical_roots = canonical_roots.await;
+        // Resolved outside any window update: a leased window is skipped.
+        let prepared = cx
+            .update(|cx| resolve_window_for_path_with(&req.project_root, &canonical_roots, cx))
+            .and_then(|(window, workspace)| prepare_target(&req, window, workspace, cx));
+        let target = match prepared {
+            Ok(target) => target,
+            Err(error) => {
+                // The error's Display already names the project root.
+                log::info!(
+                    "devtools delivery: refused items={} reason={error}",
+                    req.items.len()
+                );
+                answer.send(Err(error)).ok();
+                return Ok(());
+            }
+        };
+        let outcome = target.outcome;
+        // A caller that stopped waiting (the bridge past its response deadline) has already
+        // told the page nothing arrived; inserting now would contradict that answer.
+        if answer.send(Ok(outcome)).is_err() {
+            log::info!(
+                "devtools delivery: answer not received, nothing inserted items={}",
+                req.items.len()
+            );
+            return Ok(());
+        }
+
+        let workspace = target.workspace.downgrade();
+        let window = target.window;
+        let project_root = req.project_root.clone();
+        let items = req.items.len();
+        match insert_into_composer(req, target, cx).await {
+            Ok(()) => {
+                log::info!(
+                    "devtools delivery: inserted project_root={} items={items} outcome={outcome:?}",
+                    project_root.display(),
+                );
+                Ok(())
+            }
+            Err(error) => {
+                // Every error built after the answer is a fixed message, so
+                // neither line can carry a path from outside the project.
+                log::warn!(
+                    "devtools delivery: insertion failed after the answer project_root={} \
+                     items={items} error={error:#}",
+                    project_root.display(),
+                );
+                let message = format!("Could not insert the selection: {error:#}");
+                notify(&workspace, window, InsertionFailed::id(), message, true, cx);
+                Err(error.context(format!(
+                    "devtools selection for {}: insertion failed after the answer",
+                    project_root.display()
+                )))
+            }
+        }
+    })
+}
+
+/// The id of the notification shown when an insertion fails after the answer
+/// went out (R9.11).
+pub(crate) struct InsertionFailed;
+
+impl InsertionFailed {
+    pub(crate) fn id() -> NotificationId {
+        NotificationId::unique::<Self>()
+    }
+}
+
+/// The id of the notification shown when a new thread's agent turns out not
+/// to accept the screenshot its answer left `pending`.
+pub(crate) struct ImageDropped;
+
+impl ImageDropped {
+    pub(crate) fn id() -> NotificationId {
+        NotificationId::unique::<Self>()
+    }
+}
+
+/// The id of the notification shown when the mentions went into a thread that
+/// is no longer in front, so the window was neither raised nor focused.
+pub(crate) struct AddedInBackground;
+
+impl AddedInBackground {
+    pub(crate) fn id() -> NotificationId {
+        NotificationId::unique::<Self>()
+    }
+}
+
+/// Makes the next insertion fail with `reason`, after the answer went out:
+/// nothing else can make insertion fail once the window resolves.
+#[cfg(test)]
+pub(crate) struct FailInsertion(pub String);
+
+#[cfg(test)]
+impl Global for FailInsertion {}
+
+/// Where the mentions go, decided before the answer.
+struct Target {
+    window: WindowHandle<MultiWorkspace>,
+    workspace: Entity<Workspace>,
+    panel: Entity<AgentPanel>,
+    composer: Composer,
+    outcome: DeliveryOutcome,
+    /// [`WindowActivationOrder`]'s next stamp once the target was raised: a
+    /// later stamp on another window means the user moved on during a wait.
+    activation_mark: Option<u64>,
+}
+
+enum Composer {
+    /// The active thread's composer, ready now.
+    Ready(Entity<MessageEditor>),
+    /// A conversation still connecting: the active one, or the new thread
+    /// opened for this delivery.
+    Connecting(WeakEntity<ConversationView>),
+    /// The panel could not open a new thread (it has no open project).
+    NoThread,
+}
+
+/// Decides which composer the mentions go to, opening a new thread when no
+/// thread is active, then brings the resolved workspace forward in its window,
+/// raises the window and shows the agent panel. Answers `no_agent_panel`
+/// without changing anything when there is no panel.
+fn prepare_target(
+    req: &DevtoolsSelection,
+    window: AnyWindowHandle,
+    workspace: Entity<Workspace>,
+    cx: &mut AsyncApp,
+) -> Result<Target, DeliveryError> {
+    let no_window = || DeliveryError::NoWindow {
+        project_root: req.project_root.clone(),
+    };
+    let window = window.downcast::<MultiWorkspace>().ok_or_else(no_window)?;
+    window
+        .update(cx, |multi_workspace, window_ref, cx| {
+            let panel = workspace.read(cx).panel::<AgentPanel>(cx).ok_or_else(|| {
+                DeliveryError::NoAgentPanel {
+                    project_root: req.project_root.clone(),
+                }
+            })?;
+            let (plan, outcome) = plan_composer(
+                panel.read(cx),
+                req.items.len(),
+                req.screenshot.is_some(),
+                cx,
+            );
+            // The new thread is opened before the panel is shown: showing a
+            // panel that holds nothing would open a draft, or schedule an
+            // initial terminal that later takes the view from the thread.
+            let composer = match plan {
+                Plan::Ready(editor) => Composer::Ready(editor),
+                Plan::Connecting(conversation) => Composer::Connecting(conversation),
+                Plan::NewThread => panel
+                    .update(cx, |panel, cx| {
+                        panel.open_new_thread_for_devtools(window_ref, cx)
+                    })
+                    .map_or(Composer::NoThread, |conversation| {
+                        Composer::Connecting(conversation.downgrade())
+                    }),
+            };
+            if multi_workspace.workspace() != &workspace {
+                multi_workspace.activate(workspace.clone(), None, window_ref, cx);
+            }
+            // Raise the window before touching the panel, as
+            // `open_agent_session` does: focusing a panel only moves focus
+            // inside Zeo, and the window would stay on whichever virtual
+            // desktop it was left on.
+            window_ref.activate_window();
+            if !panel.focus_handle(cx).contains_focused(window_ref, cx) {
+                workspace.update(cx, |workspace, cx| {
+                    workspace.toggle_panel_focus::<AgentPanel>(window_ref, cx);
+                });
+            }
+            let activation_mark = cx
+                .try_global::<WindowActivationOrder>()
+                .map(|order| order.next);
+            Ok(Target {
+                window,
+                workspace: workspace.clone(),
+                panel,
+                composer,
+                outcome,
+                activation_mark,
+            })
+        })
+        .map_err(|_| no_window())?
+}
+
+enum Plan {
+    Ready(Entity<MessageEditor>),
+    Connecting(WeakEntity<ConversationView>),
+    NewThread,
+}
+
+/// The composer `panel` offers, and the answer that goes with it: the active
+/// thread's, the active conversation still connecting, or a new thread — also
+/// when the active conversation failed to load.
+fn plan_composer(
+    panel: &AgentPanel,
+    items: usize,
+    has_screenshot: bool,
+    cx: &App,
+) -> (Plan, DeliveryOutcome) {
+    // Until the thread's agent connects, its image support is unknown.
+    let pending_image = if has_screenshot {
+        ImageState::Pending
+    } else {
+        ImageState::None
+    };
+    if let Some(editor) = panel
+        .active_thread_view(cx)
+        .map(|view| view.read(cx).message_editor.clone())
+    {
+        let image = if !has_screenshot {
+            ImageState::None
+        } else if editor.read(cx).supports_images() {
+            ImageState::Included
+        } else {
+            ImageState::SkippedUnsupported
+        };
+        return (
+            Plan::Ready(editor),
+            DeliveryOutcome::Inserted { items, image },
+        );
+    }
+    if let Some(conversation) = panel
+        .active_conversation_view()
+        .filter(|conversation| conversation.read(cx).is_loading())
+    {
+        return (
+            Plan::Connecting(conversation.downgrade()),
+            DeliveryOutcome::Inserted {
+                items,
+                image: pending_image,
+            },
+        );
+    }
+    (
+        Plan::NewThread,
+        DeliveryOutcome::OpenedNewThread {
+            items,
+            image: pending_image,
+        },
+    )
+}
+
+/// Everything after the answer: decodes the screenshot, waits for the
+/// composer when needed, inserts the element mentions and the screenshot, and
+/// raises the window and focuses the composer unless the user moved on during
+/// the wait.
+async fn insert_into_composer(
+    req: DevtoolsSelection,
+    target: Target,
+    cx: &mut AsyncApp,
+) -> Result<()> {
+    let Target {
+        window,
+        workspace,
+        panel,
+        composer,
+        outcome,
+        activation_mark,
+    } = target;
+    let DevtoolsSelection {
+        items, screenshot, ..
+    } = req;
+    let window_gone = || anyhow!("the target window closed");
+
+    // Decoded off the main thread and before any wait, so only the decoded
+    // image is held across it, and a bad image inserts nothing.
+    let screenshot = match screenshot {
+        Some(screenshot) => Some(
+            cx.background_executor()
+                .spawn(async move { decode_screenshot(screenshot) })
+                .await?,
+        ),
+        None => None,
+    };
+
+    let (editor, waited_for) = match composer {
+        Composer::Ready(editor) => (editor, None),
+        Composer::Connecting(conversation) => (
+            wait_for_composer(conversation.clone(), cx).await?,
+            Some(conversation),
+        ),
+        Composer::NoThread => anyhow::bail!("the agent panel could not open a new thread"),
+    };
+    // After a wait, the user may have moved on: to another thread in this
+    // panel, or to another Zeo window. Raising then would pull them back.
+    let in_front = match &waited_for {
+        None => true,
+        Some(conversation) => cx.update(|cx| {
+            let still_shown = panel
+                .read(cx)
+                .active_conversation_view()
+                .is_some_and(|active| active.downgrade() == *conversation);
+            still_shown && !other_window_activated(window.into(), activation_mark, cx)
+        }),
+    };
+
+    let include_image = match outcome.image() {
+        ImageState::Included => true,
+        ImageState::Pending => editor.read_with(cx, |editor, _| editor.supports_images()),
+        ImageState::SkippedUnsupported | ImageState::None => false,
+    };
+    let item_count = items.len();
+    let elements = items
+        .into_iter()
+        .map(|item| (dom_element_uri(&item), item.dom))
+        .collect::<Vec<_>>();
+
+    let (elements_resolved, image_inserted) = window
+        .update(cx, |_, window, cx| -> Result<_> {
+            #[cfg(test)]
+            if let Some(FailInsertion(reason)) = cx.try_global::<FailInsertion>() {
+                anyhow::bail!("{reason}");
+            }
+            let elements_resolved = editor.update(cx, |editor, cx| {
+                editor.insert_dom_elements(elements, window, cx)
+            })?;
+            let image_inserted = match screenshot.filter(|_| include_image) {
+                Some(image) => Some(editor.update(cx, |editor, cx| {
+                    editor.insert_image(image, SCREENSHOT_NAME.into(), window, cx)
+                })),
+                None => None,
+            };
+            if in_front {
+                // Raised again: a new thread may have loaded long enough for
+                // another window to take focus since `prepare_target`.
+                window.activate_window();
+                window.focus(&editor.focus_handle(cx), cx);
+            }
+            Ok((elements_resolved, image_inserted))
+        })
+        .map_err(|_| window_gone())??;
+
+    let workspace = workspace.downgrade();
+    if !in_front {
+        let title = waited_for
+            .as_ref()
+            .and_then(|conversation| {
+                conversation
+                    .read_with(cx, |view, cx| {
+                        view.root_thread(cx)
+                            .and_then(|thread| thread.read(cx).title())
+                    })
+                    .ok()
+                    .flatten()
+            })
+            .map_or_else(
+                || "a background thread".to_string(),
+                |title| format!("\"{title}\""),
+            );
+        notify(
+            &workspace,
+            window,
+            AddedInBackground::id(),
+            format!("Selection added to {title}"),
+            false,
+            cx,
+        );
+    }
+    if outcome.image() == ImageState::Pending && !include_image {
+        log::info!(
+            "devtools delivery: screenshot dropped, the new thread's agent does not accept images"
+        );
+        notify(
+            &workspace,
+            window,
+            ImageDropped::id(),
+            "The selection's screenshot was not inserted: this agent does not accept images"
+                .to_string(),
+            in_front,
+            cx,
+        );
+    }
+
+    let resolved = elements_resolved.await;
+    if resolved < item_count {
+        // Each failed mention already showed its own notification.
+        log::warn!(
+            "devtools delivery: element mentions did not all resolve items={item_count} \
+             resolved={resolved}"
+        );
+    }
+    if let Some(image_inserted) = image_inserted {
+        image_inserted.await;
+    }
+    Ok(())
+}
+
+/// Whether a Zeo window other than `target` was activated after `mark`, or is
+/// the active window now. A focus that left Zeo (to the browser) does not
+/// count: raising is what brings the user back.
+fn other_window_activated(target: AnyWindowHandle, mark: Option<u64>, cx: &App) -> bool {
+    if cx.active_window().is_some_and(|active| active != target) {
+        return true;
+    }
+    let (Some(mark), Some(order)) = (mark, cx.try_global::<WindowActivationOrder>()) else {
+        return false;
+    };
+    order
+        .stamps
+        .iter()
+        .any(|(window, stamp)| *window != target && *stamp > mark)
+}
+
+/// The name a devtools screenshot gets as a pasted-image mention.
+const SCREENSHOT_NAME: &str = "Screenshot";
+
+/// Waits, at most [`THREAD_LOAD_TIMEOUT`], for `conversation` to connect and
+/// show its root thread's composer.
+async fn wait_for_composer(
+    conversation: WeakEntity<ConversationView>,
+    cx: &mut AsyncApp,
+) -> Result<Entity<MessageEditor>> {
+    let deadline = cx.background_executor().timer(THREAD_LOAD_TIMEOUT);
+    before(deadline, composer_once_loaded(conversation, cx))
+        .await
+        .with_context(|| format!("the thread did not load within {THREAD_LOAD_TIMEOUT:?}"))?
+}
+
+async fn composer_once_loaded(
+    conversation: WeakEntity<ConversationView>,
+    cx: &mut AsyncApp,
+) -> Result<Entity<MessageEditor>> {
+    let (notified_tx, mut notified_rx) = futures::channel::mpsc::unbounded::<()>();
+    // Only a weak handle is held across the wait, so a conversation dropped
+    // while loading drops the observer and ends the wait.
+    let _observation = cx.update(|cx| {
+        let conversation = conversation.upgrade()?;
+        Some(cx.observe(&conversation, move |_, _| {
+            notified_tx.unbounded_send(()).ok();
+        }))
+    });
+    let closed = || anyhow!("the thread closed before it loaded");
+    loop {
+        let composer = conversation
+            .read_with(cx, |view, cx| {
+                if let Some(thread) = view.root_thread_view() {
+                    return Ok(Some(thread.read(cx).message_editor.clone()));
+                }
+                match view.load_error() {
+                    Some(error) => {
+                        // The full error can name the agent's command path,
+                        // so only its kind leaves this function.
+                        log::debug!("devtools delivery: the thread failed to load: {error}");
+                        Err(anyhow!(
+                            "the thread's agent did not load: {}",
+                            load_error_kind(error)
+                        ))
+                    }
+                    None => Ok(None),
+                }
+            })
+            .map_err(|_| closed())??;
+        if let Some(composer) = composer {
+            return Ok(composer);
+        }
+        if notified_rx.next().await.is_none() {
+            return Err(closed());
+        }
+    }
+}
+
+fn load_error_kind(error: &LoadError) -> &'static str {
+    match error {
+        LoadError::Unsupported { .. } => "its version is not supported",
+        LoadError::FailedToInstall(_) => "it failed to install",
+        LoadError::Exited { .. } => "it exited",
+        LoadError::Other(_) => "it failed to start",
+    }
+}
+
+/// The element mention for `item`. Wire lines and column are 1-based; the
+/// mention's are 0-based, so wire lines 3–5 become rows 2..=4.
+fn dom_element_uri(item: &DevtoolsSelectionItem) -> MentionUri {
+    let start = item.src.line.saturating_sub(1);
+    let end = item.src.end_line.saturating_sub(1).max(start);
+    MentionUri::DomElement {
+        abs_path: item.src.file.clone(),
+        line_range: start..=end,
+        column: item.src.column.saturating_sub(1),
+        component: item.component.clone(),
+        tag: item.dom.tag.clone(),
+    }
+}
+
+/// The screenshot as an image, from its base64 PNG; the base64 text is
+/// dropped here.
+fn decode_screenshot(screenshot: DevtoolsScreenshot) -> Result<Image> {
+    let bytes = base64::engine::general_purpose::STANDARD
+        .decode(screenshot.data_b64.as_bytes())
+        .context("the screenshot is not valid base64")?;
+    Ok(Image::from_bytes(ImageFormat::Png, bytes))
+}
+
+/// Shows `message` in `workspace`'s window, raising the window first when
+/// `raise` is set. A window already gone is logged, not shown.
+fn notify(
+    workspace: &WeakEntity<Workspace>,
+    window: WindowHandle<MultiWorkspace>,
+    id: NotificationId,
+    message: String,
+    raise: bool,
+    cx: &mut AsyncApp,
+) {
+    if raise {
+        window
+            .update(cx, |_, window, _| window.activate_window())
+            .log_err();
+    }
+    workspace
+        .update(cx, |workspace, cx| {
+            workspace.show_toast(Toast::new(id, message), cx);
+        })
+        .log_err();
+}
