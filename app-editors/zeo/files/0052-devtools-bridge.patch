+// Story 033, task 6.3 — the bridge's unix socket listener (R7.1, R7.2, R7.3, R7.4, R7.5, R7.8,
+// R7.9, R8.1, R8.3 over the wire, R8.4 "insert nothing", R8.6, R8.7; Q4). Wired in the crate
+// root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod listener_tests;
+//
+// Validation filter: `listener` (every test path is `listener_tests::…`).
+//
+// Contract (tasks.md 6.3 Objective; design.md §B1, §Validation rules). Assumed signatures — if
+// one moves, adjust the `use` and the two helpers `handler`/`result` only:
+//   - `crate::listener::start(dir: &Path, handler: Handler) -> anyhow::Result<Listener>`; the
+//     socket is `<dir>/devtools.sock`; the accept loop runs on its own executor, so a plain
+//     `#[test]` drives it with blocking std clients.
+//   - `crate::listener::Handler = Arc<dyn Fn(DevtoolsSelection) -> BoxFuture<'static,
+//     DevtoolsResult> + Send + Sync>` — called only for a request that passed validation.
+//   - `Listener::stop()` removes the socket; dropping a `Listener` does the same.
+//   - `crate::listener::socket_dir(xdg_runtime_dir: Option<&OsStr>) -> anyhow::Result<PathBuf>`
+//     resolves `<XDG_RUNTIME_DIR>/zeo` and refuses unset/relative values; it takes the value as a
+//     parameter so no test reads or writes the real `$XDG_RUNTIME_DIR`.
+//   - `crate::listener::peer_uid_matches(stream: &UnixStream, own_uid: u32) -> bool` reads
+//     `SO_PEERCRED`; a uid other than our own cannot be produced without root, so R7.5 is proved
+//     on this seam, with a real socket pair, in both directions.
+//   - `crate::protocol::DevtoolsResult` deserializes from the wire result (built here from JSON:
+//     `{ v, ok: true, outcome, items, image }`, the 2026-10-09 contract correction adding `image`).
+//
+// Every socket lives under a `tempfile` dir passed explicitly to `start`.
+//
+// Hostile halves first: a live owner's socket is not stolen AND a stale file is replaced; a
+// mismatched peer uid is refused AND the same uid is accepted; 4 concurrent are served AND the
+// 5th is closed; a line over 8 MiB is refused AND one just under is read; a silent client is
+// closed at 5 s AND a client that sends its line at 3 s is served.
+
+use std::ffi::OsStr;
+use std::fs;
+use std::io::{BufRead, BufReader, ErrorKind, Read, Write};
+use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+use std::os::unix::net::{UnixListener as StdUnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use futures::FutureExt as _;
+use serde_json::{Value, json};
+
+use crate::listener::{self, Handler};
+use crate::protocol::{DevtoolsResult, DevtoolsSelection};
+
+const MIB: usize = 1024 * 1024;
+
+struct Fixture {
+    _tmp: tempfile::TempDir,
+    /// The socket directory passed to `start` (`<tmp>/zeo`, not created yet).
+    dir: PathBuf,
+    /// A project root holding `src/App.tsx`.
+    root: PathBuf,
+    calls: Arc<AtomicUsize>,
+}
+
+fn fixture() -> Fixture {
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let base = fs::canonicalize(tmp.path()).expect("the temp dir canonicalizes");
+    let root = base.join("app");
+    fs::create_dir_all(root.join("src")).expect("the project tree");
+    fs::write(root.join("src/App.tsx"), "line 1\nline 2\nline 3\n").expect("App.tsx");
+    Fixture {
+        _tmp: tmp,
+        dir: base.join("zeo"),
+        root,
+        calls: Arc::new(AtomicUsize::new(0)),
+    }
+}
+
+fn socket(dir: &Path) -> PathBuf {
+    dir.join("devtools.sock")
+}
+
+fn result(items: usize) -> DevtoolsResult {
+    serde_json::from_value(json!({
+        "v": 1, "ok": true, "outcome": "inserted", "items": items, "image": "none"
+    }))
+    .expect("DevtoolsResult deserializes from the wire success result")
+}
+
+/// The only place this file names the handler's type.
+fn handler(calls: Arc<AtomicUsize>) -> Handler {
+    Arc::new(move |selection: DevtoolsSelection| {
+        let _ = selection;
+        calls.fetch_add(1, Ordering::SeqCst);
+        async move { result(1) }.boxed()
+    })
+}
+
+fn request(root: &Path, file: &Path) -> Value {
+    json!({
+        "v": 1,
+        "project_root": root.to_string_lossy(),
+        "page_url": "http://localhost:5173/",
+        "items": [{
+            "src": { "file": file.to_string_lossy(), "line": 2, "column": 1, "end_line": 3 },
+            "component": "App",
+            "dom": {
+                "tag": "button", "id": null, "classes": [], "text": "", "attrs": {},
+                "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+            }
+        }],
+        "screenshot": null
+    })
+}
+
+fn valid_line(root: &Path) -> Vec<u8> {
+    let mut line = serde_json::to_vec(&request(root, &root.join("src/App.tsx"))).expect("json");
+    line.push(b'\n');
+    line
+}
+
+fn connect(dir: &Path) -> UnixStream {
+    let stream = UnixStream::connect(socket(dir)).expect("the bridge accepts a connection");
+    stream
+        .set_read_timeout(Some(Duration::from_secs(10)))
+        .expect("read timeout");
+    stream
+}
+
+/// Reads the whole answer: exactly one JSON line, then EOF. `None` when the bridge closed the
+/// connection without answering.
+fn answer(stream: UnixStream) -> Option<Value> {
+    let mut reader = BufReader::new(stream);
+    let mut line = String::new();
+    match reader.read_line(&mut line) {
+        Ok(0) => return None,
+        Ok(_) => {}
+        Err(error) if error.kind() == ErrorKind::ConnectionReset => return None,
+        Err(error) => panic!("reading the answer failed: {error}"),
+    }
+    let mut rest = Vec::new();
+    reader
+        .read_to_end(&mut rest)
+        .expect("the bridge closes after its answer");
+    assert!(rest.is_empty(), "exactly one response line, then close");
+    Some(serde_json::from_str(line.trim_end()).expect("the answer is one JSON line"))
+}
+
+fn exchange(dir: &Path, bytes: &[u8]) -> Option<Value> {
+    let mut stream = connect(dir);
+    stream.write_all(bytes).expect("the request is written");
+    answer(stream)
+}
+
+fn error_code(answer: &Option<Value>) -> Option<&str> {
+    answer.as_ref()?.get("error")?.as_str()
+}
+
+fn is_ok(answer: &Option<Value>) -> bool {
+    answer
+        .as_ref()
+        .and_then(|value| value.get("ok"))
+        .and_then(Value::as_bool)
+        == Some(true)
+}
+
+/// True when the peer closed (EOF or reset) within `within`, with no byte of answer.
+fn closed_without_answer(stream: &mut UnixStream, within: Duration) -> bool {
+    stream.set_read_timeout(Some(within)).expect("read timeout");
+    let mut byte = [0u8; 1];
+    match stream.read(&mut byte) {
+        Ok(0) => true,
+        Ok(_) => false,
+        Err(error) => matches!(
+            error.kind(),
+            ErrorKind::ConnectionReset | ErrorKind::BrokenPipe
+        ),
+    }
+}
+
+fn own_uid(fx: &Fixture) -> u32 {
+    fs::metadata(&fx.root).expect("the root exists").uid()
+}
+
+// ---- R7.1 modes ----------------------------------------------------------------------------
+
+#[test]
+fn listener_creates_the_directory_0700_and_the_socket_0600() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+
+    let dir_mode = fs::metadata(&fx.dir)
+        .expect("the dir exists")
+        .permissions()
+        .mode();
+    assert_eq!(dir_mode & 0o777, 0o700, "directory mode");
+    let socket_meta = fs::symlink_metadata(socket(&fx.dir)).expect("the socket exists");
+    assert!(socket_meta.file_type().is_socket(), "a unix socket");
+    assert_eq!(
+        socket_meta.permissions().mode() & 0o777,
+        0o600,
+        "socket mode"
+    );
+}
+
+// Hostile: a directory that already exists with a wider mode is tightened, not trusted.
+#[test]
+fn listener_tightens_an_existing_directory_to_0700() {
+    let fx = fixture();
+    fs::create_dir_all(&fx.dir).expect("the dir");
+    fs::set_permissions(&fx.dir, fs::Permissions::from_mode(0o755)).expect("0755");
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let dir_mode = fs::metadata(&fx.dir).expect("the dir").permissions().mode();
+    assert_eq!(dir_mode & 0o777, 0o700);
+}
+
+// ---- R7.2 / R7.3 owner vs stale ------------------------------------------------------------
+
+// Hostile: a second Zeo must never take the socket a live one answers on.
+#[test]
+fn listener_leaves_a_live_owners_socket_alone() {
+    let fx = fixture();
+    let _owner = listener::start(&fx.dir, handler(fx.calls.clone())).expect("A listens");
+    let inode = fs::symlink_metadata(socket(&fx.dir))
+        .expect("A's socket")
+        .ino();
+
+    let second_calls = Arc::new(AtomicUsize::new(0));
+    let error = match listener::start(&fx.dir, handler(second_calls.clone())) {
+        Ok(_) => panic!("a second listener must not take a live owner's socket"),
+        Err(error) => error,
+    };
+    assert!(
+        format!("{error:#}").contains(&*socket(&fx.dir).to_string_lossy()),
+        "the refusal names the socket path: {error:#}"
+    );
+    assert_eq!(
+        fs::symlink_metadata(socket(&fx.dir))
+            .expect("still there")
+            .ino(),
+        inode,
+        "A's socket file is not replaced"
+    );
+    assert!(
+        is_ok(&exchange(&fx.dir, &valid_line(&fx.root))),
+        "A still answers"
+    );
+    assert_eq!(fx.calls.load(Ordering::SeqCst), 1, "A's handler served it");
+    assert_eq!(
+        second_calls.load(Ordering::SeqCst),
+        0,
+        "never the refused one"
+    );
+}
+
+// Converse: a socket file nobody answers on is replaced.
+#[test]
+fn listener_replaces_a_stale_socket_file() {
+    let fx = fixture();
+    fs::create_dir_all(&fx.dir).expect("the dir");
+    drop(StdUnixListener::bind(socket(&fx.dir)).expect("a socket that will go stale"));
+    assert!(
+        socket(&fx.dir).exists(),
+        "precondition: the stale file exists"
+    );
+    assert!(
+        UnixStream::connect(socket(&fx.dir)).is_err(),
+        "precondition: nothing answers"
+    );
+
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    assert!(is_ok(&exchange(&fx.dir, &valid_line(&fx.root))));
+}
+
+// GOTCHA sun_path: a path past 107 bytes fails with a message, never a truncated socket.
+#[test]
+fn listener_refuses_a_socket_path_longer_than_sun_path() {
+    let fx = fixture();
+    let long = fx.dir.join("d".repeat(110));
+    let result = listener::start(&long, handler(fx.calls));
+    assert!(result.is_err(), "a too-long socket path is refused");
+    assert!(
+        !socket(&long).exists(),
+        "no socket is bound at the long path"
+    );
+}
+
+// ---- R7.4 runtime dir ----------------------------------------------------------------------
+
+#[test]
+fn listener_resolves_the_socket_dir_only_from_an_absolute_runtime_dir() {
+    for refused in [
+        None,
+        Some(OsStr::new("")),
+        Some(OsStr::new("run/user/1000")),
+    ] {
+        let error = match listener::socket_dir(refused) {
+            Ok(dir) => panic!("{refused:?} must be refused, got {dir:?}"),
+            Err(error) => error,
+        };
+        assert!(
+            format!("{error:#}").contains("XDG_RUNTIME_DIR"),
+            "the reason names the variable: {error:#}"
+        );
+    }
+    let fx = fixture();
+    let runtime = fx.root.parent().expect("base").join("runtime");
+    let dir = listener::socket_dir(Some(runtime.as_os_str())).expect("an absolute dir");
+    assert_eq!(dir, runtime.join("zeo"));
+    assert!(!dir.exists(), "resolving creates nothing");
+}
+
+// ---- R7.5 peer uid -------------------------------------------------------------------------
+
+#[test]
+fn listener_refuses_a_peer_with_another_uid_and_accepts_our_own() {
+    let fx = fixture();
+    let uid = own_uid(&fx);
+    let (ours, _theirs) = UnixStream::pair().expect("a socket pair");
+    assert!(
+        !listener::peer_uid_matches(&ours, uid.wrapping_add(1)),
+        "a peer whose uid differs is refused"
+    );
+    assert!(
+        listener::peer_uid_matches(&ours, uid),
+        "our own uid is accepted"
+    );
+}
+
+// ---- R8.3 / R8.2 / R8.4 over the wire, R7.9 the loop survives -----------------------------
+
+#[test]
+fn listener_answers_bad_request_to_invalid_json_and_keeps_serving() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+
+    let refused = exchange(&fx.dir, b"this is not json\n");
+    assert_eq!(error_code(&refused), Some("bad_request"), "{refused:?}");
+    assert_eq!(
+        fx.calls.load(Ordering::SeqCst),
+        0,
+        "nothing reaches delivery"
+    );
+    assert!(
+        is_ok(&exchange(&fx.dir, &valid_line(&fx.root))),
+        "the next request is served"
+    );
+}
+
+#[test]
+fn listener_answers_unsupported_version_without_delivering() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let mut req = request(&fx.root, &fx.root.join("src/App.tsx"));
+    req["v"] = json!(2);
+    let mut line = serde_json::to_vec(&req).expect("json");
+    line.push(b'\n');
+    let refused = exchange(&fx.dir, &line);
+    assert_eq!(
+        error_code(&refused),
+        Some("unsupported_version"),
+        "{refused:?}"
+    );
+    assert_eq!(fx.calls.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn listener_answers_outside_project_and_inserts_nothing() {
+    let fx = fixture();
+    let outside = fx.root.parent().expect("base").join("secret.tsx");
+    fs::write(&outside, "x\n").expect("outside file");
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let mut line = serde_json::to_vec(&request(&fx.root, &outside)).expect("json");
+    line.push(b'\n');
+    let refused = exchange(&fx.dir, &line);
+    assert_eq!(error_code(&refused), Some("outside_project"), "{refused:?}");
+    assert_eq!(
+        fx.calls.load(Ordering::SeqCst),
+        0,
+        "the handler is never called"
+    );
+}
+
+// ---- R8.1 line size ------------------------------------------------------------------------
+
+#[test]
+fn listener_answers_too_large_past_8_mib_and_keeps_serving() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+
+    let stream = connect(&fx.dir);
+    let mut writer = stream.try_clone().expect("a writer half");
+    let flood = thread::spawn(move || {
+        // Exactly 8 MiB + 1 bytes and no newline: the most the bridge may read.
+        let _ = writer.write_all(&vec![b'x'; 8 * MIB + 1]);
+    });
+    let refused = answer(stream);
+    let _ = flood.join();
+    assert_eq!(error_code(&refused), Some("too_large"), "{refused:?}");
+    assert_eq!(fx.calls.load(Ordering::SeqCst), 0);
+    assert!(
+        is_ok(&exchange(&fx.dir, &valid_line(&fx.root))),
+        "the loop survives a flood"
+    );
+}
+
+// Converse: a valid request padded to just under 8 MiB is read and served.
+#[test]
+fn listener_reads_a_line_just_under_8_mib() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let mut line =
+        serde_json::to_vec(&request(&fx.root, &fx.root.join("src/App.tsx"))).expect("json");
+    line.resize(8 * MIB - 1, b' ');
+    line.push(b'\n');
+
+    let stream = connect(&fx.dir);
+    let mut writer = stream.try_clone().expect("a writer half");
+    let sender = thread::spawn(move || writer.write_all(&line));
+    let served = answer(stream);
+    sender
+        .join()
+        .expect("the writer thread")
+        .expect("the line is written");
+    assert!(is_ok(&served), "{served:?}");
+}
+
+// ---- R8.6 read deadline --------------------------------------------------------------------
+
+#[test]
+fn listener_closes_a_connection_without_a_full_line_after_5_seconds() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let mut stream = connect(&fx.dir);
+    stream.write_all(b"{\"v\":1,").expect("a partial line");
+
+    let started = Instant::now();
+    assert!(
+        closed_without_answer(&mut stream, Duration::from_secs(9)),
+        "the bridge closes a silent connection without answering"
+    );
+    let elapsed = started.elapsed();
+    assert!(
+        elapsed >= Duration::from_millis(4500),
+        "not before the deadline: {elapsed:?}"
+    );
+    assert!(
+        elapsed <= Duration::from_secs(8),
+        "at the deadline: {elapsed:?}"
+    );
+    assert_eq!(fx.calls.load(Ordering::SeqCst), 0);
+}
+
+// Converse: a slow client inside the deadline is served.
+#[test]
+fn listener_serves_a_line_that_arrives_before_the_deadline() {
+    let fx = fixture();
+    let _listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    let mut stream = connect(&fx.dir);
+    thread::sleep(Duration::from_secs(3));
+    stream
+        .write_all(&valid_line(&fx.root))
+        .expect("the line, late but in time");
+    assert!(is_ok(&answer(stream)));
+}
+
+// ---- R8.7 concurrency ----------------------------------------------------------------------
+
+#[test]
+fn listener_serves_four_concurrent_connections_and_closes_the_fifth() {
+    let fx = fixture();
+    let (release, released) = smol::channel::unbounded::<()>();
+    let in_flight = Arc::new(AtomicUsize::new(0));
+    let blocking: Handler = {
+        let in_flight = in_flight.clone();
+        Arc::new(move |_selection: DevtoolsSelection| {
+            let released = released.clone();
+            let in_flight = in_flight.clone();
+            async move {
+                in_flight.fetch_add(1, Ordering::SeqCst);
+                let _ = released.recv().await;
+                result(1)
+            }
+            .boxed()
+        })
+    };
+    let _listener = listener::start(&fx.dir, blocking).expect("it listens");
+
+    let held: Vec<UnixStream> = (0..4)
+        .map(|_| {
+            let mut stream = connect(&fx.dir);
+            stream.write_all(&valid_line(&fx.root)).expect("a request");
+            stream
+        })
+        .collect();
+    let deadline = Instant::now() + Duration::from_secs(4);
+    while in_flight.load(Ordering::SeqCst) < 4 && Instant::now() < deadline {
+        thread::sleep(Duration::from_millis(20));
+    }
+    assert_eq!(
+        in_flight.load(Ordering::SeqCst),
+        4,
+        "precondition: four are being served"
+    );
+
+    let mut fifth = UnixStream::connect(socket(&fx.dir)).expect("the kernel accepts the fifth");
+    let _ = fifth.write_all(&valid_line(&fx.root));
+    let started = Instant::now();
+    assert!(
+        closed_without_answer(&mut fifth, Duration::from_secs(3)),
+        "the fifth is closed without an answer"
+    );
+    assert!(
+        started.elapsed() < Duration::from_secs(2),
+        "at once, not at the 5 s read deadline"
+    );
+    assert_eq!(
+        in_flight.load(Ordering::SeqCst),
+        4,
+        "the fifth never reached delivery"
+    );
+
+    for _ in 0..5 {
+        release.try_send(()).expect("a release token");
+    }
+    for stream in held {
+        assert!(is_ok(&answer(stream)), "each of the four gets its answer");
+    }
+    assert!(
+        is_ok(&exchange(&fx.dir, &valid_line(&fx.root))),
+        "a slot freed is served again"
+    );
+}
+
+// ---- R7.8 stop and drop --------------------------------------------------------------------
+
+#[test]
+fn listener_stop_removes_the_socket() {
+    let fx = fixture();
+    #[allow(unused_mut)]
+    let mut listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    assert!(socket(&fx.dir).exists(), "precondition");
+    listener.stop();
+    assert!(!socket(&fx.dir).exists(), "stop removes the socket file");
+    assert!(
+        UnixStream::connect(socket(&fx.dir)).is_err(),
+        "nothing answers"
+    );
+}
+
+#[test]
+fn listener_drop_removes_the_socket() {
+    let fx = fixture();
+    let listener = listener::start(&fx.dir, handler(fx.calls.clone())).expect("it listens");
+    assert!(socket(&fx.dir).exists(), "precondition");
+    drop(listener);
+    assert!(!socket(&fx.dir).exists(), "drop removes the socket file");
+}
