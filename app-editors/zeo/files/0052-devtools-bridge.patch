+#[test]
+fn protocol_holds_component_tag_and_id_to_their_lengths() {
+    let fx = fixture();
+    let cases: [(&str, &str, usize); 3] = [
+        ("component", "", 128),
+        ("tag", "dom", 64),
+        ("id", "dom", 128),
+    ];
+    for (field, parent, limit) in cases {
+        for (len, expected) in [(limit + 1, "bad_request"), (limit, "accepted")] {
+            let req = request_with_item(&fx, |one| {
+                let value = json!("a".repeat(len));
+                if parent.is_empty() {
+                    one[field] = value;
+                } else {
