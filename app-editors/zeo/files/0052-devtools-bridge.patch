+        cx.spawn(async move |_, cx| {
+            let buffer = buffer.await.with_context(|| {
+                format!("opening {} for an element mention", abs_path.display())
+            })?;
+            // Opening a path that is not on disk succeeds with a new, empty
+            // buffer, which would send the agent empty source in silence.
+            let content = buffer.read_with(cx, |buffer, _| {
+                if !buffer.file().is_some_and(|file| file.disk_state().exists()) {
