+use settings::{RegisterSetting, Settings, SettingsContent};
+
+/// The `devtools_bridge` settings section.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, RegisterSetting)]
+pub struct DevtoolsBridgeSettings {
+    /// Whether the bridge listens on its socket. Default: `true`.
+    pub enabled: bool,
+}
+
+impl Settings for DevtoolsBridgeSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        let enabled = content
+            .devtools_bridge
+            .as_ref()
+            .and_then(|bridge| bridge.enabled)
+            // `assets/settings/default.json` says `true` too; this keeps the default when an
+            // embedder's defaults lack the section.
+            .unwrap_or(true);
+        Self { enabled }
+    }
+}
diff --git a/crates/devtools_bridge/src/setting_tests.rs b/crates/devtools_bridge/src/setting_tests.rs
new file mode 100644
index 0000000..96d4f62
--- /dev/null
+++ b/crates/devtools_bridge/src/setting_tests.rs
@@ -0,0 +1,145 @@
+// Story 033, task 6.4 — the `devtools_bridge.enabled` setting and app lifecycle (R7.6, R7.7,
+// R7.8, R7.9, R7.2 at app level). Wired in the crate root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod setting_tests;
+//
+// Validation filter: `setting` (every test path is `setting_tests::…`).
+//
+// Contract (tasks.md 6.4 Objective; design.md §B1 Interface). Assumed signatures — adjust the
+// `use` only:
+//   - `crate::DevtoolsBridgeSettings` implements `settings::Settings`, with `pub enabled: bool`,
+//     default `true`, read from the user settings key `devtools_bridge.enabled`.
+//   - `crate::init_in(dir: PathBuf, app_state: Arc<workspace::AppState>, cx: &mut App)` is
+//     `init` with the socket directory passed in; `init(app_state, cx)` is
+//     `init_in(<XDG_RUNTIME_DIR>/zeo, …)`. Tests never touch the real `$XDG_RUNTIME_DIR`.
+//
+// Hostile halves: quitting removes the socket this Zeo created AND leaves one another process
+// owns; turning the setting off removes the socket AND turning it on again (or re-saving it as
+// on) leaves exactly one working listener.
+
+use std::os::unix::net::{UnixListener as StdUnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use gpui::{TestAppContext, UpdateGlobal as _};
+use settings::{Settings as _, SettingsStore};
+
+use crate::{DevtoolsBridgeSettings, init_in};
+
+fn socket(dir: &Path) -> PathBuf {
+    dir.join("devtools.sock")
+}
+
+fn answers(dir: &Path) -> bool {
+    UnixStream::connect(socket(dir)).is_ok()
+}
+
+fn start(cx: &mut TestAppContext) -> (tempfile::TempDir, PathBuf) {
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let dir = tmp.path().join("zeo");
+    start_in(dir.clone(), cx);
+    (tmp, dir)
+}
+
+fn start_in(dir: PathBuf, cx: &mut TestAppContext) {
+    let app_state: Arc<workspace::AppState> = cx.update(workspace::AppState::test);
+    cx.update(|cx| init_in(dir, app_state, cx));
+    cx.run_until_parked();
+}
+
+fn set_user_settings(json: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            let _ = store.set_user_settings(json, cx);
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn set_enabled(enabled: bool, cx: &mut TestAppContext) {
+    set_user_settings(
+        &format!(r#"{{ "devtools_bridge": {{ "enabled": {enabled} }} }}"#),
+        cx,
+    );
+    assert_eq!(
+        cx.update(|cx| DevtoolsBridgeSettings::get_global(cx).enabled),
+        enabled,
+        "precondition: the setting parsed"
+    );
+}
+
+#[gpui::test]
+async fn setting_defaults_to_enabled_and_listens(cx: &mut TestAppContext) {
+    let (_tmp, dir) = start(cx);
+    assert!(
+        cx.update(|cx| DevtoolsBridgeSettings::get_global(cx).enabled),
+        "devtools_bridge.enabled defaults to true"
+    );
+    assert!(answers(&dir), "the bridge listens at startup");
+}
+
+// R7.6 then R7.7.
+#[gpui::test]
+async fn setting_false_removes_the_socket_and_true_listens_again(cx: &mut TestAppContext) {
+    let (_tmp, dir) = start(cx);
+    assert!(answers(&dir), "precondition: listening");
+
+    set_enabled(false, cx);
+    assert!(!socket(&dir).exists(), "turning it off removes the socket");
+    assert!(!answers(&dir), "and nothing answers");
+
+    set_enabled(true, cx);
+    assert!(answers(&dir), "turning it back on listens again");
+}
+
+// Hostile: a settings change that keeps it on must not tear the live listener down, nor have it
+// refuse itself as "another Zeo".
+#[gpui::test]
+async fn setting_saved_as_on_again_keeps_one_working_listener(cx: &mut TestAppContext) {
+    let (_tmp, dir) = start(cx);
+    set_user_settings(r#"{"devtools_bridge":{"enabled":true}}"#, cx);
+    set_user_settings(r#"{ "devtools_bridge" : { "enabled" : true } }"#, cx);
+    assert!(answers(&dir), "still listening after two on-to-on changes");
+}
+
+// R7.8.
+#[gpui::test]
+async fn setting_quit_removes_the_socket_it_created(cx: &mut TestAppContext) {
+    let (_tmp, dir) = start(cx);
+    assert!(socket(&dir).exists(), "precondition");
+    cx.quit();
+    assert!(!socket(&dir).exists(), "quitting removes the socket");
+}
+
+// Hostile (R7.2 + R7.8): a socket another live process answers on is neither taken at startup
+// nor removed at quit.
+#[gpui::test]
+async fn setting_quit_leaves_a_socket_owned_by_another(cx: &mut TestAppContext) {
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let dir = tmp.path().join("zeo");
+    std::fs::create_dir_all(&dir).expect("the dir");
+    let _owner = StdUnixListener::bind(socket(&dir)).expect("another Zeo's socket");
+    start_in(dir.clone(), cx);
+    cx.quit();
+    assert!(
+        socket(&dir).exists(),
+        "the owner's socket file is left alone"
+    );
+    assert!(answers(&dir), "and the owner still answers");
+}
+
+// R7.9: a bridge that cannot listen keeps the app working and its setting toggleable.
+#[gpui::test]
+async fn setting_a_bridge_that_cannot_listen_keeps_the_app_working(cx: &mut TestAppContext) {
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let blocker = tmp.path().join("not-a-dir");
+    std::fs::write(&blocker, "a regular file where the directory should be").expect("file");
+    start_in(blocker.join("zeo"), cx);
+    set_enabled(false, cx);
+    set_enabled(true, cx);
+    assert!(
+        cx.update(|cx| DevtoolsBridgeSettings::get_global(cx).enabled),
+        "settings still read"
+    );
+}
diff --git a/crates/devtools_bridge/src/wiring.rs b/crates/devtools_bridge/src/wiring.rs
new file mode 100644
index 0000000..5c83827
--- /dev/null
+++ b/crates/devtools_bridge/src/wiring.rs
@@ -0,0 +1,286 @@
+//! Hands a validated selection to `agent_ui`'s delivery and turns its early answer into the
+//! wire result.
+//!
+//! The listener runs on the bridge's own thread, while delivery needs the app: [`Relay`] carries
+//! each request to a foreground task over a bounded channel, so the bridge thread only ever
+//! awaits a `oneshot` and never blocks on the main thread.
+//!
+//! Zeo never writes `timeout` or `unreachable` on the wire: those belong to the relay. A request
+//! Zeo cannot answer is closed without an answer, and the relay reports it.
+
+use std::path::PathBuf;
+use std::pin::pin;
+use std::sync::Arc;
+
+use agent_ui::devtools_delivery::{
+    self as delivery, DeliveryError, canonical_worktree_roots, deliver_devtools_selection,
+    resolve_window_for_path_with,
+};
+use agent_ui::{DomRect, DomSummary};
+use futures::FutureExt as _;
+use futures::channel::oneshot;
+use futures::future::{self, Either};
+use gpui::{App, Task};
+use smol::channel::TrySendError;
+use workspace::AppState;
+
+use crate::listener::{MAX_CONNECTIONS, RequestHandler};
+use crate::protocol::{
+    DeliveryOutcome, DevtoolsError, DevtoolsResult, DevtoolsSelection, ImageState, Screenshot,
+    SelectionItem,
+};
+
+/// Delivers `req` into the agent thread of the window holding its project root, and resolves
+/// to the wire answer as soon as delivery has found that window and its agent panel. Insertion
+/// goes on after the answer, in a detached task, so a thread that is still loading never holds
+/// the answer back past the relay's 10 s budget. `None` means no answer is to be written.
+///
+/// Logs one `devtools_bridge event=select` line per request: `info` on success, `warn` on a
+/// refusal. The line carries counts, codes and a window id only, never page content or a path.
+pub fn handle_selection(
+    req: DevtoolsSelection,
+    app_state: Arc<AppState>,
+    cx: &mut App,
+) -> Task<Option<DevtoolsResult>> {
+    let items = req.items.len();
+    let project_root = PathBuf::from(&req.project_root);
+    // Only to name the target window in the log line; it runs alongside delivery's own copy.
+    let canonical_roots = canonical_worktree_roots(app_state.fs.clone(), cx);
+    let (answer_tx, answer_rx) = oneshot::channel();
+    let delivery = deliver_devtools_selection(to_delivery(req), app_state, answer_tx, cx);
+    // Detached, never dropped: dropping it would cancel the insertion that follows the answer.
+    cx.foreground_executor()
+        .spawn(async move {
+            // Delivery has already warned, with its context, about every failure it returns.
+            if let Err(error) = delivery.await {
+                log::debug!("devtools_bridge event=delivery_failed reason=\"{error:#}\"");
+            }
+        })
+        .detach();
+
+    cx.spawn(async move |cx| match answer_rx.await {
+        Ok(Ok(outcome)) => {
+            let canonical_roots = canonical_roots.await;
+            // Resolved outside any window update, as `resolve_window_for_path_with` requires.
+            let window = cx
+                .update(|cx| resolve_window_for_path_with(&project_root, &canonical_roots, cx))
+                .ok()
+                .map(|(window, _)| window.window_id().as_u64());
+            let result = to_wire_success(outcome);
+            log_select(items, &result, window);
+            Some(result)
+        }
+        Ok(Err(error)) => {
+            let result = DevtoolsResult::from(to_wire_error(&error));
+            log_select(items, &result, None);
+            Some(result)
+        }
+        // Delivery answers before it finishes; a dropped sender means the app is going away.
+        Err(oneshot::Canceled) => {
+            log_unanswered(items, "shutting_down");
+            None
+        }
+    })
+}
+
+/// Carries requests from the bridge thread to a foreground task for the app's whole life.
+/// Dropping it ends that task, and every later request is closed without an answer.
+pub struct Relay {
+    requests: smol::channel::Sender<Request>,
+    _deliveries: Task<()>,
+}
+
+type Request = (DevtoolsSelection, oneshot::Sender<DevtoolsResult>);
+
+/// The listener serves at most this many connections, so a fuller queue means the main thread
+/// has fallen behind requests whose connections already gave up.
+const RELAY_CAPACITY: usize = MAX_CONNECTIONS;
+
+impl Relay {
+    pub fn new(app_state: Arc<AppState>, cx: &mut App) -> Self {
+        let (requests, incoming) = smol::channel::bounded::<Request>(RELAY_CAPACITY);
+        let deliveries = cx.spawn(async move |cx| {
+            while let Ok((selection, reply)) = incoming.recv().await {
+                let items = selection.items.len();
+                // The listener dropped its end at its response deadline: delivering now would
+                // insert a selection the page was never told about.
+                if reply.is_canceled() {
+                    log_unanswered(items, "timeout");
+                    continue;
+                }
+                let answer = cx.update(|cx| handle_selection(selection, app_state.clone(), cx));
+                // One task per request, so a slow answer never delays the next request.
+                cx.foreground_executor()
+                    .spawn(answer_or_abandon(answer, reply, items))
+                    .detach();
+            }
+        });
+        Self {
+            requests,
+            _deliveries: deliveries,
+        }
+    }
+
+    /// The listener's handler: queues the request for the foreground without waiting for room,
+    /// and awaits its answer.
+    pub fn handler(&self) -> RequestHandler {
+        let requests = self.requests.clone();
+        RequestHandler::new(move |selection| {
+            let items = selection.items.len();
+            let (reply, answer) = oneshot::channel();
+            let queued = requests.try_send((selection, reply));
+            async move {
+                match queued {
+                    Ok(()) => answer.await.ok(),
+                    Err(TrySendError::Full(_)) => {
+                        log_unanswered(items, "busy");
+                        None
+                    }
+                    Err(TrySendError::Closed(_)) => {
+                        log_unanswered(items, "shutting_down");
+                        None
+                    }
+                }
+            }
+            .boxed()
+        })
+    }
+}
+
+/// Sends `answer` on `reply`, unless the listener gives up first. Giving up drops `answer`,
+/// which drops delivery's receiver, so delivery inserts nothing.
+async fn answer_or_abandon(
+    answer: Task<Option<DevtoolsResult>>,
+    mut reply: oneshot::Sender<DevtoolsResult>,
+    items: usize,
+) {
+    let answered = match future::select(pin!(answer), pin!(reply.cancellation())).await {
+        Either::Left((answered, _)) => Some(answered),
+        Either::Right(((), _)) => None,
+    };
+    match answered {
+        // The listener may still drop its end between the two awaits; nobody is left to tell,
+        // and the select line is already logged.
+        Some(Some(result)) => {
+            reply.send(result).ok();
+        }
+        // `handle_selection` has logged why it does not answer; dropping `reply` closes the
+        // connection without one.
+        Some(None) => {}
+        None => log_unanswered(items, "timeout"),
+    }
+}
+
+/// The select line for a request closed without an answer.
+fn log_unanswered(items: usize, outcome: &str) {
+    log_select_line(log::Level::Warn, items, outcome, None);
+}
+
+fn log_select(items: usize, result: &DevtoolsResult, window: Option<u64>) {
+    match result {
+        DevtoolsResult::Success { outcome, .. } => {
+            log_select_line(log::Level::Info, items, outcome.code(), window)
+        }
+        DevtoolsResult::Failure { error, .. } => {
+            log_select_line(log::Level::Warn, items, error.code(), window)
+        }
+    }
+}
+
+/// The R12.2 line. Only fixed codes, counts and a window id go in, so nothing from the page
+/// and no path can reach it (R12.3).
+fn log_select_line(level: log::Level, items: usize, outcome: &str, window: Option<u64>) {
+    let window = window.map_or_else(|| "none".to_string(), |window| window.to_string());
+    log::log!(
+        level,
+        "devtools_bridge event=select items={items} outcome={outcome} window={window}"
+    );
+}
+
+fn to_wire_success(outcome: delivery::DeliveryOutcome) -> DevtoolsResult {
+    DevtoolsResult::Success {
+        outcome: match outcome {
+            delivery::DeliveryOutcome::Inserted { .. } => DeliveryOutcome::Inserted,
+            delivery::DeliveryOutcome::OpenedNewThread { .. } => DeliveryOutcome::OpenedNewThread,
+        },
+        items: outcome.items(),
+        image: to_wire_image(outcome.image()),
+    }
+}
+
+/// The wire code only: `DeliveryError`'s `Display` names the project root, and the wire
+/// `message` is Zeo's fixed sentence for the code.
+fn to_wire_error(error: &DeliveryError) -> DevtoolsError {
+    match error {
+        DeliveryError::NoWindow { .. } => DevtoolsError::NoWindow,
+        DeliveryError::NoAgentPanel { .. } => DevtoolsError::NoAgentPanel,
+        DeliveryError::AiDisabled { .. } => DevtoolsError::AiDisabled,
+    }
+}
+
+fn to_wire_image(image: delivery::ImageState) -> ImageState {
+    match image {
+        delivery::ImageState::Included => ImageState::Included,
+        delivery::ImageState::SkippedUnsupported => ImageState::SkippedUnsupported,
+        delivery::ImageState::None => ImageState::None,
+        delivery::ImageState::Pending => ImageState::Pending,
+    }
+}
+
+fn to_delivery(req: DevtoolsSelection) -> delivery::DevtoolsSelection {
+    delivery::DevtoolsSelection {
+        project_root: PathBuf::from(req.project_root),
+        page_url: req.page_url,
+        items: req.items.into_iter().map(to_delivery_item).collect(),
+        screenshot: req.screenshot.map(
+            |Screenshot {
+                 mime,
+                 data_b64,
+                 w,
+                 h,
+             }| delivery::DevtoolsScreenshot {
+                mime,
+                data_b64,
+                w,
+                h,
+            },
+        ),
+    }
+}
+
+fn to_delivery_item(item: SelectionItem) -> delivery::DevtoolsSelectionItem {
+    let SelectionItem {
+        src,
+        component,
+        dom,
+    } = item;
+    delivery::DevtoolsSelectionItem {
+        src: delivery::DevtoolsSource {
+            file: PathBuf::from(src.file),
+            line: saturating_u32(src.line),
+            column: saturating_u32(src.column),
+            end_line: saturating_u32(src.end_line),
+        },
+        component,
+        dom: DomSummary {
+            tag: dom.tag,
+            id: dom.id,
+            classes: dom.classes,
+            text: dom.text,
+            attrs: dom.attrs.into_iter().collect(),
+            styles: dom.styles.into_iter().collect(),
+            rect: DomRect {
+                x: dom.rect.x,
+                y: dom.rect.y,
+                w: dom.rect.w,
+                h: dom.rect.h,
+            },
+        },
+    }
+}
+
+/// Validation bounds lines from below only; no source file has 2^32 lines, so clamping loses
+/// nothing a mention could point at.
+fn saturating_u32(value: u64) -> u32 {
+    u32::try_from(value).unwrap_or(u32::MAX)
+}
diff --git a/crates/devtools_bridge/src/wiring_tests.rs b/crates/devtools_bridge/src/wiring_tests.rs
new file mode 100644
index 0000000..796efb7
--- /dev/null
+++ b/crates/devtools_bridge/src/wiring_tests.rs
@@ -0,0 +1,242 @@
+// Story 033, task 8.3 — bridge → delivery wiring: the listener's handler maps a delivery to the
+// wire `DevtoolsResult` and logs one line (R9.3 at the wire, R12.2, R12.3; Q4, Q15). Wired in
+// the crate root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod wiring_tests;
+//
+// Validation filter: `wiring` (every test path is `wiring_tests::…`).
+//
+// Contract (tasks.md 8.3 Objective; design.md §Data Models with the 2026-10-09 corrections:
+// success carries `image: included|skipped_unsupported|none`; Zeo writes the English `message`
+// of the errors it produces, `no_window` reading exactly "No Zeo window has this project open").
+// Assumed signature — adjust the `use` only:
+//   `crate::wiring::handle_selection(req: DevtoolsSelection, app_state: Arc<AppState>,
+//    cx: &mut App) -> Task<DevtoolsResult>` — the handler body the listener runs on the
+//   foreground; `DevtoolsResult` serializes to the wire result.
+//
+// Dev-dependencies this needs (all workspace crates, no third-party addition): agent_ui,
+// acp_thread, agent, language_model, project, workspace, fs, gpui (each with "test-support"),
+// serde_json, log.
+//
+// Logs are captured by a process-wide `log` logger installed once for this test binary.
+// Hostile first: a window over `/p/app2` exists and must not be taken for root `/p/app`; its
+// path, outside the project root, must not reach the log either.
+
+use std::path::Path;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use acp_thread::StubAgentConnection;
+use agent_ui::AgentPanel;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::{Value, json};
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::protocol::DevtoolsSelection;
+use crate::wiring::handle_selection;
+
+const PNG_1X1: &str = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==";
+
+struct Capture(Mutex<Vec<(log::Level, String)>>);
+
+impl log::Log for Capture {
+    fn enabled(&self, _: &log::Metadata) -> bool {
+        true
+    }
+    fn log(&self, record: &log::Record) {
+        if let Ok(mut lines) = self.0.lock() {
+            lines.push((record.level(), format!("{}", record.args())));
+        }
+    }
+    fn flush(&self) {}
+}
+
+fn capture() -> &'static Capture {
+    static CAPTURE: OnceLock<&'static Capture> = OnceLock::new();
+    CAPTURE.get_or_init(|| {
+        let capture: &'static Capture = Box::leak(Box::new(Capture(Mutex::new(Vec::new()))));
+        log::set_logger(capture).expect("no other logger is installed in this test binary");
+        log::set_max_level(log::LevelFilter::Trace);
+        capture
+    })
+}
+
+fn lines() -> Vec<(log::Level, String)> {
+    capture()
+        .0
+        .lock()
+        .map(|lines| lines.clone())
+        .unwrap_or_default()
+}
+
+fn select_lines(outcome: &str) -> Vec<(log::Level, String)> {
+    lines()
+        .into_iter()
+        .filter(|(_, line)| {
+            line.contains("devtools_bridge")
+                && line.contains("event=select")
+                && line.contains(&format!("outcome={outcome}"))
+        })
+        .collect()
+}
+
+// Only the lines logged from `since` on are scanned: the fixture's own project scan logs
+// its worktree paths at trace level before the request is handled.
+fn assert_no_page_content_logged(since: usize, forbidden: &[&str]) {
+    for (_, line) in lines().into_iter().skip(since) {
+        for needle in forbidden {
+            assert!(
+                !line.contains(needle),
+                "R12.3: `{needle}` was logged in: {line}"
+            );
+        }
+    }
+}
+
+fn init(cx: &mut TestAppContext) {
+    capture();
+    agent_ui::test_support::init_test(cx);
+    cx.update(|cx| {
+        agent_ui::thread_metadata_store::ThreadMetadataStore::init_global(cx);
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(
+        "/p",
+        json!({
+            "app": { "src": { "App.tsx": "line 1\nline 2\nline 3\nline 4\n" } },
+            "app2": { "src": { "App.tsx": "other\n" } }
+        }),
+    )
+    .await;
+    fs
+}
+
+async fn window(
+    fs: &Arc<FakeFs>,
+    root: &str,
+    cx: &mut TestAppContext,
+) -> (Entity<Workspace>, VisualTestContext) {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    agent_ui::test_support::open_thread_with_connection(
+        &panel,
+        StubAgentConnection::new(),
+        &mut vcx,
+    );
+    (workspace, vcx)
+}
+
+fn selection(items: usize, screenshot: bool) -> DevtoolsSelection {
+    let item = json!({
+        "src": { "file": "/p/app/src/App.tsx", "line": 2, "column": 1, "end_line": 3 },
+        "component": "App",
+        "dom": {
+            "tag": "button", "id": null, "classes": ["primary"],
+            "text": "SECRET-DOM-TEXT", "attrs": { "aria-label": "SECRET-ATTR-VALUE" },
+            "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+        }
+    });
+    let screenshot = if screenshot {
+        json!({ "mime": "image/png", "data_b64": PNG_1X1, "w": 1, "h": 1 })
+    } else {
+        Value::Null
+    };
+    serde_json::from_value(json!({
+        "v": 1,
+        "project_root": "/p/app",
+        "page_url": "http://localhost:5173/",
+        "items": (0..items).map(|_| item.clone()).collect::<Vec<_>>(),
+        "screenshot": screenshot
+    }))
+    .expect("DevtoolsSelection deserializes from the wire request")
+}
+
+async fn respond(
+    req: DevtoolsSelection,
+    workspace: &Entity<Workspace>,
+    cx: &mut TestAppContext,
+) -> Value {
+    let app_state = workspace.read_with(cx, |workspace, _| workspace.app_state().clone());
+    let task = cx.update(|cx| handle_selection(req, app_state, cx));
+    cx.run_until_parked();
+    serde_json::to_value(task.await).expect("DevtoolsResult serializes to the wire")
+}
+
+// R9.3 at the wire, R12.2 refusal at warn, R12.3.
+#[gpui::test]
+async fn wiring_answers_no_window_with_zeos_message_and_opens_nothing(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let (other, _other_cx) = window(&fs, "/p/app2", cx).await;
+    let windows = cx.update(|cx| cx.windows().len());
+
+    let since = lines().len();
+    let answer = respond(selection(2, false), &other, cx).await;
+
+    assert_eq!(answer["v"], json!(1));
+    assert_eq!(answer["ok"], json!(false), "{answer}");
+    assert_eq!(answer["error"], json!("no_window"), "{answer}");
+    assert_eq!(
+        answer["message"],
+        json!("No Zeo window has this project open"),
+        "Zeo writes the message of the errors it produces"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+
+    let logged = select_lines("no_window");
+    assert_eq!(logged.len(), 1, "one line per request: {logged:?}");
+    let (level, line) = &logged[0];
+    assert_eq!(*level, log::Level::Warn, "a refusal logs at warn: {line}");
+    assert!(line.contains("items=2"), "the item count: {line}");
+    assert_no_page_content_logged(since, &["SECRET-DOM-TEXT", "SECRET-ATTR-VALUE", "/p/app2"]);
+}
+
+// R12.2 success at info, the success shape with `image`, R12.3 (no image bytes).
+#[gpui::test]
+async fn wiring_answers_inserted_with_the_item_count_and_the_image_state(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let (target, _target_cx) = window(&fs, "/p/app", cx).await;
+
+    let since = lines().len();
+    let answer = respond(selection(1, true), &target, cx).await;
+
+    assert_eq!(answer["ok"], json!(true), "{answer}");
+    assert_eq!(answer["outcome"], json!("inserted"), "{answer}");
+    assert_eq!(answer["items"], json!(1), "{answer}");
+    assert_eq!(
+        answer["image"],
+        json!("included"),
+        "the stub agent accepts images"
+    );
+
+    let logged = select_lines("inserted");
+    assert_eq!(logged.len(), 1, "one line per request: {logged:?}");
+    let (level, line) = &logged[0];
+    assert_eq!(*level, log::Level::Info, "a success logs at info: {line}");
+    assert!(line.contains("items=1"), "the item count: {line}");
+    assert!(line.contains("window="), "the target window: {line}");
+    assert_no_page_content_logged(since, &["SECRET-DOM-TEXT", "SECRET-ATTR-VALUE", PNG_1X1]);
+}
diff --git a/crates/devtools_bridge/tests/relay_delivery.rs b/crates/devtools_bridge/tests/relay_delivery.rs
new file mode 100644
index 0000000..9661076
--- /dev/null
+++ b/crates/devtools_bridge/tests/relay_delivery.rs
@@ -0,0 +1,179 @@
+//! The bridge from a request line to the wire answer: parse and validate against real paths,
+//! hand the selection to the [`Relay`] the listener calls, deliver into the agent panel of the
+//! window holding the project, answer.
+//!
+//! The socket itself is not in this test: gpui's test scheduler fails any test whose foreground
+//! task is woken from another thread, and the listener's thread is one. The listener's own
+//! tests cover the socket with handlers that need no app.
+//!
+//! A test binary of its own: `wiring_tests` installs a process-wide logger and counts select
+//! lines, which these requests would add to.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use devtools_bridge::protocol::{self, DevtoolsSelection};
+use devtools_bridge::wiring::Relay;
+use futures::FutureExt as _;
+
+use acp_thread::StubAgentConnection;
+use agent_ui::AgentPanel;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::{Value, json};
+use workspace::{MultiWorkspace, Workspace};
+
+fn init(cx: &mut TestAppContext) {
+    agent_ui::test_support::init_test(cx);
+    cx.update(|cx| {
+        agent_ui::thread_metadata_store::ThreadMetadataStore::init_global(cx);
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+/// The same tree on disk, where the listener canonicalizes and confines paths, and in the
+/// fake fs the project is opened from.
+async fn project_trees(base: &Path, cx: &mut TestAppContext) -> Arc<FakeFs> {
+    for project in ["app", "other"] {
+        let src = base.join(project).join("src");
+        std::fs::create_dir_all(&src).expect("the project tree");
+        std::fs::write(src.join("App.tsx"), "line 1\nline 2\n").expect("App.tsx");
+    }
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(
+        base,
+        json!({
+            "app": { "src": { "App.tsx": "line 1\nline 2\n" } },
+            "other": { "src": { "App.tsx": "line 1\nline 2\n" } }
+        }),
+    )
+    .await;
+    fs
+}
+
+async fn window(
+    fs: &Arc<FakeFs>,
+    root: &Path,
+    cx: &mut TestAppContext,
+) -> (Entity<Workspace>, VisualTestContext) {
+    let project = Project::test(fs.clone(), [root], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    agent_ui::test_support::open_thread_with_connection(
+        &panel,
+        StubAgentConnection::new(),
+        &mut vcx,
+    );
+    (workspace, vcx)
+}
+
+fn request(root: &Path) -> DevtoolsSelection {
+    let line = serde_json::to_vec(&json!({
+        "v": 1,
+        "project_root": root.to_string_lossy(),
+        "page_url": "http://localhost:5173/",
+        "items": [{
+            "src": {
+                "file": root.join("src/App.tsx").to_string_lossy(),
+                "line": 1, "column": 1, "end_line": 2
+            },
+            "component": "App",
+            "dom": {
+                "tag": "button", "id": null, "classes": [], "text": "Save", "attrs": {},
+                "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+            }
+        }],
+        "screenshot": null
+    }))
+    .expect("the request serializes");
+    let selection = protocol::parse(&line).expect("the request line parses");
+    protocol::validate(selection, root).expect("the request validates")
+}
+
+/// Calls the relay's handler as the listener does, and pumps the app until it answers.
+async fn exchange(relay: &Relay, request: DevtoolsSelection, cx: &mut TestAppContext) -> Value {
+    let answer = cx.background_executor.spawn(relay.handler().call(request));
+    cx.run_until_parked();
+    serde_json::to_value(answer.await).expect("the answer serializes")
+}
+
+async fn setup(cx: &mut TestAppContext) -> (tempfile::TempDir, PathBuf, Relay, VisualTestContext) {
+    init(cx);
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let base: PathBuf = std::fs::canonicalize(tmp.path()).expect("the temp dir canonicalizes");
+    let fs = project_trees(&base, cx).await;
+    let (workspace, window_cx) = window(&fs, &base.join("app"), cx).await;
+    let app_state = workspace.read_with(cx, |workspace, _| workspace.app_state().clone());
+    let relay = cx.update(|cx| Relay::new(app_state, cx));
+    (tmp, base, relay, window_cx)
+}
+
+#[gpui::test]
+async fn relay_delivers_into_the_project_window_and_refuses_another_root(cx: &mut TestAppContext) {
+    let (_tmp, base, relay, _window_cx) = setup(cx).await;
+
+    let answer = exchange(&relay, request(&base.join("app")), cx).await;
+    assert_eq!(
+        answer,
+        json!({ "v": 1, "ok": true, "outcome": "inserted", "items": 1, "image": "none" })
+    );
+
+    let windows = cx.update(|cx| cx.windows().len());
+    let answer = exchange(&relay, request(&base.join("other")), cx).await;
+    assert_eq!(
+        answer,
+        json!({
+            "v": 1, "ok": false, "error": "no_window",
+            "message": "No Zeo window has this project open"
+        })
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+}
+
+// Hostile: a main thread that falls behind must neither block the listener's thread nor
+// deliver requests whose connections already gave up.
+#[gpui::test]
+async fn a_full_relay_closes_without_an_answer_and_abandoned_requests_are_skipped(
+    cx: &mut TestAppContext,
+) {
+    let (_tmp, base, relay, _window_cx) = setup(cx).await;
+    let handler = relay.handler();
+
+    // Nothing pumps the app here, so the queue only fills.
+    let queued: Vec<_> = (0..devtools_bridge::listener::MAX_CONNECTIONS)
+        .map(|_| handler.call(request(&base.join("app"))))
+        .collect();
+    let overflow = handler.call(request(&base.join("app")));
+    assert_eq!(
+        overflow.now_or_never(),
+        Some(None),
+        "a full queue closes the connection at once, without an answer"
+    );
+
+    // The listener drops each handler future at its response deadline.
+    drop(queued);
+    cx.run_until_parked();
+
+    let answer = exchange(&relay, request(&base.join("app")), cx).await;
+    assert_eq!(
+        answer["ok"],
+        json!(true),
+        "the relay still serves after skipping: {answer}"
+    );
+}
