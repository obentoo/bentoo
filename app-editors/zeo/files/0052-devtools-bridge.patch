+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ImageState {
+    Included,
+    SkippedUnsupported,
+    None,
+    Pending,
+}
+
+/// The socket response. On the wire both variants carry `v: 1` and an `ok` discriminant.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(try_from = "WireResult", into = "WireResult")]
+pub enum DevtoolsResult {
+    Success {
+        outcome: DeliveryOutcome,
+        items: usize,
+        image: ImageState,
+    },
+    Failure {
+        error: DevtoolsError,
+        message: String,
+    },
+}
+
+impl From<DevtoolsError> for DevtoolsResult {
+    fn from(error: DevtoolsError) -> Self {
+        Self::Failure {
+            error,
+            message: error.to_string(),
+        }
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireResult {
+    v: u64,
+    ok: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    outcome: Option<DeliveryOutcome>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    items: Option<usize>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    image: Option<ImageState>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    error: Option<DevtoolsError>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    message: Option<String>,
+}
+
+impl TryFrom<WireResult> for DevtoolsResult {
+    type Error = &'static str;
+
+    fn try_from(wire: WireResult) -> Result<Self, Self::Error> {
+        if wire.v != PROTOCOL_VERSION {
+            return Err("unsupported result version");
+        }
+        match wire {
+            WireResult {
+                ok: true,
+                outcome: Some(outcome),
+                items: Some(items),
+                image: Some(image),
+                error: None,
+                message: None,
+                ..
+            } if items <= MAX_ITEMS => Ok(Self::Success {
+                outcome,
+                items,
+                image,
+            }),
+            WireResult {
+                ok: false,
+                outcome: None,
+                items: None,
+                image: None,
+                error: Some(error),
+                message: Some(message),
+                ..
+            } => Ok(Self::Failure { error, message }),
+            _ => Err("a result must carry exactly the fields of its `ok` variant"),
+        }
+    }
+}
+
+impl From<DevtoolsResult> for WireResult {
+    fn from(result: DevtoolsResult) -> Self {
+        match result {
+            DevtoolsResult::Success {
+                outcome,
+                items,
+                image,
+            } => Self {
+                v: PROTOCOL_VERSION,
+                ok: true,
+                outcome: Some(outcome),
+                items: Some(items),
+                image: Some(image),
+                error: None,
+                message: None,
+            },
+            DevtoolsResult::Failure { error, message } => Self {
+                v: PROTOCOL_VERSION,
+                ok: false,
+                outcome: None,
+                items: None,
+                image: None,
+                error: Some(error),
+                message: Some(message),
+            },
+        }
+    }
+}
+
+/// Parses one request line. The version is read before the shape, so `v: 2` is
+/// `unsupported_version` whatever else is wrong with it, as the TypeScript validator answers.
+pub fn parse(line: &[u8]) -> Result<DevtoolsSelection, DevtoolsError> {
+    // A `serde_json::Value` of the whole line costs tens of times the line's size; the probe
+    // reads `v` alone and skips every other field without allocating.
+    // serde reads a struct from a JSON array too; the contract's request is an object only.
+    if line.trim_ascii_start().first() != Some(&b'{') {
+        return Err(DevtoolsError::BadRequest);
+    }
+    let probe: VersionProbe =
+        serde_json::from_slice(line).map_err(|_| DevtoolsError::BadRequest)?;
+    if probe.v == WireVersion::Other {
+        return Err(DevtoolsError::UnsupportedVersion);
+    }
+    serde_json::from_slice(line).map_err(|_| DevtoolsError::BadRequest)
+}
+
+#[derive(Deserialize)]
+struct VersionProbe {
+    #[serde(default)]
+    v: WireVersion,
+}
+
+/// What a request's `v` says, read without building it: a non-numeric `v` (`null`, a string,
+/// an array) is a version this side does not speak, not a malformed request.
+#[derive(Debug, Default, PartialEq)]
+enum WireVersion {
+    #[default]
+    Missing,
+    Supported,
+    Other,
+}
+
+impl<'de> Deserialize<'de> for WireVersion {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        deserializer.deserialize_any(WireVersionVisitor)
+    }
+}
+
+struct WireVersionVisitor;
+
+impl WireVersionVisitor {
+    fn verdict(supported: bool) -> WireVersion {
+        if supported {
+            WireVersion::Supported
+        } else {
+            WireVersion::Other
+        }
+    }
+}
+
+impl<'de> serde::de::Visitor<'de> for WireVersionVisitor {
+    type Value = WireVersion;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("any JSON value")
+    }
+
+    fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<WireVersion, E> {
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_i64<E: serde::de::Error>(self, value: i64) -> Result<WireVersion, E> {
+        Ok(Self::verdict(u64::try_from(value) == Ok(PROTOCOL_VERSION)))
+    }
+
+    fn visit_u64<E: serde::de::Error>(self, value: u64) -> Result<WireVersion, E> {
+        Ok(Self::verdict(value == PROTOCOL_VERSION))
+    }
+
+    fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<WireVersion, E> {
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_str<E: serde::de::Error>(self, _: &str) -> Result<WireVersion, E> {
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_unit<E: serde::de::Error>(self) -> Result<WireVersion, E> {
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_none<E: serde::de::Error>(self) -> Result<WireVersion, E> {
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_seq<A: serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<WireVersion, A::Error> {
+        while seq.next_element::<serde::de::IgnoredAny>()?.is_some() {}
+        Ok(WireVersion::Other)
+    }
+
+    fn visit_map<A: serde::de::MapAccess<'de>>(self, mut map: A) -> Result<WireVersion, A::Error> {
+        while map
+            .next_entry::<serde::de::IgnoredAny, serde::de::IgnoredAny>()?
+            .is_some()
+        {}
+        Ok(WireVersion::Other)
+    }
+}
+
+/// Checks every limit of the contract, then confines every item's file to `root_canon` (an
+/// already canonicalized project root). One bad item refuses the whole request.
+///
+/// The returned selection carries `project_root` and each `src.file` canonicalized: the paths
+/// Zeo later matches and opens are the ones this function proved, so a root reached through a
+/// symlink still finds the window holding its target.
+pub fn validate(
+    mut request: DevtoolsSelection,
+    root_canon: &Path,
+) -> Result<DevtoolsSelection, DevtoolsError> {
+    if request.v != PROTOCOL_VERSION {
+        return Err(DevtoolsError::UnsupportedVersion);
+    }
+    check_limits(&request)?;
+
+    // A root that is itself a regular file would be its own only "file inside the project".
+    let root_is_directory = std::fs::metadata(root_canon).is_ok_and(|metadata| metadata.is_dir());
+    if !root_is_directory {
+        return Err(DevtoolsError::OutsideProject);
+    }
+    for item in &mut request.items {
+        item.src.file = confine(&item.src.file, root_canon)?;
+    }
+    request.project_root = root_canon
+        .to_str()
+        .ok_or(DevtoolsError::OutsideProject)?
+        .to_string();
+    Ok(request)
+}
+
+fn check_limits(request: &DevtoolsSelection) -> Result<(), DevtoolsError> {
+    require((1..=MAX_ITEMS).contains(&request.items.len()))?;
+    require(is_absolute_wire_path(&request.project_root))?;
+    require(within_chars(&request.page_url, MAX_PAGE_URL_CHARS))?;
+    for item in &request.items {
+        check_item(item)?;
+    }
+    if let Some(screenshot) = &request.screenshot {
+        check_screenshot(screenshot)?;
+    }
+    Ok(())
+}
+
+fn check_item(item: &SelectionItem) -> Result<(), DevtoolsError> {
+    let src = &item.src;
+    require(is_absolute_wire_path(&src.file))?;
+    require(src.line >= 1 && src.column >= 1 && src.end_line >= 1)?;
+    require(
+        item.component
+            .as_deref()
+            .is_none_or(|component| within_chars(component, MAX_COMPONENT_CHARS)),
+    )?;
+
+    let dom = &item.dom;
+    require(!dom.tag.is_empty() && within_chars(&dom.tag, MAX_TAG_CHARS))?;
+    require(
+        dom.id
+            .as_deref()
+            .is_none_or(|id| within_chars(id, MAX_ID_CHARS)),
+    )?;
+    require(dom.classes.len() <= MAX_CLASSES)?;
+    require(
+        dom.classes
+            .iter()
+            .all(|class| within_chars(class, MAX_CLASS_CHARS)),
+    )?;
+    require(within_chars(&dom.text, MAX_TEXT_CHARS))?;
+    require(dom.attrs.iter().all(|(name, value)| {
+        is_allowed_attribute(name) && within_chars(value, MAX_ATTR_VALUE_CHARS)
+    }))?;
+    require(dom.styles.len() <= STYLE_KEYS.len())?;
+    require(dom.styles.iter().all(|(name, value)| {
+        STYLE_KEYS.contains(&name.as_str()) && within_chars(value, MAX_STYLE_VALUE_CHARS)
+    }))?;
+    require(serialized_len(dom)? <= DOM_SUMMARY_MAX_BYTES)
+}
+
+fn check_screenshot(screenshot: &Screenshot) -> Result<(), DevtoolsError> {
+    require(screenshot.mime == SCREENSHOT_MIME)?;
+    require((1..=SCREENSHOT_MAX_EDGE).contains(&screenshot.w))?;
+    require((1..=SCREENSHOT_MAX_EDGE).contains(&screenshot.h))?;
+    // Bounding the encoded length first keeps an oversized payload from being decoded at all.
+    require(
+        !screenshot.data_b64.is_empty() && screenshot.data_b64.len() <= SCREENSHOT_MAX_BASE64_LEN,
+    )?;
+    let bytes = base64::engine::general_purpose::STANDARD
+        .decode(&screenshot.data_b64)
+        .map_err(|_| DevtoolsError::BadRequest)?;
+    require(bytes.len() <= SCREENSHOT_MAX_BYTES)?;
+    let (width, height) = png_dimensions(&bytes).ok_or(DevtoolsError::BadRequest)?;
+    require(width >= 1 && height >= 1 && width.max(height) <= SCREENSHOT_MAX_EDGE)?;
+    require(width == screenshot.w && height == screenshot.h)
+}
+
+/// Reads the IHDR width and height (bytes 16–23) of a PNG, or `None` when `bytes` is not one.
+fn png_dimensions(bytes: &[u8]) -> Option<(u32, u32)> {
+    let (magic, rest) = bytes.split_first_chunk::<8>()?;
+    let (_chunk_length, rest) = rest.split_first_chunk::<4>()?;
+    let (chunk_type, rest) = rest.split_first_chunk::<4>()?;
+    let (width, rest) = rest.split_first_chunk::<4>()?;
+    let (height, _) = rest.split_first_chunk::<4>()?;
+    if *magic != PNG_MAGIC || chunk_type != b"IHDR" {
+        return None;
+    }
+    Some((u32::from_be_bytes(*width), u32::from_be_bytes(*height)))
+}
+
+/// Resolves `file` and requires a regular file under `root_canon`. Every failure, a missing
+/// file included, is `outside_project`: a path that does not resolve cannot be shown to be
+/// inside the project.
+fn confine(file: &str, root_canon: &Path) -> Result<String, DevtoolsError> {
+    let canonical = std::fs::canonicalize(file).map_err(|_| DevtoolsError::OutsideProject)?;
+    // `Path::starts_with` compares whole components, so `<root>2/x` is not under `<root>`.
+    if !canonical.starts_with(root_canon) {
+        return Err(DevtoolsError::OutsideProject);
+    }
+    let metadata = std::fs::metadata(&canonical).map_err(|_| DevtoolsError::OutsideProject)?;
+    if !metadata.is_file() {
+        return Err(DevtoolsError::OutsideProject);
+    }
+    canonical
+        .into_os_string()
+        .into_string()
+        .map_err(|_| DevtoolsError::OutsideProject)
+}
+
+fn require(condition: bool) -> Result<(), DevtoolsError> {
+    if condition {
+        Ok(())
+    } else {
+        Err(DevtoolsError::BadRequest)
+    }
+}
+
+/// The client counts code points, not bytes, and both validators must agree on the fixtures.
+fn within_chars(value: &str, max: usize) -> bool {
+    value.len() <= max || value.chars().nth(max).is_none()
+}
+
+fn is_absolute_wire_path(path: &str) -> bool {
+    Path::new(path).is_absolute()
+        && path.chars().nth(MIN_PATH_CHARS - 1).is_some()
+        && within_chars(path, MAX_PATH_CHARS)
+}
+
+/// `^(role|aria-[a-z-]+|href|type|name|alt)$`, the client's `ATTR_ALLOWLIST`.
+fn is_allowed_attribute(name: &str) -> bool {
+    match name {
+        "role" | "href" | "type" | "name" | "alt" => true,
+        _ => name.strip_prefix("aria-").is_some_and(|suffix| {
+            !suffix.is_empty()
+                && suffix
+                    .bytes()
+                    .all(|byte| byte.is_ascii_lowercase() || byte == b'-')
+        }),
+    }
+}
+
+/// The UTF-8 length of `dom` serialized compactly, measured without buffering it.
+fn serialized_len(dom: &DomSummary) -> Result<usize, DevtoolsError> {
+    let mut counter = ByteCounter(0);
+    serde_json::to_writer(&mut counter, dom).map_err(|_| DevtoolsError::BadRequest)?;
+    Ok(counter.0)
+}
+
+struct ByteCounter(usize);
+
+impl io::Write for ByteCounter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// A nullable field the contract still requires to be present: serde would otherwise read a
+/// missing key as `None`, where the zod schema refuses it.
+fn required_nullable<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    Option::<T>::deserialize(deserializer)
+}
+
+/// Writes a rect value as `JSON.stringify` does, so the DOM summary measures the same bytes on
+/// both sides of the 4 KiB cap: serde_json would write `10.0`, `1e21` and `1.5e-6` where the page
+/// writes `10`, `1e+21` and `0.0000015`.
+fn serialize_js_number<S: Serializer>(value: &f64, serializer: S) -> Result<S::Ok, S::Error> {
+    let token = js_number_token(*value)
+        .ok_or_else(|| serde::ser::Error::custom("a rect value must be a finite number"))?;
+    let raw = serde_json::value::RawValue::from_string(token).map_err(serde::ser::Error::custom)?;
+    raw.serialize(serializer)
+}
+
+/// ECMAScript `Number::toString(x)` for a finite `x`, or `None` for NaN and the infinities.
+fn js_number_token(value: f64) -> Option<String> {
+    if !value.is_finite() {
+        return None;
+    }
+    if value == 0.0 {
+        return Some("0".to_string());
+    }
+    let sign = if value < 0.0 { "-" } else { "" };
+    // Rust's `{:e}` prints the shortest digits that round-trip, the digits ECMAScript asks for;
+    // only their layout differs.
+    let scientific = format!("{:e}", value.abs());
+    let (mantissa, exponent) = scientific.split_once('e')?;
+    let digits: String = mantissa.chars().filter(|char| *char != '.').collect();
+    let digit_count = i32::try_from(digits.len()).ok()?;
+    // The spec's `n`: the value is `digits × 10^(n − digit_count)`.
+    let point = exponent.parse::<i32>().ok()? + 1;
+
+    let body = if digit_count <= point && point <= 21 {
+        let zeros = usize::try_from(point - digit_count).ok()?;
+        format!("{digits}{}", "0".repeat(zeros))
+    } else if 0 < point && point <= 21 {
+        let (integer, fraction) = digits.split_at_checked(usize::try_from(point).ok()?)?;
+        format!("{integer}.{fraction}")
+    } else if -6 < point && point <= 0 {
+        let zeros = usize::try_from(-point).ok()?;
+        format!("0.{}{digits}", "0".repeat(zeros))
+    } else {
+        let (first, rest) = digits.split_at_checked(1)?;
+        let exponent_sign = if point > 0 { '+' } else { '-' };
+        let exponent = (point - 1).abs();
+        if rest.is_empty() {
+            format!("{first}e{exponent_sign}{exponent}")
+        } else {
+            format!("{first}.{rest}e{exponent_sign}{exponent}")
+        }
+    };
+    Some(format!("{sign}{body}"))
+}
