+}
+
+#[test]
+fn protocol_refuses_a_dot_dot_path_that_escapes_the_root() {
+    let fx = fixture();
+    write_file(&fx.base.join("outside.tsx"));
+    let escaping = fx.root.join("src/../../outside.tsx");
