+/// Parses `zed:///agent/dom-element?path=…&start=…&end=…&col=…&tag=…[&component=…]`.
+/// Every field but `component` is required: a missing one is an error, never
+/// a default, so a damaged link cannot come back as a different element.
+fn parse_dom_element(url: &Url) -> Result<MentionUri> {
+    let mut path = None;
+    let mut start = None;
+    let mut end = None;
+    let mut column = None;
+    let mut tag = None;
+    let mut component = None;
+
+    for (key, value) in url.query_pairs() {
+        let slot = match key.as_ref() {
+            "path" => &mut path,
+            "start" => &mut start,
+            "end" => &mut end,
+            "col" => &mut column,
+            "tag" => &mut tag,
+            "component" => &mut component,
+            other => bail!("invalid dom-element query parameter {other:?}"),
+        };
+        if slot.replace(value.into_owned()).is_some() {
+            bail!("duplicate dom-element query parameter {key:?}");
+        }
+    }
+
+    let one_based = |value: Option<String>, name: &str| -> Result<u32> {
+        let value = value.with_context(|| format!("missing dom-element {name}"))?;
+        value
+            .parse::<u32>()
+            .with_context(|| format!("parsing dom-element {name} {value:?}"))?
+            .checked_sub(1)
+            .with_context(|| format!("dom-element {name} should be 1-based, got 0"))
+    };
+
+    let abs_path = PathBuf::from(path.context("missing dom-element path")?);
+    let start = one_based(start, "start")?;
+    let end = one_based(end, "end")?;
+    if end < start {
+        bail!("dom-element line range ends before it starts: {start}..={end}");
+    }
+    let column = one_based(column, "col")?;
+    let tag = tag.context("missing dom-element tag")?;
+
+    Ok(MentionUri::DomElement {
+        abs_path,
+        line_range: start..=end,
+        column,
+        component,
+        tag,
+    })
+}
+
+/// The chip label of an element mention: `<Component> <tag> · <file>:<line>`,
+/// or `<tag> · <file>:<line>` with no component, with a 1-based line.
+fn dom_element_name(
+    abs_path: &Path,
+    line_range: &RangeInclusive<u32>,
+    component: Option<&str>,
+    tag: &str,
+) -> String {
+    let file = abs_path.file_name().unwrap_or_default().display();
+    let line = line_range.start() + 1;
+    match component {
+        Some(component) => format!("{component} {tag} · {file}:{line}"),
+        None => format!("{tag} · {file}:{line}"),
+    }
+}
