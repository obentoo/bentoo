+// Story 033, task 6.2 — the bridge's protocol types and validation (R8.2, R8.3, R8.4, R8.5;
+// Q4, Q14). Wired in the crate root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod protocol_tests;
+//
+// Validation filter: `protocol` (every test path is `protocol_tests::…`).
+//
+// Contract (design.md §Data Models, §Validation rules; tasks.md 6.2 Objective):
+// `crate::protocol::{DevtoolsSelection, DevtoolsError, validate}`, where
+// `validate(req: DevtoolsSelection, root_canon: &Path) -> Result<DevtoolsSelection, DevtoolsError>`,
+// `DevtoolsSelection` deserializes from the wire JSON (same field names as the zod schema) and
+// `DevtoolsError` serializes to its wire code string ("bad_request", "outside_project", …).
+// Requests are built as wire JSON, so this file pins field names, not Rust struct shapes; if a
+// name moves, adjust the `use` only.
+//
+// A request serde itself refuses is answered `bad_request` by the listener (R8.3, proved over
+// the socket in `listener_tests`), so `verdict` reports a serde refusal as `bad_request`: which
+// layer enforces a given limit is the implementer's choice, the code the page sees is not.
+//
+// Hostile halves first:
+//   - path confinement, wrongly COLLAPSE: `<tmp>/app2/x.tsx` is not inside root `<tmp>/app`;
+//     a symlink inside the root that resolves outside it is outside.
+//   - path confinement, wrongly SPLIT: a symlink inside the root that resolves inside is inside;
+//     the file spelled through an alias of the root is inside; `<tmp>/app/web/x.tsx` is inside.
+//   - every numeric limit is asserted on both sides of its boundary.
+
+use std::fs;
+use std::os::unix::fs::symlink;
+use std::path::{Path, PathBuf};
+
+use base64::Engine as _;
+use serde_json::{Value, json};
+
+use crate::protocol::{DevtoolsError, DevtoolsSelection, validate};
+
+struct Fixture {
+    _tmp: tempfile::TempDir,
+    /// Canonical parent of the project root, for siblings and outside files.
+    base: PathBuf,
+    /// The project root, `<base>/app`, holding `src/App.tsx`.
+    root: PathBuf,
+}
+
+fn fixture() -> Fixture {
+    let tmp = tempfile::tempdir().expect("a temp dir");
+    let base = fs::canonicalize(tmp.path()).expect("the temp dir canonicalizes");
+    let root = base.join("app");
+    fs::create_dir_all(root.join("src")).expect("the project tree is created");
+    fs::write(root.join("src/App.tsx"), "line 1\nline 2\nline 3\n").expect("App.tsx is written");
+    Fixture {
+        _tmp: tmp,
+        base,
+        root,
+    }
+}
+
+fn write_file(path: &Path) {
+    fs::create_dir_all(path.parent().expect("a parent")).expect("parents are created");
+    fs::write(path, "export const x = 1;\n").expect("the file is written");
+}
+
+fn item(file: &Path) -> Value {
+    json!({
+        "src": { "file": file.to_string_lossy(), "line": 2, "column": 1, "end_line": 3 },
+        "component": "App",
+        "dom": {
+            "tag": "button",
+            "id": null,
+            "classes": [],
+            "text": "",
+            "attrs": {},
+            "styles": {},
+            "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+        }
+    })
+}
+
+fn request(root: &Path, items: Vec<Value>) -> Value {
+    json!({
+        "v": 1,
+        "project_root": root.to_string_lossy(),
+        "page_url": "http://localhost:5173/",
+        "items": items,
+        "screenshot": null
+    })
+}
+
+/// One valid item over `<root>/src/App.tsx`, with `edit` applied to it.
+fn request_with_item(fx: &Fixture, edit: impl FnOnce(&mut Value)) -> Value {
+    let mut one = item(&fx.root.join("src/App.tsx"));
+    edit(&mut one);
+    request(&fx.root, vec![one])
+}
+
+fn wire_code(error: &DevtoolsError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("DevtoolsError must serialize to its wire code string, got {other:?}"),
+    }
+}
+
+fn verdict(root: &Path, request: Value) -> String {
+    let selection = match serde_json::from_value::<DevtoolsSelection>(request) {
+        Ok(selection) => selection,
+        Err(_) => return "bad_request".to_string(),
+    };
+    let root_canon = fs::canonicalize(root).expect("the fixture root exists");
+    match validate(selection, &root_canon) {
+        Ok(_) => "accepted".to_string(),
+        Err(error) => wire_code(&error),
+    }
+}
+
+fn png(width: u32, height: u32, total_len: usize) -> Vec<u8> {
+    let mut bytes = vec![0x89, b'P', b'N', b'G', b'\r', b'\n', 0x1a, b'\n'];
+    bytes.extend_from_slice(&13u32.to_be_bytes());
+    bytes.extend_from_slice(b"IHDR");
+    bytes.extend_from_slice(&width.to_be_bytes());
+    bytes.extend_from_slice(&height.to_be_bytes());
+    bytes.extend_from_slice(&[8, 6, 0, 0, 0]);
+    bytes.extend_from_slice(&[0, 0, 0, 0]);
+    if bytes.len() < total_len {
+        bytes.resize(total_len, 0);
+    }
+    bytes
+}
+
+fn with_screenshot(fx: &Fixture, mime: &str, bytes: &[u8], w: u32, h: u32) -> Value {
+    let mut req = request(&fx.root, vec![item(&fx.root.join("src/App.tsx"))]);
+    req["screenshot"] = json!({
+        "mime": mime,
+        "data_b64": base64::engine::general_purpose::STANDARD.encode(bytes),
+        "w": w,
+        "h": h
+    });
+    req
+}
+
+// ---- R8.4 path confinement -------------------------------------------------------------
+
+// Hostile (wrongly collapse): a string-prefix check takes `app2` for `app`.
+#[test]
+fn protocol_refuses_a_sibling_whose_name_extends_the_root() {
+    let fx = fixture();
+    let sibling = fx.base.join("app2/src/x.tsx");
+    write_file(&sibling);
+    assert_eq!(
+        verdict(&fx.root, request(&fx.root, vec![item(&sibling)])),
+        "outside_project"
+    );
+}
+
+// Hostile (wrongly collapse): the link lives inside the root, its target does not.
+#[test]
+fn protocol_refuses_a_symlink_inside_the_root_that_resolves_outside() {
+    let fx = fixture();
+    let outside = fx.base.join("secret/key.tsx");
+    write_file(&outside);
+    let link = fx.root.join("src/Escape.tsx");
+    symlink(&outside, &link).expect("the escaping symlink is created");
+    assert_eq!(
+        verdict(&fx.root, request(&fx.root, vec![item(&link)])),
+        "outside_project"
+    );
+}
+
+// Converse (wrongly split): a link that stays inside the root is a file of the project.
+#[test]
+fn protocol_accepts_a_symlink_inside_the_root_that_resolves_inside() {
+    let fx = fixture();
+    let link = fx.root.join("src/Alias.tsx");
+    symlink(fx.root.join("src/App.tsx"), &link).expect("the inner symlink is created");
+    assert_eq!(
+        verdict(&fx.root, request(&fx.root, vec![item(&link)])),
+        "accepted"
+    );
+}
+
+// Converse (wrongly split): the same file, spelled through an alias of the root directory.
+#[test]
+fn protocol_accepts_a_file_spelled_through_an_alias_of_the_root() {
+    let fx = fixture();
+    let alias = fx.base.join("alias");
+    symlink(&fx.root, &alias).expect("the root alias is created");
+    assert_eq!(
+        verdict(
+            &fx.root,
+            request(&fx.root, vec![item(&alias.join("src/App.tsx"))])
+        ),
+        "accepted"
+    );
+}
+
+// Benign: a file in a subdirectory of the root.
+#[test]
+fn protocol_accepts_a_file_in_a_subdirectory_of_the_root() {
+    let fx = fixture();
+    let nested = fx.root.join("web/src/x.tsx");
+    write_file(&nested);
+    assert_eq!(
+        verdict(&fx.root, request(&fx.root, vec![item(&nested)])),
+        "accepted"
