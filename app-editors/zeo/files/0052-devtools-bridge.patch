+/// The error codes of the contract. Unit variants only: an error can never carry page content.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DevtoolsError {
+    NoWindow,
+    NoAgentPanel,
+    AiDisabled,
+    BadRequest,
+    TooLarge,
+    OutsideProject,
+    UnsupportedVersion,
+    Unreachable,
+    Timeout,
+}
+
+impl fmt::Display for DevtoolsError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let message = match self {
+            Self::NoWindow => "No Zeo window has this project open",
+            Self::NoAgentPanel => "This Zeo window has no agent panel",
+            Self::AiDisabled => "AI features are disabled in Zeo",
+            Self::BadRequest => "Zeo refused a malformed selection",
+            Self::TooLarge => "The selection is too large for Zeo",
+            Self::OutsideProject => "A selected file is outside this project",
+            Self::UnsupportedVersion => "Unsupported protocol version; Zeo speaks version 1",
+            Self::Unreachable => "Zeo is not running, or its devtools bridge is off",
+            Self::Timeout => "Zeo did not answer within 10 seconds",
+        };
+        formatter.write_str(message)
+    }
+}
+
+impl std::error::Error for DevtoolsError {}
+
+impl DevtoolsError {
+    /// The wire code, as serde writes it; for log lines.
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::NoWindow => "no_window",
+            Self::NoAgentPanel => "no_agent_panel",
+            Self::AiDisabled => "ai_disabled",
+            Self::BadRequest => "bad_request",
+            Self::TooLarge => "too_large",
+            Self::OutsideProject => "outside_project",
+            Self::UnsupportedVersion => "unsupported_version",
+            Self::Unreachable => "unreachable",
+            Self::Timeout => "timeout",
+        }
+    }
+}
