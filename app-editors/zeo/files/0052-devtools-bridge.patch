+}
+
+#[test]
+fn protocol_refuses_a_directory_and_a_missing_file() {
+    let fx = fixture();
+    assert_eq!(
+        verdict(
+            &fx.root,
+            request(&fx.root, vec![item(&fx.root.join("src"))])
