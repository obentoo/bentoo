@@ -0,0 +1,154 @@
+// Story 033, task 7.1 — `MentionUri::DomElement`: URI, parse and label (R10.1, R10.4). Wired in
+// the crate root `src/acp_thread.rs` as
+//
+//     #[cfg(test)]
+//     mod mention_dom_element_tests;
+//
+// Validation filter: `mention` (every test path is `mention_dom_element_tests::…`).
+//
+// Contract (tasks.md 7.1 Objective; design.md §B2): `MentionUri::DomElement { abs_path: PathBuf,
+// line_range: RangeInclusive<u32>, column: u32, component: Option<String>, tag: String }`,
+// `to_uri()` under `zed:///agent/dom-element?…`, `parse`, and `name()` =
+// `<Component> <tag> · <file>:<line>` (or `<tag> · <file>:<line>`), 0-based lines in the variant
+// and 1-based in the label. `<file>` is asserted as a suffix, so the file name or a longer path
+// both satisfy it.
+//
+// Hostile halves (identity, R10.4 "the same chip"):
+//   - wrongly SPLIT: a component holding `&tag=script`, paths holding `&`, `=`, `#`, `?`, spaces
+//     and non-ASCII must come back as the same element, field for field;
+//   - wrongly COLLAPSE: elements differing only in component, tag or line must get different
+//     URIs; a URI missing a required field must not come back as an element with a default; a
+//     Selection over the same lines must not parse as an element, nor the converse.
+
+use std::path::PathBuf;
+
+use util::paths::PathStyle;
+
+use crate::MentionUri;
+
+fn element(path: &str, component: Option<&str>, tag: &str) -> MentionUri {
+    MentionUri::DomElement {
+        abs_path: PathBuf::from(path),
+        line_range: 11..=14,
+        column: 4,
+        component: component.map(str::to_string),
+        tag: tag.to_string(),
+    }
+}
+
+fn reparse(uri: &MentionUri) -> MentionUri {
+    let text = uri.to_uri().to_string();
+    MentionUri::parse(&text, PathStyle::local())
+        .unwrap_or_else(|error| panic!("{text} parses back: {error:#}"))
+}
+
+#[test]
+fn mention_dom_element_lives_under_zed_agent_dom_element() {
+    let uri = element("/p/app/src/App.tsx", Some("Button"), "button").to_uri();
+    assert!(
+        uri.as_str().starts_with("zed:///agent/dom-element?"),
+        "got {uri}"
+    );
+}
+
+// Hostile (wrongly split): every reserved character survives the round trip.
+#[test]
+fn mention_dom_element_round_trips_hostile_values_field_for_field() {
+    let cases = [
+        element(
+            "/p/my app/src/a&b=c#d?.tsx",
+            Some("Card&tag=script"),
+            "button",
+        ),
+        element("/p/app/src/日本語.tsx", Some("Zoë"), "my-widget"),
+        element("/p/app/src/App.tsx", Some("Button"), "button"),
+        element("/p/app/src/App.tsx", None, "li"),
+    ];
+    for uri in cases {
+        assert_eq!(reparse(&uri), uri, "{}", uri.to_uri());
+    }
+}
+
+// Hostile (wrongly collapse): one differing field, one different URI.
+#[test]
+fn mention_dom_element_distinct_elements_get_distinct_uris() {
+    let base = element("/p/app/src/App.tsx", Some("Button"), "button");
+    let other_line = MentionUri::DomElement {
+        abs_path: PathBuf::from("/p/app/src/App.tsx"),
+        line_range: 12..=14,
+        column: 4,
+        component: Some("Button".to_string()),
+        tag: "button".to_string(),
+    };
+    let variants = [
+        element("/p/app/src/App.tsx", None, "button"),
+        element("/p/app/src/App.tsx", Some("Button"), "a"),
+        element("/p/app/src/App.tsx", Some("Card"), "button"),
+        other_line,
+    ];
+    for variant in variants {
+        assert_ne!(variant.to_uri(), base.to_uri(), "{variant:?}");
+    }
+    assert_eq!(
+        base.to_uri(),
+        element("/p/app/src/App.tsx", Some("Button"), "button").to_uri(),
+        "equal fields give the same URI"
+    );
+}
+
+// Hostile (wrongly collapse into a default): a URI missing a required field is not an element.
+#[test]
+fn mention_dom_element_missing_required_field_does_not_parse_as_an_element() {
+    let full = element("/p/app/src/App.tsx", Some("Button"), "button").to_uri();
+    for missing in ["path", "start", "end", "tag"] {
+        let mut uri = full.clone();
+        let kept: Vec<(String, String)> = full
+            .query_pairs()
+            .filter(|(key, _)| key != missing)
+            .map(|(key, value)| (key.into_owned(), value.into_owned()))
+            .collect();
+        uri.query_pairs_mut().clear().extend_pairs(kept);
+        let parsed = MentionUri::parse(uri.as_str(), PathStyle::local());
+        assert!(
+            !matches!(parsed, Ok(MentionUri::DomElement { .. })),
+            "without `{missing}`: {uri} gave {parsed:?}"
+        );
+    }
+}
+
+#[test]
+fn mention_dom_element_and_selection_never_parse_as_each_other() {
+    let dom = element("/p/app/src/App.tsx", Some("Button"), "button");
+    let selection = MentionUri::Selection {
+        abs_path: Some(PathBuf::from("/p/app/src/App.tsx")),
+        line_range: 11..=14,
+        column: Some(4),
+    };
+    assert!(matches!(reparse(&dom), MentionUri::DomElement { .. }));
+    assert!(matches!(reparse(&selection), MentionUri::Selection { .. }));
+}
+
+// R10.1 — 1-based line, component first when present, nothing in its place when absent.
+#[test]
+fn mention_dom_element_label_names_component_tag_file_and_line() {
+    let with = element("/p/app/src/App.tsx", Some("Button"), "button").name();
+    assert!(with.starts_with("Button button · "), "got {with:?}");
+    assert!(with.ends_with("App.tsx:12"), "1-based start line: {with:?}");
+
+    let without = element("/p/app/src/App.tsx", None, "li").name();
+    assert!(
+        without.starts_with("li · "),
+        "no component, no placeholder: {without:?}"
+    );
+    assert!(without.ends_with("App.tsx:12"), "got {without:?}");
+}
+
+// R10.4 — the persisted form (thread history) restores the same mention.
+#[test]
+fn mention_dom_element_survives_serde_persistence() {
+    let uri = element("/p/app/src/App.tsx", Some("Button"), "button");
+    let stored = serde_json::to_string(&uri).expect("serializes");
+    let restored: MentionUri = serde_json::from_str(&stored).expect("deserializes");
+    assert_eq!(restored, uri);
+    assert_eq!(restored.name(), uri.name(), "the same chip label");
+}
