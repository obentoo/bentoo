+// Story 033, task 9.1 (Rust half) — the Rust validator gives every shared contract fixture the
+// verdict the fixture names (R6.1, R8.3; Q14). Wired in the crate root `src/devtools_bridge.rs`:
+//
+//     #[cfg(test)]
+//     mod contract_agreement_tests;
+//
+// Validation: `ZEO_DEVTOOLS_CONTRACT_DIR=<zeo-devtools>/test/contract cargo test -p
+// devtools_bridge contract_agreement`. Unset, the test prints why it skipped and returns; it
+// never passes silently with fixtures present, and it never copies fixtures into the Zed tree.
+//
+// Fixture convention (shared with the vitest half; agree on it before writing either):
+//   - `valid/*.json` must be accepted; `invalid/*.json` carry a top-level `"$expect"` naming the
+//     `DevtoolsError` wire code, stripped before validation.
+//   - Socket form (has `project_root`): `project_root` is replaced by a temp root, and each
+//     `src.file` that starts with the fixture's `project_root` is re-rooted under it and created
+//     as a regular file. A `src.file` outside that prefix, or relative, is left as written, so a
+//     "relative path on the socket form" fixture stays invalid.
+//   - Page form (no `project_root`): the temp root becomes `project_root` and each relative
+//     `src.file` is made absolute under it, as the relay does.
+//
+// A request serde refuses counts as `bad_request`, the code the listener answers for it.
+
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+use serde_json::Value;
+
+use crate::protocol::{DevtoolsError, DevtoolsSelection, validate};
+
+const ENV: &str = "ZEO_DEVTOOLS_CONTRACT_DIR";
+
+fn wire_code(error: &DevtoolsError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("DevtoolsError must serialize to its wire code string, got {other:?}"),
+    }
+}
+
+fn fixtures(dir: &Path) -> Vec<PathBuf> {
+    let mut files: Vec<PathBuf> = fs::read_dir(dir)
+        .unwrap_or_else(|error| panic!("{} is readable: {error}", dir.display()))
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| path.extension().is_some_and(|ext| ext == "json"))
+        .collect();
+    files.sort();
+    files
+}
+
+fn create(path: &Path) {
+    if path.components().any(|part| part == Component::ParentDir) {
+        return;
+    }
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the fixture's parents are created");
+    }
+    let body: String = (1..=200).map(|n| format!("line {n}\n")).collect();
+    fs::write(path, body).expect("the fixture's file is created");
+}
+
+fn reroot(request: &mut Value, root: &Path) {
+    let original_root = request
+        .get("project_root")
+        .and_then(Value::as_str)
+        .map(str::to_string);
+    request["project_root"] = Value::String(root.to_string_lossy().into_owned());
+    let Some(items) = request.get_mut("items").and_then(Value::as_array_mut) else {
+        return;
+    };
+    for item in items {
+        let Some(file) = item
+            .pointer("/src/file")
+            .and_then(Value::as_str)
+            .map(str::to_string)
+        else {
+            continue;
+        };
+        let rerooted = match &original_root {
+            Some(prefix) => file
+                .strip_prefix(prefix.as_str())
+                .and_then(|rest| rest.strip_prefix('/'))
+                .map(|rest| root.join(rest)),
+            None if !file.starts_with('/') => Some(root.join(&file)),
+            None => None,
+        };
+        if let Some(path) = rerooted {
+            create(&path);
+            item["src"]["file"] = Value::String(path.to_string_lossy().into_owned());
+        }
+    }
+}
+
+fn verdict(mut request: Value, root: &Path) -> String {
+    reroot(&mut request, root);
+    let selection = match serde_json::from_value::<DevtoolsSelection>(request) {
+        Ok(selection) => selection,
+        Err(_) => return "bad_request".to_string(),
+    };
+    let root_canon = fs::canonicalize(root).expect("the temp root exists");
+    match validate(selection, &root_canon) {
+        Ok(_) => "accepted".to_string(),
+        Err(error) => wire_code(&error),
+    }
+}
+
+#[test]
+fn contract_agreement_rust_validator_agrees_with_every_shared_fixture() {
+    let Some(contract) = std::env::var_os(ENV) else {
+        eprintln!(
+            "SKIPPED contract_agreement: {ENV} is unset; point it at zeo-devtools/test/contract \
+             to hold the Rust validator to the shared fixtures"
+        );
+        return;
+    };
+    let contract = PathBuf::from(contract);
+    let mut mismatches = Vec::new();
+    let mut checked = 0;
+
+    for kind in ["valid", "invalid"] {
+        let files = fixtures(&contract.join(kind));
+        assert!(
+            !files.is_empty(),
+            "{} holds no fixture: a set variable must never pass on nothing",
+            contract.join(kind).display()
+        );
+        for file in files {
+            let text = fs::read_to_string(&file).expect("the fixture is readable");
+            let mut request: Value = serde_json::from_str(&text)
+                .unwrap_or_else(|error| panic!("{} is JSON: {error}", file.display()));
+            let expect = request
+                .as_object_mut()
+                .and_then(|object| object.remove("$expect"))
+                .map(|value| value.as_str().map(str::to_string));
+            let expected = match (kind, expect) {
+                ("valid", None) => "accepted".to_string(),
+                ("invalid", Some(Some(code))) => code,
+                (_, other) => panic!(
+                    "{}: a {kind} fixture has an unexpected `$expect`: {other:?}",
+                    file.display()
+                ),
+            };
+            let tmp = tempfile::tempdir().expect("a temp root");
+            let root = fs::canonicalize(tmp.path())
+                .expect("canonical")
+                .join("project");
+            fs::create_dir_all(&root).expect("the temp project root");
+            let got = verdict(request, &root);
+            checked += 1;
+            if got != expected {
+                mismatches.push(format!(
+                    "{}: expected {expected}, got {got}",
+                    file.display()
+                ));
+            }
+        }
+    }
+
+    assert!(
+        mismatches.is_empty(),
+        "{} of {checked} fixtures disagree:\n{}",
+        mismatches.len(),
+        mismatches.join("\n")
+    );
+}
diff --git a/crates/devtools_bridge/src/devtools_bridge.rs b/crates/devtools_bridge/src/devtools_bridge.rs
new file mode 100644
index 0000000..a5d46cb
--- /dev/null
+++ b/crates/devtools_bridge/src/devtools_bridge.rs
@@ -0,0 +1,131 @@
+//! The devtools bridge: a unix socket at `$XDG_RUNTIME_DIR/zeo/devtools.sock` that receives
+//! element selections from a dev-server page and hands them to the agent panel.
+//!
+//! [`init`] starts it at app startup, follows the `devtools_bridge.enabled` setting live and
+//! removes the socket on quit. A bridge that cannot listen logs why and leaves the rest of the
+//! app alone.
+
+pub mod listener;
+pub mod protocol;
+mod setting;
+pub mod wiring;
+
+pub use setting::DevtoolsBridgeSettings;
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use gpui::{App, BorrowAppContext as _, Global};
+use settings::{Settings as _, SettingsStore};
+use workspace::AppState;
+
+use crate::listener::Listener;
+use crate::wiring::Relay;
+
+/// Starts the bridge in `<XDG_RUNTIME_DIR>/zeo`. Call once during app startup.
+pub fn init(app_state: Arc<AppState>, cx: &mut App) {
+    // An unset, empty or relative runtime dir is refused, and `socket_dir` has already logged
+    // why: logging it here too would make it two lines for one refusal.
+    let Ok(dir) = listener::socket_dir(std::env::var_os("XDG_RUNTIME_DIR").as_deref()) else {
+        return;
+    };
+    init_in(dir, app_state, cx);
+}
+
+/// [`init`] with the socket directory passed in.
+pub fn init_in(dir: PathBuf, app_state: Arc<AppState>, cx: &mut App) {
+    let enabled = DevtoolsBridgeSettings::get_global(cx).enabled;
+    let mut bridge = DevtoolsBridge {
+        dir,
+        relay: Relay::new(app_state, cx),
+        enabled,
+        listener: None,
+    };
+    if enabled {
+        bridge.listen();
+    } else {
+        bridge.log_disabled();
+    }
+    cx.set_global(bridge);
+
+    cx.observe_global::<SettingsStore>(|cx| {
+        let enabled = DevtoolsBridgeSettings::get_global(cx).enabled;
+        if cx.has_global::<DevtoolsBridge>() {
+            cx.update_global(|bridge: &mut DevtoolsBridge, _| bridge.set_enabled(enabled));
+        }
+    })
+    .detach();
+
+    // `Drop` does not run when the process exits, so the socket is removed here.
+    cx.on_app_quit(|cx| {
+        if cx.has_global::<DevtoolsBridge>() {
+            cx.update_global(|bridge: &mut DevtoolsBridge, _| bridge.stop());
+        }
+        async {}
+    })
+    .detach();
+}
+
+/// The bridge's state for the app's whole life. Holding the [`Listener`] keeps the directory's
+/// lock; dropping it stops the listener.
+struct DevtoolsBridge {
+    dir: PathBuf,
+    /// Hands each selection to the foreground; it outlives every listener started and stopped
+    /// by the setting.
+    relay: Relay,
+    /// The last value of `devtools_bridge.enabled` acted upon.
+    enabled: bool,
+    listener: Option<Listener>,
+}
+
+impl Global for DevtoolsBridge {}
+
+impl DevtoolsBridge {
+    /// Acts on a change of the setting only. Any other settings change, or saving it as on
+    /// again, leaves a live listener alone, and leaves a refused one refused until the next
+    /// off-and-on.
+    fn set_enabled(&mut self, enabled: bool) {
+        if enabled == self.enabled {
+            return;
+        }
+        self.enabled = enabled;
+        if enabled {
+            self.listen();
+        } else {
+            self.stop();
+            self.log_disabled();
+        }
+    }
+
+    fn listen(&mut self) {
+        if self.listener.is_some() {
+            return;
+        }
+        // `start` logs its own outcome, listening or refused, so its error is not logged again.
+        self.listener = listener::start(&self.dir, self.relay.handler()).ok();
+    }
+
+    fn stop(&mut self) {
+        if let Some(mut listener) = self.listener.take() {
+            listener.stop();
+        }
+    }
+
+    fn log_disabled(&self) {
+        log::info!(
+            "devtools_bridge event=disabled path={} reason=\"devtools_bridge.enabled is false\"",
+            self.dir.join(listener::SOCKET_NAME).display()
+        );
+    }
+}
+
+#[cfg(test)]
+mod contract_agreement_tests;
+#[cfg(test)]
+mod listener_tests;
+#[cfg(test)]
+mod protocol_tests;
+#[cfg(test)]
+mod setting_tests;
+#[cfg(test)]
+mod wiring_tests;
diff --git a/crates/devtools_bridge/src/listener.rs b/crates/devtools_bridge/src/listener.rs
new file mode 100644
index 0000000..018afc3
--- /dev/null
+++ b/crates/devtools_bridge/src/listener.rs
@@ -0,0 +1,1090 @@
+//! The bridge's unix socket: one NDJSON request and one NDJSON response per connection.
+//!
+//! Every log line is `devtools_bridge event=<…> path=<socket> …`. Nothing a page sent is ever
+//! logged: no DOM text, attribute value, image byte or path other than the socket's own.
+
+use std::ffi::OsStr;
+use std::fmt;
+use std::fs::{self, File, OpenOptions, TryLockError};
+use std::io;
+use std::os::fd::AsRawFd as _;
+use std::os::unix::ffi::OsStrExt as _;
+use std::os::unix::fs::{
+    FileTypeExt as _, MetadataExt as _, OpenOptionsExt as _, PermissionsExt as _,
+};
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+
+use anyhow::{Context as _, Result, anyhow};
+use futures::FutureExt as _;
+use futures::future::BoxFuture;
+use nix::errno::Errno;
+use nix::sys::socket::{
+    AddressFamily, SockFlag, SockType, UnixAddr, connect, getsockopt, socket,
+    sockopt::PeerCredentials,
+};
+use nix::unistd::geteuid;
+use smol::io::{AsyncReadExt as _, AsyncWriteExt as _};
+use smol::{Async, Executor, Timer};
+
+use crate::protocol::{self, DevtoolsError, DevtoolsResult, DevtoolsSelection};
+
+/// Called once per request that passed validation; its result is the connection's answer.
+pub type Handler =
+    Arc<dyn Fn(DevtoolsSelection) -> BoxFuture<'static, DevtoolsResult> + Send + Sync>;
+
+/// What [`start`] runs per valid request. Unlike a [`Handler`], it may answer `None`: the
+/// connection is then closed without an answer, which the relay reports as its own
+/// `unreachable` — a code Zeo never writes itself.
+#[derive(Clone)]
+pub struct RequestHandler(
+    Arc<dyn Fn(DevtoolsSelection) -> BoxFuture<'static, Option<DevtoolsResult>> + Send + Sync>,
+);
+
+impl RequestHandler {
+    pub fn new(
+        handler: impl Fn(DevtoolsSelection) -> BoxFuture<'static, Option<DevtoolsResult>>
+        + Send
+        + Sync
+        + 'static,
+    ) -> Self {
+        Self(Arc::new(handler))
+    }
+
+    pub fn call(&self, selection: DevtoolsSelection) -> BoxFuture<'static, Option<DevtoolsResult>> {
+        (self.0)(selection)
+    }
+}
+
+impl From<Handler> for RequestHandler {
+    fn from(handler: Handler) -> Self {
+        Self::new(move |selection| handler(selection).map(Some).boxed())
+    }
+}
+
+pub const SOCKET_NAME: &str = "devtools.sock";
+/// Held, with an exclusive `flock`, for as long as a Zeo owns the socket.
+pub const LOCK_NAME: &str = "devtools.lock";
+/// The directory under `$XDG_RUNTIME_DIR` that holds the socket.
+pub const SOCKET_DIR_NAME: &str = "zeo";
+
+pub const MAX_LINE_BYTES: usize = 8 * 1024 * 1024;
+/// From accept to a full request line (R8.6).
+pub const READ_DEADLINE: Duration = Duration::from_secs(5);
+/// From accept to the answer. The relay gives up 10 s after it connects, so an answer later
+/// than this reaches nobody; past it the connection, and its slot, are let go.
+pub const RESPONSE_DEADLINE: Duration = Duration::from_secs(9);
+pub const MAX_CONNECTIONS: usize = 4;
+
+/// Linux `sun_path` is 108 bytes, one of which is the terminating NUL.
+const MAX_SOCKET_PATH_BYTES: usize = 107;
+const READ_CHUNK_BYTES: usize = 64 * 1024;
+/// A failing `accept` (EMFILE, ENFILE) fails again at once; the pause doubles from the first
+/// value to the second while the failures last.
+const ACCEPT_RETRY_FIRST: Duration = Duration::from_millis(100);
+const ACCEPT_RETRY_MAX: Duration = Duration::from_secs(5);
+
+/// Another running Zeo owns the socket; it is left to that Zeo (R7.2).
+#[derive(Debug)]
+pub struct OwnedByAnother {
+    pub path: PathBuf,
+}
+
+impl fmt::Display for OwnedByAnother {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "another Zeo already owns {}; leaving it to that Zeo",
+            self.path.display()
+        )
+    }
+}
+
+impl std::error::Error for OwnedByAnother {}
+
+/// `<xdg_runtime_dir>/zeo`. An unset, empty or relative runtime dir is refused, never replaced
+/// by a fallback such as `/tmp`: that directory is world-writable, so anyone could bind the
+/// socket name there first. The value is a parameter so callers, and tests, decide where it
+/// comes from.
+pub fn socket_dir(xdg_runtime_dir: Option<&OsStr>) -> Result<PathBuf> {
+    let resolved = match xdg_runtime_dir {
+        None => Err(anyhow!("XDG_RUNTIME_DIR is not set")),
+        Some(value) if value.is_empty() => Err(anyhow!("XDG_RUNTIME_DIR is empty")),
+        Some(value) if !Path::new(value).is_absolute() => {
+            Err(anyhow!("XDG_RUNTIME_DIR is relative, not absolute"))
+        }
+        Some(value) => Ok(Path::new(value).join(SOCKET_DIR_NAME)),
+    };
+    if let Err(error) = &resolved {
+        log::warn!("devtools_bridge event=listen_skipped reason=\"{error:#}\"");
+    }
+    resolved
+}
+
+/// Whether the peer at the other end of `stream` runs as `own_uid` (`SO_PEERCRED`). A failure
+/// to read the credentials counts as a mismatch.
+pub fn peer_uid_matches(stream: &UnixStream, own_uid: u32) -> bool {
+    match getsockopt(stream, PeerCredentials) {
+        Ok(credentials) => credentials.uid() == own_uid,
+        Err(error) => {
+            log::warn!(
+                "devtools_bridge event=peer_credentials_failed reason=\"{:#}\"",
+                anyhow::Error::from(error)
+            );
+            false
+        }
+    }
+}
+
+/// A listening bridge. Stopping it, or dropping it, removes the socket file it created and
+/// releases the directory's lock.
+pub struct Listener {
+    path: PathBuf,
+    /// `(dev, ino)` of the socket file this listener bound, so `stop` never removes a file
+    /// that another Zeo has since put at the same path.
+    socket_identity: (u64, u64),
+    /// Locked for the listener's whole life; closing it releases the `flock`.
+    lock: Option<File>,
+    stop: Option<smol::channel::Sender<()>>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Listener {
+    pub fn socket_path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Ends the accept loop, closes the socket, removes its file and releases the lock.
+    /// Calling it again does nothing.
+    pub fn stop(&mut self) {
+        let Some(stop) = self.stop.take() else {
+            return;
+        };
+        // Closing the channel is the signal: the loop's `recv` fails and it returns.
+        drop(stop);
+        if let Some(thread) = self.thread.take()
+            && thread.thread().id() != thread::current().id()
+            && thread.join().is_err()
+        {
+            log::warn!(
+                "devtools_bridge event=stop path={} reason=\"the accept thread panicked\"",
+                self.path.display()
+            );
+        }
+        remove_own_socket(&self.path, self.socket_identity);
+        // Released only after the file is gone, so the next owner never finds this one's socket.
+        drop(self.lock.take());
+        log::info!("devtools_bridge event=stopped path={}", self.path.display());
+    }
+}
+
+impl Drop for Listener {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Deadlines {
+    read: Duration,
+    response: Duration,
+}
+
+impl Deadlines {
+    const CONTRACT: Self = Self {
+        read: READ_DEADLINE,
+        response: RESPONSE_DEADLINE,
+    };
+}
+
+/// Listens on `<dir>/devtools.sock`. The accept loop runs on a thread and executor of its own,
+/// so a slow request never holds up the caller. Every failure is logged here once, with the
+/// socket path, and returned; an `OwnedByAnother` error is the R7.2 case.
+pub fn start(dir: &Path, handler: impl Into<RequestHandler>) -> Result<Listener> {
+    start_with_deadlines(dir, handler, Deadlines::CONTRACT)
+}
+
+fn start_with_deadlines(
+    dir: &Path,
+    handler: impl Into<RequestHandler>,
+    deadlines: Deadlines,
+) -> Result<Listener> {
+    let path = dir.join(SOCKET_NAME);
+    let started = start_listening(dir, &path, handler.into(), deadlines);
+    match &started {
+        Ok(_) => log::info!("devtools_bridge event=listening path={}", path.display()),
+        Err(error) if error.is::<OwnedByAnother>() => log::warn!(
+            "devtools_bridge event=owned_by_another path={} reason=\"{error:#}\"",
+            path.display()
+        ),
+        Err(error) => log::warn!(
+            "devtools_bridge event=listen_failed path={} reason=\"{error:#}\"",
+            path.display()
+        ),
+    }
+    started
+}
+
+fn start_listening(
+    dir: &Path,
+    path: &Path,
+    handler: RequestHandler,
+    deadlines: Deadlines,
+) -> Result<Listener> {
+    // Checked before anything is created: a path the kernel would truncate is refused whole.
+    let path_bytes = path.as_os_str().as_bytes().len();
+    if path_bytes > MAX_SOCKET_PATH_BYTES {
+        anyhow::bail!(
+            "socket path {} is {path_bytes} bytes; a unix socket path holds at most \
+             {MAX_SOCKET_PATH_BYTES}",
+            path.display()
+        );
+    }
+
+    let own_uid = geteuid().as_raw();
+    fs::create_dir_all(dir)
+        .with_context(|| format!("creating the socket directory {}", dir.display()))?;
+    // Checked before the chmod, which would otherwise follow a symlink to someone else's
+    // directory.
+    check_socket_dir(dir, own_uid)?;
+    // An existing directory is tightened too, never trusted at the mode it was found with.
+    fs::set_permissions(dir, fs::Permissions::from_mode(0o700))
+        .with_context(|| format!("setting the socket directory {} to 0700", dir.display()))?;
+
+    // Two Zeos starting at once over a stale socket would both see it refused, and each bind
+    // its own; the lock makes probe → remove → bind one step per directory.
+    let lock = lock_socket_dir(dir, path)?;
+    claim_socket_path(path)?;
+
+    let listener =
+        Async::<UnixListener>::bind(path).with_context(|| format!("binding {}", path.display()))?;
+    // The directory is already 0700, so nobody else can reach the socket in the moment between
+    // bind and chmod; no connection is accepted before the chmod succeeds.
+    let socket_identity = match tighten_socket(path) {
+        Ok(identity) => identity,
+        Err(error) => {
+            drop(listener);
+            remove_socket_file(path);
+            return Err(error);
+        }
+    };
+
+    let (stop, stopped) = smol::channel::bounded::<()>(1);
+    let thread = thread::Builder::new()
+        .name("devtools_bridge".into())
+        .spawn({
+            let path: Arc<Path> = Arc::from(path);
+            move || {
+                let executor = Executor::new();
+                smol::block_on(executor.run(accept_loop(
+                    &executor, listener, handler, own_uid, deadlines, stopped, path,
+                )));
+            }
+        });
+    let thread = match thread {
+        Ok(thread) => thread,
+        Err(error) => {
+            remove_socket_file(path);
+            return Err(anyhow::Error::from(error)
+                .context(format!("spawning the accept thread for {}", path.display())));
+        }
+    };
+
+    Ok(Listener {
+        path: path.to_path_buf(),
+        socket_identity,
+        lock: Some(lock),
+        stop: Some(stop),
+        thread: Some(thread),
+    })
+}
+
+/// The socket directory must be a real directory owned by this user: a symlink, a file or a
+/// directory of another uid is refused, not repaired.
+fn check_socket_dir(dir: &Path, own_uid: u32) -> Result<()> {
+    let metadata = fs::symlink_metadata(dir)
+        .with_context(|| format!("inspecting the socket directory {}", dir.display()))?;
+    if metadata.file_type().is_symlink() {
+        anyhow::bail!("socket directory {} is a symlink; refused", dir.display());
+    }
+    if !metadata.is_dir() {
+        anyhow::bail!(
+            "socket directory {} is not a directory; refused",
+            dir.display()
+        );
+    }
+    if metadata.uid() != own_uid {
+        anyhow::bail!(
+            "socket directory {} belongs to uid {}, not to uid {own_uid}; refused",
+            dir.display(),
+            metadata.uid()
+        );
+    }
+    Ok(())
+}
+
+/// Takes the directory's exclusive lock without waiting. A lock held elsewhere means another
+/// Zeo owns, or is about to own, the socket.
+fn lock_socket_dir(dir: &Path, socket_path: &Path) -> Result<File> {
+    let lock_path = dir.join(LOCK_NAME);
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .mode(0o600)
+        .custom_flags(nix::libc::O_NOFOLLOW)
+        .open(&lock_path)
+        .with_context(|| format!("opening the lock {}", lock_path.display()))?;
+    match file.try_lock() {
+        Ok(()) => {
+            // A lock file left by an older run, or made by hand, is tightened like the directory.
+            file.set_permissions(fs::Permissions::from_mode(0o600))
+                .with_context(|| format!("setting the lock {} to 0600", lock_path.display()))?;
+            Ok(file)
+        }
+        Err(TryLockError::WouldBlock) => Err(OwnedByAnother {
+            path: socket_path.to_path_buf(),
+        }
+        .into()),
+        Err(TryLockError::Error(error)) => {
+            Err(anyhow::Error::from(error).context(format!("locking {}", lock_path.display())))
+        }
+    }
+}
+
+enum Probe {
+    Free,
+    Stale,
+    Owned,
+}
+
+/// Connects without blocking: a live owner whose backlog is full would hold a blocking
+/// `connect` forever, so a connect still in progress counts as an owner.
+fn probe_socket(path: &Path) -> Result<Probe> {
+    let address = UnixAddr::new(path)
+        .with_context(|| format!("building the address of {}", path.display()))?;
+    let probe = socket(
+        AddressFamily::Unix,
+        SockType::Stream,
+        SockFlag::SOCK_NONBLOCK | SockFlag::SOCK_CLOEXEC,
+        None,
+    )
+    .context("creating the probe socket")?;
+    match connect(probe.as_raw_fd(), &address) {
+        Ok(()) | Err(Errno::EAGAIN | Errno::EINPROGRESS) => Ok(Probe::Owned),
+        Err(Errno::ENOENT) => Ok(Probe::Free),
+        Err(Errno::ECONNREFUSED) => Ok(Probe::Stale),
+        Err(errno) => Err(anyhow::Error::from(errno)
+            .context(format!("probing {} for a running Zeo", path.display()))),
+    }
+}
+
+/// Makes `path` free to bind: refuses when a live Zeo answers on it (R7.2), removes it when it
+/// is a socket nobody answers on (R7.3).
+fn claim_socket_path(path: &Path) -> Result<()> {
+    match probe_socket(path)? {
+        Probe::Free => Ok(()),
+        Probe::Owned => Err(OwnedByAnother {
+            path: path.to_path_buf(),
+        }
+        .into()),
+        Probe::Stale => {
+            // `connect` to a regular file is refused too; only a socket is ours to replace.
+            let metadata = match fs::symlink_metadata(path) {
+                Ok(metadata) => metadata,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+                Err(error) => {
+                    return Err(anyhow::Error::from(error)
+                        .context(format!("inspecting the stale socket {}", path.display())));
+                }
+            };
+            if !metadata.file_type().is_socket() {
+                anyhow::bail!(
+                    "{} exists and is not a socket; leaving it in place",
+                    path.display()
+                );
+            }
+            match fs::remove_file(path) {
+                Ok(()) => Ok(()),
+                Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+                Err(error) => Err(anyhow::Error::from(error)
+                    .context(format!("removing the stale socket {}", path.display()))),
+            }
+        }
+    }
+}
+
+fn tighten_socket(path: &Path) -> Result<(u64, u64)> {
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600))
+        .with_context(|| format!("setting the socket {} to 0600", path.display()))?;
+    let metadata = fs::symlink_metadata(path)
+        .with_context(|| format!("reading the socket {} back", path.display()))?;
+    Ok((metadata.dev(), metadata.ino()))
+}
+
+fn remove_socket_file(path: &Path) {
+    if let Err(error) = fs::remove_file(path)
+        && error.kind() != io::ErrorKind::NotFound
+    {
+        log::warn!(
+            "devtools_bridge event=remove_failed path={} reason=\"{error}\"",
+            path.display()
+        );
+    }
+}
+
+fn remove_own_socket(path: &Path, identity: (u64, u64)) {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if (metadata.dev(), metadata.ino()) == identity => remove_socket_file(path),
+        Ok(_) => log::info!(
+            "devtools_bridge event=stop path={} reason=\"the socket file is no longer ours; \
+             left in place\"",
+            path.display()
+        ),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => log::warn!(
+            "devtools_bridge event=remove_failed path={} reason=\"{error}\"",
+            path.display()
+        ),
+    }
+}
+
+/// The pause after each failed `accept` in a run of failures, and whether to log it: only the
+/// first failure of a run is a warning, so a persistent EMFILE cannot flood the log.
+#[derive(Default)]
+struct AcceptBackoff {
+    failures: u32,
+}
+
+impl AcceptBackoff {
+    /// The pause before the next `accept`, and whether this failure starts a run.
+    fn failed(&mut self) -> (Duration, bool) {
+        let starts_run = self.failures == 0;
+        let doublings = self.failures.min(31);
+        self.failures = self.failures.saturating_add(1);
+        let pause = ACCEPT_RETRY_FIRST
+            .saturating_mul(1u32 << doublings)
+            .min(ACCEPT_RETRY_MAX);
+        (pause, starts_run)
+    }
+
+    /// How many failures the run that just ended had, if one did.
+    fn succeeded(&mut self) -> Option<u32> {
+        (self.failures > 0).then(|| std::mem::take(&mut self.failures))
+    }
+}
+
+async fn accept_loop(
+    executor: &Executor<'static>,
+    listener: Async<UnixListener>,
+    handler: RequestHandler,
+    own_uid: u32,
+    deadlines: Deadlines,
+    stopped: smol::channel::Receiver<()>,
+    path: Arc<Path>,
+) {
+    let active = Arc::new(AtomicUsize::new(0));
+    let mut backoff = AcceptBackoff::default();
+    loop {
+        let accepted = smol::future::or(async { Some(listener.accept().await) }, async {
+            // Only ever closed, never sent on: either way the loop ends.
+            stopped.recv().await.ok();
+            None
+        })
+        .await;
+        let Some(accepted) = accepted else {
+            break;
+        };
+        let accepted_at = Instant::now();
+        match accepted {
+            Ok((stream, _)) => {
+                if let Some(failures) = backoff.succeeded() {
+                    log::info!(
+                        "devtools_bridge event=accept_recovered path={} failures={failures}",
+                        path.display()
+                    );
+                }
+                let Some(slot) = Slot::acquire(&active) else {
+                    log::warn!(
+                        "devtools_bridge event=busy path={} reason=\"{MAX_CONNECTIONS} \
+                         connections already being served; closed\"",
+                        path.display()
+                    );
+                    continue;
+                };
+                executor
+                    .spawn(serve(
+                        stream,
+                        handler.clone(),
+                        own_uid,
+                        accepted_at,
+                        deadlines,
+                        path.clone(),
+                        slot,
+                    ))
+                    .detach();
+            }
+            Err(error) => {
+                let (pause, starts_run) = backoff.failed();
+                if starts_run {
+                    log::warn!(
+                        "devtools_bridge event=accept_failed path={} reason=\"{error}\"; \
+                         retrying with a growing pause, up to {}s",
+                        path.display(),
+                        ACCEPT_RETRY_MAX.as_secs()
+                    );
+                } else {
+                    log::debug!(
+                        "devtools_bridge event=accept_failed path={} reason=\"{error}\" \
+                         pause_ms={}",
+                        path.display(),
+                        pause.as_millis()
+                    );
+                }
+                // A real-time pause on this thread's own reactor: there is no GPUI executor
+                // here, so `BackgroundExecutor::timer` is not available. Raced against the stop
+                // signal, so `stop` never waits out a pause of up to ACCEPT_RETRY_MAX.
+                let stopping = smol::future::or(
+                    async {
+                        Timer::at(Instant::now() + pause).await;
+                        false
+                    },
+                    async {
+                        stopped.recv().await.ok();
+                        true
+                    },
+                )
+                .await;
+                if stopping {
+                    break;
+                }
+            }
+        }
+    }
+}
+
+/// One of the `MAX_CONNECTIONS` places; dropping it frees the place.
+struct Slot(Arc<AtomicUsize>);
+
+impl Slot {
+    fn acquire(active: &Arc<AtomicUsize>) -> Option<Self> {
+        if active.fetch_add(1, Ordering::SeqCst) >= MAX_CONNECTIONS {
+            active.fetch_sub(1, Ordering::SeqCst);
+            return None;
+        }
+        Some(Self(active.clone()))
+    }
+}
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+enum Request {
+    Line(Vec<u8>),
+    TooLarge,
+    Closed,
+}
+
+async fn serve(
+    stream: Async<UnixStream>,
+    handler: RequestHandler,
+    own_uid: u32,
+    accepted_at: Instant,
+    deadlines: Deadlines,
+    path: Arc<Path>,
+    _slot: Slot,
+) {
+    if !peer_uid_matches(stream.get_ref(), own_uid) {
+        log::warn!(
+            "devtools_bridge event=peer_refused path={} reason=\"the peer runs as another uid; \
+             closed unread\"",
+            path.display()
+        );
+        return;
+    }
+
+    // The deadline runs from accept to a full line (R8.6); a real-time timer for the same
+    // reason as the accept loop's pause.
+    let request = smol::future::or(async { Some(read_request(&stream).await) }, async {
+        Timer::at(accepted_at + deadlines.read).await;
+        None
+    })
+    .await;
+    let line = match request {
+        None => {
+            log::warn!(
+                "devtools_bridge event=read_timeout path={} reason=\"no full line within {}ms; \
+                 closed\"",
+                path.display(),
+                deadlines.read.as_millis()
+            );
+            return;
+        }
+        Some(Err(error)) => {
+            log::warn!(
+                "devtools_bridge event=read_failed path={} reason=\"{error}\"",
+                path.display()
+            );
+            return;
+        }
+        Some(Ok(Request::Closed)) => return,
+        Some(Ok(Request::TooLarge)) => None,
+        Some(Ok(Request::Line(line))) => Some(line),
+    };
+
+    let answer = async move {
+        match line {
+            None => Some(DevtoolsResult::from(DevtoolsError::TooLarge)),
+            // Parsing an 8 MiB line and canonicalizing paths are blocking work; neither may
+            // hold up the accept loop.
+            Some(line) => match smol::unblock(move || parse_and_validate(&line)).await {
+                Ok(selection) => handler.call(selection).await,
+                Err(error) => Some(DevtoolsResult::from(error)),
+            },
+        }
+    };
+    // Without this deadline a handler that never answers would hold its slot forever, and four
+    // of them would close the bridge to every later request.
+    let result = smol::future::or(async { Some(answer.await) }, async {
+        Timer::at(accepted_at + deadlines.response).await;
+        None
+    })
+    .await;
+    let Some(result) = result else {
+        // No answer: past this deadline the relay has already reported its own `timeout`.
+        log::warn!(
+            "devtools_bridge event=handler_timeout path={} reason=\"no answer within {}ms of \
+             accept; closed\"",
+            path.display(),
+            deadlines.response.as_millis()
+        );
+        return;
+    };
+    let Some(result) = result else {
+        // The handler has logged why it does not answer.
+        log::debug!(
+            "devtools_bridge event=closed_unanswered path={}",
+            path.display()
+        );
+        return;
+    };
+    if let DevtoolsResult::Failure { error, .. } = &result {
+        log::info!(
+            "devtools_bridge event=request_refused path={} error={}",
+            path.display(),
+            error.code()
+        );
+    }
+
+    if let Err(error) = write_response(&stream, &result).await {
+        log::warn!(
+            "devtools_bridge event=write_failed path={} reason=\"{error:#}\"",
+            path.display()
+        );
+    }
+}
+
+/// Reads at most `MAX_LINE_BYTES + 1` bytes, up to the first newline. A peer that closes its
+/// side after a line without a trailing newline has still sent the whole line.
+async fn read_request(mut stream: &Async<UnixStream>) -> io::Result<Request> {
+    let mut line = Vec::new();
+    let mut chunk = vec![0u8; READ_CHUNK_BYTES];
+    loop {
+        let room = (MAX_LINE_BYTES + 1 - line.len()).min(chunk.len());
+        let Some(window) = chunk.get_mut(..room) else {
+            return Ok(Request::TooLarge);
+        };
+        let read = stream.read(window).await?;
+        let Some(received) = window.get(..read) else {
+            return Ok(Request::TooLarge);
+        };
+        if received.is_empty() {
+            return Ok(if line.is_empty() {
+                Request::Closed
+            } else {
+                Request::Line(line)
+            });
+        }
+        if let Some(newline) = received.iter().position(|byte| *byte == b'\n') {
+            line.extend_from_slice(received.get(..newline).unwrap_or_default());
+            return Ok(Request::Line(line));
+        }
+        line.extend_from_slice(received);
+        if line.len() > MAX_LINE_BYTES {
+            return Ok(Request::TooLarge);
+        }
+    }
+}
+
+fn parse_and_validate(line: &[u8]) -> Result<DevtoolsSelection, DevtoolsError> {
+    let selection = protocol::parse(line)?;
+    // A root that does not canonicalize is passed on as written: `validate` still answers its
+    // limits first, then refuses it as `outside_project`, since it is not a directory.
+    let root_canon = fs::canonicalize(&selection.project_root)
+        .unwrap_or_else(|_| PathBuf::from(&selection.project_root));
+    protocol::validate(selection, &root_canon)
+}
+
+async fn write_response(mut stream: &Async<UnixStream>, result: &DevtoolsResult) -> Result<()> {
+    let mut response = serde_json::to_vec(result).context("serializing the response")?;
+    response.push(b'\n');
+    stream
+        .write_all(&response)
+        .await
+        .context("writing the response")?;
+    stream.flush().await.context("flushing the response")
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::{BufRead as _, BufReader, Write as _};
+    use std::os::unix::fs::symlink;
+    use std::sync::{Barrier, mpsc};
+
+    use nix::sys::socket::{Backlog, bind, listen};
+    use serde_json::{Value, json};
+
+    use super::*;
+
+    struct Fixture {
+        _tmp: tempfile::TempDir,
+        base: PathBuf,
+        dir: PathBuf,
+        root: PathBuf,
+    }
+
+    fn fixture() -> Fixture {
+        let tmp = tempfile::tempdir().expect("a temp dir");
+        let base = fs::canonicalize(tmp.path()).expect("the temp dir canonicalizes");
+        let root = base.join("app");
+        fs::create_dir_all(root.join("src")).expect("the project tree");
