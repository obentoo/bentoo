+            json!(-1),
+            json!(null),
+            json!("1"),
+            json!([1]),
+            json!(1.5),
+        ] {
+            assert_eq!(
+                parse(&line(version.clone())).err(),
+                Some(DevtoolsError::UnsupportedVersion),
+                "v = {version}"
+            );
+        }
+        assert_eq!(
+            parse(&line(json!(1))).err(),
+            Some(DevtoolsError::BadRequest),
+            "v = 1 with an unknown key"
+        );
+        let missing = br#"{"project_root":"/p/app","page_url":"","items":[],"screenshot":null}"#;
+        assert_eq!(parse(missing).err(), Some(DevtoolsError::BadRequest));
+        assert_eq!(parse(b"not json").err(), Some(DevtoolsError::BadRequest));
+    }
+
+    #[test]
+    fn protocol_parse_refuses_a_request_written_as_an_array() {
+        let array = br#"[1, "/p/app", "http://localhost:5173/", [], null]"#;
+        assert_eq!(parse(array).err(), Some(DevtoolsError::BadRequest));
+    }
+
+    #[test]
+    fn protocol_parse_accepts_a_well_formed_request() {
+        let request = json!({
+            "v": 1,
+            "project_root": "/p/app",
+            "page_url": "http://localhost:5173/",
+            "items": [{
+                "src": { "file": "/p/app/src/App.tsx", "line": 1, "column": 1, "end_line": 1 },
+                "component": null,
+                "dom": {
+                    "tag": "div", "id": null, "classes": [], "text": "", "attrs": {},
+                    "styles": {}, "rect": { "x": 0, "y": 0, "w": 1, "h": 1 }
+                }
+            }],
+            "screenshot": null
+        });
+        let parsed = parse(request.to_string().as_bytes());
+        assert_eq!(parsed.map(|selection| selection.items.len()), Ok(1));
+    }
+
+    // A lone surrogate cannot be a shared fixture: the agreement harness reads fixtures
+    // through serde_json, which refuses it before validation. zod refuses it as well
+    // (contract.test.ts), so both ends answer bad_request.
+    #[test]
+    fn protocol_parse_refuses_a_lone_surrogate() {
+        let well_formed = json!({
+            "v": 1,
+            "project_root": "/p/app",
+            "page_url": "http://localhost:5173/",
+            "items": [{
+                "src": { "file": "/p/app/src/App.tsx", "line": 1, "column": 1, "end_line": 1 },
+                "component": null,
+                "dom": {
+                    "tag": "div", "id": null, "classes": [], "text": "LONE", "attrs": {},
+                    "styles": {}, "rect": { "x": 0, "y": 0, "w": 1, "h": 1 }
+                }
+            }],
+            "screenshot": null
+        })
+        .to_string();
+        let line = well_formed.replace("LONE", "Save \\ud800 draft");
+        assert_ne!(line, well_formed);
+        assert_eq!(
+            parse(line.as_bytes()).map(|selection| selection.items.len()),
+            Err(DevtoolsError::BadRequest)
+        );
+    }
+
+    struct Project {
+        _tmp: tempfile::TempDir,
+        root: std::path::PathBuf,
+        file: std::path::PathBuf,
+    }
+
+    fn project() -> Option<Project> {
+        let tmp = tempfile::tempdir().ok()?;
+        let root = fs::canonicalize(tmp.path()).ok()?;
+        let file = root.join("App.tsx");
+        fs::write(&file, "x\n").ok()?;
+        Some(Project {
+            _tmp: tmp,
+            root,
+            file,
+        })
+    }
+
+    fn selection(file: &Path, screenshot: serde_json::Value) -> Option<DevtoolsSelection> {
+        serde_json::from_value(json!({
+            "v": 1,
+            "project_root": file.parent()?.to_string_lossy(),
+            "page_url": "http://localhost:5173/",
+            "items": [{
+                "src": { "file": file.to_string_lossy(), "line": 1, "column": 1, "end_line": 1 },
+                "component": null,
+                "dom": {
+                    "tag": "div", "id": null, "classes": [], "text": "", "attrs": {},
+                    "styles": {}, "rect": { "x": 0, "y": 0, "w": 1, "h": 1 }
+                }
+            }],
+            "screenshot": screenshot
+        }))
+        .ok()
+    }
+
+    fn png_10x10_b64() -> String {
+        let mut bytes = PNG_MAGIC.to_vec();
+        bytes.extend_from_slice(&13u32.to_be_bytes());
+        bytes.extend_from_slice(b"IHDR");
+        bytes.extend_from_slice(&10u32.to_be_bytes());
+        bytes.extend_from_slice(&10u32.to_be_bytes());
+        bytes.extend_from_slice(&[8, 6, 0, 0, 0, 0, 0, 0, 0]);
+        base64::engine::general_purpose::STANDARD.encode(bytes)
+    }
+
+    #[test]
+    fn protocol_holds_the_declared_screenshot_size_to_the_ihdr_size() {
+        let Some(project) = project() else {
+            panic!("the temp project is created");
+        };
+        for (w, h, expected) in [
+            (10, 20, Err(DevtoolsError::BadRequest)),
+            (20, 10, Err(DevtoolsError::BadRequest)),
+            (10, 10, Ok(())),
+        ] {
+            let screenshot =
+                json!({ "mime": "image/png", "data_b64": png_10x10_b64(), "w": w, "h": h });
+            let Some(request) = selection(&project.file, screenshot) else {
+                panic!("the request deserializes");
+            };
+            assert_eq!(
+                validate(request, &project.root).map(|_| ()),
+                expected,
+                "declared {w}x{h} for a 10x10 PNG"
+            );
+        }
+    }
+
+    #[test]
+    fn protocol_refuses_a_project_root_that_is_a_regular_file() {
+        let Some(project) = project() else {
+            panic!("the temp project is created");
+        };
+        let Some(request) = selection(&project.file, serde_json::Value::Null) else {
+            panic!("the request deserializes");
+        };
+        assert_eq!(
+            validate(request.clone(), &project.file).err(),
+            Some(DevtoolsError::OutsideProject),
+            "a file root cannot accept itself"
+        );
+        assert!(
+            validate(request, &project.root).is_ok(),
+            "the directory root accepts it"
+        );
+    }
+
+    // A root reached through a symlink comes back as its target, which is the path a Zeo
+    // worktree opened on the real directory holds.
+    #[test]
+    fn protocol_returns_the_canonical_project_root() {
+        let Some(project) = project() else {
+            panic!("the temp project is created");
+        };
+        let Ok(links) = tempfile::tempdir() else {
+            panic!("a second temp dir is created");
+        };
+        let link = links.path().join("link");
+        if let Err(error) = std::os::unix::fs::symlink(&project.root, &link) {
+            panic!("the symlink is created: {error}");
+        }
+        let Some(request) = selection(&link.join("App.tsx"), serde_json::Value::Null) else {
+            panic!("the request deserializes");
+        };
+        assert_eq!(request.project_root, link.to_string_lossy(), "precondition");
+        let root_canon = fs::canonicalize(&link).unwrap_or_else(|_| link.clone());
+        let validated = validate(request, &root_canon);
+        assert_eq!(
+            validated
+                .as_ref()
+                .map(|selection| selection.project_root.as_str()),
+            Ok(project.root.to_string_lossy().as_ref()),
+        );
+        assert_eq!(
+            validated.map(|selection| selection.items.first().map(|item| item.src.file.clone())),
+            Ok(Some(project.file.to_string_lossy().into_owned())),
+        );
+    }
+}
