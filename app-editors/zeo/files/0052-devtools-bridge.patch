+/// Renders `summary` as `key: value` lines inside an `untrusted-page-content`
+/// block, preceded by a note that it is page data, not instructions. Every key
+/// and value is page-controlled and goes through `escape_page_text`.
+fn render_untrusted_dom_summary(summary: &DomSummary) -> String {
+    let mut lines = vec![format!("tag: {}", summary.tag)];
+    if let Some(id) = &summary.id {
+        lines.push(format!("id: {id}"));
+    }
+    if !summary.classes.is_empty() {
+        lines.push(format!("classes: {}", summary.classes.join(" ")));
+    }
+    if !summary.text.is_empty() {
+        lines.push(format!("text: {}", summary.text));
+    }
+    for (name, value) in &summary.attrs {
+        lines.push(format!("attrs.{name}: {value}"));
+    }
+    for (name, value) in &summary.styles {
+        lines.push(format!("styles.{name}: {value}"));
+    }
+    let DomRect { x, y, w, h } = summary.rect;
+    lines.push(format!("rect: x={x} y={y} w={w} h={h}"));
+
+    let mut block = format!(
+        "{UNTRUSTED_PAGE_CONTENT_NOTE}\n<{UNTRUSTED_PAGE_CONTENT_TAG} source=\"dev page DOM\">\n"
+    );
+    for line in lines {
+        block.push_str(&escape_page_text(&line));
+        block.push('\n');
+    }
+    block.push_str(&format!("</{UNTRUSTED_PAGE_CONTENT_TAG}>\n"));
+    block
+}
+
+/// Makes page text safe to place inside the untrusted block: a line break
+/// becomes a space, so a value cannot forge another `key: value` line, and the
+/// `<` of any `<untrusted-page-content` or `</untrusted-page-content`, in any
+/// ASCII case, becomes `&lt;`, so the text cannot close the block early or
+/// open a nested one.
+fn escape_page_text(text: &str) -> String {
+    let mut escaped = String::with_capacity(text.len());
+    for (index, ch) in text.char_indices() {
+        match ch {
+            '\n' | '\r' => escaped.push(' '),
+            '<' if starts_untrusted_tag(&text[index + 1..]) => escaped.push_str("&lt;"),
+            _ => escaped.push(ch),
+        }
+    }
+    escaped
+}
+
+/// Whether `rest`, the text right after a `<`, names the untrusted block tag,
+/// opening or closing, ignoring ASCII case.
+fn starts_untrusted_tag(rest: &str) -> bool {
+    let rest = rest.strip_prefix('/').unwrap_or(rest).as_bytes();
+    rest.get(..UNTRUSTED_PAGE_CONTENT_TAG.len())
+        .is_some_and(|name| name.eq_ignore_ascii_case(UNTRUSTED_PAGE_CONTENT_TAG.as_bytes()))
+}
