@@ -0,0 +1,53 @@
+### Voice input: agent_ui/src/voice_button.rs, voice_notice.rs and the voice_input crate's notices
+### and errors (patch 0185, USE voice). The English is the code's own, byte for byte.
+
+## The composer's button and strip
+
+voice-label = Voice input
+voice-read-only = The composer is read-only
+voice-busy = Voice input is busy in another thread
+voice-awaiting-consent = Voice input is waiting for the model download to be confirmed
+voice-downloading = Voice input is downloading the speech model
+voice-stop-recording = Stop recording
+voice-stop-recording-elapsed = Stop recording ({ $elapsed })
+voice-transcribing = Transcribing…
+voice-transcribing-aria = Transcribing voice input
+voice-with-remote = { $text } — remote: { $host }
+voice-consent = Voice input needs the speech model { $model } ({ $size }) from { $host }. Download it?
+voice-consent-decline = Not now
+voice-consent-download = Download
+voice-download-title = Downloading the speech model
+voice-download-cancel = Cancel
+voice-discarded = Transcript discarded: the thread was closed
+
+## Notices
+
+voice-no-microphone = No microphone available: { $reason }
+voice-microphone-stopped = The microphone stopped: { $reason }
+voice-limit-reached = Recording stopped at the 2-minute limit
+voice-no-speech = No speech was recognised
+voice-cpu-unsupported = Voice input needs a CPU with { $level }
+voice-model-missing = The speech model { $model } is missing; click the microphone to download it again
+voice-model-unreadable = The speech model was unreadable: { $source }
+voice-model-unreadable-redownload = The speech model was unreadable; it will be downloaded again on the next use
+voice-model-undeletable = The speech model was unreadable and could not be deleted ({ $path }): { $error }
+voice-local-failed = Local transcription failed
+voice-download-mismatch = The speech model { $model } did not match its checksum and was deleted
