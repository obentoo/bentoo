+/// What [`ScriptedTransport`] answers one message with: any number of lines, notifications
+/// before the response included, or none to leave a request pending.
+pub type Script = dyn Send + Sync + Fn(&serde_json::Value) -> Vec<serde_json::Value>;
+
+/// A transport that answers each message with whatever its script returns, and records
+/// every message it was sent. Unlike [`FakeTransport`] it can answer with an error object,
+/// send notifications mid-request and leave a request unanswered, which is what a test of a
+/// relay (Zeo's MCP-over-ACP proxy) needs.
+pub struct ScriptedTransport {
+    script: Arc<Script>,
+    sent: SentMessages,
+    tx: futures::channel::mpsc::UnboundedSender<String>,
+    rx: Arc<Mutex<futures::channel::mpsc::UnboundedReceiver<String>>>,
+}
+
+impl ScriptedTransport {
+    /// `script` sees every message but `initialize`, which gets a minimal answer carrying
+    /// `instructions` when given.
+    pub fn new(
+        instructions: Option<&str>,
+        script: impl 'static + Send + Sync + Fn(&serde_json::Value) -> Vec<serde_json::Value>,
+    ) -> Self {
+        let (tx, rx) = futures::channel::mpsc::unbounded();
+        let instructions = instructions.map(str::to_owned);
+        let script = move |message: &serde_json::Value| {
+            if message["method"] == "initialize" {
+                let mut result = serde_json::json!({
+                    "protocolVersion": crate::types::LATEST_PROTOCOL_VERSION,
+                    "capabilities": { "tools": { "listChanged": true } },
+                    "serverInfo": { "name": "scripted", "version": "1.0.0" },
+                });
+                if let Some(instructions) = &instructions {
+                    result["instructions"] = instructions.clone().into();
+                }
+                vec![serde_json::json!({ "jsonrpc": "2.0", "id": message["id"], "result": result })]
+            } else {
+                script(message)
+            }
+        };
+        Self {
+            script: Arc::new(script),
+            sent: Default::default(),
+            tx,
+            rx: Arc::new(Mutex::new(rx)),
+        }
+    }
+
+    /// A handle on every message the transport is sent, in order.
+    pub fn sent(&self) -> SentMessages {
+        self.sent.clone()
+    }
+}
+
+/// The messages a [`ScriptedTransport`] was sent; it keeps filling after the transport moves
+/// into a server.
+#[derive(Clone, Default)]
+pub struct SentMessages(Arc<parking_lot::Mutex<Vec<serde_json::Value>>>);
+
+impl SentMessages {
+    pub fn snapshot(&self) -> Vec<serde_json::Value> {
+        self.0.lock().clone()
+    }
+}
+
+#[async_trait::async_trait]
+impl Transport for ScriptedTransport {
+    async fn send(&self, message: String) -> anyhow::Result<()> {
+        let message: serde_json::Value = serde_json::from_str(&message)?;
+        let replies = (self.script)(&message);
+        self.sent.0.lock().push(message);
+        for reply in replies {
+            self.tx
+                .unbounded_send(reply.to_string())
+                .context("sending a message")?;
+        }
+        Ok(())
+    }
+
+    fn receive(&self) -> Pin<Box<dyn Stream<Item = String> + Send>> {
+        let rx = self.rx.clone();
+        Box::pin(futures::stream::unfold(rx, move |rx| async move {
+            let message = rx.lock().await.next().await?;
+            Some((message, rx))
+        }))
+    }
+
+    fn receive_err(&self) -> Pin<Box<dyn Stream<Item = String> + Send>> {
+        Box::pin(futures::stream::empty())
+    }
+}
