+/// An MCP server's JSON-RPC error object as it sent it, for [`Client::request_raw`].
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct McpErrorObject {
+    pub code: i32,
+    pub message: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub data: Option<Value>,
+}
+
+/// Splits a response line into its result or its error object. A response with neither is
+/// a broken server, not an MCP error, so it fails the request.
+fn raw_outcome(response: &str) -> Result<std::result::Result<Value, McpErrorObject>> {
+    let mut response: Value = serde_json::from_str(response)?;
+    let object = response
+        .as_object_mut()
+        .context("Invalid response: not an object")?;
+    if let Some(error) = object.remove("error").filter(|error| !error.is_null()) {
+        return Ok(Err(
+            serde_json::from_value(error).context("Invalid response: malformed error object")?
+        ));
+    }
+    match object.remove("result") {
+        Some(result) => Ok(Ok(result)),
+        None => anyhow::bail!("Invalid response: no result or error"),
+    }
+}
