+//! `request_raw` and the server's `instructions`: what Zeo's MCP-over-ACP proxy relays to an
+//! agent must be what the server sent (next proposal §6.69).
+
+use std::sync::Arc;
+
+use futures::channel::oneshot;
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use crate::client::{McpErrorObject, RequestCanceled};
+use crate::test::ScriptedTransport;
+use crate::{ContextServer, ContextServerId};
+
+fn reply(message: &Value, body: Value) -> Vec<Value> {
+    let mut reply = json!({ "jsonrpc": "2.0", "id": message["id"] });
+    for (key, value) in body.as_object().expect("a reply body is an object") {
+        reply[key] = value.clone();
+    }
+    vec![reply]
+}
+
+async fn started(transport: ScriptedTransport, cx: &mut TestAppContext) -> Arc<ContextServer> {
+    let server = Arc::new(ContextServer::new(
+        ContextServerId("scripted".into()),
+        Arc::new(transport),
+    ));
+    server
+        .start(&cx.to_async())
+        .await
+        .expect("the scripted server starts");
+    server
+}
+
+#[gpui::test]
+async fn request_raw_keeps_the_error_object_whole(cx: &mut TestAppContext) {
+    let transport = ScriptedTransport::new(None, |message| match message["method"].as_str() {
+        Some("tools/call") => reply(
+            message,
+            json!({ "error": { "code": -32602, "message": "no such tool", "data": { "tool": "x" } } }),
+        ),
+        _ => Vec::new(),
+    });
+    let server = started(transport, cx).await;
+    let client = server.client().expect("an initialized client");
+
+    let outcome = client
+        .request_raw("tools/call", Some(json!({ "name": "x" })), None)
+        .await
+        .expect("the request reaches the server");
+
+    assert_eq!(
+        outcome,
+        Err(McpErrorObject {
+            code: -32602,
+            message: "no such tool".into(),
+            data: Some(json!({ "tool": "x" })),
+        }),
+        "code and data survive, not only the message"
+    );
+}
+
+#[gpui::test]
+async fn request_raw_returns_the_result_verbatim(cx: &mut TestAppContext) {
+    let result = json!({
+        "content": [{ "type": "text", "text": "hi" }],
+        "structuredContent": { "unknown_to_zed": true },
+        "isError": false,
+    });
+    let expected = result.clone();
+    let transport = ScriptedTransport::new(None, move |message| match message["method"].as_str() {
+        Some("tools/call") => reply(message, json!({ "result": result.clone() })),
+        _ => Vec::new(),
+    });
+    let server = started(transport, cx).await;
+    let client = server.client().expect("an initialized client");
+
+    let outcome = client
+        .request_raw("tools/call", Some(json!({ "name": "x" })), None)
+        .await
+        .expect("the request reaches the server");
+
+    assert_eq!(outcome, Ok(expected), "fields Zed has no type for are kept");
+}
+
+#[gpui::test]
+async fn request_raw_cancellation_tells_the_server(cx: &mut TestAppContext) {
+    // The server never answers tools/call, so only the cancellation can end the request.
+    let transport = ScriptedTransport::new(None, |_| Vec::new());
+    let sent = transport.sent();
+    let server = started(transport, cx).await;
+    let client = server.client().expect("an initialized client");
+
+    let (cancel_tx, cancel_rx) = oneshot::channel();
+    let request = cx.executor().spawn(async move {
+        client
+            .request_raw(
+                "tools/call",
+                Some(json!({ "name": "slow" })),
+                Some(cancel_rx),
+            )
+            .await
+    });
+    cx.run_until_parked();
+    cancel_tx.send(()).expect("the request is still waiting");
+    let error = request.await.expect_err("a cancelled request fails");
+    // The notification is written by the client's output task: let it run.
+    cx.run_until_parked();
+
+    assert!(
+        error.downcast_ref::<RequestCanceled>().is_some(),
+        "the caller can tell a cancellation from a failure: {error:?}"
+    );
+    let sent = sent.snapshot();
+    let call_id = sent
+        .iter()
+        .find(|message| message["method"] == "tools/call")
+        .map(|message| message["id"].clone())
+        .expect("the call was sent");
+    assert!(
+        sent.iter()
+            .any(|message| message["method"] == "notifications/cancelled"
+                && message["params"]["requestId"] == call_id),
+        "the server is told which request to drop: {sent:?}"
+    );
+}
+
+#[gpui::test]
+async fn initialize_keeps_the_server_instructions(cx: &mut TestAppContext) {
+    let transport = ScriptedTransport::new(Some("Call search before read."), |_| Vec::new());
+    let server = started(transport, cx).await;
+
+    let client = server.client().expect("an initialized client");
+    assert_eq!(
+        client.initialize.instructions.as_deref(),
+        Some("Call search before read.")
+    );
+}
