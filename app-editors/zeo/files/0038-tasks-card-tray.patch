diff --git a/crates/agent_ui/src/tasks_card/tray.rs b/crates/agent_ui/src/tasks_card/tray.rs
new file mode 100644
index 0000000..5968ccd
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray.rs
@@ -0,0 +1,217 @@
+//! The tray sender: when a task ends out of view, tell `zeo-systray` over its
+//! datagram socket (story 013, patch `0038`).
+//!
+//! The datagram is the contract shared with `zeo-systray`'s `TaskOutcome`, pinned by
+//! one JSON fixture both repositories test against. Its privacy boundary is the
+//! tray's: identifiers, a path, labels, an outcome and a duration. A task's
+//! description, summary and command line are model-written and never leave Zeo.
+
+use std::{
+    io,
+    os::unix::net::UnixDatagram,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, SystemTime},
+};
+
+use acp_thread::{AgentTask, AgentTaskStatus};
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{App, AppContext as _};
+use serde::Serialize;
+
+use super::{TaskRow, TaskRowStatus, ended_duration};
+
+#[cfg(test)]
+#[path = "tray/decision_tests.rs"]
+mod decision;
+
+#[cfg(test)]
+#[path = "tray/send_tests.rs"]
+mod send;
+
+#[cfg(test)]
+#[path = "tray/wiring_tests.rs"]
+mod wiring;
+
+#[cfg(test)]
+#[path = "tray/dedupe_tests.rs"]
+mod dedupe;
+
+#[cfg(test)]
+#[path = "tray/subagent_tests.rs"]
+mod subagent;
+
+#[cfg(test)]
+#[path = "restored_outcome_tests.rs"]
+mod restored_outcome;
+
+/// What `project` reads when the thread has no work directory.
+const NO_PROJECT: &str = "Zeo";
+
+/// The daemon's socket under `$XDG_RUNTIME_DIR` — `zeo-systray`'s `SOCKET_NAME`.
+const SOCKET_NAME: &str = "zeo-systray.sock";
+
+/// The longest thread title a datagram carries, in characters. ACP bounds no
+/// title, and the daemon reads each datagram into a 64 KiB buffer: past it the
+/// datagram would arrive cut short, as JSON it cannot parse.
+pub(crate) const MAX_TITLE_CHARS: usize = 256;
+
+/// Set by the first failed send: a daemon that is not running fails every send,
+/// and one line per Zeo session is enough to say so (R5.4).
+static SEND_FAILURE_LOGGED: AtomicBool = AtomicBool::new(false);
+
+/// Whether an ended task is worth a tray notification: never while the user is
+/// looking at it (R5.3), otherwise when it is watched (R5.1) or it failed (R5.2).
+pub(crate) fn should_notify(watched: bool, status: AgentTaskStatus, in_view: bool) -> bool {
+    !in_view && (watched || status == AgentTaskStatus::Failed)
+}
+
+/// `should_notify` over a row's own status: a native subagent's Failed is news like a
+/// feed task's (story 064, R6.1).
+pub(crate) fn should_notify_row(watched: bool, status: TaskRowStatus, in_view: bool) -> bool {
+    should_notify(watched, status.to_task_status(), in_view)
+}
+
+/// The datagram of an ended row. Waiting and Unknown are live, so they have no outcome; a
+/// native row's outcome is its registry status, not the feed's word for it.
+pub(crate) fn datagram_for_row(
+    row: &TaskRow,
+    session_id: &acp_v2::SessionId,
+    work_dir: Option<&Path>,
+    thread_title: Option<&str>,
+    now: SystemTime,
+) -> Option<TaskOutcomeDatagram> {
+    if !row.status.is_terminal() {
+        return None;
+    }
+    let mut task = row.task.clone();
+    task.status = row.status.to_task_status();
+    datagram_for(&task, session_id, work_dir, thread_title, now)
+}
+
+/// One task-outcome datagram, serialised as one JSON object. The fields are exactly
+/// `zeo-systray`'s `TaskOutcome`; there is deliberately no field that could carry a
+/// task's description, summary or command line (R5.5).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub(crate) struct TaskOutcomeDatagram {
+    task_outcome: &'static str,
+    session_id: String,
+    task_id: String,
+    cwd: String,
+    project: String,
+    /// Written as `null` when absent, never omitted, so the daemon parses one shape.
+    thread_title: Option<String>,
+    task_type: String,
+    duration_ms: u64,
+}
+
+/// Builds the datagram for an ended task; `None` for a task still running, which
+/// has no outcome to report.
+pub(crate) fn datagram_for(
+    task: &AgentTask,
+    session_id: &acp_v2::SessionId,
+    work_dir: Option<&Path>,
+    thread_title: Option<&str>,
+    now: SystemTime,
+) -> Option<TaskOutcomeDatagram> {
+    let task_outcome = outcome_word(task.status)?;
+    let duration = ended_duration(task)
+        .unwrap_or_else(|| now.duration_since(task.started_at).unwrap_or_default());
+    let (cwd, project) = match work_dir {
+        Some(dir) => {
+            let cwd = dir.to_string_lossy().into_owned();
+            // Same fallback as the hook side: a directory with no last component
+            // (`/`) is labelled by its own path.
+            let project = dir
+                .file_name()
+                .map(|name| name.to_string_lossy().into_owned())
+                .unwrap_or_else(|| cwd.clone());
+            (cwd, project)
+        }
+        None => (String::new(), NO_PROJECT.to_string()),
+    };
+    Some(TaskOutcomeDatagram {
+        task_outcome,
+        session_id: session_id.to_string(),
+        task_id: capped(&task.id),
+        cwd,
+        project,
+        thread_title: thread_title.map(capped),
+        // The adapter names the type and the id; capped like the title, so no field
+        // the agent controls can push the datagram past the daemon's 64 KiB buffer.
+        task_type: capped(&task.kind),
+        duration_ms: duration_millis(duration),
+    })
+}
+
+/// `text` cut to `MAX_TITLE_CHARS` characters, on a character boundary.
+fn capped(text: &str) -> String {
+    text.chars().take(MAX_TITLE_CHARS).collect()
+}
+
+/// The wire spelling of an ended status, matching `zeo-systray`'s `Outcome`.
+fn outcome_word(status: AgentTaskStatus) -> Option<&'static str> {
+    match status {
+        AgentTaskStatus::Running => None,
+        AgentTaskStatus::Completed => Some("completed"),
+        AgentTaskStatus::Failed => Some("failed"),
+        AgentTaskStatus::Stopped => Some("stopped"),
+        AgentTaskStatus::Interrupted => Some("interrupted"),
+    }
+}
+
+/// Milliseconds as the wire's `u64`, saturating rather than wrapping.
+fn duration_millis(duration: Duration) -> u64 {
+    u64::try_from(duration.as_millis()).unwrap_or(u64::MAX)
+}
+
+/// Sends one datagram to `zeo-systray`, without ever waiting for it (R5.4).
+///
+/// No runtime dir means no daemon to reach: `Ok(())`, and nothing is sent. An
+/// absent socket, a refused send or a full queue — `WouldBlock`, since the socket
+/// is non-blocking — is an `Err` for the caller to drop.
+pub(crate) fn send(datagram: &TaskOutcomeDatagram) -> io::Result<()> {
+    let Some(path) = socket_path() else {
+        return Ok(());
+    };
+    let payload = serde_json::to_vec(datagram)?;
+    let socket = UnixDatagram::unbound()?;
+    // A blocking send would wait behind a daemon that stopped reading.
+    socket.set_nonblocking(true)?;
+    socket.send_to(&payload, path)?;
+    Ok(())
+}
+
+/// `$XDG_RUNTIME_DIR/zeo-systray.sock`, or `None` without a usable runtime dir.
+///
+/// Never a fallback such as `/tmp`: it is world-writable, so anyone could bind
+/// the socket name there first and read every outcome Zeo sends. A relative
+/// value — an empty one included — is ignored, as the XDG spec asks.
+fn socket_path() -> Option<PathBuf> {
+    let dir = PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR")?);
+    dir.is_absolute().then(|| dir.join(SOCKET_NAME))
+}
+
+/// Sends `datagram` off the UI thread, dropping it if the daemon does not take
+/// it; only the session's first failure is logged.
+pub(crate) fn send_in_background(datagram: TaskOutcomeDatagram, cx: &App) {
+    cx.background_spawn(async move {
+        if let Err(error) = send(&datagram) {
+            log_send_failure(&datagram, &error);
+        }
+    })
+    .detach();
+}
+
+/// Ids only: the rest of the datagram is the user's, and stays out of the log.
+fn log_send_failure(datagram: &TaskOutcomeDatagram, error: &io::Error) {
+    if SEND_FAILURE_LOGGED.swap(true, Ordering::Relaxed) {
+        return;
+    }
+    log::debug!(
+        "tasks card: zeo-systray did not take the outcome of task {} of session {}; \
+         dropped: {error}. Later failures this session are not logged",
+        datagram.task_id,
+        datagram.session_id
+    );
+}
diff --git a/crates/agent_ui/src/tasks_card/tray/decision_tests.rs b/crates/agent_ui/src/tasks_card/tray/decision_tests.rs
new file mode 100644
index 0000000..2be26f8
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray/decision_tests.rs
@@ -0,0 +1,265 @@
+// Story 013 / task 6.1 — `should_notify` and `TaskOutcomeDatagram`
+// (R5.1, R5.2, R5.3, R5.5, Q12). Filter: `tasks_card::tray::decision`.
+
+use std::{
+    collections::BTreeSet,
+    path::Path,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use acp_thread::{AgentTask, AgentTaskStatus};
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::{TaskOutcomeDatagram, datagram_for, should_notify};
+use crate::tasks_card::test_helpers::*;
+
+/// The shared contract fixture: a byte-identical copy of
+/// `zeo-systray/tests/fixtures/task-outcome.json`, which zeo-systray parses.
+const TASK_OUTCOME_FIXTURE: &str = include_str!("../test_data/task_outcome.json");
+
+const ENDED: [AgentTaskStatus; 4] = [
+    AgentTaskStatus::Completed,
+    AgentTaskStatus::Failed,
+    AgentTaskStatus::Stopped,
+    AgentTaskStatus::Interrupted,
+];
+
+// ---- hostile halves first: the cases where a notification would be WRONG ---------
+
+#[test]
+fn test_an_unwatched_task_that_completes_is_not_notified() {
+    assert!(!should_notify(false, AgentTaskStatus::Completed, false));
+    assert!(!should_notify(false, AgentTaskStatus::Stopped, false));
+    assert!(!should_notify(false, AgentTaskStatus::Interrupted, false));
+}
+
+#[test]
+fn test_nothing_is_notified_while_the_task_is_in_view() {
+    // Watched and completed, but the user is looking at it.
+    assert!(!should_notify(true, AgentTaskStatus::Completed, true));
+    // Even a failure — watched or not — is not sent while in view (R5.3 over R5.2).
+    assert!(!should_notify(true, AgentTaskStatus::Failed, true));
+    assert!(!should_notify(false, AgentTaskStatus::Failed, true));
+}
+
+// ---- then the cases where silence would be WRONG ----------------------------------
+
+#[test]
+fn test_a_failed_task_out_of_view_is_notified_even_unwatched() {
+    assert!(should_notify(false, AgentTaskStatus::Failed, false));
+}
+
+#[test]
+fn test_a_watched_task_out_of_view_is_notified_however_it_ends() {
+    for status in ENDED {
+        assert!(should_notify(true, status, false), "{status:?}");
+    }
+}
+
+/// The whole table, so no cell is left to chance: notify iff out of view and
+/// (watched or failed).
+#[test]
+fn test_the_full_truth_table() {
+    for watched in [false, true] {
+        for in_view in [false, true] {
+            for status in ENDED {
+                let expected = !in_view && (watched || status == AgentTaskStatus::Failed);
+                assert_eq!(
+                    should_notify(watched, status, in_view),
+                    expected,
+                    "watched={watched} status={status:?} in_view={in_view}"
+                );
+            }
+        }
+    }
+}
+
+// ---- the datagram -------------------------------------------------------------------
+
+fn fixture_datagram() -> TaskOutcomeDatagram {
+    TaskOutcomeDatagram {
+        task_outcome: "failed",
+        session_id: "sess-013".into(),
+        task_id: "task-7".into(),
+        cwd: "/home/user/zed-patches".into(),
+        project: "zed-patches".into(),
+        thread_title: Some("Bump the series".into()),
+        task_type: "shell".into(),
+        duration_ms: 20_500,
+    }
+}
+
+/// Q12: what Zeo serialises is exactly what zeo-systray's test parses.
+#[test]
+fn test_the_datagram_serialises_to_the_shared_fixture() {
+    let wire = serde_json::to_value(fixture_datagram()).expect("the datagram serialises");
+    let fixture: serde_json::Value =
+        serde_json::from_str(TASK_OUTCOME_FIXTURE).expect("the fixture is JSON");
+    assert_eq!(wire, fixture);
+}
+
+/// R5.5: the datagram's keys are exactly the contract's — no description, no
+/// summary, no command line, and nothing else that could carry free text.
+#[test]
+fn test_the_datagram_carries_no_free_text_fields() {
+    let wire = serde_json::to_value(fixture_datagram()).expect("the datagram serialises");
+    let keys: BTreeSet<&str> = wire
+        .as_object()
+        .expect("one JSON object")
+        .keys()
+        .map(String::as_str)
+        .collect();
+    let expected: BTreeSet<&str> = [
+        "task_outcome",
+        "session_id",
+        "task_id",
+        "cwd",
+        "project",
+        "thread_title",
+        "task_type",
+        "duration_ms",
+    ]
+    .into_iter()
+    .collect();
+    assert_eq!(keys, expected);
+    for forbidden in [
+        "description",
+        "summary",
+        "command",
+        "last_tool",
+        "output_file",
+    ] {
+        assert!(
+            !keys.contains(forbidden),
+            "{forbidden} must not cross the socket"
+        );
+    }
+}
+
+/// `thread_title` is `string | null`: absent is written as null, not omitted, so the
+/// daemon's parse sees the same shape every time.
+#[test]
+fn test_a_missing_thread_title_is_written_as_null() {
+    let mut datagram = fixture_datagram();
+    datagram.thread_title = None;
+    let wire = serde_json::to_value(datagram).expect("the datagram serialises");
+    assert_eq!(wire.get("thread_title"), Some(&serde_json::Value::Null));
+}
+
+// ---- datagram_for: outcome words, Running, duration fallbacks, work dir -------------
+
+fn at_ms(ms: u64) -> SystemTime {
+    UNIX_EPOCH + Duration::from_millis(ms)
+}
+
+/// The model's tasks for one snapshot, parsed by story 012's code (no struct
+/// literal, so the test does not pin `AgentTask`'s shape). One panel per test:
+/// `init_test` runs once.
+async fn model_tasks(
+    wire: Vec<serde_json::Value>,
+    cx: &mut TestAppContext,
+) -> (Vec<AgentTask>, acp_v2::SessionId, VisualTestContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "T", &mut cx);
+    send_tasks(&thread, wire, &mut cx);
+    let tasks = thread.read_with(&cx, |thread, _| thread.tasks().to_vec());
+    let session = session_of(&thread, &cx);
+    (tasks, session, cx)
+}
+
+fn by_id<'a>(tasks: &'a [AgentTask], id: &str) -> &'a AgentTask {
+    tasks
+        .iter()
+        .find(|task| task.id == id)
+        .unwrap_or_else(|| panic!("task {id} is in the model"))
+}
+
+#[gpui::test]
+async fn test_each_ending_maps_to_its_outcome_word(cx: &mut TestAppContext) {
+    let pairs = [
+        ("completed", "completed"),
+        ("failed", "failed"),
+        ("stopped", "stopped"),
+        ("interrupted", "interrupted"),
+    ];
+    let wire = pairs
+        .iter()
+        .enumerate()
+        .map(|(i, (status, _))| wire_task(status, status, true, 1_000 + i as u64))
+        .collect();
+    let (tasks, session, _visual) = model_tasks(wire, cx).await;
+    for (status, word) in pairs {
+        let datagram = datagram_for(
+            by_id(&tasks, status),
+            &session,
+            None,
+            Some("T"),
+            at_ms(9_000),
+        )
+        .unwrap_or_else(|| panic!("an ended task ({status}) yields a datagram"));
+        assert_eq!(datagram.task_outcome, word);
+    }
+}
+
+/// Hostile half: a task that has not ended must never produce a datagram.
+#[gpui::test]
+async fn test_a_running_task_yields_no_datagram(cx: &mut TestAppContext) {
+    let (tasks, session, _visual) =
+        model_tasks(vec![wire_task("t1", "running", true, 1_000)], cx).await;
+    assert!(datagram_for(by_id(&tasks, "t1"), &session, None, Some("T"), at_ms(9_000)).is_none());
+}
+
+#[gpui::test]
+async fn test_duration_prefers_ended_at_then_usage_then_now(cx: &mut TestAppContext) {
+    // ended_at set (2_000): it wins over a disagreeing usage figure.
+    let mut ended = wire_task("ended", "completed", true, 1_000);
+    ended["usage"] = json!({ "tokens": 1, "toolUses": 1, "durationMs": 99_999 });
+    // No ended_at: usage.duration_ms.
+    let mut usage = wire_task("usage", "completed", true, 1_001);
+    usage["endedAt"] = serde_json::Value::Null;
+    usage["usage"] = json!({ "tokens": 1, "toolUses": 1, "durationMs": 4_321 });
+    // Neither: now - started_at.
+    let mut neither = wire_task("neither", "completed", true, 1_002);
+    neither["endedAt"] = serde_json::Value::Null;
+
+    let (tasks, session, _visual) = model_tasks(vec![ended, usage, neither], cx).await;
+    let now = at_ms(8_002);
+    let duration = |id: &str| {
+        datagram_for(by_id(&tasks, id), &session, None, None, now)
+            .unwrap()
+            .duration_ms
+    };
+    assert_eq!(duration("ended"), 1_000);
+    assert_eq!(duration("usage"), 4_321);
+    assert_eq!(duration("neither"), 7_000);
+}
+
+/// cwd is the thread's first work directory and project its last component; with
+/// no work directory, cwd is empty and project is "Zeo" — never a made-up path.
+#[gpui::test]
+async fn test_cwd_and_project_come_from_the_work_dir_or_fall_back(cx: &mut TestAppContext) {
+    let (tasks, session, _visual) =
+        model_tasks(vec![wire_task("t1", "failed", true, 1_000)], cx).await;
+    let task = by_id(&tasks, "t1");
+    let with_dir = datagram_for(
+        task,
+        &session,
+        Some(Path::new("/home/user/zed-patches")),
+        Some("T"),
+        at_ms(9_000),
+    )
+    .unwrap();
+    assert_eq!(with_dir.cwd, "/home/user/zed-patches");
+    assert_eq!(with_dir.project, "zed-patches");
+    assert_eq!(with_dir.session_id, session.to_string());
+    assert_eq!(with_dir.task_id, "t1");
+    assert_eq!(with_dir.task_type, "shell");
+    assert_eq!(with_dir.thread_title.as_deref(), Some("T"));
+
+    let without = datagram_for(task, &session, None, Some("T"), at_ms(9_000)).unwrap();
+    assert_eq!(without.cwd, "");
+    assert_eq!(without.project, "Zeo");
+}
diff --git a/crates/agent_ui/src/tasks_card/tray/dedupe_tests.rs b/crates/agent_ui/src/tasks_card/tray/dedupe_tests.rs
new file mode 100644
index 0000000..8583740
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray/dedupe_tests.rs
@@ -0,0 +1,277 @@
+// Story 013 / task 9.2 — one ending, one datagram, however many views hold its
+// thread (R5.10). Filter: `tasks_card::tray::dedupe`.
+//
+// Two views of one session share one `AcpThread`: `AcpConnection` hands the thread
+// it already holds to a second caller that loads the same session id. The card
+// subscribes to that thread once per view, so it hears each `TaskEnded` twice.
+//
+// `XDG_RUNTIME_DIR` is process-wide: these tests hold the send tests' `ENV_LOCK`
+// and point it at a tempdir, never at the user's real daemon.
+
+use std::{
+    any::Any,
+    collections::HashMap,
+    io,
+    os::unix::net::UnixDatagram,
+    path::Path,
+    rc::Rc,
+    sync::{Arc, Mutex},
+};
+
+use acp_thread::{AcpThread, AgentConnection};
+use agent_client_protocol::schema::v1 as acp;
+use agent_client_protocol::schema::v2 as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{
+    App, AppContext as _, Entity, SharedString, Task, TestAppContext, VisualTestContext, WeakEntity,
+};
+use project::{AgentId, Project};
+use workspace::{PathList, Workspace};
+
+use super::send::ENV_LOCK;
+use crate::agent_connection_store::AgentConnectionStore;
+use crate::tasks_card::test_helpers::*;
+use crate::test_support::{StubAgentServer, open_thread_with_custom_connection};
+use crate::{Agent, AgentPanel, AgentThreadSource, ConversationView};
+
+fn set_runtime_dir(dir: Option<&Path>) {
+    // SAFETY: serialised by ENV_LOCK; no other thread of these tests reads it meanwhile.
+    unsafe {
+        match dir {
+            Some(dir) => std::env::set_var("XDG_RUNTIME_DIR", dir),
+            None => std::env::remove_var("XDG_RUNTIME_DIR"),
+        }
+    }
+}
+
+/// A runtime dir with the daemon's socket bound in it, as zeo-systray binds it.
+fn bound_socket() -> (tempfile::TempDir, UnixDatagram) {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let socket = UnixDatagram::bind(dir.path().join("zeo-systray.sock")).expect("bind");
+    socket.set_nonblocking(true).expect("nonblocking");
+    (dir, socket)
+}
+
+/// Every datagram waiting on `socket`, parsed.
+fn drain(socket: &UnixDatagram) -> Vec<serde_json::Value> {
+    let mut buffer = vec![0u8; 64 * 1024];
+    let mut received = Vec::new();
+    loop {
+        match socket.recv(&mut buffer) {
+            Ok(n) => received.push(serde_json::from_slice(&buffer[..n]).expect("a JSON datagram")),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => return received,
+            Err(error) => panic!("recv failed: {error}"),
+        }
+    }
+}
+
+/// `TaskActionsConnection`, plus the session reuse of `AcpConnection`: loading a
+/// session that is already open returns the thread that holds it.
+#[derive(Clone)]
+struct SharedSessionConnection {
+    inner: TaskActionsConnection,
+    threads: Arc<Mutex<HashMap<acp_v2::SessionId, WeakEntity<AcpThread>>>>,
+}
+
+impl SharedSessionConnection {
+    fn new() -> Self {
+        Self {
+            inner: TaskActionsConnection::new(),
+            threads: Arc::default(),
+        }
+    }
+}
+
+impl AgentConnection for SharedSessionConnection {
+    fn agent_id(&self) -> AgentId {
+        self.inner.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        self.inner.telemetry_id()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let created = Rc::new(self.inner.clone()).new_session(project, work_dirs, cx);
+        let threads = self.threads.clone();
+        cx.spawn(async move |cx| {
+            let thread = created.await?;
+            let session_id = cx.update(|cx| thread.read(cx).session_id().clone());
+            threads
+                .lock()
+                .map_err(|_| anyhow!("thread registry poisoned"))?
+                .insert(session_id, thread.downgrade());
+            Ok(thread)
+        })
+    }
+
+    fn supports_load_session(&self) -> bool {
+        true
+    }
+
+    fn load_session(
+        self: Rc<Self>,
+        session_id: acp_v2::SessionId,
+        _project: Entity<Project>,
+        _work_dirs: PathList,
+        _title: Option<SharedString>,
+        _cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let held = self
+            .threads
+            .lock()
+            .ok()
+            .and_then(|threads| threads.get(&session_id).and_then(WeakEntity::upgrade));
+        Task::ready(held.ok_or_else(|| anyhow!("session {session_id} is not open")))
+    }
+
+    fn auth_methods(&self) -> &[agent_client_protocol::schema::v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, method: agent_client_protocol::schema::v2::AuthMethodId, cx: &mut App) -> Task<Result<()>> {
+        self.inner.authenticate(method, cx)
+    }
+
+    fn prompt(
+        &self,
+        params: agent_client_protocol::schema::v2::PromptRequest,
+        cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        self.inner.prompt(params, cx)
+    }
+
+    fn cancel(&self, session_id: &acp_v2::SessionId, cx: &mut App) -> Result<()> {
+        self.inner.cancel(session_id, cx)
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+/// A second conversation view that loads the already open `session_id`.
+fn second_view_of(
+    session_id: &acp_v2::SessionId,
+    connection: &SharedSessionConnection,
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<ConversationView> {
+    let project = workspace.read_with(cx, |workspace, _| workspace.project().clone());
+    let view = cx.update(|window, cx| {
+        let connection_store = cx.new(|cx| AgentConnectionStore::new(project.clone(), cx));
+        cx.new(|cx| {
+            ConversationView::new(
+                Rc::new(StubAgentServer::new(connection.clone()).with_connection_agent_id()),
+                connection_store,
+                Agent::Custom {
+                    id: connection.agent_id(),
+                },
+                Some(session_id.clone()),
+                None,
+                None,
+                None,
+                None,
+                workspace.downgrade(),
+                project,
+                None,
+                AgentThreadSource::AgentPanel,
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    view
+}
+
+fn root_thread_of(view: &Entity<ConversationView>, cx: &VisualTestContext) -> Entity<AcpThread> {
+    view.read_with(cx, |view, cx| view.root_thread(cx))
+        .expect("the view holds a root thread")
+}
+
+/// A watched task of a session two views hold ends once, out of view: the card
+/// hears the ending through both views and the tray gets one datagram for it.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_one_ending_seen_through_two_views_sends_one_datagram(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let connection = SharedSessionConnection::new();
+    open_thread_with_custom_connection(&panel, connection.clone(), &mut cx);
+    let thread = panel.read_with(&cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    send_info(
+        &thread,
+        acp::SessionInfoUpdate::new().title("Shared"),
+        &mut cx,
+    );
+    let session = session_of(&thread, &cx);
+
+    let first = active_view(&panel, &cx);
+    let second = second_view_of(&session, &connection, &workspace, &mut cx);
+    assert_ne!(first.entity_id(), second.entity_id(), "two views");
+    assert_eq!(
+        root_thread_of(&second, &cx).entity_id(),
+        thread.entity_id(),
+        "the second view shares the first view's thread"
+    );
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([first.clone(), second.clone()].iter(), cx)
+    });
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    let id = find_row(&card, &session, "t1", &mut cx).unwrap().task.id;
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(session.clone(), id, cx)
+    });
+    card.read_with(&cx, |card, _| {
+        let held: Vec<_> = card
+            .views
+            .iter()
+            .filter_map(|held| held.thread.as_ref())
+            .map(|held| held.thread_id)
+            .collect();
+        assert_eq!(
+            held,
+            vec![thread.entity_id(), thread.entity_id()],
+            "the card holds the one thread through both views"
+        );
+    });
+
+    cx.deactivate_window();
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "completed", true, 1_000)],
+        &mut cx,
+    );
+    cx.run_until_parked();
+
+    let received = drain(&socket);
+    assert_eq!(received.len(), 1, "one ending, one datagram: {received:?}");
+    assert_eq!(received[0]["task_id"], "t1");
+    assert_eq!(received[0]["task_outcome"], "completed");
+    assert_eq!(received[0]["session_id"], session.to_string());
+    set_runtime_dir(None);
+}
+
+fn active_view(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Entity<ConversationView> {
+    panel
+        .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+        .expect("the panel shows a conversation")
+}
diff --git a/crates/agent_ui/src/tasks_card/tray/send_tests.rs b/crates/agent_ui/src/tasks_card/tray/send_tests.rs
new file mode 100644
index 0000000..8b72c4a
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray/send_tests.rs
@@ -0,0 +1,322 @@
+// Story 013 / task 6.2 — the non-blocking send and its wiring (R5.1, R5.3, R5.4).
+// Filter: `tasks_card::tray::send`.
+//
+// Every test that touches `XDG_RUNTIME_DIR` holds `ENV_LOCK`, because the variable
+// is process-wide and tests run on parallel threads.
+
+use std::{
+    io,
+    os::unix::net::UnixDatagram,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+use gpui::TestAppContext;
+
+use super::{TaskOutcomeDatagram, send};
+use crate::tasks_card::test_helpers::*;
+
+pub(super) static ENV_LOCK: Mutex<()> = Mutex::new(());
+
+fn set_runtime_dir(dir: Option<&std::path::Path>) {
+    // SAFETY: serialised by ENV_LOCK; no other thread of these tests reads it meanwhile.
+    unsafe {
+        match dir {
+            Some(dir) => std::env::set_var("XDG_RUNTIME_DIR", dir),
+            None => std::env::remove_var("XDG_RUNTIME_DIR"),
+        }
+    }
+}
+
+/// A runtime dir with the daemon's socket bound in it, as zeo-systray binds it.
+fn bound_socket() -> (tempfile::TempDir, UnixDatagram) {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let socket = UnixDatagram::bind(dir.path().join("zeo-systray.sock")).expect("bind");
+    socket.set_nonblocking(true).expect("nonblocking");
+    (dir, socket)
+}
+
+fn receive(socket: &UnixDatagram) -> Option<serde_json::Value> {
+    let mut buffer = vec![0u8; 64 * 1024];
+    match socket.recv(&mut buffer) {
+        Ok(n) => Some(serde_json::from_slice(&buffer[..n]).expect("a JSON datagram")),
+        Err(error) if error.kind() == io::ErrorKind::WouldBlock => None,
+        Err(error) => panic!("recv failed: {error}"),
+    }
+}
+
+fn datagram() -> TaskOutcomeDatagram {
+    TaskOutcomeDatagram {
+        task_outcome: "failed",
+        session_id: "sess-013".into(),
+        task_id: "task-7".into(),
+        cwd: "/home/user/zed-patches".into(),
+        project: "zed-patches".into(),
+        thread_title: Some("Bump the series".into()),
+        task_type: "shell".into(),
+        duration_ms: 20_500,
+    }
+}
+
+// ---- send() -------------------------------------------------------------------------
+
+#[test]
+fn test_send_delivers_one_datagram_to_the_daemon_socket() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    send(&datagram()).expect("the send succeeds");
+    let received = receive(&socket).expect("one datagram arrived");
+    assert_eq!(received["task_id"], "task-7");
+    assert_eq!(received["task_outcome"], "failed");
+    assert!(receive(&socket).is_none(), "exactly one datagram");
+    set_runtime_dir(None);
+}
+
+/// R5.4, hostile half: an absent socket must fail fast, never wait.
+#[test]
+fn test_send_to_an_absent_socket_fails_without_blocking() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let dir = tempfile::tempdir().expect("tempdir");
+    set_runtime_dir(Some(dir.path()));
+
+    let started = Instant::now();
+    let result = send(&datagram());
+    assert!(result.is_err(), "nobody is listening: the caller is told");
+    assert!(started.elapsed() < Duration::from_secs(1));
+    set_runtime_dir(None);
+}
+
+/// R5.4, the converse: a daemon that is alive but not reading must not freeze the
+/// sender either. A blocking socket would hang here once the queue is full.
+#[test]
+fn test_send_to_a_full_socket_returns_instead_of_blocking() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, _socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let started = Instant::now();
+    let mut refused = false;
+    for _ in 0..100_000 {
+        if send(&datagram()).is_err() {
+            refused = true;
+            break;
+        }
+    }
+    assert!(refused, "a never-read socket fills and refuses");
+    assert!(started.elapsed() < Duration::from_secs(10));
+    set_runtime_dir(None);
+}
+
+/// No runtime dir: no socket to reach, and never a fallback to a world-readable
+/// path such as /tmp.
+#[test]
+fn test_send_without_a_runtime_dir_is_a_quiet_no_op() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    set_runtime_dir(None);
+    // Sending a datagram never creates a file, so "nothing appeared under /tmp" could
+    // not fail; what matters is that no path -- /tmp included -- is chosen at all.
+    assert_eq!(super::socket_path(), None, "no fallback such as /tmp");
+    assert!(send(&datagram()).is_ok());
+}
+
+/// An empty or relative XDG_RUNTIME_DIR is ignored, as the XDG spec asks: nothing is
+/// resolved against the working directory, and the send is a quiet no-op.
+#[test]
+fn test_send_with_an_empty_or_relative_runtime_dir_is_a_quiet_no_op() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    for dir in ["", "rel", "./run/user"] {
+        set_runtime_dir(Some(std::path::Path::new(dir)));
+        assert_eq!(super::socket_path(), None, "XDG_RUNTIME_DIR={dir:?} is not used");
+        assert!(send(&datagram()).is_ok());
+    }
+    set_runtime_dir(None);
+}
+
+// ---- wiring: TaskEnded -> decide -> send ---------------------------------------------
+
+/// A watched task ending while Zeo's window is not active sends one datagram for it,
+/// carrying the thread's session, the task, the work dir and its project label.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_a_watched_task_ending_out_of_view_reaches_the_socket(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "Bump the series", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update(&mut cx, |card, cx| card.toggle_watch(sa.clone(), id, cx));
+
+    cx.deactivate_window();
+    send_tasks(&a, vec![wire_task("t1", "completed", true, 1_000)], &mut cx);
+    cx.run_until_parked();
+
+    let received = receive(&socket).expect("the watched task's end was sent");
+    assert_eq!(received["task_outcome"], "completed");
+    assert_eq!(received["session_id"], sa.to_string());
+    assert_eq!(received["task_id"], "t1");
+    assert_eq!(received["thread_title"], "Bump the series");
+    assert_eq!(received["task_type"], "shell");
+    assert_eq!(received["cwd"], "/project");
+    assert_eq!(received["project"], "project");
+    assert_eq!(received["duration_ms"], 1_000);
+    assert!(receive(&socket).is_none(), "one datagram per ending");
+    set_runtime_dir(None);
+}
+
+/// Hostile halves: an unwatched completion sends nothing; a failure while the
+/// user is looking at that very thread sends nothing; and a failure in ANOTHER
+/// thread than the one shown is out of view, so it is sent.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_only_out_of_view_endings_that_matter_reach_the_socket(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("a1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(
+        &b,
+        vec![
+            wire_task("b1", "running", true, 2_000),
+            wire_task("b2", "running", true, 3_000),
+        ],
+        &mut cx,
+    );
+    cx.update(|window, _| window.activate_window());
+    cx.run_until_parked();
+
+    // Unwatched, completed, out of view (window inactive): silence.
+    cx.deactivate_window();
+    send_tasks(
+        &b,
+        vec![
+            wire_task("b1", "completed", true, 2_000),
+            wire_task("b2", "running", true, 3_000),
+        ],
+        &mut cx,
+    );
+    assert!(
+        receive(&socket).is_none(),
+        "an unwatched completion is not notified"
+    );
+
+    // B is the thread shown and the window is active: a failure in B is in view.
+    cx.update(|window, _| window.activate_window());
+    cx.run_until_parked();
+    send_tasks(&b, vec![wire_task("b2", "failed", true, 3_000)], &mut cx);
+    assert!(
+        receive(&socket).is_none(),
+        "a failure in view is not notified"
+    );
+
+    // A is not the thread shown: its failure is out of view even with focus.
+    send_tasks(&a, vec![wire_task("a1", "failed", true, 1_000)], &mut cx);
+    let received = receive(&socket).expect("a failure in another thread is sent");
+    assert_eq!(received["task_id"], "a1");
+    assert_eq!(received["session_id"], session_of(&a, &cx).to_string());
+    assert!(receive(&socket).is_none());
+    set_runtime_dir(None);
+}
+
+/// R5.4 in the wiring: with no daemon listening, an ending that would notify is
+/// dropped — the card still shows the ended row and nothing panics or stalls.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_an_absent_daemon_drops_the_datagram_and_the_card_carries_on(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let dir = tempfile::tempdir().expect("tempdir");
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let _b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&a, vec![wire_task("a1", "running", true, 1_000)], &mut cx);
+    cx.deactivate_window();
+    send_tasks(&a, vec![wire_task("a1", "failed", true, 1_000)], &mut cx);
+    cx.run_until_parked();
+
+    let card = card(&panel, &cx);
+    let row = find_row(&card, &session_of(&a, &cx), "a1", &mut cx).expect("ended row on show");
+    assert!(row.error.is_none(), "a tray failure is not a task error");
+    set_runtime_dir(None);
+}
+
+/// Story 012 announces a running task that vanishes from a snapshot as
+/// `Interrupted`. A watched one, out of view, is therefore notified as interrupted
+/// — once.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_a_watched_task_that_vanishes_is_sent_as_interrupted(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let id = find_row(&card, &sa, "t1", &mut cx).unwrap().task.id;
+    card.update(&mut cx, |card, cx| card.toggle_watch(sa.clone(), id, cx));
+
+    cx.deactivate_window();
+    send_tasks(&a, vec![], &mut cx);
+    send_tasks(&a, vec![], &mut cx);
+
+    let received = receive(&socket).expect("the vanished task's end was sent");
+    assert_eq!(received["task_outcome"], "interrupted");
+    assert_eq!(received["task_id"], "t1");
+    assert!(receive(&socket).is_none(), "announced once");
+    set_runtime_dir(None);
+}
+
+/// A thread with no work directory still notifies: cwd "" and project "Zeo".
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_a_thread_without_a_work_dir_sends_an_empty_cwd_and_zeo(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::without_work_dirs();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let _b = open_titled_thread(&panel, &TaskActionsConnection::new(), "B", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "failed", true, 1_000)], &mut cx);
+
+    let received = receive(&socket).expect("a failure out of view is sent");
+    assert_eq!(received["cwd"], "");
+    assert_eq!(received["project"], "Zeo");
+    assert_eq!(received["session_id"], session_of(&a, &cx).to_string());
+    set_runtime_dir(None);
+}
diff --git a/crates/agent_ui/src/tasks_card/tray/subagent_tests.rs b/crates/agent_ui/src/tasks_card/tray/subagent_tests.rs
new file mode 100644
index 0000000..1b4434d
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray/subagent_tests.rs
@@ -0,0 +1,265 @@
+// Story 064, task 4.1 — a native subagent's terminal transition reaches zeo-systray as 0038's
+// task-outcome datagram, under 0038's own rule (R6.1; story 013 R5.1–R5.3). Patch `0038`
+// (fixup). Module path: `tasks_card::tray::subagent`; wired in `src/tasks_card/tray.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tray/subagent_tests.rs"]
+//     mod subagent;
+//
+// Validation: `cargo test -p agent_ui tasks_card`. Fixtures: `native_subagent_support.rs`.
+//
+// The datagram is read off a socket bound where zeo-systray binds it, under `send.rs`'s
+// `ENV_LOCK` (XDG_RUNTIME_DIR is process-wide). "Out of view" is the agent panel closed through
+// the workspace's dock path, as `wiring_tests.rs` closes it; the window stays active.
+//
+// Contract assumed: the same datagram fields 0038 sends (no new field), `session_id` the
+// PARENT's (the thread the tray opens), `task_id` the native row's key, which names the child;
+// a native Failed is 0038's `failed`, a native Canceled is `stopped`.
+// Revision 1 (operator, 2026-10-29): `TaskRow` carries its own `status: TaskRowStatus` (Running,
+// Waiting, Done, Failed, Canceled, Unknown) and the tray takes a row. Entry points assumed (rename
+// HERE): `tray::datagram_for_row(row: &TaskRow, session_id: &acp_v2::SessionId, work_dir:
+// Option<&Path>, thread_title: Option<&str>, now: SystemTime) -> Option<TaskOutcomeDatagram>` and
+// `tray::should_notify_row(watched: bool, status: TaskRowStatus, in_view: bool) -> bool`.
+//
+// Hostile halves first: in view, nothing is sent; one ending reported twice is one datagram;
+// an unwatched Done is not news (0038's rule, unchanged); then the benign Failed out of view.
+
+use std::{
+    io,
+    os::unix::net::UnixDatagram,
+    path::Path,
+    time::{Duration, SystemTime},
+};
+
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::TestAppContext;
+
+use super::send::ENV_LOCK;
+use super::{datagram_for_row, should_notify_row};
+use crate::AgentPanel;
+use crate::tasks_card::TaskRowStatus;
+use crate::tasks_card::native_subagent_support::*;
+
+fn set_runtime_dir(dir: Option<&Path>) {
+    // SAFETY: serialised by ENV_LOCK; no other thread of these tests reads it meanwhile.
+    unsafe {
+        match dir {
+            Some(dir) => std::env::set_var("XDG_RUNTIME_DIR", dir),
+            None => std::env::remove_var("XDG_RUNTIME_DIR"),
+        }
+    }
+}
+
+fn bound_socket() -> (tempfile::TempDir, UnixDatagram) {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let socket = UnixDatagram::bind(dir.path().join("zeo-systray.sock")).expect("bind");
+    socket.set_nonblocking(true).expect("nonblocking");
+    (dir, socket)
+}
+
+fn drain(socket: &UnixDatagram) -> Vec<serde_json::Value> {
+    let mut out = Vec::new();
+    let mut buffer = vec![0u8; 64 * 1024];
+    loop {
+        match socket.recv(&mut buffer) {
+            Ok(n) => out.push(serde_json::from_slice(&buffer[..n]).expect("a JSON datagram")),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => return out,
+            Err(error) => panic!("recv failed: {error}"),
+        }
+    }
+}
+
+/// Lets the background send land, then reads everything that arrived.
+fn arrived(rig: &mut SubagentRig, socket: &UnixDatagram) -> Vec<serde_json::Value> {
+    rig.wait(Duration::from_millis(50));
+    rig.cx.executor().run_until_parked();
+    drain(socket)
+}
+
+fn activate(rig: &mut SubagentRig) {
+    rig.cx.update(|window, _| window.activate_window());
+    rig.cx.run_until_parked();
+}
+
+fn close_agent_panel(rig: &mut SubagentRig) {
+    let workspace = rig.workspace.clone();
+    workspace.update_in(&mut rig.cx, |workspace, window, cx| {
+        workspace.close_panel::<AgentPanel>(window, cx)
+    });
+    rig.cx.run_until_parked();
+}
+
+fn error_stop() -> acp_v2::StopReason {
+    acp_v2::StopReason::Error(acp_v2::ErrorStopReason::new())
+}
+
+/// Hostile: the parent is in front of the user. A failed child is not tray news.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_tray_subagent_failure_in_view_sends_nothing(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    rig.report_idle(&alpha, error_stop());
+
+    assert!(
+        arrived(&mut rig, &socket).is_empty(),
+        "nothing while the thread is in view"
+    );
+    set_runtime_dir(None);
+}
+
+/// Hostile: one ending, reported twice by the agent, is one datagram.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_tray_subagent_one_ending_is_one_datagram(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    close_agent_panel(&mut rig);
+    rig.report_idle(&alpha, error_stop());
+    rig.report_idle(&alpha, error_stop());
+
+    let datagrams = arrived(&mut rig, &socket);
+    assert_eq!(
+        datagrams.len(),
+        1,
+        "one ending, one datagram: {datagrams:?}"
+    );
+    set_runtime_dir(None);
+}
+
+/// Hostile: 0038 tells the tray about an unwatched ending only when it failed; a child that
+/// finished normally is not news either.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_tray_subagent_unwatched_completion_sends_nothing(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    close_agent_panel(&mut rig);
+    rig.report_idle(&alpha, acp_v2::StopReason::EndTurn);
+
+    assert!(arrived(&mut rig, &socket).is_empty());
+    set_runtime_dir(None);
+}
+
+/// A child fails while its thread is out of view: one datagram, 0038's shape, for the parent's
+/// session and naming the child. Its sibling, still running, sends nothing.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_tray_subagent_failure_out_of_view_sends_the_outcome(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.report_running(&alpha);
+    rig.report_running(&bravo);
+    close_agent_panel(&mut rig);
+    rig.report_idle(&alpha, error_stop());
+
+    let datagrams = arrived(&mut rig, &socket);
+    assert_eq!(datagrams.len(), 1, "one datagram: {datagrams:?}");
+    let datagram = &datagrams[0];
+    assert_eq!(datagram["task_outcome"], "failed");
+    assert_eq!(
+        datagram["session_id"],
+        rig.parent_session.to_string(),
+        "the tray opens the parent thread"
+    );
+    let task_id = datagram["task_id"].as_str().expect("a task id");
+    assert!(
+        task_id.contains("alpha") && !task_id.contains("bravo"),
+        "the datagram names the child that failed: {task_id:?}"
+    );
+    let keys: Vec<&String> = datagram.as_object().expect("an object").keys().collect();
+    assert_eq!(
+        keys.len(),
+        8,
+        "0038's eight fields, nothing more (no description leaves Zeo): {keys:?}"
+    );
+    set_runtime_dir(None);
+}
+
+/// The row entry points, without a socket: a native row's outcome words and 0038's rule over
+/// the row statuses. Live states (Running, Waiting, Unknown) have no outcome to send.
+#[gpui::test]
+async fn test_tray_subagent_row_entry_points(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.report_running(&alpha);
+    rig.report(
+        &bravo,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+    );
+    let parent = rig.parent_session.clone();
+    let now = SystemTime::now();
+
+    let running = rig.row_of(&alpha).expect("Alpha's row");
+    assert_eq!(running.status, TaskRowStatus::Running);
+    assert!(datagram_for_row(&running, &parent, None, Some("Parent"), now).is_none());
+    let waiting = rig.row_of(&bravo).expect("Bravo's row");
+    assert_eq!(waiting.status, TaskRowStatus::Waiting);
+    assert!(
+        datagram_for_row(&waiting, &parent, None, Some("Parent"), now).is_none(),
+        "waiting is not an ending"
+    );
+
+    rig.report_idle(&alpha, acp_v2::StopReason::Cancelled);
+    let canceled = rig.row_of(&alpha).expect("the ended row is on show");
+    assert_eq!(canceled.status, TaskRowStatus::Canceled);
+    let datagram = serde_json::to_value(
+        datagram_for_row(&canceled, &parent, None, Some("Parent"), now)
+            .expect("an ended row has an outcome"),
+    )
+    .expect("serialises");
+    assert_eq!(datagram["task_outcome"], "stopped");
+    assert_eq!(datagram["session_id"], parent.to_string());
+
+    for (watched, status, in_view, expected) in [
+        (false, TaskRowStatus::Failed, false, true),
+        (false, TaskRowStatus::Done, false, false),
+        (true, TaskRowStatus::Done, false, true),
+        (true, TaskRowStatus::Canceled, false, true),
+        (false, TaskRowStatus::Canceled, false, false),
+        (false, TaskRowStatus::Failed, true, false),
+    ] {
+        assert_eq!(
+            should_notify_row(watched, status, in_view),
+            expected,
+            "watched {watched}, {status:?}, in view {in_view}"
+        );
+    }
+}
diff --git a/crates/agent_ui/src/tasks_card/tray/wiring_tests.rs b/crates/agent_ui/src/tasks_card/tray/wiring_tests.rs
new file mode 100644
index 0000000..f3b27be
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/tray/wiring_tests.rs
@@ -0,0 +1,185 @@
+// Story 013 / task 6.2 review — what the card asks before telling the tray, and
+// the cap on the title it sends. Filter: `tasks_card::tray::wiring`.
+//
+// These tests ask the card's `in_view` query directly, as `tell_tray` does, rather
+// than reading a socket: `XDG_RUNTIME_DIR` is process-wide, so any test that binds
+// one must hold `send_tests.rs`'s `ENV_LOCK`. The lock is reachable from here, but
+// asking the query keeps these tests off the variable altogether — and pins the
+// in-view answer itself, not a datagram that merely failed to arrive.
+
+use acp_thread::AgentTask;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use workspace::MultiWorkspace;
+
+use super::{MAX_TITLE_CHARS, datagram_for};
+use crate::AgentPanel;
+use crate::tasks_card::TasksCard;
+use crate::tasks_card::test_helpers::*;
+
+/// The card's answer to "is this session's thread in front of the user?".
+fn in_view(card: &Entity<TasksCard>, session: &acp_v2::SessionId, cx: &mut VisualTestContext) -> bool {
+    card.update(cx, |card, cx| {
+        card.in_view
+            .as_ref()
+            .is_some_and(|query| query(session, cx))
+    })
+}
+
+/// One window, two workspaces: switching the window to the other workspace keeps
+/// the first alive with its agent panel still "active", so the panel's own flag
+/// cannot tell that its thread left the screen. The displayed workspace does.
+#[gpui::test]
+async fn test_a_thread_in_a_workspace_the_window_no_longer_displays_is_out_of_view(
+    cx: &mut TestAppContext,
+) {
+    let (panel_a, workspace_a, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel_a, &connection, "T", &mut cx);
+    let session = session_of(&thread, &cx);
+    let card = card(&panel_a, &cx);
+    cx.update(|window, _| window.activate_window());
+    cx.run_until_parked();
+
+    // Control: active window, A displayed, its panel open on T.
+    assert!(in_view(&card, &session, &mut cx), "T is on screen in A");
+
+    let multi_workspace = cx
+        .update(|window, _| window.root::<MultiWorkspace>().flatten())
+        .expect("the window's root is a MultiWorkspace");
+    let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    let project_b = Project::test(fs, [], &mut cx).await;
+    let workspace_b = multi_workspace.update_in(&mut cx, |multi_workspace, window, cx| {
+        multi_workspace.test_add_workspace(project_b, window, cx)
+    });
+    cx.run_until_parked();
+    multi_workspace.read_with(&cx, |multi_workspace, cx| {
+        assert!(
+            multi_workspace.multi_workspace_enabled(cx),
+            "A is retained, not dropped"
+        );
+        assert_eq!(multi_workspace.workspace(), &workspace_b, "B is displayed");
+    });
+    assert!(
+        panel_a.read_with(&cx, |panel, cx| panel.active_agent_thread(cx).is_some()),
+        "A's panel still holds T"
+    );
+    assert!(
+        !in_view(&card, &session, &mut cx),
+        "T left the screen with A"
+    );
+
+    // Converse: back on A, T is in view again.
+    multi_workspace.update_in(&mut cx, |multi_workspace, window, cx| {
+        multi_workspace.activate(workspace_a.clone(), None, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(
+        in_view(&card, &session, &mut cx),
+        "T is back on screen with A"
+    );
+}
+
+/// R5.3: the window is active and T is the panel's active thread, but the panel is
+/// closed — T is not in front of the user. Closed through the workspace's dock path
+/// (`close_panel` → `Dock::set_open(false)` → `Panel::set_active(false)`), the same
+/// route the dock actions take, rather than by setting the panel's flag directly.
+#[gpui::test]
+async fn test_a_thread_in_a_closed_agent_panel_is_out_of_view(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "T", &mut cx);
+    let session = session_of(&thread, &cx);
+    let card = card(&panel, &cx);
+    cx.update(|window, _| window.activate_window());
+    cx.run_until_parked();
+
+    // Control: active window, panel open on T.
+    assert!(in_view(&card, &session, &mut cx), "T is on screen");
+
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.close_panel::<AgentPanel>(window, cx)
+    });
+    cx.run_until_parked();
+    assert!(
+        cx.update(|window, _| window.is_window_active()),
+        "the window is still active"
+    );
+    assert!(
+        panel
+            .read_with(&cx, |panel, cx| panel.active_agent_thread(cx))
+            .is_some_and(|active| active == thread),
+        "the closed panel still holds T as its active thread"
+    );
+    assert!(
+        !in_view(&card, &session, &mut cx),
+        "T left the screen with the panel"
+    );
+
+    // Converse: reopened, T is in view again.
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.open_panel::<AgentPanel>(window, cx)
+    });
+    cx.run_until_parked();
+    assert!(
+        in_view(&card, &session, &mut cx),
+        "T is back on screen with the panel"
+    );
+}
+
+/// A task of a thread titled `title`, ended, ready for `datagram_for`.
+async fn ended_task_titled(
+    title: &str,
+    cx: &mut TestAppContext,
+) -> (AgentTask, acp_v2::SessionId, VisualTestContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, title, &mut cx);
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "failed", true, 1_000)],
+        &mut cx,
+    );
+    let task = thread
+        .read_with(&cx, |thread, _| thread.tasks().first().cloned())
+        .expect("the task is in the model");
+    (task, session_of(&thread, &cx), cx)
+}
+
+/// A title of any length leaves Zeo cut to `MAX_TITLE_CHARS` characters — on a
+/// character boundary, so a multi-byte title still serialises as valid UTF-8.
+#[gpui::test]
+async fn test_a_long_thread_title_is_capped_on_a_char_boundary(cx: &mut TestAppContext) {
+    let long = "é".repeat(100_000);
+    let (task, session, _visual) = ended_task_titled("T", cx).await;
+    let now = std::time::SystemTime::now();
+
+    let capped = datagram_for(&task, &session, None, Some(&long), now)
+        .expect("an ended task yields a datagram");
+    assert_eq!(capped.thread_title, Some("é".repeat(MAX_TITLE_CHARS)));
+    let wire = serde_json::to_vec(&capped).expect("the datagram serialises");
+    assert!(wire.len() < 64 * 1024, "fits the daemon's receive buffer");
+
+    // Converse: a title at the cap, or under it, is sent whole.
+    let at_cap = "a".repeat(MAX_TITLE_CHARS);
+    let whole = datagram_for(&task, &session, None, Some(&at_cap), now).unwrap();
+    assert_eq!(whole.thread_title.as_deref(), Some(at_cap.as_str()));
+    let short = datagram_for(&task, &session, None, Some("Bump"), now).unwrap();
+    assert_eq!(short.thread_title.as_deref(), Some("Bump"));
+}
+
+/// The type and the id come from the adapter, so they are capped like the title: an
+/// unbounded value cannot push the datagram past the daemon's 64 KiB receive buffer.
+#[gpui::test]
+async fn test_an_adapter_supplied_type_and_id_are_capped(cx: &mut TestAppContext) {
+    let (mut task, session, _visual) = ended_task_titled("T", cx).await;
+    task.kind = "ü".repeat(100_000).into();
+    task.id = acp_thread::AgentTaskId::from("x".repeat(100_000));
+    let capped = datagram_for(&task, &session, None, None, std::time::SystemTime::now())
+        .expect("an ended task yields a datagram");
+    let wire = serde_json::to_value(&capped).expect("the datagram serialises");
+    assert_eq!(wire["task_type"], "ü".repeat(MAX_TITLE_CHARS));
+    assert_eq!(wire["task_id"], "x".repeat(MAX_TITLE_CHARS));
+    assert!(serde_json::to_vec(&capped).unwrap().len() < 64 * 1024);
+}
