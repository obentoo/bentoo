diff --git a/crates/agent_ui/src/tasks_card/restored_outcome_tests.rs b/crates/agent_ui/src/tasks_card/restored_outcome_tests.rs
new file mode 100644
index 0000000..4a00fbb
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/restored_outcome_tests.rs
@@ -0,0 +1,333 @@
+// Story 064, task 10.2 — an outcome Zed restores on load is history, not an ending (R1.7, R2.5).
+// Fixup of the last patch touching `tasks_card.rs` (`0071`). Wired in `src/tasks_card/tray.rs`,
+// beside `mod subagent;`, so the tests can hold the send tests' `ENV_LOCK` (private to `tray`;
+// `XDG_RUNTIME_DIR` is process-wide):
+//
+//     #[cfg(test)]
+//     #[path = "restored_outcome_tests.rs"]
+//     mod restored_outcome;
+//
+// (a `#[path]` in `tasks_card/tray.rs` resolves against `src/tasks_card/`). Module path
+// `tasks_card::tray::restored_outcome`. Validation: `cargo test -p agent_ui restored_outcome`.
+// Fixtures: `native_subagent_support.rs` (the rig, `row_of`, `report_*`).
+//
+// How a restored outcome reaches the card, as Zed does it since #66255: a native child's session
+// is LOADED first — its replay, then `AcpThread::restore_subagent_outcomes` with the last outcome,
+// which calls `update_session_state` — and only then registered with its parent
+// (`ConversationView::load_subagent_session`). So the first status the card sees for that child
+// is already terminal. `load_restored_child` below does exactly that, in that order.
+//
+// What is observed, where it lands:
+//   - a history write is the card's `TaskActivity` for the child — `Ended` is what the store turns
+//     into `record_subagent`, `Started` what it turns into a history entry; a restored child gets
+//     neither;
+//   - a tray datagram is what arrives on a socket bound where zeo-systray binds it, with the
+//     parent's view closed (out of view) and the outcome Failed — the one unwatched outcome 0038
+//     sends, so "no datagram" can fail; a Done would send nothing either way;
+//   - the row is the card's row for the child (`row_of`), found by its native source.
+//
+// Hostile halves first:
+//   - wrongly an ending: a restored Done/Failed records history or sends a datagram;
+//   - wrongly swallowed: a fix that silences every child ever restored also silences that child's
+//     NEXT, live ending once it resumes — that ending is news, exactly once;
+//   - wrongly dropped: the restored child is shown, with its restored outcome (R1.7), not hidden;
+//   - then the benign live Running -> Done / Running -> Failed: one history write, one datagram.
+
+use std::{cell::RefCell, io, os::unix::net::UnixDatagram, path::Path, rc::Rc, time::Duration};
+
+use acp_thread::{AcpThread, AgentConnection};
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{AppContext as _, Entity, Subscription, TestAppContext};
+
+use super::send::ENV_LOCK;
+use crate::AgentPanel;
+use crate::tasks_card::native_subagent_support::*;
+use crate::tasks_card::{TaskActivity, TaskRowStatus};
+
+fn set_runtime_dir(dir: Option<&Path>) {
+    // SAFETY: serialised by ENV_LOCK; no other thread of these tests reads it meanwhile.
+    unsafe {
+        match dir {
+            Some(dir) => std::env::set_var("XDG_RUNTIME_DIR", dir),
+            None => std::env::remove_var("XDG_RUNTIME_DIR"),
+        }
+    }
+}
+
+fn bound_socket() -> (tempfile::TempDir, UnixDatagram) {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let socket = UnixDatagram::bind(dir.path().join("zeo-systray.sock")).expect("bind");
+    socket.set_nonblocking(true).expect("nonblocking");
+    (dir, socket)
+}
+
+/// Lets the background send land, then reads everything that arrived.
+fn arrived(rig: &mut SubagentRig, socket: &UnixDatagram) -> Vec<serde_json::Value> {
+    rig.wait(Duration::from_millis(50));
+    rig.cx.executor().run_until_parked();
+    let mut out = Vec::new();
+    let mut buffer = vec![0u8; 64 * 1024];
+    loop {
+        match socket.recv(&mut buffer) {
+            Ok(n) => out.push(serde_json::from_slice(&buffer[..n]).expect("a JSON datagram")),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => return out,
+            Err(error) => panic!("recv failed: {error}"),
+        }
+    }
+}
+
+fn activate(rig: &mut SubagentRig) {
+    rig.cx.update(|window, _| window.activate_window());
+    rig.cx.run_until_parked();
+}
+
+fn close_agent_panel(rig: &mut SubagentRig) {
+    let workspace = rig.workspace.clone();
+    workspace.update_in(&mut rig.cx, |workspace, window, cx| {
+        workspace.close_panel::<AgentPanel>(window, cx)
+    });
+    rig.cx.run_until_parked();
+}
+
+fn error_stop() -> acp_v2::StopReason {
+    acp_v2::StopReason::Error(acp_v2::ErrorStopReason::new())
+}
+
+/// What the card told the history, per child session: ("started" | "ended", child).
+type Heard = Rc<RefCell<Vec<(&'static str, String)>>>;
+
+fn listen(rig: &mut SubagentRig) -> (Heard, Subscription) {
+    let heard: Heard = Rc::new(RefCell::new(Vec::new()));
+    let sink = heard.clone();
+    let card = rig.card.clone();
+    let subscription = rig.cx.update(|_, cx| {
+        cx.subscribe(&card, move |_, event: &TaskActivity, _| {
+            let (kind, record) = match event {
+                TaskActivity::Started(record) => ("started", record),
+                TaskActivity::Ended(record) => ("ended", record),
+            };
+            let child = record
+                .child_session_id
+                .as_ref()
+                .map(|child| child.to_string())
+                .unwrap_or_else(|| record.task_id.to_string());
+            sink.borrow_mut().push((kind, child));
+        })
+    });
+    (heard, subscription)
+}
+
+fn heard_for(heard: &Heard, kind: &str, child: &str) -> usize {
+    heard
+        .borrow()
+        .iter()
+        .filter(|(seen, session)| *seen == kind && session.contains(child))
+        .count()
+}
+
+/// A native child as a reopened parent gets it: its session loaded, its last outcome restored
+/// (`restore_subagent_outcomes`), and only then registered with the parent.
+fn load_restored_child(
+    rig: &mut SubagentRig,
+    session: &str,
+    title: &str,
+    stop: acp_v2::StopReason,
+) -> Entity<AcpThread> {
+    let parent_session = rig.parent_session.clone();
+    let connection: Rc<dyn AgentConnection> = Rc::new(rig.connection.clone());
+    let parent = rig.parent.clone();
+    let child = rig.cx.update(|_, cx| {
+        let project = parent.read(cx).project().clone();
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        cx.new(|cx| {
+            AcpThread::new(
+                Some(parent_session),
+                None,
+                None,
+                connection,
+                project,
+                action_log,
+                acp_v2::SessionId::new(session.to_string()),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+            .agent_owned()
+        })
+    });
+    rig.cx
+        .update(|_, cx| rig.connection.track_session(&child, cx));
+    let update = acp_v2::SubagentUpdate::new(session.to_string())
+        .title(title.to_string())
+        .capabilities(
+            acp_v2::SubagentSessionCapabilities::new()
+                .cancel(acp_v2::SessionCancelCapabilities::new()),
+        );
+    child
+        .update(&mut rig.cx, |child, cx| {
+            child.update_subagent_association(&update, cx)
+        })
+        .expect("an agent-owned thread takes an association");
+    child
+        .update(&mut rig.cx, |child, cx| {
+            child.restore_subagent_outcomes(
+                vec![(
+                    0,
+                    acp_v2::StateUpdate::Idle(acp_v2::IdleStateUpdate::new().stop_reason(stop)),
+                )],
+                cx,
+            )
+        })
+        .expect("a subagent's outcomes restore");
+    rig.cx.run_until_parked();
+    rig.parent.update(&mut rig.cx, |parent, cx| {
+        parent.register_subagent(child.clone(), cx)
+    });
+    rig.cx.run_until_parked();
+    child
+}
+
+// ── R2.5 / R1.7 — a restored outcome is shown, and is not an ending ────────
+
+/// Hostile (wrongly an ending): a child restored Done shows a Done row and writes no history.
+#[gpui::test]
+async fn test_restored_outcome_done_is_shown_and_writes_no_history(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let (heard, _subscription) = listen(&mut rig);
+
+    let alpha = load_restored_child(&mut rig, "alpha", "Alpha", acp_v2::StopReason::EndTurn);
+
+    assert_eq!(
+        heard_for(&heard, "ended", "alpha"),
+        0,
+        "R2.5: a restored outcome is not recorded (no record_subagent): {:?}",
+        heard.borrow()
+    );
+    assert_eq!(
+        heard_for(&heard, "started", "alpha"),
+        0,
+        "R2.5: a restored child adds no history entry either: {:?}",
+        heard.borrow()
+    );
+    assert_eq!(
+        rig.row_of(&alpha).map(|row| row.status),
+        Some(TaskRowStatus::Done),
+        "R1.7: the row reads the restored outcome"
+    );
+}
+
+/// Hostile (wrongly an ending): a child restored Failed while its thread is out of view sends no
+/// tray datagram — the one outcome 0038 would send unwatched — and writes no history.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_restored_outcome_failure_sends_no_datagram(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    close_agent_panel(&mut rig);
+    let (heard, _subscription) = listen(&mut rig);
+
+    let bravo = load_restored_child(&mut rig, "bravo", "Bravo", error_stop());
+
+    let datagrams = arrived(&mut rig, &socket);
+    set_runtime_dir(None);
+    assert!(
+        datagrams.is_empty(),
+        "R2.5: a restored failure is no tray news: {datagrams:?}"
+    );
+    assert_eq!(
+        heard_for(&heard, "ended", "bravo"),
+        0,
+        "R2.5: no record_subagent for a restored failure: {:?}",
+        heard.borrow()
+    );
+    assert_eq!(
+        rig.row_of(&bravo).map(|row| row.status),
+        Some(TaskRowStatus::Failed),
+        "R1.7: the restored failure is shown"
+    );
+}
+
+/// Hostile (wrongly swallowed): the restored child resumes and ends again, live. That ending is
+/// news — once — and the restored one still is not: exactly one `Ended` over the whole run.
+#[gpui::test]
+async fn test_restored_outcome_then_live_ending_is_recorded_once(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let (heard, _subscription) = listen(&mut rig);
+    let alpha = load_restored_child(&mut rig, "alpha", "Alpha", acp_v2::StopReason::EndTurn);
+
+    rig.report_running(&alpha);
+    assert_eq!(
+        rig.row_of(&alpha).map(|row| row.status),
+        Some(TaskRowStatus::Running)
+    );
+    rig.report_idle(&alpha, acp_v2::StopReason::EndTurn);
+
+    assert_eq!(
+        heard_for(&heard, "ended", "alpha"),
+        1,
+        "the live ending after the resume is recorded, the restored one is not: {:?}",
+        heard.borrow()
+    );
+}
+
+// ── R2.1 / R6.1 — a live ending still records and notifies ─────────────────
+
+/// Benign: a live Running -> Done is one history write.
+#[gpui::test]
+async fn test_restored_outcome_live_done_writes_history_once(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let (heard, _subscription) = listen(&mut rig);
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.cx.run_until_parked();
+    rig.report_running(&alpha);
+    rig.report_idle(&alpha, acp_v2::StopReason::EndTurn);
+
+    assert_eq!(
+        heard_for(&heard, "ended", "alpha"),
+        1,
+        "R2.1: one record_subagent for one live ending: {:?}",
+        heard.borrow()
+    );
+    assert_eq!(
+        rig.row_of(&alpha).map(|row| row.status),
+        Some(TaskRowStatus::Done)
+    );
+}
+
+/// Benign: a live Running -> Failed out of view is one datagram and one history write.
+#[gpui::test]
+#[allow(
+    clippy::await_holding_lock,
+    reason = "the gpui test executor is single-threaded; the lock only serialises XDG_RUNTIME_DIR against the other tests"
+)]
+async fn test_restored_outcome_live_failure_sends_one_datagram(cx: &mut TestAppContext) {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let (dir, socket) = bound_socket();
+    set_runtime_dir(Some(dir.path()));
+
+    let mut rig = subagent_rig(cx).await;
+    activate(&mut rig);
+    let (heard, _subscription) = listen(&mut rig);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.cx.run_until_parked();
+    rig.report_running(&bravo);
+    close_agent_panel(&mut rig);
+    rig.report_idle(&bravo, error_stop());
+
+    let datagrams = arrived(&mut rig, &socket);
+    set_runtime_dir(None);
+    assert_eq!(datagrams.len(), 1, "R6.1: one datagram: {datagrams:?}");
+    assert_eq!(datagrams[0]["task_outcome"], "failed");
+    assert_eq!(
+        heard_for(&heard, "ended", "bravo"),
+        1,
+        "R2.1: one record_subagent: {:?}",
+        heard.borrow()
+    );
+}
