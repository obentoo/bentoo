+    /// The tasks card's question before it tells the tray about an ending (R5.3):
+    /// is that session's thread in front of the user — this window active, this
+    /// panel's workspace the one the window displays, this panel open, and the
+    /// thread the one it shows? The panel is held weakly, as the card it is
+    /// handed to is owned by the panel.
+    fn tasks_card_in_view_query(
+        panel: WeakEntity<Self>,
+        window_handle: gpui::AnyWindowHandle,
+    ) -> impl Fn(&acp_v2::SessionId, &mut App) -> bool + 'static {
+        move |session_id, cx| {
+            // A window or panel that is gone shows nothing.
+            window_handle
+                .update(cx, |_, window, cx| {
+                    window.is_window_active()
+                        && panel
+                            .read_with(cx, |panel, cx| panel.shows_session(session_id, window, cx))
+                            .unwrap_or(false)
+                })
+                .unwrap_or(false)
+        }
+    }
+
+    /// Whether this panel is on screen with the thread of `session_id` as its
+    /// active one.
+    ///
+    /// `is_active` alone is not enough: switching a window to another workspace
+    /// keeps the previous one alive without deactivating its panels, so a panel
+    /// can be open in a workspace nobody is looking at.
+    fn shows_session(&self, session_id: &acp_v2::SessionId, window: &Window, cx: &App) -> bool {
+        if !self.is_active {
+            return false;
+        }
+        // A window whose root is not a `MultiWorkspace` holds only this workspace.
+        if let Some(multi_workspace) = window.root::<MultiWorkspace>().flatten() {
+            if &self.workspace != multi_workspace.read(cx).workspace() {
+                return false;
+            }
+        }
+        self.active_agent_thread(cx)
+            .is_some_and(|thread| thread.read(cx).session_id() == session_id)
+    }
+
