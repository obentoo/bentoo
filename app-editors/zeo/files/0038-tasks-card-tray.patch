+    /// Tells `zeo-systray` about an ending the user is not looking at, when it is
+    /// watched or failed (R5.1–R5.3). The send runs off the UI thread.
+    fn tell_tray(
+        &mut self,
+        key: TaskKey,
+        status: AgentTaskStatus,
+        datagram: Option<tray::TaskOutcomeDatagram>,
+        cx: &mut Context<Self>,
+    ) {
+        if !self.tray_weighed.insert(key.clone()) {
+            return;
+        }
+        let Some(in_view) = &self.in_view else {
+            return;
+        };
+        let watched = self.watched.contains(&key);
+        if !tray::should_notify(watched, status, in_view(&key.0, cx)) {
+            return;
+        }
+        let (session_id, task_id) = &key;
+        let Some(datagram) = datagram else {
+            log::debug!(
+                "tasks card: task {task_id} of session {session_id} has no outcome to send"
+            );
+            return;
+        };
+        log::debug!(
+            "tasks card: telling zeo-systray that task {task_id} of session {session_id} ended"
+        );
+        tray::send_in_background(datagram, cx);
+    }
+
