+fn open_fork_at_turn(
+    thread_view: &Entity<ThreadView>,
+    entry_ix: usize,
+    cut: serde_json::Value,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let Some((request, panel)) = sub_thread_request_at(thread_view, entry_ix, "turn", cx) else {
         return;
     };
+    let parent_session_id = request.parent_session_id.clone();
     let opening = panel.update(cx, |panel, cx| {
         panel.open_sub_thread_at(request, cut, true, window, cx)
     });
