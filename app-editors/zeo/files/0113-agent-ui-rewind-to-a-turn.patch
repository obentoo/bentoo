+++ b/crates/agent_servers/src/acp/v1/rewind_tests.rs
@@ -0,0 +1,66 @@
+// Zeo next proposal §6.33 (ask 61): reading Claude Agent (Plus) 0.38.0's `_claude/rewind`
+// answer. Filter: `v1::rewind_tests`.
+
+use agent_client_protocol::v2::schema as acp_v2;
+use serde_json::json;
+
+use super::parse_rewind_answer;
+
+#[test]
+fn a_rewound_answer_names_the_new_session() {
+    let outcome = parse_rewind_answer(&json!({
+        "status": "rewound",
+        "sessionId": "forked-1",
+        "droppedTurns": 2,
+        "filesRestored": true,
+    }))
+    .expect("rewound");
+    assert_eq!(outcome.session_id, acp_v2::SessionId::new("forked-1"));
+    assert_eq!(outcome.dropped_turns, 2);
+    assert!(outcome.files_restored);
+}
+
+/// Hostile: a conversation failure after the files were restored must say so, or the user
+/// believes nothing changed while their files did.
+#[test]
+fn a_conversation_failure_after_restored_files_says_so() {
+    let error = parse_rewind_answer(&json!({
+        "status": "failed",
+        "stage": "conversation",
+        "message": "disk full",
+        "filesRestored": true,
+    }))
+    .unwrap_err()
+    .to_string();
+    assert!(error.contains("files were restored"), "{error}");
+    assert!(error.contains("disk full"), "{error}");
+}
+
+#[test]
+fn a_files_failure_says_nothing_changed() {
+    let error = parse_rewind_answer(&json!({
+        "status": "failed", "stage": "files", "message": "no checkpoint",
+    }))
+    .unwrap_err()
+    .to_string();
+    assert!(error.contains("nothing was changed"), "{error}");
+}
+
+#[test]
+fn every_other_status_is_an_error_in_words() {
+    for (status, words) in [
+        ("busy", "Wait for the turn"),
+        ("not_found", "could not find"),
+        ("nothing_to_rewind", "nothing after"),
+        ("something_new", "unknown status"),
+    ] {
+        let error = parse_rewind_answer(&json!({ "status": status }))
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains(words), "{status}: {error}");
+    }
+    assert!(
+        parse_rewind_answer(&json!({ "status": "rewound" })).is_err(),
+        "rewound without a session id"
+    );
+}
