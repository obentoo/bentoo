+    /// A rewind's new session (Zeo next §6.33) opens as a sub-thread of the thread it came from,
+    /// which is kept as it was (operator, 2026-11-15). The session already holds the kept turns,
+    /// so it is loaded like any other, and linked to its parent as a fork is.
+    pub(super) fn open_rewound_sub_thread(
+        &mut self,
+        request: SubThreadRequest,
+        outcome: acp_thread::RewindOutcome,
+        focus: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<Entity<ConversationView>> {
+        let Some(work_dirs) = request.work_dirs.clone() else {
+            self.rewind_failed(
+                &request.parent_session_id,
+                anyhow!("the parent thread has no working directories"),
+                cx,
+            );
+            return None;
+        };
+        let opened = self.create_agent_thread_with_server_for_external_session(
+            request.agent,
+            None,
+            outcome.session_id.clone(),
+            Some(work_dirs),
+            None,
+            None,
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        );
+        let view = self.show_agent_thread(opened, focus, window, cx);
+        let child = view.read(cx).thread_id;
+        view.update(cx, |view, _| {
+            view.set_pending_parent_link(PendingParentLink {
+                child,
+                parent: request.parent_thread_id,
+                kind: ForkKind::WithContext,
+            });
+            view.sub_thread.inherited_messages = request.inherited_messages;
+        });
+        log::info!(
+            "zeo_sub_thread event=rewound parent_session={} session={} dropped_turns={} files_restored={}",
+            request.parent_session_id,
+            outcome.session_id,
+            outcome.dropped_turns,
+            outcome.files_restored
+        );
+        Some(view)
+    }
+
+    /// A rewind that did not happen says why: the agent's reason, in words (§6.33).
+    pub(super) fn rewind_failed(
+        &self,
+        parent_session: &acp_v2::SessionId,
+        error: anyhow::Error,
+        cx: &mut Context<Self>,
+    ) {
+        struct RewindFailedToast;
+        log::warn!("zeo_sub_thread event=rewind_failed parent_session={parent_session}: {error:#}");
+        let text = format!("Couldn't rewind: {error}");
+        self.panel_workspace()
+            .update(cx, |workspace, cx| {
+                workspace.show_toast(
+                    Toast::new(NotificationId::unique::<RewindFailedToast>(), text),
+                    cx,
+                );
+            })
+            .log_err();
+    }
+
     fn sub_thread_fork_failed(
         &self,
         parent_session: &acp_v2::SessionId,
