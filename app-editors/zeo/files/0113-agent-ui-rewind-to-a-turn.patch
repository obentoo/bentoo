+/// Reads a `_claude/rewind` answer (plus 0.38.0's `RewindResult`) into an outcome, or an
+/// error that says what happened in words the user can act on.
+fn parse_rewind_answer(answer: &serde_json::Value) -> Result<acp_thread::RewindOutcome> {
+    let status = answer.get("status").and_then(|status| status.as_str());
+    let message = || {
+        answer
+            .get("message")
+            .and_then(|message| message.as_str())
+            .unwrap_or("no reason given")
+    };
+    match status {
+        Some("rewound") => {
+            let session_id = answer
+                .get("sessionId")
+                .and_then(|id| id.as_str())
+                .ok_or_else(|| anyhow!("{CLAUDE_REWIND_METHOD} answered without a sessionId"))?;
+            Ok(acp_thread::RewindOutcome {
+                session_id: acp_v2::SessionId::new(session_id.to_string()),
+                dropped_turns: answer
+                    .get("droppedTurns")
+                    .and_then(|turns| turns.as_u64())
+                    .unwrap_or(0) as usize,
+                files_restored: answer
+                    .get("filesRestored")
+                    .and_then(|restored| restored.as_bool())
+                    .unwrap_or(false),
+            })
+        }
+        Some("nothing_to_rewind") => Err(anyhow!("There is nothing after this turn to rewind.")),
+        Some("not_found") => Err(anyhow!("The agent could not find this turn.")),
+        Some("busy") => Err(anyhow!("Wait for the turn to end, then rewind.")),
+        Some("failed") => {
+            let files_restored = answer
+                .get("filesRestored")
+                .and_then(|restored| restored.as_bool())
+                .unwrap_or(false);
+            match answer.get("stage").and_then(|stage| stage.as_str()) {
+                Some("files") => Err(anyhow!(
+                    "The files could not be restored, so nothing was changed: {}",
+                    message()
+                )),
+                _ if files_restored => Err(anyhow!(
+                    "The files were restored, but the conversation could not be: {}",
+                    message()
+                )),
+                _ => Err(anyhow!(
+                    "The conversation could not be rewound: {}",
+                    message()
+                )),
+            }
+        }
+        other => Err(anyhow!(
+            "{CLAUDE_REWIND_METHOD} answered an unknown status {other:?}"
+        )),
+    }
+}
