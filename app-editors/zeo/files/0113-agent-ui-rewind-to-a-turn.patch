+    let parent_session = request.parent_session_id.clone();
+    let connection = thread_view.read(cx).thread.read(cx).connection().clone();
+    let rewinding = connection.rewind_session(&parent_session, cut, restore_files, cx);
+    window
+        .spawn(cx, async move |cx| {
+            let outcome = rewinding.await;
+            cx.update(|window, cx| {
