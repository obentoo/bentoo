+/// Every Ended has a Started for the same key earlier in the stream.
+fn assert_started_before_ended(events: &[Seen]) {
+    for (index, event) in events.iter().enumerate() {
+        if let Seen::Ended(ended) = event {
+            let started_earlier = events[..index].iter().any(|earlier| {
+                matches!(earlier, Seen::Started(started) if key_of(started) == key_of(ended))
+            });
+            assert!(
+                started_earlier,
+                "Ended {:?} before its Started: {events:?}",
+                key_of(ended)
+            );
+        }
+    }
+}
