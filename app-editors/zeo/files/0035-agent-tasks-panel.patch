+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let mut a_t1 = wire_task("t1", "running", false, 1_000);
+    a_t1["description"] = json!("A's t1");
+    send_tasks(&a, vec![a_t1], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    let mut b_t1 = wire_task("t1", "running", false, 2_000);
+    b_t1["description"] = json!("B's t1");
+    send_tasks(
+        &b,
+        vec![b_t1, wire_task("only-b", "running", false, 2_100)],
+        &mut cx,
+    );
+    let sa = session_of(&a, &cx);
+    let sb = session_of(&b, &cx);
+    let card = card(&panel, &cx);
