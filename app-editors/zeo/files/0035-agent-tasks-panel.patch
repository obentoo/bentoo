@@ -0,0 +1,391 @@
+// Story 014, task 3.1 — TaskHistoryStore: startup sweep, card registration, writes, failure
+// paths (R1.1, R1.2, R1.5, R1.6, R4.3, Q4, Q11). Module path: `store::lifecycle`.
+//
+// The store is fed only through `register_card`: each test registers the real `TasksCard`
+// of a workspace's `AgentPanel` and emits `TaskActivity` on it. The card's own emission
+// from snapshots is proved in agent_ui (`tasks_card::activity`), and snapshot → panel end
+// to end in `panel::list`.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, Availability, HistoryEntry, TaskHistoryStore};
+
+/// A store over `db`, registered on the rig's card.
+fn registered_store(db: &AgentTaskHistoryDb, rig: &mut CardRig) -> Entity<TaskHistoryStore> {
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    store
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn is_available(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> bool {
+    store.read_with(cx, |store, _| {
+        matches!(store.availability(), Availability::Available)
+    })
+}
+
+// ── Startup (R1.5) ─────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn store_startup_sweeps_running_records_to_interrupted_and_loads_all(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_startup_sweep").await;
+    db.insert_started(&record(
+        "s1",
+        "left-running",
+        AgentTaskStatus::Running,
+        1_000,
+    ))
+    .await
+    .unwrap();
+    db.insert_started(&record("s1", "done", AgentTaskStatus::Completed, 2_000))
+        .await
+        .unwrap();
+    db.insert_started(&record(
+        "s2",
+        "left-running",
+        AgentTaskStatus::Running,
+        3_000,
+    ))
+    .await
+    .unwrap();
+
+    let store = registered_store(&db, &mut rig);
+
+    assert!(is_available(&store, &rig.cx));
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(memory.len(), 3, "everything recorded is loaded");
+    for session in ["s1", "s2"] {
+        let swept = &find(&memory, session, "left-running").unwrap().record;
+        assert_eq!(
+            swept.status,
+            AgentTaskStatus::Interrupted,
+            "{session} in memory"
+        );
+        assert!(swept.ended_at_ms.is_some());
+    }
+    assert_eq!(
+        find(&memory, "s1", "done").unwrap().record.status,
+        AgentTaskStatus::Completed,
+        "a finished record is not swept"
+    );
+    let stored = load(&db).await;
+    assert_eq!(
+        find(&stored, "s2", "left-running").unwrap().record.status,
+        AgentTaskStatus::Interrupted,
+        "the sweep is written, not only shown"
+    );
+}
+
+// Q11 — a restart with a running record: a new store over the same database.
+#[gpui::test]
+async fn store_restart_reports_a_task_running_at_shutdown_as_interrupted(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_restart_running").await;
+    let first_run = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "build", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        started(&record("s1", "lint", AgentTaskStatus::Running, 1_100)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        ended(&record("s1", "lint", AgentTaskStatus::Completed, 1_100)),
+        &mut rig.cx,
+    );
+    drop(first_run);
+    rig.cx.run_until_parked();
+
+    let second_run = registered_store(&db, &mut rig);
+    let memory = entries(&second_run, &rig.cx);
+    assert_eq!(memory.len(), 2);
+    assert_eq!(
+        find(&memory, "s1", "build").unwrap().record.status,
+        AgentTaskStatus::Interrupted
+    );
+    assert_eq!(
+        find(&memory, "s1", "lint").unwrap().record.status,
+        AgentTaskStatus::Completed
+    );
+}
+
+// ── Registration and identity (hostile halves first) ───────────────────────
+
+// Registering the same card twice (a second workspace load, a reloaded panel) must not
+// double-record: one subscription per card.
+#[gpui::test]
+async fn store_registering_a_card_twice_records_each_task_once(cx: &mut gpui::TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_register_twice").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+
+    emit(
+        &card,
+        started(&record("s1", "t1", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    assert_eq!(entries(&store, &rig.cx).len(), 1, "one row in memory");
+    assert_eq!(load(&db).await.len(), 1);
+}
+
+#[gpui::test]
+async fn store_keeps_two_tasks_of_one_session_and_one_task_id_of_two_sessions_apart(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_identity_apart").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "t1", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        started(&record("s1", "t2", AgentTaskStatus::Running, 1_100)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        started(&record("s2", "t1", AgentTaskStatus::Running, 1_200)),
+        &mut rig.cx,
+    );
+    // A third pair whose parts concatenate like ("s1", "t1").
+    emit(
+        &card,
+        started(&record("s", "1t1", AgentTaskStatus::Running, 1_300)),
+        &mut rig.cx,
+    );
+
+    assert_eq!(entries(&store, &rig.cx).len(), 4, "in memory");
+    assert_eq!(load(&db).await.len(), 4, "in the database");
+
+    emit(
+        &card,
+        ended(&record("s1", "t1", AgentTaskStatus::Completed, 1_000)),
+        &mut rig.cx,
+    );
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(
+        find(&memory, "s1", "t1").unwrap().record.status,
+        AgentTaskStatus::Completed
+    );
+    assert_eq!(
+        find(&memory, "s2", "t1").unwrap().record.status,
+        AgentTaskStatus::Running
+    );
+    assert_eq!(
+        find(&memory, "s", "1t1").unwrap().record.status,
+        AgentTaskStatus::Running
+    );
+}
+
+#[gpui::test]
+async fn store_records_a_repeated_start_once_and_never_reopens_an_ended_task(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_repeat_once").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    let first = record("s1", "t1", AgentTaskStatus::Running, 1_000);
+    let mut repeat = first.clone();
+    repeat.description = "A later snapshot".into();
+    repeat.tokens = Some(999);
+
+    emit(&card, started(&first), &mut rig.cx);
+    emit(&card, started(&repeat), &mut rig.cx);
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(
+        memory.len(),
+        1,
+        "one task however many snapshots repeat it (R1.3)"
+    );
+    assert_eq!(memory[0].record.description.as_ref(), "Task t1");
+    assert_eq!(load(&db).await.len(), 1);
+
+    emit(
+        &card,
+        ended(&record("s1", "t1", AgentTaskStatus::Stopped, 1_000)),
+        &mut rig.cx,
+    );
+    emit(&card, started(&first), &mut rig.cx);
+    assert_eq!(
+        entries(&store, &rig.cx)[0].record.status,
+        AgentTaskStatus::Stopped,
+        "a replayed start does not reopen an ended task"
+    );
+    assert_eq!(load(&db).await[0].record.status, AgentTaskStatus::Stopped);
+}
+
+// Benign: record → end, in memory and in the database (R1.1, R1.2); and a task first seen
+// ended (Started carrying the outcome, then Ended) is one finished record (R1.8).
+#[gpui::test]
+async fn store_records_a_start_and_its_outcome(cx: &mut gpui::TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_start_and_end").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    let mut start = record("s1", "build", AgentTaskStatus::Running, 1_000);
+    start.thread_title = Some("Build thread".into());
+    start.background = true;
+    emit(&card, started(&start), &mut rig.cx);
+
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(memory.len(), 1);
+    assert_eq!(memory[0].record.status, AgentTaskStatus::Running);
+    assert!(!memory[0].archived);
+    let stored = load(&db).await;
+    assert_eq!(stored.len(), 1);
+    assert_eq!(
+        stored[0].record.thread_title.as_ref().map(|t| t.as_ref()),
+        Some("Build thread")
+    );
+    assert!(stored[0].record.background);
+
+    let mut outcome = record("s1", "build", AgentTaskStatus::Failed, 1_000);
+    outcome.ended_at_ms = Some(5_000);
+    outcome.tokens = Some(2_048);
+    outcome.tool_uses = Some(12);
+    emit(&card, ended(&outcome), &mut rig.cx);
+
+    let in_memory = find(&entries(&store, &rig.cx), "s1", "build")
+        .unwrap()
+        .clone();
+    let in_db = find(&load(&db).await, "s1", "build").unwrap().clone();
+    for entry in [in_memory, in_db] {
+        assert_eq!(entry.record.status, AgentTaskStatus::Failed);
+        assert_eq!(entry.record.ended_at_ms, Some(5_000));
+        assert_eq!(entry.record.tokens, Some(2_048));
+        assert_eq!(entry.record.tool_uses, Some(12));
+    }
+
+    let quick = record("s1", "quick", AgentTaskStatus::Completed, 6_000);
+    emit(&card, started(&quick), &mut rig.cx);
+    emit(&card, ended(&quick), &mut rig.cx);
+    let in_db = load(&db).await;
+    let stored_quick = find(&in_db, "s1", "quick").expect("one record");
+    assert_eq!(stored_quick.record.status, AgentTaskStatus::Completed);
+    assert_eq!(stored_quick.record.ended_at_ms, Some(7_000));
+    assert_eq!(in_db.len(), 2);
+}
+
+// ── Failure paths (R1.6, R4.3, Q4) ─────────────────────────────────────────
+
+#[gpui::test]
+async fn store_write_failure_logs_the_ids_and_keeps_memory(cx: &mut gpui::TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_write_failure").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    assert!(is_available(&store, &rig.cx));
+    drop_history_table(&db).await;
+    capture_logs();
+
+    emit(
+        &card,
+        started(&record(
+            "session-w1",
+            "task-w1",
+            AgentTaskStatus::Running,
+            1_000,
+        )),
+        &mut rig.cx,
+    );
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(memory.len(), 1, "the task stays visible for this session");
+    assert_eq!(memory[0].record.status, AgentTaskStatus::Running);
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("session-w1") && line.contains("task-w1")),
+        "the failed write is logged at error level with both ids: {errors:?}"
+    );
+
+    capture_logs();
+    emit(
+        &card,
+        ended(&record(
+            "session-w1",
+            "task-w1",
+            AgentTaskStatus::Completed,
+            1_000,
+        )),
+        &mut rig.cx,
+    );
+    assert_eq!(
+        entries(&store, &rig.cx)[0].record.status,
+        AgentTaskStatus::Completed,
+        "the outcome is kept in memory"
+    );
+    assert!(
+        error_lines()
+            .iter()
+            .any(|line| line.contains("session-w1") && line.contains("task-w1")),
+        "the failed update is logged with both ids"
+    );
+}
+
+// R4.3, open-failure path: the domain's first query fails. (The silent in-memory fallback
+// path depends on what task 2.1 records about `static_connection!`; see the story report.)
+#[gpui::test]
+async fn store_unavailable_domain_reports_the_cause_and_still_keeps_live_tasks(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_unavailable").await;
+    drop_history_table(&db).await;
+    capture_logs();
+
+    let store = registered_store(&db, &mut rig);
+
+    let cause = store.read_with(&rig.cx, |store, _| match store.availability() {
+        Availability::Unavailable(cause) => Some(cause.clone()),
+        Availability::Available => None,
+    });
+    let cause = cause.expect("a domain whose first query fails is Unavailable");
+    assert!(
+        !cause.is_empty(),
+        "the cause is carried for the panel to show"
+    );
+    assert!(entries(&store, &rig.cx).is_empty());
+    assert!(
+        !error_lines().is_empty(),
+        "the failed open is logged at error level with its cause"
+    );
+
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "live", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    assert_eq!(
+        entries(&store, &rig.cx).len(),
+        1,
+        "with history unavailable, this session's tasks are still held in memory"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/store/replay_tests.rs b/crates/agent_tasks_panel/src/store/replay_tests.rs
new file mode 100644
index 0000000..08e63f0
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/replay_tests.rs
@@ -0,0 +1,108 @@
+// Story 014, task 3.1 — activity the card replays or delivers early (R1.2, R1.3, R1.5).
+// Module path: `store::replay`.
+//
+// Found while building task 1.1: a resumed task gets a second `Ended` for its key, and a
+// re-opened session emits `Started` again for the tasks it still lists. And the startup sweep
+// must not catch a task the card announces before the sweep has finished.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+#[gpui::test]
+async fn store_holds_activity_heard_during_the_startup_sweep_until_after_it(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_replay_early").await;
+    db.insert_started(&record("s0", "old", AgentTaskStatus::Running, 500))
+        .await
+        .unwrap();
+
+    // Registered and fed before the sweep and load have had a chance to run.
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    card.update(&mut rig.cx, |_, cx| {
+        cx.emit(started(&record(
+            "s1",
+            "early",
+            AgentTaskStatus::Running,
+            1_000,
+        )))
+    });
+    rig.cx.run_until_parked();
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(view.len(), 2);
+        assert_eq!(
+            find(&view, "s0", "old").unwrap().record.status,
+            AgentTaskStatus::Interrupted,
+            "the row left running is swept"
+        );
+        assert_eq!(
+            find(&view, "s1", "early").unwrap().record.status,
+            AgentTaskStatus::Running,
+            "a task started during the sweep is not"
+        );
+    }
+}
+
+#[gpui::test]
+async fn store_never_reopens_an_interrupted_task_and_keeps_the_latest_ending(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_replay_resumed").await;
+    db.insert_started(&record("s1", "swept", AgentTaskStatus::Running, 500))
+        .await
+        .unwrap();
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+
+    // The session is re-opened and lists the task as running again.
+    emit(
+        &card,
+        started(&record("s1", "swept", AgentTaskStatus::Running, 500)),
+        &mut rig.cx,
+    );
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(
+            find(&view, "s1", "swept").unwrap().record.status,
+            AgentTaskStatus::Interrupted,
+            "a replayed start does not bring a swept task back to running"
+        );
+    }
+
+    // A resumed task ends twice; the second outcome is the one kept.
+    emit(
+        &card,
+        started(&record("s1", "resumed", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    emit(
+        &card,
+        ended(&record("s1", "resumed", AgentTaskStatus::Stopped, 1_000)),
+        &mut rig.cx,
+    );
+    let mut again = record("s1", "resumed", AgentTaskStatus::Completed, 1_000);
+    again.ended_at_ms = Some(9_000);
+    again.tokens = Some(4_096);
+    emit(&card, ended(&again), &mut rig.cx);
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        let resumed = &find(&view, "s1", "resumed").unwrap().record;
+        assert_eq!(resumed.status, AgentTaskStatus::Completed);
+        assert_eq!(resumed.ended_at_ms, Some(9_000));
+        assert_eq!(resumed.tokens, Some(4_096));
+        assert_eq!(view.len(), 2);
+    }
+}
diff --git a/crates/agent_tasks_panel/src/store/title_tests.rs b/crates/agent_tasks_panel/src/store/title_tests.rs
new file mode 100644
index 0000000..e589a50
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/title_tests.rs
@@ -0,0 +1,314 @@
+// Story 014, task 6.1 fix — a thread's records follow its newest title (R1.1, R1.6).
+// Module path: `store::title`.
+//
+// Found by the GUI proof: a thread's first task is recorded under its provisional title (the
+// user's prompt), because the generated title arrives later. Its group was then titled with
+// the raw prompt once the card no longer showed the thread, and again after a restart. The
+// card now announces each held thread's title (`ThreadTitleChanged`), and the store moves
+// every record of the session to it, in memory and in the database.
+
+use acp_thread::{AcpThread, AgentTaskStatus};
+use agent_ui::{TaskRecord, ThreadTitleChanged};
+use gpui::{AppContext as _, Entity, SharedString, VisualTestContext};
+
+use super::GlobalTaskHistoryStore;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, HistoryEntry, TaskHistoryStore};
+
+const PROMPT: &str = "with the bash tool and run_in_background true, start one long sleep";
+const GENERATED: &str = "Background sleep command";
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+/// A store over `db`, loaded, then registered on the rig's card.
+fn registered_store(db: &AgentTaskHistoryDb, rig: &mut CardRig) -> Entity<TaskHistoryStore> {
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    store
+}
+
+fn titled(mut record: TaskRecord, title: &str) -> TaskRecord {
+    record.thread_title = Some(SharedString::from(title.to_string()));
+    record
+}
+
+fn retitle(session: &str, title: &str) -> ThreadTitleChanged {
+    ThreadTitleChanged {
+        session_id: sid(session),
+        title: SharedString::from(title.to_string()),
+    }
+}
+
+fn announce(rig: &mut CardRig, change: ThreadTitleChanged) {
+    rig.card.update(&mut rig.cx, |_, cx| cx.emit(change));
+    rig.cx.run_until_parked();
+}
+
+fn title_of(entries: &[HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(entries, session, task)
+        .expect("the task is recorded")
+        .record
+        .thread_title
+        .as_ref()
+        .map(|title| title.to_string())
+}
+
+fn generated() -> Option<String> {
+    Some(GENERATED.to_string())
+}
+
+// Hostile (wrong scope): the new title reaches every row of its session — the one recorded
+// under the prompt included — and no row of another session.
+#[gpui::test]
+async fn store_moves_every_record_of_a_session_to_its_new_title(cx: &mut gpui::TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_title_moves").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+
+    let first = titled(record("s1", "a", AgentTaskStatus::Completed, 1_000), PROMPT);
+    emit(&card, started(&first), &mut rig.cx);
+    emit(&card, ended(&first), &mut rig.cx);
+    let other = record("s2", "x", AgentTaskStatus::Running, 1_500);
+    emit(&card, started(&other), &mut rig.cx);
+
+    announce(&mut rig, retitle("s1", GENERATED));
+    let later = titled(
+        record("s1", "b", AgentTaskStatus::Running, 2_000),
+        GENERATED,
+    );
+    emit(&card, started(&later), &mut rig.cx);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(view.len(), 3);
+        assert_eq!(
+            title_of(&view, "s1", "a"),
+            generated(),
+            "the row recorded under the prompt takes the generated title"
+        );
+        assert_eq!(title_of(&view, "s1", "b"), generated());
+        assert_eq!(
+            title_of(&view, "s2", "x"),
+            Some("Thread s2".to_string()),
+            "another session's rows are untouched"
+        );
+        let a = &find(&view, "s1", "a").unwrap().record;
+        assert_eq!(
+            (a.status, a.ended_at_ms, a.tokens),
+            (AgentTaskStatus::Completed, Some(2_000), Some(100)),
+            "a rename changes nothing but the title"
+        );
+    }
+
+    // A restart: a new store over the same database loads the renamed rows.
+    let reloaded = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let view = entries(&reloaded, &rig.cx);
+    assert_eq!(title_of(&view, "s1", "a"), generated());
+    assert_eq!(title_of(&view, "s2", "x"), Some("Thread s2".to_string()));
+}
+
+// A title every row already carries writes nothing (a card announces again whenever it holds
+// a thread again); a rename whose write fails is logged with the session and kept in memory.
+#[gpui::test]
+async fn store_writes_a_title_only_when_it_changes_and_keeps_a_failed_rename(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_title_writes").await;
+    let store = registered_store(&db, &mut rig);
+    let card = rig.card.clone();
+    let first = titled(
+        record("session-t1", "a", AgentTaskStatus::Running, 1_000),
+        PROMPT,
+    );
+    emit(&card, started(&first), &mut rig.cx);
+    // Every later rename of a title is refused by the database.
+    run_sql(
+        &db,
+        "CREATE TRIGGER refuse_rename BEFORE UPDATE OF thread_title ON agent_task_history \
+         BEGIN SELECT RAISE(ABORT, 'rename refused'); END",
+    )
+    .await;
+
+    capture_logs();
+    announce(&mut rig, retitle("session-t1", PROMPT));
+    announce(&mut rig, retitle("session-without-records", GENERATED));
+    let errors = error_lines();
+    assert!(
+        errors.is_empty(),
+        "an unchanged title, or a session with no record, writes nothing: {errors:?}"
+    );
+    assert_eq!(entries(&store, &rig.cx).len(), 1, "a title records no task");
+
+    capture_logs();
+    announce(&mut rig, retitle("session-t1", GENERATED));
+    let errors = error_lines();
+    assert!(
+        errors.iter().any(|line| line.contains("session-t1")),
+        "the failed rename is logged at error level with its session: {errors:?}"
+    );
+    assert_eq!(
+        title_of(&entries(&store, &rig.cx), "session-t1", "a"),
+        generated(),
+        "memory keeps the new title"
+    );
+    assert_eq!(
+        title_of(&load(&db).await, "session-t1", "a"),
+        Some(PROMPT.to_string()),
+        "the refused write left the row as it was"
+    );
+}
+
+// A title heard while the startup sweep and load run is applied after them, to the rows the
+// load brought back — not lost, and not overwritten by the load.
+#[gpui::test]
+async fn store_applies_a_title_heard_during_the_startup_sweep_after_the_load(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_title_early").await;
+    db.insert_started(&titled(
+        record("s1", "old", AgentTaskStatus::Completed, 500),
+        PROMPT,
+    ))
+    .await
+    .unwrap();
+
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    announce(&mut rig, retitle("s1", GENERATED));
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(title_of(&view, "s1", "old"), generated());
+    }
+}
+
+fn open_thread_titled(rig: &mut CardRig, title: &str) -> Entity<AcpThread> {
+    open_thread_on(&rig.agent_panel, StopConnection::new(), title, &mut rig.cx)
+}
+
+// The card holds a thread before the store registers it (a thread restored at startup): the
+// store asks the card for the titles it already holds, and renames what the last run stored.
+#[gpui::test]
+async fn store_takes_the_titles_of_threads_the_card_held_before_registering(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let thread = open_thread_titled(&mut rig, GENERATED);
+    let session = session_of(&thread, &rig.cx).to_string();
+    let db = AgentTaskHistoryDb::open_test_db("store_title_pull").await;
+    db.insert_started(&titled(
+        record(&session, "a", AgentTaskStatus::Completed, 500),
+        PROMPT,
+    ))
+    .await
+    .unwrap();
+
+    let store = registered_store(&db, &mut rig);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(title_of(&view, &session, "a"), generated());
+    }
+}
+
+// End to end through the real card: a task listed while the thread still carries its
+// provisional title (the prompt), then the generated title arrives.
+#[gpui::test]
+async fn store_follows_a_real_thread_from_its_prompt_to_its_generated_title(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_title_live").await;
+    let store = registered_store(&db, &mut rig);
+    agent_ui::test_support::open_thread_with_custom_connection(
+        &rig.agent_panel,
+        StopConnection::new(),
+        &mut rig.cx,
+    );
+    rig.cx.run_until_parked();
+    let thread = rig.agent_panel.read_with(&rig.cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .expect("a thread was just opened")
+    });
+    thread.update(&mut rig.cx, |thread, cx| {
+        thread.set_provisional_title(PROMPT.into(), cx)
+    });
+    rig.cx.run_until_parked();
+    let session = session_of(&thread, &rig.cx).to_string();
+    send_tasks(
+        &thread,
+        vec![wire_task("a", "running", 1_000, None)],
+        &mut rig.cx,
+    );
+    assert_eq!(
+        title_of(&entries(&store, &rig.cx), &session, "a"),
+        Some(PROMPT.to_string()),
+        "the first task is recorded under the provisional title"
+    );
+
+    send_info(
+        &thread,
+        agent_client_protocol::schema::v1::SessionInfoUpdate::new().title(GENERATED),
+        &mut rig.cx,
+    );
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(title_of(&view, &session, "a"), generated());
+    }
+}
+
+// What the user saw: a thread the card no longer shows is grouped under the title of its
+// stored rows — after a restart too, when the panel is rebuilt over a store reloaded from the
+// same database.
+#[gpui::test]
+async fn panel_groups_a_thread_under_its_newest_title_after_a_restart(
+    cx: &mut gpui::TestAppContext,
+) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let card = panels
+        .agent_panel
+        .read_with(&panels.cx, |panel, _| panel.tasks_card().clone());
+    let only = titled(record("s1", "a", AgentTaskStatus::Completed, 1_000), PROMPT);
+    emit(&card, started(&only), &mut panels.cx);
+    emit(&card, ended(&only), &mut panels.cx);
+    card.update(&mut panels.cx, |_, cx| cx.emit(retitle("s1", GENERATED)));
+    panels.cx.run_until_parked();
+
+    let title = |groups: Vec<crate::PanelGroup>| {
+        groups
+            .into_iter()
+            .find(|group| group.session_id == sid("s1"))
+            .map(|group| group.title.to_string())
+    };
+    assert_eq!(title(groups(&mut panels)), generated());
+
+    // Restart: a new global store loaded from the same database, and a new panel over it.
+    let reloaded = panels
+        .cx
+        .update(|_, cx| cx.new(|cx| TaskHistoryStore::new(db.clone(), cx)));
+    panels
+        .cx
+        .update(|_, cx| cx.set_global(GlobalTaskHistoryStore(reloaded)));
+    let weak = panels.workspace.downgrade();
+    let loading = panels
+        .cx
+        .update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    panels.cx.run_until_parked();
+    let panel = loading.await.expect("the Agent Tasks panel loads again");
+    panels.cx.run_until_parked();
+    let groups = panel.update(&mut panels.cx, |panel, cx| panel.groups(cx));
+    assert_eq!(
+        title(groups),
+        generated(),
+        "the restarted panel titles the group with the generated title, not the prompt"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/test_helpers.rs b/crates/agent_tasks_panel/src/test_helpers.rs
new file mode 100644
index 0000000..173ab4b
--- /dev/null
+++ b/crates/agent_tasks_panel/src/test_helpers.rs
@@ -0,0 +1,546 @@
+// Story 014 — shared fixtures for the agent_tasks_panel tests (patch 0035).
+//
+// Declared in the crate's lib (`src/agent_tasks_panel.rs`) as
+//
+//     #[cfg(test)]
+//     mod test_helpers;
+//
+// in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/migration_tests.rs"]
+//     mod migration;
+//     #[cfg(test)]
+//     #[path = "history_db/statement_tests.rs"]
+//     mod statements;
+//
+// in `src/store.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "store/lifecycle_tests.rs"]
+//     mod lifecycle;
+//     #[cfg(test)]
+//     #[path = "store/archive_tests.rs"]
+//     mod archive;
+//
+// and in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/list_tests.rs"]
+//     mod list;
+//     #[cfg(test)]
+//     #[path = "panel/actions_tests.rs"]
+//     mod actions;
+//
+// so each test path carries its Validation filter: `history_db::migration`, `history_db`,
