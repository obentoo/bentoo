+fn watch(
+    card: &Entity<TasksCard>,
+    cx: &mut VisualTestContext,
+) -> (Rc<RefCell<Vec<Seen>>>, Subscription) {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let sink = seen.clone();
+    let subscription = cx.update(|_, cx| {
+        cx.subscribe(card, move |_, event: &TaskActivity, _| {
+            sink.borrow_mut().push(match event {
+                TaskActivity::Started(record) => Seen::Started(record.clone()),
+                TaskActivity::Ended(record) => Seen::Ended(record.clone()),
+            })
+        })
+    });
+    (seen, subscription)
+}
