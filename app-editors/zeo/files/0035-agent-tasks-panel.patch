+impl Panel for AgentTasksPanel {
+    fn persistent_name() -> &'static str {
+        "AgentTasksPanel"
+    }
+
+    fn panel_key() -> &'static str {
+        "AgentTasksPanel"
+    }
+
+    fn position(&self, _window: &Window, _cx: &App) -> DockPosition {
+        self.position
+    }
+
+    fn position_is_valid(&self, position: DockPosition) -> bool {
+        matches!(
+            position,
+            DockPosition::Left | DockPosition::Right | DockPosition::Bottom
+        )
+    }
+
+    fn set_position(
+        &mut self,
+        position: DockPosition,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.position = position;
+        let kvp = KeyValueStore::global(cx);
+        let value = dock_position_text(position).to_string();
+        self._save_position = cx.background_spawn(async move {
+            if let Err(error) = kvp
+                .write_kvp(<Self as Panel>::panel_key().to_string(), value)
+                .await
+            {
+                log::error!("agent tasks panel: saving the dock position failed: {error:#}");
+            }
+        });
+        // A dock moves its panels only when it re-reads their positions, which it does on a
+        // settings change. Panels with settings of their own get one by writing them; this
+        // panel has none, so it asks for the same re-read without changing any setting.
+        cx.update_global::<SettingsStore, _>(|_, _| {});
+        cx.notify();
+    }
+
+    fn default_size(&self, _window: &Window, _cx: &App) -> Pixels {
+        px(320.)
+    }
+
+    fn icon(&self, _window: &Window, _cx: &App) -> Option<IconName> {
+        Some(IconName::ListTodo)
+    }
+
+    fn icon_tooltip(&self, _window: &Window, _cx: &App) -> Option<&'static str> {
+        Some("Agent Tasks")
+    }
+
+    fn toggle_action(&self) -> Box<dyn Action> {
+        Box::new(ToggleFocus)
+    }
+
+    fn activation_priority(&self) -> u32 {
+        8
+    }
+}
