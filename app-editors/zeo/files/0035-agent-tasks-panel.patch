+// Story 014, task 3.2 — archive, unarchive and archive_group (R3.1, R3.2, R3.3, R3.4, Q4).
+// Module path: `store::archive`. Hostile fixtures come before benign ones.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+async fn seeded_store(
+    name: &'static str,
+    finished: &[(&str, &str, AgentTaskStatus)],
+    cx: &mut TestAppContext,
+) -> (AgentTaskHistoryDb, Entity<TaskHistoryStore>, CardRig) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db(name).await;
+    for (index, (session, task, status)) in finished.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, *status, at))
+            .await
+            .unwrap();
+    }
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    (db, store, rig)
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn archived(entries: &[HistoryEntry], session: &str, task: &str) -> bool {
+    find(entries, session, task)
+        .unwrap_or_else(|| panic!("({session}, {task}) should be recorded"))
+        .archived
+}
+
+// R3.2 hostile: the group's running task is never archived; another session — even one
+// holding the same task id, or a session id that extends this one — is not touched.
+#[gpui::test]
+async fn store_archive_group_archives_finished_rows_but_never_a_running_one(
+    cx: &mut TestAppContext,
+) {
+    let (db, store, mut rig) = seeded_store(
+        "store_archive_group",
+        &[
+            ("s1", "done", AgentTaskStatus::Completed),
+            ("s1", "bad", AgentTaskStatus::Failed),
+            ("s1", "halt", AgentTaskStatus::Stopped),
+            ("s1", "lost", AgentTaskStatus::Interrupted),
+            ("s2", "done", AgentTaskStatus::Completed),
+            ("s10", "other", AgentTaskStatus::Completed),
+        ],
+        cx,
+    )
+    .await;
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "run", AgentTaskStatus::Running, 9_000)),
+        &mut rig.cx,
+    );
+
+    store.update(&mut rig.cx, |store, cx| store.archive_group(&sid("s1"), cx));
+    rig.cx.run_until_parked();
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        for task in ["done", "bad", "halt", "lost"] {
+            assert!(
+                archived(&view, "s1", task),
+                "finished s1/{task} is archived"
+            );
+        }
+        assert!(
+            !archived(&view, "s1", "run"),
+            "the running task stays unarchived"
+        );
+        assert_eq!(
+            find(&view, "s1", "run").unwrap().record.status,
+            AgentTaskStatus::Running
+        );
+        assert!(
+            !archived(&view, "s2", "done"),
+            "same task id, other session: untouched"
+        );
+        assert!(
+            !archived(&view, "s10", "other"),
+            "a session id extending s1: untouched"
+        );
+    }
+}
+
+// R3.1, R3.3: archive keeps the record and its outcome; unarchive returns it as it was.
+#[gpui::test]
+async fn store_archive_and_unarchive_round_trip_one_task(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "store_archive_round_trip",
+        &[
+            ("s1", "t1", AgentTaskStatus::Failed),
+            ("s2", "t1", AgentTaskStatus::Completed),
+        ],
+        cx,
+    )
+    .await;
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.archive(&[key("s1", "t1")], cx)
+    });
+    rig.cx.run_until_parked();
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(view.len(), 2, "archiving keeps the record");
+        assert!(archived(&view, "s1", "t1"));
+        assert!(
+            !archived(&view, "s2", "t1"),
+            "the pair is the key, not the task id"
+        );
+        assert_eq!(
+            find(&view, "s1", "t1").unwrap().record.status,
+            AgentTaskStatus::Failed
+        );
+    }
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.unarchive(&[key("s1", "t1")], cx)
+    });
+    rig.cx.run_until_parked();
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert!(!archived(&view, "s1", "t1"));
+        assert_eq!(
+            find(&view, "s1", "t1").unwrap().record.status,
+            AgentTaskStatus::Failed,
+            "it returns with the outcome it had, so it matches the same filters"
+        );
+    }
+}
+
+// Q4: an archive whose write fails is kept in memory and logged with the ids.
+#[gpui::test]
+async fn store_archive_write_failure_keeps_memory_and_logs_ids(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "store_archive_write_failure",
+        &[("session-a1", "task-a1", AgentTaskStatus::Completed)],
+        cx,
+    )
+    .await;
+    drop_history_table(&db).await;
+    capture_logs();
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.archive(&[key("session-a1", "task-a1")], cx)
+    });
+    rig.cx.run_until_parked();
+
+    assert!(archived(&entries(&store, &rig.cx), "session-a1", "task-a1"));
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("session-a1") && line.contains("task-a1")),
+        "the failed archive is logged with both ids: {errors:?}"
+    );
+}
