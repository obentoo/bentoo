+/// One `_claude/tasks` wire task (story 012's camelCase shape).
+pub(crate) fn wire_task(
+    id: &str,
+    status: &str,
+    started_at_ms: u64,
+    usage: Option<(u64, u64)>,
+) -> serde_json::Value {
+    let ended = status != "running";
+    json!({
+        "id": id,
+        "toolCallId": format!("toolu_{id}"),
+        "type": "shell",
+        "description": format!("Task {id}"),
+        "background": false,
+        "depth": 0,
+        "status": status,
+        "startedAt": started_at_ms,
+        "endedAt": if ended { Some(started_at_ms + 1_000) } else { None },
+        "usage": usage.map(|(tokens, tool_uses)| json!({
+            "tokens": tokens,
+            "toolUses": tool_uses,
+            "durationMs": 1_000,
+        })),
+        "lastTool": null,
+        "summary": null,
+    })
+}
+
+/// Feeds a `_claude/tasks` snapshot (a level: it replaces the thread's list).
+pub(crate) fn send_tasks(
+    thread: &Entity<AcpThread>,
+    tasks: Vec<serde_json::Value>,
+    cx: &mut VisualTestContext,
+) {
+    let mut meta = serde_json::Map::new();
+    meta.insert(TASKS_KEY.to_string(), json!({ "tasks": tasks }));
+    send_info(thread, acp::SessionInfoUpdate::new().meta(meta), cx);
+}
+
+pub(crate) fn groups(panels: &mut Panels) -> Vec<PanelGroup> {
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.groups(cx))
+}
+
+pub(crate) fn find_row(panels: &mut Panels, session: &str, task: &str) -> Option<PanelRow> {
+    groups(panels)
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .find(|row| {
+            row.entry.record.session_id.to_string() == session
+                && row.entry.record.task_id.as_ref() == task
+        })
+}
+
+pub(crate) fn visible_keys(panels: &mut Panels) -> Vec<(String, String)> {
+    groups(panels)
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .map(|row| key_of(&row.entry))
+        .collect()
+}
