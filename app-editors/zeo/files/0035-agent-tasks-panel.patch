+// ── mark_running_interrupted (R1.5) ────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_mark_running_interrupted_touches_only_running_rows(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_mark_interrupted").await;
+    for record in [
+        record("s1", "run-a", AgentTaskStatus::Running, 1_000),
+        record("s2", "run-b", AgentTaskStatus::Running, 1_100),
+    ] {
+        db.insert_started(&record).await.unwrap();
+    }
+    for (task, status) in [
+        ("done", AgentTaskStatus::Completed),
+        ("bad", AgentTaskStatus::Failed),
+        ("halt", AgentTaskStatus::Stopped),
+        ("old", AgentTaskStatus::Interrupted),
+    ] {
+        let mut running = record("s1", task, AgentTaskStatus::Running, 500);
+        db.insert_started(&running).await.unwrap();
+        running = record("s1", task, status, 500);
+        db.update_ended(&running).await.unwrap();
+    }
+    db.set_archived(&[key("s1", "done")], true).await.unwrap();
+
+    db.mark_running_interrupted().await.unwrap();
+
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 6, "the sweep deletes nothing");
+    for task in ["run-a", "run-b"] {
+        let session = if task == "run-a" { "s1" } else { "s2" };
+        let swept = &find(&rows, session, task).unwrap().record;
+        assert_eq!(swept.status, AgentTaskStatus::Interrupted, "{task}");
+        assert!(swept.ended_at_ms.is_some(), "{task} gets an end time");
+    }
+    for (task, status) in [
+        ("done", AgentTaskStatus::Completed),
+        ("bad", AgentTaskStatus::Failed),
+        ("halt", AgentTaskStatus::Stopped),
+        ("old", AgentTaskStatus::Interrupted),
+    ] {
+        let kept = find(&rows, "s1", task).unwrap();
+        assert_eq!(kept.record.status, status, "{task} keeps its outcome");
+        assert_eq!(
+            kept.record.ended_at_ms,
+            Some(1_500),
+            "{task} keeps its end time"
+        );
+        assert_eq!(kept.record.tokens, Some(100), "{task} keeps its tokens");
+    }
+    assert!(
+        find(&rows, "s1", "done").unwrap().archived,
+        "archived flag untouched"
+    );
+
+    // Running it again (a second startup) changes nothing more.
+    db.mark_running_interrupted().await.unwrap();
+    let again = load(&db).await;
+    assert_eq!(
+        find(&again, "s1", "run-a").unwrap().record.ended_at_ms,
+        find(&rows, "s1", "run-a").unwrap().record.ended_at_ms
+    );
+}
