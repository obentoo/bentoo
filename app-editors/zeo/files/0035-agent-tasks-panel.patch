+// R1.7: closing a thread with a running task ends it as interrupted; a closed thread with only
+// ended tasks emits nothing more; a kept thread holding the same task id emits nothing.
+#[gpui::test]
+async fn tasks_card_activity_closing_a_thread_interrupts_only_its_running_tasks(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "running", false, 1_000),
+            wire_task("t0", "running", false, 900),
+        ],
+        &mut cx,
+    );
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "running", false, 1_000),
+            wire_task("t0", "completed", false, 900),
+        ],
+        &mut cx,
+    );
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", false, 2_000)], &mut cx);
+    send_tasks(
+        &b,
+        vec![wire_task("t1", "completed", false, 2_000)],
+        &mut cx,
+    );
+    let c = open_titled_thread(&panel, &connection, "C", &mut cx);
+    send_tasks(&c, vec![wire_task("t1", "running", false, 3_000)], &mut cx);
+    let sa = session_of(&a, &cx);
+    let card = card(&panel, &cx);
+    let (seen, _subscription) = watch(&card, &mut cx);
+
+    // The panel now holds only C.
+    let c_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&c_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+
+    let events = seen.borrow().clone();
+    assert_eq!(events.len(), 1, "only A's running task ends: {events:?}");
+    let Seen::Ended(interrupted) = &events[0] else {
+        panic!("expected an end, got {events:?}");
+    };
+    assert_eq!(interrupted.session_id, sa);
+    assert_eq!(interrupted.task_id.to_string(), "t1");
+    assert_eq!(interrupted.status, AgentTaskStatus::Interrupted);
+    assert!(
+        interrupted.ended_at_ms.is_some(),
+        "an interrupted task gets an end time"
+    );
+}
