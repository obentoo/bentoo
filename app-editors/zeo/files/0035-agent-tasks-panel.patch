+// R1.10 (refine v2): one task ending that reaches the card through two views of one session
+// is one `Ended`. Two views share one `AcpThread` because `AcpConnection` hands the thread it
+// already holds to a second caller loading the same session id; the card subscribes to that
+// thread once per view, so it hears each `TaskEnded` twice (story 013 measured this and
+// dedupes it for the tray). The connection below copies 013's `tray/dedupe_tests.rs`
+// fixture, which is private to that module.
+//
+// Every ending here is `completed` and unwatched, so `tray::should_notify` is false and no
+// datagram can reach a live `zeo-systray` — no `ENV_LOCK` needed (it is private to `tray`).
+mod two_views {
+    use std::{
+        any::Any,
+        collections::HashMap,
+        rc::Rc,
+        sync::{Arc, Mutex},
+    };
+
+    use acp_thread::{AcpThread, AgentConnection, AgentTaskStatus};
+    use agent_client_protocol::schema::v1 as acp;
+    use agent_client_protocol::schema::v2 as acp_v2;
+    use anyhow::{Result, anyhow};
+    use gpui::{
+        App, AppContext as _, Entity, SharedString, Task, TestAppContext, VisualTestContext,
+        WeakEntity,
+    };
+    use project::{AgentId, Project};
+    use workspace::{PathList, Workspace};
+
+    use super::{ends, starts, watch};
+    use crate::agent_connection_store::AgentConnectionStore;
+    use crate::tasks_card::TasksCard;
+    use crate::tasks_card::test_helpers::*;
+    use crate::test_support::{StubAgentServer, open_thread_with_custom_connection};
+    use crate::{Agent, AgentPanel, AgentThreadSource, ConversationView};
+
+    /// `TaskActionsConnection`, plus the session reuse of `AcpConnection`: loading a
+    /// session that is already open returns the thread that holds it.
+    #[derive(Clone)]
+    struct SharedSessionConnection {
+        inner: TaskActionsConnection,
+        threads: Arc<Mutex<HashMap<acp_v2::SessionId, WeakEntity<AcpThread>>>>,
+    }
+
+    impl SharedSessionConnection {
+        fn new() -> Self {
+            Self {
+                inner: TaskActionsConnection::new(),
+                threads: Arc::default(),
+            }
+        }
+    }
+
+    impl AgentConnection for SharedSessionConnection {
+        fn agent_id(&self) -> AgentId {
+            self.inner.agent_id()
+        }
+
+        fn telemetry_id(&self) -> SharedString {
+            self.inner.telemetry_id()
+        }
+
+        fn new_session(
+            self: Rc<Self>,
+            project: Entity<Project>,
+            work_dirs: PathList,
+            cx: &mut App,
+        ) -> Task<Result<Entity<AcpThread>>> {
+            let created = Rc::new(self.inner.clone()).new_session(project, work_dirs, cx);
+            let threads = self.threads.clone();
+            cx.spawn(async move |cx| {
+                let thread = created.await?;
+                let session_id = cx.update(|cx| thread.read(cx).session_id().clone());
+                threads
+                    .lock()
+                    .map_err(|_| anyhow!("thread registry poisoned"))?
+                    .insert(session_id, thread.downgrade());
+                Ok(thread)
+            })
+        }
+
+        fn supports_load_session(&self) -> bool {
+            true
+        }
+
+        fn load_session(
+            self: Rc<Self>,
+            session_id: acp_v2::SessionId,
+            _project: Entity<Project>,
+            _work_dirs: PathList,
+            _title: Option<SharedString>,
+            _cx: &mut App,
+        ) -> Task<Result<Entity<AcpThread>>> {
+            let held = self
+                .threads
+                .lock()
+                .ok()
+                .and_then(|threads| threads.get(&session_id).and_then(WeakEntity::upgrade));
+            Task::ready(held.ok_or_else(|| anyhow!("session {session_id} is not open")))
+        }
+
+        fn auth_methods(&self) -> &[agent_client_protocol::schema::v2::AuthMethod] {
+            &[]
+        }
+
+        fn authenticate(&self, method: agent_client_protocol::schema::v2::AuthMethodId, cx: &mut App) -> Task<Result<()>> {
+            self.inner.authenticate(method, cx)
+        }
+
+        fn prompt(
+            &self,
+            params: agent_client_protocol::schema::v2::PromptRequest,
+            cx: &mut App,
+        ) -> Task<Result<acp::PromptResponse>> {
+            self.inner.prompt(params, cx)
+        }
+
+        fn cancel(&self, session_id: &acp_v2::SessionId, cx: &mut App) {
+            self.inner.cancel(session_id, cx)
+        }
+
+        fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+            self
+        }
+    }
+
+    /// Opens a new thread on `connection` in the panel, titles it, returns its root thread.
+    fn open_shared_titled_thread(
+        panel: &Entity<AgentPanel>,
+        connection: &SharedSessionConnection,
+        title: &str,
+        cx: &mut VisualTestContext,
+    ) -> Entity<AcpThread> {
+        open_thread_with_custom_connection(panel, connection.clone(), cx);
+        let thread = panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+        send_info(&thread, acp::SessionInfoUpdate::new().title(title), cx);
+        thread
+    }
+
+    /// A second conversation view, outside the panel, that loads the open `session_id`.
+    fn second_view_of(
+        session_id: &acp_v2::SessionId,
+        connection: &SharedSessionConnection,
+        workspace: &Entity<Workspace>,
+        cx: &mut VisualTestContext,
+    ) -> Entity<ConversationView> {
+        let project = workspace.read_with(cx, |workspace, _| workspace.project().clone());
+        let view = cx.update(|window, cx| {
+            let connection_store = cx.new(|cx| AgentConnectionStore::new(project.clone(), cx));
+            cx.new(|cx| {
+                ConversationView::new(
+                    Rc::new(StubAgentServer::new(connection.clone()).with_connection_agent_id()),
+                    connection_store,
+                    Agent::Custom {
+                        id: connection.agent_id(),
+                    },
+                    Some(session_id.clone()),
+                    None,
+                    None,
+                    None,
+                    None,
+                    workspace.downgrade(),
+                    project,
+                    None,
+                    AgentThreadSource::AgentPanel,
+                    window,
+                    cx,
+                )
+            })
+        });
+        cx.run_until_parked();
+        view
+    }
+
+    fn root_thread_of(
+        view: &Entity<ConversationView>,
+        cx: &VisualTestContext,
+    ) -> Entity<AcpThread> {
+        view.read_with(cx, |view, cx| view.root_thread(cx))
+            .expect("the view holds a root thread")
+    }
+
+    fn active_view(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Entity<ConversationView> {
+        panel
+            .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+            .expect("the panel shows a conversation")
+    }
+
+    /// How many of the card's held views hold `thread`.
+    fn times_held(
+        card: &Entity<TasksCard>,
+        thread: &Entity<AcpThread>,
+        cx: &VisualTestContext,
+    ) -> usize {
+        card.read_with(cx, |card, _| {
+            card.views
+                .iter()
+                .filter_map(|held| held.thread.as_ref())
+                .filter(|held| held.thread_id == thread.entity_id())
+                .count()
+        })
+    }
+
+    fn ended_keys(seen: &Rc<std::cell::RefCell<Vec<super::Seen>>>) -> Vec<(String, String)> {
+        ends(seen).iter().map(super::key_of).collect()
+    }
+
+    // Hostile (wrong split), the rule itself: one ending heard through two views is one Ended.
+    // Hostile (wrong collapse), both converse fixtures of the dedupe key: the same task id
+    // ending in ANOTHER session still ends (a key without the session would swallow it), and
+    // ANOTHER task of the shared session still ends (a key without the task id would swallow it).
+    #[gpui::test]
+    async fn tasks_card_activity_one_ending_through_two_views_emits_one_ended(
+        cx: &mut TestAppContext,
+    ) {
+        let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+        let card = card(&panel, &cx);
+        let (seen, _subscription) = watch(&card, &mut cx);
+        let connection = SharedSessionConnection::new();
+
+        // The third element: another session, held by the panel, with the same task id.
+        let other = open_shared_titled_thread(&panel, &connection, "Other", &mut cx);
+        send_tasks(
+            &other,
+            vec![wire_task("t1", "running", false, 500)],
+            &mut cx,
+        );
+        let other_session = session_of(&other, &cx);
+
+        // The shared session, held through the panel's view and a second view.
+        let shared = open_shared_titled_thread(&panel, &connection, "Shared", &mut cx);
+        let session = session_of(&shared, &cx);
+        assert_ne!(session, other_session, "two sessions");
+        let first = active_view(&panel, &cx);
+        let second = second_view_of(&session, &connection, &workspace, &mut cx);
+        assert_ne!(first.entity_id(), second.entity_id(), "two views");
+        assert_eq!(
+            root_thread_of(&second, &cx).entity_id(),
+            shared.entity_id(),
+            "the second view shares the first view's thread"
+        );
+        let mut views = panel.read_with(&cx, |panel, _| panel.conversation_views());
+        views.push(second);
+        card.update(&mut cx, |card, cx| card.sync_threads(views.iter(), cx));
+        cx.run_until_parked();
+        assert_eq!(
+            times_held(&card, &shared, &cx),
+            2,
+            "the card holds the shared thread twice"
+        );
+        assert_eq!(
+            times_held(&card, &other, &cx),
+            1,
+            "the card holds the other thread"
+        );
+
+        send_tasks(
+            &shared,
+            vec![
+                wire_task("t1", "running", false, 1_000),
+                wire_task("t2", "running", false, 1_100),
+            ],
+            &mut cx,
+        );
+        let other_key = (other_session.to_string(), "t1".to_string());
+        let shared_t1 = (session.to_string(), "t1".to_string());
+        let shared_t2 = (session.to_string(), "t2".to_string());
+        assert_eq!(
+            starts(&seen),
+            vec![other_key.clone(), shared_t1.clone(), shared_t2.clone()],
+            "one Started per task, however many views hear its snapshot"
+        );
+
+        // The other session's t1 ends first, so a session-blind key would be taken already.
+        send_tasks(
+            &other,
+            vec![wire_task("t1", "completed", false, 500)],
+            &mut cx,
+        );
+        assert_eq!(ended_keys(&seen), vec![other_key.clone()]);
+
+        // The shared t1 ends once; both views deliver it.
+        assert_eq!(
+            times_held(&card, &shared, &cx),
+            2,
+            "still held through both views"
+        );
+        send_tasks(
+            &shared,
+            vec![
+                wire_task("t1", "completed", false, 1_000),
+                wire_task("t2", "running", false, 1_100),
+            ],
+            &mut cx,
+        );
+        cx.run_until_parked();
+        assert_eq!(
+            ended_keys(&seen),
+            vec![other_key.clone(), shared_t1.clone()],
+            "one ending through two views is one Ended, and another session's same id is apart"
+        );
+        let shared_end = ends(&seen)
+            .into_iter()
+            .find(|record| super::key_of(record) == shared_t1)
+            .unwrap();
+        assert_eq!(shared_end.session_id, session);
+        assert_eq!(shared_end.status, AgentTaskStatus::Completed);
+
+        // Another task of the shared session still ends, once.
+        send_tasks(
+            &shared,
+            vec![
+                wire_task("t1", "completed", false, 1_000),
+                wire_task("t2", "completed", false, 1_100),
+            ],
+            &mut cx,
+        );
+        cx.run_until_parked();
+        assert_eq!(
+            times_held(&card, &shared, &cx),
+            2,
+            "both views held to the end"
+        );
+        assert_eq!(
+            ended_keys(&seen),
+            vec![other_key, shared_t1, shared_t2],
+            "one Ended per ending: {:?}",
+            ends(&seen)
+        );
+        assert_eq!(starts(&seen).len(), 3, "an ending is not a new start");
+    }
+}
