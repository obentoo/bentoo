+// Story 014, task 4.2 — row actions: open, vanished thread, stop, archive (R2.5, R2.6, R2.7,
+// R3.1, R3.2, R3.3, R3.4, Q4, Q11). Module path: `panel::actions`.
+
+use acp_thread::AgentTaskStatus;
+use gpui::TestAppContext;
+
+use crate::TaskFilter;
+use crate::test_helpers::*;
+
+fn only(panels: &mut Panels, on: &[TaskFilter]) {
+    let all = [
+        TaskFilter::Active,
+        TaskFilter::Finished,
+        TaskFilter::Failed,
+        TaskFilter::Archived,
+    ];
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in all {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    panels.cx.run_until_parked();
+}
+
+fn defaults(panels: &mut Panels) {
+    only(panels, &[TaskFilter::Active, TaskFilter::Finished]);
+}
+
+fn open(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.open_task(&target, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+async fn seed_finished(
+    db: &crate::AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+}
+
+// R2.5 — a click opens the task's own thread. Hostile: both threads hold the same task id.
+#[gpui::test]
+async fn panel_actions_click_opens_the_thread_of_the_task(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread_a = open_live_thread(&mut panels, "Thread A");
+    send_tasks(
+        &thread_a,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let thread_b = open_live_thread(&mut panels, "Thread B");
+    send_tasks(
+        &thread_b,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let a = session_of(&thread_a, &panels.cx);
+    let b = session_of(&thread_b, &panels.cx);
+    assert_eq!(active_session(&panels), Some(b.clone()));
+
+    open(&mut panels, &a.to_string(), "t");
+    assert_eq!(
+        active_session(&panels),
+        Some(a.clone()),
+        "opens thread A, not the latest"
+    );
+    assert_eq!(
+        find_row(&mut panels, &a.to_string(), "t").unwrap().notice,
+        None
+    );
+
+    open(&mut panels, &b.to_string(), "t");
+    assert_eq!(active_session(&panels), Some(b));
+}
+
+// R2.7 — a recorded task whose thread is gone says so on its row and opens nothing.
+#[gpui::test]
+async fn panel_actions_click_on_a_task_whose_thread_vanished_says_so(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(&db, "gone-session", "t", AgentTaskStatus::Completed, 1_000).await;
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Still here");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let here = session_of(&thread, &panels.cx);
+    let before = active_session(&panels);
+    assert_eq!(before, Some(here.clone()));
+
+    open(&mut panels, "gone-session", "t");
+
+    assert_eq!(active_session(&panels), before, "no empty thread is opened");
+    let notice = find_row(&mut panels, "gone-session", "t")
+        .expect("the row is still listed")
+        .notice
+        .expect("the row says why nothing opened");
+    assert!(notice.contains("Thread no longer exists"), "got {notice:?}");
+    assert_eq!(
+        find_row(&mut panels, &here.to_string(), "t")
+            .unwrap()
+            .notice,
+        None,
+        "the same task id in a live thread carries no notice"
+    );
+}
+
+// R2.6, R3.4 — Stop only on running rows; archive only on finished rows.
+#[gpui::test]
+async fn panel_actions_running_rows_offer_stop_and_finished_rows_offer_archive(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed_finished(&db, "older", "past", AgentTaskStatus::Failed, 500).await;
+    let mut panels = open_panels(cx).await;
+    only(
+        &mut panels,
+        &[TaskFilter::Active, TaskFilter::Finished, TaskFilter::Failed],
+    );
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "running", 900, None),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "completed", 900, Some((10, 1))),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+
+    let run = find_row(&mut panels, &session, "run").unwrap();
+    assert!(run.can_stop, "a running row offers Stop");
+    assert!(!run.can_archive, "a running row never offers archive");
+    for (session, task) in [(session.as_str(), "done"), ("older", "past")] {
+        let row = find_row(&mut panels, session, task).unwrap();
+        assert!(!row.can_stop, "{task}: nothing to stop");
+        assert!(row.can_archive, "{task}: a finished row offers archive");
+    }
+}
+
+// R2.6 — Stop goes through the card's `request_stop`: story 013's prompt (it names the task),
+// Cancel sends nothing, a confirmed stop reaches THAT task of THAT thread, and a failed stop's
+// error — kept by the card — is read back on the panel row. Hostile: two threads share the
+// task id.
+#[gpui::test]
+async fn panel_actions_stop_uses_the_card_flow_and_shows_its_error(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    *connection.stop_error.lock().unwrap() = Some("stop failed for task run: boom");
+    let other = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Other",
+        &mut panels.cx,
+    );
+    send_tasks(
+        &other,
+        vec![wire_task("run", "running", 500, None)],
+        &mut panels.cx,
+    );
+    let thread = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Live",
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("run", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    let target = key(&session, "run");
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_stop(&target, window, cx)
+        });
+    panels.cx.run_until_parked();
+    assert!(panels.cx.has_pending_prompt(), "Stop asks before stopping");
+    let (message, detail) = panels.cx.pending_prompt().unwrap();
+    assert!(
+        format!("{message} {detail}").contains("Task run"),
+        "the card's prompt names the task: {message:?} / {detail:?}"
+    );
+    panels.cx.simulate_prompt_answer("Cancel");
+    panels.cx.run_until_parked();
+    assert!(connection.stops().is_empty(), "Cancel sends nothing");
+    assert_eq!(
+        find_row(&mut panels, &session, "run")
+            .unwrap()
+            .entry
+            .record
+            .status,
+        AgentTaskStatus::Running
+    );
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_stop(&target, window, cx)
+        });
+    panels.cx.run_until_parked();
+    panels.cx.simulate_prompt_answer("Stop");
+    panels.cx.run_until_parked();
+    assert_eq!(
+        connection.stops(),
+        vec![(session.clone(), "run".to_string())],
+        "only that thread's task is stopped"
+    );
+    let row = find_row(&mut panels, &session, "run").expect("the task is still listed");
+    assert_eq!(row.entry.record.status, AgentTaskStatus::Running);
+    let error = row
+        .error
+        .expect("the card's stop error reaches the panel row");
+    assert!(error.contains("boom"), "row error was {error:?}");
+    let other_session = session_of(&other, &panels.cx).to_string();
+    assert_eq!(
+        find_row(&mut panels, &other_session, "run").unwrap().error,
+        None,
+        "the other thread's same-id row carries no error"
+    );
+}
+
+// R3.1, R3.3 — archive hides a finished row from every filter but Archived and keeps the
+// record; unarchive returns it to the filters it matched.
+#[gpui::test]
+async fn panel_actions_archive_hides_a_finished_row_until_unarchived(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(&db, "s1", "c1", AgentTaskStatus::Completed, 1_000).await;
+    seed_finished(&db, "s1", "c2", AgentTaskStatus::Completed, 1_100).await;
+    seed_finished(&db, "s2", "c1", AgentTaskStatus::Completed, 1_200).await;
+    let mut panels = open_panels(cx).await;
+
+    let target = key("s1", "c1");
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.archive(&target, cx));
+    panels.cx.run_until_parked();
+
+    assert!(
+        find_row(&mut panels, "s1", "c1").is_none(),
+        "hidden by default"
+    );
+    assert!(find_row(&mut panels, "s1", "c2").is_some());
+    assert!(
+        find_row(&mut panels, "s2", "c1").is_some(),
+        "same task id elsewhere stays"
+    );
+    only(
+        &mut panels,
+        &[TaskFilter::Active, TaskFilter::Finished, TaskFilter::Failed],
+    );
+    assert!(
+        find_row(&mut panels, "s1", "c1").is_none(),
+        "hidden from every filter"
+    );
+    only(&mut panels, &[TaskFilter::Archived]);
+    assert!(
+        find_row(&mut panels, "s1", "c1").is_some(),
+        "shown under Archived"
+    );
+    let stored = load(&db).await;
+    assert!(
+        find(&stored, "s1", "c1").unwrap().archived,
+        "the record is kept, archived"
+    );
+
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.unarchive(&target, cx));
+    panels.cx.run_until_parked();
+    assert!(
+        find_row(&mut panels, "s1", "c1").is_none(),
+        "no longer under Archived"
+    );
+    defaults(&mut panels);
+    assert!(
+        find_row(&mut panels, "s1", "c1").is_some(),
+        "back under Finished"
+    );
+}
+
+// R3.2 — archiving a group leaves its running task in Active and moves the rest to Archived.
+#[gpui::test]
+async fn panel_actions_archive_group_leaves_the_running_task_in_active(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(
+        &db,
+        "other-session",
+        "done",
+        AgentTaskStatus::Completed,
+        500,
+    )
+    .await;
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "running", 900, None),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "completed", 900, Some((10, 1))),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx);
+    let s = session.to_string();
+
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.archive_group(&session, cx)
+    });
+    panels.cx.run_until_parked();
+
+    assert!(
+        find_row(&mut panels, &s, "run").is_some(),
+        "the running task stays in Active"
+    );
+    assert!(
+        find_row(&mut panels, &s, "done").is_none(),
+        "the finished task left the defaults"
+    );
+    assert!(
+        find_row(&mut panels, "other-session", "done").is_some(),
+        "another thread's task with the same id is untouched"
+    );
+    only(&mut panels, &[TaskFilter::Archived]);
+    assert!(find_row(&mut panels, &s, "done").is_some());
+    assert!(
+        find_row(&mut panels, &s, "run").is_none(),
+        "the running task is not archived"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/list_tests.rs b/crates/agent_tasks_panel/src/panel/list_tests.rs
