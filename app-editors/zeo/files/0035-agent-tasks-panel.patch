+/// A workspace with only the agent panel (and so its real `TasksCard`). No crate `init`.
+pub(crate) async fn card_rig(cx: &mut TestAppContext) -> CardRig {
+    init_base(cx);
+    let (workspace, agent_panel, cx) = open_agent_workspace(cx).await;
+    let card = agent_panel.read_with(&cx, |panel, _| panel.tasks_card().clone());
