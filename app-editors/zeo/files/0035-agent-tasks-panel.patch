+    let rows = load(&db).await;
+    let quick = &find(&rows, "s1", "quick").unwrap().record;
+    assert_eq!(
+        quick.status,
+        AgentTaskStatus::Failed,
+        "not stored as running"
+    );
+    assert_eq!(quick.ended_at_ms, Some(1_250));
+    assert_eq!(quick.tokens, Some(77));
+    assert_eq!(quick.tool_uses, Some(2));
+    let slow = &find(&rows, "s1", "slow").unwrap().record;
+    assert_eq!(slow.status, AgentTaskStatus::Running);
+    assert_eq!(slow.ended_at_ms, None, "a running record writes no end");
+    assert_eq!(slow.tokens, None);
