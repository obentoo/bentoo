+// ── update_ended ───────────────────────────────────────────────────────────
+
+// Hostile: ending (s1, t1) leaves (s2, t1) running.
+#[gpui::test]
+async fn history_db_update_ended_writes_the_outcome_on_its_own_row_only(_cx: &mut TestAppContext) {
