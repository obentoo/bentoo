--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/list_tests.rs
@@ -0,0 +1,291 @@
+// Story 014, task 4.1 — the dock panel, its list and its filters (R2.1, R2.2, R2.3, R2.4,
+// R4.3, Q11, Q14). Module path: `panel::list`. GPUI integration tests over the real
+// TasksCard, the real store and the per-test app database.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{TestAppContext, px};
+use ui::IconName;
+use workspace::dock::{DockPosition, Panel};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter};
+
+async fn seed_finished(db: &AgentTaskHistoryDb, record: agent_ui::TaskRecord) {
+    let mut running = record.clone();
+    running.status = AgentTaskStatus::Running;
+    running.ended_at_ms = None;
+    running.tokens = None;
+    running.tool_uses = None;
+    db.insert_started(&running).await.unwrap();
+    db.update_ended(&record).await.unwrap();
+}
+
+fn set_filters(panels: &mut Panels, on: &[TaskFilter]) {
+    let all = [
+        TaskFilter::Active,
+        TaskFilter::Finished,
+        TaskFilter::Failed,
+        TaskFilter::Archived,
+    ];
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in all {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    panels.cx.run_until_parked();
+}
+
+fn sorted(mut keys: Vec<(String, String)>) -> Vec<(String, String)> {
+    keys.sort();
+    keys
+}
+
+fn pair(session: &str, task: &str) -> (String, String) {
+    (session.to_string(), task.to_string())
+}
+
+// R2.1, Q14 — dock, size, icon, tooltip and toggle action; `init` created the store.
+#[gpui::test]
+async fn panel_list_docks_left_by_default_at_320px_and_accepts_every_dock(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+
+    panels.cx.update(|_, cx| {
+        crate::TaskHistoryStore::global(cx);
+    });
+    assert_eq!(
+        <AgentTasksPanel as Panel>::persistent_name(),
+        "AgentTasksPanel"
+    );
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            assert!(matches!(panel.position(window, cx), DockPosition::Left));
+            assert_eq!(panel.default_size(window, cx), px(320.));
+            for position in [
+                DockPosition::Left,
+                DockPosition::Right,
+                DockPosition::Bottom,
+            ] {
+                assert!(
+                    panel.position_is_valid(position),
+                    "{position:?} is a valid dock"
+                );
+            }
+            assert_eq!(panel.icon(window, cx), Some(IconName::ListTodo));
+            assert!(
+                panel.icon_tooltip(window, cx).is_some(),
+                "the dock button carries a tooltip"
+            );
+            assert!(panel.toggle_action().partial_eq(&crate::ToggleFocus));
+            assert_eq!(panel.status_message(cx), None, "history is available");
+        });
+}
+
+#[gpui::test]
+async fn panel_list_toggle_focus_action_opens_the_panel_in_its_dock(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let tasks_panel_id = panels.tasks_panel.entity_id();
+    let shown = |panels: &Panels| {
+        panels.workspace.read_with(&panels.cx, |workspace, cx| {
+            let dock = workspace.left_dock().read(cx);
+            dock.is_open()
+                && dock.visible_panel().map(|panel| panel.panel_id()) == Some(tasks_panel_id)
+        })
+    };
+    assert!(!shown(&panels), "the panel starts closed");
+
+    panels.cx.dispatch_action(crate::ToggleFocus);
+    panels.cx.run_until_parked();
+    assert!(shown(&panels), "ToggleFocus opens the Agent Tasks panel");
+}
+
+// R2.2 — grouped by thread (session), groups by their newest task, rows newest first.
+// Hostile: two threads with the same title stay two groups; one thread whose title changed
+// between tasks stays one group; one task id in two threads stays in its own group.
+#[gpui::test]
+async fn panel_list_groups_threads_by_their_newest_task_and_lists_rows_newest_first(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    let titled = |session: &str, task: &str, at: i64, title: &str| {
+        let mut finished = record(session, task, AgentTaskStatus::Completed, at);
+        finished.thread_title = Some(title.to_string().into());
+        finished
+    };
+    // X: oldest 1000, newest 5000. Y: oldest 3000, newest 4000. Z: only 4500.
+    seed_finished(&db, titled("x", "a1", 1_000, "Same title")).await;
+    seed_finished(&db, titled("x", "shared", 2_000, "Same title")).await;
+    seed_finished(&db, titled("x", "a2", 5_000, "Renamed title")).await;
+    seed_finished(&db, titled("y", "b1", 3_000, "Same title")).await;
+    seed_finished(&db, titled("y", "shared", 4_000, "Same title")).await;
+    seed_finished(&db, titled("z", "c1", 4_500, "Another")).await;
+
+    let mut panels = open_panels(cx).await;
+    let groups = groups(&mut panels);
+
+    let order: Vec<String> = groups.iter().map(|g| g.session_id.to_string()).collect();
+    assert_eq!(
+        order,
+        vec!["x", "z", "y"],
+        "groups ordered by their newest task"
+    );
+    let rows_of = |session: &str| -> Vec<String> {
+        groups
+            .iter()
+            .find(|g| g.session_id.to_string() == session)
+            .unwrap()
+            .rows
+            .iter()
+            .map(|row| row.entry.record.task_id.to_string())
+            .collect()
+    };
+    assert_eq!(
+        rows_of("x"),
+        vec!["a2", "shared", "a1"],
+        "rows newest first"
+    );
+    assert_eq!(rows_of("y"), vec!["shared", "b1"]);
+    assert_eq!(rows_of("z"), vec!["c1"]);
+}
+
+// R2.4 — Active and Finished on by default; Failed and Archived off. Archived rows show
+// under Archived only.
+#[gpui::test]
+async fn panel_list_filters_default_to_active_and_finished(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    for (task, status, at) in [
+        ("c", AgentTaskStatus::Completed, 1_000),
+        ("s", AgentTaskStatus::Stopped, 1_100),
+        ("i", AgentTaskStatus::Interrupted, 1_200),
+        ("f", AgentTaskStatus::Failed, 1_300),
+        ("ac", AgentTaskStatus::Completed, 1_400),
+        ("af", AgentTaskStatus::Failed, 1_500),
+    ] {
+        seed_finished(&db, record("s1", task, status, at)).await;
+    }
+    db.set_archived(&[key("s1", "ac"), key("s1", "af")], true)
+        .await
+        .unwrap();
+
+    let mut panels = open_panels(cx).await;
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        assert!(panel.is_filter_enabled(TaskFilter::Active));
+        assert!(panel.is_filter_enabled(TaskFilter::Finished));
+        assert!(!panel.is_filter_enabled(TaskFilter::Failed));
+        assert!(!panel.is_filter_enabled(TaskFilter::Archived));
+    });
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        sorted(vec![pair("s1", "c"), pair("s1", "s"), pair("s1", "i")]),
+        "Finished = completed, stopped, interrupted; archived rows hidden"
+    );
+
+    set_filters(
+        &mut panels,
+        &[TaskFilter::Active, TaskFilter::Finished, TaskFilter::Failed],
+    );
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        sorted(vec![
+            pair("s1", "c"),
+            pair("s1", "s"),
+            pair("s1", "i"),
+            pair("s1", "f")
+        ]),
+        "an archived failed row stays hidden under Failed"
+    );
+
+    set_filters(&mut panels, &[TaskFilter::Failed]);
+    assert_eq!(visible_keys(&mut panels), vec![pair("s1", "f")]);
+
+    set_filters(&mut panels, &[TaskFilter::Archived]);
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        sorted(vec![pair("s1", "ac"), pair("s1", "af")]),
+        "Archived shows the archived rows only"
+    );
+}
+
+// R2.3, R1.4 — a running row reads its live values from the card; progress is not stored.
+// End to end: snapshot → TasksCard → TaskActivity → store (registered on the card by
+// `AgentTasksPanel::load`) → panel.
+#[gpui::test]
+async fn panel_list_running_row_shows_live_progress_from_the_card(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live thread");
+    let session = session_of(&thread, &panels.cx).to_string();
+
+    send_tasks(
+        &thread,
+        vec![wire_task("live", "running", 10_000, Some((500, 4)))],
+        &mut panels.cx,
+    );
+    let row = find_row(&mut panels, &session, "live").expect("the running task is listed");
+    assert_eq!(row.entry.record.status, AgentTaskStatus::Running);
+    assert_eq!(row.entry.record.tokens, Some(500));
+    assert_eq!(row.entry.record.tool_uses, Some(4));
+    let group_title = groups(&mut panels)
+        .into_iter()
+        .find(|g| g.session_id.to_string() == session)
+        .map(|g| g.title.to_string());
+    assert_eq!(group_title.as_deref(), Some("Live thread"));
+
+    send_tasks(
+        &thread,
+        vec![wire_task("live", "running", 10_000, Some((800, 6)))],
+        &mut panels.cx,
+    );
+    let row = find_row(&mut panels, &session, "live").unwrap();
+    assert_eq!(
+        row.entry.record.tokens,
+        Some(800),
+        "live, not the stored start"
+    );
+
+    let stored = load(&db).await;
+    let stored = find(&stored, &session, "live").expect("the start was recorded");
+    assert_eq!(stored.record.status, AgentTaskStatus::Running);
+    assert_eq!(stored.record.tokens, None, "progress is not written (R1.4)");
+
+    set_filters(&mut panels, &[TaskFilter::Finished]);
+    assert!(
+        find_row(&mut panels, &session, "live").is_none(),
+        "Active off hides it"
+    );
+    set_filters(&mut panels, &[TaskFilter::Active]);
+    assert!(find_row(&mut panels, &session, "live").is_some());
+}
+
+// R4.3 — the domain fails to open: Zeo starts, the panel says why, live rows still show.
+#[gpui::test]
+async fn panel_list_unavailable_history_shows_a_message_and_still_lists_live_rows(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    drop_history_table(&db).await;
+    let mut panels = open_panels(cx).await;
+
+    let message = panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.status_message(cx))
+        .expect("an unavailable history is announced in the panel");
+    assert!(
+        message.contains("Task history is unavailable"),
+        "got {message:?}"
+    );
+
+    let thread = open_live_thread(&mut panels, "Live thread");
+    let session = session_of(&thread, &panels.cx).to_string();
+    send_tasks(
+        &thread,
+        vec![wire_task("live", "running", 10_000, None)],
+        &mut panels.cx,
+    );
+    assert!(
+        find_row(&mut panels, &session, "live").is_some(),
+        "the card's live rows are still listed"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/multi_window_tests.rs b/crates/agent_tasks_panel/src/panel/multi_window_tests.rs
