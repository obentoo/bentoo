+//! `AgentTasksPanel`: the dock panel that lists the agent task history (R2).
+//!
+//! Records come from the global `TaskHistoryStore`, grouped by thread and filtered by
+//! outcome. The panel lists every task of every window, so a running row reads its progress
+//! from whichever registered `TasksCard` holds it (R2.3) — never from the store, which never
+//! writes progress (R1.4).
+//!
+//! The dock the panel sits in is saved in the key-value store under the panel's key: the
+//! workspace saves each panel's size, but a panel's dock only through that panel's settings,
+//! and this panel has none.
+
+use std::{cmp::Reverse, ops::Range, sync::Arc};
+
+use acp_thread::{AgentTask, AgentTaskId, AgentTaskStatus};
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_ui::{
+    AgentPanel, DEFAULT_THREAD_TITLE, TaskRecord, TasksCard,
+    thread_metadata_store::ThreadMetadataStore,
+};
+use anyhow::{Result, anyhow};
+use collections::HashMap;
+use db::kvp::KeyValueStore;
+use gpui::{
+    Action, AnyElement, App, AsyncWindowContext, Context, ElementId, Entity, EventEmitter,
+    FocusHandle, Focusable, IntoElement, Pixels, Render, SharedString, Subscription, Task,
+    UniformListScrollHandle, WeakEntity, Window, actions, px, uniform_list,
+};
+use settings::SettingsStore;
+use ui::{Banner, ButtonLike, ButtonStyle, Severity, TintColor, Tooltip, prelude::*};
+use workspace::{
+    Workspace,
+    dock::{DockPosition, Panel, PanelEvent},
+};
+
+use crate::{Availability, HistoryEntry, TaskHistoryStore, TaskKey};
+
+actions!(
+    agent_tasks_panel,
+    [
+        /// Toggles focus on the Agent Tasks panel.
+        ToggleFocus
+    ]
+);
+
+/// Registers the panel's `ToggleFocus` on every workspace created from now on.
+pub(crate) fn register_actions(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _window, _cx| {
+        workspace.register_action(|workspace, _: &ToggleFocus, window, cx| {
+            workspace.toggle_panel_focus::<AgentTasksPanel>(window, cx);
+        });
+    })
+    .detach();
+}
+
+/// One of the panel's list filters (R2.4). Each is a toggle; a row shows when the filter it
+/// falls under is on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum TaskFilter {
+    /// Running tasks.
+    Active,
+    /// Completed, stopped or interrupted tasks.
+    Finished,
+    /// Failed tasks.
+    Failed,
+    /// Archived tasks, whatever their outcome — and only them.
+    Archived,
+}
+
+impl TaskFilter {
+    pub const ALL: [TaskFilter; 4] = [
+        TaskFilter::Active,
+        TaskFilter::Finished,
+        TaskFilter::Failed,
+        TaskFilter::Archived,
+    ];
+
+    fn label(self) -> &'static str {
+        match self {
+            TaskFilter::Active => "Active",
+            TaskFilter::Finished => "Finished",
+            TaskFilter::Failed => "Failed",
+            TaskFilter::Archived => "Archived",
+        }
+    }
+
+    fn tooltip(self, enabled: bool) -> &'static str {
+        match (self, enabled) {
+            (TaskFilter::Active, false) => "Show Running Tasks",
+            (TaskFilter::Active, true) => "Hide Running Tasks",
+            (TaskFilter::Finished, false) => "Show Completed, Stopped and Interrupted Tasks",
+            (TaskFilter::Finished, true) => "Hide Completed, Stopped and Interrupted Tasks",
+            (TaskFilter::Failed, false) => "Show Failed Tasks",
+            (TaskFilter::Failed, true) => "Hide Failed Tasks",
+            (TaskFilter::Archived, false) => "Show Archived Tasks",
+            (TaskFilter::Archived, true) => "Hide Archived Tasks",
+        }
+    }
+}
+
+/// Which filters are on. Active and Finished by default (R2.4).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct TaskFilters {
+    active: bool,
+    finished: bool,
+    failed: bool,
+    archived: bool,
+}
+
+impl Default for TaskFilters {
+    fn default() -> Self {
+        Self {
+            active: true,
+            finished: true,
+            failed: false,
+            archived: false,
+        }
+    }
+}
+
+impl TaskFilters {
+    fn is_enabled(&self, filter: TaskFilter) -> bool {
+        match filter {
+            TaskFilter::Active => self.active,
+            TaskFilter::Finished => self.finished,
+            TaskFilter::Failed => self.failed,
+            TaskFilter::Archived => self.archived,
+        }
+    }
+
+    fn set(&mut self, filter: TaskFilter, enabled: bool) {
+        let flag = match filter {
+            TaskFilter::Active => &mut self.active,
+            TaskFilter::Finished => &mut self.finished,
+            TaskFilter::Failed => &mut self.failed,
+            TaskFilter::Archived => &mut self.archived,
+        };
+        *flag = enabled;
+    }
+
+    /// Whether `entry` is listed: an archived task only under Archived (R3.1), any other
+    /// under the filter its status falls under.
+    fn shows(&self, entry: &HistoryEntry) -> bool {
+        if entry.archived {
+            self.archived
+        } else {
+            self.is_enabled(status_filter(entry.record.status))
+        }
+    }
+}
+
+/// The filter an unarchived task falls under by its status.
+fn status_filter(status: AgentTaskStatus) -> TaskFilter {
+    match status {
+        AgentTaskStatus::Running => TaskFilter::Active,
+        AgentTaskStatus::Completed | AgentTaskStatus::Stopped | AgentTaskStatus::Interrupted => {
+            TaskFilter::Finished
+        }
+        AgentTaskStatus::Failed => TaskFilter::Failed,
+    }
+}
+
+/// One thread's visible rows.
+#[derive(Clone, Debug)]
+pub struct PanelGroup {
+    pub session_id: acp_v2::SessionId,
+    pub title: SharedString,
+    pub rows: Vec<PanelRow>,
+}
+
+/// One visible task.
+#[derive(Clone, Debug)]
+pub struct PanelRow {
+    /// The stored record, carrying the card's live values while the task runs (R2.3).
+    pub entry: HistoryEntry,
+    /// The task is running in a thread the card holds, so Stop can reach it.
+    pub can_stop: bool,
+    /// The task has ended and is not archived yet (R3.4).
+    pub can_archive: bool,
+    /// Why the last click on the row opened nothing (R2.7).
+    pub notice: Option<SharedString>,
+    /// The card's error for this row (a failed stop), if any.
+    pub error: Option<SharedString>,
+}
+
+/// One line of the list: a thread's header or one of its tasks. Both are one line high,
+/// because `uniform_list` measures the first item and lays every other out at its height.
+enum ListEntry {
+    Header {
+        session_id: acp_v2::SessionId,
+        title: SharedString,
+        task_count: usize,
+        /// A listed row of the group has ended unarchived, so archiving the group does
+        /// something (R3.2).
+        can_archive: bool,
+        archive_focus: FocusHandle,
+    },
+    Row(PanelRow, RowFocus),
+}
+
+/// The focus handles of one row's controls, kept across renders so keyboard focus stays on a
+/// control while the list repaints (Q14).
+#[derive(Clone)]
+struct RowFocus {
+    open: FocusHandle,
+    stop: FocusHandle,
+    /// Archive, or Unarchive on an archived row: the two share the row's last slot.
+    archive: FocusHandle,
+}
+
+impl RowFocus {
+    fn new(cx: &mut App) -> Self {
+        Self {
+            open: control_focus_handle(cx),
+            stop: control_focus_handle(cx),
+            archive: control_focus_handle(cx),
+        }
+    }
+}
+
+/// What the panel reads from the cards in one pass: each held thread's current title and each
+/// row's error.
+#[derive(Default)]
+struct CardSnapshot {
+    titles: HashMap<acp_v2::SessionId, SharedString>,
+    errors: HashMap<(acp_v2::SessionId, AgentTaskId), SharedString>,
+}
+
+impl CardSnapshot {
+    fn read(cards: &[Entity<TasksCard>], cx: &App) -> Self {
+        let mut snapshot = Self::default();
+        for group in cards.iter().flat_map(|card| card.read(cx).rows(cx)) {
+            for row in group.rows {
+                if let Some(error) = row.error {
+                    snapshot
+                        .errors
+                        .insert((group.session_id.clone(), row.task.id), error);
+                }
+            }
+            snapshot.titles.insert(group.session_id, group.title);
+        }
+        snapshot
+    }
+}
+
+pub struct AgentTasksPanel {
+    focus_handle: FocusHandle,
+    position: DockPosition,
+    /// The workspace whose agent panel a click opens threads in.
+    workspace: WeakEntity<Workspace>,
+    store: Entity<TaskHistoryStore>,
+    filters: TaskFilters,
+    /// One per filter toggle, in `TaskFilter::ALL` order, kept across renders so keyboard
+    /// focus survives a repaint (Q14).
+    filter_focus_handles: [FocusHandle; 4],
+    /// Per listed row and per listed group; entries of rows and groups no longer listed are
+    /// dropped on render.
+    row_focus_handles: HashMap<TaskKey, RowFocus>,
+    group_focus_handles: HashMap<acp_v2::SessionId, FocusHandle>,
+    /// A row's message after a click that opened nothing, until a later click opens it.
+    notices: HashMap<TaskKey, SharedString>,
+    scroll_handle: UniformListScrollHandle,
+    /// The lines of the last render, read by the `uniform_list` callback.
+    entries: Vec<ListEntry>,
+    /// The latest write of the dock position; a newer move replaces (and so cancels) it.
+    _save_position: Task<()>,
+    _subscriptions: Vec<Subscription>,
+}
+
+impl AgentTasksPanel {
+    /// Builds the panel for `workspace` in its saved dock and records the activity of its
+    /// agent panel's card with the global store — now when the agent panel is already there,
+    /// else as soon as the workspace adds one. It never waits for the agent panel: Zeo loads
+    /// both together, and with AI disabled there is none.
+    pub fn load(
+        workspace: WeakEntity<Workspace>,
+        cx: AsyncWindowContext,
+    ) -> Task<Result<Entity<Self>>> {
+        cx.spawn(async move |cx| {
+            let kvp = cx.update(|_, cx| KeyValueStore::global(cx))?;
+            let saved = cx
+                .background_spawn(async move { kvp.read_kvp(<Self as Panel>::panel_key()) })
+                .await;
+            let position = saved_position(saved);
+            workspace.update_in(cx, |workspace, window, cx| {
+                let store = TaskHistoryStore::try_global(cx).ok_or_else(|| {
+                    anyhow!("agent_tasks_panel::init must run before the Agent Tasks panel loads")
+                })?;
+                let agent_panel = workspace.panel::<AgentPanel>(cx);
+                let workspace_entity = cx.entity();
+                Ok(cx.new(|cx| {
+                    Self::new(store, position, &workspace_entity, agent_panel, window, cx)
+                }))
+            })?
+        })
+    }
+
+    fn new(
+        store: Entity<TaskHistoryStore>,
+        position: DockPosition,
+        workspace: &Entity<Workspace>,
+        agent_panel: Option<Entity<AgentPanel>>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let subscriptions = vec![
+            cx.observe(&store, |_, _, cx| cx.notify()),
+            // The agent panel loads alongside this one, and is torn down and rebuilt when AI
+            // is turned off and on again; each one brings a new card.
+            cx.subscribe_in(
+                workspace,
+                window,
+                |panel, _, event: &workspace::Event, _window, cx| {
+                    if let workspace::Event::PanelAdded(view) = event
+                        && let Ok(agent_panel) = view.clone().downcast::<AgentPanel>()
+                    {
+                        panel.attach_card(&agent_panel, cx);
+                    }
+                },
+            ),
+        ];
+        let mut panel = Self {
+            focus_handle: cx.focus_handle(),
+            position,
+            workspace: workspace.downgrade(),
+            store,
+            filters: TaskFilters::default(),
+            filter_focus_handles: std::array::from_fn(|_| control_focus_handle(cx)),
+            row_focus_handles: HashMap::default(),
+            group_focus_handles: HashMap::default(),
+            notices: HashMap::default(),
+            scroll_handle: UniformListScrollHandle::new(),
+            entries: Vec::new(),
+            _save_position: Task::ready(()),
+            _subscriptions: subscriptions,
+        };
+        if let Some(agent_panel) = agent_panel {
+            panel.attach_card(&agent_panel, cx);
+        }
+        panel
+    }
+
+    /// Registers `agent_panel`'s card with the store. The store notifies on every registered
+    /// card's change, which is what repaints a running row in any window.
+    fn attach_card(&mut self, agent_panel: &Entity<AgentPanel>, cx: &mut Context<Self>) {
+        let card = agent_panel.read(cx).tasks_card().clone();
+        self.store
+            .update(cx, |store, cx| store.register_card(&card, cx));
+    }
+
+    /// The visible rows (after filters), grouped by thread: groups ordered by their newest
+    /// task, rows newest first (R2.2).
+    pub fn groups(&self, cx: &App) -> Vec<PanelGroup> {
+        let store = self.store.read(cx);
+        let cards: Vec<Entity<TasksCard>> = store.cards().collect();
+        let snapshot = CardSnapshot::read(&cards, cx);
+
+        let mut rows: Vec<PanelRow> = store
+            .records()
+            .iter()
+            .filter(|entry| self.filters.shows(entry))
+            .map(|entry| {
+                let key = (
+                    entry.record.session_id.clone(),
+                    entry.record.task_id.clone(),
+                );
+                let live = entry
+                    .record
+                    .status
+                    .is_running()
+                    .then(|| store.live_task(&key.0, &key.1, cx))
+                    .flatten()
+                    .map(|(_card, task)| task);
+                let notice = self.notices.get(&key).cloned();
+                panel_row(entry, live, notice, snapshot.errors.get(&key).cloned())
+            })
+            .collect();
+        rows.sort_by(|a, b| newest_first(&a.entry, &b.entry));
+        group_rows(rows, &snapshot.titles)
+    }
+
+    pub fn is_filter_enabled(&self, filter: TaskFilter) -> bool {
+        self.filters.is_enabled(filter)
+    }
+
+    pub fn set_filter(&mut self, filter: TaskFilter, enabled: bool, cx: &mut Context<Self>) {
+        if self.filters.is_enabled(filter) == enabled {
+            return;
+        }
+        self.filters.set(filter, enabled);
+        cx.notify();
+    }
+
+    /// Opens the thread of `key`'s task in this workspace's agent panel (R2.5) — which brings
+    /// forward a conversation it already holds rather than loading a second one. A thread
+    /// that no longer exists opens nothing: the row says so instead (R2.7), since the agent
+    /// panel would otherwise start an empty thread under the stale session id.
+    pub fn open_task(&mut self, key: &TaskKey, window: &mut Window, cx: &mut Context<Self>) {
+        let (session_id, task_id) = key;
+        let thread_exists = ThreadMetadataStore::try_global(cx)
+            .is_some_and(|store| store.read(cx).entry_by_session(session_id).is_some());
+        if !thread_exists {
+            log::info!(
+                "agent tasks panel: not opening task {task_id} of session {session_id}: \
+                 its thread no longer exists"
+            );
+            self.set_notice(key, "Thread no longer exists", cx);
+            return;
+        }
+        let opened = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                let agent_panel = workspace.focus_panel::<AgentPanel>(window, cx)?;
+                agent_panel.update(cx, |agent_panel, cx| {
+                    agent_panel.open_thread_by_session(session_id.clone(), window, cx)
+                });
+                Some(())
+            })
+            .ok()
+            .flatten();
+        if opened.is_none() {
+            log::error!(
+                "agent tasks panel: cannot open task {task_id} of session {session_id}: \
+                 this workspace has no agent panel"
+            );
+            self.set_notice(key, "The agent panel is not available", cx);
+            return;
+        }
+        if self.notices.remove(key).is_some() {
+            cx.notify();
+        }
+    }
+
+    /// Stops `key`'s running task through the card that holds it live, so the panel's Stop
+    /// is the card's: the same confirmation, and an error kept on the card's row, which the
+    /// panel reads back (R2.6).
+    pub fn request_stop(&mut self, key: &TaskKey, window: &mut Window, cx: &mut Context<Self>) {
+        let (session_id, task_id) = key;
+        let Some((card, _task)) = self.store.read(cx).live_task(session_id, task_id, cx) else {
+            log::debug!(
+                "agent tasks panel: stop requested for task {task_id} of session {session_id}, \
+                 which no card holds running"
+            );
+            return;
+        };
+        card.update(cx, |card, cx| {
+            card.request_stop(session_id.clone(), task_id.clone(), window, cx)
+        });
+    }
+
+    /// Archives `key`'s task (R3.1). A running task is never archived (R3.4).
+    pub fn archive(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        let (session_id, task_id) = key;
+        let store = self.store.read(cx);
+        let finished = store.records().iter().any(|entry| {
+            entry.record.session_id == *session_id
+                && entry.record.task_id == *task_id
+                && !entry.record.status.is_running()
+        });
+        if !finished {
+            log::debug!(
+                "agent tasks panel: not archiving task {task_id} of session {session_id}: \
+                 it is running or not recorded"
+            );
+            return;
+        }
+        self.store
+            .update(cx, |store, cx| store.archive(std::slice::from_ref(key), cx));
+    }
+
+    /// Returns `key`'s task to the filters it matched before it was archived (R3.3).
+    pub fn unarchive(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        self.store.update(cx, |store, cx| {
+            store.unarchive(std::slice::from_ref(key), cx)
+        });
+    }
+
+    /// Archives every finished task of `session_id`'s thread; its running tasks stay (R3.2).
+    pub fn archive_group(&mut self, session_id: &acp_v2::SessionId, cx: &mut Context<Self>) {
+        self.store
+            .update(cx, |store, cx| store.archive_group(session_id, cx));
+    }
+
+    fn set_notice(&mut self, key: &TaskKey, notice: &'static str, cx: &mut Context<Self>) {
+        self.notices
+            .insert(key.clone(), SharedString::new_static(notice));
+        cx.notify();
+    }
+
+    /// The panel's message when the history cannot be kept this session (R4.3).
+    pub fn status_message(&self, cx: &App) -> Option<SharedString> {
+        match self.store.read(cx).availability() {
+            Availability::Available => None,
+            Availability::Unavailable(cause) => {
+                Some(format!("Task history is unavailable: {cause}").into())
+            }
+        }
+    }
+
+    fn render_filters(&self, cx: &mut Context<Self>) -> impl IntoElement {
+        h_flex()
+            .p_1()
+            .gap_1()
+            .flex_wrap()
+            .border_b_1()
+            .border_color(cx.theme().colors().border)
+            .children(
+                TaskFilter::ALL
+                    .into_iter()
+                    .zip(&self.filter_focus_handles)
+                    .map(|(filter, focus_handle)| {
+                        let enabled = self.filters.is_enabled(filter);
+                        Button::new(
+                            SharedString::from(format!("agent-tasks-filter-{}", filter.label())),
+                            filter.label(),
+                        )
+                        .label_size(LabelSize::Small)
+                        .style(ButtonStyle::Subtle)
+                        .selected_style(ButtonStyle::Tinted(TintColor::Accent))
+                        .toggle_state(enabled)
+                        .tooltip(Tooltip::text(filter.tooltip(enabled)))
+                        .track_focus(focus_handle)
+                        .on_click(cx.listener(move |panel, _, _, cx| {
+                            panel.set_filter(filter, !enabled, cx);
+                        }))
+                    }),
+            )
+    }
+
+    fn render_entries(&self, range: Range<usize>, cx: &mut Context<Self>) -> Vec<AnyElement> {
+        range
+            .filter_map(|index| self.entries.get(index))
+            .map(|entry| match entry {
+                ListEntry::Header {
+                    session_id,
+                    title,
+                    task_count,
+                    can_archive,
+                    archive_focus,
+                } => render_header(
+                    session_id,
+                    title,
+                    *task_count,
+                    *can_archive,
+                    archive_focus,
+                    cx,
+                ),
+                ListEntry::Row(row, focus) => render_row(row, focus, cx),
+            })
+            .collect()
+    }
+
+    /// The list's lines for `groups`, each with the focus handles of its controls. Handles of
+    /// rows and groups no longer listed are dropped here, so the maps track what is shown.
+    fn list_entries(&mut self, groups: Vec<PanelGroup>, cx: &mut App) -> Vec<ListEntry> {
+        let mut row_focus_handles = HashMap::default();
+        let mut group_focus_handles = HashMap::default();
+        let mut entries = Vec::new();
+        for group in groups {
+            let archive_focus = self
+                .group_focus_handles
+                .remove(&group.session_id)
+                .unwrap_or_else(|| control_focus_handle(cx));
+            group_focus_handles.insert(group.session_id.clone(), archive_focus.clone());
+            entries.push(ListEntry::Header {
+                can_archive: group.rows.iter().any(|row| row.can_archive),
+                session_id: group.session_id,
+                title: group.title,
+                task_count: group.rows.len(),
+                archive_focus,
+            });
+            for row in group.rows {
+                let key = (
+                    row.entry.record.session_id.clone(),
+                    row.entry.record.task_id.clone(),
+                );
+                let focus = self
+                    .row_focus_handles
+                    .remove(&key)
+                    .unwrap_or_else(|| RowFocus::new(cx));
+                row_focus_handles.insert(key, focus.clone());
+                entries.push(ListEntry::Row(row, focus));
+            }
+        }
+        self.row_focus_handles = row_focus_handles;
+        self.group_focus_handles = group_focus_handles;
+        entries
+    }
+}
+
+/// A thread's header: its title, its task count, and — while one of its listed tasks has
+/// ended unarchived — the control that archives the group's finished tasks (R3.2).
+fn render_header(
+    session_id: &acp_v2::SessionId,
+    title: &SharedString,
+    task_count: usize,
+    can_archive: bool,
+    archive_focus: &FocusHandle,
+    cx: &mut Context<AgentTasksPanel>,
+) -> AnyElement {
+    let header_id = ElementId::NamedChild(
+        Arc::new(ElementId::Name("agent-tasks-group".into())),
+        session_id.to_string().into(),
+    );
+    let archive_button = can_archive.then(|| {
+        action_button(
+            ElementId::NamedChild(Arc::new(header_id.clone()), "archive".into()),
+            IconName::Archive,
+            format!("Archive the finished tasks of {title}"),
+            "Archive This Thread's Finished Tasks",
+            archive_focus,
+        )
+        .on_click(cx.listener({
+            let session_id = session_id.clone();
+            move |panel, _, _, cx| panel.archive_group(&session_id, cx)
+        }))
+    });
+    h_flex()
+        .id(header_id)
+        .h_7()
+        .px_2()
+        .gap_1()
+        .justify_between()
+        .child(
+            div().min_w_0().flex_1().child(
+                Label::new(title.clone())
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .truncate(),
+            ),
+        )
+        .child(
+            h_flex()
+                .flex_none()
+                .gap_1()
+                .child(
+                    Label::new(task_count.to_string())
+                        .size(LabelSize::XSmall)
+                        .color(Color::Muted),
+                )
+                .children(archive_button),
+        )
+        .into_any_element()
+}
+
+/// `row`'s line: its description and its progress or outcome — together the control that
+/// opens its thread (R2.5) — then Stop while it runs (R2.6), or Archive once it has ended
+/// (R3.1, R3.4), or Unarchive when archived (R3.3). Watched or expanded detail stays on the
+/// card, so every row keeps the one-line height `uniform_list` relies on.
+fn render_row(row: &PanelRow, focus: &RowFocus, cx: &mut Context<AgentTasksPanel>) -> AnyElement {
+    let record = &row.entry.record;
+    let key: TaskKey = (record.session_id.clone(), record.task_id.clone());
+    let row_id = row_element_id(&key.0, &key.1);
+    let control_id =
+        |control: &'static str| ElementId::NamedChild(Arc::new(row_id.clone()), control.into());
+    let (detail, detail_color) = match row.notice.as_ref().or(row.error.as_ref()) {
+        Some(message) => (message.clone(), Color::Error),
+        None => (row_detail(record).into(), status_color(record.status)),
+    };
+    let description = record.description.clone();
+
+    let open_button = ButtonLike::new(control_id("open"))
+        .full_width()
+        .child(
+            h_flex()
+                .w_full()
+                .min_w_0()
+                .gap_2()
+                .justify_between()
+                .child(
+                    div().min_w_0().flex_1().child(
+                        Label::new(description.clone())
+                            .size(LabelSize::Small)
+                            .truncate(),
+                    ),
+                )
+                // Shrinks and truncates too, so a long error cannot push the row past the
+                // panel.
+                .child(
+                    div().min_w_0().flex_shrink_1().child(
+                        Label::new(detail)
+                            .size(LabelSize::XSmall)
+                            .color(detail_color)
+                            .truncate(),
+                    ),
+                ),
+        )
+        .aria_label(format!("Open thread: {description}"))
+        .tooltip({
+            let description = description.clone();
+            move |_window, cx| Tooltip::with_meta(description.clone(), None, "Open Thread", cx)
+        })
+        .track_focus(&focus.open)
+        .on_click(cx.listener({
+            let key = key.clone();
+            move |panel, _, window, cx| panel.open_task(&key, window, cx)
+        }));
+
+    let stop_button = row.can_stop.then(|| {
+        action_button(
+            control_id("stop"),
+            IconName::Stop,
+            format!("Stop: {description}"),
+            "Stop This Task",
+            &focus.stop,
+        )
+        .on_click(cx.listener({
+            let key = key.clone();
+            move |panel, _, window, cx| panel.request_stop(&key, window, cx)
+        }))
+    });
+    let archive_button = if row.entry.archived {
+        Some(
+            action_button(
+                control_id("unarchive"),
+                IconName::Undo,
+                format!("Unarchive: {description}"),
+                "Unarchive This Task",
+                &focus.archive,
+            )
+            .on_click(cx.listener(move |panel, _, _, cx| panel.unarchive(&key, cx))),
+        )
+    } else {
+        row.can_archive.then(|| {
+            action_button(
+                control_id("archive"),
+                IconName::Archive,
+                format!("Archive: {description}"),
+                "Archive This Task",
+                &focus.archive,
+            )
+            .on_click(cx.listener({
+                let key = key.clone();
+                move |panel, _, _, cx| panel.archive(&key, cx)
+            }))
+        })
+    };
+
+    h_flex()
+        .id(row_id)
+        .h_7()
+        .pl_2()
+        .pr_2()
+        .gap_1()
+        .child(div().min_w_0().flex_1().child(open_button))
+        .children(stop_button)
+        .children(archive_button)
+        .into_any_element()
+}
+
+/// A row or header action: a small muted icon with its tooltip, its screen-reader label and
+/// its keyboard focus.
+fn action_button(
+    id: ElementId,
+    icon: IconName,
+    aria_label: String,
+    tooltip: &'static str,
+    focus_handle: &FocusHandle,
+) -> IconButton {
+    IconButton::new(id, icon)
+        .icon_size(IconSize::Small)
+        .icon_color(Color::Muted)
+        .aria_label(aria_label)
+        .tooltip(Tooltip::text(tooltip))
+        .track_focus(focus_handle)
+}
+
+/// A row's element id, keyed by its task rather than its place in the list, so a row's hover
+/// and click state stay with it when rows above it come and go. Nested children keep the pair
+/// unambiguous where a joined string would not be (`a-b` + `c` against `a` + `b-c`).
+fn row_element_id(session_id: &acp_v2::SessionId, task_id: &AgentTaskId) -> ElementId {
+    let session = ElementId::NamedChild(
+        Arc::new(ElementId::Name("agent-tasks-row".into())),
+        session_id.to_string().into(),
+    );
+    ElementId::NamedChild(Arc::new(session), task_id.clone())
+}
+
+/// The dock a saved value names; Left — the default — when nothing usable was saved.
+fn saved_position(saved: Result<Option<String>>) -> DockPosition {
+    match saved {
+        Ok(None) => DockPosition::Left,
+        Ok(Some(text)) => parse_dock_position(&text).unwrap_or_else(|| {
+            log::warn!("agent tasks panel: unknown saved dock position {text:?}; docking left");
+            DockPosition::Left
+        }),
+        Err(error) => {
+            log::error!(
+                "agent tasks panel: reading the saved dock position failed; docking left: \
+                 {error:#}"
+            );
+            DockPosition::Left
+        }
+    }
+}
+
+fn dock_position_text(position: DockPosition) -> &'static str {
+    match position {
+        DockPosition::Left => "left",
+        DockPosition::Right => "right",
+        DockPosition::Bottom => "bottom",
+    }
+}
+
+fn parse_dock_position(text: &str) -> Option<DockPosition> {
+    match text {
+        "left" => Some(DockPosition::Left),
+        "right" => Some(DockPosition::Right),
+        "bottom" => Some(DockPosition::Bottom),
+        _ => None,
+    }
+}
+
+/// `Running · 500 tokens · 4 tool uses`, or the outcome alone when no usage was reported.
+fn row_detail(record: &TaskRecord) -> String {
+    let mut parts = vec![status_label(record.status).to_string()];
+    if let Some(tokens) = record.tokens {
+        parts.push(format!("{tokens} tokens"));
+    }
+    if let Some(tool_uses) = record.tool_uses {
+        parts.push(match tool_uses {
+            1 => "1 tool use".to_string(),
+            count => format!("{count} tool uses"),
+        });
+    }
+    parts.join(" · ")
+}
+
+fn status_label(status: AgentTaskStatus) -> &'static str {
+    match status {
+        AgentTaskStatus::Running => "Running",
+        AgentTaskStatus::Completed => "Completed",
+        AgentTaskStatus::Failed => "Failed",
+        AgentTaskStatus::Stopped => "Stopped",
+        AgentTaskStatus::Interrupted => "Interrupted",
+    }
+}
+
+fn status_color(status: AgentTaskStatus) -> Color {
+    match status {
+        AgentTaskStatus::Running => Color::Muted,
+        AgentTaskStatus::Completed => Color::Success,
+        AgentTaskStatus::Failed => Color::Error,
+        AgentTaskStatus::Stopped | AgentTaskStatus::Interrupted => Color::Warning,
+    }
+}
+
+/// A row for `entry`, with `live` — the card's view of the task while it runs — laid over
+/// the stored record, which holds no progress.
+fn panel_row(
+    entry: &HistoryEntry,
+    live: Option<AgentTask>,
+    notice: Option<SharedString>,
+    error: Option<SharedString>,
+) -> PanelRow {
+    let mut entry = entry.clone();
+    let can_stop = live.is_some();
+    if let Some(task) = live {
+        let record = &mut entry.record;
+        record.status = task.status;
+        record.description = task.description;
+        record.tokens = task.usage.as_ref().map(|usage| usage.tokens);
+        record.tool_uses = task.usage.as_ref().map(|usage| usage.tool_uses);
+    }
+    PanelRow {
+        can_stop,
+        can_archive: !entry.archived && !entry.record.status.is_running(),
+        notice,
+        error,
+        entry,
+    }
+}
+
+/// Newest task first; session and task id break ties, so equal start times list the same
+/// way on every render.
+fn newest_first(a: &HistoryEntry, b: &HistoryEntry) -> std::cmp::Ordering {
+    let key = |entry: &HistoryEntry| {
+        (
+            Reverse(entry.record.started_at_ms),
+            entry.record.session_id.0.clone(),
+            entry.record.task_id.clone(),
+        )
+    };
+    key(a).cmp(&key(b))
+}
+
+/// Groups rows already sorted newest first by session. Groups come out in the order of their
+/// first row — so by their newest task — and keep their rows' order. A group is titled by
+/// the card while the card holds its thread (the title may have changed since its tasks were
+/// recorded), else by its newest record that carries a title.
+fn group_rows(
+    rows: Vec<PanelRow>,
+    live_titles: &HashMap<acp_v2::SessionId, SharedString>,
+) -> Vec<PanelGroup> {
+    let mut groups: Vec<PanelGroup> = Vec::new();
+    let mut index_of: HashMap<acp_v2::SessionId, usize> = HashMap::default();
+    for row in rows {
+        let session_id = row.entry.record.session_id.clone();
+        let index = *index_of.entry(session_id.clone()).or_insert_with(|| {
+            groups.push(PanelGroup {
+                session_id,
+                title: SharedString::default(),
+                rows: Vec::new(),
+            });
+            groups.len() - 1
+        });
+        groups[index].rows.push(row);
+    }
+    for group in &mut groups {
+        group.title = live_titles
+            .get(&group.session_id)
+            .cloned()
+            .or_else(|| {
+                group
+                    .rows
+                    .iter()
+                    .find_map(|row| row.entry.record.thread_title.clone())
+            })
+            .unwrap_or_else(|| SharedString::new_static(DEFAULT_THREAD_TITLE));
+    }
+    groups
+}
+
+/// A focus handle for one control, reachable with Tab. GPUI ignores an element's own
+/// `tab_index` once the element is given a handle, so the handle carries it.
+fn control_focus_handle(cx: &mut App) -> FocusHandle {
+    cx.focus_handle().tab_stop(true).tab_index(0)
+}
