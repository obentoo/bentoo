+/// Settings, the isolated per-test app database, and the agent globals — everything before
+/// `agent_tasks_panel::init`, so a test can seed or sabotage the history domain first.
+pub(crate) fn init_base(cx: &mut TestAppContext) -> AgentTaskHistoryDb {
+    agent_ui::test_support::init_test(cx);
+    cx.update(|cx| {
+        // `agent_ui::test_support::init_test` leaves this out; agent_ui's own rig sets it.
+        agent_ui::thread_metadata_store::ThreadMetadataStore::init_global(cx);
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        AgentTaskHistoryDb::global(cx)
