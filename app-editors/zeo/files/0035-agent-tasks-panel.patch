+pub(crate) fn sid(session: &str) -> acp_v2::SessionId {
+    acp_v2::SessionId::new(session.to_string())
+}
+
+pub(crate) fn key(session: &str, task: &str) -> Key {
+    (sid(session), AgentTaskId::from(task.to_string()))
