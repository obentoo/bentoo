+pub(crate) fn key_of(entry: &HistoryEntry) -> (String, String) {
+    (
+        entry.record.session_id.to_string(),
+        entry.record.task_id.to_string(),
+    )
+}
+
+/// A task record as the card hands it over. Finished records carry an outcome.
+pub(crate) fn record(
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    started_ms: i64,
+) -> TaskRecord {
+    let ended = !matches!(status, AgentTaskStatus::Running);
+    TaskRecord {
+        session_id: sid(session),
+        task_id: AgentTaskId::from(task.to_string()),
+        thread_title: Some(SharedString::from(format!("Thread {session}"))),
+        project: "project".into(),
+        kind: "shell".into(),
+        description: SharedString::from(format!("Task {task}")),
+        background: false,
+        started_at_ms: started_ms,
+        ended_at_ms: ended.then_some(started_ms + 1_000),
+        status,
+        tokens: ended.then_some(100),
+        tool_uses: ended.then_some(3),
+    }
+}
+
+pub(crate) fn started(record: &TaskRecord) -> TaskActivity {
+    TaskActivity::Started(record.clone())
+}
+
+pub(crate) fn ended(record: &TaskRecord) -> TaskActivity {
+    TaskActivity::Ended(record.clone())
+}
+
+pub(crate) fn find<'a>(
+    entries: &'a [HistoryEntry],
+    session: &str,
+    task: &str,
+) -> Option<&'a HistoryEntry> {
+    entries.iter().find(|entry| {
+        entry.record.session_id.to_string() == session && entry.record.task_id.as_ref() == task
+    })
+}
