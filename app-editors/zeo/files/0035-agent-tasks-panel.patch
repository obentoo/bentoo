--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/multi_window_tests.rs
@@ -0,0 +1,240 @@
+// Story 014, task 4.1 review — the cards the panel reads (R2.3) and how it reaches them.
+// Module path: `panel::multi_window`.
+//
+// The panel lists every task of every window, so a running row reads its live values from
+// whichever registered card holds it; and the card is attached whenever the agent panel
+// appears, because Zeo loads the agent panel alongside this one rather than before it.
+
+use std::path::Path;
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::AgentPanel;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, PanelRow, TaskHistoryStore};
+
+/// A new window holding a workspace over `root`, without any panel.
+async fn open_window(
+    cx: &mut TestAppContext,
+    root: &str,
+) -> (Entity<Workspace>, VisualTestContext) {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    let cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    (workspace, cx)
+}
+
+fn add_agent_panel(
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<AgentPanel> {
+    let agent_panel = workspace.update_in(cx, |workspace, window, cx| {
+        let agent_panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(agent_panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        agent_panel
+    });
+    cx.run_until_parked();
+    agent_panel
+}
+
+async fn add_tasks_panel(
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<AgentTasksPanel> {
+    let weak = workspace.downgrade();
+    let loading = cx.update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    cx.run_until_parked();
+    let tasks_panel = loading.await.expect("the Agent Tasks panel loads");
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.add_panel(tasks_panel.clone(), window, cx);
+    });
+    cx.run_until_parked();
+    tasks_panel
+}
+
+fn row_of(
+    panel: &Entity<AgentTasksPanel>,
+    session: &str,
+    task: &str,
+    cx: &mut VisualTestContext,
+) -> Option<PanelRow> {
+    panel
+        .update(cx, |panel, cx| panel.groups(cx))
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .find(|row| {
+            row.entry.record.session_id.to_string() == session
+                && row.entry.record.task_id.as_ref() == task
+        })
+}
+
+fn card_count(cx: &mut VisualTestContext) -> usize {
+    cx.update(|_, cx| TaskHistoryStore::global(cx).read(cx).cards().count())
+}
+
+// R2.3 across windows: a task running in window B shows live in window A's panel, Stop is
+// offered there, and once B's card is released nothing reads it any more.
+#[gpui::test]
+async fn panel_reads_live_values_from_the_card_of_another_window(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let (workspace_b, mut cx_b) = open_window(cx, "/other").await;
+    let agent_panel_b = add_agent_panel(&workspace_b, &mut cx_b);
+    let tasks_panel_b = add_tasks_panel(&workspace_b, &mut cx_b).await;
+    assert_eq!(
+        card_count(&mut panels.cx),
+        2,
+        "one card per window is registered"
+    );
+
+    let thread_b = open_thread_on(&agent_panel_b, StopConnection::new(), "Thread B", &mut cx_b);
+    let session_b = session_of(&thread_b, &cx_b).to_string();
+    send_tasks(
+        &thread_b,
+        vec![wire_task("live", "running", 10_000, Some((700, 5)))],
+        &mut cx_b,
+    );
+    panels.cx.run_until_parked();
+
+    let row = find_row(&mut panels, &session_b, "live").expect("window A lists B's task");
+    assert_eq!(row.entry.record.status, AgentTaskStatus::Running);
+    assert_eq!(
+        row.entry.record.tokens,
+        Some(700),
+        "B's live tokens, read in A"
+    );
+    assert_eq!(row.entry.record.tool_uses, Some(5));
+    assert!(
+        row.can_stop,
+        "B's card holds the task live, so A offers Stop"
+    );
+
+    send_tasks(
+        &thread_b,
+        vec![wire_task("live", "running", 10_000, Some((900, 6)))],
+        &mut cx_b,
+    );
+    panels.cx.run_until_parked();
+    let row = find_row(&mut panels, &session_b, "live").unwrap();
+    assert_eq!(row.entry.record.tokens, Some(900), "A follows B's progress");
+
+    // Release B's card: close its window and drop every handle that keeps its panels alive.
+    let card_b = agent_panel_b.read_with(&cx_b, |panel, _| panel.tasks_card().downgrade());
+    drop((thread_b, agent_panel_b, tasks_panel_b, workspace_b));
+    cx_b.update(|window, _| window.remove_window());
+    cx_b.run_until_parked();
+    panels.cx.run_until_parked();
+    assert!(card_b.upgrade().is_none(), "B's card is released");
+    assert_eq!(
+        card_count(&mut panels.cx),
+        1,
+        "the released card left the store"
+    );
+
+    let row = find_row(&mut panels, &session_b, "live").expect("the record stays listed");
+    assert!(
+        !row.can_stop,
+        "no card holds the task any more: nothing to stop"
+    );
+    assert_eq!(
+        row.entry.record.tokens, None,
+        "no live value from a released card"
+    );
+}
+
+// Zeo loads the agent panel alongside this one, so the card usually arrives after `load`:
+// it is registered when the agent panel is added, and again when the agent panel is replaced.
+#[gpui::test]
+async fn panel_attaches_the_card_of_an_agent_panel_added_after_it(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let (workspace, mut cx) = open_window(cx, "/project").await;
+    let tasks_panel = add_tasks_panel(&workspace, &mut cx).await;
+    assert_eq!(card_count(&mut cx), 0, "no agent panel yet, so no card");
+
+    let agent_panel = add_agent_panel(&workspace, &mut cx);
+    assert_eq!(
+        card_count(&mut cx),
+        1,
+        "the late agent panel's card is registered"
+    );
+    let thread = open_thread_on(&agent_panel, StopConnection::new(), "Late thread", &mut cx);
+    let session = session_of(&thread, &cx).to_string();
+    send_tasks(
+        &thread,
+        vec![wire_task("late", "running", 10_000, Some((300, 2)))],
+        &mut cx,
+    );
+
+    let recorded = cx.update(|_, cx| {
+        TaskHistoryStore::global(cx)
+            .read(cx)
+            .records()
+            .iter()
+            .any(|entry| {
+                entry.record.session_id.to_string() == session
+                    && entry.record.task_id.as_ref() == "late"
+            })
+    });
+    assert!(
+        recorded,
+        "the store records the task the late card reported"
+    );
+    let row = row_of(&tasks_panel, &session, "late", &mut cx).expect("the task is listed");
+    assert_eq!(
+        row.entry.record.tokens,
+        Some(300),
+        "read live from the late card"
+    );
+    assert!(row.can_stop);
+
+    // Replace the agent panel, as turning AI off and on again does.
+    let old_card = agent_panel.read_with(&cx, |panel, _| panel.tasks_card().downgrade());
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.remove_panel(&agent_panel, window, cx);
+    });
+    drop((thread, agent_panel));
+    cx.run_until_parked();
+    let new_agent_panel = add_agent_panel(&workspace, &mut cx);
+    let new_card = new_agent_panel.read_with(&cx, |panel, _| panel.tasks_card().clone());
+    let registered = cx.update(|_, cx| {
+        TaskHistoryStore::global(cx)
+            .read(cx)
+            .cards()
+            .any(|card| card == new_card)
+    });
+    assert!(registered, "the replacing agent panel's card is registered");
+    assert!(
+        old_card.upgrade().is_none(),
+        "the replaced card is released"
+    );
+    assert_eq!(
+        card_count(&mut cx),
+        1,
+        "only the live card stays registered"
+    );
+
+    emit(
+        &new_card,
+        started(&record("replaced", "t1", AgentTaskStatus::Running, 20_000)),
+        &mut cx,
+    );
+    assert!(
+        row_of(&tasks_panel, "replaced", "t1", &mut cx).is_some(),
+        "activity on the new card reaches the store and the panel"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/persistence_tests.rs b/crates/agent_tasks_panel/src/panel/persistence_tests.rs
new file mode 100644
index 0000000..9e2149a
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/persistence_tests.rs
@@ -0,0 +1,82 @@
+// Story 014, task 4.1 review — the dock the panel sits in survives a reload (R2.1).
+// Module path: `panel::persistence`.
+
+use gpui::{Entity, VisualTestContext};
+use workspace::dock::{DockPosition, Panel};
+
+use crate::AgentTasksPanel;
+use crate::test_helpers::*;
+
+async fn reload(panels: &mut Panels) -> Entity<AgentTasksPanel> {
+    let weak = panels.workspace.downgrade();
+    let loading = panels
+        .cx
+        .update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    panels.cx.run_until_parked();
+    loading.await.expect("the Agent Tasks panel loads again")
+}
+
+fn position_of(panel: &Entity<AgentTasksPanel>, cx: &mut VisualTestContext) -> DockPosition {
+    panel.update_in(cx, |panel, window, cx| panel.position(window, cx))
+}
+
+fn move_to(panels: &mut Panels, position: DockPosition) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_position(position, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+#[gpui::test]
+async fn panel_dock_position_moves_the_panel_and_survives_a_reload(cx: &mut gpui::TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    assert_eq!(
+        position_of(&panels.tasks_panel, &mut panels.cx),
+        DockPosition::Left
+    );
+
+    move_to(&mut panels, DockPosition::Right);
+    let docked_right = panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        workspace
+            .right_dock()
+            .read(cx)
+            .panel::<AgentTasksPanel>()
+            .is_some()
+    });
+    assert!(
+        docked_right,
+        "the dock moves the panel when its position changes"
+    );
+
+    let reloaded = reload(&mut panels).await;
+    assert_eq!(
+        position_of(&reloaded, &mut panels.cx),
+        DockPosition::Right,
+        "a fresh load docks where the panel was left"
+    );
+
+    move_to(&mut panels, DockPosition::Bottom);
+    let reloaded = reload(&mut panels).await;
+    assert_eq!(position_of(&reloaded, &mut panels.cx), DockPosition::Bottom);
+}
+
+#[gpui::test]
+async fn panel_dock_position_falls_back_to_left_on_an_unknown_saved_value(
+    cx: &mut gpui::TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let kvp = panels.cx.update(|_, cx| db::kvp::KeyValueStore::global(cx));
+    kvp.write_kvp(
+        <AgentTasksPanel as Panel>::panel_key().to_string(),
+        "upside-down".to_string(),
+    )
+    .await
+    .unwrap();
+
+    let reloaded = reload(&mut panels).await;
+    assert_eq!(position_of(&reloaded, &mut panels.cx), DockPosition::Left);
+}
diff --git a/crates/agent_tasks_panel/src/store.rs b/crates/agent_tasks_panel/src/store.rs
new file mode 100644
index 0000000..bf29be0
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store.rs
@@ -0,0 +1,470 @@
+//! `TaskHistoryStore`: the agent task history in memory, and the single writer of its domain.
+//!
+//! The store is fed only by the `TasksCard`s registered with it (one per workspace's agent
+//! panel): their `TaskActivity` events, and their `ThreadTitleChanged` events, which move every
+//! record of a thread to its newest title. Every change updates memory first and then the
+//! database, so a failed write leaves this session's view intact (R1.6).
+//!
+//! Startup order matters (R1.5): no task outlives the agent process that ran it, so every row
+//! still `running` is swept to `interrupted` before anything else touches the domain. Activity
+//! heard while that sweep and the first load are in flight is held back and applied after
+//! them — otherwise a task started in the first frame would be swept, or overwritten by the
+//! load.
+
+use std::{cmp, sync::atomic::Ordering};
+
+use acp_thread::{AgentTask, AgentTaskId};
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_ui::{TaskActivity, TaskRecord, TasksCard, ThreadTitleChanged};
+use anyhow::Result;
+use collections::HashMap;
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{
+    App, AppContext as _, Context, Entity, EntityId, Global, SharedString, Subscription, Task,
+    WeakEntity,
+};
+
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+/// Whether the history domain can be read and written this session (R4.3).
+#[derive(Clone, Debug, PartialEq)]
+pub enum Availability {
+    Available,
+    /// The domain failed to open; carries the cause for the panel to show.
+    Unavailable(SharedString),
+}
+
+struct GlobalTaskHistoryStore(Entity<TaskHistoryStore>);
+
+impl Global for GlobalTaskHistoryStore {}
+
+pub struct TaskHistoryStore {
+    /// Every record, newest first (the order `load_all` returns).
+    records: Vec<HistoryEntry>,
+    availability: Availability,
+    /// `Some` until the startup sweep and load finish: what was heard meanwhile, in order.
+    pending: Option<Vec<Heard>>,
+    /// Every registered card — one per workspace's agent panel, across every window — so
+    /// registering a card twice records once, and live values are read from all of them.
+    cards: HashMap<EntityId, RegisteredCard>,
+    writes: mpsc::UnboundedSender<HistoryWrite>,
+    /// Runs the startup sweep and load, then every write in the order it was queued.
+    _writer: Task<()>,
+}
+
+/// A card the store listens to. Weak: the agent panel owns its card, and a released card
+/// leaves the map through `observe_release`.
+struct RegisteredCard {
+    card: WeakEntity<TasksCard>,
+    _activity: Subscription,
+    _titles: Subscription,
+    _changes: Subscription,
+}
+
+/// What a card tells the store, in the order the card told it.
+enum Heard {
+    Activity(TaskActivity),
+    Title(ThreadTitleChanged),
+}
+
+/// A task's key in the history: the pair, since a task id is unique only within its session.
+pub type TaskKey = (acp_v2::SessionId, AgentTaskId);
+
+/// A database write, queued so that writes reach the domain in the order activity arrived:
+/// an `update_ended` that overtook its `insert_started` would update nothing, and an archive
+/// that overtook the `insert_started` of its task would archive nothing.
+enum HistoryWrite {
+    Started(TaskRecord),
+    Ended(TaskRecord),
+    Archived { keys: Vec<TaskKey>, archived: bool },
+    Titled(ThreadTitleChanged),
+}
+
+impl HistoryWrite {
+    async fn run(self, db: &AgentTaskHistoryDb) {
+        let result = match &self {
+            Self::Started(record) => db.insert_started(record).await,
+            Self::Ended(record) => db.update_ended(record).await,
+            Self::Archived { keys, archived } => db.set_archived(keys, *archived).await,
+            Self::Titled(change) => {
+                db.update_thread_title(&change.session_id, &change.title)
+                    .await
+            }
+        };
+        if let Err(error) = result {
+            log::error!(
+                "agent task history: failed to record {}; kept in memory only: {error:#}",
+                self.describe(),
+            );
+        }
+    }
+
+    /// What the write records, naming every session and task id it touches.
+    fn describe(&self) -> String {
+        match self {
+            Self::Started(record) => format!(
+                "the start of task {} in session {}",
+                record.task_id, record.session_id
+            ),
+            Self::Ended(record) => format!(
+                "the end of task {} in session {}",
+                record.task_id, record.session_id
+            ),
+            Self::Archived { keys, archived } => {
+                let action = if *archived {
+                    "archiving"
+                } else {
+                    "unarchiving"
+                };
+                let tasks = keys
+                    .iter()
+                    .map(|(session_id, task_id)| format!("task {task_id} in session {session_id}"))
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                format!("the {action} of {tasks}")
+            }
+            Self::Titled(change) => format!("the new title of session {}", change.session_id),
+        }
+    }
+}
+
+impl TaskHistoryStore {
+    /// Creates the global store over the application database (the crate's `init`).
+    pub fn init(cx: &mut App) {
+        if cx.has_global::<GlobalTaskHistoryStore>() {
+            return;
+        }
+        let db = AgentTaskHistoryDb::global(cx);
+        let store = cx.new(|cx| Self::new(db, cx));
+        cx.set_global(GlobalTaskHistoryStore(store));
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalTaskHistoryStore>()
+            .map(|store| store.0.clone())
+    }
+
+    /// The global store. Panics when `init` has not run, like every GPUI global.
+    pub fn global(cx: &App) -> Entity<Self> {
+        cx.global::<GlobalTaskHistoryStore>().0.clone()
+    }
+
+    /// A store over `db`: sweeps running rows to `interrupted`, then loads every record.
+    ///
+    /// `static_connection!` never returns an open error: when the database file cannot be
+    /// opened, `db::open_db` falls back silently to an in-memory database and raises
+    /// `db::ALL_FILE_DB_FAILED`. That flag is what marks the history unavailable here —
+    /// `persistent()` is `false` for test and `ZED_STATELESS` databases too.
+    pub fn new(db: AgentTaskHistoryDb, cx: &mut Context<Self>) -> Self {
+        let on_fallback = db::ALL_FILE_DB_FAILED.load(Ordering::Acquire);
+        Self::with_fallback_flag(db, on_fallback, cx)
+    }
+
+    /// `new`, with the fallback signal passed in. The flag is process-wide, so tests inject it
+    /// here rather than raising it for every test running in parallel.
+    pub(crate) fn with_fallback_flag(
+        db: AgentTaskHistoryDb,
+        on_fallback: bool,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let (writes, mut queue) = mpsc::unbounded::<HistoryWrite>();
+        let writer = cx.spawn(async move |this, cx| {
+            let loaded = if on_fallback {
+                Err(SharedString::from(
+                    "Zeo could not open its database file and runs on an in-memory one, \
+                     so task history is not kept this session",
+                ))
+            } else {
+                startup(&db)
+                    .await
+                    .map_err(|error| format!("{error:#}").into())
+            };
+            if this
+                .update(cx, |store, cx| store.finish_loading(loaded, cx))
+                .is_err()
+            {
+                return;
+            }
+            while let Some(write) = queue.next().await {
+                write.run(&db).await;
+            }
+        });
+        Self {
+            records: Vec::new(),
+            availability: Availability::Available,
+            pending: Some(Vec::new()),
+            cards: HashMap::default(),
+            writes,
+            _writer: writer,
+        }
+    }
+
+    /// Records the activity of one workspace's `TasksCard`. A card already registered is left
+    /// as it is, so a second registration never records a task twice.
+    pub fn register_card(&mut self, card: &Entity<TasksCard>, cx: &mut Context<Self>) {
+        let card_id = card.entity_id();
+        if self.cards.contains_key(&card_id) {
+            return;
+        }
+        let activity = cx.subscribe(card, |store, _card, activity: &TaskActivity, cx| {
+            store.hear(Heard::Activity(activity.clone()), cx);
+        });
+        let titles = cx.subscribe(card, |store, _card, change: &ThreadTitleChanged, cx| {
+            store.hear(Heard::Title(change.clone()), cx);
+        });
+        // Progress changes no record, but the panels of every window show it live (R2.3), so
+        // they repaint on this store's notifications for any card's change.
+        let changes = cx.observe(card, |_, _, cx| cx.notify());
+        cx.observe_release(card, move |store, _card, cx| {
+            store.cards.remove(&card_id);
+            cx.notify();
+        })
+        .detach();
+        self.cards.insert(
+            card_id,
+            RegisteredCard {
+                card: card.downgrade(),
+                _activity: activity,
+                _titles: titles,
+                _changes: changes,
+            },
+        );
+        // The card announced the titles of the threads it already held before this
+        // registration; a stored row may still carry an older one.
+        let titles = card.read(cx).thread_titles(cx);
+        for change in titles {
+            self.hear(Heard::Title(change), cx);
+        }
+        cx.notify();
+    }
+
+    /// Every registered card still alive.
+    pub fn cards(&self) -> impl Iterator<Item = Entity<TasksCard>> + '_ {
+        self.cards
+            .values()
+            .filter_map(|registered| registered.card.upgrade())
+    }
+
+    /// The running task `(session_id, task_id)` as the card holding it reports it, with that
+    /// card — the one a Stop must go through. `None` when no registered card holds it live.
+    pub fn live_task(
+        &self,
+        session_id: &acp_v2::SessionId,
+        task_id: &AgentTaskId,
+        cx: &App,
+    ) -> Option<(Entity<TasksCard>, AgentTask)> {
+        self.cards().find_map(|card| {
+            let task = card.read(cx).live_task(session_id, task_id, cx)?;
+            Some((card, task))
+        })
+    }
+
+    /// Every record, archived or not, newest first.
+    pub fn records(&self) -> &[HistoryEntry] {
+        &self.records
+    }
+
+    pub fn availability(&self) -> &Availability {
+        &self.availability
+    }
+
+    /// Archives `keys` (R3.1): hidden from every filter but Archived, the record kept.
+    pub fn archive(&mut self, keys: &[TaskKey], cx: &mut Context<Self>) {
+        self.set_archived(keys.to_vec(), true, cx);
+    }
+
+    /// Returns `keys` to the filters they matched before (R3.3): only the flag changes.
+    pub fn unarchive(&mut self, keys: &[TaskKey], cx: &mut Context<Self>) {
+        self.set_archived(keys.to_vec(), false, cx);
+    }
+
+    /// Archives every finished task of `session_id`, leaving its running ones unarchived
+    /// (R3.2): a running task is never archived (R3.4).
+    pub fn archive_group(&mut self, session_id: &acp_v2::SessionId, cx: &mut Context<Self>) {
+        let keys = self
+            .records
+            .iter()
+            .filter(|entry| {
+                entry.record.session_id == *session_id && !entry.record.status.is_running()
+            })
+            .map(|entry| {
+                (
+                    entry.record.session_id.clone(),
+                    entry.record.task_id.clone(),
+                )
+            })
+            .collect();
+        self.set_archived(keys, true, cx);
+    }
+
+    fn finish_loading(
+        &mut self,
+        loaded: Result<Vec<HistoryEntry>, SharedString>,
+        cx: &mut Context<Self>,
+    ) {
+        match loaded {
+            Ok(records) => self.records = records,
+            Err(cause) => {
+                log::error!("agent task history is unavailable this session: {cause}");
+                self.availability = Availability::Unavailable(cause);
+            }
+        }
+        for heard in self.pending.take().unwrap_or_default() {
+            self.apply(heard);
+        }
+        cx.notify();
+    }
+
+    fn hear(&mut self, heard: Heard, cx: &mut Context<Self>) {
+        if let Some(pending) = self.pending.as_mut() {
+            pending.push(heard);
+            return;
+        }
+        self.apply(heard);
+        cx.notify();
+    }
+
+    fn apply(&mut self, heard: Heard) {
+        match heard {
+            Heard::Activity(TaskActivity::Started(record)) => self.record_started(record),
+            Heard::Activity(TaskActivity::Ended(record)) => self.record_ended(record),
+            Heard::Title(change) => self.record_title(change),
+        }
+    }
+
+    /// A task seen for the first time is recorded with whatever it carries — its outcome too,
+    /// when first seen ended (R1.1, R1.8). A key already recorded is left alone: a repeated
+    /// snapshot (R1.3), or a re-opened session replaying `Started`, never rewrites a record nor
+    /// brings an ended or interrupted task back to running.
+    fn record_started(&mut self, mut record: TaskRecord) {
+        if self.position(&record.session_id, &record.task_id).is_some() {
+            return;
+        }
+        if record.status.is_running() {
+            // A running task's usage is progress, which is never stored (R1.4): the first
+            // snapshot that lists a task may already report some, and the panel reads it live
+            // from the card while the task runs.
+            record.tokens = None;
+            record.tool_uses = None;
+        }
+        self.insert_entry(HistoryEntry {
+            record: record.clone(),
+            archived: false,
+        });
+        self.queue_write(HistoryWrite::Started(record));
+    }
+
+    /// Writes a task's outcome (R1.2). Repeated endings are accepted — a resumed task ends
+    /// again — and each overwrites the outcome, as `update_ended` does in the database.
+    fn record_ended(&mut self, record: TaskRecord) {
+        let Some(index) = self.position(&record.session_id, &record.task_id) else {
+            // `Started` always precedes `Ended`; should one ever be missing, the ending is
+            // still recorded, in one row carrying its outcome.
+            self.record_started(record);
+            return;
+        };
+        let stored = &mut self.records[index].record;
+        stored.status = record.status;
+        stored.ended_at_ms = record.ended_at_ms;
+        stored.tokens = record.tokens;
+        stored.tool_uses = record.tool_uses;
+        self.queue_write(HistoryWrite::Ended(record));
+    }
+
+    /// Moves every record of the session to its thread's newest title. Nothing is written when
+    /// every record already carries it: cards announce a title again whenever they hold its
+    /// thread again, and a session with no record yet has nothing to rename — its first
+    /// record will carry the title.
+    fn record_title(&mut self, change: ThreadTitleChanged) {
+        let mut renamed = false;
+        for entry in &mut self.records {
+            let record = &mut entry.record;
+            if record.session_id == change.session_id
+                && record.thread_title.as_ref() != Some(&change.title)
+            {
+                record.thread_title = Some(change.title.clone());
+                renamed = true;
+            }
+        }
+        if renamed {
+            self.queue_write(HistoryWrite::Titled(change));
+        }
+    }
+
+    /// Sets the flag in memory, then queues one write for the whole batch. Memory keeps the
+    /// user's choice even when that write fails, so this session still shows it (R1.6).
+    fn set_archived(&mut self, keys: Vec<TaskKey>, archived: bool, cx: &mut Context<Self>) {
+        if keys.is_empty() {
+            return;
+        }
+        for (session_id, task_id) in &keys {
+            if let Some(index) = self.position(session_id, task_id) {
+                self.records[index].archived = archived;
+            }
+        }
+        self.queue_write(HistoryWrite::Archived { keys, archived });
+        cx.notify();
+    }
+
+    fn position(&self, session_id: &acp_v2::SessionId, task_id: &AgentTaskId) -> Option<usize> {
+        self.records.iter().position(|entry| {
+            entry.record.session_id == *session_id && entry.record.task_id == *task_id
+        })
+    }
+
+    /// Inserts keeping `load_all`'s order: newest first, then session and task id.
+    fn insert_entry(&mut self, entry: HistoryEntry) {
+        let index = self.records.partition_point(|existing| {
+            newest_first(&existing.record, &entry.record) == cmp::Ordering::Less
+        });
+        self.records.insert(index, entry);
+    }
+
+    /// Queues a write unless the domain is unavailable: there is then no database to keep the
+    /// record in (or only the in-memory fallback), and memory already holds it.
+    fn queue_write(&self, write: HistoryWrite) {
+        if matches!(self.availability, Availability::Unavailable(_)) {
+            return;
+        }
+        if let Err(error) = self.writes.unbounded_send(write) {
+            log::error!(
+                "agent task history: the writer has stopped; {} is kept in memory only",
+                error.into_inner().describe(),
+            );
+        }
+    }
+}
+
+/// The startup sweep (R1.5), then the first load.
+async fn startup(db: &AgentTaskHistoryDb) -> Result<Vec<HistoryEntry>> {
+    db.mark_running_interrupted().await?;
+    db.load_all().await
+}
+
+/// `load_all`'s order: `started_at DESC, session_id, task_id`.
+fn newest_first(a: &TaskRecord, b: &TaskRecord) -> cmp::Ordering {
+    b.started_at_ms
+        .cmp(&a.started_at_ms)
+        .then_with(|| a.session_id.0.cmp(&b.session_id.0))
+        .then_with(|| a.task_id.cmp(&b.task_id))
+}
+
