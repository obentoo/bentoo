+// R1.8: a task first seen already ended yields Started then Ended, in that order, for each
+// such task of the snapshot.
+#[gpui::test]
+async fn tasks_card_activity_first_seen_ended_emits_started_then_ended(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "Quick thread", &mut cx);
+    let card = card(&panel, &cx);
+    let (seen, _subscription) = watch(&card, &mut cx);
+
+    let mut quick = wire_task("quick", "completed", false, 1_000);
+    quick["usage"] = json!({ "tokens": 50, "toolUses": 1, "durationMs": 1_000 });
+    send_tasks(
+        &thread,
+        vec![quick, wire_task("broken", "failed", false, 1_100)],
+        &mut cx,
+    );
+
+    let events = seen.borrow().clone();
+    assert_eq!(
+        events.len(),
+        4,
+        "a Started and an Ended per task: {events:?}"
+    );
+    assert_started_before_ended(&events);
+    let ended = ends(&seen);
+    let quick = ended.iter().find(|r| r.task_id == "quick").unwrap();
+    assert_eq!(quick.status, AgentTaskStatus::Completed);
+    assert_eq!(quick.ended_at_ms, Some(2_000));
+    assert_eq!(quick.tokens, Some(50));
+    let broken = ended.iter().find(|r| r.task_id == "broken").unwrap();
+    assert_eq!(broken.status, AgentTaskStatus::Failed);
+
+    send_tasks(
+        &thread,
+        vec![wire_task("quick", "completed", false, 1_000)],
+        &mut cx,
+    );
+    assert_eq!(
+        seen.borrow().len(),
+        4,
+        "a repeated ended snapshot emits nothing"
+    );
+}
