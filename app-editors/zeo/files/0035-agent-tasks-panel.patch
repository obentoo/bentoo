+// Story 014, task 2.1 — the history domain and its first migration (R4.1, R4.2, Q12).
+// Module path: `history_db::migration` (see `src/test_helpers.rs` for the declarations).
+
+use db::sqlez::{connection::Connection, domain::Domain};
+
+use crate::AgentTaskHistoryDb;
+
+fn migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+fn names(connection: &Connection, kind: &str, name: &str) -> Vec<String> {
+    let query = format!("SELECT name FROM sqlite_master WHERE type = '{kind}' AND name = '{name}'");
+    connection
+        .select::<String>(&query)
+        .expect("sqlite_master query should prepare")()
+    .expect("sqlite_master query should run")
+}
+
+fn count_rows(connection: &Connection) -> Vec<i64> {
+    connection
+        .select::<i64>("SELECT COUNT(*) FROM agent_task_history")
+        .expect("count should prepare")()
+    .expect("count should run")
+}
+
+// R4.1 — a domain of its own: its own name, and no upstream domain it must migrate after.
+#[test]
+fn migration_domain_is_its_own_with_no_upstream_dependency() {
+    assert_eq!(AgentTaskHistoryDb::NAME, "AgentTaskHistoryDb");
+    assert!(
+        !AgentTaskHistoryDb::MIGRATIONS.is_empty(),
+        "the domain has at least its first migration"
+    );
+    let registered: Vec<&db::DomainMigration> = db::inventory::iter::<db::DomainMigration>
+        .into_iter()
+        .filter(|migration| migration.name == AgentTaskHistoryDb::NAME)
+        .collect();
+    assert_eq!(
+        registered.len(),
+        1,
+        "the domain is registered exactly once (static_connection!)"
+    );
+    assert!(
+        registered[0].dependencies.is_empty(),
+        "the history domain must not depend on any upstream domain, got {:?}",
+        registered[0].dependencies
+    );
+    assert!(
+        std::ptr::eq(registered[0].migrations, AgentTaskHistoryDb::MIGRATIONS),
+        "the registered list is the domain's own list"
+    );
+}
+
+// R4.2 — on an empty database the migration creates the table and its index.
+#[test]
+fn migration_creates_table_and_index_on_an_empty_database() {
+    let connection = Connection::open_memory(Some("agent_task_history_migration_empty"));
+    migrate_all(&connection);
+
+    assert_eq!(
+        names(&connection, "table", "agent_task_history"),
+        vec!["agent_task_history".to_string()]
+    );
+    assert_eq!(
+        names(&connection, "index", "agent_task_history_started"),
+        vec!["agent_task_history_started".to_string()]
+    );
+    assert_eq!(count_rows(&connection), vec![0]);
+}
+
+// The primary key is the pair: the same task id in two sessions is two rows, and the same
+// pair twice is refused by the table itself.
+#[test]
+fn migration_primary_key_is_session_and_task_pair() {
+    let connection = Connection::open_memory(Some("agent_task_history_migration_pk"));
+    migrate_all(&connection);
+
+    let insert = |session: &str, task: &str| {
+        let sql = format!(
+            "INSERT INTO agent_task_history \
+             (session_id, task_id, project, kind, description, background, status, started_at) \
+             VALUES ('{session}', '{task}', 'project', 'shell', 'Task', 0, 'running', 1000)"
+        );
+        connection.exec(&sql).and_then(|mut run| run())
+    };
+
+    insert("session-a", "task-1").expect("first row");
+    insert("session-b", "task-1").expect("same task id in another session is another row");
+    insert("session-a", "task-2").expect("another task id in the same session is another row");
+    assert!(
+        insert("session-a", "task-1").is_err(),
+        "the same (session_id, task_id) twice must violate the primary key"
+    );
+    assert_eq!(count_rows(&connection), vec![3]);
+}
+
+// R4.2 — a database written before this patch: other domains' tables and migration rows
+// already exist. The history migration adds its table and leaves the rest untouched.
+#[test]
+fn migration_on_a_pre_patch_database_adds_the_table_and_keeps_upstream_data() {
+    let connection = Connection::open_memory(Some("agent_task_history_migration_pre_patch"));
+    let upstream: &[&str] = &[
+        "CREATE TABLE upstream_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT;",
+        "ALTER TABLE upstream_items ADD COLUMN note TEXT;",
+    ];
+    connection
+        .migrate("UpstreamStandInDb", upstream, &mut |_, _, _| false)
+        .expect("stand-in upstream migrations");
+    connection
+        .exec("INSERT INTO upstream_items (id, name, note) VALUES (1, 'kept', 'n')")
+        .and_then(|mut run| run())
+        .expect("upstream row");
+
+    migrate_all(&connection);
+
+    assert_eq!(
+        names(&connection, "table", "agent_task_history"),
+        vec!["agent_task_history".to_string()]
+    );
+    let kept = connection
+        .select::<String>("SELECT name FROM upstream_items WHERE id = 1")
+        .expect("select")()
+    .expect("run");
+    assert_eq!(kept, vec!["kept".to_string()]);
+
+    // Upstream's list can grow afterwards without touching the history domain (positional
+    // migrations are per domain).
+    let upstream_grown: &[&str] = &[
+        upstream[0],
+        upstream[1],
+        "CREATE TABLE upstream_more(id INTEGER PRIMARY KEY) STRICT;",
+    ];
+    connection
+        .migrate("UpstreamStandInDb", upstream_grown, &mut |_, _, _| false)
+        .expect("a grown upstream list still applies");
+    migrate_all(&connection);
+}
+
+// Q12 — append-only: a database created by migration 1 opens with the current list, keeps its
+// rows, and re-running the whole list is a no-op rather than a "Migration changed" error.
+#[test]
+fn migration_opens_a_database_created_by_its_first_migration() {
+    let connection = Connection::open_memory(Some("agent_task_history_migration_first"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &AgentTaskHistoryDb::MIGRATIONS[..1],
+            &mut |_, _, _| false,
+        )
+        .expect("migration 1 alone should apply");
+    connection
+        .exec(
+            "INSERT INTO agent_task_history \
+             (session_id, task_id, thread_title, project, kind, description, background, \
+              status, started_at, ended_at, tokens, tool_uses) \
+             VALUES ('s-old', 't-old', 'Old thread', 'project', 'agent', 'Old task', 1, \
+                     'completed', 1000, 2000, 10, 2)",
+        )
+        .and_then(|mut run| run())
+        .expect("a row written by migration 1's schema");
+
+    migrate_all(&connection);
+    migrate_all(&connection);
+
+    let rows = connection
+        .select::<(String, String, String, i64)>(
+            "SELECT session_id, task_id, status, archived FROM agent_task_history",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows,
+        vec![(
+            "s-old".to_string(),
+            "t-old".to_string(),
+            "completed".to_string(),
+            0
+        )],
+        "the row from migration 1 survives, archived defaults to 0"
+    );
+}
