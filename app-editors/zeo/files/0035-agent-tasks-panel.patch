+// Story 014, task 6.1 fix — the card announces each held thread's title, so the task history
+// can move a thread's records to it (`ThreadTitleChanged`). Declared in `src/tasks_card.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/title_tests.rs"]
+//     mod title;
+//
+// so its path carries the filter `tasks_card::title`. No test here ends a task in a thread
+// out of view, so none reaches the tray.
+
+use std::{cell::RefCell, rc::Rc};
+
+use acp_thread::{AcpThread, AgentTaskStatus};
+use agent_client_protocol::schema::v1 as acp;
+use gpui::{Entity, SharedString, Subscription, TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+use super::{TaskActivity, TaskRecord, TasksCard, ThreadTitleChanged};
+use crate::AgentPanel;
+use crate::test_support::open_thread_with_custom_connection;
+
+const PROMPT: &str = "with the bash tool and run_in_background true, start one long sleep";
+const GENERATED: &str = "Background sleep command";
+
+fn watch_titles(
+    card: &Entity<TasksCard>,
+    cx: &mut VisualTestContext,
+) -> (Rc<RefCell<Vec<(String, String)>>>, Subscription) {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let sink = seen.clone();
+    let subscription = cx.update(|_, cx| {
+        cx.subscribe(card, move |_, change: &ThreadTitleChanged, _| {
+            sink.borrow_mut()
+                .push((change.session_id.to_string(), change.title.to_string()))
+        })
+    });
+    (seen, subscription)
+}
+
+fn watch_endings(
+    card: &Entity<TasksCard>,
+    cx: &mut VisualTestContext,
+) -> (Rc<RefCell<Vec<TaskRecord>>>, Subscription) {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let sink = seen.clone();
+    let subscription = cx.update(|_, cx| {
+        cx.subscribe(card, move |_, activity: &TaskActivity, _| {
+            if let TaskActivity::Ended(record) = activity {
+                sink.borrow_mut().push(record.clone());
+            }
+        })
+    });
+    (seen, subscription)
+}
+
+/// A new thread still without a title, as the panel holds it before the first prompt.
+fn open_untitled_thread(
+    panel: &Entity<AgentPanel>,
+    connection: &TaskActionsConnection,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    open_thread_with_custom_connection(panel, connection.clone(), cx);
+    cx.run_until_parked();
+    panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap())
+}
+
+fn set_provisional(thread: &Entity<AcpThread>, title: &str, cx: &mut VisualTestContext) {
+    let title = SharedString::from(title.to_string());
+    thread.update(cx, |thread, cx| thread.set_provisional_title(title, cx));
+    cx.run_until_parked();
+}
+
+fn set_title(thread: &Entity<AcpThread>, title: &str, cx: &mut VisualTestContext) {
+    send_info(thread, acp::SessionInfoUpdate::new().title(title), cx);
+}
+
+// Hostile (wrong collapse): the prompt and the generated title are two announcements.
+// Hostile (wrong split): an update that leaves the title as it was announces nothing.
+#[gpui::test]
+async fn tasks_card_title_announces_each_distinct_title_of_a_thread_once(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let card = card(&panel, &cx);
+    let (seen, _subscription) = watch_titles(&card, &mut cx);
+    let thread = open_untitled_thread(&panel, &connection, &mut cx);
+    let session = session_of(&thread, &cx).to_string();
+    assert!(
+        seen.borrow().is_empty(),
+        "a thread without a title announces nothing: {:?}",
+        seen.borrow()
+    );
+
+    set_provisional(&thread, PROMPT, &mut cx);
+    set_title(&thread, GENERATED, &mut cx);
+    // `TitleUpdated` again, the title unchanged: the generated one outranks the provisional.
+    set_provisional(&thread, "a later preview", &mut cx);
+    set_title(&thread, GENERATED, &mut cx);
+
+    assert_eq!(
+        *seen.borrow(),
+        vec![
+            (session.clone(), PROMPT.to_string()),
+            (session, GENERATED.to_string()),
+        ]
+    );
+}
+
+// A thread the card starts holding already titled is announced at once, and listed by
+// `thread_titles` for a listener that registers later; a thread held again is announced
+// again, since what was stored for it may be older.
+#[gpui::test]
+async fn tasks_card_title_announces_a_thread_when_it_is_held(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let card = card(&panel, &cx);
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let a_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    let b_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    let (sa, sb) = (session_of(&a, &cx), session_of(&b, &cx));
+
+    let mut titles: Vec<(String, String)> = card.read_with(&cx, |card, cx| {
+        card.thread_titles(cx)
+            .into_iter()
+            .map(|change| (change.session_id.to_string(), change.title.to_string()))
+            .collect()
+    });
+    titles.sort();
+    assert_eq!(
+        titles,
+        vec![
+            (sa.to_string(), "A".to_string()),
+            (sb.to_string(), "B".to_string()),
+        ]
+    );
+
+    let (seen, _subscription) = watch_titles(&card, &mut cx);
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&b_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+    assert!(
+        seen.borrow().is_empty(),
+        "letting a thread go announces nothing: {:?}",
+        seen.borrow()
+    );
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&b_view, &a_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        *seen.borrow(),
+        vec![(sa.to_string(), "A".to_string())],
+        "only the thread held again is announced again"
+    );
+}
+
+// A task still running when its thread closes ends as interrupted under the thread's newest
+// title, not the one it was first recorded under. The title arrives after the last sync that
+// held the thread, so no later snapshot of its tasks refreshes the kept record.
+#[gpui::test]
+async fn tasks_card_title_reaches_the_interrupted_ending_of_a_closed_thread(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let card = card(&panel, &cx);
+    let thread = open_untitled_thread(&panel, &connection, &mut cx);
+    set_provisional(&thread, PROMPT, &mut cx);
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    let other = open_titled_thread(&panel, &connection, "Other", &mut cx);
+    let other_view = panel.read_with(&cx, |panel, _| {
+        panel.active_conversation_view().cloned().unwrap()
+    });
+    set_title(&thread, GENERATED, &mut cx);
+    let session = session_of(&thread, &cx);
+    assert_ne!(session, session_of(&other, &cx));
+
+    let (endings, _subscription) = watch_endings(&card, &mut cx);
+    card.update(&mut cx, |card, cx| {
+        card.sync_threads([&other_view].into_iter(), cx)
+    });
+    cx.run_until_parked();
+
+    let endings = endings.borrow().clone();
+    assert_eq!(endings.len(), 1, "{endings:?}");
+    assert_eq!(endings[0].session_id, session);
+    assert_eq!(endings[0].status, AgentTaskStatus::Interrupted);
+    assert_eq!(endings[0].thread_title.as_deref(), Some(GENERATED));
+}
