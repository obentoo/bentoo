+impl Render for AgentTasksPanel {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let groups = self.groups(cx);
+        self.entries = self.list_entries(groups, cx);
+        let entry_count = self.entries.len();
+
+        v_flex()
+            .key_context("AgentTasksPanel")
+            .track_focus(&self.focus_handle)
+            .size_full()
+            .bg(cx.theme().colors().panel_background)
+            .child(self.render_filters(cx))
+            .when_some(self.status_message(cx), |panel, message| {
+                panel.child(
+                    div().p_1().child(
+                        Banner::new()
+                            .severity(Severity::Warning)
+                            .wrap_content(true)
+                            .child(Label::new(message).size(LabelSize::Small)),
+                    ),
+                )
+            })
+            .map(|panel| {
+                if entry_count == 0 {
+                    panel.child(
+                        v_flex()
+                            .flex_1()
+                            .items_center()
+                            .justify_center()
+                            .p_4()
+                            .child(
+                                Label::new("No tasks match the selected filters")
+                                    .size(LabelSize::Small)
+                                    .color(Color::Muted),
+                            ),
+                    )
+                } else {
+                    panel.child(
+                        uniform_list(
+                            "agent-tasks-list",
+                            entry_count,
+                            cx.processor(|panel, range: Range<usize>, _window, cx| {
+                                panel.render_entries(range, cx)
+                            }),
+                        )
+                        .flex_1()
+                        .track_scroll(&self.scroll_handle),
+                    )
+                }
+            })
+    }
+}
