+// ── A connection that records stops (story 012's task action) ──────────────
+
+#[derive(Clone)]
+pub(crate) struct StopConnection {
+    stub: StubAgentConnection,
+    next_session: Arc<Mutex<usize>>,
+    pub stops: Arc<Mutex<Vec<(String, String)>>>,
+    pub stop_error: Arc<Mutex<Option<&'static str>>>,
+}
+
+impl StopConnection {
+    pub(crate) fn new() -> Self {
+        Self {
+            stub: StubAgentConnection::new(),
+            next_session: Arc::new(Mutex::new(0)),
+            stops: Arc::default(),
+            stop_error: Arc::default(),
+        }
+    }
+
+    pub(crate) fn stops(&self) -> Vec<(String, String)> {
+        self.stops.lock().unwrap().clone()
+    }
+}
+
+impl AgentConnection for StopConnection {
+    fn agent_id(&self) -> AgentId {
+        self.stub.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "agent-tasks-panel-test".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let session_id = {
+            let mut next = self.next_session.lock().unwrap();
+            *next += 1;
+            acp_v2::SessionId::new(format!("tasks-panel-session-{}", *next))
+        };
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(agent_client_protocol::schema::v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[agent_client_protocol::schema::v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: agent_client_protocol::schema::v2::AuthMethodId, _cx: &mut App) -> Task<Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: agent_client_protocol::schema::v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        Task::ready(Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) {}
+
+    fn stop_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<()>> {
+        self.stops
+            .lock()
+            .unwrap()
+            .push((session_id.to_string(), task_id.to_string()));
+        match *self.stop_error.lock().unwrap() {
+            None => Task::ready(Ok(())),
+            Some(message) => Task::ready(Err(anyhow!(message))),
+        }
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
