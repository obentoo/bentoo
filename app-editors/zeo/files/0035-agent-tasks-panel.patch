+pub(crate) fn session_of(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> acp_v2::SessionId {
+    thread.read_with(cx, |thread, _| thread.session_id().clone())
+}
+
+pub(crate) fn active_session(panels: &Panels) -> Option<acp_v2::SessionId> {
+    panels.agent_panel.read_with(&panels.cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().clone())
+    })
+}
+
+pub(crate) fn send_info(
+    thread: &Entity<AcpThread>,
+    update: acp::SessionInfoUpdate,
+    cx: &mut VisualTestContext,
+) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(acp::SessionUpdate::SessionInfoUpdate(update), cx)
+        })
+        .expect("session info update should apply");
+    cx.run_until_parked();
+}
