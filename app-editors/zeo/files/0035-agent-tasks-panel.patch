+
+// Q13: a batch that fails part-way leaves every row as it was.
+#[gpui::test]
+async fn history_db_set_archived_is_atomic_when_a_row_fails_mid_batch(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_archive_atomic").await;
+    for task in ["a", "boom", "c", "d"] {
+        db.insert_started(&record("s1", task, AgentTaskStatus::Running, 1_000))
+            .await
+            .unwrap();
+        db.update_ended(&record("s1", task, AgentTaskStatus::Completed, 1_000))
+            .await
+            .unwrap();
+    }
+    db.set_archived(&[key("s1", "d")], true).await.unwrap();
+
+    run_sql(
+        &db,
+        "CREATE TRIGGER fail_mid_batch BEFORE UPDATE ON agent_task_history \
+         WHEN NEW.task_id = 'boom' \
+         BEGIN SELECT RAISE(ABORT, 'forced mid-batch failure'); END;",
+    )
+    .await;
+
+    let batch = [
+        key("s1", "a"),
+        key("s1", "boom"),
+        key("s1", "c"),
+        key("s1", "d"),
+    ];
+    let result = db.set_archived(&batch, true).await;
+    assert!(
+        result.is_err(),
+        "the forced failure must surface as an error"
+    );
+    let rows = load(&db).await;
+    assert!(
+        !find(&rows, "s1", "a").unwrap().archived,
+        "row before the failure rolled back"
+    );
+    assert!(!find(&rows, "s1", "boom").unwrap().archived);
+    assert!(!find(&rows, "s1", "c").unwrap().archived);
+    assert!(
+        find(&rows, "s1", "d").unwrap().archived,
+        "the earlier state is intact"
+    );
+
+    let unarchive = [key("s1", "d"), key("s1", "boom")];
+    assert!(db.set_archived(&unarchive, false).await.is_err());
+    assert!(
+        find(&load(&db).await, "s1", "d").unwrap().archived,
+        "an unarchive batch is atomic too"
+    );
+
+    // Without the sabotage the same batch succeeds: the failure was the trigger, not the
+    // statement.
+    run_sql(&db, "DROP TRIGGER fail_mid_batch").await;
+    db.set_archived(&batch, true).await.unwrap();
+    assert!(load(&db).await.iter().all(|entry| entry.archived));
+}
+
+// Benign: archive hides nothing from storage, unarchive restores, every record is kept.
+#[gpui::test]
+async fn history_db_set_archived_round_trips_and_keeps_every_record(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_archive_round_trip").await;
+    for task in ["a", "b", "c"] {
+        db.insert_started(&record("s1", task, AgentTaskStatus::Running, 1_000))
+            .await
+            .unwrap();
+        db.update_ended(&record("s1", task, AgentTaskStatus::Completed, 1_000))
+            .await
+            .unwrap();
+    }
+    db.set_archived(&[key("s1", "a"), key("s1", "b")], true)
+        .await
+        .unwrap();
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 3, "archiving deletes nothing (R3.5)");
+    assert!(find(&rows, "s1", "a").unwrap().archived);
+    assert!(find(&rows, "s1", "b").unwrap().archived);
+    assert!(!find(&rows, "s1", "c").unwrap().archived);
+
+    db.set_archived(&[key("s1", "a")], false).await.unwrap();
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 3);
+    let a = find(&rows, "s1", "a").unwrap();
+    assert!(!a.archived);
+    assert_eq!(
+        a.record.status,
+        AgentTaskStatus::Completed,
+        "the outcome is unchanged"
+    );
+    assert!(find(&rows, "s1", "b").unwrap().archived);
+
+    let empty: [(agent_client_protocol::schema::v2::SessionId, AgentTaskId); 0] = [];
+    db.set_archived(&empty, true).await.unwrap();
+}
+
+// ── load_all ───────────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_load_all_returns_newest_first(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_load_order").await;
+    assert!(load(&db).await.is_empty(), "an empty domain loads as empty");
+    for (session, task, at) in [
+        ("s1", "old", 1_000),
+        ("s2", "newest", 3_000),
+        ("s1", "mid", 2_000),
+    ] {
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+    }
+    let order: Vec<String> = load(&db)
+        .await
+        .iter()
+        .map(|entry| entry.record.task_id.to_string())
+        .collect();
+    assert_eq!(order, vec!["newest", "mid", "old"]);
+}
