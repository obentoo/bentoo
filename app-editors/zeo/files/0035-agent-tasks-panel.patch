+/// Emits a `TaskActivity` on the real card, as the card itself does on a snapshot.
+pub(crate) fn emit(card: &Entity<TasksCard>, activity: TaskActivity, cx: &mut VisualTestContext) {
+    card.update(cx, |_, cx| cx.emit(activity));
+    cx.run_until_parked();
+}
+
+async fn open_agent_workspace(
+    cx: &mut TestAppContext,
+) -> (Entity<Workspace>, Entity<AgentPanel>, VisualTestContext) {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    let agent_panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let agent_panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(agent_panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        agent_panel
+    });
+    cx.run_until_parked();
+    (workspace, agent_panel, cx)
+}
+
+/// Runs the crate's real `init`, opens a workspace with the agent panel, then loads the
+/// Agent Tasks panel through `AgentTasksPanel::load` — the order Zeo starts in.
+pub(crate) async fn open_panels(cx: &mut TestAppContext) -> Panels {
+    cx.update(|cx| crate::init(cx));
+    let (workspace, agent_panel, mut cx) = open_agent_workspace(cx).await;
+    let weak = workspace.downgrade();
+    let loading = cx.update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    cx.run_until_parked();
+    let tasks_panel = loading.await.expect("the Agent Tasks panel loads");
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.add_panel(tasks_panel.clone(), window, cx);
+    });
+    cx.run_until_parked();
+    Panels {
+        workspace,
+        agent_panel,
+        tasks_panel,
+        cx,
+    }
+}
+
+/// Opens a thread in the agent panel on `connection`, sends one message so it is a real
+/// (persisted) thread, titles it, and returns it.
+pub(crate) fn open_thread_on<C>(
+    agent_panel: &Entity<AgentPanel>,
+    connection: C,
+    title: &str,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread>
+where
+    C: 'static + AgentConnection + Send + Clone,
+{
+    agent_ui::test_support::open_thread_with_custom_connection(agent_panel, connection, cx);
+    agent_ui::test_support::send_message(agent_panel, cx);
+    cx.run_until_parked();
+    let thread = agent_panel.read_with(cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .expect("a thread was just opened")
+    });
+    send_info(&thread, acp::SessionInfoUpdate::new().title(title), cx);
+    thread
+}
+
+pub(crate) fn open_live_thread(panels: &mut Panels, title: &str) -> Entity<AcpThread> {
+    open_thread_on(
+        &panels.agent_panel,
+        StopConnection::new(),
+        title,
+        &mut panels.cx,
+    )
+}
