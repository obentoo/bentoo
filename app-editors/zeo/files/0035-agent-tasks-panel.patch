@@ -0,0 +1,72 @@
+// Story 014, task 3.1 — R4.3's silent-fallback path (Q4). Module path: `store::fallback`.
+//
+// Task 2.1 found that `static_connection!` never returns an open error: when the database
+// file cannot be opened, `db::open_db` falls back to an in-memory database and raises the
+// process-wide `db::ALL_FILE_DB_FAILED`. Raising that flag here would turn every store test
+// running in parallel unavailable, so the signal is injected through
+// `TaskHistoryStore::with_fallback_flag`, the constructor `new` delegates to with the flag's
+// value. The panel's "history is unavailable" banner is task 4.1's (`panel::list`).
+
+use acp_thread::AgentTaskStatus;
+use gpui::AppContext as _;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, Availability, TaskHistoryStore};
+
+#[gpui::test]
+async fn store_on_the_fallback_database_is_unavailable_with_a_cause_and_an_error_log(
+    cx: &mut gpui::TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    // Stands in for the in-memory fallback; a row in it must neither be swept nor shown.
+    let db = AgentTaskHistoryDb::open_test_db("store_fallback").await;
+    db.insert_started(&record("s0", "old", AgentTaskStatus::Running, 500))
+        .await
+        .unwrap();
+    capture_logs();
+
+    let store = rig
+        .cx
+        .new(|cx| TaskHistoryStore::with_fallback_flag(db.clone(), true, cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+
+    let cause = store.read_with(&rig.cx, |store, _| match store.availability() {
+        Availability::Unavailable(cause) => Some(cause.clone()),
+        Availability::Available => None,
+    });
+    let cause = cause.expect("a store on the fallback database is Unavailable");
+    assert!(
+        !cause.is_empty(),
+        "the cause is carried for the panel to show"
+    );
+    let errors = error_lines();
+    assert!(
+        errors.iter().any(|line| line.contains(cause.as_ref())),
+        "the fallback is logged at error level with its cause: {errors:?}"
+    );
+    assert!(
+        store.read_with(&rig.cx, |store, _| store.records().is_empty()),
+        "nothing is loaded from the fallback"
+    );
+
+    emit(
+        &card,
+        started(&record("s1", "live", AgentTaskStatus::Running, 1_000)),
+        &mut rig.cx,
+    );
+    assert_eq!(
+        store.read_with(&rig.cx, |store, _| store.records().len()),
+        1,
+        "this session's tasks are still held in memory"
+    );
+    let stored = load(&db).await;
+    assert_eq!(stored.len(), 1, "nothing is written to the fallback");
+    assert_eq!(
+        find(&stored, "s0", "old").unwrap().record.status,
+        AgentTaskStatus::Running,
+        "the fallback is not swept"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/store/lifecycle_tests.rs b/crates/agent_tasks_panel/src/store/lifecycle_tests.rs
