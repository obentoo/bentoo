+// R1.8: a task first seen already ended is one record carrying its outcome.
+#[gpui::test]
+async fn history_db_insert_started_writes_the_end_fields_a_record_carries(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_insert_ended").await;
+    let mut first_seen_ended = record("s1", "quick", AgentTaskStatus::Failed, 1_000);
+    first_seen_ended.ended_at_ms = Some(1_250);
