+    /// Operator ask of 2026-11-23: every interruption the operator starts asks first, in a
+    /// modal, as skipping a question card does (`decline_elicitation`). `interrupt` runs only on
+    /// the confirming answer; a prompt already open makes this a no-op.
+    pub(crate) fn confirm_interruption(
+        &mut self,
+        message: &'static str,
+        detail: &'static str,
+        confirm_label: &'static str,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+        interrupt: impl FnOnce(&mut Self, &mut Context<Self>) + 'static,
+    ) {
+        if self.interrupt_confirmation_open {
+            return;
+        }
+        self.interrupt_confirmation_open = true;
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            message,
+            Some(detail),
+            &[confirm_label, "Keep Going"],
+            cx,
+        );
+        cx.spawn_in(window, async move |this, cx| {
+            // Index 0 confirms; `Err` is a prompt whose sender was dropped, which keeps going.
+            let confirmed = matches!(answer.await, Ok(0));
+            this.update(cx, |this, cx| {
+                this.interrupt_confirmation_open = false;
+                log::info!(
+                    "agent_ui event=interrupt_confirmation session_id={} message={message:?} \
+                     outcome={}",
+                    this.session_id,
+                    if confirmed { "confirmed" } else { "kept" }
+                );
+                if confirmed {
+                    interrupt(this, cx);
+                }
+            })
+            .log_err();
+        })
+        .detach();
+    }
+
+    /// Stop Generation from the operator -- the button, Escape in the composer, `menu::Cancel` --
+    /// asks first while a turn runs; with nothing running it does what it always did.
+    pub(crate) fn confirm_cancel_generation(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if self.thread.read(cx).status() != ThreadStatus::Generating {
+            self.cancel_generation(cx);
+            return;
+        }
+        self.confirm_interruption(
+            "Stop generation?",
+            "The agent stops this turn. What it already did stays.",
+            "Stop",
+            window,
+            cx,
+            |this, cx| this.cancel_generation(cx),
+        );
+    }
+
+    /// Stop Subagent from the operator, on the subagent's card or its title bar, asks first.
+    fn confirm_stop_subagent(
+        &mut self,
+        thread: Entity<AcpThread>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.confirm_interruption(
+            "Stop this subagent?",
+            "The subagent stops where it is. What it already did stays.",
+            "Stop Subagent",
+            window,
+            cx,
+            move |this, cx| {
+                telemetry::event!("Subagent Stopped");
+                this.cancel_thread(&thread, cx).detach();
+            },
+        );
+    }
+
     pub fn cancel_generation(&mut self, cx: &mut Context<Self>) {
         self.thread_retry_status.take();
         self.thread_error.take();
