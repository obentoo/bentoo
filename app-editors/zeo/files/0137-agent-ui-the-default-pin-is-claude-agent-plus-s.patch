+/// Zeo next §6.57 (ask 81): one size for the default pin, the check and the favourite star, which
+/// used to be 12, 16 and 14 px side by side.
+const MENU_ROW_MARKER_SIZE: IconSize = IconSize::Small;
+
+/// Zeo next §6.57 (ask 81): the end of a menu row -- the default pin, the check, and on hover the
+/// favourite star -- laid out once, so every menu that shows them spaces and sizes them alike. The
+/// hover slot replaces the resting one (`ListItem::end_slot_on_hover`), so it must repeat the pin
+/// and the check: one that held only the star clipped them away on hover.
+pub fn menu_row_markers(
+    pin_id: impl Into<ElementId>,
+    is_default: bool,
+    is_selected: bool,
+    star: Option<AnyElement>,
+) -> impl IntoElement {
+    let has_star = star.is_some();
+    h_flex()
+        .gap_1p5()
+        .map(|this| if has_star { this.pr_1p5() } else { this.pr_2() })
+        .when(is_default, |this| this.child(default_marker(pin_id)))
+        .when(is_selected, |this| {
+            this.child(
+                Icon::new(IconName::Check)
+                    .size(MENU_ROW_MARKER_SIZE)
+                    .color(Color::Accent),
+            )
+        })
+        .children(star)
+}
