+// Story 022, task 7.2 — the Agent Tasks panel docks at the bottom unless a known dock was saved
+// (R6.1, R6.2, R5.7). Module path: `panel::dock_default`. Hostile fixtures come before benign
+// ones: a saved dock must never be folded into the new default.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/dock_default_tests.rs"]
+//     mod dock_default;
+//
+// Contract assumed beyond design.md (adjust HERE when the implementation drifts):
+//   - `saved_position(Result<Option<String>>) -> DockPosition` is the panel module's pure
+//     reading of the stored value (private, reachable from this child module);
+//   - the stored texts are `left`, `right`, `bottom` under `Panel::panel_key()`;
+//   - a read error is logged at error level and carries its cause.
+//
+// Not covered: the log line for an unknown saved value — it is a warning, and the crate's log
+// capture exposes only error lines.
+
+use anyhow::anyhow;
+use gpui::{Entity, TestAppContext, VisualTestContext, px};
+use workspace::dock::{DockPosition, Panel};
+
+use super::saved_position;
+use crate::AgentTasksPanel;
+use crate::test_helpers::*;
+
+async fn reload(panels: &mut Panels) -> Entity<AgentTasksPanel> {
+    let weak = panels.workspace.downgrade();
+    let loading = panels
+        .cx
+        .update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    panels.cx.run_until_parked();
+    loading.await.expect("the Agent Tasks panel loads again")
+}
+
+fn position_of(panel: &Entity<AgentTasksPanel>, cx: &mut VisualTestContext) -> DockPosition {
+    panel.update_in(cx, |panel, window, cx| panel.position(window, cx))
+}
+
+async fn save(panels: &mut Panels, value: &str) {
+    let kvp = panels.cx.update(|_, cx| db::kvp::KeyValueStore::global(cx));
+    kvp.write_kvp(
+        <AgentTasksPanel as Panel>::panel_key().to_string(),
+        value.to_string(),
+    )
+    .await
+    .unwrap();
+}
+
+// R5.7 first (hostile: a saved dock must not collapse into the default), then R6.1 / R6.2.
+#[test]
+fn panel_dock_default_saved_position_honours_a_saved_dock_and_falls_back_to_the_bottom() {
+    assert_eq!(saved_position(Ok(Some("left".into()))), DockPosition::Left);
+    assert_eq!(
+        saved_position(Ok(Some("right".into()))),
+        DockPosition::Right
+    );
+    assert_eq!(
+        saved_position(Ok(Some("bottom".into()))),
+        DockPosition::Bottom
+    );
+
+    assert_eq!(
+        saved_position(Ok(None)),
+        DockPosition::Bottom,
+        "no saved value docks at the bottom"
+    );
+    for unknown in ["upside-down", "", "top"] {
+        assert_eq!(
+            saved_position(Ok(Some(unknown.into()))),
+            DockPosition::Bottom,
+            "a saved value naming no known dock ({unknown:?}) docks at the bottom"
+        );
+    }
+
+    capture_logs();
+    assert_eq!(
+        saved_position(Err(anyhow!("kvp table is locked"))),
+        DockPosition::Bottom,
+        "a read error docks at the bottom"
+    );
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("kvp table is locked")),
+        "the read error is logged with its cause: {errors:?}"
+    );
+}
+
+// R6.1 — a fresh profile: the panel sits in the BOTTOM dock, 320 px, and not in the left one.
+#[gpui::test]
+async fn panel_dock_default_fresh_profile_docks_the_panel_at_the_bottom_at_320px(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            assert_eq!(panel.position(window, cx), DockPosition::Bottom);
+            assert_eq!(panel.default_size(window, cx), px(320.));
+        });
+    let (in_bottom, in_left) = panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        (
+            workspace
+                .bottom_dock()
+                .read(cx)
+                .panel::<AgentTasksPanel>()
+                .is_some(),
+            workspace
+                .left_dock()
+                .read(cx)
+                .panel::<AgentTasksPanel>()
+                .is_some(),
+        )
+    });
+    assert!(in_bottom, "the bottom dock holds the panel");
+    assert!(!in_left, "the left dock does not");
+}
+
+// R5.7 first (hostile: each saved dock survives a reload), then R6.2 (an unknown saved value
+// docks at the bottom on reload).
+#[gpui::test]
+async fn panel_dock_default_reload_honours_a_saved_dock_and_falls_back_to_the_bottom(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+
+    for (value, expected) in [
+        ("left", DockPosition::Left),
+        ("right", DockPosition::Right),
+        ("bottom", DockPosition::Bottom),
+    ] {
+        save(&mut panels, value).await;
+        let reloaded = reload(&mut panels).await;
+        assert_eq!(
+            position_of(&reloaded, &mut panels.cx),
+            expected,
+            "a saved {value:?} is honoured"
+        );
+    }
+
+    save(&mut panels, "upside-down").await;
+    let reloaded = reload(&mut panels).await;
+    assert_eq!(
+        position_of(&reloaded, &mut panels.cx),
+        DockPosition::Bottom,
+        "an unknown saved value docks at the bottom"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/label_contract_tests.rs b/crates/agent_tasks_panel/src/panel/label_contract_tests.rs
