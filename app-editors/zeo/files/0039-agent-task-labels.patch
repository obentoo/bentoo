+// R1.5 — the tooltip holds the whole label, not the cut one the row shows. Measured against a row
+// whose description *is* the long row's displayed text: were the tooltip cut too, the two would
+// be the same size.
+#[gpui::test]
+async fn test_label_tooltip_text_is_the_untruncated_label(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let long = "word ".repeat(40);
+    let shown = format!("{}…", long.trim_end().chars().take(59).collect::<String>());
+    send_tasks(
+        &a,
+        vec![
+            described("long", &long, 1_000),
+            described("cut", &shown, 2_000),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    assert!(tooltip_shows(
+        "tasks-card-label-cut",
+        "tasks-card-tooltip-label-cut",
+        &mut cx
+    ));
+    let cut = cx
+        .debug_bounds("tasks-card-tooltip-label-cut")
+        .expect("the cut row's tooltip")
+        .size;
+    assert!(tooltip_shows(
+        "tasks-card-label-long",
+        "tasks-card-tooltip-label-long",
+        &mut cx
+    ));
+    let full = cx
+        .debug_bounds("tasks-card-tooltip-label-long")
+        .expect("the long row's tooltip")
+        .size;
+    assert!(
+        full.height > cut.height || full.width > cut.width,
+        "the tooltip shows all {} characters, not the {} the row shows: {full:?} vs {cut:?}",
+        long.trim_end().chars().count(),
+        shown.chars().count()
+    );
+}
