+// Story 022, task 5.2 — inline Rename on a panel row (R3.1, R3.2, R3.4, R3.5, R3.6, R3.7,
+// R3.11, Q14). Module path: `panel::actions_rename`. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/actions_rename_tests.rs"]
+//     mod actions_rename;
+//
+// Contract assumed beyond design.md (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::start_rename(&mut self, key: TaskKey, window, cx)` opens the editor
+//     (what the Rename control does), and `rename_editor(&self) -> Option<Entity<Editor>>`
+//     exposes it while open (None otherwise);
+//   - the editor confirms on `menu::Confirm` and on losing focus, and cancels on `menu::Cancel`;
+//   - the Rename control carries debug selector `agent-tasks-rename-{task_id}` and the
+//     screen-reader label `Rename: {displayed label}`;
+//   - `agent_ui::TaskLabels` at agent_ui's root; screen-reader labels from
+//     `Window::debug_a11y_tree_json()`.
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::TaskLabels;
+use gpui::{Entity, Focusable as _, KeyBinding, Modifiers, TestAppContext, VisualTestContext};
+use serde_json::json;
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+const HEREDOC: &str = "cat > f <<'EOF'\n{\"a\": 1}\nEOF";
+const HEREDOC_SHOWN: &str = "cat > f <<'EOF' {\"a\": 1} EOF";
+
+fn ensure_labels(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+    });
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Docks the Agent Tasks panel open, so its rows are painted.
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn described(id: &str, description: &str, status: &str, at: u64) -> serde_json::Value {
+    let mut task = wire_task(id, status, at, None);
+    task["description"] = json!(description);
+    task
+}
+
+/// Every string of the window's accessibility tree (screen-reader labels among them).
+fn a11y_strings(cx: &mut VisualTestContext) -> Vec<String> {
+    draw(cx);
+    // GPUI's test windows build no accessibility tree: fall back to the labels the panel
+    // recorded on its last render.
+    let Some(json) = cx.update(|window, _| window.debug_a11y_tree_json()) else {
+        return super::RENDERED_ARIA_LABELS
+            .with_borrow(|labels| labels.iter().map(ToString::to_string).collect());
+    };
+    let value: serde_json::Value = serde_json::from_str(&json).expect("the tree is JSON");
+    let mut strings = Vec::new();
+    collect_strings(&value, &mut strings);
+    strings
+}
+
+fn collect_strings(value: &serde_json::Value, out: &mut Vec<String>) {
+    match value {
+        serde_json::Value::String(text) => out.push(text.clone()),
+        serde_json::Value::Array(items) => items.iter().for_each(|item| collect_strings(item, out)),
+        serde_json::Value::Object(map) => map.values().for_each(|item| collect_strings(item, out)),
+        _ => {}
+    }
+}
+
+fn count(strings: &[String], label: &str) -> usize {
+    strings.iter().filter(|text| text.as_str() == label).count()
+}
+
+fn store_label(session: &str, task: &str, cx: &mut VisualTestContext) -> Option<String> {
+    cx.update(|_, cx| {
+        let store = TaskHistoryStore::global(cx);
+        let records = store.read(cx).records().to_vec();
+        find(&records, session, task).and_then(|entry| entry.label.as_ref().map(|l| l.to_string()))
+    })
+}
+
+fn start(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.start_rename(target, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn editor_text(panels: &mut Panels) -> Option<String> {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.rename_editor().map(|editor| editor.read(cx).text(cx))
+    })
+}
+
+fn editor_focused(panels: &mut Panels) -> bool {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel
+                .rename_editor()
+                .is_some_and(|editor| editor.focus_handle(cx).is_focused(window))
+        })
+}
+
+fn type_text(panels: &mut Panels, text: &str) {
+    panels.cx.simulate_input(text);
+    panels.cx.run_until_parked();
+}
+
+fn confirm(panels: &mut Panels) {
+    panels.cx.dispatch_action(menu::Confirm);
+    panels.cx.run_until_parked();
+}
+
+fn cancel(panels: &mut Panels) {
+    panels.cx.dispatch_action(menu::Cancel);
+    panels.cx.run_until_parked();
+}
+
+fn rename_to(panels: &mut Panels, session: &str, task: &str, text: &str) {
+    start(panels, session, task);
+    type_text(panels, text);
+    confirm(panels);
+}
+
+/// A live thread holding one running task `t` (description `Task t`), with the panel shown.
+async fn one_live_task(cx: &mut TestAppContext) -> (crate::AgentTaskHistoryDb, Panels, String) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+    (db, panels, session)
+}
+
+// R3.1 — the editor holds the current label (collapsed), fully selected and focused.
+#[gpui::test]
+async fn panel_actions_rename_opens_a_focused_editor_with_the_label_selected(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![described("multi", HEREDOC, "running", 1_000)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    assert_eq!(editor_text(&mut panels), None, "no editor before Rename");
+    start(&mut panels, &session, "multi");
+    assert_eq!(editor_text(&mut panels).as_deref(), Some(HEREDOC_SHOWN));
+    assert!(editor_focused(&mut panels), "the editor takes focus");
+    type_text(&mut panels, "New");
+    assert_eq!(
+        editor_text(&mut panels).as_deref(),
+        Some("New"),
+        "typing replaces the whole label"
+    );
+    confirm(&mut panels);
+
+    start(&mut panels, &session, "multi");
+    assert_eq!(
+        editor_text(&mut panels).as_deref(),
+        Some("New"),
+        "a renamed row edits its own label"
+    );
+    cancel(&mut panels);
+}
+
+// R3.2 — Enter labels THAT task. Hostile: thread B holds the same task id.
+#[gpui::test]
+async fn panel_actions_rename_confirm_labels_only_that_row(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let connection = StopConnection::new();
+    let a = open_thread_on(&panels.agent_panel, connection.clone(), "A", &mut panels.cx);
+    send_tasks(
+        &a,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_thread_on(&panels.agent_panel, connection, "B", &mut panels.cx);
+    send_tasks(
+        &b,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let (sa, sb) = (
+        session_of(&a, &panels.cx).to_string(),
+        session_of(&b, &panels.cx).to_string(),
+    );
+    assert_ne!(sa, sb);
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    rename_to(&mut panels, &sa, "t", "Renamed A");
+
+    assert_eq!(editor_text(&mut panels), None, "Enter closes the editor");
+    assert_eq!(
+        store_label(&sa, "t", &mut panels.cx).as_deref(),
+        Some("Renamed A")
+    );
+    assert_eq!(store_label(&sb, "t", &mut panels.cx), None);
+    let stored = load(&db).await;
+    assert_eq!(
+        find(&stored, &sa, "t").unwrap().label.as_deref(),
+        Some("Renamed A")
+    );
+    assert_eq!(find(&stored, &sb, "t").unwrap().label, None);
+    let strings = a11y_strings(&mut panels.cx);
+    assert_eq!(count(&strings, "Open thread: Renamed A"), 1);
+    assert_eq!(count(&strings, "Open thread: Task t"), 1);
+}
+
+// R3.4 — more than 60 characters typed: the first 60 are kept.
+#[gpui::test]
+async fn panel_actions_rename_keeps_the_first_sixty_characters(cx: &mut TestAppContext) {
