+// Story 022, task 3.1 — card rows draw their label on one line, show the full text in a
+// tooltip, use the displayed label for screen readers, and show the user's label
+// (R1.2, R1.5, R1.6, R3.3, R5.2). Module path: `tasks_card::label`.
+//
+// Declared in `src/tasks_card.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/label_tests.rs"]
+//     mod label;
+//
+// Contract assumed beyond design.md (adjust HERE when the implementation drifts):
+//   - the row's label sits in an element with debug selector `tasks-card-label-{task_id}`, whose
+//     tooltip is `card_tooltip("label-{task_id}", full)` (selector `tasks-card-tooltip-label-{task_id}`);
+//   - `crate::task_label::TaskLabels` (`default`, `set`), read by the card with `try_global`;
+//   - screen-reader labels are read from `Window::debug_a11y_tree_json()`.
+
+use std::time::Duration;
+
+use acp_thread::AgentTaskId;
+use gpui::{
+    BorrowAppContext as _, Modifiers, Pixels, Point, SharedString, TestAppContext,
+    VisualTestContext, px,
+};
+use serde_json::json;
+
+use super::test_helpers::*;
+use crate::task_label::TaskLabels;
+
+const HEREDOC: &str = "cat > f <<'EOF'\n{\"a\": 1}\nEOF";
+const HEREDOC_SHOWN: &str = "cat > f <<'EOF' {\"a\": 1} EOF";
+
+fn described(id: &str, description: &str, started_at_ms: u64) -> serde_json::Value {
+    let mut task = wire_task(id, "running", true, started_at_ms);
+    task["description"] = json!(description);
+    task
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn height(selector: &'static str, cx: &mut VisualTestContext) -> Pixels {
+    cx.debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"))
+        .size
+        .height
+}
+
+fn tooltip_shows(
+    selector: &'static str,
+    tooltip: &'static str,
+    cx: &mut VisualTestContext,
+) -> bool {
+    cx.simulate_mouse_move(Point::new(px(1.), px(1.)), None, Modifiers::none());
+    advance(cx, Duration::from_millis(100));
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    advance(cx, Duration::from_secs(1));
+    draw(cx);
+    cx.debug_bounds(tooltip).is_some()
+}
+
+/// Every string of the window's accessibility tree (labels among them). GPUI's test windows
+/// never activate that tree, so without one this reads the screen-reader labels the card's row
+/// controls were given on the last render.
+fn a11y_strings(cx: &mut VisualTestContext) -> Vec<String> {
+    draw(cx);
+    let Some(json) = cx.update(|window, _| window.debug_a11y_tree_json()) else {
+        return super::RENDERED_ARIA_LABELS
+            .with_borrow(|labels| labels.iter().map(ToString::to_string).collect());
+    };
+    let value: serde_json::Value = serde_json::from_str(&json).expect("the tree is JSON");
+    let mut strings = Vec::new();
+    collect_strings(&value, &mut strings);
+    strings
+}
+
+fn collect_strings(value: &serde_json::Value, out: &mut Vec<String>) {
+    match value {
+        serde_json::Value::String(text) => out.push(text.clone()),
+        serde_json::Value::Array(items) => items.iter().for_each(|item| collect_strings(item, out)),
+        serde_json::Value::Object(map) => map.values().for_each(|item| collect_strings(item, out)),
+        _ => {}
+    }
+}
+
+fn count(strings: &[String], label: &str) -> usize {
+    strings.iter().filter(|text| text.as_str() == label).count()
+}
+
+fn set_label(
+    key: (agent_client_protocol::schema::v2::SessionId, AgentTaskId),
+    label: Option<&str>,
+    cx: &mut VisualTestContext,
+) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+        cx.update_global::<TaskLabels, _>(|labels, _| {
+            labels.set(
+                key,
+                label.map(|label| SharedString::from(label.to_string())),
+            )
+        });
+    });
+    cx.run_until_parked();
+}
+
+// R1.2 — the bug: a heredoc description drew three lines over the rows below. Hostile third:
+// a long one-line description must not soft-wrap either.
+#[gpui::test]
+async fn test_label_multi_line_description_paints_a_one_line_row(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            described("multi", HEREDOC, 1_000),
+            described("single", "Write the fixture", 2_000),
+            described("long", &"word ".repeat(40), 3_000),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+
+    let single = height("tasks-card-row-single", &mut cx);
+    assert_eq!(
+        height("tasks-card-row-multi", &mut cx),
+        single,
+        "a multi-line label is one line"
+    );
+    assert_eq!(
+        height("tasks-card-row-long", &mut cx),
+        single,
+        "a long label does not wrap"
+    );
+    let single_label = height("tasks-card-label-single", &mut cx);
+    assert_eq!(height("tasks-card-label-multi", &mut cx), single_label);
+    assert_eq!(height("tasks-card-label-long", &mut cx), single_label);
+}
+
+// R1.5 — the pointer on the label shows the full text in a tooltip.
+#[gpui::test]
+async fn test_label_tooltip_shows_on_the_row_label(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            described("multi", HEREDOC, 1_000),
+            described("long", &"word ".repeat(40), 2_000),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+    assert!(tooltip_shows(
+        "tasks-card-label-multi",
+        "tasks-card-tooltip-label-multi",
+        &mut cx
+    ));
+    assert!(tooltip_shows(
+        "tasks-card-label-long",
+        "tasks-card-tooltip-label-long",
+        &mut cx
+    ));
+}
