+// ── Red-first: the editor sits in a row whose click opens the thread (gotcha 1) ──────────────
+
+/// Two live threads, A then B, each holding one running task. B is the agent panel's active
+/// thread, so anything that opens A's thread shows in `active_session`.
+async fn two_threads(
+    cx: &mut TestAppContext,
+    task_a: &str,
+    task_b: &str,
+) -> (Panels, String, String) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let connection = StopConnection::new();
+    let a = open_thread_on(&panels.agent_panel, connection.clone(), "A", &mut panels.cx);
+    send_tasks(
+        &a,
+        vec![wire_task(task_a, "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_thread_on(&panels.agent_panel, connection, "B", &mut panels.cx);
+    send_tasks(
+        &b,
+        vec![wire_task(task_b, "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let (sa, sb) = (
+        session_of(&a, &panels.cx).to_string(),
+        session_of(&b, &panels.cx).to_string(),
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+    assert_eq!(
+        active_session_text(&panels),
+        Some(sb.clone()),
+        "B is the active thread"
+    );
+    (panels, sa, sb)
+}
+
+fn active_session_text(panels: &Panels) -> Option<String> {
+    active_session(panels).map(|session| session.to_string())
+}
