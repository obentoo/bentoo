diff --git a/crates/agent_ui/src/task_label.rs b/crates/agent_ui/src/task_label.rs
new file mode 100644
index 0000000..f27e064
--- /dev/null
+++ b/crates/agent_ui/src/task_label.rs
@@ -0,0 +1,83 @@
+//! What a task's label looks like wherever a row shows it: one line, at most
+//! [`TASK_LABEL_MAX_CHARS`] characters. `Label::truncate` alone does not give that — it stops
+//! soft wrapping, but a `\n` in the text (a Bash heredoc, say) still starts a new line inside a
+//! fixed-height row and draws over the rows below.
+//!
+//! Also the labels the user gave tasks in the Agent Tasks panel, held in a global so the Tasks
+//! card can show them without depending on the panel's crate.
+
+use collections::HashMap;
+use gpui::{Global, SharedString};
+
+use crate::tasks_card::TaskKey;
+
+/// The most characters a task label shows, and the most a renamed label keeps.
+pub const TASK_LABEL_MAX_CHARS: usize = 60;
+
+/// `text` with every run of whitespace — line breaks and tabs included — collapsed to one
+/// space and trimmed, never cut: the tooltip's text and the rename editor's starting text.
+pub fn collapse_label(text: &str) -> SharedString {
+    text.split_whitespace().collect::<Vec<_>>().join(" ").into()
+}
+
+/// The one line a row shows for `text`: collapsed, then, only when longer than
+/// [`TASK_LABEL_MAX_CHARS`], cut to 59 characters followed by `…`.
+pub fn display_label(text: &str) -> SharedString {
+    let collapsed = collapse_label(text);
+    if collapsed.chars().count() <= TASK_LABEL_MAX_CHARS {
+        return collapsed;
+    }
+    // `truncate_and_trailoff` keeps its count of characters and then appends the `…`.
+    util::truncate_and_trailoff(&collapsed, TASK_LABEL_MAX_CHARS - 1).into()
+}
+
+/// What Rename stores for `text`: collapsed and cut to [`TASK_LABEL_MAX_CHARS`] characters with
+/// no ellipsis, or `None` when nothing but whitespace was typed — the agent's description then
+/// shows again.
+pub fn normalize_user_label(text: &str) -> Option<SharedString> {
+    let collapsed = collapse_label(text);
+    if collapsed.is_empty() {
+        return None;
+    }
+    Some(
+        collapsed
+            .chars()
+            .take(TASK_LABEL_MAX_CHARS)
+            .collect::<String>()
+            .into(),
+    )
+}
+
+/// The labels the user gave tasks, keyed by the `(session, task)` pair: the Agent Tasks panel
+/// writes them, the Tasks card shows them in place of the agent's description.
+#[derive(Default)]
+pub struct TaskLabels(HashMap<TaskKey, SharedString>);
+
+impl Global for TaskLabels {}
+
+impl TaskLabels {
+    pub fn get(&self, key: &TaskKey) -> Option<&SharedString> {
+        self.0.get(key)
+    }
+
+    /// Sets `key`'s label; `None` removes it.
+    pub fn set(&mut self, key: TaskKey, label: Option<SharedString>) {
+        match label {
+            Some(label) => {
+                self.0.insert(key, label);
+            }
+            None => {
+                self.0.remove(&key);
+            }
+        }
+    }
+
+    /// Replaces every label with `labels`: what the history holds once it has loaded.
+    pub fn replace_all(&mut self, labels: impl IntoIterator<Item = (TaskKey, SharedString)>) {
+        self.0 = labels.into_iter().collect();
+    }
+}
+
