@@ -0,0 +1,272 @@
+// Story 022, task 4.2 — `TaskHistoryStore::rename` (R3.2, R3.4, R3.7, R3.8, R3.9, R3.12, Q4).
+// Module path: `store::rename`. Hostile fixtures come before benign ones.
+//
+// Declared in `src/store.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "store/rename_tests.rs"]
+//     mod rename;
+//
+// Contract assumed beyond design.md: `agent_ui::TaskLabels` is re-exported at agent_ui's root.
+// Tests set the global themselves, as `agent_ui::init` does in Zeo (the rig does not run it).
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::TaskLabels;
+use gpui::{AppContext as _, Entity, SharedString, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+fn ensure_labels(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+    });
+}
+
+fn global_label(cx: &mut VisualTestContext, session: &str, task: &str) -> Option<String> {
+    cx.update(|_, cx| {
+        cx.try_global::<TaskLabels>().and_then(|labels| {
+            labels
+                .get(&key(session, task))
+                .map(|label| label.to_string())
+        })
+    })
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn label_of(entries: &[HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(entries, session, task)
+        .unwrap_or_else(|| panic!("({session}, {task}) should be recorded"))
+        .label
+        .as_ref()
+        .map(|label| label.to_string())
+}
+
+async fn seeded_store(
+    name: &'static str,
+    finished: &[(&str, &str)],
+    cx: &mut TestAppContext,
+) -> (AgentTaskHistoryDb, Entity<TaskHistoryStore>, CardRig) {
+    let mut rig = card_rig(cx).await;
+    ensure_labels(&mut rig.cx);
+    let db = AgentTaskHistoryDb::open_test_db(name).await;
+    for (index, (session, task)) in finished.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    (db, store, rig)
+}
+
+fn rename(
+    store: &Entity<TaskHistoryStore>,
+    session: &str,
+    task: &str,
+    text: &str,
+    rig: &mut CardRig,
+) {
+    store.update(&mut rig.cx, |store, cx| {
+        store.rename(key(session, task), text, cx)
+    });
+    rig.cx.run_until_parked();
+}
+
+// Hostile (wrong collapse): memory, database and global label the pair only.
+#[gpui::test]
+async fn store_rename_labels_only_its_own_pair_everywhere(cx: &mut TestAppContext) {
+    let pairs = [
+        ("s1", "t1"),
+        ("s2", "t1"),
+        ("s1", "t2"),
+        ("s10", "t1"),
+        ("s:1", "x"),
+        ("s", "1:x"),
+    ];
+    let (db, store, mut rig) = seeded_store("store_rename_own_pair", &pairs, cx).await;
+
+    rename(&store, "s1", "t1", "Renamed", &mut rig);
+    rename(&store, "s", "1:x", "Third", &mut rig);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(label_of(&view, "s1", "t1").as_deref(), Some("Renamed"));
+        assert_eq!(label_of(&view, "s", "1:x").as_deref(), Some("Third"));
+        for (session, task) in [("s2", "t1"), ("s1", "t2"), ("s10", "t1"), ("s:1", "x")] {
+            assert_eq!(label_of(&view, session, task), None, "{session}/{task}");
+        }
+        assert_eq!(
+            find(&view, "s1", "t1").unwrap().record.description.as_ref(),
+            "Task t1",
+            "the description is kept as it was"
+        );
+    }
+    assert_eq!(
+        global_label(&mut rig.cx, "s1", "t1").as_deref(),
+        Some("Renamed")
+    );
+    assert_eq!(global_label(&mut rig.cx, "s2", "t1"), None);
+    assert_eq!(global_label(&mut rig.cx, "s:1", "x"), None);
+}
+
+// R3.4 — the text is collapsed and cut to 60 characters, with no ellipsis.
+#[gpui::test]
+async fn store_rename_collapses_and_keeps_sixty_characters(cx: &mut TestAppContext) {
+    let (db, store, mut rig) =
+        seeded_store("store_rename_sixty", &[("s1", "t1"), ("s1", "t2")], cx).await;
+    rename(&store, "s1", "t1", "  Fix\n the\t build  ", &mut rig);
+    let long = format!("{}{}", "a".repeat(60), "b".repeat(15));
+    rename(&store, "s1", "t2", &long, &mut rig);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(
+            label_of(&view, "s1", "t1").as_deref(),
+            Some("Fix the build")
+        );
+        assert_eq!(label_of(&view, "s1", "t2"), Some("a".repeat(60)));
+    }
+    assert_eq!(global_label(&mut rig.cx, "s1", "t2"), Some("a".repeat(60)));
+}
+
+// R3.7 — a blank label removes the user's label everywhere.
+#[gpui::test]
+async fn store_rename_to_blank_removes_the_label(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store("store_rename_blank", &[("s1", "t1")], cx).await;
+    rename(&store, "s1", "t1", "Old", &mut rig);
+    rename(&store, "s1", "t1", "  \n\t ", &mut rig);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(label_of(&view, "s1", "t1"), None);
+    }
+    assert_eq!(global_label(&mut rig.cx, "s1", "t1"), None);
+}
+
+// R3.9 — later updates of a renamed task, with a changed description, keep the label.
+#[gpui::test]
+async fn store_rename_survives_later_updates_of_the_task(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store("store_rename_later_updates", &[], cx).await;
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "run", AgentTaskStatus::Running, 5_000)),
+        &mut rig.cx,
+    );
+    rename(&store, "s1", "run", "Mine", &mut rig);
+
+    let mut again = record("s1", "run", AgentTaskStatus::Running, 5_000);
+    again.description = "Changed by the agent".into();
+    emit(&card, started(&again), &mut rig.cx);
+    let mut done = record("s1", "run", AgentTaskStatus::Completed, 5_000);
+    done.description = "Changed again".into();
+    emit(&card, ended(&done), &mut rig.cx);
+
+    for view in [entries(&store, &rig.cx), load(&db).await] {
+        assert_eq!(label_of(&view, "s1", "run").as_deref(), Some("Mine"));
+    }
+    assert_eq!(
+        global_label(&mut rig.cx, "s1", "run").as_deref(),
+        Some("Mine")
+    );
+}
+
+// R3.8 — a new store over the same database (a restart) loads every label and publishes them
+// to the global, replacing whatever it held.
+#[gpui::test]
+async fn store_rename_restart_loads_and_publishes_every_label(cx: &mut TestAppContext) {
+    let (db, store, mut rig) =
+        seeded_store("store_rename_restart", &[("s1", "t1"), ("s2", "t1")], cx).await;
+    rename(&store, "s1", "t1", "Before restart", &mut rig);
+
+    rig.cx.update(|_, cx| {
+        let mut stale = TaskLabels::default();
+        stale.set(key("s9", "t9"), Some(SharedString::from("Stale")));
+        cx.set_global(stale);
+    });
+    let restarted = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        label_of(&entries(&restarted, &rig.cx), "s1", "t1").as_deref(),
+        Some("Before restart")
+    );
+    assert_eq!(label_of(&entries(&restarted, &rig.cx), "s2", "t1"), None);
+    assert_eq!(
+        global_label(&mut rig.cx, "s1", "t1").as_deref(),
+        Some("Before restart")
+    );
+    assert_eq!(global_label(&mut rig.cx, "s2", "t1"), None);
+    assert_eq!(
+        global_label(&mut rig.cx, "s9", "t9"),
+        None,
+        "the loaded labels replace the global"
+    );
+}
+
+// R3.12, Q4 — a failed write keeps the label for the session and logs both ids.
+#[gpui::test]
+async fn store_rename_write_failure_keeps_the_label_and_logs_ids(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "store_rename_write_failure",
+        &[("session-r1", "task-r1")],
+        cx,
+    )
+    .await;
+    drop_history_table(&db).await;
+    capture_logs();
+
+    rename(&store, "session-r1", "task-r1", "Kept", &mut rig);
+
+    assert_eq!(
+        label_of(&entries(&store, &rig.cx), "session-r1", "task-r1").as_deref(),
+        Some("Kept")
+    );
+    assert_eq!(
+        global_label(&mut rig.cx, "session-r1", "task-r1").as_deref(),
+        Some("Kept")
+    );
+    let errors = error_lines();
+    assert!(
+        errors
+            .iter()
+            .any(|line| line.contains("session-r1") && line.contains("task-r1")),
+        "the failed label write is logged with both ids: {errors:?}"
+    );
+}
+
+// A task the history does not hold is not labelled anywhere.
+#[gpui::test]
+async fn store_rename_of_an_unknown_task_changes_nothing(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store("store_rename_unknown", &[("s1", "t1")], cx).await;
