index 0000000..aa71e9e
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/label_contract_tests.rs
@@ -0,0 +1,294 @@
+// Story 022, task 5.3 — the label contract: what the store writes is what the card and every
+// panel read, across windows and a restart (R3.3, R3.8, R3.10). Module path:
+// `panel::label_contract`.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/label_contract_tests.rs"]
+//     mod label_contract;
+//
+// Same assumptions as `panel::actions_rename` (start_rename / rename_editor / menu actions,
+// `agent_ui::TaskLabels`, `Window::debug_a11y_tree_json()`), and the card's `Watch: {label}`.
+
+use std::path::Path;
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::{AgentPanel, TaskLabels, collapse_label, display_label};
+use fs::FakeFs;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::AgentTasksPanel;
+use crate::test_helpers::*;
+
+fn ensure_labels(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+    });
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Docks the Agent Tasks panel open, so its rows are painted.
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+/// Every string of the window's accessibility tree (screen-reader labels among them). GPUI's
+/// test windows build no tree, so the labels the panel rendered are read instead, plus the
+/// card's row labels.
+fn a11y_strings(cx: &mut VisualTestContext) -> Vec<String> {
+    draw(cx);
+    let Some(json) = cx.update(|window, _| window.debug_a11y_tree_json()) else {
+        let mut strings: Vec<String> = super::RENDERED_ARIA_LABELS
+            .with_borrow(|labels| labels.iter().map(ToString::to_string).collect());
+        strings.extend(card_watch_labels(cx));
+        return strings;
+    };
+    let value: serde_json::Value = serde_json::from_str(&json).expect("the tree is JSON");
+    let mut strings = Vec::new();
+    collect_strings(&value, &mut strings);
+    strings
+}
+
+/// The card's Watch labels as its rows name them. agent_ui records its rendered labels only in
+/// its own test builds, so this reads the card's rows and the `TaskLabels` global it renders
+/// from, through agent_ui's own label rules. The agent panel and this panel share the left dock
+/// by default, so the card is brought on screen for the reading and this panel shown again.
+fn card_watch_labels(cx: &mut VisualTestContext) -> Vec<String> {
+    let Some(workspace) = cx.update(|window, cx| {
+        let multi_workspace = window.root::<MultiWorkspace>().flatten()?;
+        Some(multi_workspace.read(cx).workspace().clone())
+    }) else {
+        return Vec::new();
+    };
+    let Some(agent_panel) =
+        workspace.read_with(cx, |workspace, cx| workspace.panel::<AgentPanel>(cx))
+    else {
+        return Vec::new();
+    };
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentPanel>(window, cx);
+    });
+    draw(cx);
+    let painted = cx.debug_bounds("tasks-card").is_some();
+    let strings = cx.update(|_, cx| {
+        let card = agent_panel.read(cx).tasks_card().read(cx);
+        if !painted || card.is_minimized() {
+            return Vec::new();
+        }
+        let labels = cx.try_global::<TaskLabels>();
+        let mut strings = Vec::new();
+        for group in card.rows(cx) {
+            for row in group.rows {
+                let key = (group.session_id.clone(), row.task.id.clone());
+                let user_label = labels.and_then(|labels| labels.get(&key));
+                let shown = display_label(&collapse_label(
+                    user_label.map_or(row.task.description.as_ref(), |label| label.as_ref()),
+                ));
+                let verb = if row.watched {
+                    "Stop watching"
+                } else {
+                    "Watch"
+                };
+                strings.push(format!("{verb}: {shown}"));
+            }
+        }
+        strings
+    });
+    show_panel(&workspace, cx);
+    strings
+}
+
+fn collect_strings(value: &serde_json::Value, out: &mut Vec<String>) {
+    match value {
+        serde_json::Value::String(text) => out.push(text.clone()),
+        serde_json::Value::Array(items) => items.iter().for_each(|item| collect_strings(item, out)),
+        serde_json::Value::Object(map) => map.values().for_each(|item| collect_strings(item, out)),
+        _ => {}
+    }
+}
+
+fn count(strings: &[String], label: &str) -> usize {
+    strings.iter().filter(|text| text.as_str() == label).count()
+}
+
+fn rename_to(panels: &mut Panels, session: &str, task: &str, text: &str) {
+    let target = key(session, task);
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.start_rename(target, window, cx)
+        });
+    panels.cx.run_until_parked();
+    panels.cx.simulate_input(text);
+    panels.cx.dispatch_action(menu::Confirm);
+    panels.cx.run_until_parked();
+}
+
+async fn open_window(
+    cx: &mut TestAppContext,
+    root: &str,
+) -> (Entity<Workspace>, VisualTestContext) {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    let cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    (workspace, cx)
+}
+
+// R3.3 — a rename in the panel shows in the open card at once; hostile: thread B's row with the
+// same task id keeps its description.
+#[gpui::test]
+async fn panel_label_contract_rename_reaches_the_open_card(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let connection = StopConnection::new();
+    let a = open_thread_on(&panels.agent_panel, connection.clone(), "A", &mut panels.cx);
+    send_tasks(
+        &a,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_thread_on(&panels.agent_panel, connection, "B", &mut panels.cx);
+    send_tasks(
+        &b,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let session_a = session_of(&a, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+    assert_eq!(count(&a11y_strings(&mut panels.cx), "Watch: Task t"), 2);
+
+    rename_to(&mut panels, &session_a, "t", "Renamed");
+
+    let strings = a11y_strings(&mut panels.cx);
+    assert_eq!(
+        count(&strings, "Watch: Renamed"),
+        1,
+        "the card shows the rename without reopening"
+    );
+    assert_eq!(
+        count(&strings, "Watch: Task t"),
+        1,
+        "thread B's card row is untouched"
+    );
+    assert_eq!(count(&strings, "Open thread: Renamed"), 1);
+}
+
+// R3.10 — a rename in one window shows in every open window's panel.
+#[gpui::test]
+async fn panel_label_contract_rename_shows_in_a_second_window(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "completed", 1_000, Some((1, 1)))],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+
+    let (second, mut second_cx) = open_window(cx, "/second").await;
+    let weak = second.downgrade();
+    let loading = second_cx.update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    second_cx.run_until_parked();
+    let second_panel = loading.await.expect("the second window's panel loads");
+    second.update_in(&mut second_cx, |workspace, window, cx| {
+        workspace.add_panel(second_panel.clone(), window, cx);
+    });
+    show_panel(&second, &mut second_cx);
+    show_panel(&panels.workspace, &mut panels.cx);
+    assert_eq!(
+        count(&a11y_strings(&mut second_cx), "Open thread: Task t"),
+        1
+    );
+
+    rename_to(&mut panels, &session, "t", "Seen everywhere");
+
+    let strings = a11y_strings(&mut second_cx);
+    assert_eq!(count(&strings, "Open thread: Seen everywhere"), 1);
+    assert_eq!(count(&strings, "Open thread: Task t"), 0);
+}
+
+// R3.8 — a label confirmed before a restart shows after it, in the panel and in the card. The
+// label is in the database before Zeo starts; the thread's session is the one the card keys by.
+#[gpui::test]
+async fn panel_label_contract_restart_shows_the_stored_label_in_panel_and_card(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    let connection = StopConnection::new();
+    // StopConnection numbers its sessions from 1: the first thread opened on it is this one.
+    let first_session = "tasks-panel-session-1";
+    db.insert_started(&record(first_session, "t", AgentTaskStatus::Running, 1_000))
+        .await
+        .unwrap();
+    db.set_label(&key(first_session, "t"), Some("Before restart"))
+        .await
+        .unwrap();
+
+    // As in Zeo, agent_ui::init has set the label global before the history store loads.
+    cx.update(|cx| cx.set_global(TaskLabels::default()));
+    let mut panels = open_panels(cx).await;
+    let a = open_thread_on(&panels.agent_panel, connection.clone(), "A", &mut panels.cx);
+    assert_eq!(
+        session_of(&a, &panels.cx).to_string(),
+        first_session,
+        "fixture: the session the label was stored under"
+    );
+    send_tasks(
+        &a,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_thread_on(&panels.agent_panel, connection, "B", &mut panels.cx);
+    send_tasks(
+        &b,
+        vec![wire_task("t", "running", 3_000, None)],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let strings = a11y_strings(&mut panels.cx);
+    assert_eq!(
+        count(&strings, "Open thread: Before restart"),
+        1,
+        "the panel shows the stored label"
+    );
+    assert_eq!(
+        count(&strings, "Watch: Before restart"),
+        1,
+        "the card shows the stored label"
+    );
+    assert_eq!(
+        count(&strings, "Watch: Task t"),
+        1,
+        "thread B's task is not labelled"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/list_label_tests.rs b/crates/agent_tasks_panel/src/panel/list_label_tests.rs
new file mode 100644
index 0000000..82c396e
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/list_label_tests.rs
@@ -0,0 +1,389 @@
+// Story 022, task 5.1 — panel rows draw their label on one line, from the user's label or the
+// description, and name the task by its displayed label for screen readers (R1.1, R1.6, R3.9,
+// R5.2, R5.3). Module path: `panel::list_label`.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/list_label_tests.rs"]
+//     mod list_label;
+//
+// Contract assumed beyond design.md (adjust HERE when the implementation drifts):
+//   - the row's label sits in an element with debug selector `agent-tasks-row-label-{task_id}`;
+//   - `agent_ui::TaskLabels` is re-exported at agent_ui's root; tests set the global, as
+//     `agent_ui::init` does in Zeo;
+//   - screen-reader labels are read from `Window::debug_a11y_tree_json()`, or — GPUI's test
+//     windows build no accessibility tree — from the panel's `RENDERED_ARIA_LABELS`;
+//   - the Open Thread tooltip's text carries debug selector `agent-tasks-tooltip-open-{task_id}`.
+
+use std::time::Duration;
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::TaskLabels;
+use gpui::{Entity, Modifiers, Pixels, Point, TestAppContext, VisualTestContext, px};
+use serde_json::json;
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+const HEREDOC: &str = "cat > f <<'EOF'\n{\"a\": 1}\nEOF";
+const HEREDOC_SHOWN: &str = "cat > f <<'EOF' {\"a\": 1} EOF";
+
+fn ensure_labels(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+    });
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Docks the Agent Tasks panel open, so its rows are painted.
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn described(id: &str, description: &str, status: &str, at: u64) -> serde_json::Value {
+    let mut task = wire_task(id, status, at, None);
+    task["description"] = json!(description);
+    task
+}
+
+/// Every string of the window's accessibility tree (screen-reader labels among them). GPUI's
+/// test windows build no tree, so the labels the panel rendered are read instead.
+fn a11y_strings(cx: &mut VisualTestContext) -> Vec<String> {
+    draw(cx);
+    let Some(json) = cx.update(|window, _| window.debug_a11y_tree_json()) else {
+        return super::RENDERED_ARIA_LABELS
+            .with_borrow(|labels| labels.iter().map(ToString::to_string).collect());
+    };
+    let value: serde_json::Value = serde_json::from_str(&json).expect("the tree is JSON");
+    let mut strings = Vec::new();
+    collect_strings(&value, &mut strings);
+    strings
+}
+
+fn collect_strings(value: &serde_json::Value, out: &mut Vec<String>) {
+    match value {
+        serde_json::Value::String(text) => out.push(text.clone()),
+        serde_json::Value::Array(items) => items.iter().for_each(|item| collect_strings(item, out)),
+        serde_json::Value::Object(map) => map.values().for_each(|item| collect_strings(item, out)),
+        _ => {}
+    }
+}
+
+fn count(strings: &[String], label: &str) -> usize {
+    strings.iter().filter(|text| text.as_str() == label).count()
+}
+
+fn store_label(session: &str, task: &str, cx: &mut VisualTestContext) -> Option<String> {
+    cx.update(|_, cx| {
+        let store = TaskHistoryStore::global(cx);
+        let records = store.read(cx).records().to_vec();
+        find(&records, session, task).and_then(|entry| entry.label.as_ref().map(|l| l.to_string()))
+    })
+}
+
+fn height(selector: &'static str, cx: &mut VisualTestContext) -> Pixels {
+    cx.debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"))
+        .size
+        .height
+}
+
+fn advance(cx: &mut VisualTestContext, duration: Duration) {
+    cx.executor().advance_clock(duration);
+    cx.run_until_parked();
+}
+
+/// Rests the pointer on `selector` (after moving it away) and says whether `tooltip` shows.
+fn tooltip_shows(
+    selector: &'static str,
+    tooltip: &'static str,
+    cx: &mut VisualTestContext,
+) -> bool {
+    cx.simulate_mouse_move(Point::new(px(1.), px(1.)), None, Modifiers::none());
+    advance(cx, Duration::from_millis(100));
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    advance(cx, Duration::from_secs(1));
+    draw(cx);
+    cx.debug_bounds(tooltip).is_some()
+}
+
+/// Stores a finished task of `old-session` whose description is a heredoc.
+async fn store_heredoc_task(
+    db: &crate::AgentTaskHistoryDb,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+) {
+    let mut running = record("old-session", task, AgentTaskStatus::Running, at);
+    running.description = HEREDOC.into();
+    db.insert_started(&running).await.unwrap();
+    let mut done = record("old-session", task, status, at);
+    done.description = HEREDOC.into();
+    db.update_ended(&done).await.unwrap();
+}
+
+// R1.1 — the bug: a heredoc description is drawn on one line, like any other label.
+#[gpui::test]
+async fn panel_list_label_multi_line_description_paints_one_line(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            described("multi", HEREDOC, "running", 1_000),
+            described("single", "Write the fixture", "running", 2_000),
+        ],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let single = height("agent-tasks-row-label-single", &mut panels.cx);
+    assert_eq!(
+        height("agent-tasks-row-label-multi", &mut panels.cx),
+        single
+    );
+}
+
+// R1.6 — every control of the row names the task by its displayed label.
+#[gpui::test]
+async fn panel_list_label_screen_reader_labels_use_the_displayed_label(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    let long = format!("{} {}", "a".repeat(30), "b".repeat(40));
+    let long_shown = format!("{}…", long.chars().take(59).collect::<String>());
+    send_tasks(
+        &thread,
+        vec![
+            described("multi", HEREDOC, "running", 1_000),
+            described("long", &long, "running", 2_000),
+        ],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+    let strings = a11y_strings(&mut panels.cx);
+
+    for prefix in ["Open thread", "Stop"] {
+        assert_eq!(
+            count(&strings, &format!("{prefix}: {HEREDOC_SHOWN}")),
+            1,
+            "{prefix}"
+        );
+        assert_eq!(
+            count(&strings, &format!("{prefix}: {long_shown}")),
+            1,
+            "{prefix}"
+        );
+    }
+    assert!(
+        !strings
+            .iter()
+            .any(|text| text.starts_with("Open thread:") && text.contains('\n'))
+    );
+}
+
+// R5.2 — a one-line label of at most 60 characters reads exactly as before.
+#[gpui::test]
+async fn panel_list_label_short_label_is_unchanged(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+    assert_eq!(
+        count(&a11y_strings(&mut panels.cx), "Open thread: Task t1"),
+        1
+    );
+}
+
+// R5.3 + R1.1 — foreground shell rows already in the history (multi-line commands) still list,
+// filter and archive, on one line; none is deleted.
+#[gpui::test]
+async fn panel_list_label_stored_foreground_rows_list_filter_and_archive(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    for (task, status, at) in [
+        ("fg1", AgentTaskStatus::Completed, 1_000),
+        ("fg2", AgentTaskStatus::Completed, 2_000),
+        ("fg3", AgentTaskStatus::Failed, 3_000),
+    ] {
+        let mut running = record("old-session", task, AgentTaskStatus::Running, at);
+        running.description = HEREDOC.into();
+        db.insert_started(&running).await.unwrap();
+        let mut done = record("old-session", task, status, at);
+        done.description = HEREDOC.into();
+        db.update_ended(&done).await.unwrap();
+    }
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let visible = visible_keys(&mut panels);
+    assert!(visible.contains(&("old-session".into(), "fg1".into())));
+    assert!(visible.contains(&("old-session".into(), "fg2".into())));
+    assert_eq!(
+        count(
+            &a11y_strings(&mut panels.cx),
+            &format!("Open thread: {HEREDOC_SHOWN}")
+        ),
+        2
+    );
+
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.archive(&key("old-session", "fg1"), cx)
+    });
+    panels.cx.run_until_parked();
+    assert!(!visible_keys(&mut panels).contains(&("old-session".into(), "fg1".into())));
+
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Archived, true, cx);
+        panel.set_filter(TaskFilter::Failed, true, cx);
+    });
+    panels.cx.run_until_parked();
+    let visible = visible_keys(&mut panels);
+    for task in ["fg1", "fg2", "fg3"] {
+        assert!(
+            visible.contains(&("old-session".into(), task.into())),
+            "{task} is kept"
+        );
+    }
+}
+
+// R3.9 — a renamed row keeps its label when the agent's description changes; another thread
+// holding the same task id shows its own description.
+#[gpui::test]
+async fn panel_list_label_user_label_wins_over_a_changed_description(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let connection = StopConnection::new();
+    let a = open_thread_on(&panels.agent_panel, connection.clone(), "A", &mut panels.cx);
+    send_tasks(
+        &a,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_thread_on(&panels.agent_panel, connection, "B", &mut panels.cx);
+    send_tasks(
+        &b,
+        vec![wire_task("t", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let session_a = session_of(&a, &panels.cx);
+    assert_ne!(session_a, session_of(&b, &panels.cx));
+
+    let store = panels.cx.update(|_, cx| TaskHistoryStore::global(cx));
+    store.update(&mut panels.cx, |store, cx| {
+        store.rename(key(&session_a.to_string(), "t"), "Renamed", cx)
+    });
+    panels.cx.run_until_parked();
+    send_tasks(
+        &a,
+        vec![described("t", "Changed by the agent", "running", 1_000)],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let strings = a11y_strings(&mut panels.cx);
+    assert_eq!(count(&strings, "Open thread: Renamed"), 1);
+    assert_eq!(count(&strings, "Open thread: Changed by the agent"), 0);
+    assert_eq!(
+        count(&strings, "Open thread: Task t"),
+        1,
+        "thread B's row is not renamed"
+    );
+    assert_eq!(
+        store_label(&session_a.to_string(), "t", &mut panels.cx).as_deref(),
+        Some("Renamed")
+    );
+}
+
+// R1.5 — resting on a row's label shows the whole label in the Open Thread tooltip, not the cut
+// one the row shows. Measured against a row whose description *is* the long row's displayed
+// text: were the tooltip cut too, the two would be the same size.
+#[gpui::test]
+async fn panel_list_label_open_thread_tooltip_holds_the_full_label(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    let long = "word ".repeat(40);
+    let shown = format!("{}…", long.trim_end().chars().take(59).collect::<String>());
+    send_tasks(
+        &thread,
+        vec![
+            described("long", &long, "running", 1_000),
+            described("cut", &shown, "running", 2_000),
+        ],
+        &mut panels.cx,
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let tooltip_size =
+        |selector: &'static str, tooltip: &'static str, cx: &mut VisualTestContext| {
+            assert!(tooltip_shows(selector, tooltip, cx), "{tooltip} shows");
+            cx.debug_bounds(tooltip).expect("the tooltip").size
+        };
+    let cut = tooltip_size(
+        "agent-tasks-row-label-cut",
+        "agent-tasks-tooltip-open-cut",
+        &mut panels.cx,
+    );
+    let full = tooltip_size(
+        "agent-tasks-row-label-long",
+        "agent-tasks-tooltip-open-long",
+        &mut panels.cx,
+    );
+    assert!(
+        full.height > cut.height || full.width > cut.width,
+        "the tooltip shows all {} characters, not the {} the row shows: {full:?} vs {cut:?}",
+        long.trim_end().chars().count(),
+        shown.chars().count()
+    );
+}
+
+// R1.6 — Archive and Unarchive name the task by its displayed label too.
+#[gpui::test]
+async fn panel_list_label_archive_and_unarchive_use_the_displayed_label(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    store_heredoc_task(&db, "done", AgentTaskStatus::Completed, 1_000).await;
+    store_heredoc_task(&db, "old", AgentTaskStatus::Completed, 2_000).await;
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.archive(&key("old-session", "old"), cx);
+        panel.set_filter(TaskFilter::Archived, true, cx);
+    });
+    panels.cx.run_until_parked();
+    show_panel(&panels.workspace, &mut panels.cx);
+    let strings = a11y_strings(&mut panels.cx);
+
+    assert_eq!(count(&strings, &format!("Archive: {HEREDOC_SHOWN}")), 1);
+    assert_eq!(count(&strings, &format!("Unarchive: {HEREDOC_SHOWN}")), 1);
+    assert!(
+        !strings.iter().any(|text| text.contains('\n')),
+        "no screen-reader label carries a line break: {strings:?}"
+    );
+}
