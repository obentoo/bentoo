+// Hostile (wrong collapse): only the pair is labelled — not the same task id in another
+// session, not another task of the session, not a pair whose parts concatenate alike.
+#[gpui::test]
+async fn history_db_label_set_label_touches_only_its_own_pair(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_label_own_pair").await;
+    seed(
+        &db,
+        &[
+            ("s1", "t1"),
+            ("s2", "t1"),
+            ("s1", "t2"),
+            ("s10", "t1"),
+            ("s:1", "x"),
+            ("s", "1:x"),
+        ],
+    )
+    .await;
+
+    db.set_label(&key("s1", "t1"), Some("Renamed"))
+        .await
+        .unwrap();
+    db.set_label(&key("s", "1:x"), Some("Third")).await.unwrap();
+
+    let rows = load(&db).await;
+    assert_eq!(label_of(&rows, "s1", "t1").as_deref(), Some("Renamed"));
+    assert_eq!(label_of(&rows, "s", "1:x").as_deref(), Some("Third"));
+    for (session, task) in [("s2", "t1"), ("s1", "t2"), ("s10", "t1"), ("s:1", "x")] {
+        assert_eq!(
+            label_of(&rows, session, task),
+            None,
+            "{session}/{task} is untouched"
+        );
+    }
+}
+
+// Hostile (wrong split): a key built from fresh strings reaches the stored row; setting twice
+// overwrites; None clears. A 60-character multi-byte label round-trips exactly.
+#[gpui::test]
+async fn history_db_label_set_label_overwrites_round_trips_and_clears(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_label_round_trip").await;
+    seed(&db, &[("s1", "t1")]).await;
+
+    let session = String::from("s") + "1";
+    db.set_label(&key(&session, "t1"), Some("First"))
+        .await
+        .unwrap();
+    db.set_label(&key("s1", "t1"), Some("Second"))
+        .await
+        .unwrap();
+    assert_eq!(
+        label_of(&load(&db).await, "s1", "t1").as_deref(),
+        Some("Second")
+    );
+
+    let wide = "é".repeat(60);
+    db.set_label(&key("s1", "t1"), Some(&wide)).await.unwrap();
+    assert_eq!(label_of(&load(&db).await, "s1", "t1"), Some(wide));
+
+    db.set_label(&key("s1", "t1"), None).await.unwrap();
+    assert_eq!(label_of(&load(&db).await, "s1", "t1"), None);
+}
+
+// R3.9 at the database: a new row starts with no label, and no later write of the task — a
+// repeated start, its ending, the startup sweep — clears or rewrites one.
+#[gpui::test]
+async fn history_db_label_later_writes_never_touch_the_label(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_label_later_writes").await;
+    let running = record("s1", "t1", AgentTaskStatus::Running, 1_000);
+    db.insert_started(&running).await.unwrap();
+    assert_eq!(
+        label_of(&load(&db).await, "s1", "t1"),
+        None,
+        "a new row has no label"
+    );
+
+    db.set_label(&key("s1", "t1"), Some("Mine")).await.unwrap();
+    let mut repeat = running.clone();
+    repeat.description = "Changed by a later snapshot".into();
+    db.insert_started(&repeat).await.unwrap();
+    db.mark_running_interrupted().await.unwrap();
+    let mut ended = record("s1", "t1", AgentTaskStatus::Completed, 1_000);
+    ended.description = "Changed again".into();
+    db.update_ended(&ended).await.unwrap();
+
+    let rows = load(&db).await;
+    assert_eq!(label_of(&rows, "s1", "t1").as_deref(), Some("Mine"));
+    assert_eq!(
+        find(&rows, "s1", "t1").unwrap().record.description.as_ref(),
+        "Task t1",
+        "the stored description is never rewritten"
+    );
+}
+
+// Constraint: the label never rewrites the description, the status or the archive flag.
+#[gpui::test]
+async fn history_db_label_leaves_description_status_and_archive_alone(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_label_leaves_rest").await;
+    seed(&db, &[("s1", "t1")]).await;
+    db.set_archived(&[key("s1", "t1")], true).await.unwrap();
+    db.set_label(&key("s1", "t1"), Some("Short")).await.unwrap();
+
+    let rows = load(&db).await;
+    let entry = find(&rows, "s1", "t1").unwrap();
+    assert_eq!(entry.record.description.as_ref(), "Task t1");
+    assert_eq!(entry.record.status, AgentTaskStatus::Completed);
+    assert!(entry.archived);
+}
+
+// Q13 — a refused write returns an error naming both ids and leaves the previous label.
+#[gpui::test]
+async fn history_db_label_failed_write_names_the_ids_and_keeps_the_previous_label(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_label_failed_write").await;
+    seed(&db, &[("session-l1", "task-l1")]).await;
+    db.set_label(&key("session-l1", "task-l1"), Some("Before"))
+        .await
+        .unwrap();
+    run_sql(
+        &db,
+        "CREATE TRIGGER refuse_label BEFORE UPDATE OF label ON agent_task_history \
+         BEGIN SELECT RAISE(ABORT, 'label refused'); END",
+    )
+    .await;
+
+    let error = db
+        .set_label(&key("session-l1", "task-l1"), Some("After"))
+        .await
+        .expect_err("the trigger refuses the write");
+    let message = format!("{error:#}");
+    assert!(
+        message.contains("session-l1") && message.contains("task-l1"),
+        "the error names both ids: {message}"
+    );
+    assert_eq!(
+        label_of(&load(&db).await, "session-l1", "task-l1").as_deref(),
+        Some("Before")
+    );
+}
