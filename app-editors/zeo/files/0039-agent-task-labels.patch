diff --git a/crates/agent_tasks_panel/src/panel/rename_vanish_tests.rs b/crates/agent_tasks_panel/src/panel/rename_vanish_tests.rs
new file mode 100644
index 0000000..649e96a
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/rename_vanish_tests.rs
@@ -0,0 +1,353 @@
+// Story 022, task 7.1 — a rename editor that stops being shown discards the edit (R3.13), while
+// a blur to another element still confirms it (R3.6, narrowed). Module path:
+// `panel::rename_vanish`. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/rename_vanish_tests.rs"]
+//     mod rename_vanish;
+//
+// Contract assumed beyond design.md (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::start_rename(&mut self, key, window, cx)` opens the editor and
+//     `rename_editor(&self) -> Option<Entity<Editor>>` exposes it while open;
+//   - the editor confirms on `menu::Confirm`;
+//   - `set_filter(filter, enabled, cx)` toggles a list filter;
+//   - the list scrolls through the panel's `scroll_handle` (`UniformListScrollHandle`), and the
+//     filter toggles keep their focus handles in `filter_focus_handles` (`TaskFilter::ALL`
+//     order) — both private fields, reachable from this child module.
+//
+// Not covered: a task record removed from the history — the store offers no removal, so the
+// "removed" route of R3.13 is exercised through its effect (the row leaves the list) by a status
+// change and by a filter change.
+
+use agent_ui::TaskLabels;
+use gpui::{Entity, Focusable as _, ScrollStrategy, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+fn ensure_labels(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        if !cx.has_global::<TaskLabels>() {
+            cx.set_global(TaskLabels::default());
+        }
+    });
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Draws twice: the frame that drops the editor, then the one that settles focus after it.
+fn settle(cx: &mut VisualTestContext) {
+    draw(cx);
+    draw(cx);
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn store_label(session: &str, task: &str, cx: &mut VisualTestContext) -> Option<String> {
+    cx.update(|_, cx| {
+        let store = TaskHistoryStore::global(cx);
+        let records = store.read(cx).records().to_vec();
+        find(&records, session, task).and_then(|entry| entry.label.as_ref().map(|l| l.to_string()))
+    })
+}
+
+fn start(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.start_rename(target, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn editor_text(panels: &mut Panels) -> Option<String> {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.rename_editor().map(|editor| editor.read(cx).text(cx))
+    })
+}
+
+fn editor_focused(panels: &mut Panels) -> bool {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel
+                .rename_editor()
+                .is_some_and(|editor| editor.focus_handle(cx).is_focused(window))
+        })
+}
+
+fn type_text(panels: &mut Panels, text: &str) {
+    panels.cx.simulate_input(text);
+    panels.cx.run_until_parked();
+}
+
+fn confirm(panels: &mut Panels) {
+    panels.cx.dispatch_action(menu::Confirm);
+    panels.cx.run_until_parked();
+}
+
+fn rename_to(panels: &mut Panels, session: &str, task: &str, text: &str) {
+    start(panels, session, task);
+    type_text(panels, text);
+    confirm(panels);
+}
+
+fn set_filter(panels: &mut Panels, filter: TaskFilter, enabled: bool) {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(filter, enabled, cx)
+    });
+    panels.cx.run_until_parked();
+}
+
+/// Thread A holds a RUNNING task `t`, thread B an ENDED task with the same id `t` — the same
+/// task id in two threads, so only the (session, task) pair tells the two rows apart.
+async fn same_id_in_two_threads(cx: &mut TestAppContext) -> (Panels, String, String) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let a = open_live_thread(&mut panels, "A");
+    send_tasks(
+        &a,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let b = open_live_thread(&mut panels, "B");
+    send_tasks(
+        &b,
+        vec![wire_task("t", "completed", 2_000, None)],
+        &mut panels.cx,
+    );
+    let (sa, sb) = (
+        session_of(&a, &panels.cx).to_string(),
+        session_of(&b, &panels.cx).to_string(),
+    );
+    show_panel(&panels.workspace, &mut panels.cx);
+    (panels, sa, sb)
+}
+
+// R3.13 via a filter change. Hostile, stay-apart half first: hiding thread B's row must not close
+// the editor open on thread A's row of the SAME task id — the editor stays, focused, with its
+// text, and Enter still labels A only. Then the vanishing half: hiding the renamed row itself
+// closes the editor and keeps the previous label, and turning the filter back on brings back
+// neither the editor nor the half-typed text.
+#[gpui::test]
+async fn panel_actions_rename_vanish_filter_hiding_the_row_keeps_the_previous_label(
+    cx: &mut TestAppContext,
+) {
+    let (mut panels, sa, sb) = same_id_in_two_threads(cx).await;
+
+    start(&mut panels, &sa, "t");
+    type_text(&mut panels, "Still typing");
+    set_filter(&mut panels, TaskFilter::Finished, false);
+    settle(&mut panels.cx);
+    assert_eq!(
+        editor_text(&mut panels).as_deref(),
+        Some("Still typing"),
+        "hiding another thread's row with the same task id leaves this rename open"
+    );
+    assert!(editor_focused(&mut panels), "the editor keeps focus");
+    confirm(&mut panels);
+    assert_eq!(
+        store_label(&sa, "t", &mut panels.cx).as_deref(),
+        Some("Still typing")
+    );
+    assert_eq!(
+        store_label(&sb, "t", &mut panels.cx),
+        None,
+        "B's row was not renamed"
+    );
+    set_filter(&mut panels, TaskFilter::Finished, true);
+    settle(&mut panels.cx);
+
+    rename_to(&mut panels, &sb, "t", "Old");
+    assert_eq!(
+        store_label(&sb, "t", &mut panels.cx).as_deref(),
+        Some("Old")
+    );
+    start(&mut panels, &sb, "t");
+    type_text(&mut panels, "Half typed");
+    set_filter(&mut panels, TaskFilter::Finished, false);
+    settle(&mut panels.cx);
+
+    assert_eq!(
+        store_label(&sb, "t", &mut panels.cx).as_deref(),
+        Some("Old"),
+        "a rename whose row a filter hid keeps the previous label"
+    );
+    assert_eq!(
+        editor_text(&mut panels),
+        None,
+        "the hidden row's editor is closed"
+    );
+    assert_eq!(
+        store_label(&sa, "t", &mut panels.cx).as_deref(),
+        Some("Still typing"),
+        "the other thread's label is untouched"
+    );
+
+    set_filter(&mut panels, TaskFilter::Finished, true);
+    settle(&mut panels.cx);
+    assert_eq!(
+        editor_text(&mut panels),
+        None,
+        "showing the row again reopens nothing"
+    );
+    assert_eq!(
+        store_label(&sb, "t", &mut panels.cx).as_deref(),
+        Some("Old")
+    );
+}
+
+// R3.13 via the record: a running row that fails while being renamed leaves the list (Failed is
+// off by default) — the edit is discarded and the previous label kept.
+#[gpui::test]
+async fn panel_actions_rename_vanish_row_leaving_the_list_keeps_the_previous_label(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    rename_to(&mut panels, &session, "t", "Old");
+    start(&mut panels, &session, "t");
+    type_text(&mut panels, "Half typed");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "failed", 1_000, None)],
+        &mut panels.cx,
+    );
+    settle(&mut panels.cx);
+    assert!(
+        find_row(&mut panels, &session, "t").is_none(),
+        "the failed row is no longer listed"
+    );
+
+    assert_eq!(
+        store_label(&session, "t", &mut panels.cx).as_deref(),
+        Some("Old"),
+        "a rename whose row left the list keeps the previous label"
+    );
+    assert_eq!(editor_text(&mut panels), None, "its editor is closed");
+}
+
+// R3.13 via scrolling: a rename on the top row, then the list scrolled to its last line so the
+// renamed row is drawn no more — the edit is discarded and the previous label kept.
+#[gpui::test]
+async fn panel_actions_rename_vanish_row_scrolled_out_of_view_keeps_the_previous_label(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Long");
+    // 120 running rows — far more than any dock shows. `t119` is the newest, so it is listed
+    // first.
+    let tasks = (0..120)
+        .map(|n| wire_task(&format!("t{n}"), "running", 1_000 + n * 10, None))
+        .collect();
+    send_tasks(&thread, tasks, &mut panels.cx);
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    rename_to(&mut panels, &session, "t119", "Old");
+    start(&mut panels, &session, "t119");
+    type_text(&mut panels, "Half typed");
+    assert!(
+        editor_focused(&mut panels),
+        "the editor is shown and focused"
+    );
+
+    let last = panels.tasks_panel.update(&mut panels.cx, |panel, _| {
+        panel.entries.len().saturating_sub(1)
+    });
+    assert!(last > 100, "every row is a line of the list");
+    panels.tasks_panel.update(&mut panels.cx, |panel, _| {
+        panel
+            .scroll_handle
+            .scroll_to_item(last, ScrollStrategy::Top)
+    });
+    settle(&mut panels.cx);
+    let at_end = panels.tasks_panel.update(&mut panels.cx, |panel, _| {
+        panel.scroll_handle.is_scrolled_to_end()
+    });
+    assert_eq!(
+        at_end,
+        Some(true),
+        "the list is scrollable and scrolled to its last line, away from the renamed row"
+    );
+
+    assert_eq!(
+        store_label(&session, "t119", &mut panels.cx).as_deref(),
+        Some("Old"),
+        "a rename scrolled out of view keeps the previous label"
+    );
+    assert_eq!(editor_text(&mut panels), None, "its editor is closed");
+}
+
+// R3.6 narrowed and R3.13 side by side. Hostile half first: focus moving from the editor to
+// another element — a filter toggle — confirms, as Enter would. Then a blur that leaves NOTHING
+// focused — what a vanished editor raises — discards the edit and keeps that label.
+#[gpui::test]
+async fn panel_actions_rename_vanish_blur_with_nothing_focused_discards_but_a_blur_to_another_element_confirms(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    start(&mut panels, &session, "t");
+    type_text(&mut panels, "Kept");
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            let toggle = panel.filter_focus_handles[0].clone();
+            window.focus(&toggle, cx);
+        });
+    settle(&mut panels.cx);
+    assert_eq!(editor_text(&mut panels), None);
+    assert_eq!(
+        store_label(&session, "t", &mut panels.cx).as_deref(),
+        Some("Kept"),
+        "focus moved to a filter toggle confirms the label"
+    );
+
+    start(&mut panels, &session, "t");
+    type_text(&mut panels, "Half typed");
+    panels.cx.update(|window, cx| window.blur(cx));
+    settle(&mut panels.cx);
+
+    assert_eq!(
+        store_label(&session, "t", &mut panels.cx).as_deref(),
+        Some("Kept"),
+        "a blur with nothing focused discards the edit"
+    );
+    assert_eq!(editor_text(&mut panels), None, "the editor is closed");
+}
