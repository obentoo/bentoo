+
+// R3.11, Q14 — every row offers Rename — running, ended, interrupted, archived — with a
+// screen-reader label, and its control opens the editor on THAT row.
+#[gpui::test]
+async fn panel_actions_rename_is_offered_on_every_row(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    // Running at the last shutdown: the startup sweep marks it interrupted.
+    db.insert_started(&record("older", "lost", AgentTaskStatus::Running, 300))
+        .await
+        .unwrap();
+    for (task, at) in [("done", 400), ("old", 500)] {
+        db.insert_started(&record("older", task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record("older", task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    db.set_archived(&[key("older", "old")], true).await.unwrap();
+    let mut panels = open_panels(cx).await;
+    ensure_labels(&mut panels.cx);
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("run", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in [
+            TaskFilter::Active,
+            TaskFilter::Finished,
+            TaskFilter::Failed,
+            TaskFilter::Archived,
+        ] {
+            panel.set_filter(filter, true, cx);
+        }
+    });
+    show_panel(&panels.workspace, &mut panels.cx);
+
+    let strings = a11y_strings(&mut panels.cx);
+    for task in ["run", "done", "lost", "old"] {
+        assert_eq!(
+            count(&strings, &format!("Rename: Task {task}")),
+            1,
+            "{task} offers Rename"
+        );
+    }
+    for (selector, task) in [
+        ("agent-tasks-rename-run", "run"),
+        ("agent-tasks-rename-done", "done"),
+        ("agent-tasks-rename-lost", "lost"),
+        ("agent-tasks-rename-old", "old"),
+    ] {
+        draw(&mut panels.cx);
+        let bounds = panels
+            .cx
+            .debug_bounds(selector)
+            .unwrap_or_else(|| panic!("{selector} is painted"));
+        panels.cx.simulate_click(bounds.center(), Modifiers::none());
+        panels.cx.run_until_parked();
+        assert_eq!(
+            editor_text(&mut panels),
+            Some(format!("Task {task}")),
+            "{selector} opens the editor on its own row"
+        );
+        cancel(&mut panels);
+    }
+}
