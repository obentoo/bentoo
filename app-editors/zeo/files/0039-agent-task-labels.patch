+// Story 022, task 4.1 — migration step 2 and `set_label` (R3.8, R4.1, R5.3, Q12, Q13).
+// Module path: `history_db::label`. Hostile fixtures come before benign ones.
+//
+// Declared in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/label_tests.rs"]
+//     mod label;
+
+use acp_thread::AgentTaskStatus;
+use db::sqlez::{connection::Connection, domain::Domain};
+use gpui::TestAppContext;
+
+use crate::AgentTaskHistoryDb;
+use crate::test_helpers::*;
+
+fn label_of(rows: &[crate::HistoryEntry], session: &str, task: &str) -> Option<String> {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("({session}, {task}) should be recorded"))
+        .label
+        .as_ref()
+        .map(|label| label.to_string())
+}
+
+async fn seed(db: &AgentTaskHistoryDb, pairs: &[(&str, &str)]) {
+    for (index, (session, task)) in pairs.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+}
+
+// R4.1, Q12 — a database written by the 0035 schema (step 1 only) opens with every row,
+// status and archive flag intact, gains a NULL label, and each row is renamable.
+#[test]
+fn history_db_label_migration_two_opens_a_step_one_database_intact() {
+    assert_eq!(
+        AgentTaskHistoryDb::MIGRATIONS.len(),
+        2,
+        "step 2 is appended after the 0035 step"
+    );
+    let connection = Connection::open_memory(Some("agent_task_history_label_step_one"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &AgentTaskHistoryDb::MIGRATIONS[..1],
+            &mut |_, _, _| false,
+        )
+        .expect("step 1 alone applies");
+    connection
+        .exec(
+            "INSERT INTO agent_task_history \
+             (session_id, task_id, thread_title, project, kind, description, background, \
+              status, started_at, ended_at, tokens, tool_uses, archived) \
+             VALUES ('s-old', 'fg', 'Old', 'project', 'shell', 'ls -la\nwc -l', 0, \
+                     'completed', 1000, 2000, NULL, NULL, 1), \
+                    ('s-old', 'bg', 'Old', 'project', 'shell', 'sleep 20', 1, \
+                     'interrupted', 3000, 4000, NULL, NULL, 0)",
+        )
+        .and_then(|mut run| run())
+        .expect("rows written by the 0035 schema");
+
+    for _ in 0..2 {
+        connection
+            .migrate(
+                AgentTaskHistoryDb::NAME,
+                AgentTaskHistoryDb::MIGRATIONS,
+                &mut |_, _, _| false,
+            )
+            .expect("the full list applies to a step-1 database, and again as a no-op");
+    }
+
+    let rows = connection
+        .select::<(String, String, String, i64, i64, Option<String>)>(
+            "SELECT task_id, description, status, background, archived, label \
+             FROM agent_task_history ORDER BY task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows,
+        vec![
+            (
+                "bg".into(),
+                "sleep 20".into(),
+                "interrupted".into(),
+                1,
+                0,
+                None
+            ),
+            (
+                "fg".into(),
+                "ls -la\nwc -l".into(),
+                "completed".into(),
+                0,
+                1,
+                None
+            ),
+        ],
+        "every 0035 row survives as it was, with no label"
+    );
+
+    connection
+        .exec("UPDATE agent_task_history SET label = 'Listed files' WHERE task_id = 'fg'")
+        .and_then(|mut run| run())
+        .expect("a migrated row is renamable");
+}
+
+// R3.8, Q12 — every later start of Zeo reopens a step-2 database: the list applies no step
+// again, records each step once, and every label already written survives.
+#[test]
+fn history_db_label_reopening_a_step_two_database_keeps_the_labels() {
+    let connection = Connection::open_memory(Some("agent_task_history_label_reopen"));
+    let migrate = || {
+        connection.migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+    };
+    migrate().expect("the full list applies to an empty database");
+    connection
+        .exec(
+            "INSERT INTO agent_task_history \
+             (session_id, task_id, thread_title, project, kind, description, background, \
+              status, started_at, ended_at, tokens, tool_uses, archived, label) \
+             VALUES ('s1', 'a', 'T', 'project', 'shell', 'ls', 0, \
+                     'completed', 1000, 2000, NULL, NULL, 0, 'Kept label'), \
+                    ('s1', 'b', 'T', 'project', 'shell', 'pwd', 0, \
+                     'completed', 3000, 4000, NULL, NULL, 1, NULL)",
+        )
+        .and_then(|mut run| run())
+        .expect("rows written by the step-2 schema");
+
+    for _ in 0..2 {
+        migrate().expect("reopening a step-2 database is a no-op");
+    }
+
+    let rows = connection
+        .select::<(String, i64, Option<String>)>(
+            "SELECT task_id, archived, label FROM agent_task_history ORDER BY task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows,
+        vec![
+            ("a".into(), 0, Some("Kept label".into())),
+            ("b".into(), 1, None),
+        ],
+        "every label written before the reopen survives it"
+    );
+    let steps = connection
+        .select::<i64>("SELECT COUNT(*) FROM migrations WHERE domain = 'AgentTaskHistoryDb'")
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        steps,
+        vec![2],
+        "each step is recorded once, however often it reopens"
+    );
+}
