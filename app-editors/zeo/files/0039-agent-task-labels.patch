+// Story 022, task 2.1 — one display line, the stored user label, and the label global
+// (R1.3, R1.4, R3.4, R3.7, R5.2). Module path: `task_label::tests`.
+//
+// Declared in `src/task_label.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "task_label/task_label_tests.rs"]
+//     mod tests;
+//
+// Hostile fixtures come before benign ones.
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::SharedString;
+
+use crate::task_label::{
+    TASK_LABEL_MAX_CHARS, TaskLabels, collapse_label, display_label, normalize_user_label,
+};
+
+const HEREDOC: &str = "cat > f <<'EOF'\n{\"a\": 1}\nEOF";
+
+fn key(session: &str, task: &str) -> (acp_v2::SessionId, AgentTaskId) {
+    (
+        acp_v2::SessionId::new(session.to_string()),
+        AgentTaskId::from(task.to_string()),
+    )
+}
+
+fn chars(text: &str) -> usize {
+    text.chars().count()
+}
+
+#[test]
+fn task_label_limit_is_sixty_characters() {
+    assert_eq!(TASK_LABEL_MAX_CHARS, 60);
+}
+
+// ── display_label: one line (R1.3) ─────────────────────────────────────────
+
+// The bug's fixture: a heredoc command.
+#[test]
+fn task_label_display_collapses_a_multi_line_heredoc_to_one_line() {
+    let shown = display_label(HEREDOC);
+    assert_eq!(shown.as_ref(), "cat > f <<'EOF' {\"a\": 1} EOF");
+    assert!(!shown.contains('\n'));
+}
+
+// Hostile: every kind of line break or tab a text system may honour, and runs of them.
+#[test]
+fn task_label_display_collapses_every_whitespace_run_to_one_space() {
+    for (input, expected) in [
+        ("a\r\nb", "a b"),
+        ("a\tb", "a b"),
+        ("a \t\n\r  b", "a b"),
+        ("a\u{0B}b\u{0C}c", "a b c"),
+        ("a\u{85}b\u{2028}c\u{2029}d", "a b c d"),
+        ("\n\n  leading and trailing \t\n", "leading and trailing"),
+    ] {
+        let shown = display_label(input);
+        assert_eq!(shown.as_ref(), expected, "input {input:?}");
+        assert!(
+            !shown.chars().any(|c| c.is_whitespace() && c != ' '),
+            "only plain spaces remain for {input:?}: {shown:?}"
+        );
+    }
+}
+
+// ── display_label: 60 characters (R1.4, R5.2) ──────────────────────────────
+
+// Hostile boundary: exactly 60 characters is NOT longer than 60, so it is not cut.
+#[test]
+fn task_label_display_keeps_exactly_sixty_characters_uncut() {
+    let sixty = "a".repeat(60);
+    assert_eq!(display_label(&sixty).as_ref(), sixty);
+}
+
+// Hostile: the length is counted after collapsing, so whitespace runs never cause a cut.
+#[test]
+fn task_label_display_counts_characters_after_collapsing() {
+    let text = format!("{}\n\n\n\n\t{}", "a".repeat(40), "b".repeat(19));
+    let shown = display_label(&text);
+    assert_eq!(chars(&shown), 60);
+    assert!(
+        !shown.ends_with('…'),
+        "60 collapsed characters are not cut: {shown:?}"
+    );
+}
+
+#[test]
+fn task_label_display_cuts_sixty_one_characters_to_fifty_nine_and_an_ellipsis() {
+    let long = "a".repeat(61);
+    let shown = display_label(&long);
+    assert_eq!(chars(&shown), 60);
+    assert_eq!(shown.as_ref(), format!("{}…", "a".repeat(59)));
+}
+
+// Hostile: multi-byte characters are counted as characters, never split.
+#[test]
+fn task_label_display_counts_multi_byte_characters_and_never_splits_one() {
+    for unit in ["é", "日", "🦀"] {
+        let long = unit.repeat(80);
+        let shown = display_label(&long);
+        assert_eq!(chars(&shown), 60, "{unit}");
+        assert_eq!(shown.as_ref(), format!("{}…", unit.repeat(59)), "{unit}");
+
+        let sixty = unit.repeat(60);
+        assert_eq!(
+            display_label(&sixty).as_ref(),
+            sixty,
+            "{unit}: 60 characters stay"
+        );
+    }
+}
+
+#[test]
+fn task_label_display_cuts_a_long_multi_line_label_after_collapsing() {
+    let text = format!("{}\n{}", "x".repeat(50), "y".repeat(50));
+    let shown = display_label(&text);
+    assert_eq!(
+        shown.as_ref(),
+        format!("{} {}…", "x".repeat(50), "y".repeat(8))
+    );
+}
+
+// R5.2: a one-line label of at most 60 characters is displayed exactly as before.
+#[test]
+fn task_label_display_keeps_a_short_one_line_label_byte_identical() {
+    for label in ["Run the linter", "Task t1", "Explore the task feed", ""] {
+        assert_eq!(display_label(label).as_ref(), label);
+    }
+}
+
+// ── normalize_user_label: what Rename stores (R3.4, R3.7) ──────────────────
+
+// Hostile: blank input is no label at all, whatever the whitespace.
+#[test]
+fn task_label_normalize_returns_none_for_empty_or_whitespace_only_text() {
+    for blank in ["", " ", "\n", " \t\r\n  ", "\u{2028}"] {
+        assert_eq!(normalize_user_label(blank), None, "{blank:?}");
+    }
+}
+
+#[test]
+fn task_label_normalize_keeps_the_first_sixty_characters_without_an_ellipsis() {
+    let long = format!("{}{}", "a".repeat(60), "b".repeat(15));
+    let stored = normalize_user_label(&long).expect("a long label is kept");
+    assert_eq!(stored.as_ref(), "a".repeat(60));
+    assert!(!stored.contains('…'));
+
+    let wide = "日".repeat(75);
+    assert_eq!(
+        normalize_user_label(&wide).expect("kept").as_ref(),
+        "日".repeat(60)
+    );
+}
+
+#[test]
+fn task_label_normalize_collapses_and_trims() {
+    assert_eq!(
+        normalize_user_label("  Fix\n the\t  build  ").map(|l| l.to_string()),
+        Some("Fix the build".to_string())
+    );
+    assert_eq!(
+        normalize_user_label("Run the tests").map(|l| l.to_string()),
+        Some("Run the tests".to_string())
+    );
+}
+
+// ── TaskLabels: keyed by the (session, task) pair (R3.3) ───────────────────
+
+// Hostile (wrong collapse): the same task id in another session, another task id in the same
+// session, and pairs whose parts concatenate alike are different tasks.
+#[test]
+fn task_label_labels_keep_every_other_pair_apart() {
+    let mut labels = TaskLabels::default();
+    labels.set(key("s1", "t1"), Some(SharedString::from("Renamed")));
+    labels.set(key("s:1", "x"), Some(SharedString::from("Colon")));
+
+    assert_eq!(labels.get(&key("s2", "t1")), None);
+    assert_eq!(labels.get(&key("s1", "t2")), None);
+    assert_eq!(labels.get(&key("s1t", "1")), None);
+    assert_eq!(labels.get(&key("s", "1:x")), None);
+    assert_eq!(
+        labels.get(&key("s:1", "x")).map(|l| l.as_ref()),
+        Some("Colon")
+    );
+}
+
+// Hostile (wrong split): a key built from fresh strings finds the label set under equal parts.
+#[test]
+fn task_label_labels_find_a_label_through_an_equal_key_built_separately() {
+    let mut labels = TaskLabels::default();
+    labels.set(key("s1", "t1"), Some(SharedString::from("Renamed")));
+    let session = String::from("s") + "1";
+    let task = String::from("t") + "1";
+    assert_eq!(
+        labels.get(&key(&session, &task)).map(|l| l.as_ref()),
+        Some("Renamed")
+    );
+}
+
+#[test]
+fn task_label_labels_set_none_removes_and_replace_all_replaces() {
+    let mut labels = TaskLabels::default();
+    labels.set(key("s1", "t1"), Some(SharedString::from("First")));
+    labels.set(key("s1", "t1"), Some(SharedString::from("Second")));
+    assert_eq!(
+        labels.get(&key("s1", "t1")).map(|l| l.as_ref()),
+        Some("Second")
+    );
+    labels.set(key("s1", "t1"), None);
+    assert_eq!(labels.get(&key("s1", "t1")), None);
+
+    labels.set(key("stale", "t"), Some(SharedString::from("Stale")));
+    labels.replace_all([(key("s2", "t2"), SharedString::from("Loaded"))]);
+    assert_eq!(
+        labels.get(&key("stale", "t")),
+        None,
+        "replace_all drops what it does not list"
+    );
+    assert_eq!(
+        labels.get(&key("s2", "t2")).map(|l| l.as_ref()),
+        Some("Loaded")
+    );
+}
+
+// ── collapse_label: the full text, on one line, never cut (R1.5, R3.1) ─────
+
+// Hostile: a long multi-line text keeps every character, so the tooltip and the rename editor
+// never lose what `display_label` cuts.
+#[test]
+fn task_label_collapse_keeps_every_character_of_a_long_heredoc_on_one_line() {
+    let body = "x".repeat(200);
+    let text = format!("cat > f <<'EOF'\n{body}\n  EOF\n");
+    let collapsed = collapse_label(&text);
+    assert_eq!(collapsed.as_ref(), format!("cat > f <<'EOF' {body} EOF"));
+    assert!(!collapsed.contains('\n'));
+    assert!(!collapsed.contains('…'));
+}
