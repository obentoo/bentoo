+// R3.3 — a user label replaces the description in the open card, at once, and only on its own
+// task. Hostile: thread B holds the same task id.
+#[gpui::test]
+async fn test_label_user_label_replaces_the_description_of_its_task_only(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    let b = open_titled_thread(&panel, &connection, "B", &mut cx);
+    send_tasks(&b, vec![wire_task("t1", "running", true, 2_000)], &mut cx);
+    let session_a = session_of(&a, &cx);
+    assert_ne!(session_a, session_of(&b, &cx));
+    assert_eq!(count(&a11y_strings(&mut cx), "Watch: Task t1"), 2);
+
+    set_label(
+        (session_a.clone(), AgentTaskId::from("t1")),
+        Some("Renamed by the user"),
+        &mut cx,
+    );
+    let strings = a11y_strings(&mut cx);
+    assert_eq!(
+        count(&strings, "Watch: Renamed by the user"),
+        1,
+        "A's row, repainted without a new snapshot"
+    );
+    assert_eq!(
+        count(&strings, "Watch: Task t1"),
+        1,
+        "B's row keeps its description"
+    );
+
+    set_label((session_a, AgentTaskId::from("t1")), None, &mut cx);
+    let strings = a11y_strings(&mut cx);
+    assert_eq!(count(&strings, "Watch: Renamed by the user"), 0);
+    assert_eq!(
+        count(&strings, "Watch: Task t1"),
+        2,
+        "a removed label shows the description again"
+    );
+}
