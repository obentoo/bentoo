+// R1.6 — every control's screen-reader label names the task by its displayed label.
+#[gpui::test]
+async fn test_label_screen_reader_labels_use_the_displayed_label(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    let long = format!("{} {}", "a".repeat(30), "b".repeat(40));
+    let long_shown = format!("{}…", long.chars().take(59).collect::<String>());
+    send_tasks(
+        &a,
+        vec![
+            described("multi", HEREDOC, 1_000),
+            described("long", &long, 2_000),
+        ],
+        &mut cx,
+    );
+    let strings = a11y_strings(&mut cx);
+
+    for prefix in ["Watch", "Open in thread", "Stop"] {
+        assert_eq!(
+            count(&strings, &format!("{prefix}: {HEREDOC_SHOWN}")),
+            1,
+            "{prefix}"
+        );
+        assert_eq!(
+            count(&strings, &format!("{prefix}: {long_shown}")),
+            1,
+            "{prefix}"
+        );
+    }
+    assert!(
+        !strings
+            .iter()
+            .any(|text| text.starts_with("Watch:") && text.contains('\n')),
+        "no screen-reader label carries a line break"
+    );
+    assert!(!strings.iter().any(|text| *text == format!("Watch: {long}")));
+}
