+// Zeo next proposal §6.49 (ask 73): lists per project and global, as the view draws them.
+
+use super::*;
+
+const THIS_PROJECT: &str = "LISTS_SECTION-This Project";
+const GLOBAL: &str = "LISTS_SECTION-Global";
+
+/// With alpha active: alpha's list under "This Project", then the global one under "Global";
+/// beta's list is hidden until beta is active.
+#[gpui::test]
+async fn the_active_projects_lists_come_first_and_anothers_are_hidden(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Inbox", cx);
+    create_list_of("/beta", "Beta work", cx);
+    create_alpha_list("Alpha work", cx);
+    open_lists_view(&sidebar, cx);
+
+    assert_top_to_bottom(
+        &[
+            THIS_PROJECT,
+            header("Alpha work", 0),
+            GLOBAL,
+            header("Inbox", 0),
+        ],
+        cx,
+    );
+    assert!(!shown(header("Beta work", 0), cx), "another project's list");
+    assert!(shown("LISTS_NEW_GLOBAL_LIST", cx), "a project is active");
+}
+
+/// No project list to show: the view keeps its single, unheaded run of global lists.
+#[gpui::test]
+async fn without_a_project_list_there_are_no_section_headings(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Inbox", cx);
+    create_list_of("/beta", "Beta work", cx);
+    open_lists_view(&sidebar, cx);
+
+    assert!(shown(header("Inbox", 0), cx));
+    assert!(!shown(THIS_PROJECT, cx));
+    assert!(!shown(GLOBAL, cx));
+}
+
+/// "New List" while alpha is active makes an alpha list, shown under "This Project".
+#[gpui::test]
+async fn new_list_makes_a_list_of_the_active_project(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Inbox", cx);
+    open_lists_view(&sidebar, cx);
+    click(NEW_LIST, cx);
+    assert!(shown(NAME_FIELD, cx), "fixture: the name field is open");
+    type_name("Alpha work", cx);
+    press_enter(cx);
+
+    assert_top_to_bottom(
+        &[
+            THIS_PROJECT,
+            header("Alpha work", 0),
+            GLOBAL,
+            header("Inbox", 0),
+        ],
+        cx,
+    );
+}
