new file mode 100644
index 0000000..63f64a2
--- /dev/null
+++ b/crates/sidebar/src/lists_view/list_scopes.rs
@@ -0,0 +1,144 @@
+//! Lists per project and global (Zeo next proposal §6.49, ask 73), as pins already are (§6.5).
+//!
+//! While a project is active, the Lists view shows that project's lists first, under "This
+//! Project", then the global lists under "Global"; another project's lists are hidden until that
+//! project is active, as `0106` hides its pins. Without a project list to show, the view keeps its
+//! single, unheaded run of lists. "New List" makes a list of the active project, as a plain "Pin"
+//! pins to the project; "New Global List" makes a global one. The scope itself is the store's
+//! (`ThreadListScopeStore`), and every rule a scope change must meet is checked there.
+
+use agent_ui::ThreadId;
+use agent_ui::thread_organization::list_scope::thread_project;
+use agent_ui::thread_organization::{ListId, ProjectKey, ThreadOrganizationStore};
+use ui::prelude::*;
+
+use crate::Sidebar;
+
+pub(crate) const THIS_PROJECT_SECTION: &str = "This Project";
+pub(crate) const GLOBAL_SECTION: &str = "Global";
+
+/// The lists the Lists view shows, split by scope, each in the store's order. Generic over the
+/// list and the scope key so the rule is tested without a store.
+#[derive(Debug, PartialEq)]
+pub(crate) struct ScopedLists<L> {
+    /// The active project's lists; empty without an active project.
+    pub(crate) this_project: Vec<L>,
+    pub(crate) global: Vec<L>,
+}
+
+/// Splits `lists` into the active project's and the global ones. A list of any other project is
+/// in neither, so it is not shown.
+pub(crate) fn scoped_lists<L: Clone, K: PartialEq>(
+    lists: &[L],
+    scope_of: impl Fn(&L) -> Option<K>,
+    active: Option<&K>,
+) -> ScopedLists<L> {
+    let mut scoped = ScopedLists {
+        this_project: Vec::new(),
+        global: Vec::new(),
+    };
+    for list in lists {
+        match scope_of(list) {
+            None => scoped.global.push(list.clone()),
+            Some(project) if Some(&project) == active => scoped.this_project.push(list.clone()),
+            Some(_) => {}
+        }
+    }
+    scoped
+}
+
+/// The index in the store's order that "Move Up" (`up`) or "Move Down" takes the list at `index`
+/// to: the place of the nearest list of the same scope in that direction, so a list never trades
+/// places with one the view does not show. `None` when it is already first or last of its scope.
+pub(crate) fn same_scope_neighbor<L, K: PartialEq>(
+    lists: &[L],
+    index: usize,
+    up: bool,
+    scope_of: impl Fn(&L) -> Option<K>,
+) -> Option<usize> {
+    let scope = scope_of(lists.get(index)?);
+    if up {
+        lists[..index]
+            .iter()
+            .rposition(|candidate| scope_of(candidate) == scope)
+    } else {
+        lists[index + 1..]
+            .iter()
+            .position(|candidate| scope_of(candidate) == scope)
+            .map(|offset| index + 1 + offset)
+    }
+}
+
+/// The scope a list made for a thread from its menu ("New List…") gets: the thread's project when
+/// that is the active one, so the new list is shown and the filing is allowed; global otherwise.
+pub(crate) fn scope_for_thread_list<K: PartialEq>(
+    thread_project: Option<K>,
+    active: Option<&K>,
+) -> Option<K> {
+    thread_project.filter(|project| Some(project) == active)
+}
+
+impl Sidebar {
+    /// The active project, as the lists' scope names it.
+    pub(crate) fn active_project_key(&self, cx: &App) -> Option<ProjectKey> {
+        self.active_project_group_key(cx)
+            .map(|key| ProjectKey::from_group(&key))
+    }
+
+    /// "Make Global" (`to_project: false`) or "Move to This Project". The store refuses a name
+    /// taken in the new scope and a list holding another project's threads; the menu offers the
+    /// second only when it would be accepted, so a refusal here means another window changed the
+    /// list since the menu opened.
+    pub(crate) fn set_list_scope_from_header(
+        &mut self,
+        list_id: ListId,
+        to_project: bool,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let project = if to_project {
+            let Some(active) = self.active_project_key(cx) else {
+                return;
+            };
+            Some(active)
+        } else {
+            None
+        };
+        if let Err(error) = store.update(cx, |store, cx| store.set_list_scope(list_id, project, cx))
+        {
+            log::warn!("sidebar: scope change refused for list {list_id}: {error}");
+        }
+    }
+
+    /// The scope "New List…" from a thread's menu creates the list in.
+    pub(crate) fn scope_for_new_list_of(
+        &self,
+        thread_id: ThreadId,
+        cx: &App,
+    ) -> Option<ProjectKey> {
+        scope_for_thread_list(
+            thread_project(thread_id, cx),
+            self.active_project_key(cx).as_ref(),
+        )
+    }
+}
+
+/// Whether "Move to This Project" applies to `list`: a global list, an active project, and every
+/// thread in it of that project.
+pub(crate) fn can_move_to_project(list: ListId, active: Option<&ProjectKey>, cx: &App) -> bool {
+    let (Some(active), Some(store)) = (active, ThreadOrganizationStore::try_global(cx)) else {
+        return false;
+    };
+    let store = store.read(cx);
+    store.list_project(list, cx).is_none()
+        && store
+            .threads_in_list(list)
+            .into_iter()
+            .all(|thread_id| thread_project(thread_id, cx).as_ref() == Some(active))
+}
