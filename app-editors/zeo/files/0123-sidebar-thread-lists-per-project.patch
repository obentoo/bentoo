+/// The scope store over its own test database, installed as the global the organization store
+/// reads.
+async fn install_scopes(name: &'static str, cx: &mut TestAppContext) -> ThreadListScopeDb {
+    let db = ThreadListScopeDb::open_test_db(name).await;
+    open_scopes(&db, cx);
+    db
+}
+
+fn open_scopes(db: &ThreadListScopeDb, cx: &mut TestAppContext) {
+    let db = db.clone();
+    let store = cx.new(|cx| ThreadListScopeStore::with_fallback_flag(db, false, cx));
+    cx.update(|cx| cx.set_global(GlobalThreadListScopeStore(store)));
+    cx.run_until_parked();
+}
+
+/// A restart of both stores: each loads its own database again.
+fn restart_both(
+    store: Entity<ThreadOrganizationStore>,
+    db: &ThreadOrganizationDb,
+    scopes: &ThreadListScopeDb,
+    cx: &mut TestAppContext,
+) -> Entity<ThreadOrganizationStore> {
+    cx.run_until_parked();
+    cx.update(|cx| cx.remove_global::<GlobalThreadListScopeStore>());
+    cx.run_until_parked();
+    open_scopes(scopes, cx);
+    restart(store, db, cx)
+}
