diff --git a/crates/agent_ui/src/thread_organization/list_scope.rs b/crates/agent_ui/src/thread_organization/list_scope.rs
new file mode 100644
index 0000000..7bbe54e
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/list_scope.rs
@@ -0,0 +1,315 @@
+//! Zeo next proposal §6.49 (ask 73): a list is global or belongs to a project, as a pin is
+//! (§6.5). A project's lists are shown while that project is the active one, above the global
+//! lists; another project's are hidden until it is.
+//!
+//! The list itself -- its name, order and members -- stays where `0048` keeps it. Only the scope
+//! lives here, in a domain of its own for the reason `pin_scope` gives: `0048`'s migration list is
+//! appended to by `0063` under a USE flag, so a step appended by an earlier patch would sit at a
+//! different index with and without the flag. A row in `thread_list_scope` means "this list
+//! belongs to that project"; no row means global, so every list made before this patch stays
+//! global and nothing migrates.
+//!
+//! Only `ThreadOrganizationStore` writes a scope: it also rewrites the list's `name_key`, which
+//! carries the project so two projects can each have a list of the same name.
+
+use std::collections::HashMap;
+use std::sync::atomic::Ordering;
+
+use anyhow::{Context as _, Result};
+use db::{
+    sqlez::{domain::Domain, thread_safe_connection::ThreadSafeConnection},
+    sqlez_macros::sql,
+};
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{App, AppContext as _, Context, Entity, Global, Task};
+use project::ProjectGroupKey;
+
+use super::{
+    DbWrite, ListId, OrganizeError, ProjectKey, ThreadList, ThreadOrganizationStore,
+    normalize_list_name,
+};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+pub(crate) struct ThreadListScopeDb(ThreadSafeConnection);
+
+static LIST_SCOPE_MIGRATIONS: [&str; 1] = ["CREATE TABLE thread_list_scope(
+    list_id INTEGER PRIMARY KEY NOT NULL,
+    project_key TEXT NOT NULL
+) STRICT;"];
+
+impl Domain for ThreadListScopeDb {
+    const NAME: &str = stringify!(ThreadListScopeDb);
+    const MIGRATIONS: &[&str] = &LIST_SCOPE_MIGRATIONS;
+}
+
+db::static_connection!(ThreadListScopeDb, []);
+
+pub(super) struct GlobalThreadListScopeStore(pub(super) Entity<ThreadListScopeStore>);
+
+impl Global for GlobalThreadListScopeStore {}
+
+pub fn init(cx: &mut App) {
+    let db = ThreadListScopeDb::global(cx);
+    let store = cx.new(|cx| ThreadListScopeStore::new(db, cx));
+    cx.set_global(GlobalThreadListScopeStore(store));
+}
+
+enum ListScopeWrite {
+    Project(ListId, ProjectKey),
+    Global(ListId),
+}
+
+pub struct ThreadListScopeStore {
+    projects: HashMap<ListId, ProjectKey>,
+    /// `None` when loading failed or the database is the in-memory fallback: the session's
+    /// scopes stay in memory.
+    writes: Option<mpsc::UnboundedSender<ListScopeWrite>>,
+    _writer: Task<()>,
+}
+
+impl ThreadListScopeStore {
+    pub fn global(cx: &App) -> Entity<Self> {
+        cx.global::<GlobalThreadListScopeStore>().0.clone()
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalThreadListScopeStore>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(db: ThreadListScopeDb, cx: &mut Context<Self>) -> Self {
+        let on_fallback = db::ALL_FILE_DB_FAILED.load(Ordering::Acquire);
+        Self::with_fallback_flag(db, on_fallback, cx)
+    }
+
+    pub(super) fn with_fallback_flag(
+        db: ThreadListScopeDb,
+        on_fallback: bool,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let mut store = Self {
+            projects: HashMap::default(),
+            writes: None,
+            _writer: Task::ready(()),
+        };
+        if on_fallback {
+            log::warn!("thread_list_scope: database unavailable, list scopes will not persist");
+        }
+        match load(&db) {
+            Ok(projects) => store.projects = projects,
+            Err(error) => {
+                log::warn!(
+                    "thread_list_scope: loading failed, list scopes will not persist this \
+                     session: {error:#}"
+                );
+                return store;
+            }
+        }
+        let (writes, mut queue) = mpsc::unbounded::<ListScopeWrite>();
+        store.writes = Some(writes);
+        store._writer = cx.background_spawn(async move {
+            while let Some(write) = queue.next().await {
+                let (operation, list_id) = match &write {
+                    ListScopeWrite::Project(list_id, _) => ("project", *list_id),
+                    ListScopeWrite::Global(list_id) => ("global", *list_id),
+                };
+                if let Err(error) = db.write(move |connection| apply(connection, write)).await {
+                    log::error!(
+                        "thread_list_scope: setting {operation} failed for list {list_id}: \
+                         {error:#}"
+                    );
+                }
+            }
+        });
+        store
+    }
+
+    /// The project `list` belongs to, or `None` for a global list.
+    pub fn project_of(&self, list: ListId) -> Option<&ProjectKey> {
+        self.projects.get(&list)
+    }
+
+    /// Scopes `list` to `project`, or back to global for `None`. Only the organization store
+    /// calls this, after checking the name and the members against the new scope.
+    pub(super) fn set_scope(
+        &mut self,
+        list: ListId,
+        project: Option<ProjectKey>,
+        cx: &mut Context<Self>,
+    ) {
+        let write = match project {
+            Some(project) => {
+                if self.projects.get(&list) == Some(&project) {
+                    return;
+                }
+                self.projects.insert(list, project.clone());
+                ListScopeWrite::Project(list, project)
+            }
+            None => {
+                if self.projects.remove(&list).is_none() {
+                    return;
+                }
+                ListScopeWrite::Global(list)
+            }
+        };
+        if let Some(writes) = &self.writes
+            && let Err(error) = writes.unbounded_send(write)
+        {
+            log::error!("thread_list_scope: the writer stopped, a change was not saved: {error}");
+        }
+        cx.notify();
+    }
+}
+
+/// The project `list` belongs to; `None` for a global list, and for every list without the
+/// scope store, where lists are global as they were before §6.49.
+pub(super) fn list_scope_of(list: ListId, cx: &App) -> Option<ProjectKey> {
+    ThreadListScopeStore::try_global(cx).and_then(|store| store.read(cx).project_of(list).cloned())
+}
+
+/// The `name_key` `thread_lists` stores: the lowercase name for a global list, as before §6.49;
+/// prefixed with the project for a project list, so the column's `UNIQUE` holds per project. The
+/// project key is JSON and never contains the unit separator, and never starts with the space
+/// the placeholder keys of a rewrite start with.
+pub(super) fn list_name_key(scope: Option<&ProjectKey>, name: &str) -> String {
+    let key = name.to_lowercase();
+    match scope {
+        None => key,
+        Some(project) => format!("{}\u{1f}{key}", project.0),
+    }
+}
+
+/// A deleted list's scope goes with it.
+pub(super) fn forget_list_scope(list: ListId, cx: &mut App) {
+    if let Some(store) = ThreadListScopeStore::try_global(cx) {
+        store.update(cx, |store, cx| store.set_scope(list, None, cx));
+    }
+}
+
+/// The project of a saved thread, derived from the thread alone, as the sidebar groups it.
+pub fn thread_project(thread_id: ThreadId, cx: &App) -> Option<ProjectKey> {
+    let metadata = ThreadMetadataStore::try_global(cx)?;
+    let metadata = metadata.read(cx);
+    let entry = metadata.entry(thread_id)?;
+    Some(ProjectKey::from_group(
+        &ProjectGroupKey::from_worktree_paths(
+            &entry.worktree_paths,
+            entry.remote_connection.clone(),
+        ),
+    ))
+}
+
+impl ThreadOrganizationStore {
+    /// The project `list` belongs to, or `None` for a global list.
+    pub fn list_project(&self, list: ListId, cx: &App) -> Option<ProjectKey> {
+        list_scope_of(list, cx)
+    }
+
+    /// A new list in `project`, or a global one for `None`. Without the scope store every list is
+    /// global, so `project` is dropped rather than refused.
+    pub fn create_list_in(
+        &mut self,
+        name: &str,
+        project: Option<ProjectKey>,
+        cx: &mut Context<Self>,
+    ) -> Result<ListId, OrganizeError> {
+        let scopes = ThreadListScopeStore::try_global(cx);
+        let project = project.filter(|_| scopes.is_some());
+        let (key, display) = normalize_list_name(name)?;
+        if let Some(existing) = self.list_with_key(&key, project.as_ref(), cx) {
+            return Err(OrganizeError::DuplicateListName { list_id: existing });
+        }
+        let id = ListId(self.next_list_id);
+        self.next_list_id += 1;
+        self.lists.push(ThreadList { id, name: display });
+        // Before the positions are written: the list's `name_key` carries its scope.
+        if let (Some(scopes), Some(project)) = (scopes, project) {
+            scopes.update(cx, |scopes, cx| scopes.set_scope(id, Some(project), cx));
+        }
+        let mut write = DbWrite::new("create_list");
+        self.write_list_positions(&mut write, cx);
+        self.commit(write, cx);
+        Ok(id)
+    }
+
+    /// "Make Global" (`None`) and "Move to This Project" (`Some`). A list moves to a project only
+    /// when every thread in it belongs to that project, so no thread is left in a list its
+    /// project cannot show; and the name must be free in the new scope.
+    pub fn set_list_scope(
+        &mut self,
+        list: ListId,
+        project: Option<ProjectKey>,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        let index = self.list_index(list)?;
+        let Some(scopes) = ThreadListScopeStore::try_global(cx) else {
+            return Ok(());
+        };
+        if list_scope_of(list, cx) == project {
+            return Ok(());
+        }
+        if let Some(project) = &project
+            && self
+                .threads_in_list(list)
+                .into_iter()
+                .any(|thread_id| thread_project(thread_id, cx).as_ref() != Some(project))
+        {
+            return Err(OrganizeError::ListHoldsOtherProjects { list_id: list });
+        }
+        let key = self.lists[index].name.to_lowercase().into();
+        if let Some(existing) = self.list_with_key(&key, project.as_ref(), cx) {
+            return Err(OrganizeError::DuplicateListName { list_id: existing });
+        }
+        scopes.update(cx, |scopes, cx| scopes.set_scope(list, project, cx));
+        let mut write = DbWrite::new("set_list_scope");
+        self.write_list_positions(&mut write, cx);
+        self.commit(write, cx);
+        Ok(())
+    }
+
+    /// A thread is filed in a global list, or in a list of its own project.
+    pub(super) fn admit_to_list_scope(
+        &self,
+        thread_id: ThreadId,
+        list: ListId,
+        cx: &App,
+    ) -> Result<(), OrganizeError> {
+        match list_scope_of(list, cx) {
+            None => Ok(()),
+            Some(project) if thread_project(thread_id, cx).as_ref() == Some(&project) => Ok(()),
+            Some(_) => Err(OrganizeError::ListOfAnotherProject {
+                list_id: list,
+                thread_id,
+            }),
+        }
+    }
+}
+
+fn apply(connection: &db::sqlez::connection::Connection, write: ListScopeWrite) -> Result<()> {
+    match write {
+        ListScopeWrite::Project(list_id, project) => {
+            connection.exec_bound::<(i64, String)>(sql!(
+                INSERT INTO thread_list_scope(list_id, project_key) VALUES (?, ?)
+                ON CONFLICT(list_id) DO UPDATE SET project_key = excluded.project_key
+            ))?((list_id.0, project.0.to_string()))
+        }
+        ListScopeWrite::Global(list_id) => connection.exec_bound::<i64>(sql!(
+            DELETE FROM thread_list_scope WHERE list_id = ?
+        ))?(list_id.0),
+    }
+}
+
+fn load(db: &ThreadListScopeDb) -> Result<HashMap<ListId, ProjectKey>> {
+    let rows = db.select::<(i64, String)>(sql!(
+        SELECT list_id, project_key FROM thread_list_scope
+    ))?()
+    .context("reading thread_list_scope")?;
+    Ok(rows
+        .into_iter()
+        .map(|(list_id, project)| (ListId(list_id), ProjectKey(project.into())))
+        .collect())
+}
