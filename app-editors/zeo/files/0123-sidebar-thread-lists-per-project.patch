@@ -0,0 +1,76 @@
+// Zeo next proposal §6.49 (ask 73): which lists the Lists view shows, and where Move Up/Down
+// take one. Filter: `lists_view::list_scopes::tests`.
+
+use pretty_assertions::assert_eq;
+
+use super::*;
+
+/// `(name, scope)`: the rule reads a list only through `scope_of`, so a name stands in for it.
+const LISTS: &[(&str, Option<&str>)] = &[
+    ("Inbox", None),
+    ("A bugs", Some("A")),
+    ("B bugs", Some("B")),
+    ("Later", None),
+    ("A ideas", Some("A")),
+];
+
+fn scope_of(list: &(&'static str, Option<&'static str>)) -> Option<&'static str> {
+    list.1
+}
+
+fn names(lists: &[(&'static str, Option<&'static str>)]) -> Vec<&'static str> {
+    lists.iter().map(|list| list.0).collect()
+}
+
+#[test]
+fn with_a_project_active_its_lists_come_first_and_anothers_are_hidden() {
+    let scoped = scoped_lists(LISTS, scope_of, Some(&"A"));
+    assert_eq!(names(&scoped.this_project), vec!["A bugs", "A ideas"]);
+    assert_eq!(names(&scoped.global), vec!["Inbox", "Later"]);
+
+    let scoped = scoped_lists(LISTS, scope_of, Some(&"B"));
+    assert_eq!(names(&scoped.this_project), vec!["B bugs"]);
+    assert_eq!(names(&scoped.global), vec!["Inbox", "Later"]);
+}
+
+#[test]
+fn without_an_active_project_only_global_lists_show() {
+    let scoped = scoped_lists(LISTS, scope_of, None);
+    assert!(scoped.this_project.is_empty());
+    assert_eq!(names(&scoped.global), vec!["Inbox", "Later"]);
+}
+
+#[test]
+fn a_project_without_lists_shows_the_global_ones_alone() {
+    let scoped = scoped_lists(LISTS, scope_of, Some(&"C"));
+    assert!(scoped.this_project.is_empty());
+    assert_eq!(names(&scoped.global), vec!["Inbox", "Later"]);
+}
+
+/// Move Up/Down skip lists of another scope, which the view does not show beside this one.
+#[test]
+fn move_up_and_down_go_to_the_nearest_list_of_the_same_scope() {
+    // "A ideas" (4) up: past "Later" (global) and "B bugs" to "A bugs" (1).
+    assert_eq!(same_scope_neighbor(LISTS, 4, true, scope_of), Some(1));
+    // "A bugs" (1) down: to "A ideas" (4).
+    assert_eq!(same_scope_neighbor(LISTS, 1, false, scope_of), Some(4));
+    // "Inbox" (0) down: past two project lists to "Later" (3).
+    assert_eq!(same_scope_neighbor(LISTS, 0, false, scope_of), Some(3));
+    // First and last of a scope go nowhere.
+    assert_eq!(same_scope_neighbor(LISTS, 0, true, scope_of), None);
+    assert_eq!(same_scope_neighbor(LISTS, 3, false, scope_of), None);
+    assert_eq!(same_scope_neighbor(LISTS, 2, true, scope_of), None);
+    assert_eq!(
+        same_scope_neighbor(LISTS, 9, true, scope_of),
+        None,
+        "no such list"
+    );
+}
+
+#[test]
+fn a_list_made_from_a_threads_menu_is_its_project_only_when_that_is_active() {
+    assert_eq!(scope_for_thread_list(Some("A"), Some(&"A")), Some("A"));
+    assert_eq!(scope_for_thread_list(Some("B"), Some(&"A")), None);
+    assert_eq!(scope_for_thread_list(Some("A"), None), None);
+    assert_eq!(scope_for_thread_list(None::<&str>, Some(&"A")), None);
+}
