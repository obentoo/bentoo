@@ -0,0 +1,488 @@
+//! IDE-side implementation of the Claude Code editor integration protocol.
+//!
+//! This lets the Claude Code CLI connect to Zed the same way it connects to the
+//! official VS Code and JetBrains extensions: Zed runs a localhost WebSocket
+//! server speaking a WebSocket variant of MCP, advertises it through a lock file
+//! under `~/.claude/ide/`, and points the CLI at it via the `CLAUDE_CODE_SSE_PORT`
+//! and `ENABLE_IDE_INTEGRATION` environment variables in its integrated terminal.
+//!
+//! [`init`] wires one [`ClaudeCodeIdeServer`] per [`Workspace`]: it binds a
+//! loopback port, writes the lock file, and serves connections until the window
+//! closes, at which point the lock file is removed.
+
+mod lockfile;
+mod open_diff;
+mod selection;
+mod selection_watch;
+mod server;
+mod tools;
+
+use std::{cell::Cell, cell::RefCell, path::PathBuf, rc::Rc};
+
+use anyhow::{Context as _, Result};
+use collections::HashMap;
+use command_palette_hooks::CommandPaletteFilter;
+use editor::{Editor, EditorEvent};
+use futures::channel::mpsc;
+use gpui::{
+    AnyWindowHandle, App, AppContext as _, AsyncApp, Context, Entity, EntityId, Subscription, Task,
+    WeakEntity,
+};
+use project::{DisableAiSettings, Project};
+use release_channel::ReleaseChannel;
+use selection_watch::{Connection, SelectionHub};
+use settings::{Settings as _, SettingsStore};
+use util::ResultExt as _;
+use workspace::{Toast, Workspace, notifications::NotificationId};
+use zed_actions::claude_code_ide::MentionSelectionInClaudeCode;
+
+pub use lockfile::generate_auth_token;
+pub use selection::{
+    EditorSelection, SelectionFeed, SelectionPoint, selection_changed_notification,
+};
+pub use server::{Dispatcher, ProtocolError, ToolDescriptor, bind, serve_connection};
+pub use tools::WorkspaceDispatcher;
+
+/// Registers a Claude Code IDE server for every workspace window.
+///
+/// Call once during app startup. Each created [`Workspace`] gets its own server
+/// entity, kept alive in `servers` for the window's lifetime and dropped (which
+/// removes its lock file) when the workspace is released.
+pub fn init(cx: &mut App) {
+    // The mention action talks to an AI tool, so it leaves the palette with the
+    // rest of them when AI is disabled; the editor's menu checks the same flag.
+    update_command_palette_filter(cx);
+    cx.observe_global::<SettingsStore>(update_command_palette_filter)
+        .detach();
+
+    let servers: Rc<RefCell<HashMap<EntityId, Entity<ClaudeCodeIdeServer>>>> = Rc::default();
+    cx.observe_new({
+        let servers = servers.clone();
+        move |workspace: &mut Workspace, window, cx: &mut Context<Workspace>| {
+            let workspace_id = cx.entity_id();
+            let workspace_handle = cx.entity().downgrade();
+            let project = workspace.project().clone();
+            let window_handle = window.map(|window| window.window_handle());
+            let server =
+                cx.new(|cx| ClaudeCodeIdeServer::new(workspace_handle, project, window_handle, cx));
+            let mention_server = server.downgrade();
+            servers.borrow_mut().insert(workspace_id, server);
+
+            // The handler runs inside this workspace's update, so the selection is
+            // read here, from the `&mut Workspace` it is given, and never through
+            // the server's workspace handle, which is leased at this point.
+            workspace.register_action(
+                move |workspace, _: &MentionSelectionInClaudeCode, _window, cx| {
+                    let Some(server) = mention_server.upgrade() else {
+                        return;
+                    };
+                    let item = workspace.active_item(cx);
+                    let observed = selection_watch::observe_active_item(item, cx);
+                    let outcome = server.update(cx, |server, _| server.mention(observed));
+                    if let Some(message) = outcome.message() {
+                        workspace.show_toast(
+                            Toast::new(NotificationId::unique::<ClaudeCodeMention>(), message),
+                            cx,
+                        );
+                    }
+                },
+            );
+
+            cx.on_release({
+                let servers = servers.clone();
+                move |_workspace, _cx| {
+                    servers.borrow_mut().remove(&workspace_id);
+                }
+            })
+            .detach();
+        }
+    })
+    .detach();
+
+    // Lock files are removed when a window closes (see `Drop`), but a hard quit
+    // skips destructors, so clean them up explicitly on app exit too.
+    // The last use of `servers`, so it moves in rather than being cloned.
+    cx.on_app_quit(move |cx| {
+        for server in servers.borrow().values() {
+            server.update(cx, |server, _| server.remove_lockfile());
+        }
+        async move {}
+    })
+    .detach();
+}
+
+fn update_command_palette_filter(cx: &mut App) {
+    let disable_ai = DisableAiSettings::get_global(cx).disable_ai;
+    CommandPaletteFilter::update_global(cx, |filter, _| {
+        if disable_ai {
+            filter.hide_namespace("claude_code_ide");
+        } else {
+            filter.show_namespace("claude_code_ide");
+        }
+    });
+}
+
+/// Distinguishes the mention toast from others in the notification registry.
+struct ClaudeCodeMention;
+
+/// What a mention came to, as far as the user must be told.
+#[derive(Debug, PartialEq, Eq)]
+enum MentionOutcome {
+    Sent,
+    NoSession,
+    NoFile,
+}
+
+impl MentionOutcome {
+    fn message(&self) -> Option<&'static str> {
+        match self {
+            Self::Sent => None,
+            Self::NoSession => Some("No Claude Code session is connected to this workspace"),
+            Self::NoFile => Some("The active editor has no file to mention"),
+        }
+    }
+}
+
+/// One running WebSocket server, bound to a single workspace window.
+struct ClaudeCodeIdeServer {
+    /// Set once the listener is bound; read by `Drop` to remove the lock file.
+    /// Shared with the accept-loop task, which is the writer.
+    port: Rc<Cell<Option<u16>>>,
+    /// Set alongside `port`, and kept so the lock file can be rewritten when the
+    /// workspace's folders change without minting a new token.
+    auth_token: Rc<RefCell<Option<String>>>,
+    /// Read back when rewriting the lock file, to list the current folders.
+    workspace: WeakEntity<Workspace>,
+    /// The bind + accept loop. Dropping it (when the workspace closes) cancels
+    /// the loop, stopping the server.
+    _server_task: Task<()>,
+    /// Keeps us subscribed to the project's worktree changes.
+    _worktrees_subscription: Subscription,
+    /// What the selection tools answer and `selection_changed` carries, with
+    /// every live connection of this workspace's CLI sessions.
+    selection: Rc<RefCell<SelectionHub>>,
+    _workspace_subscription: Option<Subscription>,
+    /// The active editor's selection changes; replaced when the active item is.
+    _editor_subscription: Option<Subscription>,
+}
+
+impl ClaudeCodeIdeServer {
+    fn new(
+        workspace: WeakEntity<Workspace>,
+        project: Entity<Project>,
+        window: Option<AnyWindowHandle>,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let port = Rc::new(Cell::new(None));
+        let auth_token = Rc::new(RefCell::new(None));
+        let selection = Rc::new(RefCell::new(SelectionHub::default()));
+        let server_task = cx.spawn({
+            let port = port.clone();
+            let auth_token = auth_token.clone();
+            let workspace = workspace.clone();
+            let selection = selection.clone();
+            async move |_this, cx| {
+                let shared = Shared {
+                    port,
+                    auth_token,
+                    selection,
+                };
+                if let Err(error) = Self::run(workspace, window, shared, cx).await {
+                    log::error!("Claude Code IDE server stopped: {error:#}");
+                }
+            }
+        });
+
+        // A workspace's folders are not loaded yet when it is first observed, and
+        // some workspaces never get any -- every window opens with one, and the
+        // projects of its sidebar arrive as workspaces of their own. The CLI
+        // matches its working directory against the folder list to pick an IDE,
+        // so the lock file is published only while there are folders, and
+        // re-published whenever the set changes.
+        let worktrees_subscription =
+            cx.subscribe(&project, |this, _project, event: &project::Event, cx| {
+                if matches!(
+                    event,
+                    project::Event::WorktreeAdded(_)
+                        | project::Event::WorktreeRemoved(_)
+                        | project::Event::WorktreeOrderChanged
+                ) {
+                    this.rewrite_lockfile(cx);
+                }
+            });
+
+        let workspace_subscription = workspace.upgrade().map(|workspace| {
+            cx.subscribe(
+                &workspace,
+                |this, workspace, event: &workspace::Event, cx| {
+                    if matches!(event, workspace::Event::ActiveItemChanged) {
+                        this.watch_active_editor(&workspace, cx);
+                        this.selection_changed(cx);
+                    }
+                },
+            )
+        });
+
+        Self {
+            port,
+            auth_token,
+            workspace,
+            _server_task: server_task,
+            _worktrees_subscription: worktrees_subscription,
+            selection,
+            _workspace_subscription: workspace_subscription,
+            _editor_subscription: None,
+        }
+    }
+
+    fn watch_active_editor(&mut self, workspace: &Entity<Workspace>, cx: &mut Context<Self>) {
+        let editor = workspace
+            .read(cx)
+            .active_item(cx)
+            .and_then(|item| item.act_as::<Editor>(cx));
+        self._editor_subscription = editor.map(|editor| {
+            cx.subscribe(&editor, |this, _editor, event: &EditorEvent, cx| {
+                if matches!(event, EditorEvent::SelectionsChanged { .. }) {
+                    this.selection_changed(cx);
+                }
+            })
+        });
+    }
+
+    fn mention(&mut self, observed: selection::ObservedSelection) -> MentionOutcome {
+        let mut hub = self.selection.borrow_mut();
+        hub.observe(observed);
+        let Some(selection) = hub.state().current().cloned() else {
+            return if hub.send_now_count() == 0 {
+                MentionOutcome::NoSession
+            } else {
+                MentionOutcome::NoFile
+            };
+        };
+        if hub.send_now(selection::at_mentioned_notification(&selection)) == 0 {
+            MentionOutcome::NoSession
+        } else {
+            MentionOutcome::Sent
+        }
+    }
+
+    /// Re-reads the active item; the hub pushes it when the selection moved.
+    fn selection_changed(&mut self, cx: &mut Context<Self>) {
+        let Some(workspace) = self.workspace.upgrade() else {
+            return;
+        };
+        let item = workspace.read(cx).active_item(cx);
+        let observed = selection_watch::observe_active_item(item, cx);
+        self.selection.borrow_mut().observe(observed);
+    }
+
+    /// Re-publishes this server's lock file for the workspace's current folders.
+    ///
+    /// A no-op until the listener is bound, since `run` publishes once it has a
+    /// port; the write is atomic, so the CLI never reads a half-updated file.
+    fn rewrite_lockfile(&self, cx: &mut App) {
+        let (Some(port), Some(auth_token)) = (self.port.get(), self.auth_token.borrow().clone())
+        else {
+            return;
+        };
+        let Some(workspace) = self.workspace.upgrade() else {
+            return;
+        };
+        let folders = workspace_folders_of(workspace.read(cx), cx);
+        let project = workspace.read(cx).project().clone();
+        publish(
+            port,
+            &auth_token,
+            &folders,
+            &project,
+            &lockfile::lock_dir(),
+            cx,
+        );
+    }
+
+    async fn run(
+        workspace: WeakEntity<Workspace>,
+        window: Option<AnyWindowHandle>,
+        shared: Shared,
+        cx: &mut AsyncApp,
+    ) -> Result<()> {
+        let (listener, port) = bind().await?;
+        let auth_token = generate_auth_token();
+
+        shared.port.set(Some(port));
+        *shared.auth_token.borrow_mut() = Some(auth_token.clone());
+
+        workspace
+            .update(cx, |workspace, cx| {
+                let folders = workspace_folders_of(workspace, cx);
+                let project = workspace.project().clone();
+                publish(
+                    port,
+                    &auth_token,
+                    &folders,
+                    &project,
+                    &lockfile::lock_dir(),
+                    cx,
+                );
+            })
+            .context("publishing the IDE lock file")?;
+
+        log::info!("Claude Code IDE server listening on 127.0.0.1:{port}");
+
+        // Each accepted connection is served on the foreground executor so its
+        // tool handlers can touch workspace entities; the async I/O still yields,
+        // so it never blocks the UI.
+        let mut next_id = 0;
+        while let Ok((stream, _addr)) = listener.accept().await {
+            let id = next_id;
+            next_id += 1;
+            let current = workspace
+                .update(cx, |workspace, cx| {
+                    let item = workspace.active_item(cx);
+                    let observed = selection_watch::observe_active_item(item, cx);
+                    let mut selection = shared.selection.borrow_mut();
+                    selection.observe(observed);
+                    selection.state().notification()
+                })
+                .unwrap_or_else(|_| selection::selection_changed_notification(None));
+            let (selection_updates, updates) = mpsc::unbounded();
+            let (notify, notifications) = mpsc::unbounded();
+            shared.selection.borrow_mut().connect(Connection {
+                id,
+                selection_updates,
+                notifications: notify.clone(),
+            });
+            let executor = cx.background_executor().clone();
+            cx.spawn(async move |_cx| {
+                selection_watch::pump_selection(current, updates, notify, executor).await;
+            })
+            .detach();
+
+            let dispatcher = WorkspaceDispatcher::new(
+                workspace.clone(),
+                window,
+                shared.selection.clone(),
+                cx.clone(),
+            );
+            let auth_token = auth_token.clone();
+            let selection = shared.selection.clone();
+            cx.spawn(async move |_cx| {
+                serve_connection(stream, auth_token, dispatcher, notifications)
+                    .await
+                    .log_err();
+                // Dropping the schedule's sender ends its pump too.
+                selection.borrow_mut().disconnect(id);
+            })
+            .detach();
+        }
+
+        Ok(())
+    }
+
+    /// Removes this server's lock file, if one has been written. Idempotent.
+    fn remove_lockfile(&self) {
+        if let Some(port) = self.port.get() {
+            lockfile::remove(port).log_err();
+        }
+    }
+}
+
+/// What the accept loop shares with the server entity.
+struct Shared {
+    port: Rc<Cell<Option<u16>>>,
+    auth_token: Rc<RefCell<Option<String>>>,
+    selection: Rc<RefCell<SelectionHub>>,
+}
+
+impl Drop for ClaudeCodeIdeServer {
+    fn drop(&mut self) {
+        self.remove_lockfile();
+    }
+}
+
+/// Publishes or withdraws a server, keeping the lock file and the port the
+/// project hands to its terminals (`CLAUDE_CODE_SSE_PORT`) in step.
+///
+/// With folders, the lock file is written and the port published. Without any,
+/// both are withdrawn: a lock file listing no folders matches no working
+/// directory, so it can only mislead the CLI, and a port without a lock file
+/// gives a CLI started in that workspace's terminal no token to authenticate
+/// with -- it would fail the handshake instead of running without an IDE.
+fn publish(
+    port: u16,
+    auth_token: &str,
+    folders: &[PathBuf],
+    project: &Entity<Project>,
+    lock_dir: &std::path::Path,
+    cx: &mut App,
+) {
+    let ide_name = ReleaseChannel::try_global(cx)
+        .unwrap_or(ReleaseChannel::Stable)
+        .display_name();
+    let advertised = advertise(port, auth_token, folders, ide_name, lock_dir);
+    project.update(cx, |project, _| {
+        project.set_claude_code_ide_port(advertised)
+    });
+}
+
+/// `publish`'s decision: writes the lock file and returns the port to advertise when
+/// there are folders, removes it and returns `None` when there are none.
+fn advertise(
+    port: u16,
+    auth_token: &str,
+    folders: &[PathBuf],
+    ide_name: &str,
+    lock_dir: &std::path::Path,
+) -> Option<u16> {
+    if folders.is_empty() {
+        lockfile::remove_in(lock_dir, port).log_err();
+        None
+    } else {
+        lockfile::create_in(lock_dir, port, ide_name, auth_token, folders)
+            .log_err()
+            .map(|_| port)
+    }
+}
+
+/// The absolute paths of a workspace's visible folders, as the lock file and the
+/// `getWorkspaceFolders` tool report them.
+fn workspace_folders_of(workspace: &Workspace, cx: &App) -> Vec<PathBuf> {
+    workspace
+        .project()
+        .read(cx)
+        .visible_worktrees(cx)
+        .map(|worktree| worktree.read(cx).abs_path().to_path_buf())
+        .collect()
+}
+
+#[cfg(test)]
+mod publish_tests {
+    use super::*;
+
+    /// 2026-10-01's fix: a window with folders writes the lock file and advertises the
+    /// port its terminals hand the CLI; once it has none, both are withdrawn -- a lock
+    /// file listing no folders matches nothing, and a port without one makes a CLI
+    /// started in that terminal fail the handshake instead of running without an IDE.
+    #[test]
+    fn advertise_withdraws_the_lock_file_and_port_without_folders() {
+        let dir = std::env::temp_dir().join(format!(
+            "zeo-ide-publish-{}-{}",
+            std::process::id(),
+            lockfile::generate_auth_token()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let lock = dir.join("4245.lock");
+
+        let folders = [PathBuf::from("/work/app")];
+        assert_eq!(advertise(4245, "token", &folders, "Zeo", &dir), Some(4245));
+        assert!(lock.exists(), "a window with folders writes the lock file");
+
+        assert_eq!(
+            advertise(4245, "token", &[], "Zeo", &dir),
+            None,
+            "a window without folders advertises no port"
+        );
+        assert!(!lock.exists(), "and withdraws the lock file");
+        std::fs::remove_dir_all(&dir).ok();
+    }
+}
diff --git a/crates/claude_code_ide/src/lockfile.rs b/crates/claude_code_ide/src/lockfile.rs
new file mode 100644
index 0000000..b1f01e1
--- /dev/null
+++ b/crates/claude_code_ide/src/lockfile.rs
@@ -0,0 +1,248 @@
+//! Discovery lock files for the Claude Code IDE integration.
+//!
+//! The Claude Code CLI finds a running IDE WebSocket server by scanning
+//! `~/.claude/ide/*.lock`. Each file describes one server: which workspace it
+//! serves, the PID that owns it, and the auth token the CLI must present in the
+//! `x-claude-code-ide-authorization` header when it connects. We mirror the
+//! format the official VS Code and JetBrains extensions write.
+
+use anyhow::{Context as _, Result};
+use serde::Serialize;
+use std::{fs, path::PathBuf};
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct LockFileContents {
+    pid: u32,
+    workspace_folders: Vec<String>,
+    /// Shown in the CLI's `/ide` status output. The caller passes the release
+    /// channel's display name, so a build reports the name its window carries.
+    ide_name: String,
+    /// The field the CLI actually branches on when it builds our URL:
+    /// `true` gives `ws://host:port`, absent or `false` gives
+    /// `http://host:port/sse`. We serve only WebSocket, so omitting this
+    /// sends the CLI to an SSE endpoint that nothing answers.
+    ///
+    /// Renamed explicitly: `rename_all = "camelCase"` would emit
+    /// `useWebsocket`, with a lowercase `s`, which the CLI does not read.
+    #[serde(rename = "useWebSocket")]
+    use_websocket: bool,
+    /// Descriptive only. The CLI's lock-file parser does not read it; it is
+    /// kept because the official extensions write it and an older CLI may.
+    transport: &'static str,
+    auth_token: String,
+}
+
+impl LockFileContents {
+    fn new(ide_name: &str, auth_token: &str, workspace_folders: &[PathBuf]) -> Self {
+        Self {
+            pid: std::process::id(),
+            workspace_folders: workspace_folders
+                .iter()
+                .map(|path| path.to_string_lossy().into_owned())
+                .collect(),
+            ide_name: ide_name.to_owned(),
+            use_websocket: true,
+            transport: "ws",
+            auth_token: auth_token.to_owned(),
+        }
+    }
+}
+
+/// `$CLAUDE_CONFIG_DIR/ide` when that variable is set and non-empty, otherwise
+/// `~/.claude/ide` — the same resolution the CLI itself performs.
+pub fn lock_dir() -> PathBuf {
+    lock_dir_from(std::env::var_os("CLAUDE_CONFIG_DIR"))
+}
+
+/// `lock_dir`'s rule, with `CLAUDE_CONFIG_DIR`'s value passed in.
+fn lock_dir_from(claude_config_dir: Option<std::ffi::OsString>) -> PathBuf {
+    match claude_config_dir {
+        Some(dir) if !dir.is_empty() => PathBuf::from(dir).join("ide"),
+        _ => paths::home_dir().join(".claude").join("ide"),
+    }
+}
+
+/// A fresh v4 UUID, matching the auth-token format the official extensions use.
+pub fn generate_auth_token() -> String {
+    uuid::Uuid::new_v4().to_string()
+}
+
+/// Writes the lock file for `port`, returning its path.
+///
+/// The write is atomic (temp file + rename) so the CLI never observes a
+/// partially written file while scanning the directory.
+pub fn create(
+    port: u16,
+    ide_name: &str,
+    auth_token: &str,
+    workspace_folders: &[PathBuf],
+) -> Result<PathBuf> {
+    create_in(&lock_dir(), port, ide_name, auth_token, workspace_folders)
+}
+
+/// `create`, in `dir` rather than the resolved lock directory.
+pub(crate) fn create_in(
+    dir: &std::path::Path,
+    port: u16,
+    ide_name: &str,
+    auth_token: &str,
+    workspace_folders: &[PathBuf],
+) -> Result<PathBuf> {
+    let dir = dir.to_path_buf();
+    fs::create_dir_all(&dir).with_context(|| format!("creating lock dir {dir:?}"))?;
+    // The token is a secret, so restrict the directory to the current user
+    // (0700), matching what the official extensions do.
+    set_owner_only(&dir, 0o700)?;
+
+    let contents = LockFileContents::new(ide_name, auth_token, workspace_folders);
+    let json = serde_json::to_string(&contents).context("serializing lock file")?;
+
+    let path = dir.join(format!("{port}.lock"));
+    let temp = dir.join(format!("{port}.lock.tmp"));
+    fs::write(&temp, json).with_context(|| format!("writing {temp:?}"))?;
+    // Restrict to 0600 before the rename publishes the file, so the token is
+    // never briefly world-readable.
+    set_owner_only(&temp, 0o600)?;
+    fs::rename(&temp, &path).with_context(|| format!("renaming {temp:?} to {path:?}"))?;
+    Ok(path)
+}
+
+/// Sets owner-only Unix permissions (e.g. `0o700`, `0o600`). A no-op on
+/// platforms without Unix permission bits.
+#[cfg(unix)]
+fn set_owner_only(path: &std::path::Path, mode: u32) -> Result<()> {
+    use std::os::unix::fs::PermissionsExt as _;
+    fs::set_permissions(path, fs::Permissions::from_mode(mode))
+        .with_context(|| format!("setting mode {mode:o} on {path:?}"))
+}
+
+#[cfg(not(unix))]
+fn set_owner_only(_path: &std::path::Path, _mode: u32) -> Result<()> {
+    Ok(())
+}
+
+/// Removes the lock file for `port`. Succeeds if it is already gone.
+pub fn remove(port: u16) -> Result<()> {
+    remove_in(&lock_dir(), port)
+}
+
+/// `remove`, in `dir` rather than the resolved lock directory.
+pub(crate) fn remove_in(dir: &std::path::Path, port: u16) -> Result<()> {
+    let path = dir.join(format!("{port}.lock"));
+    match fs::remove_file(&path) {
+        Ok(()) => Ok(()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error).with_context(|| format!("removing {path:?}")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn auth_token_is_a_uuid() {
+        let token = generate_auth_token();
+        assert_eq!(token.len(), 36);
+        assert!(uuid::Uuid::parse_str(&token).is_ok());
+    }
+
+    /// A unique, empty directory under the system temp dir, removed on drop.
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new(name: &str) -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "zeo-ide-lock-{name}-{}-{}",
+                std::process::id(),
+                generate_auth_token()
+            ));
+            fs::create_dir_all(&path).unwrap();
+            Self(path)
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).ok();
+        }
+    }
+
+    /// Asserts against the file `create` publishes, not against a struct the
+    /// test builds itself: an earlier version hard-coded its own field values,
+    /// so it stayed green while the file we actually wrote was missing the one
+    /// field the CLI branches on.
+    #[test]
+    fn lock_file_matches_expected_wire_format() {
+        let temp = TempDir::new("wire");
+        let path = create_in(
+            &temp.0,
+            4242,
+            "Zed Nightly",
+            "the-token",
+            &[PathBuf::from("/home/user/project")],
+        )
+        .unwrap();
+        let value: serde_json::Value =
+            serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+
+        assert_eq!(path, temp.0.join("4242.lock"));
+        assert_eq!(value["pid"], std::process::id());
+        assert_eq!(value["workspaceFolders"][0], "/home/user/project");
+        assert_eq!(value["ideName"], "Zed Nightly");
+        assert_eq!(value["authToken"], "the-token");
+        assert_eq!(value["transport"], "ws");
+        assert_eq!(value["useWebSocket"], true);
+    }
+
+    /// The token is a secret: the directory must end up 0700 even when it
+    /// already existed wider, the file 0600, and no temp file may be left
+    /// behind. The 0700 directory is the real guard -- the temp file is written
+    /// under the umask before its own chmod.
+    #[cfg(unix)]
+    #[test]
+    fn create_writes_an_owner_only_file_in_an_owner_only_dir() {
+        use std::os::unix::fs::PermissionsExt as _;
+
+        let temp = TempDir::new("perms");
+        let dir = temp.0.join("ide");
+        fs::create_dir_all(&dir).unwrap();
+        fs::set_permissions(&dir, fs::Permissions::from_mode(0o755)).unwrap();
+
+        let path = create_in(&dir, 4243, "Zeo", "the-token", &[]).unwrap();
+
+        let mode =
+            |path: &std::path::Path| fs::metadata(path).unwrap().permissions().mode() & 0o777;
+        assert_eq!(mode(&dir), 0o700, "the lock directory must be owner-only");
+        assert_eq!(mode(&path), 0o600, "the lock file must be owner-only");
+        assert!(
+            !dir.join("4243.lock.tmp").exists(),
+            "the temp file must be renamed away"
+        );
+    }
+
+    /// `remove` deletes the file, and removing it again is not an error.
+    #[test]
+    fn remove_deletes_the_lock_file_and_tolerates_a_second_call() {
+        let temp = TempDir::new("remove");
+        let path = create_in(&temp.0, 4244, "Zeo", "the-token", &[]).unwrap();
+
+        remove_in(&temp.0, 4244).unwrap();
+        assert!(!path.exists());
+        remove_in(&temp.0, 4244).expect("an already-removed lock file is fine");
+    }
+
+    /// `CLAUDE_CONFIG_DIR` wins when set and non-empty; empty or unset falls
+    /// back to `~/.claude/ide` -- the CLI's own rule.
+    #[test]
+    fn lock_dir_honors_claude_config_dir() {
+        let default_dir = paths::home_dir().join(".claude").join("ide");
+        assert_eq!(
+            lock_dir_from(Some("/custom/claude".into())),
+            PathBuf::from("/custom/claude/ide")
+        );
+        assert_eq!(lock_dir_from(Some("".into())), default_dir);
+        assert_eq!(lock_dir_from(None), default_dir);
+    }
+}
