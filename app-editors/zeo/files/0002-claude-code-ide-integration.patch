index 0000000..bba215e
--- /dev/null
+++ b/crates/claude_code_ide/src/open_diff.rs
@@ -0,0 +1,319 @@
+//! The blocking `openDiff` tool.
+//!
+//! Shows Claude's proposed change as a side-by-side diff tab in Zed plus a
+//! Keep/Reject notification, then blocks until the user decides. On Keep we
+//! return `FILE_SAVED` together with the final buffer contents and let the
+//! Claude CLI perform the actual write (matching the official IDE protocol);
+//! on Reject we return `DIFF_REJECTED` and discard the change. Closing the
+//! tab without deciding returns `TAB_CLOSED`, as the VS Code extension does:
+//! the CLI then keeps its proposed edit unsaved instead of recording a
+//! rejection the user never made. The IDE
+//! deliberately does *not* write the file itself, which would race the CLI's
+//! own save.
+
+use crate::server::{ProtocolError, error_codes};
+use buffer_diff::BufferDiff;
+use editor::{DiffViewStyle, MultiBuffer, SelectionEffects, SplittableEditor, scroll::Autoscroll};
+use futures::channel::oneshot;
+use gpui::{AnyWindowHandle, AppContext as _, AsyncApp, DismissEvent, WeakEntity};
+use language::Buffer;
+use serde_json::{Value, json};
+use std::{cell::RefCell, rc::Rc};
+use ui::{Color, IconName};
+use workspace::{
+    SaveIntent, SplitDirection, Workspace,
+    notifications::{NotificationId, simple_message_notification::MessageNotification},
+};
+
+/// Distinguishes our notification from others in the notification registry.
+struct ClaudeDiffNotification;
+
+pub async fn open_diff(
+    workspace: WeakEntity<Workspace>,
+    window: Option<AnyWindowHandle>,
+    arguments: Value,
+    cx: &mut AsyncApp,
+) -> Result<Value, ProtocolError> {
+    let string_arg = |key: &str| {
+        arguments
+            .get(key)
+            .and_then(Value::as_str)
+            .map(str::to_owned)
+    };
+
+    let old_file_path = string_arg("old_file_path")
+        .ok_or_else(|| ProtocolError::new(error_codes::INVALID_REQUEST, "missing old_file_path"))?;
+    let new_file_contents = string_arg("new_file_contents").ok_or_else(|| {
+        ProtocolError::new(error_codes::INVALID_REQUEST, "missing new_file_contents")
+    })?;
+    let tab_name = string_arg("tab_name").unwrap_or_else(|| "Proposed changes".to_owned());
+
+    let window =
+        window.ok_or_else(|| ProtocolError::internal("no window available to show a diff"))?;
+
+    // The current on-disk contents are the diff base (the "old" side).
+    let old_contents = {
+        let path = old_file_path.clone();
+        smol::unblock(move || std::fs::read_to_string(&path).unwrap_or_default()).await
+    };
+
+    let (decision_tx, decision_rx) = oneshot::channel::<DiffDecision>();
+    let decision_tx = Rc::new(RefCell::new(Some(decision_tx)));
+
+    let message = format!("Claude proposes changes to {old_file_path}");
+
+    // Build the proposed buffer and start computing the diff against the old
+    // contents (the base). `set_base_text` is asynchronous, so we await it
+    // before showing the editor to avoid flashing a "whole file added" diff.
+    let (buffer, diff, base_ready) = window
+        .update(cx, |_root, _window, cx| {
+            let buffer = cx.new(|cx| Buffer::local(new_file_contents.clone(), cx));
+            let snapshot = buffer.read(cx).text_snapshot();
+            let diff = cx.new(|cx| BufferDiff::new(&snapshot, None, None, cx));
+            let base_ready = diff.update(cx, |diff, cx| {
+                diff.set_base_text(Some(old_contents.into()), snapshot, cx)
+            });
+            (buffer, diff, base_ready)
+        })
+        .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+    base_ready.await;
+
+    let editor_id = window
+        .update(cx, |_root, window, cx| {
+            let multibuffer = cx.new(|cx| {
+                let mut multibuffer = MultiBuffer::singleton(buffer.clone(), cx);
+                multibuffer.add_diff(diff, cx);
+                multibuffer
+            });
+
+            let Some(workspace_entity) = workspace.upgrade() else {
+                return None;
+            };
+            let project = workspace_entity.read(cx).project().clone();
+
+            // `DiffViewStyle::Split` renders side-by-side (old on the left, new on
+            // the right) like the JetBrains diff viewer; `SplittableEditor` is
+            // itself a workspace item, so it can be opened directly as a tab.
+            let diff_editor = cx.new(|cx| {
+                SplittableEditor::new(
+                    DiffViewStyle::Split,
+                    multibuffer,
+                    project,
+                    workspace_entity.clone(),
+                    window,
+                    cx,
+                )
+            });
+            let editor_id = diff_editor.entity_id();
+            let notification_id =
+                NotificationId::composite::<ClaudeDiffNotification>(tab_name.clone());
+
+            // Closing the tab drops the last strong handle to the diff editor;
+            // a Keep or Reject that came first has already taken the sender, so
+            // this only answers for a tab closed without a decision. The
+            // notification is dismissed on the next cycle because the release
+            // can fire while the workspace is still being updated.
+            let tx_closed = decision_tx.clone();
+            let workspace_on_close = workspace.clone();
+            let id_on_close = notification_id.clone();
+            cx.observe_release(&diff_editor, move |_, cx| {
+                if send_decision(&tx_closed, DiffDecision::Closed) {
+                    cx.defer(move |cx| {
+                        workspace_on_close
+                            .update(cx, |workspace, cx| {
+                                workspace.dismiss_notification(&id_on_close, cx)
+                            })
+                            .ok();
+                    });
+                }
+            })
+            .detach();
+
+            workspace_entity.update(cx, |workspace, cx| {
+                // The active pane holds Claude's integrated terminal: the CLI has
+                // focus there when it sends `openDiff`. Show the diff in any other
+                // pane so it doesn't cover the terminal; if the terminal is the
+                // only pane, split a new one off to its left.
+                let active_pane_id = workspace.active_pane().entity_id();
+                let other_pane = workspace
+                    .panes()
+                    .iter()
+                    .find(|pane| pane.entity_id() != active_pane_id)
+                    .cloned();
+                if let Some(target_pane) = other_pane {
+                    workspace.add_item(
+                        target_pane,
+                        Box::new(diff_editor.clone()),
+                        None,
+                        true,
+                        true,
+                        window,
+                        cx,
+                    );
+                } else {
+                    workspace.split_item(
+                        SplitDirection::Left,
+                        Box::new(diff_editor.clone()),
+                        window,
+                        cx,
+                    );
+                }
+
+                let tx_keep = decision_tx.clone();
+                let tx_reject = decision_tx.clone();
+                workspace.show_notification(notification_id, cx, move |cx| {
+                    cx.new(|cx| {
+                        MessageNotification::new(message, cx)
+                            .primary_message("Keep")
+                            .primary_icon(IconName::Check)
+                            .primary_icon_color(Color::Success)
+                            .primary_on_click(move |_window, cx| {
+                                send_decision(&tx_keep, DiffDecision::Accepted);
+                                cx.emit(DismissEvent);
+                            })
+                            .secondary_message("Reject")
+                            .secondary_icon(IconName::Close)
+                            .secondary_icon_color(Color::Error)
+                            .secondary_on_click(move |_window, cx| {
+                                send_decision(&tx_reject, DiffDecision::Rejected);
+                                cx.emit(DismissEvent);
+                            })
+                    })
+                });
+            });
+
+            // Center the view on the first change so the user lands on the diff
+            // rather than at the top of an otherwise-unchanged file.
+            diff_editor.update(cx, |diff_editor, cx| {
+                let editor = diff_editor.rhs_editor().clone();
+                editor.update(cx, |editor, cx| {
+                    let snapshot = editor.buffer().read(cx).snapshot(cx);
+                    if let Some(first_hunk) = snapshot.diff_hunks().next() {
+                        let start = first_hunk.multi_buffer_range.start;
+                        editor.change_selections(
+                            SelectionEffects::scroll(Autoscroll::center()),
+                            window,
+                            cx,
+                            |selections| selections.select_anchor_ranges([start..start]),
+                        );
+                    }
+                });
+            });
+            Some(editor_id)
+        })
+        .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+    // Block until the user decides or closes the tab. A dropped sender (the
+    // window closed under us) is a close too, never a rejection.
+    let decision = decision_rx.await;
+
+    // Read the final buffer contents (the user may have edited the proposed
+    // side) and close the diff tab now that the decision is made.
+    let final_contents = window
+        .update(cx, |_root, window, cx| {
+            let final_contents = buffer.read(cx).text();
+            if let Some(editor_id) = editor_id
+                && let Some(workspace_entity) = workspace.upgrade()
+            {
+                workspace_entity.update(cx, |workspace, cx| {
+                    for pane in workspace.panes().to_vec() {
+                        pane.update(cx, |pane, cx| {
+                            pane.close_item_by_id(editor_id, SaveIntent::Skip, window, cx)
+                        })
+                        .detach();
+                    }
+                });
+            }
+            final_contents
+        })
+        .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+    Ok(diff_outcome(decision, final_contents))
+}
+
+/// What ended a pending `openDiff`. The protocol answer for each lives in
+/// [`diff_outcome`], so the mapping can be tested without a window.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum DiffDecision {
+    Accepted,
+    Rejected,
+    Closed,
+}
+
+type DecisionSlot = Rc<RefCell<Option<oneshot::Sender<DiffDecision>>>>;
+
+/// Sends the first decision only; returns whether this call was the one that
+/// decided.
+fn send_decision(slot: &DecisionSlot, decision: DiffDecision) -> bool {
+    let Some(sender) = slot.borrow_mut().take() else {
+        return false;
+    };
+    if sender.send(decision).is_err() {
+        log::debug!(
+            "claude_code_ide: openDiff decision {decision:?} arrived after the request ended"
+        );
+    }
+    true
+}
+
+// The official IDE protocol has the IDE return the accepted contents and the
+// CLI perform the write, so the file is never written here.
+fn diff_outcome(
+    decision: Result<DiffDecision, oneshot::Canceled>,
+    final_contents: String,
+) -> Value {
+    match decision {
+        Ok(DiffDecision::Accepted) => json!({ "content": [
+            { "type": "text", "text": "FILE_SAVED" },
+            { "type": "text", "text": final_contents },
+        ] }),
+        Ok(DiffDecision::Rejected) => {
+            json!({ "content": [{ "type": "text", "text": "DIFF_REJECTED" }] })
+        }
+        Ok(DiffDecision::Closed) | Err(oneshot::Canceled) => {
+            json!({ "content": [{ "type": "text", "text": "TAB_CLOSED" }] })
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn texts(value: &Value) -> Vec<&str> {
+        value["content"]
+            .as_array()
+            .map(|items| {
+                items
+                    .iter()
+                    .filter_map(|item| item["text"].as_str())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    #[test]
+    fn open_diff_closed_tab_answers_tab_closed() {
+        let value = diff_outcome(Ok(DiffDecision::Closed), "proposed".to_owned());
+        assert_eq!(texts(&value), ["TAB_CLOSED"]);
+    }
+
+    #[test]
+    fn open_diff_dropped_sender_answers_tab_closed() {
+        let value = diff_outcome(Err(oneshot::Canceled), "proposed".to_owned());
+        assert_eq!(texts(&value), ["TAB_CLOSED"]);
+    }
+
+    #[test]
+    fn open_diff_reject_still_answers_diff_rejected() {
+        let value = diff_outcome(Ok(DiffDecision::Rejected), "proposed".to_owned());
+        assert_eq!(texts(&value), ["DIFF_REJECTED"]);
+    }
+
+    #[test]
+    fn open_diff_keep_still_answers_file_saved_with_the_contents() {
+        let value = diff_outcome(Ok(DiffDecision::Accepted), "edited by the user".to_owned());
+        assert_eq!(texts(&value), ["FILE_SAVED", "edited by the user"]);
+    }
+}
diff --git a/crates/claude_code_ide/src/selection.rs b/crates/claude_code_ide/src/selection.rs
new file mode 100644
index 0000000..d995e1c
--- /dev/null
+++ b/crates/claude_code_ide/src/selection.rs
@@ -0,0 +1,325 @@
+//! The editor selection as the Claude Code CLI sees it: the `selection_changed`
+//! notification pushed on every change, and the state `getCurrentSelection` and
+//! `getLatestSelection` answer from, so the tools and the notification can never
+//! disagree.
+//!
+//! Positions are 0-based on the wire: CLI 2.1.316's handler adds 1 to `line`
+//! itself (`lineStart: start.line + 1`).
+
+use std::time::{Duration, Instant};
+
+use serde_json::{Value, json};
+
+/// A position as the CLI's schema names it: `{line, character}`, both 0-based.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SelectionPoint {
+    pub line: u32,
+    pub character: u32,
+}
+
+/// The selection of a file-backed editor.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EditorSelection {
+    pub file_path: String,
+    pub text: String,
+    pub start: SelectionPoint,
+    pub end: SelectionPoint,
+}
+
+/// The `params` both the notification and the selection tools carry.
+pub fn selection_params(selection: &EditorSelection) -> Value {
+    let point = |point: SelectionPoint| json!({ "line": point.line, "character": point.character });
+    json!({
+        "text": selection.text,
+        "filePath": selection.file_path,
+        "fileUrl": format!("file://{}", selection.file_path),
+        "selection": {
+            "start": point(selection.start),
+            "end": point(selection.end),
+            "isEmpty": selection.start == selection.end,
+        },
+    })
+}
+
+/// The `selection_changed` notification; `None` is an editor with no file
+/// behind it. CLI 2.1.316 ignores a null selection (`if(!Be?.start||!Be?.end)
+/// return;`) and would keep the previous file attached, so the clear is a
+/// zero-width selection at 0:0 with no text and no file path.
+pub fn selection_changed_notification(selection: Option<&EditorSelection>) -> Value {
+    let params = match selection {
+        Some(selection) => selection_params(selection),
+        None => json!({
+            "text": "",
+            "selection": {
+                "start": { "line": 0, "character": 0 },
+                "end": { "line": 0, "character": 0 },
+                "isEmpty": true,
+            },
+        }),
+    };
+    json!({ "jsonrpc": "2.0", "method": "selection_changed", "params": params })
+}
+
+/// The `at_mentioned` notification for the selected lines.
+pub fn at_mentioned_notification(selection: &EditorSelection) -> Value {
+    // A selection of whole lines ends at column 0 of the line after the last;
+    // that line is not part of it. The CLI counts its own selections the same way.
+    let line_end = if selection.end.character == 0 && selection.end.line > selection.start.line {
+        selection.end.line - 1
+    } else {
+        selection.end.line
+    };
+    json!({
+        "jsonrpc": "2.0",
+        "method": "at_mentioned",
+        "params": {
+            "filePath": selection.file_path,
+            "lineStart": selection.start.line,
+            "lineEnd": line_end,
+        },
+    })
+}
+
+/// What the active item says about the selection when it changes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ObservedSelection {
+    /// The active item is not an editor -- a terminal, a panel. VS Code keeps
+    /// the last editor selection when its terminal takes focus, and so does
+    /// this: the CLI usually runs in that terminal.
+    NotAnEditor,
+    /// An editor; `None` when no local file backs it.
+    Editor(Option<EditorSelection>),
+}
+
+/// The selection the tools answer from and the notification is built from.
+#[derive(Debug, Default)]
+pub struct SelectionState {
+    current: Option<EditorSelection>,
+    latest: Option<EditorSelection>,
+}
+
+impl SelectionState {
+    /// Applies what the active item showed; returns whether the state moved.
+    pub fn observe(&mut self, observed: ObservedSelection) -> bool {
+        let ObservedSelection::Editor(current) = observed else {
+            return false;
+        };
+        if current == self.current {
+            return false;
+        }
+        if current.is_some() {
+            self.latest.clone_from(&current);
+        }
+        self.current = current;
+        true
+    }
+
+    pub fn current(&self) -> Option<&EditorSelection> {
+        self.current.as_ref()
+    }
+
+    /// The last selection seen in a file, even after the editor lost it.
+    pub fn latest(&self) -> Option<&EditorSelection> {
+        self.latest.as_ref()
+    }
+
+    pub fn notification(&self) -> Value {
+        selection_changed_notification(self.current())
+    }
+}
+
+/// VS Code's extension waits this long after a connection before replaying the
+/// selection, so the CLI's handlers are registered when it arrives.
+const REPLAY_AFTER: Duration = Duration::from_millis(500);
+/// At most one `selection_changed` per connection in this window.
+const THROTTLE: Duration = Duration::from_millis(100);
+
+/// One connection's `selection_changed` schedule, driven by explicit instants
+/// so it is testable without a clock. The caller sleeps until [`next_due`] and
+/// calls [`poll_due`], and calls [`offer`] on every selection change.
+///
+/// [`next_due`]: SelectionFeed::next_due
+/// [`poll_due`]: SelectionFeed::poll_due
+/// [`offer`]: SelectionFeed::offer
+#[derive(Debug)]
+pub struct SelectionFeed<T> {
+    pending: Option<T>,
+    due: Option<Instant>,
+    replay_at: Instant,
+    last_sent: Option<Instant>,
+}
+
+impl<T: Clone> SelectionFeed<T> {
+    pub fn connected(now: Instant, current: T) -> Self {
+        Self {
+            pending: Some(current),
+            due: None,
+            replay_at: now + REPLAY_AFTER,
+            last_sent: None,
+        }
+    }
+
+    /// Returns the item when it should be sent now, or holds it as the latest.
+    pub fn offer(&mut self, now: Instant, item: T) -> Option<T> {
+        // Before the replay, the replay itself carries the newest state.
+        if now < self.replay_at && self.last_sent.is_none() {
+            self.pending = Some(item);
+            return None;
+        }
+        match self.last_sent {
+            Some(sent) if now < sent + THROTTLE => {
+                self.pending = Some(item);
+                self.due = Some(sent + THROTTLE);
+                None
+            }
+            _ => {
+                self.pending = None;
+                self.due = None;
+                self.last_sent = Some(now);
+                Some(item)
+            }
+        }
+    }
+
+    pub fn poll_due(&mut self, now: Instant) -> Option<T> {
+        let due = self.next_due()?;
+        if now < due {
+            return None;
+        }
+        self.due = None;
+        self.last_sent = Some(now);
+        self.pending.take()
+    }
+
+    pub fn next_due(&self) -> Option<Instant> {
+        self.pending.as_ref()?;
+        Some(if self.last_sent.is_none() {
+            self.replay_at
+        } else {
+            self.due.unwrap_or(self.replay_at)
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn file_selection(path: &str, text: &str) -> EditorSelection {
+        EditorSelection {
+            file_path: path.to_owned(),
+            text: text.to_owned(),
+            start: SelectionPoint {
+                line: 2,
+                character: 0,
+            },
+            end: SelectionPoint {
+                line: 2,
+                character: 4,
+            },
+        }
+    }
+
+    #[test]
+    fn selection_state_keeps_the_last_selection_when_a_terminal_takes_focus() {
+        let mut state = SelectionState::default();
+        let selected = file_selection("/work/a.rs", "main");
+        assert!(state.observe(ObservedSelection::Editor(Some(selected.clone()))));
+        assert!(!state.observe(ObservedSelection::NotAnEditor));
+        assert_eq!(state.current(), Some(&selected));
+        assert_eq!(state.notification()["params"]["filePath"], "/work/a.rs");
+    }
+
+    #[test]
+    fn selection_state_clears_current_but_keeps_latest_for_an_editor_without_a_file() {
+        let mut state = SelectionState::default();
+        let selected = file_selection("/work/a.rs", "main");
+        state.observe(ObservedSelection::Editor(Some(selected.clone())));
+        assert!(state.observe(ObservedSelection::Editor(None)));
+        assert_eq!(state.current(), None);
+        assert_eq!(state.latest(), Some(&selected));
+        assert_eq!(state.notification()["params"]["selection"]["isEmpty"], true);
+    }
+
+    #[test]
+    fn selection_without_a_file_clears_with_a_zero_width_selection() {
+        let params = &selection_changed_notification(None)["params"];
+        assert_eq!(
+            params["selection"],
+            json!({
+                "start": { "line": 0, "character": 0 },
+                "end": { "line": 0, "character": 0 },
+                "isEmpty": true,
+            })
+        );
+        assert_eq!(params["text"], "");
+        assert!(params.get("filePath").is_none());
+    }
+
+    #[test]
+    fn selection_state_sends_nothing_for_a_terminal_even_before_any_editor() {
+        let mut state = SelectionState::default();
+        assert!(!state.observe(ObservedSelection::NotAnEditor));
+        assert_eq!(state.current(), None);
+    }
+
+    #[test]
+    fn selection_state_reports_no_move_for_the_same_selection() {
+        let mut state = SelectionState::default();
+        let selected = file_selection("/work/a.rs", "main");
+        assert!(state.observe(ObservedSelection::Editor(Some(selected.clone()))));
+        assert!(!state.observe(ObservedSelection::Editor(Some(selected))));
+    }
+
+    #[test]
+    fn mention_sends_the_path_and_0_based_lines() {
+        let mut selected = file_selection("/work/a.rs", "main");
+        selected.start.line = 0;
+        selected.end.line = 3;
+        let notification = at_mentioned_notification(&selected);
+        assert_eq!(notification["jsonrpc"], "2.0");
+        assert_eq!(notification["method"], "at_mentioned");
+        assert!(notification.get("id").is_none());
+        assert_eq!(
+            notification["params"],
+            json!({ "filePath": "/work/a.rs", "lineStart": 0, "lineEnd": 3 })
+        );
+    }
+
+    #[test]
+    fn mention_of_whole_lines_stops_before_the_line_the_selection_ends_on() {
+        let mut selected = file_selection("/work/a.rs", "fn a() {}\n");
+        selected.start = SelectionPoint {
+            line: 4,
+            character: 0,
+        };
+        selected.end = SelectionPoint {
+            line: 5,
+            character: 0,
+        };
+        let params = &at_mentioned_notification(&selected)["params"];
+        assert_eq!(params["lineStart"], 4);
+        assert_eq!(params["lineEnd"], 4);
+    }
+
+    #[test]
+    fn mention_of_a_cursor_names_its_line() {
+        let mut selected = file_selection("/work/a.rs", "");
+        selected.start = SelectionPoint {
+            line: 7,
+            character: 0,
+        };
+        selected.end = selected.start;
+        let params = &at_mentioned_notification(&selected)["params"];
+        assert_eq!(params["lineStart"], 7);
+        assert_eq!(params["lineEnd"], 7);
+    }
+
+    #[test]
+    fn selection_tool_and_notification_share_the_params() {
+        let selected = file_selection("/work/a.rs", "main");
+        let notification = selection_changed_notification(Some(&selected));
+        assert_eq!(notification["params"], selection_params(&selected));
+        assert_eq!(selection_params(&selected)["fileUrl"], "file:///work/a.rs");
+    }
+}
diff --git a/crates/claude_code_ide/src/selection_watch.rs b/crates/claude_code_ide/src/selection_watch.rs
new file mode 100644
index 0000000..f687f87
--- /dev/null
+++ b/crates/claude_code_ide/src/selection_watch.rs
@@ -0,0 +1,269 @@
+//! Where Zed's editor meets [`crate::selection`]: reading the active item's
+//! selection, and running one connection's `selection_changed` schedule.
+
+use editor::Editor;
+use futures::{FutureExt as _, StreamExt as _, channel::mpsc};
+use gpui::{App, BackgroundExecutor, Entity};
+use serde_json::Value;
+use text::Point;
+use workspace::ItemHandle;
+
+use crate::selection::{
+    EditorSelection, ObservedSelection, SelectionFeed, SelectionPoint, SelectionState,
+};
+
+/// One connected CLI, as the server reaches it.
+pub(crate) struct Connection {
+    pub(crate) id: u64,
+    /// Into the connection's `selection_changed` schedule.
+    pub(crate) selection_updates: mpsc::UnboundedSender<Value>,
+    /// Straight onto the socket, for what must not wait for the schedule.
+    pub(crate) notifications: mpsc::UnboundedSender<Value>,
+}
+
+/// The selection state together with everyone who must hear when it moves, so
+/// no path can change one without the other: an editor event, a tool call and
+/// a new connection all go through [`SelectionHub::observe`].
+#[derive(Default)]
+pub(crate) struct SelectionHub {
+    state: SelectionState,
+    connections: Vec<Connection>,
+}
+
+impl SelectionHub {
+    pub(crate) fn state(&self) -> &SelectionState {
+        &self.state
+    }
+
+    pub(crate) fn observe(&mut self, observed: ObservedSelection) {
+        if !self.state.observe(observed) {
+            return;
+        }
+        let notification = self.state.notification();
+        self.connections.retain(|connection| {
+            let open = connection
+                .selection_updates
+                .unbounded_send(notification.clone())
+                .is_ok();
+            if !open {
+                log::debug!(
+                    "claude_code_ide: dropping closed connection {}",
+                    connection.id
+                );
+            }
+            open
+        });
+    }
+
+    /// Sends `notification` to every open connection now; returns how many took
+    /// it, so a caller can tell the user nobody is listening.
+    pub(crate) fn send_now(&mut self, notification: Value) -> usize {
+        self.connections.retain(|connection| {
+            let open = connection
+                .notifications
+                .unbounded_send(notification.clone())
+                .is_ok();
+            if !open {
+                log::debug!(
+                    "claude_code_ide: dropping closed connection {}",
+                    connection.id
+                );
+            }
+            open
+        });
+        self.connections.len()
+    }
+
+    /// How many connections a [`SelectionHub::send_now`] would reach.
+    pub(crate) fn send_now_count(&self) -> usize {
+        self.connections.len()
+    }
+
+    pub(crate) fn connect(&mut self, connection: Connection) {
+        self.connections.push(connection);
+    }
+
+    pub(crate) fn disconnect(&mut self, id: u64) {
+        self.connections.retain(|connection| connection.id != id);
+    }
+}
+
+pub(crate) fn observe_active_item(
+    item: Option<Box<dyn ItemHandle>>,
+    cx: &mut App,
+) -> ObservedSelection {
+    // Nothing open is an editor with no file, as VS Code and `getCurrentSelection`
+    // always had it; only an open item that is not an editor keeps the selection.
+    let Some(item) = item else {
+        return ObservedSelection::Editor(None);
+    };
+    let Some(editor) = item.act_as::<Editor>(cx) else {
+        return ObservedSelection::NotAnEditor;
+    };
+    ObservedSelection::Editor(editor_selection(&editor, cx))
+}
+
+/// `None` unless a local file backs the editor: a diff view, a multibuffer and an
+/// untitled buffer have no path the CLI could act on.
+fn editor_selection(editor: &Entity<Editor>, cx: &mut App) -> Option<EditorSelection> {
+    editor.update(cx, |editor, cx| {
+        let path = editor
+            .buffer()
+            .read(cx)
+            .as_singleton()?
+            .read(cx)
+            .file()?
+            .as_local()?
+            .abs_path(cx);
+        let display_snapshot = editor.display_snapshot(cx);
+        let cursor = editor.selections.newest::<Point>(&display_snapshot);
+        let text = editor
+            .buffer()
+            .read(cx)
+            .snapshot(cx)
+            .text_for_range(cursor.start..cursor.end)
+            .collect();
+        // `Point::column` counts bytes, where VS Code counts UTF-16 units; the two
+        // agree on ASCII lines, which is what `getCurrentSelection` always sent.
+        Some(EditorSelection {
+            file_path: path.to_string_lossy().into_owned(),
+            text,
+            start: SelectionPoint {
+                line: cursor.start.row,
+                character: cursor.start.column,
+            },
+            end: SelectionPoint {
+                line: cursor.end.row,
+                character: cursor.end.column,
+            },
+        })
+    })
+}
+
+/// Feeds one connection: `updates` carries every new `selection_changed`, and
+/// what the schedule lets through goes to `out`, which the connection writes.
+/// Ends when either side is gone.
+pub(crate) async fn pump_selection(
+    current: Value,
+    mut updates: mpsc::UnboundedReceiver<Value>,
+    out: mpsc::UnboundedSender<Value>,
+    executor: BackgroundExecutor,
+) {
+    // The executor's clock, not `Instant::now`, so a test scheduler can drive it.
+    let mut feed = SelectionFeed::connected(executor.now(), current);
+    loop {
+        let mut timer = match feed.next_due() {
+            Some(due) => executor
+                .timer(due.saturating_duration_since(executor.now()))
+                .left_future(),
+            None => futures::future::pending().right_future(),
+        }
+        .fuse();
+        let ready = futures::select_biased! {
+            update = updates.next() => match update {
+                Some(update) => feed.offer(executor.now(), update),
+                None => break,
+            },
+            () = timer => feed.poll_due(executor.now()),
+        };
+        if let Some(notification) = ready
+            && out.unbounded_send(notification).is_err()
+        {
+            log::debug!("claude_code_ide: selection feed stopped, its connection closed");
+            break;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn observed(path: &str) -> ObservedSelection {
+        ObservedSelection::Editor(Some(EditorSelection {
+            file_path: path.to_owned(),
+            text: String::new(),
+            start: SelectionPoint {
+                line: 1,
+                character: 0,
+            },
+            end: SelectionPoint {
+                line: 1,
+                character: 0,
+            },
+        }))
+    }
+
+    #[test]
+    fn selection_hub_pushes_a_change_whichever_path_observed_it() {
+        let mut hub = SelectionHub::default();
+        let (selection_updates, mut updates) = mpsc::unbounded();
+        let (notifications, _socket) = mpsc::unbounded();
+        hub.connect(Connection {
+            id: 0,
+            selection_updates,
+            notifications,
+        });
+        hub.observe(observed("/work/a.rs"));
+        hub.observe(observed("/work/a.rs"));
+        let pushed = updates.try_recv().ok();
+        assert_eq!(
+            pushed.map(|notification| notification["params"]["filePath"].clone()),
+            Some(Value::from("/work/a.rs"))
+        );
+        assert!(
+            updates.try_recv().is_err(),
+            "an unchanged selection is not pushed twice"
+        );
+    }
+
+    #[test]
+    fn selection_hub_drops_a_closed_connection_and_keeps_the_open_one() {
+        let mut hub = SelectionHub::default();
+        let (closed, closed_updates) = mpsc::unbounded();
+        let (open, mut open_updates) = mpsc::unbounded();
+        drop(closed_updates);
+        let (closed_socket, _closed_socket_rx) = mpsc::unbounded();
+        let (open_socket, _open_socket_rx) = mpsc::unbounded();
+        hub.connect(Connection {
+            id: 0,
+            selection_updates: closed,
+            notifications: closed_socket,
+        });
+        hub.connect(Connection {
+            id: 1,
+            selection_updates: open,
+            notifications: open_socket,
+        });
+        hub.observe(observed("/work/b.rs"));
+        assert_eq!(hub.connections.len(), 1);
+        assert_eq!(hub.connections[0].id, 1);
+        assert!(open_updates.try_recv().ok().is_some());
+    }
+
+    #[test]
+    fn mention_reaches_every_open_connection_and_counts_them() {
+        let mut hub = SelectionHub::default();
+        assert_eq!(hub.send_now(Value::from("nobody")), 0);
+
+        let (selection_updates, _updates) = mpsc::unbounded();
+        let (notifications, mut socket) = mpsc::unbounded();
+        hub.connect(Connection {
+            id: 0,
+            selection_updates,
+            notifications,
+        });
+        let (gone_updates, _gone_updates_rx) = mpsc::unbounded();
+        let (gone, gone_socket) = mpsc::unbounded();
+        drop(gone_socket);
+        hub.connect(Connection {
+            id: 1,
+            selection_updates: gone_updates,
+            notifications: gone,
+        });
+
+        assert_eq!(hub.send_now(Value::from("mention")), 1);
+        assert_eq!(socket.try_recv().ok(), Some(Value::from("mention")));
+        assert_eq!(hub.connections.len(), 1, "the closed connection is dropped");
+    }
+}
