@@ -0,0 +1,132 @@
+//! Story 066 (tech review of 3.1): a request the user has not answered yet -- `openDiff`
+//! waits for Keep or Reject -- must not hold back the pushes or the other requests on the
+//! same connection. Before the frame loop ran requests concurrently, no `selection_changed`
+//! left the socket while a diff was open.
+
+use std::{future::Future, time::Duration};
+
+use async_tungstenite::{
+    WebSocketStream,
+    tungstenite::{Message, client::IntoClientRequest as _},
+};
+use claude_code_ide::{
+    Dispatcher, ProtocolError, ToolDescriptor, bind, selection_changed_notification,
+    serve_connection,
+};
+use futures::{StreamExt as _, channel::mpsc, executor::block_on};
+use serde_json::{Value, json};
+
+const TOKEN: &str = "the-token";
+
+/// Stands in for `WorkspaceDispatcher` with one tool that never answers, like an
+/// `openDiff` the user is still looking at.
+struct FakeUndecidedDiffDispatcher;
+
+impl Dispatcher for FakeUndecidedDiffDispatcher {
+    fn tools(&self) -> Vec<ToolDescriptor> {
+        Vec::new()
+    }
+
+    async fn call_tool(&self, name: &str, _arguments: Value) -> Result<Value, ProtocolError> {
+        if name == "openDiff" {
+            futures::future::pending::<()>().await;
+        }
+        Ok(json!({ "answered": name }))
+    }
+}
+
+async fn within<T>(limit: Duration, future: impl Future<Output = T>) -> Option<T> {
+    smol::future::or(async { Some(future.await) }, async {
+        smol::unblock(move || std::thread::sleep(limit)).await;
+        None
+    })
+    .await
+}
+
+async fn connect(port: u16) -> WebSocketStream<smol::net::TcpStream> {
+    let stream = smol::net::TcpStream::connect(("127.0.0.1", port))
+        .await
+        .expect("connecting to the test listener");
+    let mut request = format!("ws://127.0.0.1:{port}/")
+        .into_client_request()
+        .expect("a valid request");
+    let headers = request.headers_mut();
+    headers.insert(
+        "x-claude-code-ide-authorization",
+        TOKEN.parse().expect("a header value"),
+    );
+    headers.insert(
+        "Sec-WebSocket-Protocol",
+        "mcp".parse().expect("a header value"),
+    );
+    async_tungstenite::client_async(request, stream)
+        .await
+        .expect("the upgrade succeeds")
+        .0
+}
+
+#[test]
+fn an_undecided_diff_does_not_hold_back_pushes_or_other_requests() {
+    block_on(async {
+        let (listener, port) = bind().await.expect("binding the test listener");
+        let (notify, notifications) = mpsc::unbounded::<Value>();
+        let server = smol::spawn(async move {
+            let (stream, _) = listener.accept().await.expect("accepting the test client");
+            serve_connection(
+                stream,
+                TOKEN.to_owned(),
+                FakeUndecidedDiffDispatcher,
+                notifications,
+            )
+            .await
+        });
+        let mut socket = connect(port).await;
+
+        socket
+            .send(Message::text(
+                r#"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"openDiff","arguments":{}}}"#,
+            ))
+            .await
+            .expect("sending the diff request");
+        let pushed = selection_changed_notification(None);
+        notify
+            .unbounded_send(pushed.clone())
+            .expect("the server holds the receiver");
+        socket
+            .send(Message::text(
+                r#"{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"getOpenEditors","arguments":{}}}"#,
+            ))
+            .await
+            .expect("sending a second request");
+
+        let mut frames = Vec::new();
+        within(Duration::from_secs(3), async {
+            while frames.len() < 2 {
+                match socket.next().await {
+                    Some(Ok(Message::Text(text))) => frames.push(
+                        serde_json::from_str::<Value>(text.as_str()).expect("one JSON value"),
+                    ),
+                    Some(Ok(_)) => continue,
+                    _ => break,
+                }
+            }
+        })
+        .await;
+
+        assert!(
+            frames.contains(&pushed),
+            "the push waited for the diff: {frames:?}"
+        );
+        assert!(
+            frames.iter().any(|frame| frame["id"] == 2),
+            "the second request waited for the diff: {frames:?}"
+        );
+        assert!(
+            !frames.iter().any(|frame| frame["id"] == 1),
+            "the undecided diff must still be pending: {frames:?}"
+        );
+
+        drop(socket);
+        server.cancel().await;
+    });
+}
