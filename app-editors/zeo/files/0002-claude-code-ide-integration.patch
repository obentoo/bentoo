index 0000000..427d33c
--- /dev/null
+++ b/crates/claude_code_ide/src/server.rs
@@ -0,0 +1,734 @@
+//! WebSocket transport and JSON-RPC/MCP message routing for the Claude Code IDE
+//! integration.
+//!
+//! The Claude Code CLI connects to us as a WebSocket client and speaks a
+//! WebSocket variant of MCP (Model Context Protocol): newline-free JSON-RPC 2.0
+//! objects, one per WebSocket text frame. This module owns the wire protocol; it
+//! knows nothing about Zed's editor state. Everything that needs to read or act
+//! on the workspace is delegated through the [`Dispatcher`] trait, which the
+//! GPUI-aware layer implements.
+
+use anyhow::{Context as _, Result};
+use async_tungstenite::tungstenite::{
+    Message,
+    handshake::server::{ErrorResponse, Request, Response},
+    http,
+};
+use futures::{AsyncRead, AsyncWrite, StreamExt as _, stream::FuturesUnordered};
+use serde::Serialize;
+use serde_json::{Value, json};
+
+/// The MCP protocol revision the official extensions speak. Sent back from
+/// `initialize`; the CLI checks it for compatibility.
+pub const MCP_PROTOCOL_VERSION: &str = "2024-11-05";
+
+const SERVER_NAME: &str = "zed";
+const SERVER_VERSION: &str = env!("CARGO_PKG_VERSION");
+
+/// The HTTP header the CLI must send, carrying the token from the lock file.
+pub const AUTH_HEADER: &str = "x-claude-code-ide-authorization";
+
+/// JSON-RPC 2.0 standard error codes (see the spec, section 5.1).
+pub mod error_codes {
+    pub const PARSE_ERROR: i32 = -32700;
+    pub const INVALID_REQUEST: i32 = -32600;
+    pub const METHOD_NOT_FOUND: i32 = -32601;
+    pub const INTERNAL_ERROR: i32 = -32603;
+}
+
+/// The WebSocket subprotocol the Claude CLI offers on every IDE connection.
+///
+/// RFC 6455 lets the server pick one of the subprotocols the client offered, or
+/// none. "None" is not a workable answer here: the CLI's WebSocket client
+/// closes the connection with code 1002 ("Missing client protocol") when the
+/// 101 response does not name a subprotocol back, so a handshake that omits
+/// this header completes at the HTTP level and then carries no JSON-RPC at all.
+pub const MCP_SUBPROTOCOL: &str = "mcp";
+
+/// The subprotocol to echo in the handshake response, given the client's
+/// `Sec-WebSocket-Protocol` offer. `None` when the client offered nothing we
+/// speak — echoing a subprotocol that was never offered is itself a violation.
+///
+/// The header may repeat and each occurrence may list several values, so both
+/// shapes are flattened before matching.
+pub fn negotiate_subprotocol<'a>(
+    offered: impl IntoIterator<Item = &'a str>,
+) -> Option<&'static str> {
+    offered
+        .into_iter()
+        .flat_map(|value| value.split(','))
+        .any(|protocol| protocol.trim().eq_ignore_ascii_case(MCP_SUBPROTOCOL))
+        .then_some(MCP_SUBPROTOCOL)
+}
+
+/// An error a method handler can return; serialized into the JSON-RPC `error`
+/// field of the response.
+#[derive(Debug)]
+pub struct ProtocolError {
+    pub code: i32,
+    pub message: String,
+    pub data: Option<Value>,
+}
+
+impl ProtocolError {
+    pub fn new(code: i32, message: impl Into<String>) -> Self {
+        Self {
+            code,
+            message: message.into(),
+            data: None,
+        }
+    }
+
+    pub fn method_not_found(method: &str) -> Self {
+        Self::new(
+            error_codes::METHOD_NOT_FOUND,
+            format!("Method not found: {method}"),
+        )
+    }
+
+    pub fn internal(message: impl Into<String>) -> Self {
+        Self::new(error_codes::INTERNAL_ERROR, message)
+    }
+}
+
+/// One MCP tool as advertised by `tools/list`. Serializes to
+/// `{"name": ..., "description": ..., "inputSchema": {...}}`.
+#[derive(Debug, Clone, Serialize)]
+pub struct ToolDescriptor {
+    pub name: &'static str,
+    pub description: &'static str,
+    #[serde(rename = "inputSchema")]
+    pub input_schema: Value,
+}
+
+/// The seam between the wire protocol (this module) and Zed's editor state.
+///
+/// Implementors live in the GPUI layer: `call_tool` reaches into the workspace
+/// to satisfy a `tools/call` request. The protocol layer only ever sees JSON.
+// The dispatcher runs on GPUI's single-threaded foreground executor, so its
+// futures are intentionally `!Send`; we don't need the `Send` bound the lint
+// asks us to consider.
+#[allow(async_fn_in_trait)]
+pub trait Dispatcher {
+    /// The tools advertised in response to `tools/list`.
+    fn tools(&self) -> Vec<ToolDescriptor>;
+
+    /// Execute a `tools/call`. `Ok` is the MCP result object (typically
+    /// `{"content": [{"type": "text", "text": "<json>"}]}`).
+    async fn call_tool(&self, name: &str, arguments: Value) -> Result<Value, ProtocolError>;
+}
+
+/// Binds a fresh WebSocket listener on the loopback interface, letting the OS
+/// pick a free port. Returns the listener and the port we got, which the caller
+/// writes into the lock file and injects into the terminal environment.
+pub async fn bind() -> Result<(smol::net::TcpListener, u16)> {
+    let listener = smol::net::TcpListener::bind("127.0.0.1:0")
+        .await
+        .context("binding Claude Code IDE WebSocket listener")?;
+    let port = listener.local_addr().context("reading bound port")?.port();
+    Ok((listener, port))
+}
+
+/// Performs the WebSocket handshake (validating the auth header against
+/// `auth_token`), then serves JSON-RPC requests until the client disconnects.
+///
+/// `notifications` are ready JSON-RPC notifications (`selection_changed`,
+/// `at_mentioned`) written to the client as they arrive, each in its own text
+/// frame on the same socket. The connection ends with the client, never with
+/// the stream: a stream that ends only stops the pushes.
+pub async fn serve_connection<S, D, N>(
+    stream: S,
+    auth_token: String,
+    dispatcher: D,
+    notifications: N,
+) -> Result<()>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+    D: Dispatcher,
+    N: futures::Stream<Item = Value> + Unpin,
+{
+    // The handshake callback runs during the HTTP upgrade. We reject the
+    // connection unless it presents the exact token we wrote into the lock file,
+    // so only the CLI that read our lock file (same user) can connect.
+    let authorize =
+        move |request: &Request, response: Response| -> Result<Response, ErrorResponse> {
+            let presented = request
+                .headers()
+                .get(AUTH_HEADER)
+                .map(|value| value.as_bytes());
+            if presented == Some(auth_token.as_bytes()) {
+                let offered = request
+                    .headers()
+                    .get_all(http::header::SEC_WEBSOCKET_PROTOCOL)
+                    .iter()
+                    .filter_map(|value| value.to_str().ok());
+                let mut response = response;
+                if let Some(protocol) = negotiate_subprotocol(offered) {
+                    response.headers_mut().insert(
+                        http::header::SEC_WEBSOCKET_PROTOCOL,
+                        http::HeaderValue::from_static(protocol),
+                    );
+                }
+                Ok(response)
+            } else {
+                let denied = http::Response::builder()
+                    .status(http::StatusCode::UNAUTHORIZED)
+                    .body(Some("invalid or missing authorization token".to_string()))
+                    .expect("static unauthorized response is valid");
+                Err(denied)
+            }
+        };
+
+    let websocket = async_tungstenite::accept_hdr_async(stream, authorize)
+        .await
+        .context("websocket handshake failed")?;
+
+    let (mut outgoing, incoming) = websocket.split();
+    let mut incoming = incoming.fuse();
+    let mut notifications = notifications.fuse();
+    // Requests run concurrently with the frame loop: `openDiff` holds its
+    // request until the user decides, and pushes and pings must not wait for it.
+    let mut in_flight = FuturesUnordered::new();
+
+    loop {
+        let message = futures::select_biased! {
+            message = incoming.next() => message,
+            response = in_flight.select_next_some() => {
+                if let Some(response) = response {
+                    outgoing
+                        .send(Message::Text(String::into(response)))
+                        .await
+                        .context("sending response")?;
+                }
+                continue;
+            }
+            notification = notifications.next() => {
+                if let Some(notification) = notification
+                    && let Err(error) = outgoing
+                        .send(Message::Text(notification.to_string().into()))
+                        .await
+                {
+                    // The client went away between two frames; nothing to report.
+                    log::debug!("claude_code_ide: notification not delivered, connection closed: {error}");
+                    break;
+                }
+                continue;
+            }
+        };
+        let Some(message) = message else { break };
+        match message.context("reading websocket frame")? {
+            Message::Text(text) => {
+                let dispatcher = &dispatcher;
+                in_flight.push(async move { handle_message(text.as_str(), dispatcher).await });
+            }
+            // Reply to keepalive pings so the CLI doesn't consider us dead.
+            Message::Ping(payload) => {
+                outgoing
+                    .send(Message::Pong(payload))
+                    .await
+                    .context("sending pong")?;
+            }
+            Message::Close(_) => break,
+            _ => {}
+        }
+    }
+
+    Ok(())
+}
+
+/// Routes a single incoming JSON-RPC message. Returns `Some(json)` to send back
+/// for requests (those with an `id`), or `None` for notifications and for
+/// messages we intentionally don't answer.
+///
+/// Kept free of sockets and GPUI so it is unit-testable against a mock
+/// [`Dispatcher`].
+pub async fn handle_message<D: Dispatcher>(raw: &str, dispatcher: &D) -> Option<String> {
+    let parsed: Value = match serde_json::from_str(raw) {
+        Ok(value) => value,
+        Err(_) => {
+            return Some(error_response(
+                Value::Null,
+                error_codes::PARSE_ERROR,
+                "Parse error",
+            ));
+        }
+    };
+
+    if parsed.get("jsonrpc").and_then(Value::as_str) != Some("2.0") {
+        let id = parsed.get("id").cloned().unwrap_or(Value::Null);
+        return Some(error_response(
+            id,
+            error_codes::INVALID_REQUEST,
+            "Invalid Request",
+        ));
+    }
+
+    let method = parsed
+        .get("method")
+        .and_then(Value::as_str)
+        .unwrap_or_default();
+    let params = parsed.get("params").cloned().unwrap_or(Value::Null);
+    let id = parsed.get("id").cloned();
+
+    match id {
+        // A request: the client expects a response carrying the same `id`.
+        Some(id) => Some(match route_request(method, params, dispatcher).await {
+            Ok(result) => success_response(id, result),
+            Err(error) => error_response_with_data(id, error.code, &error.message, error.data),
+        }),
+        // A notification: fire-and-forget, no response.
+        None => {
+            // `notifications/initialized` and friends need no action yet.
+            None
+        }
+    }
+}
+
+async fn route_request<D: Dispatcher>(
+    method: &str,
+    params: Value,
+    dispatcher: &D,
+) -> Result<Value, ProtocolError> {
+    match method {
+        "initialize" => Ok(json!({
+            "protocolVersion": MCP_PROTOCOL_VERSION,
+            "capabilities": {
+                "logging": {},
+                "prompts": { "listChanged": true },
+                "resources": { "subscribe": true, "listChanged": true },
+                "tools": { "listChanged": true },
+            },
+            "serverInfo": { "name": SERVER_NAME, "version": SERVER_VERSION },
+        })),
+        "prompts/list" => Ok(json!({ "prompts": [] })),
+        "resources/list" => Ok(json!({ "resources": [] })),
+        "tools/list" => Ok(json!({ "tools": dispatcher.tools() })),
+        "tools/call" => {
+            let name = params.get("name").and_then(Value::as_str).ok_or_else(|| {
+                ProtocolError::new(error_codes::INVALID_REQUEST, "missing tool name")
+            })?;
+            let arguments = params.get("arguments").cloned().unwrap_or(json!({}));
+            dispatcher.call_tool(name, arguments).await
+        }
+        other => Err(ProtocolError::method_not_found(other)),
+    }
+}
+
+fn success_response(id: Value, result: Value) -> String {
+    json!({ "jsonrpc": "2.0", "id": id, "result": result }).to_string()
+}
+
+fn error_response(id: Value, code: i32, message: &str) -> String {
+    error_response_with_data(id, code, message, None)
+}
+
+fn error_response_with_data(id: Value, code: i32, message: &str, data: Option<Value>) -> String {
+    let mut error = json!({ "code": code, "message": message });
+    if let Some(data) = data {
+        error["data"] = data;
+    }
+    json!({ "jsonrpc": "2.0", "id": id, "error": error }).to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures::executor::block_on;
+
+    struct MockDispatcher;
+
+    impl Dispatcher for MockDispatcher {
+        fn tools(&self) -> Vec<ToolDescriptor> {
+            vec![ToolDescriptor {
+                name: "getCurrentSelection",
+                description: "Get the current selection",
+                input_schema: json!({ "type": "object" }),
+            }]
+        }
+
+        async fn call_tool(&self, name: &str, arguments: Value) -> Result<Value, ProtocolError> {
+            if name == "getCurrentSelection" {
+                Ok(json!({ "content": [{ "type": "text", "text": "ok" }] }))
+            } else {
+                Err(ProtocolError::method_not_found(name))
+            }
+            .map(|result| {
+                // Thread `arguments` through so the test exercises the path.
+                let _ = &arguments;
+                result
+            })
+        }
+    }
+
+    fn response(raw: &str) -> Value {
+        let json = block_on(handle_message(raw, &MockDispatcher)).expect("expected a response");
+        serde_json::from_str(&json).unwrap()
+    }
+
+    /// Drives a real socket through `accept_hdr_async`, because the defect this
+    /// guards against lived *between* `negotiate_subprotocol` and the wire: the
+    /// handshake callback returned a perfectly valid 101 that simply named no
+    /// subprotocol, and every unit test around it stayed green.
+    #[test]
+    fn handshake_echoes_the_subprotocol_over_a_real_socket() {
+        use futures::{AsyncReadExt as _, AsyncWriteExt as _};
+
+        block_on(async {
+            let (listener, port) = bind().await.expect("binding the test listener");
+            let server = smol::spawn(async move {
+                let (stream, _) = listener.accept().await.expect("accepting the test client");
+                serve_connection(
+                    stream,
+                    "the-token".to_owned(),
+                    MockDispatcher,
+                    futures::stream::pending::<Value>(),
+                )
+                .await
+            });
+
+            let mut client = smol::net::TcpStream::connect(("127.0.0.1", port))
+                .await
+                .expect("connecting to the test listener");
+            let request = format!(
+                "GET / HTTP/1.1\r\n\
+                 Host: 127.0.0.1:{port}\r\n\
+                 Upgrade: websocket\r\n\
+                 Connection: Upgrade\r\n\
+                 Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\
+                 Sec-WebSocket-Version: 13\r\n\
+                 Sec-WebSocket-Protocol: mcp\r\n\
+                 {AUTH_HEADER}: the-token\r\n\r\n"
+            );
+            client
+                .write_all(request.as_bytes())
+                .await
+                .expect("sending the upgrade request");
+
+            let mut buffer = [0u8; 512];
+            let read = client
+                .read(&mut buffer)
+                .await
+                .expect("reading the response");
+            let response = String::from_utf8_lossy(&buffer[..read]).to_lowercase();
+
+            assert!(
+                response.starts_with("http/1.1 101"),
+                "expected an upgrade, got:\n{response}"
+            );
+            assert!(
+                response.contains("sec-websocket-protocol: mcp"),
+                "the 101 named no subprotocol, so the CLI would close it with 1002:\n{response}"
+            );
+
+            drop(client);
+            server.cancel().await;
+        });
+    }
+
+    /// Sends an upgrade request to a fresh server whose token is `the-token`,
+    /// presenting `presented` in the auth header (or no header for `None`), and
+    /// returns the start of the response, lowercased.
+    fn upgrade_response(presented: Option<&str>) -> String {
+        use futures::{AsyncReadExt as _, AsyncWriteExt as _};
+
+        block_on(async {
+            let (listener, port) = bind().await.expect("binding the test listener");
+            let server = smol::spawn(async move {
+                let (stream, _) = listener.accept().await.expect("accepting the test client");
+                serve_connection(
+                    stream,
+                    "the-token".to_owned(),
+                    MockDispatcher,
+                    futures::stream::pending::<Value>(),
+                )
+                .await
+            });
+
+            let mut client = smol::net::TcpStream::connect(("127.0.0.1", port))
+                .await
+                .expect("connecting to the test listener");
+            let auth = presented
+                .map(|token| format!("{AUTH_HEADER}: {token}\r\n"))
+                .unwrap_or_default();
+            let request = format!(
+                "GET / HTTP/1.1\r\n\
+                 Host: 127.0.0.1:{port}\r\n\
+                 Upgrade: websocket\r\n\
+                 Connection: Upgrade\r\n\
+                 Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\
+                 Sec-WebSocket-Version: 13\r\n\
+                 Sec-WebSocket-Protocol: mcp\r\n\
+                 {auth}\r\n"
+            );
+            client
+                .write_all(request.as_bytes())
+                .await
+                .expect("sending the upgrade request");
+
+            let mut buffer = [0u8; 512];
+            let read = client
+                .read(&mut buffer)
+                .await
+                .expect("reading the response");
+            let response = String::from_utf8_lossy(&buffer[..read]).to_lowercase();
+            drop(client);
+            server.cancel().await;
+            response
+        })
+    }
+
+    /// Only the exact token opens the socket. Today's check is a byte-for-byte
+    /// comparison; a relaxed one (prefix, contains, case-folded) would still let
+    /// the missing-header test pass, so each near miss is pinned here. No Origin
+    /// check exists: a browser cannot set this custom header, so this token test
+    /// is also the guard against a web page reaching the server.
+    #[test]
+    fn handshake_with_a_wrong_token_is_rejected() {
+        for presented in ["wrong", "the-token-extra", "the-toke", "THE-TOKEN", ""] {
+            let response = upgrade_response(Some(presented));
+            assert!(
+                response.starts_with("http/1.1 401"),
+                "token {presented:?} must be rejected, got:\n{response}"
+            );
+        }
+        assert!(
+            upgrade_response(Some("the-token")).starts_with("http/1.1 101"),
+            "the exact token still upgrades"
+        );
+    }
+
+    /// The same socket, without the token: the upgrade must be refused outright
+    /// rather than answered with a subprotocol.
+    #[test]
+    fn handshake_without_the_token_is_rejected() {
+        use futures::{AsyncReadExt as _, AsyncWriteExt as _};
+
+        block_on(async {
+            let (listener, port) = bind().await.expect("binding the test listener");
+            let server = smol::spawn(async move {
+                let (stream, _) = listener.accept().await.expect("accepting the test client");
+                serve_connection(
+                    stream,
+                    "the-token".to_owned(),
+                    MockDispatcher,
+                    futures::stream::pending::<Value>(),
+                )
+                .await
+            });
+
+            let mut client = smol::net::TcpStream::connect(("127.0.0.1", port))
+                .await
+                .expect("connecting to the test listener");
+            let request = format!(
+                "GET / HTTP/1.1\r\n\
+                 Host: 127.0.0.1:{port}\r\n\
+                 Upgrade: websocket\r\n\
+                 Connection: Upgrade\r\n\
+                 Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\
+                 Sec-WebSocket-Version: 13\r\n\
+                 Sec-WebSocket-Protocol: mcp\r\n\r\n"
+            );
+            client
+                .write_all(request.as_bytes())
+                .await
+                .expect("sending the upgrade request");
+
+            let mut buffer = [0u8; 512];
+            let read = client
+                .read(&mut buffer)
+                .await
+                .expect("reading the response");
+            let response = String::from_utf8_lossy(&buffer[..read]).to_lowercase();
+
+            assert!(
+                response.starts_with("http/1.1 401"),
+                "expected a rejection, got:\n{response}"
+            );
+
+            drop(client);
+            server.cancel().await;
+        });
+    }
+
+    #[test]
+    fn subprotocol_is_echoed_when_the_client_offers_mcp() {
+        assert_eq!(negotiate_subprotocol(["mcp"]), Some("mcp"));
+    }
+
+    /// The CLI sends a single header value; a proxy may split or merge it. Both
+    /// shapes have to resolve to the same answer.
+    #[test]
+    fn subprotocol_is_found_in_a_list_and_across_repeated_headers() {
+        assert_eq!(negotiate_subprotocol(["chat, mcp"]), Some("mcp"));
+        assert_eq!(negotiate_subprotocol(["chat", "mcp"]), Some("mcp"));
+        assert_eq!(negotiate_subprotocol(["MCP"]), Some("mcp"));
+    }
+
+    /// Echoing a subprotocol the client never offered breaks RFC 6455 just as
+    /// omitting an offered one does, so silence is the right answer here.
+    #[test]
+    fn no_subprotocol_is_echoed_when_none_was_offered() {
+        assert_eq!(negotiate_subprotocol([]), None);
+        assert_eq!(negotiate_subprotocol(["chat"]), None);
+        assert_eq!(negotiate_subprotocol(["mcp-v2"]), None);
+    }
+
+    #[test]
+    fn initialize_reports_protocol_version() {
+        let value = response(r#"{"jsonrpc":"2.0","id":1,"method":"initialize"}"#);
+        assert_eq!(value["id"], 1);
+        assert_eq!(value["result"]["protocolVersion"], MCP_PROTOCOL_VERSION);
+        assert_eq!(value["result"]["serverInfo"]["name"], "zed");
+    }
+
+    #[test]
+    fn tools_list_returns_advertised_tools() {
+        let value = response(r#"{"jsonrpc":"2.0","id":2,"method":"tools/list"}"#);
+        assert_eq!(value["result"]["tools"][0]["name"], "getCurrentSelection");
+        assert_eq!(value["result"]["tools"][0]["inputSchema"]["type"], "object");
+    }
+
+    #[test]
+    fn tools_call_wraps_result_in_mcp_content() {
+        let value = response(
+            r#"{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"getCurrentSelection","arguments":{}}}"#,
+        );
+        assert_eq!(value["result"]["content"][0]["type"], "text");
+        assert_eq!(value["result"]["content"][0]["text"], "ok");
+    }
+
+    #[test]
+    fn unknown_tool_is_a_method_not_found_error() {
+        let value = response(
+            r#"{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"nope","arguments":{}}}"#,
+        );
+        assert_eq!(value["error"]["code"], error_codes::METHOD_NOT_FOUND);
+    }
+
+    #[test]
+    fn unknown_method_is_a_method_not_found_error() {
+        let value = response(r#"{"jsonrpc":"2.0","id":5,"method":"frobnicate"}"#);
+        assert_eq!(value["error"]["code"], error_codes::METHOD_NOT_FOUND);
+    }
+
+    /// Only JSON-RPC 2.0 is served: any other version is an invalid request, not a
+    /// call to answer.
+    #[test]
+    fn a_request_that_is_not_json_rpc_2_is_invalid() {
+        for raw in [
+            r#"{"jsonrpc":"1.0","id":6,"method":"initialize"}"#,
+            r#"{"id":7,"method":"initialize"}"#,
+        ] {
+            let value = response(raw);
+            assert_eq!(
+                value["error"]["code"],
+                error_codes::INVALID_REQUEST,
+                "{raw}"
+            );
+        }
+    }
+
+    /// A tools/call that names no tool is an invalid request, never a call to some
+    /// default tool.
+    #[test]
+    fn tools_call_without_a_name_is_invalid() {
+        let value =
+            response(r#"{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"arguments":{}}}"#);
+        assert_eq!(value["error"]["code"], error_codes::INVALID_REQUEST);
+    }
+
+    /// Past the 101: a text frame carrying a request gets its response frame, and a
+    /// ping gets a pong -- the frame loop, which the handshake tests stop short of.
+    #[test]
+    fn the_frame_loop_answers_requests_and_pings() {
+        use async_tungstenite::tungstenite::{Message, client::IntoClientRequest as _};
+        use futures::{SinkExt as _, StreamExt as _};
+
+        block_on(async {
+            let (listener, port) = bind().await.expect("binding the test listener");
+            let server = smol::spawn(async move {
+                let (stream, _) = listener.accept().await.expect("accepting the test client");
+                serve_connection(
+                    stream,
+                    "the-token".to_owned(),
+                    MockDispatcher,
+                    futures::stream::pending::<Value>(),
+                )
+                .await
+            });
+
+            let stream = smol::net::TcpStream::connect(("127.0.0.1", port))
+                .await
+                .expect("connecting to the test listener");
+            let mut request = format!("ws://127.0.0.1:{port}/")
+                .into_client_request()
+                .expect("a valid request");
+            request
+                .headers_mut()
+                .insert(AUTH_HEADER, "the-token".parse().unwrap());
+            request
+                .headers_mut()
+                .insert("Sec-WebSocket-Protocol", "mcp".parse().unwrap());
+            let (mut socket, _) = async_tungstenite::client_async(request, stream)
+                .await
+                .expect("the upgrade succeeds");
+
+            socket
+                .send(Message::text(
+                    r#"{"jsonrpc":"2.0","id":1,"method":"initialize"}"#,
+                ))
+                .await
+                .expect("sending a request frame");
+            let reply = loop {
+                match socket
+                    .next()
+                    .await
+                    .expect("a frame")
+                    .expect("a valid frame")
+                {
+                    Message::Text(text) => break text.to_string(),
+                    _ => continue,
+                }
+            };
+            let value: Value = serde_json::from_str(&reply).expect("a JSON response");
+            assert_eq!(value["id"], 1);
+            assert_eq!(value["result"]["protocolVersion"], MCP_PROTOCOL_VERSION);
+
+            socket
+                .send(Message::Ping(b"zeo".to_vec().into()))
+                .await
+                .expect("sending a ping");
+            let pong = loop {
+                match socket
+                    .next()
+                    .await
+                    .expect("a frame")
+                    .expect("a valid frame")
+                {
+                    Message::Pong(payload) => break payload,
+                    _ => continue,
+                }
+            };
+            assert_eq!(&pong[..], b"zeo");
+
+            drop(socket);
+            server.cancel().await;
+        });
+    }
+
+    #[test]
+    fn notification_yields_no_response() {
+        let result = block_on(handle_message(
+            r#"{"jsonrpc":"2.0","method":"notifications/initialized"}"#,
+            &MockDispatcher,
+        ));
+        assert!(result.is_none());
+    }
+
+    #[test]
+    fn malformed_json_is_a_parse_error() {
+        let value = response("not json at all");
+        assert_eq!(value["error"]["code"], error_codes::PARSE_ERROR);
+        assert_eq!(value["id"], Value::Null);
+    }
+}
diff --git a/crates/claude_code_ide/src/tools.rs b/crates/claude_code_ide/src/tools.rs
new file mode 100644
index 0000000..f20733b
--- /dev/null
+++ b/crates/claude_code_ide/src/tools.rs
@@ -0,0 +1,582 @@
+//! The GPUI-backed [`Dispatcher`] implementation: this is where the wire
+//! protocol meets Zed's editor state. Each `tools/call` is satisfied by reading
+//! the active workspace, editor, and buffers and shaping the result into the
+//! JSON the Claude Code CLI expects (mirroring the official extensions).
+
+use crate::selection::selection_params;
+use crate::selection_watch::SelectionHub;
+use crate::server::{Dispatcher, ProtocolError, ToolDescriptor, error_codes};
+use editor::{Editor, SplittableEditor};
+use gpui::{AnyWindowHandle, AsyncApp, Entity, WeakEntity};
+use language::{Buffer, DiagnosticSeverity};
+use serde_json::{Value, json};
+use std::{cell::RefCell, path::PathBuf, rc::Rc};
+use text::Point;
+use workspace::{OpenOptions, SaveIntent, Workspace};
+
+/// Satisfies tool calls against a single Zed workspace.
+///
+/// Holds a weak handle to the workspace (so the server task never keeps the
+/// window alive) plus a cheap clone of the async app context, which lets each
+/// call hop onto the foreground thread to read entity state.
+pub struct WorkspaceDispatcher {
+    workspace: WeakEntity<Workspace>,
+    window: Option<AnyWindowHandle>,
+    /// Shared with the server, which keeps it current for `selection_changed`.
+    selection: Rc<RefCell<SelectionHub>>,
+    cx: AsyncApp,
+}
+
+impl WorkspaceDispatcher {
+    pub(crate) fn new(
+        workspace: WeakEntity<Workspace>,
+        window: Option<AnyWindowHandle>,
+        selection: Rc<RefCell<SelectionHub>>,
+        cx: AsyncApp,
+    ) -> Self {
+        Self {
+            workspace,
+            window,
+            selection,
+            cx,
+        }
+    }
+
+    /// Answers from the state `selection_changed` is built from, refreshed
+    /// first so a tool call never sees a selection older than the last event.
+    fn get_current_selection(
+        &self,
+        latest: bool,
+        cx: &mut AsyncApp,
+    ) -> Result<Value, ProtocolError> {
+        let selection = self.selection.clone();
+        let payload = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                let item = workspace.active_item(cx);
+                let observed = crate::selection_watch::observe_active_item(item, cx);
+                let mut selection = selection.borrow_mut();
+                selection.observe(observed);
+                let selection = selection.state();
+                let answer = if latest {
+                    selection.latest().or(selection.current())
+                } else {
+                    selection.current()
+                };
+                match answer {
+                    Some(answer) => {
+                        let mut payload = selection_params(answer);
+                        payload["success"] = Value::Bool(true);
+                        payload
+                    }
+                    None => json!({ "success": false, "message": "No active editor found" }),
+                }
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+        Ok(mcp_text(payload))
+    }
+
+    fn get_workspace_folders(&self, cx: &mut AsyncApp) -> Result<Value, ProtocolError> {
+        let paths = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                workspace
+                    .project()
+                    .read(cx)
+                    .visible_worktrees(cx)
+                    .map(|worktree| worktree.read(cx).abs_path().to_string_lossy().into_owned())
+                    .collect::<Vec<_>>()
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+        let folders = paths
+            .iter()
+            .map(|path| {
+                let name = path
+                    .rsplit('/')
+                    .next()
+                    .filter(|name| !name.is_empty())
+                    .unwrap_or(path);
+                json!({ "name": name, "uri": format!("file://{path}"), "path": path })
+            })
+            .collect::<Vec<_>>();
+        let root_path = paths.first().cloned().unwrap_or_default();
+
+        Ok(mcp_text(json!({
+            "success": true,
+            "folders": folders,
+            "rootPath": root_path,
+        })))
+    }
+
+    /// Finds the open buffer for an absolute path, if any.
+    fn buffer_for_path(&self, path: &str, cx: &mut AsyncApp) -> Option<Entity<Buffer>> {
+        self.workspace
+            .update(cx, |workspace, cx| {
+                let project = workspace.project().read(cx);
+                let project_path = project.find_project_path(path, cx)?;
+                project.get_open_buffer(&project_path, cx)
+            })
+            .ok()
+            .flatten()
+    }
+
+    fn get_open_editors(&self, cx: &mut AsyncApp) -> Result<Value, ProtocolError> {
+        let tabs = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                let active = workspace.active_item_as::<Editor>(cx);
+                workspace
+                    .items_of_type::<Editor>(cx)
+                    .filter_map(|editor| {
+                        let is_active = active.as_ref() == Some(&editor);
+                        let editor = editor.read(cx);
+                        let buffer = editor.buffer().read(cx).as_singleton()?;
+                        let buffer = buffer.read(cx);
+                        let path = buffer
+                            .file()
+                            .and_then(|file| file.as_local())
+                            .map(|file| file.abs_path(cx).to_string_lossy().into_owned())?;
+                        let language = buffer
+                            .language()
+                            .map(|language| language.name().to_string())
+                            .unwrap_or_else(|| "plaintext".to_owned());
+                        let line_count = buffer.text_snapshot().max_point().row + 1;
+                        let label = path.rsplit('/').next().unwrap_or(&path).to_owned();
+                        Some(json!({
+                            "uri": format!("file://{path}"),
+                            "fileName": path,
+                            "label": label,
+                            "languageId": language,
+                            "isActive": is_active,
+                            "isDirty": buffer.is_dirty(),
+                            "isPinned": false,
+                            "isPreview": false,
+                            "isUntitled": false,
+                            "lineCount": line_count,
+                            "groupIndex": 0,
+                            "viewColumn": 1,
+                            "isGroupActive": true,
+                        }))
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+        Ok(mcp_text(json!({ "tabs": tabs })))
+    }
+
+    fn get_diagnostics(
+        &self,
+        arguments: &Value,
+        cx: &mut AsyncApp,
+    ) -> Result<Value, ProtocolError> {
+        let target = arguments
+            .get("uri")
+            .and_then(Value::as_str)
+            .map(|uri| uri.strip_prefix("file://").unwrap_or(uri).to_owned());
+
+        let diagnostics = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                let buffers = workspace
+                    .project()
+                    .read(cx)
+                    .buffer_store()
+                    .read(cx)
+                    .buffers()
+                    .collect::<Vec<_>>();
+                let mut out = Vec::new();
+                for buffer in buffers {
+                    let buffer = buffer.read(cx);
+                    let Some(path) = buffer
+                        .file()
+                        .and_then(|file| file.as_local())
+                        .map(|file| file.abs_path(cx).to_string_lossy().into_owned())
+                    else {
+                        continue;
+                    };
+                    if target.as_ref().is_some_and(|target| target != &path) {
+                        continue;
+                    }
+                    let snapshot = buffer.snapshot();
+                    for entry in snapshot.diagnostics_in_range::<Point, Point>(
+                        Point::new(0, 0)..snapshot.max_point(),
+                        false,
+                    ) {
+                        out.push(json!({
+                            "filePath": path,
+                            "line": entry.range.start.row + 1,
+                            "character": entry.range.start.column + 1,
+                            "severity": severity_to_number(entry.diagnostic.severity),
+                            "message": entry.diagnostic.message.clone(),
+                            "source": entry.diagnostic.source.clone(),
+                        }));
+                    }
+                }
+                out
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+        let content = diagnostics
+            .into_iter()
+            .map(|diagnostic| json!({ "type": "text", "text": diagnostic.to_string() }))
+            .collect::<Vec<_>>();
+        Ok(json!({ "content": content }))
+    }
+
+    fn check_document_dirty(
+        &self,
+        arguments: &Value,
+        cx: &mut AsyncApp,
+    ) -> Result<Value, ProtocolError> {
+        let path = required_path_field(arguments, "filePath")?;
+        match self.buffer_for_path(&path, cx) {
+            Some(buffer) => {
+                let is_dirty = buffer.update(cx, |buffer, _| buffer.is_dirty());
+                Ok(mcp_text(json!({
+                    "success": true,
+                    "filePath": path,
+                    "isDirty": is_dirty,
+                    "isUntitled": false,
+                })))
+            }
+            None => Ok(mcp_text(
+                json!({ "success": false, "message": format!("Document not open: {path}") }),
+            )),
+        }
+    }
+
+    /// Closes all open diff tabs (our `openDiff` views), returning the count.
+    fn close_diff_tabs(&self, cx: &mut AsyncApp) -> usize {
+        let Some(window) = self.window else {
+            return 0;
+        };
+        window
+            .update(cx, |_root, window, cx| {
+                let Some(workspace) = self.workspace.upgrade() else {
+                    return 0;
+                };
+                workspace.update(cx, |workspace, cx| {
+                    let ids = workspace
+                        .items_of_type::<SplittableEditor>(cx)
+                        .map(|editor| editor.entity_id())
+                        .collect::<Vec<_>>();
+                    let count = ids.len();
+                    for pane in workspace.panes().to_vec() {
+                        for id in &ids {
+                            pane.update(cx, |pane, cx| {
+                                pane.close_item_by_id(*id, SaveIntent::Skip, window, cx)
+                            })
+                            .detach();
+                        }
+                    }
+                    count
+                })
+            })
+            .unwrap_or(0)
+    }
+
+    async fn open_file(&self, arguments: Value, cx: &mut AsyncApp) -> Result<Value, ProtocolError> {
+        let path = required_path_field(&arguments, "filePath")?;
+        let start_line = arguments.get("startLine").and_then(Value::as_u64);
+        let end_line = arguments.get("endLine").and_then(Value::as_u64);
+        let window = self
+            .window
+            .ok_or_else(|| ProtocolError::internal("no window available"))?;
+        let open_task = window
+            .update(cx, |_root, window, cx| {
+                self.workspace.upgrade().map(|workspace| {
+                    workspace.update(cx, |workspace, cx| {
+                        workspace.open_abs_path(
+                            PathBuf::from(&path),
+                            OpenOptions::default(),
+                            window,
+                            cx,
+                        )
+                    })
+                })
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?
+            .ok_or_else(|| ProtocolError::internal("workspace unavailable"))?;
+        let item = open_task
+            .await
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+
+        // Optionally select the requested line range (1-indexed in the protocol).
+        if let (Some(start), Some(end)) = (start_line, end_line) {
+            window
+                .update(cx, |_root, window, cx| {
+                    if let Some(editor) = item.downcast::<Editor>() {
+                        editor.update(cx, |editor, cx| {
+                            let start = Point::new(start.saturating_sub(1) as u32, 0);
+                            let end = Point::new(end as u32, 0);
+                            editor.change_selections(
+                                Default::default(),
+                                window,
+                                cx,
+                                |selections| {
+                                    selections.select_ranges([start..end]);
+                                },
+                            );
+                        });
+                    }
+                })
+                .ok();
+        }
+
+        let message = match (start_line, end_line) {
+            (Some(start), Some(end)) => {
+                format!("Opened file and selected lines {start} to {end}")
+            }
+            _ => format!("Opened file: {path}"),
+        };
+        Ok(json!({ "content": [{ "type": "text", "text": message }] }))
+    }
+
+    async fn save_document(
+        &self,
+        arguments: Value,
+        cx: &mut AsyncApp,
+    ) -> Result<Value, ProtocolError> {
+        let path = required_path_field(&arguments, "filePath")?;
+        let Some(buffer) = self.buffer_for_path(&path, cx) else {
+            return Ok(mcp_text(
+                json!({ "success": false, "message": format!("Document not open: {path}") }),
+            ));
+        };
+        let save_task = self
+            .workspace
+            .update(cx, |workspace, cx| {
+                workspace
+                    .project()
+                    .update(cx, |project, cx| project.save_buffer(buffer, cx))
+            })
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+        save_task
+            .await
+            .map_err(|error| ProtocolError::internal(error.to_string()))?;
+        Ok(mcp_text(json!({ "success": true, "filePath": path })))
+    }
+}
+
+fn required_path_field(arguments: &Value, field: &str) -> Result<String, ProtocolError> {
+    arguments
+        .get(field)
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or_else(|| ProtocolError::new(error_codes::INVALID_REQUEST, format!("missing {field}")))
+}
+
+/// Maps Zed/LSP diagnostic severities to the numeric scale the protocol uses
+/// (1 = error, 2 = warning, 3 = information, 4 = hint).
+fn severity_to_number(severity: DiagnosticSeverity) -> u8 {
+    match severity {
+        DiagnosticSeverity::ERROR => 1,
+        DiagnosticSeverity::WARNING => 2,
+        DiagnosticSeverity::INFORMATION => 3,
+        DiagnosticSeverity::HINT => 4,
+        _ => 0,
+    }
+}
+
+/// Every tool this server answers, as `tools/list` advertises it. A free function
+/// so a plain test can hold it against `DISPATCHED`: `close_tab` was dispatched
+/// and never advertised, and nothing noticed (parity report item 32).
+fn tool_descriptors() -> Vec<ToolDescriptor> {
+    let empty_object_schema = json!({
+        "type": "object",
+        "additionalProperties": false,
+        "$schema": "http://json-schema.org/draft-07/schema#",
+    });
+    vec![
+        ToolDescriptor {
+            name: "getCurrentSelection",
+            description: "Get the current text selection in the editor",
+            input_schema: empty_object_schema.clone(),
+        },
+        ToolDescriptor {
+            name: "getLatestSelection",
+            description: "Get the most recent text selection (even if not in the active editor)",
+            input_schema: empty_object_schema.clone(),
+        },
+        ToolDescriptor {
+            name: "getWorkspaceFolders",
+            description: "Get all workspace folders currently open in the IDE",
+            input_schema: empty_object_schema.clone(),
+        },
+        ToolDescriptor {
+            name: "getOpenEditors",
+            description: "Get list of currently open files",
+            input_schema: empty_object_schema.clone(),
+        },
+        ToolDescriptor {
+            name: "closeAllDiffTabs",
+            description: "Close all diff tabs in the editor",
+            input_schema: empty_object_schema,
+        },
+        // The VS Code extension registers `close_tab` with no description and a
+        // required `tab_name`; the CLI calls it after an `openDiff` resolves.
+        // The handler below closes this window's diff tabs whatever the name.
+        ToolDescriptor {
+            name: "close_tab",
+            description: "Close the diff tab opened by openDiff",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": { "tab_name": { "type": "string" } },
+                "required": ["tab_name"],
+            }),
+        },
+        ToolDescriptor {
+            name: "getDiagnostics",
+            description: "Get language diagnostics (errors, warnings) from the editor",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": {
+                    "uri": { "type": "string" },
+                },
+            }),
+        },
+        ToolDescriptor {
+            name: "checkDocumentDirty",
+            description: "Check if a document has unsaved changes (is dirty)",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": { "filePath": { "type": "string" } },
+                "required": ["filePath"],
+            }),
+        },
+        ToolDescriptor {
+            name: "saveDocument",
+            description: "Save a document with unsaved changes",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": { "filePath": { "type": "string" } },
+                "required": ["filePath"],
+            }),
+        },
+        ToolDescriptor {
+            name: "openFile",
+            description: "Open a file in the editor and optionally select a range of text",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": {
+                    "filePath": { "type": "string" },
+                    "preview": { "type": "boolean" },
+                    "startLine": { "type": "integer" },
+                    "endLine": { "type": "integer" },
+                    "startText": { "type": "string" },
+                    "endText": { "type": "string" },
+                    "makeFrontmost": { "type": "boolean" },
+                },
+                "required": ["filePath"],
+            }),
+        },
+        ToolDescriptor {
+            name: "openDiff",
+            description: "Open a diff view comparing old file content with new file content",
+            input_schema: json!({
+                "type": "object",
+                "additionalProperties": false,
+                "$schema": "http://json-schema.org/draft-07/schema#",
+                "properties": {
+                    "old_file_path": { "type": "string" },
+                    "new_file_path": { "type": "string" },
+                    "new_file_contents": { "type": "string" },
+                    "tab_name": { "type": "string" },
+                },
+                "required": ["old_file_path", "new_file_path", "new_file_contents", "tab_name"],
+            }),
+        },
+    ]
+}
+
+/// The names `call_tool` dispatches. Kept beside it so a new arm and a missing
+/// descriptor cannot both land unseen: `every_dispatched_tool_is_advertised`.
+#[cfg(test)]
+const DISPATCHED: &[&str] = &[
+    "getCurrentSelection",
+    "getLatestSelection",
+    "getWorkspaceFolders",
+    "getOpenEditors",
+    "getDiagnostics",
+    "checkDocumentDirty",
+    "openFile",
+    "saveDocument",
+    "close_tab",
+    "closeAllDiffTabs",
+    "openDiff",
+];
+
+impl Dispatcher for WorkspaceDispatcher {
+    fn tools(&self) -> Vec<ToolDescriptor> {
+        tool_descriptors()
+    }
+
+    async fn call_tool(&self, name: &str, arguments: Value) -> Result<Value, ProtocolError> {
+        // Reading entity state has to happen on the foreground thread; a cloned
+        // `AsyncApp` lets `WeakEntity::update` marshal us there.
+        let mut cx = self.cx.clone();
+        match name {
+            "getCurrentSelection" => self.get_current_selection(false, &mut cx),
+            "getLatestSelection" => self.get_current_selection(true, &mut cx),
+            "getWorkspaceFolders" => self.get_workspace_folders(&mut cx),
+            "getOpenEditors" => self.get_open_editors(&mut cx),
+            "getDiagnostics" => self.get_diagnostics(&arguments, &mut cx),
+            "checkDocumentDirty" => self.check_document_dirty(&arguments, &mut cx),
+            "openFile" => self.open_file(arguments, &mut cx).await,
+            "saveDocument" => self.save_document(arguments, &mut cx).await,
+            "close_tab" => {
+                let closed = self.close_diff_tabs(&mut cx);
+                Ok(mcp_text(json!({ "success": true, "closed": closed })))
+            }
+            "closeAllDiffTabs" => {
+                let closed = self.close_diff_tabs(&mut cx);
+                Ok(mcp_text(json!({ "closedCount": closed })))
+            }
+            "openDiff" => {
+                crate::open_diff::open_diff(self.workspace.clone(), self.window, arguments, &mut cx)
+                    .await
+            }
+            other => Err(ProtocolError::method_not_found(other)),
+        }
+    }
+}
+
+/// Wraps a tool's payload in the MCP result envelope: the payload is
+/// JSON-stringified into a single text content block, exactly as the official
+/// extensions do.
+fn mcp_text(payload: Value) -> Value {
+    json!({ "content": [{ "type": "text", "text": payload.to_string() }] })
+}
+
+#[cfg(test)]
+mod descriptor_tests {
+    use super::*;
+
+    #[test]
+    fn every_dispatched_tool_is_advertised() {
+        let advertised: Vec<&str> = tool_descriptors().iter().map(|tool| tool.name).collect();
+        for name in DISPATCHED {
+            assert!(
+                advertised.contains(name),
+                "`{name}` is dispatched but not advertised"
+            );
+        }
+        assert_eq!(
+            advertised.len(),
+            DISPATCHED.len(),
+            "an advertised tool is not dispatched"
+        );
+    }
+}
diff --git a/crates/claude_code_ide/tests/selection_changed.rs b/crates/claude_code_ide/tests/selection_changed.rs
new file mode 100644
index 0000000..79f0a27
--- /dev/null
+++ b/crates/claude_code_ide/tests/selection_changed.rs
@@ -0,0 +1,396 @@
+//! Story 066, sub-task 3.1 (R3.1-R3.5): the server PUSHES `selection_changed` to the
+//! Claude Code CLI.
+//!
+//! The wire shape is what CLI 2.1.316 parses (read with `strings /opt/bin/claude`):
+//!
+//! ```text
+//! method:T("selection_changed"),params:u({selection:u({start:u({line:E(),character:E()}),
+//! end:u({line:E(),character:E()})}).nullable().optional(),text:o().optional(),
+//! filePath:o().optional()})
+//! ```
+//!
+//! and its handler turns `start.line` into `lineStart: start.line + 1`, so positions on the
+//! wire are 0-based. `fileUrl` and `selection.isEmpty` are what `getCurrentSelection`
+//! already answers (R3.6: one state for the tool and the notification); the CLI's schema is
+//! not strict, so it ignores them.
+//!
+//! The seam under test keeps the wire layer free of GPUI and of any clock:
+//! - `serve_connection` takes a fourth argument, a stream of ready JSON-RPC notifications,
+//!   and writes each one as its own text frame on the same socket that answers requests;
+//! - `selection_changed_notification` builds that notification from an `EditorSelection`;
+//! - `SelectionFeed` (tested in `selection_feed.rs`) is the per-connection schedule.
+
+use std::{future::Future, time::Duration};
+
+use async_tungstenite::{
+    WebSocketStream,
+    tungstenite::{Message, client::IntoClientRequest as _},
+};
+use claude_code_ide::{
+    Dispatcher, EditorSelection, ProtocolError, SelectionPoint, ToolDescriptor, bind,
+    selection_changed_notification, serve_connection,
+};
+use futures::{StreamExt as _, channel::mpsc, executor::block_on};
+use serde_json::{Value, json};
+
+/// The header literal the CLI sends (`X-Claude-Code-Ide-Authorization`); spelled out here
+/// because it is the wire contract, not a crate detail.
+const AUTH_HEADER: &str = "x-claude-code-ide-authorization";
+const TOKEN: &str = "the-token";
+
+/// Stands in for `WorkspaceDispatcher`: the push path must not depend on any tool.
+struct FakeWorkspaceDispatcher;
+
+impl Dispatcher for FakeWorkspaceDispatcher {
+    fn tools(&self) -> Vec<ToolDescriptor> {
+        Vec::new()
+    }
+
+    async fn call_tool(&self, name: &str, _arguments: Value) -> Result<Value, ProtocolError> {
+        Err(ProtocolError::method_not_found(name))
+    }
+}
+
+fn point(line: u32, character: u32) -> SelectionPoint {
+    SelectionPoint { line, character }
+}
+
+fn selection(
+    path: &str,
+    text: &str,
+    start: SelectionPoint,
+    end: SelectionPoint,
+) -> EditorSelection {
+    EditorSelection {
+        file_path: path.to_owned(),
+        text: text.to_owned(),
+        start,
+        end,
+    }
+}
+
+// ---- the notification's shape -------------------------------------------------------
+
+/// R3.1. Line 0 and character 0 are the hostile values: a 1-based conversion turns them
+/// into 1, which the CLI would then shift once more.
+#[test]
+fn selection_changed_carries_path_text_and_0_based_positions() {
+    let notification = selection_changed_notification(Some(&selection(
+        "/work/app/src/main.rs",
+        "fn main() {\n    run();\n}\n// end",
+        point(0, 0),
+        point(3, 7),
+    )));
+
+    assert_eq!(notification["jsonrpc"], "2.0", "{notification}");
+    assert_eq!(
+        notification["method"], "selection_changed",
+        "{notification}"
+    );
+    assert!(
+        notification.get("id").is_none(),
+        "a notification carries no id: {notification}"
+    );
+
+    let params = &notification["params"];
+    assert_eq!(
+        params["filePath"], "/work/app/src/main.rs",
+        "{notification}"
+    );
+    assert_eq!(
+        params["fileUrl"], "file:///work/app/src/main.rs",
+        "{notification}"
+    );
+    assert_eq!(
+        params["text"], "fn main() {\n    run();\n}\n// end",
+        "{notification}"
+    );
+    assert_eq!(
+        params["selection"]["start"],
+        json!({ "line": 0, "character": 0 })
+    );
+    assert_eq!(
+        params["selection"]["end"],
+        json!({ "line": 3, "character": 7 })
+    );
+    assert_eq!(params["selection"]["isEmpty"], false, "{notification}");
+}
+
+/// R3.2. The hostile case comes first: start and end on the same line but at different
+/// characters is NOT empty, whatever a line-only comparison would say.
+#[test]
+fn selection_changed_is_empty_only_when_start_and_end_coincide() {
+    let same_line = selection_changed_notification(Some(&selection(
+        "/work/app/src/lib.rs",
+        "let x",
+        point(4, 2),
+        point(4, 7),
+    )));
+    assert_eq!(
+        same_line["params"]["selection"]["isEmpty"], false,
+        "{same_line}"
+    );
+
+    let line_break = selection_changed_notification(Some(&selection(
+        "/work/app/src/lib.rs",
+        "\n",
+        point(1, 5),
+        point(2, 0),
+    )));
+    assert_eq!(
+        line_break["params"]["selection"]["isEmpty"], false,
+        "{line_break}"
+    );
+
+    let cursor = selection_changed_notification(Some(&selection(
+        "/work/app/src/lib.rs",
+        "",
+        point(4, 9),
+        point(4, 9),
+    )));
+    let params = &cursor["params"];
+    assert_eq!(params["selection"]["isEmpty"], true, "{cursor}");
+    assert_eq!(
+        params["selection"]["start"],
+        json!({ "line": 4, "character": 9 })
+    );
+    assert_eq!(
+        params["selection"]["end"],
+        json!({ "line": 4, "character": 9 })
+    );
+    assert_eq!(
+        params["text"], "",
+        "an empty selection sends empty text, not none: {cursor}"
+    );
+    assert_eq!(params["filePath"], "/work/app/src/lib.rs", "{cursor}");
+}
+
+/// R3.5 (refine v2, 2026-11-03). An editor with no file: CLI 2.1.316 ignores a null selection
+/// (`if(!Be?.start||!Be?.end)return;`) and keeps the previous file attached, so the clear is a
+/// zero-width selection at 0:0 with empty text and no `filePath`.
+#[test]
+fn selection_changed_without_a_file_backed_editor_sends_a_null_selection() {
+    let notification = selection_changed_notification(None);
+
+    assert_eq!(notification["jsonrpc"], "2.0", "{notification}");
+    assert_eq!(
+        notification["method"], "selection_changed",
+        "{notification}"
+    );
+    assert!(notification.get("id").is_none(), "{notification}");
+    let params = &notification["params"];
+    assert_eq!(
+        params["selection"]["start"],
+        json!({ "line": 0, "character": 0 }),
+        "{notification}"
+    );
+    assert_eq!(
+        params["selection"]["end"],
+        json!({ "line": 0, "character": 0 }),
+        "{notification}"
+    );
+    assert_eq!(params["selection"]["isEmpty"], true, "{notification}");
+    for field in ["text", "filePath"] {
+        let value = params.get(field).unwrap_or(&Value::Null);
+        assert!(
+            value.is_null() || value == "",
+            "{field} must be absent or empty without a file: {notification}"
+        );
+    }
+}
+
+// ---- the push path over a real loopback WebSocket -----------------------------------
+
+type Socket = WebSocketStream<smol::net::TcpStream>;
+
+/// A deadline that only turns a hang into a failed assertion; it never decides a pass.
+/// A thread sleep rather than `smol::Timer::after`, which the workspace's clippy config
+/// forbids for timing-dependent tests -- this one depends on no timing.
+async fn within<T>(limit: Duration, future: impl Future<Output = T>) -> Option<T> {
+    smol::future::or(async { Some(future.await) }, async {
+        smol::unblock(move || std::thread::sleep(limit)).await;
+        None
+    })
+    .await
+}
+
+async fn start_server() -> (
+    u16,
+    mpsc::UnboundedSender<Value>,
+    smol::Task<anyhow::Result<()>>,
+) {
+    let (listener, port) = bind().await.expect("binding the test listener");
+    let (notify, notifications) = mpsc::unbounded::<Value>();
+    let server = smol::spawn(async move {
+        let (stream, _) = listener.accept().await.expect("accepting the test client");
+        serve_connection(
+            stream,
+            TOKEN.to_owned(),
+            FakeWorkspaceDispatcher,
+            notifications,
+        )
+        .await
+    });
+    (port, notify, server)
+}
+
+async fn connect(port: u16) -> Socket {
+    let stream = smol::net::TcpStream::connect(("127.0.0.1", port))
+        .await
+        .expect("connecting to the test listener");
+    let mut request = format!("ws://127.0.0.1:{port}/")
+        .into_client_request()
+        .expect("a valid request");
+    request
+        .headers_mut()
+        .insert(AUTH_HEADER, TOKEN.parse().expect("a header value"));
+    request.headers_mut().insert(
+        "Sec-WebSocket-Protocol",
+        "mcp".parse().expect("a header value"),
+    );
+    let (socket, _) = async_tungstenite::client_async(request, stream)
+        .await
+        .expect("the upgrade succeeds");
+    socket
+}
+
+/// Reads text frames until `count` of them arrived or `limit` passed. Every text frame
+/// must be exactly one JSON object -- two messages in one frame are unreadable to the CLI.
+async fn read_frames(socket: &mut Socket, count: usize, limit: Duration) -> Vec<Value> {
+    let mut frames = Vec::new();
+    within(limit, async {
+        while frames.len() < count {
+            match socket.next().await {
+                Some(Ok(Message::Text(text))) => {
+                    let value: Value =
+                        serde_json::from_str(text.as_str()).unwrap_or_else(|error| {
+                            panic!("a frame that is not one JSON value ({error}): {text}")
+                        });
+                    frames.push(value);
+                }
+                Some(Ok(_)) => continue,
+                _ => break,
+            }
+        }
+    })
+    .await;
+    frames
+}
+
+/// R3.1 over the wire. Two pushes arrive as two frames, unchanged and in order -- the CLI
+/// keeps the last one it reads, so a reorder would leave it on the stale selection.
+#[test]
+fn selection_changed_is_pushed_to_the_client_unchanged_and_in_order() {
+    block_on(async {
+        let (port, notify, server) = start_server().await;
+        let mut socket = connect(port).await;
+
+        let first = selection_changed_notification(Some(&selection(
+            "/work/app/src/main.rs",
+            "run",
+            point(1, 4),
+            point(1, 7),
+        )));
+        let second = selection_changed_notification(None);
+        notify
+            .unbounded_send(first.clone())
+            .expect("the server holds the receiver");
+        notify
+            .unbounded_send(second.clone())
+            .expect("the server holds the receiver");
+
+        let frames = read_frames(&mut socket, 2, Duration::from_secs(3)).await;
+        assert_eq!(
+            frames,
+            vec![first, second],
+            "the pushed notifications, in order"
+        );
+
+        drop(socket);
+        server.cancel().await;
+    });
+}
+
+/// R3.1 beside R3.6: pushing does not take the socket away from request/response. A request
+/// sent while notifications flow still gets its own response, and both arrive.
+#[test]
+fn selection_pushes_and_request_responses_share_the_socket() {
+    block_on(async {
+        let (port, notify, server) = start_server().await;
+        let mut socket = connect(port).await;
+
+        let pushed = selection_changed_notification(Some(&selection(
+            "/work/app/src/lib.rs",
+            "",
+            point(8, 0),
+            point(8, 0),
+        )));
+        socket
+            .send(Message::text(
+                r#"{"jsonrpc":"2.0","id":1,"method":"initialize"}"#,
+            ))
+            .await
+            .expect("sending a request frame");
+        notify
+            .unbounded_send(pushed.clone())
+            .expect("the server holds the receiver");
+
+        let frames = read_frames(&mut socket, 2, Duration::from_secs(3)).await;
+        assert!(
+            frames.contains(&pushed),
+            "the pushed notification is missing: {frames:?}"
+        );
+        assert!(
+            frames
+                .iter()
+                .any(|frame| frame["id"] == 1 && frame["result"]["protocolVersion"].is_string()),
+            "the initialize response is missing: {frames:?}"
+        );
+
+        drop(socket);
+        server.cancel().await;
+    });
+}
+
+/// The push path must not keep a dead connection open: when the CLI closes, the server
+/// returns even though the notification sender is still alive.
+#[test]
+fn selection_push_does_not_keep_a_closed_connection_alive() {
+    block_on(async {
+        let (port, notify, server) = start_server().await;
+        let mut socket = connect(port).await;
+
+        socket
+            .close(None)
+            .await
+            .expect("closing from the client side");
+        drop(socket);
+        let finished = within(Duration::from_secs(3), server).await;
+
+        assert!(
+            matches!(finished, Some(Ok(()))),
+            "serve_connection did not return Ok after the client closed: {finished:?}"
+        );
+        drop(notify);
+    });
+}
+
+/// The hostile half of the test above: a CLI killed without a close frame. A push loop that
+/// waits on the notification stream after the socket is gone would keep this task, and the
+/// connection's sender, alive for the life of the window.
+#[test]
+fn selection_push_does_not_keep_a_dropped_connection_alive() {
+    block_on(async {
+        let (port, notify, server) = start_server().await;
+        let socket = connect(port).await;
+
+        drop(socket);
+        let finished = within(Duration::from_secs(3), server).await;
+
+        assert!(
+            finished.is_some(),
+            "serve_connection still runs after the client vanished without a close frame"
+        );
+        drop(notify);
+    });
+}
diff --git a/crates/claude_code_ide/tests/selection_feed.rs b/crates/claude_code_ide/tests/selection_feed.rs
new file mode 100644
index 0000000..64f0e4c
--- /dev/null
+++ b/crates/claude_code_ide/tests/selection_feed.rs
@@ -0,0 +1,181 @@
+//! Story 066, sub-task 3.1 (R3.3, R3.4): the per-connection schedule of
+//! `selection_changed` -- at most one send per 100 ms with the last state winning, and the
+//! current selection replayed 500 ms after the CLI connects (VS Code's extension replays
+//! the last selection the same way; docs/PARITY-REPORT.md section 23.6).
+//!
+//! `SelectionFeed` is driven by explicit `Instant`s, never a real clock, so the 100 ms and
+//! 500 ms below are exact. The GPUI layer owns the timer: it sleeps until `next_due()` and
+//! calls `poll_due()`, and calls `offer()` on every editor selection change.
+
+use std::time::{Duration, Instant};
+
+use claude_code_ide::SelectionFeed;
+use serde_json::{Value, json};
+
+// ---- the per-connection schedule (explicit clock) -----------------------------------
+
+/// Runs the feed's own timer to exhaustion, returning each emission with its offset from
+/// `t0` in milliseconds. Bounded, so a feed that is always due fails instead of spinning.
+fn drain(feed: &mut SelectionFeed<Value>, t0: Instant) -> Vec<(u128, Value)> {
+    let mut sent = Vec::new();
+    for _ in 0..16 {
+        let Some(due) = feed.next_due() else { break };
+        if let Some(item) = feed.poll_due(due) {
+            sent.push(((due - t0).as_millis(), item));
+        }
+    }
+    sent
+}
+
+fn at(t0: Instant, ms: u64) -> Instant {
+    t0 + Duration::from_millis(ms)
+}
+
+/// R3.4. Nothing before 500 ms, the current selection at 500 ms.
+#[test]
+fn selection_feed_replays_the_current_selection_500_ms_after_connecting() {
+    let t0 = Instant::now();
+    let current = json!({ "state": "current" });
+    let mut feed = SelectionFeed::connected(t0, current.clone());
+
+    assert_eq!(
+        feed.poll_due(at(t0, 0)),
+        None,
+        "the CLI is not listening yet at 0 ms"
+    );
+    assert_eq!(feed.poll_due(at(t0, 499)), None, "nothing before 500 ms");
+    assert_eq!(
+        feed.poll_due(at(t0, 500)),
+        Some(current),
+        "the replay is due at 500 ms"
+    );
+    assert_eq!(
+        feed.next_due(),
+        None,
+        "and nothing is left to send after it"
+    );
+}
+
+/// R3.4 with a change before the replay: the replay carries the LATEST state, never the
+/// one the connection started with.
+#[test]
+fn selection_feed_replay_carries_the_latest_state() {
+    let t0 = Instant::now();
+    let stale = json!({ "state": "at-connect" });
+    let latest = json!({ "state": "changed-at-200ms" });
+    let mut feed = SelectionFeed::connected(t0, stale.clone());
+
+    let mut sent = Vec::new();
+    if let Some(item) = feed.offer(at(t0, 200), latest.clone()) {
+        sent.push((200, item));
+    }
+    sent.extend(drain(&mut feed, t0));
+
+    assert!(
+        sent.iter()
+            .any(|(ms, item)| (500..=600).contains(ms) && *item == latest),
+        "the 500 ms replay must carry the latest state, sent: {sent:?}"
+    );
+    assert!(
+        !sent.iter().any(|(_, item)| *item == stale),
+        "the state superseded before the replay is never sent: {sent:?}"
+    );
+}
+
+/// R3.3. Three changes inside one window: never two sends closer than 100 ms, the middle
+/// state is superseded, and the last one is what the CLI ends up with.
+#[test]
+fn selection_feed_sends_at_most_one_per_100_ms_and_the_last_state_wins() {
+    let t0 = Instant::now();
+    let mut feed = SelectionFeed::connected(t0, json!({ "state": "initial" }));
+    let mut sent = drain(&mut feed, t0);
+
+    let (a, b, c) = (
+        json!({ "state": "a" }),
+        json!({ "state": "b" }),
+        json!({ "state": "c" }),
+    );
+    for (ms, item) in [(1000, a), (1010, b.clone()), (1020, c.clone())] {
+        if let Some(out) = feed.offer(at(t0, ms), item) {
+            sent.push((u128::from(ms), out));
+        }
+    }
+    assert_eq!(
+        feed.poll_due(at(t0, 1050)),
+        None,
+        "inside the window nothing more goes out"
+    );
+    sent.extend(drain(&mut feed, t0));
+
+    for pair in sent.windows(2) {
+        assert!(
+            pair[1].0 >= pair[0].0 + 100,
+            "two sends within 100 ms: {sent:?}"
+        );
+    }
+    let after_changes: Vec<_> = sent.iter().filter(|(ms, _)| *ms >= 1000).collect();
+    assert!(
+        after_changes.len() <= 2,
+        "three changes in 20 ms flooded the socket: {sent:?}"
+    );
+    assert_eq!(
+        after_changes.last().map(|(_, item)| item),
+        Some(&c),
+        "last wins: {sent:?}"
+    );
+    assert!(
+        !sent.iter().any(|(_, item)| *item == b),
+        "b was superseded: {sent:?}"
+    );
+}
+
+/// R3.3. A change after a quiet period is not held back past one window, and once the
+/// latest state is out nothing is sent again.
+#[test]
+fn selection_feed_sends_a_lone_change_within_one_window_and_never_resends() {
+    let t0 = Instant::now();
+    let mut feed = SelectionFeed::connected(t0, json!({ "state": "initial" }));
+    drain(&mut feed, t0);
+
+    let lone = json!({ "state": "lone" });
+    let mut sent = Vec::new();
+    if let Some(item) = feed.offer(at(t0, 5000), lone.clone()) {
+        sent.push((5000, item));
+    }
+    sent.extend(drain(&mut feed, t0));
+
+    assert_eq!(sent.len(), 1, "exactly one send for one change: {sent:?}");
+    assert_eq!(sent[0].1, lone);
+    assert!(
+        (5000..=5100).contains(&sent[0].0),
+        "held past one window: {sent:?}"
+    );
+    assert_eq!(feed.next_due(), None);
+    assert_eq!(feed.poll_due(at(t0, 60_000)), None, "nothing is resent");
+}
+
+/// R3.3 is per connection: a send on one connection holds nothing back on another.
+#[test]
+fn selection_feed_throttles_each_connection_on_its_own() {
+    let t0 = Instant::now();
+    let mut first = SelectionFeed::connected(t0, json!({ "conn": 1 }));
+    let mut second = SelectionFeed::connected(t0, json!({ "conn": 2 }));
+    drain(&mut first, t0);
+    drain(&mut second, t0);
+
+    // The first connection sends now and is inside its window until 1100 ms.
+    let _first_sent = first.offer(at(t0, 1000), json!({ "conn": 1, "state": "x" }));
+    let mine = json!({ "conn": 2, "state": "y" });
+    let mut sent = Vec::new();
+    if let Some(item) = second.offer(at(t0, 1001), mine.clone()) {
+        sent.push((1001, item));
+    }
+    sent.extend(drain(&mut second, t0));
+
+    assert_eq!(sent.len(), 1, "{sent:?}");
+    assert_eq!(sent[0].1, mine);
+    assert!(
+        sent[0].0 <= 1101,
+        "held back by the other connection: {sent:?}"
+    );
+}
