+        let mut env = HashMap::default();
+        insert_claude_code_ide_env(&mut env, None);
+        assert!(env.is_empty(), "no port, no IDE variables");
+
+        insert_claude_code_ide_env(&mut env, Some(41234));
+        assert_eq!(
+            env.get("CLAUDE_CODE_SSE_PORT").map(String::as_str),
+            Some("41234")
+        );
+        assert_eq!(
+            env.get("ENABLE_IDE_INTEGRATION").map(String::as_str),
+            Some("true")
+        );
+    }
+}
