+/// The Claude Code IDE integration's terminal environment (patch 0002): with the port
+/// of this workspace's IDE server, a `claude` started in the terminal finds it; without
+/// one, nothing is set, so a CLI there runs without an IDE instead of failing a
+/// handshake. Every terminal path calls this, so they cannot drift apart.
+fn insert_claude_code_ide_env(env: &mut HashMap<String, String>, port: Option<u16>) {
+    if let Some(port) = port {
+        env.insert("CLAUDE_CODE_SSE_PORT".to_owned(), port.to_string());
+        env.insert("ENABLE_IDE_INTEGRATION".to_owned(), "true".to_owned());
+    }
+}
