--- /dev/null
+++ b/crates/agent_servers/src/acp/session_meta.rs
@@ -0,0 +1,75 @@
+use gpui::App;
+use serde_json::{Map, Value};
+use settings::SettingsStore;
+
+/// Read by Claude Agent (Plus) (`src/question-routing.ts`), whose own default is to ask its open
+/// questions through `AskUserQuestion`'s card. Zeo next proposal §6.43.
+const ASK_QUESTIONS_IN_CARDS_META_KEY: &str = "askQuestionsInCards";
+
+/// The `_meta` sent with `session/new`, `session/load` and `session/resume`, so a reopened
+/// thread follows the setting as it is now. Only the opt-out is sent: while the setting is at
+/// its default every agent receives the same request as before.
+pub(crate) fn session_request_meta(cx: &App) -> Option<Map<String, Value>> {
+    // A test app may run without a settings store; the default applies there.
+    let ask_questions_in_cards = cx
+        .try_global::<SettingsStore>()
+        .and_then(|store| {
+            store
+                .merged_settings()
+                .agent
+                .as_ref()?
+                .ask_questions_in_cards
+        })
+        .unwrap_or(true);
+    session_request_meta_for(ask_questions_in_cards)
+}
+
+fn session_request_meta_for(ask_questions_in_cards: bool) -> Option<Map<String, Value>> {
+    (!ask_questions_in_cards).then(|| {
+        Map::from_iter([(
+            ASK_QUESTIONS_IN_CARDS_META_KEY.to_string(),
+            Value::Bool(false),
+        )])
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::{TestAppContext, UpdateGlobal as _};
+
+    #[test]
+    fn the_default_sends_nothing() {
+        assert_eq!(session_request_meta_for(true), None);
+    }
+
+    #[test]
+    fn the_opt_out_is_an_explicit_false() {
+        let meta = session_request_meta_for(false).expect("the opt-out is sent");
+        assert_eq!(meta.get("askQuestionsInCards"), Some(&Value::Bool(false)));
+        assert_eq!(meta.len(), 1);
+    }
+
+    #[gpui::test]
+    fn reads_the_merged_setting(cx: &mut TestAppContext) {
+        cx.update(|cx| {
+            assert_eq!(session_request_meta(cx), None, "no settings store");
+            let store = SettingsStore::test(cx);
+            cx.set_global(store);
+            assert_eq!(session_request_meta(cx), None, "default.json says true");
+            SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings
+                        .agent
+                        .get_or_insert_default()
+                        .ask_questions_in_cards = Some(false);
+                });
+            });
+            assert_eq!(
+                session_request_meta(cx),
+                session_request_meta_for(false),
+                "the user turned it off"
+            );
+        });
+    }
+}
