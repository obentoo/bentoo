+    #[gpui::test]
+    async fn v2_session_requests_carry_the_question_card_opt_out(cx: &mut TestAppContext) {
+        use gpui::UpdateGlobal as _;
+
+        let harness = SessionHarness::new(session_capabilities(), Vec::new(), Vec::new(), cx).await;
+        // Each request is answered before the next: the fake agent handles one at a time.
+        let mut creation = harness.create(cx);
+        let (request, _) = harness.new_request(&mut creation, cx).await;
+        assert_eq!(
+            request.meta, None,
+            "the default leaves the request as it was"
+        );
+        harness
+            .new_responses
+            .try_send(Ok(initial_response()))
+            .expect("initial response");
+        bounded(creation, cx).await.expect("create thread");
+
+        cx.update(|cx| {
+            settings::SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings
+                        .agent
+                        .get_or_insert_default()
+                        .ask_questions_in_cards = Some(false);
+                });
+            });
+        });
+        let opt_out = Some(serde_json::Map::from_iter([(
+            "askQuestionsInCards".to_string(),
+            json!(false),
+        )]));
+        let reopening = harness.reopen(false, cx);
+        let (request, responder) = bounded(harness.resume_requests.recv(), cx)
+            .await
+            .expect("resume request");
+        assert_eq!(
+            request.meta, opt_out,
+            "a reopened thread follows the setting too"
+        );
+        responder
+            .respond(acp::ResumeSessionResponse::new())
+            .expect("resumed");
+        bounded(reopening, cx).await.expect("resumed thread");
+        let mut creation = harness.create(cx);
+        let (request, _) = harness.new_request(&mut creation, cx).await;
+        assert_eq!(request.meta, opt_out, "session/new");
+    }
+
