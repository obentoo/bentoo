diff --git a/crates/agent_servers/src/acp/v1/question_cards_meta_tests.rs b/crates/agent_servers/src/acp/v1/question_cards_meta_tests.rs
new file mode 100644
index 0000000..f6ee166
--- /dev/null
+++ b/crates/agent_servers/src/acp/v1/question_cards_meta_tests.rs
@@ -0,0 +1,58 @@
+//! `agent.ask_questions_in_cards` on the v1 wire, the protocol Claude Agent (Plus) speaks
+//! (Zeo next proposal §6.43): off, every way into a thread sends `askQuestionsInCards: false`
+//! in the request's `_meta`; at its default, the requests carry no `_meta` at all.
+
+use super::thread_config_test_support::*;
+use gpui::UpdateGlobal as _;
+
+fn set_ask_questions_in_cards(value: bool, cx: &mut gpui::TestAppContext) {
+    cx.update(|cx| {
+        settings::SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, |settings| {
+                settings
+                    .agent
+                    .get_or_insert_default()
+                    .ask_questions_in_cards = Some(value);
+            });
+        });
+    });
+}
+
+#[gpui::test]
+async fn question_cards_meta_follows_the_setting_on_new_load_and_resume(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            agent_id: "Claude Agent (Plus)",
+            new_session_id: "fresh",
+            ..Default::default()
+        },
+        project,
+        cx,
+    )
+    .await;
+
+    agent.load("before", cx).await;
+    assert_eq!(
+        agent.session_request_metas("session/load"),
+        vec![serde_json::Value::Null],
+        "the default sends no _meta"
+    );
+
+    set_ask_questions_in_cards(false, cx);
+    let opt_out = serde_json::json!({ "askQuestionsInCards": false });
+    agent.new_session(cx).await;
+    agent.load("after", cx).await;
+    agent.resume("resumed", cx).await;
+    assert_eq!(
+        agent.session_request_metas("session/new"),
+        vec![opt_out.clone()]
+    );
+    assert_eq!(
+        agent.session_request_metas("session/load"),
+        vec![serde_json::Value::Null, opt_out.clone()]
+    );
+    assert_eq!(agent.session_request_metas("session/resume"), vec![opt_out]);
+}
