+/// Zeo next §6.51: removes `session`'s thread metadata, as deleting its thread does, so the
+/// record's thread is gone (`adopt_orphan_sessions` gave every seeded session one).
+pub(crate) fn forget_thread(session: &str, cx: &mut VisualTestContext) {
+    let thread_id = row_thread_id(&sid(session), cx);
+    cx.update(|_, cx| {
+        agent_ui::thread_metadata_store::ThreadMetadataStore::global(cx)
+            .update(cx, |store, cx| store.delete(thread_id, cx))
+    });
+    cx.run_until_parked();
+}
+
+/// Zeo next §6.51: moves `session`'s thread to `folder`, another project than the test window's.
+pub(crate) fn move_thread_to(session: &str, folder: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        let store = agent_ui::thread_metadata_store::ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry_by_session(&sid(session))
+            .cloned()
+            .expect("the session has a metadata row");
+        metadata.worktree_paths =
+            project::WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(folder)]));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
