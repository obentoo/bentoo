+/// Zeo next §6.51 (ask 75): the project of the thread `session_id` belongs to, derived the way
+/// `thread_project` derives it, so the Agent Tasks panel scopes its rows as the sidebar does.
+pub fn session_project(
+    session_id: &agent_client_protocol::v2::schema::SessionId,
+    cx: &App,
+) -> Option<ProjectKey> {
+    let metadata = ThreadMetadataStore::try_global(cx)?;
+    let metadata = metadata.read(cx);
+    let entry = metadata.entry_by_session(session_id)?;
+    Some(ProjectKey::from_group(
+        &ProjectGroupKey::from_worktree_paths(
+            &entry.worktree_paths,
+            entry.remote_connection.clone(),
+        ),
+    ))
+}
