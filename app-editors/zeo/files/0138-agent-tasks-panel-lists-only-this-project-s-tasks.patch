+/// Zeo next §6.51: the panel lists a record only when its thread's folders map to the window's
+/// project, and a record seeded straight into the history database has no thread at all. In
+/// Zeo every record comes from a thread that ran, so each seeded session is given the thread
+/// metadata it would have had, in `workspace`'s folders. Sessions that already have metadata
+/// (a real thread, a decoy, a remote thread) are left as they are.
+pub(crate) fn adopt_orphan_sessions(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        let paths = workspace.read(cx).project().read(cx).worktree_paths(cx);
+        let Some(history) = crate::TaskHistoryStore::try_global(cx) else {
+            return;
+        };
+        let sessions: Vec<acp_v2::SessionId> = history
+            .read(cx)
+            .records()
+            .iter()
+            .map(|entry| entry.record.session_id.clone())
+            .collect();
+        let metadata = agent_ui::thread_metadata_store::ThreadMetadataStore::global(cx);
+        let orphans: Vec<acp_v2::SessionId> = {
+            let store = metadata.read(cx);
+            let mut seen = std::collections::HashSet::new();
+            sessions
+                .into_iter()
+                .filter(|session| store.entry_by_session(session).is_none())
+                .filter(|session| seen.insert(session.clone()))
+                .collect()
+        };
+        metadata.update(cx, |store, cx| {
+            for session in orphans {
+                store.save(
+                    agent_ui::thread_metadata_store::ThreadMetadata {
+                        thread_id: agent_ui::thread_metadata_store::ThreadId::new(),
+                        session_id: Some(session),
+                        agent_id: "stub".into(),
+                        title: None,
+                        title_override: None,
+                        updated_at: Default::default(),
+                        created_at: None,
+                        interacted_at: None,
+                        worktree_paths: paths.clone(),
+                        remote_connection: None,
+                        archived: false,
+                    },
+                    cx,
+                );
+            }
+        });
+    });
+    cx.run_until_parked();
+}
