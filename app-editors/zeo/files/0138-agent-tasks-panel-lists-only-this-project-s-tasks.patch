+// Zeo next §6.51 (ask 75): Delete All Archived counts and deletes only the archived records of
+// this window's project. Unscoped, it would delete another project's records, which the panel
+// does not even show; with only theirs archived, it is not offered.
+#[gpui::test]
+async fn delete_action_all_archived_spares_another_projects_records(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "mine", "a1", AgentTaskStatus::Completed, 1_000, true).await;
+    seed(&db, "theirs", "b1", AgentTaskStatus::Completed, 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    move_thread_to("theirs", "/elsewhere", &mut panels.cx);
+
+    only(&mut panels, &[TaskFilter::Archived]);
+    assert_eq!(
+        visible_keys(&mut panels),
+        vec![("mine".to_string(), "a1".to_string())],
+        "another project's archived record is not listed"
+    );
+    request_delete_all(&mut panels);
+    let (message, _) = panels.cx.pending_prompt().unwrap();
+    assert_eq!(
+        message, "Delete 1 task record?",
+        "only this project's is counted"
+    );
+    answer(&mut panels, "Delete");
+    let left: Vec<(String, String)> = load(&db).await.iter().map(key_of).collect();
+    assert_eq!(
+        left,
+        vec![("theirs".to_string(), "b1".to_string())],
+        "another project's archived record is not deleted"
+    );
+    let labels = painted_labels(&mut panels);
+    assert!(
+        !labels.iter().any(|label| label == "Delete All Archived"),
+        "only another project's archived records are left, so nothing is offered: {labels:?}"
+    );
+}
+
+// Zeo next §6.51: the list re-filters when a thread's folders change, as the sidebar does.
+#[gpui::test]
+async fn delete_action_scope_follows_a_thread_that_changes_project(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "a1", AgentTaskStatus::Completed, 1_000, false).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished]);
+    assert_eq!(visible_keys(&mut panels).len(), 1, "listed in its project");
+    move_thread_to("s1", "/elsewhere", &mut panels.cx);
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "gone from the list once its thread is another project's"
+    );
+}
+
