+// Zeo next proposal §6.1, §6.27 (asks 3, 13, 47): "Follow Log" on a running task's row opens its
+// output in a tab of the Agent Tasks panel. The list is the first tab; one tab per task; the tab
+// reads on from where it stopped while the task runs, and stops reading once it has ended.
+// GPUI integration tests over the real card. Filter: `log_tabs_tests`.
+
+use gpui::{Modifiers, TestAppContext};
+
+use crate::test_helpers::*;
+
+use super::log_tabs::LOG_TAB_POLL_INTERVAL;
+
+fn show(panels: &mut Panels) {
+    panels
+        .workspace
+        .update_in(&mut panels.cx, |workspace, window, cx| {
+            workspace.focus_panel::<crate::AgentTasksPanel>(window, cx);
+        });
+    redraw(panels);
+}
+
+fn redraw(panels: &mut Panels) {
+    panels.cx.update(|window, _| window.refresh());
+    panels.cx.run_until_parked();
+}
+
+fn painted(panels: &mut Panels, selector: &str) -> bool {
+    let selector: &'static str = Box::leak(selector.to_string().into_boxed_str());
+    panels.cx.debug_bounds(selector).is_some()
+}
+
+fn click(panels: &mut Panels, selector: &str) {
+    let selector: &'static str = Box::leak(selector.to_string().into_boxed_str());
+    let bounds = panels
+        .cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    panels.cx.simulate_click(bounds.center(), Modifiers::none());
+    redraw(panels);
+}
+
+fn task(id: &str, status: &str, has_output: bool) -> serde_json::Value {
+    let mut task = wire_task(id, status, 2_000, None);
+    task["hasOutput"] = serde_json::json!(has_output);
+    task
+}
+
+fn write(connection: &StopConnection, text: &str) {
+    *connection.output_file.lock().unwrap() = Some(text.to_string());
+}
+
+fn tab_lines(panels: &mut Panels) -> Vec<String> {
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .active_log_tab()
+            .map(|tab| tab.buffer.lines().collect())
+            .unwrap_or_default()
+    })
+}
+
+/// Hostile: only a running task that has output is offered the button.
+#[gpui::test]
+async fn follow_log_is_offered_only_on_a_running_task_with_output(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            task("out", "running", true),
+            task("quiet", "running", false),
+            task("done", "completed", true),
+        ],
+        &mut panels.cx,
+    );
+    show(&mut panels);
+    assert!(painted(&mut panels, "agent-tasks-follow-log-out"));
+    assert!(
+        !painted(&mut panels, "agent-tasks-follow-log-quiet"),
+        "no output yet"
+    );
+    assert!(
+        !painted(&mut panels, "agent-tasks-follow-log-done"),
+        "ended"
+    );
+}
+
+/// The tab replaces the list, shows the end of the log, then reads on from where it stopped.
+#[gpui::test]
+async fn a_log_tab_shows_the_log_and_reads_on_from_where_it_stopped(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    write(&connection, "one\ntwo\n");
+    let thread = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Live",
+        &mut panels.cx,
+    );
+    send_tasks(&thread, vec![task("run", "running", true)], &mut panels.cx);
+    show(&mut panels);
+    assert!(
+        !painted(&mut panels, "agent-tasks-log-tabs"),
+        "no strip before a tab"
+    );
+
+    click(&mut panels, "agent-tasks-follow-log-run");
+    assert!(painted(&mut panels, "agent-tasks-log-tabs"));
+    assert!(painted(&mut panels, "agent-tasks-log-tab-run"));
+    assert!(painted(&mut panels, "agent-tasks-log-view"));
+    assert!(
+        !painted(&mut panels, "agent-tasks-list"),
+        "the tab replaces the list"
+    );
+    assert_eq!(tab_lines(&mut panels), ["one", "two"]);
+
+    write(&connection, "one\ntwo\nthree\n");
+    panels.cx.executor().advance_clock(LOG_TAB_POLL_INTERVAL);
+    redraw(&mut panels);
+    assert_eq!(tab_lines(&mut panels), ["one", "two", "three"]);
+    let reads = connection.output_reads.lock().unwrap().clone();
+    assert_eq!(
+        &reads[..2],
+        &[None, Some(8)],
+        "the end first, then on from its end"
+    );
+}
+
+/// One tab per task: opening it again focuses it; the list tab comes back, and closing the tab
+/// returns to the list with no strip left.
+#[gpui::test]
+async fn one_tab_per_task_and_closing_returns_to_the_list(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    write(&connection, "x\n");
+    let thread = open_thread_on(&panels.agent_panel, connection, "Live", &mut panels.cx);
+    send_tasks(&thread, vec![task("run", "running", true)], &mut panels.cx);
+    show(&mut panels);
+
+    click(&mut panels, "agent-tasks-follow-log-run");
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.show_task_list(cx));
+    redraw(&mut panels);
+    assert!(painted(&mut panels, "agent-tasks-list"), "the list tab");
+    click(&mut panels, "agent-tasks-follow-log-run");
+    let keys = panels
+        .tasks_panel
+        .read_with(&panels.cx, |panel, _| panel.log_tab_keys());
+    assert_eq!(keys.len(), 1, "focused, not opened twice");
+    assert!(painted(&mut panels, "agent-tasks-log-view"));
+
+    let key = keys[0].clone();
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.close_log_tab(&key, cx));
+    redraw(&mut panels);
+    assert!(painted(&mut panels, "agent-tasks-list"));
+    assert!(!painted(&mut panels, "agent-tasks-log-tabs"));
+}
+
+/// Hostile: once the task has ended, one last read takes its end and the tab stops asking.
+#[gpui::test]
+async fn an_ended_task_is_read_once_more_then_not_again(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    write(&connection, "a\n");
+    let thread = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Live",
+        &mut panels.cx,
+    );
+    send_tasks(&thread, vec![task("run", "running", true)], &mut panels.cx);
+    show(&mut panels);
+    click(&mut panels, "agent-tasks-follow-log-run");
+    assert_eq!(tab_lines(&mut panels), ["a"], "the first read");
+
+    write(&connection, "a\nb\n");
+    send_tasks(
+        &thread,
+        vec![task("run", "completed", true)],
+        &mut panels.cx,
+    );
+    panels.cx.executor().advance_clock(LOG_TAB_POLL_INTERVAL);
+    redraw(&mut panels);
+    let after_end = connection.output_reads.lock().unwrap().len();
+    panels
+        .cx
+        .executor()
+        .advance_clock(LOG_TAB_POLL_INTERVAL * 3);
+    redraw(&mut panels);
+    assert_eq!(
+        connection.output_reads.lock().unwrap().len(),
+        after_end,
+        "no reads after the last"
+    );
+    assert_eq!(tab_lines(&mut panels), ["a", "b"]);
+    let ended = panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel.active_log_tab().is_some_and(|tab| tab.ended)
+    });
+    assert!(ended, "the tab says the task ended");
+}
+
+/// A wheel turned up reads earlier lines: following pauses, and "Follow" resumes it.
+#[gpui::test]
+async fn scrolling_up_pauses_following_and_follow_resumes_it(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    let text: String = (0..200).map(|n| format!("line {n}\n")).collect();
+    write(&connection, &text);
+    let thread = open_thread_on(&panels.agent_panel, connection, "Live", &mut panels.cx);
+    send_tasks(&thread, vec![task("run", "running", true)], &mut panels.cx);
+    show(&mut panels);
+    click(&mut panels, "agent-tasks-follow-log-run");
+    assert!(
+        !painted(&mut panels, "agent-tasks-log-follow"),
+        "following: no button"
+    );
+
+    let bounds = panels
+        .cx
+        .debug_bounds("agent-tasks-log-view")
+        .expect("the log view is painted");
+    panels.cx.simulate_event(gpui::ScrollEvent {
+        position: bounds.center(),
+        delta: gpui::ScrollDelta::Lines(gpui::point(0., 3.)),
+        ..Default::default()
+    });
+    redraw(&mut panels);
+    let following = |panels: &mut Panels| {
+        panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+            panel.active_log_tab().is_some_and(|tab| tab.follow)
+        })
+    };
+    assert!(!following(&mut panels), "paused by the scroll up");
+    assert!(painted(&mut panels, "agent-tasks-log-follow"));
+
+    click(&mut panels, "agent-tasks-log-follow");
+    assert!(following(&mut panels), "resumed");
+}
