+impl StopConnection {
+    fn serve_output(&self, from_byte: Option<u64>) -> Result<acp_thread::TaskOutput> {
+        self.output_reads.lock().unwrap().push(from_byte);
+        let file = self.output_file.lock().unwrap();
+        let text = file.as_ref().ok_or_else(|| anyhow!("no output staged"))?;
+        let start = match from_byte {
+            Some(from) if from as usize <= text.len() => from as usize,
+            _ => 0,
+        };
+        Ok(acp_thread::TaskOutput {
+            content: text[start..].to_string(),
+            total_bytes: text.len() as u64,
+            truncated: false,
+            start_byte: Some(start as u64),
+        })
+    }
+}
