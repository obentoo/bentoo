diff --git a/crates/agent_tasks_panel/src/panel/log_buffer_tests.rs b/crates/agent_tasks_panel/src/panel/log_buffer_tests.rs
new file mode 100644
index 0000000..0a55272
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/log_buffer_tests.rs
@@ -0,0 +1,84 @@
+// Zeo next proposal §6.1, §6.27: the text of a log tab. It appends only a read that starts where
+// the last one ended, starts over otherwise, joins a line split across reads, and stays bounded.
+// Filter: `log_buffer_tests`.
+
+use acp_thread::TaskOutput;
+
+use super::{LOG_TAB_MAX_LINES, LogBuffer};
+
+fn out(content: &str, start_byte: Option<u64>) -> TaskOutput {
+    TaskOutput {
+        content: content.to_string(),
+        total_bytes: start_byte.unwrap_or(0) + content.len() as u64,
+        truncated: false,
+        start_byte,
+    }
+}
+
+fn shown(buffer: &LogBuffer) -> Vec<String> {
+    buffer.lines().collect()
+}
+
+#[test]
+fn appends_a_read_that_starts_where_the_last_ended() {
+    let mut buffer = LogBuffer::default();
+    buffer.apply(&out("one\ntwo\n", Some(100)));
+    assert_eq!(buffer.next_byte(), Some(108));
+    buffer.apply(&out("three\n", Some(108)));
+    assert_eq!(shown(&buffer), ["one", "two", "three"]);
+    assert_eq!(buffer.next_byte(), Some(114));
+}
+
+#[test]
+fn joins_a_line_split_across_two_reads() {
+    let mut buffer = LogBuffer::default();
+    buffer.apply(&out("Compiling ser", Some(0)));
+    assert_eq!(
+        shown(&buffer),
+        ["Compiling ser"],
+        "the line being written shows"
+    );
+    buffer.apply(&out("de v1.0\nnext", Some(13)));
+    assert_eq!(shown(&buffer), ["Compiling serde v1.0", "next"]);
+}
+
+/// Hostile: a read that does not continue -- the file was truncated or replaced -- must not be
+/// glued onto the old text.
+#[test]
+fn starts_over_when_a_read_does_not_continue() {
+    let mut buffer = LogBuffer::default();
+    buffer.apply(&out("old\n", Some(0)));
+    buffer.apply(&out("new\n", Some(0)));
+    assert_eq!(shown(&buffer), ["new"]);
+}
+
+/// An adapter older than `fromByte` sends the end of the file every time, with no `startByte`:
+/// each read replaces the text, so it never doubles.
+#[test]
+fn replaces_on_every_read_without_start_byte() {
+    let mut buffer = LogBuffer::default();
+    buffer.apply(&out("a\nb\n", None));
+    buffer.apply(&out("a\nb\nc\n", None));
+    assert_eq!(shown(&buffer), ["a", "b", "c"]);
+    assert_eq!(buffer.next_byte(), None, "no offset to read on from");
+}
+
+#[test]
+fn keeps_the_last_state_of_a_line_redrawn_with_carriage_returns() {
+    let mut buffer = LogBuffer::default();
+    buffer.apply(&out("10%\r50%\r100%\ndone\n", Some(0)));
+    assert_eq!(shown(&buffer), ["100%", "done"]);
+}
+
+/// Hostile: a long-running task must not grow the tab without bound.
+#[test]
+fn drops_the_oldest_lines_past_the_cap_and_counts_them() {
+    let mut buffer = LogBuffer::default();
+    let text: String = (0..LOG_TAB_MAX_LINES + 5)
+        .map(|n| format!("line {n}\n"))
+        .collect();
+    buffer.apply(&out(&text, Some(0)));
+    assert_eq!(buffer.line_count(), LOG_TAB_MAX_LINES);
+    assert_eq!(buffer.dropped(), 5);
+    assert_eq!(shown(&buffer).first().map(String::as_str), Some("line 5"));
+}
