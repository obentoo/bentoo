diff --git a/crates/agent_servers/src/acp/v1.rs b/crates/agent_servers/src/acp/v1.rs
index 6ff2ec7..47068ac 100644
--- a/crates/agent_servers/src/acp/v1.rs
+++ b/crates/agent_servers/src/acp/v1.rs
@@ -121,13 +121,65 @@ fn parse_task_output(response: &serde_json::Value) -> Result<acp_thread::TaskOut
     let truncated = field("truncated")?
         .as_bool()
         .ok_or_else(|| anyhow!("`truncated` is not a boolean"))?;
+    // Optional: an adapter older than `fromByte` sends none. Present, it must be an offset;
+    // a wrong type is an adapter bug, not an old adapter.
+    let start_byte = match response.get("startByte") {
+        None | Some(serde_json::Value::Null) => None,
+        Some(value) => Some(
+            value
+                .as_u64()
+                .ok_or_else(|| anyhow!("`startByte` is not a non-negative integer"))?,
+        ),
+    };
     Ok(acp_thread::TaskOutput {
         content,
         total_bytes,
         truncated,
+        start_byte,
     })
 }
 
+impl AcpConnection {
+    /// `_claude/tasks/output` for one task: the end of its output, or what follows `from_byte`
+    /// when given (Zeo next §6.1, §6.27). An adapter older than `fromByte` ignores the field
+    /// and answers with the end of the file and no `startByte`, which the caller reads as such.
+    fn request_task_output(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        from_byte: Option<u64>,
+        cx: &mut App,
+    ) -> Task<Result<acp_thread::TaskOutput>> {
+        let version = self.agent_tasks_version();
+        if version < 2 {
+            return Task::ready(Err(anyhow!(
+                "Reading agent task output is not supported: the agent advertises \
+                 {CLAUDE_TASKS_CAPABILITY} version {version}"
+            )));
+        }
+        let mut params = serde_json::json!({
+            "sessionId": session_id,
+            "taskId": task_id,
+            "maxBytes": CLAUDE_TASKS_OUTPUT_MAX_BYTES,
+        });
+        if let Some(from_byte) = from_byte {
+            params["fromByte"] = from_byte.into();
+        }
+        let request = send_task_request(
+            self.connection.clone(),
+            CLAUDE_TASKS_OUTPUT_METHOD,
+            params,
+            task_id.to_string(),
+        );
+        let task_id = task_id.to_string();
+        cx.foreground_executor().spawn(async move {
+            let response = request.await?;
+            parse_task_output(&response)
+                .with_context(|| format!("{CLAUDE_TASKS_OUTPUT_METHOD} answered for {task_id}"))
+        })
+    }
+}
