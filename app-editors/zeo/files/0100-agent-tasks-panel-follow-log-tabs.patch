+//! Log tabs in the Agent Tasks panel (Zeo next proposal §6.1, §6.27): "Follow Log" on a running
+//! task's row opens its output in a tab of the panel, beside the list, and keeps it current while
+//! the task runs. The list stays the first tab; one tab per task, and opening it again focuses it.
+//!
+//! The log is read incrementally: the first read takes the end of the file, and each later one
+//! asks only for what follows (`fromByte`, Claude Agent (Plus) 0.37.0). An older adapter answers
+//! without `startByte`, and the tab then replaces its text with the end of the file on every read
+//! instead of appending -- slower, still correct. Memory is bounded to [`LOG_TAB_MAX_LINES`].
+
+use std::collections::VecDeque;
+use std::time::Duration;
+
+use acp_thread::{AcpThread, AgentTaskId, TaskOutput};
+use anyhow::Result;
+use gpui::{
+    AnyElement, App, Context, Entity, ScrollEvent, ScrollStrategy, SharedString, Task,
+    UniformListScrollHandle, prelude::*, uniform_list,
+};
+use ui::{
+    ButtonCommon, Clickable, IconButton, IconName, IconSize, Label, LabelSize, Tooltip, prelude::*,
+};
+
+use super::AgentTasksPanel;
+use crate::TaskKey;
+
+/// The most lines a log tab keeps; older ones are dropped and counted.
+pub(crate) const LOG_TAB_MAX_LINES: usize = 10_000;
+
+/// How long a following tab waits between reads of a running task.
+pub(crate) const LOG_TAB_POLL_INTERVAL: Duration = Duration::from_secs(1);
+
+/// The text of one log tab: whole lines, the line still being written, and where the next read
+/// starts. Pure, so the follow rules can be tested without a window.
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct LogBuffer {
+    lines: VecDeque<String>,
+    /// The last line, until its newline arrives.
+    partial: String,
+    /// Where the next read starts; `None` before the first read and with an adapter that does
+    /// not say where its content begins.
+    next_byte: Option<u64>,
+    /// Lines dropped from the front to stay under [`LOG_TAB_MAX_LINES`].
+    dropped: usize,
+}
+
+impl LogBuffer {
+    /// Folds one answer of `_claude/tasks/output` in. Appended only when it starts exactly
+    /// where the last read ended; anything else -- the first read, a file that was truncated or
+    /// replaced, an adapter with no `startByte` -- starts the text over.
+    pub fn apply(&mut self, output: &TaskOutput) {
+        let continues = output.start_byte.is_some() && output.start_byte == self.next_byte;
+        if !continues {
+            *self = Self::default();
+        }
+        self.push_text(&output.content);
+        self.next_byte = output
+            .start_byte
+            .map(|start| start + output.content.len() as u64);
+    }
+
+    fn push_text(&mut self, text: &str) {
+        let joined = std::mem::take(&mut self.partial) + text;
+        let mut parts = joined.split('\n').collect::<Vec<_>>();
+        self.partial = parts.pop().unwrap_or_default().to_string();
+        for part in parts {
+            self.lines.push_back(terminal_line(part));
+        }
+        while self.lines.len() > LOG_TAB_MAX_LINES {
+            self.lines.pop_front();
+            self.dropped += 1;
+        }
+    }
+
+    /// Where the next read should start, if the adapter said where this one began.
+    pub fn next_byte(&self) -> Option<u64> {
+        self.next_byte
+    }
+
+    /// Lines dropped from the front to stay bounded.
+    pub fn dropped(&self) -> usize {
+        self.dropped
+    }
+
+    /// Every line on show, the one still being written last.
+    pub fn lines(&self) -> impl Iterator<Item = String> + '_ {
+        self.lines
+            .iter()
+            .cloned()
+            .chain((!self.partial.is_empty()).then(|| terminal_line(&self.partial)))
+    }
+
+    pub fn line_count(&self) -> usize {
+        self.lines.len() + usize::from(!self.partial.is_empty())
+    }
+}
+
+/// A line as a terminal leaves it: what follows the last carriage return, so a progress bar
+/// redrawn in place shows its last state rather than every frame.
+fn terminal_line(line: &str) -> String {
+    line.rsplit('\r').next().unwrap_or_default().to_string()
+}
+
+/// One open log tab.
+pub struct LogTab {
+    pub(crate) key: TaskKey,
+    pub(crate) title: SharedString,
+    pub(crate) buffer: LogBuffer,
+    /// Whether new lines scroll the view to the end; a scroll up turns it off.
+    pub(crate) follow: bool,
+    /// The task is over and its last output was read: nothing more will come.
+    pub(crate) ended: bool,
+    pub(crate) error: Option<SharedString>,
+    pub(crate) scroll: UniformListScrollHandle,
+    _poll: Task<()>,
+}
+
+impl AgentTasksPanel {
+    /// Opens `key`'s log in a tab of the panel, or focuses the tab already open for it.
+    pub fn open_log_tab(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        if self.log_tabs.iter().any(|tab| &tab.key == key) {
+            self.active_log = Some(key.clone());
+            cx.notify();
+            return;
+        }
+        let title = self
+            .store
+            .read(cx)
+            .live_task(&key.0, &key.1, cx)
+            .map(|(_, task)| agent_ui::display_label(&agent_ui::collapse_label(&task.description)))
+            .unwrap_or_else(|| key.1.to_string().into());
+        log::info!(
+            "agent_task_log event=tab_opened session_id={} task_id={} source=agent_tasks_panel",
+            key.0,
+            key.1
+        );
+        let poll = cx.spawn({
+            let key = key.clone();
+            async move |panel, cx| {
+                loop {
+                    let Ok(Some((fetch, running))) =
+                        panel.update(cx, |panel, cx| panel.start_log_read(&key, cx))
+                    else {
+                        return;
+                    };
+                    let result = fetch.await;
+                    let Ok(more) = panel.update(cx, |panel, cx| {
+                        panel.finish_log_read(&key, result, running, cx)
+                    }) else {
+                        return;
+                    };
+                    match more {
+                        LogReadNext::Now => {}
+                        LogReadNext::Later => {
+                            cx.background_executor().timer(LOG_TAB_POLL_INTERVAL).await
+                        }
+                        LogReadNext::Stop => return,
+                    }
+                }
+            }
+        });
+        self.log_tabs.push(LogTab {
+            key: key.clone(),
+            title,
+            buffer: LogBuffer::default(),
+            follow: true,
+            ended: false,
+            error: None,
+            scroll: UniformListScrollHandle::new(),
+            _poll: poll,
+        });
+        self.active_log = Some(key.clone());
+        cx.notify();
+    }
+
+    /// Closes `key`'s tab, which stops its reads; the list shows again if it was on show.
+    pub fn close_log_tab(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        self.log_tabs.retain(|tab| &tab.key != key);
+        if self.active_log.as_ref() == Some(key) {
+            self.active_log = None;
+        }
+        cx.notify();
+    }
+
+    /// Shows the list tab.
+    pub fn show_task_list(&mut self, cx: &mut Context<Self>) {
+        self.active_log = None;
+        cx.notify();
+    }
+
+    /// The tab on show, if a log tab is.
+    pub fn active_log_tab(&self) -> Option<&LogTab> {
+        let key = self.active_log.as_ref()?;
+        self.log_tabs.iter().find(|tab| &tab.key == key)
+    }
+
+    pub fn log_tab_keys(&self) -> Vec<TaskKey> {
+        self.log_tabs.iter().map(|tab| tab.key.clone()).collect()
+    }
+
+    /// Turns following back on and jumps to the end.
+    pub fn resume_log_follow(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        if let Some(tab) = self.log_tabs.iter_mut().find(|tab| &tab.key == key) {
+            tab.follow = true;
+            scroll_to_end(tab);
+            cx.notify();
+        }
+    }
+
+    fn pause_log_follow(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        if let Some(tab) = self.log_tabs.iter_mut().find(|tab| &tab.key == key)
+            && tab.follow
+        {
+            tab.follow = false;
+            cx.notify();
+        }
+    }
+
+    /// The thread that can serve `key`'s output, from whichever card holds it.
+    fn log_thread(&self, key: &TaskKey, cx: &App) -> Option<Entity<AcpThread>> {
+        self.store
+            .read(cx)
+            .cards()
+            .find_map(|card| card.read(cx).held_thread(&key.0))
+    }
+
+    /// Starts one read of `key`'s log, and says whether the task was still running when it
+    /// started -- a read that begins after the task ended is its last.
+    fn start_log_read(
+        &mut self,
+        key: &TaskKey,
+        cx: &mut Context<Self>,
+    ) -> Option<(Task<Result<TaskOutput>>, bool)> {
+        let tab = self.log_tabs.iter().find(|tab| &tab.key == key)?;
+        let next_byte = tab.buffer.next_byte();
+        let Some(thread) = self.log_thread(key, cx) else {
+            let tab = self.log_tabs.iter_mut().find(|tab| &tab.key == key)?;
+            tab.error = Some("The task's thread is no longer open".into());
+            tab.ended = true;
+            cx.notify();
+            return None;
+        };
+        let task_id: &AgentTaskId = &key.1;
+        let running = thread
+            .read(cx)
+            .tasks()
+            .iter()
+            .any(|task| &task.id == task_id && task.status.is_running());
+        let fetch = thread.update(cx, |thread, cx| match next_byte {
+            Some(from_byte) => thread.fetch_task_output_from(task_id, from_byte, cx),
+            None => thread.fetch_task_output(task_id, cx),
+        });
+        Some((fetch, running))
+    }
+
+    fn finish_log_read(
+        &mut self,
+        key: &TaskKey,
+        result: Result<TaskOutput>,
+        was_running: bool,
+        cx: &mut Context<Self>,
+    ) -> LogReadNext {
+        let Some(tab) = self.log_tabs.iter_mut().find(|tab| &tab.key == key) else {
+            return LogReadNext::Stop;
+        };
+        let next = match result {
+            Ok(output) => {
+                tab.error = None;
+                tab.buffer.apply(&output);
+                if tab.follow {
+                    scroll_to_end(tab);
+                }
+                if output.truncated && output.start_byte.is_some() {
+                    // The cap stopped the read before the end: catch up at once.
+                    LogReadNext::Now
+                } else if was_running {
+                    LogReadNext::Later
+                } else {
+                    tab.ended = true;
+                    LogReadNext::Stop
+                }
+            }
+            Err(error) => {
+                log::warn!(
+                    "agent_task_log event=tab_read_failed session_id={} task_id={} \
+                     source=agent_tasks_panel error={error:#}",
+                    key.0,
+                    key.1
+                );
+                tab.error = Some(format!("Could not read the log: {error:#}").into());
+                if was_running {
+                    LogReadNext::Later
+                } else {
+                    tab.ended = true;
+                    LogReadNext::Stop
+                }
+            }
+        };
+        cx.notify();
+        next
+    }
+
+    /// The tab strip above the panel's content, while any log tab is open.
+    pub(super) fn render_log_tab_strip(&self, cx: &mut Context<Self>) -> Option<AnyElement> {
+        if self.log_tabs.is_empty() {
+            return None;
+        }
+        let list_active = self.active_log.is_none();
+        let strip = h_flex()
+            .debug_selector(|| "agent-tasks-log-tabs".to_string())
+            .flex_none()
+            .gap_1()
+            .px_1()
+            .py_0p5()
+            .overflow_x_hidden()
+            .border_b_1()
+            .border_color(cx.theme().colors().border_variant)
+            .child(
+                Button::new("agent-tasks-tab-list", "Tasks")
+                    .label_size(LabelSize::Small)
+                    .toggle_state(list_active)
+                    .on_click(cx.listener(|panel, _, _, cx| panel.show_task_list(cx))),
+            )
+            .children(self.log_tabs.iter().enumerate().map(|(ix, tab)| {
+                let active = self.active_log.as_ref() == Some(&tab.key);
+                let task_id = tab.key.1.clone();
+                h_flex()
+                    .debug_selector(move || format!("agent-tasks-log-tab-{task_id}"))
+                    .gap_0p5()
+                    .child(
+                        Button::new(("agent-tasks-tab", ix), tab.title.clone())
+                            .label_size(LabelSize::Small)
+                            .toggle_state(active)
+                            .truncate(true)
+                            .on_click(cx.listener({
+                                let key = tab.key.clone();
+                                move |panel, _, _, cx| panel.open_log_tab(&key, cx)
+                            })),
+                    )
+                    .child(
+                        IconButton::new(("agent-tasks-tab-close", ix), IconName::Close)
+                            .icon_size(IconSize::XSmall)
+                            .tooltip(Tooltip::text("Close Log Tab"))
+                            .on_click(cx.listener({
+                                let key = tab.key.clone();
+                                move |panel, _, _, cx| panel.close_log_tab(&key, cx)
+                            })),
+                    )
+            }));
+        Some(strip.into_any_element())
+    }
+
+    /// The log tab on show: a status line, then its lines in a list that follows the end.
+    pub(super) fn render_log_tab(&self, cx: &mut Context<Self>) -> Option<AnyElement> {
+        let tab = self.active_log_tab()?;
+        let key = tab.key.clone();
+        let status: SharedString = if let Some(error) = &tab.error {
+            error.clone()
+        } else if tab.ended {
+            "Task ended".into()
+        } else if tab.follow {
+            "Following".into()
+        } else {
+            "Paused".into()
+        };
+        let lines: Vec<String> = tab.buffer.lines().collect();
+        let count = lines.len();
+        Some(
+            v_flex()
+                .debug_selector(|| "agent-tasks-log-view".to_string())
+                .flex_1()
+                .min_h_0()
+                .child(
+                    h_flex()
+                        .flex_none()
+                        .justify_between()
+                        .px_2()
+                        .py_0p5()
+                        .child(Label::new(status).size(LabelSize::XSmall).color(
+                            if tab.error.is_some() {
+                                Color::Warning
+                            } else {
+                                Color::Muted
+                            },
+                        ))
+                        .children((tab.buffer.dropped() > 0).then(|| {
+                            Label::new(format!("{} earlier lines not kept", tab.buffer.dropped()))
+                                .size(LabelSize::XSmall)
+                                .color(Color::Muted)
+                        }))
+                        .children((!tab.follow && !tab.ended).then(|| {
+                            div()
+                                .debug_selector(|| "agent-tasks-log-follow".to_string())
+                                .child(
+                                    Button::new("agent-tasks-log-follow", "Follow")
+                                        .label_size(LabelSize::XSmall)
+                                        .on_click(cx.listener({
+                                            let key = key.clone();
+                                            move |panel, _, _, cx| panel.resume_log_follow(&key, cx)
+                                        })),
+                                )
+                        })),
+                )
+                .child(
+                    div()
+                        .id("agent-tasks-log-body")
+                        .flex_1()
+                        .min_h_0()
+                        .bg(cx.theme().colors().editor_background)
+                        .on_scroll(cx.listener({
+                            move |panel, event: &ScrollEvent, window, cx| {
+                                // A wheel turned up reads earlier lines: stop following.
+                                if event.delta.pixel_delta(window.line_height()).y > gpui::px(0.) {
+                                    panel.pause_log_follow(&key, cx);
+                                }
+                            }
+                        }))
+                        .child(
+                            uniform_list("agent-tasks-log-lines", count, move |range, _, cx| {
+                                range
+                                    .map(|ix| {
+                                        Label::new(lines[ix].clone())
+                                            .size(LabelSize::XSmall)
+                                            .buffer_font(cx)
+                                            .single_line()
+                                            .into_any_element()
+                                    })
+                                    .collect()
+                            })
+                            .px_2()
+                            .size_full()
+                            .track_scroll(&tab.scroll),
+                        ),
+                )
+                .into_any_element(),
+        )
+    }
+}
+
+fn scroll_to_end(tab: &LogTab) {
+    let count = tab.buffer.line_count();
+    if count > 0 {
+        tab.scroll.scroll_to_item(count - 1, ScrollStrategy::Bottom);
+    }
+}
+
+/// What a log tab's read loop does after one read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum LogReadNext {
+    /// The read stopped at the cap: read again at once.
+    Now,
+    /// The task runs: read again after [`LOG_TAB_POLL_INTERVAL`].
+    Later,
+    /// The task is over and its end was read, or the tab closed.
+    Stop,
+}
+
