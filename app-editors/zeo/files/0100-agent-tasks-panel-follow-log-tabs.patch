+// ---- Zeo next §6.1, §6.27 — reading on from an offset -----------------------------------------
+
+/// `fromByte` goes on the wire only when a follower asks for it, and `startByte` comes back.
+#[gpui::test]
+async fn test_tasks_task_output_from_byte_sends_the_offset_and_reads_start_byte(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(2),
+        task_output_reply(serde_json::json!({
+            "content": "more\n", "totalBytes": 15, "truncated": false, "startByte": 10,
+        })),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let output = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .fetch_task_output_from(&session_id, "b1", 10, cx)
+        })
+        .await
+        .expect("served");
+    assert_eq!(output.start_byte, Some(10));
+    assert_eq!(output.content, "more\n");
+    assert_eq!(
+        task_actions_requests(&peer),
+        vec![(
+            "_claude/tasks/output".to_string(),
+            serde_json::json!({
+                "sessionId": session_id.to_string(),
+                "taskId": "b1",
+                "maxBytes": 1_048_576,
+                "fromByte": 10,
+            }),
+        )]
+    );
+}
+
+/// An adapter older than `fromByte` answers without `startByte`: the content is the end of the
+/// file, and `None` tells the follower to replace rather than append.
+#[gpui::test]
+async fn test_tasks_task_output_without_start_byte_reads_as_none(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(2),
+        task_output_reply(task_output_fixture()),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+    let output = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .fetch_task_output_from(&session_id, "b1", 10, cx)
+        })
+        .await
+        .expect("served");
+    assert_eq!(output.start_byte, None);
+}
+
+/// Hostile: a `startByte` that is not an offset is an adapter bug, refused by name.
+#[gpui::test]
+async fn test_tasks_task_output_refuses_a_malformed_start_byte(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(2),
+        task_output_reply(serde_json::json!({
+            "content": "x", "totalBytes": 1, "truncated": false, "startByte": "0",
+        })),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+    let text = format!(
+        "{:#}",
+        fetch(&peer, &session_id, "b1", cx).await.unwrap_err()
+    );
+    assert!(text.contains("startByte"), "{text}");
+}
