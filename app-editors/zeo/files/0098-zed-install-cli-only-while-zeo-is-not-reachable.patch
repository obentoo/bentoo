--- /dev/null
+++ b/crates/zed/src/zed/app_menus_cli_tests.rs
@@ -0,0 +1,62 @@
+// Zeo next proposal §6.25: the app menu offers "Install CLI" only while `zeo` is not reachable.
+// Filter: `app_menus::cli_tests`.
+
+use super::*;
+use gpui::TestAppContext;
+
+fn has_install_cli(menus: &[Menu]) -> bool {
+    menus.iter().any(|menu| {
+        menu.items.iter().any(|item| match item {
+            MenuItem::Action { action, .. } => action.partial_eq(&install_cli::InstallCliBinary),
+            MenuItem::Submenu(submenu) => has_install_cli(std::slice::from_ref(submenu)),
+            _ => false,
+        })
+    })
+}
+
+fn set_presence(cx: &mut App, on_path: bool) {
+    cx.set_global(install_cli::CliPresence::for_tests(on_path));
+}
+
+#[gpui::test]
+fn install_cli_shows_until_the_command_is_reachable(cx: &mut TestAppContext) {
+    crate::zed::tests::init_test(cx);
+    cx.update(|cx| {
+        assert!(
+            has_install_cli(&app_menus(cx)),
+            "no lookup ran: upstream's menu"
+        );
+
+        set_presence(cx, false);
+        assert!(has_install_cli(&app_menus(cx)), "not found: offered");
+
+        set_presence(cx, true);
+        assert!(!has_install_cli(&app_menus(cx)), "found: gone");
+    });
+}
+
+#[test]
+fn the_item_is_dropped_from_a_submenu_too() {
+    let mut menus = vec![Menu {
+        name: "Zeo".into(),
+        items: vec![
+            MenuItem::action("Extensions", zed_actions::Extensions::default()),
+            MenuItem::submenu(Menu {
+                name: "Tools".into(),
+                items: vec![MenuItem::action(
+                    "Install CLI",
+                    install_cli::InstallCliBinary,
+                )],
+                disabled: false,
+            }),
+        ],
+        disabled: false,
+    }];
+    drop_install_cli(&mut menus);
+    assert!(!has_install_cli(&menus));
+    assert_eq!(
+        menus[0].items.len(),
+        2,
+        "only the item goes, not its neighbours"
+    );
+}
