diff --git a/crates/install_cli/src/cli_presence.rs b/crates/install_cli/src/cli_presence.rs
new file mode 100644
index 0000000..0591f1f
--- /dev/null
+++ b/crates/install_cli/src/cli_presence.rs
@@ -0,0 +1,160 @@
+//! Whether the `zeo` command is already reachable, so the menu offers "Install CLI" only
+//! while it is not (Zeo next proposal §6.25).
+//!
+//! Upstream shows the item unconditionally, and on Linux it installed nothing: it opened a
+//! prompt saying the CLI "should already be installed". A package (`app-editors/zeo`,
+//! `zeo-bin`) puts `zeo` in `/usr/bin`, so there the item was always noise.
+//!
+//! Only a file can be seen from here. A shell `alias zeo=…` lives in a shell's rc file, not in
+//! the GUI process's environment, so it is not detected; a symlink or a copy on the PATH is.
+
+use gpui::{App, Global};
+use std::ffi::OsStr;
+use std::path::{Path, PathBuf};
+
+/// The CLI's file name, as the packages and the official layout install it.
+pub const CLI_NAME: &str = "zeo";
+
+/// Whether `zeo` was found, and how to rebuild the menus when that changes.
+///
+/// Absent on platforms that never run [`CliPresence::init`] (macOS keeps upstream's install
+/// flow, Windows has no item), which reads as "not found" and keeps the item.
+#[derive(Clone, Copy)]
+pub struct CliPresence {
+    on_path: bool,
+    reload_menus: fn(&mut App),
+}
+
+impl Global for CliPresence {}
+
+impl CliPresence {
+    /// Looks for `zeo` once, at startup, and stores the answer before the menus are built.
+    ///
+    /// Synchronous on purpose: a handful of `stat` calls, and the menus read the answer right
+    /// after this returns, so a background lookup would build them once with a stale item.
+    pub fn init(cx: &mut App, reload_menus: fn(&mut App)) {
+        if !cfg!(any(target_os = "linux", target_os = "freebsd")) {
+            return;
+        }
+        let home = std::env::var_os("HOME").map(PathBuf::from);
+        let found = find_cli(std::env::var_os("PATH").as_deref(), home.as_deref());
+        log::info!(
+            "{}",
+            serde_json::json!({
+                "event": "cli_presence",
+                "on_path": found.is_some(),
+                "path": found.as_ref().map(|path| path.display().to_string()),
+            })
+        );
+        cx.set_global(Self {
+            on_path: found.is_some(),
+            reload_menus,
+        });
+    }
+
+    /// A presence that rebuilds nothing, for tests that read the menus.
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn for_tests(on_path: bool) -> Self {
+        Self {
+            on_path,
+            reload_menus: |_| {},
+        }
+    }
+
+    /// True once `zeo` is known to be reachable: found at startup, or just installed.
+    pub fn on_path(cx: &App) -> bool {
+        cx.try_global::<Self>()
+            .is_some_and(|presence| presence.on_path)
+    }
+
+    /// Records a successful install and rebuilds the menus, so the item goes at once.
+    pub fn mark_installed(cx: &mut App) {
+        let Some(presence) = cx.try_global::<Self>().copied() else {
+            return;
+        };
+        if presence.on_path {
+            return;
+        }
+        cx.set_global(Self {
+            on_path: true,
+            ..presence
+        });
+        (presence.reload_menus)(cx);
+    }
+}
+
+/// The first executable `zeo` in the PATH's directories, then in `~/.local/bin`.
+///
+/// `~/.local/bin` is searched even when the PATH lacks it: a session started from the desktop
+/// often has a narrower PATH than a terminal's, and it is where "Install CLI" links the command.
+pub fn find_cli(path_var: Option<&OsStr>, home: Option<&Path>) -> Option<PathBuf> {
+    let mut dirs: Vec<PathBuf> = path_var
+        .map(|path| std::env::split_paths(path).collect())
+        .unwrap_or_default();
+    if let Some(home) = home {
+        dirs.push(user_bin_dir(home));
+    }
+    dirs.into_iter()
+        .filter(|dir| dir.is_absolute())
+        .map(|dir| dir.join(CLI_NAME))
+        .find(|candidate| is_executable(candidate))
+}
+
+/// Where "Install CLI" links the command on Linux: the XDG user executable directory.
+pub fn user_bin_dir(home: &Path) -> PathBuf {
+    home.join(".local").join("bin")
+}
+
+/// The `zeo` command shipped beside this editor, in the release layout: the editor at
+/// `<prefix>/libexec/zeo-editor`, the command at `<prefix>/bin/zeo`. Both packages and the
+/// release tarball use it.
+pub fn bundled_cli(editor: &Path) -> Option<PathBuf> {
+    let candidate = editor.parent()?.parent()?.join("bin").join(CLI_NAME);
+    is_executable(&candidate).then_some(candidate)
+}
+
+/// Links `~/.local/bin/zeo` to the command beside `editor`, creating the directory. No root is
+/// needed, which is why this replaces upstream's "should already be installed" prompt.
+///
+/// A file already there is left alone unless it is this same link: it may be the operator's
+/// own wrapper, and replacing it would be a surprise nobody asked for.
+#[cfg(unix)]
+pub fn link_cli(editor: &Path, home: &Path) -> anyhow::Result<PathBuf> {
+    use anyhow::Context as _;
+    let bundled = bundled_cli(editor).with_context(|| {
+        format!(
+            "no {CLI_NAME} command beside {} (expected ../bin/{CLI_NAME})",
+            editor.display()
+        )
+    })?;
+    let dir = user_bin_dir(home);
+    std::fs::create_dir_all(&dir).with_context(|| format!("creating {}", dir.display()))?;
+    let link = dir.join(CLI_NAME);
+    if link.symlink_metadata().is_ok() {
+        if std::fs::read_link(&link).is_ok_and(|target| target == bundled) {
+            return Ok(link);
+        }
+        anyhow::bail!("{} already exists and was left alone", link.display());
+    }
+    std::os::unix::fs::symlink(&bundled, &link)
+        .with_context(|| format!("linking {} to {}", link.display(), bundled.display()))?;
+    Ok(link)
+}
+
+/// A regular file (after following links) with an execute bit. A dangling link is not one.
+pub(crate) fn is_executable(path: &Path) -> bool {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::metadata(path)
+            .is_ok_and(|meta| meta.is_file() && meta.permissions().mode() & 0o111 != 0)
+    }
+    #[cfg(not(unix))]
+    {
+        path.is_file()
+    }
+}
+
+#[cfg(all(test, unix))]
+#[path = "cli_presence_tests.rs"]
+mod tests;
diff --git a/crates/install_cli/src/cli_presence_tests.rs b/crates/install_cli/src/cli_presence_tests.rs
new file mode 100644
index 0000000..6d18f31
--- /dev/null
+++ b/crates/install_cli/src/cli_presence_tests.rs
@@ -0,0 +1,164 @@
+// Zeo next proposal §6.25: "Install CLI" shows only while `zeo` is not reachable. These pin the
+// lookup the menu reads. Filter: `cli_presence`.
+
+use super::*;
+use std::os::unix::fs::{PermissionsExt, symlink};
+
+fn executable(path: &Path) {
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, "#!/bin/sh\n").unwrap();
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).unwrap();
+}
+
+fn path_of(dirs: &[&Path]) -> std::ffi::OsString {
+    std::env::join_paths(dirs).unwrap()
+}
+
+#[test]
+fn finds_zeo_on_the_path() {
+    let root = tempfile::tempdir().unwrap();
+    let empty = root.path().join("empty");
+    let bin = root.path().join("bin");
+    std::fs::create_dir_all(&empty).unwrap();
+    executable(&bin.join("zeo"));
+
+    let path = path_of(&[&empty, &bin]);
+    assert_eq!(find_cli(Some(&path), None), Some(bin.join("zeo")));
+}
+
+#[test]
+fn finds_a_symlink_in_local_bin_even_off_the_path() {
+    let root = tempfile::tempdir().unwrap();
+    let home = root.path().join("home");
+    let real = root.path().join("opt/zeo/bin/zeo");
+    executable(&real);
+    std::fs::create_dir_all(user_bin_dir(&home)).unwrap();
+    symlink(&real, user_bin_dir(&home).join("zeo")).unwrap();
+
+    let path = path_of(&[&root.path().join("nowhere")]);
+    assert_eq!(
+        find_cli(Some(&path), Some(&home)),
+        Some(user_bin_dir(&home).join("zeo")),
+        "a desktop session's PATH may lack ~/.local/bin"
+    );
+}
+
+/// Hostile: none of these makes the command reachable, so none may hide the item.
+#[test]
+fn ignores_what_cannot_run() {
+    let root = tempfile::tempdir().unwrap();
+    let not_exec = root.path().join("a");
+    std::fs::create_dir_all(&not_exec).unwrap();
+    std::fs::write(not_exec.join("zeo"), "").unwrap();
+
+    let dangling = root.path().join("b");
+    std::fs::create_dir_all(&dangling).unwrap();
+    symlink(root.path().join("gone"), dangling.join("zeo")).unwrap();
+
+    let a_dir = root.path().join("c");
+    std::fs::create_dir_all(a_dir.join("zeo")).unwrap();
+
+    let other_name = root.path().join("d");
+    executable(&other_name.join("zed"));
+
+    let path = path_of(&[&not_exec, &dangling, &a_dir, &other_name]);
+    assert_eq!(find_cli(Some(&path), None), None);
+    assert_eq!(find_cli(None, None), None, "no PATH at all");
+}
+
+/// Hostile: a relative PATH entry ("" or ".") resolves against whatever directory the
+/// editor was started from, so a `zeo` there is not the command a shell would run.
+#[test]
+fn ignores_relative_path_entries() {
+    let root = tempfile::tempdir().unwrap();
+    let relative = std::ffi::OsString::from("relative-bin");
+    executable(&root.path().join("relative-bin/zeo"));
+    std::env::set_current_dir(root.path()).unwrap();
+    assert_eq!(find_cli(Some(&relative), None), None);
+}
+
+#[gpui::test]
+fn marking_installed_rebuilds_the_menus_once(cx: &mut gpui::TestAppContext) {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static RELOADS: AtomicUsize = AtomicUsize::new(0);
+    fn reload(_: &mut App) {
+        RELOADS.fetch_add(1, Ordering::SeqCst);
+    }
+
+    cx.update(|cx| {
+        assert!(!CliPresence::on_path(cx), "no global: the item stays");
+        CliPresence::mark_installed(cx);
+        assert_eq!(RELOADS.load(Ordering::SeqCst), 0, "nothing to rebuild yet");
+
+        cx.set_global(CliPresence {
+            on_path: false,
+            reload_menus: reload,
+        });
+        CliPresence::mark_installed(cx);
+        assert!(CliPresence::on_path(cx));
+        CliPresence::mark_installed(cx);
+        assert_eq!(
+            RELOADS.load(Ordering::SeqCst),
+            1,
+            "a second install changes nothing"
+        );
+    });
+}
+
+fn release_layout(root: &Path) -> PathBuf {
+    let editor = root.join("zeo.app/libexec/zeo-editor");
+    executable(&editor);
+    executable(&root.join("zeo.app/bin/zeo"));
+    editor
+}
+
+#[test]
+fn links_the_bundled_cli_into_local_bin() {
+    let root = tempfile::tempdir().unwrap();
+    let editor = release_layout(root.path());
+    let home = root.path().join("home");
+
+    let link = link_cli(&editor, &home).unwrap();
+    assert_eq!(link, user_bin_dir(&home).join("zeo"));
+    assert_eq!(
+        std::fs::read_link(&link).unwrap(),
+        root.path().join("zeo.app/bin/zeo")
+    );
+    assert_eq!(find_cli(None, Some(&home)), Some(link.clone()), "now found");
+    assert_eq!(
+        link_cli(&editor, &home).unwrap(),
+        link,
+        "a second run is a no-op"
+    );
+}
+
+/// Hostile: an existing `~/.local/bin/zeo` that is not this link is somebody's own file.
+#[test]
+fn leaves_an_existing_file_alone() {
+    let root = tempfile::tempdir().unwrap();
+    let editor = release_layout(root.path());
+    let home = root.path().join("home");
+    let mine = user_bin_dir(&home).join("zeo");
+    std::fs::create_dir_all(user_bin_dir(&home)).unwrap();
+    std::fs::write(&mine, "#!/bin/sh\nexec my-wrapper\n").unwrap();
+
+    let error = link_cli(&editor, &home).unwrap_err().to_string();
+    assert!(error.contains("left alone"), "{error}");
+    assert_eq!(
+        std::fs::read_to_string(&mine).unwrap(),
+        "#!/bin/sh\nexec my-wrapper\n"
+    );
+}
+
+#[test]
+fn refuses_when_no_cli_sits_beside_the_editor() {
+    let root = tempfile::tempdir().unwrap();
+    let editor = root.path().join("cargo/target/debug/zeo");
+    executable(&editor);
+    let home = root.path().join("home");
+    assert!(link_cli(&editor, &home).is_err());
+    assert!(
+        !user_bin_dir(&home).join("zeo").exists(),
+        "no link to nothing"
+    );
+}
