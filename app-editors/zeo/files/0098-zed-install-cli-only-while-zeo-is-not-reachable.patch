+
+/// Removes the "Install CLI" item wherever it sits, matched by its action rather than its
+/// label, so a renamed item is still found.
+#[cfg(not(target_os = "windows"))]
+fn drop_install_cli(menus: &mut [Menu]) {
+    for menu in menus {
+        menu.items.retain(|item| {
+            !matches!(item, MenuItem::Action { action, .. }
+                if action.partial_eq(&install_cli::InstallCliBinary))
+        });
+        for item in &mut menu.items {
+            if let MenuItem::Submenu(submenu) = item {
+                drop_install_cli(std::slice::from_mut(submenu));
+            }
+        }
+    }
 }
