+
+        cx.update(|_, cx| {
+            cx.set_menus(vec![view_menu(false)]);
+            cx.set_global(install_cli::CliPresence::for_tests(true));
+        });
+
+        assert!(
+            !app_menu.read_with(cx, |app_menu, _| has_item(
+                &app_menu.entries,
+                "View",
+                "Agent Panel"
+            )),
+            "the entries were re-read from the new menus"
+        );
+    }
 }
