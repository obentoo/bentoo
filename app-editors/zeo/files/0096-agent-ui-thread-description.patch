diff --git a/crates/agent_ui/src/thread_organization/description.rs b/crates/agent_ui/src/thread_organization/description.rs
new file mode 100644
index 0000000..b67cb67
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/description.rs
@@ -0,0 +1,418 @@
+//! Zeo next proposal §6.6 (ask 19): a thread carries a description, a line saying what it is
+//! for, shown beside its title in the agent panel and in the threads sidebar.
+//!
+//! It is stored in a domain of its own rather than as a column of `thread_organization`
+//! (0048). That table's migrations are a list that two patches append to -- 0063 adds
+//! `devtools_root` under the `devtools-panel` USE flag -- and a step appended by an earlier
+//! patch would land at a different index with and without that flag, which sqlez refuses
+//! on the next start. A domain of its own has its own list, whatever the flags.
+//!
+//! Like the organization, a description belongs to a saved thread: a draft is refused
+//! (`admit`), and a deleted thread's description goes with it (`forget`).
+
+use std::collections::HashMap;
+use std::sync::atomic::Ordering;
+
+use anyhow::{Context as _, Result};
+use db::{
+    sqlez::{domain::Domain, thread_safe_connection::ThreadSafeConnection},
+    sqlez_macros::sql,
+};
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{App, AppContext as _, Context, Entity, EventEmitter, Global, SharedString, Task};
+
+use super::{OrganizeError, admit};
+use crate::thread_metadata_store::ThreadId;
+
+/// Long enough for a sentence or two, short enough for a tooltip.
+pub const MAX_DESCRIPTION_CHARS: usize = 280;
+
+pub(crate) struct ThreadDescriptionDb(ThreadSafeConnection);
+
+static DESCRIPTION_MIGRATIONS: [&str; 1] = ["CREATE TABLE thread_descriptions(
+    thread_id BLOB PRIMARY KEY NOT NULL,
+    description TEXT NOT NULL
+) STRICT;"];
+
+impl Domain for ThreadDescriptionDb {
+    const NAME: &str = stringify!(ThreadDescriptionDb);
+    const MIGRATIONS: &[&str] = &DESCRIPTION_MIGRATIONS;
+}
+
+db::static_connection!(ThreadDescriptionDb, []);
+
+/// A description as stored: whitespace collapsed to single spaces (it shows on one line),
+/// trimmed, and cut at [`MAX_DESCRIPTION_CHARS`]; `None` when nothing is left, which clears it.
+pub fn normalize_description(input: &str) -> Option<SharedString> {
+    let collapsed = input.split_whitespace().collect::<Vec<_>>().join(" ");
+    if collapsed.is_empty() {
+        return None;
+    }
+    Some(
+        collapsed
+            .chars()
+            .take(MAX_DESCRIPTION_CHARS)
+            .collect::<String>()
+            .into(),
+    )
+}
+
+pub enum ThreadDescriptionEvent {
+    Changed(ThreadId),
+}
+
+struct GlobalThreadDescriptionStore(Entity<ThreadDescriptionStore>);
+
+impl Global for GlobalThreadDescriptionStore {}
+
+pub fn init(cx: &mut App) {
+    let db = ThreadDescriptionDb::global(cx);
+    let store = cx.new(|cx| ThreadDescriptionStore::new(db, cx));
+    cx.set_global(GlobalThreadDescriptionStore(store));
+}
+
+/// Called with `thread_organization::forget`, inside a `ThreadMetadataStore` update.
+pub fn forget(thread_id: ThreadId, cx: &mut App) {
+    if let Some(store) = ThreadDescriptionStore::try_global(cx) {
+        store.update(cx, |store, cx| store.forget_thread(thread_id, cx));
+    }
+}
+
+enum Write {
+    Upsert(ThreadId, SharedString),
+    Delete(ThreadId),
+}
+
+pub struct ThreadDescriptionStore {
+    descriptions: HashMap<ThreadId, SharedString>,
+    /// `None` when loading failed or the database is the in-memory fallback: the session's
+    /// descriptions stay in memory.
+    writes: Option<mpsc::UnboundedSender<Write>>,
+    _writer: Task<()>,
+}
+
+impl EventEmitter<ThreadDescriptionEvent> for ThreadDescriptionStore {}
+
+impl ThreadDescriptionStore {
+    pub fn global(cx: &App) -> Entity<Self> {
+        cx.global::<GlobalThreadDescriptionStore>().0.clone()
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalThreadDescriptionStore>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(db: ThreadDescriptionDb, cx: &mut Context<Self>) -> Self {
+        let on_fallback = db::ALL_FILE_DB_FAILED.load(Ordering::Acquire);
+        Self::with_fallback_flag(db, on_fallback, cx)
+    }
+
+    pub(super) fn with_fallback_flag(
+        db: ThreadDescriptionDb,
+        on_fallback: bool,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let mut store = Self {
+            descriptions: HashMap::default(),
+            writes: None,
+            _writer: Task::ready(()),
+        };
+        if on_fallback {
+            log::warn!("thread_description: database unavailable, descriptions will not persist");
+        }
+        match load(&db) {
+            Ok(descriptions) => store.descriptions = descriptions,
+            Err(error) => {
+                log::warn!(
+                    "thread_description: loading failed, descriptions will not persist this \
+                     session: {error:#}"
+                );
+                return store;
+            }
+        }
+        let (writes, mut queue) = mpsc::unbounded::<Write>();
+        store.writes = Some(writes);
+        store._writer = cx.background_spawn(async move {
+            while let Some(write) = queue.next().await {
+                let (operation, thread_id) = match &write {
+                    Write::Upsert(thread_id, _) => ("set", *thread_id),
+                    Write::Delete(thread_id) => ("clear", *thread_id),
+                };
+                if let Err(error) = db.write(move |connection| apply(connection, write)).await {
+                    log::error!(
+                        "thread_description: {operation} failed for thread {}: {error:#}",
+                        thread_id.to_key_string()
+                    );
+                }
+            }
+        });
+        store
+    }
+
+    pub fn description(&self, thread_id: ThreadId) -> Option<&SharedString> {
+        self.descriptions.get(&thread_id)
+    }
+
+    /// Sets a saved thread's description, or clears it when `input` normalizes to nothing.
+    pub fn set_description(
+        &mut self,
+        thread_id: ThreadId,
+        input: &str,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        let write = match normalize_description(input) {
+            Some(description) => {
+                if self.descriptions.get(&thread_id) == Some(&description) {
+                    return Ok(());
+                }
+                self.descriptions.insert(thread_id, description.clone());
+                Write::Upsert(thread_id, description)
+            }
+            None => {
+                if self.descriptions.remove(&thread_id).is_none() {
+                    return Ok(());
+                }
+                Write::Delete(thread_id)
+            }
+        };
+        self.commit(write, thread_id, cx);
+        Ok(())
+    }
+
+    fn forget_thread(&mut self, thread_id: ThreadId, cx: &mut Context<Self>) {
+        if self.descriptions.remove(&thread_id).is_some() {
+            self.commit(Write::Delete(thread_id), thread_id, cx);
+        }
+    }
+
+    fn commit(&mut self, write: Write, thread_id: ThreadId, cx: &mut Context<Self>) {
+        if let Some(writes) = &self.writes
+            && let Err(error) = writes.unbounded_send(write)
+        {
+            log::error!("thread_description: the writer stopped, a change was not saved: {error}");
+        }
+        cx.emit(ThreadDescriptionEvent::Changed(thread_id));
+        cx.notify();
+    }
+}
+
+fn apply(connection: &db::sqlez::connection::Connection, write: Write) -> Result<()> {
+    match write {
+        Write::Upsert(thread_id, description) => {
+            connection.exec_bound::<(ThreadId, String)>(sql!(
+                INSERT INTO thread_descriptions(thread_id, description) VALUES (?, ?)
+                ON CONFLICT(thread_id) DO UPDATE SET description = excluded.description
+            ))?((thread_id, description.to_string()))
+        }
+        Write::Delete(thread_id) => connection.exec_bound::<ThreadId>(sql!(
+            DELETE FROM thread_descriptions WHERE thread_id = ?
+        ))?(thread_id),
+    }
+}
+
+fn load(db: &ThreadDescriptionDb) -> Result<HashMap<ThreadId, SharedString>> {
+    let rows = db.select::<(ThreadId, String)>(sql!(
+        SELECT thread_id, description FROM thread_descriptions
+    ))?()
+    .context("reading thread_descriptions")?;
+    Ok(rows
+        .into_iter()
+        .map(|(thread_id, description)| (thread_id, description.into()))
+        .collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use db::sqlez::connection::Connection;
+    use gpui::{Entity, TestAppContext};
+
+    use super::super::ThreadOrganizationDb;
+    use super::super::test_helpers::{PROJECT_A, delete_thread, draft_in, init, thread};
+    use super::*;
+
+    async fn open_db(name: &'static str) -> ThreadDescriptionDb {
+        ThreadDescriptionDb::open_test_db(name).await
+    }
+
+    fn open_store(
+        db: &ThreadDescriptionDb,
+        cx: &mut TestAppContext,
+    ) -> Entity<ThreadDescriptionStore> {
+        let db = db.clone();
+        let store = cx.new(|cx| ThreadDescriptionStore::with_fallback_flag(db, false, cx));
+        cx.run_until_parked();
+        store
+    }
+
+    fn set(
+        store: &Entity<ThreadDescriptionStore>,
+        thread_id: ThreadId,
+        text: &str,
+        cx: &mut TestAppContext,
+    ) -> Result<(), OrganizeError> {
+        let result = store.update(cx, |store, cx| store.set_description(thread_id, text, cx));
+        cx.run_until_parked();
+        result
+    }
+
+    fn read(
+        store: &Entity<ThreadDescriptionStore>,
+        thread_id: ThreadId,
+        cx: &TestAppContext,
+    ) -> Option<String> {
+        store.read_with(cx, |store, _| {
+            store.description(thread_id).map(|d| d.to_string())
+        })
+    }
+
+    #[test]
+    fn a_description_is_one_trimmed_line_and_blank_clears_it() {
+        assert_eq!(
+            normalize_description("  Fix the\n  release   build \t").as_deref(),
+            Some("Fix the release build")
+        );
+        assert_eq!(normalize_description(" \n\t "), None);
+        let long = "x".repeat(MAX_DESCRIPTION_CHARS + 40);
+        assert_eq!(
+            normalize_description(&long).map(|d| d.chars().count()),
+            Some(MAX_DESCRIPTION_CHARS)
+        );
+    }
+
+    /// Hostile: the description must not share 0048's migration list, whose steps land at
+    /// different indexes with and without the `devtools-panel` USE flag (0063).
+    #[test]
+    fn the_description_has_a_migration_list_of_its_own() {
+        assert_ne!(ThreadDescriptionDb::NAME, ThreadOrganizationDb::NAME);
+        assert!(
+            ThreadOrganizationDb::MIGRATIONS
+                .iter()
+                .all(|step| !step.contains("description")),
+            "no step of thread_organization mentions it"
+        );
+        let connection = Connection::open_memory(Some("thread_description_migration"));
+        connection
+            .migrate(
+                ThreadDescriptionDb::NAME,
+                ThreadDescriptionDb::MIGRATIONS,
+                &mut |_, _, _| false,
+            )
+            .expect("the description migration applies");
+    }
+
+    #[gpui::test]
+    async fn a_saved_threads_description_survives_a_restart(cx: &mut TestAppContext) {
+        init(cx);
+        let db = open_db("description_restart").await;
+        let store = open_store(&db, cx);
+        let thread_id = thread(cx);
+        set(&store, thread_id, "Ship the 0.10.0 release", cx).expect("a saved thread");
+        assert_eq!(
+            read(&store, thread_id, cx).as_deref(),
+            Some("Ship the 0.10.0 release")
+        );
+
+        cx.run_until_parked();
+        drop(store);
+        let store = open_store(&db, cx);
+        assert_eq!(
+            read(&store, thread_id, cx).as_deref(),
+            Some("Ship the 0.10.0 release")
+        );
+
+        set(&store, thread_id, "   ", cx).expect("clearing");
+        let store = {
+            cx.run_until_parked();
+            drop(store);
+            open_store(&db, cx)
+        };
+        assert_eq!(
+            read(&store, thread_id, cx),
+            None,
+            "a blank description is cleared on disk"
+        );
+    }
+
+    /// Hostile: a draft is refused, as the organization refuses it.
+    #[gpui::test]
+    async fn a_draft_has_no_description(cx: &mut TestAppContext) {
+        init(cx);
+        let db = open_db("description_draft").await;
+        let store = open_store(&db, cx);
+        let draft = draft_in(PROJECT_A, cx);
+        assert!(matches!(
+            set(&store, draft, "Never stored", cx),
+            Err(OrganizeError::Draft { .. })
+        ));
+        assert_eq!(read(&store, draft, cx), None);
+    }
+
+    /// A deleted thread's description goes with it, through thread_organization::forget.
+    #[gpui::test]
+    async fn a_deleted_threads_description_is_forgotten(cx: &mut TestAppContext) {
+        init(cx);
+        let db = open_db("description_forget").await;
+        let store = open_store(&db, cx);
+        cx.update(|cx| cx.set_global(GlobalThreadDescriptionStore(store.clone())));
+        let thread_id = thread(cx);
+        set(&store, thread_id, "Doomed", cx).expect("a saved thread");
+        assert_eq!(
+            read(&store, thread_id, cx).as_deref(),
+            Some("Doomed"),
+            "precondition: there is something to forget"
+        );
+        delete_thread(thread_id, cx);
+        assert_eq!(read(&store, thread_id, cx), None);
+        drop(store);
+        cx.update(|cx| cx.remove_global::<GlobalThreadDescriptionStore>());
+        let store = open_store(&db, cx);
+        assert_eq!(read(&store, thread_id, cx), None, "and from disk");
+    }
+
+    /// The modal (§6.6): prefilled with the current description; Enter saves the new one and
+    /// closes; a blank line clears it.
+    #[gpui::test]
+    async fn the_modal_edits_and_clears_the_description(cx: &mut TestAppContext) {
+        init(cx);
+        let db = open_db("description_modal").await;
+        let store = open_store(&db, cx);
+        cx.update(|cx| cx.set_global(GlobalThreadDescriptionStore(store.clone())));
+        let thread_id = thread(cx);
+        set(&store, thread_id, "Old purpose", cx).expect("a saved thread");
+
+        let (modal, cx) = cx.add_window_view(|window, cx| {
+            crate::thread_description_modal::ThreadDescriptionModal::new(thread_id, window, cx)
+        });
+        let prefilled = modal.read_with(cx, |modal, cx| modal.editor().read(cx).text(cx));
+        assert_eq!(prefilled, "Old purpose");
+
+        modal.update_in(cx, |modal, window, cx| {
+            modal
+                .editor()
+                .update(cx, |editor, cx| editor.set_text("New purpose", window, cx));
+            modal.confirm(cx);
+        });
+        cx.run_until_parked();
+        assert_eq!(
+            store.read_with(cx, |store, _| store
+                .description(thread_id)
+                .map(|d| d.to_string())),
+            Some("New purpose".to_string())
+        );
+
+        modal.update_in(cx, |modal, window, cx| {
+            modal
+                .editor()
+                .update(cx, |editor, cx| editor.set_text("  ", window, cx));
+            modal.confirm(cx);
+        });
+        cx.run_until_parked();
+        assert_eq!(
+            store.read_with(cx, |store, _| store.description(thread_id).cloned()),
+            None,
+            "a blank line clears it"
+        );
+    }
+}
