diff --git a/crates/agent_ui/src/agent_panel/tests/description_header_tests.rs b/crates/agent_ui/src/agent_panel/tests/description_header_tests.rs
new file mode 100644
index 0000000..2f0108c
--- /dev/null
+++ b/crates/agent_ui/src/agent_panel/tests/description_header_tests.rs
@@ -0,0 +1,67 @@
+// Zeo next proposal §6.6 (ask 19): a thread's description shows as an icon beside its title in
+// the agent panel's toolbar, and follows an edit at once.
+
+use super::*;
+use crate::thread_organization::description::ThreadDescriptionStore;
+
+#[gpui::test]
+async fn test_the_description_shows_beside_the_title(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        if ThreadDescriptionStore::try_global(cx).is_none() {
+            crate::thread_organization::init(cx);
+        }
+    });
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .unwrap();
+    let cx = &mut VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(size(px(900.), px(700.)));
+    let panel = workspace.update_in(cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    open_thread_with_connection(&panel, StubAgentConnection::new(), cx);
+    send_message(&panel, cx);
+    cx.run_until_parked();
+    assert!(
+        cx.debug_bounds("agent-panel-thread-description").is_none(),
+        "no description yet"
+    );
+
+    let thread_id = panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .expect("a thread is open")
+            .read(cx)
+            .thread_id
+    });
+    cx.update(|_, cx| {
+        ThreadDescriptionStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_description(thread_id, "Ship the Wave 3 release", cx)
+                .expect("a saved thread")
+        })
+    });
+    cx.run_until_parked();
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+    assert_eq!(
+        panel.read_with(cx, |panel, cx| panel.visible_thread_description(cx)),
+        Some("Ship the Wave 3 release".into())
+    );
+    assert!(
+        cx.debug_bounds("agent-panel-thread-description").is_some(),
+        "the icon is drawn beside the title"
+    );
+}
