@@ -0,0 +1,47 @@
+//! A thread's description in the threads sidebar (Zeo next proposal §6.6): an icon after the
+//! title whose tooltip reads it, and "Edit Description…" in the thread's menu, beside "Tags…".
+//! `sidebar.rs` only calls into it through one-line hooks.
+
+use agent_ui::ThreadId;
+use agent_ui::thread_description_modal::{EDIT_DESCRIPTION_MENU_LABEL, ThreadDescriptionModal};
+use agent_ui::thread_organization::description::ThreadDescriptionStore;
+use gpui::{App, SharedString, WeakEntity};
+use ui::ContextMenu;
+
+use crate::Sidebar;
+
+/// The thread's description, if it has one; `None` without the store.
+pub(crate) fn description_for(thread_id: ThreadId, cx: &App) -> Option<SharedString> {
+    ThreadDescriptionStore::try_global(cx)?
+        .read(cx)
+        .description(thread_id)
+        .cloned()
+}
+
+/// "Edit Description…" for the thread's menu, offered only when the store is installed.
+pub(crate) fn description_menu_entry(
+    menu: ContextMenu,
+    thread_id: ThreadId,
+    sidebar: WeakEntity<Sidebar>,
+    cx: &App,
+) -> ContextMenu {
+    if ThreadDescriptionStore::try_global(cx).is_none() {
+        return menu;
+    }
+    menu.entry(EDIT_DESCRIPTION_MENU_LABEL, None, move |window, cx| {
+        // Resolved on click: the active workspace can change while the menu is open.
+        let workspace = sidebar
+            .read_with(cx, |sidebar, cx| sidebar.active_workspace(cx))
+            .ok()
+            .flatten();
+        let Some(workspace) = workspace else {
+            log::warn!("sidebar: no workspace to edit the description of thread {thread_id:?}");
+            return;
+        };
+        workspace.update(cx, |workspace, cx| {
+            workspace.toggle_modal(window, cx, |window, cx| {
+                ThreadDescriptionModal::new(thread_id, window, cx)
+            });
+        });
+    })
+}
