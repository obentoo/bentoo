@@ -0,0 +1,115 @@
+//! Zeo next proposal §6.6 (ask 19): the modal that edits a thread's description. One line,
+//! prefilled with the current text; Enter saves (a blank line clears it), Escape keeps what
+//! was there. Opened from the agent menu and from the thread's menu in the sidebar.
+
+use editor::Editor;
+use gpui::{
+    App, Context, DismissEvent, Entity, EventEmitter, FocusHandle, Focusable, Render, SharedString,
+    Window,
+};
+use ui::prelude::*;
+use workspace::ModalView;
+
+use crate::thread_metadata_store::ThreadId;
+use crate::thread_organization::description::{MAX_DESCRIPTION_CHARS, ThreadDescriptionStore};
+
+/// The entry's label in both menus.
+pub const EDIT_DESCRIPTION_MENU_LABEL: &str = "Edit Description\u{2026}";
+
+pub struct ThreadDescriptionModal {
+    thread_id: ThreadId,
+    editor: Entity<Editor>,
+    /// Why the last Enter saved nothing (a draft), until the next one.
+    error: Option<SharedString>,
+}
+
+impl ThreadDescriptionModal {
+    pub fn new(thread_id: ThreadId, window: &mut Window, cx: &mut Context<Self>) -> Self {
+        let current = ThreadDescriptionStore::try_global(cx)
+            .and_then(|store| store.read(cx).description(thread_id).cloned());
+        let editor = cx.new(|cx| {
+            let mut editor = Editor::single_line(window, cx);
+            editor.set_placeholder_text("What is this thread for?", window, cx);
+            if let Some(current) = &current {
+                editor.set_text(current.as_ref(), window, cx);
+            }
+            editor
+        });
+        Self {
+            thread_id,
+            editor,
+            error: None,
+        }
+    }
+
+    pub fn editor(&self) -> &Entity<Editor> {
+        &self.editor
+    }
+
+    /// Saves the editor's text; closes on success, says why on a refusal.
+    pub fn confirm(&mut self, cx: &mut Context<Self>) {
+        let Some(store) = ThreadDescriptionStore::try_global(cx) else {
+            log::warn!("thread description: no store to save into");
+            cx.emit(DismissEvent);
+            return;
+        };
+        let text = self.editor.read(cx).text(cx);
+        let thread_id = self.thread_id;
+        match store.update(cx, |store, cx| store.set_description(thread_id, &text, cx)) {
+            Ok(()) => cx.emit(DismissEvent),
+            Err(error) => {
+                self.error = Some(format!("Not saved: {error}").into());
+                cx.notify();
+            }
+        }
+    }
+}
+
+impl ModalView for ThreadDescriptionModal {}
+
+impl EventEmitter<DismissEvent> for ThreadDescriptionModal {}
+
+impl Focusable for ThreadDescriptionModal {
+    fn focus_handle(&self, cx: &App) -> FocusHandle {
+        self.editor.focus_handle(cx)
+    }
+}
+
+impl Render for ThreadDescriptionModal {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        v_flex()
+            .key_context("ThreadDescriptionModal")
+            .debug_selector(|| "thread-description-modal".into())
+            .on_action(cx.listener(|this, _: &menu::Confirm, _, cx| this.confirm(cx)))
+            .on_action(cx.listener(|_, _: &menu::Cancel, _, cx| cx.emit(DismissEvent)))
+            .elevation_3(cx)
+            .w(rems(32.))
+            .p_2()
+            .gap_1()
+            .child(Label::new("Thread Description").size(LabelSize::Small))
+            .child(
+                div()
+                    .px_1()
+                    .py_0p5()
+                    .rounded_sm()
+                    .border_1()
+                    .border_color(cx.theme().colors().border)
+                    .child(self.editor.clone()),
+            )
+            .child(
+                Label::new(format!(
+                    "Enter saves, a blank line clears it, Escape cancels. Up to \
+                     {MAX_DESCRIPTION_CHARS} characters, on one line."
+                ))
+                .size(LabelSize::XSmall)
+                .color(Color::Muted),
+            )
+            .when_some(self.error.clone(), |this, error| {
+                this.child(
+                    Label::new(error)
+                        .size(LabelSize::XSmall)
+                        .color(Color::Error),
+                )
+            })
+    }
+}
