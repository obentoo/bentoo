+// Store and view helpers shared by the modules of `sidebar_lists_tests` (see `mod.rs` for the
+// selector contract they read).
+
+use super::*;
+
+// ── The store, driven directly (fixtures and read-back) ───────────────────
+
+pub(super) fn create_list(name: &str, cx: &mut VisualTestContext) -> ListId {
+    let id = cx
+        .update(|_, cx| {
+            ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.create_list(name, cx))
+        })
+        .expect("fixture: the store accepts a new valid list name");
+    cx.run_until_parked();
+    id
+}
+
+pub(super) fn file_in(thread_id: ThreadId, list: Option<ListId>, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.set_list(thread_id, list, cx))
+    })
+    .expect("fixture: the store files a known thread in a known list");
+    cx.run_until_parked();
+}
+
+pub(super) fn delete_list_in_store(list: ListId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.delete_list(list, cx))
+    })
+    .expect("fixture: the store deletes a known list");
+    cx.run_until_parked();
+}
+
+pub(super) fn move_list_in_store(list: ListId, to_index: usize, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.move_list(list, to_index, cx))
+    })
+    .expect("fixture: the store moves a known list");
+    cx.run_until_parked();
+}
+
+pub(super) fn pin(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.pin(thread_id, cx))
+    })
+    .expect("fixture: the store pins a known thread");
+    cx.run_until_parked();
+}
+
+pub(super) fn tag(thread_id: ThreadId, tag: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.add_tag(thread_id, tag, cx))
+    })
+    .expect("fixture: the store tags a known thread");
+    cx.run_until_parked();
+}
+
+/// The store's list names, in its order.
+pub(super) fn list_names(cx: &mut VisualTestContext) -> Vec<String> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .lists()
+            .iter()
+            .map(|list| list.name.to_string())
+            .collect()
+    })
+}
+
+pub(super) fn list_ids(cx: &mut VisualTestContext) -> Vec<ListId> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .lists()
+            .iter()
+            .map(|list| list.id)
+            .collect()
+    })
+}
+
+pub(super) fn list_of(thread_id: ThreadId, cx: &mut VisualTestContext) -> Option<ListId> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .organization(thread_id)
+            .and_then(|organization| organization.list_id)
+    })
+}
+
+pub(super) fn is_pinned(thread_id: ThreadId, cx: &mut VisualTestContext) -> bool {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .pinned()
+            .any(|pinned| pinned == thread_id)
+    })
+}
+
+pub(super) fn tag_keys(thread_id: ThreadId, cx: &mut VisualTestContext) -> Vec<String> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .tags(thread_id)
+            .into_iter()
+            .map(|tag| tag.key.to_string())
+            .collect()
+    })
+}
+
+// ── Reading the view ───────────────────────────────────────────────────────
+
+pub(super) fn is_lists(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> bool {
+    sidebar.read_with(cx, |sidebar, _| {
+        matches!(sidebar.view, SidebarView::Lists { .. })
+    })
+}
+
+pub(super) fn is_history(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> bool {
+    sidebar.read_with(cx, |sidebar, _| {
+        matches!(sidebar.view, SidebarView::Archive(_))
+    })
+}
+
+pub(super) fn is_thread_list(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> bool {
+    sidebar.read_with(cx, |sidebar, _| {
+        matches!(sidebar.view, SidebarView::ThreadList)
+    })
+}
+
+/// `cx.debug_bounds` takes a `&'static str`; selectors built from names are leaked, in tests only.
+pub(super) fn selector(text: String) -> &'static str {
+    Box::leak(text.into_boxed_str())
+}
+
+pub(super) fn header(name: &str, shown: usize) -> &'static str {
+    selector(format!("LISTS_HEADER-{name} ({shown})"))
+}
+
+pub(super) fn row(title: &str, project: &str) -> &'static str {
+    selector(format!("LISTS_ROW-{title} · {project}"))
+}
+
+pub(super) fn no_threads(name: &str) -> &'static str {
+    selector(format!("LISTS_NO_THREADS-{name}"))
+}
+
+pub(super) fn message(text: &str) -> &'static str {
+    selector(format!("LISTS_NAME_MESSAGE-{text}"))
+}
+
+pub(super) fn menu_item(label: &str) -> &'static str {
+    selector(format!("MENU_ITEM-{label}"))
+}
+
+/// Draws a frame of the window, so the selectors read the current state.
+pub(super) fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+pub(super) fn shown(selector: &'static str, cx: &mut VisualTestContext) -> bool {
+    draw(cx);
+    cx.debug_bounds(selector).is_some()
+}
+
+pub(super) fn bounds(selector: &'static str, cx: &mut VisualTestContext) -> Bounds<Pixels> {
+    draw(cx);
+    cx.debug_bounds(selector)
+        .unwrap_or_else(|| panic!("`{selector}` is not rendered"))
+}
+
+/// The count a list's header shows, whatever it is; `None` when no header names the list.
+pub(super) fn header_count(name: &str, cx: &mut VisualTestContext) -> Option<usize> {
+    draw(cx);
+    (0..=20).find(|count| cx.debug_bounds(header(name, *count)).is_some())
+}
+
+/// Asserts every selector is rendered, each strictly below the one before it.
+#[track_caller]
+pub(super) fn assert_top_to_bottom(selectors: &[&'static str], cx: &mut VisualTestContext) {
+    draw(cx);
+    let mut previous: Option<(&str, Pixels)> = None;
+    for selector in selectors {
+        let top = cx
+            .debug_bounds(selector)
+            .unwrap_or_else(|| panic!("`{selector}` is not rendered"))
+            .origin
+            .y;
+        if let Some((above, above_top)) = previous {
+            assert!(
+                above_top < top,
+                "`{above}` (y {above_top:?}) must be above `{selector}` (y {top:?})"
+            );
+        }
+        previous = Some((selector, top));
+    }
+}
+
+pub(super) fn click(selector: &'static str, cx: &mut VisualTestContext) {
+    let target = bounds(selector, cx);
+    cx.simulate_click(target.center(), Modifiers::none());
+    cx.run_until_parked();
+}
+
+pub(super) fn right_click(selector: &'static str, cx: &mut VisualTestContext) {
+    let target = bounds(selector, cx).center();
+    cx.simulate_mouse_down(target, MouseButton::Right, Modifiers::none());
+    cx.simulate_mouse_up(target, MouseButton::Right, Modifiers::none());
+    cx.run_until_parked();
+}
+
+/// Right-clicks the thread list's row of `thread_id` (not a pinned row).
+pub(super) fn right_click_group_row(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) {
+    let ix = sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread)
+                    if thread.metadata.thread_id == thread_id
+                        && thread.pinned_project_label.is_none())
+            })
+            .expect("fixture: the thread has a row in its group")
+    });
+    right_click_entry(sidebar, ix, cx);
+}
+
+/// Right-clicks the Pinned section's row of `thread_id`.
+pub(super) fn right_click_pinned_row(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) {
+    let ix = sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread)
+                    if thread.metadata.thread_id == thread_id
+                        && thread.pinned_project_label.is_some())
+            })
+            .expect("fixture: the thread has a pinned row")
+    });
+    right_click_entry(sidebar, ix, cx);
+}
+
+pub(super) fn right_click_entry(sidebar: &Entity<Sidebar>, ix: usize, cx: &mut VisualTestContext) {
+    draw(cx);
+    let target = sidebar
+        .read_with(cx, |sidebar, _| sidebar.list_state.bounds_for_item(ix))
+        .expect("fixture: the entry is rendered")
+        .center();
+    cx.simulate_mouse_down(target, MouseButton::Right, Modifiers::none());
+    cx.simulate_mouse_up(target, MouseButton::Right, Modifiers::none());
+    cx.run_until_parked();
+    assert!(
+        shown("MENU_ITEM-Archive Thread", cx),
+        "fixture: the thread's context menu is open"
+    );
+}
+
+/// Opens the "Move to List" submenu of the menu open now (see the file header). False when no
+/// entry of that menu opens it.
+pub(super) fn open_move_to_list(cx: &mut VisualTestContext) -> bool {
+    // A right-clicked menu takes focus on a later platform frame, which a test window never
+    // runs; hovering one of its entries focuses it as a pointer does, so the keys reach it.
+    if let Some(entry) = cx.debug_bounds("MENU_ITEM-Archive Thread") {
+        cx.simulate_mouse_move(entry.center(), None, Modifiers::none());
+        cx.run_until_parked();
+    }
+    for _ in 0..16 {
+        cx.dispatch_action(SelectNext);
+        cx.dispatch_action(SelectChild);
+        if shown(NEW_LIST_ENTRY, cx) {
+            return true;
+        }
+        cx.dispatch_action(SelectParent);
+        cx.run_until_parked();
+    }
+    false
+}
+
+/// Clicks the footer button, as a user opens or leaves the Lists view.
+pub(super) fn click_lists_button(cx: &mut VisualTestContext) {
+    click(LISTS_BUTTON, cx);
+}
+
+pub(super) fn open_lists_view(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) {
+    click_lists_button(cx);
+    assert!(is_lists(sidebar, cx), "fixture: the Lists view is shown");
+}
+
+pub(super) fn dispatch_toggle_lists(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) {
+    focus_sidebar(sidebar, cx);
+    cx.dispatch_action(ToggleThreadLists);
+    cx.run_until_parked();
+}
+
+/// Replaces the open name field's text with `text`, as a user selects all and types.
+pub(super) fn type_name(text: &str, cx: &mut VisualTestContext) {
+    assert!(shown(NAME_FIELD, cx), "fixture: the name field is open");
+    cx.dispatch_action(editor::actions::SelectAll);
+    cx.simulate_input(text);
+    cx.run_until_parked();
+}
+
+/// Enter in a single-line editor.
+pub(super) fn press_enter(cx: &mut VisualTestContext) {
+    cx.dispatch_action(Confirm);
+    cx.run_until_parked();
+}
+
+/// Escape in an editor.
+pub(super) fn press_escape(cx: &mut VisualTestContext) {
+    cx.dispatch_action(editor::actions::Cancel);
+    cx.run_until_parked();
+}
+
+pub(super) fn active_thread(
+    sidebar: &Entity<Sidebar>,
+    cx: &mut VisualTestContext,
+) -> Option<ThreadId> {
+    sidebar.read_with(cx, |sidebar, _| match &sidebar.active_entry {
+        Some(ActiveEntry::Thread { thread_id, .. }) => Some(*thread_id),
+        _ => None,
+    })
+}
+
+pub(super) fn local_key(path: &str) -> ProjectGroupKey {
+    ProjectGroupKey::new(None, PathList::new(&[PathBuf::from(path)]))
+}
