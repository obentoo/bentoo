+// ═══ Task 3.1 — the third sidebar view ═════════════════════════════════════
+use super::*;
+// Explicit, because the parent's glob-imported `assert_eq` is ambiguous with the std prelude's.
+use pretty_assertions::assert_eq;
+
+// R1.1, R1.8 — the footer offers "Thread Lists" beside History only when the store is
+// installed. The History button is the control: the footer is rendered in both cases.
+#[gpui::test]
+async fn the_lists_button_exists_only_with_the_store(cx: &mut TestAppContext) {
+    let (_mw, _sidebar, cx) = alpha_window(false, cx).await;
+    assert!(shown(HISTORY_BUTTON, cx), "fixture: the footer is rendered");
+    assert!(
+        !shown(LISTS_BUTTON, cx),
+        "no Thread Lists button without the organization store"
+    );
+}
+
+#[gpui::test]
+async fn the_lists_button_sits_beside_history_with_the_store(cx: &mut TestAppContext) {
+    let (_mw, _sidebar, cx) = alpha_window(true, cx).await;
+    let history = bounds(HISTORY_BUTTON, cx);
+    let lists = bounds(LISTS_BUTTON, cx);
+    assert!(
+        (lists.center().y - history.center().y).abs() < px(4.0),
+        "the button is in the footer row, beside History ({lists:?} vs {history:?})"
+    );
+}
+
+// R1.2, R1.3 — a click from the thread list shows Lists; a second click shows the thread list.
+#[gpui::test]
+async fn the_button_toggles_between_the_thread_list_and_lists(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    assert!(
+        is_thread_list(&sidebar, cx),
+        "fixture: starts on the thread list"
+    );
+
+    click_lists_button(cx);
+    assert!(
+        is_lists(&sidebar, cx),
+        "the first click shows the Lists view"
+    );
+
+    click_lists_button(cx);
+    assert!(
+        is_thread_list(&sidebar, cx),
+        "the second click shows the thread list again"
+    );
+}
+
+// R1.4, R1.5 — History from Lists shows History (NOT the thread list: a toggle that treats
+// every non-thread-list view as History would wrongly go back), and Lists from History shows
+// Lists (NOT the thread list).
+#[gpui::test]
+async fn history_and_lists_switch_directly(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+    open_lists_view(&sidebar, cx);
+
+    click(HISTORY_BUTTON, cx);
+    assert!(
+        is_history(&sidebar, cx),
+        "History from the Lists view shows History"
+    );
+
+    click_lists_button(cx);
+    assert!(
+        is_lists(&sidebar, cx),
+        "Thread Lists from History shows the Lists view"
+    );
+}
+
+// R1.9 — the action behaves as the click, from each of the three views.
+#[gpui::test]
+async fn the_action_behaves_as_the_click(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+
+    dispatch_toggle_lists(&sidebar, cx);
+    assert!(is_lists(&sidebar, cx), "from the thread list: Lists");
+
+    dispatch_toggle_lists(&sidebar, cx);
+    assert!(is_thread_list(&sidebar, cx), "from Lists: the thread list");
+
+    click(HISTORY_BUTTON, cx);
+    assert!(is_history(&sidebar, cx), "fixture: History is shown");
+    dispatch_toggle_lists(&sidebar, cx);
+    assert!(is_lists(&sidebar, cx), "from History: Lists");
+}
+
+// R1.6 — the saved state carries the Lists view and a restored sidebar shows it.
+#[gpui::test]
+async fn the_saved_state_restores_the_lists_view(cx: &mut TestAppContext) {
+    let (multi_workspace, sidebar, cx) = alpha_window(true, cx).await;
+    open_lists_view(&sidebar, cx);
+    let saved = sidebar
+        .read_with(cx, |sidebar, cx| sidebar.serialized_state(cx))
+        .expect("the sidebar serializes its state");
+
+    let restored =
+        cx.update(|window, cx| cx.new(|cx| Sidebar::new(multi_workspace.clone(), window, cx)));
+    cx.run_until_parked();
+    assert!(
+        is_thread_list(&restored, cx),
+        "fixture: a new sidebar starts on the list"
+    );
+    restored.update_in(cx, |sidebar, window, cx| {
+        sidebar.restore_serialized_state(&saved, window, cx);
+    });
+    cx.run_until_parked();
+
+    assert!(
+        is_lists(&restored, cx),
+        "the restored sidebar shows the Lists view"
+    );
+}
+
+// R1.6 converse — a saved thread list restores the thread list, and a saved History (in its
+// current spelling and in the legacy "Archive" one) restores History: neither becomes Lists.
+#[gpui::test]
+async fn other_saved_views_never_restore_as_lists(cx: &mut TestAppContext) {
+    let (multi_workspace, _sidebar, cx) = alpha_window_with_panel(cx).await;
+    let thread_list = serde_json::to_string(&SerializedSidebar {
+        active_view: SerializedSidebarView::ThreadList,
+        ..Default::default()
+    })
+    .expect("serializable");
+    let history = serde_json::to_string(&SerializedSidebar {
+        active_view: SerializedSidebarView::History,
+        ..Default::default()
+    })
+    .expect("serializable");
+    let legacy_archive = r#"{"active_view":"Archive"}"#.to_string();
+
+    for (saved, expect_history) in [
+        (thread_list, false),
+        (history, true),
+        (legacy_archive, true),
+    ] {
+        let restored =
+            cx.update(|window, cx| cx.new(|cx| Sidebar::new(multi_workspace.clone(), window, cx)));
+        restored.update_in(cx, |sidebar, window, cx| {
+            sidebar.restore_serialized_state(&saved, window, cx);
+        });
+        cx.run_until_parked();
+        assert!(
+            !is_lists(&restored, cx),
+            "{saved} must not restore the Lists view"
+        );
+        assert_eq!(
+            is_history(&restored, cx),
+            expect_history,
+            "{saved} restores History: {expect_history}"
+        );
+    }
+}
+
+// R1.10 — a window saved with the Lists view, restored where the store is not installed,
+// shows the thread list (and does not panic).
+#[gpui::test]
+async fn a_saved_lists_view_without_the_store_restores_the_thread_list(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(false, cx).await;
+    let saved = serde_json::to_string(&SerializedSidebar {
+        active_view: SerializedSidebarView::Lists,
+        ..Default::default()
+    })
+    .expect("serializable");
+
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.restore_serialized_state(&saved, window, cx);
+    });
+    cx.run_until_parked();
+
+    assert!(
+        is_thread_list(&sidebar, cx),
+        "without the store the thread list is shown"
+    );
+    assert!(
+        !shown(LISTS_BUTTON, cx),
+        "and no Thread Lists button appears"
+    );
+}
+
+// R1.7, R2.9 — leaving the Lists view shows the thread list exactly as before it opened:
+// same rows, same order, the same collapsed group and Pinned section, even though a thread
+// was filed into a list while the view was shown.
+#[gpui::test]
+async fn the_thread_list_after_leaving_equals_the_one_before(cx: &mut TestAppContext) {
+    let (multi_workspace, sidebar, cx) = alpha_window(true, cx).await;
+    open_in_window(BETA, &multi_workspace, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 3, cx);
+    save_in("a2", "Write docs", ALPHA, 2, cx);
+    let pinned = save_in("a3", "Tune cache", ALPHA, 1, cx);
+    save_in("b1", "Ship release", BETA, 4, cx);
+    pin(pinned, cx);
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.toggle_collapse(&local_key(BETA), window, cx);
+    });
+    cx.run_until_parked();
+    let before = visible_entries_as_strings(&sidebar, cx);
+    assert!(
+        before.iter().any(|line| line.trim() == "v Pinned")
+            && before.iter().any(|line| line.starts_with("> [beta]")),
+        "fixture: a Pinned section and a collapsed group: {before:?}"
+    );
+
+    open_lists_view(&sidebar, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    file_in(pinned, Some(ops), cx);
+    click_lists_button(cx);
+
+    assert!(
+        is_thread_list(&sidebar, cx),
+        "fixture: back on the thread list"
+    );
+    assert_eq!(visible_entries_as_strings(&sidebar, cx), before);
+}
