+// ═══ Task 5.1 — Move to List ═══════════════════════════════════════════════
+use super::*;
+use pretty_assertions::assert_eq;
+
+// R4.1 — the submenu lists every list in the STORE's order (moved after creation) and ends
+// in "New List…"; an unfiled thread is offered no "Remove from List".
+#[gpui::test]
+async fn the_submenu_lists_every_list_in_store_order(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    create_list("Ops", cx);
+    create_list("Docs", cx);
+    let later = create_list("Backlog", cx);
+    move_list_in_store(later, 0, cx);
+
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(
+        open_move_to_list(cx),
+        "the thread menu has a Move to List submenu"
+    );
+
+    assert_top_to_bottom(
+        &[
+            menu_item("Backlog"),
+            menu_item("Ops"),
+            menu_item("Docs"),
+            NEW_LIST_ENTRY,
+        ],
+        cx,
+    );
+    assert!(
+        !shown(REMOVE_ENTRY, cx),
+        "a thread in no list is offered no Remove from List"
+    );
+}
+
+// R4.1 — every thread row with a context menu has the submenu: a Pinned section row too.
+#[gpui::test]
+async fn a_pinned_row_has_the_submenu_too(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let pinned = save_in("a1", "Tune cache", ALPHA, 1, cx);
+    pin(pinned, cx);
+    create_list("Ops", cx);
+
+    right_click_pinned_row(&sidebar, pinned, cx);
+
+    assert!(
+        open_move_to_list(cx),
+        "the pinned row's menu has the submenu"
+    );
+    assert!(shown(menu_item("Ops"), cx));
+}
+
+// R4.2 — choosing another list records the thread there: it shows under the new list AND no
+// longer under the former one (exactly one list, never zero, never two).
+#[gpui::test]
+async fn choosing_another_list_moves_the_thread(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    let docs = create_list("Docs", cx);
+    file_in(fix, Some(ops), cx);
+
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(open_move_to_list(cx));
+    click(menu_item("Docs"), cx);
+
+    assert_eq!(
+        list_of(fix, cx),
+        Some(docs),
+        "the store records the new list"
+    );
+    open_lists_view(&sidebar, cx);
+    assert_top_to_bottom(
+        &[
+            header("Ops", 0),
+            header("Docs", 1),
+            row("Fix login", "alpha"),
+        ],
+        cx,
+    );
+    assert!(
+        shown(no_threads("Ops"), cx),
+        "the former list no longer shows the thread"
+    );
+}
+
+// R4.3 — choosing the thread's CURRENT list (the marked entry) changes nothing and logs
+// nothing: it must not act as a toggle that un-files the thread.
+#[gpui::test]
+async fn choosing_the_current_list_changes_nothing(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    create_list("Docs", cx);
+    file_in(fix, Some(ops), cx);
+    capture_logs();
+
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(open_move_to_list(cx));
+    click(menu_item("Ops"), cx);
+
+    assert_eq!(list_of(fix, cx), Some(ops), "the thread stays in its list");
+    assert_eq!(list_names(cx), vec!["Ops", "Docs"]);
+    assert_eq!(warn_lines(), Vec::<String>::new(), "nothing is logged");
+}
+
+// R4.4, R4.8 — "Remove from List" is offered only while the thread is in a list, and it
+// records the thread in no list; the list itself stays.
+#[gpui::test]
+async fn remove_from_list_is_offered_when_filed_and_clears_it(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let filed = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let unfiled = save_in("a2", "Write docs", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(filed, Some(ops), cx);
+
+    right_click_group_row(&sidebar, unfiled, cx);
+    assert!(open_move_to_list(cx));
+    assert!(
+        !shown(REMOVE_ENTRY, cx),
+        "not offered for a thread in no list"
+    );
+    cx.dispatch_action(Cancel);
+    cx.run_until_parked();
+
+    right_click_group_row(&sidebar, filed, cx);
+    assert!(open_move_to_list(cx));
+    click(REMOVE_ENTRY, cx);
+
+    assert_eq!(list_of(filed, cx), None, "the thread is in no list");
+    assert_eq!(list_names(cx), vec!["Ops"], "the list stays");
+}
+
+// R4.5 — "New List…" shows the Lists view with the name field open.
+#[gpui::test]
+async fn new_list_entry_opens_the_lists_view_with_the_field(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    create_list("Ops", cx);
+
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(open_move_to_list(cx));
+    click(NEW_LIST_ENTRY, cx);
+
+    assert!(is_lists(&sidebar, cx), "the Lists view is shown");
+    assert!(shown(NAME_FIELD, cx), "with its name field open");
+}
+
+// R4.7, Q4 — a refused change (the list was deleted between the menu and the click) changes
+// nothing and logs ONE warning naming the thread id, with no title and no list name.
+#[gpui::test]
+async fn a_refused_change_warns_with_the_thread_id_only(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    let gone = create_list("Gone soon", cx);
+    file_in(fix, Some(ops), cx);
+    delete_list_in_store(gone, cx);
+    capture_logs();
+
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.move_thread_to_list(fix, Some(gone), cx);
+    });
+    cx.run_until_parked();
+
+    assert_eq!(list_of(fix, cx), Some(ops), "the thread keeps its list");
+    assert_eq!(list_names(cx), vec!["Ops"], "every list is unchanged");
+    let warnings = warn_lines();
+    let naming_it: Vec<&String> = warnings
+        .iter()
+        .filter(|line| line.contains(&fix.to_key_string()))
+        .collect();
+    assert_eq!(
+        naming_it.len(),
+        1,
+        "one warning names the thread: {warnings:?}"
+    );
+    assert!(
+        warnings
+            .iter()
+            .all(|line| !line.contains("Fix login") && !line.contains("Gone soon")),
+        "no title and no list name in a log line: {warnings:?}"
+    );
+}
+
+// R4.1 — without the store the thread menu has no Move to List submenu.
+#[gpui::test]
+async fn no_submenu_without_the_store(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(false, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+
+    right_click_group_row(&sidebar, fix, cx);
+
+    assert!(!open_move_to_list(cx), "no Move to List without the store");
+}
diff --git a/crates/sidebar/src/sidebar_lists_tests/open.rs b/crates/sidebar/src/sidebar_lists_tests/open.rs
new file mode 100644
index 0000000..7ae73dc
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests/open.rs
@@ -0,0 +1,170 @@
+// ═══ Task 4.2 — opening a thread from a row ════════════════════════════════
+use super::*;
+use pretty_assertions::assert_eq;
+
+// R3.1, R3.4 — a row whose project is open in this window activates the thread in that
+// project's workspace (here not the active one), and the Lists view stays shown.
+#[gpui::test]
+async fn a_row_of_a_project_open_here_activates_its_workspace(cx: &mut TestAppContext) {
+    let (multi_workspace, sidebar, cx) = alpha_window(true, cx).await;
+    let alpha = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let beta = open_in_window(BETA, &multi_workspace, cx).await;
+    multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.activate(alpha.clone(), None, window, cx)
+    });
+    cx.run_until_parked();
+    let in_beta = save_in("b1", "Ship release", BETA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(in_beta, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+
+    click(row("Ship release", "beta"), cx);
+
+    assert_eq!(
+        multi_workspace.read_with(cx, |mw, _| mw.workspace().clone()),
+        beta,
+        "the thread's own workspace is activated"
+    );
+    assert_eq!(
+        active_thread(&sidebar, cx),
+        Some(in_beta),
+        "and the thread in it"
+    );
+    assert_eq!(
+        multi_workspace.read_with(cx, |mw, _| mw.workspaces().count()),
+        2,
+        "nothing is opened"
+    );
+    assert!(is_lists(&sidebar, cx), "R3.4: the Lists view stays shown");
+}
+
+// R3.2, R3.4 — a row whose project is open only in window B activates the thread there;
+// window A gains no workspace, keeps its active thread, and keeps the Lists view.
+#[gpui::test]
+async fn a_row_of_a_project_open_in_another_window_activates_that_window(cx: &mut TestAppContext) {
+    let mut w = two_windows(cx).await;
+    let in_alpha = save_in("a1", "Fix login", ALPHA, 2, &mut w.cx_a);
+    let in_beta = save_in("b1", "Ship release", BETA, 1, &mut w.cx_a);
+    let ops = create_list("Ops", &mut w.cx_a);
+    file_in(in_alpha, Some(ops), &mut w.cx_a);
+    file_in(in_beta, Some(ops), &mut w.cx_a);
+    open_lists_view(&w.sidebar_a, &mut w.cx_a);
+    click(row("Fix login", "alpha"), &mut w.cx_a);
+    assert_eq!(
+        active_thread(&w.sidebar_a, &mut w.cx_a),
+        Some(in_alpha),
+        "fixture: A's active thread"
+    );
+
+    click(row("Ship release", "beta"), &mut w.cx_a);
+    w.cx_b.run_until_parked();
+
+    assert!(
+        w.cx_a.read(|cx| cx.active_window()) == Some(*w.window_b),
+        "the window holding the project is activated"
+    );
+    assert_eq!(
+        active_thread(&w.sidebar_b, &mut w.cx_b),
+        Some(in_beta),
+        "the thread is activated in window B"
+    );
+    assert_eq!(
+        w.mw_a
+            .read_with(&mut w.cx_a, |mw, _| mw.workspaces().count()),
+        1,
+        "nothing is added to window A"
+    );
+    assert_eq!(
+        active_thread(&w.sidebar_a, &mut w.cx_a),
+        Some(in_alpha),
+        "window A keeps its active thread"
+    );
+    assert!(
+        is_lists(&w.sidebar_a, &mut w.cx_a),
+        "R3.4: A keeps the Lists view"
+    );
+}
+
+// R3.3, R3.4 — a row whose project is open in no window opens the project in this window and
+// activates the thread there.
+#[gpui::test]
+async fn a_row_of_a_project_open_nowhere_opens_it_here(cx: &mut TestAppContext) {
+    let (multi_workspace, sidebar, cx) = alpha_window(true, cx).await;
+    let elsewhere = save_in("d1", "Tune cache", DELTA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(elsewhere, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+    assert_eq!(
+        multi_workspace.read_with(cx, |mw, _| mw.workspaces().count()),
+        1,
+        "fixture: only alpha is open"
+    );
+
+    click(row("Tune cache", "delta"), cx);
+
+    assert_eq!(
+        multi_workspace.read_with(cx, |mw, _| mw.workspaces().count()),
+        2,
+        "the project is opened in this window"
+    );
+    let active_paths = multi_workspace.read_with(cx, |mw, cx| {
+        workspace_path_list(mw.workspace(), cx).paths().to_vec()
+    });
+    assert_eq!(active_paths, vec![PathBuf::from(DELTA)], "and made active");
+    assert_eq!(
+        active_thread(&sidebar, cx),
+        Some(elsewhere),
+        "with the thread active"
+    );
+    assert!(is_lists(&sidebar, cx), "R3.4: the Lists view stays shown");
+}
+
+// Task 4.2 — a thread deleted in another window disappears from this window's open Lists view,
+// and nothing is opened, activated or logged: there is no row left to click.
+#[gpui::test]
+async fn a_thread_deleted_in_another_window_leaves_the_view(cx: &mut TestAppContext) {
+    let mut w = two_windows(cx).await;
+    let gone = save_in("d1", "Tune cache", DELTA, 1, &mut w.cx_a);
+    let kept = save_in("a1", "Fix login", ALPHA, 2, &mut w.cx_a);
+    let ops = create_list("Ops", &mut w.cx_a);
+    file_in(gone, Some(ops), &mut w.cx_a);
+    file_in(kept, Some(ops), &mut w.cx_a);
+    open_lists_view(&w.sidebar_a, &mut w.cx_a);
+    assert!(
+        shown(row("Tune cache", "delta"), &mut w.cx_a),
+        "fixture: the row is shown in window A"
+    );
+    let active_before = w
+        .mw_a
+        .read_with(&mut w.cx_a, |mw, _| mw.workspace().clone());
+    capture_logs();
+
+    w.cx_b.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(gone, cx))
+    });
+    w.cx_b.run_until_parked();
+    w.cx_a.run_until_parked();
+
+    assert!(
+        !shown(row("Tune cache", "delta"), &mut w.cx_a),
+        "the deleted thread's row is gone without reopening the view"
+    );
+    assert_top_to_bottom(&[header("Ops", 1), row("Fix login", "alpha")], &mut w.cx_a);
+    assert_eq!(
+        w.mw_a
+            .read_with(&mut w.cx_a, |mw, _| mw.workspaces().count()),
+        1,
+        "the deleted thread's project is not opened"
+    );
+    assert_eq!(
+        w.mw_a
+            .read_with(&mut w.cx_a, |mw, _| mw.workspace().clone()),
+        active_before,
+        "nothing is activated"
+    );
+    assert!(
+        is_lists(&w.sidebar_a, &mut w.cx_a),
+        "the view does not change"
+    );
+    assert_eq!(warn_lines(), Vec::<String>::new(), "and nothing is logged");
+}
diff --git a/crates/sidebar/src/sidebar_lists_tests/render.rs b/crates/sidebar/src/sidebar_lists_tests/render.rs
new file mode 100644
index 0000000..b23f597
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests/render.rs
@@ -0,0 +1,233 @@
+// ═══ Task 4.1 — rows on screen ═════════════════════════════════════════════
+use super::*;
+use pretty_assertions::assert_eq;
+
+// R2.1, R2.2, R2.10 — one header per list in the STORE's order (moved after creation, so
+// neither creation order nor the alphabet gives it), each with its name and the count of the
+// threads shown; an archived member is not counted and not shown, but stays a member.
+#[gpui::test]
+async fn headers_follow_the_store_order_with_their_shown_counts(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 3, cx);
+    let docs = save_in("a2", "Write docs", ALPHA, 2, cx);
+    let old = save_in("a3", "Old spike", ALPHA, 1, cx);
+    // Creation order Ops, Zeta, Backlog; alphabetical Backlog, Ops, Zeta; store Zeta, Ops,
+    // Backlog — three different orders, so only the store's passes.
+    let ops = create_list("Ops", cx);
+    let zeta = create_list("Zeta", cx);
+    create_list("Backlog", cx);
+    move_list_in_store(zeta, 0, cx);
+    file_in(fix, Some(ops), cx);
+    file_in(old, Some(ops), cx);
+    file_in(docs, Some(zeta), cx);
+    archive(old, cx);
+    open_lists_view(&sidebar, cx);
+
+    assert!(
+        !shown(header("Ops", 2), cx),
+        "the archived member is not counted (Ops shows 1)"
+    );
+    assert_top_to_bottom(
+        &[
+            header("Zeta", 1),
+            row("Write docs", "alpha"),
+            header("Ops", 1),
+            row("Fix login", "alpha"),
+            header("Backlog", 0),
+        ],
+        cx,
+    );
+    assert!(!shown(row("Old spike", "alpha"), cx));
+    assert_eq!(
+        list_of(old, cx),
+        Some(ops),
+        "R2.10: hidden, the archived thread keeps its list"
+    );
+
+    unarchive(old, cx);
+    assert!(
+        shown(header("Ops", 2), cx) && shown(row("Old spike", "alpha"), cx),
+        "unarchived, it is back under its list"
+    );
+}
+
+// R2.2 — two threads with the SAME title in different projects are two rows, told apart by
+// their project names (a row keyed by title would collapse them into one).
+#[gpui::test]
+async fn same_titled_threads_of_two_projects_are_two_rows(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let in_alpha = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let in_beta = save_in("b1", "Fix login", BETA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(in_alpha, Some(ops), cx);
+    file_in(in_beta, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+
+    assert_top_to_bottom(
+        &[
+            header("Ops", 2),
+            row("Fix login", "alpha"),
+            row("Fix login", "beta"),
+        ],
+        cx,
+    );
+}
+
+// R2.5, R2.1 — a header click collapses its group in this window only (the header keeps its
+// count while collapsed), and a second click expands it. The other window, also in the Lists
+// view, keeps it expanded.
+#[gpui::test]
+async fn a_header_click_collapses_only_in_this_window(cx: &mut TestAppContext) {
+    let mut w = two_windows(cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, &mut w.cx_a);
+    let ops = create_list("Ops", &mut w.cx_a);
+    file_in(fix, Some(ops), &mut w.cx_a);
+    open_lists_view(&w.sidebar_a, &mut w.cx_a);
+    open_lists_view(&w.sidebar_b, &mut w.cx_b);
+    assert!(
+        shown(row("Fix login", "alpha"), &mut w.cx_a),
+        "fixture: A expanded"
+    );
+    assert!(
+        shown(row("Fix login", "alpha"), &mut w.cx_b),
+        "fixture: B expanded"
+    );
+
+    click(header("Ops", 1), &mut w.cx_a);
+    w.cx_b.run_until_parked();
+
+    assert!(
+        !shown(row("Fix login", "alpha"), &mut w.cx_a),
+        "A's group is collapsed"
+    );
+    assert!(
+        shown(header("Ops", 1), &mut w.cx_a),
+        "a collapsed list keeps its header and its count"
+    );
+    assert!(
+        shown(row("Fix login", "alpha"), &mut w.cx_b),
+        "B's group stays expanded"
+    );
+
+    click(header("Ops", 1), &mut w.cx_a);
+    assert!(
+        shown(row("Fix login", "alpha"), &mut w.cx_a),
+        "a second click expands it"
+    );
+}
+
+// R2.6 — "No threads" under an expanded list with nothing to show: a list with no member, AND
+// a list whose only member is archived (hidden) — the second must not be told apart from the
+// first by a stale member count.
+#[gpui::test]
+async fn no_threads_row_under_a_list_with_nothing_to_show(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let archived = save_in("a1", "Old spike", ALPHA, 1, cx);
+    let shown_one = save_in("a2", "Fix login", ALPHA, 2, cx);
+    let empty = create_list("Empty", cx);
+    let hidden_only = create_list("Hidden", cx);
+    let full = create_list("Full", cx);
+    file_in(archived, Some(hidden_only), cx);
+    file_in(shown_one, Some(full), cx);
+    archive(archived, cx);
+    let _ = empty;
+    open_lists_view(&sidebar, cx);
+
+    assert_top_to_bottom(&[header("Empty", 0), no_threads("Empty")], cx);
+    assert_top_to_bottom(&[header("Hidden", 0), no_threads("Hidden")], cx);
+    assert!(
+        !shown(no_threads("Full"), cx),
+        "a list with a thread to show has no \"No threads\" row"
+    );
+    assert_eq!(list_of(archived, cx), Some(hidden_only));
+}
+
+// R2.7, R2.11 — with no list, the empty state and its "New List" button; with one list, no empty
+// state, and the "New List" control still shown, above the lists.
+#[gpui::test]
+async fn the_empty_state_shows_only_when_no_list_exists(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    open_lists_view(&sidebar, cx);
+    assert!(shown(EMPTY_STATE, cx), "no list: the empty state");
+    assert!(shown(NEW_LIST, cx), "no list: a New List button");
+
+    create_list("Ops", cx);
+
+    assert!(!shown(EMPTY_STATE, cx), "one list: no empty state");
+    assert_top_to_bottom(&[NEW_LIST, header("Ops", 0)], cx);
+}
+
+// R2.8 — a list created and a thread filed in window B appear in window A's open Lists view
+// without it being reopened; a deletion in B disappears from A the same way.
+#[gpui::test]
+async fn changes_in_another_window_show_in_an_open_view(cx: &mut TestAppContext) {
+    let mut w = two_windows(cx).await;
+    let in_beta = save_in("b1", "Ship release", BETA, 1, &mut w.cx_b);
+    open_lists_view(&w.sidebar_a, &mut w.cx_a);
+    assert!(shown(EMPTY_STATE, &mut w.cx_a), "fixture: A shows no list");
+
+    let release = create_list("Release", &mut w.cx_b);
+    file_in(in_beta, Some(release), &mut w.cx_b);
+    w.cx_a.run_until_parked();
+
+    assert_top_to_bottom(
+        &[header("Release", 1), row("Ship release", "beta")],
+        &mut w.cx_a,
+    );
+    assert!(is_lists(&w.sidebar_a, &mut w.cx_a), "A was never reopened");
+
+    delete_list_in_store(release, &mut w.cx_b);
+    w.cx_a.run_until_parked();
+    assert!(header_count("Release", &mut w.cx_a).is_none());
+    assert!(shown(EMPTY_STATE, &mut w.cx_a));
+}
+
+// R2.9 — filing a thread keeps its row in its project group, and a pinned thread's row in the
+// Pinned section: the thread list does not change at all.
+#[gpui::test]
+async fn filing_a_thread_leaves_the_thread_list_unchanged(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let pinned = save_in("a2", "Tune cache", ALPHA, 1, cx);
+    pin(pinned, cx);
+    let before = visible_entries_as_strings(&sidebar, cx);
+
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    file_in(pinned, Some(ops), cx);
+
+    assert_eq!(visible_entries_as_strings(&sidebar, cx), before);
+}
+
+// R3.5 — a right-clicked row of the view offers the thread list's menu for THAT thread: its
+// entries, the Move to List submenu, and an entry acting on the right-clicked thread (the
+// second row, so a menu bound to the first row or to an index would pin the wrong one).
+#[gpui::test]
+async fn a_right_clicked_row_offers_the_thread_menu(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let first = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let second = save_in("a2", "Write docs", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(first, Some(ops), cx);
+    file_in(second, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+    assert_top_to_bottom(&[row("Fix login", "alpha"), row("Write docs", "alpha")], cx);
+
+    right_click(row("Write docs", "alpha"), cx);
+    for entry in [
+        "MENU_ITEM-Rename Title",
+        "MENU_ITEM-Pin Thread",
+        "MENU_ITEM-Archive Thread",
+    ] {
+        assert!(shown(entry, cx), "the thread menu offers `{entry}`");
+    }
+    click("MENU_ITEM-Pin Thread", cx);
+    assert!(is_pinned(second, cx), "the right-clicked thread is pinned");
+    assert!(!is_pinned(first, cx), "and no other");
+
+    right_click(row("Write docs", "alpha"), cx);
+    assert!(
+        open_move_to_list(cx),
+        "the thread menu offers the Move to List submenu"
+    );
+}
diff --git a/crates/sidebar/src/sidebar_lists_tests/rows.rs b/crates/sidebar/src/sidebar_lists_tests/rows.rs
new file mode 100644
index 0000000..b840458
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests/rows.rs
@@ -0,0 +1,359 @@
+// Task 2.1 — `build_list_rows`, the cx-free row model of the Lists view (R2.1–R2.4, R2.6, R2.10).
+// The function reads lists, members and metadata through its parameters only, so these tests
+// feed it plain maps. The lists themselves come from the real store: a `ListId` has no public
+// constructor, and the store's own list order is what R2.1 asks to be kept.
+
+use std::collections::{HashMap, HashSet};
+
+use agent_ui::ThreadId;
+use agent_ui::thread_metadata_store::{ThreadMetadata, ThreadMetadataStore, WorktreePaths};
+use agent_ui::thread_organization::{ListId, ThreadList, ThreadOrganizationStore};
+use chrono::{DateTime, TimeZone as _, Utc};
+use gpui::TestAppContext;
+use pretty_assertions::assert_eq;
+
+use super::init_lists_test;
+use crate::acp;
+use crate::lists_view::{ListsRow, build_list_rows};
+
+/// Creates `names` in this order in a fresh store and returns the store's lists.
+async fn lists_named(names: &[&str], cx: &mut TestAppContext) -> Vec<ThreadList> {
+    let _project = init_lists_test(true, cx).await;
+    let lists = cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            for name in names {
+                store
+                    .create_list(name, cx)
+                    .expect("fixture: a fresh, valid list name");
+            }
+            store.lists().to_vec()
+        })
+    });
+    cx.run_until_parked();
+    lists
+}
+
+fn at(hour: u32) -> DateTime<Utc> {
+    Utc.with_ymd_and_hms(2024, 1, 1, hour, 0, 0)
+        .single()
+        .expect("fixture: a valid hour")
+}
+
+/// A thread whose first message was sent; `interacted` is when the user last sent one.
+fn sent(updated: u32, interacted: Option<u32>) -> ThreadMetadata {
+    let thread_id = ThreadId::new();
+    ThreadMetadata {
+        thread_id,
+        session_id: Some(acp::SessionId::new(thread_id.to_key_string())),
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: None,
+        title_override: None,
+        updated_at: at(updated),
+        created_at: None,
+        interacted_at: interacted.map(at),
+        worktree_paths: WorktreePaths::default(),
+        remote_connection: None,
+        archived: false,
+    }
+}
+
+fn archived() -> ThreadMetadata {
+    ThreadMetadata {
+        archived: true,
+        ..sent(20, None)
+    }
+}
+
+/// A draft has no session yet; given the latest time so a sort that kept it would show it first.
+fn draft() -> ThreadMetadata {
+    ThreadMetadata {
+        session_id: None,
+        ..sent(23, Some(23))
+    }
+}
+
+/// What the stores would answer: each list's members, and the metadata of the known threads.
+#[derive(Default)]
+struct Members {
+    by_list: HashMap<ListId, Vec<ThreadId>>,
+    metadata: HashMap<ThreadId, ThreadMetadata>,
+}
+
+impl Members {
+    fn file(&mut self, list: &ThreadList, metadata: ThreadMetadata) -> ThreadId {
+        let thread_id = metadata.thread_id;
+        self.by_list.entry(list.id).or_default().push(thread_id);
+        self.metadata.insert(thread_id, metadata);
+        thread_id
+    }
+
+    /// A member the metadata store does not know.
+    fn file_unknown(&mut self, list: &ThreadList) -> ThreadId {
+        let thread_id = ThreadId::new();
+        self.by_list.entry(list.id).or_default().push(thread_id);
+        thread_id
+    }
+
+    fn rows(&self, lists: &[ThreadList], collapsed: &HashSet<ListId>) -> Vec<ListsRow> {
+        build_list_rows(
+            lists,
+            |list| self.by_list.get(&list).cloned().unwrap_or_default(),
+            |thread_id| self.metadata.get(&thread_id),
+            collapsed,
+        )
+    }
+}
+
+fn header(list: &ThreadList, shown: usize, collapsed: bool) -> ListsRow {
+    ListsRow::Header {
+        list_id: list.id,
+        name: list.name.clone(),
+        shown,
+        collapsed,
+    }
+}
+
+fn thread(list: &ThreadList, thread_id: ThreadId) -> ListsRow {
+    ListsRow::Thread {
+        list_id: list.id,
+        thread_id,
+    }
+}
+
+fn empty(list: &ThreadList) -> ListsRow {
+    ListsRow::Empty { list_id: list.id }
+}
+
+fn collapsed(lists: &[&ThreadList]) -> HashSet<ListId> {
+    lists.iter().map(|list| list.id).collect()
+}
+
+#[gpui::test]
+async fn lists_come_in_store_order(cx: &mut TestAppContext) {
+    let created = lists_named(&["Ops", "Docs", "Zed"], cx).await;
+    // Moved first, so the store order differs from creation (and id) order.
+    let lists = cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .move_list(created[2].id, 0, cx)
+                .expect("fixture: the list exists");
+            store.lists().to_vec()
+        })
+    });
+    cx.run_until_parked();
+    let [zed, ops, docs] = &lists[..] else {
+        panic!("fixture: three lists, got {lists:?}");
+    };
+    assert_eq!(zed.name.as_ref(), "Zed");
+
+    let rows = Members::default().rows(&lists, &HashSet::default());
+
+    assert_eq!(
+        rows,
+        vec![
+            header(zed, 0, false),
+            empty(zed),
+            header(ops, 0, false),
+            empty(ops),
+            header(docs, 0, false),
+            empty(docs),
+        ]
+    );
+}
+
+#[gpui::test]
+async fn shown_counts_visible_members_collapsed_or_expanded(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops"], cx).await;
+    let ops = &lists[0];
+    let mut members = Members::default();
+    let newer = members.file(ops, sent(10, None));
+    let older = members.file(ops, sent(9, None));
+    members.file(ops, archived());
+    members.file(ops, draft());
+    members.file_unknown(ops);
+
+    assert_eq!(
+        members.rows(&lists, &HashSet::default()),
+        vec![
+            header(ops, 2, false),
+            thread(ops, newer),
+            thread(ops, older),
+        ]
+    );
+    assert_eq!(
+        members.rows(&lists, &collapsed(&[ops])),
+        vec![header(ops, 2, true)]
+    );
+}
+
+#[gpui::test]
+async fn archived_draft_and_unknown_members_are_hidden(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops"], cx).await;
+    let ops = &lists[0];
+    let mut members = Members::default();
+    members.file_unknown(ops);
+    members.file(ops, draft());
+    let visible = members.file(ops, sent(8, None));
+    members.file(ops, archived());
+
+    assert_eq!(
+        members.rows(&lists, &HashSet::default()),
+        vec![header(ops, 1, false), thread(ops, visible)]
+    );
+}
+
+/// Read through the real stores, as the sidebar will: hiding an archived member is a read.
+#[gpui::test]
+async fn a_hidden_member_keeps_its_membership(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops"], cx).await;
+    let ops = lists[0].clone();
+    let metadata = sent(10, None);
+    let thread_id = metadata.thread_id;
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_list(thread_id, Some(ops.id), cx)
+                .expect("fixture: a sent thread is admitted")
+        })
+    });
+    cx.run_until_parked();
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(thread_id, None, cx))
+    });
+    cx.run_until_parked();
+
+    let (rows, still_filed) = cx.update(|cx| {
+        let organization = ThreadOrganizationStore::global(cx).read(cx);
+        let metadata = ThreadMetadataStore::global(cx).read(cx);
+        let rows = build_list_rows(
+            organization.lists(),
+            |list| organization.threads_in_list(list),
+            |thread_id| metadata.entry(thread_id),
+            &HashSet::default(),
+        );
+        (rows, organization.threads_in_list(ops.id))
+    });
+
+    assert_eq!(rows, vec![header(&ops, 0, false), empty(&ops)]);
+    assert_eq!(still_filed, vec![thread_id]);
+}
+
+#[gpui::test]
+async fn most_recent_activity_first_with_a_stable_tie(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops"], cx).await;
+    let ops = &lists[0];
+    let mut members = Members::default();
+    // Recent mode sorts by the last message the user sent, else by the last update: a thread
+    // updated last but written to long ago sorts by the older time.
+    let updated_last = members.file(ops, sent(13, Some(8)));
+    let tie_one = members.file(ops, sent(9, None));
+    let interacted_last = members.file(ops, sent(10, Some(12)));
+    let tie_two = members.file(ops, sent(9, None));
+    let updated_second = members.file(ops, sent(11, None));
+    let mut ties = [tie_one, tie_two];
+    ties.sort_by_key(|thread_id| thread_id.to_key_string());
+    let expected = vec![
+        header(ops, 5, false),
+        thread(ops, interacted_last),
+        thread(ops, updated_second),
+        thread(ops, ties[0]),
+        thread(ops, ties[1]),
+        thread(ops, updated_last),
+    ];
+
+    assert_eq!(members.rows(&lists, &HashSet::default()), expected);
+    // The same members handed over in the opposite order: the tie must not follow the input.
+    for member_ids in members.by_list.values_mut() {
+        member_ids.reverse();
+    }
+    assert_eq!(members.rows(&lists, &HashSet::default()), expected);
+}
+
+#[gpui::test]
+async fn a_collapsed_list_yields_its_header_only(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops", "Void", "Docs"], cx).await;
+    let [ops, void, docs] = &lists[..] else {
+        panic!("fixture: three lists, got {lists:?}");
+    };
+    let mut members = Members::default();
+    members.file(ops, sent(10, None));
+    members.file(ops, sent(11, None));
+    let doc = members.file(docs, sent(12, None));
+
+    assert_eq!(
+        members.rows(&lists, &collapsed(&[ops, void])),
+        vec![
+            header(ops, 2, true),
+            header(void, 0, true),
+            header(docs, 1, false),
+            thread(docs, doc),
+        ]
+    );
+}
+
+#[gpui::test]
+async fn an_expanded_list_with_nothing_to_show_yields_empty(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Void", "Shelf"], cx).await;
+    let [void, shelf] = &lists[..] else {
+        panic!("fixture: two lists, got {lists:?}");
+    };
+    let mut members = Members::default();
+    // Only hidden members: the same "No threads" as a list with none at all.
+    members.file(shelf, archived());
+    members.file(shelf, draft());
+
+    assert_eq!(
+        members.rows(&lists, &HashSet::default()),
+        vec![
+            header(void, 0, false),
+            empty(void),
+            header(shelf, 0, false),
+            empty(shelf),
+        ]
+    );
+}
+
+#[gpui::test]
+async fn lists_with_the_same_count_stay_distinct_by_id(cx: &mut TestAppContext) {
+    let lists = lists_named(&["Ops", "Docs"], cx).await;
+    let [ops, docs] = &lists[..] else {
+        panic!("fixture: two lists, got {lists:?}");
+    };
+    let mut members = Members::default();
+    let in_ops = members.file(ops, sent(10, None));
+    let in_docs = members.file(docs, sent(10, None));
+
+    assert_eq!(
+        members.rows(&lists, &HashSet::default()),
+        vec![
+            header(ops, 1, false),
+            thread(ops, in_ops),
+            header(docs, 1, false),
+            thread(docs, in_docs),
+        ]
+    );
+    // Collapsing one list by id leaves the other, of equal count, expanded.
+    assert_eq!(
+        members.rows(&lists, &collapsed(&[docs])),
+        vec![
+            header(ops, 1, false),
+            thread(ops, in_ops),
+            header(docs, 1, true),
+        ]
+    );
+}
+
+#[test]
+fn no_lists_yields_no_rows() {
+    let rows = build_list_rows(
+        &[],
+        |_| vec![ThreadId::new()],
+        |_| None::<&ThreadMetadata>,
+        &HashSet::default(),
+    );
+    assert_eq!(rows, Vec::<ListsRow>::new());
+}
