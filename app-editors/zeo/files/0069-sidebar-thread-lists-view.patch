diff --git a/crates/sidebar/src/sidebar_lists_tests.rs b/crates/sidebar/src/sidebar_lists_tests.rs
new file mode 100644
index 0000000..142413d
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests.rs
@@ -0,0 +1,291 @@
+// Story 038 — the Lists view of the agent sidebar (tasks 3.1, 4.1, 4.2, 5.1, 6.1). This file is
+// the parent module; its children live in `sidebar_lists_tests/`, one file per task (the 500-line
+// rule; Zed's `.rules` forbid `mod.rs` paths), as tasks.md names them:
+//   view          task 3.1  SidebarView::Lists, the footer button, ToggleThreadLists, the saved state
+//   render        task 4.1  headers, rows, collapse, "No threads", the empty state, other windows
+//   open          task 4.2  render_thread's own click opens a Lists row where it lives; the view
+//                           stays; a thread deleted elsewhere leaves the view
+//   move_to_list  task 5.1  the "Move to List" submenu and Sidebar::move_thread_to_list
+//   manage        task 6.1  the name field, the header menu, their refusals, the restart
+// Shared setup lives here, the store and view helpers in `support.rs`. Task 2.1's unit tests
+// (`mod rows`, ListsRow / build_list_rows) are the Executor's: they go in `rows.rs` at run time,
+// declared at the `mod rows;` line below, and are not authored here.
+//
+// Materialize as `crates/sidebar/src/sidebar_lists_tests.rs` (this file) plus the directory
+// `crates/sidebar/src/sidebar_lists_tests/` (`support.rs`, `view.rs`, `render.rs`, `open.rs`,
+// `move_to_list.rs`, `manage.rs`, and the Executor's `rows.rs`), wired in `sidebar.rs` beside
+// `mod sidebar_pinned_tests;`:
+//     #[cfg(test)]
+//     mod sidebar_lists_tests;
+// FILTER: the test paths are `sidebar_lists_tests::<module>::<test>`. Run
+// `cargo test -p sidebar sidebar_lists_tests::<module>` and check the count it reports is not 0
+// (a filter such as `lists::view` matches no test and passes vacuously).
+//
+// The store is installed with `agent_ui::thread_organization::init(cx)` BEFORE the sidebar is
+// created (the sidebar observes it from `Sidebar::new`); `init_test` gives every test its own
+// database, so lists never leak between tests.
+//
+// WHAT THE TESTS NEED FROM THE CODE. tasks.md names the API (SidebarView::Lists,
+// SerializedSidebarView::Lists, ToggleThreadLists, Sidebar::move_thread_to_list) but no way to READ the view, which GPUI tests can only do through
+// debug selectors (`cx.debug_bounds`). The view is therefore read through this selector contract;
+// each one sits on the element a user clicks or reads:
+//   ICON-ListTree                     the footer button. IconButton records `ICON-{IconName:?}`
+//                                     by itself; if another list icon is chosen, change
+//                                     LISTS_BUTTON below and nothing else
+//   LISTS_HEADER-{name} ({shown})     a list's group header (click: collapse/expand; right-click:
+//                                     the header menu). {shown} is the thread count R2.1 shows
+//   LISTS_ROW-{title} · {project}     the element wrapping a thread row of the view. The row is
+//                                     built by `build_pinned_rows` and drawn by `render_thread`,
+//                                     whose own click opens it and whose context menu it carries.
+//                                     {project} is the row's project label
+//   LISTS_NO_THREADS-{name}           the "No threads" row under an expanded list with none (R2.6)
+//   LISTS_EMPTY_STATE                 the empty state shown when no list exists (R2.7)
+//   LISTS_NEW_LIST                    the control that opens the "New List" field: R2.7's button
+//                                     in the empty state, and R2.11's control above the lists
+//   LISTS_NAME_FIELD                  the open name field (New List, New List…, Rename List…)
+//   LISTS_NAME_MESSAGE-{text}         a refusal shown under the field (R5.2, R5.3)
+// Menu entries are read through ContextMenu's own `MENU_ITEM-{label}` selectors.
+//
+// The name field must take focus when it opens (it is typed into). Keys are dispatched as the
+// default keymap maps them in a single-line editor: Enter = `menu::Confirm` (the root binding;
+// "Editor && mode == full" is the only Newline binding), Escape = `editor::actions::Cancel`.
+//
+// `Sidebar::move_thread_to_list`, defined in `lists_view.rs`'s `impl Sidebar` and called here
+// directly, must be `pub(crate)`: a private method of a child module is invisible to this sibling.
+// Rows are opened only by a real click on them (no method of their own). `capture_logs` and `warn_lines` are
+// imported from `sidebar_pinned_tests.rs` (already `pub(super)`): a second logger would panic.
+//
+// The "Move to List" submenu is opened from the keyboard: the submenu trigger has no selector, so
+// `open_move_to_list` walks the open menu (SelectNext, SelectChild) until the submenu's
+// "New List…" entry appears, and steps back out (SelectParent) of any other submenu it enters.
+//
+// Hostile halves come first in every identity rule:
+//   - a thread filed in another list is in exactly one list: shown under the new one AND gone
+//     from the former (not zero, not two);
+//   - choosing the CURRENT list keeps the thread there (a toggle-style entry must not un-file it);
+//   - two threads with the same title in different projects are two distinguishable rows;
+//   - an archived member is hidden AND keeps its membership; a list whose only member is
+//     archived counts 0 and shows "No threads", like a truly empty one;
+//   - names: "  OPS  " and "ops" are the SAME list name (refused), "Équipe"/"ÉQUIPE" too (a fold
+//     that is ASCII-only would accept it); "Ops2" is a DIFFERENT name (accepted); a list renamed to
+//     its own name in another case is not a duplicate of itself; 64 characters are accepted and 65
+//     refused, counted in characters (64 × "é" is 128 bytes and must be accepted);
+//   - deleting one list clears its members only, never another list's;
+//   - Move Up/Down moves ONE place, not to the end;
+//   - History from Lists goes to History (not back to the thread list), and a saved History —
+//     including the legacy "Archive" spelling — restores History, never Lists;
+//   - refusal warnings carry the id and never a title or a list name.
+//
+// Known gaps, reported rather than faked:
+//   - R1.2 "the button shown as toggled on" and R4.1 "the thread's current list marked" are render
+//     state with no observable trace outside the `ui` crate (no selector carries a toggle). The
+//     marked entry's BEHAVIOUR is asserted instead (choosing it changes nothing, R4.3).
+//   - (resolved in v2) R2.1's count on a COLLAPSED header is the expanded count: asserted in
+//     render::a_header_click_collapses_only_in_this_window.
+//   - R2.2 with two projects sharing a folder name ("/work/app", "/home/app"): the story does not
+//     say whether the row label is disambiguated, as the Pinned section's is. Not asserted.
+//   - R2.4 drafts and unknown ids cannot be produced as list members through the store (it refuses
+//     a draft, and deleting a thread forgets its organization): task 2.1's unit tests own them.
+//   - Q12 keyboard navigation between rows is Out of Scope; R4.3 "log nothing" is checked at WARN.
+
+use super::*;
+use crate::sidebar_pinned_tests::{capture_logs, warn_lines};
+use crate::sidebar_tests::{
+    focus_sidebar, init_test, init_test_project_with_agent_panel,
+    save_thread_metadata_with_main_paths, setup_sidebar, setup_sidebar_with_agent_panel,
+    visible_entries_as_strings,
+};
+use agent_ui::thread_organization::{ListId, ThreadOrganizationStore};
+use fs::FakeFs;
+use gpui::{Bounds, MouseButton, TestAppContext, VisualTestContext};
+
+const ALPHA: &str = "/alpha";
+const BETA: &str = "/beta";
+const GAMMA: &str = "/gamma";
+/// Opened in no window unless a test opens it on purpose.
+const DELTA: &str = "/delta";
+
+const LISTS_BUTTON: &str = "ICON-ListTree";
+const HISTORY_BUTTON: &str = "ICON-Clock";
+const EMPTY_STATE: &str = "LISTS_EMPTY_STATE";
+const NEW_LIST: &str = "LISTS_NEW_LIST";
+const NAME_FIELD: &str = "LISTS_NAME_FIELD";
+const LENGTH_MESSAGE: &str = "A list name must be 1 to 64 characters";
+const DUPLICATE_MESSAGE: &str = "A list with this name already exists";
+
+const NEW_LIST_ENTRY: &str = "MENU_ITEM-New List…";
+const REMOVE_ENTRY: &str = "MENU_ITEM-Remove from List";
+const RENAME_LIST_ENTRY: &str = "MENU_ITEM-Rename List…";
+const DELETE_LIST_ENTRY: &str = "MENU_ITEM-Delete List";
+const MOVE_UP_ENTRY: &str = "MENU_ITEM-Move Up";
+const MOVE_DOWN_ENTRY: &str = "MENU_ITEM-Move Down";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// Sidebar test globals, a FakeFs with every project folder and, when `with_store`, the
+/// organization store. Returns a project for `ALPHA`.
+async fn init_lists_test(with_store: bool, cx: &mut TestAppContext) -> Entity<project::Project> {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    for path in [ALPHA, BETA, GAMMA, DELTA] {
+        fs.insert_tree(path, serde_json::json!({ "src": {} })).await;
+    }
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        if with_store {
+            agent_ui::thread_organization::init(cx);
+        }
+    });
+    cx.run_until_parked();
+    project::Project::test(fs, [ALPHA.as_ref()], cx).await
+}
+
+/// A window on `ALPHA` with its sidebar open; the store installed when `with_store`.
+async fn alpha_window(
+    with_store: bool,
+    cx: &mut TestAppContext,
+) -> (
+    Entity<MultiWorkspace>,
+    Entity<Sidebar>,
+    &mut VisualTestContext,
+) {
+    let project = init_lists_test(with_store, cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+    (multi_workspace, sidebar, cx)
+}
+
+/// A window on `ALPHA` with an agent panel (History needs one) and the store.
+async fn alpha_window_with_panel(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<MultiWorkspace>,
+    Entity<Sidebar>,
+    &mut VisualTestContext,
+) {
+    let project = init_test_project_with_agent_panel(ALPHA, cx).await;
+    cx.update(|cx| agent_ui::thread_organization::init(cx));
+    cx.run_until_parked();
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let (sidebar, _panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    cx.update(|_window, cx| AgentRegistryStore::init_test_global(cx, vec![]));
+    cx.run_until_parked();
+    (multi_workspace, sidebar, cx)
+}
+
+/// Window A on `ALPHA` and window B on `BETA`, each with its sidebar open, sharing the store.
+struct TwoWindows {
+    window_b: WindowHandle<MultiWorkspace>,
+    mw_a: Entity<MultiWorkspace>,
+    sidebar_a: Entity<Sidebar>,
+    sidebar_b: Entity<Sidebar>,
+    cx_a: VisualTestContext,
+    cx_b: VisualTestContext,
+}
+
+async fn two_windows(cx: &mut TestAppContext) -> TwoWindows {
+    let project_a = init_lists_test(true, cx).await;
+    let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+    let project_b = project::Project::test(fs, [BETA.as_ref()], cx).await;
+    let window_a = cx.add_window(|window, cx| MultiWorkspace::test_new(project_a, window, cx));
+    let window_b = cx.add_window(|window, cx| MultiWorkspace::test_new(project_b, window, cx));
+    let mw_a = window_a.root(cx).expect("window A has a root");
+    let mw_b = window_b.root(cx).expect("window B has a root");
+    let mut cx_b = VisualTestContext::from_window(window_b.into(), cx);
+    let sidebar_b = setup_sidebar(&mw_b, &mut cx_b);
+    let mut cx_a = VisualTestContext::from_window(window_a.into(), cx);
+    let sidebar_a = setup_sidebar(&mw_a, &mut cx_a);
+    TwoWindows {
+        window_b,
+        mw_a,
+        sidebar_a,
+        sidebar_b,
+        cx_a,
+        cx_b,
+    }
+}
+
+/// Opens `path` as another project group of this window.
+async fn open_in_window(
+    path: &str,
+    multi_workspace: &Entity<MultiWorkspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<Workspace> {
+    let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    let project = project::Project::test(fs, [path.as_ref()], cx).await;
+    let workspace = multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.test_add_workspace(project, window, cx)
+    });
+    cx.run_until_parked();
+    workspace
+}
+
+/// Saves a thread with a sent message in the local project `folder`; a later `hour` is more recent.
+fn save_in(
+    session: &str,
+    title: &str,
+    folder: &str,
+    hour: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        PathList::new(&[PathBuf::from(folder)]),
+        PathList::new(&[PathBuf::from(folder)]),
+        chrono::TimeZone::with_ymd_and_hms(&Utc, 2024, 1, 1, hour, 0, 0)
+            .single()
+            .expect("fixture: a valid hour"),
+        cx,
+    );
+    let session_id = acp::SessionId::new(Arc::from(session));
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|entry| entry.session_id.as_ref() == Some(&session_id))
+            .map(|entry| entry.thread_id)
+            .expect("fixture: the thread was saved")
+    })
+}
+
+fn archive(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(thread_id, None, cx))
+    });
+    cx.run_until_parked();
+}
+
+fn unarchive(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.unarchive(thread_id, cx))
+    });
+    cx.run_until_parked();
+}
+
