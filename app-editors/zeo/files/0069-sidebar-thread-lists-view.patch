index 0000000..08ceef0
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests/manage.rs
@@ -0,0 +1,482 @@
+// ═══ Task 6.1 — managing lists ═════════════════════════════════════════════
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn open_header_menu(name: &str, cx: &mut VisualTestContext) {
+    let count = header_count(name, cx).unwrap_or_else(|| panic!("`{name}` has a header"));
+    right_click(header(name, count), cx);
+}
+
+fn open_new_list_field(cx: &mut VisualTestContext) {
+    click(NEW_LIST, cx);
+    assert!(shown(NAME_FIELD, cx), "fixture: the name field is open");
+}
+
+fn rename_field_for(name: &str, cx: &mut VisualTestContext) {
+    open_header_menu(name, cx);
+    click(RENAME_LIST_ENTRY, cx);
+    assert!(shown(NAME_FIELD, cx), "fixture: the rename field is open");
+}
+
+// R5.1, R2.7 — the empty state's New List creates the first list; with lists present, New
+// List creates after the existing ones and closes the field.
+#[gpui::test]
+async fn new_list_creates_after_the_existing_ones(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    open_lists_view(&sidebar, cx);
+    assert!(shown(EMPTY_STATE, cx), "fixture: no list yet");
+    open_new_list_field(cx);
+    type_name("Ops", cx);
+    press_enter(cx);
+    assert_eq!(
+        list_names(cx),
+        vec!["Ops"],
+        "the empty state created the first list"
+    );
+
+    create_list("Docs", cx);
+    open_new_list_field(cx);
+    type_name("Backlog", cx);
+    press_enter(cx);
+
+    assert_eq!(list_names(cx), vec!["Ops", "Docs", "Backlog"]);
+    assert!(!shown(NAME_FIELD, cx), "the field closes on success");
+    assert_top_to_bottom(
+        &[header("Ops", 0), header("Docs", 0), header("Backlog", 0)],
+        cx,
+    );
+}
+
+// R5.2 — empty, whitespace-only and 65-character names keep the field open with the length
+// message and create nothing, unlogged. The converse first-class: 64 characters are accepted,
+// counted in characters (64 × "é" is 128 bytes).
+#[gpui::test]
+async fn names_outside_one_to_sixty_four_characters_are_refused(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    open_lists_view(&sidebar, cx);
+    capture_logs();
+
+    let too_long = "x".repeat(65);
+    for refused in ["", "   ", too_long.as_str()] {
+        open_new_list_field(cx);
+        type_name(refused, cx);
+        press_enter(cx);
+        assert!(shown(NAME_FIELD, cx), "{refused:?}: the field stays open");
+        assert!(
+            shown(message(LENGTH_MESSAGE), cx),
+            "{refused:?}: the length message is shown"
+        );
+        assert_eq!(
+            list_names(cx),
+            Vec::<String>::new(),
+            "{refused:?}: nothing created"
+        );
+        press_escape(cx);
+    }
+    assert_eq!(
+        warn_lines(),
+        Vec::<String>::new(),
+        "a name refusal is not logged"
+    );
+
+    let ascii = "x".repeat(64);
+    let accented = "é".repeat(64);
+    for accepted in [&ascii, &accented] {
+        open_new_list_field(cx);
+        type_name(accepted, cx);
+        press_enter(cx);
+        assert!(!shown(NAME_FIELD, cx), "64 characters are accepted");
+    }
+    assert_eq!(list_names(cx), vec![ascii, accented]);
+}
+
+// R5.3 — a name equal to another list's ignoring case (and surrounding spaces, and non-ASCII
+// case) is refused with the duplicate message; a near-identical but DIFFERENT name is not.
+#[gpui::test]
+async fn duplicate_names_are_refused_and_near_names_are_not(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Ops", cx);
+    create_list("Équipe", cx);
+    open_lists_view(&sidebar, cx);
+    capture_logs();
+
+    for same in ["OPS", "  ops  ", "ÉQUIPE"] {
+        open_new_list_field(cx);
+        type_name(same, cx);
+        press_enter(cx);
+        assert!(shown(NAME_FIELD, cx), "{same:?}: the field stays open");
+        assert!(
+            shown(message(DUPLICATE_MESSAGE), cx),
+            "{same:?}: the duplicate message is shown"
+        );
+        press_escape(cx);
+    }
+    assert_eq!(list_names(cx), vec!["Ops", "Équipe"], "nothing was created");
+    assert_eq!(
+        warn_lines(),
+        Vec::<String>::new(),
+        "a name refusal is not logged"
+    );
+
+    open_new_list_field(cx);
+    type_name("Ops2", cx);
+    press_enter(cx);
+    assert_eq!(
+        list_names(cx),
+        vec!["Ops", "Équipe", "Ops2"],
+        "a different name is accepted"
+    );
+}
+
+// R5.3, R5.4 — renaming a list to ANOTHER list's name in a different case is refused and
+// renames nothing; renaming a list to its OWN name in a different case is not a duplicate of
+// itself and is accepted.
+#[gpui::test]
+async fn rename_refuses_another_lists_name_but_not_its_own(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Ops", cx);
+    create_list("Docs", cx);
+    open_lists_view(&sidebar, cx);
+
+    rename_field_for("Docs", cx);
+    type_name("OPS", cx);
+    press_enter(cx);
+    assert!(
+        shown(message(DUPLICATE_MESSAGE), cx),
+        "another list's name is refused"
+    );
+    assert_eq!(list_names(cx), vec!["Ops", "Docs"], "nothing renamed");
+    press_escape(cx);
+
+    rename_field_for("Docs", cx);
+    type_name("DOCS", cx);
+    press_enter(cx);
+    assert!(
+        !shown(NAME_FIELD, cx),
+        "its own name in another case is accepted"
+    );
+    assert!(!shown(message(DUPLICATE_MESSAGE), cx));
+    assert_eq!(list_names(cx).len(), 2);
+}
+
+// R5.4 — a renamed list shows under its new name at the same position.
+#[gpui::test]
+async fn rename_keeps_the_position(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Ops", cx);
+    let middle = create_list("Docs", cx);
+    create_list("Backlog", cx);
+    open_lists_view(&sidebar, cx);
+
+    rename_field_for("Docs", cx);
+    type_name("Manuals", cx);
+    press_enter(cx);
+
+    assert_eq!(list_names(cx), vec!["Ops", "Manuals", "Backlog"]);
+    assert_eq!(list_ids(cx)[1], middle, "the same list, renamed in place");
+    assert_top_to_bottom(
+        &[header("Ops", 0), header("Manuals", 0), header("Backlog", 0)],
+        cx,
+    );
+}
+
+// R5.5 — "Delete List" removes the list and leaves each of ITS threads in no list with its pin
+// and tags intact and its rows in the thread list unchanged; another list's members stay.
+#[gpui::test]
+async fn delete_clears_only_its_members_and_keeps_their_other_properties(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 3, cx);
+    let pinned = save_in("a2", "Tune cache", ALPHA, 2, cx);
+    let other = save_in("a3", "Write docs", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    let docs = create_list("Docs", cx);
+    file_in(fix, Some(ops), cx);
+    file_in(pinned, Some(ops), cx);
+    file_in(other, Some(docs), cx);
+    pin(pinned, cx);
+    tag(fix, "infra", cx);
+    let thread_list = visible_entries_as_strings(&sidebar, cx);
+    open_lists_view(&sidebar, cx);
+
+    open_header_menu("Ops", cx);
+    click(DELETE_LIST_ENTRY, cx);
+
+    assert_eq!(list_names(cx), vec!["Docs"], "the list is gone");
+    assert_eq!(list_of(fix, cx), None, "its members are in no list");
+    assert_eq!(list_of(pinned, cx), None);
+    assert_eq!(
+        list_of(other, cx),
+        Some(docs),
+        "another list's member stays"
+    );
+    assert!(is_pinned(pinned, cx), "the pin is kept");
+    assert_eq!(tag_keys(fix, cx), vec!["infra"], "the tags are kept");
+    click_lists_button(cx);
+    assert_eq!(
+        visible_entries_as_strings(&sidebar, cx),
+        thread_list,
+        "every row is where it was in the thread list"
+    );
+}
+
+// R5.6 — Move Down and Move Up move a list ONE place (not to the end), and a second window's
+// open Lists view shows the new order.
+#[gpui::test]
+async fn move_up_and_down_move_one_place_in_every_window(cx: &mut TestAppContext) {
+    let mut w = two_windows(cx).await;
+    create_list("Ops", &mut w.cx_a);
+    create_list("Docs", &mut w.cx_a);
+    create_list("Backlog", &mut w.cx_a);
+    create_list("Ideas", &mut w.cx_a);
+    open_lists_view(&w.sidebar_a, &mut w.cx_a);
+    open_lists_view(&w.sidebar_b, &mut w.cx_b);
+
+    open_header_menu("Ops", &mut w.cx_a);
+    click(MOVE_DOWN_ENTRY, &mut w.cx_a);
+    assert_eq!(
+        list_names(&mut w.cx_a),
+        vec!["Docs", "Ops", "Backlog", "Ideas"]
+    );
+
+    open_header_menu("Ideas", &mut w.cx_a);
+    click(MOVE_UP_ENTRY, &mut w.cx_a);
+    assert_eq!(
+        list_names(&mut w.cx_a),
+        vec!["Docs", "Ops", "Ideas", "Backlog"]
+    );
+
+    w.cx_b.run_until_parked();
+    assert_top_to_bottom(
+        &[
+            header("Docs", 0),
+            header("Ops", 0),
+            header("Ideas", 0),
+            header("Backlog", 0),
+        ],
+        &mut w.cx_b,
+    );
+}
+
+// R5.7 — no Move Up on the first list, no Move Down on the last; a middle list has both and a
+// single list (first AND last) has neither.
+#[gpui::test]
+async fn move_entries_are_absent_at_the_ends(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let only = create_list("Only", cx);
+    open_lists_view(&sidebar, cx);
+
+    open_header_menu("Only", cx);
+    assert!(
+        shown(DELETE_LIST_ENTRY, cx),
+        "fixture: the header menu is open"
+    );
+    assert!(
+        !shown(MOVE_UP_ENTRY, cx) && !shown(MOVE_DOWN_ENTRY, cx),
+        "single: neither"
+    );
+    cx.dispatch_action(Cancel);
+    cx.run_until_parked();
+    delete_list_in_store(only, cx);
+
+    create_list("First", cx);
+    create_list("Middle", cx);
+    create_list("Last", cx);
+    for (name, up, down) in [
+        ("First", false, true),
+        ("Middle", true, true),
+        ("Last", true, false),
+    ] {
+        open_header_menu(name, cx);
+        assert!(
+            shown(DELETE_LIST_ENTRY, cx),
+            "fixture: {name}'s menu is open"
+        );
+        assert_eq!(
+            shown(MOVE_UP_ENTRY, cx),
+            up,
+            "{name}: Move Up offered = {up}"
+        );
+        assert_eq!(
+            shown(MOVE_DOWN_ENTRY, cx),
+            down,
+            "{name}: Move Down offered = {down}"
+        );
+        cx.dispatch_action(Cancel);
+        cx.run_until_parked();
+    }
+}
+
+// R5.8, R4.6 — Escape closes a name field and changes nothing: a New List field creates
+// nothing, a Rename field renames nothing, and a "New List…" field opened from a thread
+// leaves that thread in its list.
+#[gpui::test]
+async fn escape_closes_the_field_and_changes_nothing(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+
+    open_new_list_field(cx);
+    type_name("Never", cx);
+    press_escape(cx);
+    assert!(!shown(NAME_FIELD, cx), "New List: closed");
+
+    rename_field_for("Ops", cx);
+    type_name("Renamed", cx);
+    press_escape(cx);
+    assert!(!shown(NAME_FIELD, cx), "Rename: closed");
+
+    click_lists_button(cx);
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(open_move_to_list(cx));
+    click(NEW_LIST_ENTRY, cx);
+    type_name("Also never", cx);
+    press_escape(cx);
+    assert!(!shown(NAME_FIELD, cx), "New List…: closed");
+
+    assert_eq!(list_names(cx), vec!["Ops"], "no list created or renamed");
+    assert_eq!(list_of(fix, cx), Some(ops), "the thread keeps its list");
+}
+
+// R4.9 — a valid name confirmed in the field opened by "New List…" creates the list after the
+// existing ones and records the thread in it (leaving its former list). A duplicate name there
+// is refused like anywhere else and files nothing.
+#[gpui::test]
+async fn new_list_from_a_thread_creates_the_list_and_files_the_thread(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+
+    right_click_group_row(&sidebar, fix, cx);
+    assert!(open_move_to_list(cx));
+    click(NEW_LIST_ENTRY, cx);
+    type_name("ops", cx);
+    press_enter(cx);
+    assert!(
+        shown(message(DUPLICATE_MESSAGE), cx),
+        "a duplicate is refused here too"
+    );
+    assert_eq!(list_of(fix, cx), Some(ops), "and the thread is not moved");
+
+    type_name("Urgent", cx);
+    press_enter(cx);
+
+    assert_eq!(
+        list_names(cx),
+        vec!["Ops", "Urgent"],
+        "created after the existing ones"
+    );
+    let urgent = list_ids(cx)[1];
+    assert_eq!(list_of(fix, cx), Some(urgent), "the thread is filed in it");
+    assert_top_to_bottom(
+        &[
+            header("Ops", 0),
+            header("Urgent", 1),
+            row("Fix login", "alpha"),
+        ],
+        cx,
+    );
+}
+
+// R5.9, Q4 — a list deleted elsewhere before the rename is confirmed: the store refuses, every
+// list is unchanged, and ONE warning names the list id, never a list name. The deletion and the
+// Enter happen in one update, so the confirm reaches the field the user typed in.
+#[gpui::test]
+async fn a_rename_of_a_list_deleted_elsewhere_warns_with_the_list_id(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window(true, cx).await;
+    create_list("Docs", cx);
+    create_list("Ideas", cx);
+    let ops = create_list("Ops", cx);
+    open_lists_view(&sidebar, cx);
+    rename_field_for("Ops", cx);
+    type_name("Operations", cx);
+    capture_logs();
+
+    cx.update(|window, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.delete_list(ops, cx))
+            .expect("fixture: the list is deleted in another window");
+        window.dispatch_action(Box::new(Confirm), cx);
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        list_names(cx),
+        vec!["Docs", "Ideas"],
+        "nothing renamed or recreated"
+    );
+    let warnings = warn_lines();
+    let naming_it: Vec<&String> = warnings
+        .iter()
+        .filter(|line| line.contains(&format!("list {ops}")))
+        .collect();
+    assert_eq!(
+        naming_it.len(),
+        1,
+        "one warning names the list id: {warnings:?}"
+    );
+    assert!(
+        warnings
+            .iter()
+            .all(|line| !line.contains("Operations") && !line.contains("Ops")),
+        "no list name in a log line: {warnings:?}"
+    );
+}
+
+// R5.10, Q13 — lists, their names, their order and their members survive a restart: a fresh
+// store on the same database, read by a new window.
+#[gpui::test]
+async fn lists_survive_a_restart(cx: &mut TestAppContext) {
+    let project = init_lists_test(true, cx).await;
+    let (multi_workspace, cx_a) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx_a);
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx_a);
+    let docs_thread = save_in("a2", "Write docs", ALPHA, 1, cx_a);
+    // Creation order Ops, Docs, Backlog; store order after the move Ops, Backlog, Docs, then
+    // Docs renamed Manuals: neither the creation order nor the alphabet gives it back.
+    let ops = create_list("Ops", cx_a);
+    let manuals = create_list("Docs", cx_a);
+    let backlog = create_list("Backlog", cx_a);
+    move_list_in_store(backlog, 1, cx_a);
+    file_in(fix, Some(ops), cx_a);
+    file_in(docs_thread, Some(manuals), cx_a);
+    open_lists_view(&sidebar, cx_a);
+    rename_field_for("Docs", cx_a);
+    type_name("Manuals", cx_a);
+    press_enter(cx_a);
+    let before = list_names(cx_a);
+    assert_eq!(
+        before,
+        vec!["Ops", "Backlog", "Manuals"],
+        "fixture: renamed and reordered"
+    );
+
+    cx.run_until_parked();
+    cx.update(|cx| agent_ui::thread_organization::init(cx));
+    cx.run_until_parked();
+    // A restarted Zeo opens its own project: reusing window A's would register its client
+    // handlers twice.
+    let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+    let reopened = project::Project::test(fs, [ALPHA.as_ref()], cx).await;
+    let (multi_workspace, cx_b) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(reopened, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx_b);
+
+    assert_eq!(list_names(cx_b), before, "names and order");
+    assert_eq!(list_of(fix, cx_b), Some(ops), "members");
+    assert_eq!(list_of(docs_thread, cx_b), Some(manuals));
+    open_lists_view(&sidebar, cx_b);
+    assert_top_to_bottom(
+        &[
+            header("Ops", 1),
+            row("Fix login", "alpha"),
+            header("Backlog", 0),
+            header("Manuals", 1),
+            row("Write docs", "alpha"),
+        ],
+        cx_b,
+    );
+}
