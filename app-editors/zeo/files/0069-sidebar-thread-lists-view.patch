diff --git a/crates/sidebar/src/sidebar_lists_tests/keyboard.rs b/crates/sidebar/src/sidebar_lists_tests/keyboard.rs
new file mode 100644
index 0000000..985d33a
--- /dev/null
+++ b/crates/sidebar/src/sidebar_lists_tests/keyboard.rs
@@ -0,0 +1,181 @@
+// Task 4.1, tech-review fix round — the thread list's keyboard handlers while the Lists view is
+// shown. A Lists row hands its own index to `render_thread`; renaming one used to leave that
+// index in `selection`, which Enter and shift-backspace then read against the HIDDEN thread list.
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn is_archived(thread_id: ThreadId, cx: &mut VisualTestContext) -> bool {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(thread_id)
+            .is_some_and(|metadata| metadata.archived)
+    })
+}
+
+fn title_override(thread_id: ThreadId, cx: &mut VisualTestContext) -> Option<String> {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(thread_id)
+            .and_then(|metadata| {
+                metadata
+                    .title_override
+                    .as_ref()
+                    .map(|title| title.to_string())
+            })
+    })
+}
+
+// Three unfiled threads, more recent than the filed ones, sit at the top of the thread list, so
+// the Lists index of "Write docs" names one of THEM there: a handler that reads it acts on a
+// thread the user cannot see.
+#[gpui::test]
+async fn enter_and_archive_after_a_lists_rename_touch_no_hidden_row(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+    let unfiled = [
+        save_in("u1", "Unfiled one", ALPHA, 5, cx),
+        save_in("u2", "Unfiled two", ALPHA, 6, cx),
+        save_in("u3", "Unfiled three", ALPHA, 7, cx),
+    ];
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let docs = save_in("a2", "Write docs", ALPHA, 1, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    file_in(docs, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+    let active_before = active_thread(&sidebar, cx);
+
+    right_click(row("Write docs", "alpha"), cx);
+    click("MENU_ITEM-Rename Title", cx);
+    sidebar.read_with(cx, |sidebar, _| {
+        assert_eq!(sidebar.rename_target, Some(RenameTarget::Thread(docs)));
+    });
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.rename_editor.update(cx, |editor, cx| {
+            editor.set_text("Write the docs", window, cx);
+        });
+    });
+    cx.run_until_parked();
+    press_enter(cx);
+
+    assert_eq!(
+        title_override(docs, cx).as_deref(),
+        Some("Write the docs"),
+        "Rename Title renames the Lists row's own thread"
+    );
+    assert_eq!(title_override(fix, cx), None, "and no other");
+    assert!(is_lists(&sidebar, cx), "the view stays on Lists");
+
+    press_enter(cx);
+    cx.dispatch_action(ArchiveSelectedThread);
+    cx.run_until_parked();
+
+    for thread_id in unfiled.into_iter().chain([fix, docs]) {
+        assert!(
+            !is_archived(thread_id, cx),
+            "shift-backspace archived {thread_id:?}, a row the Lists view does not select"
+        );
+    }
+    assert_eq!(
+        active_thread(&sidebar, cx),
+        active_before,
+        "Enter opened a thread the Lists view does not select"
+    );
+    assert!(is_lists(&sidebar, cx), "the view is still Lists");
+}
+
+// Arrow keys select nothing in the Lists view (keyboard navigation of its rows is Out of
+// Scope), so a following Enter cannot open a hidden thread-list row either.
+#[gpui::test]
+async fn arrow_keys_then_enter_in_lists_open_nothing(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+    let unfiled = save_in("u1", "Unfiled one", ALPHA, 5, cx);
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+    let active_before = active_thread(&sidebar, cx);
+
+    focus_sidebar(&sidebar, cx);
+    cx.dispatch_action(SelectNext);
+    cx.dispatch_action(SelectNext);
+    cx.run_until_parked();
+    sidebar.read_with(cx, |sidebar, _| {
+        assert_eq!(sidebar.selection, None, "no selection in the Lists view");
+    });
+    press_enter(cx);
+    cx.dispatch_action(ArchiveSelectedThread);
+    cx.run_until_parked();
+
+    assert_eq!(active_thread(&sidebar, cx), active_before);
+    assert!(!is_archived(unfiled, cx) && !is_archived(fix, cx));
+}
+
+// Leaving the Lists view through History (and back) leaves no Lists index behind: the thread
+// list returns with no selection.
+#[gpui::test]
+async fn leaving_lists_through_history_drops_the_lists_selection(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+
+    right_click(row("Fix login", "alpha"), cx);
+    click("MENU_ITEM-Rename Title", cx);
+    press_escape(cx);
+
+    click(HISTORY_BUTTON, cx);
+    assert!(is_history(&sidebar, cx), "fixture: History is shown");
+    click(HISTORY_BUTTON, cx);
+    assert!(
+        is_thread_list(&sidebar, cx),
+        "fixture: back on the thread list"
+    );
+
+    sidebar.read_with(cx, |sidebar, _| {
+        assert_eq!(sidebar.selection, None);
+        assert_eq!(sidebar.hovered_thread_index, None);
+    });
+}
+
+// The keys are stopped, not merely left without a selection: a selection that is somehow set
+// while the view is shown (here directly, before any frame clears it) is still never acted on.
+#[gpui::test]
+async fn a_selection_set_in_lists_is_never_acted_on(cx: &mut TestAppContext) {
+    let (_mw, sidebar, cx) = alpha_window_with_panel(cx).await;
+    let unfiled = save_in("u1", "Unfiled one", ALPHA, 5, cx);
+    let fix = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let ops = create_list("Ops", cx);
+    file_in(fix, Some(ops), cx);
+    open_lists_view(&sidebar, cx);
+    let active_before = active_thread(&sidebar, cx);
+    let unfiled_ix = sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread) if thread.metadata.thread_id == unfiled)
+            })
+            .expect("fixture: the unfiled thread has a thread-list row")
+    });
+
+    focus_sidebar(&sidebar, cx);
+    sidebar.update(cx, |sidebar, _| sidebar.selection = Some(unfiled_ix));
+    cx.dispatch_action(ArchiveSelectedThread);
+    sidebar.update(cx, |sidebar, _| sidebar.selection = Some(unfiled_ix));
+    cx.dispatch_action(Confirm);
+    cx.run_until_parked();
+
+    assert!(
+        !is_archived(unfiled, cx),
+        "shift-backspace archived a hidden row"
+    );
+    assert_eq!(
+        active_thread(&sidebar, cx),
+        active_before,
+        "Enter opened a hidden row"
+    );
+}
diff --git a/crates/sidebar/src/sidebar_lists_tests/manage.rs b/crates/sidebar/src/sidebar_lists_tests/manage.rs
