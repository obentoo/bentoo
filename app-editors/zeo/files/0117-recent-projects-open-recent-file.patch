+}
+
+#[gpui::test]
+async fn opening_a_file_records_it_in_or_out_of_the_project(cx: &mut TestAppContext) {
+    let (_app_state, workspace, mut cx) = open_project_window(cx).await;
+    open_file(&workspace, "/project/src/main.rs", &mut cx).await;
+    open_file(&workspace, "/notes/todo.txt", &mut cx).await;
+    assert_eq!(
+        recorded_paths(&mut cx),
+        vec!["/notes/todo.txt", "/project/src/main.rs"]
+    );
+
+    // Back to a tab already recorded: it moves to the top.
+    open_file(&workspace, "/project/src/main.rs", &mut cx).await;
+    assert_eq!(
+        recorded_paths(&mut cx),
+        vec!["/project/src/main.rs", "/notes/todo.txt"]
+    );
+}
+
+#[gpui::test]
+async fn the_picker_lists_files_with_their_project_and_opens_one_here(cx: &mut TestAppContext) {
+    let (_app_state, workspace, mut cx) = open_project_window(cx).await;
+    let cx = &mut cx;
+    let db = cx.update(|_, cx| ZeoRecentFilesDb::global(cx));
+    for path in ["/project/src/main.rs", "/gone.txt", "/notes/todo.txt"] {
+        db.record_file(path.to_string()).await.unwrap();
+    }
+
+    workspace.update_in(cx, |workspace, window, cx| {
+        RecentFiles::toggle(workspace, window, cx);
+    });
+    cx.run_until_parked();
+
+    let modal = workspace
+        .read_with(cx, |workspace, cx| {
+            workspace.active_modal::<RecentFiles>(cx)
+        })
+        .expect("the picker is open");
+    let shown = |cx: &mut VisualTestContext| {
+        modal.read_with(cx, |modal, cx| {
+            modal
+                .picker
+                .read(cx)
+                .delegate
+                .shown_files()
+                .into_iter()
+                .map(|file| (file.display.clone(), file.project.clone()))
+                .collect::<Vec<_>>()
+        })
+    };
+    assert_eq!(
+        shown(cx),
+        vec![
+            ("/notes/todo.txt".to_string(), None),
+            (
+                "/project/src/main.rs".to_string(),
+                Some("project".to_string())
+            ),
+        ],
+        "most recent first; the deleted file is not listed"
+    );
+    assert!(
+        !db.recent_file_paths()
+            .unwrap()
+            .contains(&"/gone.txt".to_string()),
+        "a deleted file is dropped from the history too"
+    );
+
+    let picker = modal.read_with(cx, |modal, _| modal.picker.clone());
+    picker.update_in(cx, |picker, window, cx| {
+        picker.set_query("main", window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        shown(cx),
+        vec![(
+            "/project/src/main.rs".to_string(),
+            Some("project".to_string())
+        )]
+    );
+
+    picker.update_in(cx, |picker, window, cx| picker.set_query("", window, cx));
+    cx.run_until_parked();
+    cx.dispatch_action(menu::Confirm);
+    cx.run_until_parked();
+
+    assert_eq!(
+        workspace.read_with(cx, |workspace, cx| active_local_file(workspace, cx)),
+        Some(PathBuf::from("/notes/todo.txt")),
+        "the pick opens in this window"
+    );
+    assert_eq!(cx.update(|_, cx| cx.windows().len()), 1);
+    assert!(
+        workspace
+            .read_with(cx, |workspace, cx| workspace
+                .active_modal::<RecentFiles>(cx))
+            .is_none()
+    );
+}
