+// Zeo next proposal §6.21 (ask 41): a panel row carries the tasks card's eye, ↑ and ↓ with
+// the card's conditions. The eye is the card's own -- the card watches the task -- and the
+// panel shows the same preview under its list. GPUI integration tests over the real card.
+
+use gpui::Modifiers;
+use gpui::TestAppContext;
+
+use crate::test_helpers::*;
+
+fn show(panels: &mut Panels) {
+    panels
+        .workspace
+        .update_in(&mut panels.cx, |workspace, window, cx| {
+            workspace.focus_panel::<crate::AgentTasksPanel>(window, cx);
+        });
+    panels.cx.update(|window, _| window.refresh());
+    panels.cx.run_until_parked();
+}
+
+fn click(panels: &mut Panels, selector: String) {
+    let selector: &'static str = Box::leak(selector.into_boxed_str());
+    let bounds = panels
+        .cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    panels.cx.simulate_click(bounds.center(), Modifiers::none());
+    panels.cx.update(|window, _| window.refresh());
+    panels.cx.run_until_parked();
+}
+
+fn painted(panels: &mut Panels, selector: String) -> bool {
+    let selector: &'static str = Box::leak(selector.into_boxed_str());
+    panels.cx.debug_bounds(selector).is_some()
+}
+
+/// Hostile: an ended row gets ↑ only -- no eye, no ↓ -- and a running foreground one all three.
+#[gpui::test]
+async fn card_buttons_follow_the_cards_conditions(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("run", "running", 2_000, None),
+            wire_task("done", "completed", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    show(&mut panels);
+
+    for button in ["watch", "open-at-task", "background"] {
+        assert!(
+            painted(&mut panels, format!("agent-tasks-{button}-run")),
+            "{button} on the running row"
+        );
+    }
+    assert!(painted(&mut panels, "agent-tasks-open-at-task-done".into()));
+    assert!(
+        !painted(&mut panels, "agent-tasks-watch-done".into()),
+        "no eye when ended"
+    );
+    assert!(
+        !painted(&mut panels, "agent-tasks-background-done".into()),
+        "no ↓ when ended"
+    );
+}
+
+/// The eye is the card's: it watches the task, and the panel previews it under the list.
+#[gpui::test]
+async fn card_buttons_the_eye_previews_under_the_list(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    let mut task = wire_task("run", "running", 2_000, None);
+    task["tail"] = serde_json::json!(["building PREVIEWED"]);
+    send_tasks(&thread, vec![task], &mut panels.cx);
+    let session = session_of(&thread, &panels.cx);
+    show(&mut panels);
+    assert!(!painted(&mut panels, "agent-tasks-preview".into()));
+
+    click(&mut panels, "agent-tasks-watch-run".into());
+    let card = panels
+        .agent_panel
+        .read_with(&panels.cx, |panel, _| panel.tasks_card().clone());
+    assert!(card.read_with(&panels.cx, |card, _| {
+        card.is_watched(&session, &"run".into())
+    }));
+    assert!(
+        painted(&mut panels, "agent-tasks-preview".into()),
+        "the preview shows"
+    );
+    assert!(painted(&mut panels, "agent-tasks-preview-body".into()));
+
+    click(&mut panels, "agent-tasks-watch-run".into());
+    assert!(!card.read_with(&panels.cx, |card, _| {
+        card.is_watched(&session, &"run".into())
+    }));
+    assert!(
+        !painted(&mut panels, "agent-tasks-preview".into()),
+        "closed with the eye"
+    );
+}
+
+/// ↓ sends the task's tool call to the background, through the card.
+#[gpui::test]
+async fn card_buttons_down_sends_to_the_background(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    let thread = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Live",
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("run", "running", 2_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx);
+    show(&mut panels);
+
+    click(&mut panels, "agent-tasks-background-run".into());
+    assert_eq!(
+        connection.backgrounds.lock().unwrap().clone(),
+        vec![(session.to_string(), "toolu_run".to_string())]
+    );
+}
