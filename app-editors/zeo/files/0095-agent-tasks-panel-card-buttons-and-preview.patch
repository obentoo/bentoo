+    /// The row's eye (Zeo next §6.21): the card's own, so the card watches the task --
+    /// previews it and notifies when it ends -- and the panel shows the same preview under
+    /// its list. Off again, both close.
+    pub fn toggle_preview(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        let (session_id, task_id) = key;
+        let Some((card, _task)) = self.store.read(cx).live_task(session_id, task_id, cx) else {
+            log::debug!(
+                "agent tasks panel: preview requested for task {task_id} of session \
+                 {session_id}, which no card holds running"
+            );
+            return;
+        };
+        let watched = card.read(cx).is_watched(session_id, task_id);
+        // The previous preview's eye goes off with it: one preview at a time.
+        if !watched {
+            if let Some(previous) = self.previewing.take() {
+                if let Some((previous_card, _)) =
+                    self.store.read(cx).live_task(&previous.0, &previous.1, cx)
+                {
+                    if previous_card.read(cx).is_watched(&previous.0, &previous.1) {
+                        previous_card.update(cx, |card, cx| {
+                            card.toggle_watch(previous.0.clone(), previous.1.clone(), cx)
+                        });
+                    }
+                }
+            }
+        }
+        card.update(cx, |card, cx| {
+            card.toggle_watch(session_id.clone(), task_id.clone(), cx)
+        });
+        self.previewing = (!watched).then(|| key.clone());
+        cx.notify();
+    }
