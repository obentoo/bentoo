diff --git a/crates/agent_ui/src/tasks_card/output_connection_support.rs b/crates/agent_ui/src/tasks_card/output_connection_support.rs
new file mode 100644
index 0000000..9610d27
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/output_connection_support.rs
@@ -0,0 +1,138 @@
+// A test connection that answers `fetch_task_output` as scripted, shared by the Open Log
+// tests (story 041) and the eye's preview tests (Zeo next §6.22). Moved out of
+// open_log_tests.rs unchanged but for visibility.
+
+use std::{
+    any::Any,
+    collections::HashMap,
+    rc::Rc,
+    sync::{Arc, Mutex},
+};
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection, TaskOutput};
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{App, AppContext as _, Entity, SharedString, Task};
+use project::{AgentId, Project};
+use workspace::PathList;
+
+// ---- A connection that answers `fetch_task_output` as scripted ------------------------------
+
+#[derive(Clone)]
+pub(crate) struct OutputConnection {
+    stub: StubAgentConnection,
+    next_session: Arc<Mutex<usize>>,
+    /// task id -> the answer; a missing id answers an error.
+    answers: Arc<Mutex<HashMap<(String, String), std::result::Result<TaskOutput, String>>>>,
+    fetches: Arc<Mutex<Vec<(String, String)>>>,
+}
+
+impl OutputConnection {
+    pub(crate) fn new() -> Self {
+        Self {
+            stub: StubAgentConnection::new(),
+            next_session: Arc::new(Mutex::new(0)),
+            answers: Arc::default(),
+            fetches: Arc::default(),
+        }
+    }
+
+    pub(crate) fn answer(
+        &self,
+        session: &acp_v2::SessionId,
+        task: &str,
+        answer: std::result::Result<TaskOutput, String>,
+    ) {
+        self.answers
+            .lock()
+            .unwrap()
+            .insert((session.to_string(), task.to_string()), answer);
+    }
+
+    pub(crate) fn fetches(&self) -> Vec<(String, String)> {
+        self.fetches.lock().unwrap().clone()
+    }
+}
+
+impl AgentConnection for OutputConnection {
+    fn agent_id(&self) -> AgentId {
+        self.stub.agent_id()
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "open-log-test".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<Result<Entity<AcpThread>>> {
+        let session_id = {
+            let mut next = self.next_session.lock().unwrap();
+            *next += 1;
+            acp_v2::SessionId::new(format!("open-log-session-{}", *next))
+        };
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        Task::ready(Ok(thread))
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: acp_v2::AuthMethodId, _cx: &mut App) -> Task<Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: acp_v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<Result<acp::PromptResponse>> {
+        Task::ready(Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) -> Result<()> {
+        Ok(())
+    }
+
+    fn fetch_task_output(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<Result<TaskOutput>> {
+        let key = (session_id.to_string(), task_id.to_string());
+        self.fetches.lock().unwrap().push(key.clone());
+        let answer = self.answers.lock().unwrap().get(&key).cloned();
+        Task::ready(match answer {
+            Some(Ok(output)) => Ok(output),
+            Some(Err(message)) => Err(anyhow!(
+                "_claude/tasks/output failed for {task_id}: {message}"
+            )),
+            None => Err(anyhow!(
+                "_claude/tasks/output failed for {task_id}: no answer scripted"
+            )),
+        })
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
diff --git a/crates/agent_ui/src/tasks_card/preview.rs b/crates/agent_ui/src/tasks_card/preview.rs
new file mode 100644
index 0000000..a200b7b
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/preview.rs
@@ -0,0 +1,134 @@
+//! Zeo next proposal §6.22 (ask 42): the eye previews a task. The chevron keeps the row's
+//! details (tokens, tools, summary); the eye shows what the task printed -- the output the
+//! agent serves through `_claude/tasks/output` (0056), refetched while the task runs -- in a
+//! monospace block that follows its end, and the card widens to its frame while a preview
+//! is open. Until the first fetch lands, or for a task whose output the agent does not
+//! serve, the preview falls back to the short tail the feed carries, so it is never blank.
+//! The eye keeps its tray role (§12's default): a watched task still notifies when it ends.
+
+use std::time::Duration;
+
+use acp_thread::{AgentTask, TaskOutput};
+use gpui::{AnyElement, App, ScrollHandle, SharedString, px};
+use ui::prelude::*;
+
+/// How often a running task's preview is refetched.
+pub(super) const PREVIEW_POLL: Duration = Duration::from_secs(2);
+/// The preview's last lines; older ones scroll out, as a terminal's do.
+pub(super) const PREVIEW_MAX_LINES: usize = 200;
+
+/// One open preview's state, in memory only.
+#[derive(Default)]
+pub(super) struct TaskPreview {
+    pub output: Option<TaskOutput>,
+    pub error: Option<SharedString>,
+    pub in_flight: bool,
+    /// The block's scroll, so new output can follow the end (see [`TaskPreview::show`]).
+    pub scroll: ScrollHandle,
+}
+
+impl TaskPreview {
+    /// Takes a fetched output. The block follows the end, as a terminal does, while the
+    /// reader is at the end or nothing was shown yet; scrolled up to read, it stays put.
+    pub(super) fn show(&mut self, output: TaskOutput) {
+        let at_end = self.scroll.offset().y <= -self.scroll.max_offset().y + px(2.);
+        let follow = self.output.is_none() || at_end;
+        self.output = Some(output);
+        self.error = None;
+        if follow {
+            self.scroll.scroll_to_bottom();
+        }
+    }
+}
+
+/// The last `max` lines of `content`, and whether older ones were left out.
+pub(super) fn preview_lines(content: &str, max: usize) -> (Vec<&str>, bool) {
+    let lines: Vec<&str> = content.lines().collect();
+    let cut = lines.len().saturating_sub(max);
+    (lines[cut..].to_vec(), cut > 0)
+}
+
+/// The eye's block under a row. `fallback` is the row's short tail, drawn while there is no
+/// fetched output.
+pub(super) fn render_preview(
+    task: &AgentTask,
+    preview: Option<&TaskPreview>,
+    fallback: impl FnOnce() -> AnyElement,
+    cx: &App,
+) -> AnyElement {
+    let task_id = task.id.clone();
+    let body = match preview.and_then(|preview| preview.output.as_ref()) {
+        Some(output) if !output.content.is_empty() => {
+            let (lines, cut) = preview_lines(&output.content, PREVIEW_MAX_LINES);
+            v_flex()
+                .id(SharedString::from(format!(
+                    "tasks-card-preview-output-{task_id}"
+                )))
+                .debug_selector({
+                    let task_id = task_id.clone();
+                    move || format!("tasks-card-preview-output-{task_id}")
+                })
+                .max_h(rems(16.))
+                .overflow_y_scroll()
+                .track_scroll(
+                    &preview
+                        .map(|preview| preview.scroll.clone())
+                        .unwrap_or_default(),
+                )
+                .min_w_0()
+                .px_1()
+                .rounded_sm()
+                .bg(cx.theme().colors().editor_background)
+                .when(cut || output.truncated, |this| {
+                    this.child(
+                        Label::new("… earlier output not shown")
+                            .size(LabelSize::XSmall)
+                            .color(Color::Muted),
+                    )
+                })
+                .children(lines.into_iter().map(|line| {
+                    Label::new(line.to_string())
+                        .size(LabelSize::XSmall)
+                        .buffer_font(cx)
+                        .single_line()
+                }))
+                .into_any_element()
+        }
+        _ => fallback(),
+    };
+    v_flex()
+        .debug_selector(move || format!("tasks-card-preview-{task_id}"))
+        .min_w_0()
+        .gap_0p5()
+        .child(body)
+        .when_some(
+            preview.and_then(|preview| preview.error.clone()),
+            |this, error| {
+                this.child(
+                    Label::new(format!("Preview unavailable: {error}"))
+                        .size(LabelSize::XSmall)
+                        .color(Color::Muted),
+                )
+            },
+        )
+        .into_any_element()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_preview_keeps_the_last_lines() {
+        let content = (1..=5)
+            .map(|n| format!("line {n}"))
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert_eq!(
+            preview_lines(&content, 3),
+            (vec!["line 3", "line 4", "line 5"], true)
+        );
+        assert_eq!(preview_lines(&content, 10).1, false, "nothing left out");
+        assert_eq!(preview_lines("", 3), (Vec::<&str>::new(), false));
+    }
+}
