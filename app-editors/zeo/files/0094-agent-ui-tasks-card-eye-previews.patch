+// Zeo next proposal §6.22 (ask 42): the eye previews a task -- what it printed, refetched
+// while it runs -- and the chevron keeps the details. The card widens while a preview is
+// open. Filter: `tasks_card::preview_rows`.
+
+use std::time::Duration;
+
+use acp_thread::{AcpThread, TaskOutput};
+use agent_client_protocol::v1::schema as acp;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::output_connection_support::OutputConnection;
+use super::test_helpers::*;
+use crate::test_support::open_thread_with_custom_connection;
+
+fn open_thread(
+    panel: &Entity<crate::AgentPanel>,
+    connection: &OutputConnection,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    open_thread_with_custom_connection(panel, connection.clone(), cx);
+    let thread = panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap());
+    send_info(&thread, acp::SessionInfoUpdate::new().title("A"), cx);
+    thread
+}
+
+fn shell(id: &str, status: &str) -> serde_json::Value {
+    let mut task = wire_task(id, status, true, 1_000);
+    task["hasOutput"] = json!(true);
+    task["tail"] = json!(["short tail"]);
+    task
+}
+
+fn output(content: &str) -> TaskOutput {
+    TaskOutput {
+        content: content.to_string(),
+        total_bytes: content.len() as u64,
+        truncated: false,
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Hostile: the eye must show the fetched output, not the chevron's details, and the card
+/// must widen for it.
+#[gpui::test]
+async fn test_preview_rows_the_eye_shows_the_output_and_widens_the_card(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, &mut cx);
+    let sa = session_of(&a, &cx);
+    connection.answer(
+        &sa,
+        "t1",
+        Ok(output("compiling foo\ncompiling bar\nPREVIEW-END")),
+    );
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    draw(&mut cx);
+    let narrow = cx
+        .debug_bounds("tasks-card")
+        .expect("card painted")
+        .size
+        .width;
+
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+
+    assert_eq!(
+        connection.fetches(),
+        vec![(sa.to_string(), "t1".to_string())]
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-preview-output-t1").is_some(),
+        "the output shows"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-details-t1").is_none(),
+        "not the details"
+    );
+    let wide = cx
+        .debug_bounds("tasks-card")
+        .expect("card painted")
+        .size
+        .width;
+    assert!(wide > narrow, "the card widens: {narrow:?} -> {wide:?}");
+
+    // The chevron opens the details; the preview stays.
+    card.update(&mut cx, |card, cx| {
+        card.toggle_expanded(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-details-t1").is_some());
+
+    // Unwatched, the preview closes and the card is back to its width.
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-preview-t1").is_none());
+    let back = cx
+        .debug_bounds("tasks-card")
+        .expect("card painted")
+        .size
+        .width;
+    assert_eq!(back, narrow);
+}
+
+/// A running task's preview is refetched; an unwatched one is not.
+#[gpui::test]
+async fn test_preview_rows_a_running_preview_follows_and_stops_when_unwatched(
+    cx: &mut TestAppContext,
+) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, &mut cx);
+    let sa = session_of(&a, &cx);
+    connection.answer(&sa, "t1", Ok(output("one")));
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    draw(&mut cx);
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+    assert_eq!(connection.fetches().len(), 1);
+
+    advance(&mut cx, Duration::from_secs(2));
+    draw(&mut cx);
+    assert_eq!(connection.fetches().len(), 2, "refetched while it runs");
+
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    advance(&mut cx, Duration::from_secs(6));
+    draw(&mut cx);
+    assert_eq!(
+        connection.fetches().len(),
+        2,
+        "nothing fetched once unwatched"
+    );
+}
+
+/// A failed fetch falls back to the feed's tail and says why, instead of a blank block.
+#[gpui::test]
+async fn test_preview_rows_a_failed_fetch_falls_back_to_the_tail(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, &mut cx);
+    let sa = session_of(&a, &cx);
+    connection.answer(&sa, "t1", Err("gone".to_string()));
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    draw(&mut cx);
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+    assert!(cx.debug_bounds("tasks-card-preview-t1").is_some());
+    assert!(
+        cx.debug_bounds("tasks-card-tail-t1").is_some(),
+        "the tail stands in"
+    );
+    assert!(cx.debug_bounds("tasks-card-preview-output-t1").is_none());
+}
+
+/// Hostile: a long output must open on its end, not its first line, as a terminal does.
+#[gpui::test]
+async fn test_preview_rows_a_long_output_opens_on_its_end(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = OutputConnection::new();
+    let a = open_thread(&panel, &connection, &mut cx);
+    let sa = session_of(&a, &cx);
+    let long = (1..=80)
+        .map(|n| format!("line {n}"))
+        .collect::<Vec<_>>()
+        .join("\n");
+    connection.answer(&sa, "t1", Ok(output(&long)));
+    send_tasks(&a, vec![shell("t1", "running")], &mut cx);
+    draw(&mut cx);
+    let card = card(&panel, &cx);
+    card.update(&mut cx, |card, cx| {
+        card.toggle_watch(sa.clone(), "t1".into(), cx)
+    });
+    draw(&mut cx);
+    draw(&mut cx);
+    let (offset, max) = card.read_with(&cx, |card, _| {
+        let preview = card
+            .previews
+            .get(&(sa.clone(), "t1".into()))
+            .expect("a preview");
+        (preview.scroll.offset().y, preview.scroll.max_offset().y)
+    });
+    assert!(max > gpui::px(0.), "the output overflows the block");
+    assert!(
+        offset < gpui::px(0.),
+        "scrolled to the end: offset {offset:?} of {max:?}"
+    );
+}
