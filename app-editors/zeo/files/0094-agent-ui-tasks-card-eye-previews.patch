+    /// Fetches a watched task's output for its preview, unless a fetch is already out or
+    /// the agent serves none for it (Zeo next §6.22).
+    fn refresh_preview(&mut self, key: TaskKey, cx: &mut Context<Self>) {
+        let Some(task) = self.current_task(&key, cx) else {
+            return;
+        };
+        if !task.has_output {
+            return;
+        }
+        let Some(thread) = self.held_thread(&key.0) else {
+            return;
+        };
+        let preview = self.previews.entry(key.clone()).or_default();
+        if preview.in_flight {
+            return;
+        }
+        preview.in_flight = true;
+        let fetch = thread.update(cx, |thread, cx| thread.fetch_task_output(&key.1, cx));
+        cx.spawn(async move |card, cx| {
+            let fetched = fetch.await;
+            card.update(cx, |card, cx| {
+                // Unwatched while the fetch was out: nothing to show it in.
+                let Some(preview) = card.previews.get_mut(&key) else {
+                    return;
+                };
+                preview.in_flight = false;
+                match fetched {
+                    Ok(output) => preview.show(output),
+                    Err(error) => {
+                        log::debug!(
+                            "tasks card: preview of task {} in session {} failed: {error:#}",
+                            key.1,
+                            key.0
+                        );
+                        preview.error = Some(format!("{error:#}").into());
+                    }
+                }
+                cx.notify();
+            })
+            .ok();
+        })
+        .detach();
+    }
+
+    /// Keeps a refetch loop alive while a watched task runs.
+    fn update_preview_poll(&mut self, cx: &mut Context<Self>) {
+        if self.watched.is_empty() {
+            self._preview_poll = None;
+            return;
+        }
+        if self._preview_poll.is_some() {
+            return;
+        }
+        self._preview_poll = Some(cx.spawn(async move |card, cx| {
+            loop {
+                cx.background_executor().timer(preview::PREVIEW_POLL).await;
+                let keep = card.update(cx, |card, cx| {
+                    let running: Vec<TaskKey> = card
+                        .watched
+                        .iter()
+                        .filter(|key| card.running_task(key, cx).is_some())
+                        .cloned()
+                        .collect();
+                    for key in running {
+                        card.refresh_preview(key, cx);
+                    }
+                    !card.watched.is_empty()
+                });
+                if !matches!(keep, Ok(true)) {
+                    card.update(cx, |card, _| card._preview_poll = None).ok();
+                    break;
+                }
+            }
+        }));
+    }
