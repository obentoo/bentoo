+/// [`session_request_meta`] for a session of `agent_id` in `project` (new, loaded or resumed),
+/// plus Zeo's skills as plugins for Zeo's Claude adapters (§6.69 step 2,
+/// `crate::zeo_skills_plugin`): each request starts the CLI, which loads plugins then.
+pub(crate) fn new_session_meta(
+    agent_id: &project::AgentId,
+    project: &gpui::Entity<project::Project>,
+    cx: &App,
+) -> Option<Map<String, Value>> {
+    let mut meta = session_request_meta(cx);
+    if crate::zeo_skills_plugin::reads_claude_code_options(agent_id.0.as_ref()) {
+        let root = project
+            .read(cx)
+            .visible_worktrees(cx)
+            .next()
+            .map(|worktree| worktree.read(cx).abs_path().to_path_buf());
+        let dirs = crate::zeo_skills_plugin::skill_plugin_dirs(
+            root.as_deref(),
+            paths::home_dir(),
+            &paths::data_dir().join(crate::zeo_skills_plugin::SKILL_PLUGINS_DIR),
+        );
+        if let Some(claude_code) = crate::zeo_skills_plugin::plugins_meta(&dirs) {
+            meta.get_or_insert_default()
+                .insert("claudeCode".to_string(), claude_code);
+        }
+    }
+    meta
+}
