@@ -0,0 +1,123 @@
+//! Zeo's skills reach Claude Agent (Plus) as a plugin (Zeo proposal §6.69 step 2, 2026-11-22).
+//!
+//! Zeo's skills live in `~/.agents/skills` and `<project>/.agents/skills`, which only the native
+//! Zed agent reads: the Claude CLI does not (measured by the plus lane, 2026-11-22 -- the path
+//! occurs only in its Cursor importer). The SDK's `skills` option only filters what is already
+//! loaded, but its `plugins` option loads a local directory, and a manifest-less one whose
+//! `skills` is a symlink loads that folder's skills under the directory's name (measured: a
+//! `plugin-bare` dir with `skills -> ~/.agents/skills` loaded `plugin-bare:<skill>`). So Zeo keeps
+//! one such directory per source under its data dir and hands them to Plus (and the TUI adapter)
+//! in `session/new` as `_meta.claudeCode.options.plugins`, which Plus spreads into the SDK
+//! options. Nothing is copied: the skills stay where the user keeps them.
+//!
+//! A jailed agent sees the project, so its `.agents/skills` works there as it is; the plugin
+//! root and `~/.agents/skills` are mapped read-only into the jail by the agent sandbox (0148).
+
+use std::path::{Path, PathBuf};
+
+use serde_json::{Value, json};
+
+/// The folder under Zeo's data dir that holds the plugin directories. The agent sandbox maps the
+/// same folder into a jail by this name.
+pub const SKILL_PLUGINS_DIR: &str = "agent-skill-plugins";
+
+/// The plugin of `~/.agents/skills`; its skills load as `zeo-agents-skills:<name>`.
+const GLOBAL_PLUGIN: &str = "zeo-agents-skills";
+
+/// The plugin of a project's `.agents/skills`; its skills load as `zeo-project-skills:<name>`.
+const PROJECT_PLUGIN: &str = "zeo-project-skills";
+
+/// The agents that read `_meta.claudeCode.options`: Zeo's two Claude adapters.
+pub fn reads_claude_code_options(agent_id: &str) -> bool {
+    agent_id == project::agent_registry_store::ZEO_PLUS_AGENT_ID
+        || agent_id == project::agent_registry_store::ZEO_TUI_AGENT_ID
+}
+
+/// The plugin directories for a session in `project_root`, made (or repaired) under
+/// `plugin_root`: one for `~/.agents/skills` under `home`, one for the project's own, each only
+/// when its skills folder exists. A directory that cannot be made is left out and logged.
+pub fn skill_plugin_dirs(
+    project_root: Option<&Path>,
+    home: &Path,
+    plugin_root: &Path,
+) -> Vec<PathBuf> {
+    let mut dirs = Vec::new();
+    let global = home.join(".agents/skills");
+    if global.is_dir() {
+        dirs.extend(ensure_plugin(&plugin_root.join(GLOBAL_PLUGIN), &global));
+    }
+    if let Some(root) = project_root {
+        let own = root.join(".agents/skills");
+        if own.is_dir() {
+            let dir = plugin_root
+                .join("projects")
+                .join(format!(
+                    "{:016x}",
+                    fnv1a(root.as_os_str().as_encoded_bytes())
+                ))
+                .join(PROJECT_PLUGIN);
+            dirs.extend(ensure_plugin(&dir, &own));
+        }
+    }
+    dirs
+}
+
+/// The `_meta` entry that hands `dirs` to the agent, `None` when there are none.
+pub fn plugins_meta(dirs: &[PathBuf]) -> Option<Value> {
+    (!dirs.is_empty()).then(|| {
+        let plugins: Vec<Value> = dirs
+            .iter()
+            .map(|dir| json!({ "type": "local", "path": dir.to_string_lossy() }))
+            .collect();
+        json!({ "options": { "plugins": plugins } })
+    })
+}
+
+/// `dir` with a `skills` symlink to `target`: made when missing, re-pointed when it points
+/// elsewhere. The plugin directory is the symlink's only content.
+fn ensure_plugin(dir: &Path, target: &Path) -> Option<PathBuf> {
+    let link = dir.join("skills");
+    if std::fs::read_link(&link).is_ok_and(|current| current == target) {
+        return Some(dir.to_path_buf());
+    }
+    let made = std::fs::create_dir_all(dir).and_then(|()| {
+        if link.symlink_metadata().is_ok() {
+            std::fs::remove_file(&link)?;
+        }
+        symlink(target, &link)
+    });
+    match made {
+        Ok(()) => Some(dir.to_path_buf()),
+        Err(error) => {
+            log::warn!(
+                "zeo_skills event=plugin_dir_failed error={:?}",
+                error.to_string()
+            );
+            None
+        }
+    }
+}
+
+#[cfg(unix)]
+fn symlink(target: &Path, link: &Path) -> std::io::Result<()> {
+    std::os::unix::fs::symlink(target, link)
+}
+
+#[cfg(not(unix))]
+fn symlink(_target: &Path, _link: &Path) -> std::io::Result<()> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "skills plugins need symlinks",
+    ))
+}
+
+/// FNV-1a: a project's folder name must not change with the toolchain, as `DefaultHasher` may.
+fn fnv1a(bytes: &[u8]) -> u64 {
+    bytes.iter().fold(0xcbf2_9ce4_8422_2325, |hash, byte| {
+        (hash ^ u64::from(*byte)).wrapping_mul(0x0000_0100_0000_01b3)
+    })
+}
+
