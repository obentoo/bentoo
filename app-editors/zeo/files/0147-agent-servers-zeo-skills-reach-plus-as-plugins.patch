new file mode 100644
index 0000000..e25dbc0
--- /dev/null
+++ b/crates/agent_servers/src/zeo_skills_plugin_tests.rs
@@ -0,0 +1,93 @@
+// Zeo proposal §6.69 step 2: Zeo's skills reach Plus as plugin directories. Filter:
+// `zeo_skills_plugin`.
+
+use std::path::Path;
+
+use super::*;
+
+fn mkdirs(path: &Path) {
+    std::fs::create_dir_all(path).expect("mkdir");
+}
+
+#[test]
+fn zeo_skills_plugin_links_both_skill_folders() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let home = tmp.path().join("home");
+    let root = tmp.path().join("app");
+    let plugins = tmp.path().join("data/agent-skill-plugins");
+    mkdirs(&home.join(".agents/skills/deploy"));
+    mkdirs(&root.join(".agents/skills/review"));
+
+    let dirs = skill_plugin_dirs(Some(&root), &home, &plugins);
+    assert_eq!(dirs.len(), 2, "{dirs:?}");
+    assert_eq!(dirs[0], plugins.join("zeo-agents-skills"));
+    assert_eq!(
+        std::fs::read_link(dirs[0].join("skills")).expect("a symlink"),
+        home.join(".agents/skills")
+    );
+    assert!(
+        dirs[0].join("skills/deploy").is_dir(),
+        "the skill is reached through it"
+    );
+    assert!(dirs[1].ends_with("zeo-project-skills"));
+    assert_eq!(
+        std::fs::read_link(dirs[1].join("skills")).expect("a symlink"),
+        root.join(".agents/skills")
+    );
+    assert_eq!(
+        skill_plugin_dirs(Some(&root), &home, &plugins),
+        dirs,
+        "the same directories next time"
+    );
+}
+
+/// Hostile: no skills folder, no plugin -- an empty plugin would still be loaded.
+#[test]
+fn zeo_skills_plugin_skips_missing_folders() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let dirs = skill_plugin_dirs(
+        Some(&tmp.path().join("app")),
+        &tmp.path().join("home"),
+        &tmp.path().join("plugins"),
+    );
+    assert!(dirs.is_empty(), "{dirs:?}");
+    assert_eq!(plugins_meta(&dirs), None);
+}
+
+#[test]
+fn zeo_skills_plugin_repoints_a_stale_link() {
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let home = tmp.path().join("home");
+    let plugins = tmp.path().join("plugins");
+    mkdirs(&home.join(".agents/skills"));
+    mkdirs(&plugins.join("zeo-agents-skills"));
+    std::os::unix::fs::symlink(
+        tmp.path().join("elsewhere"),
+        plugins.join("zeo-agents-skills/skills"),
+    )
+    .expect("stale link");
+    let dirs = skill_plugin_dirs(None, &home, &plugins);
+    assert_eq!(
+        std::fs::read_link(dirs[0].join("skills")).expect("a symlink"),
+        home.join(".agents/skills")
+    );
+}
+
+#[test]
+fn zeo_skills_plugin_meta_is_the_sdks_local_plugin_list() {
+    let meta = plugins_meta(&[std::path::PathBuf::from("/d/zeo-agents-skills")]).expect("meta");
+    assert_eq!(
+        meta,
+        serde_json::json!({ "options": { "plugins": [
+            { "type": "local", "path": "/d/zeo-agents-skills" }
+        ]}})
+    );
+}
+
+#[test]
+fn zeo_skills_plugin_is_for_zeos_claude_adapters_only() {
+    assert!(reads_claude_code_options("claude-agent-acp-plus"));
+    assert!(reads_claude_code_options("claude-agent-tui"));
+    assert!(!reads_claude_code_options("claude-acp"));
+    assert!(!reads_claude_code_options("gemini"));
+}
