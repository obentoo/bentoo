diff --git a/crates/agent_ui/src/conversation_view/thread_view/side_question_card.rs b/crates/agent_ui/src/conversation_view/thread_view/side_question_card.rs
new file mode 100644
index 0000000..5783f28
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/thread_view/side_question_card.rs
@@ -0,0 +1,276 @@
+//! `/btw`: a side question answered in a card (Zeo next proposal §6.8, ask 29).
+//!
+//! A composer message that starts with `/btw` goes to the agent at once — while a turn runs it
+//! is not queued behind it — through `_claude/btw` (Claude Agent (Plus) 0.38.0), and the answer
+//! shows in a dismissable card above the composer. The answer never enters the conversation:
+//! the agent keeps it out of the session's transcript, so the next turn does not see it and a
+//! reloaded thread does not show it. One card per thread view; a new question replaces it.
+//!
+//! An agent that does not advertise `_claude/btw` gets the text as before, as a prompt.
+
+use acp_thread::{SIDE_QUESTION_MAX_CHARS, SideAnswer};
+use gpui::{AnyElement, Context, Entity, ScrollHandle, SharedString, Task, Window, px};
+use markdown::{Markdown, MarkdownFont, MarkdownStyle};
+use ui::{
+    Icon, IconButton, IconName, IconSize, Label, LabelSize, ScrollAxes, Scrollbars, Tooltip,
+    WithScrollbar, prelude::*,
+};
+
+use super::ThreadView;
+use super::content_column::content_column;
+
+/// The most of an answer the card shows before it scrolls.
+const SIDE_ANSWER_MAX_HEIGHT: f32 = 240.;
+
+const SIDE_QUESTION_USAGE: &str = "Type /btw and a question to ask something on the side. \
+     The agent answers here, even while it works, and the answer is not added to the \
+     conversation.";
+
+/// What a composer message beginning with `/btw` asks for.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum SideQuestionInvocation {
+    Ask(String),
+    /// A bare `/btw`.
+    Usage,
+    /// Longer than the agent accepts, in characters.
+    TooLong(usize),
+}
+
+/// The side question in a composer message, as plus reads `/btw`: the command must be the
+/// whole first word (`/btwx` is not it), and the question is the rest, trimmed. Leading
+/// whitespace before the command is ignored. `None` for any other message.
+pub(crate) fn side_question_invocation(text: &str) -> Option<SideQuestionInvocation> {
+    let rest = text.trim_start().strip_prefix("/btw")?;
+    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
+        return None;
+    }
+    let question = rest.trim();
+    if question.is_empty() {
+        return Some(SideQuestionInvocation::Usage);
+    }
+    let chars = question.chars().count();
+    if chars > SIDE_QUESTION_MAX_CHARS {
+        return Some(SideQuestionInvocation::TooLong(chars));
+    }
+    Some(SideQuestionInvocation::Ask(question.to_string()))
+}
+
+enum SideQuestionState {
+    Asking,
+    Answered {
+        markdown: Entity<Markdown>,
+        fallback_model: Option<SharedString>,
+    },
+    /// Words for the reader that are not an error: the usage of a bare `/btw`.
+    Note(SharedString),
+    Failed(SharedString),
+}
+
+/// The open card, with the request that fills it. Replacing the card drops the request's task,
+/// so a late answer to an earlier question never lands in a newer card.
+pub(crate) struct SideQuestionCard {
+    question: SharedString,
+    state: SideQuestionState,
+    scroll: ScrollHandle,
+    _ask: Task<()>,
+}
+
+impl ThreadView {
+    /// Sends the composer's `/btw` as a side question when the agent answers them, and clears
+    /// the composer. Returns `false`, touching nothing, when the message is not a side
+    /// question for this agent, so the send goes on as before.
+    pub(super) fn send_side_question(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let connection = self.thread.read(cx).connection().clone();
+        if !connection.supports_side_question() {
+            return false;
+        }
+        let text = self.message_editor.read(cx).text(cx);
+        let Some(invocation) = side_question_invocation(&text) else {
+            return false;
+        };
+        self.message_editor
+            .update(cx, |editor, cx| editor.clear(window, cx));
+
+        let (question, state, ask): (SharedString, _, _) = match invocation {
+            SideQuestionInvocation::Usage => (
+                "/btw".into(),
+                SideQuestionState::Note(SIDE_QUESTION_USAGE.into()),
+                Task::ready(()),
+            ),
+            SideQuestionInvocation::TooLong(chars) => (
+                "/btw".into(),
+                SideQuestionState::Failed(
+                    format!(
+                        "The question is {chars} characters long; a side question takes at \
+                         most {SIDE_QUESTION_MAX_CHARS}."
+                    )
+                    .into(),
+                ),
+                Task::ready(()),
+            ),
+            SideQuestionInvocation::Ask(question) => {
+                let session_id = self.thread.read(cx).session_id().clone();
+                let request = connection.ask_side_question(&session_id, question.clone(), cx);
+                let languages = self
+                    .project
+                    .upgrade()
+                    .map(|project| project.read(cx).languages().clone());
+                let ask = cx.spawn(async move |this, cx| {
+                    let result = request.await;
+                    this.update(cx, |this, cx| {
+                        let Some(card) = this.side_question_card.as_mut() else {
+                            return;
+                        };
+                        card.state = match result {
+                            Ok(SideAnswer {
+                                answer,
+                                fallback_model,
+                            }) => SideQuestionState::Answered {
+                                markdown: cx
+                                    .new(|cx| Markdown::new(answer.into(), languages, None, cx)),
+                                fallback_model: fallback_model.map(Into::into),
+                            },
+                            Err(error) => {
+                                log::warn!(
+                                    "side question failed: session={session_id} error={error:#}"
+                                );
+                                SideQuestionState::Failed(error.to_string().into())
+                            }
+                        };
+                        cx.notify();
+                    })
+                    .ok();
+                });
+                (question.into(), SideQuestionState::Asking, ask)
+            }
+        };
+        self.side_question_card = Some(SideQuestionCard {
+            question,
+            state,
+            scroll: ScrollHandle::new(),
+            _ask: ask,
+        });
+        cx.notify();
+        true
+    }
+
+    pub(super) fn render_side_question_card(
+        &self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        let card = self.side_question_card.as_ref()?;
+
+        let header = h_flex()
+            .w_full()
+            .gap_2()
+            .justify_between()
+            .child(
+                h_flex()
+                    .min_w_0()
+                    .gap_1p5()
+                    .child(
+                        Icon::new(IconName::Chat)
+                            .size(IconSize::XSmall)
+                            .color(Color::Muted),
+                    )
+                    .child(Label::new("By the way").size(LabelSize::Small))
+                    .child(
+                        Label::new(card.question.clone())
+                            .size(LabelSize::Small)
+                            .color(Color::Muted)
+                            .truncate(),
+                    ),
+            )
+            .child(
+                IconButton::new("side-question-dismiss", IconName::Close)
+                    .icon_size(IconSize::Small)
+                    .icon_color(Color::Muted)
+                    .aria_label("Dismiss the side question")
+                    .tooltip(Tooltip::text("Dismiss"))
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.side_question_card = None;
+                        cx.notify();
+                    })),
+            );
+
+        let body = match &card.state {
+            SideQuestionState::Asking => Label::new("Asking on the side…")
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .into_any_element(),
+            SideQuestionState::Note(note) => Label::new(note.clone())
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .into_any_element(),
+            SideQuestionState::Failed(reason) => Label::new(reason.clone())
+                .size(LabelSize::Small)
+                .color(Color::Error)
+                .into_any_element(),
+            SideQuestionState::Answered { markdown, .. } => {
+                let style = MarkdownStyle::themed(MarkdownFont::Agent, window, cx);
+                div()
+                    .w_full()
+                    .max_h(px(SIDE_ANSWER_MAX_HEIGHT))
+                    .child(
+                        div()
+                            .id("side-question-answer")
+                            .max_h(px(SIDE_ANSWER_MAX_HEIGHT))
+                            .pr_3()
+                            .overflow_y_scroll()
+                            .track_scroll(&card.scroll)
+                            .child(self.render_markdown(markdown.clone(), style, cx)),
+                    )
+                    // Always visible: `Scrollbars::new` hides itself when idle, and a cut-off
+                    // answer then reads as the whole one (the trap §6.32 met).
+                    .custom_scrollbars(
+                        Scrollbars::always_visible(ScrollAxes::Vertical)
+                            .tracked_scroll_handle(&card.scroll),
+                        window,
+                        cx,
+                    )
+                    .into_any_element()
+            }
+        };
+
+        let footer = match &card.state {
+            SideQuestionState::Answered { fallback_model, .. } => Some(
+                Label::new(match fallback_model {
+                    Some(model) => format!("Not added to the conversation · answered by {model}"),
+                    None => "Not added to the conversation".to_string(),
+                })
+                .size(LabelSize::XSmall)
+                .color(Color::Muted),
+            ),
+            _ => None,
+        };
+
+        // Read after the body: the scrollbar above borrows `cx` mutably.
+        let colors = cx.theme().colors();
+        let card = v_flex()
+            .id("side-question-card")
+            .debug_selector(|| "side-question-card".into())
+            .mx_2()
+            .mb_1()
+            .p_2()
+            .gap_1p5()
+            .rounded_md()
+            .border_1()
+            .border_color(colors.border)
+            .bg(colors.panel_background)
+            .shadow_sm()
+            .child(header)
+            .child(body)
+            .children(footer);
+        // The composer's column (§6.30), as the context card beside it.
+        Some(content_column(card, cx).into_any_element())
+    }
+}
