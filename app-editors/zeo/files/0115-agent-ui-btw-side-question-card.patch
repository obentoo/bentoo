--- /dev/null
+++ b/crates/agent_servers/src/acp/v1/side_question_tests.rs
@@ -0,0 +1,55 @@
+// Zeo next proposal §6.8 (ask 29): reading Claude Agent (Plus) 0.38.0's `_claude/btw` answer.
+// Filter: `v1::side_question_tests`.
+
+use serde_json::json;
+
+use super::parse_side_question_answer;
+
+#[test]
+fn an_answer_is_read_with_its_fallback_model() {
+    let answer = parse_side_question_answer(&json!({
+        "status": "answered",
+        "answer": "It is **42**.",
+        "synthetic": false,
+        "fallbackModel": "claude-sonnet-5-5",
+    }))
+    .expect("answered");
+    assert_eq!(answer.answer, "It is **42**.");
+    assert_eq!(answer.fallback_model.as_deref(), Some("claude-sonnet-5-5"));
+}
+
+#[test]
+fn an_answer_without_a_fallback_has_none() {
+    let answer = parse_side_question_answer(&json!({
+        "status": "answered", "answer": "Yes.", "synthetic": false,
+    }))
+    .expect("answered");
+    assert_eq!(answer.fallback_model, None);
+}
+
+/// Hostile: `answered` with no text must not show an empty card as if the model said nothing.
+#[test]
+fn an_answered_status_without_text_is_an_error() {
+    let error = parse_side_question_answer(&json!({ "status": "answered" }))
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("without an answer"), "{error}");
+}
+
+#[test]
+fn every_other_status_reads_as_words() {
+    let read = |answer| parse_side_question_answer(&answer).unwrap_err().to_string();
+    assert_eq!(
+        read(json!({ "status": "no_answer" })),
+        "The side question got no answer."
+    );
+    assert_eq!(
+        read(json!({ "status": "unsupported" })),
+        "This Claude Code version cannot answer side questions."
+    );
+    assert_eq!(
+        read(json!({ "status": "failed", "message": "rate limited" })),
+        "The side question failed: rate limited"
+    );
+    assert!(read(json!({ "status": "later" })).contains("unknown status"));
+}
