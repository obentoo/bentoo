+// Zeo next proposal §6.8 (ask 29): which composer messages are side questions. Filter:
+// `side_question_card`.
+
+use acp_thread::SIDE_QUESTION_MAX_CHARS;
+
+use super::{SideQuestionInvocation, side_question_invocation};
+
+#[test]
+fn a_question_after_the_command_is_asked() {
+    assert_eq!(
+        side_question_invocation("/btw what does this flag do?"),
+        Some(SideQuestionInvocation::Ask(
+            "what does this flag do?".into()
+        ))
+    );
+    // Leading whitespace and a newline after the command are still the command.
+    assert_eq!(
+        side_question_invocation("  /btw\nmultiline\nquestion  "),
+        Some(SideQuestionInvocation::Ask("multiline\nquestion".into()))
+    );
+}
+
+#[test]
+fn a_bare_command_asks_for_usage() {
+    assert_eq!(
+        side_question_invocation("/btw"),
+        Some(SideQuestionInvocation::Usage)
+    );
+    assert_eq!(
+        side_question_invocation("/btw   "),
+        Some(SideQuestionInvocation::Usage)
+    );
+}
+
+/// Hostile: only the whole first word counts, or `/btwx` and a prompt that merely mentions
+/// `/btw` would be taken out of the conversation.
+#[test]
+fn anything_else_is_not_a_side_question() {
+    assert_eq!(side_question_invocation("/btwx question"), None);
+    assert_eq!(side_question_invocation("please run /btw later"), None);
+    assert_eq!(side_question_invocation("/compact"), None);
+    assert_eq!(side_question_invocation(""), None);
+}
+
+#[test]
+fn a_question_longer_than_the_agent_takes_is_refused_here() {
+    let long = "x".repeat(SIDE_QUESTION_MAX_CHARS + 1);
+    assert_eq!(
+        side_question_invocation(&format!("/btw {long}")),
+        Some(SideQuestionInvocation::TooLong(SIDE_QUESTION_MAX_CHARS + 1))
+    );
+    let fits = "é".repeat(SIDE_QUESTION_MAX_CHARS);
+    assert!(matches!(
+        side_question_invocation(&format!("/btw {fits}")),
+        Some(SideQuestionInvocation::Ask(_))
+    ));
+}
