+/// Reads a `_claude/btw` answer (plus 0.38.0's `SideQuestionResult`) into the answer, or an
+/// error in words the user can act on: the card shows it as it is.
+fn parse_side_question_answer(answer: &serde_json::Value) -> Result<acp_thread::SideAnswer> {
+    match answer.get("status").and_then(|status| status.as_str()) {
+        Some("answered") => {
+            let text = answer
+                .get("answer")
+                .and_then(|text| text.as_str())
+                .ok_or_else(|| anyhow!("{CLAUDE_BTW_METHOD} answered without an answer"))?;
+            Ok(acp_thread::SideAnswer {
+                answer: text.to_string(),
+                fallback_model: answer
+                    .get("fallbackModel")
+                    .and_then(|model| model.as_str())
+                    .map(str::to_string),
+            })
+        }
+        Some("no_answer") => Err(anyhow!("The side question got no answer.")),
+        Some("unsupported") => Err(anyhow!(
+            "This Claude Code version cannot answer side questions."
+        )),
+        Some("failed") => Err(anyhow!(
+            "The side question failed: {}",
+            answer
+                .get("message")
+                .and_then(|message| message.as_str())
+                .unwrap_or("no reason given")
+        )),
+        other => Err(anyhow!(
+            "{CLAUDE_BTW_METHOD} answered an unknown status {other:?}"
+        )),
+    }
+}
+
 /// Reads a `_claude/tasks/output` result strictly: a missing or wrong-typed field is an
 /// error naming it, never a default value.
