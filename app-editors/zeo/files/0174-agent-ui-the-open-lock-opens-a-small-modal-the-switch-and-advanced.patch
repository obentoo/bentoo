@@ -0,0 +1,99 @@
+// Operator ask 15 of 2026-11-23: the open lock of an agent started outside the jail opens a
+// small modal -- this project's switch and Advanced -- instead of the whole Agent Sandbox page.
+// Filter: `quick_modal::`.
+use gpui::UpdateGlobal as _;
+use settings::SettingsStore;
+
+use crate::agent_jail_quick_modal::AgentJailQuickModal;
+
+use super::*;
+
+/// The sandbox settings of now (the same helper as `icon::sandbox_settings`, which is private).
+fn sandbox_settings(value: serde_json::Value, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&value.to_string(), cx)
+                .result()
+                .expect("settings");
+        })
+    });
+}
+
+fn record_opened_pages(cx: &mut TestAppContext) -> Arc<Mutex<Vec<String>>> {
+    let opened: Arc<Mutex<Vec<String>>> = Arc::default();
+    cx.update({
+        let opened = opened.clone();
+        move |cx| {
+            cx.on_action(move |action: &zed_actions::OpenSettingsAt, _| {
+                opened.lock().push(action.path.clone());
+            });
+        }
+    });
+    opened
+}
+
+fn quick_modal(win: &mut Win) -> Option<Entity<AgentJailQuickModal>> {
+    win.workspace.read_with(&mut win.cx, |workspace, cx| {
+        workspace.active_modal::<AgentJailQuickModal>(cx)
+    })
+}
+
+#[gpui::test]
+async fn quick_modal_opens_from_the_open_lock_instead_of_the_page(cx: &mut TestAppContext) {
+    let fs = init(cx);
+    cx.update(|cx| LaunchRegistry::register(record("/w/app", Reason::Off, None), cx));
+    let opened = record_opened_pages(cx);
+    let mut win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    let lock = win
+        .cx
+        .debug_bounds("ICON-LockOff")
+        .expect("the open lock is drawn");
+    win.cx
+        .simulate_click(lock.center(), gpui::Modifiers::default());
+    win.cx.run_until_parked();
+
+    let modal = quick_modal(&mut win).expect("the small modal is open");
+    assert!(opened.lock().is_empty(), "the page did not open");
+    assert!(
+        !modal.read_with(&mut win.cx, |modal, cx| modal.jail_on(cx)),
+        "its switch shows the jail off, as the settings have it"
+    );
+    assert!(win.cx.debug_bounds("agent-jail-quick-switch").is_some());
+
+    let advanced = win
+        .cx
+        .debug_bounds("agent-jail-quick-advanced")
+        .expect("Advanced is drawn");
+    win.cx
+        .simulate_click(advanced.center(), gpui::Modifiers::default());
+    win.cx.run_until_parked();
+    assert_eq!(
+        opened.lock().clone(),
+        vec![zed_actions::AGENT_JAIL_SETTINGS_PATH.to_string()],
+        "Advanced opens the full page"
+    );
+    assert!(quick_modal(&mut win).is_none(), "and closes the modal");
+}
+
+#[gpui::test]
+async fn quick_modal_switch_follows_the_setting(cx: &mut TestAppContext) {
+    let fs = init(cx);
+    cx.update(|cx| LaunchRegistry::register(record("/w/app", Reason::Off, None), cx));
+    let mut win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    let lock = win.cx.debug_bounds("ICON-LockOff").expect("open lock");
+    win.cx
+        .simulate_click(lock.center(), gpui::Modifiers::default());
+    win.cx.run_until_parked();
+    let modal = quick_modal(&mut win).expect("modal");
+
+    // Saved from anywhere -- here, the page in another window.
+    sandbox_settings(json!({ "agent_sandbox": { "enabled": true } }), &mut win.cx);
+    win.cx.run_until_parked();
+    assert!(
+        modal.read_with(&mut win.cx, |modal, cx| modal.jail_on(cx)),
+        "the switch reads the setting of now"
+    );
+}
