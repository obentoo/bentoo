@@ -0,0 +1,134 @@
+//! The lock's small modal (operator ask 15 of 2026-11-23): clicking the lock of an agent started
+//! outside the jail opened the whole Agent Sandbox page -- folders, hosts, limits, host view,
+//! capabilities -- when all the operator wanted was to turn the jail on. The modal holds only
+//! this project's switch and "Advanced…", which opens the full page. A jail already on keeps the
+//! old click (the page), and a pending change keeps the restart.
+
+use std::path::PathBuf;
+
+use agent_sandbox::{AgentSandboxSettings, LaunchRegistry, launch};
+use gpui::{
+    App, Context, DismissEvent, EventEmitter, FocusHandle, Focusable, Render, Subscription, Window,
+};
+use project::agent_server_store::AgentId;
+use settings::{Settings as _, SettingsStore};
+use ui::{SwitchField, ToggleState, prelude::*};
+use workspace::ModalView;
+
+pub const QUICK_MODAL_TITLE: &str = "Agent Sandbox";
+pub const QUICK_SWITCH_LABEL: &str = "Run agents in ai-jail for this project";
+pub const QUICK_SWITCH_HINT: &str =
+    "Applies when the agent restarts: click the lock again once it turns amber.";
+pub const QUICK_ADVANCED: &str = "Advanced\u{2026}";
+
+pub struct AgentJailQuickModal {
+    agent_id: AgentId,
+    root: PathBuf,
+    focus_handle: FocusHandle,
+    _settings: Subscription,
+}
+
+impl AgentJailQuickModal {
+    pub fn new(agent_id: AgentId, root: PathBuf, cx: &mut Context<Self>) -> Self {
+        Self {
+            agent_id,
+            root,
+            focus_handle: cx.focus_handle(),
+            // The switch shows the setting of now: a change saved from here, or from the page in
+            // another window, redraws it.
+            _settings: cx.observe_global::<SettingsStore>(|_, cx| cx.notify()),
+        }
+    }
+
+    /// Whether the next start of this thread's agent would be jailed, as the lock reads it.
+    pub fn jail_on(&self, cx: &App) -> bool {
+        LaunchRegistry::get(&self.agent_id, &self.root, cx)
+            .and_then(|record| {
+                launch::jailed_on_next_start(&record, AgentSandboxSettings::get_global(cx))
+            })
+            .unwrap_or(false)
+    }
+
+    fn open_advanced(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        window.dispatch_action(
+            Box::new(zed_actions::OpenSettingsAt {
+                path: zed_actions::AGENT_JAIL_SETTINGS_PATH.to_string(),
+                target: None,
+            }),
+            cx,
+        );
+        cx.emit(DismissEvent);
+    }
+}
+
+impl ModalView for AgentJailQuickModal {}
+
+impl EventEmitter<DismissEvent> for AgentJailQuickModal {}
+
+impl Focusable for AgentJailQuickModal {
+    fn focus_handle(&self, _cx: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl Render for AgentJailQuickModal {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let root = self.root.clone();
+        let switch = SwitchField::new(
+            "agent-jail-quick-switch",
+            Some(QUICK_SWITCH_LABEL),
+            Some(QUICK_SWITCH_HINT.into()),
+            self.jail_on(cx),
+            move |toggle, window, cx| {
+                log::info!(
+                    "agent_sandbox event=quick_modal_toggle on={}",
+                    *toggle == ToggleState::Selected
+                );
+                // The page's own path: only `enabled` is written, and turning off asks first.
+                agent_sandbox::confirm::set_project_enabled(
+                    &root,
+                    *toggle == ToggleState::Selected,
+                    window,
+                    cx,
+                )
+                .detach();
+            },
+        )
+        .tab_index(0);
+        v_flex()
+            .key_context("AgentJailQuickModal")
+            .debug_selector(|| "agent-jail-quick-modal".into())
+            .track_focus(&self.focus_handle)
+            .on_action(cx.listener(|_, _: &menu::Cancel, _, cx| cx.emit(DismissEvent)))
+            .elevation_3(cx)
+            .w(rems(30.))
+            .p_3()
+            .gap_2()
+            .child(Label::new(QUICK_MODAL_TITLE))
+            .child(
+                Label::new(self.root.to_string_lossy().into_owned())
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .buffer_font(cx),
+            )
+            .child(
+                div()
+                    .debug_selector(|| "agent-jail-quick-switch".into())
+                    .child(switch),
+            )
+            .child(
+                h_flex().justify_end().child(
+                    div()
+                        .debug_selector(|| "agent-jail-quick-advanced".into())
+                        .child(
+                            Button::new("agent-jail-quick-advanced", QUICK_ADVANCED)
+                                .label_size(LabelSize::Small)
+                                .tab_index(0_isize)
+                                .on_click(cx.listener(|this, _, window, cx| {
+                                    this.open_advanced(window, cx)
+                                })),
+                        ),
+                ),
+            )
+    }
+}
diff --git a/crates/agent_ui/src/agent_jail_quick_modal_tests.rs b/crates/agent_ui/src/agent_jail_quick_modal_tests.rs
