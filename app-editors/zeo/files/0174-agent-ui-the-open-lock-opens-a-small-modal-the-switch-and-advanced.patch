+    /// Opens the lock's small modal for `root` (ask 15 of 2026-11-23).
+    fn open_jail_quick_modal(&self, root: PathBuf) -> Box<dyn Fn(&mut Window, &mut App)> {
+        let workspace = self.workspace.clone();
+        let agent_id = self.agent_id.clone();
+        Box::new(move |window, cx| {
+            let (agent_id, root) = (agent_id.clone(), root.clone());
+            workspace
+                .update(cx, |workspace, cx| {
+                    workspace.toggle_modal(window, cx, |_window, cx| {
+                        crate::agent_jail_quick_modal::AgentJailQuickModal::new(agent_id, root, cx)
+                    });
+                })
+                .log_err();
+        })
+    }
+
     /// Restarts the agent so a changed sandbox setting applies (§6.50). The thread is resumed
