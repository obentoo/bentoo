diff --git a/crates/agent_ui/src/conversation_view/thread_view.rs b/crates/agent_ui/src/conversation_view/thread_view.rs
index 1f5de74..e9d3deb 100644
--- a/crates/agent_ui/src/conversation_view/thread_view.rs
+++ b/crates/agent_ui/src/conversation_view/thread_view.rs
@@ -3099,6 +3099,17 @@ impl ThreadView {
         self.elicitation_form_states.contains_key(id)
     }
 
+    #[cfg(test)]
+    pub(crate) fn elicitation_text_field(
+        &self,
+        id: &ElicitationEntryId,
+        field_name: &str,
+    ) -> Option<Entity<Editor>> {
+        self.elicitation_form_states
+            .get(id)?
+            .text_field_editor(field_name)
+    }
+
     fn submit_elicitation(
         &mut self,
         elicitation_id: ElicitationEntryId,
@@ -8046,6 +8057,19 @@ impl ThreadView {
         self.message_editor.read(cx).set_local_commands(commands);
     }
 
+    /// Mirrors the conversation's pending question into the composer's key
+    /// context. Read on every render rather than on the elicitation events, so
+    /// every way a question ends -- answered, declined, cancelled, the turn
+    /// stopped -- clears it without a path of its own. The conversation-wide
+    /// predicate is the one 0030's sidebar status reads, so the composer stops
+    /// sending exactly while the sidebar says "Waiting for Your Answer".
+    fn sync_question_pending(&self, cx: &App) {
+        let question_pending = self.conversation.read(cx).has_pending_elicitation();
+        self.message_editor
+            .read(cx)
+            .set_question_pending(question_pending);
+    }
+
     /// Whether this elicitation is drawn by the pinned card above the message
     /// editor rather than inline, in the conversation.
     ///
@@ -13534,6 +13558,7 @@ impl Render for ThreadView {
         // current availability of feedback/sharing, which can change between
         // renders (settings, connection state, feature flags).
         self.sync_local_commands(cx);
+        self.sync_question_pending(cx);
 
         let has_messages = self.list_state.item_count() > 0;
         let list_state = self.list_state.clone();
