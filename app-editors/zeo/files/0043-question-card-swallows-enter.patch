diff --git a/crates/agent_ui/src/conversation_view.rs b/crates/agent_ui/src/conversation_view.rs
index 32a0c86..607af91 100644
--- a/crates/agent_ui/src/conversation_view.rs
+++ b/crates/agent_ui/src/conversation_view.rs
@@ -5862,6 +5862,291 @@ pub(crate) mod tests {
         });
     }
 
+    /// A composer with a question from the agent still open, the default keymap
+    /// bound, and "hello" typed and focused. Returns the thread view and the
+    /// question's id.
+    async fn setup_question_pending_composer(
+        use_modifier_to_send: bool,
+        vim_mode: bool,
+        cx: &mut TestAppContext,
+    ) -> (
+        Entity<ThreadView>,
+        ElicitationEntryId,
+        &mut VisualTestContext,
+    ) {
+        init_test(cx);
+        cx.update(|cx| {
+            cx.update_flags(true, vec![AcpBetaFeatureFlag::NAME.to_string()]);
+            let bindings = settings::KeymapFile::load_asset_allow_partial_failure(
+                "keymaps/default-linux.json",
+                cx,
+            )
+            .expect("default keymap should load");
+            cx.bind_keys(bindings);
+            cx.update_global::<SettingsStore, _>(|store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings.agent.get_or_insert_default().use_modifier_to_send =
+                        Some(use_modifier_to_send);
+                    settings.vim_mode = Some(vim_mode);
+                });
+            });
+            if vim_mode {
+                vim::init(cx);
+                let mut vim_bindings =
+                    settings::KeymapFile::load_asset_allow_partial_failure("keymaps/vim.json", cx)
+                        .expect("vim keymap should load");
+                for binding in &mut vim_bindings {
+                    binding.set_meta(settings::KeybindSource::Vim.meta());
+                }
+                cx.bind_keys(vim_bindings);
+            }
+        });
+
+        let connection = PreloadedElicitationConnection::default();
+        let elicitation_id = connection.elicitation_id.clone();
+        let (conversation_view, cx) =
+            setup_conversation_view(StubAgentServer::new(connection), cx).await;
+        add_to_workspace_with_size(conversation_view.clone(), true, cx);
+        let elicitation_id = elicitation_id
+            .lock()
+            .clone()
+            .expect("connection should preload an elicitation");
+
+        let thread_view = active_thread(&conversation_view, cx);
+        thread_view.update_in(cx, |view, window, cx| {
+            view.message_editor.update(cx, |editor, cx| {
+                editor.set_text("hello", window, cx);
+            });
+            let focus = view.message_editor.focus_handle(cx);
+            window.focus(&focus, cx);
+        });
+        cx.run_until_parked();
+        (thread_view, elicitation_id, cx)
+    }
+
+    fn user_message_count(thread_view: &Entity<ThreadView>, cx: &VisualTestContext) -> usize {
+        thread_view.read_with(cx, |view, cx| {
+            view.thread
+                .read(cx)
+                .entries()
+                .iter()
+                .filter(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)))
+                .count()
+        })
+    }
+
+    fn composer_text(thread_view: &Entity<ThreadView>, cx: &VisualTestContext) -> String {
+        thread_view.read_with(cx, |view, cx| view.message_editor.read(cx).text(cx))
+    }
+
+    // Story 017: Enter in the composer must not send a message over a question the agent
+    // is still waiting on -- and must not insert a newline either.
+    #[gpui::test]
+    async fn test_question_pending_enter_sends_nothing(cx: &mut TestAppContext) {
+        let (thread_view, elicitation_id, cx) =
+            setup_question_pending_composer(false, false, cx).await;
+
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        assert_eq!(composer_text(&thread_view, cx), "hello");
+
+        // `ctrl-enter` (send and follow) is a send too.
+        cx.simulate_keystrokes("ctrl-enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        assert_eq!(composer_text(&thread_view, cx), "hello");
+
+        // Once the question is answered, Enter sends again.
+        let thread = thread_view.read_with(cx, |view, _| view.thread.clone());
+        thread.update(cx, |thread, cx| {
+            thread.cancel_elicitation(&elicitation_id, cx)
+        });
+        cx.run_until_parked();
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 1);
+        assert_eq!(composer_text(&thread_view, cx), "");
+    }
+
+    // Pinned on purpose, not by accident: a URL elicitation (open a link, finish in the
+    // browser) blocks Enter like a form question. 0043's reason holds for both -- a message
+    // sent over an open question is one the agent must reconcile with an answer it never
+    // got -- even though a URL question has no card to type into, and is drawn inline.
+    #[gpui::test]
+    async fn test_question_pending_url_elicitation_blocks_enter_too(cx: &mut TestAppContext) {
+        let (thread_view, form_id, cx) = setup_question_pending_composer(false, false, cx).await;
+        let thread = thread_view.read_with(cx, |view, _| view.thread.clone());
+        thread.update(cx, |thread, cx| thread.cancel_elicitation(&form_id, cx));
+        cx.run_until_parked();
+
+        let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+        let _response = thread.update(cx, |thread, cx| {
+            thread
+                .request_elicitation(
+                    acp_v2::CreateElicitationRequest::new(
+                        acp_v2::ElicitationUrlMode::new(
+                            acp_v2::ElicitationSessionScope::new(session_id),
+                            acp_v2::ElicitationId::new("url-1"),
+                            "https://example.com/complete",
+                        ),
+                        "Complete this in the browser",
+                    ),
+                    cx,
+                )
+                .expect("a URL elicitation should be accepted")
+        });
+        cx.run_until_parked();
+        let url_id = thread.read_with(cx, |thread, _| {
+            thread
+                .entries()
+                .iter()
+                .rev()
+                .find_map(|entry| match entry {
+                    AgentThreadEntry::Elicitation(id) => Some(id.clone()),
+                    _ => None,
+                })
+                .expect("the URL elicitation is an entry")
+        });
+
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        assert_eq!(composer_text(&thread_view, cx), "hello");
+
+        thread.update(cx, |thread, cx| thread.cancel_elicitation(&url_id, cx));
+        cx.run_until_parked();
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 1);
+    }
+
+    #[gpui::test]
+    async fn test_question_pending_swallows_the_modifier_send(cx: &mut TestAppContext) {
+        let (thread_view, _, cx) = setup_question_pending_composer(true, false, cx).await;
+
+        cx.simulate_keystrokes("ctrl-enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        assert_eq!(composer_text(&thread_view, cx), "hello");
+    }
+
+    // Vim's normal mode binds Enter to `agent::Chat` in a keymap loaded after the default
+    // one, so it needs its own `question_pending` block to be outranked.
+    #[gpui::test]
+    async fn test_question_pending_swallows_vim_normal_mode_enter(cx: &mut TestAppContext) {
+        let (thread_view, _, cx) = setup_question_pending_composer(false, true, cx).await;
+
+        // The composer opens in vim's normal mode -- and Escape there would cancel the
+        // turn, and the question with it.
+        cx.update(|window, _cx| {
+            assert!(
+                window
+                    .context_stack()
+                    .last()
+                    .is_some_and(|context| context.contains("VimControl")),
+                "the composer should start in vim's normal mode"
+            );
+        });
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+        assert_eq!(composer_text(&thread_view, cx), "hello");
+    }
+
+    // The block lives in the key binding, so the Send button -- which calls the same
+    // `send` its click listener does -- still sends while the question is open.
+    #[gpui::test]
+    async fn test_question_pending_send_button_still_sends(cx: &mut TestAppContext) {
+        let (thread_view, _, cx) = setup_question_pending_composer(false, false, cx).await;
+
+        thread_view.update_in(cx, |view, window, cx| view.send(window, cx));
+        cx.run_until_parked();
+        assert_eq!(user_message_count(&thread_view, cx), 1);
+    }
+
+    // The card's own Enter is untouched: Tab from its field to Submit, then Enter, answers.
+    #[gpui::test]
+    async fn test_question_pending_tab_enter_answers_the_card(cx: &mut TestAppContext) {
+        let (thread_view, elicitation_id, cx) =
+            setup_question_pending_composer(false, false, cx).await;
+
+        let field = thread_view.read_with(cx, |view, _| {
+            view.elicitation_text_field(&elicitation_id, "name")
+                .expect("the card should have a text field named `name`")
+        });
+        cx.update(|window, cx| {
+            field.update(cx, |editor, cx| editor.set_text("Ada", window, cx));
+            window.focus(&field.focus_handle(cx), cx);
+        });
+        cx.run_until_parked();
+        for key in ["tab", "enter"] {
+            cx.simulate_keystrokes(key);
+            cx.simulate_event(gpui::KeyUpEvent {
+                keystroke: gpui::Keystroke::parse(key).expect("valid keystroke"),
+            });
+            cx.run_until_parked();
+        }
+
+        thread_view.read_with(cx, |view, cx| {
+            let thread = view.thread.read(cx);
+            let (_, elicitation) = thread
+                .elicitation(&elicitation_id)
+                .expect("the question should still be in the thread");
+            assert!(
+                matches!(elicitation.status, ElicitationStatus::Accepted),
+                "Tab then Enter should have answered the question"
+            );
+        });
+        assert_eq!(user_message_count(&thread_view, cx), 0);
+    }
+
+    // 0005: a text answer can span lines. Enter in the card's field is `menu::Confirm`, so
+    // Shift-Enter -- the auto-height editor's newline -- is the only way to type a line
+    // break, and it must neither answer nor drop the question.
+    #[gpui::test]
+    async fn test_elicitation_text_field_shift_enter_inserts_a_newline(cx: &mut TestAppContext) {
+        let (thread_view, elicitation_id, cx) =
+            setup_question_pending_composer(false, false, cx).await;
+
+        let field = thread_view.read_with(cx, |view, _| {
+            view.elicitation_text_field(&elicitation_id, "name")
+                .expect("the card should have a text field named `name`")
+        });
+        cx.update(|window, cx| {
+            field.update(cx, |editor, cx| editor.set_text("first", window, cx));
+            field.update(cx, |editor, cx| {
+                editor.move_to_end(&editor::actions::MoveToEnd, window, cx)
+            });
+            window.focus(&field.focus_handle(cx), cx);
+        });
+        cx.run_until_parked();
+        cx.simulate_keystrokes("shift-enter");
+        cx.simulate_input("second");
+        cx.run_until_parked();
+
+        let text = cx.update(|_, cx| field.read(cx).text(cx));
+        assert_eq!(text, "first\nsecond");
+        let pending = |thread_view: &Entity<ThreadView>, cx: &VisualTestContext| {
+            thread_view.read_with(cx, |view, cx| {
+                view.thread
+                    .read(cx)
+                    .elicitation(&elicitation_id)
+                    .is_some_and(|(_, elicitation)| {
+                        matches!(elicitation.status, ElicitationStatus::Pending { .. })
+                    })
+            })
+        };
+        assert!(pending(&thread_view, cx), "Shift-Enter must not answer the question");
+
+        cx.simulate_keystrokes("enter");
+        cx.run_until_parked();
+        assert!(!pending(&thread_view, cx), "Enter still answers it");
+    }
+
