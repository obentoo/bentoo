--- /dev/null
+++ b/crates/zeo_i18n/locales/en-US/secrets.ftl
@@ -0,0 +1,20 @@
+### The Secrets settings page: settings_ui/src/pages/secrets_page.rs (patch 0180, USE ai-jail).
+### The English is the page's own, byte for byte. The page's title in the settings navigation
+### ("Secrets") stays English, as the Agent Sandbox page's does.
+
+secrets-title = Secrets
+secrets-intro = Secrets are kept in the system keyring, never in settings. Zeo shows only their last three characters. An MCP server reads one through azukari: put the reference in the server's env and start it with the command below.
+secrets-command-placeholder = <server command>
+secrets-empty = No secrets yet.
+secrets-loading = Loading…
+secrets-locked = locked
+secrets-copy-reference = Copy Reference
+secrets-delete = Delete
+secrets-add-or-replace = Add or replace
+secrets-field-service = service (e.g. github)
+secrets-field-account = account (e.g. token)
+secrets-field-value = value (visible while typed)
+secrets-save = Save
+secrets-type-value-first = Type the value first.
+secrets-saved = Saved { $reference }.
+secrets-deleted = Deleted { $reference }.
diff --git a/crates/zeo_i18n/locales/pt-BR/secrets.ftl b/crates/zeo_i18n/locales/pt-BR/secrets.ftl
new file mode 100644
index 0000000..73ecb8d
--- /dev/null
+++ b/crates/zeo_i18n/locales/pt-BR/secrets.ftl
@@ -0,0 +1,20 @@
+### The Secrets settings page in Brazilian Portuguese (patch 0180), translated by hand on
+### 2026-11-24; awaiting the operator's review as a native speaker. "service" and "account" in
+### the placeholders name the reference's two parts (secret://SERVICE/ACCOUNT).
+
+secrets-title = Segredos
+secrets-intro = Os segredos ficam no chaveiro do sistema, nunca nas configurações. O Zeo mostra só os três últimos caracteres. Um servidor MCP lê um deles pelo azukari: ponha a referência no env do servidor e inicie-o com o comando abaixo.
+secrets-command-placeholder = <comando do servidor>
+secrets-empty = Nenhum segredo ainda.
+secrets-loading = Carregando…
+secrets-locked = bloqueado
+secrets-copy-reference = Copiar referência
+secrets-delete = Apagar
+secrets-add-or-replace = Adicionar ou substituir
+secrets-field-service = serviço (ex.: github)
+secrets-field-account = conta (ex.: token)
+secrets-field-value = valor (visível enquanto é digitado)
+secrets-save = Salvar
+secrets-type-value-first = Digite o valor primeiro.
+secrets-saved = { $reference } salvo.
+secrets-deleted = { $reference } apagado.
