+// ── Hostile converse: no other flag is opened (R7.4) ───────────────────────
+
+#[gpui::test]
+fn acp_beta_switch_opens_no_other_flag_in_a_non_staff_build(cx: &mut App) {
+    if !acp_beta_in_non_staff_process("acp_beta_switch_opens_no_other_flag_in_a_non_staff_build") {
+        return;
+    }
+    acp_beta_settings(cx);
+    let store = FeatureFlagStore::default();
+    acp_beta_set(AcpBetaFeatureFlag::NAME, Some("off"), cx);
+    acp_beta_set(DiffReviewFeatureFlag::NAME, Some("on"), cx);
+    acp_beta_set(SandboxingFeatureFlag::NAME, Some("off"), cx);
+
+    assert!(
+        !store.has_flag::<DiffReviewFeatureFlag>(cx),
+        "another flag's override stays a staff-only affordance"
