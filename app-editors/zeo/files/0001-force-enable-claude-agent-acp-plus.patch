new file mode 100644
index 0000000..8886175
--- /dev/null
+++ b/crates/feature_flags/src/acp_beta_switch_tests.rs
@@ -0,0 +1,233 @@
+// Story 064, task 8.1 (flag half) — the operator's off switch for the forced `acp-beta` (R7.1,
+// R7.2, R7.4). Module path: `store::acp_beta_switch`. Wired at the end of
+// `crates/feature_flags/src/store.rs`, after its `mod tests`, as
+//
+//     #[cfg(test)]
+//     #[path = "acp_beta_switch_tests.rs"]
+//     mod acp_beta_switch;
+//
+// Validation filter: `cargo test -p feature_flags acp_beta`.
+//
+// Contract (design.md §Feature flag switch; story.md R7): `AcpBetaFeatureFlag` stays
+// `enabled_for_all` (0001), but `has_flag::<AcpBetaFeatureFlag>()` first reads the settings'
+// `feature_flags` map for `acp-beta`, even when `overrides_enabled()` is false; every other flag
+// keeps upstream's gate (honoured only in debug or staff builds; `enabled_for_all` still wins).
+// The connection reads the flag through `FeatureFlagAppExt::has_flag` (`agent_servers/src/acp.rs`
+// `connect`), so that reader is exercised too.
+// Assumed beyond design.md: `flag_value::<AcpBetaFeatureFlag>()` agrees with `has_flag` (both are
+// built on `try_flag_value`); a reader that says on while the other says off would be two answers
+// to one switch.
+//
+// A release build cannot be compiled into a debug test, so the non-staff rows run in a CHILD
+// PROCESS of this test binary with `ZED_DISABLE_STAFF=1`: there `overrides_enabled()` is false, as
+// for a non-staff user of a release build (`store.rs`: `(cfg!(debug_assertions) || staff) &&
+// !ZED_DISABLE_STAFF`). `ZED_DISABLE_STAFF` is a `LazyLock` read once per process, which is why a
+// process and not an env var set mid-test. The child is the same `#[test]`, selected with
+// `--exact`, and the parent fails unless the child reports exactly one passed test.
+//
+// Hostile halves first:
+//   - `acp-beta: off` must read off — in a debug build, and in a non-staff build where no other
+//     override is honoured (today `enabled_for_all` wins over it in both);
+//   - converse, the switch must not open other flags: in a non-staff build `diff-review: on` stays
+//     off, and `sandboxing: off` stays on in every build (another `enabled_for_all` flag);
+//   - then the default (on, R7.1), the switch taking effect for the next read, and the readers
+//     agreeing.
+
+use gpui::{App, UpdateGlobal as _};
+use settings::SettingsStore;
+
+use crate::{
+    AcpBetaFeatureFlag, DiffReviewFeatureFlag, FeatureFlag, FeatureFlagAppExt as _,
+    FeatureFlagStore, FeatureFlagsSettings, PresenceFlag, SandboxingFeatureFlag, ZED_DISABLE_STAFF,
+};
+
+const ACP_BETA_NON_STAFF_CHILD: &str = "ZEO_064_ACP_BETA_NON_STAFF_CHILD";
+
+fn acp_beta_settings(cx: &mut App) {
+    let mut store = SettingsStore::test(cx);
+    store.register_setting::<FeatureFlagsSettings>();
+    cx.set_global(store);
+    FeatureFlagStore::init(cx);
+}
+
+fn acp_beta_set(name: &str, value: Option<&str>, cx: &mut App) {
+    SettingsStore::update_global(cx, |store: &mut SettingsStore, cx| {
+        store.update_user_settings(cx, |content| {
+            let map = content.feature_flags.get_or_insert_default();
+            match value {
+                Some(value) => {
+                    map.insert(name.to_string(), value.to_string());
+                }
+                None => {
+                    map.remove(name);
+                }
+            }
+        });
+    });
+}
+
+/// `true` in the non-staff child, where the caller runs its body; in the parent it runs the
+/// child, asserts it passed, and returns `false`.
+// A blocking wait is the point here: the test cannot go on until its child process has answered.
+#[allow(clippy::disallowed_methods)]
+fn acp_beta_in_non_staff_process(test_name: &str) -> bool {
+    if std::env::var_os(ACP_BETA_NON_STAFF_CHILD).is_some() {
+        assert!(
+            *ZED_DISABLE_STAFF,
+            "the child runs with ZED_DISABLE_STAFF=1"
+        );
+        return true;
+    }
+    let module = module_path!().split_once("::").map_or("", |(_, rest)| rest);
+    let exact = format!("{module}::{test_name}");
+    let binary = std::env::current_exe().expect("the test binary's path");
+    let output = std::process::Command::new(binary)
+        .args([exact.as_str(), "--exact", "--nocapture", "--test-threads=1"])
+        .env(ACP_BETA_NON_STAFF_CHILD, "1")
+        .env("ZED_DISABLE_STAFF", "1")
+        .output()
+        .expect("the test binary runs again as a child");
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(
+        output.status.success(),
+        "non-staff run of {exact} failed:\n{stdout}\n{stderr}"
+    );
+    assert!(
+        stdout.contains("1 passed"),
+        "the child ran exactly {exact}, not zero tests:\n{stdout}"
+    );
+    false
+}
