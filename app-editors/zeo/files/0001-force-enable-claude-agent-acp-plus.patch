+#[gpui::test]
+fn acp_beta_stays_on_by_default_in_a_non_staff_build(cx: &mut App) {
+    if !acp_beta_in_non_staff_process("acp_beta_stays_on_by_default_in_a_non_staff_build") {
+        return;
