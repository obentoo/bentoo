diff --git a/crates/agent_servers/src/acp/acp_beta_connect_tests.rs b/crates/agent_servers/src/acp/acp_beta_connect_tests.rs
new file mode 100644
index 0000000..4d596de
--- /dev/null
+++ b/crates/agent_servers/src/acp/acp_beta_connect_tests.rs
@@ -0,0 +1,223 @@
+// Story 064, task 8.1 (connection half) — with `acp-beta` switched off in the settings'
+// `feature_flags` map, the next agent connection is ACP v1 without the subagents capability, as
+// upstream connects a non-staff user (R7.2, R7.3); with it on (the default, R7.1) Zed negotiates v2
+// first. Module path: `acp::acp_beta_connect`. Wired at the end of
+// `crates/agent_servers/src/acp.rs`, after `mod selection_tests`, as
+//
+//     #[cfg(all(test, unix))]
+//     #[path = "acp/acp_beta_connect_tests.rs"]
+//     mod acp_beta_connect;
+//
+// Validation filter: `cargo test -p agent_servers connect` (names start `connect_`).
+//
+// Contract: `connect` (acp.rs) reads `cx.has_flag::<AcpBetaFeatureFlag>()` once per connection
+// and tries v2 only when it is on; `v1::connect` offers `clientCapabilities.subagents` only when
+// it is on (`client_capabilities_for_agent`). design.md §Feature flag switch: the flag reads the
+// settings map for `acp-beta`, so the switch applies to the next connection.
+// Note for task 8.1: `selection_tests::set_beta` asserts the flag is on whatever it is asked
+// (0001's comment); once the switch works that helper must assert `enabled` again, as upstream.
+// This file does not call it.
+//
+// The agent is a `/bin/sh` script, as in `selection_tests`, that traces each start, each
+// initialize's protocol version and whether a v1 initialize offered subagents. Hostile first:
+// off must give exactly one v1 initialize and no subagents offer; the converse — the default
+// with a v1-only agent — must show the offer on its v1 retry, which proves the trace can see an
+// offer at all (an offer the detector cannot see would make the first test pass vacuously); then
+// the switch between two connections, and the default's v2.
+
+use super::*;
+use gpui::{TestAppContext, UpdateGlobal as _};
+
+const AGENT_SCRIPT: &str = r#"
+printf 'start %s\n' "$$" >> "$ACP_BETA_TRACE"
+while IFS= read -r request; do
+    case "$request" in
+        *'"method":"initialize"'*)
+            id=${request#*\"id\":}; id=${id%%,*}
+            case "$request" in
+                *'"protocolVersion":2'*)
+                    printf 'initialize 2\n' >> "$ACP_BETA_TRACE"
+                    if [ "$ACP_BETA_ACCEPT_V2" = 1 ]; then
+                        printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":2,"info":{"name":"beta-v2","version":"1"},"capabilities":{"session":{}}}}\n' "$id"
+                    else
+                        printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":1,"agentCapabilities":{},"agentInfo":{"name":"beta-v1","version":"1"}}}\n' "$id"
+                    fi
+                    ;;
+                *)
+                    printf 'initialize 1\n' >> "$ACP_BETA_TRACE"
+                    case "$request" in
+                        *'"subagents"'*) printf 'subagents offered\n' >> "$ACP_BETA_TRACE" ;;
+                    esac
+                    printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":1,"agentCapabilities":{},"agentInfo":{"name":"beta-v1","version":"1"}}}\n' "$id"
+                    ;;
+            esac
+            ;;
+    esac
+done
+"#;
+
+fn connect_beta_init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let mut store = settings::SettingsStore::test(cx);
+        store.register_setting::<feature_flags::FeatureFlagsSettings>();
+        cx.set_global(store);
+        release_channel::init("0.0.0".parse().expect("version"), cx);
+        // The store global the connection reads; no server flag and no staff.
+        cx.update_flags(false, Vec::new());
+    });
+    cx.executor().allow_parking();
+}
+
+/// Sets (`Some`) or removes (`None`) the `acp-beta` entry of the user's `feature_flags` map.
+fn connect_beta_setting(value: Option<&str>, cx: &mut TestAppContext) {
+    let value = value.map(str::to_string);
+    cx.update(|cx| {
+        settings::SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, |settings| {
+                let map = settings.feature_flags.get_or_insert_default();
+                match value {
+                    Some(value) => {
+                        map.insert("acp-beta".into(), value);
+                    }
+                    None => {
+                        map.remove("acp-beta");
+                    }
+                }
+            });
+        });
+    });
+}
+
+/// One connection through `connect`; returns it and the agent's trace lines.
+async fn connect_beta_once(
+    project: &Entity<Project>,
+    trace: &std::path::Path,
+    accept_v2: bool,
+    cx: &mut TestAppContext,
+) -> (Rc<dyn acp_thread::AgentConnection>, Vec<String>) {
+    std::fs::write(trace, "").expect("clear trace");
+    let command = AgentServerCommand {
+        path: "/bin/sh".into(),
+        args: vec!["-c".into(), AGENT_SCRIPT.into()],
+        env: Some(HashMap::from_iter([
+            (
+                "ACP_BETA_TRACE".into(),
+                trace.to_string_lossy().into_owned(),
+            ),
+            (
+                "ACP_BETA_ACCEPT_V2".into(),
+                if accept_v2 { "1" } else { "0" }.into(),
+            ),
+        ])),
+    };
+    let connecting = cx.spawn({
+        let project = project.clone();
+        async move |mut cx| {
+            connect(
+                AgentId::new("acp-beta-switch"),
+                project,
+                command,
+                WeakEntity::new_invalid(),
+                None,
+                HashMap::default(),
+                &mut cx,
+            )
+            .await
+        }
+    });
+    let timeout = cx
+        .background_executor
+        .timer(std::time::Duration::from_secs(10));
+    futures::pin_mut!(connecting, timeout);
+    let connection = match futures::future::select(connecting, timeout).await {
+        futures::future::Either::Left((result, _)) => result.expect("the scripted agent connects"),
+        _ => panic!("connect timed out"),
+    };
+    let lines = std::fs::read_to_string(trace)
+        .expect("connection trace")
+        .lines()
+        .filter(|line| !line.starts_with("start "))
+        .map(str::to_string)
+        .collect();
+    (connection, lines)
+}
+
+fn connect_beta_is_v2(connection: &Rc<dyn acp_thread::AgentConnection>) -> bool {
+    connection.clone().downcast::<AcpV2Connection>().is_some()
+}
+
+// ── Hostile: off is v1, and no subagents are offered ───────────────────────
+
+#[gpui::test]
+async fn connect_with_acp_beta_off_offers_v1_without_subagents(cx: &mut TestAppContext) {
+    connect_beta_init(cx);
+    let directory = tempfile::tempdir().expect("working directory");
+    let project = Project::example([directory.path()], &mut cx.to_async()).await;
+    let trace = directory.path().join("trace");
+    connect_beta_setting(Some("off"), cx);
+
+    // An agent that would accept v2: only the flag can keep Zed on v1.
+    let (connection, lines) = connect_beta_once(&project, &trace, true, cx).await;
+
+    assert_eq!(
+        lines,
+        ["initialize 1"],
+        "one v1 initialize, no v2 attempt and no subagents offer"
+    );
+    assert!(!connect_beta_is_v2(&connection), "a v1 connection");
+    connection.shutdown();
+}
+
+// Converse, and the detector's own check: with the default, a v1-only agent is retried on v1 and
+// that initialize DOES offer subagents.
+#[gpui::test]
+async fn connect_with_acp_beta_default_offers_subagents_on_the_v1_retry(cx: &mut TestAppContext) {
+    connect_beta_init(cx);
+    let directory = tempfile::tempdir().expect("working directory");
+    let project = Project::example([directory.path()], &mut cx.to_async()).await;
+    let trace = directory.path().join("trace");
+
+    let (connection, lines) = connect_beta_once(&project, &trace, false, cx).await;
+
+    assert_eq!(
+        lines,
+        ["initialize 2", "initialize 1", "subagents offered"],
+        "v2 first, then the v1 retry offering subagents"
+    );
+    assert!(!connect_beta_is_v2(&connection));
+    connection.shutdown();
+}
+
+// ── The switch between connections (R7.2: "for the next agent connection") ──
+
+#[gpui::test]
+async fn connect_after_switching_acp_beta_off_uses_v1_for_the_next_connection(
+    cx: &mut TestAppContext,
+) {
+    connect_beta_init(cx);
+    let directory = tempfile::tempdir().expect("working directory");
+    let project = Project::example([directory.path()], &mut cx.to_async()).await;
+    let trace = directory.path().join("trace");
+
+    let (first, lines) = connect_beta_once(&project, &trace, true, cx).await;
+    assert_eq!(lines, ["initialize 2"], "precondition: the default is v2");
+    assert!(connect_beta_is_v2(&first));
+
+    connect_beta_setting(Some("off"), cx);
+    assert!(
+        connect_beta_is_v2(&first),
+        "a live connection is not renegotiated by the switch"
+    );
+    let (second, lines) = connect_beta_once(&project, &trace, true, cx).await;
+    assert_eq!(lines, ["initialize 1"], "the next connection is v1");
+    assert!(!connect_beta_is_v2(&second));
+
+    connect_beta_setting(None, cx);
+    let (third, lines) = connect_beta_once(&project, &trace, true, cx).await;
+    assert_eq!(lines, ["initialize 2"], "removing the entry restores v2");
+    assert!(connect_beta_is_v2(&third));
+
+    for connection in [first, second, third] {
+        connection.shutdown();
+    }
+}
