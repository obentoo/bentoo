+    acp_beta_set(AcpBetaFeatureFlag::NAME, Some("off"), cx);
+    acp_beta_set(DiffReviewFeatureFlag::NAME, Some("on"), cx);
+    acp_beta_set(SandboxingFeatureFlag::NAME, Some("off"), cx);
+
+    assert!(
