+    ) {
+        return;
+    }
+    acp_beta_settings(cx);
+    let store = FeatureFlagStore::default();
+    assert!(
+        !store.overrides_enabled(),
+        "precondition: a non-staff build honours no override"
+    );
+    assert!(store.has_flag::<AcpBetaFeatureFlag>(cx), "precondition: on");
+
+    acp_beta_set(AcpBetaFeatureFlag::NAME, Some("off"), cx);
+
+    assert!(
+        !store.has_flag::<AcpBetaFeatureFlag>(cx),
+        "acp-beta's off is honoured where no other override is"
+    );
+    assert!(!cx.has_flag::<AcpBetaFeatureFlag>());
+}
