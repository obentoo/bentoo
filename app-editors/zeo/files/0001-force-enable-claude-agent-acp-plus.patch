+// No restart: the next read after the settings change answers off, and on again once the entry
+// is gone. The connection reads it once per connection, so this is "the next connection".
+#[gpui::test]
+fn acp_beta_switch_applies_to_the_next_read_and_reverts(cx: &mut App) {
+    acp_beta_settings(cx);
+    assert!(cx.has_flag::<AcpBetaFeatureFlag>());
+
+    acp_beta_set(AcpBetaFeatureFlag::NAME, Some("off"), cx);
+    assert!(!cx.has_flag::<AcpBetaFeatureFlag>(), "off at the next read");
+    assert_eq!(
+        cx.flag_value::<AcpBetaFeatureFlag>(),
+        PresenceFlag::Off,
+        "every reader of the flag gives the same answer"
+    );
+
+    acp_beta_set(AcpBetaFeatureFlag::NAME, None, cx);
+    assert!(
+        cx.has_flag::<AcpBetaFeatureFlag>(),
+        "removing the entry restores the forced default"
+    );
+    assert_eq!(cx.flag_value::<AcpBetaFeatureFlag>(), PresenceFlag::On);
+}
