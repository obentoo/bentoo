+    #[test]
+    fn test_parse_config_listing_refuses_invalid_utf8_and_oversized_output() {
+        assert!(matches!(
+            parse_config_listing(b"core.bare\n\xff\0"),
+            Err(UnsafeWorktreeConfig::Unreadable { .. })
+        ));
+        let huge = vec![b'a'; MAX_CONFIG_LISTING_BYTES];
+        assert!(matches!(
+            parse_config_listing(&huge),
+            Err(UnsafeWorktreeConfig::Unreadable { .. })
+        ));
+    }
