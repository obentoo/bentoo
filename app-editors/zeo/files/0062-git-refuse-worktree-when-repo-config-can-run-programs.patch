+    #[cfg(unix)]
+    #[test]
+    fn test_unreadable_git_directory_is_refused() {
+        use std::os::unix::fs::PermissionsExt as _;
+
+        let dir = tempfile::tempdir().unwrap();
+        let git_dir = dir.path().join(".git");
+        std::fs::create_dir(&git_dir).unwrap();
+        std::fs::write(git_dir.join("config"), "[core]\n\tbare = false\n").unwrap();
+        assert_eq!(check_readable(&git_dir, &git_dir), Ok(()));
+
+        std::fs::set_permissions(
+            git_dir.join("config"),
+            std::fs::Permissions::from_mode(0o000),
+        )
+        .unwrap();
+        let refused = check_readable(&git_dir, &git_dir);
+        std::fs::set_permissions(
+            git_dir.join("config"),
+            std::fs::Permissions::from_mode(0o644),
+        )
+        .unwrap();
+        assert!(
+            matches!(refused, Err(UnsafeWorktreeConfig::Unreadable { .. })),
+            "{refused:?}"
+        );
+
+        std::fs::set_permissions(&git_dir, std::fs::Permissions::from_mode(0o000)).unwrap();
+        let refused = check_readable(&git_dir, &git_dir);
+        std::fs::set_permissions(&git_dir, std::fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(
+            matches!(refused, Err(UnsafeWorktreeConfig::Unreadable { .. })),
+            "{refused:?}"
+        );
+    }
