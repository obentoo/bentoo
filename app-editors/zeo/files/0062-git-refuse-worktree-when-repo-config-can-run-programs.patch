+    #[test]
+    fn test_conditional_include_is_refused() {
+        assert_eq!(
+            screen(&[("includeIf.gitdir:~/work/.path", Some("~/work.gitconfig"))]),
+            Err(UnsafeWorktreeConfig::ConditionalInclude {
+                key: "includeIf.gitdir:~/work/.path".to_string()
+            })
+        );
+        // git lowercases the section name in its listing.
+        assert!(matches!(
+            screen(&[("includeif.onbranch:main.path", Some("x"))]),
+            Err(UnsafeWorktreeConfig::ConditionalInclude { .. })
+        ));
