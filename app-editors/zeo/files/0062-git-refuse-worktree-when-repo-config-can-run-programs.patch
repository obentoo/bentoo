+        ConfigEntry {
+            key: key.to_string(),
+            value: value.map(str::to_string),
+        }
+    }
+
+    fn screen(entries: &[(&str, Option<&str>)]) -> Result<(), UnsafeWorktreeConfig> {
+        let entries: Vec<_> = entries.iter().map(|(k, v)| entry(k, *v)).collect();
+        screen_config_entries(&entries)
+    }
+
+    #[test]
+    fn test_parse_config_listing_splits_keys_values_and_valueless_keys() {
+        let listing = b"core.bare\nfalse\0user.note\nline one\nline two\0core.flag\0";
+        assert_eq!(
+            parse_config_listing(listing).unwrap(),
+            vec![
+                entry("core.bare", Some("false")),
+                entry("user.note", Some("line one\nline two")),
+                entry("core.flag", None),
+            ]
+        );
+    }
