@@ -0,0 +1,452 @@
+//! Screens a repository's own git config before `git worktree add` runs.
+//!
+//! `git worktree add` checks out a whole tree, and a checkout runs whatever
+//! programs the repository's config names for it: filter drivers
+//! (`filter.<name>.clean`/`smudge`/`process`), and, through the `lfs` filter,
+//! Git LFS's custom transfer agents and extensions. Repository-local config is
+//! not versioned, so whoever wrote it — a tool, a script, a checkout the user
+//! does not trust — chose those programs, not the user.
+//!
+//! The rule mirrors the Claude Code VS Code extension (2.1.289–2.1.296), which
+//! refuses the same keys, plus filter drivers, which it neutralises with
+//! `-c filter.<name>.clean=` overrides rather than refusing. Refusing is the
+//! stricter choice and the one taken here: a checkout with its filters switched
+//! off writes the unfiltered blobs (an LFS pointer instead of the file) into a
+//! worktree an agent then edits as if it were the real content.
+//!
+//! Not screened, because `GitBinary::build_command` already overrides them on
+//! every command it builds: `core.fsmonitor` (always), and `core.hooksPath`,
+//! `core.sshCommand`, `credential.helper`, `diff.external` (untrusted
+//! repositories).
+
+use crate::repository::GitBinary;
+use anyhow::Result;
+use std::fmt;
+use std::path::Path;
+
+/// A git config listing larger than this is refused rather than parsed.
+const MAX_CONFIG_LISTING_BYTES: usize = 1024 * 1024;
+
+const ADVICE: &str = "If that setting is yours, move it to your global git config \
+    (`git config --global`); if you don't recognize it, remove it from the repository's \
+    config, since a tool or checkout you don't trust may have written it.";
+
+/// Why a worktree was not created. Its `Display` is the message shown to the
+/// user, and names the offending key so it can be found and removed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UnsafeWorktreeConfig {
+    /// The repository's git directory or config could not be read, so it
+    /// could not be checked.
+    Unreadable { detail: String },
+    /// `includeIf.<condition>.path` loads further config only under a
+    /// condition, so what it loads at checkout time cannot be checked now.
+    ConditionalInclude { key: String },
+    /// `filter.<name>.clean`, `.smudge` or `.process` names a program the
+    /// checkout would run.
+    FilterDriver { key: String },
+    /// A Git LFS setting that names a program LFS would run during checkout.
+    LfsProgram { key: String },
+}
+
+impl fmt::Display for UnsafeWorktreeConfig {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Unreadable { detail } => write!(
+                f,
+                "Refused to create the worktree: this repository's git directory or config \
+                 could not be read, so it could not be checked for programs git would run \
+                 while creating the worktree ({detail}). Make the repository's .git readable \
+                 and try again."
+            ),
+            Self::ConditionalInclude { key } => write!(
+                f,
+                "Refused to create the worktree: this repository's git config sets `{}`, an \
+                 includeIf setting that can load other settings which cannot be checked for \
+                 programs git would run while creating the worktree. {ADVICE}",
+                display_key(key)
+            ),
+            Self::FilterDriver { key } => write!(
+                f,
+                "Refused to create the worktree: this repository's git config sets `{}`, a \
+                 filter driver git would run while checking out the worktree. {ADVICE}",
+                display_key(key)
+            ),
+            Self::LfsProgram { key } => write!(
+                f,
+                "Refused to create the worktree: this repository's git config sets `{}`, a \
+                 program Git LFS would run while checking out the worktree. {ADVICE}",
+                display_key(key)
+            ),
+        }
+    }
+}
+
+impl std::error::Error for UnsafeWorktreeConfig {}
+
+/// A key as read from the config, made safe to print: control characters
+/// escaped, and a very long key cut in the middle.
+fn display_key(key: &str) -> String {
+    let escaped: String = key.escape_debug().collect();
+    let chars: Vec<char> = escaped.chars().collect();
+    if chars.len() <= 100 {
+        return escaped;
+    }
+    let head: String = chars[..60].iter().collect();
+    let tail: String = chars[chars.len() - 40..].iter().collect();
+    format!("{head}…{tail}")
+}
+
+/// One `git config -z --list` entry. `value` is `None` for a key written
+/// without `=`, which git reads as boolean true.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ConfigEntry {
+    pub key: String,
+    pub value: Option<String>,
+}
+
+/// Parses the output of `git config -z --list`: entries end in NUL, and a key
+/// is separated from its value by the first newline.
+pub fn parse_config_listing(stdout: &[u8]) -> Result<Vec<ConfigEntry>, UnsafeWorktreeConfig> {
+    if stdout.len() >= MAX_CONFIG_LISTING_BYTES {
+        return Err(UnsafeWorktreeConfig::Unreadable {
+            detail: format!(
+                "the config listing is {} bytes or larger",
+                MAX_CONFIG_LISTING_BYTES
+            ),
+        });
+    }
+    let text = std::str::from_utf8(stdout).map_err(|_| UnsafeWorktreeConfig::Unreadable {
+        detail: "the config is not valid UTF-8".to_string(),
+    })?;
+    Ok(text
+        .split('\0')
+        .filter(|entry| !entry.is_empty())
+        .map(|entry| match entry.split_once('\n') {
+            Some((key, value)) => ConfigEntry {
+                key: key.to_string(),
+                value: Some(value.to_string()),
+            },
+            None => ConfigEntry {
+                key: entry.to_string(),
+                value: None,
+            },
+        })
+        .collect())
+}
+
+/// Refuses the first entry that names a program a checkout would run.
+pub fn screen_config_entries(entries: &[ConfigEntry]) -> Result<(), UnsafeWorktreeConfig> {
+    for entry in entries {
+        let key = entry.key.to_lowercase();
+
+        if key.starts_with("includeif.") && key.ends_with(".path") {
+            return Err(UnsafeWorktreeConfig::ConditionalInclude {
+                key: entry.key.clone(),
+            });
+        }
+
+        if is_lfs_program_key(&key) {
+            return Err(UnsafeWorktreeConfig::LfsProgram {
+                key: entry.key.clone(),
+            });
+        }
+
+        // Git LFS reads `git config --list` line by line, so a value holding a
+        // newline can smuggle a second `key=value` line past git's own parser.
+        if let Some(value) = &entry.value {
+            for line in value.lines().skip(1) {
+                if let Some((smuggled, _)) = line.split_once('=')
+                    && is_lfs_program_key(&smuggled.trim().to_lowercase())
+                {
+                    return Err(UnsafeWorktreeConfig::LfsProgram {
+                        key: entry.key.clone(),
+                    });
+                }
+            }
+        }
+
+        if key.starts_with("filter.")
+            && (key.ends_with(".clean") || key.ends_with(".smudge") || key.ends_with(".process"))
+            // An empty value is how a driver is switched off.
+            && entry.value.as_deref().is_some_and(|value| !value.trim().is_empty())
+        {
+            return Err(UnsafeWorktreeConfig::FilterDriver {
+                key: entry.key.clone(),
+            });
+        }
+    }
+    Ok(())
+}
+
+/// The VS Code extension's rule, as a lowercase key match:
+/// `lfs.customtransfer.<name>.path`, `lfs.[<url>.]standalonetransferagent`,
+/// and anything under `lfs.extension.`.
+fn is_lfs_program_key(key: &str) -> bool {
+    (key.starts_with("lfs.customtransfer.") && key.ends_with(".path"))
+        || (key.starts_with("lfs.")
+            && (key == "lfs.standalonetransferagent" || key.ends_with(".standalonetransferagent")))
+        || key.starts_with("lfs.extension.")
+}
+
+/// Reads the repository's local config (and its per-worktree config, when
+/// `extensions.worktreeConfig` is on), following `include.path`, and refuses
+/// anything `screen_config_entries` refuses.
+pub(crate) async fn screen_repository_config(
+    git: &GitBinary,
+    git_dir: &Path,
+    common_dir: &Path,
+) -> Result<()> {
+    check_readable(git_dir, common_dir)?;
+
+    let mut entries = read_config_scope(git, "--local").await?;
+    let worktree_config = entries.iter().any(|entry| {
+        entry.key.eq_ignore_ascii_case("extensions.worktreeconfig")
+            && entry.value.as_deref().is_none_or(|value| {
+                matches!(
+                    value.trim().to_lowercase().as_str(),
+                    "true" | "yes" | "on" | "1"
+                )
+            })
+    });
+    if worktree_config {
+        entries.extend(read_config_scope(git, "--worktree").await?);
+    }
+
+    screen_config_entries(&entries)?;
+    Ok(())
+}
+
+/// Checked on the filesystem before asking git: when `.git` cannot be read,
+/// git's discovery may walk past it to an enclosing repository and answer for
+/// that one instead.
+fn check_readable(git_dir: &Path, common_dir: &Path) -> Result<(), UnsafeWorktreeConfig> {
+    std::fs::read_dir(git_dir).map_err(|error| UnsafeWorktreeConfig::Unreadable {
+        detail: format!("{}: {error}", git_dir.display()),
+    })?;
+    let config = common_dir.join("config");
+    match std::fs::File::open(&config) {
+        Ok(_) => Ok(()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(UnsafeWorktreeConfig::Unreadable {
+            detail: format!("{}: {error}", config.display()),
+        }),
+    }
+}
+
+async fn read_config_scope(git: &GitBinary, scope: &str) -> Result<Vec<ConfigEntry>> {
+    let output = git
+        .build_command(&["config", scope, "--includes", "-z", "--list"])
+        .env("LC_ALL", "C")
+        .output()
+        .await
+        .map_err(|error| UnsafeWorktreeConfig::Unreadable {
+            detail: format!("could not run git config {scope}: {error}"),
+        })?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        // A repository without a config file has nothing to screen.
+        if stderr.contains("unable to read config file") && stderr.contains("No such file") {
+            return Ok(Vec::new());
+        }
+        return Err(UnsafeWorktreeConfig::Unreadable {
+            detail: format!("git config {scope} failed: {}", stderr.trim()),
+        }
+        .into());
+    }
+    Ok(parse_config_listing(&output.stdout)?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
