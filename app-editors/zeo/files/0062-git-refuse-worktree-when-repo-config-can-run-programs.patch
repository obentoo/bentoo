+    #[test]
+    fn test_message_names_the_key_and_says_what_to_do() {
+        let message = UnsafeWorktreeConfig::FilterDriver {
+            key: "filter.lfs.smudge".to_string(),
+        }
+        .to_string();
+        assert!(message.contains("`filter.lfs.smudge`"), "{message}");
+        assert!(message.contains("global git config"), "{message}");
+
+        let message = UnsafeWorktreeConfig::LfsProgram {
+            key: format!("lfs.extension.{}\u{1b}[31m.path", "x".repeat(200)),
+        }
+        .to_string();
+        assert!(
+            !message.contains('\u{1b}'),
+            "control characters are escaped"
+        );
+        assert!(message.contains('…'), "a long key is shortened");
+    }
