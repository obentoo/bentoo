+agent-sandbox-list-add-to = Добавить в { $list }
+agent-sandbox-list-remove = Удалить { $entry }
+agent-sandbox-choose-folder = Выбрать папку…
+agent-sandbox-choose-folder-prompt = Добавить папку с правом записи
