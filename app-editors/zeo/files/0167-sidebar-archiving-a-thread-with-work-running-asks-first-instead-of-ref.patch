+    /// Operator ask of 2026-11-23: archiving a thread whose turn, subagents or background tasks
+    /// still run asks first, in a modal, as stopping a turn does. On "Archive" the turn is
+    /// stopped and the thread archived; "Keep It" leaves both alone.
+    fn confirm_archive_running_thread(
+        &mut self,
+        session_id: acp::SessionId,
+        thread_id: ThreadId,
+        workspace: ThreadEntryWorkspace,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let reason = match &workspace {
+            ThreadEntryWorkspace::Open(workspace) => {
+                archive_refusal_reason(workspace, &session_id, cx)
+            }
+            ThreadEntryWorkspace::Closed { .. } => None,
+        }
+        .unwrap_or(ARCHIVE_CONFIRM_TURN);
+        let detail = format!(
+            "{reason}. Archiving stops its current turn; work it started in the background may \
+             keep running until the agent ends it."
+        );
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            "Archive a thread that is still working?",
+            Some(&detail),
+            &["Archive", "Keep It"],
+            cx,
+        );
+        cx.spawn_in(window, async move |this, cx| {
+            // Index 0 is "Archive"; `Err` is a prompt whose sender was dropped, which keeps it.
+            let confirmed = matches!(answer.await, Ok(0));
+            log::info!(
+                "sidebar event=archive_running_thread session_id={session_id} outcome={}",
+                if confirmed { "archived" } else { "kept" }
+            );
+            if !confirmed {
+                return;
+            }
+            this.update_in(cx, |this, window, cx| {
+                if let ThreadEntryWorkspace::Open(workspace) = &workspace
+                    && let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx)
+                {
+                    panel.update(cx, |panel, cx| panel.cancel_thread(&thread_id, cx));
+                }
+                this.archive_thread(&session_id, window, cx);
+            })
+            .log_err();
+        })
+        .detach();
+    }
+
+    /// The archive of the row menu and of the row's button: through the confirmation when the
+    /// thread has work running, straight to the archive otherwise.
+    fn archive_thread_or_ask(
+        &mut self,
+        session_id: &acp::SessionId,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let (_, thread_entry) = self.thread_to_archive(session_id, cx);
+        match thread_entry {
+            Some(thread)
+                if matches!(
+                    thread.status,
+                    AgentThreadStatus::Running
+                        | AgentThreadStatus::WaitingForConfirmation
+                        | AgentThreadStatus::Unconfirmed
+                        | AgentThreadStatus::Background
+                        | AgentThreadStatus::WaitingForAnswer
+                ) =>
+            {
+                self.confirm_archive_running_thread(
+                    session_id.clone(),
+                    thread.metadata.thread_id,
+                    thread.workspace.clone(),
+                    window,
+                    cx,
+                );
+            }
+            _ => self.archive_thread(session_id, window, cx),
+        }
+    }
+
     fn thread_to_archive(
         &self,
         session_id: &acp::SessionId,
