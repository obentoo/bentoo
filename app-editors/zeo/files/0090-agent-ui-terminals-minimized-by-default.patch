diff --git a/crates/agent_ui/src/terminals_minimized.rs b/crates/agent_ui/src/terminals_minimized.rs
new file mode 100644
index 0000000..d16961e
--- /dev/null
+++ b/crates/agent_ui/src/terminals_minimized.rs
@@ -0,0 +1,70 @@
+//! Zeo next proposal §6.17 (ask 37): an agent-menu toggle that starts every inline
+//! terminal minimized, so a long run of tool calls takes less of the conversation's
+//! scroll. It is upstream's `agent.expand_terminal_card` seen from the other side --
+//! "minimized" is "not expanded" -- so the menu owns no setting of its own, and a
+//! terminal already on screen keeps the state it has.
+
+use agent_settings::AgentSettings;
+use settings::SettingsContent;
+
+/// The agent-menu label, shared with the menu and its tests.
+pub(crate) const TERMINALS_MINIMIZED_MENU_LABEL: &str = "Terminals Minimized by Default";
+
+/// Whether the toggle shows checked.
+pub(crate) fn terminals_minimized_by_default(settings: &AgentSettings) -> bool {
+    !settings.expand_terminal_card
+}
+
+/// Writes the toggle's new state into the user's settings.
+pub(crate) fn set_terminals_minimized_by_default(settings: &mut SettingsContent, minimized: bool) {
+    settings.agent.get_or_insert_default().expand_terminal_card = Some(!minimized);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::UpdateGlobal as _;
+    use settings::Settings as _;
+
+    #[test]
+    fn minimized_is_the_terminal_card_not_expanded() {
+        let mut settings = SettingsContent::default();
+        set_terminals_minimized_by_default(&mut settings, true);
+        assert_eq!(
+            settings
+                .agent
+                .as_ref()
+                .and_then(|agent| agent.expand_terminal_card),
+            Some(false)
+        );
+        set_terminals_minimized_by_default(&mut settings, false);
+        assert_eq!(
+            settings
+                .agent
+                .as_ref()
+                .and_then(|agent| agent.expand_terminal_card),
+            Some(true)
+        );
+    }
+
+    #[gpui::test]
+    fn the_toggle_reads_the_upstream_setting(cx: &mut gpui::TestAppContext) {
+        cx.update(|cx| {
+            let store = settings::SettingsStore::test(cx);
+            cx.set_global(store);
+            AgentSettings::register(cx);
+            assert!(
+                !terminals_minimized_by_default(AgentSettings::get_global(cx)),
+                "upstream's default expands the card"
+            );
+            settings::SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    set_terminals_minimized_by_default(settings, true)
+                });
+            });
+            assert!(terminals_minimized_by_default(AgentSettings::get_global(
+                cx
+            )));
+        });
+    }
+}
