@@ -45,6 +45,10 @@ use crate::terminal_thread_metadata_store::{
     TerminalThreadMetadata, TerminalThreadMetadataStore, compose_terminal_thread_title,
     normalize_terminal_custom_title, terminal_title_without_prefix,
 };
+use crate::terminals_minimized::{
+    TERMINALS_MINIMIZED_MENU_LABEL, set_terminals_minimized_by_default,
+    terminals_minimized_by_default,
+};
 use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore, ThreadMetadataStoreEvent};
 use crate::{
     Agent, AgentInitialContent, AgentThreadSource, ExternalSourcePrompt, NewExternalAgentThread,
@@ -6774,6 +6778,29 @@ impl AgentPanel {
                             );
                         }
 
+                        // Zeo next §6.17: inline terminals start minimized, so a
+                        // long run of tool calls takes less of the scroll. Applies
+                        // to terminals created after the change.
+                        let terminals_minimized =
+                            terminals_minimized_by_default(AgentSettings::get_global(cx));
+                        menu = menu.separator().header("Conversation").toggleable_entry(
+                            TERMINALS_MINIMIZED_MENU_LABEL,
+                            terminals_minimized,
+                            IconPosition::End,
+                            None,
+                            {
+                                let fs = fs.clone();
+                                move |_window, cx| {
+                                    update_settings_file(fs.clone(), cx, move |settings, _| {
+                                        set_terminals_minimized_by_default(
+                                            settings,
+                                            !terminals_minimized,
+                                        );
+                                    });
+                                }
+                            },
+                        );
+
                         if has_auth_methods || supports_logout {
                             menu = menu.separator()
                         }
