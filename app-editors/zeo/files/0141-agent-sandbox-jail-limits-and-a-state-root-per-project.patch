+// Zeo next proposal §6.50/§6.54: a restart for the jail keeps the session. Filter:
+// `agent_jail_restart`.
+
+use std::path::{Path, PathBuf};
+
+use super::{carry_transcript, host_config_dir, transcript_folder};
+
+const SESSION: &str = "3e9d0351-0ad9-4a35-9fd9-73b132034533";
+
+#[test]
+fn agent_jail_restart_names_the_folder_as_claude_does() {
+    assert_eq!(
+        transcript_folder(Path::new("/home/otaku/Desktop/test")),
+        "-home-otaku-Desktop-test",
+        "the folder seen in a real state directory"
+    );
+    assert_eq!(transcript_folder(Path::new("/w/my app.v2")), "-w-my-app-v2");
+}
+
+#[test]
+fn agent_jail_restart_host_dir_honours_claude_config_dir() {
+    let home = Path::new("/home/u");
+    assert_eq!(
+        host_config_dir(None, home),
+        PathBuf::from("/home/u/.claude")
+    );
+    assert_eq!(
+        host_config_dir(Some(PathBuf::from("/c")), home),
+        PathBuf::from("/c")
+    );
+}
+
+#[test]
+fn agent_jail_restart_carries_the_transcript_into_the_jail() {
+    let base = tempfile::tempdir().unwrap();
+    let host = base.path().join("host");
+    let jail = base.path().join("jail/claude");
+    let cwd = PathBuf::from("/home/u/app");
+    let folder = host.join("projects").join(transcript_folder(&cwd));
+    std::fs::create_dir_all(folder.join(SESSION).join("subagents")).unwrap();
+    std::fs::write(folder.join(format!("{SESSION}.jsonl")), "{\"turn\":1}\n").unwrap();
+    std::fs::write(folder.join(SESSION).join("subagents/a.jsonl"), "{}\n").unwrap();
+
+    assert!(carry_transcript(&host, &jail, std::slice::from_ref(&cwd), SESSION).unwrap());
+    let target = jail.join("projects").join(transcript_folder(&cwd));
+    assert_eq!(
+        std::fs::read_to_string(target.join(format!("{SESSION}.jsonl"))).unwrap(),
+        "{\"turn\":1}\n",
+        "the restarted agent finds the session it resumes"
+    );
+    assert!(target.join(SESSION).join("subagents/a.jsonl").is_file());
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt as _;
+        let mode = std::fs::metadata(&target).unwrap().permissions().mode() & 0o777;
+        assert_eq!(mode, 0o700, "a conversation stays private");
+    }
+    assert!(
+        !carry_transcript(&host, &jail, &[cwd], SESSION).unwrap(),
+        "a second restart copies nothing and overwrites nothing"
+    );
+}
+
+#[test]
+fn agent_jail_restart_finds_the_transcript_under_either_root() {
+    let base = tempfile::tempdir().unwrap();
+    let host = base.path().join("host");
+    let jail = base.path().join("jail");
+    let link = PathBuf::from("/home/u/link-to-app");
+    let canonical = PathBuf::from("/srv/app");
+    let folder = host.join("projects").join(transcript_folder(&link));
+    std::fs::create_dir_all(&folder).unwrap();
+    std::fs::write(folder.join(format!("{SESSION}.jsonl")), "x").unwrap();
+    assert!(
+        carry_transcript(&host, &jail, &[canonical, link.clone()], SESSION).unwrap(),
+        "an agent outside the jail ran in the folder as opened, not canonicalized"
+    );
+    assert!(
+        jail.join("projects")
+            .join(transcript_folder(&link))
+            .join(format!("{SESSION}.jsonl"))
+            .is_file()
+    );
+}
+
+#[test]
+fn agent_jail_restart_without_a_transcript_copies_nothing() {
+    let base = tempfile::tempdir().unwrap();
+    assert!(
+        !carry_transcript(
+            &base.path().join("host"),
+            &base.path().join("jail"),
+            &[PathBuf::from("/w/app")],
+            SESSION
+        )
+        .unwrap(),
+        "an empty thread has no transcript: it starts a new session instead"
+    );
+}
+
+#[test]
+fn agent_jail_restart_resumes_only_a_session_it_will_find() {
+    let base = tempfile::tempdir().unwrap();
+    let jail = base.path().join("jail");
+    let cwd = PathBuf::from("/w/app");
+    assert!(
+        !super::has_transcript(&jail, std::slice::from_ref(&cwd), SESSION),
+        "nothing to resume: a new session, not \"Resource not found\""
+    );
+    let folder = jail.join("projects").join(transcript_folder(&cwd));
+    std::fs::create_dir_all(&folder).unwrap();
+    std::fs::write(folder.join(format!("{SESSION}.jsonl")), "x").unwrap();
+    assert!(super::has_transcript(&jail, &[cwd], SESSION));
+}
