+pub fn watch_disk(id: LaunchId, quota: u64, dirs: Vec<PathBuf>, cx: &mut App) {
+    let executor = cx.background_executor().clone();
+    let measure = move |dirs: Vec<PathBuf>| {
+        executor.spawn(async move {
+            dirs.iter()
+                .map(|dir| crate::disk_watch::disk_usage(dir))
+                .fold(0u64, u64::saturating_add)
+        })
+    };
+    cx.spawn(async move |cx| {
+        let start = measure(dirs.clone()).await;
+        let mut watch = crate::disk_watch::DiskWatch {
+            baseline: start,
+            quota,
+        };
+        let mut was_paused = false;
+        log::info!("agent_sandbox event=disk_watch_start quota={quota} baseline={start}");
+        loop {
+            cx.background_executor()
+                .timer(crate::disk_watch::INTERVAL)
+                .await;
+            let Some(record) = cx.update(|cx| LaunchRegistry::launch(id, cx)) else {
+                break;
+            };
+            if record.paused {
+                was_paused = true;
+                continue;
+            }
+            let usage = measure(dirs.clone()).await;
+            if was_paused {
+                watch = watch.resumed_at(usage);
+                was_paused = false;
+                continue;
+            }
+            if !watch.over(usage) {
+                continue;
+            }
+            let Some(pid) = record.jail_pid else {
+                continue;
+            };
+            match crate::control::jail_scope_dir(pid)
+                .and_then(|scope| crate::control::set_frozen(&scope, true))
+            {
+                Ok(()) => {
+                    log::warn!(
+                        "agent_sandbox event=disk_quota_paused pid={pid} usage={usage} baseline={} quota={quota}",
+                        watch.baseline
+                    );
+                    cx.update(|cx| LaunchRegistry::set_paused(id, true, cx));
+                }
+                Err(error) => log::error!(
+                    "agent_sandbox event=disk_quota_pause_failed pid={pid} error={error}"
+                ),
+            }
+        }
+    })
+    .detach();
+}
