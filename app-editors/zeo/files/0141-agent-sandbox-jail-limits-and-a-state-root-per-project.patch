+#[test]
+fn agent_jail_limits_preview_shows_the_state_folder_and_the_limits() {
+    let policy = agent_sandbox::ProjectPolicy {
+        enabled: true,
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        limits: Default::default(),
+    };
+    let memory = agent_sandbox::AgentMemorySettings {
+        enabled: false,
+        endpoint: String::new(),
+    };
+    let dir = PathBuf::from("/var/tmp/zeo-jail/app-8347daa28034a658");
+    let extras = PreviewExtras {
+        state_dir: Some(dir.clone()),
+        limit_args: vec!["--memory".into(), "8G".into()],
+    };
+    let preview = preview_command(
+        &policy,
+        Path::new("/w/app"),
+        "/home/u/.claude-jailed",
+        Some(Path::new("/usr/bin/ai-jail")),
+        &memory,
+        false,
+        &extras,
+    );
+    assert!(
+        preview.contains(&format!("--state-root {}", dir.display())),
+        "{preview}"
+    );
+    assert!(preview.contains("--memory 8G"), "{preview}");
+    assert!(!preview.contains("--claude-dir"), "{preview}");
+    let plain = preview_command(
+        &policy,
+        Path::new("/w/app"),
+        "/home/u/.claude-jailed",
+        Some(Path::new("/usr/bin/ai-jail")),
+        &memory,
+        false,
+        &PreviewExtras::default(),
+    );
+    assert!(
+        plain.contains("--claude-dir /home/u/.claude-jailed"),
+        "{plain}"
+    );
+    assert!(!plain.contains("--state-root"), "{plain}");
+}
