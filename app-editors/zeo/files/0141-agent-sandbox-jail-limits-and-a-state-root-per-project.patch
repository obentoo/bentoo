+// Zeo next proposal §6.54 (ask 78): the page's limits and state folder. Filter: `agent_jail_limits`.
+
+use std::path::{Path, PathBuf};
+
+use settings::AgentSandboxLimitsContent;
+
+use super::super::{PreviewExtras, preview_command};
+use super::{LimitField, LimitValue};
+
+#[test]
+fn agent_jail_limits_accept_only_what_ai_jail_and_the_watchdog_read() {
+    for ok in ["8G", "512m", "0", "1024"] {
+        assert!(LimitField::Memory.parse(ok).is_ok(), "{ok}");
+    }
+    // ai-jail's own --memory parser refuses a `B` suffix, so the page must too.
+    for bad in ["8GB", "lots", "", "G", "-1"] {
+        assert!(LimitField::Memory.parse(bad).is_err(), "{bad}");
+    }
+    for ok in ["20G", "20GiB", "0"] {
+        assert!(LimitField::DiskQuota.parse(ok).is_ok(), "{ok}");
+    }
+    assert!(LimitField::DiskQuota.parse("big").is_err());
+    assert_eq!(
+        LimitField::CpuQuota.parse("200"),
+        Ok(LimitValue::Count(200))
+    );
+    assert!(LimitField::CpuQuota.parse("50%").is_err());
+    assert!(LimitField::MaxTasks.parse("many").is_err());
+    let rule = LimitField::Memory.parse("8GB").unwrap_err();
+    assert!(
+        rule.contains("0 for none"),
+        "the refusal says how to turn it off: {rule}"
+    );
+}
+
+#[test]
+fn agent_jail_limits_set_one_field_and_a_reset_removes_it() {
+    let mut limits = AgentSandboxLimitsContent::default();
+    LimitField::Memory.apply(&mut limits, Some(LimitValue::Size("4G".into())));
+    LimitField::CpuQuota.apply(&mut limits, Some(LimitValue::Count(0)));
+    assert_eq!(limits.memory.as_deref(), Some("4G"));
+    assert_eq!(
+        limits.cpu_quota,
+        Some(0),
+        "0 is written: it turns the default off"
+    );
+    assert_eq!(
+        limits.max_tasks, None,
+        "a field not named keeps the default"
+    );
+    LimitField::Memory.apply(&mut limits, None);
+    assert_eq!(limits.memory, None, "reset brings the default back");
+}
