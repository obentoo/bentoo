+//! The Agent Sandbox page's resource limits and state folder (Zeo next proposal §6.54, ask 78):
+//! the four limits a jailed start applies, each settable for this project, and the folder that
+//! keeps the project's own jail home, /tmp and Claude login.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, OnceLock};
+
+use agent_sandbox::SandboxLimits;
+use agent_sandbox::confirm::{non_utf8_root_message, target_project_key};
+use agent_sandbox::disk_watch::parse_size;
+use fs::Fs;
+use futures::channel::oneshot;
