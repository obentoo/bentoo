+/// Resource limits for one jail (Zeo next §6.54). `None` leaves a limit off.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Hash)]
+pub struct SandboxLimits {
+    /// Memory for the whole jail, as written ("8G").
+    pub memory: Option<String>,
+    /// Percent of one CPU.
+    pub cpu_quota: Option<u32>,
+    /// Processes and threads together.
+    pub max_tasks: Option<u64>,
+    /// Growth allowed to the jail's state and the project, as written ("20G").
+    pub disk_quota: Option<String>,
+}
+
+impl SandboxLimits {
+    /// These limits with each one `over` names put in its place.
+    pub fn overridden_by(&self, over: &SandboxLimits) -> Self {
+        Self {
+            memory: over.memory.clone().or_else(|| self.memory.clone()),
+            cpu_quota: over.cpu_quota.or(self.cpu_quota),
+            max_tasks: over.max_tasks.or(self.max_tasks),
+            disk_quota: over.disk_quota.clone().or_else(|| self.disk_quota.clone()),
+        }
+    }
+
+    /// These limits with every one set to zero (`0`, `"0"` or `""`) turned off: a zero is how a
+    /// setting turns a default limit off, since an unset value inherits it.
+    pub fn effective(&self) -> Self {
+        let size = |value: &Option<String>| {
+            value
+                .as_ref()
+                .filter(|text| !matches!(text.trim(), "" | "0"))
+                .cloned()
+        };
+        Self {
+            memory: size(&self.memory),
+            cpu_quota: self.cpu_quota.filter(|quota| *quota > 0),
+            max_tasks: self.max_tasks.filter(|tasks| *tasks > 0),
+            disk_quota: size(&self.disk_quota),
+        }
+    }
+
+    /// Whether any limit is on, and so needs ai-jail's systemd scope: every one does, the disk
+    /// quota through the task cap it brings.
+    pub fn any(&self) -> bool {
+        let on = self.effective();
+        on.memory.is_some()
+            || on.cpu_quota.is_some()
+            || on.max_tasks.is_some()
+            || on.disk_quota.is_some()
+    }
+
+    /// The ai-jail options that apply these limits. A disk quota is Zeo's own watchdog, not an
+    /// ai-jail option; alone, it still brings `--max-tasks` so the jail gets a scope to freeze.
+    pub fn jail_args(&self) -> Vec<String> {
+        let on = self.effective();
+        let mut args = Vec::new();
+        if let Some(memory) = &on.memory {
+            args.extend(["--memory".to_string(), memory.clone()]);
+        }
+        if let Some(quota) = on.cpu_quota {
+            args.extend(["--cpu-quota".to_string(), quota.to_string()]);
+        }
+        let tasks = on
+            .max_tasks
+            .or(on.disk_quota.as_ref().map(|_| DISK_QUOTA_MAX_TASKS));
+        if let Some(tasks) = tasks {
+            args.extend(["--max-tasks".to_string(), tasks.to_string()]);
+        }
+        args
+    }
+}
