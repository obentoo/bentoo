+use gpui::TestAppContext;
+use serde_json::{Value, json};
+use settings::Settings as _;
+
+use crate::AgentSandboxSettings;
+use crate::launch::project_state_dir;
+use crate::launch_tests::*;
+use crate::settings::{DISK_QUOTA_MAX_TASKS, SandboxLimits};
+
+/// An ai-jail whose --help lists the options the fork's 3.5.0-r1 adds.
+const HELP_WITH_LIMITS_AND_STATE_ROOT: &str = "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n' ;; *) echo 'ai-jail 3.5.0' ;; esac";
+
+fn limits(memory: &str, cpu: u32, tasks: u64, disk: Option<&str>) -> SandboxLimits {
+    SandboxLimits {
+        memory: Some(memory.to_string()),
+        cpu_quota: Some(cpu),
+        max_tasks: Some(tasks),
+        disk_quota: disk.map(str::to_string),
+    }
+}
+
+#[test]
+fn limits_become_jail_options_and_zero_turns_one_off() {
+    assert_eq!(
+        limits("8G", 400, 4096, None).jail_args(),
+        [
+            "--memory",
+            "8G",
+            "--cpu-quota",
+            "400",
+            "--max-tasks",
+            "4096"
+        ]
+    );
+    let off = limits("0", 0, 0, None);
+    assert!(off.jail_args().is_empty());
+    assert!(!off.any(), "all zero is no limit at all");
+}
+
+#[test]
+fn a_disk_quota_alone_brings_the_task_cap_its_watchdog_needs() {
+    let disk_only = limits("0", 0, 0, Some("20G"));
+    assert!(disk_only.any());
+    assert_eq!(
+        disk_only.jail_args(),
+        ["--max-tasks".to_string(), DISK_QUOTA_MAX_TASKS.to_string()],
+        "ai-jail creates the scope the watchdog freezes only for a limit"
+    );
+}
+
+#[test]
+fn a_project_replaces_the_defaults_it_names_one_by_one() {
+    let defaults = limits("8G", 400, 4096, None);
+    let project = SandboxLimits {
+        memory: Some("2G".into()),
+        cpu_quota: Some(0),
+        ..SandboxLimits::default()
+    };
+    let merged = defaults.overridden_by(&project);
+    assert_eq!(
+        merged.jail_args(),
+        ["--memory", "2G", "--max-tasks", "4096"],
+        "its memory replaces the default, its 0 turns the CPU quota off, the task cap stays"
+    );
+}
+
+#[gpui::test]
+async fn the_defaults_are_the_operators_values_and_a_state_root(cx: &mut TestAppContext) {
+    init(cx);
+    let settings = cx.update(|cx| AgentSandboxSettings::get_global(cx).clone());
+    assert_eq!(
+        settings.limits,
+        limits("8G", 400, 4096, None),
+        "8 GB, 400 %, 4096 processes (operator, 2026-11-17); no disk quota"
+    );
+    assert_eq!(settings.state_root, "/var/tmp/zeo-jail");
+}
+
+#[test]
+fn each_project_has_its_own_stable_state_folder() {
+    let base = Path::new("/var/tmp/zeo-jail");
+    let app = project_state_dir(base, Path::new("/home/u/src/app"));
+    assert_eq!(
+        app,
+        project_state_dir(base, Path::new("/home/u/src/app")),
+        "the same root always maps to the same folder"
+    );
+    let other = project_state_dir(base, Path::new("/home/u/old/app"));
+    assert_ne!(app, other, "two projects named alike never share a jail");
+    let name = app.file_name().unwrap().to_string_lossy().into_owned();
+    assert!(name.starts_with("app-"), "readable: {name}");
+    // FNV-1a of the path, so a Zeo update cannot move a project's login.
+    assert_eq!(name, "app-8347daa28034a658");
+    assert_eq!(
+        project_state_dir(base, Path::new("/srv/a b:c"))
+            .file_name()
+            .unwrap()
+            .to_string_lossy()[..6],
+        *"a_b_c-",
+        "unsafe characters are replaced"
+    );
+}
+
+fn with_limits_on(f: &Fixture, state_root: &Path) -> Value {
+    let mut value = sandbox(f, true, Value::Null, memory_off());
+    value["agent_sandbox"]["limits"] =
+        json!({ "memory": "8G", "cpu_quota": 400, "max_tasks": 4096 });
+    value["agent_sandbox"]["state_root"] = json!(state_root);
+    value
+}
+
+#[gpui::test]
+async fn a_limit_the_installed_ai_jail_cannot_apply_refuses_the_start(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    set_user_settings(with_limits_on(&f, &f.base.join("state")), cx);
+    let project = project(&f, cx).await;
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(text.contains("cannot apply them"), "{text}");
+    assert!(text.contains("3.5.0-r1"), "says what to install: {text}");
+}
+
+#[gpui::test]
+async fn limits_and_the_project_state_root_reach_the_command(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, HELP_WITH_LIMITS_AND_STATE_ROOT);
+    let base = f.base.join("state");
+    set_user_settings(with_limits_on(&f, &base), cx);
+    let project = project(&f, cx).await;
+    let (record, cmd) =
+        jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+
+    let dir = project_state_dir(&base, &f.root);
+    let dir_text = dir.display().to_string();
+    assert_eq!(
+        count(&cmd.args, "--state-root", &dir_text),
+        1,
+        "{:?}",
+        cmd.args
+    );
+    assert!(
+        !cmd.args.iter().any(|arg| arg == "--claude-dir"),
+        "the state root's claude/ replaces the shared config dir: {:?}",
+        cmd.args
+    );
+    let separator = cmd.args.iter().position(|arg| arg == "--").unwrap();
+    for (flag, value) in [
+        ("--memory", "8G"),
+        ("--cpu-quota", "400"),
+        ("--max-tasks", "4096"),
+    ] {
+        let at = cmd
+            .args
+            .windows(2)
+            .position(|pair| pair[0] == flag && pair[1] == value)
+            .unwrap_or_else(|| panic!("{flag} {value} in {:?}", cmd.args));
+        assert!(at < separator, "{flag} is ai-jail's, before `--`");
+    }
+    let claude = dir.join("claude");
+    assert!(
+        claude.is_dir(),
+        "created before the start, so a login can run first"
+    );
+    let mode = std::fs::metadata(&claude).unwrap().permissions().mode() & 0o777;
+    assert_eq!(mode, 0o700, "it holds a login");
+    assert_eq!(
+        record.rw_maps.first(),
+        Some(&dir),
+        "the record names the state folder"
+    );
+    assert_eq!(
+        record.claude_config_dir,
+        Some(claude),
+        "where a login started from Zeo must write"
+    );
+}
+
+#[gpui::test]
+async fn without_state_root_support_the_shared_config_dir_stays(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(
+        &f.ai_jail,
+        "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n' ;; *) echo 'ai-jail 3.5.0' ;; esac",
+    );
+    set_user_settings(with_limits_on(&f, &f.base.join("state")), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let claude = f.claude_dir.display().to_string();
+    assert_eq!(
+        count(&cmd.args, "--claude-dir", &claude),
+        1,
+        "{:?}",
+        cmd.args
+    );
+    assert!(!cmd.args.iter().any(|arg| arg == "--state-root"));
+    assert!(
+        !f.base.join("state").exists(),
+        "nothing created for a jail that cannot use it"
+    );
+}
+
+#[gpui::test]
+async fn the_registry_keeps_a_launchs_pid_and_pause(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, HELP_WITH_LIMITS_AND_STATE_ROOT);
+    set_user_settings(with_limits_on(&f, &f.base.join("state")), cx);
+    let project = project(&f, cx).await;
+    let (record, _) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let agent = record.agent_id.clone();
+    let root = record.project_root.clone();
+    let id = cx.update(|cx| crate::LaunchRegistry::register(record, cx));
+    cx.update(|cx| {
+        crate::LaunchRegistry::set_jail_pid(id, 4242, cx);
+        crate::LaunchRegistry::set_paused(id, true, cx);
+    });
+    let (found, record) = cx
+        .update(|cx| crate::LaunchRegistry::get_with_id(&agent, &root, cx))
+        .expect("registered");
+    assert_eq!(found, id);
+    assert_eq!(record.jail_pid, Some(4242), "the kill switch's target");
+    assert!(record.paused, "the watchdog's pause shows");
+    cx.update(|cx| crate::LaunchRegistry::set_paused(id, false, cx));
+    assert!(
+        !cx.update(|cx| crate::LaunchRegistry::launch(id, cx))
+            .unwrap()
+            .paused
+    );
+    cx.update(|cx| crate::LaunchRegistry::remove_launch(id, cx));
+    assert!(
+        cx.update(|cx| crate::LaunchRegistry::launch(id, cx))
+            .is_none(),
+        "ends with the launch"
+    );
+}
+
+fn unchanged(decision: crate::launch::LaunchDecision) -> crate::launch::LaunchRecord {
+    match decision {
+        crate::launch::LaunchDecision::Unchanged(record) => record,
+        _ => panic!("expected an unjailed start"),
+    }
+}
+
+#[gpui::test]
+async fn a_start_with_the_jail_off_records_whether_ai_jail_is_installed(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    set_user_settings(sandbox(&f, false, Value::Null, memory_off()), cx);
+    let project = project(&f, cx).await;
+    let record = unchanged(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        !record.ai_jail_missing,
+        "ai-jail is there: the lock can turn it on"
+    );
+
+    std::fs::remove_file(&f.ai_jail).unwrap();
+    let record = unchanged(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        record.ai_jail_missing,
+        "no ai-jail: the thread's lock is disabled and says what to install"
+    );
+}
