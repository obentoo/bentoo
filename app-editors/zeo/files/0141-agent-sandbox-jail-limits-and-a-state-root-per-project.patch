diff --git a/crates/agent_sandbox/src/control.rs b/crates/agent_sandbox/src/control.rs
new file mode 100644
index 0000000..5b50b11
--- /dev/null
+++ b/crates/agent_sandbox/src/control.rs
@@ -0,0 +1,166 @@
+//! Acting on a running jail (Zeo next §6.53 kill switch, §6.54 disk watchdog): stopping it, and
+//! pausing and resuming it through ai-jail's systemd scope.
+
+use std::io;
+
+/// Stops the jail whose ai-jail process is `pid`: a SIGTERM to ai-jail ends everything inside
+/// it (measured, §6.55), the agent and every command it started. Logged as one event.
+#[cfg(unix)]
+pub fn stop_jail(pid: u32) -> io::Result<()> {
+    let pid = libc::pid_t::try_from(pid)
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "pid out of range"))?;
+    if pid <= 1 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "refusing to signal pid 0 or 1",
+        ));
+    }
+    // SAFETY: kill(2) with a positive pid and a valid signal touches no memory of ours.
+    let result = unsafe { libc::kill(pid, libc::SIGTERM) };
+    if result == 0 {
+        log::info!("agent_sandbox event=kill_switch pid={pid} outcome=signalled");
+        Ok(())
+    } else {
+        let error = io::Error::last_os_error();
+        log::warn!("agent_sandbox event=kill_switch pid={pid} outcome=failed error={error}");
+        Err(error)
+    }
+}
+
+#[cfg(not(unix))]
+pub fn stop_jail(_pid: u32) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "the agent sandbox runs on Linux only",
+    ))
+}
+
+/// The cgroup v2 directory of ai-jail's systemd scope for the process `pid`, under the
+/// filesystem roots given (`/proc` and `/sys/fs/cgroup` outside tests). Only a scope named
+/// `ai-jail-*.scope` is returned: pausing anything else -- Zeo's own cgroup, when no limit made
+/// ai-jail create a scope -- would freeze the editor.
+pub fn jail_scope_dir_in(
+    proc_root: &std::path::Path,
+    cgroup_root: &std::path::Path,
+    pid: u32,
+) -> io::Result<std::path::PathBuf> {
+    let text = std::fs::read_to_string(proc_root.join(pid.to_string()).join("cgroup"))?;
+    let relative = text
+        .lines()
+        .find_map(|line| line.strip_prefix("0::"))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "no cgroup v2 entry"))?;
+    let dir = cgroup_root.join(relative.trim_start_matches('/'));
+    let is_jail_scope = dir.file_name().is_some_and(|name| {
+        let name = name.to_string_lossy();
+        name.starts_with("ai-jail-") && name.ends_with(".scope")
+    });
+    if !is_jail_scope {
+        return Err(io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("{} is not an ai-jail scope", dir.display()),
+        ));
+    }
+    Ok(dir)
+}
+
+/// [`jail_scope_dir_in`] on the real filesystems.
+pub fn jail_scope_dir(pid: u32) -> io::Result<std::path::PathBuf> {
+    jail_scope_dir_in(
+        std::path::Path::new("/proc"),
+        std::path::Path::new("/sys/fs/cgroup"),
+        pid,
+    )
+}
+
+/// Pauses (`true`) or resumes the scope at `scope_dir` through `cgroup.freeze`, which works
+/// without root on a scope the user's systemd delegates (measured, §6.54). Logged.
+pub fn set_frozen(scope_dir: &std::path::Path, frozen: bool) -> io::Result<()> {
+    let result = std::fs::write(
+        scope_dir.join("cgroup.freeze"),
+        if frozen { "1" } else { "0" },
+    );
+    let outcome = if result.is_ok() { "ok" } else { "failed" };
+    log::info!(
+        "agent_sandbox event=jail_freeze frozen={frozen} scope={} outcome={outcome}",
+        scope_dir.display()
+    );
+    result
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    #[test]
+    #[allow(
+        clippy::disallowed_methods,
+        reason = "the signal must reach a real child, outside any executor"
+    )]
+    fn stopping_a_jail_terminates_its_process() {
+        let mut child = std::process::Command::new("sleep")
+            .arg("30")
+            .spawn()
+            .expect("spawn sleep");
+        stop_jail(child.id()).expect("signalled");
+        let status = child.wait().expect("waited");
+        use std::os::unix::process::ExitStatusExt as _;
+        assert_eq!(status.signal(), Some(libc::SIGTERM), "{status:?}");
+    }
+
+    fn fake_proc(pid: u32, cgroup_line: &str) -> tempfile::TempDir {
+        let root = tempfile::tempdir().unwrap();
+        let dir = root.path().join("proc").join(pid.to_string());
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("cgroup"), format!("{cgroup_line}\n")).unwrap();
+        root
+    }
+
+    #[test]
+    fn the_scope_of_a_jail_is_found_from_its_pid() {
+        let root = fake_proc(
+            42,
+            "0::/user.slice/user-1000.slice/user@1000.service/app.slice/ai-jail-42.scope",
+        );
+        let cgroup = root.path().join("cgroup");
+        let dir = jail_scope_dir_in(&root.path().join("proc"), &cgroup, 42).unwrap();
+        assert_eq!(
+            dir,
+            cgroup.join("user.slice/user-1000.slice/user@1000.service/app.slice/ai-jail-42.scope")
+        );
+    }
+
+    #[test]
+    fn a_process_outside_an_ai_jail_scope_is_never_frozen() {
+        let root = fake_proc(
+            42,
+            "0::/user.slice/user-1000.slice/user@1000.service/app.slice/zeo.scope",
+        );
+        let err = jail_scope_dir_in(&root.path().join("proc"), &root.path().join("cgroup"), 42)
+            .unwrap_err();
+        assert!(err.to_string().contains("not an ai-jail scope"), "{err}");
+    }
+
+    #[test]
+    fn freezing_writes_the_scope_freeze_file() {
+        let scope = tempfile::tempdir().unwrap();
+        set_frozen(scope.path(), true).unwrap();
+        assert_eq!(
+            std::fs::read_to_string(scope.path().join("cgroup.freeze")).unwrap(),
+            "1"
+        );
+        set_frozen(scope.path(), false).unwrap();
+        assert_eq!(
+            std::fs::read_to_string(scope.path().join("cgroup.freeze")).unwrap(),
+            "0"
+        );
+    }
+
+    #[test]
+    fn pid_zero_and_one_are_never_signalled() {
+        assert!(
+            stop_jail(0).is_err(),
+            "pid 0 is the caller's whole process group"
+        );
+        assert!(stop_jail(1).is_err(), "pid 1 is init");
+    }
+}
diff --git a/crates/agent_sandbox/src/disk_watch.rs b/crates/agent_sandbox/src/disk_watch.rs
new file mode 100644
index 0000000..99d6638
--- /dev/null
+++ b/crates/agent_sandbox/src/disk_watch.rs
@@ -0,0 +1,128 @@
+//! The jail's disk quota (Zeo next §6.54, the operator's design): Zeo measures how much the jail's
+//! own state folder and the project have grown since the agent started, every few seconds, and
+//! past the quota pauses the jail -- freezing its systemd scope, which loses no work -- until the
+//! operator resumes or stops it. A soft limit: a burst between two measurements can overshoot.
+
+use std::path::Path;
+
+/// How often the watchdog measures.
+pub const INTERVAL: std::time::Duration = std::time::Duration::from_secs(5);
+
+/// `text` as a byte count: a number with an optional K, M, G or T suffix (powers of 1024, `B`
+/// and `iB` accepted), as `agent_sandbox.limits.disk_quota` is written. `None` for anything
+/// else, and for zero, which turns the quota off.
+pub fn parse_size(text: &str) -> Option<u64> {
+    let text = text.trim();
+    let upper = text.to_ascii_uppercase();
+    let unit = upper.trim_end_matches("IB").trim_end_matches('B');
+    let (number, shift) = match unit.chars().last()? {
+        'K' => (&unit[..unit.len() - 1], 10),
+        'M' => (&unit[..unit.len() - 1], 20),
+        'G' => (&unit[..unit.len() - 1], 30),
+        'T' => (&unit[..unit.len() - 1], 40),
+        c if c.is_ascii_digit() => (unit, 0),
+        _ => return None,
+    };
+    let value: u64 = number.trim().parse().ok()?;
+    value
+        .checked_shl(shift)
+        .filter(|bytes| *bytes > 0 && bytes >> shift == value)
+}
+
+/// The space `path` takes on disk, in bytes: allocated blocks, never following a symlink, so a
+/// link to `/` costs nothing. An unreadable entry is skipped: the watchdog measures, it does not
+/// fail.
+pub fn disk_usage(path: &Path) -> u64 {
+    #[cfg(unix)]
+    use std::os::unix::fs::MetadataExt as _;
+    let Ok(meta) = path.symlink_metadata() else {
+        return 0;
+    };
+    #[cfg(unix)]
+    let own = meta.blocks() * 512;
+    #[cfg(not(unix))]
+    let own = meta.len();
+    if !meta.is_dir() {
+        return own;
+    }
+    let Ok(entries) = std::fs::read_dir(path) else {
+        return own;
+    };
+    entries
+        .flatten()
+        .map(|entry| disk_usage(&entry.path()))
+        .fold(own, u64::saturating_add)
+}
+
+/// One jail's quota: the usage it started from, and how far it may grow.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DiskWatch {
+    pub baseline: u64,
+    pub quota: u64,
+}
+
+impl DiskWatch {
+    /// Whether `usage` is past the quota.
+    pub fn over(&self, usage: u64) -> bool {
+        usage.saturating_sub(self.baseline) > self.quota
+    }
+
+    /// The watch after a Resume at `usage`: the operator saw the pause and let the jail go on, so
+    /// it may grow by a whole quota again from here.
+    pub fn resumed_at(self, usage: u64) -> Self {
+        Self {
+            baseline: usage,
+            ..self
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sizes_parse_with_binary_units() {
+        assert_eq!(parse_size("20G"), Some(20 << 30));
+        assert_eq!(parse_size("512M"), Some(512 << 20));
+        assert_eq!(parse_size("1GiB"), Some(1 << 30));
+        assert_eq!(parse_size(" 3 GB "), Some(3 << 30));
+        assert_eq!(parse_size("4096"), Some(4096));
+        assert_eq!(parse_size("0"), None, "zero turns the quota off");
+        assert_eq!(parse_size("lots"), None);
+        assert_eq!(
+            parse_size("99999999999T"),
+            None,
+            "overflow is refused, not wrapped"
+        );
+    }
+
+    #[test]
+    fn usage_counts_files_and_never_follows_a_symlink() {
+        let dir = tempfile::tempdir().unwrap();
+        let empty = disk_usage(dir.path());
+        std::fs::write(dir.path().join("data"), vec![7u8; 64 * 1024]).unwrap();
+        #[cfg(unix)]
+        std::os::unix::fs::symlink("/", dir.path().join("root-link")).unwrap();
+        let used = disk_usage(dir.path());
+        assert!(used >= empty + 64 * 1024, "{used} after a 64 KiB file");
+        assert!(
+            used < empty + 1024 * 1024,
