diff --git a/crates/agent_ui/src/agent_jail_login.rs b/crates/agent_ui/src/agent_jail_login.rs
new file mode 100644
index 0000000..b8fddc6
--- /dev/null
+++ b/crates/agent_ui/src/agent_jail_login.rs
@@ -0,0 +1,47 @@
+//! The login of a jailed agent (Zeo next proposal §6.54).
+//!
+//! A jailed Claude agent reads its login from its own config directory -- one per project since
+//! §6.54 -- but the login Zeo starts runs on the host, in a terminal, because the browser's OAuth
+//! callback lands on a host port the jail cannot receive. So the login is pointed at the jail's
+//! directory with `CLAUDE_CONFIG_DIR`; without it the token went to `~/.claude` and the jailed
+//! agent kept answering "Authentication required".
+
+use std::path::PathBuf;
+
+use gpui::{App, Entity};
+use project::{Project, agent_server_store::AgentId};
+
+/// The config directory the agent's live jailed launch in `project` uses, if it is jailed.
+pub(crate) fn jailed_claude_config_dir(
+    agent_id: &AgentId,
+    project: &Entity<Project>,
+    cx: &App,
+) -> Option<PathBuf> {
+    let root = agent_sandbox::launch::project_root(project, cx)?;
+    agent_sandbox::LaunchRegistry::get(agent_id, &root, cx)?.claude_config_dir
+}
+
+/// Points `login` at a jailed agent's config directory, and says so in the log.
+pub(crate) fn point_login_at_jail(
+    login: &mut task::SpawnInTerminal,
+    agent_id: &AgentId,
+    project: &Entity<Project>,
+    cx: &App,
+) {
+    let Some(dir) = jailed_claude_config_dir(agent_id, project, cx) else {
+        return;
+    };
+    log::info!(
+        "agent_sandbox event=jailed_login agent={} config_dir={}",
+        agent_id.0,
+        dir.display()
+    );
+    login.env.insert(
+        "CLAUDE_CONFIG_DIR".to_string(),
+        dir.to_string_lossy().into_owned(),
+    );
+}
+
+#[cfg(test)]
+#[path = "agent_jail_login_tests.rs"]
+mod agent_jail_login_tests;
diff --git a/crates/agent_ui/src/agent_jail_login_tests.rs b/crates/agent_ui/src/agent_jail_login_tests.rs
new file mode 100644
index 0000000..6362710
--- /dev/null
+++ b/crates/agent_ui/src/agent_jail_login_tests.rs
@@ -0,0 +1,83 @@
+// Zeo next proposal §6.54: the login Zeo starts for a jailed agent writes to the jail's own
+// Claude config directory. Filter: `agent_jail_login`.
+
+use std::path::{Path, PathBuf};
+
+use agent_sandbox::launch::{LaunchRecord, LaunchRegistry, MemoryPort, Reason};
+use fs::{FakeFs, Fs};
+use gpui::TestAppContext;
+use project::Project;
+use project::agent_server_store::AgentId;
+use serde_json::json;
+
+use super::point_login_at_jail;
+
+const ROOT: &str = "/w/app";
+const JAIL_CLAUDE: &str = "/var/tmp/zeo-jail/app-8347daa28034a658/claude";
+
+fn record(agent: &str, claude_config_dir: Option<&str>) -> LaunchRecord {
+    LaunchRecord {
+        agent_id: AgentId::new(agent),
+        project_root: PathBuf::from(ROOT),
+        reason: Reason::On,
+        ai_jail_version: None,
+        ai_jail_path: None,
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        forward_ports: Vec::new(),
+        memory_port: MemoryPort::Off,
+        settings_fingerprint: 0,
+        memory_fingerprint: 0,
+        settings_key: None,
+        jail_pid: None,
+        paused: false,
+        claude_config_dir: claude_config_dir.map(PathBuf::from),
+        ai_jail_missing: false,
+    }
+}
+
+async fn login_env_with(
+    registered: LaunchRecord,
+    agent: &str,
+    cx: &mut TestAppContext,
+) -> Option<String> {
+    crate::conversation_view::tests::init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        <dyn Fs>::set_global(fs.clone(), cx);
+        agent_sandbox::init(cx);
+    });
+    fs.insert_tree(ROOT, json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new(ROOT)], cx).await;
+    cx.update(|cx| {
+        LaunchRegistry::register(registered, cx);
+        let mut login = task::SpawnInTerminal::default();
+        point_login_at_jail(&mut login, &AgentId::new(agent), &project, cx);
+        login.env.get("CLAUDE_CONFIG_DIR").cloned()
+    })
+}
+
+#[gpui::test]
+async fn agent_jail_login_writes_to_the_jails_config_dir(cx: &mut TestAppContext) {
+    let env = login_env_with(record("Plus", Some(JAIL_CLAUDE)), "Plus", cx).await;
+    assert_eq!(
+        env.as_deref(),
+        Some(JAIL_CLAUDE),
+        "the token must land where the jailed agent reads it, not in ~/.claude"
+    );
+}
+
+#[gpui::test]
+async fn agent_jail_login_leaves_an_unjailed_agent_alone(cx: &mut TestAppContext) {
+    let env = login_env_with(record("Plus", None), "Plus", cx).await;
+    assert_eq!(env, None, "an agent outside the jail logs in as before");
+}
+
+#[gpui::test]
+async fn agent_jail_login_reads_only_its_own_agents_launch(cx: &mut TestAppContext) {
+    let env = login_env_with(record("Other", Some(JAIL_CLAUDE)), "Plus", cx).await;
+    assert_eq!(
+        env, None,
+        "another agent's jail says nothing about this login"
+    );
+}
diff --git a/crates/agent_ui/src/agent_jail_restart.rs b/crates/agent_ui/src/agent_jail_restart.rs
new file mode 100644
index 0000000..6665a19
--- /dev/null
+++ b/crates/agent_ui/src/agent_jail_restart.rs
@@ -0,0 +1,177 @@
+//! Restarting an agent because its jail was turned on or off (Zeo next proposal §6.50, §6.54).
+//!
+//! The restart resumes the thread's session, and Claude keeps a session's transcript under its
+//! config directory: `<config>/projects/<cwd with every non-alphanumeric as '-'>/<id>.jsonl`.
+//! Since §6.54 a jailed agent has a config directory of its own per project, so the restarted
+//! agent looked for the transcript in a directory that never had it and answered "Resource not
+//! found" (operator, 2026-11-22). The transcript is carried across first; and a session with no
+//! transcript anywhere (no message yet, or only turns that failed before Claude wrote one) has
+//! nothing to resume, so the restart starts a new session instead.
+
+use std::io;
+use std::path::{Path, PathBuf};
+
+use agent_sandbox::launch::project_state_dir;
+use agent_sandbox::validate::expand_tilde;
+use agent_sandbox::{AgentSandboxSettings, LaunchRegistry};
+use gpui::{App, Entity, Task};
+use project::{Project, agent_server_store::AgentId};
+use settings::Settings as _;
+
+/// The project folder name Claude gives a working directory: every character that is not an
+/// ASCII letter or digit becomes `-` (`/home/u/app` → `-home-u-app`).
+pub(crate) fn transcript_folder(cwd: &Path) -> String {
+    cwd.to_string_lossy()
+        .chars()
+        .map(|ch| if ch.is_ascii_alphanumeric() { ch } else { '-' })
+        .collect()
+}
+
+/// The config directory an agent outside the jail uses: Zeo's own `CLAUDE_CONFIG_DIR`, or
+/// `~/.claude`.
+pub(crate) fn host_config_dir(env_config_dir: Option<PathBuf>, home: &Path) -> PathBuf {
+    env_config_dir.unwrap_or_else(|| home.join(".claude"))
+}
+
+/// The config directory the agent will use once restarted under the settings of now: the
+/// project's own state folder when the jail is on, the host's otherwise.
+pub(crate) fn next_config_dir(
+    sandbox: &AgentSandboxSettings,
+    root: &Path,
+    canonical_root: &Path,
+    host: &Path,
+    home: &Path,
+) -> PathBuf {
+    if sandbox.effective_enabled(root) {
+        project_state_dir(&expand_tilde(&sandbox.state_root, home), canonical_root).join("claude")
+    } else {
+        host.to_path_buf()
+    }
+}
+
+/// The copy a restart for the jail needs before it resumes `session_id`: from the directory the
+/// running agent uses to the one the restarted agent will. Resolves to whether the restarted
+/// agent will find the session's transcript, which decides between resuming it and starting a
+/// new one. `None` when there is no project root.
+pub(crate) fn plan_carry(
+    agent_id: &AgentId,
+    project: &Entity<Project>,
+    session_id: String,
+    cx: &App,
+) -> Option<Task<bool>> {
+    let root = agent_sandbox::launch::project_root(project, cx)?;
+    let home = paths::home_dir().clone();
+    let host = host_config_dir(
+        std::env::var_os("CLAUDE_CONFIG_DIR").map(PathBuf::from),
+        &home,
+    );
+    let from = LaunchRegistry::get(agent_id, &root, cx)
+        .and_then(|record| record.claude_config_dir)
+        .unwrap_or_else(|| host.clone());
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    Some(cx.background_executor().spawn(async move {
+        // The jail runs in the canonical root; an agent outside it, in the folder as opened.
+        let canonical = std::fs::canonicalize(&root).unwrap_or_else(|_| root.clone());
+        let to = next_config_dir(&sandbox, &root, &canonical, &host, &home);
+        let cwds = [canonical, root];
+        let carried = carry_transcript(&from, &to, &cwds, &session_id);
+        let resumable = has_transcript(&to, &cwds, &session_id);
+        match carried {
+            Ok(copied) => log::info!(
+                "agent_sandbox event=transcript_carry session={session_id} copied={copied} to={}",
+                to.display()
+            ),
+            Err(error) => log::error!(
+                "agent_sandbox event=transcript_carry_failed session={session_id} to={} error={error}",
+                to.display()
+            ),
+        }
+        resumable
+    }))
+}
+
+/// Whether `config` holds session `session_id`'s transcript under one of `cwds`.
+pub(crate) fn has_transcript(config: &Path, cwds: &[PathBuf], session_id: &str) -> bool {
+    cwds.iter().any(|cwd| {
+        config
+            .join("projects")
+            .join(transcript_folder(cwd))
+            .join(format!("{session_id}.jsonl"))
+            .is_file()
+    })
+}
+
+/// Copies session `session_id`'s transcript (and its folder of sub-agent transcripts, when
+/// there is one) from `from` to `to`, under the first of `cwds` that holds it. Nothing is
+/// overwritten. `Ok(true)` when something was copied.
+pub(crate) fn carry_transcript(
+    from: &Path,
+    to: &Path,
+    cwds: &[PathBuf],
+    session_id: &str,
+) -> io::Result<bool> {
+    if from == to {
+        return Ok(false);
+    }
+    for cwd in cwds {
+        let folder = transcript_folder(cwd);
+        let source = from.join("projects").join(&folder);
+        let file = source.join(format!("{session_id}.jsonl"));
+        if !file.is_file() {
+            continue;
+        }
+        let target = to.join("projects").join(&folder);
+        create_private_dirs(&target)?;
+        let mut copied = copy_new(&file, &target.join(format!("{session_id}.jsonl")))?;
+        let sub_agents = source.join(session_id);
+        if sub_agents.is_dir() {
+            copied |= copy_tree_new(&sub_agents, &target.join(session_id))?;
+        }
+        return Ok(copied);
+    }
+    Ok(false)
+}
+
+fn copy_new(from: &Path, to: &Path) -> io::Result<bool> {
+    if to.symlink_metadata().is_ok() {
+        return Ok(false);
+    }
+    std::fs::copy(from, to)?;
+    Ok(true)
+}
+
+fn copy_tree_new(from: &Path, to: &Path) -> io::Result<bool> {
+    create_private_dirs(to)?;
+    let mut copied = false;
+    for entry in std::fs::read_dir(from)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        let target = to.join(entry.file_name());
+        if kind.is_dir() {
+            copied |= copy_tree_new(&entry.path(), &target)?;
+        } else if kind.is_file() {
+            copied |= copy_new(&entry.path(), &target)?;
+        }
+    }
+    Ok(copied)
+}
