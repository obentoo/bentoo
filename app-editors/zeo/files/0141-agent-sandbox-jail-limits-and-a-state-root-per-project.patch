+/// One of `agent_sandbox.limits`' fields.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum LimitField {
+    Memory,
+    CpuQuota,
+    MaxTasks,
+    DiskQuota,
+}
+
+/// A limit as it is written to the settings file.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum LimitValue {
+    Size(String),
+    Count(u64),
+}
+
+impl LimitField {
+    pub(crate) const ALL: [LimitField; 4] = [
+        LimitField::Memory,
+        LimitField::CpuQuota,
+        LimitField::MaxTasks,
+        LimitField::DiskQuota,
+    ];
+
+    pub(crate) fn field(self) -> &'static str {
+        match self {
+            LimitField::Memory => "memory",
+            LimitField::CpuQuota => "cpu_quota",
+            LimitField::MaxTasks => "max_tasks",
+            LimitField::DiskQuota => "disk_quota",
+        }
+    }
+
+    fn title(self) -> &'static str {
+        match self {
+            LimitField::Memory => "Memory",
+            LimitField::CpuQuota => "CPU",
+            LimitField::MaxTasks => "Processes",
+            LimitField::DiskQuota => "Disk Growth",
+        }
+    }
+
+    fn placeholder(self) -> &'static str {
+        match self {
+            LimitField::Memory => "Memory for this project (e.g. 4G, 0 for none)…",
+            LimitField::CpuQuota => "Percent of one CPU (e.g. 200, 0 for none)…",
+            LimitField::MaxTasks => "Processes and threads (e.g. 2048, 0 for none)…",
+            LimitField::DiskQuota => "Disk growth before a pause (e.g. 20G, 0 for none)…",
+        }
+    }
+
+    /// The value in force, as the page shows it.
+    fn shown(self, limits: &SandboxLimits) -> String {
+        let on = limits.effective();
+        let text = match self {
+            LimitField::Memory => on.memory,
+            LimitField::CpuQuota => on.cpu_quota.map(|quota| format!("{quota} %")),
+            LimitField::MaxTasks => on.max_tasks.map(|tasks| tasks.to_string()),
+            LimitField::DiskQuota => on.disk_quota,
+        };
+        text.unwrap_or_else(|| "No limit".to_string())
+    }
+
+    /// Whether the project's own entry sets this limit.
+    fn is_set(self, own: &SandboxLimits) -> bool {
+        match self {
+            LimitField::Memory => own.memory.is_some(),
+            LimitField::CpuQuota => own.cpu_quota.is_some(),
+            LimitField::MaxTasks => own.max_tasks.is_some(),
+            LimitField::DiskQuota => own.disk_quota.is_some(),
+        }
+    }
+
+    /// `raw` as this limit, or the rule it breaks. The memory rule is ai-jail's own (a whole
+    /// number with an optional K, M, G or T), so nothing the page saves is refused at the start;
+    /// the disk quota is read by Zeo's watchdog, which also takes `B` and `iB`.
+    pub(crate) fn parse(self, raw: &str) -> Result<LimitValue, String> {
+        let raw = raw.trim();
+        match self {
+            LimitField::Memory => {
+                let digits = raw.strip_suffix(['K', 'M', 'G', 'T', 'k', 'm', 'g', 't']);
+                let digits = digits.unwrap_or(raw);
+                if !digits.is_empty() && digits.bytes().all(|byte| byte.is_ascii_digit()) {
+                    Ok(LimitValue::Size(raw.to_string()))
+                } else {
+                    Err(format!(
+                        "{raw:?} is not a memory size: a whole number with an optional K, M, G or T (8G), or 0 for none."
+                    ))
+                }
+            }
+            LimitField::DiskQuota => {
+                if raw == "0" || parse_size(raw).is_some() {
+                    Ok(LimitValue::Size(raw.to_string()))
+                } else {
+                    Err(format!(
+                        "{raw:?} is not a disk size: a whole number with an optional K, M, G or T (20G), or 0 for none."
+                    ))
+                }
+            }
+            LimitField::CpuQuota => raw
+                .parse::<u32>()
+                .map(|quota| LimitValue::Count(quota.into()))
+                .map_err(|_| {
+                    format!(
+                        "{raw:?} is not a percentage of one CPU (400 is four CPUs), or 0 for none."
+                    )
+                }),
+            LimitField::MaxTasks => raw
+                .parse::<u64>()
+                .map(LimitValue::Count)
+                .map_err(|_| format!("{raw:?} is not a number of processes, or 0 for none.")),
+        }
+    }
+
+    /// Writes `value` into `limits`; `None` removes the project's own value, so the default is
+    /// back in force.
+    pub(crate) fn apply(self, limits: &mut AgentSandboxLimitsContent, value: Option<LimitValue>) {
+        let size = |value: &Option<LimitValue>| match value {
+            Some(LimitValue::Size(text)) => Some(text.clone()),
+            Some(LimitValue::Count(count)) => Some(count.to_string()),
+            None => None,
+        };
+        let count = |value: &Option<LimitValue>| match value {
+            Some(LimitValue::Count(count)) => Some(*count),
+            Some(LimitValue::Size(text)) => text.parse().ok(),
+            None => None,
+        };
+        match self {
+            LimitField::Memory => limits.memory = size(&value),
+            LimitField::DiskQuota => limits.disk_quota = size(&value),
+            LimitField::CpuQuota => {
+                limits.cpu_quota = count(&value).and_then(|quota| u32::try_from(quota).ok())
+            }
+            LimitField::MaxTasks => limits.max_tasks = count(&value),
+        }
+    }
+}
+
+/// Sets (or, with `None`, clears) the project's own `field`. `resolved` is the key the root
+/// resolves to through a symlink, as for the lists.
+pub(crate) fn write_limit(
+    root: &Path,
+    resolved: Option<String>,
+    field: LimitField,
+    value: Option<LimitValue>,
+    cx: &mut App,
+) -> Task<Result<(), String>> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        return Task::ready(Err(non_utf8_root_message(root)));
+    };
+    cx.spawn(async move |cx| write_limit_async(root_text, resolved, field, value, cx).await)
+}
+
+async fn write_limit_async(
+    root_text: String,
+    resolved: Option<String>,
+    field: LimitField,
+    value: Option<LimitValue>,
+    cx: &mut AsyncApp,
+) -> Result<(), String> {
+    let written_key = Arc::new(OnceLock::new());
+    let receiver = cx.update(|cx| {
+        let written_key = written_key.clone();
+        cx.global::<SettingsStore>()
+            .update_settings_file_with_completion(<dyn Fs>::global(cx), move |content, _| {
+                let projects = content
+                    .agent_sandbox
+                    .get_or_insert_default()
+                    .projects
+                    .get_or_insert_default();
+                let key = target_project_key(
+                    projects.keys(),
+                    &root_text,
+                    resolved.as_deref().map(Path::new),
+                );
+                written_key
+                    .set(format!(
+                        "agent_sandbox.projects[{key}].limits.{}",
+                        field.field()
+                    ))
+                    .ok();
+                let entry = projects.entry(key).or_default();
+                let limits = entry.limits.get_or_insert_default();
+                field.apply(limits, value);
+                if *limits == AgentSandboxLimitsContent::default() {
+                    entry.limits = None;
+                }
+            })
+    });
+    let error = match receiver.await {
+        Ok(Ok(())) => return Ok(()),
+        Ok(Err(error)) => error,
+        Err(oneshot::Canceled) => anyhow::anyhow!("the settings writer stopped before saving"),
+    };
+    let key = written_key
+        .get()
+        .cloned()
+        .unwrap_or_else(|| format!("agent_sandbox.projects.limits.{}", field.field()));
+    let error = first_line(&error);
+    log::error!("agent_sandbox event=settings_write_failed key={key:?} error={error:?}");
+    Err(format!("Could not save the agent sandbox setting: {error}"))
+}
+
+/// The limits block: each limit in force, a reset on the ones this project sets, an input to set
+/// one, and the state folder with how to log in to it.
+pub(crate) fn render_limits(
+    limits: &SandboxLimits,
+    own: &SandboxLimits,
+    state_dir: Option<&PathBuf>,
+    error: Option<(LimitField, String)>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let mut rows = Vec::with_capacity(LimitField::ALL.len());
+    for field in LimitField::ALL {
+        let action = if field.is_set(own) {
+            let label = format!("Use the default {}", field.title().to_lowercase());
+            let id = format!("agent-jail-limit-{}-reset", field.field());
+            let button = IconButton::new(SharedString::from(id.clone()), IconName::RotateCcw)
+                .icon_size(IconSize::Small)
+                .icon_color(Color::Muted)
+                .tab_index(0_isize)
+                .aria_label(label.clone())
+                .tooltip(Tooltip::text(label))
+                .on_click({
+                    let state = state.clone();
+                    move |_, _, cx| {
+                        state.update(cx, |state, cx| state.set_limit(field, None, cx));
+                    }
+                });
+            reveal(state, id, scroll_handle, button, cx)
+        } else {
+            Label::new("Default for every project")
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .into_any_element()
+        };
+        let input_id = format!("agent-jail-limit-{}-new", field.field());
+        let input = SettingsInputField::new(SharedString::from(input_id.clone()))
+            .with_placeholder(field.placeholder())
+            .aria_label(format!("{} limit for this project", field.title()))
+            .tab_index(0)
+            .with_buffer_font()
+            .display_confirm_button()
+            .clear_on_confirm()
+            .on_confirm({
+                let state = state.clone();
+                move |raw, _window, cx| {
+                    let Some(raw) = raw.filter(|raw| !raw.trim().is_empty()) else {
+                        return;
+                    };
+                    state.update(cx, |state, cx| match field.parse(&raw) {
+                        Ok(value) => state.set_limit(field, Some(value), cx),
+                        Err(rule) => state.show_limit_error(field, rule, cx),
+                    });
+                }
+            });
+        rows.push(
+            v_flex()
+                .gap_1()
+                .child(
+                    h_flex()
+                        .gap_2()
+                        .justify_between()
+                        .child(
+                            h_flex()
+                                .gap_2()
+                                .child(Label::new(field.title()).size(LabelSize::Small))
+                                .child(
+                                    Label::new(field.shown(limits))
+                                        .size(LabelSize::Small)
+                                        .buffer_font(cx),
+                                ),
+                        )
+                        .child(action),
+                )
+                .child(reveal(state, input_id, scroll_handle, input, cx))
+                .when_some(
+                    error.as_ref().filter(|(at, _)| *at == field),
+                    |this, (_, error)| {
+                        this.child(
+                            Label::new(error.clone())
+                                .size(LabelSize::Small)
+                                .color(Color::Error),
+                        )
+                    },
+                ),
+        );
+    }
+    v_flex()
+        .gap_0p5()
+        .child(Label::new("Resource Limits"))
+        .child(
+            Label::new(
+                "Applied by ai-jail to the whole jail. Past the disk growth the agent is paused, not stopped. 0 turns a limit off for this project.",
+            )
+            .size(LabelSize::Small)
+            .color(Color::Muted),
+        )
+        .child(v_flex().mt_2().gap_2().children(rows))
+        .when_some(state_dir, |this, dir| {
+            let claude = dir.join("claude");
+            this.child(
+                v_flex()
+                    .mt_3()
+                    .gap_0p5()
+                    .child(Label::new("State Folder"))
+                    .child(
+                        Label::new("This project's jail keeps its home, /tmp and Claude login in:")
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    )
+                    .child(
+                        Label::new(dir.display().to_string())
+                            .size(LabelSize::Small)
+                            .buffer_font(cx),
+                    )
+                    .child(
+                        Label::new("To log in before the first start, run:")
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    )
+                    .child(
+                        Label::new(format!("CLAUDE_CONFIG_DIR={} claude", claude.display()))
+                            .size(LabelSize::Small)
+                            .buffer_font(cx),
+                    ),
+            )
+        })
+        .into_any_element()
+}
