+// Zeo proposal §6.63 (operator, 2026-11-22): the lock says which cores a jail reserved, and
+// warns when it shares them. Filter: `cpu_tests`.
+use std::path::PathBuf;
+
+use agent_sandbox::cpu_reserve::CpuReservation;
+use agent_sandbox::launch::{LaunchRecord, MemoryPort, Reason};
+use project::agent_server_store::AgentId;
+use ui::Color;
+
+use super::*;
+
+fn jailed() -> LaunchRecord {
+    LaunchRecord {
+        agent_id: AgentId::new("Test"),
+        project_root: PathBuf::from("/w/app"),
+        reason: Reason::On,
+        ai_jail_version: Some(semver::Version::parse("3.5.0").expect("version")),
+        ai_jail_path: None,
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        forward_ports: Vec::new(),
+        memory_port: MemoryPort::Off,
+        settings_fingerprint: 0,
+        memory_fingerprint: 0,
+        settings_key: None,
+        jail_pid: None,
+        paused: false,
+        claude_config_dir: None,
+        ai_jail_missing: false,
+    }
+}
+
+#[test]
+fn the_lock_names_the_reserved_cores() {
+    let summary =
+        jail_status_summary(&jailed(), false).with_cpu_reservation(Some(&CpuReservation {
+            cpus: vec![28, 29, 30, 31],
+            shared: false,
+        }));
+    assert!(
+        summary
+            .lines
+            .iter()
+            .any(|line| line.as_ref() == "Reserved CPUs: 28-31"),
+        "{:?}",
+        summary.lines
+    );
+    assert_eq!(summary.color, Color::Default);
+}
+
+/// Hostile: a jail that shares its cores says so, in warning.
+#[test]
+fn the_lock_warns_when_the_cores_are_shared() {
+    let summary =
+        jail_status_summary(&jailed(), false).with_cpu_reservation(Some(&CpuReservation {
+            cpus: vec![4, 5],
+            shared: true,
+        }));
+    assert!(
+        summary
+            .lines
+            .iter()
+            .any(|line| line.starts_with("Shares CPUs 4-5 with another jail")),
+        "{:?}",
+        summary.lines
+    );
+    assert_eq!(summary.color, Color::Warning);
+}
+
+#[test]
+fn the_quota_alone_adds_no_line() {
+    let plain = jail_status_summary(&jailed(), false);
+    assert_eq!(plain.clone().with_cpu_reservation(None), plain);
+}
