diff --git a/crates/agent_sandbox/src/cpu_reserve.rs b/crates/agent_sandbox/src/cpu_reserve.rs
new file mode 100644
index 0000000..a60502d
--- /dev/null
+++ b/crates/agent_sandbox/src/cpu_reserve.rs
@@ -0,0 +1,84 @@
+//! CPU reservation for jails (Zeo proposal §6.63 step 3, operator decision 2026-11-22).
+//!
+//! By default a jail has its CPU quota alone: time, spread over every core, as before. A jail
+//! *reserves* cores only when its project asks (`agent_sandbox.limits.reserve_cpus`, also
+//! switched from the thread's lock) or when it gets ai-jail's synthetic host view
+//! (`mask_host`, whose CPU files must match the cores the jail can run on). A reservation is
+//! `ceil(quota / 100)` cores, disjoint from every other live reservation: the free cores Zeo
+//! may use, the last ones first, away from CPU 0, which takes most interrupts. When too few are
+//! free the jail still pins, to the least-shared cores, and the reservation says it is shared:
+//! the lock shows it, so the operator knows this jail competes with another for those cores.
+//! Reservations live in the `LaunchRegistry`, keyed by launch, and end with it.
+
+use std::collections::HashMap;
+
+/// The cores one jail is pinned to.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CpuReservation {
+    /// Ascending.
+    pub cpus: Vec<u32>,
+    /// Some of them are another live jail's too: not enough cores were free.
+    pub shared: bool,
+}
+
+impl CpuReservation {
+    /// The cores as an ai-jail `--cpus` list: `28-31`, `4-6,9`.
+    pub fn list(&self) -> String {
+        format_cpu_list(&self.cpus)
+    }
+}
+
+/// How many cores a CPU quota pays for: `ceil(quota / 100)`; none without a quota.
+pub fn quota_cores(quota: Option<u32>) -> usize {
+    quota
+        .filter(|quota| *quota > 0)
+        .map_or(0, |quota| quota.div_ceil(100) as usize)
+}
+
+/// `count` of the `online` cores, avoiding `taken` (every live reservation's cores, a core once
+/// per jail holding it). `None` when nothing is asked, nothing is known, or `count` covers every
+/// core -- a pin to all of them changes nothing.
+pub fn reserve(count: usize, online: &[u32], taken: &[u32]) -> Option<CpuReservation> {
+    let mut cores = online.to_vec();
+    cores.sort_unstable();
+    cores.dedup();
+    if count == 0 || count >= cores.len() {
+        return None;
+    }
+    let mut uses: HashMap<u32, usize> = HashMap::new();
+    for core in taken {
+        *uses.entry(*core).or_default() += 1;
+    }
+    let use_of = |core: &u32| uses.get(core).copied().unwrap_or(0);
+    // Least used first; among equals, the highest-numbered first.
+    cores.sort_by(|a, b| use_of(a).cmp(&use_of(b)).then(b.cmp(a)));
+    let mut cpus: Vec<u32> = cores.into_iter().take(count).collect();
+    let shared = cpus.iter().any(|core| use_of(core) > 0);
+    cpus.sort_unstable();
+    Some(CpuReservation { cpus, shared })
+}
+
+/// `cpus`, sorted, as ranges: `[4, 5, 6, 9]` is `4-6,9`.
+pub fn format_cpu_list(cpus: &[u32]) -> String {
+    let mut parts = Vec::new();
+    let mut ix = 0;
+    while ix < cpus.len() {
+        let start = cpus[ix];
+        let mut end = start;
+        while ix + 1 < cpus.len() && cpus[ix + 1] == end + 1 {
+            ix += 1;
+            end = cpus[ix];
+        }
+        parts.push(if start == end {
+            start.to_string()
+        } else {
+            format!("{start}-{end}")
+        });
+        ix += 1;
+    }
+    parts.join(",")
+}
+
+#[cfg(test)]
+#[path = "cpu_reserve_tests.rs"]
+mod cpu_reserve_tests;
diff --git a/crates/agent_sandbox/src/cpu_reserve_tests.rs b/crates/agent_sandbox/src/cpu_reserve_tests.rs
new file mode 100644
index 0000000..41a7b93
--- /dev/null
+++ b/crates/agent_sandbox/src/cpu_reserve_tests.rs
@@ -0,0 +1,74 @@
+// Zeo proposal §6.63 step 3 (operator, 2026-11-22): reserved cores are disjoint while enough are
+// free, shared -- and said so -- when they run out, and free again when a launch ends. Filter:
+// `cpu_reserve`.
+
+use super::*;
+
+fn host(n: u32) -> Vec<u32> {
+    (0..n).collect()
+}
+
+#[test]
+fn cpu_reserve_takes_the_last_free_cores() {
+    let first = reserve(4, &host(32), &[]).expect("a reservation");
+    assert_eq!(first.cpus, vec![28, 29, 30, 31]);
+    assert!(!first.shared);
+    assert_eq!(first.list(), "28-31");
+}
+
+#[test]
+fn cpu_reserve_keeps_live_reservations_disjoint() {
+    let mut taken = Vec::new();
+    let mut seen = Vec::new();
+    for _ in 0..4 {
+        let reservation = reserve(4, &host(16), &taken).expect("a reservation");
+        assert!(!reservation.shared, "{reservation:?} with {taken:?} taken");
+        for core in &reservation.cpus {
+            assert!(!seen.contains(core), "core {core} reserved twice");
+            seen.push(*core);
+        }
+        taken.extend(&reservation.cpus);
+    }
+    assert_eq!(seen.len(), 16);
+}
+
+/// Hostile: when cores run out the jail is told it shares, and gets the least-shared ones.
+#[test]
+fn cpu_reserve_shares_the_least_used_cores_when_exhausted() {
+    let taken: Vec<u32> = (0..8).chain(0..4).collect();
+    let reservation = reserve(4, &host(8), &taken).expect("a reservation");
+    assert!(reservation.shared);
+    assert_eq!(
+        reservation.cpus,
+        vec![4, 5, 6, 7],
+        "4-7 are held once, 0-3 twice"
+    );
+}
+
+#[test]
+fn cpu_reserve_frees_cores_when_a_launch_ends() {
+    let a = reserve(4, &host(8), &[]).expect("a");
+    let b = reserve(4, &host(8), &a.cpus).expect("b");
+    assert!(!b.shared);
+    // `a` ended: its cores are no longer taken, so the next jail gets them unshared.
+    let c = reserve(4, &host(8), &b.cpus).expect("c");
+    assert!(!c.shared);
+    assert_eq!(c.cpus, a.cpus);
+}
+
+#[test]
+fn cpu_reserve_pins_nothing_without_a_quota_or_for_every_core() {
+    assert_eq!(reserve(0, &host(8), &[]), None);
+    assert_eq!(reserve(8, &host(8), &[]), None, "all of them is no pin");
+    assert_eq!(reserve(4, &[], &[]), None, "unknown cores: no pin");
+    assert_eq!(quota_cores(None), 0);
+    assert_eq!(quota_cores(Some(0)), 0);
+    assert_eq!(quota_cores(Some(150)), 2, "rounded up");
+    assert_eq!(quota_cores(Some(400)), 4);
+}
+
+#[test]
+fn cpu_reserve_formats_ranges() {
+    assert_eq!(format_cpu_list(&[4, 5, 6, 9]), "4-6,9");
+    assert_eq!(format_cpu_list(&[31]), "31");
+}
