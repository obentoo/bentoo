+/// Sets the project's `agent_sandbox.projects[root].limits.reserve_cpus` (§6.63, the thread's
+/// "Reserve CPUs"). Resolves to `true` only when the file was saved; a restart applies it.
+pub fn set_project_reserve_cpus(root: &Path, reserve: bool, cx: &mut App) -> Task<bool> {
+    let Some(root_text) = root.to_str().map(str::to_string) else {
+        refuse_non_utf8_root(root, cx);
+        return Task::ready(false);
+    };
+    let root = root.to_path_buf();
+    cx.spawn(async move |cx| {
+        let keys: Vec<String> = cx.update(|cx| {
+            AgentSandboxSettings::get_global(cx)
+                .projects
+                .keys()
+                .cloned()
+                .collect()
+        });
+        let resolved = cx
+            .background_executor()
+            .spawn(async move {
+                resolve_project_key(keys.iter().map(String::as_str), &root).map(PathBuf::from)
+            })
+            .await;
+        let fallback = format!("agent_sandbox.projects[{root_text}].limits.reserve_cpus");
+        save(
+            cx,
+            move |content| {
+                let projects = content
+                    .agent_sandbox
+                    .get_or_insert_default()
+                    .projects
+                    .get_or_insert_default();
+                let key = target_project_key(projects.keys(), &root_text, resolved.as_deref());
+                let label = format!("agent_sandbox.projects[{key}].limits.reserve_cpus");
+                projects
+                    .entry(key)
+                    .or_default()
+                    .limits
+                    .get_or_insert_default()
+                    .reserve_cpus = Some(reserve);
+                label
+            },
+            fallback,
+        )
+        .await
+    })
+}
