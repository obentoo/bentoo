new file mode 100644
index 0000000..1036d3c
--- /dev/null
+++ b/crates/agent_sandbox/src/skill_maps.rs
@@ -0,0 +1,56 @@
+//! Zeo's skills inside the jail (Zeo proposal §6.69 step 2, 2026-11-22).
+//!
+//! Zeo hands Claude Agent (Plus) its skills as plugin directories under its data dir, each a
+//! `skills` symlink to `~/.agents/skills` or to a project's `.agents/skills`
+//! (`agent_servers::zeo_skills_plugin`). A jailed agent sees the project, but neither Zeo's data
+//! dir nor the real home: both folders are mapped read-only, at their own paths, so the plugin
+//! paths and the symlinks resolve inside as outside. Only folders that exist are mapped; the
+//! launch makes the plugin root first, since Zeo fills it at session/new, after the jail starts
+//! (the round-2 Xvfb proof found the first jailed start without the map).
+
+use std::path::{Path, PathBuf};
+
+/// The folder under Zeo's data dir holding the plugin directories; the same name as
+/// `agent_servers::zeo_skills_plugin::SKILL_PLUGINS_DIR`, which this crate cannot depend on.
+pub const SKILL_PLUGINS_DIR: &str = "agent-skill-plugins";
+
+/// The read-only maps a jail needs for Zeo's skills: the plugin root and `~/.agents/skills`,
+/// those of them that are folders (`is_dir` is the file-system check, a parameter for tests).
+pub fn skill_maps(home: &Path, data_dir: &Path, is_dir: impl Fn(&Path) -> bool) -> Vec<PathBuf> {
+    [
+        data_dir.join(SKILL_PLUGINS_DIR),
+        home.join(".agents/skills"),
+    ]
+    .into_iter()
+    .filter(|path| is_dir(path))
+    .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn skill_maps_name_the_plugin_root_and_the_users_skills() {
+        let maps = skill_maps(
+            Path::new("/h/u"),
+            Path::new("/h/u/.local/share/zeo"),
+            |_| true,
+        );
+        assert_eq!(
+            maps,
+            vec![
+                PathBuf::from("/h/u/.local/share/zeo/agent-skill-plugins"),
+                PathBuf::from("/h/u/.agents/skills"),
+            ]
+        );
+    }
+
+    #[test]
+    fn skill_maps_leave_out_what_is_not_there() {
+        let maps = skill_maps(Path::new("/h/u"), Path::new("/d"), |path| {
+            path == Path::new("/h/u/.agents/skills")
+        });
+        assert_eq!(maps, vec![PathBuf::from("/h/u/.agents/skills")]);
+    }
+}
