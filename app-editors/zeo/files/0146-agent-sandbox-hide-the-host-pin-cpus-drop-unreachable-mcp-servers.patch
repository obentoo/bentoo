+//! What a jail shows of the host (Zeo proposal §6.63, ask 86), the claude.ai connectors it lets
+//! through (§6.64), and which of Zeo's MCP servers it can run (§6.64 step 1).
+//!
+//! ai-jail binds `/etc` and `/sys` read-only whole and masks hardware only under `--lockdown`,
+//! which Zeo cannot use (it makes the project read-only too). So every jail gets ai-jail's own
+//! `--mask` on the paths that name this machine or what it runs: its real hostname (UTS already
+//! says `ai-sandbox`), its fstab, its boot command line (disk-encryption names), its network
+//! interface names, its board (DMI) and its machine id. `/proc/uptime` is not masked: `uptime`
+//! must work in a default jail (operator, 2026-11-22); under `mask_host` ai-jail writes a
+//! synthetic one. ai-jail 3.5.0's `--mask` turns a
+//! file into an empty read-only file and a folder into an empty tmpfs, after every base mount, so
+//! the masks land on top of `/proc` and `/sys`; a path this machine lacks is left out (ai-jail
+//! would only warn). ai-jail's `--mask-host` covers none of these.
+//!
+//! What it costs, measured 2026-11-22 (bubblewrap 0.13.0, the same binds): `ps`, `top` and `ls`
+//! work. A bind over a `/proc`
+//! file also makes the kernel refuse a nested procfs mount (`mount_too_revealing`), but nested
+//! sandboxes -- bwrap, podman, Claude Code's own Bash sandbox -- already fail inside a default
+//! jail because of ai-jail's Landlock and seccomp (the ai-jail lane's finding, 2026-11-22), so
+//! that costs nothing either.
+//!
+//! `agent_sandbox.mask_host` adds ai-jail's `--mask-host`: CPU and memory files sized to the
+//! limits, only the jail's own cgroup, a per-jail machine id (so the empty machine-id mask is
+//! left out under it). Zeo's disk watchdog finds the jail's scope through `/proc/<pid>/cgroup`
+//! read from outside the jail, which a cgroup namespace inside does not change (reasoned, not
+//! measured).
+//!
+//! The CPU quota alone is time, spread over every core: `nproc` (which reads the cgroup's
+//! `cpu.max`) says 4 while `getconf` and runtimes asking `sched_getaffinity` say 32. A jail that
+//! reserves cores (`cpu_reserve`) is pinned with `--cpus`, and then they all agree.
+//!
+//! This hides, it does not isolate: `cpuid`, timing, `uname(2)` and mount sources stay visible
+//! short of a VM.
+
+use std::path::{Component, Path, PathBuf};
+
+use crate::launch::{LaunchRecord, Reason};
+
+/// Masked in every jail: files become empty, folders an empty tmpfs.
+pub const HOST_MASKS: [&str; 6] = [
+    "/etc/hostname",
+    "/etc/fstab",
+    "/proc/cmdline",
+    "/sys/class/net",
+    "/sys/class/dmi",
+    "/sys/devices/virtual/dmi",
+];
+
+/// Masked in every jail unless `mask_host` is on, where ai-jail writes a per-jail id instead.
+pub const MACHINE_ID: &str = "/etc/machine-id";
+
+/// ai-jail's option for the synthetic host view (§6.63 step 2).
+pub const MASK_HOST_OPTION: &str = "--mask-host";
+
+/// The variable Claude Code reads to load the account's claude.ai connectors. They are reached
+/// through `mcp-proxy.anthropic.com`, so a jail that allows `anthropic.com` would let every one
+/// of them past `allow_hosts`; jails set it to `false` unless the project turns them on.
+pub const CONNECTORS_ENV: &str = "ENABLE_CLAUDEAI_MCP_SERVERS";
+
+/// The ai-jail options that hide the host, for the paths that exist here (ai-jail warns on a
+/// missing one and applies nothing). `exists` is the file-system check, a parameter so the rule
+/// is tested without this machine's `/etc`.
+pub fn host_args(mask_host: bool, exists: impl Fn(&Path) -> bool) -> Vec<String> {
+    let mut paths: Vec<&str> = HOST_MASKS.to_vec();
+    if !mask_host {
+        paths.push(MACHINE_ID);
+    }
+    let mut args = Vec::new();
+    for path in paths {
+        if exists(Path::new(path)) {
+            args.extend(["--mask".to_string(), path.to_string()]);
+        }
+    }
+    if mask_host {
+        args.push(MASK_HOST_OPTION.to_string());
+    }
+    args
+}
+
+/// A kernel CPU list (`0-3,8,10-11`) as CPU numbers; an unreadable part is skipped.
+pub fn parse_cpu_list(text: &str) -> Vec<u32> {
+    let mut cpus = Vec::new();
+    for part in text.trim().split(',').map(str::trim) {
+        match part.split_once('-') {
+            Some((start, end)) => {
+                if let (Ok(start), Ok(end)) = (start.parse::<u32>(), end.parse::<u32>())
+                    && start <= end
+                {
+                    cpus.extend(start..=end);
+                }
+            }
+            None => {
+                if let Ok(cpu) = part.parse() {
+                    cpus.push(cpu);
+                }
+            }
+        }
+    }
+    cpus
+}
+
+/// The CPUs Zeo itself may run on, from `/proc/self/status`; empty where it cannot be read.
+pub fn allowed_cpus() -> Vec<u32> {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|status| {
+            status
+                .lines()
+                .find_map(|line| line.strip_prefix("Cpus_allowed_list:"))
+                .map(parse_cpu_list)
+        })
+        .unwrap_or_default()
+}
+
+/// The host folders a jail sees at their own path: the system folders ai-jail binds read-only,
+/// then `own` -- the project and the writable folders. The jail's home is its own, so nothing
+/// else under the real home is there.
+pub fn visible_roots(own: impl IntoIterator<Item = PathBuf>) -> Vec<PathBuf> {
+    ["/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc", "/opt"]
+        .into_iter()
+        .map(PathBuf::from)
+        .chain(own)
+        .collect()
+}
+
+/// [`visible_roots`] for a jailed launch: its project, as spelled and resolved, and its writable
+/// folders (the state folder first). `None` for a start that is not jailed.
+pub fn jail_roots(record: &LaunchRecord) -> Option<Vec<PathBuf>> {
+    if record.reason != Reason::On {
+        return None;
+    }
+    let mut own = vec![record.project_root.clone()];
+    if let Ok(resolved) = record.project_root.canonicalize()
+        && resolved != record.project_root
+    {
+        own.push(resolved);
+    }
+    own.extend(record.rw_maps.iter().cloned());
+    Some(visible_roots(own))
+}
+
+/// The first path a stdio MCP server needs that the jail does not show: its command, or an
+/// absolute argument naming a file or folder outside every one of `roots`. `None` when the server
+/// can start inside. An argument that is a flag with an absolute value (`--config=/x`) counts by
+/// its value.
+pub fn hidden_server_path<'a>(
+    command: &'a Path,
+    args: &'a [String],
+    roots: &[PathBuf],
+) -> Option<&'a Path> {
+    // `..` is never resolved here: `/usr/../home/x` is outside `/usr`.
+    let visible = |path: &Path| {
+        !path
+            .components()
+            .any(|component| component == Component::ParentDir)
+            && roots.iter().any(|root| path.starts_with(root))
+    };
+    if command.is_absolute() && !visible(command) {
+        return Some(command);
+    }
+    args.iter()
+        .map(|arg| match arg.split_once('=') {
+            Some((flag, value)) if flag.starts_with('-') => value,
+            _ => arg.as_str(),
+        })
+        .map(Path::new)
+        .find(|path| path.is_absolute() && !visible(path))
+}
+
+#[cfg(test)]
+#[path = "host_view_tests.rs"]
+mod host_view_tests;
