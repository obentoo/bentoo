+impl JailStatusSummary {
+    /// The cores the jail reserved (§6.63), and a warning when it shares them: too few cores
+    /// were free when it started, so it competes with another reserving jail.
+    pub fn with_cpu_reservation(mut self, reservation: Option<&CpuReservation>) -> Self {
+        let Some(reservation) = reservation else {
+            return self;
+        };
+        if reservation.shared {
+            self.lines.push(cpu_shared_line(reservation).into());
+            self.color = Color::Warning;
+        } else {
+            self.lines
+                .push(format!("Reserved CPUs: {}", reservation.list()).into());
+        }
+        self
+    }
+}
+
+/// The warning a jail that shares its reserved cores shows.
+pub fn cpu_shared_line(reservation: &CpuReservation) -> String {
+    format!(
+        "Shares CPUs {} with another jail: too few cores were free when it started.",
+        reservation.list()
+    )
+}
+
+/// The label beside the lock of a jail whose reserved cores are shared (§6.63).
+pub const CPU_SHARED_LABEL: &str = "Shares CPUs";
+
+/// The thread's "Reserve CPUs" switch beside the lock (§6.63, operator 2026-11-22): pins the
+/// project's jail to cores of its own, or lets the quota alone limit it. A click writes the
+/// project's `limits.reserve_cpus` and restarts the agent, which applies it.
+pub fn render_cpu_reservation_toggle(
+    reserving: bool,
+    shared: bool,
+    on_toggle: Box<dyn Fn(&mut Window, &mut App)>,
+) -> AnyElement {
+    let (icon, tooltip) = if reserving {
+        (
+            IconName::Unpin,
+            "Stop Reserving CPUs: the quota alone limits this jail (restarts the agent)",
+        )
+    } else {
+        (
+            IconName::Pin,
+            "Reserve CPUs: pin this jail to cores no other reserving jail uses (restarts the agent)",
+        )
+    };
+    h_flex()
+        .gap_1()
+        .when(shared, |this| {
+            this.child(
+                Label::new(CPU_SHARED_LABEL)
+                    .size(LabelSize::Small)
+                    .color(Color::Warning),
+            )
+        })
+        .child(
+            IconButton::new("agent-jail-reserve-cpus", icon)
+                .icon_size(IconSize::Small)
+                .icon_color(if shared { Color::Warning } else { Color::Muted })
+                .tooltip(Tooltip::text(tooltip))
+                .on_click(move |_, window, cx| on_toggle(window, cx)),
+        )
+        .into_any_element()
+}
