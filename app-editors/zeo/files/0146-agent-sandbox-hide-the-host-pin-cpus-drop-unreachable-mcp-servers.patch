@@ -0,0 +1,85 @@
+// Zeo proposal §6.64 step 1: a jailed session is not handed a server it cannot start. Filter:
+// `jail_servers`.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use project::context_server_store::ContextServerConfiguration;
+use settings::ContextServerCommand;
+
+use super::split_hidden;
+
+fn stdio(path: &str, args: &[&str]) -> Arc<ContextServerConfiguration> {
+    Arc::new(ContextServerConfiguration::Custom {
+        command: ContextServerCommand {
+            path: PathBuf::from(path),
+            args: args.iter().map(|arg| arg.to_string()).collect(),
+            env: None,
+            timeout: None,
+        },
+        remote: false,
+        launcher: None,
+    })
+}
+
+fn roots() -> Vec<PathBuf> {
+    agent_sandbox::host_view::visible_roots([PathBuf::from("/w/app")])
+}
+
+#[test]
+fn jail_servers_leave_out_an_extension_server_and_keep_the_rest() {
+    let configurations = vec![
+        (
+            "mcp-server-figma".to_string(),
+            stdio(
+                "/usr/bin/node",
+                &[
+                    "/home/u/.local/share/zeo/extensions/work/mcp-server-figma/dist/bin.js",
+                    "--figma-api-key",
+                    "SECRET",
+                ],
+            ),
+        ),
+        (
+            "project-tool".to_string(),
+            stdio("/usr/bin/node", &["/w/app/tool.js"]),
+        ),
+        (
+            "remote".to_string(),
+            Arc::new(ContextServerConfiguration::Http {
+                url: "https://mcp.example.com/mcp".parse().expect("url"),
+                headers: Default::default(),
+                timeout: None,
+                oauth: None,
+            }),
+        ),
+    ];
+    let (kept, hidden) = split_hidden(configurations, Some(&roots()));
+    let kept: Vec<&str> = kept.iter().map(|(name, _)| name.as_str()).collect();
+    assert_eq!(
+        kept,
+        ["project-tool", "remote"],
+        "http servers are not file-bound"
+    );
+    assert_eq!(hidden.len(), 1);
+    assert_eq!(hidden[0].0, "mcp-server-figma");
+    assert_eq!(
+        hidden[0].1,
+        Path::new("/home/u/.local/share/zeo/extensions/work/mcp-server-figma/dist/bin.js")
+    );
+}
+
+/// Hostile: an unjailed session keeps every server, the hidden ones included.
+#[test]
+fn jail_servers_leave_nothing_out_without_a_jail() {
+    let configurations = vec![(
+        "mcp-server-figma".to_string(),
+        stdio(
+            "/usr/bin/node",
+            &["/home/u/.local/share/zeo/extensions/x/bin.js"],
+        ),
+    )];
+    let (kept, hidden) = split_hidden(configurations, None);
+    assert_eq!(kept.len(), 1);
+    assert!(hidden.is_empty());
+}
