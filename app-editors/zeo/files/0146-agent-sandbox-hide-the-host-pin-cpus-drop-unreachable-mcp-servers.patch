+// Zeo proposal §6.63 steps 1 and 3, §6.64 step 1: what a jail shows of the host. Filter:
+// `host_view`.
+
+use std::path::{Path, PathBuf};
+
+use super::*;
+
+fn all_exist(_: &Path) -> bool {
+    true
+}
+
+#[test]
+fn host_view_masks_the_machines_names_in_every_jail() {
+    let args = host_args(false, all_exist);
+    for path in [
+        "/etc/hostname",
+        "/etc/machine-id",
+        "/etc/fstab",
+        "/proc/cmdline",
+        "/sys/class/net",
+        "/sys/class/dmi",
+        "/sys/devices/virtual/dmi",
+    ] {
+        assert!(
+            args.windows(2)
+                .any(|pair| pair[0] == "--mask" && pair[1] == path),
+            "{path} is not masked: {args:?}"
+        );
+    }
+    assert!(!args.iter().any(|arg| arg == MASK_HOST_OPTION));
+}
+
+/// Under `mask_host` ai-jail gives the jail its own machine id, which an empty mask would hide;
+/// every other mask stays, since `--mask-host` covers none of them.
+#[test]
+fn host_view_mask_host_keeps_the_masks_and_its_own_machine_id() {
+    let masked = host_args(true, all_exist);
+    assert_eq!(masked.last().map(String::as_str), Some(MASK_HOST_OPTION));
+    assert!(!masked.contains(&MACHINE_ID.to_string()), "{masked:?}");
+    for path in HOST_MASKS {
+        assert!(masked.contains(&path.to_string()), "{path}: {masked:?}");
+    }
+}
+
+#[test]
+fn host_view_skips_a_path_this_machine_lacks() {
+    let args = host_args(false, |path| path != Path::new("/etc/fstab"));
+    assert!(!args.contains(&"/etc/fstab".to_string()), "{args:?}");
+    assert!(args.contains(&"/etc/hostname".to_string()));
+}
+
+/// `uptime` must work in a default jail (operator, 2026-11-22).
+#[test]
+fn host_view_leaves_uptime_alone() {
+    for mask_host in [false, true] {
+        let args = host_args(mask_host, all_exist);
+        assert!(!args.contains(&"/proc/uptime".to_string()), "{args:?}");
+    }
+}
+
+#[test]
+fn host_view_reads_the_kernels_cpu_lists() {
+    assert_eq!(parse_cpu_list("0-3,8,10-11\n"), vec![0, 1, 2, 3, 8, 10, 11]);
+    assert_eq!(parse_cpu_list("5"), vec![5]);
+    assert_eq!(
+        parse_cpu_list("x,2"),
+        vec![2],
+        "an unreadable part is skipped"
+    );
+}
+
+fn roots() -> Vec<PathBuf> {
+    visible_roots([
+        PathBuf::from("/w/app"),
+        PathBuf::from("/var/tmp/zeo-jail/app-1"),
+    ])
+}
+
+/// The figma case of 2026-11-22: `node` is visible, its script under Zeo's extensions is not.
+#[test]
+fn host_view_finds_a_server_whose_script_the_jail_cannot_see() {
+    let args = vec![
+        "/home/u/.local/share/zeo/extensions/work/mcp-server-figma/node_modules/figma-developer-mcp/dist/bin.js".to_string(),
+        "--figma-api-key".to_string(),
+        "SECRET".to_string(),
+        "--stdio".to_string(),
+    ];
+    let hidden = hidden_server_path(Path::new("/usr/bin/node"), &args, &roots());
+    assert_eq!(hidden, Some(Path::new(args[0].as_str())));
+}
+
+#[test]
+fn host_view_keeps_a_server_whose_files_are_inside() {
+    let args = vec![
+        "/w/app/tools/server.js".to_string(),
+        "--root=/w/app".to_string(),
+    ];
+    assert_eq!(
+        hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()),
+        None
+    );
+    assert_eq!(
+        hidden_server_path(Path::new("/opt/bin/bun"), &[], &roots()),
+        None
+    );
+}
+
+#[test]
+fn host_view_finds_a_hidden_command_and_a_hidden_flag_value() {
+    let home_bin = Path::new("/home/u/.cargo/bin/server");
+    assert_eq!(hidden_server_path(home_bin, &[], &roots()), Some(home_bin));
+    let args = vec!["--config=/home/u/.config/server.toml".to_string()];
+    assert_eq!(
+        hidden_server_path(Path::new("/usr/bin/server"), &args, &roots()),
+        Some(Path::new("/home/u/.config/server.toml"))
+    );
+}
+
+/// Hostile: a parent component never counts as inside the folder it starts with, and a sibling
+/// that shares a prefix is not inside either.
+#[test]
+fn host_view_is_not_fooled_by_dot_dot_or_a_shared_prefix() {
+    let args = vec!["/usr/../home/u/x.js".to_string()];
+    assert!(hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()).is_some());
+    let args = vec!["/w/app2/x.js".to_string()];
+    assert!(hidden_server_path(Path::new("/usr/bin/node"), &args, &roots()).is_some());
+}
