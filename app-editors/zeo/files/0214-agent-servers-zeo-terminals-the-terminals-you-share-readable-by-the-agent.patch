+    /// `servers` and `zeo-terminals` after them, when the policy lets the connection reach it, the
+    /// project is local (a remote project's terminals run on the remote host) and no other
+    /// server has the name. It lists only the terminals the operator shared (§6.71).
+    pub(crate) fn declare_zeo_terminals(
+        &self,
+        project: &Entity<Project>,
+        mut servers: Vec<acp::McpServer>,
+        policy: &McpProxyPolicy,
+        cx: &App,
+    ) -> Vec<acp::McpServer> {
+        let name = super::zeo_terminals::ZEO_TERMINALS_SERVER_NAME;
+        let taken = servers.iter().any(|server| match server {
+            acp::McpServer::Stdio(stdio) => stdio.name == name,
+            acp::McpServer::Http(http) => http.name == name,
+            acp::McpServer::Acp(acp) => acp.name == name,
+            _ => false,
+        });
+        if taken
+            || !project.read(cx).is_local()
+            || !policy.allows(name)
+            || !super::zeo_terminals::enabled(cx)
+        {
+            return servers;
+        }
+        let server_id = server_id_for(project, name);
+        self.routes.borrow_mut().insert(
+            server_id.clone(),
+            Route {
+                name: name.to_string(),
+                project: project.downgrade(),
+                backend: Backend::ZeoTerminals,
+            },
+        );
+        servers.push(acp::McpServer::Acp(acp::McpServerAcp::new(name, server_id)));
+        servers
+    }
+
     fn route(&self, server_id: &str) -> Option<Route> {
         self.routes.borrow().get(server_id).cloned()
     }
