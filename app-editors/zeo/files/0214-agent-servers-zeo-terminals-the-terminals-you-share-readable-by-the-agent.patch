--- /dev/null
+++ b/crates/agent_servers/src/acp/zeo_terminals.rs
@@ -0,0 +1,250 @@
+//! `zeo-terminals`: the terminals the operator shared with the agent, readable over MCP-over-ACP
+//! like `zeo-lsp` (next proposal §6.71).
+//!
+//! ACP's `terminal/*` reaches only terminals the agent itself created, and Claude Agent (Plus)
+//! creates none, so the agent never saw what the operator runs beside it. This server lists the
+//! project's terminals the operator shared -- per terminal, from its tab (`Share with Agent`), and
+//! marked there -- and reads their last lines. Read-only, forever: it never writes to a terminal.
+//! A read is logged with the terminal and the line count, never the content. Remote projects get
+//! no declaration: their terminals run on the remote host. A jail reaches it only when chosen in
+//! its Capabilities, like any proxied server.
+
+use agent_client_protocol::v1::schema as acp;
+use gpui::{AsyncApp, Entity};
+use project::Project;
+use serde_json::{Map, Value, json};
+use terminal::{TaskStatus, Terminal};
+
+/// The server's name, as the agent sees it (`mcp__zeo-terminals__<tool>` in Claude Code).
+pub(crate) const ZEO_TERMINALS_SERVER_NAME: &str = "zeo-terminals";
+/// Lines read when the call names none, and the most one read returns.
+const DEFAULT_LINES: usize = 200;
+const MAX_LINES: usize = 2_000;
+/// The most text one read returns; older lines are dropped first.
+const MAX_BYTES: usize = 256 * 1024;
+const METHOD_NOT_FOUND: i32 = -32601;
+const INVALID_PARAMS: i32 = -32602;
+
+const INSTRUCTIONS: &str = "The terminals the user shared with you in Zeo, read-only. \
+`list_terminals` names them; `read_terminal` returns the last lines of one. Only terminals the \
+user shared from their tab are listed; ask the user to share one if you need it.";
+
+/// `agent.zeo_terminals`, default on. A test app may run without a settings store.
+pub(crate) fn enabled(cx: &gpui::App) -> bool {
+    cx.try_global::<settings::SettingsStore>()
+        .and_then(|store| store.merged_settings().agent.as_ref()?.zeo_terminals)
+        .unwrap_or(true)
+}
+
+/// One `mcp/message` for `zeo-terminals`, in `project`.
+pub(super) async fn serve(
+    project: Entity<Project>,
+    method: &str,
+    params: Option<Map<String, Value>>,
+    cx: &mut AsyncApp,
+) -> acp::MessageMcpResponse {
+    match method {
+        "server/discover" => acp::MessageMcpResponse::success(discovery()),
+        "ping" => acp::MessageMcpResponse::success(json!({})),
+        "tools/list" => acp::MessageMcpResponse::success(json!({ "tools": tool_list() })),
+        "tools/call" => {
+            let params = params.unwrap_or_default();
+            let Some(name) = params.get("name").and_then(Value::as_str) else {
+                return inner_error(INVALID_PARAMS, "tools/call needs a tool name");
+            };
+            let arguments = params
+                .get("arguments")
+                .and_then(Value::as_object)
+                .cloned()
+                .unwrap_or_default();
+            let shared = cx.update(|cx| shared_terminals(&project, cx));
+            let answer = match name {
+                "list_terminals" => Ok(cx.update(|cx| list_text(&shared, cx))),
+                "read_terminal" => cx.update(|cx| read_text(&shared, &arguments, cx)),
+                other => {
+                    return inner_error(
+                        INVALID_PARAMS,
+                        &format!("zeo-terminals has no tool {other:?}"),
+                    );
+                }
+            };
+            match answer {
+                Ok(text) => acp::MessageMcpResponse::success(tool_result(text, false)),
+                // A refused read is the tool's answer, not a protocol error: the model reads it.
+                Err(text) => acp::MessageMcpResponse::success(tool_result(text, true)),
+            }
+        }
+        other => inner_error(
+            METHOD_NOT_FOUND,
+            &format!("zeo-terminals does not serve {other}"),
+        ),
+    }
+}
+
+/// The project's terminals the operator shared, oldest first.
+fn shared_terminals(project: &Entity<Project>, cx: &gpui::App) -> Vec<Entity<Terminal>> {
+    project
+        .read(cx)
+        .local_terminals()
+        .into_iter()
+        .filter(|terminal| terminal.read(cx).shared_with_agent())
+        .collect()
+}
+
+fn terminal_id(terminal: &Entity<Terminal>) -> u64 {
+    terminal.entity_id().as_u64()
+}
+
+fn status_text(terminal: &Terminal) -> &'static str {
+    match terminal.task().map(|task| task.status) {
+        None => "shell",
+        Some(TaskStatus::Running) => "task running",
+        Some(TaskStatus::Completed { success: true }) => "task finished, exit 0",
+        Some(TaskStatus::Completed { success: false }) => "task failed, exit non-zero",
+        Some(TaskStatus::Unknown) => "task ended, status unknown",
+    }
+}
+
+fn list_text(shared: &[Entity<Terminal>], cx: &gpui::App) -> String {
+    if shared.is_empty() {
+        return "No terminal is shared with you. The user shares one from its tab's context menu \
+                (Share with Agent); a shared tab shows the agent's icon."
+            .to_string();
+    }
+    let mut text = String::new();
+    for terminal in shared {
+        let view = terminal.read(cx);
+        let directory = view
+            .working_directory()
+            .map(|dir| dir.display().to_string())
+            .unwrap_or_else(|| "unknown".to_string());
+        text.push_str(&format!(
+            "id {} -- {} -- in {} -- {}\n",
+            terminal_id(terminal),
+            view.title(false),
+            directory,
+            status_text(view),
+        ));
+    }
+    text
+}
+
+fn read_text(
+    shared: &[Entity<Terminal>],
+    arguments: &Map<String, Value>,
+    cx: &gpui::App,
+) -> Result<String, String> {
+    let Some(id) = arguments.get("id").and_then(Value::as_u64) else {
+        return Err("read_terminal needs the terminal's `id` from list_terminals".to_string());
+    };
+    let Some(terminal) = shared.iter().find(|terminal| terminal_id(terminal) == id) else {
+        return Err(format!(
+            "terminal {id} is not shared with you (or was closed); list_terminals names the shared ones"
+        ));
+    };
+    let lines = arguments
+        .get("lines")
+        .and_then(Value::as_u64)
+        .map_or(DEFAULT_LINES, |lines| lines as usize)
+        .clamp(1, MAX_LINES);
+    let view = terminal.read(cx);
+    let text = within_bytes(view.last_n_non_empty_lines(lines), MAX_BYTES);
+    log::info!(
+        "zeo_terminals event=read terminal={id} lines_asked={lines} bytes={}",
+        text.len()
+    );
+    Ok(format!(
+        "{} ({}):\n{text}",
+        view.title(false),
+        status_text(view)
+    ))
+}
+
+/// The lines joined, keeping the newest ones within `max` bytes.
+fn within_bytes(lines: Vec<String>, max: usize) -> String {
+    let mut kept: Vec<String> = Vec::new();
+    let mut size = 0;
+    for line in lines.into_iter().rev() {
+        if size + line.len() + 1 > max {
+            break;
+        }
+        size += line.len() + 1;
+        kept.push(line);
+    }
+    kept.reverse();
+    kept.join("\n")
+}
+
+fn discovery() -> Value {
+    json!({
+        "supportedVersions": ["2026-07-28"],
+        "capabilities": { "tools": {} },
+        "serverInfo": {
+            "name": ZEO_TERMINALS_SERVER_NAME,
+            "title": "Zeo terminals",
+            "version": env!("CARGO_PKG_VERSION"),
+        },
+        "instructions": INSTRUCTIONS,
+    })
+}
+
+fn tool_result(text: String, is_error: bool) -> Value {
+    json!({ "content": [{ "type": "text", "text": text }], "isError": is_error })
+}
+
+fn inner_error(code: i32, message: &str) -> acp::MessageMcpResponse {
+    acp::MessageMcpResponse::error(acp::McpError::new(code, message))
+}
+
+fn tool_list() -> Value {
+    let read_only = json!({ "readOnlyHint": true, "openWorldHint": false });
+    json!([
+        {
+            "name": "list_terminals",
+            "description": "The terminals the user shared with you: id, title, folder, and whether a task runs or how it ended.",
+            "inputSchema": { "type": "object", "properties": {} },
+            "annotations": read_only,
+        },
+        {
+            "name": "read_terminal",
+            "description": "The last lines of a shared terminal, newest last (at most 2000 lines and 256 KB).",
+            "inputSchema": {
+                "type": "object",
+                "properties": {
+                    "id": { "type": "integer", "description": "The terminal's id from list_terminals." },
+                    "lines": { "type": "integer", "minimum": 1, "maximum": MAX_LINES, "description": "How many of the last non-empty lines (default 200)." },
+                },
+                "required": ["id"],
+            },
+            "annotations": read_only,
+        },
+    ])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_read_keeps_the_newest_lines_within_the_byte_bound() {
+        let lines: Vec<String> = (0..10).map(|n| format!("line {n}")).collect();
+        assert_eq!(within_bytes(lines.clone(), 1024), lines.join("\n"));
+        // "line 9" + newline is 7 bytes: 14 bytes keep the last two.
+        assert_eq!(within_bytes(lines, 14), "line 8\nline 9");
+    }
+
+    #[test]
+    fn the_tools_are_read_only() {
+        let tools = tool_list();
+        for tool in tools.as_array().unwrap() {
+            assert_eq!(tool["annotations"]["readOnlyHint"], true, "{tool}");
+        }
+        let names: Vec<&str> = tools
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter_map(|tool| tool["name"].as_str())
+            .collect();
+        assert_eq!(names, ["list_terminals", "read_terminal"]);
+    }
+}
