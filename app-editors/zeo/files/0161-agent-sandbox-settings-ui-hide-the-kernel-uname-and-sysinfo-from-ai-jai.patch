+            SYSCALL_VIEW_OPTION.to_string()
         ]
     );
     let shown = host_args_for(false, layer, all_exist);
@@ -208,4 +211,8 @@ fn host_view_overlay_system_rides_mask_host_only() {
         !shown.contains(&OVERLAY_SYSTEM_OPTION.to_string()),
         "{shown:?}"
     );
+    assert!(
+        !shown.contains(&SYSCALL_VIEW_OPTION.to_string()),
+        "{shown:?}"
+    );
 }
