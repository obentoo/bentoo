--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -3209,6 +3209,9 @@
     // Also serve /usr, /etc and /opt through read-only overlays under the host view, so the
     // mount table names no host disk for them (ai-jail --overlay-system). Slower metadata walks.
     "overlay_system": false,
+    // Also answer uname(2) and sysinfo(2) from ai-jail under the host view, so the kernel
+    // release, memory and uptime they report match it (ai-jail --syscall-view).
+    "syscall_view": false,
     // Whether jailed agents load the account's claude.ai connectors, which reach their
     // vendors through anthropic.com, past `allow_hosts`.
     "claude_ai_connectors": false,
diff --git a/crates/agent_sandbox/src/capabilities.rs b/crates/agent_sandbox/src/capabilities.rs
index 4d98e14..be16694 100644
--- a/crates/agent_sandbox/src/capabilities.rs
+++ b/crates/agent_sandbox/src/capabilities.rs
@@ -331,6 +331,13 @@ pub fn set_project_overlay_system(root: &Path, on: bool, cx: &mut App) -> Task<b
     write_entry(root, "overlay_system", write, cx)
 }
 
+/// Sets the project's `syscall_view` (ai-jail's --syscall-view; the page's Hide the Kernel); a
+/// restart applies it.
+pub fn set_project_syscall_view(root: &Path, on: bool, cx: &mut App) -> Task<bool> {
+    let write = move |entry: &mut AgentSandboxProjectSettingsContent| entry.syscall_view = Some(on);
+    write_entry(root, "syscall_view", write, cx)
+}
+
 /// Writes the project's `capabilities` through `update`, which also sees the default MCP server
 /// list in the file (empty when the file has none, as `default.json` says). A `capabilities`
 /// left with nothing set is removed, so a reset leaves the entry as it was.
diff --git a/crates/agent_sandbox/src/host_view.rs b/crates/agent_sandbox/src/host_view.rs
index e5302f8..48f5dfd 100644
--- a/crates/agent_sandbox/src/host_view.rs
+++ b/crates/agent_sandbox/src/host_view.rs
@@ -46,6 +46,12 @@
 //! off by default) because an overlay slows metadata walks (+21 % on a `find` over `/usr`) and
 //! its cost on a real build has not been measured.
 //!
+//! ai-jail's `--syscall-view` (§4.3) goes further: a seccomp user-notify filter sends `uname(2)`
+//! and `sysinfo(2)` to ai-jail outside the jail, which answers with the cleaned kernel strings
+//! and the jail's limits, so `uname -r`, Python's `platform` and `getconf _PHYS_PAGES` agree with
+//! the files. Its own switch (`agent_sandbox.syscall_view`), off until it has run in daily use:
+//! every process in the jail pays a round trip to ai-jail on those two calls.
+//!
 //! This hides, it does not isolate: `cpuid`, timing, `uname(2)`, `sysinfo(2)` and mount sources
 //! stay visible short of a VM. The writable mounts' sources (the project's disk and subvolume)
 //! stay visible by decision (operator, 2026-11-23): hiding them needs root on the host.
@@ -94,6 +100,11 @@ pub const MASK_HOST_OPTION: &str = "--mask-host";
 /// (docs/HOST-VIEW-EXTRA-LAYER.md §4.2), so the mount table names no host disk for them.
 pub const OVERLAY_SYSTEM_OPTION: &str = "--overlay-system";
 
+/// ai-jail's option that answers `uname(2)` and `sysinfo(2)` for the jail under `--mask-host`
+/// (docs/HOST-VIEW-EXTRA-LAYER.md §4.3), so the kernel release and the memory, load and uptime
+/// those calls report agree with the host view's files.
+pub const SYSCALL_VIEW_OPTION: &str = "--syscall-view";
+
 /// Masks `--mask-host` gives better answers for once ai-jail has its identity layer (3.5.0-r3,
 /// the release that brings `--overlay-system`): a swap table with its header instead of an empty
 /// file, and a boot id of the jail's own instead of none. Zeo's `--mask` lands after ai-jail's
@@ -108,6 +119,8 @@ pub struct HostLayer {
     pub identity: bool,
     /// The project asks for `--overlay-system` (only with `mask_host`).
     pub overlay_system: bool,
+    /// The project asks for `--syscall-view` (only with `mask_host`).
+    pub syscall_view: bool,
 }
 
 /// The variable Claude Code reads to load the account's claude.ai connectors. They are reached
@@ -146,6 +159,9 @@ pub fn host_args_for(
         if layer.overlay_system {
             args.push(OVERLAY_SYSTEM_OPTION.to_string());
         }
+        if layer.syscall_view {
+            args.push(SYSCALL_VIEW_OPTION.to_string());
+        }
     }
     args
 }
diff --git a/crates/agent_sandbox/src/host_view_layer_tests.rs b/crates/agent_sandbox/src/host_view_layer_tests.rs
index d0535e5..0530e47 100644
--- a/crates/agent_sandbox/src/host_view_layer_tests.rs
+++ b/crates/agent_sandbox/src/host_view_layer_tests.rs
@@ -4,15 +4,23 @@
 use gpui::TestAppContext;
 use serde_json::{Value, json};
 
-use crate::host_view::{IDENTITY_LAYER_MASKS, MASK_HOST_OPTION, OVERLAY_SYSTEM_OPTION};
+use crate::host_view::{
+    IDENTITY_LAYER_MASKS, MASK_HOST_OPTION, OVERLAY_SYSTEM_OPTION, SYSCALL_VIEW_OPTION,
+};
 use crate::launch_tests::*;
 
 /// The fork's 3.5.0-r2 options; `layer` adds `--overlay-system`, as 3.5.0-r3 does.
 fn help(layer: bool) -> String {
-    let layer = if layer {
-        "    --overlay-system  Overlays\\n"
-    } else {
-        ""
+    help_with(layer, false)
+}
+
+/// `syscalls` adds `--syscall-view`, as 3.5.0-r4 does.
+fn help_with(layer: bool, syscalls: bool) -> String {
+    let layer = match (layer, syscalls) {
+        (true, true) => "    --overlay-system  Overlays\\n    --syscall-view  Syscalls\\n",
+        (true, false) => "    --overlay-system  Overlays\\n",
+        (false, true) => "    --syscall-view  Syscalls\\n",
+        (false, false) => "",
     };
     format!(
         "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n    --cpus <LIST>  Pin CPUs\\n    --mask-host  Synthetic host view\\n{layer}' ;; *) echo 'ai-jail 3.5.0' ;; esac"
@@ -132,3 +140,41 @@ async fn host_view_layer_keeps_swap_and_boot_id_masks_for_an_older_ai_jail(
         }
     }
 }
+
+#[gpui::test]
+async fn host_view_layer_passes_syscall_view_under_mask_host(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help_with(true, true));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "syscall_view": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let args = before_separator(&cmd.args);
+    let mask = args.iter().position(|a| a == MASK_HOST_OPTION);
+    let syscalls = args.iter().position(|a| a == SYSCALL_VIEW_OPTION);
+    assert!(mask.is_some() && syscalls > mask, "{args:?}");
+    assert!(
+        !has(&cmd.args, OVERLAY_SYSTEM_OPTION),
+        "off by default: {args:?}"
+    );
+}
+
+#[gpui::test]
+async fn host_view_layer_refuses_syscall_view_without_the_option(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "syscall_view": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        text.contains("--syscall-view"),
+        "says what is missing: {text}"
+    );
+}
