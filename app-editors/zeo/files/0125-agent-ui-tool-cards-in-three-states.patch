+++ b/crates/agent_ui/src/conversation_view/thread_view/tool_card_state.rs
@@ -0,0 +1,110 @@
+//! A tool, terminal or edit card's three states, as `ThreadView` reads and steps them (Zeo next
+//! proposal §6.44, ask 68). The rules are `tool_card_display`'s; this is where a card's header
+//! asks for its state and where a click on it moves to the next one.
+
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_settings::AgentSettings;
+use gpui::{App, Context, SharedString, Window};
+use settings::{Settings as _, ToolCardDisplay};
+use ui::{CopyButton, Label, LabelCommon, LabelSize, prelude::*};
+
+use super::ThreadView;
+use crate::tool_card_display::{ToolCardKind, default_display, next_display};
+
+/// The one line a collapsed terminal card shows: the command's first line, with `…` after it
+/// when more lines follow. The label cuts what does not fit the card with `…` too, so the stored
+/// command is never shortened, and the copy button still copies it whole.
+pub(crate) fn collapsed_command_line(command: &str) -> String {
+    let mut lines = command.lines();
+    let first = lines.next().unwrap_or_default().trim_end();
+    if lines.next().is_some() {
+        format!("{first} …")
+    } else {
+        first.to_string()
+    }
+}
+
+/// A card's title: as it is on one line, or, for a minimized or maximized card, in a block as
+/// wide as the header, so it wraps -- as a flex item its width would be the whole text's, and the
+/// header would clip it.
+pub(crate) fn wrap_title(wrap: bool, title: impl IntoElement) -> AnyElement {
+    if wrap {
+        div().w_full().min_w_0().child(title).into_any_element()
+    } else {
+        title.into_any_element()
+    }
+}
+
+impl ThreadView {
+    /// The state `tool_call_id`'s card shows: the one it was stepped to, else its kind's default.
+    pub(crate) fn tool_card_display(
+        &self,
+        tool_call_id: &acp_v2::ToolCallId,
+        kind: ToolCardKind,
+        cx: &App,
+    ) -> ToolCardDisplay {
+        self.entry_view_state
+            .read(cx)
+            .tool_card_display(tool_call_id)
+            .unwrap_or_else(|| default_display(kind, AgentSettings::get_global(cx)))
+    }
+
+    /// A click on the card's header or chevron: the next state, with the card's views made when
+    /// it opens to show its content.
+    pub(crate) fn step_tool_card(
+        &mut self,
+        tool_call_id: &acp_v2::ToolCallId,
+        kind: ToolCardKind,
+        has_content: bool,
+        entry_ix: usize,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let next = next_display(self.tool_card_display(tool_call_id, kind, cx), has_content);
+        self.entry_view_state.update(cx, |state, _cx| {
+            state.set_tool_card_display(tool_call_id.clone(), next);
+        });
+        self.materialize_tool_call_views(entry_ix, window, cx);
+        self.refresh_thread_search(window, cx);
+        cx.notify();
+    }
+
+    /// A collapsed terminal card's command: one line, cut with `…` where the card ends, beside the
+    /// same copy button the whole command has.
+    pub(crate) fn render_collapsed_command(
+        &self,
+        group: SharedString,
+        command_text: String,
+        cx: &Context<Self>,
+    ) -> Div {
+        let copy_button = CopyButton::new(
+            SharedString::from(format!("{group}-copy-command")),
+            command_text.clone(),
+        )
+        .tooltip_label("Copy Command")
+        .visible_on_hover(group.clone());
+        h_flex()
+            .group(group)
+            .debug_selector(|| "TOOL_CARD_COLLAPSED_COMMAND".into())
+            .relative()
+            .w_full()
+            .min_w_0()
+            .px_1p5()
+            .py_1()
+            .gap_1()
+            .child(
+                div().flex_1().min_w_0().child(
+                    Label::new(collapsed_command_line(&command_text))
+                        .buffer_font(cx)
+                        .size(LabelSize::Small)
+                        .single_line()
+                        .truncate(),
+                ),
+            )
+            .child(copy_button)
+    }
+}
+
+#[cfg(test)]
+#[path = "tool_card_state_tests.rs"]
+mod tests;
