index 0000000..4bde368
--- /dev/null
+++ b/crates/agent_ui/src/tool_card_display_tests.rs
@@ -0,0 +1,90 @@
+// Zeo next proposal §6.44 (ask 68): the three card states, their defaults and the menu's
+// settings. Filter: `tool_card_display`.
+
+use gpui::{TestAppContext, UpdateGlobal as _};
+use pretty_assertions::assert_eq;
+use settings::Settings as _;
+
+use super::*;
+
+fn with_settings(
+    cx: &mut TestAppContext,
+    update: impl FnOnce(&mut SettingsContent),
+) -> [ToolCardDisplay; 3] {
+    cx.update(|cx| {
+        let store = settings::SettingsStore::test(cx);
+        cx.set_global(store);
+        AgentSettings::register(cx);
+        settings::SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, update);
+        });
+        let settings = AgentSettings::get_global(cx);
+        [
+            default_display(ToolCardKind::Terminal, settings),
+            default_display(ToolCardKind::Edit, settings),
+            default_display(ToolCardKind::Tool, settings),
+        ]
+    })
+}
+
+use ToolCardDisplay::{Collapsed, Maximized, Minimized};
+
+/// Nothing chosen: every kind keeps the look it had — upstream expands terminals and edits, and a
+/// tool's title is one line.
+#[gpui::test]
+fn without_a_choice_each_kind_keeps_its_old_look(cx: &mut TestAppContext) {
+    assert_eq!(with_settings(cx, |_| {}), [Maximized, Maximized, Collapsed]);
+}
+
+#[gpui::test]
+fn with_upstreams_expand_off_a_terminal_shows_its_command_and_an_edit_its_title(
+    cx: &mut TestAppContext,
+) {
+    let defaults = with_settings(cx, |settings| {
+        let agent = settings.agent.get_or_insert_default();
+        agent.expand_terminal_card = Some(false);
+        agent.expand_edit_card = Some(false);
+    });
+    assert_eq!(defaults, [Minimized, Collapsed, Collapsed]);
+}
+
+/// A kind's own choice wins over upstream's `expand_*_card`.
+#[gpui::test]
+fn a_kinds_own_choice_wins(cx: &mut TestAppContext) {
+    let defaults = with_settings(cx, |settings| {
+        let agent = settings.agent.get_or_insert_default();
+        agent.expand_terminal_card = Some(true);
+        agent.terminal_card_default = Some(Collapsed);
+        agent.edit_card_default = Some(Minimized);
+        agent.tool_card_default = Some(Maximized);
+    });
+    assert_eq!(defaults, [Collapsed, Minimized, Maximized]);
+}
+
+#[test]
+fn a_click_steps_through_the_three_states_and_round() {
+    assert_eq!(next_display(Collapsed, true), Minimized);
+    assert_eq!(next_display(Minimized, true), Maximized);
+    assert_eq!(next_display(Maximized, true), Collapsed);
+}
+
+#[test]
+fn a_card_with_nothing_to_show_steps_between_two() {
+    assert_eq!(next_display(Collapsed, false), Minimized);
+    assert_eq!(next_display(Minimized, false), Collapsed);
+}
+
+/// The menu keeps upstream's `expand_*_card` in step, so the Settings page agrees with it.
+#[test]
+fn the_menu_writes_the_kind_and_keeps_expand_in_step() {
+    let mut settings = SettingsContent::default();
+    set_default_display(&mut settings, ToolCardKind::Terminal, Collapsed);
+    set_default_display(&mut settings, ToolCardKind::Edit, Maximized);
+    set_default_display(&mut settings, ToolCardKind::Tool, Minimized);
+    let agent = settings.agent.expect("written");
+    assert_eq!(agent.terminal_card_default, Some(Collapsed));
+    assert_eq!(agent.expand_terminal_card, Some(false));
+    assert_eq!(agent.edit_card_default, Some(Maximized));
+    assert_eq!(agent.expand_edit_card, Some(true));
+    assert_eq!(agent.tool_card_default, Some(Minimized));
+}
