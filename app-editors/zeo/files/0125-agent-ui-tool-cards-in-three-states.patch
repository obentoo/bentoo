@@ -0,0 +1,135 @@
+//! Zeo next proposal §6.44 (ask 68): a card's three states, as the thread view reads and steps
+//! them. Filter: `tests::tool_card_display_tests`.
+//!
+//! Wiring: inside `conversation_view.rs`'s `mod tests { .. }`, `mod tool_card_display_tests;`
+//! resolves to this file.
+
+use super::*;
+use crate::tool_card_display::ToolCardKind;
+use agent_client_protocol::v2::schema as acp_v2;
+use settings::ToolCardDisplay::{Collapsed, Maximized, Minimized};
+
+/// A finished read with output: a tool card with something to maximize.
+async fn read_tool_call(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<ThreadView>,
+    acp_v2::ToolCallId,
+    &mut VisualTestContext,
+) {
+    let (conversation_view, cx) =
+        setup_conversation_view(StubAgentServer::default_response(), cx).await;
+    let thread_view = active_thread(&conversation_view, cx);
+    let thread = thread_view.read_with(cx, |view, _| view.thread.clone());
+    let read: acp_v2::ToolCallUpdate = serde_json::from_value(json!({
+        "toolCallId": "read-long",
+        "title": "Read crates/agent_ui/src/conversation_view/thread_view/tool_card_state.rs",
+        "kind": "read",
+        "status": "completed",
+        "rawOutput": "fn collapsed_command_line"
+    }))
+    .expect("the read should deserialize");
+    thread
+        .update(cx, |thread, cx| thread.upsert_wire_tool_call(read, cx))
+        .expect("the read should apply");
+    cx.run_until_parked();
+    (thread_view, acp_v2::ToolCallId::new("read-long"), cx)
+}
+
+fn display_of(
+    view: &Entity<ThreadView>,
+    id: &acp_v2::ToolCallId,
+    kind: ToolCardKind,
+    cx: &mut VisualTestContext,
+) -> settings::ToolCardDisplay {
+    view.read_with(cx, |view, cx| view.tool_card_display(id, kind, cx))
+}
+
+fn step(view: &Entity<ThreadView>, id: &acp_v2::ToolCallId, cx: &mut VisualTestContext) {
+    view.update_in(cx, |view, window, cx| {
+        view.step_tool_card(id, ToolCardKind::Tool, true, 0, window, cx)
+    });
+    cx.run_until_parked();
+}
+
+/// Upstream's look: a tool's title on one line, and a click steps through the three states.
+#[gpui::test]
+async fn a_tool_card_starts_collapsed_and_steps_through_three_states(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (view, id, cx) = read_tool_call(cx).await;
+    assert_eq!(display_of(&view, &id, ToolCardKind::Tool, cx), Collapsed);
+
+    step(&view, &id, cx);
+    assert_eq!(display_of(&view, &id, ToolCardKind::Tool, cx), Minimized);
+    step(&view, &id, cx);
+    assert_eq!(display_of(&view, &id, ToolCardKind::Tool, cx), Maximized);
+    view.read_with(cx, |view, cx| {
+        assert!(
+            view.entry_view_state.read(cx).is_tool_call_expanded(&id),
+            "maximized is the old 'expanded', so search and views see the content"
+        );
+    });
+    step(&view, &id, cx);
+    assert_eq!(display_of(&view, &id, ToolCardKind::Tool, cx), Collapsed);
+}
+
+/// The kind's setting is the default of a card nobody has stepped.
+#[gpui::test]
+async fn the_tool_kinds_setting_is_its_default(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        AgentSettings::override_global(
+            AgentSettings {
+                tool_card_default: Some(Maximized),
+                ..AgentSettings::get_global(cx).clone()
+            },
+            cx,
+        );
+    });
+    let (view, id, cx) = read_tool_call(cx).await;
+    assert_eq!(display_of(&view, &id, ToolCardKind::Tool, cx), Maximized);
+}
+
+/// The edit kind's own setting wins over upstream's `expand_edit_card`: a new diff does not open
+/// a card whose kind starts collapsed.
+#[gpui::test]
+async fn an_edit_kinds_choice_wins_over_expand_edit_card(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        AgentSettings::override_global(
+            AgentSettings {
+                expand_edit_card: true,
+                edit_card_default: Some(Collapsed),
+                ..AgentSettings::get_global(cx).clone()
+            },
+            cx,
+        );
+    });
+    let (conversation_view, cx) =
+        setup_conversation_view(StubAgentServer::default_response(), cx).await;
+    let view = active_thread(&conversation_view, cx);
+    let thread = view.read_with(cx, |view, _| view.thread.clone());
+    let patch: acp_v2::ToolCallUpdate = serde_json::from_value(json!({
+        "toolCallId": "edit-collapsed",
+        "title": "Edit file",
+        "kind": "edit",
+        "content": [{
+            "type": "diff",
+            "changes": [{"operation": "modify", "path": "/tmp/edit-collapsed"}],
+            "patch": {
+                "format": "git_patch",
+                "text": "diff --git a//tmp/edit-collapsed b//tmp/edit-collapsed\n--- a//tmp/edit-collapsed\n+++ b//tmp/edit-collapsed\n@@ -1 +1 @@\n-old\n+new\n"
+            }
+        }]
+    }))
+    .expect("the edit should deserialize");
+    thread
+        .update(cx, |thread, cx| thread.upsert_wire_tool_call(patch, cx))
+        .expect("the edit should apply");
+    cx.run_until_parked();
+    let id = acp_v2::ToolCallId::new("edit-collapsed");
+    view.read_with(cx, |view, cx| {
+        assert!(!view.entry_view_state.read(cx).is_tool_call_expanded(&id));
+    });
+    assert_eq!(display_of(&view, &id, ToolCardKind::Edit, cx), Collapsed);
+}
