diff --git a/crates/agent_ui/src/tool_card_display.rs b/crates/agent_ui/src/tool_card_display.rs
new file mode 100644
index 0000000..b8610d2
--- /dev/null
+++ b/crates/agent_ui/src/tool_card_display.rs
@@ -0,0 +1,118 @@
+//! Tool, terminal and edit cards in three states (Zeo next proposal §6.44, ask 68): collapsed (one
+//! line of the command or title, cut with `…`), minimized (the whole command or title) and
+//! maximized (the command or title and the card's content). A click on the card's header or its
+//! chevron steps through them.
+//!
+//! Each kind has a default of its own, chosen in the agent menu (which replaces §6.17's
+//! "Terminals Minimized by Default" toggle). Until one is chosen, each kind keeps the look it had:
+//! upstream's `expand_terminal_card` and `expand_edit_card` choose maximized, and otherwise a
+//! terminal shows its whole command and an edit or another tool its one-line title.
+
+use agent_settings::AgentSettings;
+use settings::{SettingsContent, ToolCardDisplay};
+
+/// The three kinds of card, each with its own default.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ToolCardKind {
+    Terminal,
+    Edit,
+    Tool,
+}
+
+impl ToolCardKind {
+    pub(crate) const ALL: [ToolCardKind; 3] = [
+        ToolCardKind::Terminal,
+        ToolCardKind::Tool,
+        ToolCardKind::Edit,
+    ];
+
+    /// The agent menu's submenu for this kind.
+    pub(crate) fn menu_label(self) -> &'static str {
+        match self {
+            ToolCardKind::Terminal => "Terminal Cards",
+            ToolCardKind::Edit => "Edit Cards",
+            ToolCardKind::Tool => "Tool Cards",
+        }
+    }
+}
+
+/// The label of each state in the agent menu.
+pub(crate) fn display_menu_label(display: ToolCardDisplay) -> &'static str {
+    match display {
+        ToolCardDisplay::Collapsed => "Collapsed",
+        ToolCardDisplay::Minimized => "Minimized",
+        ToolCardDisplay::Maximized => "Maximized",
+    }
+}
+
+pub(crate) const DISPLAYS: [ToolCardDisplay; 3] = [
+    ToolCardDisplay::Collapsed,
+    ToolCardDisplay::Minimized,
+    ToolCardDisplay::Maximized,
+];
+
+/// How a card of `kind` first appears: the kind's own setting when set, else what the card showed
+/// before §6.44.
+pub(crate) fn default_display(kind: ToolCardKind, settings: &AgentSettings) -> ToolCardDisplay {
+    let (explicit, expanded, closed) = match kind {
+        ToolCardKind::Terminal => (
+            settings.terminal_card_default,
+            settings.expand_terminal_card,
+            // A terminal's header has always shown its whole command, wrapped.
+            ToolCardDisplay::Minimized,
+        ),
+        ToolCardKind::Edit => (
+            settings.edit_card_default,
+            settings.expand_edit_card,
+            // An edit's header has always been one line.
+            ToolCardDisplay::Collapsed,
+        ),
+        ToolCardKind::Tool => (
+            settings.tool_card_default,
+            false,
+            ToolCardDisplay::Collapsed,
+        ),
+    };
+    explicit.unwrap_or(if expanded {
+        ToolCardDisplay::Maximized
+    } else {
+        closed
+    })
+}
+
+/// The state a click on the header steps to: collapsed, minimized, maximized, and round again. A
+/// card with no content has nothing to maximize, so it steps between the first two.
+pub(crate) fn next_display(current: ToolCardDisplay, has_content: bool) -> ToolCardDisplay {
+    match current {
+        ToolCardDisplay::Collapsed => ToolCardDisplay::Minimized,
+        ToolCardDisplay::Minimized if has_content => ToolCardDisplay::Maximized,
+        ToolCardDisplay::Minimized | ToolCardDisplay::Maximized => ToolCardDisplay::Collapsed,
+    }
+}
+
+/// Writes the agent menu's choice for `kind`. For a terminal or an edit, upstream's
+/// `expand_*_card` is kept in step (on for maximized, off otherwise), so the Settings page and
+/// the menu never disagree about whether the card opens maximized.
+pub(crate) fn set_default_display(
+    settings: &mut SettingsContent,
+    kind: ToolCardKind,
+    display: ToolCardDisplay,
+) {
+    let agent = settings.agent.get_or_insert_default();
+    let maximized = display == ToolCardDisplay::Maximized;
+    match kind {
+        ToolCardKind::Terminal => {
+            agent.terminal_card_default = Some(display);
+            agent.expand_terminal_card = Some(maximized);
+        }
+        ToolCardKind::Edit => {
+            agent.edit_card_default = Some(display);
+            agent.expand_edit_card = Some(maximized);
+        }
+        ToolCardKind::Tool => agent.tool_card_default = Some(display),
+    }
+}
+
+#[cfg(test)]
+#[path = "tool_card_display_tests.rs"]
+mod tests;
