+agent-sandbox-default-rw-maps = Carpetas con permiso de escritura para todos los proyectos (agent_sandbox.rw_maps)
+agent-sandbox-default-allow-hosts = Hosts permitidos para todos los proyectos (agent_sandbox.allow_hosts)
+agent-sandbox-list-empty = Ninguno
+
+agent-memory = Memoria
