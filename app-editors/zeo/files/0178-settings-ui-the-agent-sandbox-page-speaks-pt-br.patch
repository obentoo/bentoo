+++ b/crates/zeo_i18n/locales/en-US/agent-sandbox.ftl
@@ -0,0 +1,173 @@
+### The Agent Sandbox (ai-jail) settings page: settings_ui/src/pages/agent_jail_*.rs
+### (patch 0178, USE ai-jail). The English is the page's own text, byte for byte, so the
+### page reads the same in en-US as before 0178. Errors and confirmations that come from the
+### agent_sandbox crate (validation, the Turn Off / Forget dialogs) are not here yet.
+
+## Page: notices
+
+agent-sandbox-no-project = Open a local project to configure it.
+agent-sandbox-not-installed = ai-jail is not installed. Install it with `emerge sys-apps/ai-jail`, or enable USE `ai-jail` on `app-editors/zeo`.
+agent-sandbox-ai-jail-file = This project has an .ai-jail file. ai-jail reads it too, and lets it only narrow the generated jail, never widen it.
+agent-sandbox-preview-off = Sandbox off: the agent starts without ai-jail.
+agent-sandbox-memory-endpoint-invalid = No port is forwarded into the jail: the ai-memory endpoint is not a valid URL.
+agent-sandbox-memory-endpoint-remote = No port is forwarded into the jail for ai-memory at { $host }. Add { $host } to the allowed hosts for the jailed agent to reach it.
+agent-sandbox-restart-notice = Restart the agent to apply.
+agent-sandbox-restart-button = Restart Agent
+    .tooltip = Restart this project's agents that run on older settings. A thread in the middle of a turn asks first.
+
+## Page: ai-jail binary
+
+agent-sandbox-binary-looking = Looking for ai-jail…
+agent-sandbox-binary-not-found = Not found at { $path } (agent_sandbox.ai_jail_path).
+agent-sandbox-binary-found = ai-jail { $version } at { $path }
+agent-sandbox-binary-unreadable = The version of ai-jail could not be read: { $error }.
+
+## Page: this project
+
+agent-sandbox-this-project = This Project
+agent-sandbox-project-enabled = Run agents in ai-jail for this project
+    .note = Start the Claude agents of this project inside ai-jail. Turning it off asks first.
+agent-sandbox-default-for-every-project = Default for every project
+agent-sandbox-set-for-this-project = Set for this project
+
+## Page: the two lists. $kind is rw_map or allow_host.
+
+agent-sandbox-rw-maps = Writable Folders
+    .note = Folders the jailed agent may write besides the project, chosen with Choose Folder. Each must be outside the project, the Claude config directory and every other writable folder.
+    .placeholder = Add a writable folder (e.g. ~/data)…
+agent-sandbox-allow-hosts = Allowed Hosts
+    .note = Hosts the jailed agent may reach. Each is a bare DNS name: no scheme, port, path, wildcard or IP address.
+    .placeholder = Add an allowed host (e.g. registry.npmjs.org)…
+agent-sandbox-list-add-to = Add to { $list }
+agent-sandbox-list-remove = Remove { $entry }
+agent-sandbox-choose-folder = Choose Folder…
+agent-sandbox-choose-folder-prompt = Add Writable Folder
+agent-sandbox-entry-already-listed = { $kind ->
+    [rw_map] Writable folder "{ $raw }" is already in the list.
+   *[allow_host] Allowed host "{ $raw }" is already in the list.
+}
+agent-sandbox-entry-is-claude-dir = Writable folder "{ $raw }" is the Claude config directory, which the jail always maps.
+agent-sandbox-entry-is-default = { $kind ->
+    [rw_map] Writable folder "{ $raw }" applies to every project; remove it from agent_sandbox.{ $field } in settings.json.
+   *[allow_host] Allowed host "{ $raw }" applies to every project; remove it from agent_sandbox.{ $field } in settings.json.
+}
+agent-sandbox-entry-not-listed = { $kind ->
+    [rw_map] Writable folder "{ $raw }" is not in this project's list.
+   *[allow_host] Allowed host "{ $raw }" is not in this project's list.
+}
+agent-sandbox-save-failed = Could not save the agent sandbox setting: { $error }
+
+## Page: limits. $field is memory, cpu_quota, max_tasks or disk_quota.
+
+agent-sandbox-limits = Resource Limits
+    .note = Applied by ai-jail to the whole jail. Past the disk growth the agent is paused, not stopped. 0 turns a limit off for this project. Shift steps further, Alt finer; click a value to type one.
+agent-sandbox-limit-title = { $field ->
+    [memory] Memory
+    [cpu_quota] CPU
+    [max_tasks] Processes
+   *[disk_quota] Disk Growth
+}
+agent-sandbox-limit-reset = { $field ->
+    [memory] Use the default memory
+    [cpu_quota] Use the default cpu
+    [max_tasks] Use the default processes
+   *[disk_quota] Use the default disk growth
+}
+agent-sandbox-limit-stepper = { $field ->
+    [memory] Memory limit for this project
+    [cpu_quota] CPU limit for this project
+    [max_tasks] Processes limit for this project
+   *[disk_quota] Disk Growth limit for this project
+}
+agent-sandbox-limit-off = No limit
+agent-sandbox-limit-invalid-memory = { $raw } is not a memory size: a whole number with an optional K, M, G or T (8G), or 0 for none.
+agent-sandbox-limit-invalid-disk = { $raw } is not a disk size: a whole number with an optional K, M, G or T (20G), or 0 for none.
+agent-sandbox-limit-invalid-cpu = { $raw } is not a percentage of one CPU (400 is four CPUs), or 0 for none.
+agent-sandbox-limit-invalid-tasks = { $raw } is not a number of processes, or 0 for none.
+agent-sandbox-stepper-invalid-size = { $raw } is not a size: a whole number with K, M, G or T (8G)
+agent-sandbox-stepper-invalid-cpu = { $raw } is not a percentage of one CPU
+agent-sandbox-stepper-invalid-tasks = { $raw } is not a number of processes
+agent-sandbox-state-folder = State Folder
+    .note = This project's jail keeps its home, /tmp and Claude login in:
+    .login = To log in before the first start, run:
+
+## Page: host
+
+agent-sandbox-host = Host
+agent-sandbox-hide-host = Hide the Host
+    .note = The jailed agent sees only the CPUs and memory its limits allow, its own cgroup, a machine id of its own and, with ai-jail 3.5.0-r6, a host name of its own (desktop- and six characters, the same on every start of this project), instead of this machine's; with ai-jail 3.5.0-r3, also a kernel version without the build details, a generic OS name, no swap or disks, and an uptime counted from its start. Still visible: the writable folders' disk and size, the CPU numbers, cpuid and the toolchains' own version strings. It hides; it does not isolate. Restart the agent to apply.
+agent-sandbox-hide-disks = Hide the Disks
+    .note = Serve /usr, /etc and /opt through read-only overlays, so the jail's mount table names no disk of this machine for them. File walks over those folders get slower. Needs ai-jail 3.5.0-r3. Restart the agent to apply.
+agent-sandbox-hide-kernel = Hide the Kernel
+    .note = Answer uname and sysinfo from ai-jail, so the kernel version, memory, load and uptime they report match the hidden host instead of this machine's. Each of those calls makes a round trip to ai-jail. Needs ai-jail 3.5.0-r4. Restart the agent to apply.
+agent-sandbox-hide-system-config = Hide the System Config
+    .note = Show the jail only the parts of /etc its tools need -- accounts, DNS, certificates, time zone, the library loader and the shell's startup -- instead of all of this machine's configuration. /usr and /opt stay: the toolchains live there. A tool that reads another /etc file may fail. Needs ai-jail 3.5.0-r5. Restart the agent to apply.
+agent-sandbox-host-layer-off = Applies only while Hide the Host is on.
+agent-sandbox-reserve-cpus = Reserve CPUs
+    .note = Pin the jail to cores of its own, none shared with another reserving jail while enough are free. Off, the CPU quota alone limits it. Restart the agent to apply.
+    .forced = On while Hide the Host is on: its CPU files must match the cores the jail runs on.
+
+## Page: capabilities
+
+agent-sandbox-capabilities = Capabilities
+    .note = What the jailed agent may use besides the project. A project's own choice replaces the default in agent_sandbox.capabilities, field by field.
+agent-sandbox-mcp-servers = MCP Servers
+    .note = Zeo's MCP servers this project's jailed agent may use. A chosen server runs outside the jail, in Zeo, and the agent reaches it through Zeo (MCP over ACP), so its tools act with your files and network. None unless the default list (agent_sandbox.capabilities) names some; a choice applies to the next thread.
+    .none = This project has no MCP servers. Add one under MCP Servers.
+    .reset = Use the default MCP servers
+agent-sandbox-mcp-running = Running
+agent-sandbox-mcp-starting = Starting
+agent-sandbox-mcp-stopped = Stopped: handed over as configured only if the jail can start it
+agent-sandbox-mcp-failed = Failed to start
+agent-sandbox-mcp-needs-auth = Needs authentication
+agent-sandbox-mcp-carries-secret = { $status }. Carries a secret ({ $places }): asks before turning on
+agent-sandbox-mcp-zeo-lsp = The project's language servers, read-only: diagnostics, definition, references, hover, symbols
+agent-sandbox-mcp-not-configured = Not configured in this project
+agent-sandbox-skills = Skills
+    .note = Zeo's skills (~/.agents/skills and this project's .agents/skills) as plugins, mapped read-only. Restart the agent to apply.
+    .reset = Use the default for skills
+agent-sandbox-plugins = Claude Code Plugins
+    .note = Zeo has no plugin store yet, so the jail gets no Claude Code plugin: the host's ~/.claude/plugins is not mapped. Zeo's skills reach it as plugins, above.
+agent-sandbox-connectors = claude.ai Connectors
+    .note = The account's claude.ai connectors. They reach their vendors through anthropic.com, past the allowed hosts. Restart the agent to apply.
+
+## Page: generated command
+
+agent-sandbox-command = Generated Command
+    .note = What a start of this project's agent runs. Environment values are never shown.
+    .copy = Copy Command
+    .copy-tooltip = Copy the generated ai-jail command
+
+## Page: other projects
+
+agent-sandbox-other-projects = Other Projects
+agent-sandbox-default-enabled = Run agents in ai-jail for projects without their own setting
+    .note = The default for every project the switch above was never set for. Turning it off asks first.
+agent-sandbox-default-rw-maps = Writable folders for every project (agent_sandbox.rw_maps)
+agent-sandbox-default-allow-hosts = Allowed hosts for every project (agent_sandbox.allow_hosts)
+agent-sandbox-list-empty = None
+
+## Page: memory (ai-memory)
+
+agent-memory = Memory
+agent-memory-enabled = Let the agents use ai-memory
+    .note = The Claude agents read and write this project's ai-memory pages. Turning it off asks nothing: it is not the jail.
+agent-memory-off = Memory is off.
+agent-memory-no-project = Open a local project to see its memory.
+agent-memory-endpoint-invalid = The ai-memory endpoint in agent_memory.endpoint is not a valid URL.
+agent-memory-forward-port-exposure = While the jail is on, --forward-port exposes the whole ai-memory service to the jailed agent, not only this project's pages.
+agent-memory-status = ai-memory { $version } at { $endpoint } · { $scope }: { $pages } pages, { $sessions } sessions
+agent-memory-scope = { $source ->
+    [marker] Scope: { $scope } (from .ai-memory.toml)
+    [upstream] Scope: { $scope } (from the upstream remote)
+    [origin] Scope: { $scope } (from the origin remote)
+   *[folder] Scope: { $scope } (from the folder name; add .ai-memory.toml to choose another)
+}
+agent-memory-asking = Asking ai-memory…
+agent-memory-refresh = Refresh
+    .tooltip = Ask ai-memory again
+agent-memory-recent = Recent Pages
+agent-memory-no-pages = No pages yet.
+agent-memory-forget = Forget { $path }
+agent-memory-forget-failed = Could not forget { $path }: { $error }
+agent-memory-save-failed = Could not save the agent memory setting: { $error }
