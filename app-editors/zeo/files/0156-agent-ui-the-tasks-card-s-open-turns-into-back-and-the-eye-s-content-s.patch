diff --git a/crates/agent_ui/src/tasks_card/back_to_main_thread_tests.rs b/crates/agent_ui/src/tasks_card/back_to_main_thread_tests.rs
new file mode 100644
index 0000000..bac0a73
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/back_to_main_thread_tests.rs
@@ -0,0 +1,90 @@
+// Operator, 2026-11-22: "Open Thread at This Task" turns into an exit while the task's thread is on
+// screen, and clicking it returns to the main thread. Module path: `tasks_card::back_to_main_thread`;
+// fixtures in `native_subagent_support.rs`. Validation: `cargo test -p agent_ui back_to_main`.
+//
+// An Open/Back is read where it lands: the session the conversation shows, and the label the
+// row's button carries.
+
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Modifiers, TestAppContext};
+
+use super::RENDERED_ARIA_LABELS;
+use super::native_subagent_support::*;
+
+fn click_open(rig: &mut SubagentRig, task_id: &str) {
+    let open = selector(format!("tasks-card-open-{task_id}"));
+    let bounds = rig
+        .cx
+        .debug_bounds(open)
+        .expect("the row's Open is painted");
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+    rig.draw();
+}
+
+fn open_label_shown(label: &str) -> bool {
+    RENDERED_ARIA_LABELS.with(|labels| labels.borrow().iter().any(|shown| shown.contains(label)))
+}
+
+#[gpui::test]
+async fn open_turns_into_back_on_the_task_s_thread_and_back_returns_to_the_main_thread(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    rig.draw();
+    let id = rig
+        .row_of(&alpha)
+        .expect("Alpha has a row")
+        .task
+        .id
+        .to_string();
+    assert!(
+        open_label_shown("Open in thread: Alpha"),
+        "on the main thread the row opens"
+    );
+
+    click_open(&mut rig, &id);
+    assert_eq!(rig.shown_session(), Some(acp_v2::SessionId::new("alpha")));
+    RENDERED_ARIA_LABELS.with(|labels| labels.borrow_mut().clear());
+    rig.draw();
+    assert!(
+        open_label_shown("Back to the main thread: Alpha"),
+        "on the task's thread the same button goes back"
+    );
+
+    click_open(&mut rig, &id);
+    assert_eq!(
+        rig.shown_session(),
+        Some(rig.parent_session.clone()),
+        "Back shows the main thread again"
+    );
+    RENDERED_ARIA_LABELS.with(|labels| labels.borrow_mut().clear());
+    rig.draw();
+    assert!(open_label_shown("Open in thread: Alpha"));
+    assert!(!open_label_shown("Back to the main thread"));
+}
+
+/// Hostile: on Bravo's thread only Bravo's row goes back; Alpha's still opens Alpha.
+#[gpui::test]
+async fn only_the_row_of_the_thread_on_screen_goes_back(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.report_running(&alpha);
+    rig.report_running(&bravo);
+    rig.draw();
+    let bravo_id = rig
+        .row_of(&bravo)
+        .expect("Bravo has a row")
+        .task
+        .id
+        .to_string();
+    click_open(&mut rig, &bravo_id);
+    assert_eq!(rig.shown_session(), Some(acp_v2::SessionId::new("bravo")));
+    RENDERED_ARIA_LABELS.with(|labels| labels.borrow_mut().clear());
+    rig.draw();
+    assert!(open_label_shown("Back to the main thread: Bravo"));
+    assert!(open_label_shown("Open in thread: Alpha"));
+}
