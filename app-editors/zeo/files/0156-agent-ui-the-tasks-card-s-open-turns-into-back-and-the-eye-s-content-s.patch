+    /// The tasks card's Back (operator, 2026-11-22): brings `session_id`'s conversation forward on
+    /// its main thread, leaving the task's thread it was showing.
+    fn return_to_main_thread_from_card(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(conversation) = self.held_conversation_view(&session_id, cx) else {
+            log::warn!(
+                "agent panel: back to the main thread of session {session_id} from the tasks \
+                 card, but its thread is not open"
+            );
+            return;
+        };
+        self.open_thread_by_session(session_id.clone(), window, cx);
+        conversation.update(cx, |conversation, cx| {
+            conversation.navigate_to_thread(session_id.clone(), window, cx)
+        });
+        log::info!(
+            "agent panel: back to the main thread of session {session_id} from the tasks card"
+        );
+    }
