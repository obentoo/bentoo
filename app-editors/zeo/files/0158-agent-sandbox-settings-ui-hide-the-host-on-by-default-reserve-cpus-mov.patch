 /// Hostile: the host view asked for and not offered refuses the start (fail closed).
+/// Operator, 2026-11-22: the host is hidden by default -- a settings file that never names
+/// `mask_host` passes --mask-host.
+#[gpui::test]
+async fn host_view_launch_hides_the_host_by_default(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    let mut value = settings(&f, Value::Null);
+    value["agent_sandbox"]
+        .as_object_mut()
+        .expect("an agent_sandbox object")
+        .remove("mask_host");
+    set_user_settings(value, cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    let separator = cmd.args.iter().position(|arg| arg == "--").expect("`--`");
+    assert!(
+        cmd.args[..separator]
+            .iter()
+            .any(|arg| arg == MASK_HOST_OPTION),
+        "{:?}",
+        cmd.args
+    );
+    assert_pinned(&cmd.args, "the default host view reserves its cores");
+}
