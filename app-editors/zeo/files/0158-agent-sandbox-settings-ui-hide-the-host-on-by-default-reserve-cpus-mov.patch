+use std::collections::BTreeMap;
+
+use agent_sandbox::{AgentSandboxProjectSettings, AgentSandboxSettings};
+use pretty_assertions::assert_eq;
+
+use super::{HostSwitches, host_switches};
+
+fn sandbox(
+    mask_host: bool,
+    reserve_cpus: bool,
+    project: AgentSandboxProjectSettings,
+) -> AgentSandboxSettings {
+    AgentSandboxSettings {
+        enabled: true,
+        ai_jail_path: None,
+        claude_config_dir: "~/.claude".to_string(),
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        state_root: "/var/tmp/zeo-jail".to_string(),
+        limits: Default::default(),
+        mask_host,
+        claude_ai_connectors: false,
+        reserve_cpus,
+        capabilities: Default::default(),
+        projects: BTreeMap::from([("/p".to_string(), project)]),
+    }
+}
+
+#[test]
+fn agent_jail_host_switches_follow_the_project_then_the_default() {
+    let follows = sandbox(true, false, AgentSandboxProjectSettings::default());
+    assert_eq!(
+        host_switches(&follows, Some("/p")),
+        HostSwitches {
+            mask_host: true,
+            reserve_cpus: true,
+            reserve_forced: true,
+        },
+        "the default hides the host, which reserves"
+    );
+    let own = sandbox(
+        true,
+        false,
+        AgentSandboxProjectSettings {
+            mask_host: Some(false),
+            reserve_cpus: Some(true),
+            ..AgentSandboxProjectSettings::default()
+        },
+    );
+    assert_eq!(
+        host_switches(&own, Some("/p")),
+        HostSwitches {
+            mask_host: false,
+            reserve_cpus: true,
+            reserve_forced: false,
+        },
+        "the project's own choices replace the defaults"
+    );
+    assert_eq!(
+        host_switches(&sandbox(false, false, Default::default()), None),
+        HostSwitches {
+            mask_host: false,
+            reserve_cpus: false,
+            reserve_forced: false,
+        }
+    );
+}
