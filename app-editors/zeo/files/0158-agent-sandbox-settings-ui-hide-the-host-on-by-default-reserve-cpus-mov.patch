@@ -0,0 +1,105 @@
+//! The Agent Sandbox page's host switches (operator, 2026-11-22): "Hide the Host" (ai-jail's
+//! --mask-host, §6.63) and "Reserve CPUs" (§6.63 step 3). Reserve CPUs used to be a button beside
+//! the thread's lock; the operator found it out of place there and asked for it here, with the
+//! other per-project choices. Both write the project's own entry and apply on the next start.
+
+use std::path::Path;
+
+use agent_sandbox::AgentSandboxSettings;
+use agent_sandbox::capabilities::set_project_mask_host;
+use agent_sandbox::confirm::set_project_reserve_cpus;
+use gpui::{AnyElement, App, Entity, ScrollHandle};
+use ui::{SwitchField, ToggleState, prelude::*};
+
+use super::{JailPageState, reveal};
+
+/// What the two switches show for the project under `key`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct HostSwitches {
+    pub mask_host: bool,
+    pub reserve_cpus: bool,
+    /// Reserve CPUs cannot be turned off: Hide the Host's CPU files must match the cores the jail
+    /// runs on, so a masked jail always reserves (launch.rs, `mask_host || reserve_cpus`).
+    pub reserve_forced: bool,
+}
+
+pub(crate) fn host_switches(sandbox: &AgentSandboxSettings, key: Option<&str>) -> HostSwitches {
+    let mask_host = sandbox.mask_host_for_key(key);
+    HostSwitches {
+        mask_host,
+        reserve_cpus: mask_host || sandbox.reserve_cpus_for_key(key),
+        reserve_forced: mask_host,
+    }
+}
+
+pub(crate) const MASK_HOST_NOTE: &str = "The jailed agent sees only the CPUs and memory its limits allow, its own cgroup and a machine id of its own, instead of this machine's. It hides; it does not isolate: a determined process can still infer the hardware. Restart the agent to apply.";
+pub(crate) const RESERVE_NOTE: &str = "Pin the jail to cores of its own, none shared with another reserving jail while enough are free. Off, the CPU quota alone limits it. Restart the agent to apply.";
+pub(crate) const RESERVE_FORCED_NOTE: &str =
+    "On while Hide the Host is on: its CPU files must match the cores the jail runs on.";
+
+pub(crate) fn render_host_switches(
+    root: &Path,
+    sandbox: &AgentSandboxSettings,
+    key: Option<&str>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let switches = host_switches(sandbox, key);
+    let mask_host = SwitchField::new(
+        "agent-jail-mask-host",
+        Some("Hide the Host"),
+        Some(MASK_HOST_NOTE.into()),
+        switches.mask_host,
+        {
+            let root = root.to_path_buf();
+            move |toggle, _, cx| {
+                set_project_mask_host(&root, *toggle == ToggleState::Selected, cx).detach();
+            }
+        },
+    )
+    .tab_index(0);
+    let reserve = SwitchField::new(
+        "agent-jail-reserve-cpus",
+        Some("Reserve CPUs"),
+        Some(
+            if switches.reserve_forced {
+                RESERVE_FORCED_NOTE
+            } else {
+                RESERVE_NOTE
+            }
+            .into(),
+        ),
+        switches.reserve_cpus,
+        {
+            let root = root.to_path_buf();
+            move |toggle, _, cx| {
+                set_project_reserve_cpus(&root, *toggle == ToggleState::Selected, cx).detach();
+            }
+        },
+    )
+    .disabled(switches.reserve_forced)
+    .tab_index(0);
+    v_flex()
+        .gap_2()
+        .child(Label::new("Host"))
+        .child(reveal(
+            state,
+            "agent-jail-mask-host",
+            scroll_handle,
+            mask_host,
+            cx,
+        ))
+        .child(reveal(
+            state,
+            "agent-jail-reserve-cpus",
+            scroll_handle,
+            reserve,
+            cx,
+        ))
+        .into_any_element()
+}
+
+#[cfg(test)]
+#[path = "agent_jail_host_tests.rs"]
+mod agent_jail_host_tests;
