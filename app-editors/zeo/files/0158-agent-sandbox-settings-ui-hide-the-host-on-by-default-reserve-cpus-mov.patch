+/// Sets the project's `mask_host` (ai-jail's --mask-host, §6.63; the page's Hide the Host); a
+/// restart applies it.
+pub fn set_project_mask_host(root: &Path, on: bool, cx: &mut App) -> Task<bool> {
+    let write = move |entry: &mut AgentSandboxProjectSettingsContent| entry.mask_host = Some(on);
+    write_entry(root, "mask_host", write, cx)
+}
