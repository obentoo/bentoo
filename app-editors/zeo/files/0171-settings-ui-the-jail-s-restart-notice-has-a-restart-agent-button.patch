+++ b/crates/agent_ui/src/conversation_view.rs
@@ -1200,6 +1200,7 @@ impl ConversationView {
         }));
 
         subscriptions.extend(crate::sub_thread::observe_sub_thread_stores(cx));
+        subscriptions.push(Self::observe_settings_restart(window, cx));
 
         cx.on_release(|this, cx| {
             this.request_elicitation_form_states.clear();
@@ -1352,6 +1353,40 @@ impl ConversationView {
         self.reset(window, cx);
     }
 
+    /// Restarts this thread's agent when the Agent Sandbox page asks for it (operator ask 9 of
+    /// 2026-11-23) and the agent runs on settings older than now. It goes the lock click's way, so
+    /// a turn in progress asks first. Only requests made after this view exists count.
+    fn observe_settings_restart(window: &mut Window, cx: &mut Context<Self>) -> Subscription {
+        use agent_sandbox::restart_request::{JailRestartRequest, restart_wanted};
+        let last_serial = std::cell::Cell::new(
+            cx.try_global::<JailRestartRequest>()
+                .map_or(0, |request| request.serial),
+        );
+        cx.observe_global_in::<JailRestartRequest>(window, move |this, window, cx| {
+            let request = cx.global::<JailRestartRequest>().clone();
+            let Some(root) = agent_sandbox::launch::project_root(&this.project, cx) else {
+                return;
+            };
+            let drifted = agent_sandbox::LaunchRegistry::get(&this.agent.agent_id(), &root, cx)
+                .is_some_and(|record| agent_sandbox::launch::drifted_now(&record, cx));
+            let wanted = restart_wanted(&request, last_serial.get(), &root, drifted);
+            last_serial.set(request.serial);
+            if !wanted {
+                return;
+            }
+            let Some(thread_view) = this.root_thread_view() else {
+                return;
+            };
+            log::info!(
+                "agent_sandbox event=restart_for_jail source=settings serial={}",
+                request.serial
+            );
+            let restart = thread_view.read(cx).restart_agent_for_jail();
+            // The restart updates this view, which is mid-update here: run it once this ends.
+            window.defer(cx, move |window, cx| restart(window, cx));
+        })
+    }
+
