+//! Operator ask 9 of 2026-11-23: the Agent Sandbox page's "Restart the agent to apply." notice
+//! gets a Restart Agent button, and the threads of that project restart on it. Filter:
+//! `tests::settings_restart_tests`.
+//!
+//! Wiring: inside `conversation_view.rs`'s `mod tests { .. }`, `mod settings_restart_tests;`
+//! resolves to this file.
+
+use super::*;
+use agent_sandbox::launch::{LaunchRecord, MemoryPort, Reason};
+use agent_sandbox::restart_request::request_restart;
+use gpui::EntityId;
+
+/// A view of agent "Test" on a project with one worktree, `/project`.
+async fn view_on_project(
+    cx: &mut TestAppContext,
+) -> (Entity<ConversationView>, PathBuf, &mut VisualTestContext) {
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/project", serde_json::json!({ "main.rs": "" }))
+        .await;
+    let project = Project::test(fs, [Path::new("/project")], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let thread_store = cx.update(|_window, cx| cx.new(|cx| ThreadStore::new(cx)));
+    let connection_store =
+        cx.update(|_window, cx| cx.new(|cx| AgentConnectionStore::new(project.clone(), cx)));
+    let root = cx
+        .update(|_window, cx| agent_sandbox::launch::project_root(&project, cx))
+        .expect("a project with a worktree has a root");
+    let view = cx.update(|window, cx| {
+        cx.new(|cx| {
+            ConversationView::new(
+                Rc::new(StubAgentServer::new(StubAgentConnection::new())),
+                connection_store.clone(),
+                Agent::Custom { id: "Test".into() },
+                None,
+                None,
+                None,
+                None,
+                None,
+                workspace.downgrade(),
+                project,
+                Some(thread_store),
+                AgentThreadSource::AgentPanel,
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (view, root, cx)
+}
+
+/// A launch of agent "Test" in `root`, outside the jail, started on settings that are not the
+/// ones of now (its fingerprint matches none), so it shows as drifted.
+fn drifted_launch(root: &Path) -> LaunchRecord {
+    LaunchRecord {
+        agent_id: "Test".into(),
+        project_root: root.to_path_buf(),
+        reason: Reason::Off,
+        ai_jail_version: None,
+        ai_jail_path: None,
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        forward_ports: Vec::new(),
+        memory_port: MemoryPort::Off,
+        settings_fingerprint: 0x5eed,
+        memory_fingerprint: 0x5eed,
+        settings_key: None,
+        jail_pid: None,
+        paused: false,
+        claude_config_dir: None,
+        ai_jail_missing: false,
+    }
+}
+
+fn thread_id_of(view: &Entity<ConversationView>, cx: &mut VisualTestContext) -> EntityId {
+    view.read_with(cx, |view, _| {
+        view.active_thread().expect("connected thread").entity_id()
+    })
+}
+
+#[gpui::test]
+async fn settings_restart_restarts_a_drifted_agent_of_the_project(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (view, root, cx) = view_on_project(cx).await;
+    cx.update(|_window, cx| agent_sandbox::LaunchRegistry::register(drifted_launch(&root), cx));
+    let before = thread_id_of(&view, cx);
+
+    cx.update(|_window, cx| request_restart(Path::new("/elsewhere"), cx));
+    cx.run_until_parked();
+    assert_eq!(
+        thread_id_of(&view, cx),
+        before,
+        "a request for another project leaves this thread's agent running"
+    );
+
+    cx.update(|_window, cx| request_restart(&root, cx));
+    cx.run_until_parked();
+    assert_ne!(
+        thread_id_of(&view, cx),
+        before,
+        "the project's drifted agent restarts and the thread is rebuilt on it"
+    );
+}
+
+#[gpui::test]
+async fn settings_restart_leaves_an_agent_without_a_launch_alone(cx: &mut TestAppContext) {
+    init_test(cx);
+    let (view, root, cx) = view_on_project(cx).await;
+    let before = thread_id_of(&view, cx);
+    cx.update(|_window, cx| request_restart(&root, cx));
+    cx.run_until_parked();
+    assert_eq!(
+        thread_id_of(&view, cx),
+        before,
+        "with no launch record there is no setting to apply"
+    );
+}
