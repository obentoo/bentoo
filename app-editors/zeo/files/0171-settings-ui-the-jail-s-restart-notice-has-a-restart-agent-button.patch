index 0000000..305c873
--- /dev/null
+++ b/crates/agent_sandbox/src/restart_request_tests.rs
@@ -0,0 +1,52 @@
+// Operator ask 9 of 2026-11-23: the Agent Sandbox page's restart notice gets a button that
+// restarts the project's agents. Filter: `restart_request`.
+use std::cell::Cell;
+use std::path::Path;
+use std::rc::Rc;
+
+use gpui::TestAppContext;
+
+use crate::restart_request::{JailRestartRequest, request_restart, restart_wanted};
+
+fn request(root: &str, serial: u64) -> JailRestartRequest {
+    JailRestartRequest {
+        root: root.into(),
+        serial,
+    }
+}
+
+#[test]
+fn restart_request_applies_to_a_drifted_agent_of_the_same_project_once() {
+    let asked = request("/w/app", 3);
+    assert!(restart_wanted(&asked, 2, Path::new("/w/app"), true));
+    assert!(
+        !restart_wanted(&asked, 3, Path::new("/w/app"), true),
+        "a request already acted on is not acted on again"
+    );
+    assert!(
+        !restart_wanted(&asked, 2, Path::new("/w/other"), true),
+        "another project's agents keep running"
+    );
+    assert!(
+        !restart_wanted(&asked, 2, Path::new("/w/app"), false),
+        "an agent already on the settings of now has nothing to apply"
+    );
+}
+
+#[gpui::test]
+fn restart_request_notifies_observers_with_a_growing_serial(cx: &mut TestAppContext) {
+    let seen = Rc::new(Cell::new(0u64));
+    let _subscription = cx.update(|cx| {
+        let seen = seen.clone();
+        cx.observe_global::<JailRestartRequest>(move |cx| {
+            seen.set(cx.global::<JailRestartRequest>().serial);
+        })
+    });
+    let first = cx.update(|cx| request_restart(Path::new("/w/app"), cx));
+    cx.run_until_parked();
+    assert_eq!(seen.get(), first, "the observers learn of the request");
+    let second = cx.update(|cx| request_restart(Path::new("/w/app"), cx));
+    cx.run_until_parked();
+    assert!(second > first, "a second click is a new request");
+    assert_eq!(seen.get(), second);
+}
