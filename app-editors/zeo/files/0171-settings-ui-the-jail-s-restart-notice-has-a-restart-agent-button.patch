diff --git a/crates/agent_sandbox/src/restart_request.rs b/crates/agent_sandbox/src/restart_request.rs
new file mode 100644
index 0000000..f821466
--- /dev/null
+++ b/crates/agent_sandbox/src/restart_request.rs
@@ -0,0 +1,43 @@
+//! A restart asked from the Agent Sandbox page (operator ask 9 of 2026-11-23): its "Restart the
+//! agent to apply." notice had no way to act on it, so the operator had to find each thread's lock.
+//! `settings_ui` cannot reach the threads (it does not depend on `agent_ui`), so the page writes a
+//! request here and every agent thread observes it, restarting the way its lock click does.
+
+use std::path::{Path, PathBuf};
+
+use gpui::{App, Global};
+
+/// The latest restart asked for: the project whose agents should restart, and a serial so a
+/// thread acts on each request once, however often the global is observed.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct JailRestartRequest {
+    pub root: PathBuf,
+    pub serial: u64,
+}
+
+impl Global for JailRestartRequest {}
+
+/// Asks every agent of `root` running on settings older than now to restart; returns the serial.
+pub fn request_restart(root: &Path, cx: &mut App) -> u64 {
+    let serial = cx
+        .try_global::<JailRestartRequest>()
+        .map_or(1, |request| request.serial + 1);
+    log::info!("agent_sandbox event=restart_requested source=settings serial={serial}");
+    cx.set_global(JailRestartRequest {
+        root: root.to_path_buf(),
+        serial,
+    });
+    serial
+}
+
+/// Whether a thread of `own_root` that last acted on `last_serial` restarts for `request`: only
+/// for its own project, only once, and only when its agent runs on older settings -- an agent
+/// already current has nothing to apply, and a restart would only cut it.
+pub fn restart_wanted(
+    request: &JailRestartRequest,
+    last_serial: u64,
+    own_root: &Path,
+    drifted: bool,
+) -> bool {
+    request.serial > last_serial && request.root == own_root && drifted
+}
diff --git a/crates/agent_sandbox/src/restart_request_tests.rs b/crates/agent_sandbox/src/restart_request_tests.rs
