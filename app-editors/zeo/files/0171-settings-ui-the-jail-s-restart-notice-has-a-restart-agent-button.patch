 }
 
+/// The notice a changed setting shows until the agents restart, with the button that restarts
+/// them (operator ask 9 of 2026-11-23): before it, the notice named a step it gave no way to take.
+/// The page cannot reach the threads, so it asks through [`agent_sandbox::restart_request`].
+fn render_restart_notice(root: &Path) -> AnyElement {
+    let root = root.to_path_buf();
+    h_flex()
+        .gap_2()
+        .child(
+            Label::new(RESTART_NOTICE)
+                .size(LabelSize::Small)
+                .color(Color::Warning),
+        )
+        .child(
+            Button::new("agent-jail-restart-agent", RESTART_BUTTON)
+                .start_icon(Icon::new(IconName::RotateCw).size(IconSize::Small))
+                .label_size(LabelSize::Small)
+                .tab_index(0_isize)
+                .tooltip(Tooltip::text(RESTART_TOOLTIP))
+                .on_click(move |_, _, cx| {
+                    agent_sandbox::restart_request::request_restart(&root, cx);
+                }),
+        )
+        .into_any_element()
+}
