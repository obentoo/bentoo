diff --git a/crates/agent_ui/src/tasks_card/dock_bottom_tests.rs b/crates/agent_ui/src/tasks_card/dock_bottom_tests.rs
new file mode 100644
index 0000000..38a0927
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/dock_bottom_tests.rs
@@ -0,0 +1,107 @@
+// Zeo next proposal §6.19 (ask 39): a "v" in the card's header moves the tasks card to a
+// full-width bar at the bottom of the conversation, above the message editor, as the
+// question card's bar does. The bar is part of the thread's layout, so it takes its own
+// space instead of covering the last entries; a "^" brings the card back.
+
+use gpui::{Modifiers, TestAppContext, VisualTestContext};
+
+use super::test_helpers::*;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn click(selector: &'static str, cx: &mut VisualTestContext) {
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    draw(cx);
+}
+
+/// Hostile: the bar must not be the old floating pill moved down -- it sits between the
+/// conversation and the message editor, and the floating card is gone while it shows.
+#[gpui::test]
+async fn test_the_card_moves_to_a_bar_above_the_message_editor(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(&a, vec![wire_task("t1", "running", true, 1_000)], &mut cx);
+    draw(&mut cx);
+    assert!(
+        cx.debug_bounds("tasks-card").is_some(),
+        "the floating card shows"
+    );
+
+    click("tasks-card-dock-bottom", &mut cx);
+
+    assert!(
+        cx.debug_bounds("tasks-card").is_none(),
+        "the floating card is gone while the bar shows"
+    );
+    assert!(
+        cx.debug_bounds("tasks-card-pill").is_none(),
+        "not the floating pill"
+    );
+    let bar = cx
+        .debug_bounds("tasks-card-bar")
+        .expect("the bar is painted");
+    let panel_bounds = cx.debug_bounds("agent-panel").expect("panel painted");
+    let editor = panel.read_with(&cx, |panel, cx| {
+        panel
+            .active_thread_view(cx)
+            .and_then(|view| {
+                view.read(cx)
+                    .message_editor
+                    .read(cx)
+                    .editor()
+                    .read(cx)
+                    .last_bounds()
+                    .copied()
+            })
+            .expect("the message editor was painted")
+    });
+    assert!(
+        bar.bottom() <= editor.top(),
+        "the bar {bar:?} sits above the editor {editor:?}"
+    );
+    assert!(
+        bar.size.width >= panel_bounds.size.width * 0.9,
+        "the bar spans the panel: {bar:?} in {panel_bounds:?}"
+    );
+
+    click("tasks-card-bar-expand", &mut cx);
+    assert!(cx.debug_bounds("tasks-card").is_some(), "the card is back");
+    assert!(
+        cx.debug_bounds("tasks-card-bar").is_none(),
+        "the bar is gone"
+    );
+}
+
+/// The bar says what runs, as the pill does.
+#[gpui::test]
+async fn test_the_bar_counts_what_runs(cx: &mut TestAppContext) {
+    let (panel, mut cx) = setup_card_panel(cx).await;
+    let connection = TaskActionsConnection::new();
+    let a = open_titled_thread(&panel, &connection, "A", &mut cx);
+    send_tasks(
+        &a,
+        vec![
+            wire_task("t1", "running", true, 1_000),
+            wire_task("t2", "running", true, 1_001),
+        ],
+        &mut cx,
+    );
+    draw(&mut cx);
+    click("tasks-card-dock-bottom", &mut cx);
+    let card = card(&panel, &cx);
+    card.read_with(&cx, |card, _| {
+        assert!(card.is_docked_bottom());
+        assert!(!card.is_minimized(), "docking is not minimizing");
+    });
+    assert!(
+        cx.debug_bounds("tasks-card-bar-spinner").is_some(),
+        "it spins while work runs"
+    );
+}
