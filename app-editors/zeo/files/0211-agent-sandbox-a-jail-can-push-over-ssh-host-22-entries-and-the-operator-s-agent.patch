diff --git a/crates/agent_sandbox/src/validate.rs b/crates/agent_sandbox/src/validate.rs
index 78ddd80..e6c48db 100644
--- a/crates/agent_sandbox/src/validate.rs
+++ b/crates/agent_sandbox/src/validate.rs
@@ -625,11 +625,48 @@ impl fmt::Display for HostError {
 
 impl std::error::Error for HostError {}
 
+impl HostError {
+    /// The same refusal, naming `entry` instead: a `name:PORT` entry is refused for its name, and
+    /// the message quotes the whole entry the user typed.
+    fn for_entry(self, entry: &str) -> Self {
+        let entry = entry.to_string();
+        match self {
+            Self::Empty => Self::Empty,
+            Self::TooLong { length, .. } => Self::TooLong { entry, length },
+            Self::IpLiteral { .. } => Self::IpLiteral { entry },
+            Self::Localhost { .. } => Self::Localhost { entry },
+            Self::NotDnsName { shape, .. } => Self::NotDnsName { entry, shape },
+            Self::NumericLastLabel { .. } => Self::NumericLastLabel { entry },
+            Self::PatternUnavailable { .. } => Self::PatternUnavailable { entry },
+        }
+    }
+}
+
 pub fn validate_host(raw: &str) -> Result<String, HostError> {
     let entry = || raw.to_string();
     if raw.is_empty() {
         return Err(HostError::Empty);
     }
+    // `name:PORT` opens that one port of `name` (ai-jail 3.7.1-r1, §6.9: `github.com:22` for a
+    // push over SSH); a bare name keeps ai-jail's 443 and 80. Only a DNS name takes a port.
+    if !raw.starts_with('[')
+        && !raw.contains("://")
+        && let Some((name, port)) = raw.rsplit_once(':')
+        && !name.contains(':')
+    {
+        let port_ok = !port.is_empty()
+            && port.bytes().all(|byte| byte.is_ascii_digit())
+            && port.parse::<u16>().is_ok_and(|port| port != 0);
+        if !port_ok || name.is_empty() {
+            return Err(HostError::NotDnsName {
+                entry: entry(),
+                shape: HostShape::Port,
+            });
+        }
+        // The error names the whole entry, port included, as the user typed it.
+        let host = validate_host(name).map_err(|error| error.for_entry(raw))?;
+        return Ok(format!("{host}:{port}"));
+    }
     if raw.len() > MAX_HOST_LENGTH {
         return Err(HostError::TooLong {
             entry: entry(),
