+
+/// §6.9: `name:PORT` opens one port of a DNS name (`github.com:22` for a push over SSH).
+#[test]
+fn validate_host_accepts_a_dns_name_with_one_port() {
+    assert_eq!(validate_host("github.com:22").unwrap(), "github.com:22");
+    assert_eq!(
+        validate_host("api.example.com:8443").unwrap(),
+        "api.example.com:8443"
+    );
+    assert!(
+        validate_host("GitHub.com:22").is_err(),
+        "the name keeps its own rules"
+    );
+    assert!(validate_host("localhost:22").is_err());
+}
