diff --git a/crates/agent_sandbox/src/jail_ssh.rs b/crates/agent_sandbox/src/jail_ssh.rs
new file mode 100644
index 0000000..25bc2c8
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_ssh.rs
@@ -0,0 +1,156 @@
+//! The operator's restricted ssh-agent, reachable from a jail (Zeo next §6.9).
+//!
+//! The operator starts an agent for the jails alone, its socket in a folder of its own:
+//! `ssh-agent -a /tmp/zeo-ssh/agent.sock`, then `ssh-add -c -t 1h -h github.com <key>` -- each use
+//! asks, the key expires, and it signs only for the hosts named. A jail gets that folder
+//! read-only (ai-jail maps folders, not files) and `SSH_AUTH_SOCK` pointing at the socket; never
+//! the desktop agent, never `~/.ssh`. A push also needs the host's port 22 in the allowed hosts,
+//! which ai-jail tunnels through its egress proxy.
+
+use std::os::unix::fs::{FileTypeExt as _, MetadataExt as _, PermissionsExt as _};
+use std::path::{Path, PathBuf};
+
+/// Why the configured socket is not handed to a jail. Each refuses the start: a jail that expects
+/// to push and cannot fails later and less clearly.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SshSocketProblem {
+    /// Not an absolute path (after `~`).
+    NotAbsolute,
+    /// Nothing is there, or it is not a socket.
+    NotASocket,
+    /// The socket or its folder belongs to someone else.
+    NotYours,
+    /// The folder is open to others (its mode is not 700): the jail would see what else is there,
+    /// and anyone could swap the socket.
+    OpenFolder,
+    /// The folder is one the sandbox never maps (home, the config or runtime directory, …).
+    Protected,
+}
+
+impl SshSocketProblem {
+    /// The `$reason` selector of `agent-jail-launch-ssh-socket`.
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::NotAbsolute => "not-absolute",
+            Self::NotASocket => "not-a-socket",
+            Self::NotYours => "not-yours",
+            Self::OpenFolder => "open-folder",
+            Self::Protected => "protected",
+        }
+    }
+}
+
+/// The socket at `raw` (`~` expanded against `home`) and its folder, checked for a jail.
+/// `protected` says whether a folder is one the sandbox refuses to map.
+pub fn check_socket(
+    raw: &str,
+    home: &Path,
+    uid: u32,
+    protected: impl Fn(&Path) -> bool,
+) -> Result<(PathBuf, PathBuf), (PathBuf, SshSocketProblem)> {
+    let socket = match raw.strip_prefix("~/") {
+        Some(rest) => home.join(rest),
+        None => PathBuf::from(raw),
+    };
+    let refuse = |problem| Err((socket.clone(), problem));
+    if !socket.is_absolute() {
+        return refuse(SshSocketProblem::NotAbsolute);
+    }
+    let Ok(metadata) = std::fs::symlink_metadata(&socket) else {
+        return refuse(SshSocketProblem::NotASocket);
+    };
+    if !metadata.file_type().is_socket() {
+        return refuse(SshSocketProblem::NotASocket);
+    }
+    if metadata.uid() != uid {
+        return refuse(SshSocketProblem::NotYours);
+    }
+    let Some(folder) = socket.parent().map(Path::to_path_buf) else {
+        return refuse(SshSocketProblem::NotAbsolute);
+    };
+    let Ok(folder_metadata) = std::fs::symlink_metadata(&folder) else {
+        return refuse(SshSocketProblem::NotASocket);
+    };
+    if !folder_metadata.is_dir() || folder_metadata.uid() != uid {
+        return refuse(SshSocketProblem::NotYours);
+    }
+    if folder_metadata.permissions().mode() & 0o077 != 0 {
+        return refuse(SshSocketProblem::OpenFolder);
+    }
+    if protected(&folder) {
+        return refuse(SshSocketProblem::Protected);
+    }
+    Ok((socket, folder))
+}
+
+/// Empties the operator's agent (`ssh-add -D`), for the kill switch: the agent is the operator's
+/// process, so it is disarmed, not killed. Fire and forget; smol reaps the child.
+pub fn empty_agent(socket: &Path) {
+    let spawned = smol::process::Command::new("ssh-add")
+        .arg("-D")
+        .env("SSH_AUTH_SOCK", socket)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn();
+    match spawned {
+        Ok(_) => log::info!(
+            "agent_sandbox event=ssh_agent_emptied socket={}",
+            socket.display()
+        ),
+        Err(error) => log::warn!(
+            "agent_sandbox event=ssh_agent_empty_failed socket={} error={error}",
+            socket.display()
+        ),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bound_socket(dir: &Path) -> PathBuf {
+        let socket = dir.join("agent.sock");
+        let listener = std::os::unix::net::UnixListener::bind(&socket).expect("bind");
+        std::mem::forget(listener);
+        socket
+    }
+
+    #[test]
+    fn a_private_folder_with_the_operator_s_socket_is_accepted() {
+        let tmp = tempfile::tempdir().expect("tempdir");
+        let folder = tmp.path().join("zeo-ssh");
+        std::fs::create_dir(&folder).unwrap();
+        std::fs::set_permissions(&folder, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let socket = bound_socket(&folder);
+        let uid = unsafe { libc::getuid() };
+        let (checked, checked_folder) =
+            check_socket(socket.to_str().unwrap(), tmp.path(), uid, |_| false).unwrap();
+        assert_eq!((checked, checked_folder), (socket.clone(), folder.clone()));
+
+        // Open to others, someone else's, protected, relative, or not a socket: refused.
+        std::fs::set_permissions(&folder, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let problem = |raw: &str, uid: u32, protected: bool| {
+            check_socket(raw, tmp.path(), uid, |_| protected)
+                .unwrap_err()
+                .1
+        };
+        let raw = socket.to_str().unwrap();
+        assert_eq!(problem(raw, uid, false), SshSocketProblem::OpenFolder);
+        std::fs::set_permissions(&folder, std::fs::Permissions::from_mode(0o700)).unwrap();
+        assert_eq!(problem(raw, uid + 1, false), SshSocketProblem::NotYours);
+        assert_eq!(problem(raw, uid, true), SshSocketProblem::Protected);
+        assert_eq!(
+            problem("zeo-ssh/agent.sock", uid, false),
+            SshSocketProblem::NotAbsolute
+        );
+        let plain = folder.join("plain");
+        std::fs::write(&plain, "").unwrap();
+        assert_eq!(
+            problem(plain.to_str().unwrap(), uid, false),
+            SshSocketProblem::NotASocket
+        );
+        // `~/` is the home given.
+        assert!(check_socket("~/zeo-ssh/agent.sock", tmp.path(), uid, |_| false).is_ok());
+    }
+}
