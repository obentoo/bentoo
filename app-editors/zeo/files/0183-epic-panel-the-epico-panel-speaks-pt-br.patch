@@ -0,0 +1,23 @@
+### The Epico panel: epic_panel/src/panel.rs (patch 0183, USE epic). The English is the code's own,
+### byte for byte. Kept as they are: the panel's name in the dock ("Epico Stories"), the story
+### fields the epic plugin writes (type, scale, engineering, the statuses) and EPICO.md's name.
+
+epic-panel-no-epic-dir = No .epico/ directory in this project
+epic-panel-no-stories = No stories yet
+epic-panel-unknown-status = Status not known to this Zeo; the epic plugin may be newer
+epic-panel-live-updates-off = Live updates are off: { $reason }. Use Refresh.
+epic-panel-open-index = Open { $file }
+epic-panel-open-failed = Could not open { $path }: { $reason }
+epic-panel-refresh = Refresh
+epic-panel-archived = Archived ({ $count })
+epic-panel-more-not-shown = { $count } more not shown
+epic-panel-badge = { $problem ->
+    [unreadable] unreadable
+    [too_large] too large
+    [symlink] symlink not followed
+   *[no_files] no story files
+}
+epic-panel-problem-unreadable = { $file }: unreadable ({ $reason })
+epic-panel-problem-too-large = { $file }: too large ({ $bytes } bytes, over the { $limit }-byte limit)
+epic-panel-problem-symlink = { $file }: symlink not followed
+epic-panel-problem-no-files = No story.md or tasks.md in this directory
diff --git a/crates/zeo_i18n/locales/pt-BR/epic-panel.ftl b/crates/zeo_i18n/locales/pt-BR/epic-panel.ftl
new file mode 100644
index 0000000..c7ab2d3
--- /dev/null
+++ b/crates/zeo_i18n/locales/pt-BR/epic-panel.ftl
@@ -0,0 +1,26 @@
+### The Epico panel in Brazilian Portuguese (patch 0183), translated by hand on 2026-11-25;
+### awaiting the operator's review as a native speaker. "story" is the plugin's own word for its
+### unit of work and stays in English, as do the file names and the plugin's field names.
+
+epic-panel-no-epic-dir = Nenhum diretório .epico/ neste projeto
+epic-panel-no-stories = Nenhuma story ainda
+epic-panel-unknown-status = Status desconhecido para este Zeo; o plugin epic pode ser mais novo
+epic-panel-live-updates-off = A atualização ao vivo está desligada: { $reason }. Use Atualizar.
+epic-panel-open-index = Abrir { $file }
+epic-panel-open-failed = Não foi possível abrir { $path }: { $reason }
+epic-panel-refresh = Atualizar
+epic-panel-archived = Arquivadas ({ $count })
+epic-panel-more-not-shown = { $count ->
+    [one] mais { $count } não mostrada
+   *[other] mais { $count } não mostradas
+}
+epic-panel-badge = { $problem ->
+    [unreadable] ilegível
+    [too_large] grande demais
+    [symlink] symlink não seguido
+   *[no_files] sem arquivos de story
+}
+epic-panel-problem-unreadable = { $file }: ilegível ({ $reason })
+epic-panel-problem-too-large = { $file }: grande demais ({ $bytes } bytes, acima do limite de { $limit } bytes)
+epic-panel-problem-symlink = { $file }: symlink não seguido
+epic-panel-problem-no-files = Nenhum story.md ou tasks.md neste diretório
