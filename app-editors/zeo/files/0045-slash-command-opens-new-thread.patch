+#[gpui::test]
+fn test_code_block_action_absent_when_the_hook_declines(cx: &mut TestAppContext) {
+    // Two blocks in one message: the hook accepts only the second, so the first gets
+    // only today's buttons and the second gets the action.
+    let (hook, recorder) =
+        recording_hook(IconName::ThreadFromSummary, |code| code.trim() == "/help");
+    let cx = open_view(
+        vec![("```\necho hi\n```\n\n```\n/help\n```\n", Some(hook))],
+        CopyButtonVisibility::AlwaysVisible,
+        cx,
+    );
+
+    let asked = recorder.asked.borrow().clone();
+    assert!(
+        asked.iter().any(|code| code.trim() == "echo hi")
+            && asked.iter().any(|code| code.trim() == "/help"),
+        "the hook is asked about every code block: {asked:?}"
+    );
+    let button = cx
+        .debug_bounds(ACTION)
+        .expect("the accepted block has a button");
+    cx.simulate_click(button.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert_eq!(
+        recorder
+            .clicked
+            .borrow()
+            .iter()
+            .map(|code| code.trim().to_string())
+            .collect::<Vec<_>>(),
+        vec!["/help".to_string()],
+        "the only button belongs to the accepted block"
+    );
+}
