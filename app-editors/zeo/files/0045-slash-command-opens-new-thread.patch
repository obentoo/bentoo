diff --git a/crates/agent_ui/src/slash_command_in_code_block_tests.rs b/crates/agent_ui/src/slash_command_in_code_block_tests.rs
new file mode 100644
index 0000000..38223e7
--- /dev/null
+++ b/crates/agent_ui/src/slash_command_in_code_block_tests.rs
@@ -0,0 +1,143 @@
+//! Which code blocks qualify for the "new thread with this command" button (story 020,
+//! Task 2.1; R1.1, R1.2, R1.3).
+//!
+//! Wiring: in `crates/agent_ui/src/agent_ui.rs` (the crate root) declare
+//!
+//!     #[cfg(test)]
+//!     mod slash_command_in_code_block_tests;
+//!
+//! The predicate must be reachable as `crate::slash_command_in_code_block` -- if it is
+//! defined in a submodule, re-export it at the crate root with `pub(crate) use`.
+//!
+//! Contract: `fn slash_command_in_code_block(code: &str) -> Option<&str>` returns the
+//! command, trimmed, when the block holds exactly one non-empty line and that line starts
+//! with `/` once leading whitespace is ignored; otherwise `None`.
+//!
+//! Order follows the hostile-half rule: first the inputs that would make the rule
+//! wrongly COLLAPSE (distinct lines merged into one command, a non-command accepted),
+//! then the inputs that would make it wrongly SPLIT (one command, differently shaped,
+//! rejected or returned differently), then the plain case.
+
+use crate::slash_command_in_code_block;
+
+// ---------------------------------------------------------------------------
+// Hostile half 1 -- must stay apart: never one command out of several lines
+// ---------------------------------------------------------------------------
+
+#[test]
+fn test_slash_command_in_code_block_rejects_two_commands() {
+    // Two slash lines are two commands, not one (R1.2).
+    assert_eq!(
+        slash_command_in_code_block("/epic:epic stories run 014\n/epic:epic stories run 015\n"),
+        None
+    );
+    // Even when the two lines are identical.
+    assert_eq!(slash_command_in_code_block("/help\n/help"), None);
+}
+
+#[test]
+fn test_slash_command_in_code_block_rejects_a_command_with_any_other_line() {
+    // A slash line followed or preceded by any other non-empty line (R1.2).
+    assert_eq!(slash_command_in_code_block("/help\nthen press enter"), None);
+    assert_eq!(slash_command_in_code_block("run this:\n/help"), None);
+    assert_eq!(slash_command_in_code_block("/help\n\n\nmore"), None);
+    // A blank-looking line that carries text after its indentation is still a line.
+    assert_eq!(slash_command_in_code_block("/help\n    x"), None);
+}
+
+#[test]
+fn test_slash_command_in_code_block_rejects_a_line_not_starting_with_slash() {
+    // The `/` has to be the first non-whitespace character (R1.3).
+    assert_eq!(slash_command_in_code_block("echo /help"), None);
+    assert_eq!(slash_command_in_code_block("$ /help"), None);
+    assert_eq!(slash_command_in_code_block("# /help"), None);
+    assert_eq!(slash_command_in_code_block("cargo test"), None);
+    assert_eq!(slash_command_in_code_block("\\/help"), None);
+}
+
+#[test]
+fn test_slash_command_in_code_block_rejects_a_bare_slash_and_empty_blocks() {
+    // A lone `/` names no command.
+    assert_eq!(slash_command_in_code_block("/"), None);
+    assert_eq!(slash_command_in_code_block("   /   \n"), None);
+    // No non-empty line at all.
+    assert_eq!(slash_command_in_code_block(""), None);
+    assert_eq!(slash_command_in_code_block("\n\n"), None);
+    assert_eq!(slash_command_in_code_block("  \t \n   "), None);
+}
+
+// ---------------------------------------------------------------------------
+// Hostile half 2 -- must come together: one command, however it is wrapped
+// ---------------------------------------------------------------------------
+
+#[test]
+fn test_slash_command_in_code_block_ignores_surrounding_whitespace_and_blank_lines() {
+    // Every one of these is the same single command, and all must yield the SAME
+    // trimmed text -- a predicate that accepts some shapes and not others, or returns
+    // the indentation / line ending along with the command, splits one command in two.
+    let shapes = [
+        "/help",
+        "/help\n",
+        "  /help",
+        "/help   ",
+        "\t/help\t",
+        "/help\r\n",
+        "\n\n/help\n\n",
+        "   \n  /help  \n \t \n",
+    ];
+    for shape in shapes {
+        assert_eq!(
+            slash_command_in_code_block(shape),
+            Some("/help"),
+            "shape {shape:?} holds the one command `/help`"
+        );
+    }
+}
+
+#[test]
+fn test_slash_command_in_code_block_keeps_the_command_whole() {
+    // Interior spaces, colons and arguments are part of the one command: it must not be
+    // cut at the first space.
+    assert_eq!(
+        slash_command_in_code_block("  /epic:epic stories run 014  \n"),
+        Some("/epic:epic stories run 014")
+    );
+    assert_eq!(
+        slash_command_in_code_block("/compact keep the   spacing"),
+        Some("/compact keep the   spacing")
+    );
+}
+
+#[test]
+fn test_slash_command_in_code_block_takes_a_path_literally() {
+    // R1.1 read literally: a single line that starts with `/` qualifies, so a lone path
+    // such as `/usr/bin/foo` gets the button too. The story decides by shape, not by
+    // knowing the agent's command list; this test pins that decision so a later change
+    // to it is deliberate.
+    assert_eq!(
+        slash_command_in_code_block("/usr/bin/foo\n"),
+        Some("/usr/bin/foo")
+    );
+}
+
+// ---------------------------------------------------------------------------
+// The plain case
+// ---------------------------------------------------------------------------
+
+#[test]
+fn test_slash_command_in_code_block_accepts_one_command() {
+    assert_eq!(slash_command_in_code_block("/help"), Some("/help"));
+    assert_eq!(
+        slash_command_in_code_block("/epic:epic stories run 014"),
+        Some("/epic:epic stories run 014")
+    );
+}
+
+#[test]
+fn test_slash_command_in_code_block_returns_a_slice_of_its_input() {
+    // `Option<&str>` borrowed from the block: the command is the block's own text.
+    let block = String::from("\n  /review src/main.rs  \n");
+    let command = slash_command_in_code_block(&block).expect("one command");
+    let start = command.as_ptr() as usize - block.as_ptr() as usize;
+    assert_eq!(&block[start..start + command.len()], "/review src/main.rs");
+}
diff --git a/crates/markdown/src/code_block_action_tests.rs b/crates/markdown/src/code_block_action_tests.rs
new file mode 100644
index 0000000..e38ceed
--- /dev/null
+++ b/crates/markdown/src/code_block_action_tests.rs
@@ -0,0 +1,368 @@
+//! A caller-decided action button in a code block's button row (story 020, Task 3.1;
+//! R1.1, R1.5, Q12).
+//!
+//! Wiring: in `crates/markdown/src/markdown.rs` (the crate root) declare
+//!
+//!     #[cfg(test)]
+//!     mod code_block_action_tests;
+//!
+//! Contract (from the plan's surface):
+//!   - `MarkdownElement::on_code_block_action(self, impl Fn(&str) -> Option<CodeBlockAction> + 'static) -> Self`
+//!   - `pub struct CodeBlockAction { pub icon: IconName, pub tooltip: SharedString (or any
+//!     `From<&'static str>`), pub on_click: Rc<dyn Fn(&str, &mut Window, &mut App)> }`
+//!   - the button is a `ui::IconButton`, so it paints under the debug selector
+//!     `ICON-{icon:?}` -- that is how these tests find it.
+//!
+//! Behaviour asserted: the hook is asked with the block's code; `Some` draws a button that
+//! hands that same code to `on_click`; `None` draws nothing extra; the button follows the
+//! Copy button's visibility (hidden with it, revealed on hover with it); each block's
+//! button hands over its own block's code; buttons stay distinct across two markdown
+//! entities rendering the same source.
+
+use std::{cell::RefCell, rc::Rc};
+
+use gpui::{
+    App, AppContext as _, Bounds, Context, Entity, IntoElement, Modifiers, ParentElement as _,
+    Pixels, Point, Render, Styled as _, TestAppContext, VisualTestContext, Window, div, px, size,
+};
+use ui::IconName;
+
+use crate::{
+    CodeBlockAction, CodeBlockRenderer, CopyButtonVisibility, Markdown, MarkdownElement,
+    MarkdownStyle, WrapButtonVisibility,
+};
+
+type Hook = Rc<dyn Fn(&str) -> Option<CodeBlockAction>>;
+
+const ACTION: &str = "ICON-ThreadFromSummary";
+const OTHER_ACTION: &str = "ICON-Plus";
+const COPY: &str = "ICON-Copy";
+
+struct ActionView {
+    markdowns: Vec<(Entity<Markdown>, Option<Hook>)>,
+    copy: CopyButtonVisibility,
+}
+
+impl Render for ActionView {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let mut root = div().size_full().flex().flex_col();
+        for (markdown, hook) in &self.markdowns {
+            let mut element = MarkdownElement::new(markdown.clone(), MarkdownStyle::default())
+                .code_block_renderer(CodeBlockRenderer::Default {
+                    copy_button_visibility: self.copy,
+                    wrap_button_visibility: WrapButtonVisibility::Hidden,
+                    border: false,
+                });
+            if let Some(hook) = hook.clone() {
+                element = element.on_code_block_action(move |code| hook(code));
+            }
+            root = root.child(element);
+        }
+        root
+    }
+}
+
+fn ensure_theme_initialized(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        if !cx.has_global::<settings::SettingsStore>() {
+            settings::init(cx);
+        }
+        if !cx.has_global::<theme::GlobalTheme>() {
+            theme_settings::init(theme::LoadThemes::JustBase, cx);
+        }
+    });
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// A hook that records every code it is asked about and every code handed to a click,
+/// answering with `icon` for every block whose code satisfies `accept`.
+struct Recorder {
+    asked: Rc<RefCell<Vec<String>>>,
+    clicked: Rc<RefCell<Vec<String>>>,
+}
+
+fn recording_hook(icon: IconName, accept: fn(&str) -> bool) -> (Hook, Recorder) {
+    let asked = Rc::new(RefCell::new(Vec::new()));
+    let clicked = Rc::new(RefCell::new(Vec::new()));
+    let hook: Hook = {
+        let asked = asked.clone();
+        let clicked = clicked.clone();
+        Rc::new(move |code: &str| {
+            asked.borrow_mut().push(code.to_string());
+            if !accept(code) {
+                return None;
+            }
+            let clicked = clicked.clone();
+            Some(CodeBlockAction {
+                icon,
+                tooltip: "New Thread with This Command".into(),
+                on_click: Rc::new(move |code: &str, _: &mut Window, _: &mut App| {
+                    clicked.borrow_mut().push(code.to_string());
+                }),
+            })
+        })
+    };
+    (hook, Recorder { asked, clicked })
+}
+
+fn open_view<'a>(
+    sources: Vec<(&str, Option<Hook>)>,
+    copy: CopyButtonVisibility,
+    cx: &'a mut TestAppContext,
+) -> &'a mut VisualTestContext {
+    ensure_theme_initialized(cx);
+    let markdowns: Vec<(Entity<Markdown>, Option<Hook>)> = sources
+        .into_iter()
+        .map(|(source, hook)| {
+            let source = source.to_string();
+            (
+                cx.new(|cx| Markdown::new(source.into(), None, None, cx)),
+                hook,
+            )
+        })
+        .collect();
+    cx.run_until_parked();
+    let (_, cx) = cx.add_window_view(move |_, _| ActionView { markdowns, copy });
+    cx.simulate_resize(size(px(600.), px(400.)));
+    cx.simulate_mouse_move(Point::new(px(599.), px(399.)), None, Modifiers::none());
+    draw(cx);
+    cx
+}
+
+/// Moves the mouse down the view and returns the first bounds at which `selector` paints.
+fn hover_until_painted(
+    selector: &'static str,
+    cx: &mut VisualTestContext,
+) -> Option<Bounds<Pixels>> {
+    for y in (2..400).step_by(4) {
+        cx.simulate_mouse_move(Point::new(px(300.), px(y as f32)), None, Modifiers::none());
+        draw(cx);
+        if let Some(bounds) = cx.debug_bounds(selector) {
+            return Some(bounds);
+        }
+    }
+    None
+}
