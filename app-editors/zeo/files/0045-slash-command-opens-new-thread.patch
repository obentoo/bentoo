+++ b/crates/agent_ui/src/agent_panel.rs
@@ -2119,6 +2119,72 @@ impl AgentPanel {
         self.activate_new_thread(true, AgentThreadSource::AgentPanel, window, cx);
     }
 
+    /// Opens a new thread for `agent` with `text` in its composer -- never sent:
+    /// the operator reviews it and sends it. An agent that is no longer
+    /// configured opens nothing and says so. `source_session` is the session whose
+    /// message offered the command -- a subagent's, when the click came from one,
+    /// which the panel's active thread (always the root) would misreport.
+    pub fn new_thread_with_prefilled_prompt(
+        &mut self,
+        agent: Agent,
+        source_session: acp_v2::SessionId,
+        text: String,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let agent_id = agent.id();
+        let is_available = match &agent {
+            Agent::Custom { id } => self
+                .project
+                .read(cx)
+                .agent_server_store()
+                .read(cx)
+                .external_agents()
+                .any(|known| known == id),
+            _ => true,
+        };
+        if !is_available {
+            log::warn!(
+                "prefilled thread not opened: agent {agent_id} is not available (source session {source_session})"
+            );
+            struct PrefilledAgentUnavailableToast;
+            self.workspace
+                .update(cx, |workspace, cx| {
+                    workspace.show_toast(
+                        workspace::Toast::new(
+                            workspace::notifications::NotificationId::unique::<
+                                PrefilledAgentUnavailableToast,
+                            >(),
+                            format!(
+                                "Can't open a new thread: agent \"{agent_id}\" is not available"
+                            ),
+                        ),
+                        cx,
+                    );
+                })
+                .log_err();
+            return;
+        }
+        log::info!(
+            "opening a prefilled thread: agent {agent_id}, source session {source_session}, command length {}",
+            text.len()
+        );
+        self.external_thread(
+            Some(agent),
+            None,
+            None,
+            None,
+            Some(AgentInitialContent::ContentBlock {
+                blocks: vec![acp_v2::ContentBlock::Text(acp_v2::TextContent::new(text))],
+                auto_submit: false,
+            }),
+            true,
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        );
+    }
+
     fn set_selected_agent_and_persist(&mut self, agent: Agent, cx: &mut Context<Self>) {
         if self.selected_agent != agent {
             self.selected_agent = agent.clone();
