+#[gpui::test]
+fn test_code_block_action_each_block_hands_over_its_own_code(cx: &mut TestAppContext) {
+    // Hostile half for block identity: two accepted blocks in one markdown must not
+    // collapse onto one button (e.g. a shared id or a captured first `code`). Different
+    // icons per block make each button separately findable.
+    let clicked = Rc::new(RefCell::new(Vec::<String>::new()));
+    let hook: Hook = {
+        let clicked = clicked.clone();
+        Rc::new(move |code: &str| {
+            let icon = match code.trim() {
+                "/first" => IconName::ThreadFromSummary,
+                "/second" => IconName::Plus,
+                _ => return None,
+            };
+            let clicked = clicked.clone();
+            Some(CodeBlockAction {
+                icon,
+                tooltip: "New Thread with This Command".into(),
+                on_click: Rc::new(move |code: &str, _: &mut Window, _: &mut App| {
+                    clicked.borrow_mut().push(code.trim().to_string());
+                }),
+            })
+        })
+    };
+    let cx = open_view(
+        vec![(
+            "```\n/first\n```\n\ntext\n\n```\n/second\n```\n",
+            Some(hook),
+        )],
+        CopyButtonVisibility::AlwaysVisible,
+        cx,
+    );
+
+    let second = cx
+        .debug_bounds(OTHER_ACTION)
+        .expect("second block's button");
+    cx.simulate_click(second.center(), Modifiers::none());
+    cx.run_until_parked();
+    draw(cx);
+    let first = cx.debug_bounds(ACTION).expect("first block's button");
+    cx.simulate_click(first.center(), Modifiers::none());
+    cx.run_until_parked();
+
+    assert_eq!(
+        *clicked.borrow(),
+        vec!["/second".to_string(), "/first".to_string()],
+        "each button hands over its own block's code"
+    );
+}
+
+#[gpui::test]
+fn test_code_block_action_unique_across_markdown_entities(cx: &mut TestAppContext) {
+    // Mirrors `test_code_block_controls_are_unique_across_markdown_entities`: two
+    // entities render the same source, both with the hook, beside Copy. Each entity's
+    // button must reach its own handler.
+    let (first_hook, first) = recording_hook(IconName::ThreadFromSummary, |_| true);
+    let (second_hook, second) = recording_hook(IconName::Plus, |_| true);
+    let source = "```sh\n/help\n```";
+    let cx = open_view(
+        vec![(source, Some(first_hook)), (source, Some(second_hook))],
+        CopyButtonVisibility::AlwaysVisible,
+        cx,
+    );
+
+    let a = cx.debug_bounds(ACTION).expect("first entity's button");
+    let b = cx
+        .debug_bounds(OTHER_ACTION)
+        .expect("second entity's button");
+    assert_ne!(a, b, "two entities, two buttons");
+
+    cx.simulate_click(b.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert_eq!(first.clicked.borrow().len(), 0);
+    assert_eq!(second.clicked.borrow().len(), 1);
+
+    draw(cx);
+    let a = cx.debug_bounds(ACTION).expect("first entity's button");
+    cx.simulate_click(a.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert_eq!(first.clicked.borrow().len(), 1);
+    assert_eq!(second.clicked.borrow().len(), 1);
+}
