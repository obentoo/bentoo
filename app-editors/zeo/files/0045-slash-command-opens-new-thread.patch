+//! Contract between the button, the predicate and the panel (story 020, Task 5.2;
+//! R1.2, R2.2, R2.3, R2.4, Q11).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod slash_command_contract_tests;` beside `mod prefilled_prompt_tests;` and
+//! `mod slash_command_button_tests;` (whose harnesses this reuses). Resolves to
+//! `crates/agent_ui/src/agent_panel/tests/slash_command_contract_tests.rs`.
+//!
+//! The string the click hands over must be exactly the predicate's trimmed command, and
+//! the new thread's composer must hold exactly that string -- end to end, through the
+//! real markdown rendering of an agent message, the real button and the real panel.
+
+use gpui::TestAppContext;
+
+use super::prefilled_prompt_tests::*;
+use super::slash_command_button_tests::{click, sweep};
+use crate::slash_command_in_code_block;
+
+#[gpui::test]
+async fn test_slash_command_contract_click_prefills_the_trimmed_command(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    // Blank lines and indentation around the command: the derived value (the trimmed
+    // command) is what must arrive, not the block's raw text.
+    let block = "\n   /epic:epic stories run 014   \n\n";
+    let reply =
+        format!("Not this one:\n\n```\n/help\nand more\n```\n\nThis one:\n\n```{block}```\n");
+    assert_eq!(
+        slash_command_in_code_block(block),
+        Some(COMMAND),
+        "precondition: the predicate's answer for the qualifying block"
+    );
+    let source = open_source_thread(&panel, "what next?", vec![agent_says(&reply)], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_agent = active_agent_id(&panel, &cx);
+    let source_entries = entry_count(&source, &cx);
+    let toasts = notification_count(&workspace, &cx);
+
+    let sweep = sweep(&mut cx);
+    assert_eq!(
+        sweep.actions.len(),
+        1,
+        "R1.2: the two-line block has no button; the single-command block has one"
+    );
+    click(sweep.actions[0], &mut cx);
+
+    // R2.1-R2.3: new thread, same agent, the predicate's exact output in a focused
+    // composer, nothing sent.
+    assert_prefilled_new_thread(&panel, &source, &source_agent, COMMAND, &mut cx);
+    // R2.4: the source thread is unchanged and still kept; nothing failed.
+    assert_eq!(
+        entry_count(&source, &cx),
+        source_entries,
+        "R2.4: source untouched"
+    );
+    assert!(
+        panel.read_with(&cx, |panel, _| panel
+            .retained_threads()
+            .contains_key(&source_id)),
+        "R2.4: the source thread is still kept"
+    );
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts,
+        "no error toast"
+    );
+}
