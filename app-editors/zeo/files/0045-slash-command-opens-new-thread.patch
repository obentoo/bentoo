+#[gpui::test]
+fn test_code_block_action_is_asked_with_the_code_and_hands_it_to_the_click(
+    cx: &mut TestAppContext,
+) {
+    let (hook, recorder) = recording_hook(IconName::ThreadFromSummary, |_| true);
+    let cx = open_view(
+        vec![(
+            "Next:\n\n```sh\n  /epic:epic stories run 014  \n```\n",
+            Some(hook),
+        )],
+        CopyButtonVisibility::AlwaysVisible,
+        cx,
+    );
+
+    let asked = recorder.asked.borrow().clone();
+    assert!(
+        asked
+            .iter()
+            .any(|code| code.trim() == "/epic:epic stories run 014"),
+        "the hook must be asked with the block's code, got {asked:?}"
+    );
+    assert!(
+        cx.debug_bounds(COPY).is_some(),
+        "precondition: Copy is painted"
+    );
+    let button = cx
+        .debug_bounds(ACTION)
+        .expect("the hook said Some: its button must be painted beside Copy");
+
+    cx.simulate_click(button.center(), Modifiers::none());
+    cx.run_until_parked();
+
+    let clicked = recorder.clicked.borrow().clone();
+    assert_eq!(clicked.len(), 1, "one click, one call: {clicked:?}");
+    assert!(
+        asked.contains(&clicked[0]),
+        "the click hands over the same code the hook was asked with: {clicked:?} vs {asked:?}"
+    );
+}
