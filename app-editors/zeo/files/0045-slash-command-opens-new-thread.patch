+++ b/crates/agent_ui/src/agent_panel/tests/prefilled_prompt_tests.rs
@@ -0,0 +1,305 @@
+//! `AgentPanel::new_thread_with_prefilled_prompt` (story 020, Task 4.1; R2.1-R2.5, Q4).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod prefilled_prompt_tests;` -- an inline module of a non-mod-rs file, so this
+//! resolves to `crates/agent_ui/src/agent_panel/tests/prefilled_prompt_tests.rs`.
+//! `slash_command_button_tests.rs` and `slash_command_contract_tests.rs` reuse the
+//! harness below and need this module declared beside them.
+//!
+//! Contract: `pub fn new_thread_with_prefilled_prompt(&mut self, agent: Agent, text: String,
+//! window: &mut Window, cx: &mut Context<Self>)`. Behaviour asserted: a new thread for that
+//! agent becomes active with `text` in its focused composer and nothing sent; the source
+//! thread is untouched and kept; an agent that is not available raises one toast and
+//! opens nothing.
+//!
+//! Not asserted here (no log capture in these tests): the INFO line of R3.1 and the WARN
+//! line of the unavailable path -- reviewed, not tested.
+
+use std::{path::Path, time::Duration};
+
+use acp_thread::{AcpThread, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, Focusable as _, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::conversation_view::tests::init_test;
+use crate::test_support::open_thread_with_custom_connection;
+use crate::{Agent, AgentPanel};
+
+pub(super) const COMMAND: &str = "/epic:epic stories run 014";
+
+/// A visible agent panel in a workspace window.
+pub(super) async fn setup_panel_in_workspace(
+    cx: &mut TestAppContext,
+) -> (Entity<AgentPanel>, Entity<Workspace>, VisualTestContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(800.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    (panel, workspace, cx)
+}
+
+/// Opens a thread on a stub connection whose agent id is `stub` (so the agent resolves to
+/// the always-available `Agent::Stub`), sends `prompt`, and lets the stub answer with
+/// `reply` (agent message chunks and/or thought chunks).
+pub(super) fn open_source_thread(
+    panel: &Entity<AgentPanel>,
+    prompt: &str,
+    reply: Vec<acp::SessionUpdate>,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    let connection = StubAgentConnection::new();
+    open_thread_with_custom_connection(panel, connection.clone(), cx);
+    connection.set_next_prompt_updates(reply);
+    let thread_view = panel.read_with(cx, |panel, cx| panel.active_thread_view(cx).unwrap());
+    let message_editor = thread_view.read_with(cx, |view, _cx| view.message_editor.clone());
+    message_editor.update_in(cx, |editor, window, cx| editor.set_text(prompt, window, cx));
+    thread_view.update_in(cx, |view, window, cx| view.send(window, cx));
+    cx.run_until_parked();
+    panel.read_with(cx, |panel, cx| panel.active_agent_thread(cx).unwrap())
+}
+
+pub(super) fn agent_says(text: &str) -> acp::SessionUpdate {
+    acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(text.into()))
+}
+
+pub(super) fn agent_thinks(text: &str) -> acp::SessionUpdate {
+    acp::SessionUpdate::AgentThoughtChunk(acp::ContentChunk::new(text.into()))
+}
+
+pub(super) fn notification_count(workspace: &Entity<Workspace>, cx: &VisualTestContext) -> usize {
+    workspace.read_with(cx, |workspace, _| workspace.notification_ids().len())
+}
+
+/// The agent id of the active conversation.
+pub(super) fn active_agent_id(
+    panel: &Entity<AgentPanel>,
+    cx: &VisualTestContext,
+) -> project::AgentId {
+    panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .expect("a conversation is active")
+            .read(cx)
+            .agent_key()
+            .id()
+    })
+}
+
+pub(super) fn entry_count(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| thread.entries().len())
+}
+
+/// Lets any deferred work (a would-be auto-submit included) run out.
+pub(super) fn settle(cx: &mut VisualTestContext) {
+    cx.run_until_parked();
+    cx.executor().advance_clock(Duration::from_secs(5));
+    cx.run_until_parked();
+}
+
+/// Asserts the active thread is a new one, on the agent whose id is `agent_id`, holding
+/// exactly `command` in its focused composer, with nothing sent.
+pub(super) fn assert_prefilled_new_thread(
+    panel: &Entity<AgentPanel>,
+    source: &Entity<AcpThread>,
+    agent_id: &project::AgentId,
+    command: &str,
+    cx: &mut VisualTestContext,
+) {
+    let active = panel
+        .read_with(cx, |panel, cx| panel.active_agent_thread(cx))
+        .filter(|thread| thread != source);
+    let new_thread_id = panel.read_with(cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let conversation = panel
+        .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+        .expect("a conversation is active");
+    let source_session = source.read_with(cx, |thread, _| thread.session_id().clone());
+    assert_ne!(
+        active
+            .as_ref()
+            .map(|t| t.read_with(cx, |t, _| t.session_id().clone())),
+        Some(source_session),
+        "R2.1: a NEW thread is active, not the source"
+    );
+    assert_eq!(
+        &conversation.read_with(cx, |view, _| view.agent_key().id()),
+        agent_id,
+        "R2.1: the new thread runs the same agent"
+    );
+    assert_eq!(
+        panel.read_with(cx, |panel, cx| panel.editor_text(new_thread_id, cx)),
+        Some(command.to_string()),
+        "R2.2: the composer holds exactly the command"
+    );
+    if let Some(thread) = active {
+        assert_eq!(
+            entry_count(&thread, cx),
+            0,
+            "R2.3: nothing is sent until the operator sends it"
+        );
+    }
+    let thread_view = panel.read_with(cx, |panel, cx| panel.active_thread_view(cx).unwrap());
+    let message_editor = thread_view.read_with(cx, |view, _| view.message_editor.clone());
+    assert!(
+        cx.update(|window, cx| message_editor.focus_handle(cx).contains_focused(window, cx)),
+        "R2.2: the composer has focus"
+    );
+}
+
+#[gpui::test]
+async fn test_prefilled_prompt_opens_a_new_thread_with_the_text_unsent(cx: &mut TestAppContext) {
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "what next?", vec![agent_says("Run it.")], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_entries = entry_count(&source, &cx);
+    assert!(
+        source_entries >= 2,
+        "precondition: the source thread has a turn"
+    );
+    let toasts = notification_count(&workspace, &cx);
+
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            Agent::Stub,
+            source_session.clone(),
+            COMMAND.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_prefilled_new_thread(&panel, &source, &Agent::Stub.id(), COMMAND, &mut cx);
+    assert_ne!(
+        panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap()),
+        source_id
+    );
+    // R2.4: the source thread is unchanged and still kept by the panel.
+    assert_eq!(
+        entry_count(&source, &cx),
+        source_entries,
+        "R2.4: source untouched"
+    );
+    assert!(
+        panel.read_with(&cx, |panel, _| panel
+            .retained_threads()
+            .contains_key(&source_id)),
+        "R2.4: the source thread is still kept"
+    );
+    // An available agent raises no error.
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts,
+        "no toast on success"
+    );
+}
+
+#[gpui::test]
+async fn test_prefilled_prompt_keeps_the_text_verbatim(cx: &mut TestAppContext) {
+    // The panel does not reinterpret the text: what it is given is what the composer gets
+    // (a mention-like `@`, a second slash, interior spacing).
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let text = "/review  @src/main.rs /tmp/x";
+
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            Agent::Stub,
+            source_session.clone(),
+            text.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_prefilled_new_thread(&panel, &source, &Agent::Stub.id(), text, &mut cx);
+}
+
+#[gpui::test]
+async fn test_prefilled_prompt_for_an_unavailable_agent_toasts_and_opens_nothing(
+    cx: &mut TestAppContext,
+) {
+    let (panel, workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let source = open_source_thread(&panel, "hi", vec![agent_says("ok")], &mut cx);
+    let source_id = panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap());
+    let source_conversation = panel
+        .read_with(&cx, |panel, _| panel.active_conversation_view().cloned())
+        .unwrap();
+    let source_entries = entry_count(&source, &cx);
+    let toasts = notification_count(&workspace, &cx);
+
+    // A custom agent the agent-server store does not know: removed from settings since
+    // the source thread was opened.
+    let retired = Agent::Custom {
+        id: "retired-agent".into(),
+    };
+    let source_session = source.read_with(&cx, |thread, _| thread.session_id().clone());
+    panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            retired,
+            source_session.clone(),
+            COMMAND.to_string(),
+            window,
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    assert_eq!(
+        notification_count(&workspace, &cx),
+        toasts + 1,
+        "R2.5/Q4: exactly one error toast"
+    );
+    assert_eq!(
+        panel.read_with(&cx, |panel, cx| panel.active_thread_id(cx).unwrap()),
+        source_id,
+        "R2.5: no thread is opened -- the source stays active"
+    );
+    assert_eq!(
+        panel
+            .read_with(&cx, |panel, _| panel.active_conversation_view().cloned())
+            .map(|view| view.entity_id()),
+        Some(source_conversation.entity_id()),
+        "R2.5: no new conversation replaces the source"
+    );
+    assert!(
+        !panel
+            .read_with(&cx, |panel, cx| panel.retained_threads().values().any(
+                |view| view.read(cx).agent_key().id().as_ref() == "retired-agent"
+            )),
+        "R2.5: no thread for the unavailable agent is kept either"
+    );
+    assert_eq!(entry_count(&source, &cx), source_entries);
+    assert_eq!(
+        panel.read_with(&cx, |panel, cx| panel.editor_text(source_id, cx)),
+        None,
+        "the source composer did not receive the command"
+    );
+}
diff --git a/crates/agent_ui/src/agent_panel/tests/slash_command_button_tests.rs b/crates/agent_ui/src/agent_panel/tests/slash_command_button_tests.rs
new file mode 100644
index 0000000..c08aff6
--- /dev/null
+++ b/crates/agent_ui/src/agent_panel/tests/slash_command_button_tests.rs
@@ -0,0 +1,180 @@
+//! The "new thread with this command" button appears only on qualifying code blocks of
+//! agent messages (story 020, Task 5.1; R1.1-R1.5, R2.1).
+//!
+//! Wiring: inside `crates/agent_ui/src/agent_panel.rs`'s `mod tests { .. }`, declare
+//! `mod slash_command_button_tests;` beside `mod prefilled_prompt_tests;` (whose harness
+//! this reuses). Resolves to `crates/agent_ui/src/agent_panel/tests/slash_command_button_tests.rs`.
+//!
+//! How the button is found: it is a `ui::IconButton`, which paints under the debug
+//! selector `ICON-{icon:?}`. These tests pin the icon to `IconName::ThreadFromSummary`
+//! (painted nowhere else in Zed). If the implementation picks another icon, change
+//! `ACTION` -- the one audited surface pin -- and check that icon is not painted
+//! elsewhere in the panel (the precondition in `sweep` catches that).
+//!
+//! The code-block buttons show on hover, so `sweep` moves the mouse over the whole window
+//! and records every distinct bounds at which the action and the code block's Wrap button
+//! (`ICON-TextWrap`, painted only in a hovered code block's row) are painted. Copy cannot
+//! be the witness: a debug selector keeps only the last bounds painted in a frame, and the
+//! thread's own always-visible Copy button (`ICON-Copy`, below the message) paints after
+//! the code blocks, so `ICON-Copy` never reports a code block's Copy. Every test
+//! carries a qualifying control block, so each one needs the feature to pass, and asserts
+//! that the ONLY button revealed hands over the control's command.
+
+use std::collections::BTreeSet;
+
+use gpui::{Bounds, Modifiers, Pixels, Point, TestAppContext, VisualTestContext, px};
+
+use super::prefilled_prompt_tests::*;
+
+pub(super) const ACTION: &str = "ICON-ThreadFromSummary";
+const WRAP: &str = "ICON-TextWrap";
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn key(bounds: Bounds<Pixels>) -> (i32, i32) {
+    (
+        f32::from(bounds.origin.x).round() as i32,
+        f32::from(bounds.origin.y).round() as i32,
+    )
+}
+
+pub(super) struct Sweep {
+    pub actions: Vec<Bounds<Pixels>>,
+    pub wraps: usize,
+}
+
+/// Hovers a grid over the window; returns each distinct action bounds and how many
+/// distinct code-block button rows were revealed (one Wrap button per block). Asserts
+/// R1.5's invariant on every frame: the action is painted only in a revealed row -- it
+/// follows the row's hover visibility, never shows on its own.
+pub(super) fn sweep(cx: &mut VisualTestContext) -> Sweep {
+    cx.simulate_mouse_move(Point::new(px(1.), px(1.)), None, Modifiers::none());
+    draw(cx);
+    assert!(
+        cx.debug_bounds(ACTION).is_none(),
+        "precondition: {ACTION} must not be painted with the mouse away (icon collision?)"
+    );
+    let mut seen_actions = BTreeSet::new();
+    let mut actions = Vec::new();
+    let mut wraps = BTreeSet::new();
+    for x in (60..1200).step_by(120) {
+        for y in (4..800).step_by(10) {
+            cx.simulate_mouse_move(
+                Point::new(px(x as f32), px(y as f32)),
+                None,
+                Modifiers::none(),
+            );
+            draw(cx);
+            let wrap = cx.debug_bounds(WRAP);
+            if let Some(wrap) = wrap {
+                wraps.insert(key(wrap));
+            }
+            if let Some(action) = cx.debug_bounds(ACTION) {
+                assert!(
+                    wrap.is_some(),
+                    "R1.5: the action is visible only with its code block's button row (at {x},{y})"
+                );
+                if seen_actions.insert(key(action)) {
+                    actions.push(action);
+                }
+            }
+        }
+    }
+    Sweep {
+        actions,
+        wraps: wraps.len(),
+    }
+}
+
+/// Clicks `bounds` (hovering first, so the row is revealed) and lets the panel settle.
+pub(super) fn click(bounds: Bounds<Pixels>, cx: &mut VisualTestContext) {
+    cx.simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    draw(cx);
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    settle(cx);
+}
+
+#[gpui::test]
+async fn test_slash_command_button_only_on_the_single_slash_line_block(cx: &mut TestAppContext) {
+    let (panel, _workspace, mut cx) = setup_panel_in_workspace(cx).await;
+    let reply = concat!(
+        "Two options:\n\n",
+        "```\n/epic:epic stories run 014\n/epic:epic stories run 015\n```\n\n", // R1.2
+        "A shell line:\n\n",
+        "```sh\necho /epic:epic stories run 014\n```\n\n", // R1.3
+        "Next step:\n\n",
+        "```\n  /epic:epic stories run 014  \n```\n", // R1.1 -- the control
+    );
+    let source = open_source_thread(&panel, "what next?", vec![agent_says(reply)], &mut cx);
+    draw(&mut cx);
+
+    let sweep = sweep(&mut cx);
+    assert!(
+        sweep.wraps >= 3,
+        "precondition: all three code blocks were hovered (saw {} button rows)",
+        sweep.wraps
+    );
+    assert_eq!(
+        sweep.actions.len(),
+        1,
+        "R1.1-R1.3: exactly one block -- the single slash line -- carries the button"
+    );
+
+    let source_agent = active_agent_id(&panel, &cx);
+    click(sweep.actions[0], &mut cx);
+    assert_prefilled_new_thread(&panel, &source, &source_agent, COMMAND, &mut cx);
+}
+
+#[gpui::test]
+async fn test_slash_command_button_not_on_a_thinking_block(cx: &mut TestAppContext) {
