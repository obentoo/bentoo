+#[gpui::test]
+fn test_code_block_action_hidden_when_copy_is_hidden(cx: &mut TestAppContext) {
+    // Hostile half: the hook says Some, but the caller hid Copy -- the action follows it.
+    let (hook, _recorder) = recording_hook(IconName::ThreadFromSummary, |_| true);
+    let (control, control_recorder) = recording_hook(IconName::Plus, |_| true);
+    let cx = open_view(
+        vec![
+            ("```\n/help\n```\n", Some(hook)),
+            ("```\n/compact\n```\n", Some(control)),
+        ],
+        CopyButtonVisibility::Hidden,
+        cx,
+    );
+    assert!(
+        cx.debug_bounds(COPY).is_none(),
+        "precondition: Copy is hidden"
+    );
+    assert!(
+        hover_until_painted(ACTION, cx).is_none(),
+        "no action button anywhere while Copy is hidden"
+    );
+    assert!(cx.debug_bounds(OTHER_ACTION).is_none());
+    // The hook may or may not be consulted, but nothing it returns may become a click.
+    assert!(control_recorder.clicked.borrow().is_empty());
+}
