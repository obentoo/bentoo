+#[gpui::test]
+fn test_code_block_action_follows_copy_on_hover(cx: &mut TestAppContext) {
+    let (hook, recorder) = recording_hook(IconName::ThreadFromSummary, |_| true);
+    let cx = open_view(
+        vec![("```\n/help\n```\n", Some(hook))],
+        CopyButtonVisibility::VisibleOnHover,
+        cx,
+    );
+
+    // Mouse away from the block: neither Copy nor the action is painted.
+    assert!(cx.debug_bounds(COPY).is_none(), "Copy waits for hover");
+    assert!(
+        cx.debug_bounds(ACTION).is_none(),
+        "the action waits for hover, like Copy"
+    );
+
+    // Hover the block: Copy appears, and the action appears in the same frame.
+    let copy = hover_until_painted(COPY, cx).expect("hovering the block reveals Copy");
+    let action = cx
+        .debug_bounds(ACTION)
+        .expect("the action is revealed together with Copy");
+    assert!(
+        action.origin.x < copy.origin.x,
+        "the action sits before Copy in the button row: action {action:?}, copy {copy:?}"
+    );
+
+    cx.simulate_click(action.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert_eq!(
+        recorder.clicked.borrow().len(),
+        1,
+        "the revealed action is clickable"
+    );
+}
