+//! The `en-XA` transform. Fluent calls it on every text fragment of a
+//! pattern and never on a placeable, so `{ $count }` and other variables come
+//! through untouched — which is what keeps a pseudo-localized message
+//! readable enough to check a layout with.
+
+use std::borrow::Cow;
+
+/// Accent every ASCII letter and pad the fragment by about a third, inside
+/// brackets: `Hide the Host` becomes `[Ĥîðé ţĥé Ĥöšţ ~~~~]`. The brackets show
+/// where a message starts and ends, so a clipped one is visible as a missing
+/// `]`; the padding stands for the longer languages (German, Portuguese)
+/// running about 30% past English.
+pub fn transform(text: &str) -> Cow<'_, str> {
+    if text.trim().is_empty() {
+        return Cow::Borrowed(text);
+    }
+    let accented: String = text.chars().map(accent).collect();
+    let letters = text.chars().filter(char::is_ascii_alphabetic).count();
+    let padding = "~".repeat(letters.div_ceil(3));
+    if padding.is_empty() {
+        Cow::Owned(format!("[{accented}]"))
+    } else {
+        Cow::Owned(format!("[{accented} {padding}]"))
+    }
+}
+
+fn accent(c: char) -> char {
+    match c {
+        'a' => 'à',
+        'b' => 'ƀ',
+        'c' => 'ç',
+        'd' => 'ð',
+        'e' => 'é',
+        'f' => 'ƒ',
+        'g' => 'ĝ',
+        'h' => 'ĥ',
+        'i' => 'î',
+        'j' => 'ĵ',
+        'k' => 'ķ',
+        'l' => 'ļ',
+        'm' => 'ɱ',
+        'n' => 'ñ',
+        'o' => 'ö',
+        'p' => 'þ',
+        'q' => 'ǫ',
+        'r' => 'ŕ',
+        's' => 'š',
+        't' => 'ţ',
+        'u' => 'û',
+        'v' => 'ṽ',
+        'w' => 'ŵ',
+        'x' => 'ẋ',
+        'y' => 'ý',
+        'z' => 'ž',
+        'A' => 'À',
+        'B' => 'Ɓ',
+        'C' => 'Ç',
+        'D' => 'Ð',
+        'E' => 'É',
+        'F' => 'Ƒ',
+        'G' => 'Ĝ',
+        'H' => 'Ĥ',
+        'I' => 'Î',
+        'J' => 'Ĵ',
+        'K' => 'Ķ',
+        'L' => 'Ļ',
+        'M' => 'Ṁ',
+        'N' => 'Ñ',
+        'O' => 'Ö',
+        'P' => 'Þ',
+        'Q' => 'Ǫ',
+        'R' => 'Ŕ',
+        'S' => 'Š',
+        'T' => 'Ţ',
+        'U' => 'Û',
+        'V' => 'Ṽ',
+        'W' => 'Ŵ',
+        'X' => 'Ẋ',
+        'Y' => 'Ý',
+        'Z' => 'Ž',
+        other => other,
+    }
+}
diff --git a/crates/zeo_i18n/src/zeo_i18n.rs b/crates/zeo_i18n/src/zeo_i18n.rs
