index 0000000..6e47a52
--- /dev/null
+++ b/crates/zeo_i18n/src/zeo_i18n.rs
@@ -0,0 +1,146 @@
+//! Zeo's UI translations (docs/I18N-PROPOSAL.md in zeo-workspace).
+//!
+//! Text is looked up by a stable id with [`t!`], formatted by Fluent from
+//! `locales/<language>/*.ftl`, in the language the `ui_language` setting
+//! names — or the system's when it names none. The design follows upstream's
+//! RFC (zed-industries/zed discussion #43592: Fluent, one macro taking a
+//! message id), so the ids and `.ftl` files can move onto Zed's own system if
+//! it lands.
+//!
+//! The catalog is a process global rather than a GPUI global so `t!` needs no
+//! `cx`: a render function can call it wherever it builds a label. Changing
+//! the language rebuilds the catalog and refreshes every window, and the next
+//! frame reads the new one.
+
+mod catalog;
+mod pseudo;
+
+use std::collections::HashSet;
+use std::sync::{LazyLock, Mutex, PoisonError, RwLock};
+
+use gpui::App;
+use settings::{RegisterSetting, Settings, SettingsContent, SettingsStore};
+
+pub use catalog::{Catalog, FALLBACK_LANGUAGE, LocaleSource, PSEUDO_LANGUAGE, SHIPPED};
+pub use fluent_bundle::{FluentArgs, FluentValue};
+
+/// English until [`init`] runs: only `main` applies the setting or the system's
+/// languages, so a test -- which never calls `init` -- reads the same English on
+/// a desktop set to Portuguese as on a CI runner with no locale at all.
+static CATALOG: LazyLock<RwLock<Catalog>> =
+    LazyLock::new(|| RwLock::new(Catalog::new(&[], SHIPPED)));
+
+/// Ids already reported missing: `t!` runs on every frame, so an unknown id
+/// is logged once, not sixty times a second.
+static REPORTED_MISSING: LazyLock<Mutex<HashSet<String>>> =
+    LazyLock::new(|| Mutex::new(HashSet::new()));
+
+/// Translate `id` — a message, or `message.attribute` — with optional
+/// variables:
+///
+/// ```ignore
+/// Label::new(t!("agent-sandbox-hide-host"))
+/// Tooltip::text(t!("agent-sandbox-hide-host.tooltip"))
+/// Label::new(t!("agent-sandbox-jails-running", count = jails.len()))
+/// ```
+///
+/// Variable names are Rust identifiers, so they are written in snake_case in
+/// the `.ftl` too (`{ $folder_name }`). An id missing from every language
+/// renders as the id itself and is logged once; `scripts/i18n-check.py` in
+/// zed-patches catches it before that can ship.
+#[macro_export]
+macro_rules! t {
+    ($id:literal $(,)?) => {
+        $crate::translate($id, None)
+    };
+    ($id:literal, $($name:ident = $value:expr),+ $(,)?) => {{
+        let mut args = $crate::FluentArgs::new();
+        $( args.set(stringify!($name), $value); )+
+        $crate::translate($id, Some(&args))
+    }};
+}
+
+/// What [`t!`] expands to.
+pub fn translate(id: &str, args: Option<&FluentArgs>) -> String {
+    let catalog = CATALOG.read().unwrap_or_else(PoisonError::into_inner);
+    if let Some(text) = catalog.format(id, args) {
+        return text;
+    }
+    let mut reported = REPORTED_MISSING
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner);
+    if reported.insert(id.to_string()) {
+        log::warn!(
+            "zeo_i18n: missing message id={id} language={}",
+            catalog.language()
+        );
+    }
+    id.to_string()
+}
+
+/// Switch languages. `None`, an empty string or `"system"` follow the
+/// system's languages; anything else is a BCP 47 tag (`pt-BR`, or `en-XA` for
+/// the pseudo-locale). Returns the language now answering first.
+pub fn set_language(preference: Option<&str>) -> String {
+    let requested = match preference.map(str::trim) {
+        None | Some("") => system_languages(),
+        Some(tag) if tag.eq_ignore_ascii_case("system") => system_languages(),
+        Some(tag) => vec![tag.to_string()],
+    };
+    let catalog = Catalog::new(&requested, SHIPPED);
+    let language = catalog.language().to_string();
+    *CATALOG.write().unwrap_or_else(PoisonError::into_inner) = catalog;
+    language
+}
+
+/// The language answering first right now.
+pub fn current_language() -> String {
+    CATALOG
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .language()
+        .to_string()
+}
+
+fn system_languages() -> Vec<String> {
+    sys_locale::get_locales().collect()
+}
+
+/// The `ui_language` setting.
+#[derive(Debug, Clone, PartialEq, Eq, RegisterSetting)]
+pub struct UiLanguageSettings {
+    pub ui_language: Option<String>,
+}
+
+impl Settings for UiLanguageSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        Self {
+            ui_language: content.ui_language.clone(),
+        }
+    }
+}
+
+/// Apply `ui_language` now and on every settings change, refreshing the
+/// windows when the language actually changed. Called from `main` before the
+/// first window opens.
+pub fn init(cx: &mut App) {
+    UiLanguageSettings::register(cx);
+    let mut applied = UiLanguageSettings::get_global(cx).ui_language.clone();
+    let language = set_language(applied.as_deref());
+    log::info!("zeo_i18n: language={language} setting={applied:?}");
+
+    cx.observe_global::<SettingsStore>(move |cx| {
+        let wanted = UiLanguageSettings::get_global(cx).ui_language.clone();
+        if wanted == applied {
+            return;
+        }
+        let language = set_language(wanted.as_deref());
+        log::info!("zeo_i18n: language={language} setting={wanted:?}");
+        applied = wanted;
+        cx.refresh_windows();
+    })
+    .detach();
+}
+
+#[cfg(test)]
+mod catalog_tests;
