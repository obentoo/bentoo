diff --git a/crates/zeo_i18n/src/catalog.rs b/crates/zeo_i18n/src/catalog.rs
new file mode 100644
index 0000000..a4c12e3
--- /dev/null
+++ b/crates/zeo_i18n/src/catalog.rs
@@ -0,0 +1,179 @@
+//! The loaded translations: one Fluent bundle per language in the negotiated
+//! chain, always ending in `en-US`, so a message missing from a translation
+//! falls back to English instead of disappearing.
+
+use std::borrow::Cow;
+
+use fluent_bundle::{FluentArgs, FluentResource, concurrent::FluentBundle};
+use fluent_langneg::{NegotiationStrategy, negotiate_languages};
+use unic_langid::LanguageIdentifier;
+
+use crate::pseudo;
+
+/// The language every chain ends in, and the one the ids are written against.
+pub const FALLBACK_LANGUAGE: &str = "en-US";
+
+/// The pseudo-locale: `en-US` with every letter accented and every message
+/// lengthened, so a string left out of the catalog stands out (it stays plain
+/// English) and a layout that clips a longer translation shows it. Chosen only
+/// by name through `ui_language`, never by negotiation, so a system set to some
+/// other English can never land on it.
+pub const PSEUDO_LANGUAGE: &str = "en-XA";
+
+/// One language's `.ftl` files, embedded at build time.
+pub struct LocaleSource {
+    pub language: &'static str,
+    pub files: &'static [(&'static str, &'static str)],
+}
+
+/// What ships. A new `.ftl` file is a new line here: `include_str!` keeps the
+/// files inside the binary, so no path is resolved at run time and a missing
+/// file fails the build rather than a launch. `scripts/i18n-check.py` in
+/// zed-patches reads the same directory and fails when a file it finds is not
+/// listed here.
+pub static SHIPPED: &[LocaleSource] = &[
+    LocaleSource {
+        language: "en-US",
+        files: &[("en-US/zeo.ftl", include_str!("../locales/en-US/zeo.ftl"))],
+    },
+    LocaleSource {
+        language: "pt-BR",
+        files: &[("pt-BR/zeo.ftl", include_str!("../locales/pt-BR/zeo.ftl"))],
+    },
+];
+
+pub struct Catalog {
+    /// The languages actually in use, best first; the last is always `en-US`.
+    chain: Vec<String>,
+    bundles: Vec<FluentBundle<FluentResource>>,
+}
+
+impl Catalog {
+    /// Build the chain for `requested` (best first, BCP 47 tags) from `sources`.
+    /// A tag that does not parse is skipped, so a POSIX `C` locale simply
+    /// yields English.
+    pub fn new(requested: &[String], sources: &[LocaleSource]) -> Self {
+        if requested
+            .first()
+            .is_some_and(|tag| tag.eq_ignore_ascii_case(PSEUDO_LANGUAGE))
+        {
+            return Self::pseudo(sources);
+        }
+
+        let requested: Vec<LanguageIdentifier> = requested
+            .iter()
+            .filter_map(|tag| tag.parse().ok())
+            .collect();
+        let available: Vec<LanguageIdentifier> = sources
+            .iter()
+            .filter_map(|source| source.language.parse().ok())
+            .collect();
+        let fallback: LanguageIdentifier = FALLBACK_LANGUAGE
+            .parse()
+            .unwrap_or_else(|_| LanguageIdentifier::default());
+
+        let negotiated = negotiate_languages(
+            &requested,
+            &available,
+            Some(&fallback),
+            NegotiationStrategy::Filtering,
+        );
+
+        let mut chain: Vec<String> = negotiated.iter().map(|id| id.to_string()).collect();
+        // negotiate_languages appends the default only when it is not already
+        // there, so this holds today; it is the invariant `format` relies on.
+        if chain.last().map(String::as_str) != Some(FALLBACK_LANGUAGE) {
+            chain.retain(|language| language != FALLBACK_LANGUAGE);
+            chain.push(FALLBACK_LANGUAGE.to_string());
+        }
+
+        let bundles = chain
+            .iter()
+            .filter_map(|language| {
+                let source = sources.iter().find(|s| s.language == language)?;
+                Some(build_bundle(source, language, None))
+            })
+            .collect();
+        Self { chain, bundles }
+    }
+
+    fn pseudo(sources: &[LocaleSource]) -> Self {
+        let bundles = sources
+            .iter()
+            .find(|source| source.language == FALLBACK_LANGUAGE)
+            .map(|source| build_bundle(source, PSEUDO_LANGUAGE, Some(pseudo::transform)))
+            .into_iter()
+            .collect();
+        Self {
+            chain: vec![PSEUDO_LANGUAGE.to_string()],
+            bundles,
+        }
+    }
+
+    /// The language the catalog answers in first.
+    pub fn language(&self) -> &str {
+        self.chain
+            .first()
+            .map(String::as_str)
+            .unwrap_or(FALLBACK_LANGUAGE)
+    }
+
+    /// Format `id` — a message, or `message.attribute` — from the first bundle
+    /// in the chain that has it. `None` when no bundle does.
+    pub fn format(&self, id: &str, args: Option<&FluentArgs>) -> Option<String> {
+        let (message_id, attribute) = match id.split_once('.') {
+            Some((message, attribute)) => (message, Some(attribute)),
+            None => (id, None),
+        };
+        self.bundles.iter().find_map(|bundle| {
+            let message = bundle.get_message(message_id)?;
+            let pattern = match attribute {
+                Some(attribute) => message.get_attribute(attribute)?.value(),
+                None => message.value()?,
+            };
+            let mut errors = Vec::new();
+            let text = bundle.format_pattern(pattern, args, &mut errors);
+            if !errors.is_empty() {
+                log::warn!(
+                    "zeo_i18n: format errors id={id} language={} errors={errors:?}",
+                    bundle
+                        .locales
+                        .first()
+                        .map(|l| l.to_string())
+                        .unwrap_or_default()
+                );
+            }
+            Some(text.into_owned())
+        })
+    }
+}
+
+fn build_bundle(
+    source: &LocaleSource,
+    language: &str,
+    transform: Option<fn(&str) -> Cow<'_, str>>,
+) -> FluentBundle<FluentResource> {
+    let id: LanguageIdentifier = language
+        .parse()
+        .unwrap_or_else(|_| LanguageIdentifier::default());
+    let mut bundle = FluentBundle::new_concurrent(vec![id]);
+    // Fluent wraps every placeable in Unicode isolation marks (FSI/PDI) by
+    // default, for right-to-left text. GPUI draws them as visible boxes in
+    // some fonts, and no language Zeo ships is right-to-left yet; revisit with
+    // the first one that is.
+    bundle.set_use_isolating(false);
+    bundle.set_transform(transform);
+    for (path, text) in source.files {
+        let resource = match FluentResource::try_new((*text).to_string()) {
+            Ok(resource) => resource,
+            Err((resource, errors)) => {
+                log::error!("zeo_i18n: parse errors file={path} errors={errors:?}");
+                resource
+            }
+        };
+        if let Err(errors) = bundle.add_resource(resource) {
+            log::error!("zeo_i18n: duplicate ids file={path} errors={errors:?}");
+        }
+    }
+    bundle
+}
