+
+const EN: &str = "\
+greeting = Hello
+only-english = Only in English
+jails = { $count ->
+    [one] One jail
+   *[other] { $count } jails
+}
+hide-host = Hide the Host
+    .tooltip = The agent sees a made-up host
+";
+
+const PT: &str = "\
+greeting = Olá
+jails = { $count ->
+    [one] Uma jail
+   *[other] { $count } jails
+}
+hide-host = Ocultar o host
+    .tooltip = O agente vê um host inventado
+";
+
+static TEST_SOURCES: &[LocaleSource] = &[
+    LocaleSource {
+        language: "en-US",
+        files: &[("en-US/test.ftl", EN)],
+    },
+    LocaleSource {
+        language: "pt-BR",
+        files: &[("pt-BR/test.ftl", PT)],
+    },
+];
+
+fn catalog(requested: &[&str]) -> Catalog {
+    let requested: Vec<String> = requested.iter().map(|s| s.to_string()).collect();
+    Catalog::new(&requested, TEST_SOURCES)
+}
+
+fn count(n: i64) -> FluentArgs<'static> {
+    let mut args = FluentArgs::new();
+    args.set("count", n);
+    args
+}
+
+#[test]
+fn a_requested_language_answers_first() {
+    let pt = catalog(&["pt-BR"]);
+    assert_eq!(pt.language(), "pt-BR");
+    assert_eq!(pt.format("greeting", None).as_deref(), Some("Olá"));
+}
+
+#[test]
+fn a_message_missing_from_a_translation_falls_back_to_english() {
+    let pt = catalog(&["pt-BR"]);
+    assert_eq!(
+        pt.format("only-english", None).as_deref(),
+        Some("Only in English")
+    );
+}
+
+#[test]
+fn an_id_missing_everywhere_is_none() {
+    assert_eq!(catalog(&["pt-BR"]).format("no-such-id", None), None);
+    assert_eq!(
+        catalog(&["pt-BR"]).format("hide-host.no-such-attr", None),
+        None
+    );
+}
+
+#[test]
+fn another_region_of_a_shipped_language_gets_it() {
+    assert_eq!(catalog(&["pt-PT"]).language(), "pt-BR");
+}
+
+#[test]
+fn an_unshipped_or_unparsable_language_gets_english() {
+    assert_eq!(catalog(&["ja-JP"]).language(), FALLBACK_LANGUAGE);
+    assert_eq!(catalog(&["C"]).language(), FALLBACK_LANGUAGE);
+    assert_eq!(catalog(&[]).language(), FALLBACK_LANGUAGE);
+}
+
+#[test]
+fn another_english_never_lands_on_the_pseudo_locale() {
+    assert_eq!(catalog(&["en-GB"]).language(), FALLBACK_LANGUAGE);
+    assert_eq!(
+        catalog(&["en-GB"]).format("greeting", None).as_deref(),
+        Some("Hello")
+    );
+}
+
+#[test]
+fn plurals_follow_the_language() {
+    let en = catalog(&["en-US"]);
+    assert_eq!(
+        en.format("jails", Some(&count(1))).as_deref(),
+        Some("One jail")
+    );
+    assert_eq!(
+        en.format("jails", Some(&count(3))).as_deref(),
+        Some("3 jails")
+    );
+    let pt = catalog(&["pt-BR"]);
+    assert_eq!(
+        pt.format("jails", Some(&count(1))).as_deref(),
+        Some("Uma jail")
+    );
+    assert_eq!(
+        pt.format("jails", Some(&count(2))).as_deref(),
+        Some("2 jails")
+    );
+}
+
+#[test]
+fn attributes_are_addressed_with_a_dot() {
+    let pt = catalog(&["pt-BR"]);
+    assert_eq!(
+        pt.format("hide-host", None).as_deref(),
+        Some("Ocultar o host")
+    );
+    assert_eq!(
+        pt.format("hide-host.tooltip", None).as_deref(),
+        Some("O agente vê um host inventado")
+    );
+}
+
+#[test]
+fn variables_carry_no_isolation_marks() {
+    let text = catalog(&["en-US"])
+        .format("jails", Some(&count(3)))
+        .unwrap_or_default();
+    assert!(
+        !text.contains('\u{2068}') && !text.contains('\u{2069}'),
+        "{text:?}"
+    );
+}
+
+#[test]
+fn the_pseudo_locale_accents_and_pads_text_but_not_variables() {
+    let xa = catalog(&[PSEUDO_LANGUAGE]);
+    assert_eq!(xa.language(), PSEUDO_LANGUAGE);
+    assert_eq!(xa.format("greeting", None).as_deref(), Some("[Ĥéļļö ~~]"));
+    let jails = xa.format("jails", Some(&count(3))).unwrap_or_default();
+    assert!(jails.starts_with('3'), "{jails:?}");
+    assert!(jails.contains("ĵàîļš"), "{jails:?}");
+}
+
+#[test]
+fn the_shipped_files_parse_and_cover_the_fallback() {
+    assert!(SHIPPED.iter().any(|s| s.language == FALLBACK_LANGUAGE));
+    for source in SHIPPED {
+        for (path, text) in source.files {
+            if let Err((_, errors)) = fluent_bundle::FluentResource::try_new(text.to_string()) {
+                panic!("{path}: {errors:?}");
+            }
+        }
+    }
+}
+
+#[test]
+fn the_global_catalog_answers_in_english_until_init() {
+    // set_language is never called by a test; if one did, this would race it.
+    assert_eq!(crate::current_language(), FALLBACK_LANGUAGE);
+}
+
+#[test]
+fn the_macro_formats_through_the_global_catalog() {
+    // The shipped catalog may hold no message yet; an unknown id comes back
+    // as itself, with or without variables.
+    assert_eq!(
+        crate::t!("zeo-i18n-test-unknown-id"),
+        "zeo-i18n-test-unknown-id"
+    );
+    assert_eq!(
+        crate::t!("zeo-i18n-test-unknown-id", count = 2, name = "x"),
+        "zeo-i18n-test-unknown-id"
+    );
+}
