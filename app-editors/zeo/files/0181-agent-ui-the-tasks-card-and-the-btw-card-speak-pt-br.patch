+agent-tasks-card-usage = { $tokens } tokens · { $tool_uses } tool uses
+agent-tasks-card-no-usage = No usage reported yet
+agent-tasks-card-last-tool = Last tool: { $tool }
+agent-tasks-card-activity = { $tool_uses ->
+    [one] { $tool } · { $tool_uses } tool
+   *[other] { $tool } · { $tool_uses } tools
+}
+agent-tasks-card-starting = starting
+agent-tasks-card-status = { $status ->
+    [running] Running
+    [completed] Completed
+    [failed] Failed
+    [stopped] Stopped
+   *[interrupted] Interrupted
+}
+agent-tasks-card-sub-thread = Sub-thread
+agent-tasks-card-sub-thread-open = Open Sub-thread
+    .aria = Open sub-thread: { $title }
+agent-tasks-card-sub-thread-running = Running · { $elapsed }
+agent-tasks-card-sub-thread-idle = Idle
+
+## The /btw side-question card
+
