diff --git a/crates/agent_sandbox/src/jail_secrets.rs b/crates/agent_sandbox/src/jail_secrets.rs
new file mode 100644
index 0000000..8d4b3a9
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_secrets.rs
@@ -0,0 +1,185 @@
+//! Vault secrets handed to a jail (Zeo §6.53 step 3).
+//!
+//! A project chooses secrets from Zeo's vault by `secret://` reference; each one declares, on the
+//! Secrets page (`0206`), the variable the agent reads and the hosts the credential is for. At
+//! start the jail gets the variable through `--env NAME`, with the real value only in ai-jail's
+//! own environment (never on its command line), and `--secret NAME=host,host`, which makes
+//! ai-jail hand the jail a placeholder and put the real value only into requests to those hosts,
+//! HTTPS included. Those hosts join the jail's allowlist: the credential is useless without them.
+//!
+//! A chosen secret that cannot be handed over refuses the start (fail closed): an agent that
+//! expects a credential and runs without it fails later and less clearly, and handing over the
+//! wrong one is worse than none.
+
+use std::collections::{BTreeMap, HashMap};
+
+use secret_vault::{JailUse, SecretRef, VaultEntry};
+use zeroize::Zeroizing;
+
+/// What ai-jail's `--help` shows for a `--secret` that takes several hosts and injects into
+/// HTTPS (ai-jail 3.7.1-r1). The single-host `--secret` before it reaches plain HTTP alone.
+pub const SECRET_HOSTS_SYNTAX: &str = "KEY=host[,host";
+
+/// Names the jail's environment already uses: a secret named like one would replace it.
+const RESERVED_NAMES: [&str; 5] = ["HOME", "PATH", "LANG", "XDG_RUNTIME_DIR", "ZEO_NO_PROXY"];
+
+/// One secret a jail receives.
+pub struct JailSecret {
+    pub env_name: String,
+    /// Sorted, lowercase, as the vault stores them.
+    pub hosts: Vec<String>,
+    pub value: Zeroizing<String>,
+}
+
+impl std::fmt::Debug for JailSecret {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("JailSecret")
+            .field("env_name", &self.env_name)
+            .field("hosts", &self.hosts)
+            .field("value", &"[redacted]")
+            .finish()
+    }
+}
+
+/// Why a chosen secret cannot reach the jail. Never carries a value.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SecretProblem {
+    /// The setting holds something that is not a `secret://SERVICE/ACCOUNT` reference.
+    Invalid,
+    /// No item in the vault answers the reference.
+    Missing,
+    /// The item declares no variable and hosts, so the jail would not know where it goes.
+    NoJailUse,
+    /// The item could not be read.
+    Unreadable,
+    /// The vault could not be opened or listed (a locked keyring, most often).
+    VaultUnreadable,
+    /// Two chosen secrets declare the same variable.
+    DuplicateName,
+    /// The variable is one the jail's environment already sets.
+    ReservedName,
+    /// The variable is also one the agent's own settings forward into the jail.
+    ConfiguredName,
+}
+
+impl SecretProblem {
+    /// The `$reason` selector of `agent-jail-launch-secret-unavailable`.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Invalid => "invalid",
+            Self::Missing => "missing",
+            Self::NoJailUse => "no-jail-use",
+            Self::Unreadable => "unreadable",
+            Self::VaultUnreadable => "vault-unreadable",
+            Self::DuplicateName => "duplicate",
+            Self::ReservedName => "reserved",
+            Self::ConfiguredName => "configured",
+        }
+    }
+}
+
+/// The chosen references matched against the vault's listing, before any value is read: each
+/// reference with its jail use, in the chosen order, repeats dropped. `forwarded` holds the
+/// variables the agent's settings already forward.
+pub fn match_chosen(
+    chosen: &[String],
+    entries: &[VaultEntry],
+    forwarded: &[String],
+) -> Result<Vec<(SecretRef, JailUse)>, (String, SecretProblem)> {
+    let by_uri: HashMap<String, &VaultEntry> = entries
+        .iter()
+        .map(|entry| (entry.reference.uri(), entry))
+        .collect();
+    let mut seen_uris = Vec::new();
+    let mut names = BTreeMap::new();
+    let mut out = Vec::new();
+    for raw in chosen {
+        let reference = SecretRef::parse(raw).map_err(|_| (raw.clone(), SecretProblem::Invalid))?;
+        let uri = reference.uri();
+        if seen_uris.contains(&uri) {
+            continue;
+        }
+        let entry = by_uri
+            .get(&uri)
+            .ok_or_else(|| (uri.clone(), SecretProblem::Missing))?;
+        let jail_use = entry
+            .jail_use
+            .clone()
+            .ok_or_else(|| (uri.clone(), SecretProblem::NoJailUse))?;
+        if RESERVED_NAMES.contains(&jail_use.env_name.as_str()) {
+            return Err((uri, SecretProblem::ReservedName));
+        }
+        if forwarded.contains(&jail_use.env_name) {
+            return Err((uri, SecretProblem::ConfiguredName));
+        }
+        if names.insert(jail_use.env_name.clone(), ()).is_some() {
+            return Err((uri, SecretProblem::DuplicateName));
+        }
+        seen_uris.push(uri);
+        out.push((reference, jail_use));
+    }
+    Ok(out)
+}
+
+/// Lists the vault once and reads each chosen secret. Empty `chosen` touches nothing.
+pub async fn resolve(
+    chosen: &[String],
+    forwarded: &[String],
+) -> Result<Vec<JailSecret>, (String, SecretProblem)> {
+    if chosen.is_empty() {
+        return Ok(Vec::new());
+    }
+    let entries = secret_vault::list().await.map_err(|error| {
+        log::warn!(
+            "agent_sandbox event=secret_vault_list_failed error={:?}",
+            error.to_string()
+        );
+        (String::new(), SecretProblem::VaultUnreadable)
+    })?;
+    let matched = match_chosen(chosen, &entries, forwarded)?;
+    let mut secrets = Vec::with_capacity(matched.len());
+    for (reference, jail_use) in matched {
+        let value = secret_vault::read(&reference).await.map_err(|error| {
+            // The error names the reference and the cause, never the value.
+            log::warn!(
+                "agent_sandbox event=secret_read_failed reference={} error={:?}",
+                reference.uri(),
+                error.to_string()
+            );
+            (reference.uri(), SecretProblem::Unreadable)
+        })?;
+        secrets.push(JailSecret {
+            env_name: jail_use.env_name,
+            hosts: jail_use.hosts,
+            value,
+        });
+    }
+    Ok(secrets)
+}
+
+/// `--secret NAME=host,host` for each secret, sorted by name.
+pub fn secret_args(secrets: &[JailSecret]) -> Vec<String> {
+    let mut sorted: Vec<&JailSecret> = secrets.iter().collect();
+    sorted.sort_by(|a, b| a.env_name.cmp(&b.env_name));
+    sorted
+        .into_iter()
+        .flat_map(|secret| {
+            [
+                "--secret".to_string(),
+                format!("{}={}", secret.env_name, secret.hosts.join(",")),
+            ]
+        })
+        .collect()
+}
+
+/// Adds each secret's hosts to `allow_hosts` once, after the configured ones.
+pub fn allow_secret_hosts(secrets: &[JailSecret], allow_hosts: &mut Vec<String>) {
+    for host in secrets.iter().flat_map(|secret| &secret.hosts) {
+        if !allow_hosts
+            .iter()
+            .any(|known| known.eq_ignore_ascii_case(host))
+        {
+            allow_hosts.push(host.clone());
+        }
+    }
+}
diff --git a/crates/agent_sandbox/src/jail_secrets_tests.rs b/crates/agent_sandbox/src/jail_secrets_tests.rs
new file mode 100644
index 0000000..42e8b06
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_secrets_tests.rs
@@ -0,0 +1,217 @@
+//! Zeo §6.53 step 3: the vault secrets a jail receives -- matching the chosen references against
+//! the vault, the ai-jail options they become, and the probe that says ai-jail can take them.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+
+use gpui::TestAppContext;
+use secret_vault::{JailUse, SecretRef, VaultEntry};
+use zeroize::Zeroizing;
+
+use crate::jail_secrets::{
+    JailSecret, SecretProblem, allow_secret_hosts, match_chosen, secret_args,
+};
+
+fn entry(service: &str, account: &str, jail_use: Option<(&str, &[&str])>) -> VaultEntry {
+    VaultEntry {
+        reference: SecretRef::new(service, account).expect("reference"),
+        tail: "…abcd".into(),
+        jail_use: jail_use.map(|(name, hosts)| JailUse::new(name, hosts).expect("jail use")),
+    }
+}
+
+fn vault() -> Vec<VaultEntry> {
+    vec![
+        entry(
+            "github",
+            "push",
+            Some(("GH_TOKEN", &["github.com", "api.github.com"])),
+        ),
+        entry(
+            "openai",
+            "key",
+            Some(("OPENAI_API_KEY", &["api.openai.com"])),
+        ),
+        entry("plain", "note", None),
+        entry("other", "gh", Some(("GH_TOKEN", &["gitlab.com"]))),
+    ]
+}
+
+fn chosen(list: &[&str]) -> Vec<String> {
+    list.iter().map(|uri| uri.to_string()).collect()
+}
+
+#[test]
+fn chosen_secrets_match_the_vault_in_order_and_once() {
+    let matched = match_chosen(
+        &chosen(&[
+            "secret://openai/key",
+            "secret://github/push",
+            "secret://openai/key",
+        ]),
+        &vault(),
+        &[],
+    )
+    .expect("match");
+    let names: Vec<&str> = matched.iter().map(|(_, u)| u.env_name.as_str()).collect();
+    assert_eq!(names, ["OPENAI_API_KEY", "GH_TOKEN"]);
+    assert_eq!(matched[1].1.hosts, ["api.github.com", "github.com"]);
+    assert!(match_chosen(&[], &vault(), &[]).expect("none").is_empty());
+}
+
+#[test]
+fn every_unusable_choice_names_its_reference_and_problem() {
+    let case = |list: &[&str], forwarded: &[&str]| {
+        let forwarded: Vec<String> = forwarded.iter().map(|n| n.to_string()).collect();
+        match_chosen(&chosen(list), &vault(), &forwarded).expect_err("refused")
+    };
+    assert_eq!(
+        case(&["github/push"], &[]),
+        ("github/push".into(), SecretProblem::Invalid)
+    );
+    assert_eq!(
+        case(&["secret://nope/none"], &[]),
+        ("secret://nope/none".into(), SecretProblem::Missing)
+    );
+    assert_eq!(
+        case(&["secret://plain/note"], &[]),
+        ("secret://plain/note".into(), SecretProblem::NoJailUse)
+    );
+    assert_eq!(
+        case(&["secret://github/push", "secret://other/gh"], &[]),
+        ("secret://other/gh".into(), SecretProblem::DuplicateName)
+    );
+    assert_eq!(
+        case(&["secret://openai/key"], &["OPENAI_API_KEY"]),
+        ("secret://openai/key".into(), SecretProblem::ConfiguredName)
+    );
+}
+
+#[test]
+fn a_secret_may_not_take_a_name_the_jail_sets() {
+    let vault = vec![entry("x", "home", Some(("HOME", &["example.com"])))];
+    assert_eq!(
+        match_chosen(&chosen(&["secret://x/home"]), &vault, &[]).expect_err("reserved"),
+        ("secret://x/home".into(), SecretProblem::ReservedName)
+    );
+}
+
+fn secret(name: &str, hosts: &[&str]) -> JailSecret {
+    JailSecret {
+        env_name: name.into(),
+        hosts: hosts.iter().map(|h| h.to_string()).collect(),
+        value: Zeroizing::new("real-value-never-on-argv".into()),
+    }
+}
+
+#[test]
+fn secrets_become_sorted_secret_options_and_allowed_hosts_without_their_values() {
+    let secrets = [
+        secret("OPENAI_API_KEY", &["api.openai.com"]),
+        secret("GH_TOKEN", &["api.github.com", "github.com"]),
+    ];
+    assert_eq!(
+        secret_args(&secrets),
+        [
+            "--secret",
+            "GH_TOKEN=api.github.com,github.com",
+            "--secret",
+            "OPENAI_API_KEY=api.openai.com",
+        ]
+    );
+    let mut hosts = vec!["GitHub.com".to_string(), "pypi.org".to_string()];
+    allow_secret_hosts(&secrets, &mut hosts);
+    assert_eq!(
+        hosts,
+        ["GitHub.com", "pypi.org", "api.openai.com", "api.github.com"]
+    );
+    let shown = format!("{:?}", secrets[0]);
+    assert!(!shown.contains("real-value"), "{shown}");
+}
+
+#[test]
+fn the_secret_options_sit_before_the_agent() {
+    use crate::command::{JailInputs, generate};
+    use project::agent_server_store::AgentServerCommand;
+
+    let args = secret_args(&[secret("GH_TOKEN", &["github.com"])]);
+    let inputs = JailInputs {
+        ai_jail: Path::new("/usr/bin/ai-jail"),
+        project_root: Path::new("/p"),
+        claude_dir: Path::new("/c"),
+        state_root: None,
+        limit_args: &[],
+        host_args: &[],
+        ro_maps: &[],
+        rw_maps: &[],
+        allow_hosts: &["github.com".into()],
+        forward_ports: &[],
+        env_names: vec!["GH_TOKEN".into()],
+        secret_args: &args,
+    };
+    let agent = AgentServerCommand {
+        path: PathBuf::from("/usr/bin/agent"),
+        args: vec!["--secret".into(), "agent-own".into()],
+        env: None,
+    };
+    let jailed = generate(agent, &inputs);
+    let separator = jailed.args.iter().position(|a| a == "--").expect("--");
+    let own = &jailed.args[..separator];
+    assert!(own.windows(2).any(|w| w == ["--env", "GH_TOKEN"]));
+    assert!(
+        own.windows(2)
+            .any(|w| w == ["--secret", "GH_TOKEN=github.com"])
+    );
+    assert!(
+        !jailed.args.iter().any(|a| a.contains("real-value")),
+        "a value never reaches argv"
+    );
+    // The agent's own arguments stay after `--`, untouched.
+    assert_eq!(jailed.args[separator + 2..], ["--secret", "agent-own"]);
+}
+
+fn fake_jail(dir: &Path, help: &str) -> PathBuf {
+    let path = dir.join("ai-jail");
+    let body = format!(
+        "#!/bin/sh\ncase \"$1\" in\n--version) echo 'ai-jail 3.7.1' ;;\n--help) printf '%s\\n' {help} ;;\nesac\n"
+    );
+    std::fs::write(&path, body).expect("write");
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+    path
+}
+
+#[gpui::test]
+async fn the_probe_tells_https_injection_from_the_plain_http_secret(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let new = fake_jail(
+        &tmp.path().join("new").tap_mkdir(),
+        "'Usage: ai-jail [OPTIONS]' '    --secret <KEY=host[,host...]>   Keep KEY out'",
+    );
+    let old = fake_jail(
+        &tmp.path().join("old").tap_mkdir(),
+        "'Usage: ai-jail [OPTIONS]' '    --secret <KEY=host>             Keep KEY out'",
+    );
+    let binary = crate::probe::probe(&new, &cx.executor())
+        .await
+        .expect("probe");
+    assert!(binary.supports_secrets);
+    let binary = crate::probe::probe(&old, &cx.executor())
+        .await
+        .expect("probe");
+    assert!(
+        !binary.supports_secrets,
+        "a single-host --secret is plain HTTP only"
+    );
+}
+
+trait TapMkdir {
+    fn tap_mkdir(self) -> Self;
+}
+
+impl TapMkdir for PathBuf {
+    fn tap_mkdir(self) -> Self {
+        std::fs::create_dir_all(&self).expect("mkdir");
+        self
+    }
+}
