+
+    const ZEO_PLUS_SYSTEM_BINARY: &str = "/usr/bin/claude-agent-acp-plus";
+    const ZEO_TUI_SYSTEM_BINARY: &str = "/usr/bin/claude-agent-acp-tui";
+    const ZEO_PLUS_NPM_SPEC: &str = "@lucascouts/claude-agent-acp-plus@latest";
+    const ZEO_TUI_NPM_SPEC: &str = "@lucascouts/claude-agent-tui@latest";
+
+    /// Runs the resolver with `answer` as the probe and returns every path the
+    /// probe was asked about, in order.
+    fn resolve_recording(
+        agent_id: &str,
+        answer: impl Fn(&Path) -> std::io::Result<bool>,
+    ) -> (ZeoLaunchSource, Vec<PathBuf>) {
+        let probed = std::cell::RefCell::new(Vec::new());
+        let source = zeo_agent_launch_source(agent_id, |path: &Path| {
+            probed.borrow_mut().push(path.to_path_buf());
+            answer(path)
+        });
+        (source, probed.into_inner())
+    }
+
+    /// Hostile (wrong collapse): ids that look like a Zeo default but are not
+    /// one -- including the TUI *binary* name used as an id -- never resolve to
+    /// a system path, even when every probed path exists and is executable.
+    #[test]
+    fn zeo_agent_launch_source_never_gives_a_system_path_to_another_id() {
+        for agent_id in [
+            "claude-agent-acp-tui",
+            "claude-acp",
+            "claude-agent",
+            "claude-agent-acp-plus-dev",
+            "CLAUDE-AGENT-ACP-PLUS",
+            "",
+        ] {
+            let (source, _) = resolve_recording(agent_id, |_| Ok(true));
+            assert!(
+                matches!(source, ZeoLaunchSource::Npm(_)),
+                "{agent_id:?} is not a Zeo default agent and must not launch a system binary, got {source:?}"
+            );
+        }
+    }
+
+    /// Hostile (wrong split): the TUI agent's id is `claude-agent-tui`, but its
+    /// binary is `claude-agent-acp-tui`. A binary named after the id must not
+    /// count, and the Plus agent must never pick up the TUI binary.
+    #[test]
+    fn zeo_agent_launch_source_probes_the_tui_binary_not_the_tui_id() {
+        fn only(wanted: &'static str) -> impl Fn(&Path) -> std::io::Result<bool> {
+            move |path: &Path| Ok(path == Path::new(wanted))
+        }
+
+        let (source, probed) =
+            resolve_recording(ZEO_TUI_AGENT_ID, only("/usr/bin/claude-agent-tui"));
+        assert_eq!(source, ZeoLaunchSource::Npm(ZEO_TUI_NPM_SPEC.to_string()));
+        assert_eq!(probed, vec![PathBuf::from(ZEO_TUI_SYSTEM_BINARY)]);
+
+        let (source, _) = resolve_recording(ZEO_PLUS_AGENT_ID, only(ZEO_TUI_SYSTEM_BINARY));
+        assert_eq!(source, ZeoLaunchSource::Npm(ZEO_PLUS_NPM_SPEC.to_string()));
+
+        let (source, _) = resolve_recording(ZEO_TUI_AGENT_ID, only(ZEO_PLUS_SYSTEM_BINARY));
+        assert_eq!(source, ZeoLaunchSource::Npm(ZEO_TUI_NPM_SPEC.to_string()));
+
+        let (source, _) = resolve_recording(ZEO_TUI_AGENT_ID, only(ZEO_TUI_SYSTEM_BINARY));
+        assert_eq!(
+            source,
+            ZeoLaunchSource::System(PathBuf::from(ZEO_TUI_SYSTEM_BINARY))
+        );
+    }
+
+    /// Q4: a probe error (permission denied, broken symlink) is never read as
+    /// "present" -- it falls back to the npm package.
+    #[test]
+    fn zeo_agent_launch_source_falls_back_to_npm_on_a_probe_error() {
+        for kind in [
+            std::io::ErrorKind::PermissionDenied,
+            std::io::ErrorKind::NotFound,
+            std::io::ErrorKind::Other,
+        ] {
+            for (agent_id, spec) in [
+                (ZEO_PLUS_AGENT_ID, ZEO_PLUS_NPM_SPEC),
+                (ZEO_TUI_AGENT_ID, ZEO_TUI_NPM_SPEC),
+            ] {
+                let (source, _) = resolve_recording(agent_id, |_| Err(std::io::Error::from(kind)));
+                assert_eq!(
+                    source,
+                    ZeoLaunchSource::Npm(spec.to_string()),
+                    "{agent_id} with a probe error {kind:?}"
+                );
+            }
+        }
+    }
+
+    /// R2.1: absent or not executable (`Ok(false)`) launches the package patch
+    /// 0033 ships, with its `@latest` spec, and the two specs stay distinct.
+    #[test]
+    fn zeo_agent_launch_source_falls_back_to_npm_when_the_binary_is_absent() {
+        let (plus, _) = resolve_recording(ZEO_PLUS_AGENT_ID, |_| Ok(false));
+        let (tui, _) = resolve_recording(ZEO_TUI_AGENT_ID, |_| Ok(false));
+        assert_eq!(plus, ZeoLaunchSource::Npm(ZEO_PLUS_NPM_SPEC.to_string()));
+        assert_eq!(tui, ZeoLaunchSource::Npm(ZEO_TUI_NPM_SPEC.to_string()));
+        assert_ne!(plus, tui);
+    }
+
+    /// R1.1, R1.2, R3.1 (benign): with the binary present each default agent
+    /// resolves to its own absolute `/usr/bin` path, under the ids 0033 ships.
+    #[test]
+    fn zeo_agent_launch_source_picks_the_system_binary_when_present() {
+        assert_eq!(ZEO_PLUS_AGENT_ID, "claude-agent-acp-plus");
+        assert_eq!(ZEO_TUI_AGENT_ID, "claude-agent-tui");
+
+        let (plus, probed) = resolve_recording(ZEO_PLUS_AGENT_ID, |_| Ok(true));
+        assert_eq!(
+            plus,
+            ZeoLaunchSource::System(PathBuf::from(ZEO_PLUS_SYSTEM_BINARY))
+        );
+        assert_eq!(probed, vec![PathBuf::from(ZEO_PLUS_SYSTEM_BINARY)]);
+
+        let (tui, _) = resolve_recording(ZEO_TUI_AGENT_ID, |_| Ok(true));
+        assert_eq!(
+            tui,
+            ZeoLaunchSource::System(PathBuf::from(ZEO_TUI_SYSTEM_BINARY))
+        );
+
+        for source in [&plus, &tui] {
+            let ZeoLaunchSource::System(path) = source else {
+                unreachable!()
+            };
+            assert!(
+                path.is_absolute(),
+                "{path:?} must be absolute, never a bare name"
+            );
+        }
+    }
+
+    /// The production probe answers "exists and is executable": a plain file,
+    /// a directory, a missing path or a dangling symlink never counts as
+    /// launchable; an executable file -- or a symlink to one, which is how npm
+    /// installs a package's bin under /usr/bin -- does.
+    #[cfg(unix)]
+    #[test]
+    fn zeo_agent_launch_source_production_probe_requires_an_executable_file() {
+        use std::os::unix::fs::{PermissionsExt as _, symlink};
+
+        let dir = tempfile::tempdir().unwrap();
+        let path = |name: &str| dir.path().join(name);
+        let set_mode = |name: &str, mode: u32| {
+            std::fs::set_permissions(path(name), std::fs::Permissions::from_mode(mode)).unwrap()
+        };
+
+        std::fs::write(path("not-executable"), b"#!/bin/sh\n").unwrap();
+        set_mode("not-executable", 0o644);
+        std::fs::create_dir(path("a-directory")).unwrap();
+        set_mode("a-directory", 0o755);
+        symlink(path("nowhere"), path("dangling-link")).unwrap();
+        std::fs::write(path("executable"), b"#!/bin/sh\n").unwrap();
+        set_mode("executable", 0o755);
+        symlink(path("executable"), path("link-to-executable")).unwrap();
+
+        for hostile in ["not-executable", "a-directory", "missing", "dangling-link"] {
+            let answer = zeo_system_binary_is_executable(&path(hostile));
+            assert!(
+                !matches!(answer, Ok(true)),
+                "{hostile} must not be launchable, got {answer:?}"
+            );
+        }
+        for launchable in ["executable", "link-to-executable"] {
+            let answer = zeo_system_binary_is_executable(&path(launchable));
+            assert!(
+                matches!(answer, Ok(true)),
+                "{launchable} must be launchable, got {answer:?}"
+            );
+        }
+    }
 }
