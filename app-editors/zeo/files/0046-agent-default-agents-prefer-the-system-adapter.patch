+/// Where a Zeo default agent is launched from.
+#[derive(Debug, PartialEq)]
+pub enum ZeoLaunchSource {
+    /// The adapter a package manager installed, as an absolute path -- never a
+    /// bare name, which would depend on the spawn-time `PATH`.
+    System(PathBuf),
+    /// The npm registry package, as `zeo_agents()` ships it. Empty for an id
+    /// that is not a Zeo default: the caller keeps its own package then.
+    Npm(String),
+}
+
+/// The binary the system package installs for each Zeo default agent. The TUI
+/// agent's id is `claude-agent-tui` but its binary is `claude-agent-acp-tui`.
+fn zeo_system_binary(agent_id: &str) -> Option<&'static str> {
+    match agent_id {
+        ZEO_PLUS_AGENT_ID => Some("/usr/bin/claude-agent-acp-plus"),
+        ZEO_TUI_AGENT_ID => Some("/usr/bin/claude-agent-acp-tui"),
+        _ => None,
+    }
+}
+
+/// Decides, at launch time, whether a Zeo default agent runs the adapter a
+/// package manager installed or the npm package. `probe` answers "exists and is
+/// executable"; an error counts as absent, so a broken install falls back to
+/// npm instead of failing the launch -- the caller's probe logs the error.
+/// Any other id resolves to npm without probing anything.
+pub fn zeo_agent_launch_source(
+    agent_id: &str,
+    probe: impl Fn(&Path) -> std::io::Result<bool>,
+) -> ZeoLaunchSource {
+    let Some(binary) = zeo_system_binary(agent_id) else {
+        return ZeoLaunchSource::Npm(String::new());
+    };
+    let binary = Path::new(binary);
+    if let Ok(true) = probe(binary) {
+        return ZeoLaunchSource::System(binary.to_path_buf());
+    }
+    let spec = zeo_agents()
+        .into_iter()
+        .find_map(|agent| match agent {
+            RegistryAgent::Npx(agent) if agent.metadata.id.0.as_ref() == agent_id => {
+                Some(agent.package.to_string())
+            }
+            _ => None,
+        })
+        .unwrap_or_default();
+    ZeoLaunchSource::Npm(spec)
+}
+
+/// The production probe for `zeo_agent_launch_source`: a regular file, through
+/// symlinks, with an executable bit. A missing path -- a dangling symlink
+/// included -- is `Ok(false)`, not an error, so a `zeo-bin` user without the
+/// adapter installed gets no warning on every start.
+pub fn zeo_system_binary_is_executable(path: &Path) -> std::io::Result<bool> {
+    let metadata = match std::fs::metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+        Err(error) => return Err(error),
+    };
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt as _;
+        Ok(metadata.is_file() && metadata.permissions().mode() & 0o111 != 0)
+    }
+    #[cfg(not(unix))]
+    {
+        Ok(metadata.is_file())
+    }
+}
+
 struct RegistryFetchResult {
     index: RegistryIndex,
     raw_body: Vec<u8>,
@@ -783,7 +855,11 @@ mod zeo_agent_tests {
                 panic!("{} should be an npx agent", agent.id().0);
