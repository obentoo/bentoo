+            ("claude-acp", "@agentclientprotocol/claude-agent-acp@1.0.0"),
+            (
+                "claude-agent-acp-tui",
+                "@lucascouts/claude-agent-tui@latest",
+            ),
+        ] {
+            let mut agent = make_zeo_npx_agent(cx, fs.clone(), registry_id, package, |_| Ok(true));
+            let result = start(cx, &mut agent, Vec::new(), HashMap::default()).await;
+            assert_took_npm_path(&fs, registry_id, result, registry_id).await;
+        }
+
+        let mut plus = make_zeo_npx_agent(
+            cx,
+            fs.clone(),
+            crate::agent_registry_store::ZEO_PLUS_AGENT_ID,
+            "@lucascouts/claude-agent-acp-plus@latest",
+            |_| Ok(true),
+        );
+        let result = start(cx, &mut plus, Vec::new(), HashMap::default()).await;
+        assert_took_system_path(
+            &fs,
+            crate::agent_registry_store::ZEO_PLUS_AGENT_ID,
+            result,
+            ZEO_PLUS_SYSTEM_BINARY,
+            "plus with the binary present",
+        )
+        .await;
+    }
+
+    /// R2.1, Q4, R3.3, R1.2: the source is decided on every start of the same
+    /// agent -- a probe error and an absent binary both fall back to npm,
+    /// installing the adapter switches the next start to it, removing it
+    /// switches back, all with no rebuild of the agent.
+    #[gpui::test]
+    async fn zeo_agent_launch_falls_back_to_npm_and_rechecks_every_start(cx: &mut TestAppContext) {
+        let fs = fs::FakeFs::new(cx.executor());
+        let tui = crate::agent_registry_store::ZEO_TUI_AGENT_ID;
+        let answers: Arc<std::sync::Mutex<Vec<std::io::Result<bool>>>> =
+            Arc::new(std::sync::Mutex::new(vec![
+                Ok(false),
+                Ok(true),
+                Ok(false),
+                Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied)),
+            ]));
+        let probe_answers = answers.clone();
+        let mut agent = make_zeo_npx_agent(
+            cx,
+            fs.clone(),
+            tui,
+            "@lucascouts/claude-agent-tui@latest",
+            move |_| {
+                probe_answers
+                    .lock()
+                    .unwrap()
+                    .pop()
+                    .expect("the probe should be asked exactly once per start")
+            },
+        );
+
+        let result = start(cx, &mut agent, Vec::new(), HashMap::default()).await;
+        assert_took_npm_path(&fs, tui, result, "start 1, probe error").await;
+
+        clear_npx_dir(&fs, tui).await;
+        let result = start(cx, &mut agent, Vec::new(), HashMap::default()).await;
+        assert_took_npm_path(&fs, tui, result, "start 2, binary absent").await;
+
+        clear_npx_dir(&fs, tui).await;
+        let result = start(cx, &mut agent, Vec::new(), HashMap::default()).await;
+        assert_took_system_path(
+            &fs,
+            tui,
+            result,
+            ZEO_TUI_SYSTEM_BINARY,
+            "start 3, installed",
+        )
+        .await;
+
+        let result = start(cx, &mut agent, Vec::new(), HashMap::default()).await;
+        assert_took_npm_path(&fs, tui, result, "start 4, removed again").await;
+
+        assert!(answers.lock().unwrap().is_empty(), "one probe per start");
+    }
+
+    /// R1.1, R1.3 (benign): with the adapter installed, the Plus agent runs the
+    /// absolute system binary directly -- not through node -- with Zed's extra
+    /// args and env, and nothing is prepared for npm.
+    #[gpui::test]
+    async fn zeo_agent_launch_system_binary_runs_without_npm(cx: &mut TestAppContext) {
+        let fs = fs::FakeFs::new(cx.executor());
+        let plus = crate::agent_registry_store::ZEO_PLUS_AGENT_ID;
+        let probed = Arc::new(std::sync::Mutex::new(Vec::<PathBuf>::new()));
+        let recorder = probed.clone();
+        let mut agent = make_zeo_npx_agent(
+            cx,
+            fs.clone(),
+            plus,
+            "@lucascouts/claude-agent-acp-plus@latest",
+            move |path| {
+                recorder.lock().unwrap().push(path.to_path_buf());
+                Ok(path == Path::new(ZEO_PLUS_SYSTEM_BINARY))
+            },
+        );
+
+        let mut extra_env = HashMap::default();
+        extra_env.insert("ZEO_EXTRA".to_string(), "1".to_string());
+        let result = start(cx, &mut agent, vec!["--from-zed".to_string()], extra_env).await;
+        let command =
+            assert_took_system_path(&fs, plus, result, ZEO_PLUS_SYSTEM_BINARY, "plus installed")
+                .await;
+
+        assert_eq!(command.args, vec!["--from-zed".to_string()]);
+        assert!(
+            !command.args.iter().any(|arg| arg.contains("node_modules")),
+            "a system launch must not point at an npm-installed script: {:?}",
+            command.args
+        );
+        assert_eq!(
+            command.env.as_ref().and_then(|env| env.get("ZEO_EXTRA")),
+            Some(&"1".to_string())
+        );
+        assert_eq!(
+            *probed.lock().unwrap(),
+            vec![PathBuf::from(ZEO_PLUS_SYSTEM_BINARY)]
+        );
+    }
+
+    fn zeo_registry_agent(id: &str, package: &str) -> RegistryAgent {
+        RegistryAgent::Npx(RegistryNpxAgent {
+            metadata: RegistryAgentMetadata {
+                id: AgentId::new(SharedString::from(id.to_string())),
+                name: SharedString::from(id.to_string()),
+                description: SharedString::from(""),
+                version: SharedString::from("latest"),
+                repository: None,
+                website: None,
+                license_url: None,
+                icon_path: None,
+            },
+            package: SharedString::from(package.to_string()),
+            args: Vec::new(),
+            env: HashMap::default(),
+        })
+    }
+
+    /// Replaces the probe of the store-built default agent `id` and starts it.
+    async fn start_store_default(
+        cx: &mut TestAppContext,
+        store: &gpui::Entity<AgentServerStore>,
+        id: &str,
+        binary_present: bool,
+    ) -> Result<AgentServerCommand> {
+        let task = store.update(cx, |store, cx| {
+            let agent = store
+                .get_external_agent(&AgentId::new(SharedString::from(id.to_string())))
+                .unwrap_or_else(|| panic!("{id} should be registered by default"));
+            let npx = agent
+                .as_any_mut()
+                .downcast_mut::<LocalRegistryNpxAgent>()
+                .unwrap_or_else(|| panic!("{id} should be a registry npx agent by default"));
+            npx.launch_probe = Arc::new(move |_| Ok(binary_present));
+            npx.get_command(Vec::new(), HashMap::default(), &mut cx.to_async())
+        });
+        let result = task.await;
+        cx.run_until_parked();
+        result
+    }
+
+    /// R3.1, R3.2: with default.json as 0033 ships it, both ids resolve
+    /// through the system-binary rule; a user `agent_servers` entry with the
+    /// same id replaces the default for that id only -- the user's command
+    /// runs even though the system binary is present -- and the other default
+    /// keeps applying.
+    #[gpui::test]
+    async fn zeo_agent_settings_user_entry_wins_over_the_system_binary(cx: &mut TestAppContext) {
+        use crate::agent_registry_store::{ZEO_PLUS_AGENT_ID, ZEO_TUI_AGENT_ID};
+        use gpui::BorrowAppContext as _;
+
+        init_test_settings(cx);
+        init_registry(
+            cx,
+            vec![
+                zeo_registry_agent(
+                    ZEO_PLUS_AGENT_ID,
+                    "@lucascouts/claude-agent-acp-plus@latest",
+                ),
+                zeo_registry_agent(ZEO_TUI_AGENT_ID, "@lucascouts/claude-agent-tui@latest"),
+            ],
+        );
+        let store = create_agent_server_store(cx);
+        cx.run_until_parked();
+
+        for (id, binary) in [
+            (ZEO_PLUS_AGENT_ID, "/usr/bin/claude-agent-acp-plus"),
+            (ZEO_TUI_AGENT_ID, "/usr/bin/claude-agent-acp-tui"),
+        ] {
+            let command = start_store_default(cx, &store, id, true)
+                .await
+                .unwrap_or_else(|error| panic!("{id} with its binary present: {error:#}"));
+            assert_eq!(command.path, PathBuf::from(binary), "{id}");
+
+            let result = start_store_default(cx, &store, id, false).await;
+            assert!(
+                result.is_err(),
+                "{id} with its binary absent should take the npm path, got {result:?}"
+            );
+        }
+
+        cx.update(|cx| {
+            cx.update_global::<SettingsStore, _>(|settings, cx| {
+                let _ = settings.set_user_settings(
+                    r#"{
+                        "agent_servers": {
+                            "claude-agent-acp-plus": {
+                                "type": "custom",
+                                "command": "/opt/user/claude-plus",
+                                "args": ["--mine"]
+                            }
+                        }
+                    }"#,
+                    cx,
+                );
+            });
+        });
+        cx.run_until_parked();
+
+        let plus_id = AgentId::new(SharedString::from(ZEO_PLUS_AGENT_ID.to_string()));
+        let task = store.update(cx, |store, cx| {
+            assert_eq!(
+                store.agent_source(&plus_id),
+                Some(ExternalAgentSource::Custom),
+                "the user's entry should replace the default"
+            );
+            let agent = store
+                .get_external_agent(&plus_id)
+                .expect("the user's entry should be registered under the same id");
+            assert!(
+                agent
+                    .as_any_mut()
+                    .downcast_mut::<LocalRegistryNpxAgent>()
+                    .is_none(),
+                "the user's entry must not be resolved through the system-binary rule"
+            );
+            agent.get_command(Vec::new(), HashMap::default(), &mut cx.to_async())
+        });
+        let command = task.await.expect("the user's command should start");
+        assert_eq!(command.path, PathBuf::from("/opt/user/claude-plus"));
+        assert_eq!(command.args, vec!["--mine".to_string()]);
+
+        let command = start_store_default(cx, &store, ZEO_TUI_AGENT_ID, true)
+            .await
+            .expect("the TUI default still applies");
+        assert_eq!(command.path, PathBuf::from("/usr/bin/claude-agent-acp-tui"));
+    }
 }
