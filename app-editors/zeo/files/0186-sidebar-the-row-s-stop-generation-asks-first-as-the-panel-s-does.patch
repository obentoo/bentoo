--- /dev/null
+++ b/crates/sidebar/src/sidebar_stop_confirm_tests.rs
@@ -0,0 +1,84 @@
+// Operator, 2026-11-25: the sidebar row's Stop Generation stopped the turn at once, while the
+// agent panel's asked first (0166). Both now go through `ThreadView::confirm_cancel_generation`.
+//
+// Hostile half first: "Keep Going" must leave the turn running -- a stop that skipped the
+// prompt, or cancelled before the answer, fails it. Then "Stop" stops it.
+
+use super::*;
+use crate::sidebar_tests::{init_test_project_with_agent_panel, setup_sidebar_with_agent_panel};
+use acp_thread::{AcpThread, StubAgentConnection, ThreadStatus};
+use agent_ui::test_support::{active_thread_id, open_thread_with_connection, send_message};
+use gpui::{TestAppContext, VisualTestContext};
+
+async fn generating_thread(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<Sidebar>,
+    Entity<AcpThread>,
+    agent_ui::ThreadId,
+    &mut VisualTestContext,
+) {
+    let project = init_test_project_with_agent_panel("/project-a", cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let (sidebar, panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    open_thread_with_connection(&panel, StubAgentConnection::new(), cx);
+    send_message(&panel, cx);
+    cx.run_until_parked();
+    let thread = panel.read_with(cx, |panel, cx| {
+        panel.active_agent_thread(cx).expect("the thread")
+    });
+    let thread_id = active_thread_id(&panel, cx);
+    (sidebar, thread, thread_id, cx)
+}
+
+fn status(thread: &Entity<AcpThread>, cx: &mut VisualTestContext) -> ThreadStatus {
+    thread.read_with(cx, |thread, _| thread.status())
+}
+
+#[gpui::test]
+async fn test_sidebar_stop_asks_and_keep_going_keeps_the_turn(cx: &mut TestAppContext) {
+    let (sidebar, thread, thread_id, cx) = generating_thread(cx).await;
+    assert_eq!(
+        status(&thread, cx),
+        ThreadStatus::Generating,
+        "precondition"
+    );
+
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.stop_thread(&thread_id, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(cx.has_pending_prompt(), "the row's Stop asks first");
+    assert_eq!(
+        status(&thread, cx),
+        ThreadStatus::Generating,
+        "nothing stops before the answer"
+    );
+
+    cx.simulate_prompt_answer("Keep Going");
+    cx.run_until_parked();
+    assert_eq!(
+        status(&thread, cx),
+        ThreadStatus::Generating,
+        "Keep Going keeps the turn"
+    );
+}
+
+#[gpui::test]
+async fn test_sidebar_stop_confirmed_stops_the_turn(cx: &mut TestAppContext) {
+    let (sidebar, thread, thread_id, cx) = generating_thread(cx).await;
+
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.stop_thread(&thread_id, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(cx.has_pending_prompt());
+    cx.simulate_prompt_answer("Stop");
+    cx.run_until_parked();
+    assert_eq!(
+        status(&thread, cx),
+        ThreadStatus::Idle,
+        "Stop stops the turn"
+    );
+}
