+#[gpui::test]
+async fn test_background_tasks_outlive_the_turn_in_the_sidebar(cx: &mut TestAppContext) {
+    let project_a = init_test_project_with_agent_panel("/project-a", cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project_a.clone(), window, cx));
+    let (sidebar, panel_a) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+
+    let connection_a = StubAgentConnection::new();
+    open_thread_with_connection(&panel_a, connection_a.clone(), cx);
+    send_message(&panel_a, cx);
+
+    let session_id_a = active_session_id(&panel_a, cx);
+    save_test_thread_metadata(&session_id_a, &project_a, cx).await;
+
+    let background_tasks = |count: u64| {
+        let mut meta = serde_json::Map::new();
+        meta.insert(
+            "_claude/backgroundTasks".to_string(),
+            serde_json::json!({ "count": count, "tasks": [] }),
+        );
+        acp_v1::SessionUpdate::SessionInfoUpdate(acp_v1::SessionInfoUpdate::new().meta(meta))
+    };
+
+    // The turn launches a background shell, then ends while it keeps running.
+    cx.update(|_, cx| {
+        connection_a.send_update(session_id_a.clone(), background_tasks(1), cx);
+    });
+    cx.run_until_parked();
+
+    let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    let project_b = project::Project::test(fs, [], cx).await;
+    multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.test_add_workspace(project_b, window, cx);
+    });
+    cx.run_until_parked();
+
+    connection_a.end_turn(session_id_a.clone(), acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+
+    // The turn is over, so it is no longer "running" -- but the work is not done, so
+    // it is not "finished" either.
+    assert_eq!(
+        visible_entries_as_strings(&sidebar, cx),
+        vec![
+            //
+            "v [project-a]",
+            "  Hello * (background)",
+        ]
+    );
+
+    // Archiving is refused while the background work runs, as upstream refuses it for a
+    // running or Unconfirmed thread.
+    let background_index = sidebar.read_with(cx, |sidebar, _cx| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(
+                    entry,
+                    ListEntry::Thread(thread) if thread.status == AgentThreadStatus::Background
+                )
+            })
+            .expect("the background thread is listed")
+    });
+    focus_sidebar(&sidebar, cx);
+    sidebar.update_in(cx, |sidebar, _window, _cx| {
+        sidebar.selection = Some(background_index);
+    });
+    cx.dispatch_action(ArchiveSelectedThread);
+    cx.run_until_parked();
+    assert_eq!(
+        visible_entries_as_strings(&sidebar, cx),
+        vec![
+            //
+            "v [project-a]",
+            "  Hello * (background)  <== selected",
+        ]
+    );
+    sidebar.update_in(cx, |sidebar, _window, _cx| {
+        sidebar.selection = None;
+    });
+
+    // The last background task ends between turns, with no turn to carry the news.
+    cx.update(|_, cx| {
+        connection_a.send_update(session_id_a.clone(), background_tasks(0), cx);
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        visible_entries_as_strings(&sidebar, cx),
+        vec![
+            //
+            "v [project-a]",
+            "  Hello * (!)",
+        ]
+    );
+}
