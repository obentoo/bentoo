diff --git a/crates/sidebar/src/sidebar_pinned_background_tests.rs b/crates/sidebar/src/sidebar_pinned_background_tests.rs
new file mode 100644
index 0000000..593574e
--- /dev/null
+++ b/crates/sidebar/src/sidebar_pinned_background_tests.rs
@@ -0,0 +1,206 @@
+// Story 032 v4, task 10.2 — Background→Completed on a pinned row (R2.12). Patch `0029`.
+//
+// Compiles only with `0029` applied (`AgentThreadStatus::Background`, the `_claude/backgroundTasks`
+// meta key): `0029` adds this file and its `mod` line, never `0049`. Materialize as a child module
+// of `sidebar_pinned_tests.rs`, at the end of that file:
+//     #[path = "sidebar_pinned_background_tests.rs"]
+//     mod background;
+// Filter: `cargo test -p sidebar --lib sidebar_pinned_tests::background` (also matched by `pinned`).
+//
+// The `Background` arm lives in this file's own reader (`entries` below), not in `0049`'s
+// `pinned_entries`, so `0049` keeps compiling without `0029` (546bba9's reason, design.md v4
+// GOTCHA). The rows print as `pinned_entries` does, plus " (background)" for that status.
+//
+// Hostile halves first: a turn that ends while background work keeps running (Running →
+// Background) is NOT news — no marker; then the end of that work (Background → Completed) on a
+// pinned thread that is not the active one IS news on its row and on the Pinned header, with the
+// section expanded and collapsed; and the converse — the active pinned thread gets no marker.
+
+use super::*;
+use pretty_assertions::assert_eq;
+
+/// The adapter's background-task level, as `0029`'s own sidebar test sends it.
+fn background_tasks(count: u64) -> acp_v1::SessionUpdate {
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/backgroundTasks".to_string(),
+        serde_json::json!({ "count": count, "tasks": [] }),
+    );
+    acp_v1::SessionUpdate::SessionInfoUpdate(acp_v1::SessionInfoUpdate::new().meta(meta))
+}
+
+/// `pinned_entries` with the `Background` status printed as " (background)".
+fn entries(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    let base = pinned_entries(sidebar, cx);
+    sidebar.read_with(cx, |sidebar, _cx| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .enumerate()
+            .zip(base)
+            .map(|((ix, entry), line)| match entry {
+                ListEntry::Thread(thread)
+                    if thread.pinned_project_label.is_some()
+                        && thread.status == AgentThreadStatus::Background =>
+                {
+                    let label = thread.pinned_project_label.as_ref().unwrap();
+                    let title = thread.metadata.display_title();
+                    let live = if thread.is_live { " *" } else { "" };
+                    let notified = if sidebar
+                        .contents
+                        .is_thread_notified(&thread.metadata.thread_id)
+                    {
+                        " (!)"
+                    } else {
+                        ""
+                    };
+                    let selected = if sidebar.selection == Some(ix) {
+                        "  <== selected"
+                    } else {
+                        ""
+                    };
+                    format!("  {title} · {label}{live} (background){notified}{selected}")
+                }
+                _ => line,
+            })
+            .collect()
+    })
+}
+
+/// A window on `/project-a` with an agent panel and a pinned thread whose turn launched
+/// background work and then ended. With `away`, a second workspace is made active first, so the
+/// pinned thread is not the active one.
+async fn pinned_thread_with_background_work(
+    cx: &mut TestAppContext,
+    away: bool,
+) -> (
+    Entity<Sidebar>,
+    StubAgentConnection,
+    acp::SessionId,
+    &mut VisualTestContext,
+) {
+    let project_a = init_test_project_with_agent_panel("/project-a", cx).await;
+    cx.update(|cx| agent_ui::thread_organization::init(cx));
+    cx.run_until_parked();
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project_a.clone(), window, cx));
+    let (sidebar, panel_a) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    let connection = StubAgentConnection::new();
+    open_thread_with_connection(&panel_a, connection.clone(), cx);
+    send_message(&panel_a, cx);
+    let session = active_session_id(&panel_a, cx);
+    save_test_thread_metadata(&session, &project_a, cx).await;
+    cx.update(|_, cx| connection.send_update(session.clone(), background_tasks(1), cx));
+    cx.run_until_parked();
+    let thread = thread_id_of(&session.0, cx);
+    store_pin(thread, cx);
+    if away {
+        let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+        let project_b = project::Project::test(fs, [], cx).await;
+        multi_workspace.update_in(cx, |mw, window, cx| {
+            mw.test_add_workspace(project_b, window, cx);
+        });
+        cx.run_until_parked();
+    }
+    connection.end_turn(session.clone(), acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+    (sidebar, connection, session, cx)
+}
+
+// R2.12 — out of sight: the turn ending with work still running is not news (hostile half: a
+// rule keyed on "the turn ended" would fire here); the work ending is, on the row and the header.
+#[gpui::test]
+async fn pinned_row_is_notified_when_its_background_work_ends_out_of_sight(
+    cx: &mut TestAppContext,
+) {
+    let (sidebar, connection, session, cx) = pinned_thread_with_background_work(cx, true).await;
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec![
+            "v [project-a]",
+            "v Pinned",
+            "  Hello · project-a * (background)"
+        ],
+        "the turn ended with work running: Background, and no marker yet"
+    );
+    assert_eq!(pinned_header_has_notifications(&sidebar, cx), Some(false));
+
+    cx.update(|_, cx| connection.send_update(session.clone(), background_tasks(0), cx));
+    cx.run_until_parked();
+
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec!["v [project-a]", "v Pinned", "  Hello · project-a * (!)"],
+        "Background → Completed out of sight marks the pinned row"
+    );
+    assert_eq!(
+        pinned_header_has_notifications(&sidebar, cx),
+        Some(true),
+        "and the Pinned header"
+    );
+}
+
+// R2.12 with Pinned collapsed — no row is shown, the header still reports the notification, and
+// expanding shows the row marked.
+#[gpui::test]
+async fn collapsed_pinned_header_reports_the_end_of_background_work(cx: &mut TestAppContext) {
+    let (sidebar, connection, session, cx) = pinned_thread_with_background_work(cx, true).await;
+    let header = pinned_header_ix(&sidebar, cx).expect("fixture: a Pinned header");
+    confirm_at(&sidebar, header, cx);
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec!["v [project-a]", "> Pinned  <== selected"],
+        "fixture: Pinned is collapsed"
+    );
+    assert_eq!(pinned_header_has_notifications(&sidebar, cx), Some(false));
+
+    cx.update(|_, cx| connection.send_update(session.clone(), background_tasks(0), cx));
+    cx.run_until_parked();
+    sidebar.update(cx, |sidebar, cx| sidebar.update_entries(cx));
+    cx.run_until_parked();
+
+    assert_eq!(
+        pinned_header_has_notifications(&sidebar, cx),
+        Some(true),
+        "the collapsed Pinned header reports the end of the background work"
+    );
+    confirm_at(&sidebar, header, cx);
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec![
+            "v [project-a]",
+            "v Pinned  <== selected",
+            "  Hello · project-a * (!)"
+        ],
+        "the row is marked once Pinned is expanded"
+    );
+}
+
+// R2.12 converse — the active pinned thread finishing its background work is in sight: no marker
+// on its row, none on the header.
+#[gpui::test]
+async fn active_pinned_thread_gets_no_marker_when_its_background_work_ends(
+    cx: &mut TestAppContext,
+) {
+    let (sidebar, connection, session, cx) = pinned_thread_with_background_work(cx, false).await;
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec![
+            "v [project-a]",
+            "v Pinned",
+            "  Hello · project-a * (background)"
+        ],
+        "fixture: the active pinned thread runs in the background"
+    );
+
+    cx.update(|_, cx| connection.send_update(session.clone(), background_tasks(0), cx));
+    cx.run_until_parked();
+
+    assert_eq!(
+        entries(&sidebar, cx),
+        vec!["v [project-a]", "v Pinned", "  Hello · project-a *"],
+        "no marker on the active thread"
+    );
+    assert_eq!(pinned_header_has_notifications(&sidebar, cx), Some(false));
+}
