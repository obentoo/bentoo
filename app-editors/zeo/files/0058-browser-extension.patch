+actions!(
+    devtools_bridge,
+    [
+        /// Forgets every browser extension approved to read and drive agent threads, and closes
+        /// every open browser session.
+        RevokeBrowserAccess
+    ]
+);
+
+/// The key-value store key holding the approved identities, as a JSON array of
+/// `"<browser>:<extension_id>"`.
+pub const APPROVED_CLIENTS_KEY: &str = "zeo_browser_approved_clients";
+/// How long an approval prompt waits for an answer (R4.4).
+pub const APPROVAL_TIMEOUT: Duration = Duration::from_secs(120);
+/// The longest extension id a log line or the prompt shows.
+const SHOWN_EXTENSION_CHARS: usize = 64;
+
+// ---------------------------------------------------------------------------------------------
+// Sessions
+
+/// Identifies one browser session for the listener's whole life.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct SessionId(u64);
+
+impl SessionId {
+    pub fn new(raw: u64) -> Self {
+        Self(raw)
+    }
+
+    pub fn as_u64(&self) -> u64 {
+        self.0
+    }
+}
+
+impl fmt::Display for SessionId {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}", self.0)
+    }
+}
+
+/// Writes [`ServerMsg`]s to one browser session. Cloneable; sending never waits.
+///
+/// The bridge builds it over its bounded writer queue with [`SessionSink::with_overflow_signal`],
+/// so a queue that fills overflows the session; a sink built with [`SessionSink::new`] has no
+/// such signal and a full queue only fails the send.
+#[derive(Debug, Clone)]
+pub struct SessionSink {
+    queue: smol::channel::Sender<ServerMsg>,
+    /// Closed, never sent on, when the queue overflows: the bridge's writer takes it as the
+    /// order to write `overloaded` and close.
+    overflow: Option<smol::channel::Sender<()>>,
+}
+
+/// The session a [`SessionSink`] wrote to has closed, or is closing after an overflow.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SessionClosed;
+
+impl fmt::Display for SessionClosed {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("the browser session is closed")
+    }
+}
+
+impl std::error::Error for SessionClosed {}
+
+impl SessionSink {
+    pub fn new(queue: smol::channel::Sender<ServerMsg>) -> Self {
+        Self {
+            queue,
+            overflow: None,
+        }
+    }
+
+    /// A sink whose overflow closes `overflow` before the queue, so the reader of `queue` can
+    /// tell an overflow from a close that still delivers what is queued.
+    pub fn with_overflow_signal(
+        queue: smol::channel::Sender<ServerMsg>,
+        overflow: smol::channel::Sender<()>,
+    ) -> Self {
+        Self {
+            queue,
+            overflow: Some(overflow),
+        }
+    }
+
+    /// Queues `msg` without waiting. A message that finds the queue full overflows the session:
+    /// this send and every later one fail.
+    pub fn send(&self, msg: ServerMsg) -> Result<(), SessionClosed> {
+        match self.queue.try_send(msg) {
+            Ok(()) => Ok(()),
+            Err(TrySendError::Full(_)) => {
+                // The signal before the queue: the writer checks it first, so it never mistakes
+                // the overflow for a close that still delivers what is queued.
+                if let Some(overflow) = &self.overflow {
+                    overflow.close();
+                }
+                self.queue.close();
+                Err(SessionClosed)
+            }
+            Err(TrySendError::Closed(_)) => Err(SessionClosed),
+        }
+    }
+
+    /// Ends the session once what is already queued has been written.
+    pub fn close(&self) {
+        self.queue.close();
+    }
+
+    pub fn is_closed(&self) -> bool {
+        self.queue.is_closed()
+    }
+
+    /// Whether `other` writes to the same session as `self`.
+    pub fn same_session(&self, other: &SessionSink) -> bool {
+        self.queue.same_channel(&other.queue)
+    }
+}
+
+/// One browser session as the bridge opened it: its id and the sink that writes to it. Its
+/// approval state lives in the app-wide channel, keyed by the id, so [`close_session`] and
+/// [`RevokeBrowserAccess`] reach it without holding the session.
+#[derive(Debug, Clone)]
+pub struct BrowserSession {
+    id: SessionId,
+    sink: SessionSink,
+}
+
+impl BrowserSession {
+    pub fn new(id: SessionId, sink: SessionSink) -> Self {
+        Self { id, sink }
+    }
+
+    pub fn id(&self) -> &SessionId {
+        &self.id
+    }
+}
+
+/// The two buttons of the approval prompt.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ApprovalAnswer {
+    Allow,
+    Deny,
+}
+
+// ---------------------------------------------------------------------------------------------
+// The channel's state
+
+/// Every session's state for the app's whole life, plus the identities denied in this run.
+#[derive(Default)]
+struct BrowserChannel {
+    sessions: HashMap<SessionId, SessionState>,
+    denied: HashSet<Identity>,
+    store: ApprovalStore,
+    /// Numbers every attachment of a session to a thread, so a callback or timer of an older one
+    /// changes nothing.
+    next_stream: u64,
+    hooks: FollowHooks,
+}
+
+/// Orders every read and write of [`APPROVED_CLIENTS_KEY`] against revokes.
+///
+/// The lock alone serialises the store operations but does not order them: a delete spawned by
+/// a revoke may run before a save spawned by an earlier Allow, or after a read spawned by a later
+/// hello. So each revoke takes a new generation on the foreground before spawning its delete;
+/// a save that was decided under an older generation writes nothing, and until the store has
+/// been cleared for the current generation, what it holds reads as empty.
+#[derive(Clone, Default)]
+struct ApprovalStore {
+    lock: Arc<smol::lock::Mutex<()>>,
+    /// Bumped by every revoke, on the foreground, before its delete is spawned.
+    revoked: Arc<AtomicU64>,
+    /// The newest revoke whose effect the store already holds.
+    cleared: Arc<AtomicU64>,
+}
+
+impl ApprovalStore {
+    fn generation(&self) -> u64 {
+        self.revoked.load(Ordering::SeqCst)
+    }
+
+    /// Starts a revoke; returns its generation.
+    fn revoke(&self) -> u64 {
+        self.revoked.fetch_add(1, Ordering::SeqCst) + 1
+    }
+
+    async fn read(&self, kvp: &KeyValueStore) -> Result<Vec<String>> {
+        let _guard = self.lock.lock().await;
+        self.read_locked(kvp)
+    }
+
+    fn read_locked(&self, kvp: &KeyValueStore) -> Result<Vec<String>> {
+        if self.cleared.load(Ordering::SeqCst) < self.generation() {
+            // A revoke's delete has not run yet: what the store holds is already forgotten.
+            return Ok(Vec::new());
+        }
+        read_approved(kvp)
+    }
+
+    /// Adds `key`, unless a revoke came after the Allow decided under `generation`; returns
+    /// whether it was added.
+    async fn add(&self, kvp: &KeyValueStore, key: String, generation: u64) -> Result<bool> {
+        let _guard = self.lock.lock().await;
+        if self.generation() != generation {
+            return Ok(false);
+        }
+        let mut approved = self.read_locked(kvp)?;
+        if !approved.contains(&key) {
+            approved.push(key);
+        }
+        let value = serde_json::to_string(&approved).context("encoding the approved list")?;
+        kvp.write_kvp(APPROVED_CLIENTS_KEY.to_string(), value)
+            .await
+            .context("writing the approved browser extensions")?;
+        // The value written replaced whatever an earlier generation had left.
+        self.cleared.fetch_max(generation, Ordering::SeqCst);
+        Ok(true)
+    }
+
+    /// Clears the store for the revoke of `generation`, unless a later write already did.
+    async fn clear(&self, kvp: &KeyValueStore, generation: u64) -> Result<()> {
+        let _guard = self.lock.lock().await;
+        if self.cleared.load(Ordering::SeqCst) >= generation {
+            return Ok(());
+        }
+        kvp.delete_kvp(APPROVED_CLIENTS_KEY.to_string())
+            .await
+            .context("forgetting the approved browser extensions")?;
+        self.cleared.fetch_max(generation, Ordering::SeqCst);
+        Ok(())
+    }
+}
+
+impl Global for BrowserChannel {}
+
+struct SessionState {
+    sink: SessionSink,
+    /// Set by the first `hello`.
+    identity: Option<Identity>,
+    /// The first `hello`'s `id`, echoed by the reply that ends its approval.
+    hello_id: Option<String>,
+    approval: Approval,
+    /// What the session subscribed to; dropping it drops the thread subscription.
+    stream: Option<Stream>,
+}
+
+enum Approval {
+    /// No `hello` handled yet.
+    AwaitingHello,
+    /// The store is being read for the identity.
+    Checking,
+    /// The prompt is shown; dropping the timer task cancels the timeout.
+    Pending {
+        prompt: Prompt,
+        _timeout: Task<()>,
+    },
+    /// Allow was chosen and the identity is being written to the store.
+    Saving,
+    Approved,
+}
+
+impl Approval {
+    fn is_approved(&self) -> bool {
+        matches!(self, Self::Approved)
+    }
+}
+
+/// A shown approval notification.
+struct Prompt {
+    workspace: WeakEntity<Workspace>,
+    id: NotificationId,
+}
+
+impl Prompt {
+    fn dismiss(&self, cx: &mut App) {
+        // A workspace already gone took its notification with it.
+        self.workspace
+            .update(cx, |workspace, cx| {
+                workspace.dismiss_notification(&self.id, cx)
+            })
+            .ok();
+    }
+}
+
+/// Marks the approval prompts' notification ids.
+struct BrowserApprovalPrompt;
+
+/// Who a session is, as the native host injected it into the `hello`.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+struct Identity {
+    browser: Browser,
+    extension_id: String,
+}
+
+impl Identity {
+    fn of(client: &ClientInfo) -> Self {
+        Self {
+            browser: client.browser,
+            extension_id: client.extension_id.clone(),
+        }
+    }
+
+    /// The form kept in the store.
+    fn key(&self) -> String {
+        format!("{}:{}", self.browser.code(), self.extension_id)
+    }
+}
+
+impl fmt::Display for Identity {
+    /// `browser=<code> extension="<id>"`, the id sanitised so the peer's own string can neither
+    /// forge a field nor smuggle a URL into the log.
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "browser={} extension={:?}",
+            self.browser.code(),
+            loggable_extension_id(&self.extension_id)
+        )
+    }
+}
+
+/// An extension id as a log line or the approval prompt shows it: at most 64 characters, each
+/// one an ASCII letter, digit or one of `@ . _ - { }` (what Chrome and Firefox ids are made of),
+/// anything else replaced by `_`.
+pub fn loggable_extension_id(raw: &str) -> String {
+    raw.chars()
+        .take(SHOWN_EXTENSION_CHARS)
+        .map(|char| {
+            if char.is_ascii_alphanumeric() || matches!(char, '@' | '.' | '_' | '-' | '{' | '}') {
+                char
+            } else {
+                '_'
+            }
+        })
+        .collect()
+}
+
+/// Registers [`RevokeBrowserAccess`] and the channel's state. Idempotent; the first session
+/// message does it too.
+pub fn init(cx: &mut App) {
+    global(cx);
+}
+
+fn global(cx: &mut App) -> &mut BrowserChannel {
+    if !cx.has_global::<BrowserChannel>() {
+        cx.set_global(BrowserChannel::default());
+        cx.on_action(|_: &RevokeBrowserAccess, cx| revoke_browser_access(cx));
+    }
+    cx.global_mut::<BrowserChannel>()
+}
+
+// ---------------------------------------------------------------------------------------------
+// The interface the bridge calls
+
+/// Handles one message of `session`: its `hello` starts the approval, and until the session is
+/// approved every other message is answered `not_approved` (R4.5). Never fails: every outcome is
+/// a reply on the session.
+pub fn handle_session_message(
+    session: &BrowserSession,
+    msg: ClientMsg,
+    app_state: Arc<AppState>,
+    cx: &mut App,
+) {
+    let started = Instant::now();
+    let channel = global(cx);
+    let reused = channel
+        .sessions
+        .get(&session.id)
+        .is_some_and(|state| !state.sink.same_session(&session.sink));
+    if reused {
+        // Another listener numbered a new session like a gone one: nothing carries over.
+        log_line(
+            log::Level::Warn,
+            format!(
+                "devtools_bridge event=session_id_reused session={}",
+                session.id
+            ),
+        );
+        forget(&session.id, cx);
+    }
+    let channel = global(cx);
+    if !channel.sessions.contains_key(&session.id) {
+        // A session refused or closed here may still deliver what the bridge had read.
+        if session.sink.is_closed() {
+            return;
+        }
+        channel.sessions.insert(
+            session.id.clone(),
+            SessionState {
+                sink: session.sink.clone(),
+                identity: None,
+                hello_id: None,
+                approval: Approval::AwaitingHello,
+                stream: None,
+            },
+        );
+    }
+
+    match msg {
+        ClientMsg::Hello { id, client, .. } => handle_hello(&session.id, id, &client, cx),
+        msg => {
+            let approved = channel
+                .sessions
+                .get(&session.id)
+                .is_some_and(|state| state.approval.is_approved());
+            if approved {
+                handle_approved(session, msg, app_state, cx);
+            } else {
+                let kind = msg.kind();
+                let id = msg.request_id().map(str::to_owned);
+                send(
+                    &session.id,
+                    ServerMsg::error(id, ChannelError::NotApproved),
+                    cx,
+                );
+                log_line(
+                    log::Level::Debug,
+                    format!(
+                        "devtools_bridge event=session_msg session={} kind={kind} \
+                         outcome=not_approved ms={}",
+                        session.id,
+                        started.elapsed().as_millis()
+                    ),
+                );
+            }
+        }
+    }
+}
+
+/// Forgets `id`: drops its state, cancels its approval timer and dismisses its pending prompt,
+/// so a sidebar closed during approval leaves nothing behind. The bridge calls it on the
+/// session's `Closed`; it never writes to the session.
+pub fn close_session(id: SessionId, cx: &mut App) {
+    let state = forget(&id, cx);
+    let known = state.is_some();
+    // Refused sessions are already forgotten, so their identity is gone too.
+    let identity = state
+        .as_ref()
+        .and_then(|state| state.identity.as_ref())
+        .map_or_else(|| "browser=unknown".to_string(), ToString::to_string);
+    log_line(
+        log::Level::Debug,
+        format!("devtools_bridge event=session_released session={id} {identity} known={known}"),
+    );
+}
+
+/// Drops `id`'s state, dismissing its prompt; dropping the state cancels its timer.
+fn forget(id: &SessionId, cx: &mut App) -> Option<SessionState> {
+    let state = global(cx).sessions.remove(id);
+    if let Some(SessionState {
+        approval: Approval::Pending { prompt, .. },
+        ..
+    }) = &state
+    {
+        prompt.dismiss(cx);
+    }
+    state
+}
+
+/// What the approval prompt's buttons call; the single path an answer takes. An answer covers
+/// the identity, not only the session it was asked in: every session of that identity waiting
+/// on an approval gets it (R4.2, R4.3). An answer for a session no longer waiting on one
+/// (closed, timed out, already answered) changes nothing.
+pub fn answer_approval(id: SessionId, answer: ApprovalAnswer, cx: &mut App) {
+    let channel = global(cx);
+    let identity = match channel.sessions.get(&id) {
+        Some(SessionState {
+            identity: Some(identity),
+            approval: Approval::Pending { .. },
+            ..
+        }) => identity.clone(),
+        state => {
+            let reason = if state.is_some() {
+                "not_pending"
+            } else {
+                "closed"
+            };
+            log_line(
+                log::Level::Debug,
+                format!(
+                    "devtools_bridge event=approval_answer_ignored session={id} reason={reason}"
+                ),
+            );
+            return;
+        }
+    };
+    match answer {
+        // A Deny from another session already refused this one; this guards a prompt that
+        // outlived it.
+        ApprovalAnswer::Allow if channel.denied.contains(&identity) => {
+            refuse(&id, ChannelError::ApprovalDenied, "denied_this_run", cx);
+        }
+        ApprovalAnswer::Allow => {
+            // The answer is in: every waiting prompt of the identity goes, with its timer.
+            for waiting in sessions_of(&identity, cx) {
+                let state = global(cx).sessions.get_mut(&waiting);
+                if let Some(state) = state
+                    && matches!(state.approval, Approval::Pending { .. })
+                {
+                    let pending = std::mem::replace(&mut state.approval, Approval::Saving);
+                    if let Approval::Pending { prompt, .. } = pending {
+                        prompt.dismiss(cx);
+                    }
+                }
+            }
+            save_approval(identity, cx);
+        }
+        ApprovalAnswer::Deny => {
+            global(cx).denied.insert(identity.clone());
+            for waiting in sessions_of(&identity, cx) {
+                refuse(&waiting, ChannelError::ApprovalDenied, "denied", cx);
+            }
+        }
+    }
+}
+
+/// The sessions of `identity` still waiting on an approval: being checked, prompted or saved.
+fn sessions_of(identity: &Identity, cx: &mut App) -> Vec<SessionId> {
+    global(cx)
+        .sessions
+        .iter()
+        .filter(|(_, state)| {
+            state.identity.as_ref() == Some(identity)
+                && matches!(
+                    state.approval,
+                    Approval::Checking | Approval::Pending { .. } | Approval::Saving
+                )
+        })
+        .map(|(id, _)| id.clone())
+        .collect()
+}
+
+/// Forgets every approved identity and closes every session (R4.6).
+pub fn revoke_browser_access(cx: &mut App) {
+    let channel = global(cx);
+    let sessions: Vec<(SessionId, SessionState)> = channel.sessions.drain().collect();
+    let store = channel.store.clone();
+    // Taken here, before anything is spawned: whatever the store does next is ordered by it.
+    let generation = store.revoke();
+    let count = sessions.len();
+    for (id, state) in sessions {
+        if let Approval::Pending { prompt, .. } = &state.approval {
+            prompt.dismiss(cx);
+        }
+        state.sink.close();
+        let identity = state
+            .identity
+            .as_ref()
+            .map_or_else(|| "browser=unknown".to_string(), ToString::to_string);
+        log_line(
+            log::Level::Info,
+            format!("devtools_bridge event=session_refused session={id} {identity} reason=revoked"),
+        );
+    }
+    let kvp = KeyValueStore::global(cx);
+    cx.background_spawn(async move { store.clear(&kvp, generation).await })
+        .detach_and_log_err(cx);
+    log_line(
+        log::Level::Info,
+        format!("devtools_bridge event=approvals_revoked sessions={count}"),
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Approval
+
+fn handle_hello(id: &SessionId, hello_id: Option<String>, client: &ClientInfo, cx: &mut App) {
+    let channel = global(cx);
+    let Some(state) = channel.sessions.get_mut(id) else {
+        return;
+    };
+    match &state.approval {
+        Approval::Approved => {
+            send(id, welcome(hello_id, cx), cx);
+            return;
+        }
+        // A repeated hello while the prompt waits: the answer is the same.
+        Approval::Pending { .. } | Approval::Saving => {
+            send(id, ServerMsg::ApprovalPending { v: V2 }, cx);
+            return;
+        }
+        // The store read in flight answers the first hello.
+        Approval::Checking => return,
+        Approval::AwaitingHello => {}
+    }
+
+    let identity = Identity::of(client);
+    state.identity = Some(identity.clone());
+    state.hello_id = hello_id;
+    if channel.denied.contains(&identity) {
+        refuse(id, ChannelError::ApprovalDenied, "denied_this_run", cx);
+        return;
+    }
+    state.approval = Approval::Checking;
+    let store = channel.store.clone();
+    let kvp = KeyValueStore::global(cx);
+    let read = cx.background_spawn(async move { store.read(&kvp).await });
+    let id = id.clone();
+    cx.spawn(async move |cx| {
+        let approved = read.await;
+        cx.update(|cx| finish_check(&id, &identity, approved, cx));
+    })
+    .detach();
+}
+
+fn finish_check(id: &SessionId, identity: &Identity, approved: Result<Vec<String>>, cx: &mut App) {
+    let channel = global(cx);
+    let checking = channel
+        .sessions
+        .get(id)
+        .is_some_and(|state| matches!(state.approval, Approval::Checking));
+    // Closed, revoked, or approved by an Allow given in another session while the store was
+    // read.
+    if !checking {
+        return;
+    }
+    // Denied in another session while the store was read.
+    if channel.denied.contains(identity) {
+        refuse(id, ChannelError::ApprovalDenied, "denied_this_run", cx);
+        return;
+    }
+    match approved {
+        Ok(approved) if approved.contains(&identity.key()) => {
+            approve(id, identity, "remembered", cx);
+        }
+        Ok(_) => ask(id, identity, cx),
+        Err(error) => {
+            log_store_failed(id, identity, &error);
+            refuse(id, ChannelError::ApprovalUnavailable, "store_failed", cx);
+        }
+    }
+}
+
+/// A store that cannot be read or written needs a human: the approvals it holds are out of
+/// reach until it is repaired.
+fn log_store_failed(id: &SessionId, identity: &Identity, error: &anyhow::Error) {
+    log_line(
+        log::Level::Error,
+        format!(
+            "devtools_bridge event=approval_store_failed session={id} {identity} reason={:?}",
+            format!("{error:#}")
+        ),
+    );
+}
+
+/// Shows the prompt in the most recently active window and starts the timeout, or refuses the
+/// session when no window is open (R4.7).
+fn ask(id: &SessionId, identity: &Identity, cx: &mut App) {
+    let Some((_, workspace)) = most_recent_window(cx) else {
+        refuse(id, ChannelError::ApprovalUnavailable, "no_window", cx);
+        return;
+    };
+    let notification =
+        NotificationId::composite::<BrowserApprovalPrompt>(ElementId::Integer(id.as_u64()));
+    show_prompt(&workspace, notification.clone(), id, identity, cx);
+
+    let timeout = cx.spawn({
+        let id = id.clone();
+        async move |cx| {
+            cx.background_executor().timer(APPROVAL_TIMEOUT).await;
+            cx.update(|cx| expire(&id, "approval_timeout", cx));
+        }
+    });
+    if let Some(state) = global(cx).sessions.get_mut(id) {
+        state.approval = Approval::Pending {
+            prompt: Prompt {
+                workspace: workspace.downgrade(),
+                id: notification,
+            },
+            _timeout: timeout,
+        };
+    }
+    send(id, ServerMsg::ApprovalPending { v: V2 }, cx);
+    log_line(
+        log::Level::Debug,
+        format!("devtools_bridge event=session_approval_pending session={id} {identity}"),
+    );
+}
+
+fn show_prompt(
+    workspace: &Entity<Workspace>,
+    notification: NotificationId,
+    id: &SessionId,
+    identity: &Identity,
+    cx: &mut App,
+) {
+    let message = format!(
+        "A browser extension ({}, {}) wants to read and drive your agent threads.",
+        identity.browser.code(),
+        loggable_extension_id(&identity.extension_id)
+    );
+    let allow = id.clone();
+    let deny = id.clone();
+    let closed = id.clone();
+    workspace.update(cx, |workspace, cx| {
+        workspace.show_notification(notification, cx, |cx| {
+            let prompt = cx.new(|cx| {
+                MessageNotification::new(message, cx)
+                    .primary_message("Allow")
+                    .primary_on_click(move |_, cx| {
+                        answer_approval(allow.clone(), ApprovalAnswer::Allow, cx)
+                    })
+                    .secondary_message("Deny")
+                    .secondary_on_click(move |_, cx| {
+                        answer_approval(deny.clone(), ApprovalAnswer::Deny, cx)
+                    })
+                    .show_suppress_button(false)
+            });
+            // The buttons answer first and then dismiss, so a session still pending here was
+            // closed with the X: nobody can answer it any more. Deferred: the workspace is
+            // being updated, and refusing dismisses through it.
+            cx.subscribe(&prompt, move |_, _, _: &DismissEvent, cx| {
+                let closed = closed.clone();
+                let app: &mut App = cx;
+                app.defer(move |cx| expire(&closed, "prompt_closed", cx));
+            })
+            .detach();
+            prompt
+        });
+    });
+}
+
+/// Ends a prompt nobody will answer: its 120 s ran out (R4.4) or it was closed with its X.
+/// Neither is a Deny, so the identity is asked again next time. `refuse` dismisses the prompt.
+fn expire(id: &SessionId, reason: &str, cx: &mut App) {
+    let pending = global(cx)
+        .sessions
+        .get(id)
+        .is_some_and(|state| matches!(state.approval, Approval::Pending { .. }));
+    if pending {
+        refuse(id, ChannelError::ApprovalTimeout, reason, cx);
+    }
+}
+
+/// Writes `identity` into the store after Allow, then welcomes every session of it still waiting;
+/// a store that fails leaves the saving ones unapproved and answers `approval_unavailable`. A
+/// revoke given after the Allow wins: nothing is written, and the revoke has already closed the
+/// sessions the Allow covered.
+fn save_approval(identity: Identity, cx: &mut App) {
+    let store = global(cx).store.clone();
+    let generation = store.generation();
+    let kvp = KeyValueStore::global(cx);
+    let key = identity.key();
+    let saved = cx.background_spawn(async move { store.add(&kvp, key, generation).await });
+    cx.spawn(async move |cx| {
+        let saved = saved.await;
+        cx.update(|cx| {
+            let waiting = sessions_of(&identity, cx);
+            match saved {
+                Ok(true) => {
+                    for id in waiting {
+                        // A prompt still shown in another session goes with the answer.
+                        forget_prompt(&id, cx);
+                        approve(&id, &identity, "allowed", cx);
+                    }
+                }
+                // A revoke came after the Allow and closed every session it covered; any
+                // session of the identity now waiting started after the revoke and keeps its
+                // own approval.
+                Ok(false) => {}
+                Err(error) => {
+                    for id in waiting {
+                        let saving = global(cx)
+                            .sessions
+                            .get(&id)
+                            .is_some_and(|state| matches!(state.approval, Approval::Saving));
+                        if saving {
+                            log_store_failed(&id, &identity, &error);
+                            refuse(&id, ChannelError::ApprovalUnavailable, "store_failed", cx);
+                        }
+                    }
+                }
+            }
+        });
+    })
+    .detach();
+}
+
+/// Dismisses `id`'s prompt, if it shows one, without ending the session.
+fn forget_prompt(id: &SessionId, cx: &mut App) {
+    if let Some(state) = global(cx).sessions.get_mut(id)
+        && matches!(state.approval, Approval::Pending { .. })
+    {
+        let pending = std::mem::replace(&mut state.approval, Approval::Saving);
+        if let Approval::Pending { prompt, .. } = pending {
+            prompt.dismiss(cx);
+        }
+    }
+}
+
+/// The identities the store holds. A value that is not a JSON array of strings reads as empty
+/// (the next Allow rewrites it), so a damaged value never locks every browser out.
+fn read_approved(store: &KeyValueStore) -> Result<Vec<String>> {
+    let Some(value) = store
+        .read_kvp(APPROVED_CLIENTS_KEY)
+        .context("reading the approved browser extensions")?
+    else {
+        return Ok(Vec::new());
+    };
+    Ok(serde_json::from_str(&value).unwrap_or_else(|error| {
+        log_line(
+            log::Level::Warn,
+            format!(
+                "devtools_bridge event=approval_store_unreadable key={APPROVED_CLIENTS_KEY} \
+                 reason={:?}",
+                error.to_string()
+            ),
+        );
+        Vec::new()
+    }))
+}
+
+fn approve(id: &SessionId, identity: &Identity, reason: &str, cx: &mut App) {
+    let hello_id = match global(cx).sessions.get_mut(id) {
+        Some(state) => {
+            state.approval = Approval::Approved;
+            state.hello_id.take()
+        }
+        None => return,
+    };
+    send(id, welcome(hello_id, cx), cx);
+    log_line(
+        log::Level::Info,
+        format!("devtools_bridge event=session_approved session={id} {identity} reason={reason}"),
+    );
+}
+
+/// Answers the session's `hello` with a fatal `error` and closes the session; its state goes,
+/// so a later message of it is ignored. A Deny is a decision, logged at info; every other
+/// refusal leaves a browser without access it may have wanted, logged at warn.
+fn refuse(id: &SessionId, error: ChannelError, reason: &str, cx: &mut App) {
+    let Some(state) = forget(id, cx) else {
+        return;
+    };
+    // The bridge closes the connection once it has written a fatal error; closing the sink
+    // ends a session whose writer is not the bridge's too.
+    state
+        .sink
+        .send(ServerMsg::error(state.hello_id, error))
+        .ok();
+    state.sink.close();
+    let identity = state
+        .identity
+        .as_ref()
+        .map_or_else(|| "browser=unknown".to_string(), ToString::to_string);
+    let level = if error == ChannelError::ApprovalDenied {
+        log::Level::Info
+    } else {
+        log::Level::Warn
+    };
+    log_line(
+        level,
+        format!("devtools_bridge event=session_refused session={id} {identity} reason={reason}"),
+    );
+}
+
+fn welcome(id: Option<String>, cx: &App) -> ServerMsg {
+    ServerMsg::Welcome {
+        v: V2,
+        id,
+        protocol: PROTOCOL_VERSION as i64,
+        zeo_version: release_channel::AppVersion::global(cx).to_string(),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Approved sessions
+
+/// A message of an approved session. With AI disabled, nothing reads a thread or acts in one:
+/// `subscribe`, `send` and `authorize` answer `ai_disabled` (R7.10).
+fn handle_approved(
+    session: &BrowserSession,
+    msg: ClientMsg,
+    app_state: Arc<AppState>,
+    cx: &mut App,
+) {
+    let started = Instant::now();
+    let kind = msg.kind();
+    let refused_while_ai_disabled = matches!(
+        msg,
+        ClientMsg::Subscribe { .. } | ClientMsg::Send(_) | ClientMsg::Authorize { .. }
+    );
+    let outcome = if refused_while_ai_disabled && DisableAiSettings::get_global(cx).disable_ai {
+        let id = msg.request_id().map(str::to_owned);
+        reply_error(&session.id, id, ChannelError::AiDisabled, cx)
+    } else {
+        match msg {
+            ClientMsg::ListThreads { id, .. } => list_threads(&session.id, id, cx),
+            ClientMsg::Subscribe { id, target, .. } => subscribe(&session.id, id, target, cx),
+            ClientMsg::Send(request) => send_message(&session.id, request, cx),
+            ClientMsg::Cancel { id, .. } => cancel(&session.id, id, cx),
+            ClientMsg::Authorize {
+                id,
+                request_id,
+                option_id,
+                ..
+            } => authorize(&session.id, id, &request_id, &option_id, cx),
+            ClientMsg::OpenInZeo { id, .. } => open_in_zeo(&session.id, id, app_state, cx),
+            // Answered before a session is approved.
+            ClientMsg::Hello { .. } => "ignored",
+        }
+    };
+    log_line(
+        log::Level::Debug,
+        format!(
+            "devtools_bridge event=session_msg session={} kind={kind} outcome={outcome} ms={}",
+            session.id,
+            started.elapsed().as_millis()
+        ),
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Listing, following and streaming (R5, R6)
+
+/// The most threads a `threads` reply lists (R5.1).
+const LISTED_THREADS: usize = 50;
+/// The most entries a snapshot carries; `earlier` counts the rest (R6.1).
+const SNAPSHOT_ENTRIES: usize = 100;
+/// The longest entry markdown sent, in bytes, before the truncation note (R6.6).
+const ENTRY_MARKDOWN_BYTES: usize = 64 * 1024;
+const TRUNCATION_NOTE: &str = "\n\n(truncated — open in Zeo for the rest)";
+/// At most one `entry_updated` per entry in this interval (R6.3).
+const ENTRY_UPDATE_INTERVAL: Duration = Duration::from_millis(100);
+
+/// What a session's subscription points at.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Target {
+    /// The thread of the most recently active window (R5.2, R5.3).
+    Follow,
+    /// One thread, by its `ThreadId` key, whatever becomes active (R5.4).
+    Pinned(String),
+}
+
+/// A session's subscription.
+struct Stream {
+    target: Target,
+    generation: u64,
+    /// The thread streamed; `None` while following nothing, or once the pinned thread closed.
+    attached: Option<Attached>,
+}
+
+/// The thread a session streams. Dropping it drops the thread subscription and every pending
+/// update timer.
+struct Attached {
+    thread_id: ThreadId,
+    thread: WeakEntity<AcpThread>,
+    /// The view showing the thread, which holds its error (R6.7).
+    view: WeakEntity<ThreadView>,
+    /// The last `status` the session was told.
+    status: Status,
+    /// Entries inside their coalescing interval.
+    updates: HashMap<usize, PendingUpdate>,
+    /// How many of the thread's entries the session holds. GPUI delivers a `NewEntry` after the
+    /// whole update, when the thread may already hold several new entries.
+    sent_entries: usize,
+    _subscriptions: [Subscription; 3],
+}
+
+struct PendingUpdate {
+    /// Updated since the last `entry_updated` was sent.
+    dirty: bool,
+    _timer: Task<()>,
+}
+
+/// A thread open in a window's agent panel.
+#[derive(Clone)]
+struct Located {
+    thread_id: ThreadId,
+    thread: Entity<AcpThread>,
+    view: Entity<ThreadView>,
+}
+
+/// Re-reviews every stream on window activation, window close, an agent panel's active-view
+/// change and a conversation's thread change. Installed by the first `subscribe`.
+#[derive(Default)]
+struct FollowHooks {
+    installed: bool,
+    review_scheduled: bool,
+    /// Each window's activation and its active-workspace change.
+    windows: HashMap<AnyWindowHandle, [Subscription; 2]>,
+    entities: HashMap<EntityId, Subscription>,
+    _global: Vec<Subscription>,
+}
+
+fn list_threads(id: &SessionId, request_id: String, cx: &mut App) -> &'static str {
+    let followed = followed_thread(cx).map(|located| located.thread_id);
+    let mut items: Vec<ThreadInfo> = open_threads(cx)
+        .iter()
+        .map(|located| thread_info(located, followed == Some(located.thread_id), cx))
+        .collect();
+    // Stable: after the followed thread, the most recently active window's threads first.
+    items.sort_by_key(|item| !item.followed);
+    items.truncate(LISTED_THREADS);
+    send(
+        id,
+        ServerMsg::Threads {
+            v: V2,
+            id: request_id,
+            items,
+        },
+        cx,
+    );
+    "threads"
+}
+
+fn subscribe(
+    id: &SessionId,
+    request_id: String,
+    target: SubscribeTarget,
+    cx: &mut App,
+) -> &'static str {
+    let (target, located) = match target {
+        SubscribeTarget::Follow => (Target::Follow, followed_thread(cx)),
+        SubscribeTarget::Thread { thread_id } => match find_thread(&thread_id, cx) {
+            Some(located) => (Target::Pinned(thread_id), Some(located)),
+            // A pinned thread restored after its window closed, or never known here.
+            None => {
+                send(
+                    id,
+                    ServerMsg::error(Some(request_id), ChannelError::ThreadClosed),
+                    cx,
+                );
+                return "thread_closed";
+            }
+        },
+    };
+    install_hooks(cx);
+    attach(id, target, located, Some(request_id), cx);
+    "snapshot"
+}
+
+/// Points session `id` at `located`, or at nothing, dropping its previous subscription, and
+/// sends the snapshot, echoing `request_id` when a `subscribe` asked for it.
+fn attach(
+    id: &SessionId,
+    target: Target,
+    located: Option<Located>,
+    request_id: Option<String>,
+    cx: &mut App,
+) {
+    let channel = global(cx);
+    if !channel.sessions.contains_key(id) {
+        return;
+    }
+    channel.next_stream += 1;
+    let generation = channel.next_stream;
+    let snapshot = snapshot(located.as_ref(), request_id, cx);
+    let attached = located.map(|located| {
+        let status = thread_status(located.view.read(cx), cx);
+        let sent_entries = located.thread.read(cx).entries().len();
+        let events = cx.subscribe(&located.thread, {
+            let id = id.clone();
+            move |thread, event, cx| on_thread_event(&id, generation, &thread, event, cx)
+        });
+        let released = cx.observe_release(&located.thread, |_, cx| schedule_review(cx));
+        // The view stores a failed turn's error after the thread's `Error` event.
+        let view_changed = cx.observe(&located.view, {
+            let id = id.clone();
+            move |_, cx| send_status(&id, generation, cx)
+        });
+        Attached {
+            thread_id: located.thread_id,
+            thread: located.thread.downgrade(),
+            view: located.view.downgrade(),
+            status,
+            updates: HashMap::default(),
+            sent_entries,
+            _subscriptions: [events, released, view_changed],
+        }
+    });
+    let Some(state) = global(cx).sessions.get_mut(id) else {
+        return;
+    };
+    state.stream = Some(Stream {
+        target,
+        generation,
+        attached,
+    });
+    stream_send(id, snapshot, cx);
+}
+
+/// The snapshot of `located`: its last [`SNAPSHOT_ENTRIES`] entries, fewer when they would not
+/// fit one line, the oldest dropped first and counted in `earlier` (R6.1, R3.10).
+fn snapshot(located: Option<&Located>, request_id: Option<String>, cx: &App) -> ServerMsg {
+    let Some(located) = located else {
+        return ServerMsg::Snapshot {
+            v: V2,
+            id: request_id,
+            thread: None,
+            earlier: 0,
+            entries: Vec::new(),
+            status: Status {
+                state: ThreadState::Idle,
+                message: None,
+            },
+            permissions: Vec::new(),
+            subagents: Vec::new(),
+        };
+    };
+    let followed = followed_thread(cx).map(|followed| followed.thread_id);
+    let info = thread_info(located, followed == Some(located.thread_id), cx);
+    let thread = located.thread.read(cx);
+    let all = thread.entries();
+    let first = all.len().saturating_sub(SNAPSHOT_ENTRIES);
+    let mut entries: Vec<Entry> = all[first..]
+        .iter()
+        .map(|entry| wire_entry(entry, cx))
+        .collect();
+    let status = thread_status(located.view.read(cx), cx);
+    let permissions: Vec<Permission> = thread
+        .pending_permission_requests()
+        .filter_map(|request| wire_permission(thread, request.id, cx))
+        .collect();
+    // The same rows the tasks card reads, so the sidebar and Zeo agree on a child's status.
+    let subagents: Vec<SubagentInfo> = acp_thread::subagent_rows::subagent_rows(thread, cx)
+        .into_iter()
+        .map(|row| SubagentInfo {
+            title: row.label.to_string(),
+            status: wire_subagent_state(row.status),
+        })
+        .collect();
+
+    // An upper bound of the line: the envelope with the widest `earlier`, plus each entry and
+    // its comma. Dropping the oldest until it fits keeps the line under the cap.
+    let envelope = ServerMsg::Snapshot {
+        v: V2,
+        id: request_id.clone(),
+        thread: Some(info.clone()),
+        earlier: all.len() as u64,
+        entries: Vec::new(),
+        status: status.clone(),
+        permissions: permissions.clone(),
+        subagents: subagents.clone(),
+    };
+    let sizes: Vec<usize> = entries.iter().map(|entry| encoded_len(entry) + 1).collect();
+    let mut line = encoded_len(&envelope) + sizes.iter().sum::<usize>();
+    let mut dropped = 0;
+    while line > MAX_SERVER_LINE_BYTES && dropped < sizes.len() {
+        line -= sizes[dropped];
+        dropped += 1;
+    }
+    entries.drain(..dropped);
+    ServerMsg::Snapshot {
+        v: V2,
+        id: request_id,
+        thread: Some(info),
+        earlier: (first + dropped) as u64,
+        entries,
+        status,
+        permissions,
+        subagents,
+    }
+}
+
+fn wire_subagent_state(status: acp_thread::subagent_rows::SubagentRowStatus) -> SubagentState {
+    use acp_thread::subagent_rows::SubagentRowStatus;
+    match status {
+        SubagentRowStatus::Running => SubagentState::Running,
+        SubagentRowStatus::Waiting => SubagentState::Waiting,
+        SubagentRowStatus::Done => SubagentState::Done,
+        SubagentRowStatus::Failed => SubagentState::Failed,
+        SubagentRowStatus::Canceled => SubagentState::Canceled,
+        SubagentRowStatus::Unknown => SubagentState::Unknown,
+    }
+}
+
+fn encoded_len(value: &impl serde::Serialize) -> usize {
+    // These types always serialise; a failure counts as too long, so it is dropped.
+    serde_json::to_vec(value).map_or(MAX_SERVER_LINE_BYTES + 1, |line| line.len())
+}
+
+/// Every thread open in a window's agent panel, the most recently active window's first.
+fn open_threads(cx: &App) -> Vec<Located> {
+    let mut seen = HashSet::new();
+    open_views(cx)
+        .iter()
+        .filter_map(|view| locate(view, cx))
+        .filter(|located| seen.insert(located.thread_id))
+        .collect()
+}
+
+/// Every conversation open in a window's agent panel, the most recently active window's first.
+fn open_views(cx: &App) -> Vec<Entity<ConversationView>> {
+    workspaces_by_recency(cx)
+        .into_iter()
+        .flat_map(|(_, workspaces)| workspaces)
+        .filter_map(|workspace| workspace.read(cx).panel::<AgentPanel>(cx))
+        .flat_map(|panel| panel.read(cx).conversation_views())
+        .collect()
+}
+
+/// The `ThreadId` of every conversation open in a window's agent panel, loaded or not.
+fn open_thread_ids(cx: &App) -> HashSet<ThreadId> {
+    open_views(cx)
+        .iter()
+        .map(|view| view.read(cx).thread_id)
+        .collect()
+}
+
+fn locate(view: &Entity<ConversationView>, cx: &App) -> Option<Located> {
+    let conversation = view.read(cx);
+    let thread_view = conversation.root_thread_view()?;
+    Some(Located {
+        thread_id: conversation.thread_id,
+        thread: thread_view.read(cx).thread.clone(),
+        view: thread_view,
+    })
+}
+
+/// The thread the agent panel of the most recently active window shows (R5.2).
+fn followed_thread(cx: &App) -> Option<Located> {
+    let (_, workspace) = most_recent_window(cx)?;
+    let panel = workspace.read(cx).panel::<AgentPanel>(cx)?;
+    let view = panel.read(cx).active_conversation_view()?.clone();
+    locate(&view, cx)
+}
+
+fn find_thread(thread_id: &str, cx: &App) -> Option<Located> {
+    open_threads(cx)
+        .into_iter()
+        .find(|located| located.thread_id.to_key_string() == thread_id)
+}
+
+fn thread_info(located: &Located, followed: bool, cx: &App) -> ThreadInfo {
+    let thread = located.thread.read(cx);
+    let project = thread
+        .project()
+        .read(cx)
+        .visible_worktrees(cx)
+        .next()
+        .map(|worktree| worktree.read(cx).root_name_str().to_string())
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| "No project".to_string());
+    ThreadInfo {
+        thread_id: located.thread_id.to_key_string(),
+        title: thread_title(thread),
+        project,
+        agent: thread.connection().agent_id().to_string(),
+        status: thread_status(located.view.read(cx), cx).state,
+        followed,
+    }
+}
+
+fn thread_title(thread: &AcpThread) -> String {
+    thread
+        .title()
+        .filter(|title| !title.trim().is_empty())
+        .map_or_else(
+            || DEFAULT_THREAD_TITLE.to_string(),
+            |title| capped_title(&title),
+        )
+}
+
+/// A permission waiting outranks generating; an error shows once the thread has stopped, with
+/// the message of the error its view shows, which the view drops when a new turn starts (R6.7).
+/// The message is the operator's to read, never logged (R13.4).
+fn thread_status(view: &ThreadView, cx: &App) -> Status {
+    let thread = view.thread.read(cx);
+    let (state, message) = if thread.pending_permission_requests().next().is_some() {
+        (ThreadState::AwaitingPermission, None)
+    } else if thread.status() == ThreadStatus::Generating {
+        (ThreadState::Working, None)
+    } else if thread.status() == ThreadStatus::Unconfirmed {
+        (ThreadState::Unconfirmed, None)
+    } else if let Some(error) = view.thread_error_text(cx) {
+        (ThreadState::Error, Some(capped_title(&error)))
+    } else {
+        (ThreadState::Idle, None)
+    };
+    Status { state, message }
+}
+
+/// An entry as the sidebar shows it: `to_markdown` capped at [`ENTRY_MARKDOWN_BYTES`], and a
+/// question asked by the agent without its text (R6.5, R6.6).
+fn wire_entry(entry: &AgentThreadEntry, cx: &App) -> Entry {
+    let (role, tool) = match entry {
+        AgentThreadEntry::UserMessage(_) => (EntryRole::User, None),
+        AgentThreadEntry::AssistantMessage(_) => (EntryRole::Assistant, None),
+        // A message between this session and a subagent: the wire has no role for it, and
+        // its markdown already names both sessions.
+        AgentThreadEntry::SessionMessage(_) => (EntryRole::Assistant, None),
+        AgentThreadEntry::ToolCall(call) => (
+            EntryRole::Tool,
+            Some(EntryTool {
+                title: capped_title(call.label.read(cx).source()),
+                status: tool_status(call.status()),
+            }),
+        ),
+        AgentThreadEntry::Elicitation(_) => {
+            return Entry {
+                role: EntryRole::Question,
+                markdown: String::new(),
+                truncated: false,
+                tool: None,
+            };
+        }
+        AgentThreadEntry::ContextCompaction(_) => (EntryRole::Compaction, None),
+    };
+    let markdown = match entry {
+        AgentThreadEntry::AssistantMessage(message) => assistant_markdown(message, cx),
+        entry => entry.to_markdown(cx),
+    };
+    let (markdown, truncated) = capped_markdown(markdown);
+    Entry {
+        role,
+        markdown,
+        truncated,
+        tool,
+    }
+}
+
+/// `AssistantMessage::to_markdown`, but over the received text: the thread reveals streamed text
+/// to its own view gradually, and the sidebar must end on the final text (R6.3).
+fn assistant_markdown(message: &AssistantMessage, cx: &App) -> String {
+    let chunks: Vec<String> = message
+        .chunks
+        .iter()
+        .map(|chunk| match chunk {
+            AssistantMessageChunk::Message { block, .. } => received_markdown(block, cx),
+            AssistantMessageChunk::Thought { block, .. } => {
+                format!("<thinking>\n{}\n</thinking>", received_markdown(block, cx))
+            }
+        })
+        .collect();
+    format!("## Assistant\n\n{}\n\n", chunks.join("\n\n"))
+}
+
+/// The received text of `content` when it is text alone, else what its view renders.
+fn received_markdown(content: &MessageContent, cx: &App) -> String {
+    let sources = content.source_blocks();
+    let text_only = !sources.is_empty()
+        && sources
+            .iter()
+            .all(|source| matches!(source, acp_v2::ContentBlock::Text(_)));
+    if !text_only {
+        return content.to_markdown(cx);
+    }
+    sources
+        .iter()
+        .filter_map(|source| match source {
+            acp_v2::ContentBlock::Text(text) => Some(text.text.as_str()),
+            _ => None,
+        })
+        .collect()
+}
+
+/// The longest tool title, permission title, option label, thread title or error message sent,
+/// in bytes. A title can be a whole command (a heredoc), and one line must stay under the cap
+/// (R3.10).
+const TITLE_BYTES: usize = 4 * 1024;
+
+/// `text` cut to [`TITLE_BYTES`] on a character boundary, with an ellipsis when cut.
+fn capped_title(text: &str) -> String {
+    if text.len() <= TITLE_BYTES {
+        return text.to_string();
+    }
+    let mut end = TITLE_BYTES;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    format!("{}…", &text[..end])
+}
+
+fn capped_markdown(mut markdown: String) -> (String, bool) {
+    if markdown.len() <= ENTRY_MARKDOWN_BYTES {
+        return (markdown, false);
+    }
+    let mut end = ENTRY_MARKDOWN_BYTES;
+    while !markdown.is_char_boundary(end) {
+        end -= 1;
+    }
+    markdown.truncate(end);
+    markdown.push_str(TRUNCATION_NOTE);
+    (markdown, true)
+}
+
+fn tool_status(status: ToolCallStatus) -> ToolStatus {
+    match status {
+        ToolCallStatus::Pending => ToolStatus::Pending,
+        ToolCallStatus::WaitingForConfirmation => ToolStatus::AwaitingPermission,
+        // ACP 5.0.0 added `Paused`; the wire contract of zeo-browser has no such state, and a
+        // paused call has started and not finished, which is what "in progress" tells it.
+        ToolCallStatus::InProgress | ToolCallStatus::Paused => ToolStatus::InProgress,
+        ToolCallStatus::Completed => ToolStatus::Completed,
+        ToolCallStatus::Failed => ToolStatus::Failed,
+        // The wire has no "rejected": a rejected call never ran, as a canceled one.
+        ToolCallStatus::Rejected | ToolCallStatus::Canceled => ToolStatus::Canceled,
+    }
+}
+
+/// The pending permission `request` of `thread`; `entry_index` is its tool call's thread index.
+fn wire_permission(
+    thread: &AcpThread,
+    request: PermissionRequestId,
+    cx: &App,
+) -> Option<Permission> {
+    let pending = thread.permission_request(request)?;
+    let request_id = permission_request_id(request);
+    if let Some(tool_call_id) = pending.legacy_tool_call_id() {
+        let (index, call) = thread.tool_call(tool_call_id)?;
+        return Some(Permission {
+            request_id,
+            entry_index: index as u64,
+            title: capped_title(call.label.read(cx).source()),
+            options: pending
+                .legacy_options()
+                .map(wire_options)
+                .unwrap_or_default(),
+        });
+    }
+    // A request that names no tool call belongs to where the thread stands.
+    let generic = pending.generic_request()?;
+    Some(Permission {
+        request_id,
+        entry_index: thread.entries().len().saturating_sub(1) as u64,
+        title: capped_title(&generic.title),
+        options: generic
+            .options
+            .iter()
+            .filter_map(|option| wire_option(option, option.option_id.0.to_string()))
+            .collect(),
+    })
+}
+
+/// The options of a permission request. A dropdown's choices can share an option id, told apart
+/// only by the pattern a choice carries ("Always for terminal" and "Always for `cargo build`
+/// commands" are both `always_allow:terminal`), so each choice's allow and deny are named by
+/// the choice instead: `<choice index>:allow` and `<choice index>:deny` (see [`selected_outcome`]).
+fn wire_options(options: &PermissionOptions) -> Vec<PermissionOption> {
+    match options {
+        PermissionOptions::Flat(options) => options
+            .iter()
+            .filter_map(|option| wire_option(option, option.option_id.0.to_string()))
+            .collect(),
+        PermissionOptions::Dropdown(choices)
+        | PermissionOptions::DropdownWithPatterns { choices, .. } => choices
+            .iter()
+            .enumerate()
+            .flat_map(|(index, choice)| {
+                [
+                    wire_option(&choice.allow, choice_option_id(index, true)),
+                    wire_option(&choice.deny, choice_option_id(index, false)),
+                ]
+            })
+            .flatten()
+            .collect(),
+    }
+}
+
+fn choice_option_id(index: usize, allow: bool) -> String {
+    format!("{index}:{}", if allow { "allow" } else { "deny" })
+}
+
+/// `option`, named `option_id` on the wire; a kind newer than the contract is left out.
+fn wire_option(option: &acp_v2::PermissionOption, option_id: String) -> Option<PermissionOption> {
+    let kind = match option.kind {
+        acp_v2::PermissionOptionKind::AllowOnce => PermissionOptionKind::AllowOnce,
+        acp_v2::PermissionOptionKind::AllowAlways => PermissionOptionKind::AllowAlways,
+        acp_v2::PermissionOptionKind::RejectOnce => PermissionOptionKind::RejectOnce,
+        acp_v2::PermissionOptionKind::RejectAlways => PermissionOptionKind::RejectAlways,
+        _ => return None,
+    };
+    Some(PermissionOption {
+        option_id,
+        label: capped_title(&option.name),
+        kind,
+    })
+}
+
+/// The id's own serialised form (a UUID), so the wire and the thread name a request alike.
+fn permission_request_id(id: PermissionRequestId) -> String {
+    match serde_json::to_value(id) {
+        Ok(serde_json::Value::String(id)) => id,
+        _ => format!("{id:?}"),
+    }
+}
+
+fn on_thread_event(
+    id: &SessionId,
+    generation: u64,
+    thread: &Entity<AcpThread>,
+    event: &AcpThreadEvent,
+    cx: &mut App,
+) {
+    if attached_mut(id, generation, cx).is_none() {
+        return;
+    }
+    match event {
+        AcpThreadEvent::NewEntry => {
+            let Some(sent) = attached_mut(id, generation, cx).map(|attached| attached.sent_entries)
+            else {
+                return;
+            };
+            let added: Vec<ServerMsg> = {
+                let thread = thread.read(cx);
+                let entries = thread.entries();
+                entries
+                    .iter()
+                    .enumerate()
+                    .skip(sent)
+                    .map(|(index, entry)| ServerMsg::EntryAdded {
+                        v: V2,
+                        index: index as u64,
+                        entry: wire_entry(entry, cx),
+                    })
+                    .collect()
+            };
+            let len = sent + added.len();
+            if let Some(attached) = attached_mut(id, generation, cx) {
+                attached.sent_entries = len;
+            }
+            for added in added {
+                if !stream_send(id, added, cx) {
+                    return;
+                }
+            }
+        }
+        AcpThreadEvent::EntryUpdated(index) => entry_updated(id, generation, thread, *index, cx),
+        AcpThreadEvent::EntriesRemoved(range) => {
+            if let Some(attached) = attached_mut(id, generation, cx) {
+                attached.updates.retain(|index, _| *index < range.start);
+                attached.sent_entries = attached.sent_entries.min(range.start);
+            }
+            let removed = ServerMsg::EntriesRemoved {
+                v: V2,
+                start: range.start as u64,
+                end: range.end as u64,
+            };
+            stream_send(id, removed, cx);
+        }
+        AcpThreadEvent::StatusChanged | AcpThreadEvent::Error => send_status(id, generation, cx),
+        AcpThreadEvent::Stopped { .. } => {
+            // A stream must never end on a partial message.
+            flush_updates(id, generation, thread, cx);
+            send_status(id, generation, cx);
+        }
+        AcpThreadEvent::ToolAuthorizationRequested(request) => {
+            let permission = wire_permission(thread.read(cx), *request, cx);
+            if let Some(permission) = permission
+                && !stream_send(id, ServerMsg::PermissionRequested { v: V2, permission }, cx)
+            {
+                return;
+            }
+            send_status(id, generation, cx);
+        }
+        AcpThreadEvent::ToolAuthorizationReceived(request) => {
+            let resolved = ServerMsg::PermissionResolved {
+                v: V2,
+                request_id: permission_request_id(*request),
+            };
+            if stream_send(id, resolved, cx) {
+                send_status(id, generation, cx);
+            }
+        }
+        AcpThreadEvent::TitleUpdated => {
+            let title = thread_title(thread.read(cx));
+            stream_send(id, ServerMsg::Title { v: V2, title }, cx);
+        }
+        _ => {}
+    }
+}
+
+/// The streamed thread of session `id`, if its subscription is still `generation`.
+fn attached_mut<'a>(id: &SessionId, generation: u64, cx: &'a mut App) -> Option<&'a mut Attached> {
+    global(cx)
+        .sessions
+        .get_mut(id)?
+        .stream
+        .as_mut()
+        .filter(|stream| stream.generation == generation)?
+        .attached
+        .as_mut()
+}
+
+/// Sends the thread's status when it differs from the last one sent.
+fn send_status(id: &SessionId, generation: u64, cx: &mut App) {
+    let Some(view) = attached_mut(id, generation, cx).and_then(|attached| attached.view.upgrade())
+    else {
+        return;
+    };
+    let status = thread_status(view.read(cx), cx);
+    let Some(attached) = attached_mut(id, generation, cx) else {
+        return;
+    };
+    if attached.status == status {
+        return;
+    }
+    attached.status = status.clone();
+    stream_send(id, ServerMsg::Status { v: V2, status }, cx);
+}
+
+/// Sends an update at once when the entry is outside its interval, else marks it for the
+/// interval's end: at most one `entry_updated` per entry per [`ENTRY_UPDATE_INTERVAL`] (R6.3).
+fn entry_updated(
+    id: &SessionId,
+    generation: u64,
+    thread: &Entity<AcpThread>,
+    index: usize,
+    cx: &mut App,
+) {
+    if let Some(pending) =
+        attached_mut(id, generation, cx).and_then(|attached| attached.updates.get_mut(&index))
+    {
+        pending.dirty = true;
+        return;
+    }
+    start_interval(id, generation, index, cx);
+    send_entry_update(id, thread, index, cx);
+}
+
+fn start_interval(id: &SessionId, generation: u64, index: usize, cx: &mut App) {
+    let timer = cx.spawn({
+        let id = id.clone();
+        async move |cx| {
+            cx.background_executor().timer(ENTRY_UPDATE_INTERVAL).await;
+            cx.update(|cx| interval_ended(&id, generation, index, cx));
+        }
+    });
+    if let Some(attached) = attached_mut(id, generation, cx) {
+        attached.updates.insert(
+            index,
+            PendingUpdate {
+                dirty: false,
+                _timer: timer,
+            },
+        );
+    }
+}
+
+/// The trailing flush: an entry updated during the interval is sent in its latest state and
+/// starts another interval; an idle one leaves the coalescer.
+fn interval_ended(id: &SessionId, generation: u64, index: usize, cx: &mut App) {
+    let Some(attached) = attached_mut(id, generation, cx) else {
+        return;
+    };
+    let dirty = attached
+        .updates
+        .get(&index)
+        .is_some_and(|pending| pending.dirty);
+    let thread = attached.thread.upgrade();
+    let (true, Some(thread)) = (dirty, thread) else {
+        attached.updates.remove(&index);
+        return;
+    };
+    start_interval(id, generation, index, cx);
+    send_entry_update(id, &thread, index, cx);
+}
+
+/// Sends every update still held back, in entry order, and ends their intervals.
+fn flush_updates(id: &SessionId, generation: u64, thread: &Entity<AcpThread>, cx: &mut App) {
+    let Some(attached) = attached_mut(id, generation, cx) else {
+        return;
+    };
+    let mut dirty: Vec<usize> = attached
+        .updates
+        .drain()
+        .filter(|(_, pending)| pending.dirty)
+        .map(|(index, _)| index)
+        .collect();
+    dirty.sort_unstable();
+    for index in dirty {
+        send_entry_update(id, thread, index, cx);
+    }
+}
+
+fn send_entry_update(id: &SessionId, thread: &Entity<AcpThread>, index: usize, cx: &mut App) {
+    let updated = {
+        let thread = thread.read(cx);
+        thread
+            .entries()
+            .get(index)
+            .map(|entry| ServerMsg::EntryUpdated {
+                v: V2,
+                index: index as u64,
+                entry: wire_entry(entry, cx),
+            })
+    };
+    if let Some(updated) = updated {
+        stream_send(id, updated, cx);
+    }
+}
+
+/// Sends a stream message to session `id`. A sink that has closed takes the subscription with
+/// it; a full one has already overflowed the session (`overloaded`).
+fn stream_send(id: &SessionId, msg: ServerMsg, cx: &mut App) -> bool {
+    let Some(state) = global(cx).sessions.get_mut(id) else {
+        return false;
+    };
+    if state.sink.send(msg).is_ok() {
+        return true;
+    }
+    state.stream = None;
+    log_line(
+        log::Level::Debug,
+        format!("devtools_bridge event=stream_dropped session={id} reason=session_closing"),
+    );
+    false
+}
+
+fn install_hooks(cx: &mut App) {
+    if !global(cx).hooks.installed {
+        let windows = cx.observe_new(|_: &mut MultiWorkspace, _, cx| {
+            let app: &mut App = cx;
+            app.defer(hook_open_views);
+        });
+        let panels = cx.observe_new(|_: &mut AgentPanel, _, cx| {
+            let app: &mut App = cx;
+            app.defer(hook_open_views);
+        });
+        let views = cx.observe_new(|_: &mut ConversationView, _, cx| {
+            let app: &mut App = cx;
+            app.defer(hook_open_views);
+        });
+        let closed = cx.on_window_closed(|cx, _| schedule_review(cx));
+        let hooks = &mut global(cx).hooks;
+        hooks.installed = true;
+        hooks._global = vec![windows, panels, views, closed];
+    }
+    hook_open_views(cx);
+}
+
+/// Hooks every open window, agent panel and conversation not hooked yet, and forgets the gone.
+fn hook_open_views(cx: &mut App) {
+    let mut windows = Vec::new();
+    let mut panels = Vec::new();
+    let mut views = Vec::new();
+    for (window, workspaces) in workspaces_by_recency(cx) {
+        windows.push(window);
+        for workspace in workspaces {
+            if let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) {
+                views.extend(panel.read(cx).conversation_views());
+                panels.push(panel);
+            }
+        }
+    }
+    let hooks = &mut global(cx).hooks;
+    hooks.windows.retain(|window, _| windows.contains(window));
+    let live: HashSet<EntityId> = panels
+        .iter()
+        .map(|panel| panel.entity_id())
+        .chain(views.iter().map(|view| view.entity_id()))
+        .collect();
+    hooks.entities.retain(|entity, _| live.contains(entity));
+    windows.retain(|window| !hooks.windows.contains_key(window));
+    panels.retain(|panel| !hooks.entities.contains_key(&panel.entity_id()));
+    views.retain(|view| !hooks.entities.contains_key(&view.entity_id()));
+
+    for window in windows {
+        let Some(handle) = window.downcast::<MultiWorkspace>() else {
+            continue;
+        };
+        let activation = handle.update(cx, |_, window, cx| {
+            let activation = cx.observe_window_activation(window, |_, window, cx| {
+                if window.is_window_active() {
+                    schedule_review(cx);
+                }
+            });
+            (activation, cx.entity())
+        });
+        let Ok((activation, multi_workspace)) = activation else {
+            continue;
+        };
+        // Switching workspaces inside one window changes the followed thread too (R5.3).
+        let workspace_switch =
+            cx.subscribe(&multi_workspace, |_, event: &MultiWorkspaceEvent, cx| {
+                if matches!(event, MultiWorkspaceEvent::ActiveWorkspaceChanged { .. }) {
+                    schedule_review(cx);
+                }
+            });
+        global(cx)
+            .hooks
+            .windows
+            .insert(window, [activation, workspace_switch]);
+    }
+    for panel in panels {
+        let hook = cx.subscribe(&panel, |_, event: &AgentPanelEvent, cx| {
+            if matches!(event, AgentPanelEvent::ActiveViewChanged) {
+                schedule_review(cx);
+            }
+        });
+        global(cx).hooks.entities.insert(panel.entity_id(), hook);
+    }
+    for view in views {
+        let hook = cx.subscribe(&view, |_, event: &AcpServerViewEvent, cx| {
+            if matches!(event, AcpServerViewEvent::ActiveThreadChanged) {
+                schedule_review(cx);
+            }
+        });
+        global(cx).hooks.entities.insert(view.entity_id(), hook);
+    }
+}
+
+/// Reviews every stream once the current update has ended: windows are leased during it.
+fn schedule_review(cx: &mut App) {
+    let hooks = &mut global(cx).hooks;
+    if hooks.review_scheduled {
+        return;
+    }
+    hooks.review_scheduled = true;
+    cx.defer(|cx| {
+        global(cx).hooks.review_scheduled = false;
+        review_streams(cx);
+    });
+}
+
+/// Tells every session whose thread closed (R5.5), then moves every following session to the
+/// thread now followed: `target_changed`, then a fresh `snapshot` (R5.3).
+fn review_streams(cx: &mut App) {
+    if !global(cx)
+        .sessions
+        .values()
+        .any(|state| state.stream.is_some())
+    {
+        return;
+    }
+    // A conversation still loading (a reconnect, a retry) is open: its thread comes back.
+    let open = open_thread_ids(cx);
+    let closed: Vec<SessionId> = global(cx)
+        .sessions
+        .iter()
+        .filter(|(_, state)| {
+            state
+                .stream
+                .as_ref()
+                .and_then(|stream| stream.attached.as_ref())
+                .is_some_and(|attached| !open.contains(&attached.thread_id))
+        })
+        .map(|(id, _)| id.clone())
+        .collect();
+    for id in closed {
+        if let Some(stream) = global(cx)
+            .sessions
+            .get_mut(&id)
+            .and_then(|state| state.stream.as_mut())
+        {
+            stream.attached = None;
+        }
+        if stream_send(&id, ServerMsg::ThreadClosed { v: V2 }, cx) {
+            log_line(
+                log::Level::Debug,
+                format!("devtools_bridge event=stream_thread_closed session={id}"),
+            );
+        }
+    }
+
+    // A conversation that reconnected holds a new `AcpThread` under the same `ThreadId`: the
+    // session stays on it, with a fresh snapshot (R5.4).
+    let loaded = open_threads(cx);
+    let rebuilt: Vec<(SessionId, Target, Located)> = global(cx)
+        .sessions
+        .iter()
+        .filter_map(|(id, state)| {
+            let stream = state.stream.as_ref()?;
+            let attached = stream.attached.as_ref()?;
+            let current = loaded
+                .iter()
+                .find(|located| located.thread_id == attached.thread_id)?;
+            (current.thread.entity_id() != attached.thread.entity_id())
+                .then(|| (id.clone(), stream.target.clone(), current.clone()))
+        })
+        .collect();
+    for (id, target, located) in rebuilt {
+        attach(&id, target, Some(located), None, cx);
+        log_line(
+            log::Level::Debug,
+            format!("devtools_bridge event=stream_reattached session={id}"),
+        );
+    }
+
+    let followed = followed_thread(cx);
+    let followed_id = followed.as_ref().map(|located| located.thread_id);
+    let moved: Vec<SessionId> = global(cx)
+        .sessions
+        .iter()
+        .filter(|(_, state)| {
+            state.stream.as_ref().is_some_and(|stream| {
+                stream.target == Target::Follow
+                    && stream.attached.as_ref().map(|attached| attached.thread_id) != followed_id
+            })
+        })
+        .map(|(id, _)| id.clone())
+        .collect();
+    for id in moved {
+        let thread = followed
+            .as_ref()
+            .map(|located| thread_info(located, true, cx));
+        if !stream_send(&id, ServerMsg::TargetChanged { v: V2, thread }, cx) {
+            continue;
+        }
+        attach(&id, Target::Follow, followed.clone(), None, cx);
+        log_line(
+            log::Level::Debug,
+            format!(
+                "devtools_bridge event=stream_retargeted session={id} thread={}",
+                followed_id.map_or_else(|| "none".to_string(), |id| id.to_key_string())
+            ),
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Driving a thread: send, stop, authorize, open in Zeo (R7, R5.7)
+
+/// The thread a session acts on, with the window, panel and views holding it.
+struct Driven {
+    window: AnyWindowHandle,
+    workspace: Entity<Workspace>,
+    panel: Entity<AgentPanel>,
+    conversation: Entity<ConversationView>,
+    view: Entity<ThreadView>,
+    thread: Entity<AcpThread>,
+    thread_id: ThreadId,
+}
+
+/// The thread session `id` acts on: the one it streams, else the followed one (a session that
+/// never subscribed follows). A pinned thread that closed is `thread_closed`; nothing to follow
+/// is `no_thread`.
+fn driven_thread(id: &SessionId, cx: &mut App) -> Result<Driven, ChannelError> {
+    let (pinned, attached) = match global(cx)
+        .sessions
+        .get(id)
+        .and_then(|state| state.stream.as_ref())
+    {
+        Some(stream) => (
+            matches!(stream.target, Target::Pinned(_)),
+            stream
+                .attached
+                .as_ref()
+                .and_then(|attached| attached.thread.upgrade()),
+        ),
+        None => (false, None),
+    };
+    let thread = match attached {
+        Some(thread) => thread,
+        None if pinned => return Err(ChannelError::ThreadClosed),
+        None => followed_thread(cx).ok_or(ChannelError::NoThread)?.thread,
+    };
+    holder_of(&thread, cx).ok_or(ChannelError::ThreadClosed)
+}
+
+/// Where `thread` is shown as the root thread of a conversation in an agent panel.
+fn holder_of(thread: &Entity<AcpThread>, cx: &App) -> Option<Driven> {
+    for (window, workspaces) in workspaces_by_recency(cx) {
+        for workspace in workspaces {
+            let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) else {
+                continue;
+            };
+            for conversation in panel.read(cx).conversation_views() {
+                let Some(view) = conversation.read(cx).root_thread_view() else {
+                    continue;
+                };
+                if view.read(cx).thread.entity_id() == thread.entity_id() {
+                    let thread_id = conversation.read(cx).thread_id;
+                    return Some(Driven {
+                        window,
+                        workspace,
+                        panel,
+                        conversation,
+                        view,
+                        thread: thread.clone(),
+                        thread_id,
+                    });
+                }
+            }
+        }
+    }
+    None
+}
+
+/// Sends `request` to the session's thread as the operator would, without the window's
+/// composer: a detached composer of the thread gets the text, one browser chip per element and
+/// capture, and the images when the agent takes them, then goes through the thread view's
+/// queue-or-send path (R7.1–R7.3, R7.9, R10.5). Answered once the thread has taken the message
+/// or it is in Zeo's queue.
+fn send_message(id: &SessionId, request: SendRequest, cx: &mut App) -> &'static str {
+    let SendRequest {
+        id: request_id,
+        text,
+        attachments,
+        ..
+    } = request;
+    let driven = match driven_thread(id, cx) {
+        Ok(driven) => driven,
+        Err(error) => return reply_error(id, Some(request_id), error, cx),
+    };
+    let attachment_count = attachments.len();
+    let mut contents = Vec::new();
+    let mut images = Vec::new();
+    for attachment in attachments {
+        match attachment {
+            Attachment::Image(image) => images.push(image),
+            other => contents.extend(other.into_browser_content()),
+        }
+    }
+    let supports_images = driven
+        .view
+        .read(cx)
+        .session_capabilities
+        .read()
+        .supports_images();
+    let sent_images = match (images.is_empty(), supports_images) {
+        (true, _) => SentImages::None,
+        (false, true) => SentImages::Included,
+        (false, false) => SentImages::SkippedUnsupported,
+    };
+    let images = if sent_images == SentImages::Included {
+        match decode_images(&images) {
+            Ok(images) => images,
+            Err(error) => return send_failed(id, request_id, &error, "image_undecodable", cx),
+        }
+    } else {
+        Vec::new()
+    };
+
+    let expected_chips = contents.len();
+    let expected_images = images.len();
+    let view = driven.view.clone();
+    let composed = driven.window.update(cx, |_, window, cx| {
+        let editor = view.update(cx, |view, cx| view.detached_message_editor(window, cx));
+        let parts = editor.update(cx, |editor, cx| {
+            editor.insert_text(&text, window, cx);
+            if !text.is_empty() && expected_chips + expected_images > 0 {
+                editor.insert_text("\n", window, cx);
+            }
+            let chips = editor.insert_browser_contexts(contents, window, cx)?;
+            let pasted: Vec<Task<()>> = images
+                .into_iter()
+                .map(|(image, name)| editor.insert_image(image, name, window, cx))
+                .collect();
+            anyhow::Ok((chips, pasted))
+        });
+        parts.map(|(chips, pasted)| (editor, chips, pasted))
+    });
+    let (editor, chips, pasted) = match composed.and_then(|composed| composed) {
+        Ok(composed) => composed,
+        Err(error) => {
+            let error = error.context("composing the message");
+            return send_failed(id, request_id, &error, "compose_failed", cx);
+        }
+    };
+
+    let session = id.clone();
+    let window = driven.window;
+    cx.spawn(async move |cx| {
+        let attached = async {
+            let resolved = chips.await;
+            if resolved < expected_chips {
+                anyhow::bail!(
+                    "{} of {expected_chips} page attachments could not be attached",
+                    expected_chips - resolved
+                );
+            }
+            join_all(pasted).await;
+            let contents = cx
+                .update(|cx| view.update(cx, |view, cx| view.resolve_message_contents(&editor, cx)))
+                .await
+                .context("preparing the message")?;
+            let attached_images = contents
+                .0
+                .iter()
+                .filter(|block| matches!(block, acp_v2::ContentBlock::Image(_)))
+                .count();
+            if attached_images < expected_images {
+                anyhow::bail!(
+                    "{} of {expected_images} images could not be attached",
+                    expected_images - attached_images
+                );
+            }
+            if contents.0.is_empty() {
+                anyhow::bail!("the message is empty");
+            }
+            window
+                .update(cx, |_, window, cx| {
+                    view.update(cx, |view, cx| view.send_external(contents, window, cx))
+                })
+                .context("the window holding the thread closed")?
+                .await
+        }
+        .await;
+        cx.update(|cx| match attached {
+            Ok(queued) => {
+                send(
+                    &session,
+                    ServerMsg::Sent {
+                        v: V2,
+                        id: request_id,
+                        queued,
+                        images: sent_images,
+                    },
+                    cx,
+                );
+                log_line(
+                    log::Level::Info,
+                    format!(
+                        "devtools_bridge event=browser_send session={session} outcome=sent \
+                         queued={queued} images={} attachments={attachment_count}",
+                        sent_images_code(sent_images)
+                    ),
+                );
+            }
+            Err(error) => {
+                send_failed(&session, request_id, &error, "attach_failed", cx);
+            }
+        });
+    })
+    .detach();
+    "sending"
+}
+
+/// Decodes the images of a `send`, which `validate_send` has already held to PNG or JPEG
+/// magic bytes, canonical base64 and the size limits (R12.5).
+fn decode_images(images: &[ImageAttachment]) -> Result<Vec<(gpui::Image, SharedString)>> {
+    images
+        .iter()
+        .enumerate()
+        .map(|(index, image)| {
+            let number = index + 1;
+            let bytes = base64::engine::general_purpose::STANDARD
+                .decode(&image.data_b64)
+                .with_context(|| format!("decoding image {number}"))?;
+            let format = match image.mime {
+                ImageMime::Png => gpui::ImageFormat::Png,
+                ImageMime::Jpeg => gpui::ImageFormat::Jpeg,
+            };
+            Ok((
+                gpui::Image::from_bytes(format, bytes),
+                SharedString::from(format!("Browser image {number}")),
+            ))
+        })
+        .collect()
+}
+
+fn sent_images_code(images: SentImages) -> &'static str {
+    match images {
+        SentImages::Included => "included",
+        SentImages::SkippedUnsupported => "skipped_unsupported",
+        SentImages::None => "none",
+    }
+}
+
+/// Answers `send_failed` with what failed after the contract's message, so the sidebar can say
+/// why. The log line carries only `reason`, a fixed code: the error may quote the message.
+fn send_failed(
+    id: &SessionId,
+    request_id: String,
+    error: &anyhow::Error,
+    reason: &'static str,
+    cx: &mut App,
+) -> &'static str {
+    let error_code = ChannelError::SendFailed;
+    send(
+        id,
+        ServerMsg::Error {
+            v: V2,
+            id: Some(request_id),
+            error: error_code,
+            message: format!("{}: {error:#}", error_code.message()),
+            fatal: error_code.fatal(),
+        },
+        cx,
+    );
+    log_line(
+        log::Level::Warn,
+        format!(
+            "devtools_bridge event=browser_send session={id} outcome=send_failed reason={reason}"
+        ),
+    );
+    error_code.code()
+}
+
+/// Stops the thread's turn as the window's Stop does, which also pauses Zeo's queue (R7.4).
+fn cancel(id: &SessionId, request_id: String, cx: &mut App) -> &'static str {
+    let driven = match driven_thread(id, cx) {
+        Ok(driven) => driven,
+        Err(error) => return reply_error(id, Some(request_id), error, cx),
+    };
+    driven
+        .view
+        .update(cx, |view, cx| view.cancel_generation(cx));
+    send(
+        id,
+        ServerMsg::Ok {
+            v: V2,
+            id: request_id,
+        },
+        cx,
+    );
+    log_line(
+        log::Level::Info,
+        format!("devtools_bridge event=browser_cancel session={id} outcome=ok"),
+    );
+    "ok"
+}
+
+/// Answers the pending permission request whose wire id is `permission` with the option
+/// `option_id` (R7.6). A request no longer pending, or never known, is `stale_permission` and
+/// changes nothing.
+fn authorize(
+    id: &SessionId,
+    request_id: String,
+    permission: &str,
+    option_id: &str,
+    cx: &mut App,
+) -> &'static str {
+    let driven = match driven_thread(id, cx) {
+        Ok(driven) => driven,
+        Err(error) => return reply_error(id, Some(request_id), error, cx),
+    };
+    let found = driven
+        .thread
+        .read(cx)
+        .pending_permission_requests()
+        .find(|request| permission_request_id(request.id) == permission)
+        .map(|request| {
+            (
+                request.id,
+                request.legacy_tool_call_id().cloned(),
+                selected_outcome(request, option_id),
+            )
+        });
+    let Some((request, tool_call_id, outcome)) = found else {
+        return reply_error(id, Some(request_id), ChannelError::StalePermission, cx);
+    };
+    let Some(outcome) = outcome else {
+        let error = ChannelError::BadRequest {
+            detail: "option_id is not one the permission request offers",
+        };
+        return reply_error(id, Some(request_id), error, cx);
+    };
+    let allows = matches!(
+        outcome.option_kind,
+        acp_v2::PermissionOptionKind::AllowOnce | acp_v2::PermissionOptionKind::AllowAlways
+    );
+    // The window disables Allow until its look-alike character warning is acknowledged, and
+    // only the window shows that warning.
+    if allows
+        && tool_call_id
+            .is_some_and(|tool_call_id| driven.view.read(cx).blocks_allow_for(&tool_call_id, cx))
+    {
+        let error = ChannelError::BadRequest {
+            detail: "the command has look-alike characters; allow it in Zeo",
+        };
+        return reply_error(id, Some(request_id), error, cx);
+    }
+    let session_id = driven.thread.read(cx).session_id().clone();
+    let view = driven.view.clone();
+    let answered = driven.window.update(cx, |_, window, cx| {
+        view.update(cx, |view, cx| {
+            view.authorize_permission_request(session_id, request, outcome, window, cx)
+        })
+    });
+    if answered.is_err() {
+        return reply_error(id, Some(request_id), ChannelError::ThreadClosed, cx);
+    }
+    send(
+        id,
+        ServerMsg::Ok {
+            v: V2,
+            id: request_id,
+        },
+        cx,
+    );
+    log_line(
+        log::Level::Info,
+        format!("devtools_bridge event=browser_authorize session={id} outcome=ok allows={allows}"),
+    );
+    "ok"
+}
+
+/// The answer the wire option `option_id` stands for in `request`, or `None` when the request
+/// offers no such option. A dropdown choice is answered as the window answers it, through
+/// [`resolve_outcome_from_selection`], so a choice's pattern rides with its answer: without
+/// it, "Always for `cargo build` commands" would be saved as "always allow the terminal".
+fn selected_outcome(
+    request: &PermissionRequest,
+    option_id: &str,
+) -> Option<SelectedPermissionOutcome> {
+    let by_id = |options: &[acp_v2::PermissionOption]| {
+        options
+            .iter()
+            .find(|option| option.option_id.0.as_ref() == option_id)
+            .map(|option| {
+                SelectedPermissionOutcome::new(option.option_id.clone(), option.kind.clone())
+            })
+    };
+    let Some(options) = request.legacy_options() else {
+        return by_id(&request.generic_request()?.options);
+    };
+    let choices = match options {
+        PermissionOptions::Flat(options) => return by_id(options),
+        PermissionOptions::Dropdown(choices)
+        | PermissionOptions::DropdownWithPatterns { choices, .. } => choices,
+    };
+    let (index, side) = option_id.split_once(':')?;
+    let allow = match side {
+        "allow" => true,
+        "deny" => false,
+        _ => return None,
+    };
+    let index: usize = index.parse().ok()?;
+    // Checked first: the window's resolver falls back to the last choice for an index it does
+    // not know.
+    if index >= choices.len() || choice_option_id(index, allow) != option_id {
+        return None;
+    }
+    resolve_outcome_from_selection(options, Some(&PermissionSelection::Choice(index)), allow)
+}
+
+/// Brings the session's thread forward in Zeo (R5.5, R5.7): a thread with a session through
+/// `open_agent_session`, which raises the window holding its project; a draft, which has no
+/// session to open, by raising its window and focusing its panel on it.
+fn open_in_zeo(
+    id: &SessionId,
+    request_id: String,
+    app_state: Arc<AppState>,
+    cx: &mut App,
+) -> &'static str {
+    let driven = match driven_thread(id, cx) {
+        Ok(driven) => driven,
+        Err(error) => return reply_error(id, Some(request_id), error, cx),
+    };
+    if driven.thread.read(cx).is_draft_thread() {
+        return match raise(&driven, cx) {
+            Ok(()) => {
+                send(
+                    id,
+                    ServerMsg::Ok {
+                        v: V2,
+                        id: request_id,
+                    },
+                    cx,
+                );
+                log_line(
+                    log::Level::Info,
+                    format!(
+                        "devtools_bridge event=browser_open session={id} outcome=ok draft=true"
+                    ),
+                );
+                "ok"
+            }
+            Err(_) => open_failed(id, request_id, cx),
+        };
+    }
+    let session_id = driven.thread.read(cx).session_id().clone();
+    let options = OpenAgentSessionOptions {
+        fallback_window: Some(driven.window),
+        ..OpenAgentSessionOptions::default()
+    };
+    let opening = open_agent_session(session_id, options, app_state, cx);
+    let session = id.clone();
+    cx.spawn(async move |cx| {
+        let opened = opening.await;
+        cx.update(|cx| match opened {
+            Ok(_) => {
+                send(
+                    &session,
+                    ServerMsg::Ok {
+                        v: V2,
+                        id: request_id,
+                    },
+                    cx,
+                );
+                log_line(
+                    log::Level::Info,
+                    format!(
+                        "devtools_bridge event=browser_open session={session} outcome=ok \
+                         draft=false"
+                    ),
+                );
+            }
+            Err(_) => {
+                open_failed(&session, request_id, cx);
+            }
+        });
+    })
+    .detach();
+    "opening"
+}
+
+/// Raises the window holding `driven`, makes its workspace the window's active one and shows
+/// the thread in its focused agent panel.
+fn raise(driven: &Driven, cx: &mut App) -> Result<()> {
+    let window = driven
+        .window
+        .downcast::<MultiWorkspace>()
+        .context("the thread's window is not a workspace window")?;
+    window
+        .update(cx, |multi_workspace, window, cx| {
+            window.activate_window();
+            if multi_workspace.workspace() != &driven.workspace {
+                multi_workspace.activate(driven.workspace.clone(), None, window, cx);
+            }
+            driven.workspace.update(cx, |workspace, cx| {
+                workspace.focus_panel::<AgentPanel>(window, cx);
+            });
+            driven.panel.update(cx, |panel, cx| {
+                let shown = panel
+                    .active_conversation_view()
+                    .is_some_and(|active| active.entity_id() == driven.conversation.entity_id());
+                if !shown {
+                    panel.activate_retained_thread(driven.thread_id, true, window, cx);
+                }
+            });
+        })
+        .context("the thread's window closed")
+}
+
+/// The thread could not be brought forward: it is answered as closed. The log line carries
+/// only a fixed reason code: the error names the thread's folders.
+fn open_failed(id: &SessionId, request_id: String, cx: &mut App) -> &'static str {
+    log_line(
+        log::Level::Warn,
+        format!(
+            "devtools_bridge event=browser_open session={id} outcome=thread_closed \
+             reason=open_failed"
+        ),
+    );
+    reply_error(id, Some(request_id), ChannelError::ThreadClosed, cx)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+/// Sends `msg` to session `id`. A session whose sink has closed is forgotten: the bridge's
+/// `Closed` follows, and nothing is left to answer.
+fn send(id: &SessionId, msg: ServerMsg, cx: &mut App) {
+    let Some(state) = global(cx).sessions.get(id) else {
+        return;
+    };
+    if state.sink.send(msg).is_err() {
+        log_line(
+            log::Level::Debug,
+            format!(
+                "devtools_bridge event=session_reply_dropped session={id} reason=session_closing"
+            ),
+        );
+    }
+}
+
+/// Answers `request_id` with `error`; returns the error's code for the log line.
+fn reply_error(
+    id: &SessionId,
+    request_id: Option<String>,
+    error: ChannelError,
+    cx: &mut App,
+) -> &'static str {
+    send(id, ServerMsg::error(request_id, error), cx);
+    error.code()
+}
+
+/// Logs one of this module's event lines. Tests read back the lines their own thread logged:
+/// installing a `log` logger is not possible in a test binary that already has one.
+fn log_line(level: log::Level, line: String) {
+    #[cfg(test)]
+    LOGGED.with_borrow_mut(|lines| lines.push((level, line.clone())));
+    log::log!(level, "{line}");
+}
+
+#[cfg(test)]
+thread_local! {
+    static LOGGED: std::cell::RefCell<Vec<(log::Level, String)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Every line [`log_line`] logged on this thread so far.
+#[cfg(test)]
+fn logged_lines() -> Vec<String> {
+    logged_levels().into_iter().map(|(_, line)| line).collect()
+}
+
+/// [`logged_lines`], each with its level.
+#[cfg(test)]
+fn logged_levels() -> Vec<(log::Level, String)> {
+    LOGGED.with_borrow(Clone::clone)
+}
