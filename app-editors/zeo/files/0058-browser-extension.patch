+#[gpui::test]
+async fn drive_authorize_answers_the_request_and_an_unknown_id_is_stale(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let tool_call_id = acp_v2::ToolCallId::new("1");
+    let connection = StubAgentConnection::new().with_permission_requests(HashMap::from_iter([(
+        tool_call_id.clone(),
+        PermissionOptions::Flat(vec![acp_v2::PermissionOption::new(
+            "allow-1",
+            "Allow",
+            acp_v2::PermissionOptionKind::AllowOnce,
+        )]),
+    )]));
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::ToolCall(
+        acp_v1::ToolCall::new(acp_v1::ToolCallId::new("1"), "Run tests")
+            .kind(acp_v1::ToolKind::Execute),
+    )]);
+    let win = window(&fs, "/p/app", Some(connection), cx).await;
+    let probe = approved_on(&win, cx).await;
+    probe.handle(
+        request(
+            "send",
+            "m1",
+            json!({ "text": "run the tests", "attachments": [] }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    probe.drain(cx);
+    let tool_status = |win: &Win| {
+        win.thread().read_with(&win.cx, |thread, _| {
+            thread.entries().iter().find_map(|e| match e {
+                AgentThreadEntry::ToolCall(call) => Some((call.status(), call.authorization_id())),
+                _ => None,
+            })
+        })
+    };
+    let (status, authorization) = tool_status(&win).expect("a tool call");
+    assert!(
+        matches!(status, ToolCallStatus::WaitingForConfirmation),
+        "{status:?}"
+    );
+    // The wire request_id is the permission request's serde form (a UUID string).
+    let request_id = serde_json::to_value(authorization.expect("pending")).expect("serializes");
+
+    probe.handle(
+        request(
+            "authorize",
+            "a0",
+            json!({ "request_id": "00000000-0000-0000-0000-000000000000", "option_id": "allow-1" }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&probe.drain(cx), "a0")["error"], "stale_permission");
+    assert!(
+        matches!(
+            tool_status(&win).expect("call").0,
+            ToolCallStatus::WaitingForConfirmation
+        ),
+        "untouched by a stale id"
+    );
+
+    probe.handle(
+        request(
+            "authorize",
+            "a1",
+            json!({ "request_id": request_id, "option_id": "allow-1" }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&probe.drain(cx), "a1")["kind"], "ok");
+    assert!(
+        !matches!(
+            tool_status(&win).expect("call").0,
+            ToolCallStatus::WaitingForConfirmation
+        ),
+        "R7.6: answered"
+    );
+}
