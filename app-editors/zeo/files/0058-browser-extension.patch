+//
+// Operator decision (Revision 1, 2026-10-29): field + zeo-browser 0.2. Zeo OMITS `subagents` for
+// a thread with no children (pinned here, so 0.1.x keeps reading those snapshots), and story 064's
+// task 7.3 makes zeo-browser 0.2.0 accept the optional field and the `unconfirmed` thread state,
+// released with Zeo 0.8.0 (its test: zeo-browser/test/contract.subagents.test.ts).
+//
+// Contract assumed beyond design.md (adjust HERE): `ServerMsg::Snapshot` gains
+// `subagents: Vec<SubagentInfo>` (`#[serde(default, skip_serializing_if = "Vec::is_empty")]`),
+// `SubagentInfo { title: String, status: SubagentState }` (`deny_unknown_fields`), and
+// `SubagentState` written snake_case as R1.3's six row statuses: `running`, `waiting`, `done`,
+// `failed`, `canceled`, `unknown`.
+//
+// Hostile halves first: no children → no key at all (the 0.1.x shape, byte for byte); two
+// children with the same title and status are two entries (a count with no identity is all the
+// shape allows — flagged in the report); an entry carrying anything beyond `{title, status}` is
+// refused; then the benign encode/decode.
+
+use serde_json::{Value, json};
+
+use super::{
+    Entry, EntryRole, ServerMsg, Status, SubagentInfo, SubagentState, ThreadInfo, ThreadState, V2,
+    encode_server,
+};
+
+fn thread() -> ThreadInfo {
+    ThreadInfo {
+        thread_id: "5f0c2a9e-7b1d-4c3a-9e4f-2d8b6a1c0e7f".into(),
+        title: "Fix the header overflow".into(),
+        project: "acme-web".into(),
+        agent: "claude-acp".into(),
+        status: ThreadState::Idle,
+        followed: true,
+    }
+}
+
+fn snapshot(subagents: Vec<SubagentInfo>) -> ServerMsg {
+    ServerMsg::Snapshot {
+        v: V2,
+        id: Some("r2".into()),
+        thread: Some(thread()),
+        earlier: 0,
+        entries: vec![Entry {
+            role: EntryRole::User,
+            markdown: "Why does the header overflow?".into(),
+            truncated: false,
+            tool: None,
+        }],
+        status: Status {
+            state: ThreadState::Idle,
+            message: None,
+        },
+        permissions: Vec::new(),
+        subagents,
+    }
+}
+
+fn encoded(msg: &ServerMsg) -> Value {
+    serde_json::from_str(&encode_server(msg).expect("the snapshot encodes")).expect("JSON")
+}
+
+fn child(title: &str, status: SubagentState) -> SubagentInfo {
+    SubagentInfo {
+        title: title.into(),
+        status,
+    }
+}
+
+/// Hostile (compatibility): a thread with no children encodes exactly the keys zeo-browser
+/// 0.1.x's strict schema accepts — no `subagents`, not even empty.
+#[test]
+fn browser_wire_snapshot_without_children_has_no_subagents_key() {
+    let value = encoded(&snapshot(Vec::new()));
+    let mut keys: Vec<&str> = value
+        .as_object()
+        .expect("an object")
+        .keys()
+        .map(String::as_str)
+        .collect();
+    keys.sort_unstable();
+    assert_eq!(
+        keys,
+        vec![
+            "earlier",
+            "entries",
+            "id",
+            "kind",
+            "permissions",
+            "status",
+            "thread",
+            "v"
+        ],
+        "0.1.x drops a snapshot carrying any other key"
+    );
+}
+
+/// Hostile (distinguishability): two children sharing a title and a status stay two entries,
+/// in the order given.
+#[test]
+fn browser_wire_snapshot_keeps_same_titled_children_apart() {
+    let value = encoded(&snapshot(vec![
+        child("Worker", SubagentState::Running),
+        child("Worker", SubagentState::Running),
+    ]));
+    assert_eq!(
+        value["subagents"],
+        json!([
+            { "title": "Worker", "status": "running" },
+            { "title": "Worker", "status": "running" }
+        ])
+    );
+}
+
+/// Hostile (shape): an entry is exactly `{title, status}`; anything else is refused, and so is
+/// a status outside the six.
+#[test]
+fn browser_wire_snapshot_subagent_entries_are_strict() {
+    let mut value = encoded(&snapshot(vec![child("Alpha", SubagentState::Done)]));
+    value["subagents"][0]["session_id"] = json!("alpha");
+    assert!(
+        serde_json::from_value::<ServerMsg>(value).is_err(),
+        "an extra key in an entry is refused"
+    );
+    let mut value = encoded(&snapshot(vec![child("Alpha", SubagentState::Done)]));
+    value["subagents"][0]["status"] = json!("completed");
+    assert!(
+        serde_json::from_value::<ServerMsg>(value).is_err(),
+        "the row statuses are R1.3's, not the feed's"
+    );
+}
+
+/// Every status, its wire word, and a round trip through the decoder.
+#[test]
+fn browser_wire_snapshot_subagents_round_trip_with_every_status() {
+    let all = [
+        (SubagentState::Running, "running"),
+        (SubagentState::Waiting, "waiting"),
+        (SubagentState::Done, "done"),
+        (SubagentState::Failed, "failed"),
+        (SubagentState::Canceled, "canceled"),
+        (SubagentState::Unknown, "unknown"),
+    ];
+    let msg = snapshot(
+        all.iter()
+            .map(|(status, word)| child(&format!("Child {word}"), *status))
+            .collect(),
+    );
+    let value = encoded(&msg);
+    let words: Vec<&str> = value["subagents"]
+        .as_array()
+        .expect("an array")
+        .iter()
+        .map(|entry| entry["status"].as_str().expect("a word"))
+        .collect();
+    assert_eq!(words, all.iter().map(|(_, word)| *word).collect::<Vec<_>>());
+    let decoded: ServerMsg = serde_json::from_value(value).expect("the snapshot decodes");
+    assert_eq!(decoded, msg);
+}
