+// Fix round (tech review of 5.3): a flooding session must not starve the bridge thread, and a
+// stalled consumer must bound what a session buffers.
+
+#[test]
+fn session_a_newline_free_flood_does_not_starve_v1_requests() {
+    let bridge = start_bridge(true);
+    let mut client = Client::hello(&bridge.dir);
+    client.line().expect("welcome");
+    let mut flood = client.writer.try_clone().expect("clone");
+    let flooding = thread::spawn(move || {
+        let block = vec![b'a'; 4 * MIB];
+        let end = Instant::now() + Duration::from_secs(2);
+        let mut sent = 0usize;
+        while Instant::now() < end {
+            if flood.write_all(&block).is_err() {
+                break;
+            }
+            sent += block.len();
+        }
+        sent
+    });
+    thread::sleep(Duration::from_millis(100));
+
+    let mut slowest = Duration::ZERO;
+    let mut answered = 0;
+    let end = Instant::now() + Duration::from_millis(1700);
+    while Instant::now() < end {
+        let started = Instant::now();
+        let mut v1 = Client::connect(&bridge.dir);
+        v1.send(&json!({ "v": 1 }));
+        assert_eq!(v1.line().expect("a v1 answer")["v"], 1);
+        slowest = slowest.max(started.elapsed());
+        answered += 1;
+        thread::sleep(Duration::from_millis(50));
+    }
+    let sent = flooding.join().expect("the flood thread");
+    assert!(
+        sent >= 32 * MIB,
+        "precondition: the flood ran ({sent} bytes)"
+    );
+    assert!(answered >= 5, "v1 requests kept being served: {answered}");
+    assert!(
+        slowest < Duration::from_millis(300),
+        "a v1 request waited {slowest:?} behind the flood"
+    );
+}
