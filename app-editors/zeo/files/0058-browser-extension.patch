+    win.set_composer(DRAFT);
+    let probe = approved_on(&win, cx).await;
+    probe.handle(
+        request(
+            "send",
+            "m1",
+            json!({ "text": "from the browser", "attachments": [] }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    let sent = reply(&probe.drain(cx), "m1");
+    assert_eq!(sent["kind"], "sent", "{sent}");
+    assert_eq!(sent["queued"], false);
+    assert_eq!(sent["images"], "none");
+    let users = user_messages(&win);
+    assert_eq!(users.len(), 1, "R7.1: one user message in the thread");
+    assert!(users[0].contains("from the browser"));
+    assert!(!users[0].contains(DRAFT), "R7.3: the draft is never sent");
