+// Story 045, task 7.3 — send, stop, authorize and open in Zeo from an approved session
+// (design.md §B2 Send/Stop/Authorize/Open in Zeo). Requirements: R7.1, R7.2, R7.3, R7.4, R7.6,
+// R7.10, R5.7, R10.5, R12.1 (the chip reaches the thread). Q4.
+// Fixtures and seams: `test_support`. The tests set the target with `subscribe`: `send` goes to
+// "the attached thread", so Task 7.3 needs `subscribe` to record the target even though the
+// snapshot and the event pump are Task 7.4's.
+//
+// Hostile halves first:
+//   - the window's composer holds a DRAFT: the sidebar's message is sent, the draft is not, and
+//     the composer still holds it afterwards (a send through `ThreadView::send` would fail this);
+//   - images: included for an agent that takes them AND skipped (message still sent) for one
+//     that does not;
+//   - authorize: a well-formed option on an unknown request id is `stale_permission`, never
+//     applied to the pending request.
+
+use std::collections::HashMap;
+
+use acp_thread::{AgentThreadEntry, PermissionOptions, StubAgentConnection, ToolCallStatus};
+use agent_client_protocol::{v1::schema as acp_v1, v2::schema as acp_v2};
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::test_support::*;
+
+const DRAFT: &str = "DRAFT the operator is still typing";
+
+async fn approved_on(win: &Win, cx: &mut TestAppContext) -> Probe {
+    let probe = open_session(1);
+    approve(&probe, &win.app_state(), cx);
+    probe.handle(
+        request("subscribe", "s", json!({ "target": { "follow": true } })),
+        &win.app_state(),
+        cx,
+    );
+    probe.drain(cx);
+    probe
+}
+
+fn user_messages(win: &Win) -> Vec<String> {
+    let thread = win.thread();
+    thread.read_with(&win.cx, |thread, cx| {
+        thread
+            .entries()
+            .iter()
+            .filter(|e| matches!(e, AgentThreadEntry::UserMessage(_)))
+            .map(|e| e.to_markdown(cx))
+            .collect()
+    })
+}
+
+fn reply(msgs: &[Value], id: &str) -> Value {
+    msgs.iter()
+        .find(|m| m["id"] == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no reply to {id}: {msgs:?}"))
+}
+
+fn image() -> Value {
+    json!({ "type": "image", "mime": "image/png", "data_b64": PNG_1X1, "w": 1, "h": 1 })
+}
