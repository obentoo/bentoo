+/// Parses `zed:///agent/browser-context?kind=…&url=…&label=…`. Every field
+/// is required and appears once, and `kind` must be a known kind, so a damaged
+/// link is an error rather than a different chip.
+fn parse_browser_context(url: &Url) -> Result<MentionUri> {
+    let mut kind = None;
+    let mut page_url = None;
+    let mut label = None;
+
+    for (key, value) in url.query_pairs() {
+        let slot = match key.as_ref() {
+            "kind" => &mut kind,
+            "url" => &mut page_url,
+            "label" => &mut label,
+            other => bail!("invalid browser-context query parameter {other:?}"),
+        };
+        if slot.replace(value.into_owned()).is_some() {
+            bail!("duplicate browser-context query parameter {key:?}");
+        }
+    }
+
+    let kind = BrowserContextKind::from_uri_value(&kind.context("missing browser-context kind")?)?;
+    Ok(MentionUri::BrowserContext {
+        kind,
+        page_url: page_url.context("missing browser-context url")?,
+        label: label.context("missing browser-context label")?,
+    })
+}
