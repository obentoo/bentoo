+#[test]
+fn session_a_fifth_hello_is_busy_while_the_v1_places_stay_free() {
+    let bridge = start_bridge(true);
+    let mut sessions: Vec<Client> = (0..4).map(|_| Client::hello(&bridge.dir)).collect();
+    for session in &mut sessions {
+        assert_eq!(session.line().expect("welcome")["kind"], "welcome");
+    }
+    let mut fifth = Client::hello(&bridge.dir);
+    let busy = fifth.line().expect("an answer");
+    assert_eq!(error_code(&busy), "busy");
+    assert_eq!(busy["fatal"], true);
+    assert!(fifth.line().is_none());
+
+    let v1: Vec<Client> = (0..4)
+        .map(|_| {
+            let mut client = Client::connect(&bridge.dir);
+            client.send(&json!({ "v": 1 }));
+            client
+        })
+        .collect();
+    for mut client in v1 {
+        assert_eq!(
+            client.line().expect("the Vite relay is still served")["v"],
+            1
+        );
+    }
+
+    drop(sessions.pop());
+    wait_until("the closed session", || {
+        bridge.rec.closed.load(Ordering::SeqCst) >= 1
+    });
+    let mut again = Client::hello(&bridge.dir);
+    assert_eq!(again.line().expect("a freed place")["kind"], "welcome");
+}
