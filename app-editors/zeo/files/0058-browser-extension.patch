@@ -0,0 +1,160 @@
+//! The calling extension's identity, read from the arguments the browser starts the host with
+//! (design.md §B4 Arguments; R2.7).
+//!
+//! - Chrome and Chromium pass the caller's origin, `chrome-extension://<id>/`, and on Windows
+//!   also `--parent-window=<n>`. They pass the same shape, so the two are told apart by the
+//!   parent process's executable name.
+//! - Firefox passes the path of the host manifest and the add-on ID.
+//!
+//! Anything else, including arguments that only look like one of these, is `unknown`.
+
+use std::path::Path;
+
+use serde::Serialize;
+
+const CHROME_ORIGIN_SCHEME: &str = "chrome-extension://";
+const CHROME_PARENT_WINDOW_FLAG: &str = "--parent-window=";
+/// Chrome extension IDs are 32 characters drawn from `a`..=`p`.
+const CHROME_ID_LEN: usize = 32;
+
+/// Which browser started the host, in the bridge's wire spelling.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Browser {
+    Chrome,
+    Chromium,
+    Firefox,
+    Unknown,
+}
+
+impl Browser {
+    /// The wire name; also the form used in log lines.
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::Chrome => "chrome",
+            Self::Chromium => "chromium",
+            Self::Firefox => "firefox",
+            Self::Unknown => "unknown",
+        }
+    }
+
+    /// Chrome or Chromium, from the executable of the process that started the host:
+    /// a basename starting with `chromium` is Chromium, anything else (or nothing readable)
+    /// is Chrome.
+    pub fn chrome_family_from_parent_exe(exe: Option<&Path>) -> Self {
+        let is_chromium = exe
+            .and_then(Path::file_name)
+            .is_some_and(|name| name.as_encoded_bytes().starts_with(b"chromium"));
+        if is_chromium {
+            Self::Chromium
+        } else {
+            Self::Chrome
+        }
+    }
+}
+
+/// The `client` keys the host writes into the `hello`, overwriting whatever the page sent.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct ClientIdentity {
+    pub browser: Browser,
+    pub extension_id: String,
+}
+
+impl ClientIdentity {
+    /// The identity named by `args` (the arguments after argv[0]). A Chrome-shaped caller is
+    /// told from Chromium by `/proc/<ppid>/exe`.
+    pub fn from_args(args: impl IntoIterator<Item = String>) -> Self {
+        Self::from_args_with_parent(args, || {
+            let parent = std::os::unix::process::parent_id();
+            std::fs::read_link(format!("/proc/{parent}/exe")).ok()
+        })
+    }
+
+    /// [`Self::from_args`] with the parent executable supplied by `parent_exe`, which is only
+    /// consulted for a Chrome-shaped caller.
+    pub fn from_args_with_parent(
+        args: impl IntoIterator<Item = String>,
+        parent_exe: impl FnOnce() -> Option<std::path::PathBuf>,
+    ) -> Self {
+        let args: Vec<String> = args.into_iter().collect();
+        if let Some(id) = chrome_extension_id(&args) {
+            return Self {
+                browser: Browser::chrome_family_from_parent_exe(parent_exe().as_deref()),
+                extension_id: id.to_string(),
+            };
+        }
+        if let Some(id) = firefox_addon_id(&args) {
+            return Self {
+                browser: Browser::Firefox,
+                extension_id: id.to_string(),
+            };
+        }
+        Self::unknown()
+    }
+
+    pub fn unknown() -> Self {
+        Self {
+            browser: Browser::Unknown,
+            extension_id: String::new(),
+        }
+    }
+}
+
+/// `chrome-extension://<id>/`, optionally followed by `--parent-window=<n>` and nothing else.
+fn chrome_extension_id(args: &[String]) -> Option<&str> {
+    let (origin, rest) = args.split_first()?;
+    match rest {
+        [] => {}
+        [flag] if is_parent_window_flag(flag) => {}
+        _ => return None,
+    }
+    let id = origin
+        .strip_prefix(CHROME_ORIGIN_SCHEME)?
+        .strip_suffix('/')?;
+    let well_formed =
+        id.len() == CHROME_ID_LEN && id.bytes().all(|byte| (b'a'..=b'p').contains(&byte));
+    well_formed.then_some(id)
+}
+
+fn is_parent_window_flag(arg: &str) -> bool {
+    arg.strip_prefix(CHROME_PARENT_WINDOW_FLAG)
+        .is_some_and(|handle| {
+            !handle.is_empty() && handle.bytes().all(|byte| byte.is_ascii_digit())
+        })
+}
+
+/// `<absolute path to a .json manifest> <add-on id>`, exactly two arguments.
+fn firefox_addon_id(args: &[String]) -> Option<&str> {
+    let [manifest, addon_id] = args else {
+        return None;
+    };
+    let manifest = Path::new(manifest);
+    let manifest_ok =
+        manifest.is_absolute() && manifest.extension().is_some_and(|ext| ext == "json");
+    (manifest_ok && is_addon_id(addon_id)).then_some(addon_id.as_str())
+}
+
+/// A Firefox add-on ID: an email-like `name@domain` or a braced GUID.
+fn is_addon_id(id: &str) -> bool {
+    if id.is_empty() || id.len() > 255 {
+        return false;
+    }
+    if let Some(guid) = id.strip_prefix('{').and_then(|rest| rest.strip_suffix('}')) {
+        return !guid.is_empty()
+            && guid
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit() || byte == b'-');
+    }
+    let Some((name, domain)) = id.split_once('@') else {
+        return false;
+    };
+    let name_ok = !name.is_empty()
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"._+-".contains(&byte));
+    let domain_ok = !domain.is_empty()
+        && domain
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b".-".contains(&byte));
+    name_ok && domain_ok
+}
