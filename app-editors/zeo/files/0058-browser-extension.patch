+// Story 045, task 6.1 — the relay between the browser's stdio and the bridge socket, driven
+// in-process against a fake bridge on a temp unix socket (design.md §B4; R2.1–R2.6, R2.8, R2.9,
+// R13.4). Wired in `src/main.rs` as `#[cfg(test)] mod relay_tests;`. (Task 8.2 drives the built
+// binary the same way from vitest; this file needs no binary.)
+//
+// Assumed signatures (adjust the `use` and `run_relay` only):
+//   - `crate::relay::resolve_socket(zeo_devtools_socket: Option<&OsStr>, xdg_runtime_dir:
+//      Option<&OsStr>) -> Result<PathBuf, Unavailable>`, `Unavailable::reason(&self) -> &str`;
+//   - `crate::relay::run(identity: &ClientIdentity, socket: &Path, stdin: impl Read + Send +
+//      'static, stdout: impl Write + Send + 'static) -> anyhow::Result<()>` — returns after the
+//      relay ends, having written `bridge_unavailable` / `bridge_closed` frames itself.
+//
+// Hostile halves first:
+//   - identity: a `client` forged in the page's hello is overwritten; a LATER message is relayed
+//     unchanged (only the first message is the hello);
+//   - caps: 8 MiB + 1 from stdin and 1 000 001 bytes from Zeo are refused with the connection kept,
+//     while exactly 1 000 000 bytes from Zeo pass;
+//   - stdout holds frames and nothing else, down to the last byte.
+
+use std::ffi::OsStr;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::fs::PermissionsExt as _;
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+
+use serde_json::{Value, json};
+
+use crate::args::ClientIdentity;
+use crate::relay::{resolve_socket, run};
+
+const ID: &str = "abcdefghijklmnopabcdefghijklmnop";
+
+#[derive(Clone, Default)]
+struct Out(Arc<Mutex<Vec<u8>>>);
+
+impl Write for Out {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().expect("lock").extend_from_slice(buf);
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Out {
+    /// Every frame; panics on any byte that is not part of a whole frame when `strict`.
+    fn frames(&self, strict: bool) -> Vec<Value> {
+        let bytes = self.0.lock().expect("lock").clone();
+        let mut out = Vec::new();
+        let mut at = 0;
+        while at + 4 <= bytes.len() {
+            let len = u32::from_ne_bytes(bytes[at..at + 4].try_into().expect("4 bytes")) as usize;
+            if at + 4 + len > bytes.len() {
+                break;
+            }
+            out.push(serde_json::from_slice(&bytes[at + 4..at + 4 + len]).expect("a JSON frame"));
+            at += 4 + len;
+        }
+        if strict {
+            assert_eq!(
+                at,
+                bytes.len(),
+                "stdout carries {} stray bytes",
+                bytes.len() - at
+            );
+        }
+        out
+    }
+}
+
+fn framed(body: &[u8]) -> Vec<u8> {
+    let mut out = (body.len() as u32).to_ne_bytes().to_vec();
+    out.extend_from_slice(body);
+    out
+}
+
+struct Relay {
+    stdin: Option<std::io::PipeWriter>,
+    out: Out,
+    done: JoinHandle<anyhow::Result<()>>,
+}
+
+fn run_relay(args: &[&str], socket: &Path) -> Relay {
+    let (reader, writer) = std::io::pipe().expect("pipe");
+    let out = Out::default();
+    let identity = ClientIdentity::from_args(args.iter().map(|a| a.to_string()));
+    let socket = socket.to_path_buf();
+    let sink = out.clone();
+    let done = thread::spawn(move || run(&identity, &socket, reader, sink));
+    Relay {
+        stdin: Some(writer),
+        out,
+        done,
+    }
+}
+
+impl Relay {
+    fn send(&mut self, body: &[u8]) {
+        self.stdin
+            .as_mut()
+            .expect("stdin open")
+            .write_all(&framed(body))
+            .expect("write");
+    }
+    fn send_json(&mut self, value: &Value) {
+        self.send(&serde_json::to_vec(value).expect("json"));
+    }
+    fn wait_frame(&self, pred: impl Fn(&Value) -> bool) -> Value {
+        let end = Instant::now() + Duration::from_secs(5);
+        loop {
+            if let Some(frame) = self.out.frames(false).into_iter().find(|f| pred(f)) {
+                return frame;
+            }
+            assert!(
+                Instant::now() < end,
+                "no matching frame in {:?}",
+                self.out.frames(false)
+            );
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+    fn finish(self) -> (anyhow::Result<()>, Out) {
+        let out = self.out.clone();
+        (
+            self.done.join().expect("the relay thread does not panic"),
+            out,
+        )
+    }
+}
+
+struct Zeo {
+    _tmp: tempfile::TempDir,
+    path: PathBuf,
+    conn: Arc<Mutex<Option<UnixStream>>>,
+    lines: Arc<Mutex<Vec<String>>>,
+}
+
+fn fake_zeo() -> Zeo {
+    let tmp = tempfile::tempdir().expect("temp");
+    let path = tmp.path().join("devtools.sock");
+    let listener = UnixListener::bind(&path).expect("bind");
+    let conn = Arc::new(Mutex::new(None));
+    let lines = Arc::new(Mutex::new(Vec::new()));
+    let (c, l) = (conn.clone(), lines.clone());
+    thread::spawn(move || {
+        if let Ok((stream, _)) = listener.accept() {
+            *c.lock().expect("lock") = Some(stream.try_clone().expect("clone"));
+            for line in BufReader::new(stream).lines() {
+                match line {
+                    Ok(line) => l.lock().expect("lock").push(line),
+                    Err(_) => break,
+                }
+            }
+            l.lock().expect("lock").push("<eof>".to_string());
+        }
+    });
+    Zeo {
+        _tmp: tmp,
+        path,
+        conn,
+        lines,
+    }
+}
+
+impl Zeo {
+    fn wait_lines(&self, n: usize) -> Vec<String> {
+        let end = Instant::now() + Duration::from_secs(5);
+        loop {
+            let lines = self.lines.lock().expect("lock").clone();
+            if lines.len() >= n {
+                return lines;
+            }
+            assert!(
+                Instant::now() < end,
+                "only {} lines: {lines:?}",
+                lines.len()
+            );
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+    fn write(&self, text: &str) {
+        let end = Instant::now() + Duration::from_secs(5);
+        loop {
+            if let Some(stream) = self.conn.lock().expect("lock").as_mut() {
+                stream
+                    .write_all(text.as_bytes())
+                    .expect("write to the relay");
+                return;
+            }
+            assert!(Instant::now() < end, "the relay never connected");
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+    fn close(&self) {
+        if let Some(stream) = self.conn.lock().expect("lock").take() {
+            stream.shutdown(std::net::Shutdown::Both).ok();
+        }
+    }
+}
+
+fn hello_forged() -> Value {
+    json!({ "v": 2, "kind": "hello", "client": { "browser": "firefox", "extension_id": "forged", "extension_version": "0.1.0" } })
+}
+
+fn chrome() -> String {
+    format!("chrome-extension://{ID}/")
+}
+
+#[test]
+fn relay_overwrites_a_forged_hello_identity_and_only_the_first_message() {
+    let zeo = fake_zeo();
+    let mut relay = run_relay(&[&chrome()], &zeo.path);
+    relay.send_json(&hello_forged());
+    let later = json!({ "v": 2, "kind": "cancel", "id": "c1", "client": { "extension_id": "kept-as-sent" } });
+    relay.send_json(&later);
+    let lines = zeo.wait_lines(2);
+    let hello: Value = serde_json::from_str(&lines[0]).expect("json");
+    assert_eq!(hello["client"]["extension_id"], ID);
+    assert!(hello["client"]["browser"] == "chrome" || hello["client"]["browser"] == "chromium");
+    assert_eq!(
+        hello["client"]["extension_version"], "0.1.0",
+        "the rest of the hello is kept"
+    );
+    let second: Value = serde_json::from_str(&lines[1]).expect("json");
+    assert_eq!(second, later, "only the first message is the hello");
+}
+
+#[test]
+fn relay_writes_each_message_as_one_compact_line() {
