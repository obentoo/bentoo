+#[gpui::test]
+async fn approval_allow_welcomes_and_remembers_across_a_restart(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let probe = open_session(1);
+    let got = approve(&probe, &win.app_state(), cx);
+    assert_eq!(kinds(&got), ["approval_pending", "welcome"]);
+    let welcome = &got[1];
+    assert_eq!(welcome["protocol"], 2);
+    assert!(
+        welcome["zeo_version"]
+            .as_str()
+            .is_some_and(|v| !v.is_empty())
+    );
+    let stored = approved_store(cx).expect("R4.2: the approval is persisted");
+    let list: Vec<String> = serde_json::from_str(&stored).expect("a JSON array of identities");
+    assert_eq!(list, ["chrome:approved-ext"]);
+
+    // A new session for the same identity (as after a restart: only the store remains).
+    let notifications = win.notifications();
