+// Story 045, tasks 7.2–7.4 — shared fixtures for the browser channel tests. Each sub-task's tests
+// live in their own file, so a sub-task's Green never depends on a later sub-task's API (a Rust
+// test module naming a missing item breaks the whole crate's test build). Wired INSIDE
+// `src/browser_channel.rs`, so the test paths match the Validation filters
+// `browser_channel::approval`, `browser_channel::drive` and `browser_channel::stream`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/support.rs"]
+//     mod test_support;                                   // with 7.2
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/approval.rs"]
+//     mod approval;                                       // 7.2
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/drive.rs"]
+//     mod drive;                                          // 7.3
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/stream.rs"]
+//     mod stream;                                         // 7.4
+//
+// Assumed signatures (design.md §B2 Interface; the ONLY lines naming constructors are in
+// `open_session`, adjust them there):
+//   - `handle_session_message(session: &BrowserSession, msg: ClientMsg, app_state:
+//      Arc<AppState>, cx: &mut App)` and `close_session(id: SessionId, cx: &mut App)`;
+//   - `BrowserSession::new(id: SessionId, sink: SessionSink)`, `SessionSink::new(smol Sender<
+//      ServerMsg>)`, `SessionId::new(u64)`; closing a session closes its sink's channel;
+//   - `ClientMsg: Deserialize` and `ServerMsg: Serialize` in the wire shape (design.md §Data
+//      Models) — agent_ui cannot import devtools_bridge, so it holds or re-exports them;
+//   - `answer_approval(id: SessionId, answer: ApprovalAnswer, cx: &mut App)`, which the
+//      notification's Allow/Deny buttons call (`ApprovalAnswer::{Allow, Deny}`); clicking a GPUI
+//      notification button is not drivable from a test, so the tests call it directly and check
+//      the notification's presence through `Workspace::notification_ids()`.
+
