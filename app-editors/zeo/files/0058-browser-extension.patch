index 0000000..6a64ba7
--- /dev/null
+++ b/crates/zeo_browser_host/src/main.rs
@@ -0,0 +1,125 @@
+//! `zeo-browser-host`: the native-messaging host the Zeo browser extension talks to. It relays
+//! native-messaging frames on stdio to Zeo's devtools bridge socket and back (design.md §B4).
+//!
+//! stdout belongs to the browser and carries nothing but frames (R2.8), so printing to it is a
+//! compile error here; logs and panics go to stderr as `zeo-browser-host event=… browser=…
+//! reason=…` lines with no message content (R13.3, R13.4).
+#![deny(clippy::print_stdout)]
+
+mod args;
+mod frame;
+mod relay;
+
+#[cfg(test)]
+mod args_tests;
+#[cfg(test)]
+mod frame_tests;
+#[cfg(test)]
+mod relay_tests;
+
+use std::env;
+use std::io::{self, Write as _};
+use std::process;
+
+use crate::args::ClientIdentity;
+
+/// Raises or lowers the stderr log level without a rebuild: `error`, `warn`, `info` (default),
+/// `debug`, `trace` or `off`.
+const LOG_LEVEL_VAR: &str = "ZEO_BROWSER_HOST_LOG";
+
+fn main() {
+    install_panic_hook();
+    ignore_sigpipe();
+    init_logging();
+
+    let identity = ClientIdentity::from_args(
+        env::args_os()
+            .skip(1)
+            .map(|arg| arg.to_string_lossy().into_owned()),
+    );
+    let browser = identity.browser.code();
+    log::info!("event=start browser={browser} reason=none");
+
+    let socket = match relay::resolve_socket(
+        env::var_os("ZEO_DEVTOOLS_SOCKET").as_deref(),
+        env::var_os("XDG_RUNTIME_DIR").as_deref(),
+    ) {
+        Ok(socket) => socket,
+        Err(unavailable) => {
+            relay::report_unavailable(&identity, unavailable, io::stdout());
+            process::exit(0);
+        }
+    };
+
+    match relay::run(&identity, &socket, io::stdin(), io::stdout()) {
+        // `exit` rather than returning: the thread still blocked reading stdin must not keep
+        // the process alive once the relay has ended (R2.3, R2.4).
+        Ok(()) => process::exit(0),
+        Err(error) => {
+            let detail = format!("{error:#}").replace('"', "'");
+            log::error!("event=exit browser={browser} reason=internal_error error=\"{detail}\"");
+            process::exit(1);
+        }
+    }
+}
+
+/// Panics go to stderr in the log format, naming only where they happened: a panic message
+/// could quote data, and stdout must never see a byte that is not a frame.
+fn install_panic_hook() {
+    std::panic::set_hook(Box::new(|info| {
+        let location = info
+            .location()
+            .map(|location| format!("{}:{}", location.file(), location.line()))
+            .unwrap_or_else(|| "unknown".to_string());
+        writeln!(
+            io::stderr().lock(),
+            "zeo-browser-host event=panic browser=unknown reason=panic location={location}"
+        )
+        .ok();
+    }));
+}
+
+/// With SIGPIPE ignored, writing to a stdout the browser has closed is an `EPIPE` error the
+/// relay handles (one log line, exit 0) instead of a silent kill.
+fn ignore_sigpipe() {
+    // SAFETY: `signal` with `SIG_IGN` only changes this process's disposition for SIGPIPE; it
+    // runs first thing in `main`, before any thread is spawned, and installs no handler code.
+    let previous = unsafe { libc::signal(libc::SIGPIPE, libc::SIG_IGN) };
+    if previous == libc::SIG_ERR {
+        writeln!(
+            io::stderr().lock(),
+            "zeo-browser-host event=start browser=unknown reason=sigpipe_not_ignored"
+        )
+        .ok();
+    }
+}
+
+struct StderrLogger;
+
+impl log::Log for StderrLogger {
+    fn enabled(&self, metadata: &log::Metadata<'_>) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record<'_>) {
+        if self.enabled(record.metadata()) {
+            writeln!(io::stderr().lock(), "zeo-browser-host {}", record.args()).ok();
+        }
+    }
+
+    fn flush(&self) {
+        io::stderr().flush().ok();
+    }
+}
+
+static LOGGER: StderrLogger = StderrLogger;
+
+fn init_logging() {
+    let level = env::var(LOG_LEVEL_VAR)
+        .ok()
+        .and_then(|value| value.parse::<log::LevelFilter>().ok())
+        .unwrap_or(log::LevelFilter::Info);
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(level);
+    }
+}
diff --git a/crates/zeo_browser_host/src/relay.rs b/crates/zeo_browser_host/src/relay.rs
new file mode 100644
index 0000000..1200806
--- /dev/null
+++ b/crates/zeo_browser_host/src/relay.rs
@@ -0,0 +1,538 @@
+//! The relay between the browser's stdio (native-messaging frames) and Zeo's devtools bridge
+//! socket (one JSON object per line), design.md §B4.
+//!
+//! Two threads move the bytes, one per direction; the calling thread waits for the first of
+//! them to end and decides the last frame the browser sees. Every stdout write goes through one
+//! mutex-guarded writer, so stdout carries whole frames and nothing else (R2.8).
+//!
+//! A browser can stop reading stdout and then close stdin, so a stdout write may block for
+//! good. Nothing that has to notice the end of the session ever waits on that writer: the
+//! calling thread only raises the `finished` flag, the stdin thread queues its refusals for a
+//! writer thread of their own, and the last frame is written off the calling thread.
+
+use std::ffi::OsStr;
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::net::Shutdown;
+use std::os::unix::net::UnixStream;
+use std::panic::{self, AssertUnwindSafe};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex, PoisonError};
+use std::thread;
+
+use anyhow::{Context as _, anyhow};
+use serde_json::{Map, Value, json};
+
+use crate::args::ClientIdentity;
+use crate::frame::{FrameError, MAX_FRAME_BYTES, read_frame, write_frame};
+
+/// The longest line accepted from Zeo, newline excluded. Chrome disconnects a host that sends it
+/// a message over 1 MB, so a longer line is dropped here instead (R2.6).
+pub const MAX_LINE_FROM_ZEO: usize = 1_000_000;
+
+/// The socket under `$XDG_RUNTIME_DIR`, as patch 0052's listener binds it.
+const SOCKET_UNDER_RUNTIME_DIR: &str = "zeo/devtools.sock";
+
+/// The protocol version every host-produced frame carries.
+const PROTOCOL_VERSION: u64 = 2;
+
+/// The longest request `id` the contract allows; a longer one is not echoed.
+const MAX_ID_CHARS: usize = 64;
+
+/// Read buffer for the socket; lines up to [`MAX_LINE_FROM_ZEO`] are assembled from it.
+const SOCKET_READ_BUFFER: usize = 64 * 1024;
+
+/// Refusals waiting for stdout. Past this many the newest are dropped (and logged), so a page
+/// flooding bad frames into a jammed stdout cannot grow the host's memory.
+const PENDING_REFUSALS: usize = 64;
+
+/// Why the bridge cannot be reached; `reason()` is the wire value of `bridge_unavailable`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Unavailable {
+    NoRuntimeDir,
+    Absent,
+    Refused,
+    Permission,
+}
+
+impl Unavailable {
+    pub fn reason(&self) -> &'static str {
+        match self {
+            Self::NoRuntimeDir => "no_runtime_dir",
+            Self::Absent => "absent",
+            Self::Refused => "refused",
+            Self::Permission => "permission",
+        }
+    }
+
+    fn from_connect_error(error: &io::Error) -> Self {
+        match error.kind() {
+            io::ErrorKind::ConnectionRefused => Self::Refused,
+            io::ErrorKind::PermissionDenied => Self::Permission,
+            // NotFound, NotADirectory, a path too long for `sun_path`, …: there is no socket
+            // to talk to at that path.
+            _ => Self::Absent,
+        }
+    }
+}
+
+/// The socket path: `$ZEO_DEVTOOLS_SOCKET` when set (R2.9), otherwise
+/// `$XDG_RUNTIME_DIR/zeo/devtools.sock`. An empty variable counts as unset, as in
+/// `zeo-devtools`'s `resolveSocketPath`. A missing or relative runtime dir is `no_runtime_dir`;
+/// a relative override names no socket the host can trust its working directory for, so it is
+/// `absent`.
+pub fn resolve_socket(
+    zeo_devtools_socket: Option<&OsStr>,
+    xdg_runtime_dir: Option<&OsStr>,
+) -> Result<PathBuf, Unavailable> {
+    if let Some(chosen) = zeo_devtools_socket.filter(|value| !value.is_empty()) {
+        let chosen = Path::new(chosen);
+        return if chosen.is_absolute() {
+            Ok(chosen.to_path_buf())
+        } else {
+            Err(Unavailable::Absent)
+        };
+    }
+    let runtime = xdg_runtime_dir
+        .filter(|value| !value.is_empty())
+        .map(Path::new)
+        .filter(|path| path.is_absolute())
+        .ok_or(Unavailable::NoRuntimeDir)?;
+    Ok(runtime.join(SOCKET_UNDER_RUNTIME_DIR))
+}
+
+/// Writes the one `bridge_unavailable` frame and the matching log lines (R2.2, R13.3). A broken
+/// stdout is logged, not returned: the browser is gone and there is nobody left to tell.
+pub fn report_unavailable(identity: &ClientIdentity, unavailable: Unavailable, stdout: impl Write) {
+    let browser = identity.browser.code();
+    let reason = unavailable.reason();
+    log::warn!("event=unavailable browser={browser} reason={reason}");
+    let output = Output::new(stdout);
+    let body = host_frame(json!({
+        "v": PROTOCOL_VERSION,
+        "kind": "bridge_unavailable",
+        "reason": reason,
+    }));
+    let exit_reason = match output.final_frame(&body) {
+        Ok(()) => reason,
+        Err(_) => "stdout_closed",
+    };
+    log::info!("event=exit browser={browser} reason={exit_reason}");
+}
+
+/// Connects to `socket` and relays until either side ends, having written any
+/// `bridge_unavailable` / `bridge_closed` frame itself. Every designed ending returns `Ok`; an
+/// `Err` is a failure of the host itself (a thread that could not start or panicked).
+pub fn run(
+    identity: &ClientIdentity,
+    socket: &Path,
+    stdin: impl Read + Send + 'static,
+    stdout: impl Write + Send + 'static,
+) -> anyhow::Result<()> {
+    let browser = identity.browser.code();
+    let stream = match UnixStream::connect(socket) {
+        Ok(stream) => stream,
+        Err(error) => {
+            report_unavailable(identity, Unavailable::from_connect_error(&error), stdout);
+            return Ok(());
+        }
+    };
+    log::info!("event=connected browser={browser} reason=none");
+
+    let output = Arc::new(Output::new(stdout));
+    let to_zeo = stream
+        .try_clone()
+        .context("cloning the bridge socket for the stdin thread")?;
+    let from_zeo = stream
+        .try_clone()
+        .context("cloning the bridge socket for the stdout thread")?;
+    let (ended, events) = mpsc::channel::<End>();
+    let (refuse, refusals) = mpsc::sync_channel::<Vec<u8>>(PENDING_REFUSALS);
+
+    spawn_pump("zeo-host-stdin", ended.clone(), {
+        let identity = identity.clone();
+        move || pump_stdin(&identity, stdin, to_zeo, &refuse)
+    })?;
+    spawn_pump("zeo-host-refusals", ended.clone(), {
+        let output = output.clone();
+        move || write_refusals(&refusals, &output)
+    })?;
+    spawn_pump("zeo-host-socket", ended.clone(), {
+        let output = output.clone();
+        move || pump_socket(browser, from_zeo, &output)
+    })?;
+
+    // The first ending decides, except that a closed bridge still owes the browser its
+    // `bridge_closed` frame. The other threads are left to die with the process (`main` exits
+    // right after) or, in-process, to stop at their next read or write.
+    let mut closing = false;
+    let exit_reason = loop {
+        let end = events
+            .recv()
+            .context("every relay thread ended without reporting why")?;
+        match end {
+            End::StdinClosed(reason) => {
+                output.finish();
+                break reason;
+            }
+            End::StdoutBroken => {
+                output.finish();
+                break "stdout_closed";
+            }
+            End::Written(reason) => break reason,
+            End::Idle => {}
+            End::SocketClosed(_) if closing => {}
+            End::SocketClosed(reason) => {
+                closing = true;
+                // Written off this thread: if the browser has stopped reading stdout, this
+                // write never returns, and a stdin close must still end the relay.
+                spawn_pump("zeo-host-final", ended.clone(), {
+                    let output = output.clone();
+                    move || {
+                        let body =
+                            host_frame(json!({ "v": PROTOCOL_VERSION, "kind": "bridge_closed" }));
+                        match output.final_frame(&body) {
+                            Ok(()) => End::Written(reason),
+                            Err(_) => End::StdoutBroken,
+                        }
+                    }
+                })?;
+            }
+            End::Panicked(thread) => {
+                output.finish();
+                stream.shutdown(Shutdown::Both).ok();
+                return Err(anyhow!("relay thread {thread} panicked"));
+            }
+        }
+    };
+    // Closing both directions is what tells the bridge the browser is gone (R2.4); on a socket
+    // that already ended it is a harmless no-op.
+    stream.shutdown(Shutdown::Both).ok();
+    log::info!("event=exit browser={browser} reason={exit_reason}");
+    Ok(())
+}
+
+/// How a relay thread ended. The payload is the `reason=` of the exit log line.
+#[derive(Debug)]
+enum End {
+    StdinClosed(&'static str),
+    SocketClosed(&'static str),
+    StdoutBroken,
+    /// The last frame (`bridge_closed`) reached stdout.
+    Written(&'static str),
+    /// A refusal writer with nothing left to write: not an ending.
+    Idle,
+    Panicked(&'static str),
+}
+
+fn spawn_pump(
+    name: &'static str,
+    ended: mpsc::Sender<End>,
+    pump: impl FnOnce() -> End + Send + 'static,
+) -> anyhow::Result<()> {
+    thread::Builder::new()
+        .name(name.to_string())
+        .spawn(move || {
+            let end = panic::catch_unwind(AssertUnwindSafe(pump)).unwrap_or(End::Panicked(name));
+            // The receiver is gone once the other direction ended first; nothing to report.
+            ended.send(end).ok();
+        })
+        .with_context(|| format!("spawning the {name} thread"))?;
+    Ok(())
+}
+
+/// The single stdout writer. Once `finished`, every frame not yet started is silently dropped,
+/// so the frame that ends the session is also the last byte on stdout.
+///
+/// `finished` is checked under the writer lock, so a frame is written whole or not at all; it
+/// is raised without the lock, so ending the session never waits on a blocked write.
+struct Output<W> {
+    writer: Mutex<W>,
+    finished: AtomicBool,
+}
+
+impl<W: Write> Output<W> {
+    fn new(writer: W) -> Self {
+        Self {
+            writer: Mutex::new(writer),
+            finished: AtomicBool::new(false),
+        }
+    }
+
+    fn frame(&self, body: &[u8]) -> io::Result<()> {
+        let mut writer = self.lock();
+        if self.finished.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        write_frame(&mut *writer, body)
+    }
+
+    fn final_frame(&self, body: &[u8]) -> io::Result<()> {
+        let mut writer = self.lock();
+        if self.finished.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        let written = write_frame(&mut *writer, body);
+        self.finish();
+        written
+    }
+
+    fn finish(&self) {
+        self.finished.store(true, Ordering::Release);
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, W> {
+        // A panic while holding the lock leaves a whole frame or none (one `write_all` per
+        // frame), so the writer is still usable.
+        self.writer.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+}
+
+fn host_frame(value: Value) -> Vec<u8> {
+    // Serialising a `Value` built from `json!` with string keys cannot fail; the fallback keeps
+    // that invariant visible without a panic path.
+    serde_json::to_vec(&value).unwrap_or_default()
+}
+
+// ---------------------------------------------------------------------------------------------
+// stdin → socket
+
+/// Why a frame from the browser was dropped with a `bad_request` (R2.5).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum Refusal {
+    TooLarge,
+    /// Not JSON at all, or nested deeper than serde_json's 128-level recursion limit.
+    InvalidJson,
+    NotObject,
+    BeforeHello {
+        id: Option<String>,
+    },
+}
+
+impl Refusal {
+    fn code(&self) -> &'static str {
+        match self {
+            Self::TooLarge => "too_large",
+            Self::InvalidJson => "invalid_json",
+            Self::NotObject => "not_object",
+            Self::BeforeHello { .. } => "before_hello",
+        }
+    }
+
+    fn frame(&self) -> Vec<u8> {
+        let message = match self {
+            Self::TooLarge => format!(
+                "The message is larger than the {} MiB the host relays",
+                MAX_FRAME_BYTES / (1024 * 1024)
+            ),
+            Self::InvalidJson => "A message must be valid JSON within 128 levels".to_string(),
+            Self::NotObject => "A message must be a JSON object".to_string(),
+            Self::BeforeHello { .. } => "The first message must be hello".to_string(),
+        };
+        let mut error = Map::new();
+        error.insert("v".into(), json!(PROTOCOL_VERSION));
+        error.insert("kind".into(), json!("error"));
+        if let Self::BeforeHello { id: Some(id) } = self {
+            error.insert("id".into(), json!(id));
+        }
+        error.insert("error".into(), json!("bad_request"));
+        error.insert("message".into(), json!(message));
+        error.insert("fatal".into(), json!(false));
+        host_frame(Value::Object(error))
+    }
+}
+
+/// The line to write to the bridge for one frame `body`, newline included: the message
+/// re-serialised compactly (no raw newline survives), with `client.browser` and
+/// `client.extension_id` overwritten from the arguments in every `hello`. Until a `hello` has
+/// gone through, any other message is refused, so a page can never slip a forged identity past
+/// the host by sending something else first.
+pub(crate) fn bridge_line(
+    identity: &ClientIdentity,
+    body: &[u8],
+    greeted: &mut bool,
+) -> Result<Vec<u8>, Refusal> {
+    let mut message = match serde_json::from_slice::<Value>(body) {
+        Ok(Value::Object(message)) => message,
+        Ok(_) => return Err(Refusal::NotObject),
+        Err(_) => return Err(Refusal::InvalidJson),
+    };
+    if message.get("kind").and_then(Value::as_str) == Some("hello") {
+        let client = message
+            .entry("client")
+            .or_insert_with(|| Value::Object(Map::new()));
+        if !client.is_object() {
+            *client = Value::Object(Map::new());
+        }
+        if let Value::Object(client) = client {
+            client.insert("browser".into(), json!(identity.browser.code()));
+            client.insert("extension_id".into(), json!(identity.extension_id));
+        }
+        *greeted = true;
+    } else if !*greeted {
+        let id = message
+            .get("id")
+            .and_then(Value::as_str)
+            .filter(|id| id.chars().count() <= MAX_ID_CHARS)
+            .map(str::to_string);
+        return Err(Refusal::BeforeHello { id });
+    }
+    let mut line = serde_json::to_vec(&message).map_err(|_| Refusal::NotObject)?;
+    line.push(b'\n');
+    Ok(line)
+}
+
+fn pump_stdin(
+    identity: &ClientIdentity,
+    mut stdin: impl Read,
+    mut socket: UnixStream,
+    refuse: &mpsc::SyncSender<Vec<u8>>,
+) -> End {
+    let browser = identity.browser.code();
+    let mut greeted = false;
+    loop {
+        let line = match read_frame(&mut stdin) {
+            Ok(None) => return End::StdinClosed("stdin_closed"),
+            Ok(Some(body)) => bridge_line(identity, &body, &mut greeted),
+            Err(FrameError::TooLarge { .. }) => Err(Refusal::TooLarge),
+            // A read error, or the port closing inside a frame: the browser is gone.
+            Err(FrameError::Io(_)) => return End::StdinClosed("stdin_error"),
+        };
+        match line {
+            Ok(line) => {
+                if socket.write_all(&line).is_err() {
+                    return End::SocketClosed("socket_write_error");
+                }
+                log::debug!(
+                    "event=relayed browser={browser} reason=none direction=to_zeo bytes={}",
+                    line.len()
+                );
+            }
+            Err(refusal) => {
+                log::warn!(
+                    "event=dropped browser={browser} reason={} direction=to_zeo",
+                    refusal.code()
+                );
+                match refuse.try_send(refusal.frame()) {
+                    Ok(()) => {}
+                    Err(mpsc::TrySendError::Full(_)) => log::warn!(
+                        "event=dropped browser={browser} reason=refusal_queue_full direction=to_browser"
+                    ),
+                    // The refusal writer only stops once stdout is broken.
+                    Err(mpsc::TrySendError::Disconnected(_)) => return End::StdoutBroken,
+                }
+            }
+        }
+    }
+}
+
+/// Writes the stdin thread's queued refusals, so a jammed stdout blocks this thread and never
+/// the one that must notice stdin closing.
+fn write_refusals<W: Write>(refusals: &mpsc::Receiver<Vec<u8>>, output: &Output<W>) -> End {
+    for refusal in refusals {
+        if output.frame(&refusal).is_err() {
+            return End::StdoutBroken;
+        }
+    }
+    End::Idle
+}
+
+// ---------------------------------------------------------------------------------------------
+// socket → stdout
+
+/// One line read under a cap.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Line {
+    /// A whole line, now in the buffer without its newline.
+    Complete,
+    /// A line over the cap, consumed up to and including its newline and discarded.
+    Oversized,
+    /// The end of the stream. A trailing line with no newline is discarded.
+    Eof,
+}
+
+/// Reads the next newline-terminated line into `buf` (cleared first), never holding more than
+/// `max` bytes of it: past the cap the rest of the line is skipped up to its newline.
+pub(crate) fn read_capped_line(
+    reader: &mut impl BufRead,
+    max: usize,
+    buf: &mut Vec<u8>,
+) -> io::Result<Line> {
+    buf.clear();
+    let mut oversized = false;
+    loop {
+        let available = match reader.fill_buf() {
+            Ok(available) => available,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        };
+        if available.is_empty() {
+            return Ok(Line::Eof);
+        }
+        let newline = available.iter().position(|&byte| byte == b'\n');
+        let chunk = &available[..newline.unwrap_or(available.len())];
+        if !oversized {
+            if buf.len() + chunk.len() > max {
+                oversized = true;
+                buf.clear();
+            } else {
+                buf.extend_from_slice(chunk);
+            }
+        }
+        let consumed = chunk.len() + usize::from(newline.is_some());
+        reader.consume(consumed);
+        if newline.is_some() {
+            return Ok(if oversized {
+                Line::Oversized
+            } else {
+                Line::Complete
+            });
+        }
+    }
+}
+
+fn oversized_from_zeo_frame() -> Vec<u8> {
+    host_frame(json!({
+        "v": PROTOCOL_VERSION,
+        "kind": "error",
+        "error": "oversized_from_zeo",
+        "message": "Zeo sent a message too large to relay",
+        "fatal": false,
+    }))
+}
+
+fn pump_socket<W: Write>(browser: &'static str, socket: UnixStream, output: &Output<W>) -> End {
+    let mut reader = BufReader::with_capacity(SOCKET_READ_BUFFER, socket);
+    let mut line = Vec::new();
+    loop {
+        let written = match read_capped_line(&mut reader, MAX_LINE_FROM_ZEO, &mut line) {
+            Ok(Line::Eof) => return End::SocketClosed("bridge_closed"),
+            Err(_) => return End::SocketClosed("socket_read_error"),
+            Ok(Line::Oversized) => {
+                log::warn!(
+                    "event=dropped browser={browser} reason=oversized_from_zeo direction=from_zeo"
+                );
+                output.frame(&oversized_from_zeo_frame())
+            }
+            Ok(Line::Complete) => {
+                // The browser disconnects the host on a frame that is not JSON; the bridge
+                // only writes JSON, so this only guards against a corrupt line.
+                if serde_json::from_slice::<serde::de::IgnoredAny>(&line).is_err() {
+                    log::warn!(
+                        "event=dropped browser={browser} reason=invalid_json direction=from_zeo"
+                    );
+                    continue;
+                }
+                log::debug!(
+                    "event=relayed browser={browser} reason=none direction=from_zeo bytes={}",
+                    line.len()
+                );
+                output.frame(&line)
+            }
+        };
+        if written.is_err() {
+            return End::StdoutBroken;
+        }
+    }
+}
