+#[test]
+fn session_an_unread_queue_of_300_lines_overflows_into_overloaded_and_a_close() {
+    let bridge = start_bridge(false);
+    let mut client = Client::hello(&bridge.dir);
+    wait_until("the session", || {
+        !bridge.rec.sinks.lock().unwrap().is_empty()
+    });
+    let sink = bridge.rec.sink(0);
+    for n in 0..300 {
+        let _ = sink.send(big_title(n));
+    }
+    let mut lines = 0;
+    let mut overloaded = false;
+    while let Some(line) = client.line() {
+        if line["kind"] == "error" {
+            assert_eq!(error_code(&line), "overloaded");
+            assert_eq!(line["fatal"], true);
+            overloaded = true;
+        } else {
+            lines += 1;
+        }
+    }
+    assert!(overloaded, "the session says why it closes");
+    assert!(lines < 300, "the overflowing lines are not delivered");
+}
