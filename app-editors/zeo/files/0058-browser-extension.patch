+/// A unix socket bound to `path` and never listened on: every connect is ECONNREFUSED.
+fn nix_bound_socket(path: &Path) -> std::os::fd::OwnedFd {
+    // SAFETY: plain libc calls on a fresh fd owned by the returned OwnedFd; the address is
+    // zero-initialised and filled within `sun_path`'s bounds by `zip`.
+    let fd = unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_STREAM, 0) };
+    assert!(fd >= 0, "socket()");
+    let owned = unsafe { <std::os::fd::OwnedFd as std::os::fd::FromRawFd>::from_raw_fd(fd) };
+    let mut sun: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    sun.sun_family = libc::AF_UNIX as libc::sa_family_t;
+    for (dst, src) in sun
+        .sun_path
+        .iter_mut()
+        .zip(path.as_os_str().as_encoded_bytes())
+    {
+        *dst = *src as libc::c_char;
+    }
+    let len = std::mem::size_of::<libc::sockaddr_un>() as libc::socklen_t;
+    let rc = unsafe { libc::bind(fd, std::ptr::from_ref(&sun).cast(), len) };
+    assert_eq!(rc, 0, "bind()");
+    owned
+}
