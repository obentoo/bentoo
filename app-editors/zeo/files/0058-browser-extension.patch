new file mode 100644
index 0000000..ad274ef
--- /dev/null
+++ b/crates/devtools_bridge/src/channel.rs
@@ -0,0 +1,680 @@
+//! The v2 session protocol between the browser extension (through `zeo-browser-host`) and Zeo:
+//! one JSON object per line, every message carrying `v: 2` and a `kind`.
+//!
+//! The message types are `agent_ui::browser_wire`'s, re-exported here: `agent_ui`'s
+//! `browser_channel` answers the sessions and cannot depend on this crate. What stays here reads
+//! a line from the socket: [`parse_client`] and the limits [`validate_send`] enforces, which share
+//! 033's validators in [`crate::protocol`].
+//!
+//! Field names and limits mirror `zeo-browser/src/contract.ts` and `src/limits.ts`; both
+//! validators are held to the same fixture files (`zeo-browser/test/contract/`), so a shape or
+//! limit changed here must change there too. "Characters" are Unicode code points, "bytes" are
+//! UTF-8 bytes, as on the extension's side. An element's `dom` is the exception: its caps are
+//! 033's, counted as 033 counts them (`protocol::check_dom`).
+
+use std::fmt;
+use std::marker::PhantomData;
+
+use base64::Engine as _;
+use serde::de::IgnoredAny;
+use serde::{Deserialize, Deserializer};
+use serde_json::value::RawValue;
+
+pub use agent_ui::browser_wire::*;
+
+use crate::protocol::{self, SCREENSHOT_MAX_BASE64_LEN, WireVersion, png_dimensions, within_chars};
+
+pub const MAX_ID_CHARS: usize = 64;
+pub const MAX_TEXT_CHARS: usize = 100_000;
+pub const MAX_ELEMENTS: usize = 20;
+pub const MAX_IMAGES: usize = 3;
+pub const MAX_CONSOLE_CAPTURES: usize = 1;
+pub const MAX_NETWORK_CAPTURES: usize = 1;
+pub const MAX_CAPTURE_ENTRIES: usize = 200;
+pub const MAX_CONSOLE_TEXT_BYTES: usize = 2048;
+pub const MAX_NETWORK_URL_BYTES: usize = 2048;
+pub const MAX_PAGE_URL_BYTES: usize = 2048;
+pub const MAX_HTML_BYTES: usize = 16_384;
+pub const MAX_SELECTOR_CHARS: usize = 512;
+pub const MAX_IMAGE_EDGE: u32 = protocol::SCREENSHOT_MAX_EDGE;
+/// Decoded bytes.
+pub const MAX_IMAGE_BYTES: usize = protocol::SCREENSHOT_MAX_BYTES;
+/// A network entry's HTTP status, when it has one.
+pub const NETWORK_STATUS_RANGE: std::ops::RangeInclusive<i64> = 100..=599;
+
+/// The most attachments a `send` can carry without breaking a per-type cap.
+const MAX_ATTACHMENTS: usize =
+    MAX_ELEMENTS + MAX_IMAGES + MAX_CONSOLE_CAPTURES + MAX_NETWORK_CAPTURES;
+
+/// Compared ASCII-case-insensitively, as the extension's `/^(?:https?|file):\/\//i` does.
+const PAGE_URL_SCHEMES: [&str; 3] = ["http://", "https://", "file://"];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum AttachmentKind {
+    Element,
+    Image,
+    Console,
+    Network,
+}
+
+fn attachment_kind_of(attachment: &Attachment) -> AttachmentKind {
+    match attachment {
+        Attachment::Element(_) => AttachmentKind::Element,
+        Attachment::Image(_) => AttachmentKind::Image,
+        Attachment::Console(_) => AttachmentKind::Console,
+        Attachment::Network(_) => AttachmentKind::Network,
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Parsing
+
+/// Parses one session line in the extension's order: `v` first (a missing `v` is
+/// `bad_request`, any other value but 2 is `unsupported_version`), then `kind` (not a string is
+/// `bad_request`, an unknown one `unknown_kind`), then the strict shape and every limit. A
+/// `send` is returned only after [`validate_send`] accepted it.
+///
+/// Nothing here buffers the line: the probe skips what it does not read, each kind is read into
+/// its own plain struct (an internally tagged enum would first copy the whole line into serde's
+/// `Content` tree, about 16 times its size), and a `send`'s attachments stay borrowed slices of
+/// the line until their counts have passed.
+pub fn parse_client(line: &[u8]) -> Result<ClientMsg, ChannelError> {
+    // serde reads a struct from a JSON array too; a message is an object only.
+    if line.trim_ascii_start().first() != Some(&b'{') {
+        return Err(bad("message is a JSON object"));
+    }
+    // The probe reads `v` and `kind` alone and skips every other field without allocating.
+    let probe: MessageProbe =
+        serde_json::from_slice(line).map_err(|_| bad("message is a JSON object"))?;
+    match probe.v {
+        WireVersion::Missing => return Err(bad("message carries v")),
+        WireVersion::Number(PROTOCOL_VERSION) => {}
+        WireVersion::Number(_) | WireVersion::Other => {
+            return Err(ChannelError::UnsupportedVersion);
+        }
+    }
+    let kind = match probe.kind {
+        KindProbe::Name(kind) => kind,
+        KindProbe::Missing | KindProbe::NotString => return Err(bad("kind is a string")),
+    };
+
+    let msg = match kind.as_str() {
+        "hello" => {
+            let wire: WireHello = read_fields(line)?;
+            ClientMsg::Hello {
+                v: wire.v,
+                id: wire.id,
+                client: wire.client,
+            }
+        }
+        "list_threads" => {
+            let wire: WireRequest = read_fields(line)?;
+            ClientMsg::ListThreads {
+                v: wire.v,
+                id: wire.id,
+            }
+        }
+        "subscribe" => {
+            let wire: WireSubscribe = read_fields(line)?;
+            ClientMsg::Subscribe {
+                v: wire.v,
+                id: wire.id,
+                target: wire.target,
+            }
+        }
+        "send" => ClientMsg::Send(parse_send(line)?),
+        "cancel" => {
+            let wire: WireRequest = read_fields(line)?;
+            ClientMsg::Cancel {
+                v: wire.v,
+                id: wire.id,
+            }
+        }
+        "authorize" => {
+            let wire: WireAuthorize = read_fields(line)?;
+            ClientMsg::Authorize {
+                v: wire.v,
+                id: wire.id,
+                request_id: wire.request_id,
+                option_id: wire.option_id,
+            }
+        }
+        "open_in_zeo" => {
+            let wire: WireRequest = read_fields(line)?;
+            ClientMsg::OpenInZeo {
+                v: wire.v,
+                id: wire.id,
+            }
+        }
+        _ => return Err(ChannelError::UnknownKind),
+    };
+    require(
+        msg.request_id()
+            .is_none_or(|id| within_chars(id, MAX_ID_CHARS)),
+        "id <= 64 characters",
+    )?;
+    Ok(msg)
+}
+
+/// A `send` read with its attachments' counts checked before any attachment is built.
+fn parse_send(line: &[u8]) -> Result<SendRequest, ChannelError> {
+    let wire: WireSend = read_fields(line)?;
+    check_id_and_text(&wire.id, &wire.text)?;
+    let kinds = wire
+        .attachments
+        .0
+        .iter()
+        .map(|raw| attachment_kind(raw))
+        .collect::<Result<Vec<_>, _>>()?;
+    check_counts(&kinds)?;
+    let attachments = wire
+        .attachments
+        .0
+        .iter()
+        .zip(kinds)
+        .map(|(raw, kind)| read_attachment(raw, kind))
+        .collect::<Result<Vec<_>, _>>()?;
+    let send = SendRequest {
+        v: wire.v,
+        id: wire.id,
+        text: wire.text,
+        attachments,
+    };
+    validate_send(&send)?;
+    Ok(send)
+}
+
+fn read_fields<'a, T: Deserialize<'a>>(line: &'a [u8]) -> Result<T, ChannelError> {
+    serde_json::from_slice(line).map_err(|_| bad("message fields match its kind"))
+}
+
+fn attachment_kind(raw: &RawValue) -> Result<AttachmentKind, ChannelError> {
+    const DETAIL: &str = "attachment type is element, image, console or network";
+    if !raw.get().trim_start().starts_with('{') {
+        return Err(bad(DETAIL));
+    }
+    let probe: TypeProbe = serde_json::from_str(raw.get()).map_err(|_| bad(DETAIL))?;
+    match probe.kind {
+        KindProbe::Name(kind) => match kind.as_str() {
+            "element" => Ok(AttachmentKind::Element),
+            "image" => Ok(AttachmentKind::Image),
+            "console" => Ok(AttachmentKind::Console),
+            "network" => Ok(AttachmentKind::Network),
+            _ => Err(bad(DETAIL)),
+        },
+        KindProbe::Missing | KindProbe::NotString => Err(bad(DETAIL)),
+    }
+}
+
+fn read_attachment(raw: &RawValue, kind: AttachmentKind) -> Result<Attachment, ChannelError> {
+    fn read<'a, T: Deserialize<'a>>(raw: &'a RawValue) -> Result<T, ChannelError> {
+        serde_json::from_str(raw.get()).map_err(|_| bad("attachment fields match its type"))
+    }
+    Ok(match kind {
+        AttachmentKind::Element => {
+            let wire: WireElement = read(raw)?;
+            Attachment::Element(ElementAttachment {
+                page_url: wire.page_url,
+                selector: wire.selector,
+                html: wire.html,
+                dom: wire.dom,
+            })
+        }
+        AttachmentKind::Image => {
+            let wire: WireImage = read(raw)?;
+            Attachment::Image(ImageAttachment {
+                mime: wire.mime,
+                data_b64: wire.data_b64,
+                w: wire.w,
+                h: wire.h,
+            })
+        }
+        AttachmentKind::Console => {
+            let wire: WireConsole = read(raw)?;
+            Attachment::Console(ConsoleCapture {
+                page_url: wire.page_url,
+                cut_short: wire.cut_short,
+                entries: wire.entries.0,
+            })
+        }
+        AttachmentKind::Network => {
+            let wire: WireNetwork = read(raw)?;
+            Attachment::Network(NetworkCapture {
+                page_url: wire.page_url,
+                cut_short: wire.cut_short,
+                entries: wire.entries.0,
+            })
+        }
+    })
+}
+
+// One plain struct per kind and per attachment type. Each names its discriminant as an ignored
+// field (the probe has already read it) so `deny_unknown_fields` still refuses everything else.
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireHello {
+    v: V2,
+    #[serde(rename = "kind")]
+    _kind: IgnoredAny,
+    #[serde(default, deserialize_with = "present")]
+    id: Option<String>,
+    client: ClientInfo,
+}
+
+/// `list_threads`, `cancel` and `open_in_zeo`.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireRequest {
+    v: V2,
+    #[serde(rename = "kind")]
+    _kind: IgnoredAny,
+    id: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireSubscribe {
+    v: V2,
+    #[serde(rename = "kind")]
+    _kind: IgnoredAny,
+    id: String,
+    target: SubscribeTarget,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireAuthorize {
+    v: V2,
+    #[serde(rename = "kind")]
+    _kind: IgnoredAny,
+    id: String,
+    request_id: String,
+    option_id: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireSend<'a> {
+    v: V2,
+    #[serde(rename = "kind")]
+    _kind: IgnoredAny,
+    id: String,
+    text: String,
+    #[serde(borrow)]
+    attachments: Capped<&'a RawValue, { MAX_ATTACHMENTS + 1 }>,
+}
+
+#[derive(Deserialize)]
+struct TypeProbe {
+    #[serde(default, rename = "type")]
+    kind: KindProbe,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireElement {
+    #[serde(rename = "type")]
+    _type: IgnoredAny,
+    page_url: String,
+    selector: String,
+    html: String,
+    dom: DomSummary,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireImage {
+    #[serde(rename = "type")]
+    _type: IgnoredAny,
+    mime: ImageMime,
+    data_b64: String,
+    w: u32,
+    h: u32,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireConsole {
+    #[serde(rename = "type")]
+    _type: IgnoredAny,
+    page_url: String,
+    cut_short: bool,
+    entries: Capped<ConsoleEntry, { MAX_CAPTURE_ENTRIES + 1 }>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireNetwork {
+    #[serde(rename = "type")]
+    _type: IgnoredAny,
+    page_url: String,
+    cut_short: bool,
+    entries: Capped<NetworkEntry, { MAX_CAPTURE_ENTRIES + 1 }>,
+}
+
+/// A JSON array of which only the first `KEEP` items are built; the rest are skipped unbuilt.
+/// `KEEP` is one past the limit, so the count check that follows still sees a longer array
+/// break it, while a huge array costs no more than `KEEP` items.
+struct Capped<T, const KEEP: usize>(Vec<T>);
+
+impl<'de, T: Deserialize<'de>, const KEEP: usize> Deserialize<'de> for Capped<T, KEEP> {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        deserializer.deserialize_seq(CappedVisitor::<T, KEEP>(PhantomData))
+    }
+}
+
+struct CappedVisitor<T, const KEEP: usize>(PhantomData<T>);
+
+impl<'de, T: Deserialize<'de>, const KEEP: usize> serde::de::Visitor<'de>
+    for CappedVisitor<T, KEEP>
+{
+    type Value = Capped<T, KEEP>;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("a JSON array")
+    }
+
+    fn visit_seq<A: serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {
+        let mut items = Vec::new();
+        while items.len() < KEEP {
+            match seq.next_element()? {
+                Some(item) => items.push(item),
+                None => return Ok(Capped(items)),
+            }
+        }
+        while seq.next_element::<IgnoredAny>()?.is_some() {}
+        Ok(Capped(items))
+    }
+}
+
+#[derive(Deserialize)]
+struct MessageProbe {
+    #[serde(default)]
+    v: WireVersion,
+    #[serde(default)]
+    kind: KindProbe,
+}
+
+/// What a message's `kind` is, read without failing: a non-string `kind` must not hide what
+/// `v` says, so every JSON value is accepted here.
+#[derive(Default)]
+enum KindProbe {
+    #[default]
+    Missing,
+    Name(String),
+    NotString,
+}
+
+impl<'de> Deserialize<'de> for KindProbe {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        deserializer.deserialize_any(KindProbeVisitor)
+    }
+}
+
+struct KindProbeVisitor;
+
+impl<'de> serde::de::Visitor<'de> for KindProbeVisitor {
+    type Value = KindProbe;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("any JSON value")
+    }
+
+    fn visit_str<E: serde::de::Error>(self, value: &str) -> Result<KindProbe, E> {
+        Ok(KindProbe::Name(value.to_string()))
+    }
+
+    fn visit_string<E: serde::de::Error>(self, value: String) -> Result<KindProbe, E> {
+        Ok(KindProbe::Name(value))
+    }
+
+    fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_i64<E: serde::de::Error>(self, _: i64) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_unit<E: serde::de::Error>(self) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_none<E: serde::de::Error>(self) -> Result<KindProbe, E> {
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_seq<A: serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<KindProbe, A::Error> {
+        while seq.next_element::<serde::de::IgnoredAny>()?.is_some() {}
+        Ok(KindProbe::NotString)
+    }
+
+    fn visit_map<A: serde::de::MapAccess<'de>>(self, mut map: A) -> Result<KindProbe, A::Error> {
+        while map
+            .next_entry::<serde::de::IgnoredAny, serde::de::IgnoredAny>()?
+            .is_some()
+        {}
+        Ok(KindProbe::NotString)
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// `send` validation (design.md §Validation rules, R12.5)
+
+/// Checks every limit of a `send`: the text, the per-type counts, then each attachment. One
+/// broken limit refuses the whole message, naming that limit.
+pub fn validate_send(send: &SendRequest) -> Result<(), ChannelError> {
+    check_id_and_text(&send.id, &send.text)?;
+    let kinds: Vec<AttachmentKind> = send.attachments.iter().map(attachment_kind_of).collect();
+    check_counts(&kinds)?;
+    for attachment in &send.attachments {
+        match attachment {
+            Attachment::Element(element) => check_element(element)?,
+            Attachment::Image(image) => check_image(image)?,
+            Attachment::Console(capture) => check_console(capture)?,
+            Attachment::Network(capture) => check_network(capture)?,
+        }
+    }
+    Ok(())
+}
+
+fn check_id_and_text(id: &str, text: &str) -> Result<(), ChannelError> {
+    require(within_chars(id, MAX_ID_CHARS), "id <= 64 characters")?;
+    require(
+        within_chars(text, MAX_TEXT_CHARS),
+        "text <= 100000 characters",
+    )
+}
+
+fn check_counts(kinds: &[AttachmentKind]) -> Result<(), ChannelError> {
+    let count = |wanted: AttachmentKind| kinds.iter().filter(|kind| **kind == wanted).count();
+    require(
+        count(AttachmentKind::Element) <= MAX_ELEMENTS,
+        "elements <= 20",
+    )?;
+    require(count(AttachmentKind::Image) <= MAX_IMAGES, "images <= 3")?;
+    require(
+        count(AttachmentKind::Console) <= MAX_CONSOLE_CAPTURES,
+        "console captures <= 1",
+    )?;
+    require(
+        count(AttachmentKind::Network) <= MAX_NETWORK_CAPTURES,
+        "network captures <= 1",
+    )
+}
+
+fn check_element(element: &ElementAttachment) -> Result<(), ChannelError> {
+    check_page_url(&element.page_url)?;
+    require(
+        within_chars(&element.selector, MAX_SELECTOR_CHARS),
+        "selector <= 512 characters",
+    )?;
+    require(element.html.len() <= MAX_HTML_BYTES, "html <= 16384 bytes")?;
+    protocol::check_dom(&element.dom)
+        .map_err(|_| bad("dom within 033's caps, <= 4096 bytes serialized"))
+}
+
+fn check_console(capture: &ConsoleCapture) -> Result<(), ChannelError> {
+    check_page_url(&capture.page_url)?;
+    require(
+        capture.entries.len() <= MAX_CAPTURE_ENTRIES,
+        "capture entries <= 200",
+    )?;
+    require(
+        capture
+            .entries
+            .iter()
+            .all(|entry| entry.text.len() <= MAX_CONSOLE_TEXT_BYTES),
+        "console text <= 2048 bytes",
+    )
+}
+
+fn check_network(capture: &NetworkCapture) -> Result<(), ChannelError> {
+    check_page_url(&capture.page_url)?;
+    require(
+        capture.entries.len() <= MAX_CAPTURE_ENTRIES,
+        "capture entries <= 200",
+    )?;
+    require(
+        capture
+            .entries
+            .iter()
+            .all(|entry| entry.url.len() <= MAX_NETWORK_URL_BYTES),
+        "network url <= 2048 bytes",
+    )?;
+    require(
+        capture.entries.iter().all(|entry| {
+            entry
+                .status
+                .is_none_or(|status| NETWORK_STATUS_RANGE.contains(&status))
+        }),
+        "network status within 100..=599",
+    )
+}
+
+fn check_page_url(url: &str) -> Result<(), ChannelError> {
+    require(url.len() <= MAX_PAGE_URL_BYTES, "page_url <= 2048 bytes")?;
+    let has_scheme = PAGE_URL_SCHEMES.iter().any(|scheme| {
+        url.as_bytes()
+            .get(..scheme.len())
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(scheme.as_bytes()))
+    });
+    require(
+        has_scheme,
+        "page_url starts with http://, https:// or file://",
+    )
+}
+
+fn check_image(image: &ImageAttachment) -> Result<(), ChannelError> {
+    let edge = 1..=MAX_IMAGE_EDGE;
+    require(
+        edge.contains(&image.w) && edge.contains(&image.h),
+        "image long edge <= 1568",
+    )?;
+    // Bounding the encoded length first keeps an oversized payload from being decoded at all.
+    require(
+        image.data_b64.len() <= SCREENSHOT_MAX_BASE64_LEN,
+        "image <= 4194304 bytes decoded",
+    )?;
+    // The STANDARD engine requires canonical padding, so unpadded or misaligned input fails.
+    let bytes = base64::engine::general_purpose::STANDARD
+        .decode(&image.data_b64)
+        .map_err(|_| bad("image data_b64 is canonical padded base64"))?;
+    require(
+        bytes.len() <= MAX_IMAGE_BYTES,
+        "image <= 4194304 bytes decoded",
+    )?;
+    let (mime, width, height) = image_header(&bytes).ok_or(bad("image bytes are PNG or JPEG"))?;
+    require(mime == image.mime, "image mime matches its bytes")?;
+    require(
+        width == image.w && height == image.h,
+        "image w and h match its header",
+    )
+}
+
+/// The format and pixel size read from the bytes themselves, as the extension's
+/// `readImageHeader` reads them.
+fn image_header(bytes: &[u8]) -> Option<(ImageMime, u32, u32)> {
+    if let Some((width, height)) = png_dimensions(bytes) {
+        return Some((ImageMime::Png, width, height));
+    }
+    jpeg_dimensions(bytes).map(|(width, height)| (ImageMime::Jpeg, width, height))
+}
+
+/// SOI, then the marker segments up to the first SOFn, whose height and width are u16 BE at
+/// +5 and +7. `None` for anything else, a truncated header included.
+fn jpeg_dimensions(bytes: &[u8]) -> Option<(u32, u32)> {
+    let at = |index: usize| bytes.get(index).copied();
+    let u16_at = |index: usize| Some(u16::from_be_bytes([at(index)?, at(index.checked_add(1)?)?]));
+
+    if bytes.get(..2)? != [0xff, 0xd8] {
+        return None;
+    }
+    let mut index = 2usize;
+    while index.checked_add(1)? < bytes.len() {
+        if at(index)? != 0xff {
+            return None;
+        }
+        // Any number of 0xFF fill bytes may precede a marker.
+        let mut marker = at(index + 1)?;
+        while marker == 0xff {
+            index += 1;
+            marker = at(index.checked_add(1)?)?;
+        }
+        // Markers that stand alone, with no length: TEM, RSTn, SOI.
+        if marker == 0x01 || (0xd0..=0xd8).contains(&marker) {
+            index += 2;
+            continue;
+        }
+        // End of image or start of scan before any frame header: no dimensions to read.
+        if marker == 0xd9 || marker == 0xda {
+            return None;
+        }
+        let length = usize::from(u16_at(index.checked_add(2)?)?);
+        if length < 2 {
+            return None;
+        }
+        // SOF0..SOF15, except DHT (C4), JPG (C8) and DAC (CC), which share the range.
+        let is_sof = (0xc0..=0xcf).contains(&marker) && ![0xc4, 0xc8, 0xcc].contains(&marker);
+        if is_sof {
+            if length < 7 {
+                return None;
+            }
+            let height = u16_at(index.checked_add(5)?)?;
+            let width = u16_at(index.checked_add(7)?)?;
+            return Some((u32::from(width), u32::from(height)));
+        }
+        index = index.checked_add(2)?.checked_add(length)?;
+    }
+    None
+}
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+fn bad(detail: &'static str) -> ChannelError {
+    ChannelError::BadRequest { detail }
+}
+
+fn require(condition: bool, detail: &'static str) -> Result<(), ChannelError> {
+    if condition { Ok(()) } else { Err(bad(detail)) }
+}
+
+/// An optional field that, when present, must hold a value: serde reads `null` as `None` for a
+/// plain `Option`, where the zod schema (`.optional()`) refuses it.
+fn present<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
