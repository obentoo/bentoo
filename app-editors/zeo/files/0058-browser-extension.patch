+// ---- real image bytes, built here (no image crate) ----
+
+fn crc32(bytes: &[u8]) -> u32 {
+    let mut crc = 0xffff_ffffu32;
+    for byte in bytes {
+        crc ^= u32::from(*byte);
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 {
+                (crc >> 1) ^ 0xedb8_8320
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    !crc
+}
+
+fn adler32(bytes: &[u8]) -> u32 {
+    let (mut a, mut b) = (1u32, 0u32);
+    for byte in bytes {
+        a = (a + u32::from(*byte)) % 65521;
+        b = (b + a) % 65521;
+    }
+    (b << 16) | a
+}
+
+fn chunk(kind: &[u8; 4], data: &[u8]) -> Vec<u8> {
+    let mut out = (data.len() as u32).to_be_bytes().to_vec();
+    let mut body = kind.to_vec();
+    body.extend_from_slice(data);
+    out.extend_from_slice(&body);
+    out.extend_from_slice(&crc32(&body).to_be_bytes());
+    out
+}
+
+/// A real, decodable RGB PNG (stored deflate blocks); `pad` grows the file with an ancillary chunk.
+fn png(w: u32, h: u32, pad: usize) -> String {
+    let mut ihdr = w.to_be_bytes().to_vec();
+    ihdr.extend_from_slice(&h.to_be_bytes());
+    ihdr.extend_from_slice(&[8, 2, 0, 0, 0]);
+    let raw: Vec<u8> = (0..h)
+        .flat_map(|_| std::iter::once(0u8).chain(std::iter::repeat_n(0u8, (w * 3) as usize)))
+        .collect();
+    let mut zlib = vec![0x78, 0x01];
+    let blocks: Vec<&[u8]> = raw.chunks(65535).collect();
+    for (i, block) in blocks.iter().enumerate() {
+        zlib.push(u8::from(i + 1 == blocks.len()));
+        let len = block.len() as u16;
+        zlib.extend_from_slice(&len.to_le_bytes());
+        zlib.extend_from_slice(&(!len).to_le_bytes());
+        zlib.extend_from_slice(block);
+    }
+    zlib.extend_from_slice(&adler32(&raw).to_be_bytes());
+    let mut file = vec![0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];
+    file.extend(chunk(b"IHDR", &ihdr));
+    if pad > 0 {
+        file.extend(chunk(b"zeRo", &vec![0; pad]));
+    }
+    file.extend(chunk(b"IDAT", &zlib));
+    file.extend(chunk(b"IEND", &[]));
+    base64::engine::general_purpose::STANDARD.encode(file)
+}
+
+/// A real 2×1 JPEG produced with ImageMagick at authoring time.
+const JPEG_2X1: &str = "";
+
+/// The real JPEG with its SOF0 dimensions rewritten.
+fn jpeg_claiming(w: u16, h: u16) -> String {
+    let engine = base64::engine::general_purpose::STANDARD;
+    let mut bytes = engine.decode(JPEG_2X1).expect("base64");
+    let sof = bytes
+        .windows(2)
+        .position(|pair| pair == [0xff, 0xc0])
+        .expect("SOF0");
+    bytes[sof + 5..sof + 7].copy_from_slice(&h.to_be_bytes());
+    bytes[sof + 7..sof + 9].copy_from_slice(&w.to_be_bytes());
+    engine.encode(bytes)
+}
