+// ---------------------------------------------------------------------------------------------
+// Story 045, task 7.2 — the bridge wired to `agent_ui::browser_channel` through `init_in`
+// (design.md §B1 Wiring, §B2; R4.1 at the socket, R3.1, R13.1, R13.4; Q4, Q15).
+//
+// Hostile half: with `DevtoolsBridge::listen()` still on `listener::start` (v1 only), the same
+// `hello` is answered by the v1 path and no session is opened, so `approval_pending` never comes.
+
+mod browser_sessions {
+    use std::io::{ErrorKind, Read as _, Write as _};
+    use std::os::unix::net::UnixStream;
+    use std::path::{Path, PathBuf};
+    use std::time::Duration;
+
+    use gpui::{Entity, TestAppContext};
+    use serde_json::{Value, json};
+    use workspace::Workspace;
+
+    use super::{init, lines, shared_fs, window};
+
+    /// A bridge started the way the app starts it, with one window open on `/p/app`.
+    struct Bridge {
+        _tmp: tempfile::TempDir,
+        dir: PathBuf,
+        workspace: Entity<Workspace>,
+        _vcx: gpui::VisualTestContext,
+    }
+
+    async fn start(cx: &mut TestAppContext) -> Bridge {
+        // The bridge thread wakes the foreground relay from outside the test scheduler: real
+        // socket I/O, which the scheduler admits only with parking allowed.
+        cx.executor().allow_parking();
+        init(cx);
+        let fs = shared_fs(cx).await;
+        let (workspace, vcx) = window(&fs, "/p/app", cx).await;
+        let tmp = tempfile::tempdir().expect("a temp dir");
+        let dir = std::fs::canonicalize(tmp.path())
+            .expect("a canonical temp dir")
+            .join("zeo");
+        let app_state = workspace.read_with(cx, |workspace, _| workspace.app_state().clone());
+        cx.update(|cx| crate::init_in(dir.clone(), app_state, cx));
+        cx.run_until_parked();
+        Bridge {
+            _tmp: tmp,
+            dir,
+            workspace,
+            _vcx: vcx,
+        }
+    }
+
+    impl Bridge {
+        fn notifications(&self, cx: &mut TestAppContext) -> usize {
+            self.workspace
+                .read_with(cx, |workspace, _| workspace.notification_ids().len())
+        }
+    }
+
+    /// A raw socket peer. Replies need the foreground (the session relay and `browser_channel`
+    /// run there), so every wait pumps the test app between non-blocking reads.
+    struct Peer {
+        stream: UnixStream,
+        pending: Vec<u8>,
+    }
+
+    impl Peer {
+        fn connect(dir: &Path) -> Self {
+            let stream = UnixStream::connect(dir.join("devtools.sock")).expect("connect");
+            stream.set_nonblocking(true).expect("non-blocking");
+            Self {
+                stream,
+                pending: Vec::new(),
+            }
+        }
+
+        fn send(&mut self, value: &Value) {
+            let mut line = serde_json::to_vec(value).expect("serializes");
+            line.push(b'\n');
+            self.stream.set_nonblocking(false).expect("blocking write");
+            self.stream.write_all(&line).expect("write");
+            self.stream.set_nonblocking(true).expect("non-blocking");
+        }
+
+        /// The next line, or `None` if none arrives within about 10 s or the bridge closes.
+        fn next(&mut self, cx: &mut TestAppContext) -> Option<Value> {
+            for _ in 0..1000 {
+                if let Some(end) = self.pending.iter().position(|byte| *byte == b'\n') {
+                    let line: Vec<u8> = self.pending.drain(..=end).collect();
+                    return Some(serde_json::from_slice(&line).expect("one JSON object per line"));
+                }
+                cx.run_until_parked();
+                let mut chunk = [0u8; 4096];
+                match self.stream.read(&mut chunk) {
+                    Ok(0) => return None,
+                    Ok(read) => self.pending.extend_from_slice(&chunk[..read]),
+                    Err(error) if error.kind() == ErrorKind::WouldBlock => {
+                        std::thread::sleep(Duration::from_millis(10));
+                    }
+                    Err(error) => panic!("reading the bridge: {error}"),
+                }
+            }
+            None
+        }
+    }
+
+    fn hello(extension_id: &str) -> Value {
+        json!({ "v": 2, "kind": "hello", "client": { "browser": "chrome", "extension_id": extension_id, "extension_version": "0.1.0" } })
+    }
+
+    /// The listener's id for the session of `extension_id`, read off its `session_open` line.
+    fn session_of(extension_id: &str) -> Option<String> {
+        let needle = format!("extension={extension_id:?}");
+        lines().into_iter().find_map(|(_, line)| {
+            if !(line.contains("event=session_open") && line.contains(&needle)) {
+                return None;
+            }
+            let rest = line.split("session=").nth(1)?;
+            Some(rest.split(' ').next()?.to_string())
+        })
+    }
+
+    /// `session_released` lines for this listener's session `session` of `extension_id`; the
+    /// extension tells it from another test's listener, which numbers its sessions from 1 too.
+    fn released(session: &str, extension_id: &str) -> usize {
+        let needle = format!("event=session_released session={session} ");
+        let extension = format!("extension={extension_id:?}");
+        lines()
+            .into_iter()
+            .filter(|(_, line)| line.contains(&needle) && line.contains(&extension))
+            .count()
+    }
+
+    fn pump(cx: &mut TestAppContext, until: impl Fn() -> bool) {
+        for _ in 0..1000 {
+            cx.run_until_parked();
+            if until() {
+                return;
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+
+    #[gpui::test]
+    async fn wiring_browser_hello_reaches_browser_channel_and_v1_is_still_answered(
+        cx: &mut TestAppContext,
+    ) {
+        let bridge = start(cx).await;
+        let notifications = bridge.notifications(cx);
+
+        let mut browser = Peer::connect(&bridge.dir);
+        browser.send(&hello("wiring-ext-pending"));
+        let reply = browser.next(cx).expect("the hello is answered");
+        assert_eq!(
+            (reply["v"].clone(), reply["kind"].clone()),
+            (json!(2), json!("approval_pending")),
+            "a v2 hello opens a session that browser_channel answers: {reply}"
+        );
+        assert_eq!(
+            bridge.notifications(cx),
+            notifications + 1,
+            "R4.1: the approval prompt is shown"
+        );
+
+        // The session stays open while a v1 request is served on the same socket.
+        let mut page = Peer::connect(&bridge.dir);
+        page.send(&json!({ "v": 1 }));
+        let answer = page
+            .next(cx)
+            .expect("R3.1: the v1 request is still answered");
+        assert_eq!(answer["v"], json!(1), "{answer}");
+        assert_eq!(
+            answer["ok"],
+            json!(false),
+            "a malformed v1 request: {answer}"
+        );
+    }
+
+    #[gpui::test]
+    async fn wiring_browser_peer_eof_reaches_close_session_exactly_once(cx: &mut TestAppContext) {
+        let bridge = start(cx).await;
+        let notifications = bridge.notifications(cx);
+        let mut browser = Peer::connect(&bridge.dir);
+        browser.send(&hello("wiring-ext-eof"));
+        let reply = browser.next(cx).expect("the hello is answered");
+        assert_eq!(reply["kind"], json!("approval_pending"), "{reply}");
+        let session = session_of("wiring-ext-eof").expect("the listener logged session_open");
+
+        // A message before approval is refused, and nothing it carries is logged (R13.4).
+        let since = lines().len();
+        browser.send(&json!({ "v": 2, "kind": "send", "id": "s1", "text": "SECRET-PROMPT-TEXT http://example.invalid/x", "attachments": [] }));
+        let refusal = browser.next(cx).expect("the send is answered");
+        assert_eq!(refusal["error"], json!("not_approved"), "{refusal}");
+        assert_eq!(refusal["id"], json!("s1"), "{refusal}");
+        for (_, line) in lines().into_iter().skip(since) {
+            assert!(
+                !line.contains("SECRET-PROMPT-TEXT") && !line.contains("example.invalid"),
+                "R13.4: message text was logged in: {line}"
+            );
+        }
+
+        drop(browser);
+        pump(cx, || released(&session, "wiring-ext-eof") > 0);
+        // Whatever else is still queued gets its chance to arrive twice.
+        for _ in 0..20 {
+            cx.run_until_parked();
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        assert_eq!(
+            released(&session, "wiring-ext-eof"),
+            1,
+            "the peer's EOF reaches close_session exactly once"
+        );
+        assert_eq!(
+            bridge.notifications(cx),
+            notifications,
+            "closing the session dismissed its pending approval prompt"
+        );
+    }
+}
