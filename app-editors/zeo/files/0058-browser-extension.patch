+fn relay_unreachable_bridge_writes_one_bridge_unavailable_frame_with_its_reason() {
+    let tmp = tempfile::tempdir().expect("temp");
+    // absent
+    let relay = run_relay(&[&chrome()], &tmp.path().join("nothing.sock"));
+    let (result, out) = relay.finish();
+    result.expect("exit 0");
+    assert_eq!(
+        out.frames(true),
+        vec![json!({ "v": 2, "kind": "bridge_unavailable", "reason": "absent" })]
+    );
+    // refused: bound, never listening
+    let stale = tmp.path().join("stale.sock");
+    let socket = nix_bound_socket(&stale);
+    let (result, out) = run_relay(&[&chrome()], &stale).finish();
+    result.expect("exit 0");
+    assert_eq!(
+        out.frames(true),
+        vec![json!({ "v": 2, "kind": "bridge_unavailable", "reason": "refused" })]
+    );
+    drop(socket);
+    // permission: a socket inside a directory we cannot search
+    let locked = tmp.path().join("locked");
+    std::fs::create_dir(&locked).expect("dir");
+    let _listener = UnixListener::bind(locked.join("devtools.sock")).expect("bind");
+    std::fs::set_permissions(&locked, std::fs::Permissions::from_mode(0o000)).expect("chmod");
+    let (result, out) = run_relay(&[&chrome()], &locked.join("devtools.sock")).finish();
+    std::fs::set_permissions(&locked, std::fs::Permissions::from_mode(0o700)).expect("chmod back");
+    result.expect("exit 0");
+    assert_eq!(
+        out.frames(true),
+        vec![json!({ "v": 2, "kind": "bridge_unavailable", "reason": "permission" })]
+    );
+}
