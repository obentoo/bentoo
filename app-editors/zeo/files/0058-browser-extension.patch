+// Review note (6.1): a parse failure (including nesting past serde_json's 128 levels) is worded
+// as invalid JSON; only a well-formed non-object is "must be a JSON object".
+#[test]
+fn relay_bad_request_wording_tells_invalid_json_from_a_non_object() {
+    let zeo = fake_zeo();
+    let mut relay = run_relay(&[&chrome()], &zeo.path);
+    relay.send_json(&hello_forged());
+    zeo.wait_lines(1);
+    let deep = format!("{}{}", "[".repeat(200), "]".repeat(200));
+    relay.send(deep.as_bytes());
+    relay.send(b"[1,2,3]");
+    relay.send(b"not json");
+    let end = Instant::now() + Duration::from_secs(5);
+    while relay
+        .out
+        .frames(false)
+        .iter()
+        .filter(|f| f["error"] == "bad_request")
+        .count()
+        < 3
+    {
+        assert!(Instant::now() < end, "{:?}", relay.out.frames(false));
+        thread::sleep(Duration::from_millis(10));
+    }
+    let messages: Vec<String> = relay
+        .out
+        .frames(false)
+        .iter()
+        .filter(|f| f["error"] == "bad_request")
+        .map(|f| f["message"].as_str().unwrap_or_default().to_string())
+        .collect();
+    assert_eq!(
+        messages,
+        [
+            "A message must be valid JSON within 128 levels",
+            "A message must be a JSON object",
+            "A message must be valid JSON within 128 levels",
+        ]
+    );
