+// Story 064, task 7.2 — the browser sidebar's thread snapshot carries the thread's ACP children
+// (R6.2). Patch `0058` (fixup). Wired INSIDE `src/browser_channel.rs`, beside `mod stream;`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/browser_wire_subagents.rs"]
+//     mod browser_wire_subagents;
+//
+// so the path `browser_channel::browser_wire_subagents::…` matches the Validation filter
+// `cargo test -p agent_ui browser_wire`. Fixtures and seams: `test_support` (story 045).
+//
+// Carrier settled (Revision 1, 2026-10-29): the snapshot's optional `subagents` field, omitted
+// when the thread has no child; zeo-browser 0.2.0 reads it (task 7.3).
+//
+// A child is built as `agent_servers::acp::apply_subagent_update` builds one (an `agent_owned`
+// thread under the parent's session, its association, `register_subagent`).
+//
+// Contract assumed: the wire statuses of `browser_wire/subagents_tests.rs`; the entry's title is
+// R1.2's (the association's title, else the child's own, else "Subagent").
+//
+// Hostile halves first: a thread with no child sends no `subagents` key (0.1.x keeps working for
+// it); two children with one title are two entries; a child's own title never beats the
+// parent's label for it; then the benign two children with their statuses.
+
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection};
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{AppContext as _, Entity, TestAppContext};
+use serde_json::{Value, json};
+
+use super::test_support::*;
+
+fn spawn_child(
+    win: &mut Win,
+    connection: &StubAgentConnection,
+    session: &str,
+    title: Option<&str>,
+) -> Entity<AcpThread> {
+    let parent = win.thread();
+    let parent_session = parent.read_with(&win.cx, |thread, _| thread.session_id().clone());
+    let shared: Rc<dyn AgentConnection> = Rc::new(connection.clone());
+    let child = win.cx.update(|_, cx| {
+        let project = parent.read(cx).project().clone();
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        cx.new(|cx| {
+            AcpThread::new(
+                Some(parent_session),
+                None,
+                None,
+                shared,
+                project,
+                action_log,
+                acp_v2::SessionId::new(session.to_string()),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+            .agent_owned()
+        })
+    });
+    win.cx.update(|_, cx| connection.track_session(&child, cx));
+    let mut update = acp_v2::SubagentUpdate::new(session.to_string());
+    if let Some(title) = title {
+        update = update.title(title.to_string());
+    }
+    child
+        .update(&mut win.cx, |child, cx| {
+            child.update_subagent_association(&update, cx)
+        })
+        .expect("an agent-owned thread takes an association");
+    parent.update(&mut win.cx, |parent, cx| {
+        parent.register_subagent(child.clone(), cx)
+    });
+    win.cx.run_until_parked();
+    child
+}
+
+fn report(win: &mut Win, child: &Entity<AcpThread>, state: acp_v2::StateUpdate) {
+    child
+        .update(&mut win.cx, |child, cx| {
+            child.update_session_state(state, cx)
+        })
+        .expect("an agent-owned thread reports its state");
+    win.cx.run_until_parked();
+}
+
+/// The snapshot a following subscriber receives.
+fn followed_snapshot(win: &Win, cx: &mut TestAppContext) -> Value {
+    let probe = open_session(1);
+    approve(&probe, &win.app_state(), cx);
+    probe.handle(
+        request("subscribe", "s", json!({ "target": { "follow": true } })),
+        &win.app_state(),
+        cx,
+    );
+    let msgs = probe.drain(cx);
+    msgs.iter()
+        .find(|m| m["kind"] == "snapshot")
+        .cloned()
+        .unwrap_or_else(|| panic!("a snapshot: {msgs:?}"))
+}
+
+/// Where the children travel; the one line to change if the operator picks another carrier.
+fn subagents_of(snapshot: &Value) -> Option<&Value> {
+    snapshot.get("subagents")
+}
+
+async fn rfd_window(cx: &mut TestAppContext) -> (Win, StubAgentConnection) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    let mut win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    activate(&mut win);
+    (win, connection)
+}
+
+/// Hostile (compatibility): no child, no key.
+#[gpui::test]
+async fn browser_wire_subagents_absent_for_a_thread_without_children(cx: &mut TestAppContext) {
+    let (win, _connection) = rfd_window(cx).await;
