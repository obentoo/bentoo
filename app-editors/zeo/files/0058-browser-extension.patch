+/// The most recently active window (see [`WindowRecency`]) and the workspace it
+/// shows, or `None` when no window can be read. Used by the browser channel to
+/// place its approval prompt.
+///
+/// Do not call it from inside a window update: a leased window is skipped.
+pub(crate) fn most_recent_window(cx: &App) -> Option<(AnyWindowHandle, Entity<Workspace>)> {
+    let recency = WindowRecency::new(cx);
+    let mut best: Option<(Recency, AnyWindowHandle, Entity<Workspace>)> = None;
+    for window in cx.windows() {
+        let Some(multi_workspace) = window
+            .downcast::<MultiWorkspace>()
+            .and_then(|handle| handle.read(cx).ok())
+        else {
+            continue;
+        };
+        let rank = recency.rank(window);
+        // Strictly greater, as in `resolve_window_for_path_with`.
+        if best.as_ref().is_none_or(|(best, _, _)| rank > *best) {
+            best = Some((rank, window, multi_workspace.workspace().clone()));
+        }
+    }
+    best.map(|(_, window, workspace)| (window, workspace))
+}
+
+/// Every window's workspaces, the most recently active window first (see [`WindowRecency`]),
+/// each window's active workspace first. Used by the browser channel to list threads.
+///
+/// Do not call it from inside a window update: a leased window is skipped.
+pub(crate) fn workspaces_by_recency(cx: &App) -> Vec<(AnyWindowHandle, Vec<Entity<Workspace>>)> {
+    let recency = WindowRecency::new(cx);
+    let mut windows: Vec<(Recency, AnyWindowHandle, Vec<Entity<Workspace>>)> = cx
+        .windows()
+        .into_iter()
+        .filter_map(|window| {
+            let multi_workspace = window
+                .downcast::<MultiWorkspace>()
+                .and_then(|handle| handle.read(cx).ok())?;
+            let active = multi_workspace.workspace().clone();
+            let mut workspaces = vec![active.clone()];
+            workspaces.extend(
+                multi_workspace
+                    .workspaces()
+                    .filter(|workspace| **workspace != active)
+                    .cloned(),
+            );
+            Some((recency.rank(window), window, workspaces))
+        })
+        .collect();
+    // Stable: windows of equal rank keep the app's order.
+    windows.sort_by_key(|(rank, _, _)| Reverse(*rank));
+    windows
+        .into_iter()
+        .map(|(_, window, workspaces)| (window, workspaces))
+        .collect()
+}
