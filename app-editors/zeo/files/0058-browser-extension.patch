+// Story 045, task 5.2 — the v2 session protocol types and validation (design.md §B1, §Data
+// Models, §Validation rules). Requirements: R3.3, R3.5, R3.6, R3.7, R3.10, R12.5 (Q4, Q14).
+// Wired in the crate root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod channel_tests;
+//
+// Validation filter: `channel` (every test path is `channel_tests::…`).
+//
+// Contract (tasks.md 5.2 Objective). Assumed signatures — if one moves, adjust the `use` and the
+// helpers `verdict`/`server` only:
+//   - `crate::channel::parse_client(line: &[u8]) -> Result<ClientMsg, ChannelError>`;
+//   - `crate::channel::validate_send(&send) -> Result<(), ChannelError>`, reached through the
+//     `ClientMsg::Send(_)` variant (if `parse_client` already validates, `verdict` still holds);
+//   - `crate::channel::encode_server(&ServerMsg) -> Result<String, EncodeError>`;
+//   - `ChannelError` (de)serializes as its snake_case wire code and has `fatal()` and `message()`;
+//   - `ServerMsg` deserializes from the wire (the agreement test needs it too).
+// The test builds messages from wire JSON, so it pins the contract's field names, not structs.
+//
+// Hostile halves first:
+//   - order: `v` decides before `kind` — `v: 1` with a bogus kind is `unsupported_version`;
+//   - text counts code points: 100 000 astral characters (400 000 bytes) pass, 100 001 fail;
+//   - byte caps count bytes: 1 025 "é" break the 2 KiB console cap;
+//   - image identity: a JPEG labelled PNG and a PNG labelled JPEG both fail; true labels pass;
+//   - `fatal()` in both directions: the session-ending codes are fatal AND the per-message codes
+//     are not (a session that dies on `bad_request` breaks R3.5).
+
+use base64::Engine as _;
+use serde_json::{Value, json};
+
+use crate::channel::{
+    ChannelError, ClientMsg, ServerMsg, encode_server, parse_client, validate_send,
+};
+
+fn code(error: &ChannelError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("ChannelError must serialize to its wire code, got {other:?}"),
+    }
+}
+
+fn error(code: &str) -> ChannelError {
+    serde_json::from_value(json!(code)).unwrap_or_else(|e| panic!("{code} is a ChannelError: {e}"))
+}
+
+fn verdict_bytes(line: &[u8]) -> String {
+    match parse_client(line) {
+        Err(error) => code(&error),
+        Ok(ClientMsg::Send(send)) => match validate_send(&send) {
+            Ok(()) => "accepted".to_string(),
+            Err(error) => code(&error),
+        },
+        Ok(_) => "accepted".to_string(),
+    }
+}
