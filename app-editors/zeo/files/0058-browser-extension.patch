+#[test]
+fn session_malformed_lines_are_answered_and_the_session_kept() {
+    let bridge = start_bridge(true);
+    let mut client = Client::hello(&bridge.dir);
+    client.line().expect("welcome");
+
+    let mut huge = vec![b'a'; 8 * MIB + 1];
+    huge.push(b'\n');
+    client.send_raw(&huge);
+    assert_eq!(error_code(&client.line().expect("answer")), "too_large");
+    client.send_raw(b"{not json\n");
+    assert_eq!(error_code(&client.line().expect("answer")), "bad_request");
+    client.send(&json!({ "v": 2, "kind": "teleport", "id": "a" }));
+    assert_eq!(error_code(&client.line().expect("answer")), "unknown_kind");
+    client.send(&json!({ "v": 1, "kind": "cancel", "id": "a" }));
+    assert_eq!(
+        error_code(&client.line().expect("answer")),
+        "unsupported_version"
+    );
+
+    client.send(&json!({ "v": 2, "kind": "cancel", "id": "c1" }));
+    wait_until("the valid message after four bad ones", || {
+        bridge
+            .rec
+            .messages
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|m| m.contains("cancel"))
+    });
+    assert_eq!(
+        bridge.rec.messages.lock().unwrap().len(),
+        1,
+        "malformed lines never reach the handler"
+    );
+}
