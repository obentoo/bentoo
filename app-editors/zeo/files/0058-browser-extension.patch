+// Story 045, task 6.1 — the calling extension's identity, from the browser's arguments
+// (design.md §B4 Arguments; R2.7). Wired in `src/main.rs` as
+//
+//     #[cfg(test)]
+//     mod args_tests;
+//
+// Assumed signature (adjust `identity` only): `crate::args::ClientIdentity::from_args(args)`,
+// taking the arguments after argv[0], and `ClientIdentity: Serialize` to the hello's `client`
+// keys `{ "browser", "extension_id" }` — the exact object the host injects.
+//
+// Hostile halves first: an argument that only LOOKS like an origin (another scheme, an empty id)
+// is `unknown`, never trusted; Chrome's extra Windows flag does not change the identity; the
+// Firefox shape is recognised by its add-on id, not by position alone.
+
+use serde_json::Value;
+
+use crate::args::ClientIdentity;
+
+fn identity(args: &[&str]) -> (String, String) {
+    let value = serde_json::to_value(ClientIdentity::from_args(
+        args.iter().map(|a| a.to_string()),
+    ))
+    .expect("serializes");
+    (
+        value["browser"].as_str().unwrap_or_default().to_string(),
+        value["extension_id"]
+            .as_str()
+            .unwrap_or_default()
+            .to_string(),
+    )
+}
+
+const ID: &str = "abcdefghijklmnopabcdefghijklmnop";
+
+#[test]
+fn args_chrome_origin_gives_the_extension_id() {
+    let (browser, id) = identity(&[&format!("chrome-extension://{ID}/")]);
+    assert!(browser == "chrome" || browser == "chromium", "{browser}");
+    assert_eq!(id, ID);
+}
+
+#[test]
+fn args_chrome_parent_window_flag_does_not_change_the_identity() {
+    assert_eq!(
+        identity(&[&format!("chrome-extension://{ID}/"), "--parent-window=0"]),
+        identity(&[&format!("chrome-extension://{ID}/")])
+    );
+}
+
+#[test]
+fn args_firefox_manifest_path_and_addon_id() {
+    let (browser, id) = identity(&[
+        "/usr/lib64/mozilla/native-messaging-hosts/dev.zeo.browser_host.json",
+        "zeo-browser@zeo.dev",
+    ]);
+    assert_eq!(browser, "firefox");
+    assert_eq!(id, "zeo-browser@zeo.dev");
+}
+
+#[test]
+fn args_look_alikes_and_nothing_are_unknown() {
+    for args in [
+        vec![],
+        vec!["https://evil.example/"],
+        vec!["chrome-extension:///"],
+        vec!["moz-extension://abc/"],
+        vec!["--parent-window=0"],
+    ] {
+        let (browser, _) = identity(&args);
+        assert_eq!(browser, "unknown", "{args:?}");
+    }
+}
+
+// Planned amendment (post-review): Chrome and Chromium pass the same arguments, so the host
+// tells them apart by its parent's executable; an unreadable parent is `chrome`.
+
+fn identity_with_parent(args: &[&str], parent: Option<&str>) -> (String, String) {
+    let parent = parent.map(std::path::PathBuf::from);
+    let value: Value = serde_json::to_value(ClientIdentity::from_args_with_parent(
+        args.iter().map(|a| a.to_string()),
+        || parent,
+    ))
+    .expect("serializes");
+    (
+        value["browser"].as_str().unwrap_or_default().to_string(),
+        value["extension_id"]
+            .as_str()
+            .unwrap_or_default()
+            .to_string(),
+    )
+}
+
+#[test]
+fn args_chromium_parent_executable_gives_chromium() {
+    let origin = format!("chrome-extension://{ID}/");
+    for exe in [
+        "/usr/lib64/chromium-browser/chromium-browser",
+        "/usr/bin/chromium",
+        "/usr/lib64/chromium-browser/chromium-browser (deleted)",
+    ] {
+        assert_eq!(
+            identity_with_parent(&[&origin], Some(exe)),
+            ("chromium".to_string(), ID.to_string()),
+            "{exe}"
+        );
+    }
+}
+
+#[test]
+fn args_other_or_unreadable_parent_executable_gives_chrome() {
+    let origin = format!("chrome-extension://{ID}/");
+    for exe in [
+        Some("/opt/google/chrome/chrome"),
+        Some("/usr/bin/not-chromium"),
+        None,
+    ] {
+        assert_eq!(
+            identity_with_parent(&[&origin], exe),
+            ("chrome".to_string(), ID.to_string()),
+            "{exe:?}"
+        );
+    }
+}
+
+#[test]
+fn args_parent_executable_never_makes_a_look_alike_trusted() {
+    for args in [
+        vec!["https://evil.example/"],
+        vec!["chrome-extension:///"],
+        vec![],
+    ] {
+        assert_eq!(
+            identity_with_parent(&args, Some("/usr/bin/chromium")).0,
+            "unknown",
+            "{args:?}"
+        );
+    }
+}
diff --git a/crates/zeo_browser_host/src/frame.rs b/crates/zeo_browser_host/src/frame.rs
new file mode 100644
index 0000000..332e391
--- /dev/null
+++ b/crates/zeo_browser_host/src/frame.rs
@@ -0,0 +1,93 @@
+//! Native-messaging framing: a u32 length in the machine's native byte order, then that many
+//! bytes of UTF-8 JSON (design.md §B4; R2.5).
+
+use std::fmt;
+use std::io::{self, Read, Write};
+
+/// The largest frame accepted from the browser. Chrome allows up to 64 MiB towards the host;
+/// the bridge accepts lines up to 8 MiB, so anything larger could never be delivered.
+pub const MAX_FRAME_BYTES: usize = 8 * 1024 * 1024;
+
+/// Why a frame could not be read.
+#[derive(Debug)]
+pub enum FrameError {
+    /// The frame announced more than [`MAX_FRAME_BYTES`]. Its body has been skipped, so the next
+    /// read starts at the next frame's length.
+    TooLarge { len: usize },
+    /// The stream failed or ended inside a frame.
+    Io(io::Error),
+}
+
+impl fmt::Display for FrameError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::TooLarge { len } => write!(
+                formatter,
+                "frame of {len} bytes is over the {MAX_FRAME_BYTES}-byte limit"
+            ),
+            Self::Io(error) => write!(formatter, "reading a frame: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for FrameError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::TooLarge { .. } => None,
+            Self::Io(error) => Some(error),
+        }
+    }
+}
+
+impl From<io::Error> for FrameError {
+    fn from(error: io::Error) -> Self {
+        Self::Io(error)
+    }
+}
+
+/// Reads one frame. `Ok(None)` is a clean end of stream between frames; an end of stream inside
+/// the length or the body is an error, never a short frame.
+pub fn read_frame(r: &mut impl Read) -> Result<Option<Vec<u8>>, FrameError> {
+    let mut header = [0u8; 4];
+    let mut filled = 0;
+    while filled < header.len() {
+        match r.read(&mut header[filled..]) {
+            Ok(0) if filled == 0 => return Ok(None),
+            Ok(0) => {
+                return Err(FrameError::Io(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "stream ended inside a frame length",
+                )));
+            }
+            Ok(n) => filled += n,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            Err(error) => return Err(FrameError::Io(error)),
+        }
+    }
+    let len = u32::from_ne_bytes(header) as usize;
+    if len > MAX_FRAME_BYTES {
+        // Skip the body so the stream stays aligned on frame boundaries. A body cut short by
+        // the end of the stream is left for the next read to report as a clean end.
+        io::copy(&mut r.take(len as u64), &mut io::sink())?;
+        return Err(FrameError::TooLarge { len });
+    }
+    let mut body = vec![0u8; len];
+    r.read_exact(&mut body)?;
+    Ok(Some(body))
+}
+
+/// Writes one frame: the native-endian length, then `body`, then a flush.
+pub fn write_frame(w: &mut impl Write, body: &[u8]) -> io::Result<()> {
+    let len = u32::try_from(body.len()).map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "frame body does not fit a u32 length",
+        )
+    })?;
+    // One buffer, one write: a frame is never interleaved with another writer's bytes.
+    let mut framed = Vec::with_capacity(4 + body.len());
+    framed.extend_from_slice(&len.to_ne_bytes());
+    framed.extend_from_slice(body);
+    w.write_all(&framed)?;
+    w.flush()
+}
