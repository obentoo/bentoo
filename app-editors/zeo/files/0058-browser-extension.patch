+++ b/crates/acp_thread/src/mention_browser_context_tests.rs
@@ -0,0 +1,199 @@
+// Story 045, task 7.1 — `MentionUri::BrowserContext`: URI, parse, label and persistence
+// (design.md §B3; R12.1, R12.4). Wired in `src/acp_thread.rs` as
+//
+//     #[cfg(test)]
+//     mod mention_browser_context_tests;
+//
+// Validation filter: `browser_context` (every test path is `mention_browser_context_tests::…`).
+//
+// Contract: `MentionUri::BrowserContext { kind: BrowserContextKind, page_url: String, label:
+// String }`, `BrowserContextKind::{ Element, Console, Network }` (re-exported at the crate root
+// like the rest of `mention`), `to_uri()` under `zed:///agent/browser-context?…`, `parse`, and
+// `name()` = `label`.
+//
+// Hostile halves (identity, R12.4 "the same chip"):
+//   - wrongly SPLIT: urls and labels holding `&`, `=`, `#`, `?`, `%`, spaces, ` · `, parentheses
+//     and non-ASCII come back field for field;
+//   - wrongly COLLAPSE: an Element and a Console chip with the same url and label get different
+//     URIs; a URI missing a field, or with an unknown kind, is not a BrowserContext; a
+//     `dom-element` URI never parses as one, nor the converse.
+
+use util::paths::PathStyle;
+
+use crate::{BrowserContextKind, MentionUri};
+
+fn chip(kind: BrowserContextKind, url: &str, label: &str) -> MentionUri {
+    MentionUri::BrowserContext {
+        kind,
+        page_url: url.to_string(),
+        label: label.to_string(),
+    }
+}
+
+fn reparse(uri: &MentionUri) -> MentionUri {
+    let text = uri.to_uri().to_string();
+    MentionUri::parse(&text, PathStyle::local())
+        .unwrap_or_else(|error| panic!("{text} parses back: {error:#}"))
+}
+
+#[test]
+fn browser_context_lives_under_its_own_path() {
+    let uri = chip(
+        BrowserContextKind::Element,
+        "https://app.example/",
+        "button · app.example",
+    )
+    .to_uri();
+    assert!(
+        uri.as_str().starts_with("zed:///agent/browser-context?"),
+        "{uri}"
+    );
+    assert!(
+        !uri.as_str().contains("dom-element"),
+        "never 033's path: {uri}"
+    );
+}
+
+#[test]
+fn browser_context_round_trips_hostile_values() {
+    for uri in [
+        chip(
+            BrowserContextKind::Element,
+            "https://app.example/a?b=c&d=e#f",
+            "a&b=c · app.example",
+        ),
+        chip(
+            BrowserContextKind::Console,
+            "https://xn--nxasmq6b.example/日本?q=%20x",
+            "Console · 日本.example (12)",
+        ),
+        chip(
+            BrowserContextKind::Network,
+            "file:///tmp/my page.html",
+            "Network · local file (200)",
+        ),
+    ] {
+        assert_eq!(reparse(&uri), uri, "{}", uri.to_uri());
+    }
+}
+
+#[test]
+fn browser_context_kinds_never_collapse() {
+    let element = chip(
+        BrowserContextKind::Element,
+        "https://app.example/",
+        "same label",
+    );
+    let console = chip(
+        BrowserContextKind::Console,
+        "https://app.example/",
+        "same label",
+    );
+    let network = chip(
+        BrowserContextKind::Network,
+        "https://app.example/",
+        "same label",
+    );
+    assert_ne!(element.to_uri(), console.to_uri());
+    assert_ne!(console.to_uri(), network.to_uri());
+    assert!(matches!(
+        reparse(&console),
+        MentionUri::BrowserContext {
+            kind: BrowserContextKind::Console,
+            ..
+        }
+    ));
+}
+
+#[test]
+fn browser_context_missing_field_or_unknown_kind_does_not_parse_as_one() {
+    let full = chip(
+        BrowserContextKind::Element,
+        "https://app.example/",
+        "button · app.example",
+    )
+    .to_uri();
+    let names: Vec<String> = full.query_pairs().map(|(k, _)| k.into_owned()).collect();
+    assert!(
+        names.len() >= 3,
+        "kind, url and label are in the URI: {full}"
+    );
+    for missing in &names {
+        let mut uri = full.clone();
+        let kept: Vec<(String, String)> = full
+            .query_pairs()
+            .filter(|(k, _)| k != missing)
+            .map(|(k, v)| (k.into_owned(), v.into_owned()))
+            .collect();
+        uri.query_pairs_mut().clear().extend_pairs(kept);
+        let parsed = MentionUri::parse(uri.as_str(), PathStyle::local());
+        assert!(
+            !matches!(parsed, Ok(MentionUri::BrowserContext { .. })),
+            "without `{missing}`: {parsed:?}"
+        );
+    }
+    let mut cookies = full.clone();
+    let swapped: Vec<(String, String)> = full
+        .query_pairs()
+        .map(|(k, v)| {
+            if v == "element" {
+                (k.into_owned(), "cookies".to_string())
+            } else {
+                (k.into_owned(), v.into_owned())
+            }
+        })
+        .collect();
+    cookies.query_pairs_mut().clear().extend_pairs(swapped);
+    assert!(!matches!(
+        MentionUri::parse(cookies.as_str(), PathStyle::local()),
+        Ok(MentionUri::BrowserContext { .. })
+    ));
+}
+
+#[test]
+fn browser_context_and_dom_element_never_parse_as_each_other() {
+    let browser = chip(
+        BrowserContextKind::Element,
+        "https://app.example/",
+        "li · app.example",
+    );
+    let dom = MentionUri::DomElement {
+        abs_path: std::path::PathBuf::from("/p/app/src/App.tsx"),
+        line_range: 1..=2,
+        column: 0,
+        component: None,
+        tag: "li".to_string(),
+    };
+    assert!(matches!(
+        reparse(&browser),
+        MentionUri::BrowserContext { .. }
+    ));
+    assert!(matches!(reparse(&dom), MentionUri::DomElement { .. }));
+}
+
+#[test]
+fn browser_context_label_is_the_chip_name() {
+    for label in [
+        "button · app.example",
+        "Console · app.example (7)",
+        "Network · app.example (42)",
+    ] {
+        assert_eq!(
+            chip(BrowserContextKind::Element, "https://app.example/", label).name(),
+            label
+        );
+    }
+}
+
+#[test]
+fn browser_context_survives_persistence_with_the_same_chip() {
+    let uri = chip(
+        BrowserContextKind::Network,
+        "https://app.example/",
+        "Network · app.example (3)",
+    );
+    let stored = serde_json::to_string(&uri).expect("serializes");
+    let restored: MentionUri = serde_json::from_str(&stored).expect("deserializes");
+    assert_eq!(restored, uri);
+    assert_eq!(restored.name(), uri.name());
+}
