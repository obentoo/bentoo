+// Review fix (6.1): a browser that stops reading stdout and then closes stdin must not hang the
+// host. A flooding bridge fills the undrained stdout pipe, so the socket→stdout thread blocks
+// inside a frame write; closing stdin must still end `run` within a second.
+
+#[test]
+fn relay_stdin_closing_ends_the_relay_while_stdout_is_jammed() {
+    let tmp = tempfile::tempdir().expect("temp");
+    let path = tmp.path().join("devtools.sock");
+    let listener = UnixListener::bind(&path).expect("bind");
+    let got_hello = Arc::new(Mutex::new(false));
+    let seen = got_hello.clone();
+    thread::spawn(move || {
+        let Ok((stream, _)) = listener.accept() else {
+            return;
+        };
+        let mut flood = stream.try_clone().expect("clone");
+        thread::spawn(move || {
+            let line = format!(
+                "{{\"v\":2,\"kind\":\"title\",\"title\":\"{}\"}}\n",
+                "x".repeat(100_000)
+            );
+            while flood.write_all(line.as_bytes()).is_ok() {}
+        });
+        for line in BufReader::new(stream).lines() {
+            if line.is_err() {
+                break;
+            }
+            *seen.lock().expect("lock") = true;
+        }
+    });
+
+    // Nobody reads `_undrained`, but it stays open: stdout writes block instead of failing.
+    let (_undrained, stdout) = std::io::pipe().expect("stdout pipe");
+    let (stdin, mut browser) = std::io::pipe().expect("stdin pipe");
+    let identity = ClientIdentity::from_args([chrome()]);
+    let (done_tx, done_rx) = std::sync::mpsc::channel();
+    thread::spawn(move || {
+        done_tx
+            .send(run(&identity, &path, stdin, stdout).is_ok())
+            .ok();
+    });
+    browser
+        .write_all(&framed(&serde_json::to_vec(&hello_forged()).expect("json")))
+        .expect("write");
+    let end = Instant::now() + Duration::from_secs(5);
+    while !*got_hello.lock().expect("lock") {
+        assert!(Instant::now() < end, "the bridge never got the hello");
+        thread::sleep(Duration::from_millis(10));
+    }
+    // Long enough for the flood to fill the stdout pipe and block the writer mid-frame.
+    thread::sleep(Duration::from_millis(300));
+
+    drop(browser);
+    let ended = done_rx.recv_timeout(Duration::from_secs(1));
+    assert_eq!(
+        ended,
+        Ok(true),
+        "run() must return Ok within 1 s of stdin closing"
+    );
+}
