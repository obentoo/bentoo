+impl Peer {
+    /// The request id to echo and the peer, or `None` when `msg` is not a `hello`.
+    fn of_hello(msg: &ClientMsg) -> Option<(Option<String>, Self)> {
+        match msg {
+            ClientMsg::Hello { id, client, .. } => Some((
+                id.clone(),
+                Self {
+                    browser: client.browser.code(),
+                    // Unbounded on the wire; a log line keeps the length an id has and the
+                    // characters ids are made of, so no URL can reach it (R13.4).
+                    extension: agent_ui::browser_channel::loggable_extension_id(
+                        &client.extension_id,
+                    ),
+                },
+            )),
+            _ => None,
+        }
+    }
+}
+
+impl fmt::Display for Peer {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        // Debug-quoted: the extension id is the peer's own string, so it must not be able to
+        // forge a field or a line.
+        write!(
+            formatter,
+            "browser={} extension={:?}",
+            self.browser, self.extension
+        )
+    }
+}
+
+/// Emits a session's one `Closed` when it is dropped. The session future drops it however the
+/// session ends, including when the bridge thread's executor drops the future on `stop`.
+struct SessionGuard {
+    id: SessionId,
+    peer: Peer,
+    place: Option<Slot>,
+    handler: SessionHandler,
+    /// What ended the session; a future dropped before it set one was stopped with the bridge.
+    reason: &'static str,
+}
+
+impl Drop for SessionGuard {
+    fn drop(&mut self) {
+        // Freed before `Closed`, so whoever reacts to it finds the place free.
+        drop(self.place.take());
+        log::info!(
+            "devtools_bridge event=session_closed session={} {} reason={}",
+            self.id,
+            self.peer,
+            self.reason
+        );
+        (self.handler)(SessionEvent::Closed {
+            id: self.id.clone(),
+        });
+    }
+}
+
+enum SessionEnd {
+    PeerClosed,
+    ReadFailed(anyhow::Error),
+    WriteFailed(anyhow::Error),
+    /// A fatal `error` was written; carries its code.
+    Fatal(&'static str),
+    /// `told` is whether the `overloaded` line reached the socket within the grace.
+    Overloaded {
+        told: bool,
+    },
+    ClosedByZeo,
+}
+
+impl SessionEnd {
+    fn reason(&self) -> &'static str {
+        match self {
+            Self::PeerClosed => "peer_closed",
+            Self::ReadFailed(_) => "read_failed",
+            Self::WriteFailed(_) => "write_failed",
+            Self::Fatal(code) => code,
+            Self::Overloaded { .. } => "overloaded",
+            Self::ClosedByZeo => "closed_by_zeo",
+        }
+    }
+}
+
+/// The session half of [`serve`]: `first` is the connection's first line, already parsed, and
+/// `slot` its short-lived place, released as soon as the session holds a place of its own.
+async fn serve_session(
+    stream: Async<UnixStream>,
+    mut reader: LineReader,
+    first: Result<ClientMsg, ChannelError>,
+    sessions: &Sessions,
+    slot: Slot,
+) {
+    let (hello, hello_id, peer) = match first {
+        Ok(msg) => match Peer::of_hello(&msg) {
+            Some((hello_id, peer)) => (msg, hello_id, peer),
+            None => {
+                let id = msg.request_id().map(str::to_owned);
+                return refuse_first_line(&stream, id, FIRST_LINE_DETAIL).await;
+            }
+        },
+        Err(ChannelError::BadRequest { detail }) => {
+            return refuse_first_line(&stream, None, detail).await;
+        }
+        Err(_) => return refuse_first_line(&stream, None, FIRST_LINE_DETAIL).await,
+    };
+
+    let Some(place) = Slot::acquire(&sessions.places, SESSION_PLACES) else {
+        log::warn!(
+            "devtools_bridge event=session_refused {peer} reason=busy places={SESSION_PLACES}"
+        );
+        write_refusal(&stream, &ServerMsg::error(hello_id, ChannelError::Busy)).await;
+        return;
+    };
+    // The short-lived place covers the first line only: a session keeping it would leave the
+    // Vite relay fewer places (R3.4).
+    drop(slot);
+
+    let id = SessionId::new(NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed));
+    let (queue, queued) = smol::channel::bounded(SESSION_QUEUE_LINES);
+    // The session keeps a sender of its own, so dropping every sink never reads as an overflow.
+    let (overflow, overflowed) = smol::channel::bounded::<()>(1);
+    let sink = SessionSink::with_overflow_signal(queue, overflow.clone());
+    log::info!("devtools_bridge event=session_open session={id} {peer}");
+    let mut guard = SessionGuard {
+        id: id.clone(),
+        peer,
+        place: Some(place),
+        handler: sessions.handler.clone(),
+        reason: "bridge_stopped",
+    };
+    (sessions.handler)(SessionEvent::Opened {
+        id: id.clone(),
+        hello,
+        sink: sink.clone(),
+    });
+
+    let in_flight = Arc::new(Semaphore::new(SESSION_MESSAGES_IN_FLIGHT));
+    let end = smol::future::or(
+        read_session(
+            &stream,
+            &mut reader,
+            &id,
+            &sink,
+            &sessions.handler,
+            &in_flight,
+        ),
+        write_session(&stream, &id, queued, overflowed),
+    )
+    .await;
+    match &end {
+        SessionEnd::ReadFailed(error) => log::warn!(
+            "devtools_bridge event=session_read_failed session={id} reason=\"{error:#}\""
+        ),
+        SessionEnd::WriteFailed(error) => log::warn!(
+            "devtools_bridge event=session_write_failed session={id} reason=\"{error:#}\""
+        ),
+        SessionEnd::Overloaded { told } => log::warn!(
+            "devtools_bridge event=session_overloaded session={id} \
+             queue={SESSION_QUEUE_LINES} told={told}"
+        ),
+        SessionEnd::PeerClosed | SessionEnd::Fatal(_) | SessionEnd::ClosedByZeo => {}
+    }
+    guard.reason = end.reason();
+    drop(overflow);
+    // The socket closes before `Closed` is emitted.
+    drop(stream);
+    drop(guard);
+}
+
+/// Answers a `v: 2` first line that is not a valid `hello`, as fatal: the connection closes right
+/// after it (R3.3).
+async fn refuse_first_line(stream: &Async<UnixStream>, id: Option<String>, detail: &'static str) {
+    log::warn!("devtools_bridge event=session_refused reason=bad_request detail=\"{detail}\"");
+    let error = ChannelError::BadRequest { detail };
+    let refusal = ServerMsg::Error {
+        v: V2,
+        id,
+        error,
+        message: error.message(),
+        fatal: true,
+    };
+    write_refusal(stream, &refusal).await;
+}
+
+/// Reads session lines until the peer closes or the read fails. Each line is answered here when
+/// it is malformed, and handed to the handler when it is not.
+async fn read_session(
+    stream: &Async<UnixStream>,
+    reader: &mut LineReader,
+    id: &SessionId,
+    sink: &SessionSink,
+    handler: &SessionHandler,
+    in_flight: &Arc<Semaphore>,
+) -> SessionEnd {
+    loop {
+        // Taken before the socket is read: at the bound the session reads nothing more until
+        // the consumer drops a `Message`. The writer, polled beside this loop, keeps running.
+        let permit = in_flight.acquire_arc().await;
+        let line = match reader.next_line(stream).await {
+            Ok(Line::Full(line)) => line,
+            Ok(Line::TooLarge) => {
+                refuse_message(id, sink, ChannelError::TooLarge, Duration::ZERO);
+                // The writer is polled only when this loop is pending; without the yield a flood
+                // of oversized lines would queue replies that it never gets to write.
+                smol::future::yield_now().await;
+                continue;
+            }
+            Ok(Line::Closed) => return SessionEnd::PeerClosed,
+            Err(error) => {
+                return SessionEnd::ReadFailed(
+                    anyhow::Error::from(error).context("reading a session line"),
+                );
+            }
+        };
+        let started = Instant::now();
+        // An 8 MiB `send` takes real time to parse, and every connection shares this thread.
+        match smol::unblock(move || channel::parse_client(&line)).await {
+            Ok(msg) => {
+                log::debug!(
+                    "devtools_bridge event=session_msg session={id} kind={} outcome=forwarded \
+                     ms={}",
+                    msg.kind(),
+                    started.elapsed().as_millis()
+                );
+                handler(SessionEvent::Message {
+                    id: id.clone(),
+                    msg,
+                    permit: MessagePermit { _guard: permit },
+                });
+            }
+            Err(error) => refuse_message(id, sink, error, started.elapsed()),
+        }
+    }
+}
+
+/// Answers a malformed session line; the session stays open (R3.5–R3.7).
+fn refuse_message(id: &SessionId, sink: &SessionSink, error: ChannelError, elapsed: Duration) {
+    let ms = elapsed.as_millis();
+    match error {
+        ChannelError::BadRequest { detail } => log::warn!(
+            "devtools_bridge event=session_msg session={id} outcome=bad_request \
+             detail=\"{detail}\" ms={ms}"
+        ),
+        other => log::warn!(
+            "devtools_bridge event=session_msg session={id} outcome={} ms={ms}",
+            other.code()
+        ),
+    }
+    if sink.send(ServerMsg::error(None, error)).is_err() {
+        log::debug!(
+            "devtools_bridge event=session_reply_dropped session={id} reason=\"the session is \
+             closing\""
+        );
+    }
+}
+
+enum Next {
+    Message(ServerMsg),
+    Overflowed,
+    Closed,
+}
+
+/// Writes queued messages in order, each through `channel::encode_server`, until a fatal error
+/// is written, the queue overflows or closes, or a write fails.
+async fn write_session(
+    stream: &Async<UnixStream>,
+    id: &SessionId,
+    queued: smol::channel::Receiver<ServerMsg>,
+    overflowed: smol::channel::Receiver<()>,
+) -> SessionEnd {
+    loop {
+        // The overflow signal is polled first, so it wins over whatever is still queued.
+        let next = smol::future::or(
+            async {
+                overflowed.recv().await.ok();
+                Next::Overflowed
+            },
+            async { queued.recv().await.map_or(Next::Closed, Next::Message) },
+        )
+        .await;
+        let msg = match next {
+            Next::Message(msg) => msg,
+            Next::Overflowed => return write_overloaded(stream).await,
+            Next::Closed => return SessionEnd::ClosedByZeo,
+        };
+        let fatal = match &msg {
+            ServerMsg::Error {
+                error, fatal: true, ..
+            } => Some(error.code()),
+            _ => None,
+        };
+        let line = match channel::encode_server(&msg) {
+            Ok(line) => line,
+            Err(error) => {
+                // The producer was to truncate first; a dropped line beats a browser that
+                // disconnects the host for an oversized frame (R3.10).
+                log::warn!(
+                    "devtools_bridge event=session_line_dropped session={id} reason=\"{:#}\"",
+                    anyhow::Error::from(error)
+                );
+                continue;
+            }
+        };
+        // A peer that stops reading blocks this write; once the queue overflows behind it, the
+        // grace bounds how long the session waits for it.
+        let written = smol::future::or(async { Some(write_line(stream, line).await) }, async {
+            overflowed.recv().await.ok();
+            Timer::at(Instant::now() + OVERLOADED_WRITE_GRACE).await;
+            None
+        })
+        .await;
+        match written {
+            None => return SessionEnd::Overloaded { told: false },
+            Some(Err(error)) => return SessionEnd::WriteFailed(error),
+            Some(Ok(())) => {
+                if let Some(code) = fatal {
+                    return SessionEnd::Fatal(code);
+                }
+            }
+        }
+    }
+}
+
+async fn write_overloaded(stream: &Async<UnixStream>) -> SessionEnd {
+    let line = match channel::encode_server(&ServerMsg::error(None, ChannelError::Overloaded)) {
+        Ok(line) => line,
+        Err(error) => {
+            return SessionEnd::WriteFailed(
+                anyhow::Error::from(error).context("encoding the overloaded line"),
+            );
+        }
+    };
+    let written = smol::future::or(async { Some(write_line(stream, line).await) }, async {
+        Timer::at(Instant::now() + OVERLOADED_WRITE_GRACE).await;
+        None
+    })
+    .await;
+    match written {
+        Some(Ok(())) => SessionEnd::Overloaded { told: true },
+        Some(Err(error)) => SessionEnd::WriteFailed(error),
+        None => SessionEnd::Overloaded { told: false },
+    }
+}
+
+/// Writes the one line a refused connection gets before it closes.
+async fn write_refusal(stream: &Async<UnixStream>, refusal: &ServerMsg) {
+    let written = match channel::encode_server(refusal) {
+        Ok(line) => write_line(stream, line).await,
+        Err(error) => Err(anyhow::Error::from(error).context("encoding a refusal")),
+    };
+    if let Err(error) = written {
+        log::warn!("devtools_bridge event=session_write_failed reason=\"{error:#}\"");
+    }
+}
+
+/// Writes `line` and its `\n` terminator, which `encode_server`'s cap does not count.
+async fn write_line(mut stream: &Async<UnixStream>, mut line: String) -> Result<()> {
+    line.push('\n');
+    stream
+        .write_all(line.as_bytes())
+        .await
+        .context("writing a session line")?;
+    stream.flush().await.context("flushing a session line")
+}
