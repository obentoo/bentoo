+#[gpui::test]
+async fn stream_permission_requested_and_resolved_in_zeo(cx: &mut TestAppContext) {
+    use std::collections::HashMap;
+
+    use acp_thread::{AgentThreadEntry, PermissionOptions, SelectedPermissionOutcome};
+    use agent_client_protocol::{v1::schema as acp_v1, v2::schema as acp_v2};
+
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new().with_permission_requests(HashMap::from_iter([(
+        acp_v2::ToolCallId::new("1"),
+        PermissionOptions::Flat(vec![acp_v2::PermissionOption::new(
+            "allow-1",
+            "Allow",
+            acp_v2::PermissionOptionKind::AllowOnce,
+        )]),
+    )]));
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::ToolCall(
+        acp_v1::ToolCall::new(acp_v1::ToolCallId::new("1"), "Delete build dir"),
+    )]);
+    let win = window(&fs, "/p/app", Some(connection), cx).await;
+    let (probe, _) = subscribed(&win, json!({ "follow": true }), cx);
+    probe.handle(
+        request("send", "m", json!({ "text": "clean", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    let got = probe.drain(cx);
+    let requested = got
+        .iter()
+        .find(|m| m["kind"] == "permission_requested")
+        .unwrap_or_else(|| panic!("R7.5: {:?}", kinds(&got)));
+    assert_eq!(requested["permission"]["title"], "Delete build dir");
+    assert_eq!(
+        requested["permission"]["options"][0]["option_id"],
+        "allow-1"
+    );
+    assert_eq!(requested["permission"]["options"][0]["kind"], "allow_once");
+    assert!(
+        got.iter()
+            .any(|m| m["kind"] == "status" && m["status"]["state"] == "awaiting_permission")
+    );
+    let request_id = requested["permission"]["request_id"].clone();
+
+    // Answered in Zeo, not in the sidebar.
+    let thread = win.thread();
+    thread.update(cx, |thread, cx| {
+        let call = thread.entries().iter().find_map(|e| match e {
+            AgentThreadEntry::ToolCall(call) => Some(call.id.clone()),
+            _ => None,
+        });
+        let outcome = SelectedPermissionOutcome::new(
+            acp_v2::PermissionOptionId::new("allow-1"),
+            acp_v2::PermissionOptionKind::AllowOnce,
+        );
+        thread.authorize_tool_call(call.expect("the call"), outcome, cx);
+    });
+    cx.run_until_parked();
+    assert!(
+        probe
+            .drain(cx)
+            .iter()
+            .any(|m| m["kind"] == "permission_resolved" && m["request_id"] == request_id),
+        "R7.7: the sidebar is told"
+    );
+}
