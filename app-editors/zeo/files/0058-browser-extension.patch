+// Story 045, task 5.3 — first-line dispatch, session places and the session writer, over a real
+// unix socket (design.md §B1, §Validation rules). Requirements: R3.1–R3.10 (R13.1/R13.2 log lines
+// are checked by Q15's grep, not here). Q4, Q16. Wired in `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod session_tests;
+//
+// Validation filter: `session` (every test path is `session_tests::…`); 033's `listener_tests`
+// must stay green beside it.
+//
+// Assumed seam — the only lines naming it are in `start_bridge` and `Recorder::handler`:
+//   - `crate::listener::start_with_sessions(dir: &Path, requests: impl Into<RequestHandler>,
+//      sessions: SessionHandler) -> anyhow::Result<Listener>`, where
+//      `SessionHandler = Arc<dyn Fn(SessionEvent) + Send + Sync>` and
+//      `SessionEvent::{ Opened { id, hello: ClientMsg, sink: SessionSink }, Message { id, msg:
+//      ClientMsg }, Closed { id } }` — the shape `SessionRelay` forwards to the foreground;
+//   - `SessionSink` is `Clone + Send` with `send(&self, msg: ServerMsg) -> Result<…>` that never
+//     blocks (a full queue is the listener's `overloaded`, not the caller's wait).
+// Answers to malformed session lines (`too_large`, `bad_request`, `unknown_kind`,
+// `unsupported_version`) are written by the listener itself; `welcome` comes from the handler
+// (approval happens in agent_ui), so this test's handler sends it.
+//
+// Hostile halves first:
+//   - dispatch: a v1 request never opens a session, AND a v2 hello never reaches the v1 handler;
+//   - places: four open sessions refuse a fifth hello, AND the four v1 places stay free for the
+//     Vite relay; closing one session frees its place;
+//   - queue: 300 unread large lines overflow into `overloaded` and a close, AND 200 do not.
+
+use std::io::{BufRead, BufReader, ErrorKind, Write};
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use futures::FutureExt as _;
+use serde_json::{Value, json};
+
+use crate::channel::ServerMsg;
+use crate::listener::{self, Handler, Listener, SessionEvent, SessionHandler, SessionSink};
+use crate::protocol::{DevtoolsResult, DevtoolsSelection};
+
+const MIB: usize = 1024 * 1024;
+
+#[derive(Default)]
+struct Recorder {
+    v1_calls: AtomicUsize,
+    opened: Mutex<Vec<String>>,
+    messages: Mutex<Vec<String>>,
+    closed: AtomicUsize,
+    sinks: Mutex<Vec<SessionSink>>,
+    welcome: bool,
+}
+
+impl Recorder {
+    fn handler(self: &Arc<Self>) -> SessionHandler {
+        let this = self.clone();
+        Arc::new(move |event: SessionEvent| match event {
+            SessionEvent::Opened { hello, sink, .. } => {
+                this.opened.lock().unwrap().push(format!("{hello:?}"));
+                if this.welcome {
+                    let _ = sink.send(server(json!({ "v": 2, "kind": "welcome", "protocol": 2, "zeo_version": "0.0.0-test" })));
+                }
+                this.sinks.lock().unwrap().push(sink);
+            }
+            SessionEvent::Message { msg, .. } => this
+                .messages
+                .lock()
+                .unwrap()
+                .push(format!("{msg:?}").to_lowercase().replace('_', "")),
+            SessionEvent::Closed { .. } => {
+                this.closed.fetch_add(1, Ordering::SeqCst);
+            }
+        })
+    }
+
+    fn sink(&self, index: usize) -> SessionSink {
+        self.sinks.lock().unwrap()[index].clone()
+    }
+}
+
+fn server(value: Value) -> ServerMsg {
+    serde_json::from_value(value).expect("ServerMsg deserializes from the wire")
+}
+
+struct Bridge {
+    _tmp: tempfile::TempDir,
+    dir: PathBuf,
+    listener: Listener,
+    rec: Arc<Recorder>,
+}
+
+fn start_bridge(welcome: bool) -> Bridge {
+    let tmp = tempfile::tempdir().expect("temp dir");
+    let dir = std::fs::canonicalize(tmp.path())
+        .expect("canonical")
+        .join("zeo");
+    let rec = Arc::new(Recorder {
+        welcome,
+        ..Recorder::default()
+    });
+    let calls = rec.clone();
+    let v1: Handler = Arc::new(move |_selection: DevtoolsSelection| {
+        calls.v1_calls.fetch_add(1, Ordering::SeqCst);
+        async move {
+            serde_json::from_value::<DevtoolsResult>(
+                json!({ "v": 1, "ok": true, "outcome": "inserted", "items": 1, "image": "none" }),
+            )
+            .expect("result")
+        }
+        .boxed()
+    });
+    let listener =
+        listener::start_with_sessions(&dir, v1, rec.handler()).expect("the bridge listens");
+    Bridge {
+        _tmp: tmp,
+        dir,
+        listener,
+        rec,
+    }
+}
+
+struct Client {
+    reader: BufReader<UnixStream>,
+    writer: UnixStream,
+}
+
+impl Client {
+    fn connect(dir: &Path) -> Self {
+        let stream = UnixStream::connect(dir.join("devtools.sock")).expect("connect");
+        stream
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .expect("timeout");
+        Self {
+            reader: BufReader::new(stream.try_clone().expect("clone")),
+            writer: stream,
+        }
+    }
+    fn send(&mut self, value: &Value) {
+        let mut line = serde_json::to_vec(value).expect("json");
+        line.push(b'\n');
+        self.writer.write_all(&line).expect("write");
+    }
+    fn send_raw(&mut self, bytes: &[u8]) {
+        self.writer.write_all(bytes).expect("write");
+    }
+    /// The next line, `None` at EOF; panics on a read timeout.
+    fn line(&mut self) -> Option<Value> {
+        self.raw_line()
+            .map(|line| serde_json::from_str(&line).expect("a JSON line"))
+    }
+    fn raw_line(&mut self) -> Option<String> {
+        let mut line = String::new();
+        match self.reader.read_line(&mut line) {
+            Ok(0) => None,
+            Ok(_) => Some(line.trim_end_matches('\n').to_string()),
+            Err(error) if matches!(error.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut) => {
+                panic!("no line within 5 s")
+            }
+            Err(error) if error.kind() == ErrorKind::ConnectionReset => None,
+            Err(error) => panic!("read: {error}"),
+        }
+    }
+    fn hello(dir: &Path) -> Self {
+        let mut client = Self::connect(dir);
+        client.send(&json!({ "v": 2, "kind": "hello", "client": { "browser": "chrome", "extension_id": "abc", "extension_version": "0.1.0" } }));
+        client
+    }
+}
+
+fn wait_until(what: &str, mut done: impl FnMut() -> bool) {
+    let end = Instant::now() + Duration::from_secs(5);
+    while !done() {
+        assert!(Instant::now() < end, "timed out waiting for {what}");
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn error_code(line: &Value) -> &str {
+    assert_eq!(line["kind"], "error", "{line}");
+    line["error"].as_str().unwrap_or_default()
+}
+
+#[test]
+fn session_v1_request_keeps_its_one_shot_path_and_opens_no_session() {
+    let bridge = start_bridge(true);
+    let mut client = Client::connect(&bridge.dir);
+    client.send(&json!({ "v": 1 }));
+    let answer = client.line().expect("a v1 answer");
+    assert_eq!(answer["v"], 1, "{answer}");
+    assert_eq!(answer["ok"], false);
+    assert_eq!(answer["error"], "bad_request");
+    assert!(client.line().is_none(), "v1 closes after one answer");
+    assert!(
+        bridge.rec.opened.lock().unwrap().is_empty(),
+        "no session for v1"
+    );
+}
