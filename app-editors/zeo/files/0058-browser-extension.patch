diff --git a/crates/devtools_bridge/src/browser_contract_agreement_tests.rs b/crates/devtools_bridge/src/browser_contract_agreement_tests.rs
new file mode 100644
index 0000000..0ffd7a0
--- /dev/null
+++ b/crates/devtools_bridge/src/browser_contract_agreement_tests.rs
@@ -0,0 +1,188 @@
+// Story 045, task 8.1 (Rust half) — `channel.rs` gives every shared v2 fixture the verdict it
+// names, and the host's native-messaging manifest templates equal the extension's expected copies
+// byte for byte (R3.6, R3.7, R12.5, R14.4; Q14). Wired in `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod browser_contract_agreement_tests;
+//
+// Validation: `ZEO_BROWSER_CONTRACT_DIR=<zeo-browser>/test/contract cargo test -p devtools_bridge
+// browser_contract_agreement`. Unset, each test prints SKIPPED with the reason and returns; a set
+// variable over an empty directory FAILS. Fixtures are never copied into the Zed tree.
+//
+// Fixture convention (shared with the vitest half): `client|server/{valid,invalid}/*.json`;
+// invalid files carry a top-level `"$expect"` (a ChannelError code), stripped first.
+// Scope: client fixtures get the full verdict (Zeo is their validator). Server fixtures are
+// Zeo's OUTPUT: every valid one must deserialize and re-encode through `encode_server`, and
+// every server kind must be covered; refusing invalid server messages is the extension's job
+// (the vitest half).
+//
+// Hostile half: an invalid fixture that Rust ACCEPTS is a mismatch exactly like a valid one it
+// refuses — both directions are listed, never only one.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+use crate::channel::{
+    ChannelError, ClientMsg, ServerMsg, encode_server, parse_client, validate_send,
+};
+
+const ENV: &str = "ZEO_BROWSER_CONTRACT_DIR";
+
+fn contract_dir(test: &str) -> Option<PathBuf> {
+    match std::env::var_os(ENV) {
+        Some(dir) => Some(PathBuf::from(dir)),
+        None => {
+            eprintln!("SKIPPED {test}: {ENV} is unset; point it at zeo-browser/test/contract");
+            None
+        }
+    }
+}
+
+fn fixtures(dir: &Path) -> Vec<(PathBuf, Value, Option<String>)> {
+    let mut files: Vec<PathBuf> = fs::read_dir(dir)
+        .unwrap_or_else(|error| panic!("{} is readable: {error}", dir.display()))
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| path.extension().is_some_and(|ext| ext == "json"))
+        .collect();
+    files.sort();
+    assert!(
+        !files.is_empty(),
+        "{} holds no fixture: a set variable never passes on nothing",
+        dir.display()
+    );
+    files
+        .into_iter()
+        .map(|file| {
+            let text = fs::read_to_string(&file).expect("readable");
+            let mut value: Value =
+                serde_json::from_str(&text).unwrap_or_else(|e| panic!("{}: {e}", file.display()));
+            let expect = value
+                .as_object_mut()
+                .and_then(|object| object.remove("$expect"))
+                .and_then(|value| value.as_str().map(str::to_string));
+            (file, value, expect)
+        })
+        .collect()
+}
+
+fn code(error: &ChannelError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("ChannelError serializes to its code, got {other:?}"),
+    }
+}
+
+fn client_verdict(value: &Value) -> String {
+    let line = serde_json::to_vec(value).expect("json");
+    match parse_client(&line) {
+        Err(error) => code(&error),
+        Ok(ClientMsg::Send(send)) => {
+            validate_send(&send).map_or_else(|e| code(&e), |()| "accepted".to_string())
+        }
+        Ok(_) => "accepted".to_string(),
+    }
+}
+
+#[test]
+fn browser_contract_agreement_client_fixtures() {
+    let Some(contract) = contract_dir("browser_contract_agreement_client_fixtures") else {
+        return;
+    };
+    let mut mismatches = Vec::new();
+    for kind in ["valid", "invalid"] {
+        for (file, value, expect) in fixtures(&contract.join("client").join(kind)) {
+            let expected = match (kind, expect) {
+                ("valid", None) => "accepted".to_string(),
+                ("invalid", Some(code)) => code,
+                (_, other) => panic!("{}: unexpected `$expect` {other:?}", file.display()),
+            };
+            let got = client_verdict(&value);
+            if got != expected {
+                mismatches.push(format!(
+                    "{}: expected {expected}, got {got}",
+                    file.display()
+                ));
+            }
+        }
+    }
+    assert!(
+        mismatches.is_empty(),
+        "{} disagree:\n{}",
+        mismatches.len(),
+        mismatches.join("\n")
+    );
+}
+
+#[test]
+fn browser_contract_agreement_server_valid_fixtures_round_trip() {
+    let Some(contract) =
+        contract_dir("browser_contract_agreement_server_valid_fixtures_round_trip")
+    else {
+        return;
+    };
+    let mut kinds = std::collections::BTreeSet::new();
+    for (file, value, expect) in fixtures(&contract.join("server").join("valid")) {
+        assert!(
+            expect.is_none(),
+            "{}: a valid fixture has no `$expect`",
+            file.display()
+        );
+        kinds.insert(value["kind"].as_str().unwrap_or_default().to_string());
+        let msg: ServerMsg = serde_json::from_value(value.clone())
+            .unwrap_or_else(|e| panic!("{}: {e}", file.display()));
+        let line = encode_server(&msg).unwrap_or_else(|e| panic!("{}: {e:?}", file.display()));
+        let back: Value = serde_json::from_str(&line).expect("json");
+        assert_eq!(
+            back,
+            value,
+            "{}: encoding changes the message",
+            file.display()
+        );
+    }
+    for kind in [
+        "welcome",
+        "threads",
+        "snapshot",
+        "target_changed",
+        "entry_added",
+        "entry_updated",
+        "entries_removed",
+        "status",
+        "title",
+        "permission_requested",
+        "permission_resolved",
+        "thread_closed",
+        "sent",
+        "ok",
+        "approval_pending",
+        "error",
+    ] {
+        assert!(
+            kinds.contains(kind),
+            "no valid server fixture of kind {kind}"
+        );
+    }
+}
+
+#[test]
+fn browser_contract_agreement_host_manifests_are_byte_identical() {
+    let Some(contract) =
+        contract_dir("browser_contract_agreement_host_manifests_are_byte_identical")
+    else {
+        return;
+    };
+    let templates = Path::new(env!("CARGO_MANIFEST_DIR")).join("../zeo_browser_host/manifests");
+    for browser in ["chrome", "firefox"] {
+        let name = format!("dev.zeo.browser_host.{browser}.json");
+        let expected = fs::read(contract.join("host-manifests").join(&name))
+            .unwrap_or_else(|e| panic!("fixture {name}: {e}"));
+        let template =
+            fs::read(templates.join(&name)).unwrap_or_else(|e| panic!("template {name}: {e}"));
+        assert!(
+            template == expected,
+            "{name}: the crate template and the extension's copy differ"
+        );
+    }
+}
