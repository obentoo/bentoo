+fn console(n: usize, text: &str) -> Value {
+    let entries: Vec<Value> = (0..n)
+        .map(|_| json!({ "level": "log", "text": text, "source": null, "ts": 1 }))
+        .collect();
+    json!({ "type": "console", "page_url": URL, "cut_short": false, "entries": entries })
+}
+fn network(n: usize, url: &str) -> Value {
+    let entries: Vec<Value> = (0..n)
+        .map(|_| json!({ "method": "GET", "url": url, "status": 200, "resource_type": "fetch", "ms": 3, "failed": null }))
+        .collect();
+    json!({ "type": "network", "page_url": URL, "cut_short": false, "entries": entries })
+}
+fn send(text: &str, attachments: Vec<Value>) -> Value {
+    json!({ "v": 2, "kind": "send", "id": "r1", "text": text, "attachments": attachments })
+}
+fn elements(n: usize) -> Vec<Value> {
