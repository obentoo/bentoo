+// ---------------------------------------------------------------------------------------------
+// Encoding
+
+/// One compact JSON line, without its `\n`: serde_json escapes every newline inside a string,
+/// so the line cannot split a frame. Refuses more than [`MAX_SERVER_LINE_BYTES`] (R3.10).
+pub fn encode_server(msg: &ServerMsg) -> Result<String, EncodeError> {
+    let line = serde_json::to_string(msg).map_err(EncodeError::Serialize)?;
+    if line.len() > MAX_SERVER_LINE_BYTES {
+        return Err(EncodeError::TooLarge { len: line.len() });
+    }
+    Ok(line)
+}
