+#[test]
+fn session_a_stalled_consumer_stops_the_reader_at_the_bound_and_draining_resumes_it() {
+    use crate::channel::ClientMsg;
+
+    let tmp = tempfile::tempdir().expect("temp dir");
+    let dir = std::fs::canonicalize(tmp.path())
+        .expect("canonical")
+        .join("zeo");
+    // The stalled consumer: it keeps every `Message` event, and with it the event's permit.
+    let held: Arc<Mutex<Vec<SessionEvent>>> = Arc::default();
+    let order: Arc<Mutex<Vec<String>>> = Arc::default();
+    let handler: SessionHandler = {
+        let held = held.clone();
+        let order = order.clone();
+        Arc::new(move |event: SessionEvent| {
+            if let SessionEvent::Message {
+                msg: ClientMsg::Cancel { id, .. },
+                ..
+            } = &event
+            {
+                order.lock().unwrap().push(id.clone());
+                held.lock().unwrap().push(event);
+            }
+        })
+    };
+    let v1: Handler = Arc::new(|_selection: DevtoolsSelection| {
+        async {
+            serde_json::from_value::<DevtoolsResult>(
+                json!({ "v": 1, "ok": true, "outcome": "inserted", "items": 1, "image": "none" }),
+            )
+            .expect("result")
+        }
+        .boxed()
+    });
+    let _listener = listener::start_with_sessions(&dir, v1, handler).expect("the bridge listens");
+
+    let mut client = Client::hello(&dir);
+    for n in 0..20 {
+        client.send(&json!({ "v": 2, "kind": "cancel", "id": format!("c{n}") }));
+    }
+    wait_until("the bound", || {
+        order.lock().unwrap().len() == listener::SESSION_MESSAGES_IN_FLIGHT
+    });
+    thread::sleep(Duration::from_millis(300));
+    assert_eq!(
+        order.lock().unwrap().len(),
+        listener::SESSION_MESSAGES_IN_FLIGHT,
+        "the reader stops at the bound"
+    );
+
+    wait_until("every message after draining", || {
+        held.lock().unwrap().clear();
+        order.lock().unwrap().len() == 20
+    });
+    let expected: Vec<String> = (0..20).map(|n| format!("c{n}")).collect();
+    assert_eq!(
+        *order.lock().unwrap(),
+        expected,
+        "resumed in order, nothing lost"
+    );
+}
