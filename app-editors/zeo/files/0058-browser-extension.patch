+/// Carries browser-session events from the bridge thread to a foreground consumer, in the order
+/// the listener emitted them. It mirrors [`Relay`], but streams: one `Opened`, the session's
+/// `Message`s, then its one `Closed`.
+///
+/// The app's consumer is `agent_ui::browser_channel`, through [`browser_session_relay`].
+///
+/// The queue is unbounded because no event may be lost: a dropped `Closed` would leave the
+/// consumer holding a session that is gone, so `Opened` and `Closed` are never held back. What
+/// bounds it is each `Message`'s permit: it is released when the consumer returns and drops the
+/// event, and a session holding `SESSION_MESSAGES_IN_FLIGHT` unreleased permits stops reading its
+/// socket. With at most `SESSION_PLACES` sessions, a stalled foreground queues at most
+/// `SESSION_PLACES × SESSION_MESSAGES_IN_FLIGHT` messages.
+///
+/// The consumer needs no `SessionSink::close` on disable or quit: stopping the listener ends
+/// every session and emits its `Closed`. `close` is for an end the consumer decides, such as a
+/// revoked approval.
+pub struct SessionRelay {
+    events: smol::channel::Sender<SessionEvent>,
+    _forwarding: Task<()>,
+}
+
+impl SessionRelay {
+    pub fn new(mut consumer: impl FnMut(SessionEvent, &mut App) + 'static, cx: &mut App) -> Self {
+        let (events, incoming) = smol::channel::unbounded::<SessionEvent>();
+        let forwarding = cx.spawn(async move |cx| {
+            while let Ok(event) = incoming.recv().await {
+                cx.update(|cx| consumer(event, cx));
+            }
+        });
+        Self {
+            events,
+            _forwarding: forwarding,
+        }
+    }
+
+    /// The listener's session handler: queues each event for the foreground without waiting.
+    pub fn handler(&self) -> SessionHandler {
+        let events = self.events.clone();
+        Arc::new(move |event| {
+            if events.try_send(event).is_err() {
+                // Only a dropped relay closes the queue, and that happens when the app goes away.
+                log::debug!(
+                    "devtools_bridge event=session_event_dropped reason=\"the relay is gone\""
+                );
+            }
+        })
+    }
+}
+
+/// The relay `init_in` starts the listener with: its consumer is `agent_ui::browser_channel`.
+/// `Opened` opens a [`BrowserSession`] and hands it the `hello`, each `Message` is handled and then
+/// dropped, which releases its permit, and `Closed` ends the session with
+/// [`browser_channel::close_session`].
+pub fn browser_session_relay(app_state: Arc<AppState>, cx: &mut App) -> SessionRelay {
+    let mut sessions: HashMap<SessionId, BrowserSession> = HashMap::new();
+    SessionRelay::new(
+        move |event, cx| match event {
+            SessionEvent::Opened { id, hello, sink } => {
+                let session = BrowserSession::new(id.clone(), sink);
+                browser_channel::handle_session_message(&session, hello, app_state.clone(), cx);
+                sessions.insert(id, session);
+            }
+            SessionEvent::Message { id, msg, permit } => {
+                match sessions.get(&id) {
+                    Some(session) => {
+                        browser_channel::handle_session_message(session, msg, app_state.clone(), cx)
+                    }
+                    // The listener emits `Opened` first, so this is a bug, not a peer's doing.
+                    None => log::warn!(
+                        "devtools_bridge event=session_msg session={id} kind={} \
+                         outcome=unknown_session",
+                        msg.kind()
+                    ),
+                }
+                // Released only now: the handler has returned.
+                drop(permit);
+            }
+            SessionEvent::Closed { id } => {
+                sessions.remove(&id);
+                browser_channel::close_session(id, cx);
+            }
+        },
+        cx,
+    )
+}
