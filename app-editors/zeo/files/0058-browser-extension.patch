+// A native terminal prompt offers "Always for terminal" and "Always for `cargo build` commands"
+// under the same option id, told apart only by the pattern the second carries. Answering the
+// pattern choice without its pattern would persist "always allow the terminal" in the settings:
+// the wire must name each choice apart, and the answer must carry the choice's pattern.
+#[gpui::test]
+async fn drive_a_pattern_choice_is_answered_with_its_pattern_not_the_tool_wide_default(
+    cx: &mut TestAppContext,
+) {
+    use agent::{AgentTool as _, TerminalTool, ToolPermissionContext};
+
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let options = ToolPermissionContext::new(TerminalTool::NAME, vec!["cargo build".to_string()])
+        .build_permission_options();
+    let connection = StubAgentConnection::new().with_permission_requests(HashMap::from_iter([(
+        acp_v2::ToolCallId::new("1"),
+        options,
+    )]));
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::ToolCall(
+        acp_v1::ToolCall::new(acp_v1::ToolCallId::new("1"), "cargo build")
+            .kind(acp_v1::ToolKind::Execute),
+    )]);
+    let win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let probe = approved_on(&win, cx).await;
+    probe.handle(
+        request(
+            "send",
+            "m1",
+            json!({ "text": "build it", "attachments": [] }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    let msgs = probe.drain(cx);
+    let permission = msgs
+        .iter()
+        .find(|m| m["kind"] == "permission_requested")
+        .unwrap_or_else(|| panic!("a permission_requested: {msgs:?}"))["permission"]
+        .clone();
+    let offered = permission["options"]
+        .as_array()
+        .cloned()
+        .unwrap_or_default();
+    let ids: Vec<String> = offered
+        .iter()
+        .map(|o| o["option_id"].as_str().unwrap_or_default().to_string())
+        .collect();
+    let distinct: std::collections::HashSet<&String> = ids.iter().collect();
+    assert_eq!(
+        distinct.len(),
+        ids.len(),
+        "every choice has its own wire id: {offered:?}"
+    );
+    let pattern_allow = offered
+        .iter()
+        .find(|o| {
+            o["kind"] == "allow_always"
+                && o["label"]
+                    .as_str()
+                    .is_some_and(|label| label.contains("cargo build"))
+        })
+        .unwrap_or_else(|| panic!("the pattern choice is offered: {offered:?}"))["option_id"]
+        .clone();
+
+    probe.handle(
+        request(
+            "authorize",
+            "a1",
+            json!({ "request_id": permission["request_id"], "option_id": pattern_allow }),
+        ),
+        &win.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&probe.drain(cx), "a1")["kind"], "ok");
+    let outcomes = connection.take_authorization_outcomes();
+    let [acp_thread::RequestPermissionOutcome::Selected(outcome)] = outcomes.as_slice() else {
+        panic!("one selected outcome: {outcomes:?}");
+    };
+    assert_eq!(
+        outcome.option_kind,
+        acp_v2::PermissionOptionKind::AllowAlways
+    );
+    assert!(
+        matches!(&outcome.params, Some(acp_thread::SelectedPermissionParams::Terminal { patterns }) if !patterns.is_empty()),
+        "the pattern rides with the answer; without it the terminal is allowed tool-wide: {outcome:?}"
+    );
+}
+
+// The operator may be editing an earlier message, with the composer expanded, while the
+// browser sends: the send must leave both as they were.
+#[gpui::test]
+async fn drive_a_browser_send_keeps_the_operators_edit_and_expanded_composer(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new();
+    let mut win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let probe = approved_on(&win, cx).await;
+    probe.handle(
+        request("send", "m1", json!({ "text": "first", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    probe.drain(cx);
+    let session_id = win
+        .thread()
+        .read_with(&win.cx, |thread, _| thread.session_id().clone());
+    connection.end_turn(session_id, acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+
+    let view = win.view();
+    view.update(&mut win.cx, |view, _| {
+        view.editing_message = Some(0);
+        view.editor_expanded = true;
+    });
+    probe.handle(
+        request("send", "m2", json!({ "text": "second", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    let sent = reply(&probe.drain(cx), "m2");
+    assert_eq!(sent["kind"], "sent", "{sent}");
+    assert_eq!(sent["queued"], false, "{sent}");
+    assert_eq!(user_messages(&win).len(), 2);
+    view.read_with(&win.cx, |view, _| {
+        assert_eq!(
+            view.editing_message,
+            Some(0),
+            "the edit in progress survives"
+        );
+        assert!(view.editor_expanded, "the expanded composer stays expanded");
+    });
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/status.rs b/crates/agent_ui/src/browser_channel_tests/status.rs
new file mode 100644
index 0000000..30d1190
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/status.rs
@@ -0,0 +1,353 @@
+// Story 045, task 12.1 — the thread's error state and message in `Status` (design.md §Contract:
+// `Status = { state: "idle" | "working" | "awaiting_permission" | "error"; message: string | null
+// }`, plus "unconfirmed" since upstream's resumed v2 sessions, the last test below). Requirement:
+// R6.7. Never logged: R13.4. Fixtures and seams: `test_support`.
+//
+// Wired INSIDE `src/browser_channel.rs`, next to the other test modules:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/status.rs"]
+//     mod status;
+//
+// Driven black-box: a turn fails through the stub connection, and every assertion reads the
+// session's wire output (`status` messages and `snapshot.status`).
+//
+// Hostile halves first:
+//   - wrongly collapse: a thread that errored, seen by a FRESH subscribe, must not read `idle`
+//     like a thread that never failed — and a clean thread beside it must not read `error`
+//     because a different thread failed (the error belongs to its thread, not to the channel);
+//   - wrongly split: once the errored thread runs again, its state and its message clear
+//     together — no `working` or `idle` status still carrying the old message, and no fresh
+//     snapshot still reading `error`;
+//   - caps: an error text over every wire-string cap of this module arrives cut, on a character
+//     boundary, and its line still fits; a short one arrives whole and verbatim (plain text).
+
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::{v1::schema as acp_v1, v2::schema as acp_v2};
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::test_support::*;
+
+/// Markdown syntax on purpose: the sidebar gets the error's own text, not a rendering of it.
+const ERROR_TEXT: &str = "agent crashed: `claude-agent-acp` exited with **status 7**";
+
+fn statuses(msgs: &[Value]) -> Vec<Value> {
+    msgs.iter()
+        .filter(|m| m["kind"] == "status")
+        .map(|m| m["status"].clone())
+        .collect()
+}
+
+fn snapshot_of(msgs: &[Value]) -> Value {
+    msgs.iter()
+        .find(|m| m["kind"] == "snapshot")
+        .cloned()
+        .unwrap_or_else(|| panic!("a snapshot: {:?}", kinds(msgs)))
+}
+
+/// A new session, approved, subscribed to `target`; returns it and its snapshot.
+fn fresh_subscribe(n: u64, win: &Win, target: Value, cx: &mut TestAppContext) -> (Probe, Value) {
+    let probe = open_session(n);
+    approve(&probe, &win.app_state(), cx);
+    probe.handle(
+        request("subscribe", "s", json!({ "target": target })),
+        &win.app_state(),
+        cx,
+    );
+    let snapshot = snapshot_of(&probe.drain(cx));
+    (probe, snapshot)
+}
+
+/// Sends a message from the browser and fails its turn with `text`; returns what followed.
+fn fail_turn(
+    probe: &Probe,
+    win: &Win,
+    connection: &StubAgentConnection,
+    text: &str,
+    cx: &mut TestAppContext,
+) -> Vec<Value> {
+    let finish = connection.defer_next_prompt_response();
+    probe.handle(
+        request("send", "m", json!({ "text": "go", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    let mut got = probe.drain(cx);
+    assert!(
+        statuses(&got).iter().any(|s| s["state"] == "working"),
+        "the turn ran: {:?}",
+        kinds(&got)
+    );
+    assert!(
+        finish.send(Err(anyhow::anyhow!(text.to_string()))).is_ok(),
+        "the turn is still waiting for its response"
+    );
+    cx.run_until_parked();
+    got.extend(probe.drain(cx));
+    got
+}
+
+fn assert_errored_with(status: &Value, text: &str, context: &str) {
+    assert_eq!(status["state"], "error", "{context}: {status}");
+    let message = status["message"].as_str().unwrap_or_else(|| {
+        panic!("{context}: an error status carries its message (R6.7): {status}")
+    });
+    assert!(
+        message.contains(text),
+        "{context}: the error's own text, verbatim: {message:?}"
+    );
+}
+
+fn assert_clean(status: &Value, context: &str) {
+    assert_ne!(status["state"], "error", "{context}: {status}");
+    assert!(
+        status["message"].is_null(),
+        "{context}: no message outside an error: {status}"
+    );
+}
+
+#[gpui::test]
+async fn status_a_failed_turn_sends_error_with_its_message(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new();
+    let win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let (probe, snapshot) = fresh_subscribe(1, &win, json!({ "follow": true }), cx);
+    assert_clean(&snapshot["status"], "before any turn");
+
+    let logged_before = super::logged_lines().len();
+    let got = fail_turn(&probe, &win, &connection, ERROR_TEXT, cx);
+    let statuses = statuses(&got);
+    assert!(
+        statuses.iter().any(|s| s["state"] == "error"),
+        "R6.7: the failure is sent: {statuses:?}"
+    );
+    let last = statuses.last().expect("a status after the failure");
+    assert_errored_with(last, ERROR_TEXT, "the last status after the failure");
+    for status in &statuses {
+        if status["state"] != "error" {
+            assert!(
+                status["message"].is_null(),
+                "message only with error: {status}"
+            );
+        }
+    }
+
+    let logged: Vec<String> = super::logged_lines()
+        .into_iter()
+        .skip(logged_before)
+        .collect();
+    assert!(
+        logged.iter().all(|line| !line.contains("status 7")),
+        "R13.4: the error text is sent, never logged: {logged:?}"
+    );
+}
+
+#[gpui::test]
+async fn status_a_fresh_subscribe_reads_the_error_and_only_on_the_thread_that_failed(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let failing = StubAgentConnection::new();
+    let mut a = window(&fs, "/p/app", Some(failing.clone()), cx).await;
+    let b = window(&fs, "/p/web", Some(StubAgentConnection::new()), cx).await;
+    activate(&mut a);
+    let (live, snapshot) = fresh_subscribe(1, &a, json!({ "follow": true }), cx);
+    let a_id = snapshot["thread"]["thread_id"].clone();
+    fail_turn(&live, &a, &failing, ERROR_TEXT, cx);
+
+    // The other thread: listed by project, never touched by A's failure.
+    let probe = open_session(2);
+    approve(&probe, &a.app_state(), cx);
+    probe.handle(request("list_threads", "l", json!({})), &a.app_state(), cx);
+    let threads = probe
+        .drain(cx)
+        .into_iter()
+        .find(|m| m["kind"] == "threads")
+        .expect("threads");
+    let b_id = threads["items"]
+        .as_array()
+        .expect("items")
+        .iter()
+        .find(|item| item["project"] == "web")
+        .map(|item| item["thread_id"].clone())
+        .expect("the thread of the second window");
+    assert_ne!(a_id, b_id);
+
+    // Hostile half: the clean thread must not inherit the failure of another thread.
+    let (_, clean) = fresh_subscribe(3, &b, json!({ "thread_id": b_id }), cx);
+    assert_eq!(clean["thread"]["thread_id"], b_id);
+    assert_clean(&clean["status"], "a thread that never failed");
+
+    // Hostile half: the failed thread, seen by a session that was not there, is not `idle`.
+    let (_, errored) = fresh_subscribe(4, &a, json!({ "thread_id": a_id }), cx);
+    assert_eq!(errored["thread"]["thread_id"], a_id);
+    assert_errored_with(
+        &errored["status"],
+        ERROR_TEXT,
+        "R6.7: a snapshot after the failure",
+    );
+
+    // The session that watched the failure re-subscribes: the same answer.
+    live.handle(
+        request(
+            "subscribe",
+            "again",
+            json!({ "target": { "thread_id": a_id } }),
+        ),
+        &a.app_state(),
+        cx,
+    );
+    let again = snapshot_of(&live.drain(cx));
+    assert_errored_with(
+        &again["status"],
+        ERROR_TEXT,
+        "a re-subscribe after the failure",
+    );
+}
+
+#[gpui::test]
+async fn status_the_next_run_clears_the_error_state_and_its_message_together(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new();
+    let win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let (probe, _) = fresh_subscribe(1, &win, json!({ "follow": true }), cx);
+    let failed = fail_turn(&probe, &win, &connection, ERROR_TEXT, cx);
+    let last = statuses(&failed).last().cloned().expect("a status");
+    assert_errored_with(
+        &last,
+        ERROR_TEXT,
+        "precondition: the failure carried its message",
+    );
+
+    // The next run: the stub keeps the turn open until `end_turn`.
+    probe.handle(
+        request("send", "m2", json!({ "text": "again", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    let running = statuses(&probe.drain(cx));
+    let working = running
+        .iter()
+        .find(|s| s["state"] == "working")
+        .unwrap_or_else(|| panic!("the next run is working: {running:?}"));
+    assert_clean(working, "the next run");
+    for status in &running {
+        assert_clean(status, "while the next run goes");
+    }
+
+    let session_id = win
+        .thread()
+        .read_with(&win.cx, |thread, _| thread.session_id().clone());
+    connection.end_turn(session_id, acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+    let ended = statuses(&probe.drain(cx));
+    let last = ended
+        .last()
+        .unwrap_or_else(|| panic!("a status at the end: {ended:?}"));
+    assert_eq!(last["state"], "idle", "{last}");
+    assert_clean(last, "after a clean turn");
+
+    let (_, snapshot) = fresh_subscribe(2, &win, json!({ "follow": true }), cx);
+    assert_clean(
+        &snapshot["status"],
+        "a fresh subscribe after the clean turn",
+    );
+}
+
+#[gpui::test]
+async fn status_an_over_long_error_message_is_capped_on_a_character_boundary(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new();
+    let win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let (probe, _) = fresh_subscribe(1, &win, json!({ "follow": true }), cx);
+
+    // An odd-length head, then two-byte characters: an even byte cap lands mid-character.
+    let widest_cap = super::TITLE_BYTES.max(super::ENTRY_MARKDOWN_BYTES);
+    let huge = format!("HEAD-{}", "é".repeat(widest_cap * 2));
+    assert!(huge.len() > widest_cap * 3);
+    let got = fail_turn(&probe, &win, &connection, &huge, cx);
+    for msg in &got {
+        let line = serde_json::to_string(msg).expect("serializes");
+        assert!(line.len() < super::MAX_SERVER_LINE_BYTES, "R3.10: one line");
+    }
+    let last = statuses(&got).last().cloned().expect("a status");
+    assert_eq!(last["state"], "error", "{}", last["state"]);
+    let message = last["message"]
+        .as_str()
+        .expect("an error status carries its message, even an over-long one");
+    let bound = widest_cap + super::TRUNCATION_NOTE.len();
+    assert!(
+        message.len() <= bound,
+        "capped like the module's other wire strings: {} > {bound} bytes",
+        message.len()
+    );
+    assert!(message.len() < huge.len(), "the message was cut");
+    assert!(
+        message.starts_with("HEAD-éé"),
+        "the head of the text is kept"
+    );
+
+    // The cap holds in a snapshot too.
+    let (_, snapshot) = fresh_subscribe(2, &win, json!({ "follow": true }), cx);
+    let message = snapshot["status"]["message"]
+        .as_str()
+        .expect("the snapshot carries the capped message");
+    assert!(message.len() <= bound, "{} > {bound} bytes", message.len());
+}
+
+// A resumed v2 session reads Unconfirmed until the agent reports its activity (upstream
+// da5921d6ba). The sidebar is told so rather than shown `idle`, and a browser send is a manual
+// send: it goes out at once, as the composer's does, instead of waiting in the queue for an
+// idle report that may never come.
+#[gpui::test]
+async fn status_an_unconfirmed_thread_reads_unconfirmed_and_takes_a_browser_send(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = StubAgentConnection::new().with_receipt_submissions(true);
+    let win = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    let thread = win.thread();
+    thread.update(cx, |thread, cx| thread.mark_activity_unconfirmed(cx));
+    cx.run_until_parked();
+    assert_eq!(
+        thread.read_with(cx, |thread, _| thread.status()),
+        acp_thread::ThreadStatus::Unconfirmed
+    );
+
+    let (probe, snapshot) = fresh_subscribe(1, &win, json!({ "follow": true }), cx);
+    assert_eq!(
+        snapshot["status"]["state"], "unconfirmed",
+        "not `idle`: {snapshot}"
+    );
+    assert!(snapshot["status"]["message"].is_null());
+
+    let response = connection.defer_next_receipt_response();
+    probe.handle(
+        request("send", "m", json!({ "text": "go", "attachments": [] })),
+        &win.app_state(),
+        cx,
+    );
+    cx.run_until_parked();
+    assert_eq!(
+        connection.take_receipt_prompt(),
+        Some(vec!["go".into()]),
+        "the browser send went out while the thread was Unconfirmed"
+    );
+    win.view().read_with(cx, |view, _| {
+        assert_eq!(view.message_queue.len(), 0, "nothing was queued");
+    });
+    response
+        .send(Ok(acp_v2::PromptResponse::new("go")))
+        .expect("the receipt is still awaited");
+    cx.run_until_parked();
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/stream.rs b/crates/agent_ui/src/browser_channel_tests/stream.rs
new file mode 100644
index 0000000..92ba884
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/stream.rs
@@ -0,0 +1,608 @@
+// Story 045, task 7.4 — list, follow, subscribe and the event pump (design.md §B2 List/Follow/
+// Subscribe, §Performance). Requirements: R5.1–R5.6, R6.1–R6.7, R7.5, R7.7, R3.10 (snapshot fits
+// one line), R13.2 (debug log, Q15). Q4. Fixtures and seams: `test_support`.
+//
+// Hostile halves first:
+//   - follow vs pinned: in follow mode activating another window retargets (target_changed, then
+//     a snapshot of the new thread) AND the old thread's events stop; pinned, activating another
+//     window changes nothing and the pinned thread's events keep coming;
+//   - list identity: two threads with the same title in two windows stay two, distinct ids, and
+//     exactly one is followed;
+//   - caps: 105 entries give the LATEST 100 plus `earlier: 5`; an entry over 64 KiB is truncated
+//     and marked while a short one is whole; a snapshot whose entries exceed one line drops the OLDEST;
+//   - coalescing: 50 chunks inside 100 ms give at most two updates, the last one complete.
+
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::test_support::*;
+
+fn push(win: &Win, user: bool, text: &str, cx: &mut TestAppContext) {
+    let thread = win.thread();
+    // Alternating roles makes each push a new entry; the same role extends the last entry.
+    thread.update(cx, |thread, cx| {
+        if user {
+            thread.push_user_content_block(None, text.to_string().into(), cx);
+        } else {
+            thread.push_assistant_content_block(text.to_string().into(), false, cx);
+        }
+    });
+    cx.run_until_parked();
+}
+
+fn entries(win: &Win, n: usize, size: usize, cx: &mut TestAppContext) {
+    for i in 0..n {
+        let text = format!("entry-{i:03} {}", "y".repeat(size));
+        push(win, i % 2 == 0, &text, cx);
+    }
+}
+
+fn subscribed(win: &Win, target: Value, cx: &mut TestAppContext) -> (Probe, Value) {
+    let probe = open_session(1);
+    approve(&probe, &win.app_state(), cx);
+    probe.handle(
+        request("subscribe", "s", json!({ "target": target })),
+        &win.app_state(),
+        cx,
+    );
+    let msgs = probe.drain(cx);
+    let snapshot = msgs
+        .iter()
+        .find(|m| m["kind"] == "snapshot")
+        .cloned()
+        .unwrap_or_else(|| panic!("a snapshot: {msgs:?}"));
+    (probe, snapshot)
+}
+
+#[gpui::test]
+async fn stream_list_threads_keeps_same_titled_threads_apart_with_one_followed_first(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let a = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let mut b = window(&fs, "/p/web", Some(StubAgentConnection::new()), cx).await;
+    for win in [&a, &b] {
+        let thread = win.thread();
+        thread
+            .update(cx, |t, cx| t.set_title("Same title".into(), cx))
+            .detach();
+    }
+    cx.run_until_parked();
+    activate(&mut b);
+    let probe = open_session(1);
+    approve(&probe, &a.app_state(), cx);
+    probe.handle(request("list_threads", "l", json!({})), &a.app_state(), cx);
+    let threads = probe
+        .drain(cx)
+        .into_iter()
+        .find(|m| m["kind"] == "threads")
+        .expect("threads");
+    let items = threads["items"].as_array().expect("items");
+    assert_eq!(items.len(), 2, "R5.1: never collapsed by title: {items:?}");
+    assert_ne!(items[0]["thread_id"], items[1]["thread_id"]);
+    assert_eq!(items.iter().filter(|i| i["followed"] == true).count(), 1);
+    assert_eq!(items[0]["followed"], true, "the followed thread first");
+    assert_eq!(
+        items[0]["project"], "web",
+        "the most recently active window's thread"
+    );
+    for item in items {
+        for key in ["title", "project", "agent", "status"] {
+            assert!(
+                item[key].as_str().is_some_and(|v| !v.is_empty()),
+                "{key} in {item}"
+            );
+        }
+    }
+    assert!(items.len() <= 50);
+}
+
+#[gpui::test]
+async fn stream_follow_retargets_on_activation_and_drops_the_old_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut a = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let mut b = window(&fs, "/p/web", Some(StubAgentConnection::new()), cx).await;
+    activate(&mut a);
+    let (probe, snapshot) = subscribed(&a, json!({ "follow": true }), cx);
+    assert_eq!(snapshot["thread"]["project"], "app", "R5.2");
+    activate(&mut b);
+    let got = probe.drain(cx);
+    let k = kinds(&got);
+    let changed = k
+        .iter()
+        .position(|k| k == "target_changed")
+        .expect("R5.3: target_changed");
+    let snap = k
+        .iter()
+        .rposition(|k| k == "snapshot")
+        .expect("then a snapshot");
+    assert!(changed < snap, "{k:?}");
+    assert_eq!(got[changed]["thread"]["project"], "web");
+    push(&a, true, "OLD-THREAD-TEXT", cx);
+    assert!(
+        !probe
+            .drain(cx)
+            .iter()
+            .any(|m| m.to_string().contains("OLD-THREAD-TEXT")),
+        "the old subscription is dropped"
+    );
