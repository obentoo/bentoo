+fn dom(text: &str) -> Value {
+    json!({ "tag": "b", "id": null, "classes": [], "text": text, "attrs": {}, "styles": {}, "rect": { "x": 0, "y": 0, "w": 1, "h": 1 } })
+}
+fn element(i: usize) -> Value {
+    json!({ "type": "element", "page_url": URL, "selector": format!("#e{i}"), "html": "<b>x</b>", "dom": dom("x") })
+}
+fn with(mut v: Value, key: &str, value: Value) -> Value {
+    v[key] = value;
+    v
+}
+fn image(data: String, w: u32, h: u32, mime: &str) -> Value {
+    json!({ "type": "image", "mime": mime, "data_b64": data, "w": w, "h": h })
