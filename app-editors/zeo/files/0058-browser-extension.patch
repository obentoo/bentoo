+#[gpui::test]
+async fn approval_an_unknown_identity_is_pending_with_a_notification_in_the_most_recent_window(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut older = window(&fs, "/p/app", None, cx).await;
+    let mut recent = window(&fs, "/p/web", None, cx).await;
+    activate(&mut older);
+    activate(&mut recent);
+    let (before_older, before_recent) = (older.notifications(), recent.notifications());
+
+    let probe = open_session(1);
+    probe.handle(
+        hello("chrome", "abcdefghijklmnopabcdefghijklmnop"),
+        &recent.app_state(),
+        cx,
+    );
+    assert_eq!(kinds(&probe.drain(cx)), ["approval_pending"]);
+    assert_eq!(
+        recent.notifications(),
+        before_recent + 1,
+        "R4.1: in the most recently active window"
+    );
+    assert_eq!(older.notifications(), before_older, "and only there");
+}
