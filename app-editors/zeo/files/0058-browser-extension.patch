+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+/// An optional field that, when present, must hold a value: serde reads `null` as `None` for a
+/// plain `Option`, where the zod schema (`.optional()`) refuses it.
+fn present<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
+
+/// A nullable field the contract still requires to be present: serde would otherwise read a
+/// missing key as `None`, where the zod schema refuses it.
+fn required_nullable<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    Option::<T>::deserialize(deserializer)
+}
