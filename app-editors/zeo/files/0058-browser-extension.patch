@@ -0,0 +1,74 @@
+// Story 045, task 6.1 — native-messaging framing: a u32 length in NATIVE byte order, then UTF-8
+// JSON (design.md §B4; R2.5). Wired in `src/main.rs` as `#[cfg(test)] mod frame_tests;`.
+//
+// Assumed signatures (adjust the `use` only):
+//   `crate::frame::read_frame(r: &mut impl Read) -> Result<Option<Vec<u8>>, FrameError>`
+//   (`Ok(None)` at a clean EOF between frames) and
+//   `crate::frame::write_frame(w: &mut impl Write, body: &[u8]) -> std::io::Result<()>`.
+//
+// Hostile halves first: a frame over 8 MiB is refused AND its body is skipped, so the NEXT frame
+// still reads correctly (the connection stays usable, R2.5); exactly 8 MiB is accepted.
+
+use std::io::Cursor;
+
+use crate::frame::{read_frame, write_frame};
+
+const MAX: usize = 8 * 1024 * 1024;
+
+fn framed(body: &[u8]) -> Vec<u8> {
+    let mut out = (body.len() as u32).to_ne_bytes().to_vec();
+    out.extend_from_slice(body);
+    out
+}
+
+#[test]
+fn frame_reads_native_endian_frames_in_order_then_eof() {
+    let mut bytes = framed(br#"{"a":1}"#);
+    bytes.extend(framed(br#"{"b":2}"#));
+    let mut r = Cursor::new(bytes);
+    assert_eq!(
+        read_frame(&mut r).expect("ok").as_deref(),
+        Some(&br#"{"a":1}"#[..])
+    );
+    assert_eq!(
+        read_frame(&mut r).expect("ok").as_deref(),
+        Some(&br#"{"b":2}"#[..])
+    );
+    assert!(read_frame(&mut r).expect("clean eof").is_none());
+}
+
+#[test]
+fn frame_over_8_mib_is_refused_and_skipped_so_the_next_frame_reads() {
+    let mut bytes = framed(&vec![b'a'; MAX + 1]);
+    bytes.extend(framed(br#"{"next":true}"#));
+    let mut r = Cursor::new(bytes);
+    assert!(read_frame(&mut r).is_err(), "8 MiB + 1 is refused");
+    assert_eq!(
+        read_frame(&mut r).expect("aligned").as_deref(),
+        Some(&br#"{"next":true}"#[..])
+    );
+}
+
+#[test]
+fn frame_of_exactly_8_mib_is_accepted() {
+    let mut r = Cursor::new(framed(&vec![b' '; MAX]));
+    assert_eq!(read_frame(&mut r).expect("ok").map(|b| b.len()), Some(MAX));
+}
+
+#[test]
+fn frame_truncated_body_is_an_error_not_a_short_frame() {
+    let mut bytes = (100u32).to_ne_bytes().to_vec();
+    bytes.extend_from_slice(b"{\"short\":");
+    assert!(read_frame(&mut Cursor::new(bytes)).is_err());
+}
+
+#[test]
+fn frame_write_round_trips() {
+    let mut out = Vec::new();
+    write_frame(&mut out, br#"{"kind":"bridge_closed"}"#).expect("write");
+    assert_eq!(out, framed(br#"{"kind":"bridge_closed"}"#));
+    assert_eq!(
+        read_frame(&mut Cursor::new(out)).expect("ok").as_deref(),
+        Some(&br#"{"kind":"bridge_closed"}"#[..])
+    );
+}
