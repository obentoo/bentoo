+/// Hostile (identity): two children titled alike are two entries; a child with no label of its
+/// parent's falls back to its own title, then to "Subagent" — and the parent's label wins over
+/// the child's own title.
+#[gpui::test]
+async fn browser_wire_subagents_lists_each_child_with_its_label(cx: &mut TestAppContext) {
+    let (mut win, connection) = rfd_window(cx).await;
+    let first = spawn_child(&mut win, &connection, "worker-1", Some("Worker"));
+    let second = spawn_child(&mut win, &connection, "worker-2", Some("Worker"));
+    let own = spawn_child(&mut win, &connection, "own-title", None);
+    own.update(&mut win.cx, |thread, cx| {
+        thread.update_session_info(acp_v2::SessionInfoUpdate::new().title("Own title"), cx)
+    });
+    let labelled = spawn_child(&mut win, &connection, "labelled", Some("Parent label"));
+    labelled.update(&mut win.cx, |thread, cx| {
+        thread.update_session_info(acp_v2::SessionInfoUpdate::new().title("Child title"), cx)
+    });
+    let _untitled = spawn_child(&mut win, &connection, "untitled", None);
+    for child in [&first, &second, &own, &labelled] {
+        report(
+            &mut win,
+            child,
+            acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+        );
+    }
+    win.cx.run_until_parked();
+
+    let snapshot = followed_snapshot(&win, cx);
+    let titles: Vec<&str> = subagents_of(&snapshot)
+        .and_then(Value::as_array)
+        .expect("the snapshot lists the children")
+        .iter()
+        .map(|entry| entry["title"].as_str().expect("a title"))
+        .collect();
+    assert_eq!(
+        titles,
+        vec!["Worker", "Worker", "Own title", "Parent label", "Subagent"],
+        "one entry per child, in registration order, with R1.2's label"
+    );
+}
+
+/// Two children and their statuses as the snapshot reports them; the snapshot's other fields
+/// are untouched.
+#[gpui::test]
+async fn browser_wire_subagents_carry_each_childs_status(cx: &mut TestAppContext) {
+    let (mut win, connection) = rfd_window(cx).await;
+    let alpha = spawn_child(&mut win, &connection, "alpha", Some("Alpha"));
+    let bravo = spawn_child(&mut win, &connection, "bravo", Some("Bravo"));
+    report(
+        &mut win,
+        &alpha,
+        acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+    );
+    report(
+        &mut win,
+        &bravo,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+    );
+
+    let snapshot = followed_snapshot(&win, cx);
+    assert_eq!(
+        subagents_of(&snapshot),
+        Some(&json!([
+            { "title": "Alpha", "status": "running" },
+            { "title": "Bravo", "status": "waiting" }
+        ]))
+    );
+    assert!(
+        snapshot["thread"].is_object(),
+        "the thread info is still sent"
+    );
+    assert!(snapshot["entries"].is_array());
+}
