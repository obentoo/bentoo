+    );
+    let origins = connection
+        .select::<String>("SELECT origin FROM agent_task_history")
+        .expect("select")()
+    .expect("run");
+    assert_eq!(origins, vec!["adapter".to_string()]);
+}
+
+// ── The origin decides (R5.7) ──────────────────────────────────────────────
+
+// Hostile (wrong collapse): an adapter task dressed as a sub-thread — kind `sub_thread`, an id
+// carrying the `zeo-sub-thread:` prefix — recorded by the adapter path stays an adapter task.
+#[gpui::test]
+async fn history_db_origin_adapter_task_resembling_a_sub_thread_stays_adapter(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_origin_resembling").await;
+    let mut by_kind = record("s1", "t-kind", AgentTaskStatus::Running, 1_000);
+    by_kind.kind = "sub_thread".into();
+    let by_id = record("s1", "zeo-sub-thread:s9", AgentTaskStatus::Completed, 2_000);
+    let mut by_both = record("s2", "zeo-sub-thread:s1", AgentTaskStatus::Running, 3_000);
+    by_both.kind = "sub_thread".into();
+    for record in [&by_kind, &by_id, &by_both] {
+        db.insert_started(record)
+            .await
+            .expect("insert_started should succeed");
+    }
+
+    let rows = load(&db).await;
+    assert_eq!(origin_of(&rows, "s1", "t-kind"), TaskOrigin::Adapter);
+    assert_eq!(
+        origin_of(&rows, "s1", "zeo-sub-thread:s9"),
+        TaskOrigin::Adapter
+    );
+    assert_eq!(
+        origin_of(&rows, "s2", "zeo-sub-thread:s1"),
+        TaskOrigin::Adapter
+    );
+}
+
+// Hostile (wrong split): a row stored as a sub-thread item reads `SubThread` even when nothing
+// else about it looks like one — no prefix, an adapter kind.
+#[gpui::test]
+async fn history_db_origin_stored_sub_thread_reads_sub_thread_whatever_its_kind_and_id(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_origin_stored_sub_thread").await;
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at, \
+          origin) \
+         VALUES ('s1', 'plain-id', 'zeo', 'shell', 'Looks adapter', 0, 'completed', 1000, \
+                 'sub_thread')",
+    )
+    .await;
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at) \
+         VALUES ('s1', 'zeo-sub-thread:s7', 'zeo', 'sub_thread', 'Looks sub-thread', 0, \
+                 'completed', 2000)",
+    )
+    .await;
+
+    let rows = load(&db).await;
+    assert_eq!(origin_of(&rows, "s1", "plain-id"), TaskOrigin::SubThread);
+    assert_eq!(
+        origin_of(&rows, "s1", "zeo-sub-thread:s7"),
+        TaskOrigin::Adapter,
+        "no origin written: the column default, whatever the kind and id say"
+    );
+}
+
+#[gpui::test]
+async fn history_db_origin_fresh_adapter_record_is_adapter(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_origin_fresh").await;
+    db.insert_started(&record("s1", "t1", AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+    assert_eq!(origin_of(&load(&db).await, "s1", "t1"), TaskOrigin::Adapter);
+}
+
+// R5.7 / Error handling table: an origin this build does not know is never read as one it does.
+#[gpui::test]
+async fn history_db_origin_unknown_text_is_skipped_with_a_warning(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_origin_unknown").await;
+    db.insert_started(&record("s1", "kept", AgentTaskStatus::Completed, 1_000))
+        .await
+        .expect("insert_started should succeed");
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at, \
+          origin) \
+         VALUES ('s1', 'from-the-future', 'zeo', 'shell', 'Future', 0, 'completed', 2000, \
+                 'tray')",
+    )
+    .await;
+
+    capture_logs();
+    let rows = load(&db).await;
+    assert!(
+        find(&rows, "s1", "from-the-future").is_none(),
+        "a row of unknown origin is skipped, never listed as adapter or sub-thread"
+    );
+    assert_eq!(
+        origin_of(&rows, "s1", "kept"),
+        TaskOrigin::Adapter,
+        "the readable rows are still loaded"
+    );
+    assert!(
+        warn_lines()
+            .iter()
+            .any(|line| line.contains("s1") && line.contains("from-the-future")),
+        "the skip is a warning naming the row"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/history_db/sub_thread.rs b/crates/agent_tasks_panel/src/history_db/sub_thread.rs
new file mode 100644
index 0000000..eae99de
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/sub_thread.rs
@@ -0,0 +1,135 @@
+//! Story 040: the writes of a sub-thread item. A sub-thread is recorded under its parent's
+//! session, with a task id of its own, so it groups with the parent's tasks and archives and
+//! deletes through the same `TaskKey` paths (design.md, TaskHistoryStore and AgentTaskHistoryDb).
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_ui::{SubThreadRecord, TaskKey};
+use anyhow::{Context as _, Result};
+use db::sqlez_macros::sql;
+
+use super::{AgentTaskHistoryDb, TaskOrigin};
+
+/// Prefixed so a sub-thread's id never equals an id the adapter chose for a task of the same
+/// session. The prefix alone guarantees nothing, an adapter may pick any id, which is why both
+/// writes below are guarded on the stored origin.
+pub const SUB_THREAD_TASK_PREFIX: &str = "zeo-sub-thread:";
+
+/// The `kind` of a sub-thread item. Display only: the origin column decides what an item is.
+pub const SUB_THREAD_KIND: &str = "sub_thread";
+
+pub fn sub_thread_task_id(record: &SubThreadRecord) -> String {
+    format!("{SUB_THREAD_TASK_PREFIX}{}", record.sub_session)
+}
+
+/// The tombstone write of `delete` (R5.10). Session ids only: the title is user text (R8.1). A
+/// stored id without the prefix is logged as it is.
+pub(super) fn log_tombstone(parent_session: &str, task_id: &str) {
+    let sub_session = task_id
+        .strip_prefix(SUB_THREAD_TASK_PREFIX)
+        .unwrap_or(task_id);
+    log::info!(
+        "zeo_sub_thread event=history_write parent_session={parent_session} \
+         sub_session={sub_session} status=deleted result=ok"
+    );
+}
+
+/// Both sessions name the item in an error; the title is user text and never does.
+fn sessions_of(record: &SubThreadRecord) -> String {
+    format!(
+        "sub-thread {} of session {}",
+        record.sub_session, record.parent_session
+    )
+}
+
+impl AgentTaskHistoryDb {
+    /// Records a sub-thread item, or refreshes its status, description and end on a repeat
+    /// (R5.2, R5.3, R5.5). `status` is the stored text, `running` or `completed`; a running item
+    /// has no end. A conflict never touches `archived`, and never a row the adapter wrote on the
+    /// same key (R5.7).
+    pub async fn upsert_sub_thread(&self, record: &SubThreadRecord, status: &str) -> Result<()> {
+        let sessions = sessions_of(record);
+        let ended_at = (status != "running").then_some(record.at_ms);
+        // Every literal is bound: a single-quoted SQL string inside `sql!` does not compile.
+        let identity = (
+            record.parent_session.to_string(),
+            sub_thread_task_id(record),
+            record.project.to_string(),
+            SUB_THREAD_KIND,
+            record.title.to_string(),
+        );
+        let state = (
+            status.to_string(),
+            record.at_ms,
+            TaskOrigin::SubThread.as_text(),
+            ended_at,
+        );
+        self.write(move |connection| {
+            connection.exec_bound(sql!(
+                INSERT INTO agent_task_history(
+                    session_id, task_id, thread_title, project, kind, description, background,
+                    status, started_at, origin, ended_at
+                ) VALUES (?1, ?2, NULL, ?3, ?4, ?5, 0, ?6, ?7, ?8, ?9)
+                ON CONFLICT(session_id, task_id) DO UPDATE SET
+                    status = excluded.status,
+                    description = excluded.description,
+                    ended_at = excluded.ended_at
+                WHERE agent_task_history.origin = ?8 AND agent_task_history.deleted = 0
+            ))?((identity, state))
+        })
+        .await
+        .with_context(|| format!("recording {sessions} as {status}"))
+    }
+
+    /// What `Linked` and `Retitled` write: a new item is recorded Idle, an existing one gets only
+    /// its description. Status and end are left alone, so a second window's `Linked` cannot flip
+    /// a running sub-thread to Idle (R5.3, R7.4).
+    pub async fn record_sub_thread_link(&self, record: &SubThreadRecord) -> Result<()> {
+        let sessions = sessions_of(record);
+        let identity = (
+            record.parent_session.to_string(),
+            sub_thread_task_id(record),
+            record.project.to_string(),
+            SUB_THREAD_KIND,
+            record.title.to_string(),
+        );
+        let state = (
+            "completed",
+            record.at_ms,
+            TaskOrigin::SubThread.as_text(),
+            record.at_ms,
+        );
+        self.write(move |connection| {
+            connection.exec_bound(sql!(
+                INSERT INTO agent_task_history(
+                    session_id, task_id, thread_title, project, kind, description, background,
+                    status, started_at, origin, ended_at
+                ) VALUES (?1, ?2, NULL, ?3, ?4, ?5, 0, ?6, ?7, ?8, ?9)
+                ON CONFLICT(session_id, task_id) DO UPDATE SET
+                    description = excluded.description
+                WHERE agent_task_history.origin = ?8 AND agent_task_history.deleted = 0
+            ))?((identity, state))
+        })
+        .await
+        .with_context(|| format!("recording the link of {sessions}"))
+    }
+
+    /// The keys of the deleted sub-thread items (R5.10). The store seeds its `deleted` set with
+    /// them before any replayed `Linked` is applied, so a restart does not list them again.
+    pub async fn deleted_sub_thread_keys(&self) -> Result<Vec<TaskKey>> {
+        let keys = self.select_bound::<&str, (String, String)>(sql!(
+            SELECT session_id, task_id FROM agent_task_history
+            WHERE deleted = 1 AND origin = ?1
+        ))?(TaskOrigin::SubThread.as_text())
+        .context("loading the deleted sub-thread items")?;
+        Ok(keys
+            .into_iter()
+            .map(|(session_id, task_id)| {
+                (
+                    acp_v2::SessionId::new(session_id),
+                    AgentTaskId::from(task_id),
+                )
+            })
+            .collect())
+    }
+}
diff --git a/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs b/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs
new file mode 100644
index 0000000..e487520
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs
@@ -0,0 +1,308 @@
+// Story 040, task 3.2 (database half) — `AgentTaskHistoryDb::upsert_sub_thread`: one statement that
+// records or refreshes a sub-thread item (R5.1, R5.2, R5.5, R5.7; Q14). Module path:
+// `history_db::sub_thread_upsert`. Wired in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/sub_thread_upsert_tests.rs"]
+//     mod sub_thread_upsert;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- sub_thread` (names carry
+// `history_db_sub_thread`).
+//
+// Contract (design.md §TaskHistoryStore and AgentTaskHistoryDb, revised 2026-10-20):
+//   - `AgentTaskHistoryDb::upsert_sub_thread(&SubThreadRecord, status: &str)`, one
+//     `INSERT … ON CONFLICT(session_id, task_id) DO UPDATE … WHERE agent_task_history.origin =
+//     'sub_thread'` statement (every literal bound as `?n`): `session_id` = the parent's session,
+//     `task_id = 'zeo-sub-thread:' || sub_session`, `kind = 'sub_thread'`, `description` = the
+//     title, `origin = 'sub_thread'`; a conflict refreshes status, description and `ended_at`,
+//     never `archived`; an error names both session ids;
+//   - `AgentTaskHistoryDb::record_sub_thread_link(&SubThreadRecord)`, the same INSERT with status
+//     `completed`, whose conflict updates the DESCRIPTION ONLY (never status or `ended_at`), under
+//     the same origin guard — what `Linked` and `Retitled` write;
+//   - `agent_ui::SubThreadRecord { parent_session, sub_session, title, project, at_ms }`.
+// Assumed beyond design.md: both methods are `async` and return `anyhow::Result<()>` like every
+// other writer of this domain; `SubThreadRecord`'s fields are `pub` and it is `Clone`. Adjust in
+// `upsert`, `link_item` and `sub_record` only.
+//
+// Hostile halves first:
+//   - wrongly collapse: two sub-threads of one parent are two items; a sub-thread whose session id
+//     equals an adapter task id of the parent's session is a separate item;
+//   - a THIRD element against the derived key: an adapter task whose id is literally
+//     `zeo-sub-thread:<sub session>` already sits on the key both writers derive. Neither may
+//     rewrite that adapter row (its origin, kind, description and status stay) — the origin guard;
+//   - a link re-reported while the sub-thread runs (a second window's `Linked`, a `Retitled`)
+//     must not flip it to Idle: `record_sub_thread_link` leaves status and `ended_at` alone;
+//   - wrongly split: the same sub-thread reported again, running, idle and retitled, stays ONE
+//     item;
+//   - then the benign shape of a fresh item.
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::SubThreadRecord;
+use gpui::TestAppContext;
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn sub_record(parent: &str, sub: &str, title: &str, at_ms: i64) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: sid(parent),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms,
+    }
+}
+
+async fn upsert(db: &AgentTaskHistoryDb, record: &SubThreadRecord, status: &str) {
+    db.upsert_sub_thread(record, status)
+        .await
+        .expect("upsert_sub_thread should succeed");
+}
+
+async fn link_item(db: &AgentTaskHistoryDb, record: &SubThreadRecord) {
+    db.record_sub_thread_link(record)
+        .await
+        .expect("record_sub_thread_link should succeed");
+}
+
+fn item<'a>(rows: &'a [HistoryEntry], parent: &str, sub: &str) -> Option<&'a HistoryEntry> {
+    find(rows, parent, &format!("{PREFIX}{sub}"))
+}
+
+fn items_of(rows: &[HistoryEntry], parent: &str) -> usize {
+    rows.iter()
+        .filter(|entry| {
+            entry.record.session_id.to_string() == parent && entry.origin == TaskOrigin::SubThread
+        })
+        .count()
+}
+
+// ── Wrongly collapse ───────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_two_sub_threads_of_one_parent_are_two_items(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_two").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "completed").await;
+    upsert(&db, &sub_record("p1", "sub-b", "Bravo", 2_000), "running").await;
+
+    let rows = load(&db).await;
+    assert_eq!(items_of(&rows, "p1"), 2, "one item per sub-thread");
+    let a = item(&rows, "p1", "sub-a").expect("sub-a is recorded");
+    let b = item(&rows, "p1", "sub-b").expect("sub-b is recorded");
+    assert_eq!(a.record.description.as_ref(), "Alpha");
+    assert_eq!(b.record.description.as_ref(), "Bravo");
+    assert_eq!(a.record.status, AgentTaskStatus::Completed);
+    assert_eq!(b.record.status, AgentTaskStatus::Running);
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_session_named_like_an_adapter_task_is_a_separate_item(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_like_task").await;
+    db.insert_started(&record("p1", "s-sub", AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+    upsert(&db, &sub_record("p1", "s-sub", "Side", 2_000), "completed").await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", "s-sub").expect("the adapter task is kept");
+    assert_eq!(task.origin, TaskOrigin::Adapter);
+    assert_eq!(task.record.description.as_ref(), "Task s-sub");
+    assert_eq!(task.record.status, AgentTaskStatus::Running);
+    let sub = item(&rows, "p1", "s-sub").expect("the sub-thread item is recorded beside it");
+    assert_eq!(sub.origin, TaskOrigin::SubThread);
+}
+
+// The derived key's third element: an adapter task already holding `zeo-sub-thread:<sub>`.
+#[gpui::test]
+async fn history_db_sub_thread_upsert_never_rewrites_an_adapter_row_on_its_key(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_third").await;
+    let squatter = format!("{PREFIX}s-sub");
+    db.insert_started(&record("p1", &squatter, AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+
+    // Whether the write is refused or ignored is the implementation's; the adapter row is not.
+    let _outcome = db
+        .upsert_sub_thread(&sub_record("p1", "s-sub", "Side", 2_000), "completed")
+        .await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", &squatter).expect("the adapter row is still there");
+    assert_eq!(task.origin, TaskOrigin::Adapter, "still an adapter task");
+    assert_eq!(task.record.kind.as_ref(), "shell", "its kind is kept");
+    assert_eq!(
+        task.record.description.as_ref(),
+        format!("Task {squatter}"),
+        "its description is not replaced by the sub-thread's title"
+    );
+    assert_eq!(
+        task.record.status,
+        AgentTaskStatus::Running,
+        "its status is not replaced by the sub-thread's"
+    );
+}
+
+// ── record_sub_thread_link: description only (R5.2, R5.3, R5.5) ────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_link_on_a_running_item_updates_only_the_description(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_running").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "running").await;
+
+    // A second window's reporter links it again, then the title changes.
+    link_item(&db, &sub_record("p1", "sub-a", "Alpha", 2_000)).await;
+    link_item(&db, &sub_record("p1", "sub-a", "Alpha renamed", 3_000)).await;
+
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 1, "still one item: {rows:?}");
+    let entry = item(&rows, "p1", "sub-a").expect("recorded");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Running,
+        "a re-reported link never flips a running sub-thread to Idle"
+    );
+    assert_eq!(entry.record.ended_at_ms, None, "nor gives it an end");
+    assert_eq!(entry.record.started_at_ms, 1_000, "nor moves its start");
+    assert_eq!(entry.record.description.as_ref(), "Alpha renamed");
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_link_never_rewrites_an_adapter_row_on_its_key(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_third").await;
+    let squatter = format!("{PREFIX}s-sub");
+    db.insert_started(&record("p1", &squatter, AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+
+    let _outcome = db
+        .record_sub_thread_link(&sub_record("p1", "s-sub", "Side", 2_000))
+        .await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", &squatter).expect("the adapter row is still there");
+    assert_eq!(task.origin, TaskOrigin::Adapter);
+    assert_eq!(task.record.kind.as_ref(), "shell");
+    assert_eq!(task.record.description.as_ref(), format!("Task {squatter}"));
+    assert_eq!(task.record.status, AgentTaskStatus::Running);
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_link_inserts_a_new_item_as_idle(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_new").await;
+    link_item(&db, &sub_record("p1", "sub-a", "Alpha", 1_000)).await;
+
+    let rows = load(&db).await;
+    let entry = item(&rows, "p1", "sub-a").expect("a new link is recorded");
+    assert_eq!(entry.origin, TaskOrigin::SubThread);
+    assert_eq!(entry.record.kind.as_ref(), "sub_thread");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Completed,
+        "stored as completed (Idle)"
+    );
+    assert_eq!(entry.record.description.as_ref(), "Alpha");
+}
+
+// ── Wrongly split (R5.2) ───────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_reported_again_stays_one_item(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_again").await;
+    let linked = sub_record("p1", "sub-a", "Alpha", 1_000);
+    upsert(&db, &linked, "completed").await;
+    // A restart, a second window: the same link reported again.
+    upsert(&db, &linked, "completed").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 2_000), "running").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 3_000), "completed").await;
+    // R5.5: a new title is the same item's new description.
+    upsert(
+        &db,
+        &sub_record("p1", "sub-a", "Alpha renamed", 4_000),
+        "completed",
+    )
+    .await;
+
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 1, "exactly one row: {rows:?}");
+    let only = item(&rows, "p1", "sub-a").expect("the item is recorded");
+    assert_eq!(only.record.description.as_ref(), "Alpha renamed");
+    assert_eq!(only.record.status, AgentTaskStatus::Completed);
+    assert!(
+        only.record.ended_at_ms.is_some(),
+        "an idle item carries when it stopped"
+    );
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_upsert_keeps_the_archive_flag(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_archived").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "completed").await;
+    db.set_archived(&[key("p1", &format!("{PREFIX}sub-a"))], true)
+        .await
+        .expect("set_archived should succeed");
+
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 2_000), "running").await;
+
+    let rows = load(&db).await;
+    assert!(
+        item(&rows, "p1", "sub-a").expect("recorded").archived,
+        "a re-report never unarchives the item"
+    );
+}
+
+// ── The item's shape (R5.1) ────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_item_is_grouped_under_the_parent_with_the_title(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_shape").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "running").await;
+
+    let rows = load(&db).await;
+    let entry = item(&rows, "p1", "sub-a").expect("recorded under the parent's session");
+    assert_eq!(entry.origin, TaskOrigin::SubThread);
+    assert_eq!(entry.record.kind.as_ref(), "sub_thread");
+    assert_eq!(entry.record.description.as_ref(), "Alpha");
+    assert_eq!(entry.record.project.as_ref(), "project");
+    assert_eq!(entry.record.started_at_ms, 1_000);
+    assert_eq!(entry.record.status, AgentTaskStatus::Running);
+    assert!(!entry.archived);
+    assert_eq!(entry.log_bytes, None, "a sub-thread item has no log");
+}
+
+// ── Failure (R5.8, Q4) ─────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_failed_write_names_both_sessions(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_failure").await;
+    drop_history_table(&db).await;
+
+    let error = db
+        .upsert_sub_thread(
+            &sub_record("p-fail", "sub-fail", "Secret title", 1_000),
+            "running",
+        )
+        .await
+        .expect_err("the table is gone");
+    let text = format!("{error:#}");
+    assert!(text.contains("p-fail"), "names the parent session: {text}");
+    assert!(
+        text.contains("sub-fail"),
+        "names the sub-thread session: {text}"
+    );
+    assert!(!text.contains("Secret title"), "never the title: {text}");
+}
diff --git a/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs b/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs
new file mode 100644
index 0000000..bcb4137
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs
@@ -0,0 +1,197 @@
+// Story 040, task 11.1 (migration half) — step 6 of `HISTORY_MIGRATIONS`, `deleted` (Q13; review
+// 3.x F1). Module path: `history_db::tombstone_step`. Wired in `src/history_db.rs`, after
+// `mod sub_thread_upsert;`, as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/tombstone_step_tests.rs"]
+//     mod tombstone_step;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- history_db` (names carry
+// `history_db_tombstone`). The tombstone's behaviour is in `tombstone_tests.rs`.
+//
+// Contract (design.md v4, "Tombstone (v4, review 3.x F1, R5.10)"; story.md Q13): step 6 (index 5)
+// is `sql!(ALTER TABLE agent_task_history ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;)`,
+// appended after the five shipped steps, which stay byte-identical — never folded into step 5,
+// which already ran in every database of tasks 3–7.
+//
+// Hostile half first: a database written by the five shipped steps, holding rows of both
+// origins, keeps every row and value through step 6, each live; then the step's own pin.
+
+use db::sqlez::{connection::Connection, domain::Domain};
+use db::sqlez_macros::sql;
+
+use crate::AgentTaskHistoryDb;
+
+// The five shipped steps, byte for byte (steps 1–4 as `origin_tests.rs` copies them, step 5 as
+// story 040's task 3.1 shipped it).
+const SHIPPED_STEP_0: &str = sql!(
+    CREATE TABLE IF NOT EXISTS agent_task_history(
+        session_id TEXT NOT NULL,
+        task_id TEXT NOT NULL,
+        thread_title TEXT,
+        project TEXT NOT NULL,
+        kind TEXT NOT NULL,
+        description TEXT NOT NULL,
+        background INTEGER NOT NULL,
+        status TEXT NOT NULL,
+        started_at INTEGER NOT NULL,
+        ended_at INTEGER,
+        tokens INTEGER,
+        tool_uses INTEGER,
+        archived INTEGER NOT NULL DEFAULT 0,
+        PRIMARY KEY(session_id, task_id)
+    ) STRICT;
+    CREATE INDEX IF NOT EXISTS agent_task_history_started ON agent_task_history(started_at);
+);
+const SHIPPED_STEP_1: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN label TEXT;);
+const SHIPPED_STEP_2: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN tool_call_id TEXT;);
+const SHIPPED_STEP_3: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN log_bytes INTEGER;);
+const SHIPPED_STEP_4: &str =
+    sql!(ALTER TABLE agent_task_history ADD COLUMN origin TEXT NOT NULL DEFAULT "adapter";);
+
+const TOMBSTONE_STEP: &str =
+    sql!(ALTER TABLE agent_task_history ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;);
+
+fn tombstone_migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+/// One fixed SQL statement of this test (sqlez, not a process).
+fn tombstone_sql_now(connection: &Connection, statement: &str) {
+    let mut run = connection.exec(statement).expect("statement prepares");
+    run().expect("statement runs");
+}
+
+// ── The step itself (Q13) ──────────────────────────────────────────────────
+
+#[test]
+fn history_db_tombstone_step_is_appended_after_the_five_shipped_steps() {
+    let steps = AgentTaskHistoryDb::MIGRATIONS;
+    assert!(
+        steps.len() >= 6,
+        "a sixth step exists: {} steps",
+        steps.len()
+    );
+    assert!(steps[0] == SHIPPED_STEP_0, "step 1 is never edited");
+    assert!(
+        steps[1] == SHIPPED_STEP_1,
+        "step 2 (story 022) is never edited"
+    );
+    assert!(
+        steps[2] == SHIPPED_STEP_2,
+        "step 3 (story 023) is never edited"
+    );
+    assert!(
+        steps[3] == SHIPPED_STEP_3,
+        "step 4 (story 041) is never edited"
+    );
+    assert!(
+        steps[4] == SHIPPED_STEP_4,
+        "step 5 (story 040, origin) is never edited, nor folded into step 6"
+    );
+    assert!(steps[5] == TOMBSTONE_STEP, "step 6 adds the deleted column");
+    assert_eq!(
+        steps.iter().filter(|step| **step == TOMBSTONE_STEP).count(),
+        1,
+        "appended exactly once"
+    );
+}
+
+// Hostile (Q13): a database written by the five shipped steps, holding adapter tasks and
+// sub-thread items, archived or not, opens with the new list and keeps every row and value, each
+// live (`deleted = 0`). A second open changes nothing more.
+#[test]
+fn history_db_tombstone_step_five_database_keeps_every_row_live() {
+    let connection = Connection::open_memory(Some("history_db_tombstone_step_five"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &[
+                SHIPPED_STEP_0,
+                SHIPPED_STEP_1,
+                SHIPPED_STEP_2,
+                SHIPPED_STEP_3,
+                SHIPPED_STEP_4,
+            ],
+            &mut |_, _, _| false,
+        )
+        .expect("the shipped steps apply");
+    for (session, task, kind, origin, archived, log_bytes) in [
+        ("p1", "t1", "shell", "adapter", 1, "4096"),
+        ("p1", "t2", "shell", "adapter", 0, "NULL"),
+        (
+            "p1",
+            "zeo-sub-thread:s-a",
+            "sub_thread",
+            "sub_thread",
+            1,
+            "NULL",
+        ),
+        (
+            "p1",
+            "zeo-sub-thread:s-b",
+            "sub_thread",
+            "sub_thread",
+            0,
+            "NULL",
+        ),
+    ] {
+        tombstone_sql_now(
+            &connection,
+            &format!(
+                "INSERT INTO agent_task_history \
+                 (session_id, task_id, thread_title, project, kind, description, background, \
+                  status, started_at, ended_at, archived, label, tool_call_id, log_bytes, origin) \
+                 VALUES ('{session}', '{task}', NULL, 'zeo', '{kind}', 'Kept {task}', 0, \
+                         'completed', 1000, 2000, {archived}, NULL, NULL, {log_bytes}, \
+                         '{origin}')"
+            ),
+        );
+    }
+
+    tombstone_migrate_all(&connection);
+    tombstone_migrate_all(&connection);
+
+    let columns = connection
+        .select::<String>("SELECT name FROM pragma_table_info('agent_task_history')")
+        .expect("select")()
+    .expect("run");
+    assert!(
+        columns.iter().any(|column| column == "deleted"),
+        "step 6 adds the deleted column: {columns:?}"
+    );
+    let rows = connection
+        .select::<(String, String, String, bool, Option<i64>, String, i64)>(
+            "SELECT session_id, task_id, description, archived, log_bytes, origin, deleted \
+             FROM agent_task_history ORDER BY session_id, task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows.len(),
+        4,
+        "every row survives, and none is added: {rows:?}"
+    );
+    let expected = [
+        ("t1", true, Some(4096), "adapter"),
+        ("t2", false, None, "adapter"),
+        ("zeo-sub-thread:s-a", true, None, "sub_thread"),
+        ("zeo-sub-thread:s-b", false, None, "sub_thread"),
+    ];
+    for ((session, task, description, archived, log_bytes, origin, deleted), want) in
+        rows.into_iter().zip(expected)
+    {
+        assert_eq!((session.as_str(), task.as_str()), ("p1", want.0));
+        assert_eq!(description, format!("Kept {task}"), "{task} keeps its text");
+        assert_eq!(archived, want.1, "{task} keeps its archive flag");
+        assert_eq!(log_bytes, want.2, "{task} keeps its log size");
+        assert_eq!(origin, want.3, "{task} keeps its origin");
+        assert_eq!(deleted, 0, "{task} is live, not a tombstone");
+    }
+}
diff --git a/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs b/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs
new file mode 100644
index 0000000..6eed9b2
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs
@@ -0,0 +1,427 @@
+// Story 040, task 11.1 (database half) — the tombstone of a deleted sub-thread item (R5.10,
+// R7.6; Q14; review 3.x F1). Module path: `history_db::tombstone`. Wired in `src/history_db.rs`,
+// after `mod sub_thread_upsert;`, as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/tombstone_tests.rs"]
+//     mod tombstone;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- history_db` (names carry
+// `history_db_tombstone`). Step 6 itself is pinned in `tombstone_step_tests.rs`.
+//
+// Contract (design.md v4, "Tombstone (v4, review 3.x F1, R5.10)"):
+//   - `AgentTaskHistoryDb::delete` keeps its contract — archived rows only, returns the indices it
+//     removed — but a row of origin `sub_thread` is kept with `deleted = 1`; an adapter row is
+//     still removed;
+//   - `load_all` skips `deleted = 1` rows; `AgentTaskHistoryDb::deleted_sub_thread_keys()` returns
+//     their keys;
+//   - `upsert_sub_thread` and `record_sub_thread_link` never rewrite nor revive a tombstone.
+// Assumed beyond design.md: `deleted_sub_thread_keys` is `async`, returns `anyhow::Result` of a
+// collection of `TaskKey` (`(SessionId, AgentTaskId)`) — adjust in `tombstones` only; a
+// tombstoned row counts among the indices `delete` returns, since it is deleted from the user's
+// view and `delete` "keeps its contract" (a sub-thread row has no log, so the log delete the
+// store runs for it is a no-op).
+//
+// Hostile halves first, for "a deleted item is the SAME item when it is reported again":
+//   - wrongly split (the revival): the same sub-thread linked, run and idled again after its
+//     delete stays deleted, and its row is never rewritten;
+//   - wrongly collapse: tombstoning one sub-thread hides neither its sibling under the same
+//     parent, nor the same sub session under another parent, nor an adapter task of the parent
+//     whose id is the sub session — the third element against the derived key
+//     `zeo-sub-thread:<sub>`;
+//   - the origin alone decides: an adapter row dressed as a sub-thread (kind `sub_thread`, the
+//     prefix) is removed, a stored sub-thread row with plain kind and id is tombstoned;
+//   - the guard is not over-broad: a live item of the same parent is still refreshed, and a new
+//     one still inserted, after a sibling's tombstone;
+//   - then the benign shapes (a non-archived item is not deleted; an archived adapter row goes).
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::SubThreadRecord;
+use gpui::TestAppContext;
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn tombstone_sub_record(parent: &str, sub: &str, title: &str, at_ms: i64) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: sid(parent),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms,
+    }
+}
+
+fn sub_key(parent: &str, sub: &str) -> Key {
+    key(parent, &format!("{PREFIX}{sub}"))
+}
+
+async fn tombstone_upsert(db: &AgentTaskHistoryDb, record: &SubThreadRecord, status: &str) {
+    db.upsert_sub_thread(record, status)
+        .await
+        .expect("upsert_sub_thread should succeed");
+}
+
+async fn tombstone_link(db: &AgentTaskHistoryDb, record: &SubThreadRecord) {
+    db.record_sub_thread_link(record)
+        .await
+        .expect("record_sub_thread_link should succeed");
+}
+
+/// An archived, idle sub-thread item, ready to be deleted.
+async fn archived_item(db: &AgentTaskHistoryDb, parent: &str, sub: &str, title: &str, at: i64) {
+    tombstone_upsert(
+        db,
+        &tombstone_sub_record(parent, sub, title, at),
+        "completed",
+    )
+    .await;
+    db.set_archived(&[sub_key(parent, sub)], true)
+        .await
+        .expect("set_archived should succeed");
+}
+
+/// An archived, completed adapter task.
+async fn archived_task(db: &AgentTaskHistoryDb, task: &agent_ui::TaskRecord) {
+    db.insert_started(task)
+        .await
+        .expect("insert_started should succeed");
+    db.set_archived(&[(task.session_id.clone(), task.task_id.clone())], true)
+        .await
+        .expect("set_archived should succeed");
+}
+
+/// `deleted_sub_thread_keys`, as sorted `(session, task)` text pairs.
+async fn tombstones(db: &AgentTaskHistoryDb) -> Vec<(String, String)> {
+    let mut keys: Vec<(String, String)> = db
+        .deleted_sub_thread_keys()
+        .await
+        .expect("deleted_sub_thread_keys should succeed")
+        .into_iter()
+        .map(|(session_id, task_id)| (session_id.to_string(), task_id.to_string()))
+        .collect();
+    keys.sort();
+    keys
+}
+
+fn pair(session: &str, task: &str) -> (String, String) {
+    (session.to_string(), task.to_string())
+}
+
+fn sub_pair(parent: &str, sub: &str) -> (String, String) {
+    pair(parent, &format!("{PREFIX}{sub}"))
+}
+
+/// How many rows the table physically holds for `(session, task)`, hidden or not. Reads no
+/// column story 040 adds, so it answers on any schema.
+fn rows_on_key(db: &AgentTaskHistoryDb, session: &str, task: &str) -> usize {
+    db.select::<(String, String)>("SELECT session_id, task_id FROM agent_task_history")
+        .expect("select prepares")()
+    .expect("select runs")
+    .into_iter()
+    .filter(|(s, t)| s == session && t == task)
+    .count()
+}
+
+/// The stored `(description, status, deleted)` of one row. Reads the step-6 column: call it only
+/// after an assertion that fails without that step.
+fn stored_row(db: &AgentTaskHistoryDb, session: &str, task: &str) -> (String, String, i64) {
+    let rows = db
+        .select::<(String, String, String, String, i64)>(
+            "SELECT session_id, task_id, description, status, deleted FROM agent_task_history",
+        )
+        .expect("select prepares")()
+    .expect("select runs");
+    rows.into_iter()
+        .find(|(s, t, ..)| s == session && t == task)
+        .map(|(_, _, description, status, deleted)| (description, status, deleted))
+        .unwrap_or_else(|| panic!("{session}/{task} has a row"))
+}
+
+fn listed(rows: &[HistoryEntry], session: &str, task: &str) -> bool {
+    find(rows, session, task).is_some()
+}
+
+// ── Wrongly split: the revival (R5.10, Q14) ────────────────────────────────
+
+// The replay of the next start reports every link again, then the sub-thread may run: none of it
+// brings the deleted item back, and the tombstone row itself is never rewritten.
+#[gpui::test]
+async fn history_db_tombstone_no_sub_thread_write_revives_a_deleted_item(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_no_revival").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    db.delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha relinked", 2_000),
+    )
+    .await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha running", 3_000),
+        "running",
+    )
+    .await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha idle", 4_000),
+        "completed",
+    )
+    .await;
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha retitled", 5_000),
+    )
+    .await;
+
+    let rows = load(&db).await;
+    assert!(
+        !listed(&rows, "p1", &format!("{PREFIX}sub-a")),
+        "a deleted item is never listed again: {rows:?}"
+    );
+    assert_eq!(
+        tombstones(&db).await,
+        vec![sub_pair("p1", "sub-a")],
+        "the item is still a tombstone"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", &format!("{PREFIX}sub-a")),
+        1,
+        "one row on the key: no second row"
+    );
+    let (description, status, deleted) = stored_row(&db, "p1", &format!("{PREFIX}sub-a"));
+    assert_eq!(deleted, 1, "still deleted");
+    assert_eq!(
+        description, "Alpha",
+        "the tombstone's description is never rewritten"
+    );
+    assert_eq!(
+        status, "completed",
+        "the tombstone's status is never rewritten"
+    );
+}
+
+// ── Wrongly collapse ───────────────────────────────────────────────────────
+
+// One sub-thread's tombstone hides only that item: not its sibling under the same parent, not the
+// same sub session recorded under another parent, and not an adapter task of the parent whose id
+// is the sub session (the derived key's third element).
+#[gpui::test]
+async fn history_db_tombstone_hides_only_the_deleted_item(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_only_that_item").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    archived_item(&db, "p1", "sub-b", "Bravo", 1_100).await;
+    archived_item(&db, "p2", "sub-a", "Alpha elsewhere", 1_200).await;
+    archived_task(
+        &db,
+        &record("p1", "sub-a", AgentTaskStatus::Completed, 1_300),
+    )
+    .await;
+    db.insert_started(&record("p1", "t-live", AgentTaskStatus::Running, 1_400))
+        .await
+        .expect("insert_started should succeed");
+
+    let removed = db
+        .delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    assert_eq!(
+        tombstones(&db).await,
+        vec![sub_pair("p1", "sub-a")],
+        "exactly the deleted item is a tombstone"
+    );
+    assert_eq!(
+        removed,
+        vec![0],
+        "the tombstoned item is reported as deleted"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", &format!("{PREFIX}sub-a")),
+        1,
+        "the deleted sub-thread row is kept, hidden"
+    );
+    let rows = load(&db).await;
+    assert!(
+        !listed(&rows, "p1", &format!("{PREFIX}sub-a")),
+        "the deleted item is hidden"
+    );
+    assert!(
+        listed(&rows, "p1", &format!("{PREFIX}sub-b")),
+        "its sibling is still listed"
+    );
+    assert!(
+        listed(&rows, "p2", &format!("{PREFIX}sub-a")),
+        "the same sub session under another parent is still listed"
+    );
+    assert!(
+        listed(&rows, "p1", "sub-a"),
+        "an adapter task whose id is the sub session is still listed"
+    );
+    assert!(
+        listed(&rows, "p1", "t-live"),
+        "the parent's live task is still listed"
+    );
+    assert_eq!(
+        stored_row(&db, "p1", &format!("{PREFIX}sub-a")).2,
+        1,
+        "deleted = 1"
+    );
+    assert_eq!(
+        stored_row(&db, "p1", &format!("{PREFIX}sub-b")).2,
+        0,
+        "sibling deleted = 0"
+    );
+}
+
+// ── The origin alone decides (R5.7) ────────────────────────────────────────
+
+// Wrong split: a row stored as a sub-thread item, with nothing else about it looking like one,
+// is tombstoned, not removed.
+#[gpui::test]
+async fn history_db_tombstone_stored_sub_thread_with_plain_kind_and_id_is_tombstoned(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_plain_sub_thread").await;
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at, \
+          archived, origin) \
+         VALUES ('p1', 'plain-id', 'zeo', 'shell', 'Looks adapter', 0, 'completed', 1000, 1, \
+                 'sub_thread')",
+    )
+    .await;
+
+    db.delete(&[key("p1", "plain-id")])
+        .await
+        .expect("delete should succeed");
+
+    assert_eq!(
+        tombstones(&db).await,
+        vec![pair("p1", "plain-id")],
+        "the stored origin, not the kind or the id, makes it a sub-thread tombstone"
+    );
+    assert_eq!(rows_on_key(&db, "p1", "plain-id"), 1, "the row is kept");
+    assert!(!listed(&load(&db).await, "p1", "plain-id"), "and hidden");
+}
+
+// Wrong collapse: adapter rows — a plain one and one dressed as a sub-thread — are still removed
+// outright, and never reported as tombstones (the shipped behaviour, kept).
+#[gpui::test]
+async fn history_db_tombstone_archived_adapter_rows_are_still_removed(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_adapter_removed").await;
+    archived_task(&db, &record("p1", "t1", AgentTaskStatus::Completed, 1_000)).await;
+    let mut dressed = record("p1", "zeo-sub-thread:s9", AgentTaskStatus::Completed, 1_100);
+    dressed.kind = "sub_thread".into();
+    archived_task(&db, &dressed).await;
+    assert_eq!(
+        find(&load(&db).await, "p1", "zeo-sub-thread:s9").map(|entry| entry.origin),
+        Some(TaskOrigin::Adapter),
+        "precondition: the dressed row is an adapter row"
+    );
+
+    let removed = db
+        .delete(&[key("p1", "t1"), key("p1", "zeo-sub-thread:s9")])
+        .await
+        .expect("delete should succeed");
+
+    assert_eq!(
+        removed,
+        vec![0, 1],
+        "both archived adapter rows are deleted"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", "t1"),
+        0,
+        "the adapter row is removed"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", "zeo-sub-thread:s9"),
+        0,
+        "the adapter row dressed as a sub-thread is removed, not kept"
+    );
+    assert!(
+        tombstones(&db).await.is_empty(),
+        "an adapter row is never a tombstone"
+    );
+}
+
+// ── The guard is not over-broad ────────────────────────────────────────────
+
+// After a sibling's tombstone, a live item of the same parent is still refreshed by both writes,
+// and a new sub-thread of that parent is still recorded.
+#[gpui::test]
+async fn history_db_tombstone_live_items_of_the_parent_still_take_writes(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_live_writes").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo", 1_100),
+        "completed",
+    )
+    .await;
+    db.delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo", 2_000),
+        "running",
+    )
+    .await;
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo renamed", 2_100),
+    )
+    .await;
+    tombstone_link(&db, &tombstone_sub_record("p1", "sub-c", "Charlie", 2_200)).await;
+
+    let rows = load(&db).await;
+    let bravo = find(&rows, "p1", &format!("{PREFIX}sub-b")).expect("the live item is listed");
+    assert_eq!(
+        bravo.record.status,
+        AgentTaskStatus::Running,
+        "the upsert refreshed it"
+    );
+    assert_eq!(
+        bravo.record.description.as_ref(),
+        "Bravo renamed",
+        "the link write refreshed it"
+    );
+    let charlie = find(&rows, "p1", &format!("{PREFIX}sub-c")).expect("a new item is recorded");
+    assert_eq!(charlie.origin, TaskOrigin::SubThread);
+}
+
+// ── Benign ─────────────────────────────────────────────────────────────────
+
+// The archived-only rule is kept: an item that is not archived is neither deleted nor tombstoned.
+#[gpui::test]
+async fn history_db_tombstone_unarchived_item_is_not_deleted(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_unarchived").await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha", 1_000),
+        "completed",
+    )
+    .await;
+
+    let removed = db
+        .delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    assert!(removed.is_empty(), "nothing is reported deleted");
+    assert!(
+        listed(&load(&db).await, "p1", &format!("{PREFIX}sub-a")),
+        "the item is still listed"
+    );
+    assert!(tombstones(&db).await.is_empty(), "and is no tombstone");
+}
