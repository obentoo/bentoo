+// Story 040, task 3.1 — migration step 5 and the origin of a history item (R5.6, R5.7; Q13).
+// Module path: `history_db::origin`. Wired in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/origin_tests.rs"]
+//     mod origin;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- history_db` (names carry
+// `history_db_origin`).
+//
+// Contract (design.md §TaskHistoryStore and AgentTaskHistoryDb):
+//   - step 5 of `HISTORY_MIGRATIONS` (index 4) is
+//     `sql!(ALTER TABLE agent_task_history ADD COLUMN origin TEXT NOT NULL DEFAULT "adapter";)`,
+//     appended after the four shipped steps, which stay byte-identical. The default is
+//     double-quoted: `'adapter'` inside `sql!` is a malformed Rust char literal (Phase 3 finding,
+//     adopted by design.md 2026-10-20);
+//   - `pub enum TaskOrigin { Adapter, SubThread }`, stored as `'adapter'` / `'sub_thread'`;
+//   - `HistoryEntry::origin: TaskOrigin`, read by `load_all`;
+//   - `insert_started` writes no origin, so an adapter row takes the column default.
+// Assumed beyond design.md: `TaskOrigin` derives `Debug`, `Clone`, `Copy`, `PartialEq` and is
+// reachable as `crate::history_db::TaskOrigin` (re-exported at the crate root or not).
+//
+// Unknown origin text: `load_all` skips the row with a warning carrying its ids, as the shipped
+// code does for an unknown status, and keeps the rest of the history (design.md, 2026-10-20).
+//
+// Hostile halves first, for "the stored origin alone decides" (R5.7):
+//   - wrongly collapse: an ADAPTER task whose kind is `sub_thread` and whose id carries the
+//     `zeo-sub-thread:` prefix must stay `Adapter`;
+//   - wrongly split: a row stored with origin `sub_thread` but an adapter-looking kind and id
+//     must read `SubThread`;
+//   - then the benign fresh adapter record.
+
+use acp_thread::AgentTaskStatus;
+use db::sqlez::{connection::Connection, domain::Domain};
+use db::sqlez_macros::sql;
+use gpui::TestAppContext;
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+/// Step 1 exactly as patch 0035 shipped it (the copy story 041's test carries).
+const SHIPPED_STEP_0: &str = sql!(
+    CREATE TABLE IF NOT EXISTS agent_task_history(
+        session_id TEXT NOT NULL,
+        task_id TEXT NOT NULL,
+        thread_title TEXT,
+        project TEXT NOT NULL,
+        kind TEXT NOT NULL,
+        description TEXT NOT NULL,
+        background INTEGER NOT NULL,
+        status TEXT NOT NULL,
+        started_at INTEGER NOT NULL,
+        ended_at INTEGER,
+        tokens INTEGER,
+        tool_uses INTEGER,
+        archived INTEGER NOT NULL DEFAULT 0,
+        PRIMARY KEY(session_id, task_id)
+    ) STRICT;
+    CREATE INDEX IF NOT EXISTS agent_task_history_started ON agent_task_history(started_at);
+);
+const SHIPPED_STEP_1: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN label TEXT;);
+const SHIPPED_STEP_2: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN tool_call_id TEXT;);
+const SHIPPED_STEP_3: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN log_bytes INTEGER;);
+
+const ORIGIN_STEP: &str =
+    sql!(ALTER TABLE agent_task_history ADD COLUMN origin TEXT NOT NULL DEFAULT "adapter";);
+
+fn migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+/// One fixed SQL statement of this test (sqlez, not a process).
+fn run_sql_now(connection: &Connection, statement: &str) {
+    let mut run = connection.exec(statement).expect("statement prepares");
+    run().expect("statement runs");
+}
+
+fn origin_of(rows: &[HistoryEntry], session: &str, task: &str) -> TaskOrigin {
+    find(rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+        .origin
+}
+
+// ── The step itself (Q13) ──────────────────────────────────────────────────
+
+#[test]
+fn history_db_origin_step_is_appended_after_the_four_shipped_steps() {
+    let steps = AgentTaskHistoryDb::MIGRATIONS;
+    assert!(
+        steps.len() >= 5,
+        "a fifth step exists: {} steps",
+        steps.len()
+    );
+    assert!(steps[0] == SHIPPED_STEP_0, "step 1 is never edited");
+    assert!(
+        steps[1] == SHIPPED_STEP_1,
+        "step 2 (story 022) is never edited"
+    );
+    assert!(
+        steps[2] == SHIPPED_STEP_2,
+        "step 3 (story 023) is never edited"
+    );
+    assert!(
+        steps[3] == SHIPPED_STEP_3,
+        "step 4 (story 041) is never edited"
+    );
+    assert!(steps[4] == ORIGIN_STEP, "step 5 adds the origin column");
+    assert_eq!(
+        steps.iter().filter(|step| **step == ORIGIN_STEP).count(),
+        1,
+        "appended exactly once"
+    );
+}
+
+// Hostile (Q13, R5.6): a database written by the shipped steps 1–4, holding records with labels,
+// tool calls, logs and archive flags, opens with the new list and keeps every record and value,
+// each of origin "adapter"; no sub-thread item appears.
+#[test]
+fn history_db_origin_step_four_database_keeps_every_record_as_adapter() {
