+mod replay_tests;
diff --git a/crates/agent_ui/src/sub_thread_reporter/replay_tests.rs b/crates/agent_ui/src/sub_thread_reporter/replay_tests.rs
new file mode 100644
index 0000000..7e874a8
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_reporter/replay_tests.rs
@@ -0,0 +1,88 @@
+// Story 040, task 2.1 — the tech review's two reachable gaps: a link older than the history's
+// subscription is heard through `replay_sub_thread_activity`, and a sub-thread already mid-turn
+// when its link lands is reported Running after its `Linked`.
+
+use std::{cell::RefCell, rc::Rc};
+
+use acp_thread::ThreadStatus;
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::TestAppContext;
+
+use crate::SubThreadActivity;
+use crate::sub_thread_test_support::*;
+
+fn kinds_of(heard: &Rc<RefCell<Vec<SubThreadActivity>>>) -> Vec<(&'static str, String)> {
+    heard
+        .borrow()
+        .iter()
+        .map(|activity| match activity {
+            SubThreadActivity::Linked(record) => ("linked", record.sub_session.to_string()),
+            SubThreadActivity::Running(record) => ("running", record.sub_session.to_string()),
+            SubThreadActivity::Idle(record) => ("idle", record.sub_session.to_string()),
+            SubThreadActivity::Retitled(record) => ("retitled", record.sub_session.to_string()),
+        })
+        .collect()
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_replay_reaches_a_late_subscriber(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    // Subscribed after the card already reported the link, as `register_card` is in production.
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+    assert!(
+        kinds_of(&heard).is_empty(),
+        "precondition: nothing heard yet"
+    );
+
+    card(&rig).update(&mut rig.cx, |card, cx| card.replay_sub_thread_activity(cx));
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        kinds_of(&heard),
+        vec![("linked", child.session.to_string())],
+        "the replay reports the existing link, and no status for an idle sub-thread"
+    );
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_link_during_a_turn_reports_running(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    let finish = rig.connection.defer_next_prompt_response();
+    set_composer(&child.view, "a side question", &mut rig.cx);
+    child
+        .view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    assert_eq!(
+        child.thread.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Generating,
+        "precondition: the thread is generating before it is linked"
+    );
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+
+    let sub = child.session.to_string();
+    assert_eq!(
+        kinds_of(&heard),
+        vec![("linked", sub.clone()), ("running", sub.clone())],
+        "Linked, then Running for the turn already under way"
+    );
+
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+        .expect("the turn is still waiting");
+    rig.cx.run_until_parked();
+    assert_eq!(
+        kinds_of(&heard).last(),
+        Some(&("idle", sub)),
+        "Idle once the turn ends"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_reporter/reporter_tests.rs b/crates/agent_ui/src/sub_thread_reporter/reporter_tests.rs
new file mode 100644
index 0000000..8f7a0c5
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_reporter/reporter_tests.rs
@@ -0,0 +1,326 @@
+// Story 040, task 2.1 — `SubThreadReporter`: the card reports every parent link and every status
+// and title change of a sub-thread as `SubThreadActivity` (R5.1, R5.2, R5.3, R5.5, R5.9; Q5).
+// Module path: `sub_thread_reporter::reporter_tests`. Wired in `src/sub_thread_reporter.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_reporter/reporter_tests.rs"]
+//     mod reporter_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- sub_thread_reporter`. Fixtures:
+// `crate::sub_thread_test_support` (materialized with this task).
+//
+// Contract (design.md §SubThreadReporter):
+//   - `pub enum SubThreadActivity { Linked, Running, Idle, Retitled }(SubThreadRecord)`;
+//     `pub struct SubThreadRecord { parent_session, sub_session, title, project, at_ms }`;
+//     `impl EventEmitter<SubThreadActivity> for TasksCard`; both re-exported from `agent_ui`;
+//   - the reporter, owned by the card, observes `ThreadOrganizationStore` (skipped silently when
+//     `try_global` is `None`) and emits `Linked` once per link, and every existing link at
+//     creation; ids, title and project come from `ThreadMetadataStore`; a link whose parent or
+//     child has no session is skipped;
+//   - for a held root thread that is a sub-thread: `StatusChanged` → `Running`/`Idle` from
+//     `status()`, `TitleUpdated` → `Retitled`; a repeat of the last state is suppressed.
+// Assumed beyond design.md: `SubThreadActivity` and `SubThreadRecord` derive `Clone` and `Debug`;
+// `SubThreadRecord`'s fields are `pub` (agent_tasks_panel reads them).
+//
+// "Existing links at creation" is asserted through a subscriber registered right after the card
+// is built, which is how `TaskHistoryStore::register_card` hears a card: an emission made inside
+// `TasksCard::new` reaches nobody.
+//
+// Hostile halves first:
+//   - wrongly collapse: two sub-threads of one parent are two `Linked`, each with its own
+//     sub-thread session; the parent and an unlinked thread generating are NOT sub-threads;
+//   - wrongly split: one link is one `Linked`, however many times the store notifies; one turn is
+//     one `Running` and one `Idle`;
+//   - a dangling link (parent deleted) is never reported with a made-up parent;
+//   - then the benign record shape and the title.
+
+use std::{cell::RefCell, rc::Rc};
+
+use acp_thread::ThreadStatus;
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::{AppContext as _, TestAppContext};
+
+use crate::sub_thread_test_support::*;
+use crate::thread_organization::ThreadOrganizationStore;
+use crate::{SubThreadActivity, SubThreadRecord, TasksCard};
+
+fn kind(activity: &SubThreadActivity) -> &'static str {
+    match activity {
+        SubThreadActivity::Linked(_) => "linked",
+        SubThreadActivity::Running(_) => "running",
+        SubThreadActivity::Idle(_) => "idle",
+        SubThreadActivity::Retitled(_) => "retitled",
+    }
+}
+
+fn record(activity: &SubThreadActivity) -> &SubThreadRecord {
+    match activity {
+        SubThreadActivity::Linked(record)
+        | SubThreadActivity::Running(record)
+        | SubThreadActivity::Idle(record)
+        | SubThreadActivity::Retitled(record) => record,
+    }
+}
+
+/// `(kind, parent session, sub-thread session)` of every activity heard.
+fn summary(heard: &Rc<RefCell<Vec<SubThreadActivity>>>) -> Vec<(&'static str, String, String)> {
+    heard
+        .borrow()
+        .iter()
+        .map(|activity| {
+            let record = record(activity);
+            (
+                kind(activity),
+                record.parent_session.to_string(),
+                record.sub_session.to_string(),
+            )
+        })
+        .collect()
+}
+
+fn of_kind(heard: &Rc<RefCell<Vec<SubThreadActivity>>>, wanted: &str) -> Vec<(String, String)> {
+    summary(heard)
+        .into_iter()
+        .filter(|(kind, _, _)| *kind == wanted)
+        .map(|(_, parent, sub)| (parent, sub))
+        .collect()
+}
+
+// ── Wrongly collapse ───────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn sub_thread_reporter_two_sub_threads_of_one_parent_are_two_links(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let first = open_conversation(&mut rig, "First", "first answer");
+    let second = open_conversation(&mut rig, "Second", "second answer");
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    link(first.thread_id, parent.thread_id, &mut rig.cx);
+    link(second.thread_id, parent.thread_id, &mut rig.cx);
+
+    let mut linked = of_kind(&heard, "linked");
+    linked.sort();
+    let mut expected = vec![
+        (parent.session.to_string(), first.session.to_string()),
+        (parent.session.to_string(), second.session.to_string()),
+    ];
+    expected.sort();
+    assert_eq!(linked, expected, "one Linked per sub-thread, each its own");
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_parent_and_unlinked_threads_report_no_status(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let lone = open_conversation(&mut rig, "Lone", "lone answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    send_text(&mut rig, &parent.view, "parent again", "ok");
+    send_text(&mut rig, &lone.view, "lone again", "ok");
+
+    let statuses: Vec<_> = summary(&heard)
+        .into_iter()
+        .filter(|(kind, _, _)| *kind == "running" || *kind == "idle")
+        .collect();
+    assert!(
+        statuses.is_empty(),
+        "neither a parent nor an unlinked thread is a sub-thread: {statuses:?}"
+    );
+}
+
+// ── Wrongly split ──────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn sub_thread_reporter_one_link_is_one_linked_across_notifies(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    for _ in 0..3 {
+        rig.cx
+            .update(|_, cx| ThreadOrganizationStore::global(cx).update(cx, |_, cx| cx.notify()));
+        rig.cx.run_until_parked();
+    }
+
+    assert_eq!(
+        of_kind(&heard, "linked"),
+        vec![(parent.session.to_string(), child.session.to_string())],
+        "reported once"
+    );
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_one_turn_is_one_running_then_one_idle(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    let finish = rig.connection.defer_next_prompt_response();
+    set_composer(&child.view, "a side question", &mut rig.cx);
+    child
+        .view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    assert_eq!(
+        child.thread.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Generating,
+        "precondition: the sub-thread is generating"
+    );
+    let pair = (parent.session.to_string(), child.session.to_string());
+    assert_eq!(
+        of_kind(&heard, "running"),
+        vec![pair.clone()],
+        "Running once"
+    );
+    assert!(
+        of_kind(&heard, "idle").is_empty(),
+        "not Idle while generating"
+    );
+
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+        .expect("the turn is still waiting");
+    rig.cx.run_until_parked();
+
+    assert_eq!(of_kind(&heard, "running"), vec![pair.clone()], "still once");
+    assert_eq!(
+        of_kind(&heard, "idle"),
+        vec![pair],
+        "Idle once the turn ends"
+    );
+}
+
+// ── Links that cannot be reported ──────────────────────────────────────────
+
+#[gpui::test]
+async fn sub_thread_reporter_dangling_link_is_not_reported(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    delete_thread(parent.thread_id, &mut rig.cx);
+
+    // A card built after the parent is gone reads the dangling link at creation.
+    let fresh = rig.cx.update(|_, cx| cx.new(|cx| TasksCard::new(cx)));
+    let (heard, _subscription) = record_activity(&fresh, &mut rig.cx);
+    rig.cx.run_until_parked();
+
+    let about_child: Vec<_> = summary(&heard)
+        .into_iter()
+        .filter(|(_, _, sub)| *sub == child.session.to_string())
+        .collect();
+    assert!(
+        about_child.is_empty(),
+        "no item is made up for a link whose parent has no session: {about_child:?}"
+    );
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_without_the_organization_store_reports_nothing(
+    cx: &mut TestAppContext,
+) {
+    init_without_organization(cx);
+    let mut rig = rig(cx).await;
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+    let only = open_conversation(&mut rig, "Only", "an answer");
+    send_text(&mut rig, &only.view, "again", "ok");
+
+    assert!(
+        summary(&heard).is_empty(),
+        "nothing to report, and no panic"
+    );
+}
+
+// ── Benign: existing links, the record, the title ──────────────────────────
+
+#[gpui::test]
+async fn sub_thread_reporter_reports_existing_links_at_creation(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+
+    // A link made before this card existed (another window, or before this story shipped).
+    let fresh = rig.cx.update(|_, cx| cx.new(|cx| TasksCard::new(cx)));
+    let (heard, _subscription) = record_activity(&fresh, &mut rig.cx);
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        of_kind(&heard, "linked"),
+        vec![(parent.session.to_string(), child.session.to_string())],
+        "the existing link is reported once, to a subscriber registered after creation"
+    );
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_linked_record_carries_the_sub_thread_title_and_project(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+
+    let heard = heard.borrow();
+    let linked = heard
+        .iter()
+        .find_map(|activity| match activity {
+            SubThreadActivity::Linked(record) => Some(record.clone()),
+            _ => None,
+        })
+        .expect("the link is reported");
+    assert_eq!(linked.parent_session, parent.session);
+    assert_eq!(linked.sub_session, child.session);
+    assert_eq!(
+        linked.title.as_ref(),
+        "Child",
+        "the sub-thread's title, not the parent's"
+    );
+    assert_eq!(linked.project.as_ref(), "project");
+    assert!(linked.at_ms > 0, "stamped with the time it was heard");
+}
+
+#[gpui::test]
+async fn sub_thread_reporter_retitle_of_a_sub_thread_is_reported(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let (heard, _subscription) = record_activity(&card(&rig), &mut rig.cx);
+
+    // The parent's own title change is no sub-thread's.
+    set_title(&parent.thread, "Parent renamed", &mut rig.cx);
+    set_title(&child.thread, "Child renamed", &mut rig.cx);
+
+    let retitled: Vec<(String, String)> = heard
+        .borrow()
+        .iter()
+        .filter_map(|activity| match activity {
+            SubThreadActivity::Retitled(record) => {
+                Some((record.sub_session.to_string(), record.title.to_string()))
+            }
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        retitled,
+        vec![(child.session.to_string(), "Child renamed".to_string())]
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_send.rs b/crates/agent_ui/src/sub_thread_send.rs
new file mode 100644
index 0000000..772ef58
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send.rs
@@ -0,0 +1,247 @@
+//! Story 040 — Send to Parent (design.md, SendToParentControl): a sub-thread's last reply, or a
+//! summary it is asked for, appended to its parent's composer and never sent.
+
+use acp_thread::{AcpThread, AgentThreadEntry, ThreadStatus};
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{App, SharedString};
+
+use crate::conversation_view::ThreadView;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::ThreadOrganizationStore;
+
+/// The request Summarize and Send submits as a visible turn of the sub-thread (R3.1).
+pub(crate) const SUMMARY_REQUEST: &str = "Summarize this sub-thread for its parent thread: \
+the question it explored, what was found, and any decision or open item. \
+Reply with the summary only.";
+
+/// The reply is cut here, in characters, so one giant reply cannot stall the parent's editor
+/// (R4.5); the header is never cut and does not count.
+const REPLY_CAP_CHARS: usize = 200_000;
+
+const DELETED_TOOLTIP: &str = "The parent thread was deleted";
+/// 039's wording for the same wait, so the two features read as one (story v2).
+const WAIT_TOOLTIP: &str = "Wait for the turn to end";
+const NO_REPLY_TOOLTIP: &str = "No reply to send yet";
+const DELIVERING_TOOLTIP: &str = "Sending to the parent thread";
+
+#[derive(Default)]
+pub(crate) struct SendToParentState {
+    pub(crate) pending_summary: Option<PendingSummary>,
+    pub(crate) notice: Option<SharedString>,
+    /// A Send Last Reply still reaching its parent: a second pick would open the parent twice
+    /// while the router waits for a new window (R2.6, review 7.x L2).
+    pub(crate) delivering: bool,
+}
+
+/// A Summarize and Send waiting for its turn: only a `Stopped` of the turn whose latest user
+/// message is this request delivers (R3.6, R3.7).
+#[derive(Default)]
+pub(crate) struct PendingSummary {
+    /// No earlier turn's `Stopped` is the summary's.
+    pub(crate) activity_generation: u64,
+    /// The request's entry is at or after this index. On the reported-activity transport the
+    /// generation moves when the agent reports activity, so a turn the agent starts on its own
+    /// can take the generation above; the entry is what names the summary's turn (review 7.x M4).
+    pub(crate) entries_before: usize,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum ParentLink {
+    /// Not a sub-thread, or no organization store: the control is not drawn (R1.2).
+    None,
+    Live {
+        parent: ThreadId,
+        parent_session: acp_v2::SessionId,
+    },
+    /// Linked to a parent that has no metadata row, or one with no session (R4.4).
+    Deleted,
+}
+
+/// Each choice enabled, or disabled with the tooltip that says why (R1.4, R1.5).
+pub(crate) struct Availability {
+    pub(crate) last_reply: Result<(), SharedString>,
+    pub(crate) summarize: Result<(), SharedString>,
+}
+
+pub(crate) fn parent_link(thread_id: ThreadId, cx: &App) -> ParentLink {
+    let Some(organization) = ThreadOrganizationStore::try_global(cx) else {
+        return ParentLink::None;
+    };
+    let Some((parent, _)) = organization.read(cx).parent(thread_id) else {
+        return ParentLink::None;
+    };
+    let parent_session = ThreadMetadataStore::try_global(cx).and_then(|store| {
+        store
+            .read(cx)
+            .entry(parent)
+            .and_then(|entry| entry.session_id.clone())
+    });
+    match parent_session {
+        Some(parent_session) => ParentLink::Live {
+            parent,
+            parent_session,
+        },
+        None => ParentLink::Deleted,
+    }
+}
+
+/// Pure: reads the link, the thread and the state, and changes nothing. The checks run in the
+/// order design.md fixes, so the most lasting reason is the one shown.
+pub(crate) fn availability(
+    link: &ParentLink,
+    thread: &AcpThread,
+    state: &SendToParentState,
+) -> Availability {
+    let blocked: Option<&'static str> = if *link == ParentLink::Deleted {
+        Some(DELETED_TOOLTIP)
+    } else if state.delivering {
+        Some(DELIVERING_TOOLTIP)
+    } else if thread.status() == ThreadStatus::Generating || state.pending_summary.is_some() {
+        Some(WAIT_TOOLTIP)
+    } else {
+        None
+    };
+    if let Some(reason) = blocked {
+        return Availability {
+            last_reply: Err(reason.into()),
+            summarize: Err(reason.into()),
+        };
+    }
+    let has_reply = thread
+        .entries()
+        .iter()
+        .any(|entry| matches!(entry, AgentThreadEntry::AssistantMessage(_)));
+    Availability {
+        last_reply: if has_reply {
+            Ok(())
+        } else {
+            Err(NO_REPLY_TOOLTIP.into())
+        },
+        // A turn from before the load may still be running: its end would be taken for the
+        // summary's (R3.8). Send Last Reply stays available, as upstream's Copy does.
+        summarize: if thread.status() == ThreadStatus::Unconfirmed {
+            Err(WAIT_TOOLTIP.into())
+        } else {
+            Ok(())
+        },
+    }
+}
+
+/// The last assistant run of the thread, as upstream's Copy reads it (R2.1).
+pub(crate) fn last_reply_text(entries: &[AgentThreadEntry], cx: &App) -> Option<String> {
+    let last = entries
+        .iter()
+        .rposition(|entry| matches!(entry, AgentThreadEntry::AssistantMessage(_)))?;
+    ThreadView::get_agent_message_content(entries, last, cx).filter(|text| !text.trim().is_empty())
+}
+
+/// The block appended to the parent's composer: a header naming the sub-thread, a blank line,
+/// then the reply, cut on a `char` boundary at the cap with the count of what was left out.
+pub(crate) fn compose_block(sub_thread_title: &str, reply: &str) -> String {
+    let header = format!("From sub-thread \"{sub_thread_title}\":\n\n");
+    match reply.char_indices().nth(REPLY_CAP_CHARS) {
+        None => format!("{header}{reply}"),
+        Some((cut, _)) => {
+            let left_out = reply[cut..].chars().count();
+            format!(
+                "{header}{}\n[truncated: {left_out} more characters]",
+                &reply[..cut]
+            )
+        }
+    }
+}
+
+pub(crate) mod control;
+mod delivery;
+mod summary;
+pub(crate) use delivery::deliver_to_parent;
+
+impl ThreadView {
+    /// Send Last Reply (R2): the last reply, under a header naming this sub-thread, appended to
+    /// the parent's composer. A choice the control shows disabled does nothing here either.
+    pub(crate) fn send_last_reply(
+        &mut self,
+        window: &mut gpui::Window,
+        cx: &mut gpui::Context<Self>,
+    ) {
+        self.send_to_parent.notice = None;
+        cx.notify();
+        let link = parent_link(self.root_thread_id, cx);
+        let ParentLink::Live { parent_session, .. } = &link else {
+            return;
+        };
+        let thread = self.thread.read(cx);
+        if availability(&link, thread, &self.send_to_parent)
+            .last_reply
+            .is_err()
+        {
+            return;
+        }
+        let Some(reply) = last_reply_text(thread.entries(), cx) else {
+            return;
+        };
+        let title = thread
+            .title()
+            .unwrap_or_else(|| crate::DEFAULT_THREAD_TITLE.into());
+        let block = compose_block(&title, &reply);
+        // Cleared by `deliver_to_parent` on every way it ends.
+        self.send_to_parent.delivering = true;
+        deliver_to_parent(
+            parent_session.clone(),
+            block,
+            cx.entity().downgrade(),
+            window,
+            cx,
+        );
+    }
+}
+
+#[cfg(test)]
+#[path = "sub_thread_send/helpers_tests.rs"]
+mod helpers_tests;
+
+#[cfg(test)]
+#[path = "sub_thread_send/send_to_parent_control_tests.rs"]
+mod send_to_parent_control_tests;
+
+#[cfg(test)]
+#[path = "sub_thread_send/deliver_to_parent_tests.rs"]
+mod deliver_to_parent_tests;
+
+#[cfg(test)]
+// The frozen story-040 test clones in a helper; the lint is silenced here, not edited there.
+#[allow(clippy::redundant_clone)]
+#[path = "sub_thread_send/summarize_and_send_tests.rs"]
+mod summarize_and_send_tests;
+
+#[cfg(test)]
+#[path = "sub_thread_send/receipt_test_support.rs"]
+mod receipt_test_support;
+
+#[cfg(test)]
+#[path = "sub_thread_send/summary_binding_tests.rs"]
