@@ -0,0 +1,428 @@
+// Story 064, task 2.1 — `TaskRowMerger`: native subagent rows and `_claude/tasks` entries become
+// one list, one row per child (R3.1, R3.2, R3.3, R3.4).
+//
+// Wired at the end of `crates/agent_ui/src/tasks_card/merge.rs` (new, fixup of 0037) as
+//
+//     #[cfg(test)]
+//     #[path = "merge_tests.rs"]
+//     mod tests;
+//
+// Validation filter: `cargo test -p agent_ui tasks_card::merge`.
+//
+// Contract (design.md §TaskRowMerger, §Tasks card and tray, §Data Models):
+//   - `pub fn merge(subagents: &[SubagentRow], feed: &[AgentTask]) -> Vec<TaskRow>`;
+//   - a feed task whose `child_session_id` equals a row's `child_session_id` is folded into that
+//     row: status from the row, usage / last tool / summary from the task; every other feed task
+//     and every other row is kept. Identity is the child session id, never the title;
+//   - `TaskRow` gains `source: TaskSource`, `TaskSource::{ClaudeTasks, AcpSubagent { child:
+//     SessionId, can_cancel: bool }}`;
+//   - `AgentTask` gains `child_session_id: Option<SessionId>`;
+//   - (operator, 2026-10-29, revision 1) `TaskRow` gains its own `status: TaskRowStatus`,
+//     `TaskRowStatus::{Running, Waiting, Done, Failed, Canceled, Unknown}`, so a merged row can
+//     show Waiting and Unknown; a native row's status is its `SubagentRowStatus`, variant for
+//     variant; a feed-only row maps its `AgentTaskStatus` into it.
+// Assumed beyond design.md (adjust HERE — `native_row` and `feed_task` — not in each test):
+//   - `SubagentRow` and its status enum are reachable as `acp_thread::subagent_rows::{SubagentRow,
+//     SubagentRowStatus}` (`pub mod subagent_rows`, as `pub mod subagents`); the status enum is
+//     named `SubagentRowStatus` (design.md says `TaskActivity`, a name `agent_ui` already uses);
+//   - `SubagentRow.started_at: Option<SystemTime>`; the other field types as in task 1.1's tests;
+//   - `TaskRowStatus` derives `Clone, Copy, Debug, PartialEq, Eq` and sits beside `TaskRow`;
+//   - the feed mapping pinned here is Running -> Running, Completed -> Done, Failed -> Failed,
+//     Stopped -> Canceled (`expected_feed_status`); `Interrupted` is not pinned — the operator's
+//     decision names no target for it;
+//   - row order is not part of the contract; rows are looked up, never indexed.
+//
+// Hostile halves first, for "a subagent is shown once" (identity = child session id):
+//   - wrongly collapse: two children sharing a label, a feed entry with the same description and
+//     no child, a feed entry naming an unregistered child, and a feed entry whose own id equals
+//     another child's id — each stays its own row;
+//   - wrongly split: a feed entry naming a registered child under a different description, and
+//     two feed entries naming the same child, fold into that child's single row;
+//   - then status disagreement (registry wins), and the benign feed-only and native-only cases.
+
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use acp_thread::subagent_rows::{SubagentRow, SubagentRowStatus};
+use acp_thread::{AgentTask, AgentTaskStatus, AgentTaskUsage};
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::SharedString;
+
+use super::merge;
+use crate::tasks_card::{TaskRow, TaskRowStatus, TaskSource};
+
+fn merge_ms(ms: u64) -> SystemTime {
+    UNIX_EPOCH + Duration::from_millis(ms)
+}
+
+/// A native subagent row as task 1.1's `subagent_rows` produces it.
+fn native_row(child: &str, label: &str, status: SubagentRowStatus) -> SubagentRow {
+    SubagentRow {
+        child_session_id: acp_v2::SessionId::new(child),
+        label: SharedString::from(label.to_string()),
+        status,
+        can_cancel: true,
+        error: None,
+        started_at: Some(merge_ms(1_000)),
+    }
+}
+
+/// A `_claude/tasks` entry; `child` is its `childSessionId` (contract v3), `None` for v2.
+fn feed_task(
+    id: &str,
+    description: &str,
+    status: AgentTaskStatus,
+    child: Option<&str>,
+) -> AgentTask {
+    let ended = !status.is_running();
+    AgentTask {
+        id: SharedString::from(id.to_string()),
+        tool_call_id: Some(acp_v2::ToolCallId::new(format!("toolu_{id}"))),
+        kind: "subagent".into(),
+        description: SharedString::from(description.to_string()),
+        background: true,
+        depth: 0,
+        status,
+        started_at: merge_ms(1_000),
+        ended_at: ended.then(|| merge_ms(2_000)),
+        usage: Some(AgentTaskUsage {
+            tokens: 4_321,
+            tool_uses: 7,
+            duration: Duration::from_millis(9_000),
+        }),
+        last_tool: Some(SharedString::from(format!("Last tool of {id}"))),
+        summary: Some(SharedString::from(format!("Summary of {id}"))),
+        has_output: false,
+        tail: None,
+        child_session_id: child.map(acp_v2::SessionId::new),
+    }
+}
+
+fn merge_child_of(row: &TaskRow) -> Option<String> {
+    match &row.source {
+        TaskSource::AcpSubagent { child, .. } => Some(child.to_string()),
+        TaskSource::ClaudeTasks => None,
+    }
+}
+
+fn merge_native_rows<'a>(rows: &'a [TaskRow], child: &str) -> Vec<&'a TaskRow> {
+    rows.iter()
+        .filter(|row| merge_child_of(row).as_deref() == Some(child))
+        .collect()
+}
+
+fn merge_the_native_row<'a>(rows: &'a [TaskRow], child: &str) -> &'a TaskRow {
+    let found = merge_native_rows(rows, child);
+    assert_eq!(
+        found.len(),
+        1,
+        "child {child} has exactly one row: {:?}",
+        merge_summary(rows)
+    );
+    found[0]
+}
+
+fn merge_feed_ids(rows: &[TaskRow]) -> Vec<String> {
+    let mut ids: Vec<String> = rows
+        .iter()
+        .filter(|row| matches!(row.source, TaskSource::ClaudeTasks))
+        .map(|row| row.task.id.to_string())
+        .collect();
+    ids.sort();
+    ids
+}
+
+/// (source child or "feed", task id) per row, for failure messages.
+fn merge_summary(rows: &[TaskRow]) -> Vec<(String, String)> {
+    rows.iter()
+        .map(|row| {
+            (
+                merge_child_of(row).unwrap_or_else(|| "feed".to_string()),
+                row.task.id.to_string(),
+            )
+        })
+        .collect()
+}
+
+/// A native row shows its registry status, variant for variant (exhaustive: a seventh
+/// `SubagentRowStatus` fails to compile here).
+fn expected_native_status(status: SubagentRowStatus) -> TaskRowStatus {
+    match status {
+        SubagentRowStatus::Running => TaskRowStatus::Running,
+        SubagentRowStatus::Waiting => TaskRowStatus::Waiting,
+        SubagentRowStatus::Done => TaskRowStatus::Done,
+        SubagentRowStatus::Failed => TaskRowStatus::Failed,
+        SubagentRowStatus::Canceled => TaskRowStatus::Canceled,
+        SubagentRowStatus::Unknown => TaskRowStatus::Unknown,
+    }
+}
+
+/// A feed-only row's status from its entry; `None` where no mapping is pinned (`Interrupted`).
+fn expected_feed_status(status: AgentTaskStatus) -> Option<TaskRowStatus> {
+    match status {
+        AgentTaskStatus::Running => Some(TaskRowStatus::Running),
+        AgentTaskStatus::Completed => Some(TaskRowStatus::Done),
+        AgentTaskStatus::Failed => Some(TaskRowStatus::Failed),
+        AgentTaskStatus::Stopped => Some(TaskRowStatus::Canceled),
+        AgentTaskStatus::Interrupted => None,
+    }
+}
+
+// ── Wrongly collapse: distinct things stay distinct (R3.3, R3.2) ───────────
+
+#[test]
+fn tasks_card_merge_children_sharing_a_label_stay_two_rows() {
+    let subagents = [
+        native_row("c-a", "Explore", SubagentRowStatus::Running),
+        native_row("c-b", "Explore", SubagentRowStatus::Running),
+    ];
+    // Same description, no child: an old-style entry that only looks like the children.
+    let feed = [feed_task(
+        "t-plain",
+        "Explore",
+        AgentTaskStatus::Running,
+        None,
+    )];
+
+    let rows = merge(&subagents, &feed);
+
+    merge_the_native_row(&rows, "c-a");
+    merge_the_native_row(&rows, "c-b");
+    assert_eq!(
+        merge_feed_ids(&rows),
+        ["t-plain"],
+        "an entry without childSessionId is never folded by title: {:?}",
+        merge_summary(&rows)
+    );
+    assert_eq!(rows.len(), 3, "{:?}", merge_summary(&rows));
+}
+
+#[test]
+fn tasks_card_merge_entry_naming_an_unregistered_child_stays_a_feed_row() {
+    let subagents = [native_row("c-a", "Explore", SubagentRowStatus::Running)];
+    let feed = [feed_task(
+        "t-orphan",
+        "Explore",
+        AgentTaskStatus::Running,
+        Some("c-unregistered"),
+    )];
+
+    let rows = merge(&subagents, &feed);
+
+    merge_the_native_row(&rows, "c-a");
+    assert!(
+        merge_native_rows(&rows, "c-unregistered").is_empty(),
+        "no native row is invented for a child the registry does not hold"
+    );
+    assert_eq!(merge_feed_ids(&rows), ["t-orphan"]);
+    assert_eq!(rows.len(), 2, "{:?}", merge_summary(&rows));
+}
+
+// An entry whose own task id equals another child's session id folds into the child it NAMES,
+// never into the child its id happens to spell.
+#[test]
+fn tasks_card_merge_entry_id_spelling_a_child_id_folds_only_by_child_session_id() {
+    let subagents = [
+        native_row("c-a", "First", SubagentRowStatus::Running),
+        native_row("c-b", "Second", SubagentRowStatus::Running),
+    ];
+    let feed = [feed_task(
+        "c-b",
+        "Feed",
+        AgentTaskStatus::Running,
+        Some("c-a"),
+    )];
+
+    let rows = merge(&subagents, &feed);
+
+    let first = merge_the_native_row(&rows, "c-a");
+    let second = merge_the_native_row(&rows, "c-b");
+    assert_eq!(
+        first.task.summary.as_ref().map(|s| s.to_string()),
+        Some("Summary of c-b".to_string()),
+        "the entry enriches the child it names"
+    );
+    assert_ne!(
+        second.task.summary.as_ref().map(|s| s.to_string()),
+        Some("Summary of c-b".to_string()),
+        "and never the child whose id its own id spells"
+    );
+    assert!(
+        merge_feed_ids(&rows).is_empty(),
+        "{:?}",
+        merge_summary(&rows)
+    );
+    assert_eq!(rows.len(), 2);
+}
+
+// ── Wrongly split: one child is one row (R3.1) ─────────────────────────────
+
+#[test]
+fn tasks_card_merge_entry_naming_a_child_folds_into_its_row_whatever_its_description() {
+    let subagents = [native_row(
+        "c-a",
+        "Explore the parser",
+        SubagentRowStatus::Running,
+    )];
+    let feed = [feed_task(
+        "t-agent-7",
+        "Different words entirely",
+        AgentTaskStatus::Running,
+        Some("c-a"),
+    )];
+
+    let rows = merge(&subagents, &feed);
+
+    assert_eq!(
+        rows.len(),
+        1,
+        "one row for the child: {:?}",
+        merge_summary(&rows)
+    );
+    let row = merge_the_native_row(&rows, "c-a");
+    assert_eq!(
+        row.task.usage, feed[0].usage,
+        "the feed's usage is shown on the native row"
+    );
+    assert_eq!(row.task.last_tool, feed[0].last_tool, "and its last tool");
+    assert_eq!(row.task.summary, feed[0].summary, "and its summary");
+    assert!(merge_feed_ids(&rows).is_empty());
+}
+
+#[test]
+fn tasks_card_merge_two_entries_naming_one_child_are_still_one_row() {
+    let subagents = [native_row("c-a", "Explore", SubagentRowStatus::Running)];
+    let feed = [
+        feed_task("t-first", "Explore", AgentTaskStatus::Running, Some("c-a")),
+        feed_task(
+            "t-again",
+            "Explore again",
+            AgentTaskStatus::Running,
+            Some("c-a"),
+        ),
+    ];
+
+    let rows = merge(&subagents, &feed);
+
+    merge_the_native_row(&rows, "c-a");
+    assert!(
+        merge_feed_ids(&rows).is_empty(),
+        "no entry naming the child survives beside its row: {:?}",
+        merge_summary(&rows)
+    );
+    assert_eq!(rows.len(), 1);
+}
+
+// ── R3.4: the registry's status wins ───────────────────────────────────────
+
+#[test]
+fn tasks_card_merge_status_disagreement_shows_the_registry_status() {
+    for (native, feed_status) in [
+        (SubagentRowStatus::Waiting, AgentTaskStatus::Running),
+        (SubagentRowStatus::Unknown, AgentTaskStatus::Completed),
+        (SubagentRowStatus::Failed, AgentTaskStatus::Completed),
+        (SubagentRowStatus::Running, AgentTaskStatus::Completed),
+        (SubagentRowStatus::Done, AgentTaskStatus::Running),
+        (SubagentRowStatus::Canceled, AgentTaskStatus::Failed),
+    ] {
+        let expected = expected_native_status(native);
+        assert_ne!(
+            Some(expected),
+            expected_feed_status(feed_status),
+            "precondition for {native:?}: the two sources really disagree"
+        );
+        let row = native_row("c-a", "Explore", native);
+        let feed = [feed_task("t-1", "Explore", feed_status, Some("c-a"))];
+
+        let rows = merge(std::slice::from_ref(&row), &feed);
+
+        assert_eq!(
+            merge_the_native_row(&rows, "c-a").status,
+            expected,
+            "{native:?} vs feed {feed_status:?}: the registry's status is shown"
+        );
+    }
+}
+
+// ── Benign: each source alone ──────────────────────────────────────────────
+
+// R3.2: with no native rows, the feed's entries are the rows, unchanged.
+#[test]
+fn tasks_card_merge_feed_only_entries_are_shown_as_today() {
+    let feed = [
+        feed_task("t-shell", "Run the tests", AgentTaskStatus::Running, None),
+        feed_task("t-done", "Build", AgentTaskStatus::Completed, None),
+        feed_task("t-failed", "Lint", AgentTaskStatus::Failed, None),
+        feed_task("t-stopped", "Watch", AgentTaskStatus::Stopped, None),
+    ];
+
+    let rows = merge(&[], &feed);
+
+    assert_eq!(
+        merge_feed_ids(&rows),
+        ["t-done", "t-failed", "t-shell", "t-stopped"]
+    );
+    for task in &feed {
+        let row = rows
+            .iter()
+            .find(|row| row.task.id == task.id)
+            .expect("the entry is a row");
+        assert_eq!(&row.task, task, "a feed row carries its entry as it came");
+        assert!(matches!(row.source, TaskSource::ClaudeTasks));
+        assert_eq!(
+            Some(row.status),
+            expected_feed_status(task.status),
+            "{}: a feed row maps its entry's status",
+            task.id
+        );
+    }
+}
+
+// R1.3 through the merge: every native status reaches the row, Waiting and Unknown included.
+#[test]
+fn tasks_card_merge_native_rows_show_all_six_statuses() {
+    let statuses = [
+        ("c-run", SubagentRowStatus::Running),
+        ("c-wait", SubagentRowStatus::Waiting),
+        ("c-done", SubagentRowStatus::Done),
+        ("c-fail", SubagentRowStatus::Failed),
+        ("c-cancel", SubagentRowStatus::Canceled),
+        ("c-unknown", SubagentRowStatus::Unknown),
+    ];
+    let subagents = statuses.map(|(child, status)| native_row(child, "Explore", status));
+
+    let rows = merge(&subagents, &[]);
+
+    for (child, status) in statuses {
+        assert_eq!(
+            merge_the_native_row(&rows, child).status,
+            expected_native_status(status),
+            "{child}"
+        );
+    }
+}
+
+#[test]
+fn tasks_card_merge_native_rows_without_entries_are_kept_with_their_grant() {
+    let mut refused = native_row("c-refused", "No stop", SubagentRowStatus::Waiting);
+    refused.can_cancel = false;
+    let subagents = [
+        native_row("c-a", "Explore", SubagentRowStatus::Running),
+        refused,
+    ];
+
+    let rows = merge(&subagents, &[]);
+
+    assert_eq!(rows.len(), 2, "{:?}", merge_summary(&rows));
+    for (child, can_cancel) in [("c-a", true), ("c-refused", false)] {
+        match &merge_the_native_row(&rows, child).source {
+            TaskSource::AcpSubagent {
+                can_cancel: granted,
+                ..
+            } => assert_eq!(
+                *granted, can_cancel,
+                "{child}: the row keeps its Stop grant"
+            ),
+            TaskSource::ClaudeTasks => unreachable!("looked up as a native row"),
+        }
+    }
+}
