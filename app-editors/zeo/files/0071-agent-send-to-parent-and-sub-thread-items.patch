+                SHIPPED_STEP_0,
+                SHIPPED_STEP_1,
+                SHIPPED_STEP_2,
+                SHIPPED_STEP_3,
+            ],
+            &mut |_, _, _| false,
+        )
+        .expect("the shipped steps apply");
+    for (session, task, log_bytes, archived) in [
+        ("s-old", "t1", "4096", 1),
+        ("s-old", "t2", "NULL", 0),
+        ("s-other", "t1", "1048620", 0),
+    ] {
+        run_sql_now(
+            &connection,
+            &format!(
+                "INSERT INTO agent_task_history \
+                 (session_id, task_id, thread_title, project, kind, description, background, \
+                  status, started_at, ended_at, archived, label, tool_call_id, log_bytes) \
+                 VALUES ('{session}', '{task}', 'Old', 'zeo', 'shell', 'Old task', 1, \
+                         'completed', 1000, 2000, {archived}, 'kept label', 'toolu_x', \
+                         {log_bytes})"
+            ),
+        );
+    }
+
+    migrate_all(&connection);
+    // A second open of the same database changes nothing more.
+    migrate_all(&connection);
+
+    let rows = connection
+        .select::<(String, String, Option<String>, Option<i64>, bool, String)>(
+            "SELECT session_id, task_id, label, log_bytes, archived, origin \
+             FROM agent_task_history ORDER BY session_id, task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(rows.len(), 3, "every record survives, and none is added");
+    let expected = [
+        ("s-old", "t1", Some(4096), true),
+        ("s-old", "t2", None, false),
+        ("s-other", "t1", Some(1_048_620), false),
+    ];
+    for ((session, task, label, log_bytes, archived, origin), want) in
+        rows.into_iter().zip(expected)
+    {
+        assert_eq!((session.as_str(), task.as_str()), (want.0, want.1));
+        assert_eq!(label.as_deref(), Some("kept label"), "{session}/{task}");
+        assert_eq!(log_bytes, want.2, "{session}/{task} keeps its log size");
+        assert_eq!(archived, want.3, "{session}/{task} keeps its archive flag");
+        assert_eq!(origin, "adapter", "{session}/{task} is an adapter record");
+    }
+}
