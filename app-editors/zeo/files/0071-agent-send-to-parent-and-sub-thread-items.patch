+    assert_eq!(task.record.description.as_ref(), format!("Task {squatter}"));
+    assert_eq!(task.record.status, AgentTaskStatus::Running);
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_link_inserts_a_new_item_as_idle(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_new").await;
