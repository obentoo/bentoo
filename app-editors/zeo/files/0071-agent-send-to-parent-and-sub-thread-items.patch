+    );
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-b", "Bravo", 2_000)),
+        &mut rig.cx,
+    );
+
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(
+        item(&memory, "p1", "sub-a").map(|e| e.record.description.to_string()),
+        Some("Alpha".to_string())
+    );
+    assert_eq!(
+        item(&memory, "p1", "sub-b").map(|e| e.record.description.to_string()),
+        Some("Bravo".to_string())
+    );
