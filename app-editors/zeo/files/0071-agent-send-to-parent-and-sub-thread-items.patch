+
+// Hostile (wrong split): a row stored as a sub-thread item reads `SubThread` even when nothing
+// else about it looks like one — no prefix, an adapter kind.
+#[gpui::test]
+async fn history_db_origin_stored_sub_thread_reads_sub_thread_whatever_its_kind_and_id(
