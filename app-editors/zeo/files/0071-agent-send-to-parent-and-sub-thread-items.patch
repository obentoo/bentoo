+    assert_eq!(
+        removed,
+        vec![0, 1],
+        "both archived adapter rows are deleted"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", "t1"),
+        0,
+        "the adapter row is removed"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", "zeo-sub-thread:s9"),
+        0,
+        "the adapter row dressed as a sub-thread is removed, not kept"
+    );
+    assert!(
+        tombstones(&db).await.is_empty(),
+        "an adapter row is never a tombstone"
+    );
+}
+
+// ── The guard is not over-broad ────────────────────────────────────────────
+
+// After a sibling's tombstone, a live item of the same parent is still refreshed by both writes,
+// and a new sub-thread of that parent is still recorded.
+#[gpui::test]
+async fn history_db_tombstone_live_items_of_the_parent_still_take_writes(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_live_writes").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo", 1_100),
+        "completed",
+    )
+    .await;
+    db.delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo", 2_000),
+        "running",
+    )
+    .await;
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-b", "Bravo renamed", 2_100),
+    )
+    .await;
+    tombstone_link(&db, &tombstone_sub_record("p1", "sub-c", "Charlie", 2_200)).await;
