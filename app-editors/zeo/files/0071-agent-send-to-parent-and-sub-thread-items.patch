diff --git a/crates/agent_tasks_panel/src/store/sub_thread_tombstone_tests.rs b/crates/agent_tasks_panel/src/store/sub_thread_tombstone_tests.rs
new file mode 100644
index 0000000..db30b58
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/sub_thread_tombstone_tests.rs
@@ -0,0 +1,272 @@
+// Story 040, task 11.1 (store half) — a deleted sub-thread item stays deleted across a restart
+// (R5.10, R7.6; Q14; review 3.x F1). Module path: `store::sub_thread_tombstone`. Wired in
+// `src/store.rs`, after `mod sub_thread_items;`, as
+//
+//     #[cfg(test)]
+//     #[path = "store/sub_thread_tombstone_tests.rs"]
+//     mod sub_thread_tombstone;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- sub_thread` (names carry
+// `store_sub_thread_tombstone`).
+//
+// Contract (design.md v4, "Tombstone (v4, review 3.x F1, R5.10)"): the store's delete leaves a
+// tombstone row; at load, `deleted_sub_thread_keys()` seeds the store's `deleted` set BEFORE the
+// `Linked` that `register_card` replays is applied, so the in-memory guard of
+// `record_sub_thread` covers the restart. A restart is modelled as story 014's tests model it: a
+// new `TaskHistoryStore` over the same database, registered on the card.
+//
+// Fidelity: the `Linked` of the restart is the card's REAL replay
+// (`TasksCard::replay_sub_thread_activity`, run by `register_card`) over a real
+// `ThreadOrganizationStore` link between two real threads — never an emitted fake. The first
+// test is the control proving that replay reaches the store in this rig; without it, "no item"
+// would hold vacuously.
+//
+// Hostile halves first:
+//   - wrongly split (the revival): after Delete, a new store over the same database hears the
+//     replayed `Linked` and lists no item, in memory and on disk — whether the store registers
+//     after its load ended, or while it is still loading (the replay is then queued and applied
+//     after the load);
+//   - wrongly collapse: the deleted item's sibling, linked to the same parent, is still listed
+//     after the restart;
+//   - then the benign control: a link never deleted is listed by a store over a new database.
+// Assumed beyond design.md: `deleted_sub_thread_keys` as in `history_db/tombstone_tests.rs`.
+
+use acp_thread::AcpThread;
+use agent_ui::thread_metadata_store::ThreadMetadataStore;
+use agent_ui::thread_organization::{ForkKind, ThreadOrganizationStore};
+use gpui::{AppContext as _, Entity, TestAppContext};
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore, TaskKey};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+/// A parent thread with two sub-threads linked to it in the organization store.
+struct LinkedThreads {
+    ids: [agent_ui::ThreadId; 3],
+    parent_session: String,
+    alpha_session: String,
+    bravo_session: String,
+}
+
+fn open_tombstone_thread(
+    rig: &mut CardRig,
+    title: &str,
+) -> (Entity<AcpThread>, agent_ui::ThreadId) {
+    let thread = open_thread_on(&rig.agent_panel, StopConnection::new(), title, &mut rig.cx);
+    let id = agent_ui::test_support::active_thread_id(&rig.agent_panel, &rig.cx);
+    (thread, id)
+}
+
+fn link_two_sub_threads(rig: &mut CardRig) -> LinkedThreads {
+    rig.cx
+        .update(|_, cx| agent_ui::thread_organization::init(cx));
+    rig.cx.run_until_parked();
+    let (parent, parent_id) = open_tombstone_thread(rig, "Parent");
+    let (alpha, alpha_id) = open_tombstone_thread(rig, "Alpha");
+    let (bravo, bravo_id) = open_tombstone_thread(rig, "Bravo");
+    rig.cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            for child in [alpha_id, bravo_id] {
+                store
+                    .set_parent(child, parent_id, ForkKind::Clean, cx)
+                    .expect("the link is recorded");
+            }
+        })
+    });
+    rig.cx.run_until_parked();
+    LinkedThreads {
+        ids: [parent_id, alpha_id, bravo_id],
+        parent_session: session_of(&parent, &rig.cx).to_string(),
+        alpha_session: session_of(&alpha, &rig.cx).to_string(),
+        bravo_session: session_of(&bravo, &rig.cx).to_string(),
+    }
+}
+
+/// A store over `db`, registered on the rig's card once its load ended (`register_card` replays
+/// the card's links).
+fn tombstone_store_after_load(
+    db: &AgentTaskHistoryDb,
+    rig: &mut CardRig,
+) -> Entity<TaskHistoryStore> {
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    store
+}
+
+/// A store over `db`, registered on the rig's card before its load ended: the replayed links are
+/// heard while loading and applied after it.
+fn tombstone_store_while_loading(
+    db: &AgentTaskHistoryDb,
+    rig: &mut CardRig,
+) -> Entity<TaskHistoryStore> {
+    let card = rig.card.clone();
+    let store = rig.cx.new(|cx| {
+        let mut store = TaskHistoryStore::new(db.clone(), cx);
+        store.register_card(&card, cx);
+        store
+    });
+    rig.cx.run_until_parked();
+    store
+}
+
+fn tombstone_entries(store: &Entity<TaskHistoryStore>, rig: &CardRig) -> Vec<HistoryEntry> {
+    store.read_with(&rig.cx, |store, _| store.records().to_vec())
+}
+
+fn item_key(parent: &str, sub: &str) -> TaskKey {
+    (sid(parent), format!("{PREFIX}{sub}").into())
+}
+
+fn has_item(rows: &[HistoryEntry], parent: &str, sub: &str) -> bool {
+    rows.iter().any(|entry| {
+        entry.origin == TaskOrigin::SubThread
+            && entry.record.session_id.to_string() == parent
+            && entry.record.task_id == format!("{PREFIX}{sub}")
+    })
+}
+
+/// Records both items through the first store, then archives and deletes Alpha's.
+fn delete_alpha(store: &Entity<TaskHistoryStore>, links: &LinkedThreads, rig: &mut CardRig) {
+    // The real replay records both links in this store (idempotent if the reporter already did).
+    let card = rig.card.clone();
+    card.update(&mut rig.cx, |card, cx| card.replay_sub_thread_activity(cx));
+    rig.cx.run_until_parked();
+    let before = tombstone_entries(store, rig);
+    assert!(
+        has_item(&before, &links.parent_session, &links.alpha_session)
+            && has_item(&before, &links.parent_session, &links.bravo_session),
+        "precondition: both items are recorded: {before:?}"
+    );
+    let alpha = item_key(&links.parent_session, &links.alpha_session);
+    store.update(&mut rig.cx, |store, cx| {
+        store.archive(std::slice::from_ref(&alpha), cx)
+    });
+    rig.cx.run_until_parked();
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(std::slice::from_ref(&alpha), cx)
+    });
+    rig.cx.run_until_parked();
+    assert!(
+        !has_item(
+            &tombstone_entries(store, rig),
+            &links.parent_session,
+            &links.alpha_session
+        ),
+        "precondition: the item is gone this session"
+    );
+}
+
+/// What the restarted store and the database show for Alpha and Bravo.
+async fn assert_alpha_stays_deleted(
+    restarted: &Entity<TaskHistoryStore>,
+    db: &AgentTaskHistoryDb,
+    links: &LinkedThreads,
+    rig: &mut CardRig,
+) {
+    let memory = tombstone_entries(restarted, rig);
+    assert!(
+        !has_item(&memory, &links.parent_session, &links.alpha_session),
+        "the replayed Linked does not bring the deleted item back: {memory:?}"
+    );
+    assert!(
+        has_item(&memory, &links.parent_session, &links.bravo_session),
+        "its sibling is still listed after the restart"
+    );
+    assert!(
+        !has_item(&load(db).await, &links.parent_session, &links.alpha_session),
+        "no live row is written back for the deleted item"
+    );
+    let tombstones: Vec<(String, String)> = db
+        .deleted_sub_thread_keys()
+        .await
+        .expect("deleted_sub_thread_keys should succeed")
+        .into_iter()
+        .map(|(session_id, task_id)| (session_id.to_string(), task_id.to_string()))
+        .collect();
+    assert_eq!(
+        tombstones,
+        vec![(
+            links.parent_session.clone(),
+            format!("{PREFIX}{}", links.alpha_session)
+        )],
+        "the deleted item is kept as a tombstone"
+    );
+    let [parent_id, alpha_id, bravo_id] = links.ids;
+    rig.cx.update(|_, cx| {
+        let organization = ThreadOrganizationStore::global(cx);
+        assert_eq!(
+            organization.read(cx).parent(alpha_id),
+            Some((parent_id, ForkKind::Clean)),
+            "the deleted item's link is untouched (R7.6)"
+        );
+        let metadata = ThreadMetadataStore::global(cx);
+        let metadata = metadata.read(cx);
+        for id in [parent_id, alpha_id, bravo_id] {
+            let entry = metadata.entry(id).expect("the thread still exists (R7.6)");
+            assert!(!entry.archived, "the thread is not archived (R7.6)");
+        }
+    });
+}
+
+// ── Control: the replay reaches the store in this rig ──────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_tombstone_control_replay_lists_a_link_never_deleted(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let links = link_two_sub_threads(&mut rig);
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_tombstone_control").await;
+
+    let store = tombstone_store_after_load(&db, &mut rig);
+
+    let memory = tombstone_entries(&store, &rig);
+    assert!(
+        has_item(&memory, &links.parent_session, &links.alpha_session)
+            && has_item(&memory, &links.parent_session, &links.bravo_session),
+        "register_card's replay records every link: {memory:?}"
+    );
+}
+
+// ── Wrongly split: the revival (R5.10) ─────────────────────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_tombstone_deleted_item_stays_deleted_after_a_restart(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let links = link_two_sub_threads(&mut rig);
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_tombstone_restart").await;
+    let first = tombstone_store_after_load(&db, &mut rig);
+    delete_alpha(&first, &links, &mut rig);
+    drop(first);
+    rig.cx.run_until_parked();
+
+    let restarted = tombstone_store_after_load(&db, &mut rig);
+
+    assert_alpha_stays_deleted(&restarted, &db, &links, &mut rig).await;
+}
+
+// The replay heard while the restarted store is still loading is applied after the load: the
+// tombstones must already be in the store's `deleted` set by then.
+#[gpui::test]
+async fn store_sub_thread_tombstone_deleted_item_stays_deleted_when_replayed_while_loading(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let links = link_two_sub_threads(&mut rig);
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_tombstone_loading").await;
+    let first = tombstone_store_after_load(&db, &mut rig);
+    delete_alpha(&first, &links, &mut rig);
+    drop(first);
+    rig.cx.run_until_parked();
+
+    let restarted = tombstone_store_while_loading(&db, &mut rig);
+
+    assert_alpha_stays_deleted(&restarted, &db, &links, &mut rig).await;
+}
