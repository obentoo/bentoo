@@ -0,0 +1,225 @@
+// Story 064, task 4.1 — shared fixtures for the tasks card's native subagent rows (R1.1, R1.4,
+// R1.5, R1.6, R6.1). Patch `0037` (fixup). Wired in `src/tasks_card.rs` beside `test_helpers`:
+//
+//     #[cfg(test)]
+//     mod native_subagent_support;
+//     #[cfg(test)]
+//     #[path = "tasks_card/native_subagent_tests.rs"]
+//     mod native_subagent;
+//
+// and in `src/tasks_card/tray.rs`, beside `mod dedupe;`:
+//
+//     #[cfg(test)]
+//     #[path = "tray/subagent_tests.rs"]
+//     mod subagent;
+//
+// Validation filter: `cargo test -p agent_ui tasks_card`.
+//
+// A child is built the way `agent_servers::acp::apply_subagent_update` builds one — an
+// `agent_owned` `AcpThread` whose parent session is the thread's, its association applied, then
+// `register_subagent` on the parent (which emits `SubagentSpawned`). The stub connection cannot
+// do that itself: subagent updates are routed by `agent_servers`, not by `AcpThread`. The child is
+// made known to the stub with `track_session`, so `session/cancel` on it reaches the stub's
+// `cancel_calls` instead of failing with "Session not found".
+//
+// Contract assumed beyond design.md (adjust HERE, not in each test):
+//   - `TaskRow::source: TaskSource` and `TaskSource::AcpSubagent { child: acp_v2::SessionId,
+//     can_cancel: bool }`, reachable as `super::TaskSource` from the card's module;
+//   - a native row still carries `task.id` (its row key with the parent's session), which the
+//     existing per-row selectors (`tasks-card-row-{id}`, `tasks-card-stop-{id}`,
+//     `tasks-card-open-{id}`) and `request_stop(parent, id, …)` use. The tests read the id from
+//     the row; they never spell it.
+//   - Revision 1 (operator, 2026-10-29): `TaskRow::status: TaskRowStatus` (Running, Waiting, Done,
+//     Failed, Canceled, Unknown), reachable as `super::TaskRowStatus`; the acp_thread side's row
+//     status is `SubagentRowStatus` (advisor A's 1.1).
+
+#![allow(dead_code)]
+
+use std::rc::Rc;
+use std::time::Duration;
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection};
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use super::test_helpers::*;
+use super::{TaskRow, TaskSource, TasksCard};
+use crate::AgentPanel;
+
+/// A visible agent panel holding one titled parent thread on a stub that follows the subagents
+/// RFD.
+pub(crate) struct SubagentRig {
+    pub panel: Entity<AgentPanel>,
+    pub workspace: Entity<Workspace>,
+    pub connection: StubAgentConnection,
+    pub parent: Entity<AcpThread>,
+    pub parent_session: acp_v2::SessionId,
+    pub card: Entity<TasksCard>,
+    pub cx: VisualTestContext,
+}
+
+pub(crate) async fn subagent_rig(cx: &mut TestAppContext) -> SubagentRig {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    crate::test_support::open_thread_with_connection(&panel, connection.clone(), &mut cx);
+    let parent = panel.read_with(&cx, |panel, cx| {
+        panel.active_agent_thread(cx).expect("a thread was opened")
+    });
+    send_info(
+        &parent,
+        acp::SessionInfoUpdate::new().title("Parent"),
+        &mut cx,
+    );
+    let parent_session = session_of(&parent, &cx);
+    let card = card(&panel, &cx);
+    SubagentRig {
+        panel,
+        workspace,
+        connection,
+        parent,
+        parent_session,
+        card,
+        cx,
+    }
+}
+
+impl SubagentRig {
+    /// Announces one child of the parent, as an ACP `subagent_update` does: its title (the
+    /// association's) and whether the agent lets Zed cancel it. The child reports no state yet.
+    pub(crate) fn spawn_child(
+        &mut self,
+        session: &str,
+        title: Option<&str>,
+        can_cancel: bool,
+    ) -> Entity<AcpThread> {
+        let parent_session = self.parent_session.clone();
+        let connection: Rc<dyn AgentConnection> = Rc::new(self.connection.clone());
+        let parent = self.parent.clone();
+        let child = self.cx.update(|_, cx| {
+            let project = parent.read(cx).project().clone();
+            let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+            cx.new(|cx| {
+                AcpThread::new(
+                    Some(parent_session),
+                    None,
+                    None,
+                    connection,
+                    project,
+                    action_log,
+                    acp_v2::SessionId::new(session.to_string()),
+                    watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                    cx,
+                )
+                .agent_owned()
+            })
+        });
+        self.cx
+            .update(|_, cx| self.connection.track_session(&child, cx));
+        let mut update = acp_v2::SubagentUpdate::new(session.to_string());
+        if let Some(title) = title {
+            update = update.title(title.to_string());
+        }
+        if can_cancel {
+            update = update.capabilities(
+                acp_v2::SubagentSessionCapabilities::new()
+                    .cancel(acp_v2::SessionCancelCapabilities::new()),
+            );
+        }
+        child
+            .update(&mut self.cx, |child, cx| {
+                child.update_subagent_association(&update, cx)
+            })
+            .expect("an agent-owned thread takes an association");
+        // Its own update, as each ACP notification is applied.
+        self.parent.update(&mut self.cx, |parent, cx| {
+            parent.register_subagent(child.clone(), cx)
+        });
+        child
+    }
+
+    /// The child reports a state snapshot (the `state` of a v1 `subagent_update`).
+    pub(crate) fn report(&mut self, child: &Entity<AcpThread>, state: acp_v2::StateUpdate) {
+        child
+            .update(&mut self.cx, |child, cx| {
+                child.update_session_state(state, cx)
+            })
+            .expect("an agent-owned thread reports its state");
+        self.cx.run_until_parked();
+    }
+
+    pub(crate) fn report_running(&mut self, child: &Entity<AcpThread>) {
+        self.report(
+            child,
+            acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+        );
+    }
+
+    pub(crate) fn report_idle(&mut self, child: &Entity<AcpThread>, stop: acp_v2::StopReason) {
+        self.report(
+            child,
+            acp_v2::StateUpdate::Idle(acp_v2::IdleStateUpdate::new().stop_reason(stop)),
+        );
+    }
+
+    /// The card's row for `child`, found by its native source — never by title.
+    pub(crate) fn row_of(&mut self, child: &Entity<AcpThread>) -> Option<TaskRow> {
+        let child_session = session_of(child, &self.cx);
+        let card = self.card.clone();
+        rows_of(&card, &self.parent_session, &mut self.cx)
+            .into_iter()
+            .find(|row| {
+                matches!(
+                    &row.source,
+                    TaskSource::AcpSubagent { child, .. } if *child == child_session
+                )
+            })
+    }
+
+    /// How many rows of the parent's group stand for `child`.
+    pub(crate) fn rows_for(&mut self, child: &Entity<AcpThread>) -> usize {
+        let child_session = session_of(child, &self.cx);
+        let card = self.card.clone();
+        rows_of(&card, &self.parent_session, &mut self.cx)
+            .into_iter()
+            .filter(|row| {
+                matches!(
+                    &row.source,
+                    TaskSource::AcpSubagent { child, .. } if *child == child_session
+                )
+            })
+            .count()
+    }
+
+    /// Starts a parent turn that stays in flight: the stub keeps the prompt open until
+    /// `end_turn`, so the parent reads Generating meanwhile.
+    pub(crate) fn start_parent_turn(&mut self) {
+        crate::test_support::send_message(&self.panel, &mut self.cx);
+    }
+
+    /// The session of the thread the conversation shows (a child after navigation, else the
+    /// root).
+    pub(crate) fn shown_session(&self) -> Option<acp_v2::SessionId> {
+        self.panel.read_with(&self.cx, |panel, cx| {
+            panel
+                .active_conversation_view()
+                .and_then(|view| view.read(cx).active_thread().cloned())
+                .map(|thread_view| thread_view.read(cx).session_id.clone())
+        })
+    }
+
+    pub(crate) fn draw(&mut self) {
+        self.cx.update(|window, _| window.refresh());
+        self.cx.run_until_parked();
+    }
+
+    pub(crate) fn wait(&mut self, duration: Duration) {
+        advance(&mut self.cx, duration);
+    }
+}
+
+/// A selector string the test context can look up (`debug_bounds` takes `&'static str`).
+pub(crate) fn selector(text: String) -> &'static str {
+    Box::leak(text.into_boxed_str())
+}
diff --git a/crates/agent_ui/src/tasks_card/native_subagent_tests.rs b/crates/agent_ui/src/tasks_card/native_subagent_tests.rs
new file mode 100644
index 0000000..467c621
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/native_subagent_tests.rs
@@ -0,0 +1,361 @@
+// Story 064, task 4.1 — native subagents on the tasks card: rows, Stop, Open (R1.1, R1.4, R1.5,
+// R1.6). Module path: `tasks_card::native_subagent`; fixtures in `native_subagent_support.rs`
+// (its header names the wiring and the contract assumed beyond design.md). Validation:
+// `cargo test -p agent_ui tasks_card`.
+//
+// Side effects are read where they land, never from the card's own word: a Stop is the
+// `session/cancel` the stub connection received (which session, how many), the parent's own
+// `ThreadStatus`, and the sibling's native `ForegroundActivity`; an Open is the session the
+// conversation shows.
+//
+// Hostile halves first:
+//   - Stop cancels THAT child: never the parent (the child must not collapse into its parent),
+//     never a sibling, never a same-titled sibling (the title is not the identity);
+//   - a Stop the agent does not allow is shown DISABLED with its reason — not hidden, not tried
+//     and failed (AcpThread's own guard would turn a naive cancel into an error on the row);
+//   - Open navigates to the CHILD, not to the parent whose group the row sits in, and to the
+//     child that was opened, not its sibling;
+//   - then the benign row, Stop and Open.
+
+use std::time::Duration;
+
+use acp_thread::{ForegroundActivity, ThreadStatus};
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Modifiers, TestAppContext};
+
+use super::RENDERED_ARIA_LABELS;
+use super::native_subagent_support::*;
+use super::test_helpers::*;
+
+/// The disabled Stop's reason (R1.5), byte for byte.
+const STOP_NOT_ALLOWED: &str = "This agent does not allow stopping its subagents";
+
+/// Confirms the card's Stop prompt when it asks one: whether a native Stop asks first is the
+/// card's choice, what it sends is what these tests pin.
+fn answer_stop_if_asked(rig: &mut SubagentRig) {
+    if rig.cx.has_pending_prompt() {
+        rig.cx.simulate_prompt_answer("Stop");
+        rig.cx.run_until_parked();
+    }
+}
+
+fn stop_row(rig: &mut SubagentRig, child: &gpui::Entity<acp_thread::AcpThread>) {
+    let id = rig.row_of(child).expect("the child has a row").task.id;
+    let parent = rig.parent_session.clone();
+    let card = rig.card.clone();
+    card.update_in(&mut rig.cx, |card, window, cx| {
+        card.request_stop(parent, id, window, cx)
+    });
+    rig.cx.run_until_parked();
+    answer_stop_if_asked(rig);
+}
+
+// ── R1.4 — Stop cancels that child, and only it ─────────────────────────────
+
+/// Hostile: two running children and a parent turn in flight. Stopping Alpha sends exactly one
+/// `session/cancel`, for Alpha — not the parent, not Bravo — and the parent keeps generating
+/// while Bravo keeps running.
+#[gpui::test]
+async fn test_native_subagent_stop_cancels_only_that_child_and_the_parent_keeps_running(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    rig.start_parent_turn();
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.report_running(&alpha);
+    rig.report_running(&bravo);
+    assert_eq!(
+        rig.parent.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Generating,
+        "precondition: the parent's turn is in flight"
+    );
+    assert!(rig.row_of(&alpha).is_some() && rig.row_of(&bravo).is_some());
+    rig.connection.take_cancel_calls();
+
+    stop_row(&mut rig, &alpha);
+
+    assert_eq!(
+        rig.connection.take_cancel_calls(),
+        vec![acp_v2::SessionId::new("alpha")],
+        "session/cancel carries the CHILD's id, once, and nothing else is cancelled"
+    );
+    assert_eq!(
+        rig.parent.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Generating,
+        "the parent keeps running"
+    );
+    assert_eq!(
+        bravo.read_with(&rig.cx, |thread, _| thread.foreground_activity()),
+        ForegroundActivity::Running,
+        "the sibling keeps running"
+    );
+    assert!(rig.row_of(&bravo).is_some(), "the sibling keeps its row");
+
+    // The agent confirms: Alpha's row ends, Bravo's stays.
+    rig.report_idle(&alpha, acp_v2::StopReason::Cancelled);
+    assert_eq!(
+        alpha.read_with(&rig.cx, |thread, _| thread.foreground_activity()),
+        ForegroundActivity::Idle
+    );
+    assert!(rig.row_of(&bravo).is_some());
+}
+
+/// Hostile: two children that share a title are two rows, and stopping one cancels only that
+/// one — a card keyed by title would cancel the wrong one or both.
+#[gpui::test]
+async fn test_native_subagent_stop_tells_same_titled_children_apart(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let first = rig.spawn_child("worker-1", Some("Worker"), true);
+    let second = rig.spawn_child("worker-2", Some("Worker"), true);
+    rig.report_running(&first);
+    rig.report_running(&second);
+    assert_eq!(rig.rows_for(&first), 1);
+    assert_eq!(rig.rows_for(&second), 1);
+    rig.connection.take_cancel_calls();
+
+    stop_row(&mut rig, &second);
+
+    assert_eq!(
+        rig.connection.take_cancel_calls(),
+        vec![acp_v2::SessionId::new("worker-2")]
+    );
+    assert_eq!(
+        first.read_with(&rig.cx, |thread, _| thread.foreground_activity()),
+        ForegroundActivity::Running
+    );
+}
+
+/// A child that is waiting for the user (`requires_action`) can be stopped like a running one.
+#[gpui::test]
+async fn test_native_subagent_stop_reaches_a_waiting_child(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report(
+        &alpha,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+    );
+    assert_eq!(
+        rig.row_of(&alpha).expect("Alpha's row").status,
+        super::TaskRowStatus::Waiting,
+        "the row reads Waiting (Revision 1: TaskRow's own status)"
+    );
+    rig.connection.take_cancel_calls();
+
+    stop_row(&mut rig, &alpha);
+
+    assert_eq!(
+        rig.connection.take_cancel_calls(),
+        vec![acp_v2::SessionId::new("alpha")]
+    );
+}
+
+/// `cancel()` fails: the error is on the row, the child is still running, and the cancel was
+/// attempted for that child.
+#[gpui::test]
+async fn test_native_subagent_failed_cancel_shows_on_the_row(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    rig.connection.take_cancel_calls();
+    rig.connection
+        .set_next_cancel_error(anyhow::anyhow!("the agent refused: boom"));
+
+    stop_row(&mut rig, &alpha);
+
+    assert_eq!(
+        rig.connection.take_cancel_calls(),
+        vec![acp_v2::SessionId::new("alpha")]
+    );
+    let row = rig.row_of(&alpha).expect("the child is still listed");
+    let error = row.error.expect("the cancel error reaches the row");
+    assert!(error.contains("boom"), "row error was {error:?}");
+    assert_eq!(
+        alpha.read_with(&rig.cx, |thread, _| thread.foreground_activity()),
+        ForegroundActivity::Running,
+        "a failed cancel leaves the child running"
+    );
+}
+
+// ── R1.5 — no cancel grant: Stop is shown, disabled, with the reason ────────
+
+/// Hostile: the agent grants no cancel. The Stop control is painted (not hidden) and labelled
+/// with the reason; using it sends nothing and leaves no error on the row. A card that tried
+/// anyway would get AcpThread's own refusal back as a row error.
+#[gpui::test]
+async fn test_native_subagent_without_cancel_shows_stop_disabled_with_the_reason(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), false);
+    rig.report_running(&alpha);
+    rig.connection.take_cancel_calls();
+    RENDERED_ARIA_LABELS.with_borrow_mut(Vec::clear);
+    rig.draw();
+
+    let id = rig.row_of(&alpha).expect("the child has a row").task.id;
+    let stop = selector(format!("tasks-card-stop-{id}"));
+    let bounds = rig
+        .cx
+        .debug_bounds(stop)
+        .expect("the Stop control is painted, disabled, not hidden");
+    let labels: Vec<String> = RENDERED_ARIA_LABELS
+        .with_borrow(|labels| labels.iter().map(|label| label.to_string()).collect());
+    assert!(
+        labels.iter().any(|label| label.contains(STOP_NOT_ALLOWED)),
+        "the disabled Stop names its reason: {labels:?}"
+    );
+
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+    assert!(!rig.cx.has_pending_prompt(), "a disabled Stop asks nothing");
+    let parent = rig.parent_session.clone();
+    let card = rig.card.clone();
+    card.update_in(&mut rig.cx, |card, window, cx| {
+        card.request_stop(parent, id.clone(), window, cx)
+    });
+    rig.cx.run_until_parked();
+    answer_stop_if_asked(&mut rig);
+
+    assert!(
+        rig.connection.take_cancel_calls().is_empty(),
+        "nothing is cancelled without the agent's grant"
+    );
+    let row = rig.row_of(&alpha).expect("still listed");
+    assert!(
+        row.error.is_none(),
+        "no error: the Stop was never tried ({:?})",
+        row.error
+    );
+    assert_eq!(
+        alpha.read_with(&rig.cx, |thread, _| thread.foreground_activity()),
+        ForegroundActivity::Running
+    );
+}
+
+/// Converse: the grant arriving later enables Stop — the reason is about the grant, not the
+/// child.
+#[gpui::test]
+async fn test_native_subagent_stop_follows_a_later_cancel_grant(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), false);
+    rig.report_running(&alpha);
+    alpha
+        .update(&mut rig.cx, |child, cx| {
+            child.update_subagent_association(
+                &acp_v2::SubagentUpdate::new("alpha").capabilities(
+                    acp_v2::SubagentSessionCapabilities::new()
+                        .cancel(acp_v2::SessionCancelCapabilities::new()),
+                ),
+                cx,
+            )
+        })
+        .expect("association update");
+    rig.cx.run_until_parked();
+    rig.connection.take_cancel_calls();
+
+    stop_row(&mut rig, &alpha);
+
+    assert_eq!(
+        rig.connection.take_cancel_calls(),
+        vec![acp_v2::SessionId::new("alpha")]
+    );
+}
+
+// ── R1.6 — Open navigates the conversation to the child ─────────────────────
+
+/// Hostile: Open on Bravo's row shows Bravo — not the parent whose group holds the row (which
+/// is what the card's Open does for a feed task) and not Alpha.
+#[gpui::test]
+async fn test_native_subagent_open_shows_that_child(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    rig.report_running(&alpha);
+    rig.report_running(&bravo);
+    assert_eq!(
+        rig.shown_session(),
+        Some(rig.parent_session.clone()),
+        "precondition: the conversation shows the parent"
+    );
+    rig.draw();
+
+    let id = rig.row_of(&bravo).expect("Bravo has a row").task.id;
+    let open = selector(format!("tasks-card-open-{id}"));
+    let bounds = rig.cx.debug_bounds(open).expect("Open is painted");
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        rig.shown_session(),
+        Some(acp_v2::SessionId::new("bravo")),
+        "Open navigates to the child, as the native card's Full Screen does"
+    );
+    // The parent is still the conversation's root: navigation, not a new conversation.
+    assert_eq!(
+        rig.panel.read_with(&rig.cx, |panel, cx| panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().clone())),
+        Some(rig.parent_session.clone())
+    );
+}
+
+/// An ended (idle) child's row still opens its child while it is on show.
+#[gpui::test]
+async fn test_native_subagent_open_on_an_ended_row(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    rig.report_idle(&alpha, acp_v2::StopReason::EndTurn);
+    rig.draw();
+    let Some(row) = rig.row_of(&alpha) else {
+        panic!("the ended row is on show right after the ending");
+    };
+    let open = selector(format!("tasks-card-open-{}", row.task.id));
+    let bounds = rig.cx.debug_bounds(open).expect("Open is painted");
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+    assert_eq!(rig.shown_session(), Some(acp_v2::SessionId::new("alpha")));
+}
+
+// ── R1.1 — a row within one frame of SubagentSpawned ────────────────────────
+
+/// The row appears on the spawn alone: no feed snapshot, no state report, no parent event
+/// other than `SubagentSpawned`. It is painted on the next frame.
+#[gpui::test]
+async fn test_native_subagent_row_appears_on_spawn(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    assert!(
+        !visible(&rig.card.clone(), &mut rig.cx),
+        "precondition: nothing on the card"
+    );
+
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.cx.run_until_parked();
+
+    let row = rig.row_of(&alpha).expect("the spawn alone adds the row");
+    assert!(visible(&rig.card.clone(), &mut rig.cx), "the card shows");
+    rig.draw();
+    let painted = selector(format!("tasks-card-row-{}", row.task.id));
+    assert!(
+        rig.cx.debug_bounds(painted).is_some(),
+        "the row is painted on the next frame"
+    );
+    assert_eq!(rig.rows_for(&alpha), 1, "one row per child");
+}
+
+/// Two children, two rows, each found by its own session.
+#[gpui::test]
+async fn test_native_subagent_two_children_are_two_rows(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", None, true);
+    rig.report_running(&alpha);
+    rig.report_running(&bravo);
+    rig.wait(Duration::from_millis(10));
+    assert_eq!(rig.rows_for(&alpha), 1);
+    assert_eq!(rig.rows_for(&bravo), 1);
+    let alpha_id = rig.row_of(&alpha).unwrap().task.id;
+    let bravo_id = rig.row_of(&bravo).unwrap().task.id;
+    assert_ne!(alpha_id, bravo_id, "each row has its own key");
+}
diff --git a/crates/agent_ui/src/tasks_card/sub_thread_row.rs b/crates/agent_ui/src/tasks_card/sub_thread_row.rs
new file mode 100644
index 0000000..811bf57
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/sub_thread_row.rs
@@ -0,0 +1,287 @@
+//! Story 040: sub-thread rows in the tasks card (design.md, SubThreadReporter, "Card rows").
+//!
+//! A sub-thread is a whole conversation, not a task of its parent, so its row offers only Open:
+//! Stop, Send to Background, Expand, Open Log and Open Thread belong to adapter tasks (R6.5).
+
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::v2::schema as acp_v2;
+use collections::HashSet;
+use gpui::{AnyElement, App, Context, SharedString};
+use ui::{Chip, prelude::*};
+
+use super::{
+    ENDED_ROW_TTL, RowControl, TaskKey, TasksCard, TasksCardEvent, ThreadGroup, card_tooltip,
+    format_duration, row_aria_label,
+};
+use crate::DEFAULT_THREAD_TITLE;
+use crate::sub_thread_reporter::{SubThreadActivity, SubThreadRecord, project_of};
+use crate::thread_metadata_store::ThreadMetadataStore;
+
+/// The prefix of a sub-thread item's task id in the history; reused here so a row's Open and its
+/// error share one key with nothing the adapter reports.
+const SUB_THREAD_KEY_PREFIX: &str = "zeo-sub-thread:";
+
+/// One sub-thread on the card: running, or idle for the ended window (R6.1, R6.3).
+#[derive(Clone, Debug)]
+pub struct SubThreadRow {
+    pub record: SubThreadRecord,
+    pub running: bool,
+    /// When it turned Idle, on the card's clock; `None` while running.
+    pub idle_since: Option<Instant>,
+}
+
+impl SubThreadRow {
+    fn on_show(&self, now: Instant) -> bool {
+        self.running
+            || self
+                .idle_since
+                .is_some_and(|since| now < since + ENDED_ROW_TTL)
+    }
+
+    fn started_at(&self) -> SystemTime {
+        let ms = u64::try_from(self.record.at_ms).unwrap_or_default();
+        UNIX_EPOCH + Duration::from_millis(ms)
+    }
+}
+
+/// The key a sub-thread row's Open control and its error live under.
+fn row_key(sub_session: &acp_v2::SessionId) -> TaskKey {
+    (
+        sub_session.clone(),
+        AgentTaskId::from(format!("{SUB_THREAD_KEY_PREFIX}{sub_session}")),
+    )
+}
+
+impl TasksCard {
+    /// Keeps the card's rows in step with what the reporter tells the history, so the card and
+    /// the panel never disagree about a sub-thread.
+    pub(crate) fn note_sub_thread_activity(
+        &mut self,
+        activity: &SubThreadActivity,
+        cx: &mut Context<Self>,
+    ) {
+        match activity {
+            SubThreadActivity::Linked(_) => return,
+            SubThreadActivity::Running(record) => {
+                self.sub_thread_rows.insert(
+                    record.sub_session.clone(),
+                    SubThreadRow {
+                        record: record.clone(),
+                        running: true,
+                        idle_since: None,
+                    },
+                );
+            }
+            SubThreadActivity::Idle(record) => {
+                let now = cx.background_executor().now();
+                let row = self
+                    .sub_thread_rows
+                    .entry(record.sub_session.clone())
+                    .or_insert_with(|| SubThreadRow {
+                        record: record.clone(),
+                        running: false,
+                        idle_since: None,
+                    });
+                row.running = false;
+                row.idle_since = Some(now);
+                row.record.title = record.title.clone();
+                self.schedule_expiry(cx);
+            }
+            SubThreadActivity::Retitled(record) => {
+                let Some(row) = self.sub_thread_rows.get_mut(&record.sub_session) else {
+                    return;
+                };
+                row.record.title = record.title.clone();
+            }
+        }
+        self.update_tick(cx);
+        cx.notify();
+    }
+
+    /// The rows on show now, keyed by nothing: each names its parent in its record.
+    pub(super) fn sub_thread_rows_on_show(&self, cx: &App) -> Vec<SubThreadRow> {
+        let now = cx.background_executor().now();
+        let mut rows: Vec<SubThreadRow> = self
+            .sub_thread_rows
+            .values()
+            .filter(|row| row.on_show(now))
+            .cloned()
+            .collect();
+        rows.sort_by(|a, b| {
+            (a.record.at_ms, &a.record.sub_session.0)
+                .cmp(&(b.record.at_ms, &b.record.sub_session.0))
+        });
+        rows
+    }
+
+    /// The earliest moment an idle row leaves the card, for `schedule_expiry`.
+    pub(super) fn earliest_sub_thread_expiry(&self) -> Option<Instant> {
+        self.sub_thread_rows
+            .values()
+            .filter(|row| !row.running)
+            .filter_map(|row| row.idle_since)
+            .map(|since| since + ENDED_ROW_TTL)
+            .min()
+    }
+
+    pub(super) fn expire_sub_thread_rows(&mut self, now: Instant) {
+        let expired: Vec<acp_v2::SessionId> = self
+            .sub_thread_rows
+            .iter()
+            .filter(|(_, row)| !row.on_show(now))
+            .map(|(session, _)| session.clone())
+            .collect();
+        for session in expired {
+            self.sub_thread_rows.remove(&session);
+            self.row_errors.remove(&row_key(&session));
+        }
+    }
+
+    pub(super) fn any_sub_thread_running(&self) -> bool {
+        self.sub_thread_rows.values().any(|row| row.running)
+    }
+
+    /// Opens the sub-thread itself through the card's open path; a failure comes back on the row
+    /// through `set_row_error` (R6.4).
+    fn open_sub_thread(&mut self, sub_session: acp_v2::SessionId, cx: &mut Context<Self>) {
+        let (session_id, task_id) = row_key(&sub_session);
+        cx.emit(TasksCardEvent::OpenTask {
+            session_id,
+            task_id,
+            tool_call_id: None,
+        });
+    }
+
+    /// The order key of a group made only of sub-thread rows, and of the sub-threads inside a
+    /// held parent's group: running first, by start.
+    pub(super) fn oldest_running_sub_thread(rows: &[SubThreadRow]) -> Option<SystemTime> {
+        rows.iter()
+            .filter(|row| row.running)
+            .map(SubThreadRow::started_at)
+            .min()
+    }
+
+    /// Groups for the sub-threads whose parent no panel of this card holds, headed by the
+    /// parent's metadata (R6.2).
+    pub(super) fn groups_of_unheld_parents(
+        rows: Vec<SubThreadRow>,
+        held: &HashSet<acp_v2::SessionId>,
+        cx: &App,
+    ) -> Vec<ThreadGroup> {
+        let mut groups: Vec<ThreadGroup> = Vec::new();
+        for row in rows {
+            let parent = row.record.parent_session.clone();
+            if held.contains(&parent) {
+                continue;
+            }
+            if let Some(group) = groups.iter_mut().find(|group| group.session_id == parent) {
+                group.sub_threads.push(row);
+                continue;
+            }
+            let metadata = ThreadMetadataStore::try_global(cx)
+                .and_then(|store| store.read(cx).entry_by_session(&parent).cloned());
+            let (title, project) = match metadata {
+                Some(metadata) => (metadata.display_title(), project_of(&metadata)),
+                None => (
+                    SharedString::new_static(DEFAULT_THREAD_TITLE),
+                    row.record.project.clone(),
+                ),
+            };
+            groups.push(ThreadGroup {
+                session_id: parent,
+                title,
+                project,
+                rows: Vec::new(),
+                sub_threads: vec![row],
+            });
+        }
+        groups
+    }
+
+    pub(super) fn render_sub_thread_row(
+        &mut self,
+        row: SubThreadRow,
+        now: SystemTime,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let sub = row.record.sub_session.clone();
+        let key = row_key(&sub);
+        let title = row.record.title.clone();
+        let error = self.row_errors.get(&key).map(|error| error.message.clone());
+        let state = if row.running {
+            let elapsed = now.duration_since(row.started_at()).unwrap_or_default();
+            format!("Running · {}", format_duration(elapsed))
+        } else {
+            "Idle".to_string()
+        };
+
+        let open_focus_handle = self.row_focus_handle(&key, RowControl::Open, cx);
+        let open_button = IconButton::new(
+            SharedString::from(format!("tasks-card-sub-thread-open-{sub}")),
+            IconName::ArrowUpRight,
+        )
+        .icon_size(IconSize::Small)
+        .icon_color(Color::Muted)
+        .aria_label(row_aria_label(format!("Open sub-thread: {title}")))
+        .tooltip(card_tooltip(
+            format!("sub-thread-open-{sub}").into(),
+            "Open Sub-thread".into(),
+        ))
+        .track_focus(&open_focus_handle)
+        .on_click(cx.listener({
+            let sub = sub.clone();
+            move |card, _, _, cx| card.open_sub_thread(sub.clone(), cx)
+        }));
+        let open_button = div()
+            .debug_selector({
+                let sub = sub.clone();
+                move || format!("tasks-card-sub-thread-open-{sub}")
+            })
+            .flex_none()
+            .child(open_button);
+
+        let line = h_flex()
+            .gap_1()
+            .min_w_0()
+            .child(
+                div()
+                    .flex_none()
+                    .child(Chip::new("Sub-thread").label_size(LabelSize::XSmall)),
+            )
+            .child(
+                div().flex_1().min_w_0().child(
+                    Label::new(title)
+                        .size(LabelSize::Small)
+                        .single_line()
+                        .truncate(),
+                ),
+            )
+            .child(
+                Label::new(state)
+                    .size(LabelSize::XSmall)
+                    .color(if row.running {
+                        Color::Accent
+                    } else {
+                        Color::Muted
+                    }),
+            )
+            .child(open_button);
+
+        v_flex()
+            .id(SharedString::from(format!("tasks-card-sub-thread-{sub}")))
+            .debug_selector(move || format!("tasks-card-sub-thread-{sub}"))
+            .pl_2()
+            .py_0p5()
+            .child(line)
+            .when_some(error, |this, error| {
+                this.child(
+                    Label::new(error)
+                        .size(LabelSize::XSmall)
+                        .color(Color::Error),
+                )
+            })
+            .into_any_element()
+    }
+}
diff --git a/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs b/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs
new file mode 100644
index 0000000..f0aad64
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs
@@ -0,0 +1,389 @@
+// Story 040, task 4.1 — sub-thread rows in the tasks card (R6.1–R6.5; Q11, Q12). Module path:
+// `tasks_card::sub_thread_row_tests` (the production rows live in `tasks_card/sub_thread_row.rs`).
+// Wired in `src/tasks_card.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/sub_thread_row_tests.rs"]
+//     mod sub_thread_row_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- tasks_card`. Fixtures:
+// `crate::sub_thread_test_support`.
+//
+// Contract (design.md §SubThreadReporter, "Card rows"):
+//   - `TasksCard::sub_thread_rows: HashMap<acp::SessionId, SubThreadRow>`, keyed by the
+//     sub-thread's session; `SubThreadRow { record, running: bool, idle_since: Option<Instant> }`;
+//   - a row is drawn while running and for `ENDED_ROW_TTL` after `Idle`, in the parent's group
+//     when the panel holds the parent, else in a group built from the parent's metadata;
+//   - the row offers only "Open" (Tab stop, tooltip, accessible label), which opens the
+//     sub-thread; no Stop, Send to Background, Expand, Open Log or Open Thread.
+// Assumed beyond design.md (one place each, rename here):
+//   - debug selectors `tasks-card-sub-thread-{sub session}` on the row and
+//     `tasks-card-sub-thread-open-{sub session}` on its Open control; the existing group header
+//     selector `tasks-card-open-group-{parent session}`;
+//   - Open's tooltip through the card's `card_tooltip`, name `sub-thread-open-{sub session}`, and
+//     its screen-reader label through `row_aria_label`, text `Open sub-thread: {title}`;
+//   - the card counts a sub-thread row as something to show (`is_visible`).
+//
+// Hostile halves first:
+//   - the sub-thread row carries none of the task controls, while the adapter rows beside it keep
+//     theirs, a subagent's "Open Thread" included (R6.5);
+//   - Open on the row opens the SUB-thread, not the parent whose group it sits in;
+//   - an idle row does not outlive the ended window; a running one is not dropped by it;
+//   - then the benign placement under a held and an unheld parent.
+
+use std::path::Path;
+use std::time::Duration;
+
+use agent_client_protocol::v1::schema as acp_v1;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Entity, Modifiers, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::{ENDED_ROW_TTL, RENDERED_ARIA_LABELS, TasksCard};
+use crate::sub_thread_test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+
+fn row_selector(sub: &acp_v2::SessionId) -> String {
+    format!("tasks-card-sub-thread-{sub}")
+}
+
+fn open_selector(sub: &acp_v2::SessionId) -> String {
+    format!("tasks-card-sub-thread-open-{sub}")
+}
+
+fn group_selector(parent: &acp_v2::SessionId) -> String {
+    format!("tasks-card-open-group-{parent}")
+}
+
+fn advance(cx: &mut VisualTestContext, duration: Duration) {
+    cx.executor().advance_clock(duration);
+    cx.run_until_parked();
+}
+
+fn sub_row_running(
+    card: &Entity<TasksCard>,
+    sub: &acp_v2::SessionId,
+    cx: &VisualTestContext,
+) -> Option<bool> {
+    card.read_with(cx, |card, _| {
+        card.sub_thread_rows.get(sub).map(|row| row.running)
+    })
+}
+
+/// One `_claude/tasks` wire task in the adapter's shape (story 012), for the adapter rows.
+fn wire_task(id: &str, kind: &str) -> serde_json::Value {
+    json!({
+        "id": id,
+        "toolCallId": format!("toolu_{id}"),
+        "type": kind,
+        "description": format!("Task {id}"),
+        "background": false,
+        "depth": 0,
+        "status": "running",
+        "startedAt": 1_000,
+        "endedAt": null,
+        "usage": null,
+        "lastTool": null,
+        "summary": null,
+        "hasOutput": false,
+        "tail": null,
+    })
+}
+
+fn send_tasks(conv: &Conv, tasks: Vec<serde_json::Value>, cx: &mut VisualTestContext) {
+    let mut meta = serde_json::Map::new();
+    meta.insert("_claude/tasks".to_string(), json!({ "tasks": tasks }));
+    conv.thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp_v1::SessionUpdate::SessionInfoUpdate(
+                    acp_v1::SessionInfoUpdate::new().meta(meta),
+                ),
+                cx,
+            )
+        })
+        .expect("the tasks snapshot applies");
+    cx.run_until_parked();
+}
+
+/// Starts a turn in `conv` that does not end until the returned sender answers.
+fn start_turn(
+    rig: &mut Rig,
+    conv: &Conv,
+) -> futures::channel::oneshot::Sender<anyhow::Result<acp_v1::PromptResponse>> {
+    let finish = rig.connection.defer_next_prompt_response();
+    set_composer(&conv.view, "a side question", &mut rig.cx);
+    conv.view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    finish
+}
+
+fn end_turn(
+    finish: futures::channel::oneshot::Sender<anyhow::Result<acp_v1::PromptResponse>>,
+    cx: &mut VisualTestContext,
+) {
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+        .expect("the turn is still waiting");
+    cx.run_until_parked();
+}
+
+/// A parent known only to the metadata store: not held by any agent panel.
+fn unheld_parent(cx: &mut VisualTestContext) -> (ThreadId, acp_v2::SessionId) {
+    let thread_id = ThreadId::new();
+    let session = acp_v2::SessionId::new("unheld-parent-session");
+    let now = chrono::Utc::now();
+    let folders = [Path::new("/elsewhere")];
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Away parent".into()),
+                    title_override: None,
+                    updated_at: now,
+                    created_at: Some(now),
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(
+                        &workspace::PathList::new(&folders),
+                    ),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (thread_id, session)
+}
+
+// ── R6.5: only Open, beside adapter rows that keep their controls ──────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_has_only_open_while_adapter_rows_keep_their_controls(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "shell"), wire_task("t2", "subagent")],
+        &mut rig.cx,
+    );
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    let sub = &child.session;
+    assert!(
+        painted(row_selector(sub), &mut rig.cx),
+        "the sub-thread row is drawn"
+    );
+    assert!(painted(open_selector(sub), &mut rig.cx), "with its Open");
+    for control in [
+        "stop",
+        "background",
+        "expand",
+        "open-log",
+        "open-thread",
+        "watch",
+    ] {
+        for id in [sub.to_string(), format!("zeo-sub-thread:{sub}")] {
+            assert!(
+                !painted(format!("tasks-card-{control}-{id}"), &mut rig.cx),
+                "no {control} on a sub-thread row"
+            );
+        }
+    }
+    assert!(
+        painted("tasks-card-stop-t1", &mut rig.cx),
+        "the adapter row keeps Stop"
+    );
+    assert!(
+        painted("tasks-card-background-t1", &mut rig.cx),
+        "and Send to Background"
+    );
+    assert!(
+        painted("tasks-card-open-thread-t2", &mut rig.cx),
+        "a subagent task keeps its Open Thread"
+    );
+}
+
+// ── R6.4: Open opens the sub-thread ────────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_open_shows_the_sub_thread_not_its_parent(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+    assert_eq!(
+        crate::test_support::active_session_id(&rig.panel, &rig.cx),
+        parent.session,
+        "precondition: the parent is in front"
+    );
+
+    let selector: &'static str = Box::leak(open_selector(&child.session).into_boxed_str());
+    let bounds = rig
+        .cx
+        .debug_bounds(selector)
+        .expect("the sub-thread row's Open is painted");
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        crate::test_support::active_session_id(&rig.panel, &rig.cx),
+        child.session,
+        "the sub-thread is shown"
+    );
+}
+
+// ── R6.3: Idle, then dropped after the ended window ────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_idle_row_stays_for_the_ended_window_then_goes(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let card = card(&rig);
+
+    let finish = start_turn(&mut rig, &child);
+    advance(&mut rig.cx, ENDED_ROW_TTL + Duration::from_secs(5));
+    draw(&mut rig.cx);
+    assert_eq!(
+        sub_row_running(&card, &child.session, &rig.cx),
+        Some(true),
+        "a running row is never dropped by the ended window"
+    );
+    assert!(painted(row_selector(&child.session), &mut rig.cx));
+
+    end_turn(finish, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert_eq!(
+        sub_row_running(&card, &child.session, &rig.cx),
+        Some(false),
+        "the row turns Idle"
+    );
+    assert!(
+        painted(row_selector(&child.session), &mut rig.cx),
+        "an Idle row stays on show"
+    );
+
+    advance(&mut rig.cx, ENDED_ROW_TTL + Duration::from_secs(1));
+    draw(&mut rig.cx);
+    assert!(
+        !painted(row_selector(&child.session), &mut rig.cx),
+        "dropped after the ended window"
+    );
+}
+
+// ── R6.1, R6.2: placement ──────────────────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_sits_in_the_held_parent_group(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let card = card(&rig);
+
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    assert!(
+        card.update(&mut rig.cx, |card, cx| card.is_visible(cx)),
+        "a running sub-thread alone puts the card on screen"
+    );
+    let header: &'static str = Box::leak(group_selector(&parent.session).into_boxed_str());
+    let row: &'static str = Box::leak(row_selector(&child.session).into_boxed_str());
+    let header = rig
+        .cx
+        .debug_bounds(header)
+        .expect("the parent's group is drawn");
+    let row = rig
+        .cx
+        .debug_bounds(row)
+        .expect("the sub-thread row is drawn");
+    assert!(
+        row.top() >= header.top(),
+        "the row sits under its parent's header"
+    );
+    assert!(
+        !painted(group_selector(&child.session), &mut rig.cx),
+        "the sub-thread gets no group of its own"
+    );
+    let parent_session = card.read_with(&rig.cx, |card, _| {
+        card.sub_thread_rows
+            .get(&child.session)
+            .map(|row| row.record.parent_session.clone())
+    });
+    assert_eq!(parent_session, Some(parent.session.clone()));
+}
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_of_an_unheld_parent_gets_the_parent_group(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent_id, parent_session) = unheld_parent(&mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    assert!(
+        painted(group_selector(&parent_session), &mut rig.cx),
+        "a group headed by the parent, though no panel holds it"
+    );
+    assert!(painted(row_selector(&child.session), &mut rig.cx));
+}
+
+// ── Q12: tooltip and accessible label ──────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_open_has_a_tooltip_and_an_accessible_label(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    let labels: Vec<String> =
+        RENDERED_ARIA_LABELS.with(|labels| labels.borrow().iter().map(|l| l.to_string()).collect());
+    assert!(
+        labels.iter().any(|label| label == "Open sub-thread: Child"),
+        "Open is labelled for screen readers: {labels:?}"
+    );
+
+    let selector: &'static str = Box::leak(open_selector(&child.session).into_boxed_str());
+    let bounds = rig.cx.debug_bounds(selector).expect("Open is painted");
+    rig.cx
+        .simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    advance(&mut rig.cx, Duration::from_secs(1));
+    draw(&mut rig.cx);
+    assert!(
+        painted(
+            format!("tasks-card-tooltip-sub-thread-open-{}", child.session),
+            &mut rig.cx
+        ),
+        "Open has a tooltip"
+    );
+}
diff --git a/crates/agent_ui/src/tasks_card/waiting_label_tests.rs b/crates/agent_ui/src/tasks_card/waiting_label_tests.rs
new file mode 100644
index 0000000..5ed7c77
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/waiting_label_tests.rs
@@ -0,0 +1,277 @@
+// Story 064, task 11.1 — a subagent that needs the operator reads "Waiting for you" on the tasks
+// card, never "Running" or "starting"; a running one keeps its progress line (R1.8). Fixup of
+// `0071`. Module path: `tasks_card::waiting_label`; wired in `src/tasks_card.rs` beside the other
+// card test modules:
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/waiting_label_tests.rs"]
+//     mod waiting_label;
+//
+// Validation filter: `cargo test -p agent_ui tasks_card`.
+//
+// Contract beyond design.md (adjust `second_line` below only): GPUI's test window records painted
+// BOUNDS, not painted text, so the text a row paints is read through a test-only sibling of
+// story 023's `progress_label`:
+//
+//     #[cfg(test)]
+//     pub(crate) fn row_progress_label(row: &TaskRow, now: SystemTime) -> Option<SharedString>
+//
+// — what an active row paints on its second line: "Waiting for you" (an elapsed time may follow)
+// while `row.status` is `TaskRowStatus::Waiting`, else exactly `progress_label(&row.task, now)`.
+// `progress_label` itself cannot carry the state: it reads `AgentTask`, whose status
+// `TaskRowStatus::to_task_status` folds Waiting into Running on purpose (design.md, "Waiting
+// text"), and that fold is kept for expiry, history and the tray.
+//
+// Hostile halves first:
+//   - Waiting must NOT collapse into Running: the row's text is not the "starting" progress line
+//     and says neither "Running" nor "starting" — and stays so when the feed enriches that child
+//     with tool use, which is what would bring `progress_activity` back;
+//   - Running must NOT split into Waiting: a running sibling in the same group, and a feed task of
+//     the same parent, keep their progress line — the state is the row's, not the group's;
+//   - Waiting must not stick: once the child runs again its row reads its progress line;
+//   - then the benign half: the waiting row is still a live row — painted, stoppable, no ended
+//     status, and `task.status` still Running.
+
+use std::time::SystemTime;
+
+use acp_thread::AgentTaskStatus;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Entity, TestAppContext};
+use serde_json::json;
+
+use super::native_subagent_support::*;
+use super::test_helpers::*;
+use super::{TaskRow, TaskRowStatus};
+
+/// The status text R1.8 names, byte for byte.
+const WAITING: &str = "Waiting for you";
+
+fn second_line(row: &TaskRow, now: SystemTime) -> Option<String> {
+    super::row_progress_label(row, now).map(|text| text.to_string())
+}
+
+fn progress_line(row: &TaskRow, now: SystemTime) -> Option<String> {
+    super::progress_label(&row.task, now).map(|text| text.to_string())
+}
+
+fn report_waiting(rig: &mut SubagentRig, child: &Entity<acp_thread::AcpThread>) {
+    rig.report(
+        child,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+    );
+}
+
+fn assert_reads_waiting(text: Option<String>, what: &str) {
+    let text = text.unwrap_or_else(|| panic!("{what}: a waiting row paints a status line"));
+    assert!(
+        text.starts_with(WAITING),
+        "{what}: a waiting row reads {WAITING:?}, it read {text:?}"
+    );
+    assert!(
+        !text.contains("Running") && !text.contains("starting"),
+        "{what}: a waiting row never reads \"Running\" or \"starting\": {text:?}"
+    );
+}
+
+// ── R1.8 — Waiting is not Running ───────────────────────────────────────────
+
+/// Hostile: a child in RequiresAction. Today the card paints it as a running row that has not
+/// used a tool yet — "starting · 0s".
+#[gpui::test]
+async fn test_tasks_card_waiting_child_reads_waiting_for_you(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    report_waiting(&mut rig, &alpha);
+    let row = rig.row_of(&alpha).expect("the waiting child has a row");
+    assert_eq!(
+        row.status,
+        TaskRowStatus::Waiting,
+        "precondition: the merger reads the child as Waiting"
+    );
+
+    let now = SystemTime::now();
+    assert_reads_waiting(second_line(&row, now), "Alpha");
+    assert_ne!(
+        second_line(&row, now),
+        progress_line(&row, now),
+        "the waiting text replaces the progress line"
+    );
+}
+
+/// Hostile: the feed names the waiting child and reports tool use. Enrichment brings the last
+/// tool and the count onto the row's task — which is exactly what `progress_activity` prints —
+/// but the row still reads Waiting.
+#[gpui::test]
+async fn test_tasks_card_waiting_child_enriched_by_the_feed_still_reads_waiting(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    report_waiting(&mut rig, &alpha);
+    let mut entry = wire_task("feed-alpha", "running", true, 1_000);
+    entry["type"] = json!("subagent");
+    entry["childSessionId"] = json!("alpha");
+    entry["lastTool"] = json!("Bash");
+    entry["usage"] = json!({ "tokens": 900, "toolUses": 3, "durationMs": 2_000 });
+    let parent = rig.parent.clone();
+    send_tasks(&parent, vec![entry], &mut rig.cx);
+
+    assert_eq!(
+        rig.rows_for(&alpha),
+        1,
+        "the feed entry folds into the child's row"
+    );
+    let row = rig.row_of(&alpha).expect("the waiting child has a row");
+    assert_eq!(
+        row.status,
+        TaskRowStatus::Waiting,
+        "the registry's status wins"
+    );
+    assert_eq!(
+        row.task.last_tool.as_deref(),
+        Some("Bash"),
+        "precondition: the feed enriched the row"
+    );
+    let now = SystemTime::now();
+    assert_reads_waiting(second_line(&row, now), "Alpha, enriched");
+    assert!(
+        !second_line(&row, now).unwrap_or_default().contains("Bash"),
+        "the tool line does not come back while the child waits"
+    );
+}
+
+// ── R1.8 converse — Running is not Waiting ──────────────────────────────────
+
+/// Hostile converse: Alpha waits, Bravo runs, in the same parent's group. Bravo keeps its
+/// progress line; only Alpha's row changes.
+#[gpui::test]
+async fn test_tasks_card_running_sibling_of_a_waiting_child_keeps_its_progress(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    let bravo = rig.spawn_child("bravo", Some("Bravo"), true);
+    report_waiting(&mut rig, &alpha);
+    rig.report_running(&bravo);
+
+    let now = SystemTime::now();
+    let alpha_row = rig.row_of(&alpha).expect("Alpha's row");
+    let bravo_row = rig.row_of(&bravo).expect("Bravo's row");
+    assert_eq!(bravo_row.status, TaskRowStatus::Running);
+    let bravo_text = second_line(&bravo_row, now);
+    assert_eq!(
+        bravo_text,
+        progress_line(&bravo_row, now),
+        "a running child keeps its progress line"
+    );
+    assert!(
+        bravo_text
+            .as_deref()
+            .is_some_and(|text| text.starts_with("starting") && !text.contains(WAITING)),
+        "Bravo has used no tool yet: {bravo_text:?}"
+    );
+    assert_reads_waiting(second_line(&alpha_row, now), "Alpha");
+}
+
+/// Hostile converse, third element: a feed task of the same parent — no registry, no Waiting
+/// state — keeps the progress line it has always had.
+#[gpui::test]
+async fn test_tasks_card_feed_task_beside_a_waiting_child_keeps_its_progress(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    report_waiting(&mut rig, &alpha);
+    let parent = rig.parent.clone();
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut rig.cx,
+    );
+
+    let parent_session = rig.parent_session.clone();
+    let card = rig.card.clone();
+    let feed_row =
+        find_row(&card, &parent_session, "t1", &mut rig.cx).expect("the feed task has a row");
+    assert_eq!(feed_row.status, TaskRowStatus::Running);
+    let now = SystemTime::now();
+    let text = second_line(&feed_row, now);
+    assert_eq!(text, progress_line(&feed_row, now));
+    assert!(
+        text.as_deref().is_some_and(|text| !text.contains(WAITING)),
+        "a feed task never reads Waiting: {text:?}"
+    );
+    assert_reads_waiting(
+        second_line(&rig.row_of(&alpha).expect("Alpha's row"), now),
+        "Alpha",
+    );
+}
+
+/// Waiting does not stick: the operator answers, the child runs again, and its row reads its
+/// progress line once more.
+#[gpui::test]
+async fn test_tasks_card_child_running_again_after_waiting_reads_its_progress(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    rig.report_running(&alpha);
+    report_waiting(&mut rig, &alpha);
+    let now = SystemTime::now();
+    assert_reads_waiting(
+        second_line(&rig.row_of(&alpha).expect("Alpha's row"), now),
+        "Alpha, waiting",
+    );
+
+    rig.report_running(&alpha);
+
+    let row = rig.row_of(&alpha).expect("Alpha's row");
+    assert_eq!(row.status, TaskRowStatus::Running);
+    let now = SystemTime::now();
+    let text = second_line(&row, now);
+    assert_eq!(text, progress_line(&row, now), "back to the progress line");
+    assert!(
+        text.as_deref().is_some_and(|text| !text.contains(WAITING)),
+        "{text:?}"
+    );
+}
+
+// ── Benign — the waiting row is still a live row ────────────────────────────
+
+/// The waiting row is painted with its Stop, paints no ended status (which is where an
+/// "Running"/"Completed" word would sit), and its task status is still Running: expiry,
+/// history and the tray read that fold and must not change.
+#[gpui::test]
+async fn test_tasks_card_waiting_row_stays_a_live_row(cx: &mut TestAppContext) {
+    let mut rig = subagent_rig(cx).await;
+    let alpha = rig.spawn_child("alpha", Some("Alpha"), true);
+    report_waiting(&mut rig, &alpha);
+    rig.draw();
+
+    let row = rig.row_of(&alpha).expect("Alpha's row");
+    assert_eq!(
+        row.task.status,
+        AgentTaskStatus::Running,
+        "the AgentTask fold stays Running (expiry, history, tray)"
+    );
+    let id = row.task.id.clone();
+    assert!(
+        rig.cx
+            .debug_bounds(selector(format!("tasks-card-row-{id}")))
+            .is_some(),
+        "the waiting row is painted"
+    );
+    assert!(
+        rig.cx
+            .debug_bounds(selector(format!("tasks-card-stop-{id}")))
+            .is_some(),
+        "a waiting child keeps its Stop"
+    );
+    assert!(
+        rig.cx
+            .debug_bounds(selector(format!("tasks-card-ended-{id}")))
+            .is_none(),
+        "a waiting row paints no ended status"
+    );
+    assert_reads_waiting(second_line(&row, SystemTime::now()), "Alpha");
+}
