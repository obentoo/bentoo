diff --git a/crates/agent_tasks_panel/src/history_db/sub_thread.rs b/crates/agent_tasks_panel/src/history_db/sub_thread.rs
new file mode 100644
index 0000000..251e1e3
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/sub_thread.rs
@@ -0,0 +1,135 @@
+//! Story 040: the writes of a sub-thread item. A sub-thread is recorded under its parent's
+//! session, with a task id of its own, so it groups with the parent's tasks and archives and
+//! deletes through the same `TaskKey` paths (design.md, TaskHistoryStore and AgentTaskHistoryDb).
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_ui::{SubThreadRecord, TaskKey};
+use anyhow::{Context as _, Result};
+use db::sqlez_macros::sql;
+
+use super::{AgentTaskHistoryDb, TaskOrigin};
+
+/// Prefixed so a sub-thread's id never equals an id the adapter chose for a task of the same
+/// session. The prefix alone guarantees nothing, an adapter may pick any id, which is why both
+/// writes below are guarded on the stored origin.
+pub const SUB_THREAD_TASK_PREFIX: &str = "zeo-sub-thread:";
+
+/// The `kind` of a sub-thread item. Display only: the origin column decides what an item is.
+pub const SUB_THREAD_KIND: &str = "sub_thread";
+
+pub fn sub_thread_task_id(record: &SubThreadRecord) -> String {
+    format!("{SUB_THREAD_TASK_PREFIX}{}", record.sub_session)
+}
+
+/// The tombstone write of `delete` (R5.10). Session ids only: the title is user text (R8.1). A
+/// stored id without the prefix is logged as it is.
+pub(super) fn log_tombstone(parent_session: &str, task_id: &str) {
+    let sub_session = task_id
+        .strip_prefix(SUB_THREAD_TASK_PREFIX)
+        .unwrap_or(task_id);
+    log::info!(
+        "zeo_sub_thread event=history_write parent_session={parent_session} \
+         sub_session={sub_session} status=deleted result=ok"
+    );
+}
+
+/// Both sessions name the item in an error; the title is user text and never does.
+fn sessions_of(record: &SubThreadRecord) -> String {
+    format!(
+        "sub-thread {} of session {}",
+        record.sub_session, record.parent_session
+    )
+}
+
+impl AgentTaskHistoryDb {
+    /// Records a sub-thread item, or refreshes its status, description and end on a repeat
+    /// (R5.2, R5.3, R5.5). `status` is the stored text, `running` or `completed`; a running item
+    /// has no end. A conflict never touches `archived`, and never a row the adapter wrote on the
+    /// same key (R5.7).
+    pub async fn upsert_sub_thread(&self, record: &SubThreadRecord, status: &str) -> Result<()> {
+        let sessions = sessions_of(record);
+        let ended_at = (status != "running").then_some(record.at_ms);
+        // Every literal is bound: a single-quoted SQL string inside `sql!` does not compile.
+        let identity = (
+            record.parent_session.to_string(),
+            sub_thread_task_id(record),
+            record.project.to_string(),
+            SUB_THREAD_KIND,
+            record.title.to_string(),
+        );
+        let state = (
+            status.to_string(),
+            record.at_ms,
+            TaskOrigin::SubThread.as_text(),
+            ended_at,
+        );
+        self.write(move |connection| {
+            connection.exec_bound(sql!(
+                INSERT INTO agent_task_history(
+                    session_id, task_id, thread_title, project, kind, description, background,
+                    status, started_at, origin, ended_at
+                ) VALUES (?1, ?2, NULL, ?3, ?4, ?5, 0, ?6, ?7, ?8, ?9)
+                ON CONFLICT(session_id, task_id) DO UPDATE SET
+                    status = excluded.status,
+                    description = excluded.description,
+                    ended_at = excluded.ended_at
+                WHERE agent_task_history.origin = ?8 AND agent_task_history.deleted = 0
+            ))?((identity, state))
+        })
+        .await
+        .with_context(|| format!("recording {sessions} as {status}"))
+    }
+
+    /// What `Linked` and `Retitled` write: a new item is recorded Idle, an existing one gets only
+    /// its description. Status and end are left alone, so a second window's `Linked` cannot flip
+    /// a running sub-thread to Idle (R5.3, R7.4).
+    pub async fn record_sub_thread_link(&self, record: &SubThreadRecord) -> Result<()> {
+        let sessions = sessions_of(record);
+        let identity = (
+            record.parent_session.to_string(),
+            sub_thread_task_id(record),
+            record.project.to_string(),
+            SUB_THREAD_KIND,
+            record.title.to_string(),
+        );
+        let state = (
+            "completed",
+            record.at_ms,
+            TaskOrigin::SubThread.as_text(),
+            record.at_ms,
+        );
+        self.write(move |connection| {
+            connection.exec_bound(sql!(
+                INSERT INTO agent_task_history(
+                    session_id, task_id, thread_title, project, kind, description, background,
+                    status, started_at, origin, ended_at
+                ) VALUES (?1, ?2, NULL, ?3, ?4, ?5, 0, ?6, ?7, ?8, ?9)
+                ON CONFLICT(session_id, task_id) DO UPDATE SET
+                    description = excluded.description
+                WHERE agent_task_history.origin = ?8 AND agent_task_history.deleted = 0
+            ))?((identity, state))
+        })
+        .await
+        .with_context(|| format!("recording the link of {sessions}"))
+    }
+
+    /// The keys of the deleted sub-thread items (R5.10). The store seeds its `deleted` set with
+    /// them before any replayed `Linked` is applied, so a restart does not list them again.
+    pub async fn deleted_sub_thread_keys(&self) -> Result<Vec<TaskKey>> {
+        let keys = self.select_bound::<&str, (String, String)>(sql!(
+            SELECT session_id, task_id FROM agent_task_history
+            WHERE deleted = 1 AND origin = ?1
+        ))?(TaskOrigin::SubThread.as_text())
+        .context("loading the deleted sub-thread items")?;
+        Ok(keys
+            .into_iter()
+            .map(|(session_id, task_id)| {
+                (
+                    acp_v2::SessionId::new(session_id),
+                    AgentTaskId::from(task_id),
+                )
+            })
+            .collect())
+    }
+}
diff --git a/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs b/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs
new file mode 100644
index 0000000..e487520
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/sub_thread_upsert_tests.rs
@@ -0,0 +1,308 @@
+// Story 040, task 3.2 (database half) — `AgentTaskHistoryDb::upsert_sub_thread`: one statement that
+// records or refreshes a sub-thread item (R5.1, R5.2, R5.5, R5.7; Q14). Module path:
+// `history_db::sub_thread_upsert`. Wired in `src/history_db.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/sub_thread_upsert_tests.rs"]
+//     mod sub_thread_upsert;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- sub_thread` (names carry
+// `history_db_sub_thread`).
+//
+// Contract (design.md §TaskHistoryStore and AgentTaskHistoryDb, revised 2026-10-20):
+//   - `AgentTaskHistoryDb::upsert_sub_thread(&SubThreadRecord, status: &str)`, one
+//     `INSERT … ON CONFLICT(session_id, task_id) DO UPDATE … WHERE agent_task_history.origin =
+//     'sub_thread'` statement (every literal bound as `?n`): `session_id` = the parent's session,
+//     `task_id = 'zeo-sub-thread:' || sub_session`, `kind = 'sub_thread'`, `description` = the
+//     title, `origin = 'sub_thread'`; a conflict refreshes status, description and `ended_at`,
+//     never `archived`; an error names both session ids;
+//   - `AgentTaskHistoryDb::record_sub_thread_link(&SubThreadRecord)`, the same INSERT with status
+//     `completed`, whose conflict updates the DESCRIPTION ONLY (never status or `ended_at`), under
+//     the same origin guard — what `Linked` and `Retitled` write;
+//   - `agent_ui::SubThreadRecord { parent_session, sub_session, title, project, at_ms }`.
+// Assumed beyond design.md: both methods are `async` and return `anyhow::Result<()>` like every
+// other writer of this domain; `SubThreadRecord`'s fields are `pub` and it is `Clone`. Adjust in
+// `upsert`, `link_item` and `sub_record` only.
+//
+// Hostile halves first:
+//   - wrongly collapse: two sub-threads of one parent are two items; a sub-thread whose session id
+//     equals an adapter task id of the parent's session is a separate item;
+//   - a THIRD element against the derived key: an adapter task whose id is literally
+//     `zeo-sub-thread:<sub session>` already sits on the key both writers derive. Neither may
+//     rewrite that adapter row (its origin, kind, description and status stay) — the origin guard;
+//   - a link re-reported while the sub-thread runs (a second window's `Linked`, a `Retitled`)
+//     must not flip it to Idle: `record_sub_thread_link` leaves status and `ended_at` alone;
+//   - wrongly split: the same sub-thread reported again, running, idle and retitled, stays ONE
+//     item;
+//   - then the benign shape of a fresh item.
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::SubThreadRecord;
+use gpui::TestAppContext;
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn sub_record(parent: &str, sub: &str, title: &str, at_ms: i64) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: sid(parent),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms,
+    }
+}
+
+async fn upsert(db: &AgentTaskHistoryDb, record: &SubThreadRecord, status: &str) {
+    db.upsert_sub_thread(record, status)
+        .await
+        .expect("upsert_sub_thread should succeed");
+}
+
+async fn link_item(db: &AgentTaskHistoryDb, record: &SubThreadRecord) {
+    db.record_sub_thread_link(record)
+        .await
+        .expect("record_sub_thread_link should succeed");
+}
+
+fn item<'a>(rows: &'a [HistoryEntry], parent: &str, sub: &str) -> Option<&'a HistoryEntry> {
+    find(rows, parent, &format!("{PREFIX}{sub}"))
+}
+
+fn items_of(rows: &[HistoryEntry], parent: &str) -> usize {
+    rows.iter()
+        .filter(|entry| {
+            entry.record.session_id.to_string() == parent && entry.origin == TaskOrigin::SubThread
+        })
+        .count()
+}
+
+// ── Wrongly collapse ───────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_two_sub_threads_of_one_parent_are_two_items(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_two").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "completed").await;
+    upsert(&db, &sub_record("p1", "sub-b", "Bravo", 2_000), "running").await;
+
+    let rows = load(&db).await;
+    assert_eq!(items_of(&rows, "p1"), 2, "one item per sub-thread");
+    let a = item(&rows, "p1", "sub-a").expect("sub-a is recorded");
+    let b = item(&rows, "p1", "sub-b").expect("sub-b is recorded");
+    assert_eq!(a.record.description.as_ref(), "Alpha");
+    assert_eq!(b.record.description.as_ref(), "Bravo");
+    assert_eq!(a.record.status, AgentTaskStatus::Completed);
+    assert_eq!(b.record.status, AgentTaskStatus::Running);
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_session_named_like_an_adapter_task_is_a_separate_item(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_like_task").await;
+    db.insert_started(&record("p1", "s-sub", AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+    upsert(&db, &sub_record("p1", "s-sub", "Side", 2_000), "completed").await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", "s-sub").expect("the adapter task is kept");
+    assert_eq!(task.origin, TaskOrigin::Adapter);
+    assert_eq!(task.record.description.as_ref(), "Task s-sub");
+    assert_eq!(task.record.status, AgentTaskStatus::Running);
+    let sub = item(&rows, "p1", "s-sub").expect("the sub-thread item is recorded beside it");
+    assert_eq!(sub.origin, TaskOrigin::SubThread);
+}
+
+// The derived key's third element: an adapter task already holding `zeo-sub-thread:<sub>`.
+#[gpui::test]
+async fn history_db_sub_thread_upsert_never_rewrites_an_adapter_row_on_its_key(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_third").await;
+    let squatter = format!("{PREFIX}s-sub");
+    db.insert_started(&record("p1", &squatter, AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+
+    // Whether the write is refused or ignored is the implementation's; the adapter row is not.
+    let _outcome = db
+        .upsert_sub_thread(&sub_record("p1", "s-sub", "Side", 2_000), "completed")
+        .await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", &squatter).expect("the adapter row is still there");
+    assert_eq!(task.origin, TaskOrigin::Adapter, "still an adapter task");
+    assert_eq!(task.record.kind.as_ref(), "shell", "its kind is kept");
+    assert_eq!(
+        task.record.description.as_ref(),
+        format!("Task {squatter}"),
+        "its description is not replaced by the sub-thread's title"
+    );
+    assert_eq!(
+        task.record.status,
+        AgentTaskStatus::Running,
+        "its status is not replaced by the sub-thread's"
+    );
+}
+
+// ── record_sub_thread_link: description only (R5.2, R5.3, R5.5) ────────────
+
+#[gpui::test]
+async fn history_db_sub_thread_link_on_a_running_item_updates_only_the_description(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_running").await;
+    upsert(&db, &sub_record("p1", "sub-a", "Alpha", 1_000), "running").await;
+
+    // A second window's reporter links it again, then the title changes.
+    link_item(&db, &sub_record("p1", "sub-a", "Alpha", 2_000)).await;
+    link_item(&db, &sub_record("p1", "sub-a", "Alpha renamed", 3_000)).await;
+
+    let rows = load(&db).await;
+    assert_eq!(rows.len(), 1, "still one item: {rows:?}");
+    let entry = item(&rows, "p1", "sub-a").expect("recorded");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Running,
+        "a re-reported link never flips a running sub-thread to Idle"
+    );
+    assert_eq!(entry.record.ended_at_ms, None, "nor gives it an end");
+    assert_eq!(entry.record.started_at_ms, 1_000, "nor moves its start");
+    assert_eq!(entry.record.description.as_ref(), "Alpha renamed");
+}
+
+#[gpui::test]
+async fn history_db_sub_thread_link_never_rewrites_an_adapter_row_on_its_key(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_sub_thread_link_third").await;
+    let squatter = format!("{PREFIX}s-sub");
+    db.insert_started(&record("p1", &squatter, AgentTaskStatus::Running, 1_000))
+        .await
+        .expect("insert_started should succeed");
+
+    let _outcome = db
+        .record_sub_thread_link(&sub_record("p1", "s-sub", "Side", 2_000))
+        .await;
+
+    let rows = load(&db).await;
+    let task = find(&rows, "p1", &squatter).expect("the adapter row is still there");
