@@ -0,0 +1,68 @@
+// Story 040, task 12.3 (validation fix round 1, audit claim Q12): the two Send to Parent choices
+// carry a screen-reader label each, enabled or not, and a disabled one names why (R1.6). GPUI's
+// test windows never activate their accessibility tree, so the labels of the last render are read
+// from `control::RENDERED_CHOICE_LABELS`, the card's pattern (`tasks_card::RENDERED_ARIA_LABELS`).
+
+use gpui::{Modifiers, TestAppContext, VisualTestContext};
+
+use super::control::RENDERED_CHOICE_LABELS;
+use crate::sub_thread_test_support::*;
+
+const LAST_REPLY_LABEL: &str =
+    "Send Last Reply: put this sub-thread's last reply in the parent thread's composer";
+const SUMMARIZE_LABEL: &str = "Summarize and Send: ask this sub-thread for a summary, then put it in the parent thread's composer";
+
+fn open_menu(cx: &mut VisualTestContext) -> Vec<String> {
+    RENDERED_CHOICE_LABELS.with_borrow_mut(Vec::clear);
+    let bounds = cx
+        .debug_bounds("send-to-parent")
+        .unwrap_or_else(|| panic!("the control is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    cx.run_until_parked();
+    draw(cx);
+    RENDERED_CHOICE_LABELS.with_borrow(|labels| labels.iter().map(ToString::to_string).collect())
+}
+
+#[gpui::test]
+async fn send_to_parent_control_choices_carry_accessible_labels(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+
+    let labels = open_menu(&mut rig.cx);
+
+    assert!(
+        labels.iter().any(|label| label == LAST_REPLY_LABEL),
+        "Send Last Reply is named: {labels:?}"
+    );
+    assert!(
+        labels.iter().any(|label| label == SUMMARIZE_LABEL),
+        "Summarize and Send is named: {labels:?}"
+    );
+}
+
+#[gpui::test]
+async fn send_to_parent_control_disabled_choices_name_why(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = rig.connection.defer_next_prompt_response();
+    set_composer(&child.view, "still thinking", &mut rig.cx);
+    child
+        .view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    draw(&mut rig.cx);
+
+    let labels = open_menu(&mut rig.cx);
+
+    for name in ["Send Last Reply", "Summarize and Send"] {
+        let expected = format!("{name}, unavailable: Wait for the turn to end");
+        assert!(labels.contains(&expected), "{expected:?} among {labels:?}");
+    }
+}
diff --git a/crates/agent_ui/src/sub_thread_send/control.rs b/crates/agent_ui/src/sub_thread_send/control.rs
new file mode 100644
index 0000000..1918051
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/control.rs
@@ -0,0 +1,147 @@
+//! Story 040, the footer control: a "Send to Parent" menu button on a sub-thread's composer, with
+//! "Send Last Reply" and "Summarize and Send" (R1).
+
+use gpui::{AnyElement, Context, Entity, Role, SharedString, Window};
+use ui::{ContextMenu, PopoverMenu, Tooltip, prelude::*};
+
+use super::{ParentLink, availability, parent_link};
+use crate::conversation_view::ThreadView;
+
+// GPUI's test windows never activate their accessibility tree, so tests read the choices'
+// screen-reader labels of the last render from here (the card's `RENDERED_ARIA_LABELS`).
+#[cfg(test)]
+thread_local! {
+    pub(crate) static RENDERED_CHOICE_LABELS: std::cell::RefCell<Vec<SharedString>> =
+        std::cell::RefCell::default();
+}
+
+/// A choice's screen-reader label, recorded in test builds (see `RENDERED_CHOICE_LABELS`).
+fn choice_aria_label(label: &str, state: &Result<(), SharedString>, purpose: &str) -> SharedString {
+    let aria_label = SharedString::from(match state {
+        Ok(()) => format!("{label}: {purpose}"),
+        Err(reason) => format!("{label}, unavailable: {reason}"),
+    });
+    #[cfg(test)]
+    RENDERED_CHOICE_LABELS.with_borrow_mut(|labels| labels.push(aria_label.clone()));
+    aria_label
+}
+
+/// One choice of the menu: a selectable entry when enabled, otherwise an inert row whose tooltip
+/// says why (R1.4, R1.5). Both carry an accessible label (R1.6): a div with no role never reaches
+/// the accessibility tree, and `ContextMenu` labels only its own string entries, so the content
+/// is given the `Label` role.
+fn choice(
+    menu: ContextMenu,
+    selector: &'static str,
+    label: &'static str,
+    purpose: &'static str,
+    state: Result<(), SharedString>,
+    view: Entity<ThreadView>,
+    run: fn(&mut ThreadView, &mut Window, &mut Context<ThreadView>),
+) -> ContextMenu {
+    match state {
+        Ok(()) => menu.custom_entry(
+            move |_, _| {
+                div()
+                    .id(selector)
+                    .role(Role::Label)
+                    .aria_label(choice_aria_label(label, &Ok(()), purpose))
+                    .debug_selector(move || selector.into())
+                    .tooltip(Tooltip::text(purpose))
+                    .child(Label::new(label))
+                    .into_any_element()
+            },
+            move |window, cx| view.update(cx, |view, cx| run(view, window, cx)),
+        ),
+        Err(reason) => menu.custom_row(move |_, _| {
+            let state = Err(reason.clone());
+            div()
+                .id(selector)
+                .role(Role::Label)
+                .aria_label(choice_aria_label(label, &state, purpose))
+                .debug_selector(move || selector.into())
+                .tooltip(Tooltip::text(reason.clone()))
+                .child(Label::new(label).color(Color::Disabled))
+                .into_any_element()
+        }),
+    }
+}
+
+impl ThreadView {
+    /// The control under a sub-thread's composer; nothing for a thread that is not a sub-thread
+    /// or where no organization store exists (R1.1, R1.2).
+    pub(crate) fn render_send_to_parent(
+        &mut self,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        let link = parent_link(self.root_thread_id, cx);
+        if link == ParentLink::None {
+            return None;
+        }
+        let available = availability(&link, self.thread.read(cx), &self.send_to_parent);
+        let view = cx.entity();
+        let menu = PopoverMenu::new("send-to-parent-menu")
+            .trigger_with_tooltip(
+                Button::new("send-to-parent", "Send to Parent")
+                    .label_size(LabelSize::Small)
+                    .track_focus(&self.send_to_parent_focus_handle)
+                    .aria_label("Send to Parent: send this sub-thread's reply to its parent"),
+                Tooltip::text("Send this sub-thread's reply to its parent thread"),
+            )
+            .menu(move |window, cx| {
+                let view = view.clone();
+                let last_reply = available.last_reply.clone();
+                let summarize = available.summarize.clone();
+                Some(ContextMenu::build(window, cx, move |menu, _, _| {
+                    let menu = choice(
+                        menu,
+                        "send-to-parent-last-reply",
+                        "Send Last Reply",
+                        "put this sub-thread's last reply in the parent thread's composer",
+                        last_reply,
+                        view.clone(),
+                        ThreadView::send_last_reply,
+                    );
+                    choice(
+                        menu,
+                        "send-to-parent-summarize",
+                        "Summarize and Send",
+                        "ask this sub-thread for a summary, then put it in the parent thread's composer",
+                        summarize,
+                        view,
+                        ThreadView::summarize_and_send,
+                    )
+                }))
+            });
+        let notice = self.send_to_parent.notice.clone().map(|notice| {
+            div()
+                .debug_selector(|| "send-to-parent-notice".into())
+                .child(
+                    Label::new(notice)
+                        .size(LabelSize::XSmall)
+                        .color(Color::Muted),
+                )
+        });
+        Some(
+            v_flex()
+                .gap_0p5()
+                .child(
+                    // Sized to the button, so the selector's centre is on it.
+                    h_flex().child(
+                        div()
+                            .flex_none()
+                            .debug_selector(|| "send-to-parent".into())
+                            .child(menu),
+                    ),
+                )
+                .children(notice)
+                .into_any_element(),
+        )
+    }
+
+    #[cfg(test)]
+    pub(crate) fn send_to_parent_focus_handle(&self) -> &gpui::FocusHandle {
+        &self.send_to_parent_focus_handle
+    }
+}
diff --git a/crates/agent_ui/src/sub_thread_send/deliver_to_parent_tests.rs b/crates/agent_ui/src/sub_thread_send/deliver_to_parent_tests.rs
new file mode 100644
index 0000000..77594f5
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/deliver_to_parent_tests.rs
@@ -0,0 +1,406 @@
+// Story 040, task 7.1 — Send Last Reply and `deliver_to_parent`: the block lands in the parent's
+// composer, unsent, after any draft, wherever the parent is (R2.1–R2.5, R4.1–R4.3, R8.1; Q4,
+// Q11). Module path: `sub_thread_send::deliver_to_parent_tests`. Wired in
+// `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/deliver_to_parent_tests.rs"]
+//     mod deliver_to_parent_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- deliver_to_parent`. Fixtures:
+// `crate::sub_thread_test_support`; log capture: `crate::thread_organization::test_helpers`
+// (pub(crate)), the one logger this test binary shares — a second `set_logger` would panic.
+//
+// Contract (design.md §deliver_to_parent, §SendToParentControl):
+//   - `ThreadView::send_last_reply(&mut self, window, cx)` → `compose_block(title,
+//     last_reply_text)` → `deliver_to_parent(parent_session, block, origin, window, cx)`;
+//   - an open view of the parent in ANY window is used first; else `open_agent_session`, and the
+//     view is looked up again after the await; `Err(e)` → notice "Could not open the parent
+//     thread: {e:#}" on the sub-thread, a warning with both ids, nothing inserted;
+//   - `append_to_composer`: cursor to the end, `"\n\n"` first when the buffer is not empty, then
+//     the block; the editor is focused; nothing is sent; the parent's window and panel come
+//     forward;
+//   - every later exit that inserts nothing (no view after the await, the origin view gone, a
+//     window activation `Err`) warns `event=deliver_lost` and sets the notice when it can;
+//   - `zeo_sub_thread event=delivered|open_failed|deliver_lost` with session ids and `chars=N`,
+//     never text.
+// `deliver_to_parent` is assumed to take `&mut Window` and `&mut App` (its origin is a
+// `WeakEntity`, so it is not a `ThreadView` method); the lost-origin test calls it directly.
+//
+// Hostile halves first:
+//   - a draft whose cursor sits at its START keeps its text and gets the block AFTER it — the
+//     GOTCHA of `MessageEditor::insert_text`, which inserts at the cursor;
+//   - nothing is sent: neither thread gains a user message, neither starts a turn;
+//   - the parent open in ANOTHER window is the one written to, not a new view in this one;
+//   - an open failure inserts nothing anywhere and says why; so does an origin view gone before
+//     the parent opened (`deliver_lost`);
+//   - then the empty composer, the focus and the cursor.
+
+use std::time::Duration;
+
+use acp_thread::{StubAgentConnection, ThreadStatus};
+use gpui::{Focusable as _, TestAppContext, VisualTestContext, WeakEntity};
+use serde_json::json;
+
+use super::deliver_to_parent;
+use crate::sub_thread_test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::test_helpers::{all_lines_lowercased, capture_logs};
+
+fn block(title: &str, reply: &str) -> String {
+    format!("From sub-thread \"{title}\":\n\n{reply}")
+}
+
+fn send_last_reply(conv: &Conv, cx: &mut VisualTestContext) {
+    conv.view
+        .update_in(cx, |view, window, cx| view.send_last_reply(window, cx));
+    cx.run_until_parked();
+}
+
+fn idle(conv: &Conv, cx: &VisualTestContext) -> bool {
+    conv.thread
+        .read_with(cx, |thread, _| thread.status() == ThreadStatus::Idle)
+}
+
+/// A parent known to the metadata store under `folder`, run by `crate::Agent::Stub`.
+fn saved_parent(
+    folder: &str,
+    cx: &mut VisualTestContext,
+) -> (ThreadId, agent_client_protocol::v2::schema::SessionId) {
+    let thread_id = ThreadId::new();
+    let session = agent_client_protocol::v2::schema::SessionId::new("closed-parent-session");
+    let now = chrono::Utc::now();
+    let folders = [std::path::Path::new(folder)];
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Closed parent".into()),
+                    title_override: None,
+                    updated_at: now,
+                    created_at: Some(now),
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(
+                        &workspace::PathList::new(&folders),
+                    ),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (thread_id, session)
+}
+
+fn shown_session(rig: &Rig) -> Option<String> {
+    rig.panel.read_with(&rig.cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().to_string())
+    })
+}
+
+// ── Hostile: the draft, and nothing sent (R2.2, R2.3, R2.5) ────────────────
+
+#[gpui::test]
+async fn deliver_to_parent_appends_after_a_draft_whose_cursor_is_at_its_start(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    set_composer(&parent.view, "my draft", &mut rig.cx);
+    let parent_editor = parent
+        .view
+        .read_with(&rig.cx, |view, _| view.message_editor.clone());
+    parent_editor.update_in(&mut rig.cx, |editor, window, cx| {
+        editor.set_cursor_offset(0, window, cx)
+    });
+    let sent_parent = user_message_count(&parent.thread, &rig.cx);
+    let sent_child = user_message_count(&child.thread, &rig.cx);
+
+    send_last_reply(&child, &mut rig.cx);
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        format!("my draft\n\n{}", block("Child", "child answer")),
+        "the draft is kept and the block follows it after a blank line"
+    );
+    assert_eq!(
+        user_message_count(&parent.thread, &rig.cx),
+        sent_parent,
+        "nothing sent to the parent"
+    );
+    assert_eq!(
+        user_message_count(&child.thread, &rig.cx),
+        sent_child,
+        "no turn in the sub-thread"
+    );
+    assert!(
+        idle(&parent, &rig.cx) && idle(&child, &rig.cx),
+        "no agent turn starts"
+    );
+}
+
+// ── Hostile: the parent open in another window (R4.1) ──────────────────────
+
+#[gpui::test]
+async fn deliver_to_parent_writes_to_the_parent_open_in_another_window(cx: &mut TestAppContext) {
+    init(cx);
+    let mut a = rig(cx).await;
+    a.fs.insert_tree("/side", json!({ "file.txt": "" })).await;
+    let mut b = window_over(&a.fs.clone(), "/side", cx).await;
+    b.connection = a.connection.clone();
+    let parent = open_conversation(&mut a, "Parent", "parent answer");
+    let child = open_conversation(&mut b, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut b.cx);
+    let views_in_b = b
+        .panel
+        .read_with(&b.cx, |panel, _| panel.conversation_views().len());
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+
+    send_last_reply(&child, &mut b.cx);
+
+    assert_eq!(
+        composer_text(&parent.view, &a.cx),
+        block("Child", "child answer"),
+        "the open parent, in its own window, gets the block"
+    );
+    assert_eq!(
+        b.panel
+            .read_with(&b.cx, |panel, _| panel.conversation_views().len()),
+        views_in_b,
+        "no second view of the parent is opened here"
+    );
+    assert_eq!(
+        composer_text(&child.view, &b.cx),
+        "",
+        "the sub-thread's composer is untouched"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.active_window()),
+        Some(a.window.into()),
+        "the parent's window comes forward"
+    );
+}
+
+// ── Hostile: open failure (R4.3, Q4) ───────────────────────────────────────
+
+#[gpui::test]
+async fn deliver_to_parent_open_failure_inserts_nothing_and_says_why(cx: &mut TestAppContext) {
+    init(cx);
+    let mut a = rig(cx).await;
+    a.fs.insert_tree("/side", json!({ "file.txt": "" })).await;
+    let mut b = window_over(&a.fs.clone(), "/side", cx).await;
+    b.connection = a.connection.clone();
+    let parent = open_conversation(&mut a, "Parent", "parent answer");
+    let child = open_conversation(&mut b, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut b.cx);
+    // The parent's window keeps its folder but loses its agent panel (story 024's failure recipe).
+    let panel_a = a.panel.clone();
+    a.workspace.update_in(&mut a.cx, |workspace, window, cx| {
+        workspace.remove_panel(&panel_a, window, cx)
+    });
+    drop(panel_a);
+    a.cx.run_until_parked();
+
+    capture_logs();
+    send_last_reply(&child, &mut b.cx);
+    // The router waits for an agent panel up to its 60 s safety net before it reports.
+    b.cx.executor().advance_clock(Duration::from_secs(61));
+    b.cx.run_until_parked();
+
+    let notice = notice_of(&child.view, &b.cx).expect("the sub-thread says why");
+    assert!(
+        notice.starts_with("Could not open the parent thread: "),
+        "the notice names the failure: {notice:?}"
+    );
+    assert_eq!(
+        composer_text(&child.view, &b.cx),
+        "",
+        "nothing lands in the sub-thread"
+    );
+    let lines = all_lines_lowercased();
+    let parent_id = parent.session.to_string().to_lowercase();
+    let child_id = child.session.to_string().to_lowercase();
+    assert!(
+        lines.iter().any(|line| line.contains("zeo_sub_thread")
+            && line.contains("open_failed")
+            && line.contains(&parent_id)
+            && line.contains(&child_id)),
+        "one event names both sessions: {lines:?}"
+    );
+    assert!(
+        lines.iter().all(|line| !line.contains("child answer")),
+        "no log line carries the reply"
+    );
+}
+
+// ── Hostile: the origin view is gone by the time the parent opens (deliver_lost) ──
+
+#[gpui::test]
+async fn deliver_to_parent_with_its_origin_gone_inserts_nothing_and_warns(cx: &mut TestAppContext) {
+    init(cx);
+    crate::test_support::set_stub_agent_connection(
+        StubAgentConnection::new().with_supports_load_session(true),
+    );
+    let mut rig = rig(cx).await;
+    let (_parent_id, parent_session) = saved_parent("/project", &mut rig.cx);
+    let block_text = block("Gone", "lost answer");
+    capture_logs();
+
+    // The sub-thread's view closed between the choice and the parent's opening.
+    let session = parent_session.clone();
+    rig.cx.update(|window, cx| {
+        deliver_to_parent(
+            session,
+            block_text.clone(),
+            WeakEntity::new_invalid(),
+            window,
+            cx,
+        )
+    });
+    rig.cx.run_until_parked();
+
+    let composers: Vec<String> = rig.panel.read_with(&rig.cx, |panel, cx| {
+        panel
+            .conversation_views()
+            .iter()
+            .filter_map(|conversation| conversation.read(cx).root_thread_view())
+            .map(|view| view.read(cx).message_editor.read(cx).text(cx))
+            .collect()
+    });
+    assert!(
+        composers.iter().all(|text| !text.contains("lost answer")),
+        "no composer receives the block: {composers:?}"
+    );
+    let lines = all_lines_lowercased();
+    assert!(
+        lines.iter().any(|line| line.contains("zeo_sub_thread")
+            && line.contains("deliver_lost")
+            && line.contains(&parent_session.to_string().to_lowercase())),
+        "the lost delivery is a warning naming the parent: {lines:?}"
+    );
+    assert!(
+        lines.iter().all(|line| !line.contains("lost answer")),
+        "never the text"
+    );
+}
+
+// ── Not open: opened, then inserted (R4.2) ─────────────────────────────────
+
+#[gpui::test]
+async fn deliver_to_parent_opens_a_closed_parent_then_inserts(cx: &mut TestAppContext) {
+    init(cx);
+    crate::test_support::set_stub_agent_connection(
+        StubAgentConnection::new().with_supports_load_session(true),
+    );
+    let mut rig = rig(cx).await;
+    // The panel loads the parent through its `Agent::Stub` connection, so that one must be the
+    // stub that supports loading (agent_panel.rs, test_open_thread_by_session_keeps_agent_and_folders).
+    rig.connection = crate::test_support::stub_agent_connection();
+    let loadable = rig.connection.clone();
+    rig.panel.update(&mut rig.cx, |panel, cx| {
+        panel.connection_store().update(cx, |store, cx| {
+            store.restart_connection(
+                crate::Agent::Stub,
+                std::rc::Rc::new(crate::test_support::StubAgentServer::new(loadable)),
+                cx,
+            );
+        });
+    });
+    rig.cx.run_until_parked();
+    let (parent_id, parent_session) = saved_parent("/project", &mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+    assert_ne!(
+        shown_session(&rig),
+        Some(parent_session.to_string()),
+        "precondition: the parent is not open"
+    );
+
+    send_last_reply(&child, &mut rig.cx);
+
+    assert_eq!(
+        shown_session(&rig),
+        Some(parent_session.to_string()),
+        "the parent is opened and brought forward"
+    );
+    let parent_view = rig
+        .panel
+        .read_with(&rig.cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("the parent's view");
+    assert_eq!(
+        parent_view.read_with(&rig.cx, |view, cx| view.message_editor.read(cx).text(cx)),
+        block("Child", "child answer"),
+        "inserted once its composer exists"
+    );
+}
+
+// ── Benign: empty composer, focus, cursor, log (R2.1, R2.4, R8.1) ──────────
+
+#[gpui::test]
+async fn deliver_to_parent_fills_an_empty_composer_focused_with_the_cursor_at_the_end(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    capture_logs();
+
+    send_last_reply(&child, &mut rig.cx);
+
+    let expected = block("Child", "child answer");
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        expected,
+        "exactly the block"
+    );
+    assert_eq!(
+        shown_session(&rig),
+        Some(parent.session.to_string()),
+        "the parent is in front"
+    );
+    let editor = parent
+        .view
+        .read_with(&rig.cx, |view, _| view.message_editor.clone());
+    assert!(
+        rig.cx.update(|window, cx| editor
+            .read(cx)
+            .focus_handle(cx)
+            .contains_focused(window, cx)),
+        "the parent's composer has focus"
+    );
+    editor.update_in(&mut rig.cx, |editor, window, cx| {
+        editor.insert_text("|", window, cx)
+    });
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        format!("{expected}|"),
+        "the cursor is at the end of the inserted block"
+    );
+
+    let lines = all_lines_lowercased();
+    assert!(
+        lines.iter().any(|line| line.contains("zeo_sub_thread")
+            && line.contains("delivered")
+            && line.contains(&parent.session.to_string().to_lowercase())
+            && line.contains(&child.session.to_string().to_lowercase())
+            && line.contains("chars=")),
+        "the delivery is logged with ids and its size: {lines:?}"
+    );
+    assert!(
+        lines.iter().all(|line| !line.contains("child answer")),
+        "never the text"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_send/delivering_availability_tests.rs b/crates/agent_ui/src/sub_thread_send/delivering_availability_tests.rs
new file mode 100644
index 0000000..8c746d0
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/delivering_availability_tests.rs
@@ -0,0 +1,190 @@
+// Story 040, task 11.3 (refine v4, review 7.x L2) — `availability` rows while a Send Last Reply
+// delivery is still reaching the parent (R2.6, R4.4; Q5). Module path:
+// `sub_thread_send::delivering_availability_tests`. Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/delivering_availability_tests.rs"]
+//     mod delivering_availability_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- sub_thread_send`. Fixtures:
+// `crate::sub_thread_test_support` and `super::receipt_test_support` (task 11.2's setup-only
+// helpers, used for the Unconfirmed row).
+//
+// Contract (design.md v4 §SendToParentControl): `SendToParentState { pending_summary, notice,
+// delivering: bool }`, `Default`; `availability(link, thread, state)` disables BOTH choices with
+// "Sending to the parent thread" while `delivering`, after the Deleted check and before the
+// Unconfirmed and no-reply checks. The state is built the way design.md names it,
+// `SendToParentState { delivering: true, ..Default::default() }`.
+//
+// Not pinned here: whether `delivering` or a running turn / pending summary speaks first when
+// both hold. design.md v4 lists generating/pending before delivering; tasks.md 11.3 ToDo 2 puts
+// delivering before the generating check. Every row below holds under either order.
+//
+// Hostile halves first:
+//   - wrongly ALLOWED: a sub-thread with a reply, idle, offers both choices while its delivery
+//     is in flight (L2: a second pick opens a second window and appends a second block);
+//   - wrongly ALLOWED: Unconfirmed keeps Send Last Reply available (R3.8), and must not let it
+//     through while delivering; nor may "No reply to send yet" replace the in-flight reason;
+//   - wrongly DISABLED / wrong reason: a deleted parent still says it was deleted;
+//   - the converse "not delivering offers both" is helpers_tests.rs's
+//     `sub_thread_send_availability_idle_with_a_reply_enables_both`, unchanged.
+
+use acp_thread::{AcpThread, ThreadStatus};
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::{Entity, SharedString, TestAppContext, VisualTestContext};
+
+use super::receipt_test_support::open_unconfirmed_receipt_conversation;
+use super::{Availability, ParentLink, SendToParentState, availability};
+use crate::sub_thread_test_support::*;
+
+const SENDING: &str = "Sending to the parent thread";
+const DELETED: &str = "The parent thread was deleted";
+
+/// The state of a sub-thread whose Send Last Reply is still reaching its parent.
+fn in_flight_state() -> SendToParentState {
+    SendToParentState {
+        delivering: true,
+        ..Default::default()
+    }
+}
+
+fn choices_while(
+    link: &ParentLink,
+    thread: &Entity<AcpThread>,
+    state: &SendToParentState,
+    cx: &VisualTestContext,
+) -> (Result<(), String>, Result<(), String>) {
+    thread.read_with(cx, |thread, _| {
+        let Availability {
+            last_reply,
+            summarize,
+        } = availability(link, thread, state);
+        (
+            last_reply.map_err(|tooltip: SharedString| tooltip.to_string()),
+            summarize.map_err(|tooltip: SharedString| tooltip.to_string()),
+        )
+    })
+}
+
+fn live_link_to(parent: &Conv) -> ParentLink {
+    ParentLink::Live {
+        parent: parent.thread_id,
+        parent_session: parent.session.clone(),
+    }
+}
+
+// ── Hostile: an idle sub-thread with a reply, mid-delivery (R2.6) ──────────
+
+#[gpui::test]
+async fn sub_thread_send_availability_delivering_disables_both_choices(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    assert_eq!(
+        child.thread.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Idle,
+        "precondition: no turn running, so only the delivery can disable the choices"
+    );
+
+    let (last_reply, summarize) = choices_while(
+        &live_link_to(&parent),
+        &child.thread,
+        &in_flight_state(),
+        &rig.cx,
+    );
+    assert_eq!(
+        last_reply,
+        Err(SENDING.to_string()),
+        "a second Send Last Reply waits for the first to reach the parent"
+    );
+    assert_eq!(
+        summarize,
+        Err(SENDING.to_string()),
+        "Summarize and Send waits too: both choices write to the same composer"
+    );
+}
+
+// ── Hostile: Unconfirmed lets Send Last Reply through, delivering must not ─
+
+#[gpui::test]
+async fn sub_thread_send_availability_delivering_while_unconfirmed_disables_both(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, _connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+    assert_eq!(
+        child.thread.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Unconfirmed,
+        "precondition"
+    );
+
+    let (last_reply, summarize) = choices_while(
+        &live_link_to(&parent),
+        &child.thread,
+        &in_flight_state(),
+        &rig.cx,
+    );
+    assert_eq!(
+        last_reply,
+        Err(SENDING.to_string()),
+        "the in-flight delivery is checked before Unconfirmed, which leaves Send Last Reply on"
+    );
+    assert_eq!(summarize, Err(SENDING.to_string()));
+}
+
+// ── Hostile: the in-flight reason is not replaced by "No reply to send yet" ─
+
+#[gpui::test]
+async fn sub_thread_send_availability_delivering_wins_over_no_reply(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "");
+    // The stub keeps a turn with no updates open until told how it ended (helpers_tests.rs).
+    rig.connection
+        .end_turn(child.session.clone(), acp_v1::StopReason::EndTurn);
+    rig.cx.run_until_parked();
+    assert_eq!(
+        child.thread.read_with(&rig.cx, |thread, _| thread.status()),
+        ThreadStatus::Idle,
+        "precondition: the turn ended with no reply, so no wait applies"
+    );
+
+    let (last_reply, summarize) = choices_while(
+        &live_link_to(&parent),
+        &child.thread,
+        &in_flight_state(),
+        &rig.cx,
+    );
+    assert_eq!(last_reply, Err(SENDING.to_string()));
+    assert_eq!(
+        summarize,
+        Err(SENDING.to_string()),
+        "no reply disables Send Last Reply only; delivering disables both"
+    );
+}
+
+// ── Order: a deleted parent still wins (R4.4) ──────────────────────────────
+
+#[gpui::test]
+async fn sub_thread_send_availability_deleted_parent_wins_over_delivering(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let child = open_conversation(&mut rig, "Child", "child answer");
+
+    let (last_reply, summarize) = choices_while(
+        &ParentLink::Deleted,
+        &child.thread,
+        &in_flight_state(),
+        &rig.cx,
+    );
+    assert_eq!(
+        last_reply,
+        Err(DELETED.to_string()),
+        "the more lasting reason is the one shown"
+    );
+    assert_eq!(summarize, Err(DELETED.to_string()));
+}
diff --git a/crates/agent_ui/src/sub_thread_send/delivery.rs b/crates/agent_ui/src/sub_thread_send/delivery.rs
new file mode 100644
index 0000000..8d815fb
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/delivery.rs
@@ -0,0 +1,199 @@
+//! Story 040, delivery: the block lands in the parent's composer, after any draft, focused and
+//! never sent, wherever the parent is open — or once the router has opened it (design.md,
+//! deliver_to_parent).
+
+use agent_client_protocol::v2::schema as acp_v2;
+use anyhow::Context as _;
+use gpui::{AnyWindowHandle, App, AsyncApp, Entity, Focusable as _, WeakEntity, Window};
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::AgentPanel;
+use crate::agent_session_router::{OpenAgentSessionOptions, open_agent_session};
+use crate::conversation_view::ThreadView;
+
+/// A loaded conversation of `parent_session` in any window: the window, its workspace and the
+/// root thread view. Not called inside a window update, where that window would be leased and
+/// skipped — the caller always reaches it from a spawned task.
+fn find_parent_view(
+    parent_session: &acp_v2::SessionId,
+    origin_window: AnyWindowHandle,
+    cx: &App,
+) -> Option<(AnyWindowHandle, Entity<Workspace>, Entity<ThreadView>)> {
+    // The sub-thread's own window first, so a parent open there is the one written to.
+    let mut windows = cx.windows();
+    windows.sort_by_key(|window| *window != origin_window);
+    for window in windows {
+        let Some(multi_workspace) = window
+            .downcast::<MultiWorkspace>()
+            .and_then(|handle| handle.read(cx).ok())
+        else {
+            continue;
+        };
+        for workspace in multi_workspace.workspaces() {
+            let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) else {
+                continue;
+            };
+            let view = panel
+                .read(cx)
+                .conversation_views()
+                .into_iter()
+                .filter(|view| view.read(cx).root_session_id.as_ref() == Some(parent_session))
+                .find_map(|view| view.read(cx).root_thread_view());
+            if let Some(view) = view {
+                return Some((window, workspace.clone(), view));
+            }
+        }
+    }
+    None
+}
+
+/// Appends `block` to the parent's composer, sending nothing (R2.2–R2.4). The cursor goes to the
+/// end first: `MessageEditor::insert_text` inserts at the cursor, which may sit inside a draft.
+fn append_to_composer(view: &mut ThreadView, block: &str, window: &mut Window, cx: &mut App) {
+    view.message_editor.update(cx, |editor, cx| {
+        let text = editor.text(cx);
+        editor.set_cursor_offset(text.len(), window, cx);
+        if !text.is_empty() {
+            editor.insert_text("\n\n", window, cx);
+        }
+        editor.insert_text(block, window, cx);
+    });
+    let focus = view.message_editor.focus_handle(cx);
+    window.focus(&focus, cx);
+}
+
+/// Shows `notice` on the sub-thread's view when it still exists.
+fn tell_origin(origin: &WeakEntity<ThreadView>, notice: String, cx: &mut AsyncApp) {
+    origin
+        .update(cx, |view, cx| {
+            view.send_to_parent.notice = Some(notice.into());
+            cx.notify();
+        })
+        // A view closed meanwhile has nobody left to tell; the warning already said it.
+        .ok();
+}
+
+/// Delivers `block` to the parent thread of session `parent_session` (R2, R4). `origin` is the
+/// sub-thread's view, held weakly: it may close while the parent opens.
+pub(crate) fn deliver_to_parent(
+    parent_session: acp_v2::SessionId,
+    block: String,
+    origin: WeakEntity<ThreadView>,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let fallback_window = window.window_handle();
+    let chars = block.chars().count();
+    cx.spawn(async move |cx| {
+        async {
+            // Read here, not before spawning: the caller is usually that very view, mid-update.
+            let sub_session = origin
+                .read_with(cx, |view, _| view.session_id.to_string())
+                .ok();
+            // Session ids and a count only: the block is the user's text (R8.1).
+            let ids = match &sub_session {
+                Some(sub) => format!("parent_session={parent_session} sub_session={sub}"),
+                None => format!("parent_session={parent_session}"),
+            };
+            if sub_session.is_none() {
+                log::warn!("zeo_sub_thread event=deliver_lost {ids} reason=origin_gone");
+                return;
+            }
+            let mut found = cx.update(|cx| find_parent_view(&parent_session, fallback_window, cx));
+            if found.is_none() {
+                let routing = cx.update(|cx| {
+                    // The sub-thread's own workspace: every workspace shares one `AppState`.
+                    let workspace = origin
+                        .read_with(cx, |view, _| view.workspace.upgrade())
+                        .ok()
+                        .flatten()
+                        .context("no window to open the parent thread from")?;
+                    let app_state = workspace.read(cx).app_state().clone();
+                    anyhow::Ok(open_agent_session(
+                        parent_session.clone(),
+                        OpenAgentSessionOptions {
+                            cwd: None,
+                            fallback_window: Some(fallback_window),
+                            tool_call_id: None,
+                            task_id: None,
+                        },
+                        app_state,
+                        cx,
+                    ))
+                });
+                let opened = match routing {
+                    Ok(routing) => routing.await,
+                    Err(error) => Err(error),
+                };
+                if let Err(error) = opened {
+                    log::warn!("zeo_sub_thread event=open_failed {ids} error={error:#}");
+                    tell_origin(
+                        &origin,
+                        format!("Could not open the parent thread: {error:#}"),
+                        cx,
+                    );
+                    return;
+                }
+                // Looked up again: no editor handle is ever held across the router's await.
+                found = cx.update(|cx| find_parent_view(&parent_session, fallback_window, cx));
+            }
+            let Some((parent_window, workspace, view)) = found else {
+                log::warn!("zeo_sub_thread event=deliver_lost {ids} reason=no_parent_view");
+                tell_origin(
+                    &origin,
+                    "Could not open the parent thread: it did not load".to_string(),
+                    cx,
+                );
+                return;
+            };
+            // The choice was made in a view that is gone: nothing is delivered on its behalf.
+            if origin.upgrade().is_none() {
+                log::warn!("zeo_sub_thread event=deliver_lost {ids} reason=origin_gone");
+                return;
+            }
+            let delivered = parent_window.update(cx, |root, window, cx| {
+                window.activate_window();
+                // A parent in a workspace the window is not showing would get the block unseen.
+                if let Ok(multi_workspace) = root.downcast::<MultiWorkspace>()
+                    && multi_workspace.read(cx).workspace() != &workspace
+                {
+                    multi_workspace.update(cx, |multi_workspace, cx| {
+                        multi_workspace.activate(workspace.clone(), None, window, cx)
+                    });
+                }
+                let panel = workspace.update(cx, |workspace, cx| {
+                    workspace.focus_panel::<AgentPanel>(window, cx)
+                });
+                if let Some(panel) = panel {
+                    panel.update(cx, |panel, cx| {
+                        panel.open_thread_by_session(parent_session.clone(), window, cx)
+                    });
+                }
+                view.update(cx, |view, cx| append_to_composer(view, &block, window, cx));
+            });
+            match delivered {
+                Ok(()) => log::info!("zeo_sub_thread event=delivered {ids} chars={chars}"),
+                Err(error) => {
+                    log::warn!(
+                        "zeo_sub_thread event=deliver_lost {ids} reason=window error={error:#}"
+                    );
+                    tell_origin(
+                        &origin,
+                        format!("Could not open the parent thread: {error:#}"),
+                        cx,
+                    );
+                }
+            }
+        }
+        .await;
+        // Every way the delivery ends gives the choices back (R2.6).
+        origin
+            .update(cx, |view, cx| {
+                view.send_to_parent.delivering = false;
+                cx.notify();
+            })
+            // A view closed meanwhile has no choices left to give back.
+            .ok();
+    })
+    .detach();
+}
diff --git a/crates/agent_ui/src/sub_thread_send/helpers_tests.rs b/crates/agent_ui/src/sub_thread_send/helpers_tests.rs
new file mode 100644
index 0000000..dd73b39
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/helpers_tests.rs
@@ -0,0 +1,367 @@
+// Story 040, task 6.1 — the pure helpers of Send to Parent: `parent_link`, `availability`,
+// `last_reply_text`, `compose_block`, `SUMMARY_REQUEST` (R1.4, R1.5, R2.1, R3.5, R4.4, R4.5; Q5).
+// Module path: `sub_thread_send::helpers_tests`. Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/helpers_tests.rs"]
+//     mod helpers_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- sub_thread_send`. Fixtures:
+// `crate::sub_thread_test_support`.
+//
+// Contract (design.md §SendToParentControl):
+//   - `parent_link(thread_id, cx) -> ParentLink`, `ParentLink::{None, Live { parent,
+//     parent_session }, Deleted}`: `None` with no link or no organization store; `Deleted` when
+//     the parent has no metadata entry or its entry has no session; an archived parent is Live;
+//   - `availability(link, thread, state) -> Availability { last_reply, summarize }`, each
+//     `Result<(), SharedString>` whose `Err` is the tooltip; checks in this order: Deleted →
+//     "The parent thread was deleted"; generating or a pending summary → "Wait for the turn
+//     to end" (039's text, story v2); no agent message → "No reply to send yet" (last reply only);
+//   - `last_reply_text(entries, cx)`: the LAST assistant run;
+//   - `compose_block(title, reply)`: `From sub-thread "<title>":`, a blank line, the reply cut at
+//     200,000 characters on a `char` boundary plus the line `[truncated: N more characters]`;
+//   - `SUMMARY_REQUEST`, the fixed text of design.md §Summary request.
+// Assumed beyond design.md: `ParentLink` derives `Debug` + `PartialEq`; `availability` takes
+// `&ParentLink`, `&AcpThread` and `&SendToParentState` (adapt in `avail` only); `PendingSummary`
+// and `SendToParentState` are built here through their private fields (this is a child module).
+//
+// Where R4.5 and design.md disagree: R4.5 caps "the inserted text", design.md caps "the reply".
+// These tests follow design.md (the header is never cut and does not count toward the cap).
+//
+// Hostile halves first:
+//   - the check ORDER: a deleted parent says so even while generating; generating says "wait"
+//     even with no reply yet;
+//   - `parent_link` of a thread that HAS children but no parent is `None`;
+//   - `last_reply_text` is the last reply, not the first and not all of them;
+//   - the cap counts characters, not bytes: 150,000 two-byte characters are not cut; exactly
+//     200,000 are not cut; 200,001 are.
+
+use acp_thread::AcpThread;
+use agent_client_protocol::v1::schema as acp_v1;
+use gpui::{Entity, SharedString, TestAppContext, VisualTestContext};
+
+use super::{
+    Availability, ParentLink, PendingSummary, SUMMARY_REQUEST, SendToParentState, availability,
+    compose_block, last_reply_text, parent_link,
+};
+use crate::sub_thread_test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+const DELETED: &str = "The parent thread was deleted";
+const WAIT: &str = "Wait for the turn to end";
+const NO_REPLY: &str = "No reply to send yet";
+
+fn avail(
+    link: &ParentLink,
+    thread: &Entity<AcpThread>,
+    state: &SendToParentState,
+    cx: &VisualTestContext,
+) -> (Result<(), String>, Result<(), String>) {
+    thread.read_with(cx, |thread, _| {
+        let Availability {
+            last_reply,
+            summarize,
+        } = availability(link, thread, state);
+        (
+            last_reply.map_err(|tooltip: SharedString| tooltip.to_string()),
+            summarize.map_err(|tooltip: SharedString| tooltip.to_string()),
+        )
+    })
+}
+
+fn link_of(thread_id: ThreadId, cx: &mut VisualTestContext) -> ParentLink {
+    cx.update(|_, cx| parent_link(thread_id, cx))
+}
+
+fn pending() -> SendToParentState {
+    SendToParentState {
+        pending_summary: Some(PendingSummary {
+            activity_generation: 1,
+            ..Default::default()
+        }),
+        notice: None,
+        ..Default::default()
+    }
+}
+
+fn live(parent: &Conv) -> ParentLink {
+    ParentLink::Live {
+        parent: parent.thread_id,
+        parent_session: parent.session.clone(),
+    }
