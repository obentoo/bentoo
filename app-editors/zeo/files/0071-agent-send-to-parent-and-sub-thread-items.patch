+        .expect("the sub-thread is listed in its parent's group");
+    assert!(!sub_row.can_stop, "no Stop on a sub-thread row");
+    assert!(!sub_row.can_open_log, "no Open Log on a sub-thread row");
+    let adapter_row = group
+        .rows
+        .iter()
+        .find(|row| row.entry.record.task_id.as_ref() == "t1")
+        .expect("the adapter task is listed");
+    assert!(adapter_row.can_stop, "the adapter row keeps Stop");
+
+    assert!(
+        !painted(&mut panels, chip_selector("t1")),
+        "an adapter row has no Sub-thread chip"
+    );
+    assert!(
+        painted(&mut panels, chip_selector(&sub_task("sub-a"))),
+        "the chip is drawn"
+    );
+    assert!(
