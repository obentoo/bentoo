diff --git a/crates/agent_ui/src/tasks_card/sub_thread_row.rs b/crates/agent_ui/src/tasks_card/sub_thread_row.rs
new file mode 100644
index 0000000..529dd8b
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/sub_thread_row.rs
@@ -0,0 +1,287 @@
+//! Story 040: sub-thread rows in the tasks card (design.md, SubThreadReporter, "Card rows").
+//!
+//! A sub-thread is a whole conversation, not a task of its parent, so its row offers only Open:
+//! Stop, Send to Background, Expand, Open Log and Open Thread belong to adapter tasks (R6.5).
+
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::schema::v2 as acp_v2;
+use collections::HashSet;
+use gpui::{AnyElement, App, Context, SharedString};
+use ui::{Chip, prelude::*};
+
+use super::{
+    ENDED_ROW_TTL, RowControl, TaskKey, TasksCard, TasksCardEvent, ThreadGroup, card_tooltip,
+    format_duration, row_aria_label,
+};
+use crate::DEFAULT_THREAD_TITLE;
+use crate::sub_thread_reporter::{SubThreadActivity, SubThreadRecord, project_of};
+use crate::thread_metadata_store::ThreadMetadataStore;
+
+/// The prefix of a sub-thread item's task id in the history; reused here so a row's Open and its
+/// error share one key with nothing the adapter reports.
+const SUB_THREAD_KEY_PREFIX: &str = "zeo-sub-thread:";
+
+/// One sub-thread on the card: running, or idle for the ended window (R6.1, R6.3).
+#[derive(Clone, Debug)]
+pub struct SubThreadRow {
+    pub record: SubThreadRecord,
+    pub running: bool,
+    /// When it turned Idle, on the card's clock; `None` while running.
+    pub idle_since: Option<Instant>,
+}
+
+impl SubThreadRow {
+    fn on_show(&self, now: Instant) -> bool {
+        self.running
+            || self
+                .idle_since
+                .is_some_and(|since| now < since + ENDED_ROW_TTL)
+    }
+
+    fn started_at(&self) -> SystemTime {
+        let ms = u64::try_from(self.record.at_ms).unwrap_or_default();
+        UNIX_EPOCH + Duration::from_millis(ms)
+    }
+}
+
+/// The key a sub-thread row's Open control and its error live under.
+fn row_key(sub_session: &acp_v2::SessionId) -> TaskKey {
+    (
+        sub_session.clone(),
+        AgentTaskId::from(format!("{SUB_THREAD_KEY_PREFIX}{sub_session}")),
+    )
+}
+
+impl TasksCard {
+    /// Keeps the card's rows in step with what the reporter tells the history, so the card and
+    /// the panel never disagree about a sub-thread.
+    pub(crate) fn note_sub_thread_activity(
+        &mut self,
+        activity: &SubThreadActivity,
+        cx: &mut Context<Self>,
+    ) {
+        match activity {
+            SubThreadActivity::Linked(_) => return,
+            SubThreadActivity::Running(record) => {
+                self.sub_thread_rows.insert(
+                    record.sub_session.clone(),
+                    SubThreadRow {
+                        record: record.clone(),
+                        running: true,
+                        idle_since: None,
+                    },
+                );
+            }
+            SubThreadActivity::Idle(record) => {
+                let now = cx.background_executor().now();
+                let row = self
+                    .sub_thread_rows
+                    .entry(record.sub_session.clone())
+                    .or_insert_with(|| SubThreadRow {
+                        record: record.clone(),
+                        running: false,
+                        idle_since: None,
+                    });
+                row.running = false;
+                row.idle_since = Some(now);
+                row.record.title = record.title.clone();
+                self.schedule_expiry(cx);
+            }
+            SubThreadActivity::Retitled(record) => {
+                let Some(row) = self.sub_thread_rows.get_mut(&record.sub_session) else {
+                    return;
+                };
+                row.record.title = record.title.clone();
+            }
+        }
+        self.update_tick(cx);
+        cx.notify();
+    }
+
+    /// The rows on show now, keyed by nothing: each names its parent in its record.
+    pub(super) fn sub_thread_rows_on_show(&self, cx: &App) -> Vec<SubThreadRow> {
+        let now = cx.background_executor().now();
+        let mut rows: Vec<SubThreadRow> = self
+            .sub_thread_rows
+            .values()
+            .filter(|row| row.on_show(now))
+            .cloned()
+            .collect();
+        rows.sort_by(|a, b| {
+            (a.record.at_ms, &a.record.sub_session.0)
+                .cmp(&(b.record.at_ms, &b.record.sub_session.0))
+        });
+        rows
+    }
+
+    /// The earliest moment an idle row leaves the card, for `schedule_expiry`.
+    pub(super) fn earliest_sub_thread_expiry(&self) -> Option<Instant> {
+        self.sub_thread_rows
+            .values()
+            .filter(|row| !row.running)
+            .filter_map(|row| row.idle_since)
+            .map(|since| since + ENDED_ROW_TTL)
+            .min()
+    }
+
+    pub(super) fn expire_sub_thread_rows(&mut self, now: Instant) {
+        let expired: Vec<acp_v2::SessionId> = self
+            .sub_thread_rows
+            .iter()
+            .filter(|(_, row)| !row.on_show(now))
+            .map(|(session, _)| session.clone())
+            .collect();
+        for session in expired {
+            self.sub_thread_rows.remove(&session);
+            self.row_errors.remove(&row_key(&session));
+        }
+    }
+
+    pub(super) fn any_sub_thread_running(&self) -> bool {
+        self.sub_thread_rows.values().any(|row| row.running)
+    }
+
+    /// Opens the sub-thread itself through the card's open path; a failure comes back on the row
+    /// through `set_row_error` (R6.4).
+    fn open_sub_thread(&mut self, sub_session: acp_v2::SessionId, cx: &mut Context<Self>) {
+        let (session_id, task_id) = row_key(&sub_session);
+        cx.emit(TasksCardEvent::OpenTask {
+            session_id,
+            task_id,
+            tool_call_id: None,
+        });
+    }
+
+    /// The order key of a group made only of sub-thread rows, and of the sub-threads inside a
+    /// held parent's group: running first, by start.
+    pub(super) fn oldest_running_sub_thread(rows: &[SubThreadRow]) -> Option<SystemTime> {
+        rows.iter()
+            .filter(|row| row.running)
+            .map(SubThreadRow::started_at)
+            .min()
+    }
+
+    /// Groups for the sub-threads whose parent no panel of this card holds, headed by the
+    /// parent's metadata (R6.2).
+    pub(super) fn groups_of_unheld_parents(
+        rows: Vec<SubThreadRow>,
+        held: &HashSet<acp_v2::SessionId>,
+        cx: &App,
+    ) -> Vec<ThreadGroup> {
+        let mut groups: Vec<ThreadGroup> = Vec::new();
+        for row in rows {
+            let parent = row.record.parent_session.clone();
+            if held.contains(&parent) {
+                continue;
+            }
+            if let Some(group) = groups.iter_mut().find(|group| group.session_id == parent) {
+                group.sub_threads.push(row);
+                continue;
+            }
+            let metadata = ThreadMetadataStore::try_global(cx)
+                .and_then(|store| store.read(cx).entry_by_session(&parent).cloned());
+            let (title, project) = match metadata {
+                Some(metadata) => (metadata.display_title(), project_of(&metadata)),
+                None => (
+                    SharedString::new_static(DEFAULT_THREAD_TITLE),
+                    row.record.project.clone(),
+                ),
+            };
+            groups.push(ThreadGroup {
+                session_id: parent,
+                title,
+                project,
+                rows: Vec::new(),
+                sub_threads: vec![row],
+            });
+        }
+        groups
+    }
+
+    pub(super) fn render_sub_thread_row(
+        &mut self,
+        row: SubThreadRow,
+        now: SystemTime,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let sub = row.record.sub_session.clone();
+        let key = row_key(&sub);
+        let title = row.record.title.clone();
+        let error = self.row_errors.get(&key).map(|error| error.message.clone());
+        let state = if row.running {
+            let elapsed = now.duration_since(row.started_at()).unwrap_or_default();
+            format!("Running · {}", format_duration(elapsed))
+        } else {
+            "Idle".to_string()
+        };
+
+        let open_focus_handle = self.row_focus_handle(&key, RowControl::Open, cx);
+        let open_button = IconButton::new(
+            SharedString::from(format!("tasks-card-sub-thread-open-{sub}")),
+            IconName::ArrowUpRight,
+        )
+        .icon_size(IconSize::Small)
+        .icon_color(Color::Muted)
+        .aria_label(row_aria_label(format!("Open sub-thread: {title}")))
+        .tooltip(card_tooltip(
+            format!("sub-thread-open-{sub}").into(),
+            "Open Sub-thread".into(),
+        ))
+        .track_focus(&open_focus_handle)
+        .on_click(cx.listener({
+            let sub = sub.clone();
+            move |card, _, _, cx| card.open_sub_thread(sub.clone(), cx)
+        }));
+        let open_button = div()
+            .debug_selector({
+                let sub = sub.clone();
+                move || format!("tasks-card-sub-thread-open-{sub}")
+            })
+            .flex_none()
+            .child(open_button);
+
+        let line = h_flex()
+            .gap_1()
+            .min_w_0()
+            .child(
+                div()
+                    .flex_none()
+                    .child(Chip::new("Sub-thread").label_size(LabelSize::XSmall)),
+            )
+            .child(
+                div().flex_1().min_w_0().child(
+                    Label::new(title)
+                        .size(LabelSize::Small)
+                        .single_line()
+                        .truncate(),
+                ),
+            )
+            .child(
+                Label::new(state)
+                    .size(LabelSize::XSmall)
+                    .color(if row.running {
+                        Color::Accent
+                    } else {
+                        Color::Muted
+                    }),
+            )
+            .child(open_button);
+
+        v_flex()
+            .id(SharedString::from(format!("tasks-card-sub-thread-{sub}")))
+            .debug_selector(move || format!("tasks-card-sub-thread-{sub}"))
+            .pl_2()
+            .py_0p5()
+            .child(line)
+            .when_some(error, |this, error| {
+                this.child(
+                    Label::new(error)
+                        .size(LabelSize::XSmall)
+                        .color(Color::Error),
+                )
+            })
+            .into_any_element()
+    }
+}
diff --git a/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs b/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs
new file mode 100644
index 0000000..ea850e6
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/sub_thread_row_tests.rs
@@ -0,0 +1,389 @@
+// Story 040, task 4.1 — sub-thread rows in the tasks card (R6.1–R6.5; Q11, Q12). Module path:
+// `tasks_card::sub_thread_row_tests` (the production rows live in `tasks_card/sub_thread_row.rs`).
+// Wired in `src/tasks_card.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "tasks_card/sub_thread_row_tests.rs"]
+//     mod sub_thread_row_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- tasks_card`. Fixtures:
+// `crate::sub_thread_test_support`.
+//
+// Contract (design.md §SubThreadReporter, "Card rows"):
+//   - `TasksCard::sub_thread_rows: HashMap<acp::SessionId, SubThreadRow>`, keyed by the
+//     sub-thread's session; `SubThreadRow { record, running: bool, idle_since: Option<Instant> }`;
+//   - a row is drawn while running and for `ENDED_ROW_TTL` after `Idle`, in the parent's group
+//     when the panel holds the parent, else in a group built from the parent's metadata;
+//   - the row offers only "Open" (Tab stop, tooltip, accessible label), which opens the
+//     sub-thread; no Stop, Send to Background, Expand, Open Log or Open Thread.
+// Assumed beyond design.md (one place each, rename here):
+//   - debug selectors `tasks-card-sub-thread-{sub session}` on the row and
+//     `tasks-card-sub-thread-open-{sub session}` on its Open control; the existing group header
+//     selector `tasks-card-open-group-{parent session}`;
+//   - Open's tooltip through the card's `card_tooltip`, name `sub-thread-open-{sub session}`, and
+//     its screen-reader label through `row_aria_label`, text `Open sub-thread: {title}`;
+//   - the card counts a sub-thread row as something to show (`is_visible`).
+//
+// Hostile halves first:
+//   - the sub-thread row carries none of the task controls, while the adapter rows beside it keep
+//     theirs, a subagent's "Open Thread" included (R6.5);
+//   - Open on the row opens the SUB-thread, not the parent whose group it sits in;
+//   - an idle row does not outlive the ended window; a running one is not dropped by it;
+//   - then the benign placement under a held and an unheld parent.
+
+use std::path::Path;
+use std::time::Duration;
+
+use agent_client_protocol::schema::v1 as acp_v1;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{Entity, Modifiers, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::{ENDED_ROW_TTL, RENDERED_ARIA_LABELS, TasksCard};
+use crate::sub_thread_test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+
+fn row_selector(sub: &acp_v2::SessionId) -> String {
+    format!("tasks-card-sub-thread-{sub}")
+}
+
+fn open_selector(sub: &acp_v2::SessionId) -> String {
+    format!("tasks-card-sub-thread-open-{sub}")
+}
+
+fn group_selector(parent: &acp_v2::SessionId) -> String {
+    format!("tasks-card-open-group-{parent}")
+}
+
+fn advance(cx: &mut VisualTestContext, duration: Duration) {
+    cx.executor().advance_clock(duration);
+    cx.run_until_parked();
+}
+
+fn sub_row_running(
+    card: &Entity<TasksCard>,
+    sub: &acp_v2::SessionId,
+    cx: &VisualTestContext,
+) -> Option<bool> {
+    card.read_with(cx, |card, _| {
+        card.sub_thread_rows.get(sub).map(|row| row.running)
+    })
+}
+
+/// One `_claude/tasks` wire task in the adapter's shape (story 012), for the adapter rows.
+fn wire_task(id: &str, kind: &str) -> serde_json::Value {
+    json!({
+        "id": id,
+        "toolCallId": format!("toolu_{id}"),
+        "type": kind,
+        "description": format!("Task {id}"),
+        "background": false,
+        "depth": 0,
+        "status": "running",
+        "startedAt": 1_000,
+        "endedAt": null,
+        "usage": null,
+        "lastTool": null,
+        "summary": null,
+        "hasOutput": false,
+        "tail": null,
+    })
+}
+
+fn send_tasks(conv: &Conv, tasks: Vec<serde_json::Value>, cx: &mut VisualTestContext) {
+    let mut meta = serde_json::Map::new();
+    meta.insert("_claude/tasks".to_string(), json!({ "tasks": tasks }));
+    conv.thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp_v1::SessionUpdate::SessionInfoUpdate(
+                    acp_v1::SessionInfoUpdate::new().meta(meta),
+                ),
+                cx,
+            )
+        })
+        .expect("the tasks snapshot applies");
+    cx.run_until_parked();
+}
+
+/// Starts a turn in `conv` that does not end until the returned sender answers.
+fn start_turn(
+    rig: &mut Rig,
+    conv: &Conv,
+) -> futures::channel::oneshot::Sender<anyhow::Result<acp_v1::PromptResponse>> {
+    let finish = rig.connection.defer_next_prompt_response();
+    set_composer(&conv.view, "a side question", &mut rig.cx);
+    conv.view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    finish
+}
+
+fn end_turn(
+    finish: futures::channel::oneshot::Sender<anyhow::Result<acp_v1::PromptResponse>>,
+    cx: &mut VisualTestContext,
+) {
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+        .expect("the turn is still waiting");
+    cx.run_until_parked();
+}
+
+/// A parent known only to the metadata store: not held by any agent panel.
+fn unheld_parent(cx: &mut VisualTestContext) -> (ThreadId, acp_v2::SessionId) {
+    let thread_id = ThreadId::new();
+    let session = acp_v2::SessionId::new("unheld-parent-session");
+    let now = chrono::Utc::now();
+    let folders = [Path::new("/elsewhere")];
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Away parent".into()),
+                    title_override: None,
+                    updated_at: now,
+                    created_at: Some(now),
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(
+                        &workspace::PathList::new(&folders),
+                    ),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (thread_id, session)
+}
+
+// ── R6.5: only Open, beside adapter rows that keep their controls ──────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_has_only_open_while_adapter_rows_keep_their_controls(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "shell"), wire_task("t2", "subagent")],
+        &mut rig.cx,
+    );
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    let sub = &child.session;
+    assert!(
+        painted(row_selector(sub), &mut rig.cx),
+        "the sub-thread row is drawn"
+    );
+    assert!(painted(open_selector(sub), &mut rig.cx), "with its Open");
+    for control in [
+        "stop",
+        "background",
+        "expand",
+        "open-log",
+        "open-thread",
+        "watch",
+    ] {
+        for id in [sub.to_string(), format!("zeo-sub-thread:{sub}")] {
+            assert!(
+                !painted(format!("tasks-card-{control}-{id}"), &mut rig.cx),
+                "no {control} on a sub-thread row"
+            );
+        }
+    }
+    assert!(
+        painted("tasks-card-stop-t1", &mut rig.cx),
+        "the adapter row keeps Stop"
+    );
+    assert!(
+        painted("tasks-card-background-t1", &mut rig.cx),
+        "and Send to Background"
+    );
+    assert!(
+        painted("tasks-card-open-thread-t2", &mut rig.cx),
+        "a subagent task keeps its Open Thread"
+    );
+}
+
+// ── R6.4: Open opens the sub-thread ────────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_open_shows_the_sub_thread_not_its_parent(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+    assert_eq!(
+        crate::test_support::active_session_id(&rig.panel, &rig.cx),
+        parent.session,
+        "precondition: the parent is in front"
+    );
+
+    let selector: &'static str = Box::leak(open_selector(&child.session).into_boxed_str());
+    let bounds = rig
+        .cx
+        .debug_bounds(selector)
+        .expect("the sub-thread row's Open is painted");
+    rig.cx.simulate_click(bounds.center(), Modifiers::none());
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        crate::test_support::active_session_id(&rig.panel, &rig.cx),
+        child.session,
+        "the sub-thread is shown"
+    );
+}
+
+// ── R6.3: Idle, then dropped after the ended window ────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_idle_row_stays_for_the_ended_window_then_goes(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let card = card(&rig);
+
+    let finish = start_turn(&mut rig, &child);
+    advance(&mut rig.cx, ENDED_ROW_TTL + Duration::from_secs(5));
+    draw(&mut rig.cx);
+    assert_eq!(
+        sub_row_running(&card, &child.session, &rig.cx),
+        Some(true),
+        "a running row is never dropped by the ended window"
+    );
+    assert!(painted(row_selector(&child.session), &mut rig.cx));
+
+    end_turn(finish, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert_eq!(
+        sub_row_running(&card, &child.session, &rig.cx),
+        Some(false),
+        "the row turns Idle"
+    );
+    assert!(
+        painted(row_selector(&child.session), &mut rig.cx),
+        "an Idle row stays on show"
+    );
+
+    advance(&mut rig.cx, ENDED_ROW_TTL + Duration::from_secs(1));
+    draw(&mut rig.cx);
+    assert!(
+        !painted(row_selector(&child.session), &mut rig.cx),
+        "dropped after the ended window"
+    );
+}
+
+// ── R6.1, R6.2: placement ──────────────────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_sits_in_the_held_parent_group(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let card = card(&rig);
+
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    assert!(
+        card.update(&mut rig.cx, |card, cx| card.is_visible(cx)),
+        "a running sub-thread alone puts the card on screen"
+    );
+    let header: &'static str = Box::leak(group_selector(&parent.session).into_boxed_str());
+    let row: &'static str = Box::leak(row_selector(&child.session).into_boxed_str());
+    let header = rig
+        .cx
+        .debug_bounds(header)
+        .expect("the parent's group is drawn");
+    let row = rig
+        .cx
+        .debug_bounds(row)
+        .expect("the sub-thread row is drawn");
+    assert!(
+        row.top() >= header.top(),
+        "the row sits under its parent's header"
+    );
+    assert!(
+        !painted(group_selector(&child.session), &mut rig.cx),
+        "the sub-thread gets no group of its own"
+    );
+    let parent_session = card.read_with(&rig.cx, |card, _| {
+        card.sub_thread_rows
+            .get(&child.session)
+            .map(|row| row.record.parent_session.clone())
+    });
+    assert_eq!(parent_session, Some(parent.session.clone()));
+}
+
+#[gpui::test]
+async fn tasks_card_sub_thread_row_of_an_unheld_parent_gets_the_parent_group(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent_id, parent_session) = unheld_parent(&mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    assert!(
+        painted(group_selector(&parent_session), &mut rig.cx),
+        "a group headed by the parent, though no panel holds it"
+    );
+    assert!(painted(row_selector(&child.session), &mut rig.cx));
+}
+
+// ── Q12: tooltip and accessible label ──────────────────────────────────────
+
+#[gpui::test]
+async fn tasks_card_sub_thread_open_has_a_tooltip_and_an_accessible_label(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = start_turn(&mut rig, &child);
+    draw(&mut rig.cx);
+
+    let labels: Vec<String> =
+        RENDERED_ARIA_LABELS.with(|labels| labels.borrow().iter().map(|l| l.to_string()).collect());
+    assert!(
+        labels.iter().any(|label| label == "Open sub-thread: Child"),
+        "Open is labelled for screen readers: {labels:?}"
+    );
+
+    let selector: &'static str = Box::leak(open_selector(&child.session).into_boxed_str());
+    let bounds = rig.cx.debug_bounds(selector).expect("Open is painted");
+    rig.cx
+        .simulate_mouse_move(bounds.center(), None, Modifiers::none());
+    advance(&mut rig.cx, Duration::from_secs(1));
+    draw(&mut rig.cx);
+    assert!(
+        painted(
+            format!("tasks-card-tooltip-sub-thread-open-{}", child.session),
+            &mut rig.cx
+        ),
+        "Open has a tooltip"
+    );
+}
