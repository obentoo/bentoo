+// Story 064, task 5.1 — recorded native subagents after a restart, and the open fallback for a
+// child that is not loaded (R2.3, R2.4). Module path: `store::panel_native_subagent_restart`
+// (under `store` to reach `GlobalTaskHistoryStore`, story 014's restart recipe; the name
+// carries the Validation filter `cargo test -p agent_tasks_panel panel`). Fixtures:
+// `native_subagent_support.rs`, `test_helpers.rs`.
+//
+// Side effects are read where they land: the rows of the database itself (`load(&db)`), the
+// rows a freshly loaded panel lists, the session the agent panel shows, the window count, the
+// row's notice and the shown thread's scroll position.
+//
+// Hostile halves first:
+//   - a terminal transition is recorded ONCE, under the PARENT's session and the child's own
+//     key — never under the child's session, never twice (Started and Ended are one row);
+//   - after a restart the row reads its recorded, ended status — not running;
+//   - a child that is not loaded is never looked up in the thread metadata store: a decoy
+//     metadata row under the child's session id is never opened, and no window appears;
+//   - it opens the PARENT at the child's announcement, with the notice — never "Thread no
+//     longer exists", never 023's "no entry to jump to";
+//   - then the benign archive and delete of a recorded subagent row.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, TestAppContext};
+
+use super::{GlobalTaskHistoryStore, TaskHistoryStore};
+use crate::AgentTasksPanel;
+use crate::native_subagent_support::*;
+use crate::test_helpers::*;
+
+/// Restart: a new global store loaded from the same database, and a new panel over it.
+async fn restart(panels: &mut Panels, db: &crate::AgentTaskHistoryDb) -> Entity<AgentTasksPanel> {
+    let reloaded = panels
+        .cx
+        .update(|_, cx| cx.new(|cx| TaskHistoryStore::new(db.clone(), cx)));
+    panels
+        .cx
+        .update(|_, cx| cx.set_global(GlobalTaskHistoryStore(reloaded)));
+    let weak = panels.workspace.downgrade();
+    let loading = panels
+        .cx
+        .update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+    panels.cx.run_until_parked();
+    let panel = loading.await.expect("the Agent Tasks panel loads again");
+    panels.cx.run_until_parked();
+    panel
+}
+
+fn listed(
+    panel: &Entity<AgentTasksPanel>,
+    key: &Key,
+    panels: &mut Panels,
+) -> Option<crate::PanelRow> {
+    panel
+        .update(&mut panels.cx, |panel, cx| panel.groups(cx))
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .find(|row| row.entry.record.session_id == key.0 && row.entry.record.task_id == key.1)
+}
+
+// ── R2.3 — recorded on the terminal transition, listed after a restart ──────
+
+#[gpui::test]
+async fn panel_native_subagent_is_recorded_once_and_listed_after_a_restart(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    report_running(&alpha, &mut panels.cx);
+    report_done(&alpha, &mut panels.cx);
+    let key = subagent_key(&parent_session, "alpha");
+
+    let stored = load(&db).await;
+    let rows: Vec<_> = stored
+        .iter()
+        .filter(|entry| entry.record.task_id == key.1)
+        .collect();
+    assert_eq!(rows.len(), 1, "one terminal transition, one row: {rows:?}");
+    assert_eq!(
+        rows[0].record.session_id, parent_session,
+        "keyed by the parent's session, never the child's"
+    );
+    assert_eq!(rows[0].record.status, AgentTaskStatus::Completed);
+    assert_eq!(
+        rows[0].origin,
+        crate::TaskOrigin::AcpSubagent,
+        "a native record carries the origin acp_subagent (Revision 1: no source column)"
+    );
+    assert!(
+        stored
+            .iter()
+            .all(|entry| entry.record.session_id.to_string() != "alpha"),
+        "nothing is recorded under the child's own session"
+    );
+
+    let panel = restart(&mut panels, &db).await;
+    let row = listed(&panel, &key, &mut panels).expect("the recorded subagent row is listed");
+    assert_eq!(
+        row.entry.record.status,
+        AgentTaskStatus::Completed,
+        "it reads its recorded ending, not running"
+    );
+    assert!(!row.can_stop, "an ended record cannot be stopped");
+}
+
+/// Archive and delete work on a recorded subagent row as on any other record (story 014, 025).
+#[gpui::test]
+async fn panel_native_subagent_record_archives_and_deletes(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    seed_recorded_subagent(&db, &parent_session, "ghost").await;
+    let panel = restart(&mut panels, &db).await;
+    let key = subagent_key(&parent_session, "ghost");
+    assert!(
+        listed(&panel, &key, &mut panels).is_some(),
+        "precondition: listed"
+    );
+
+    panel.update(&mut panels.cx, |panel, cx| panel.archive(&key, cx));
+    panels.cx.run_until_parked();
+    let archived = load(&db)
+        .await
+        .into_iter()
+        .find(|entry| entry.record.session_id == key.0 && entry.record.task_id == key.1)
+        .expect("still stored");
+    assert!(archived.archived, "archive is written to the database");
+
+    let store = panels.cx.update(|_, cx| TaskHistoryStore::global(cx));
+    store.update(&mut panels.cx, |store, cx| {
+        store.delete_archived(std::slice::from_ref(&key), cx)
+    });
+    panels.cx.run_until_parked();
+    assert!(
+        load(&db)
+            .await
+            .into_iter()
+            .all(|entry| !(entry.record.session_id == key.0 && entry.record.task_id == key.1)),
+        "delete removes the archived record"
+    );
+}
+
+// ── R2.4 — an unloaded child opens its parent at its card, and says so ──────
+
+#[gpui::test]
+async fn panel_native_subagent_open_on_an_unloaded_child_opens_the_parent_at_its_card(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    pad(&parent, 0, &mut panels.cx);
+    let announcement = announce_to(&parent, "ghost", &mut panels.cx);
+    pad(&parent, 20, &mut panels.cx);
+    pad(&parent, 40, &mut panels.cx);
+    // Recorded by an earlier Zeo session; "ghost" is registered nowhere in this one.
+    seed_recorded_subagent(&db, &parent_session, "ghost").await;
+    save_decoy_metadata_for("ghost", &mut panels.cx);
+    let panel = restart(&mut panels, &db).await;
+    let key = subagent_key(&parent_session, "ghost");
+    assert!(
+        listed(&panel, &key, &mut panels).is_some(),
+        "precondition: the recorded subagent row is listed"
+    );
+    let windows = window_count(&mut panels.cx);
+
+    open_from(&panel, &key, &mut panels.cx);
+
+    assert_eq!(
+        window_count(&mut panels.cx),
+        windows,
+        "no window opens for the decoy under the child's id"
+    );
+    assert_eq!(
+        active_session(&panels),
+        Some(parent_session.clone()),
+        "the parent is the thread shown"
+    );
+    assert_eq!(
+        conversation_shows(&panels.agent_panel, &panels.cx),
+        Some(parent_session.clone()),
+        "the conversation shows the parent itself"
+    );
+    assert_eq!(
+        notice_of(&panel, &parent_session, key.1.as_ref(), &mut panels.cx).as_deref(),
+        Some(PARENT_ONLY_NOTICE),
+        "the row says the transcript lives with the parent"
+    );
+    assert_eq!(
+        scroll_top(&panels.agent_panel, &mut panels.cx),
+        announcement,
+        "the parent opens at the child's card (its announcement), not at its top or end"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/store/sub_thread.rs b/crates/agent_tasks_panel/src/store/sub_thread.rs
new file mode 100644
index 0000000..0db39eb
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/sub_thread.rs
@@ -0,0 +1,125 @@
+//! Story 040: the store's half of sub-thread items. `SubThreadActivity` from any registered card
+//! is applied to memory first, then queued on the same ordered writer as every task write
+//! (design.md, TaskHistoryStore and AgentTaskHistoryDb).
+
+use acp_thread::{AgentTaskId, AgentTaskStatus};
+use agent_ui::{SubThreadActivity, SubThreadRecord, TaskRecord};
+
+use super::{HistoryWrite, TaskHistoryStore};
+use crate::history_db::{SUB_THREAD_KIND, sub_thread_task_id};
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskOrigin};
+
+/// A sub-thread write, carried by `HistoryWrite::SubThread`.
+pub(super) enum SubThreadWrite {
+    /// `Linked` or `Retitled`: a new item Idle, an existing one its description only.
+    Link(SubThreadRecord),
+    /// `Running` or `Idle`, as the stored status text.
+    Status(SubThreadRecord, &'static str),
+}
+
+impl SubThreadWrite {
+    pub(super) async fn run(&self, db: &AgentTaskHistoryDb) -> anyhow::Result<()> {
+        let result = match self {
+            Self::Link(record) => db.record_sub_thread_link(record).await,
+            Self::Status(record, status) => db.upsert_sub_thread(record, status).await,
+        };
+        let (record, status) = self.parts();
+        // Session ids and the status only: the title is user text (R8.1).
+        match &result {
+            Ok(()) => log::info!(
+                "zeo_sub_thread event=history_write parent_session={} sub_session={} \
+                 status={status} result=ok",
+                record.parent_session,
+                record.sub_session
+            ),
+            Err(error) => log::error!(
+                "zeo_sub_thread event=history_write parent_session={} sub_session={} \
+                 status={status} result=failed; kept in memory only: {error:#}",
+                record.parent_session,
+                record.sub_session
+            ),
+        }
+        result
+    }
+
+    fn parts(&self) -> (&SubThreadRecord, &'static str) {
+        match self {
+            Self::Link(record) => (record, "link"),
+            Self::Status(record, status) => (record, status),
+        }
+    }
+
+    pub(super) fn describe(&self) -> String {
+        let (record, status) = self.parts();
+        format!(
+            "the {status} of sub-thread {} in session {}",
+            record.sub_session, record.parent_session
+        )
+    }
+}
+
+impl TaskHistoryStore {
+    pub(super) fn record_sub_thread(&mut self, activity: SubThreadActivity) {
+        let (record, status) = match activity {
+            SubThreadActivity::Linked(record) | SubThreadActivity::Retitled(record) => {
+                (record, None)
+            }
+            SubThreadActivity::Running(record) => (record, Some(AgentTaskStatus::Running)),
+            SubThreadActivity::Idle(record) => (record, Some(AgentTaskStatus::Completed)),
+        };
+        let task_id = AgentTaskId::from(sub_thread_task_id(&record));
+        let key = (record.parent_session.clone(), task_id.clone());
+        // Deleted this session: a later report must not bring the item back before restart.
+        if self.deleted.contains(&key) {
+            return;
+        }
+        match self.position(&record.parent_session, &task_id) {
+            // An adapter task on the same key is never rewritten, as the database guard says.
+            Some(index) if self.records[index].origin != TaskOrigin::SubThread => return,
+            Some(index) => {
+                let entry = &mut self.records[index].record;
+                entry.description = record.title.clone();
+                if let Some(status) = status {
+                    entry.status = status;
+                    entry.ended_at_ms = ended_at(status, &record);
+                }
+            }
+            None => {
+                let status = status.unwrap_or(AgentTaskStatus::Completed);
+                self.insert_entry(HistoryEntry {
+                    record: TaskRecord {
+                        session_id: record.parent_session.clone(),
+                        task_id,
+                        thread_title: None,
+                        project: record.project.clone(),
+                        kind: SUB_THREAD_KIND.into(),
+                        description: record.title.clone(),
+                        background: false,
+                        started_at_ms: record.at_ms,
+                        ended_at_ms: ended_at(status, &record),
+                        status,
+                        tokens: None,
+                        tool_uses: None,
+                        tool_call_id: None,
+                        child_session_id: None,
+                        waiting: false,
+                    },
+                    archived: false,
+                    label: None,
+                    log_bytes: None,
+                    origin: TaskOrigin::SubThread,
+                });
+            }
+        }
+        let write = match status {
+            None => SubThreadWrite::Link(record),
+            Some(AgentTaskStatus::Running) => SubThreadWrite::Status(record, "running"),
+            Some(_) => SubThreadWrite::Status(record, "completed"),
+        };
+        self.queue_write(HistoryWrite::SubThread(write));
+    }
+}
+
+fn ended_at(status: AgentTaskStatus, record: &SubThreadRecord) -> Option<i64> {
+    (!status.is_running()).then_some(record.at_ms)
+}
diff --git a/crates/agent_tasks_panel/src/store/sub_thread_tests.rs b/crates/agent_tasks_panel/src/store/sub_thread_tests.rs
new file mode 100644
index 0000000..f01e836
--- /dev/null
+++ b/crates/agent_tasks_panel/src/store/sub_thread_tests.rs
@@ -0,0 +1,486 @@
+// Story 040, task 3.2 (store half) — `TaskHistoryStore` persists `SubThreadActivity` from every
+// registered card (R5.1–R5.5, R5.8, R5.9; Q4, Q14). Module path: `store::sub_thread`. Wired in
+// `src/store.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "store/sub_thread_tests.rs"]
+//     mod sub_thread;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- sub_thread` (names carry
+// `store_sub_thread`).
+//
+// Contract (design.md §SubThreadReporter, §TaskHistoryStore and AgentTaskHistoryDb):
+//   - `agent_ui::{SubThreadActivity, SubThreadRecord}`; `SubThreadActivity::{Linked, Running,
+//     Idle, Retitled}(SubThreadRecord)`; `impl EventEmitter<SubThreadActivity> for TasksCard`;
+//   - `register_card` subscribes to it beside `TaskActivity`: `Linked` and `Retitled` →
+//     `record_sub_thread_link` (inserted `completed` when new, else the description only — never
+//     the status), `Running` → `running`, `Idle` → `completed` with `ended_at`; never `archived`;
+//     every write logs `zeo_sub_thread event=history_write` with both session ids and the status;
+//   - memory first, then the ordered writer; a failed write keeps memory and logs at error level
+//     with both session ids and never the title (R5.8);
+//   - the item: session = parent session, task id `zeo-sub-thread:<sub session>`, kind
+//     `sub_thread`, origin `TaskOrigin::SubThread`.
+// The store is fed as story 014's tests feed it: events emitted on the real card of an
+// `AgentPanel`. Assumed beyond design.md: `SubThreadRecord`'s fields are `pub`, it is `Clone`.
+//
+// Hostile halves first:
+//   - wrongly split: one link heard twice — and heard from a second registered card, as a second
+//     window would — is ONE item, in memory and on disk (R5.2);
+//   - a second window's `Linked`, or a `Retitled`, arriving while the sub-thread runs leaves it
+//     Running, in memory and on disk (R5.3, R7.4);
+//   - wrongly collapse: two sub-threads of one parent are two items; an adapter task whose kind
+//     is `sub_thread` stays an adapter task in memory (R5.7);
+//   - deleting a sub-thread item touches neither the organization store nor the thread metadata
+//     (Q14, R7.6);
+//   - then the benign lifecycle.
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::thread_metadata_store::ThreadMetadataStore;
+use agent_ui::thread_organization::{ForkKind, ThreadOrganizationStore};
+use agent_ui::{SubThreadActivity, SubThreadRecord, TasksCard};
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn sub_record(parent: &str, sub: &str, title: &str, at_ms: i64) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: sid(parent),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms,
+    }
+}
+
+/// A store over `db`, registered on the rig's card.
+fn registered_store(db: &AgentTaskHistoryDb, rig: &mut CardRig) -> Entity<TaskHistoryStore> {
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    store
+}
+
+fn emit_sub(card: &Entity<TasksCard>, activity: SubThreadActivity, cx: &mut VisualTestContext) {
+    card.update(cx, |_, cx| cx.emit(activity));
+    cx.run_until_parked();
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn item<'a>(rows: &'a [HistoryEntry], parent: &str, sub: &str) -> Option<&'a HistoryEntry> {
+    find(rows, parent, &format!("{PREFIX}{sub}"))
+}
+
+fn sub_items(rows: &[HistoryEntry]) -> Vec<(String, String)> {
+    rows.iter()
+        .filter(|entry| entry.origin == TaskOrigin::SubThread)
+        .map(key_of)
+        .collect()
+}
+
+// ── Wrongly split (R5.2) ───────────────────────────────────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_link_heard_twice_and_from_two_cards_is_one_item(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_twice").await;
+    let store = registered_store(&db, &mut rig);
+    // A second window's card, registered with the same store.
+    let second_card = rig.cx.new(|cx| TasksCard::new(cx));
+    store.update(&mut rig.cx, |store, cx| {
+        store.register_card(&second_card, cx)
+    });
+    rig.cx.run_until_parked();
+
+    let linked = sub_record("p1", "sub-a", "Alpha", 1_000);
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(linked.clone()),
+        &mut rig.cx,
+    );
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(linked.clone()),
+        &mut rig.cx,
+    );
+    emit_sub(&second_card, SubThreadActivity::Linked(linked), &mut rig.cx);
+
+    assert_eq!(
+        sub_items(&entries(&store, &rig.cx)),
+        vec![("p1".to_string(), format!("{PREFIX}sub-a"))],
+        "one item in memory"
+    );
+    assert_eq!(
+        sub_items(&load(&db).await),
+        vec![("p1".to_string(), format!("{PREFIX}sub-a"))],
+        "one item on disk"
+    );
+}
+
+// A re-report while running (design.md 2026-10-20: `Linked`/`Retitled` never touch the status).
+#[gpui::test]
+async fn store_sub_thread_second_card_link_while_running_stays_running(cx: &mut TestAppContext) {
+    capture_logs();
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_relink_running").await;
+    let store = registered_store(&db, &mut rig);
+    let second_card = rig.cx.new(|cx| TasksCard::new(cx));
+    store.update(&mut rig.cx, |store, cx| {
+        store.register_card(&second_card, cx)
+    });
+    rig.cx.run_until_parked();
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-a", "Alpha", 1_000)),
+        &mut rig.cx,
+    );
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Running(sub_record("p1", "sub-a", "Alpha", 2_000)),
+        &mut rig.cx,
+    );
+    // Another window's reporter reports the same link, then the title changes.
+    emit_sub(
+        &second_card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-a", "Alpha", 3_000)),
+        &mut rig.cx,
+    );
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Retitled(sub_record("p1", "sub-a", "Alpha renamed", 4_000)),
+        &mut rig.cx,
+    );
+
+    let memory = entries(&store, &rig.cx);
+    let entry = item(&memory, "p1", "sub-a").expect("in memory");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Running,
+        "still Running in memory"
+    );
+    assert_eq!(entry.record.description.as_ref(), "Alpha renamed");
+    let disk = load(&db).await;
+    let entry = item(&disk, "p1", "sub-a").expect("on disk");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Running,
+        "still Running on disk"
+    );
+    assert_eq!(entry.record.description.as_ref(), "Alpha renamed");
+    assert_eq!(sub_items(&disk).len(), 1, "one item");
+    assert!(
+        log_lines()
+            .iter()
+            .any(|line| line.contains("zeo_sub_thread")
+                && line.contains("history_write")
+                && line.contains("p1")
+                && line.contains("sub-a")),
+        "every write is logged with both ids"
+    );
+    assert!(
+        log_lines()
+            .iter()
+            .all(|line| !line.contains("Alpha renamed")),
+        "never the title"
+    );
+}
+
+// ── Wrongly collapse (R5.1, R5.7) ──────────────────────────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_two_sub_threads_of_one_parent_are_two_items(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_two").await;
+    let store = registered_store(&db, &mut rig);
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-a", "Alpha", 1_000)),
+        &mut rig.cx,
+    );
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-b", "Bravo", 2_000)),
+        &mut rig.cx,
+    );
+
+    let memory = entries(&store, &rig.cx);
+    assert_eq!(
+        item(&memory, "p1", "sub-a").map(|e| e.record.description.to_string()),
+        Some("Alpha".to_string())
+    );
+    assert_eq!(
+        item(&memory, "p1", "sub-b").map(|e| e.record.description.to_string()),
+        Some("Bravo".to_string())
+    );
+    assert_eq!(sub_items(&load(&db).await).len(), 2, "two items on disk");
+}
+
+#[gpui::test]
+async fn store_sub_thread_adapter_task_of_kind_sub_thread_stays_adapter(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_adapter_kind").await;
+    let store = registered_store(&db, &mut rig);
+
+    let mut look_alike = record(
+        "p1",
+        "zeo-sub-thread:sub-a",
+        AgentTaskStatus::Running,
+        1_000,
+    );
+    look_alike.kind = "sub_thread".into();
+    emit(&rig.card, started(&look_alike), &mut rig.cx);
+
+    let memory = entries(&store, &rig.cx);
+    let entry = find(&memory, "p1", "zeo-sub-thread:sub-a").expect("the task is recorded");
+    assert_eq!(entry.origin, TaskOrigin::Adapter, "in memory");
+    let disk = load(&db).await;
+    let entry = find(&disk, "p1", "zeo-sub-thread:sub-a").expect("the task is written");
+    assert_eq!(entry.origin, TaskOrigin::Adapter, "on disk");
+}
+
+// ── Delete touches the history only (Q14, R7.6) ────────────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_archive_and_delete_leave_the_link_and_the_threads(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_delete").await;
+    let store = registered_store(&db, &mut rig);
+    rig.cx
+        .update(|_, cx| agent_ui::thread_organization::init(cx));
+    rig.cx.run_until_parked();
+
+    let parent_thread = open_thread_on(
+        &rig.agent_panel,
+        StopConnection::new(),
+        "Parent",
+        &mut rig.cx,
+    );
+    let parent_id = agent_ui::test_support::active_thread_id(&rig.agent_panel, &rig.cx);
+    let child_thread = open_thread_on(
+        &rig.agent_panel,
+        StopConnection::new(),
+        "Child",
+        &mut rig.cx,
+    );
+    let child_id = agent_ui::test_support::active_thread_id(&rig.agent_panel, &rig.cx);
+    let parent_session = session_of(&parent_thread, &rig.cx);
+    let child_session = session_of(&child_thread, &rig.cx);
+    rig.cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_parent(child_id, parent_id, ForkKind::Clean, cx)
+                .expect("the link is recorded")
+        })
+    });
+    rig.cx.run_until_parked();
+
+    let record = SubThreadRecord {
+        parent_session: parent_session.clone(),
+        sub_session: child_session.clone(),
+        title: "Child".into(),
+        project: "project".into(),
+        at_ms: 1_000,
+    };
+    emit_sub(&rig.card, SubThreadActivity::Linked(record), &mut rig.cx);
+    let item_key: crate::TaskKey = (
+        parent_session.clone(),
+        format!("{PREFIX}{child_session}").into(),
+    );
+    assert!(
+        store.read_with(&rig.cx, |store, _| store.records().iter().any(|entry| (
+            entry.record.session_id.clone(),
+            entry.record.task_id.clone()
+        )
+            == item_key)),
+        "precondition: the item is recorded"
+    );
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.archive(std::slice::from_ref(&item_key), cx)
+    });
+    rig.cx.run_until_parked();
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(std::slice::from_ref(&item_key), cx)
+    });
+    rig.cx.run_until_parked();
+
+    assert!(
+        item(
+            &load(&db).await,
+            &parent_session.to_string(),
+            &child_session.to_string()
+        )
+        .is_none(),
+        "the history item is deleted"
+    );
+    rig.cx.update(|_, cx| {
+        let organization = ThreadOrganizationStore::global(cx);
+        assert_eq!(
+            organization.read(cx).parent(child_id),
+            Some((parent_id, ForkKind::Clean)),
+            "the parent link is untouched"
+        );
+        let metadata = ThreadMetadataStore::global(cx);
+        let metadata = metadata.read(cx);
+        let parent = metadata
+            .entry(parent_id)
+            .expect("the parent thread still exists");
+        assert!(!parent.archived, "the parent thread is not archived");
+        let child = metadata
+            .entry(child_id)
+            .expect("the sub-thread still exists");
+        assert!(!child.archived, "the sub-thread is not archived");
+    });
+}
+
+// ── Lifecycle (R5.1, R5.3, R5.5, R5.9) ─────────────────────────────────────
+
+#[gpui::test]
+async fn store_sub_thread_lifecycle_running_idle_and_retitled(cx: &mut TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_sub_thread_lifecycle").await;
+    let store = registered_store(&db, &mut rig);
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Linked(sub_record("p1", "sub-a", "Alpha", 1_000)),
+        &mut rig.cx,
+    );
+    let linked = entries(&store, &rig.cx);
+    let entry = item(&linked, "p1", "sub-a").expect("Linked records the item");
+    assert_eq!(entry.origin, TaskOrigin::SubThread);
+    assert_eq!(entry.record.kind.as_ref(), "sub_thread");
+    assert_eq!(
+        entry.record.status,
+        AgentTaskStatus::Completed,
+        "a link alone is Idle"
+    );
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Running(sub_record("p1", "sub-a", "Alpha", 2_000)),
+        &mut rig.cx,
+    );
+    let running = entries(&store, &rig.cx);
+    assert_eq!(
+        item(&running, "p1", "sub-a").unwrap().record.status,
+        AgentTaskStatus::Running
+    );
+    assert_eq!(
+        item(&load(&db).await, "p1", "sub-a").unwrap().record.status,
+        AgentTaskStatus::Running,
+        "written too"
+    );
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Idle(sub_record("p1", "sub-a", "Alpha", 3_000)),
+        &mut rig.cx,
+    );
+    let idle = entries(&store, &rig.cx);
+    let entry = item(&idle, "p1", "sub-a").unwrap();
+    assert_eq!(entry.record.status, AgentTaskStatus::Completed);
+    assert!(
+        entry.record.ended_at_ms.is_some(),
+        "Idle carries when it stopped"
+    );
+
+    emit_sub(
+        &rig.card,
+        SubThreadActivity::Retitled(sub_record("p1", "sub-a", "Alpha renamed", 4_000)),
+        &mut rig.cx,
+    );
+    assert_eq!(
+        item(&entries(&store, &rig.cx), "p1", "sub-a")
+            .unwrap()
+            .record
+            .description
+            .as_ref(),
+        "Alpha renamed"
+    );
+    let disk = load(&db).await;
+    assert_eq!(
+        item(&disk, "p1", "sub-a")
+            .unwrap()
+            .record
+            .description
+            .as_ref(),
+        "Alpha renamed"
+    );
+    assert!(
+        !item(&disk, "p1", "sub-a").unwrap().archived,
+        "never archived by an event"
+    );
+}
+
