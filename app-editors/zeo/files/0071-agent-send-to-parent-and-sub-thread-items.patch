+        "a stopped sub-thread reads Idle"
+    );
+    let row = find_row(&mut panels, &parent_session.to_string(), &sub_task("sub-a"))
+        .expect("still listed once idle");
+    assert_ne!(row.entry.record.status, AgentTaskStatus::Running);
+}
