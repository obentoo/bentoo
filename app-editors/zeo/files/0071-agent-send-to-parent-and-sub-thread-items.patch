diff --git a/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs b/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs
new file mode 100644
index 0000000..bcb4137
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/tombstone_step_tests.rs
@@ -0,0 +1,197 @@
+// Story 040, task 11.1 (migration half) — step 6 of `HISTORY_MIGRATIONS`, `deleted` (Q13; review
+// 3.x F1). Module path: `history_db::tombstone_step`. Wired in `src/history_db.rs`, after
+// `mod sub_thread_upsert;`, as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/tombstone_step_tests.rs"]
+//     mod tombstone_step;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- history_db` (names carry
+// `history_db_tombstone`). The tombstone's behaviour is in `tombstone_tests.rs`.
+//
+// Contract (design.md v4, "Tombstone (v4, review 3.x F1, R5.10)"; story.md Q13): step 6 (index 5)
+// is `sql!(ALTER TABLE agent_task_history ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;)`,
+// appended after the five shipped steps, which stay byte-identical — never folded into step 5,
+// which already ran in every database of tasks 3–7.
+//
+// Hostile half first: a database written by the five shipped steps, holding rows of both
+// origins, keeps every row and value through step 6, each live; then the step's own pin.
+
+use db::sqlez::{connection::Connection, domain::Domain};
+use db::sqlez_macros::sql;
+
+use crate::AgentTaskHistoryDb;
+
+// The five shipped steps, byte for byte (steps 1–4 as `origin_tests.rs` copies them, step 5 as
+// story 040's task 3.1 shipped it).
+const SHIPPED_STEP_0: &str = sql!(
+    CREATE TABLE IF NOT EXISTS agent_task_history(
+        session_id TEXT NOT NULL,
+        task_id TEXT NOT NULL,
+        thread_title TEXT,
+        project TEXT NOT NULL,
+        kind TEXT NOT NULL,
+        description TEXT NOT NULL,
+        background INTEGER NOT NULL,
+        status TEXT NOT NULL,
+        started_at INTEGER NOT NULL,
+        ended_at INTEGER,
+        tokens INTEGER,
+        tool_uses INTEGER,
+        archived INTEGER NOT NULL DEFAULT 0,
+        PRIMARY KEY(session_id, task_id)
+    ) STRICT;
+    CREATE INDEX IF NOT EXISTS agent_task_history_started ON agent_task_history(started_at);
+);
+const SHIPPED_STEP_1: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN label TEXT;);
+const SHIPPED_STEP_2: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN tool_call_id TEXT;);
+const SHIPPED_STEP_3: &str = sql!(ALTER TABLE agent_task_history ADD COLUMN log_bytes INTEGER;);
+const SHIPPED_STEP_4: &str =
+    sql!(ALTER TABLE agent_task_history ADD COLUMN origin TEXT NOT NULL DEFAULT "adapter";);
+
+const TOMBSTONE_STEP: &str =
+    sql!(ALTER TABLE agent_task_history ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;);
+
+fn tombstone_migrate_all(connection: &Connection) {
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            AgentTaskHistoryDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the history migrations should apply");
+}
+
+/// One fixed SQL statement of this test (sqlez, not a process).
+fn tombstone_sql_now(connection: &Connection, statement: &str) {
+    let mut run = connection.exec(statement).expect("statement prepares");
+    run().expect("statement runs");
+}
+
+// ── The step itself (Q13) ──────────────────────────────────────────────────
+
+#[test]
+fn history_db_tombstone_step_is_appended_after_the_five_shipped_steps() {
+    let steps = AgentTaskHistoryDb::MIGRATIONS;
+    assert!(
+        steps.len() >= 6,
+        "a sixth step exists: {} steps",
+        steps.len()
+    );
+    assert!(steps[0] == SHIPPED_STEP_0, "step 1 is never edited");
+    assert!(
+        steps[1] == SHIPPED_STEP_1,
+        "step 2 (story 022) is never edited"
+    );
+    assert!(
+        steps[2] == SHIPPED_STEP_2,
+        "step 3 (story 023) is never edited"
+    );
+    assert!(
+        steps[3] == SHIPPED_STEP_3,
+        "step 4 (story 041) is never edited"
+    );
+    assert!(
+        steps[4] == SHIPPED_STEP_4,
+        "step 5 (story 040, origin) is never edited, nor folded into step 6"
+    );
+    assert!(steps[5] == TOMBSTONE_STEP, "step 6 adds the deleted column");
+    assert_eq!(
+        steps.iter().filter(|step| **step == TOMBSTONE_STEP).count(),
+        1,
+        "appended exactly once"
+    );
+}
+
+// Hostile (Q13): a database written by the five shipped steps, holding adapter tasks and
+// sub-thread items, archived or not, opens with the new list and keeps every row and value, each
+// live (`deleted = 0`). A second open changes nothing more.
+#[test]
+fn history_db_tombstone_step_five_database_keeps_every_row_live() {
+    let connection = Connection::open_memory(Some("history_db_tombstone_step_five"));
+    connection
+        .migrate(
+            AgentTaskHistoryDb::NAME,
+            &[
+                SHIPPED_STEP_0,
+                SHIPPED_STEP_1,
+                SHIPPED_STEP_2,
+                SHIPPED_STEP_3,
+                SHIPPED_STEP_4,
+            ],
+            &mut |_, _, _| false,
+        )
+        .expect("the shipped steps apply");
+    for (session, task, kind, origin, archived, log_bytes) in [
+        ("p1", "t1", "shell", "adapter", 1, "4096"),
+        ("p1", "t2", "shell", "adapter", 0, "NULL"),
+        (
+            "p1",
+            "zeo-sub-thread:s-a",
+            "sub_thread",
+            "sub_thread",
+            1,
+            "NULL",
+        ),
+        (
+            "p1",
+            "zeo-sub-thread:s-b",
+            "sub_thread",
+            "sub_thread",
+            0,
+            "NULL",
+        ),
+    ] {
+        tombstone_sql_now(
+            &connection,
+            &format!(
+                "INSERT INTO agent_task_history \
+                 (session_id, task_id, thread_title, project, kind, description, background, \
+                  status, started_at, ended_at, archived, label, tool_call_id, log_bytes, origin) \
+                 VALUES ('{session}', '{task}', NULL, 'zeo', '{kind}', 'Kept {task}', 0, \
+                         'completed', 1000, 2000, {archived}, NULL, NULL, {log_bytes}, \
+                         '{origin}')"
+            ),
+        );
+    }
+
+    tombstone_migrate_all(&connection);
+    tombstone_migrate_all(&connection);
+
+    let columns = connection
+        .select::<String>("SELECT name FROM pragma_table_info('agent_task_history')")
+        .expect("select")()
+    .expect("run");
+    assert!(
+        columns.iter().any(|column| column == "deleted"),
+        "step 6 adds the deleted column: {columns:?}"
+    );
+    let rows = connection
+        .select::<(String, String, String, bool, Option<i64>, String, i64)>(
+            "SELECT session_id, task_id, description, archived, log_bytes, origin, deleted \
+             FROM agent_task_history ORDER BY session_id, task_id",
+        )
+        .expect("select")()
+    .expect("run");
+    assert_eq!(
+        rows.len(),
+        4,
+        "every row survives, and none is added: {rows:?}"
+    );
+    let expected = [
+        ("t1", true, Some(4096), "adapter"),
+        ("t2", false, None, "adapter"),
+        ("zeo-sub-thread:s-a", true, None, "sub_thread"),
+        ("zeo-sub-thread:s-b", false, None, "sub_thread"),
+    ];
+    for ((session, task, description, archived, log_bytes, origin, deleted), want) in
+        rows.into_iter().zip(expected)
+    {
+        assert_eq!((session.as_str(), task.as_str()), ("p1", want.0));
+        assert_eq!(description, format!("Kept {task}"), "{task} keeps its text");
+        assert_eq!(archived, want.1, "{task} keeps its archive flag");
+        assert_eq!(log_bytes, want.2, "{task} keeps its log size");
+        assert_eq!(origin, want.3, "{task} keeps its origin");
+        assert_eq!(deleted, 0, "{task} is live, not a tombstone");
+    }
+}
diff --git a/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs b/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs
new file mode 100644
index 0000000..6eed9b2
--- /dev/null
+++ b/crates/agent_tasks_panel/src/history_db/tombstone_tests.rs
@@ -0,0 +1,427 @@
+// Story 040, task 11.1 (database half) — the tombstone of a deleted sub-thread item (R5.10,
+// R7.6; Q14; review 3.x F1). Module path: `history_db::tombstone`. Wired in `src/history_db.rs`,
+// after `mod sub_thread_upsert;`, as
+//
+//     #[cfg(test)]
+//     #[path = "history_db/tombstone_tests.rs"]
+//     mod tombstone;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- history_db` (names carry
+// `history_db_tombstone`). Step 6 itself is pinned in `tombstone_step_tests.rs`.
+//
+// Contract (design.md v4, "Tombstone (v4, review 3.x F1, R5.10)"):
+//   - `AgentTaskHistoryDb::delete` keeps its contract — archived rows only, returns the indices it
+//     removed — but a row of origin `sub_thread` is kept with `deleted = 1`; an adapter row is
+//     still removed;
+//   - `load_all` skips `deleted = 1` rows; `AgentTaskHistoryDb::deleted_sub_thread_keys()` returns
+//     their keys;
+//   - `upsert_sub_thread` and `record_sub_thread_link` never rewrite nor revive a tombstone.
+// Assumed beyond design.md: `deleted_sub_thread_keys` is `async`, returns `anyhow::Result` of a
+// collection of `TaskKey` (`(SessionId, AgentTaskId)`) — adjust in `tombstones` only; a
+// tombstoned row counts among the indices `delete` returns, since it is deleted from the user's
+// view and `delete` "keeps its contract" (a sub-thread row has no log, so the log delete the
+// store runs for it is a no-op).
+//
+// Hostile halves first, for "a deleted item is the SAME item when it is reported again":
+//   - wrongly split (the revival): the same sub-thread linked, run and idled again after its
+//     delete stays deleted, and its row is never rewritten;
+//   - wrongly collapse: tombstoning one sub-thread hides neither its sibling under the same
+//     parent, nor the same sub session under another parent, nor an adapter task of the parent
+//     whose id is the sub session — the third element against the derived key
+//     `zeo-sub-thread:<sub>`;
+//   - the origin alone decides: an adapter row dressed as a sub-thread (kind `sub_thread`, the
+//     prefix) is removed, a stored sub-thread row with plain kind and id is tombstoned;
+//   - the guard is not over-broad: a live item of the same parent is still refreshed, and a new
+//     one still inserted, after a sibling's tombstone;
+//   - then the benign shapes (a non-archived item is not deleted; an archived adapter row goes).
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::SubThreadRecord;
+use gpui::TestAppContext;
+
+use crate::history_db::TaskOrigin;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn tombstone_sub_record(parent: &str, sub: &str, title: &str, at_ms: i64) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: sid(parent),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms,
+    }
+}
+
+fn sub_key(parent: &str, sub: &str) -> Key {
+    key(parent, &format!("{PREFIX}{sub}"))
+}
+
+async fn tombstone_upsert(db: &AgentTaskHistoryDb, record: &SubThreadRecord, status: &str) {
+    db.upsert_sub_thread(record, status)
+        .await
+        .expect("upsert_sub_thread should succeed");
+}
+
+async fn tombstone_link(db: &AgentTaskHistoryDb, record: &SubThreadRecord) {
+    db.record_sub_thread_link(record)
+        .await
+        .expect("record_sub_thread_link should succeed");
+}
+
+/// An archived, idle sub-thread item, ready to be deleted.
+async fn archived_item(db: &AgentTaskHistoryDb, parent: &str, sub: &str, title: &str, at: i64) {
+    tombstone_upsert(
+        db,
+        &tombstone_sub_record(parent, sub, title, at),
+        "completed",
+    )
+    .await;
+    db.set_archived(&[sub_key(parent, sub)], true)
+        .await
+        .expect("set_archived should succeed");
+}
+
+/// An archived, completed adapter task.
+async fn archived_task(db: &AgentTaskHistoryDb, task: &agent_ui::TaskRecord) {
+    db.insert_started(task)
+        .await
+        .expect("insert_started should succeed");
+    db.set_archived(&[(task.session_id.clone(), task.task_id.clone())], true)
+        .await
+        .expect("set_archived should succeed");
+}
+
+/// `deleted_sub_thread_keys`, as sorted `(session, task)` text pairs.
+async fn tombstones(db: &AgentTaskHistoryDb) -> Vec<(String, String)> {
+    let mut keys: Vec<(String, String)> = db
+        .deleted_sub_thread_keys()
+        .await
+        .expect("deleted_sub_thread_keys should succeed")
+        .into_iter()
+        .map(|(session_id, task_id)| (session_id.to_string(), task_id.to_string()))
+        .collect();
+    keys.sort();
+    keys
+}
+
+fn pair(session: &str, task: &str) -> (String, String) {
+    (session.to_string(), task.to_string())
+}
+
+fn sub_pair(parent: &str, sub: &str) -> (String, String) {
+    pair(parent, &format!("{PREFIX}{sub}"))
+}
+
+/// How many rows the table physically holds for `(session, task)`, hidden or not. Reads no
+/// column story 040 adds, so it answers on any schema.
+fn rows_on_key(db: &AgentTaskHistoryDb, session: &str, task: &str) -> usize {
+    db.select::<(String, String)>("SELECT session_id, task_id FROM agent_task_history")
+        .expect("select prepares")()
+    .expect("select runs")
+    .into_iter()
+    .filter(|(s, t)| s == session && t == task)
+    .count()
+}
+
+/// The stored `(description, status, deleted)` of one row. Reads the step-6 column: call it only
+/// after an assertion that fails without that step.
+fn stored_row(db: &AgentTaskHistoryDb, session: &str, task: &str) -> (String, String, i64) {
+    let rows = db
+        .select::<(String, String, String, String, i64)>(
+            "SELECT session_id, task_id, description, status, deleted FROM agent_task_history",
+        )
+        .expect("select prepares")()
+    .expect("select runs");
+    rows.into_iter()
+        .find(|(s, t, ..)| s == session && t == task)
+        .map(|(_, _, description, status, deleted)| (description, status, deleted))
+        .unwrap_or_else(|| panic!("{session}/{task} has a row"))
+}
+
+fn listed(rows: &[HistoryEntry], session: &str, task: &str) -> bool {
+    find(rows, session, task).is_some()
+}
+
+// ── Wrongly split: the revival (R5.10, Q14) ────────────────────────────────
+
+// The replay of the next start reports every link again, then the sub-thread may run: none of it
+// brings the deleted item back, and the tombstone row itself is never rewritten.
+#[gpui::test]
+async fn history_db_tombstone_no_sub_thread_write_revives_a_deleted_item(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_no_revival").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    db.delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha relinked", 2_000),
+    )
+    .await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha running", 3_000),
+        "running",
+    )
+    .await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha idle", 4_000),
+        "completed",
+    )
+    .await;
+    tombstone_link(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha retitled", 5_000),
+    )
+    .await;
+
+    let rows = load(&db).await;
+    assert!(
+        !listed(&rows, "p1", &format!("{PREFIX}sub-a")),
+        "a deleted item is never listed again: {rows:?}"
+    );
+    assert_eq!(
+        tombstones(&db).await,
+        vec![sub_pair("p1", "sub-a")],
+        "the item is still a tombstone"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", &format!("{PREFIX}sub-a")),
+        1,
+        "one row on the key: no second row"
+    );
+    let (description, status, deleted) = stored_row(&db, "p1", &format!("{PREFIX}sub-a"));
+    assert_eq!(deleted, 1, "still deleted");
+    assert_eq!(
+        description, "Alpha",
+        "the tombstone's description is never rewritten"
+    );
+    assert_eq!(
+        status, "completed",
+        "the tombstone's status is never rewritten"
+    );
+}
+
+// ── Wrongly collapse ───────────────────────────────────────────────────────
+
+// One sub-thread's tombstone hides only that item: not its sibling under the same parent, not the
+// same sub session recorded under another parent, and not an adapter task of the parent whose id
+// is the sub session (the derived key's third element).
+#[gpui::test]
+async fn history_db_tombstone_hides_only_the_deleted_item(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_only_that_item").await;
+    archived_item(&db, "p1", "sub-a", "Alpha", 1_000).await;
+    archived_item(&db, "p1", "sub-b", "Bravo", 1_100).await;
+    archived_item(&db, "p2", "sub-a", "Alpha elsewhere", 1_200).await;
+    archived_task(
+        &db,
+        &record("p1", "sub-a", AgentTaskStatus::Completed, 1_300),
+    )
+    .await;
+    db.insert_started(&record("p1", "t-live", AgentTaskStatus::Running, 1_400))
+        .await
+        .expect("insert_started should succeed");
+
+    let removed = db
+        .delete(&[sub_key("p1", "sub-a")])
+        .await
+        .expect("delete should succeed");
+
+    assert_eq!(
+        tombstones(&db).await,
+        vec![sub_pair("p1", "sub-a")],
+        "exactly the deleted item is a tombstone"
+    );
+    assert_eq!(
+        removed,
+        vec![0],
+        "the tombstoned item is reported as deleted"
+    );
+    assert_eq!(
+        rows_on_key(&db, "p1", &format!("{PREFIX}sub-a")),
+        1,
+        "the deleted sub-thread row is kept, hidden"
+    );
+    let rows = load(&db).await;
+    assert!(
+        !listed(&rows, "p1", &format!("{PREFIX}sub-a")),
+        "the deleted item is hidden"
+    );
+    assert!(
+        listed(&rows, "p1", &format!("{PREFIX}sub-b")),
+        "its sibling is still listed"
+    );
+    assert!(
+        listed(&rows, "p2", &format!("{PREFIX}sub-a")),
+        "the same sub session under another parent is still listed"
+    );
+    assert!(
+        listed(&rows, "p1", "sub-a"),
+        "an adapter task whose id is the sub session is still listed"
+    );
+    assert!(
+        listed(&rows, "p1", "t-live"),
+        "the parent's live task is still listed"
+    );
+    assert_eq!(
+        stored_row(&db, "p1", &format!("{PREFIX}sub-a")).2,
+        1,
+        "deleted = 1"
+    );
+    assert_eq!(
+        stored_row(&db, "p1", &format!("{PREFIX}sub-b")).2,
+        0,
+        "sibling deleted = 0"
+    );
+}
+
+// ── The origin alone decides (R5.7) ────────────────────────────────────────
+
+// Wrong split: a row stored as a sub-thread item, with nothing else about it looking like one,
+// is tombstoned, not removed.
+#[gpui::test]
+async fn history_db_tombstone_stored_sub_thread_with_plain_kind_and_id_is_tombstoned(
+    _cx: &mut TestAppContext,
+) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_plain_sub_thread").await;
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at, \
+          archived, origin) \
+         VALUES ('p1', 'plain-id', 'zeo', 'shell', 'Looks adapter', 0, 'completed', 1000, 1, \
+                 'sub_thread')",
+    )
+    .await;
+
+    db.delete(&[key("p1", "plain-id")])
+        .await
+        .expect("delete should succeed");
+
+    assert_eq!(
+        tombstones(&db).await,
+        vec![pair("p1", "plain-id")],
+        "the stored origin, not the kind or the id, makes it a sub-thread tombstone"
+    );
+    assert_eq!(rows_on_key(&db, "p1", "plain-id"), 1, "the row is kept");
+    assert!(!listed(&load(&db).await, "p1", "plain-id"), "and hidden");
+}
+
+// Wrong collapse: adapter rows — a plain one and one dressed as a sub-thread — are still removed
+// outright, and never reported as tombstones (the shipped behaviour, kept).
+#[gpui::test]
+async fn history_db_tombstone_archived_adapter_rows_are_still_removed(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_adapter_removed").await;
+    archived_task(&db, &record("p1", "t1", AgentTaskStatus::Completed, 1_000)).await;
+    let mut dressed = record("p1", "zeo-sub-thread:s9", AgentTaskStatus::Completed, 1_100);
+    dressed.kind = "sub_thread".into();
+    archived_task(&db, &dressed).await;
+    assert_eq!(
+        find(&load(&db).await, "p1", "zeo-sub-thread:s9").map(|entry| entry.origin),
+        Some(TaskOrigin::Adapter),
+        "precondition: the dressed row is an adapter row"
+    );
+
+    let removed = db
+        .delete(&[key("p1", "t1"), key("p1", "zeo-sub-thread:s9")])
+        .await
+        .expect("delete should succeed");
