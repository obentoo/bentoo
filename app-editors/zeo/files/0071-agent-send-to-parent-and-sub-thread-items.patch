+
+    delete_thread(parent.thread_id, &mut rig.cx);
+    assert_eq!(link_of(child.thread_id, &mut rig.cx), ParentLink::Deleted);
+
+    // The parent's row survives with no session.
+    rig.cx.update(|_, cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let mut entry = store
+            .read(cx)
+            .entry(other_parent.thread_id)
+            .cloned()
+            .expect("the parent's row");
+        entry.session_id = None;
+        store.update(cx, |store, cx| store.save(entry, cx));
+    });
+    rig.cx.run_until_parked();
+    assert_eq!(
+        link_of(other_child.thread_id, &mut rig.cx),
