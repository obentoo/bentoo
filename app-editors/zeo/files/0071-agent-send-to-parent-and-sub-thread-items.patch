index 0000000..429ed3d
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/native_subagent_tests.rs
@@ -0,0 +1,132 @@
+// Story 064, task 5.1 — the Agent Tasks panel lists native subagents live and opens them (R1.1,
+// R1.6). Module path: `panel::native_subagent`; wired in `src/panel.rs` (see
+// `native_subagent_support.rs` for the wiring and the contract assumed). Validation:
+// `cargo test -p agent_tasks_panel panel`.
+//
+// Side effects are read where they land: which session the conversation shows, which thread
+// the agent panel holds as root, how many windows exist, the row's notice and the scroll
+// position of the shown thread.
+//
+// Hostile halves first:
+//   - Open on a loaded child shows THAT child: not its parent (which is what Open does today for
+//     a row keyed by the parent's session), not its sibling;
+//   - then the benign live rows.
+//
+// The unloaded child's fallback (R2.4) and the restart listing (R2.3) need a store swap, which
+// only the store module can make: they are in `store/panel_native_subagent_restart_tests.rs`.
+
+use gpui::TestAppContext;
+
+use crate::native_subagent_support::*;
+use crate::test_helpers::*;
+
+/// The agent panel's root thread (the conversation it holds), whatever it navigated to.
+fn root_session(panels: &Panels) -> Option<agent_client_protocol::v2::schema::SessionId> {
+    active_session(panels)
+}
+
+// ── R1.6 — Open on a loaded child navigates to it ───────────────────────────
+
+/// Hostile: Open on Bravo shows Bravo — not the parent (the key's own session), not Alpha.
+#[gpui::test]
+async fn panel_native_subagent_open_on_a_loaded_child_shows_that_child(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    let bravo = spawn_child(&parent, &connection, "bravo", "Bravo", &mut panels.cx);
+    report_running(&alpha, &mut panels.cx);
+    report_running(&bravo, &mut panels.cx);
+    let key = subagent_key(&parent_session, "bravo");
+    assert!(
+        find_row(&mut panels, &key.0.to_string(), key.1.as_ref()).is_some(),
+        "precondition: Bravo is a live row of the panel"
+    );
+    assert_eq!(
+        conversation_shows(&panels.agent_panel, &panels.cx),
+        Some(parent_session.clone()),
+        "precondition: the conversation shows the parent"
+    );
+
+    open_from(&panels.tasks_panel, &key, &mut panels.cx);
+
+    assert_eq!(
+        conversation_shows(&panels.agent_panel, &panels.cx),
+        Some(agent_client_protocol::v2::schema::SessionId::new("bravo")),
+        "Open on a loaded child navigates the conversation to it"
+    );
+    assert_eq!(
+        root_session(&panels),
+        Some(parent_session),
+        "the parent stays the conversation's root"
+    );
+    let notice = find_row(&mut panels, &key.0.to_string(), key.1.as_ref())
+        .expect("still listed")
+        .notice;
+    assert_eq!(
+        notice, None,
+        "a navigation that reached the child says nothing"
+    );
+}
+
+// ── R1.1 — live rows from the merger ────────────────────────────────────────
+
+/// Two children, two live rows under the parent's group, keyed by child — and the parent's
+/// group is the only group: a child is never a thread group of its own.
+#[gpui::test]
+async fn panel_native_subagent_children_are_live_rows_of_their_parent(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Same", &mut panels.cx);
+    let bravo = spawn_child(&parent, &connection, "bravo", "Same", &mut panels.cx);
+    report_running(&alpha, &mut panels.cx);
+    report_running(&bravo, &mut panels.cx);
+
+    let groups = groups(&mut panels);
+    assert!(
+        groups
+            .iter()
+            .all(|group| group.session_id.to_string() != "alpha"
+                && group.session_id.to_string() != "bravo"),
+        "a child is not a thread group of its own"
+    );
+    let parent_group = groups
+        .iter()
+        .find(|group| group.session_id == parent_session)
+        .expect("the parent's group lists its children");
+    let keys: Vec<String> = parent_group
+        .rows
+        .iter()
+        .map(|row| row.entry.record.task_id.to_string())
+        .collect();
+    assert!(
+        keys.contains(&"acp-subagent:alpha".to_string())
+            && keys.contains(&"acp-subagent:bravo".to_string()),
+        "two children sharing a title are two rows: {keys:?}"
+    );
+    let row = find_row(
+        &mut panels,
+        &parent_session.to_string(),
+        "acp-subagent:alpha",
+    )
+    .expect("Alpha's row");
+    assert!(
+        row.can_stop,
+        "a running child with a cancel grant can be stopped from the panel"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/sub_thread_row.rs b/crates/agent_tasks_panel/src/panel/sub_thread_row.rs
new file mode 100644
index 0000000..a8ce884
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/sub_thread_row.rs
@@ -0,0 +1,73 @@
+//! Story 040: what a sub-thread item changes in a panel row (design.md, AgentTasksPanel rows).
+//!
+//! A sub-thread row is a row like any other — selection, archive, delete and rename stay on the
+//! shared `TaskKey` paths (R7.6) — except for three things kept here: its chip, its state and the
+//! session its activation opens. Stop and Open Log never show, because a sub-thread has no live
+//! card task and no saved log (`PanelRow::can_stop`, `can_open_log`).
+
+use acp_thread::AgentTaskStatus;
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_ui::TaskRecord;
+use gpui::{AnyElement, SharedString};
+use ui::{Chip, Tooltip, prelude::*};
+
+use crate::history_db::SUB_THREAD_TASK_PREFIX;
+use crate::{HistoryEntry, TaskKey, TaskOrigin};
+
+pub(super) fn is_sub_thread(entry: &HistoryEntry) -> bool {
+    entry.origin == TaskOrigin::SubThread
+}
+
+/// "Running" while the stored status is running, "Idle" otherwise: the panel holds no handle
+/// on a reporter, and an interrupted item after a restart is simply idle (R5.4, R7.1).
+pub(super) fn sub_thread_state(record: &TaskRecord) -> &'static str {
+    if record.status == AgentTaskStatus::Running {
+        "Running"
+    } else {
+        "Idle"
+    }
+}
+
+/// The detail slot of a sub-thread row: its state, under a selector naming it.
+pub(super) fn sub_thread_state_label(record: &TaskRecord, color: Color) -> AnyElement {
+    let state = sub_thread_state(record);
+    let task_id = record.task_id.clone();
+    div()
+        .debug_selector(move || {
+            format!(
+                "agent-tasks-sub-thread-state-{}-{task_id}",
+                state.to_lowercase()
+            )
+        })
+        .min_w_0()
+        .child(Label::new(state).size(LabelSize::XSmall).color(color))
+        .into_any_element()
+}
+
+pub(super) fn sub_thread_chip(record: &TaskRecord) -> AnyElement {
+    let task_id = record.task_id.clone();
+    div()
+        .id(SharedString::from(format!(
+            "agent-tasks-sub-thread-chip-{task_id}"
+        )))
+        .debug_selector(move || format!("agent-tasks-sub-thread-chip-{task_id}"))
+        .flex_none()
+        .tooltip(Tooltip::text("A sub-thread of this thread"))
+        .child(Chip::new("Sub-thread").label_size(LabelSize::XSmall))
+        .into_any_element()
+}
+
+/// The session an activation of `key` opens: the sub-thread's own for a sub-thread item, never
+/// the parent's session that keys its row (R7.2); `None` for an adapter task.
+pub(super) fn sub_thread_session(
+    key: &TaskKey,
+    records: &[HistoryEntry],
+) -> Option<acp_v2::SessionId> {
+    let (session_id, task_id) = key;
+    records
+        .iter()
+        .find(|entry| entry.record.session_id == *session_id && entry.record.task_id == *task_id)
+        .filter(|entry| is_sub_thread(entry))?;
+    let sub = task_id.as_ref().strip_prefix(SUB_THREAD_TASK_PREFIX)?;
+    Some(acp_v2::SessionId::new(sub.to_string()))
+}
diff --git a/crates/agent_tasks_panel/src/panel/sub_thread_row_tests.rs b/crates/agent_tasks_panel/src/panel/sub_thread_row_tests.rs
