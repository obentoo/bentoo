diff --git a/crates/agent_ui/src/sub_thread_send/in_flight_guard_tests.rs b/crates/agent_ui/src/sub_thread_send/in_flight_guard_tests.rs
new file mode 100644
index 0000000..a710b31
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/in_flight_guard_tests.rs
@@ -0,0 +1,406 @@
+// Story 040, task 11.3 (refine v4, review 7.x L2) — the in-flight guard on Send Last Reply: while
+// a delivery is still reaching the parent, a second pick does nothing, and both choices come
+// back once the delivery ends, whichever way it ends (R2.6, R4.2, R4.3; Q4, Q11). Module path:
+// `sub_thread_send::in_flight_guard_tests`. Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/in_flight_guard_tests.rs"]
+//     mod in_flight_guard_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- send_last_reply`. Fixtures:
+// `crate::sub_thread_test_support`; log capture: `crate::thread_organization::test_helpers`.
+//
+// Contract (design.md v4 §SendToParentControl, §deliver_to_parent):
+//   - `ThreadView::send_last_reply` sets `SendToParentState::delivering` before the delivery
+//     starts; `availability` then disables both choices with "Sending to the parent thread";
+//   - the flag is cleared when the delivery ends: delivered, or `open_failed`;
+//   - a closed parent is reached through `open_agent_session`: a window holding exactly its
+//     folders, else a NEW window over them, then that window's agent panel (up to 60 s).
+// Read through `parent_link` + `availability` on the view's own state (the control's source),
+// never through a field name, so the tests do not depend on how the flag is stored.
+//
+// Fixture: the parent is a saved thread under `/elsewhere`, a folder no window holds, so the
+// router opens a new window for it — L2's path (agent_session_router.rs, `OpenMode::NewWindow`).
+// A test app adds no agent panel to that window, so the delivery stays in flight until the test
+// adds one (success) or the router's 60 s wait runs out (open failure).
+//
+// Hostile halves first:
+//   - wrongly DUPLICATED: two picks in a row, before the parent exists anywhere, open one window,
+//     one view of the parent and one block — not one per pick;
+//   - wrongly ALLOWED: during the router's wait both choices say "Sending to the parent thread",
+//     and a pick then starts no second open (one `open_failed`, one window);
+//   - wrongly KEPT: after the delivery, and after an open failure, both choices are enabled again,
+//     and a later deliberate pick delivers a second block (the guard swallows only overlap);
+//   - wrongly SHARED: a sibling sub-thread of the same parent keeps both choices meanwhile.
+//
+// GOTCHA: `StubAgentConnection::load_session` returns an EMPTY thread, which the metadata store
+// saves as a draft with `session_id: None`; read afterwards, `parent_link` would say "The parent
+// thread was deleted". `replay_parent_history` adds the one entry a real load would bring back.
+
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::schema::v1 as acp_v1;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{AnyWindowHandle, AppContext as _, Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+use workspace::MultiWorkspace;
+
+use super::{Availability, availability, parent_link};
+use crate::AgentPanel;
+use crate::sub_thread_test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::test_helpers::{all_lines_lowercased, capture_logs};
+
+const SENDING: &str = "Sending to the parent thread";
+const NOBODY_HOLDS: &str = "/elsewhere";
+
+type Choices = (Result<(), String>, Result<(), String>);
+
+fn sub_thread_block(title: &str, reply: &str) -> String {
+    format!("From sub-thread \"{title}\":\n\n{reply}")
+}
+
+/// What the control would offer now, from the view's own link, thread and state.
+fn offered(conv: &Conv, cx: &mut VisualTestContext) -> Choices {
+    let view = conv.view.clone();
+    cx.update(|_, cx| {
+        let view = view.read(cx);
+        let link = parent_link(view.root_thread_id, cx);
+        let Availability {
+            last_reply,
+            summarize,
+        } = availability(&link, view.thread.read(cx), &view.send_to_parent);
+        (
+            last_reply.map_err(|tooltip| tooltip.to_string()),
+            summarize.map_err(|tooltip| tooltip.to_string()),
+        )
+    })
+}
+
+/// One pick of Send Last Reply, with nothing run after it: its delivery has not started yet.
+fn pick_send_last_reply(conv: &Conv, cx: &mut VisualTestContext) {
+    conv.view
+        .update_in(cx, |view, window, cx| view.send_last_reply(window, cx));
+}
+
+/// The rig's panel runs `crate::Agent::Stub` on a stub that can load a session back, as
+/// deliver_to_parent_tests.rs's closed-parent test sets it up.
+fn loadable_stub(panel: &Entity<AgentPanel>, cx: &mut VisualTestContext) {
+    let loadable = crate::test_support::stub_agent_connection();
+    panel.update(cx, |panel, cx| {
+        panel.connection_store().update(cx, |store, cx| {
+            store.restart_connection(
+                crate::Agent::Stub,
+                std::rc::Rc::new(crate::test_support::StubAgentServer::new(loadable)),
+                cx,
+            );
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// A rig whose stub loads sessions, plus a folder no window holds.
+async fn guard_rig(cx: &mut TestAppContext) -> Rig {
+    init(cx);
+    crate::test_support::set_stub_agent_connection(
+        StubAgentConnection::new().with_supports_load_session(true),
+    );
+    let mut rig = rig(cx).await;
+    rig.connection = crate::test_support::stub_agent_connection();
+    loadable_stub(&rig.panel.clone(), &mut rig.cx);
+    rig.fs
+        .insert_tree(NOBODY_HOLDS, json!({ "file.txt": "" }))
+        .await;
+    rig
+}
+
+/// A parent known only to the metadata store, under `folder`, run by `crate::Agent::Stub`.
+fn saved_closed_parent(
+    session: &str,
+    folder: &str,
+    cx: &mut VisualTestContext,
+) -> (ThreadId, acp_v2::SessionId) {
+    let thread_id = ThreadId::new();
+    let session = acp_v2::SessionId::new(session);
+    let now = chrono::Utc::now();
+    let folders = [std::path::Path::new(folder)];
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Closed parent".into()),
+                    title_override: None,
+                    updated_at: now,
+                    created_at: Some(now),
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(
+                        &workspace::PathList::new(&folders),
+                    ),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (thread_id, session)
+}
+
+fn windows_now(cx: &mut TestAppContext) -> Vec<AnyWindowHandle> {
+    cx.update(|cx| cx.windows())
+}
+
+fn opened_since(before: &[AnyWindowHandle], cx: &mut TestAppContext) -> Vec<AnyWindowHandle> {
+    windows_now(cx)
+        .into_iter()
+        .filter(|window| !before.contains(window))
+        .collect()
+}
+
+/// Gives `window` the agent panel a test app never adds, on the loadable stub, so a delivery
+/// waiting for it can go on.
+fn give_agent_panel(window: AnyWindowHandle, cx: &mut TestAppContext) {
+    let workspace = window
+        .downcast::<MultiWorkspace>()
+        .expect("a workspace window")
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window is open");
+    let mut window_cx = VisualTestContext::from_window(window, cx);
+    let panel = workspace.update_in(&mut window_cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        panel
+    });
+    loadable_stub(&panel, &mut window_cx);
+}
+
+/// The composer of every view of `session`, in every window: one entry per view.
+fn composers_of(session: &acp_v2::SessionId, cx: &mut TestAppContext) -> Vec<String> {
+    cx.update(|cx| {
+        let mut composers = Vec::new();
+        for window in cx.windows() {
+            let Some(multi_workspace) = window
+                .downcast::<MultiWorkspace>()
+                .and_then(|handle| handle.read(cx).ok())
+            else {
+                continue;
+            };
+            for workspace in multi_workspace.workspaces() {
+                let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) else {
+                    continue;
+                };
+                for conversation in panel.read(cx).conversation_views() {
+                    if conversation.read(cx).root_session_id.as_ref() != Some(session) {
+                        continue;
+                    }
+                    if let Some(view) = conversation.read(cx).root_thread_view() {
+                        composers.push(view.read(cx).message_editor.read(cx).text(cx));
+                    }
+                }
+            }
+        }
+        composers
+    })
+}
+
+/// What a real load does and the stub does not: the parent's history comes back with it. The
+/// stub loads an EMPTY thread, which the metadata store saves as a draft (`session_id: None`),
+/// so `parent_link` would read the parent as deleted and hide what the guard does.
+fn replay_parent_history(session: &acp_v2::SessionId, cx: &mut TestAppContext) {
+    let threads: Vec<Entity<acp_thread::AcpThread>> = cx.update(|cx| {
+        let mut threads = Vec::new();
+        for window in cx.windows() {
+            let Some(multi_workspace) = window
+                .downcast::<MultiWorkspace>()
+                .and_then(|handle| handle.read(cx).ok())
+            else {
+                continue;
+            };
+            for workspace in multi_workspace.workspaces() {
+                let Some(panel) = workspace.read(cx).panel::<AgentPanel>(cx) else {
+                    continue;
+                };
+                for conversation in panel.read(cx).conversation_views() {
+                    if conversation.read(cx).root_session_id.as_ref() == Some(session)
+                        && let Some(view) = conversation.read(cx).root_thread_view()
+                    {
+                        threads.push(view.read(cx).thread.clone());
+                    }
+                }
+            }
+        }
+        threads
+    });
+    assert_eq!(threads.len(), 1, "precondition: the parent is loaded once");
+    for thread in threads {
+        thread.update(cx, |thread, cx| {
+            thread
+                .handle_session_update(
+                    acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(
+                        "the parent's earlier answer".to_string().into(),
+                    )),
+                    cx,
+                )
+                .expect("the replayed history applies")
+        });
+    }
+    cx.run_until_parked();
+}
+
+// ── Hostile: two picks, one window, one view, one block (R2.6, R4.2; L2) ───
+
+#[gpui::test]
+async fn send_last_reply_twice_toward_a_closed_parent_opens_one_window_and_appends_one_block(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = guard_rig(cx).await;
+    let (parent_id, parent_session) =
+        saved_closed_parent("guard-twice-parent", NOBODY_HOLDS, &mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+    let before = windows_now(cx);
+
+    // A double pick: the second comes before the first delivery has even looked for the parent.
+    pick_send_last_reply(&child, &mut rig.cx);
+    pick_send_last_reply(&child, &mut rig.cx);
+    rig.cx.run_until_parked();
+
+    let opened = opened_since(&before, cx);
+    for window in &opened {
+        give_agent_panel(*window, cx);
+    }
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        opened.len(),
+        1,
+        "one window is opened for the parent, not one per pick"
+    );
+    assert_eq!(
+        composers_of(&parent_session, cx),
+        vec![sub_thread_block("Child", "child answer")],
+        "one view of the parent, holding exactly one block"
+    );
+    replay_parent_history(&parent_session, cx);
+    assert_eq!(
+        offered(&child, &mut rig.cx),
+        (Ok(()), Ok(())),
+        "both choices are back once the delivery has landed"
+    );
+}
+
+// ── Hostile: disabled mid-delivery, a pick then opens nothing, back after an open failure ──
+
+#[gpui::test]
+async fn send_last_reply_in_flight_ignores_a_pick_and_re_enables_after_an_open_failure(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = guard_rig(cx).await;
+    let (parent_id, parent_session) =
+        saved_closed_parent("guard-failure-parent", NOBODY_HOLDS, &mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+    let before = windows_now(cx);
+    capture_logs();
+
+    pick_send_last_reply(&child, &mut rig.cx);
+    rig.cx.run_until_parked();
+    // The router opened the parent's window and waits for its agent panel, which never comes.
+    assert_eq!(
+        offered(&child, &mut rig.cx),
+        (Err(SENDING.to_string()), Err(SENDING.to_string())),
+        "while the parent is being opened, both choices say why they wait"
+    );
+    pick_send_last_reply(&child, &mut rig.cx);
+    rig.cx.run_until_parked();
+    rig.cx.executor().advance_clock(Duration::from_secs(61));
+    rig.cx.run_until_parked();
+
+    let parent_id_text = parent_session.to_string().to_lowercase();
+    let failures = all_lines_lowercased()
+        .into_iter()
+        .filter(|line| {
+            line.contains("zeo_sub_thread")
+                && line.contains("open_failed")
+                && line.contains(&parent_id_text)
+        })
+        .count();
+    assert_eq!(failures, 1, "the pick made mid-delivery opened nothing");
+    assert_eq!(
+        opened_since(&before, cx).len(),
+        1,
+        "one window for the parent, from the first pick only"
+    );
+    let notice = notice_of(&child.view, &rig.cx).expect("the sub-thread says why");
+    assert!(
+        notice.starts_with("Could not open the parent thread: "),
+        "the open failure is shown: {notice:?}"
+    );
+    assert_eq!(
+        offered(&child, &mut rig.cx),
+        (Ok(()), Ok(())),
+        "both choices are back after the open failure"
+    );
+}
+
+// ── Hostile converse: the guard ends with the delivery, and is per sub-thread ──
+
+#[gpui::test]
+async fn send_last_reply_in_flight_disables_both_then_a_later_pick_delivers_again(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = guard_rig(cx).await;
+    let (parent_id, parent_session) =
+        saved_closed_parent("guard-again-parent", NOBODY_HOLDS, &mut rig.cx);
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let sibling = open_conversation(&mut rig, "Sibling", "sibling answer");
+    link(child.thread_id, parent_id, &mut rig.cx);
+    link(sibling.thread_id, parent_id, &mut rig.cx);
+    let before = windows_now(cx);
+
+    pick_send_last_reply(&child, &mut rig.cx);
+    assert_eq!(
+        offered(&child, &mut rig.cx),
+        (Err(SENDING.to_string()), Err(SENDING.to_string())),
+        "disabled from the pick on, before the delivery has run at all"
+    );
+    assert_eq!(
+        offered(&sibling, &mut rig.cx),
+        (Ok(()), Ok(())),
+        "another sub-thread of the same parent is not held back"
+    );
+    rig.cx.run_until_parked();
+    let opened = opened_since(&before, cx);
+    for window in &opened {
+        give_agent_panel(*window, cx);
+    }
+    rig.cx.run_until_parked();
+
+    let one = sub_thread_block("Child", "child answer");
+    assert_eq!(
+        composers_of(&parent_session, cx),
+        vec![one.clone()],
+        "the first delivery lands"
+    );
+    replay_parent_history(&parent_session, cx);
+    assert_eq!(
+        offered(&child, &mut rig.cx),
+        (Ok(()), Ok(())),
+        "both choices are back after the delivery"
+    );
+
+    // A deliberate pick after the first has landed is not overlap: it delivers.
+    pick_send_last_reply(&child, &mut rig.cx);
+    rig.cx.run_until_parked();
+    assert_eq!(
+        composers_of(&parent_session, cx),
+        vec![format!("{one}\n\n{one}")],
+        "the later pick appends its own block to the same composer"
+    );
+    assert_eq!(offered(&child, &mut rig.cx), (Ok(()), Ok(())));
+}
diff --git a/crates/agent_ui/src/sub_thread_send/receipt_test_support.rs b/crates/agent_ui/src/sub_thread_send/receipt_test_support.rs
new file mode 100644
index 0000000..69b8fb5
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/receipt_test_support.rs
@@ -0,0 +1,171 @@
+// Story 040, task 11.2 — setup only: conversations on the reported-activity ("receipt")
+// transport, where the agent, not Zeo, reports when a turn runs and ends. Module path:
+// `sub_thread_send::receipt_test_support`. Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/receipt_test_support.rs"]
+//     mod receipt_test_support;
+//
+// On this transport a send resolves when the agent ACCEPTS the message, the user message
+// appears only when the agent echoes it, and `Stopped` comes from the agent's Idle report
+// (`AcpThread::update_session_state`). That is what lets a test reproduce review 7.x M4: the
+// agent reports a turn of its own between the summary's submit and the summary's own turn.
+// Nothing here asserts; it drives `StubAgentConnection::with_receipt_submissions(true)` and the
+// thread's public update methods the way `conversation_view.rs`'s receipt tests do.
+
+#![allow(dead_code)]
+
+use acp_thread::{AcpThread, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp_v1;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{Entity, VisualTestContext};
+
+use crate::sub_thread_test_support::{Conv, Rig, set_composer, set_title};
+
+fn conversation_on(rig: &mut Rig, connection: &StubAgentConnection) -> Conv {
+    // Under the connection's own agent id: the panel keeps one connection per agent id, and the
+    // rig's legacy conversations already hold the default one ("Test").
+    crate::test_support::open_thread_with_custom_connection(
+        &rig.panel,
+        connection.clone(),
+        &mut rig.cx,
+    );
+    let (thread, view) = rig.panel.read_with(&rig.cx, |panel, cx| {
+        (
+            panel
+                .active_agent_thread(cx)
+                .expect("a thread was just opened"),
+            panel.active_thread_view(cx).expect("its view is shown"),
+        )
+    });
+    let session = thread.read_with(&rig.cx, |thread, _| thread.session_id().clone());
+    let thread_id = crate::test_support::active_thread_id(&rig.panel, &rig.cx);
+    Conv {
+        thread,
+        view,
+        session,
+        thread_id,
+    }
+}
+
+/// A conversation on its own receipt connection that has run one complete turn — "Hello",
+/// answered `reply`, reported Idle with end of turn — titled `title`. Its state is confirmed.
+pub(crate) fn open_receipt_conversation(
+    rig: &mut Rig,
+    title: &str,
+    reply: &str,
+) -> (Conv, StubAgentConnection) {
+    let connection = StubAgentConnection::new().with_receipt_submissions(true);
+    let conv = conversation_on(rig, &connection);
+    let receipt = connection.defer_next_receipt_response();
+    set_composer(&conv.view, "Hello", &mut rig.cx);
+    conv.view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    report_running(&conv.thread, &mut rig.cx);
+    receipt
+        .send(Ok(acp_v2::PromptResponse::new("hello-echo")))
+        .expect("the first message waits for its receipt");
+    rig.cx.run_until_parked();
+    echo_user_message(&conv.thread, "hello-echo", "Hello", &mut rig.cx);
+    agent_chunk(&conv.thread, reply, &mut rig.cx);
+    report_idle(&conv.thread, Some(acp_v2::StopReason::EndTurn), &mut rig.cx);
+    set_title(&conv.thread, title, &mut rig.cx);
+    (conv, connection)
+}
+
+/// A conversation titled "Child" on its own receipt connection, as it is right after a load: no
+/// state reported yet (`ThreadStatus::Unconfirmed`), with `reply` as its history's last agent
+/// message (none when empty).
+pub(crate) fn open_unconfirmed_receipt_conversation(
+    rig: &mut Rig,
+    reply: &str,
+) -> (Conv, StubAgentConnection) {
+    let connection = StubAgentConnection::new().with_receipt_submissions(true);
+    let conv = conversation_on(rig, &connection);
+    conv.thread.update(&mut rig.cx, |thread, cx| {
+        thread.mark_activity_unconfirmed(cx)
+    });
+    rig.cx.run_until_parked();
+    agent_chunk(&conv.thread, reply, &mut rig.cx);
+    set_title(&conv.thread, "Child", &mut rig.cx);
+    (conv, connection)
+}
+
+pub(crate) fn report_running(thread: &Entity<AcpThread>, cx: &mut VisualTestContext) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.update_session_state(
+                acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+                cx,
+            )
+        })
+        .expect("the running report applies");
+    cx.run_until_parked();
+}
+
+pub(crate) fn report_idle(
+    thread: &Entity<AcpThread>,
+    stop_reason: Option<acp_v2::StopReason>,
+    cx: &mut VisualTestContext,
+) {
+    let idle = match stop_reason {
+        Some(reason) => acp_v2::IdleStateUpdate::new().stop_reason(reason),
+        None => acp_v2::IdleStateUpdate::new(),
+    };
+    thread
+        .update(cx, |thread, cx| {
+            thread.update_session_state(acp_v2::StateUpdate::Idle(idle), cx)
+        })
+        .expect("the idle report applies");
+    cx.run_until_parked();
+}
+
+/// One agent message chunk; an empty `text` sends nothing.
+pub(crate) fn agent_chunk(thread: &Entity<AcpThread>, text: &str, cx: &mut VisualTestContext) {
+    if text.is_empty() {
+        return;
+    }
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(
+                    text.to_string().into(),
+                )),
+                cx,
+            )
+        })
+        .expect("the agent chunk applies");
+    cx.run_until_parked();
+}
+
+/// The agent echoes the user message it took under the receipt id `id`.
+pub(crate) fn echo_user_message(
+    thread: &Entity<AcpThread>,
+    id: &str,
+    text: &str,
+    cx: &mut VisualTestContext,
+) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.upsert_user_message(
+                acp_v2::UserMessage::new(id.to_string()).content(vec![text.into()]),
+                cx,
+            )
+        })
+        .expect("the echo applies");
+    cx.run_until_parked();
+}
+
+/// A turn the agent starts ON ITS OWN (a background-task continuation, review 7.x M4): it
+/// reports Running, answers `reply` and reports Idle with `stop_reason` — no user message.
+pub(crate) fn agent_initiated_turn(
+    thread: &Entity<AcpThread>,
+    reply: &str,
+    stop_reason: acp_v2::StopReason,
+    cx: &mut VisualTestContext,
+) {
+    report_running(thread, cx);
+    agent_chunk(thread, reply, cx);
+    report_idle(thread, Some(stop_reason), cx);
+}
diff --git a/crates/agent_ui/src/sub_thread_send/send_to_parent_control_tests.rs b/crates/agent_ui/src/sub_thread_send/send_to_parent_control_tests.rs
new file mode 100644
index 0000000..af9ae6c
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/send_to_parent_control_tests.rs
@@ -0,0 +1,203 @@
+// Story 040, task 6.2 — the Send to Parent control in a sub-thread's footer (R1.1–R1.6, R4.4;
+// Q11, Q12). Module path: `sub_thread_send::send_to_parent_control_tests`. Wired in
+// `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/send_to_parent_control_tests.rs"]
+//     mod send_to_parent_control_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- send_to_parent_control`. Fixtures:
+// `crate::sub_thread_test_support`.
+//
+// Contract (design.md §SendToParentControl): `render_send_to_parent` is called from one hook in
+// `ThreadView::render_message_editor` and draws nothing for `ParentLink::None` (or without the
+// organization store); otherwise a menu button "Send to Parent" with exactly "Send Last Reply"
+// and "Summarize and Send", each disabled per `availability` with its tooltip; Tab stops and
+// accessible labels; `SendToParentState::notice` shows under the control until the next action.
+// Assumed beyond design.md (one place each):
+//   - debug selectors: `send-to-parent` (the button), `send-to-parent-last-reply` and
+//     `send-to-parent-summarize` (the two choices, while the menu is open),
+//     `send-to-parent-notice` (the notice);
+//   - the button's focus handle through `ThreadView::send_to_parent_focus_handle(&self)
+//     -> &FocusHandle`, the card's accessor pattern (`minimize_focus_handle`), read in
+//     `control_handle` only.
+//
+// Hostile halves first:
+//   - no control on an unlinked thread, nor on a PARENT (a thread with sub-threads but no parent),
+//     nor anywhere without the organization store;
+//   - a disabled choice is inert: activating "Send Last Reply" while the sub-thread generates puts
+//     nothing in the parent's composer;
+//   - then the control, its two choices, the notice and the Tab stop.
+
+use gpui::{FocusHandle, Modifiers, TestAppContext, VisualTestContext};
+
+use crate::conversation_view::ThreadView;
+use crate::sub_thread_test_support::*;
+
+const CONTROL: &str = "send-to-parent";
+const LAST_REPLY: &str = "send-to-parent-last-reply";
+const SUMMARIZE: &str = "send-to-parent-summarize";
+const NOTICE: &str = "send-to-parent-notice";
+
+fn click(selector: &'static str, cx: &mut VisualTestContext) {
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    cx.run_until_parked();
+    draw(cx);
+}
+
+fn control_handle(view: &gpui::Entity<ThreadView>, cx: &VisualTestContext) -> FocusHandle {
+    view.read_with(cx, |view, _| view.send_to_parent_focus_handle().clone())
+}
+
+// ── Where the control is drawn (R1.1, R1.2) ────────────────────────────────
+
+#[gpui::test]
+async fn send_to_parent_control_absent_on_a_parent_and_an_unlinked_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    // Opened last, the parent is the thread on screen once the link exists.
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert!(
+        !painted(CONTROL, &mut rig.cx),
+        "a parent has no Send to Parent"
+    );
+
+    let _lone = open_conversation(&mut rig, "Lone", "lone answer");
+    draw(&mut rig.cx);
+    assert!(
+        !painted(CONTROL, &mut rig.cx),
+        "an unlinked thread has none"
+    );
+}
+
+#[gpui::test]
+async fn send_to_parent_control_drawn_on_a_sub_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    draw(&mut rig.cx);
+    assert!(
+        !painted(CONTROL, &mut rig.cx),
+        "control: not before the link"
+    );
+
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert!(painted(CONTROL, &mut rig.cx), "a sub-thread has it");
+}
+
+#[gpui::test]
+async fn send_to_parent_control_absent_without_the_organization_store(cx: &mut TestAppContext) {
+    init_without_organization(cx);
+    let mut rig = rig(cx).await;
+    let _only = open_conversation(&mut rig, "Only", "an answer");
+    draw(&mut rig.cx);
+    assert!(!painted(CONTROL, &mut rig.cx));
+}
+
+// ── A disabled choice is inert (R1.4) ──────────────────────────────────────
+
+#[gpui::test]
+async fn send_to_parent_control_disabled_choice_inserts_nothing(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _finish = rig.connection.defer_next_prompt_response();
+    set_composer(&child.view, "still thinking", &mut rig.cx);
+    child
+        .view
+        .update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+    draw(&mut rig.cx);
+
+    click(CONTROL, &mut rig.cx);
+    if painted(LAST_REPLY, &mut rig.cx) {
+        click(LAST_REPLY, &mut rig.cx);
+    }
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        "",
+        "nothing reaches the parent while the sub-thread generates"
+    );
+}
+
+// ── The menu (R1.3) and the notice ─────────────────────────────────────────
+
+#[gpui::test]
+async fn send_to_parent_control_offers_the_two_choices(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert!(!painted(LAST_REPLY, &mut rig.cx), "closed until activated");
+
+    click(CONTROL, &mut rig.cx);
+
+    assert!(
+        painted(LAST_REPLY, &mut rig.cx),
+        "Send Last Reply is offered"
+    );
+    assert!(
+        painted(SUMMARIZE, &mut rig.cx),
+        "Summarize and Send is offered"
+    );
+}
+
+#[gpui::test]
+async fn send_to_parent_control_shows_the_notice_under_the_control(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+    assert!(!painted(NOTICE, &mut rig.cx), "no notice before any action");
+
+    child.view.update(&mut rig.cx, |view, cx| {
+        view.send_to_parent.notice = Some("Summary not sent: the reply did not finish".into());
+        cx.notify();
+    });
+    draw(&mut rig.cx);
+
+    assert!(painted(NOTICE, &mut rig.cx), "the notice is drawn");
+    assert_eq!(
+        notice_of(&child.view, &rig.cx).as_deref(),
+        Some("Summary not sent: the reply did not finish")
+    );
+}
+
+// ── Keyboard (R1.6, Q12) ───────────────────────────────────────────────────
+
+#[gpui::test]
+async fn send_to_parent_control_is_a_tab_stop(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    draw(&mut rig.cx);
+
+    let handle = control_handle(&child.view, &rig.cx);
+    let mut reached = false;
+    for _ in 0..200 {
+        rig.cx.update(|window, cx| window.focus_next(cx));
+        draw(&mut rig.cx);
+        if rig.cx.update(|window, _| handle.is_focused(window)) {
+            reached = true;
+            break;
+        }
+    }
+    assert!(reached, "Tab reaches Send to Parent");
+}
diff --git a/crates/agent_ui/src/sub_thread_send/summarize_and_send_tests.rs b/crates/agent_ui/src/sub_thread_send/summarize_and_send_tests.rs
new file mode 100644
index 0000000..56ee1ce
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/summarize_and_send_tests.rs
@@ -0,0 +1,277 @@
+// Story 040, task 7.2 — Summarize and Send: one visible summary turn in the sub-thread, delivered
+// to the parent only when THAT turn ends with end-of-turn (R3.1–R3.6, R8.1; Q4, Q11). Module
+// path: `sub_thread_send::summarize_and_send_tests`. Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/summarize_and_send_tests.rs"]
+//     mod summarize_and_send_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- summarize_and_send`. Fixtures:
+// `crate::sub_thread_test_support`; log capture: `crate::thread_organization::test_helpers`.
+//
+// Contract (design.md §SendToParentControl, §Summary request):
+//   - `ThreadView::summarize_and_send(&mut self, window, cx)` submits `SUMMARY_REQUEST` through
+//     the view's normal send path, then stores `PendingSummary { activity_generation }` read
+//     after the submit;
+//   - on `AcpThreadEvent::Stopped` with that generation: `EndTurn` → `compose_block(title,
+//     last_reply_text)` → `deliver_to_parent`; any other stop reason → notice "Summary not sent:
+//     the reply did not finish"; `Error` / `Refusal` with a pending summary clear it with the
+//     notice; a non-matching generation does nothing; a dropped view delivers nothing;
+//   - `zeo_sub_thread event=summary_requested|summary_failed`, ids only.
+//
+// Hostile halves first:
+//   - a LATER turn of the sub-thread, after the summary was delivered, delivers nothing (R3.6);
+//   - a summary turn that is cancelled, fails or is refused delivers nothing and says so (R3.3);
+//   - a sub-thread view closed mid-summary delivers nothing (R3.4);
+//   - then the visible request and the delivered summary.
+
+use acp_thread::AgentThreadEntry;
+use agent_client_protocol::schema::v1 as acp_v1;
+use futures::channel::oneshot;
+use gpui::{TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::SUMMARY_REQUEST;
+use crate::sub_thread_test_support::*;
+use crate::thread_organization::test_helpers::{all_lines_lowercased, capture_logs};
+
+const NOT_SENT: &str = "Summary not sent: the reply did not finish";
+
+type Finish = oneshot::Sender<anyhow::Result<acp_v1::PromptResponse>>;
+
+fn block(title: &str, reply: &str) -> String {
+    format!("From sub-thread \"{title}\":\n\n{reply}")
+}
+
+/// Asks for the summary; the agent's turn answers `reply` and waits for the returned sender.
+fn summarize(rig: &mut Rig, child: &Conv, reply: &str, cx_label: &str) -> Finish {
+    let finish = rig.connection.defer_next_prompt_response();
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+    // A deferred stub turn streams none of the queued updates, so the reply is streamed here.
+    if !reply.is_empty() {
+        child
+            .thread
+            .update(&mut rig.cx, |thread, cx| {
+                thread.handle_session_update(
+                    acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(
+                        reply.to_string().into(),
+                    )),
+                    cx,
+                )
+            })
+            .expect("the reply chunk applies");
+        rig.cx.run_until_parked();
+    }
+    assert!(
+        child.view.read_with(&rig.cx, |view, _| view
+            .send_to_parent
+            .pending_summary
+            .is_some()),
+        "{cx_label}: the summary is pending while its turn runs"
+    );
+    finish
+}
+
+fn stop(finish: Finish, reason: acp_v1::StopReason, cx: &mut VisualTestContext) {
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(reason)))
+        .expect("the summary turn is still waiting");
+    cx.run_until_parked();
+}
+
+fn last_user_text(child: &Conv, cx: &VisualTestContext) -> Option<String> {
+    child.thread.read_with(cx, |thread, cx| {
+        thread.entries().iter().rev().find_map(|entry| match entry {
+            AgentThreadEntry::UserMessage(message) => {
+                Some(message.content.to_markdown(cx).to_string())
+            }
+            _ => None,
+        })
+    })
+}
+
+fn linked_pair(rig: &mut Rig) -> (Conv, Conv) {
+    let parent = open_conversation(rig, "Parent", "parent answer");
+    let child = open_conversation(rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    (parent, child)
+}
+
+// ── Hostile: a later turn (R3.6) ───────────────────────────────────────────
+
+#[gpui::test]
+async fn summarize_and_send_a_later_turn_delivers_nothing_more(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child) = linked_pair(&mut rig);
+    let finish = summarize(&mut rig, &child, "the summary", "first");
+    stop(finish, acp_v1::StopReason::EndTurn, &mut rig.cx);
+    let delivered = block("Child", "the summary");
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        delivered,
+        "precondition: delivered once"
+    );
+
+    // The operator keeps talking in the sub-thread; that turn ends normally too.
+    send_text(&mut rig, &child.view, "one more thing", "a later answer");
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        delivered,
+        "a turn Summarize and Send did not start delivers nothing"
+    );
+}
+
+// ── Hostile: the summary turn does not finish (R3.3) ───────────────────────
+
+#[gpui::test]
+async fn summarize_and_send_cancelled_turn_delivers_nothing_and_says_so(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child) = linked_pair(&mut rig);
+    let finish = summarize(&mut rig, &child, "half a summary", "cancelled");
+
+    stop(finish, acp_v1::StopReason::Cancelled, &mut rig.cx);
+
+    assert_eq!(composer_text(&parent.view, &rig.cx), "", "nothing inserted");
+    assert_eq!(notice_of(&child.view, &rig.cx).as_deref(), Some(NOT_SENT));
+    assert!(
+        child.view.read_with(&rig.cx, |view, _| view
+            .send_to_parent
+            .pending_summary
+            .is_none()),
+        "the pending summary is cleared"
+    );
+}
+
+#[gpui::test]
+async fn summarize_and_send_refused_turn_delivers_nothing_and_says_so(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child) = linked_pair(&mut rig);
+    let finish = summarize(&mut rig, &child, "", "refused");
+
+    stop(finish, acp_v1::StopReason::Refusal, &mut rig.cx);
+
+    assert_eq!(composer_text(&parent.view, &rig.cx), "");
+    assert_eq!(notice_of(&child.view, &rig.cx).as_deref(), Some(NOT_SENT));
+}
+
+#[gpui::test]
+async fn summarize_and_send_failed_turn_delivers_nothing_and_says_so(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child) = linked_pair(&mut rig);
+    let finish = summarize(&mut rig, &child, "", "failed");
+    capture_logs();
+
+    finish
+        .send(Err(anyhow::anyhow!("the agent fell over")))
+        .expect("the summary turn is still waiting");
+    rig.cx.run_until_parked();
+
+    assert_eq!(composer_text(&parent.view, &rig.cx), "");
+    assert_eq!(notice_of(&child.view, &rig.cx).as_deref(), Some(NOT_SENT));
+    let lines = all_lines_lowercased();
+    assert!(
+        lines.iter().any(|line| line.contains("zeo_sub_thread")
+            && line.contains("summary_failed")
+            && line.contains(&child.session.to_string().to_lowercase())),
+        "the failure is logged with the ids: {lines:?}"
+    );
+}
+
+// ── Hostile: the view is closed mid-summary (R3.4) ─────────────────────────
+
+#[gpui::test]
+async fn summarize_and_send_closed_view_delivers_nothing(cx: &mut TestAppContext) {
+    init(cx);
+    let mut a = rig(cx).await;
+    a.fs.insert_tree("/side", json!({ "file.txt": "" })).await;
+    let mut b = window_over(&a.fs.clone(), "/side", cx).await;
+    b.connection = a.connection.clone();
+    let parent = open_conversation(&mut a, "Parent", "parent answer");
+    let child = open_conversation(&mut b, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut b.cx);
+    let finish = summarize(&mut b, &child, "too late", "closed");
+
+    // The sub-thread's window, and with it its view, goes away before the turn ends.
+    let window = b.window;
+    drop(child);
+    drop(b);
+    cx.update(|cx| {
+        window
+            .update(cx, |_, window, _| window.remove_window())
+            .expect("the window is still there")
+    });
+    cx.run_until_parked();
+    // The agent may still answer; whether anyone listens is not the point.
+    let _late = finish.send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)));
+    cx.run_until_parked();
+
+    assert_eq!(
+        composer_text(&parent.view, &a.cx),
+        "",
+        "nothing is delivered"
+    );
+}
+
+// ── Benign: the visible request and the delivery (R3.1, R3.2) ──────────────
+
+#[gpui::test]
+async fn summarize_and_send_sends_the_request_visibly_then_delivers_the_summary(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child) = linked_pair(&mut rig);
+    let sent_before = user_message_count(&child.thread, &rig.cx);
+    let parent_sent = user_message_count(&parent.thread, &rig.cx);
+    capture_logs();
+
+    let finish = summarize(&mut rig, &child, "Quokka summary", "happy");
+    assert_eq!(
+        user_message_count(&child.thread, &rig.cx),
+        sent_before + 1,
+        "exactly one visible message starts one turn"
+    );
+    assert_eq!(
+        last_user_text(&child, &rig.cx).as_deref().map(str::trim),
+        Some(SUMMARY_REQUEST)
+    );
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        "",
+        "nothing before the turn ends"
+    );
+
+    stop(finish, acp_v1::StopReason::EndTurn, &mut rig.cx);
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        block("Child", "Quokka summary")
+    );
+    assert_eq!(
+        user_message_count(&parent.thread, &rig.cx),
+        parent_sent,
+        "not sent in the parent"
+    );
+    let lines = all_lines_lowercased();
+    assert!(
+        lines.iter().any(|line| line.contains("zeo_sub_thread")
+            && line.contains("summary_requested")
+            && line.contains(&child.session.to_string().to_lowercase())),
+        "the request is logged with the ids: {lines:?}"
+    );
+    assert!(
+        lines
+            .iter()
+            .all(|line| !line.contains("summarize this sub-thread")
+                && !line.contains("quokka summary")),
+        "neither the request nor the summary text reaches a log"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_send/summary.rs b/crates/agent_ui/src/sub_thread_send/summary.rs
new file mode 100644
index 0000000..a22b453
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/summary.rs
@@ -0,0 +1,195 @@
+//! Story 040, Summarize and Send: the sub-thread is asked for a summary in a visible turn, and
+//! only that turn's clean end delivers it (design.md, SendToParentControl; R3).
+
+use acp_thread::{AcpThread, AcpThreadEvent, AgentThreadEntry, SubmissionId, SubmissionState};
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::SharedString;
+use gpui::{Context, Task, Window};
+
+use super::{
+    ParentLink, PendingSummary, SUMMARY_REQUEST, availability, compose_block, deliver_to_parent,
+    last_reply_text, parent_link,
+};
+use crate::conversation_view::ThreadView;
+
+const NOT_SENT: &str = "Summary not sent: the reply did not finish";
+
+/// Where the thread stands against the summary's own turn.
+enum SummaryTurn {
+    /// The request is not in the thread yet, or a newer user message is not the latest one:
+    /// the turn that ended is not the summary's (R3.7).
+    NotYet,
+    /// The latest user message is the request: the turn that ended is the summary's.
+    Current,
+    /// A user message came after the request: its turn ended without a `Stopped` of its own
+    /// (legacy transport) and will never deliver.
+    Passed,
+}
+
+fn is_summary_request(content: &[acp_v2::ContentBlock]) -> bool {
+    content.iter().any(
+        |block| matches!(block, acp_v2::ContentBlock::Text(text) if text.text == SUMMARY_REQUEST),
+    )
+}
+
+/// The agent's refusal of the summary request itself. On the reported-activity transport it is
+/// only a settled submission: no `Error` and no turn follow, so nothing else would clear the
+/// summary (R3.3). The legacy transport also ends that turn with `Error`, which stays its path.
+fn rejected_summary_request(thread: &AcpThread, id: SubmissionId) -> Option<SharedString> {
+    if !thread.uses_reported_activity() {
+        return None;
+    }
+    let record = thread.submission(id)?;
+    match &record.state {
+        SubmissionState::Failed(error) if is_summary_request(&record.content) => {
+            Some(error.clone())
+        }
+        _ => None,
+    }
+}
+
+fn summary_turn(thread: &AcpThread, pending: &PendingSummary) -> SummaryTurn {
+    let user_messages = thread
+        .entries()
+        .iter()
+        .enumerate()
+        .skip(pending.entries_before)
+        .filter_map(|(index, entry)| match entry {
+            AgentThreadEntry::UserMessage(message) => Some((index, message)),
+            _ => None,
+        });
+    let mut request = None;
+    let mut latest = None;
+    for (index, message) in user_messages {
+        let is_request = is_summary_request(message.content.source_blocks());
+        if is_request && request.is_none() {
+            request = Some(index);
+        }
+        latest = Some(index);
+    }
+    match (request, latest) {
+        (Some(request), Some(latest)) if request == latest => SummaryTurn::Current,
+        (Some(_), Some(_)) => SummaryTurn::Passed,
+        _ => SummaryTurn::NotYet,
+    }
+}
+
+impl ThreadView {
+    /// Submits `SUMMARY_REQUEST` as a turn of this sub-thread, leaving its composer and draft as
+    /// they are (`send_content`), and waits for that turn to end (R3.1).
+    pub(crate) fn summarize_and_send(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        self.send_to_parent.notice = None;
+        cx.notify();
+        let link = parent_link(self.root_thread_id, cx);
+        if !matches!(link, ParentLink::Live { .. }) {
+            return;
+        }
+        let thread = self.thread.read(cx);
+        // A composer send still resolving would race the request, and the user's own turn would
+        // take the generation stored below.
+        if self.is_loading_contents
+            || availability(&link, thread, &self.send_to_parent)
+                .summarize
+                .is_err()
+        {
+            return;
+        }
+        // The thread is idle (availability says so), so the turn this starts is the next
+        // activity generation at the earliest (R3.6).
+        let activity_generation = thread.activity_generation() + 1;
+        self.send_to_parent.pending_summary = Some(PendingSummary {
+            activity_generation,
+            entries_before: thread.entries().len(),
+        });
+        let session = self.session_id.clone();
+        log::info!("zeo_sub_thread event=summary_requested sub_session={session}");
+        let request = acp_v2::ContentBlock::Text(acp_v2::TextContent::new(SUMMARY_REQUEST));
+        // Upstream's own send of a ready message: it never reads nor clears the composer. A
+        // turn that fails ends with `AcpThreadEvent::Error`, and a request the agent rejects
+        // settles its submission `Failed`; either clears the summary (R3.3).
+        self.send_content(
+            Task::ready(Ok(Some((vec![request], Vec::new())))),
+            false,
+            window,
+            cx,
+        );
+    }
+
+    /// The end of a turn, or a removal of entries, forwarded by the conversation view. Delivers
+    /// the summary on a clean end of the summary's own turn (R3.2); any other end of it says so
+    /// (R3.3); another turn's end is not this feature's business (R3.6, R3.7).
+    pub(crate) fn on_sub_thread_turn_event(
+        &mut self,
+        event: &AcpThreadEvent,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(pending) = self.send_to_parent.pending_summary.as_ref() else {
+            return;
+        };
+        if let AcpThreadEvent::SubmissionUpdated(id) = event {
+            if let Some(error) = rejected_summary_request(self.thread.read(cx), *id) {
+                self.send_to_parent.pending_summary = None;
+                log::warn!(
+                    "zeo_sub_thread event=summary_failed sub_session={} reason=submit_rejected",
+                    self.session_id
+                );
+                self.send_to_parent.notice = Some(format!("Summary not sent: {error}").into());
+                cx.notify();
+            }
+            return;
+        }
+        let turn = summary_turn(self.thread.read(cx), pending);
+        let finished_cleanly = match (event, turn) {
+            // Not bound to the request's entry: a refused turn is truncated from its user
+            // message before this event, so the request is no longer there to find (R3.3).
+            (AcpThreadEvent::Error | AcpThreadEvent::Refusal, _) => false,
+            // The request's entry was removed — a rewind, or a refusal truncating the turn with
+            // no `Refusal` event (native agent): its turn can no longer deliver (R3.3).
+            (AcpThreadEvent::EntriesRemoved(range), SummaryTurn::NotYet)
+                if range.end > pending.entries_before =>
+            {
+                false
+            }
+            (_, SummaryTurn::NotYet) => return,
+            (
+                AcpThreadEvent::Stopped {
+                    activity_generation,
+                    ..
+                },
+                _,
+            ) if *activity_generation < pending.activity_generation => return,
+            (AcpThreadEvent::Stopped { stop_reason, .. }, SummaryTurn::Current) => {
+                *stop_reason == Some(acp_v2::StopReason::EndTurn)
+            }
+            (AcpThreadEvent::Stopped { .. }, SummaryTurn::Passed) => false,
+            _ => return,
+        };
+        self.send_to_parent.pending_summary = None;
+        cx.notify();
+        let session = self.session_id.clone();
+        let parent = match parent_link(self.root_thread_id, cx) {
+            ParentLink::Live { parent_session, .. } => Some(parent_session),
+            _ => None,
+        };
+        let thread = self.thread.read(cx);
+        let reply = finished_cleanly
+            .then(|| last_reply_text(thread.entries(), cx))
+            .flatten();
+        let (Some(parent_session), Some(reply)) = (parent, reply) else {
+            log::warn!(
+                "zeo_sub_thread event=summary_failed sub_session={session} reason=turn_not_finished"
+            );
+            self.send_to_parent.notice = Some(NOT_SENT.into());
+            return;
+        };
+        let title = thread
+            .title()
+            .unwrap_or_else(|| crate::DEFAULT_THREAD_TITLE.into());
+        let block = compose_block(&title, &reply);
+        // The same in-flight guard as Send Last Reply: a pick meanwhile would open the parent
+        // twice (R2.6).
+        self.send_to_parent.delivering = true;
+        deliver_to_parent(parent_session, block, cx.entity().downgrade(), window, cx);
+    }
+}
diff --git a/crates/agent_ui/src/sub_thread_send/summary_binding_tests.rs b/crates/agent_ui/src/sub_thread_send/summary_binding_tests.rs
new file mode 100644
index 0000000..21b9563
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/summary_binding_tests.rs
@@ -0,0 +1,320 @@
+// Story 040, task 11.2 (refine v4, review 7.x M4 and L1) — the summary is bound to the turn its
+// own request started, and Summarize waits while the thread's state is unconfirmed (R3.3, R3.6,
+// R3.7, R3.8; Q4, Q11). Module path: `sub_thread_send::summary_binding_tests`. Wired in
+// `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/summary_binding_tests.rs"]
+//     mod summary_binding_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- summarize_and_send`. Fixtures:
+// `crate::sub_thread_test_support` and `super::receipt_test_support` (setup only).
+//
+// Every case runs the sub-thread on the reported-activity transport, the one M4 is about: the
+// generation moves when the AGENT reports Running, not when Zeo sends, so a turn the agent
+// starts on its own after the summary's submit takes the generation the summary was waiting
+// for. How the summary binds to its submission (the prompt's own result, or the stopped turn's
+// latest user message being the request) is left to the implementation: these tests assert only
+// what reaches the parent's composer, the notice, whether the summary is still pending, and
+// what the agent was sent.
+//
+// Hostile halves first:
+//   - wrongly COLLAPSED: a turn the agent starts on its own, ending with end of turn while the
+//     summary is pending, is taken for the summary and its reply delivered (M4) — must insert
+//     nothing and keep waiting; the same turn ending cancelled must not fail the summary either;
+//   - wrongly SPLIT: once the agent's own turn has taken that generation, the summary's own turn
+//     carries a later one — it must still deliver, exactly once, and nothing after it does;
+//   - wrongly ALLOWED: Summarize picked while the thread is Unconfirmed submits nothing (L1);
+//     its converse, Send Last Reply in the same state, still delivers;
+//   - then the benign control: the summary's turn alone on this transport delivers.
+
+use agent_client_protocol::schema::v2 as acp_v2;
+use futures::channel::oneshot;
+use gpui::{Modifiers, TestAppContext, VisualTestContext};
+
+use super::SUMMARY_REQUEST;
+use super::receipt_test_support::*;
+use crate::sub_thread_test_support::*;
+
+const NOT_SENT: &str = "Summary not sent: the reply did not finish";
+const CONTROL: &str = "send-to-parent";
+const LAST_REPLY: &str = "send-to-parent-last-reply";
+const SUMMARIZE: &str = "send-to-parent-summarize";
+/// The receipt id the agent gives the summary request; its echo carries it back.
+const SUMMARY_ECHO: &str = "summary-echo";
+
+fn block(title: &str, reply: &str) -> String {
+    format!("From sub-thread \"{title}\":\n\n{reply}")
+}
+
+fn pending(child: &Conv, cx: &VisualTestContext) -> bool {
+    child
+        .view
+        .read_with(cx, |view, _| view.send_to_parent.pending_summary.is_some())
+}
+
+fn generation(child: &Conv, cx: &VisualTestContext) -> u64 {
+    child
+        .thread
+        .read_with(cx, |thread, _| thread.activity_generation())
+}
+
+/// A legacy parent and a confirmed-idle child on the receipt transport, linked.
+fn receipt_pair(rig: &mut Rig) -> (Conv, Conv, acp_thread::StubAgentConnection) {
+    let parent = open_conversation(rig, "Parent", "parent answer");
+    let (child, connection) = open_receipt_conversation(rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    (parent, child, connection)
+}
+
+/// Picks Summarize and Send; the agent accepts the request (receipt) but has not taken it up
+/// yet — no echo, no Running.
+fn summarize_accepted(rig: &mut Rig, child: &Conv, connection: &acp_thread::StubAgentConnection) {
+    let receipt: oneshot::Sender<anyhow::Result<acp_v2::PromptResponse>> =
+        connection.defer_next_receipt_response();
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+    assert_eq!(
+        connection.take_receipt_prompt(),
+        Some(vec![SUMMARY_REQUEST.into()]),
+        "precondition: the summary request went to the agent"
+    );
+    receipt
+        .send(Ok(acp_v2::PromptResponse::new(SUMMARY_ECHO)))
+        .expect("the summary request waits for its receipt");
+    rig.cx.run_until_parked();
+    assert!(
+        pending(child, &rig.cx),
+        "precondition: the summary is pending"
+    );
+}
+
+/// The agent takes up the summary request: echo, Running, `reply`, Idle with end of turn.
+fn summary_turn(child: &Conv, reply: &str, cx: &mut VisualTestContext) {
+    echo_user_message(&child.thread, SUMMARY_ECHO, SUMMARY_REQUEST, cx);
+    report_running(&child.thread, cx);
+    agent_chunk(&child.thread, reply, cx);
+    report_idle(&child.thread, Some(acp_v2::StopReason::EndTurn), cx);
+}
+
+fn click(selector: &'static str, cx: &mut VisualTestContext) {
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    cx.run_until_parked();
+    draw(cx);
+}
+
+// ── Hostile, wrongly collapsed: the agent's own turn is not the summary (R3.7) ──
+
+#[gpui::test]
+async fn summarize_and_send_agent_initiated_turn_while_pending_inserts_nothing(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child, connection) = receipt_pair(&mut rig);
+    let before = generation(&child, &rig.cx);
+    summarize_accepted(&mut rig, &child, &connection);
+
+    // Before taking up the request, the agent runs a turn of its own and ends it cleanly.
+    agent_initiated_turn(
+        &child.thread,
+        "a background continuation",
+        acp_v2::StopReason::EndTurn,
+        &mut rig.cx,
+    );
+    assert_eq!(
+        generation(&child, &rig.cx),
+        before + 1,
+        "precondition: the agent's own turn took the next generation, the one the summary's turn \
+         would have had"
+    );
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        "",
+        "a turn the agent started on its own delivers nothing"
+    );
+    assert!(
+        pending(&child, &rig.cx),
+        "the summary keeps waiting for its own turn"
+    );
+    assert_eq!(notice_of(&child.view, &rig.cx), None, "and nothing failed");
+}
+
+#[gpui::test]
+async fn summarize_and_send_agent_initiated_turn_cancelled_while_pending_keeps_waiting(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child, connection) = receipt_pair(&mut rig);
+    summarize_accepted(&mut rig, &child, &connection);
+
+    agent_initiated_turn(
+        &child.thread,
+        "half a continuation",
+        acp_v2::StopReason::Cancelled,
+        &mut rig.cx,
+    );
+
+    assert_eq!(composer_text(&parent.view, &rig.cx), "");
+    assert_eq!(
+        notice_of(&child.view, &rig.cx),
+        None,
+        "another turn's end is not the summary's failure (R3.3 is about the summary's own turn)"
+    );
+    assert!(pending(&child, &rig.cx), "the summary keeps waiting");
+}
+
+// ── Hostile, wrongly split: the summary's own turn still delivers (R3.6, R3.7) ──
+
+#[gpui::test]
+async fn summarize_and_send_its_own_turn_delivers_once_after_an_agent_initiated_turn(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child, connection) = receipt_pair(&mut rig);
+    summarize_accepted(&mut rig, &child, &connection);
+    agent_initiated_turn(
+        &child.thread,
+        "a background continuation",
+        acp_v2::StopReason::EndTurn,
+        &mut rig.cx,
+    );
+
+    summary_turn(&child, "the summary", &mut rig.cx);
+
+    let delivered = block("Child", "the summary");
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        delivered,
+        "the summary's own turn delivers its reply, once"
+    );
+    assert!(!pending(&child, &rig.cx), "nothing is pending any more");
+    assert_eq!(notice_of(&child.view, &rig.cx), None);
+
+    // After delivery, neither another turn of the agent's own nor a repeated Idle adds anything.
+    agent_initiated_turn(
+        &child.thread,
+        "yet another continuation",
+        acp_v2::StopReason::EndTurn,
+        &mut rig.cx,
+    );
+    report_idle(
+        &child.thread,
+        Some(acp_v2::StopReason::EndTurn),
+        &mut rig.cx,
+    );
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        delivered,
+        "delivered exactly once"
+    );
+}
+
+// ── Hostile, wrongly allowed: Summarize while Unconfirmed (R3.8) ───────────
+
+#[gpui::test]
+async fn summarize_and_send_disabled_while_unconfirmed(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let sent_before = user_message_count(&child.thread, &rig.cx);
+    // Were the request submitted, the agent would accept it: the receipt is ready.
+    let _receipt = connection.defer_next_receipt_response();
+    draw(&mut rig.cx);
+
+    click(CONTROL, &mut rig.cx);
+    assert!(
+        painted(SUMMARIZE, &mut rig.cx),
+        "precondition: the choice is listed"
+    );
+    click(SUMMARIZE, &mut rig.cx);
+    // The guard holds on the direct path too, not only in the menu.
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        connection.take_receipt_prompt(),
+        None,
+        "no summary request reaches the agent while the thread's state is unconfirmed"
+    );
+    assert_eq!(user_message_count(&child.thread, &rig.cx), sent_before);
+    assert!(!pending(&child, &rig.cx), "no summary is pending");
+    assert_eq!(composer_text(&parent.view, &rig.cx), "");
+
+    // Converse: Send Last Reply is not held back by Unconfirmed.
+    draw(&mut rig.cx);
+    if !painted(LAST_REPLY, &mut rig.cx) {
+        click(CONTROL, &mut rig.cx);
+    }
+    click(LAST_REPLY, &mut rig.cx);
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        block("Child", "a loaded reply"),
+        "Send Last Reply still delivers while Unconfirmed"
+    );
+}
+
+#[gpui::test]
+async fn summarize_and_send_unconfirmed_then_first_report_running_delivers_nothing(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+    let _receipt = connection.defer_next_receipt_response();
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+
+    // L1: the first report belongs to a turn from before the load, and it ends cleanly.
+    agent_initiated_turn(
+        &child.thread,
+        "the end of an earlier turn",
+        acp_v2::StopReason::EndTurn,
+        &mut rig.cx,
+    );
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        "",
+        "a turn from before the load is never delivered as a summary"
+    );
+    assert_ne!(
+        notice_of(&child.view, &rig.cx).as_deref(),
+        Some(NOT_SENT),
+        "and no summary was waiting to fail"
+    );
+}
+
+// ── Benign control: the summary's turn alone on this transport ─────────────
+
+#[gpui::test]
+async fn summarize_and_send_on_the_reported_activity_transport_delivers(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (parent, child, connection) = receipt_pair(&mut rig);
+    summarize_accepted(&mut rig, &child, &connection);
+
+    summary_turn(&child, "the summary", &mut rig.cx);
+
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        block("Child", "the summary")
+    );
+    assert!(!pending(&child, &rig.cx));
+}
diff --git a/crates/agent_ui/src/sub_thread_send/summary_rejected_submit_tests.rs b/crates/agent_ui/src/sub_thread_send/summary_rejected_submit_tests.rs
new file mode 100644
index 0000000..2999cdb
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/summary_rejected_submit_tests.rs
@@ -0,0 +1,72 @@
+// Story 040, task 12.2 (validation fix round 1, audit finding "Happy/error path symmetry"):
+// on the reported-activity transport a Summarize submit the agent rejects settles `Failed` and
+// emits only `SubmissionUpdated` — no `Error`, no turn — so the summary must be cleared there,
+// with the failure as the notice, instead of leaving both choices on "Wait for the turn to end"
+// with nothing running (R3.3, R3.5; tasks.md 7.2 ToDo 1).
+
+use agent_client_protocol::schema::v2 as acp_v2;
+use futures::channel::oneshot;
+use gpui::{SharedString, TestAppContext};
+
+use super::receipt_test_support::*;
+use super::{Availability, SUMMARY_REQUEST, availability, parent_link};
+use crate::sub_thread_test_support::*;
+
+#[gpui::test]
+async fn summarize_and_send_rejected_submit_on_the_receipt_transport_clears_the_summary(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, connection) = open_receipt_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+
+    let receipt: oneshot::Sender<anyhow::Result<acp_v2::PromptResponse>> =
+        connection.defer_next_receipt_response();
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+    assert_eq!(
+        connection.take_receipt_prompt(),
+        Some(vec![SUMMARY_REQUEST.into()]),
+        "precondition: the summary request went to the agent"
+    );
+    let pending = |rig: &Rig| {
+        child.view.read_with(&rig.cx, |view, _| {
+            view.send_to_parent.pending_summary.is_some()
+        })
+    };
+    assert!(pending(&rig), "precondition: the summary is pending");
+
+    receipt
+        .send(Err(anyhow::anyhow!("the agent refused the message")))
+        .expect("the summary request waits for its receipt");
+    rig.cx.run_until_parked();
+
+    assert!(!pending(&rig), "a rejected submit no longer waits");
+    let notice = notice_of(&child.view, &rig.cx);
+    assert_eq!(
+        notice.as_deref(),
+        Some("Summary not sent: the agent refused the message"),
+        "the failure is shown under the control"
+    );
+    let choices = child.view.read_with(&rig.cx, |view, cx| {
+        let link = parent_link(view.root_thread_id, cx);
+        let Availability {
+            last_reply,
+            summarize,
+        } = availability(&link, view.thread.read(cx), &view.send_to_parent);
+        (
+            last_reply.map_err(|tooltip: SharedString| tooltip.to_string()),
+            summarize.map_err(|tooltip: SharedString| tooltip.to_string()),
+        )
+    });
+    assert_eq!(choices, (Ok(()), Ok(())), "both choices are offered again");
+    assert_eq!(
+        composer_text(&parent.view, &rig.cx),
+        "",
+        "nothing delivered"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_send/summary_removed_entries_tests.rs b/crates/agent_ui/src/sub_thread_send/summary_removed_entries_tests.rs
new file mode 100644
index 0000000..f9524e2
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/summary_removed_entries_tests.rs
@@ -0,0 +1,60 @@
+// Story 040, task 11.2 (tech review 11.x M1): the summary's request entry removed while its turn
+// runs — here by a rewind of the earlier message — clears the pending summary with its notice,
+// instead of leaving both choices on "Wait for the turn to end" for good (R3.3).
+
+use acp_thread::AgentThreadEntry;
+use agent_client_protocol::schema::v1 as acp_v1;
+use gpui::TestAppContext;
+
+use crate::sub_thread_test_support::*;
+
+const NOT_SENT: &str = "Summary not sent: the reply did not finish";
+
+#[gpui::test]
+async fn summarize_and_send_request_removed_by_a_rewind_clears_with_the_notice(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let child = open_conversation(&mut rig, "Child", "child answer");
+    link(child.thread_id, parent.thread_id, &mut rig.cx);
+
+    let finish = rig.connection.defer_next_prompt_response();
+    child.view.update_in(&mut rig.cx, |view, window, cx| {
+        view.summarize_and_send(window, cx)
+    });
+    rig.cx.run_until_parked();
+    let pending = |rig: &Rig| {
+        child.view.read_with(&rig.cx, |view, _| {
+            view.send_to_parent.pending_summary.is_some()
+        })
+    };
+    assert!(pending(&rig), "precondition: the summary is pending");
+
+    // The user rewinds to the first message while the summary's turn still runs.
+    let first = child.thread.read_with(&rig.cx, |thread, _| {
+        thread.entries().iter().find_map(|entry| match entry {
+            AgentThreadEntry::UserMessage(message) => message.client_id.clone(),
+            _ => None,
+        })
+    });
+    let first = first.expect("precondition: the first message has a client id");
+    child
+        .thread
+        .update(&mut rig.cx, |thread, cx| thread.rewind(first, cx))
+        .await
+        .expect("the rewind applies");
+    rig.cx.run_until_parked();
+
+    assert!(!pending(&rig), "the summary no longer waits");
+    assert_eq!(notice_of(&child.view, &rig.cx).as_deref(), Some(NOT_SENT));
+
+    // The turn's late end delivers nothing.
+    finish
+        .send(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+        // The rewind may already have dropped the turn's receiver; either way nothing is sent.
+        .ok();
+    rig.cx.run_until_parked();
+    assert_eq!(composer_text(&parent.view, &rig.cx), "");
+}
diff --git a/crates/agent_ui/src/sub_thread_send/unconfirmed_availability_tests.rs b/crates/agent_ui/src/sub_thread_send/unconfirmed_availability_tests.rs
new file mode 100644
index 0000000..8520cf1
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_send/unconfirmed_availability_tests.rs
@@ -0,0 +1,185 @@
+// Story 040, task 11.2 (refine v4, review 7.x L1) — `availability` rows for a thread whose state
+// is not yet known (R3.8; Q5). Module path: `sub_thread_send::unconfirmed_availability_tests`.
+// Wired in `src/sub_thread_send.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "sub_thread_send/unconfirmed_availability_tests.rs"]
+//     mod unconfirmed_availability_tests;
+//
+// Validation filter: `cargo test -p agent_ui -- sub_thread_send`. Fixtures:
+// `crate::sub_thread_test_support` and `super::receipt_test_support` (task 11.2's setup-only
+// helpers for the reported-activity transport).
+//
+// Contract (design.md v4 §SendToParentControl, `availability` order of checks): Deleted → "The
+// parent thread was deleted" (both); generating or a pending summary → "Wait for the turn to end"
+// (both); delivering → "Sending to the parent thread" (both, task 11.3); `ThreadStatus::Unconfirmed`
+// → "Wait for the turn to end" for Summarize ONLY — Send Last Reply keeps its own rules, as
+// upstream's Copy does; no agent message → "No reply to send yet" (last reply only).
+// Only `SendToParentState::default()` is built here, so task 11.3's `delivering` field and
+// any change to `PendingSummary` leave this file alone.
+//
+// Hostile halves first:
+//   - wrongly ALLOWED: an Unconfirmed thread with a reply offers Summarize (L1 — its first active
+//     report may belong to a turn from before the load, and that reply would be delivered);
+//   - wrongly DISABLED: the same Unconfirmed thread must still offer Send Last Reply; and a
+//     reported-activity thread whose first report was Idle (confirmed, still generation 0) is not
+//     Unconfirmed and offers both;
+//   - order: a deleted parent still wins over Unconfirmed (the pending-summary row is
+//     helpers_tests.rs's, unchanged);
+//   - then the plain row with no reply.
+
+use acp_thread::{AcpThread, ThreadStatus};
+use gpui::{Entity, SharedString, TestAppContext, VisualTestContext};
+
+use super::receipt_test_support::*;
+use super::{Availability, ParentLink, SendToParentState, availability};
+use crate::sub_thread_test_support::*;
+
+const DELETED: &str = "The parent thread was deleted";
+const WAIT: &str = "Wait for the turn to end";
+const NO_REPLY: &str = "No reply to send yet";
+
+fn avail(
+    link: &ParentLink,
+    thread: &Entity<AcpThread>,
+    state: &SendToParentState,
+    cx: &VisualTestContext,
+) -> (Result<(), String>, Result<(), String>) {
+    thread.read_with(cx, |thread, _| {
+        let Availability {
+            last_reply,
+            summarize,
+        } = availability(link, thread, state);
+        (
+            last_reply.map_err(|tooltip: SharedString| tooltip.to_string()),
+            summarize.map_err(|tooltip: SharedString| tooltip.to_string()),
+        )
+    })
+}
+
+fn live(parent: &Conv) -> ParentLink {
+    ParentLink::Live {
+        parent: parent.thread_id,
+        parent_session: parent.session.clone(),
+    }
+}
+
+fn status(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> ThreadStatus {
+    thread.read_with(cx, |thread, _| thread.status())
+}
+
+// ── Hostile: Unconfirmed must not offer Summarize (R3.8) ───────────────────
+
+#[gpui::test]
+async fn sub_thread_send_availability_unconfirmed_disables_summarize_only(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, _connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+    assert_eq!(
+        status(&child.thread, &rig.cx),
+        ThreadStatus::Unconfirmed,
+        "precondition: no state reported since the load"
+    );
+
+    let (last_reply, summarize) = avail(
+        &live(&parent),
+        &child.thread,
+        &SendToParentState::default(),
+        &rig.cx,
+    );
+    assert_eq!(
+        summarize,
+        Err(WAIT.to_string()),
+        "Summarize waits until the agent says whether a turn is running"
+    );
+    assert_eq!(
+        last_reply,
+        Ok(()),
+        "Send Last Reply stays available while Unconfirmed, as upstream's Copy does"
+    );
+}
+
+#[gpui::test]
+async fn sub_thread_send_availability_unconfirmed_without_a_reply(cx: &mut TestAppContext) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, _connection) = open_unconfirmed_receipt_conversation(&mut rig, "");
+
+    let (last_reply, summarize) = avail(
+        &live(&parent),
+        &child.thread,
+        &SendToParentState::default(),
+        &rig.cx,
+    );
+    assert_eq!(
+        summarize,
+        Err(WAIT.to_string()),
+        "Unconfirmed disables Summarize with or without a reply"
+    );
+    assert_eq!(
+        last_reply,
+        Err(NO_REPLY.to_string()),
+        "Send Last Reply keeps its own rule, not the Unconfirmed wait"
+    );
+}
+
+// ── Hostile converse: a confirmed idle thread is not Unconfirmed ───────────
+
+#[gpui::test]
+async fn sub_thread_send_availability_confirmed_idle_at_generation_zero_offers_both(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let parent = open_conversation(&mut rig, "Parent", "parent answer");
+    let (child, _connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+    // The agent's first report says it is idle: the state is known, and no turn ever ran.
+    report_idle(&child.thread, None, &mut rig.cx);
+    assert_eq!(
+        status(&child.thread, &rig.cx),
+        ThreadStatus::Idle,
+        "precondition"
+    );
+    assert_eq!(
+        child
+            .thread
+            .read_with(&rig.cx, |thread, _| thread.activity_generation()),
+        0,
+        "precondition: still generation 0, so generation alone cannot tell the two apart"
+    );
+
+    let (last_reply, summarize) = avail(
+        &live(&parent),
+        &child.thread,
+        &SendToParentState::default(),
+        &rig.cx,
+    );
+    assert_eq!(
+        summarize,
+        Ok(()),
+        "a confirmed idle thread offers Summarize"
+    );
+    assert_eq!(last_reply, Ok(()));
+}
+
+// ── Order: the more lasting reason still wins ──────────────────────────────
+
+#[gpui::test]
+async fn sub_thread_send_availability_deleted_parent_wins_over_unconfirmed(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let mut rig = rig(cx).await;
+    let (child, _connection) = open_unconfirmed_receipt_conversation(&mut rig, "a loaded reply");
+
+    let (last_reply, summarize) = avail(
+        &ParentLink::Deleted,
+        &child.thread,
+        &SendToParentState::default(),
+        &rig.cx,
+    );
+    assert_eq!(last_reply, Err(DELETED.to_string()));
+    assert_eq!(summarize, Err(DELETED.to_string()));
+}
diff --git a/crates/agent_ui/src/sub_thread_test_support.rs b/crates/agent_ui/src/sub_thread_test_support.rs
new file mode 100644
index 0000000..eca185a
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_test_support.rs
@@ -0,0 +1,260 @@
+// Story 040 — shared fixtures for the agent_ui tests of Send to Parent and the sub-thread
+// reporter (tasks 2.1, 4.1, 6.1, 6.2, 7.1, 7.2). Materialize with the first of those tasks, in
+// `src/agent_ui.rs`:
+//
+//     #[cfg(test)]
+//     mod sub_thread_test_support;
+//
+// A rig is one window over `/project` with a real `AgentPanel` (and so its real `TasksCard`),
+// the real `ThreadMetadataStore` and, unless a test says otherwise, the real
+// `ThreadOrganizationStore` installed BEFORE the panel exists — so the card's reporter can
+// observe it from creation, as in Zeo, where `agent_ui::init` installs it at startup.
+//
+// Threads run on one shared `StubAgentConnection`; a sub-thread link is made the way story 039
+// makes it, `ThreadOrganizationStore::set_parent(child, parent, kind)`. Contract assumed beyond
+// design.md (adjust HERE, not in each test):
+//   - `ThreadView::send_to_parent` is a `pub(crate)` field (`notice_of` reads it);
+//   - `AgentPanel::tasks_card()` returns the panel's card (as in 0037's tests).
+
+#![allow(dead_code)]
+
+use std::{cell::RefCell, path::Path, rc::Rc};
+
+use acp_thread::{AcpThread, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp_v1;
+use agent_client_protocol::schema::v2 as acp;
+use fs::FakeFs;
+use gpui::{
+    AppContext as _, Entity, Subscription, TestAppContext, VisualTestContext, WindowHandle,
+};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, Workspace};
+
+use crate::conversation_view::ThreadView;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use crate::{AgentPanel, SubThreadActivity, TasksCard};
+
+/// Upstream's agent_ui test globals, the agent globals, and the organization store.
+pub(crate) fn init(cx: &mut TestAppContext) {
+    init_without_organization(cx);
+    cx.update(|cx| crate::thread_organization::init(cx));
+    cx.run_until_parked();
+}
+
+/// The same, with no organization store installed (`try_global` is `None`).
+pub(crate) fn init_without_organization(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+pub(crate) struct Rig {
+    pub fs: std::sync::Arc<FakeFs>,
+    pub window: WindowHandle<MultiWorkspace>,
+    pub workspace: Entity<Workspace>,
+    pub panel: Entity<AgentPanel>,
+    pub connection: StubAgentConnection,
+    pub cx: VisualTestContext,
+}
+
+/// One conversation of the rig's panel: its root thread, its view, its ids.
+#[derive(Clone)]
+pub(crate) struct Conv {
+    pub thread: Entity<AcpThread>,
+    pub view: Entity<ThreadView>,
+    pub session: acp::SessionId,
+    pub thread_id: ThreadId,
+}
+
+/// A window over `/project` with a visible agent panel. `init` (or `init_without_organization`)
+/// must have run.
+pub(crate) async fn rig(cx: &mut TestAppContext) -> Rig {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    window_over(&fs, "/project", cx).await
+}
+
+/// Another window over `root` on the same file system (`root` must exist on `fs`), with its own
+/// agent panel. Its `connection` is a fresh stub; share one by assigning it.
+pub(crate) async fn window_over(
+    fs: &std::sync::Arc<FakeFs>,
+    root: &str,
+    cx: &mut TestAppContext,
+) -> Rig {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    vcx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    Rig {
+        fs: fs.clone(),
+        window,
+        workspace,
+        panel,
+        connection: StubAgentConnection::new(),
+        cx: vcx,
+    }
+}
+
+/// The agent's next turn answers `reply` and ends with end-of-turn; an empty `reply` answers
+/// nothing at all (the turn ends with no agent message).
+pub(crate) fn next_reply(connection: &StubAgentConnection, reply: &str) {
+    if reply.is_empty() {
+        connection.set_next_prompt_updates(Vec::new());
+        return;
+    }
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new(reply.to_string().into()),
+    )]);
+}
+
+/// Opens a new conversation on the rig's connection, sends one message answered by `reply`
+/// (so it is a persisted thread with a session), titles it `title`, and returns it. It stays
+/// held by the panel (the stub cannot load a session back, so it is never released).
+pub(crate) fn open_conversation(rig: &mut Rig, title: &str, reply: &str) -> Conv {
+    crate::test_support::open_thread_with_connection(
+        &rig.panel,
+        rig.connection.clone(),
+        &mut rig.cx,
+    );
+    next_reply(&rig.connection, reply);
+    crate::test_support::send_message(&rig.panel, &mut rig.cx);
+    rig.cx.run_until_parked();
+    let (thread, view) = rig.panel.read_with(&rig.cx, |panel, cx| {
+        (
+            panel
+                .active_agent_thread(cx)
+                .expect("a thread was just opened"),
+            panel.active_thread_view(cx).expect("its view is shown"),
+        )
+    });
+    set_title(&thread, title, &mut rig.cx);
+    let session = thread.read_with(&rig.cx, |thread, _| thread.session_id().clone());
+    let thread_id = crate::test_support::active_thread_id(&rig.panel, &rig.cx);
+    Conv {
+        thread,
+        view,
+        session,
+        thread_id,
+    }
+}
+
+pub(crate) fn set_title(thread: &Entity<AcpThread>, title: &str, cx: &mut VisualTestContext) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp_v1::SessionUpdate::SessionInfoUpdate(
+                    acp_v1::SessionInfoUpdate::new().title(title),
+                ),
+                cx,
+            )
+        })
+        .expect("the title update applies");
+    cx.run_until_parked();
+}
+
+/// Records `child` as a sub-thread of `parent`, as story 039 does.
+pub(crate) fn link(child: ThreadId, parent: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_parent(child, parent, ForkKind::Clean, cx)
+                .expect("the parent link is recorded")
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// Deletes a thread's metadata row, as deleting the thread from the history does. The
+/// organization store keeps a child's link to it (story 031: a dangling link).
+pub(crate) fn delete_thread(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(thread_id, cx))
+    });
+    cx.run_until_parked();
+}
+
+/// Types `text` into `view`'s composer and sends it; the agent answers `reply`.
+pub(crate) fn send_text(rig: &mut Rig, view: &Entity<ThreadView>, text: &str, reply: &str) {
+    next_reply(&rig.connection, reply);
+    set_composer(view, text, &mut rig.cx);
+    view.update_in(&mut rig.cx, |view, window, cx| view.send(window, cx));
+    rig.cx.run_until_parked();
+}
+
+pub(crate) fn set_composer(view: &Entity<ThreadView>, text: &str, cx: &mut VisualTestContext) {
+    let editor = view.read_with(cx, |view, _| view.message_editor.clone());
+    editor.update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    cx.run_until_parked();
+}
+
+pub(crate) fn composer_text(view: &Entity<ThreadView>, cx: &VisualTestContext) -> String {
+    view.read_with(cx, |view, cx| view.message_editor.read(cx).text(cx))
+}
+
+/// The user messages of `thread`, in order — what was SENT, never what sits in a composer.
+pub(crate) fn user_message_count(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .filter(|entry| matches!(entry, acp_thread::AgentThreadEntry::UserMessage(_)))
+            .count()
+    })
+}
+
+/// The notice Send to Parent shows under its control, if any.
+pub(crate) fn notice_of(view: &Entity<ThreadView>, cx: &VisualTestContext) -> Option<String> {
+    view.read_with(cx, |view, _| {
+        view.send_to_parent
+            .notice
+            .as_ref()
+            .map(|notice| notice.to_string())
+    })
+}
+
+pub(crate) fn card(rig: &Rig) -> Entity<TasksCard> {
+    rig.panel
+        .read_with(&rig.cx, |panel, _| panel.tasks_card().clone())
+}
+
+/// Every `SubThreadActivity` `card` emits from now on, in order.
+pub(crate) fn record_activity(
+    card: &Entity<TasksCard>,
+    cx: &mut VisualTestContext,
+) -> (Rc<RefCell<Vec<SubThreadActivity>>>, Subscription) {
+    let heard = Rc::new(RefCell::new(Vec::new()));
+    let subscription = cx.update(|_, cx| {
+        let heard = heard.clone();
+        cx.subscribe(card, move |_, activity: &SubThreadActivity, _| {
+            heard.borrow_mut().push(activity.clone())
+        })
+    });
+    (heard, subscription)
+}
+
+pub(crate) fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Whether the element painted under `selector` exists after the last draw.
+pub(crate) fn painted(selector: impl Into<String>, cx: &mut VisualTestContext) -> bool {
+    let selector: &'static str = Box::leak(selector.into().into_boxed_str());
+    cx.debug_bounds(selector).is_some()
+}
