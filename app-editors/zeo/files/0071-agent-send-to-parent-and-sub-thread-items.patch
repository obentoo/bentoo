+// ── Row shape (R7.1, R7.7) ─────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_row_has_its_chip_and_no_stop_or_log_beside_an_adapter_row(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    emit_sub(
