+// Story 064, task 5.1 — fixtures for the Agent Tasks panel's native subagent rows (R1.1, R1.6,
+// R2.3, R2.4). Patches `0035`/`0041`/`0053` (fixups). Wired in the crate's lib
+// (`src/agent_tasks_panel.rs`) beside `test_helpers`:
+//
+//     #[cfg(test)]
+//     mod native_subagent_support;
+//
+// and its two test files in `src/panel.rs` and `src/store.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "panel/native_subagent_tests.rs"]
+//     mod native_subagent;                         // panel::native_subagent
+//     #[cfg(test)]
+//     #[path = "store/panel_native_subagent_restart_tests.rs"]
+//     mod panel_native_subagent_restart;           // store::panel_native_subagent_restart
+//
+// The restart file sits under `store` because only that module reaches the private
+// `GlobalTaskHistoryStore` (story 014's restart recipe); its name carries the Validation
+// filter `cargo test -p agent_tasks_panel panel`.
+//
+// A child is built as `agent_servers::acp::apply_subagent_update` builds one (see 4.1's
+// `native_subagent_support.rs`): an `agent_owned` thread under the parent's session,
+// `track_session` on the stub, its association, then `register_subagent`.
+//
+// Contract assumed beyond design.md (adjust HERE): the panel's row key of a native subagent is
+// design.md's history key, `(parent session, "acp-subagent:<child session>")`. Revision 1
+// (operator, 2026-10-29): no `source` column — step 7 adds only `child_session_id`, and a native
+// record carries the new origin value `acp_subagent` (`TaskOrigin::AcpSubagent`) in step 5's
+// existing `origin` column. The one SQL that names them is `seed_recorded_subagent`.
+
+#![allow(dead_code)]
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection};
+use agent_client_protocol::v1::schema as acp;
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_ui::AgentPanel;
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use gpui::{AppContext as _, Entity, VisualTestContext};
+use workspace::PathList;
+
+use crate::AgentTaskHistoryDb;
+use crate::test_helpers::*;
+
+/// The notice a recorded subagent row shows when only its parent could be opened (R2.4).
+pub(crate) const PARENT_ONLY_NOTICE: &str =
+    "This subagent's transcript is only available from its parent thread";
+
+pub(crate) fn subagent_key(parent: &acp_v2::SessionId, child: &str) -> Key {
+    (parent.clone(), format!("acp-subagent:{child}").into())
+}
+
+/// A stub that follows the subagents RFD; its first prompt ends at once, so the opening
+/// message persists the thread and leaves the parent idle.
+pub(crate) fn rfd_connection() -> StubAgentConnection {
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    connection.set_next_prompt_updates(vec![acp::SessionUpdate::AgentMessageChunk(
+        acp::ContentChunk::new("ok".into()),
+    )]);
+    connection
+}
+
+/// Announces `session` as a child of `parent` and registers it.
+pub(crate) fn spawn_child(
+    parent: &Entity<AcpThread>,
+    connection: &StubAgentConnection,
+    session: &str,
+    title: &str,
+    cx: &mut VisualTestContext,
+) -> Entity<AcpThread> {
+    let parent_session = session_of(parent, cx);
+    let shared: Rc<dyn AgentConnection> = Rc::new(connection.clone());
+    let child = cx.update(|_, cx| {
+        let project = parent.read(cx).project().clone();
+        let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+        cx.new(|cx| {
+            AcpThread::new(
+                Some(parent_session),
+                None,
+                None,
+                shared,
+                project,
+                action_log,
+                acp_v2::SessionId::new(session.to_string()),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+            .agent_owned()
+        })
+    });
+    cx.update(|_, cx| connection.track_session(&child, cx));
+    child
+        .update(cx, |child, cx| {
+            child.update_subagent_association(
+                &acp_v2::SubagentUpdate::new(session.to_string())
+                    .title(title.to_string())
+                    .capabilities(
+                        acp_v2::SubagentSessionCapabilities::new()
+                            .cancel(acp_v2::SessionCancelCapabilities::new()),
+                    ),
+                cx,
+            )
+        })
+        .expect("an agent-owned thread takes an association");
+    parent.update(cx, |parent, cx| parent.register_subagent(child.clone(), cx));
+    cx.run_until_parked();
+    child
+}
+
+pub(crate) fn report(
+    child: &Entity<AcpThread>,
+    state: acp_v2::StateUpdate,
+    cx: &mut VisualTestContext,
+) {
+    child
+        .update(cx, |child, cx| child.update_session_state(state, cx))
+        .expect("an agent-owned thread reports its state");
+    cx.run_until_parked();
+}
+
+pub(crate) fn report_running(child: &Entity<AcpThread>, cx: &mut VisualTestContext) {
+    report(
+        child,
+        acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+        cx,
+    );
+}
+
+pub(crate) fn report_done(child: &Entity<AcpThread>, cx: &mut VisualTestContext) {
+    report(
+        child,
+        acp_v2::StateUpdate::Idle(
+            acp_v2::IdleStateUpdate::new().stop_reason(acp_v2::StopReason::EndTurn),
+        ),
+        cx,
+    );
+}
+
+/// The parent's first outgoing session message to `child`: the place its card is drawn.
+pub(crate) fn announce_to(
+    parent: &Entity<AcpThread>,
+    child: &str,
+    cx: &mut VisualTestContext,
+) -> usize {
+    let parent_session = session_of(parent, cx);
+    parent
+        .update(cx, |parent, cx| {
+            parent.upsert_session_message(
+                acp_v2::SessionMessage::new(format!("launch-{child}"))
+                    .sender_session_id(parent_session)
+                    .recipient_session_id(acp_v2::SessionId::new(child.to_string()))
+                    .content(vec!["Look into it".into()]),
+                cx,
+            )
+        })
+        .expect("an outgoing session message applies");
+    cx.run_until_parked();
+    parent.read_with(cx, |parent, _| parent.entries().len() - 1)
+}
+
+/// Forty question/answer entries, so a scroll to an earlier entry is not clamped to the end.
+pub(crate) fn pad(parent: &Entity<AcpThread>, from: usize, cx: &mut VisualTestContext) {
+    parent.update(cx, |thread, cx| {
+        for i in from..from + 20 {
+            thread
+                .handle_session_update(
+                    acp::SessionUpdate::UserMessageChunk(acp::ContentChunk::new(
+                        format!("question {i}").into(),
+                    )),
+                    cx,
+                )
+                .expect("entry applies");
+            thread
+                .handle_session_update(
+                    acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(
+                        format!("answer {i}").into(),
+                    )),
+                    cx,
+                )
+                .expect("entry applies");
+        }
+    });
+    cx.run_until_parked();
+}
+
+/// The session the conversation shows: a child after navigation, else the root.
+pub(crate) fn conversation_shows(
+    agent_panel: &Entity<AgentPanel>,
+    cx: &VisualTestContext,
+) -> Option<acp_v2::SessionId> {
+    agent_panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .and_then(|view| view.read(cx).active_thread().cloned())
+            .map(|thread_view| thread_view.read(cx).session_id.clone())
+    })
+}
+
+/// A decoy: a metadata row under the CHILD's session id, in a folder no window holds. A panel
+/// that looked the child up in the thread metadata store would route there.
+pub(crate) fn save_decoy_metadata_for(child: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id: ThreadId::new(),
+                    session_id: Some(acp_v2::SessionId::new(child.to_string())),
+                    agent_id: "stub".into(),
+                    title: Some("Decoy under the child's id".into()),
+                    title_override: None,
+                    updated_at: Default::default(),
+                    created_at: None,
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(&PathList::new(&[
+                        Path::new("/elsewhere/decoy"),
+                    ])),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// A subagent record written by an earlier Zeo session: ended, keyed by `parent`, origin
+/// `acp_subagent`, its child in step 7's `child_session_id`. The child is not registered anywhere
+/// in this session. Double quotes: `'…'` inside `sql!` is a Rust char literal (step 5's note);
+/// this is a runtime string, and SQLite reads either form.
+pub(crate) async fn seed_recorded_subagent(
+    db: &AgentTaskHistoryDb,
+    parent: &acp_v2::SessionId,
+    child: &str,
+) {
+    let sql = format!(
+        "INSERT INTO agent_task_history(session_id, task_id, thread_title, project, kind, \
+         description, background, status, started_at, ended_at, origin, child_session_id) \
+         VALUES ('{parent}', 'acp-subagent:{child}', 'Parent', 'project', 'subagent', \
+         'Recorded child', 1, 'completed', 1000, 2000, 'acp_subagent', '{child}');"
+    );
+    run_sql(db, Box::leak(sql.into_boxed_str())).await;
+}
