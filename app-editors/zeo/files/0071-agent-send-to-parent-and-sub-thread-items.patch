+//! One task row per subagent, whichever source names it (story 064, R3). The registry is the
+//! authority on a child's status; the `_claude/tasks` feed only enriches the child it names.
+
+use std::time::SystemTime;
+
+use acp_thread::subagent_rows::{SubagentRow, SubagentRowStatus};
+use acp_thread::{AgentTask, AgentTaskStatus};
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::SharedString;
+
+use super::{TaskRow, TaskRowStatus, TaskSource};
+
+/// The prefix of a native row's task id, which is also its history `task_id`. The prefix
+/// only keeps the id apart from feed ids; the row's origin is read from `source`, never
+/// from the id.
+pub const SUBAGENT_TASK_ID_PREFIX: &str = "acp-subagent:";
+
+pub fn subagent_task_id(child: &acp_v2::SessionId) -> SharedString {
+    format!("{SUBAGENT_TASK_ID_PREFIX}{child}").into()
+}
+
+/// The card-only fields (watched, expanded, error, running_what) are left empty; the card
+/// fills them by row identity after the merge.
+pub fn merge(subagents: &[SubagentRow], feed: &[AgentTask]) -> Vec<TaskRow> {
+    let mut rows: Vec<TaskRow> = subagents.iter().map(native_row).collect();
+    for task in feed {
+        // Folding by title would collapse two children that share one (R3.3).
+        let named = task.child_session_id.as_ref().and_then(|child| {
+            rows.iter_mut().find(|row| {
+                matches!(&row.source, TaskSource::AcpSubagent { child: own, .. } if own == child)
+            })
+        });
+        match named {
+            Some(row) => enrich(&mut row.task, task),
+            None => {
+                if let Some(child) = &task.child_session_id {
+                    log::debug!(
+                        "tasks feed entry {} names subagent {child}, which is not registered",
+                        task.id
+                    );
+                }
+                rows.push(feed_row(task));
+            }
+        }
+    }
+    rows
+}
+
+fn native_row(row: &SubagentRow) -> TaskRow {
+    let status = TaskRowStatus::from(row.status);
+    let started_at = row.started_at.unwrap_or(SystemTime::UNIX_EPOCH);
+    TaskRow {
+        task: AgentTask {
+            id: subagent_task_id(&row.child_session_id),
+            tool_call_id: None,
+            kind: "subagent".into(),
+            description: row.label.clone(),
+            background: true,
+            depth: 0,
+            status: status.to_task_status(),
+            started_at,
+            ended_at: None,
+            usage: None,
+            last_tool: None,
+            summary: None,
+            has_output: false,
+            tail: None,
+            child_session_id: Some(row.child_session_id.clone()),
+        },
+        source: TaskSource::AcpSubagent {
+            child: row.child_session_id.clone(),
+            can_cancel: row.can_cancel,
+        },
+        status,
+        watched: false,
+        expanded: false,
+        running_what: row.label.clone(),
+        error: row.error.clone(),
+    }
+}
+
+/// Usage, last tool and summary come from the feed; status and label stay the registry's
+/// (R3.4).
+fn enrich(native: &mut AgentTask, feed: &AgentTask) {
+    native.tool_call_id = native
+        .tool_call_id
+        .take()
+        .or_else(|| feed.tool_call_id.clone());
+    native.usage = feed.usage.clone().or(native.usage.take());
+    native.last_tool = feed.last_tool.clone().or(native.last_tool.take());
+    native.summary = feed.summary.clone().or(native.summary.take());
+    native.has_output |= feed.has_output;
+    native.tail = feed.tail.clone().or(native.tail.take());
+    native.ended_at = feed.ended_at.or(native.ended_at);
+}
+
+fn feed_row(task: &AgentTask) -> TaskRow {
+    TaskRow {
+        status: TaskRowStatus::from(task.status),
+        source: TaskSource::ClaudeTasks,
+        watched: false,
+        expanded: false,
+        running_what: task.description.clone(),
+        error: None,
+        task: task.clone(),
+    }
+}
+
+impl From<SubagentRowStatus> for TaskRowStatus {
+    fn from(status: SubagentRowStatus) -> Self {
+        match status {
+            SubagentRowStatus::Running => Self::Running,
+            SubagentRowStatus::Waiting => Self::Waiting,
+            SubagentRowStatus::Done => Self::Done,
+            SubagentRowStatus::Failed => Self::Failed,
+            SubagentRowStatus::Canceled => Self::Canceled,
+            SubagentRowStatus::Unknown => Self::Unknown,
+        }
+    }
+}
+
+impl From<AgentTaskStatus> for TaskRowStatus {
+    fn from(status: AgentTaskStatus) -> Self {
+        match status {
+            AgentTaskStatus::Running => Self::Running,
+            AgentTaskStatus::Completed => Self::Done,
+            AgentTaskStatus::Failed => Self::Failed,
+            AgentTaskStatus::Stopped => Self::Canceled,
+            // Its outcome is not known, as R1.7 treats a replayed child.
+            AgentTaskStatus::Interrupted => Self::Unknown,
+        }
+    }
+}
+
+impl TaskRowStatus {
+    pub fn is_active(self) -> bool {
+        matches!(self, Self::Running | Self::Waiting)
+    }
+
+    pub fn is_terminal(self) -> bool {
+        matches!(self, Self::Done | Self::Failed | Self::Canceled)
+    }
+
+    /// The status the card's older paths (expiry, history, tray) read off `AgentTask`.
+    pub fn to_task_status(self) -> AgentTaskStatus {
+        match self {
+            Self::Running | Self::Waiting => AgentTaskStatus::Running,
+            Self::Done => AgentTaskStatus::Completed,
+            Self::Failed => AgentTaskStatus::Failed,
+            Self::Canceled => AgentTaskStatus::Stopped,
+            Self::Unknown => AgentTaskStatus::Interrupted,
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "merge_tests.rs"]
+mod tests;
