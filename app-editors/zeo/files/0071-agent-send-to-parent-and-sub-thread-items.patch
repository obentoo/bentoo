index 0000000..effc0cd
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/sub_thread_row_tests.rs
@@ -0,0 +1,337 @@
+// Story 040, task 5.1 — sub-thread rows in the Agent Tasks panel (R7.1–R7.5, R7.7; Q11, Q12).
+// Module path: `panel::sub_thread_row_tests` (the production row lives in
+// `panel/sub_thread_row.rs`, so the test module takes another name). Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/sub_thread_row_tests.rs"]
+//     mod sub_thread_row_tests;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- panel` (names carry `panel_sub_thread`).
+//
+// Contract (design.md §AgentTasksPanel rows):
+//   - a `TaskOrigin::SubThread` entry is listed in its parent's group (`PanelGroup::session_id` =
+//     the parent's session) with the chip "Sub-thread" and the state Running when
+//     `entry.record.status == Running`, else Idle (design.md 2026-10-20); no Stop,
+//     no Open Log, no Expand (`PanelRow::can_stop` and `can_open_log` false);
+//   - filters: Active = running sub-threads too; Finished = sub-threads not running; Failed never
+//     holds one; the text filter matches the description (the title);
+//   - activation strips `zeo-sub-thread:` and opens THAT session through `open_agent_session`;
+//     with no metadata row for it the row says "Thread no longer exists".
+// Assumed beyond design.md — the debug selectors, kept in `CHIP` and `STATE` below so a rename is
+// one edit: `agent-tasks-sub-thread-chip-{task_id}` on the chip, and
+// `agent-tasks-sub-thread-state-{running|idle}-{task_id}` on the state label.
+// The store is fed as story 014's panel tests feed it: events on the agent panel's real card.
+//
+// Hostile halves first:
+//   - activation must open the SUB-thread, never the parent whose session keys the row; a
+//     sub-thread whose own thread is gone says so even though its parent exists (the shipped
+//     `open_task` checks the key's session — the parent's — and would open it);
+//   - a running sub-thread is not Finished and an idle one is not Active; neither is Failed;
+//   - the derived id `zeo-sub-thread:…` is not text the filter matches; the title is;
+//   - an adapter row keeps Stop and has no chip.
+
+use acp_thread::AgentTaskStatus;
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_ui::{SubThreadActivity, SubThreadRecord, TasksCard};
+use gpui::{Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, TaskFilter};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn chip_selector(task_id: &str) -> String {
+    format!("agent-tasks-sub-thread-chip-{task_id}")
+}
+
+fn state_selector(state: &str, task_id: &str) -> String {
+    format!("agent-tasks-sub-thread-state-{state}-{task_id}")
+}
+
+fn sub_record(parent: &acp_v2::SessionId, sub: &str, title: &str) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: parent.clone(),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms: 1_000,
+    }
+}
+
+fn card_of(panels: &Panels) -> Entity<TasksCard> {
+    panels
+        .agent_panel
+        .read_with(&panels.cx, |panel, _| panel.tasks_card().clone())
+}
+
+fn emit_sub(panels: &mut Panels, activity: SubThreadActivity) {
+    let card = card_of(panels);
+    card.update(&mut panels.cx, |_, cx| cx.emit(activity));
+    panels.cx.run_until_parked();
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_tasks_panel(panels: &mut Panels) {
+    let workspace = panels.workspace.clone();
+    workspace.update_in(&mut panels.cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(&mut panels.cx);
+}
+
+fn painted(panels: &mut Panels, selector: String) -> bool {
+    let selector: &'static str = Box::leak(selector.into_boxed_str());
+    panels.cx.debug_bounds(selector).is_some()
+}
+
+fn only_filter(panels: &mut Panels, only: TaskFilter) {
+    let panel = panels.tasks_panel.clone();
+    panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, filter == only, cx);
+        }
+    });
+    panels.cx.run_until_parked();
+}
+
+fn sub_task(sub: &str) -> String {
+    format!("{PREFIX}{sub}")
+}
+
+// ── Activation (R7.2, R7.3) ────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_activation_opens_the_sub_thread_not_the_parent(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let child = open_live_thread(&mut panels, "Child");
+    let child_session = session_of(&child, &panels.cx);
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    assert_eq!(
+        active_session(&panels),
+        Some(parent_session.clone()),
+        "precondition"
+    );
+
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(
+            &parent_session,
+            &child_session.to_string(),
+            "Child",
+        )),
+    );
+    let item = key(
+        &parent_session.to_string(),
+        &sub_task(&child_session.to_string()),
+    );
+    let tasks_panel = panels.tasks_panel.clone();
+    open_from(&tasks_panel, &item, &mut panels.cx);
+
+    assert_eq!(
+        active_session(&panels),
+        Some(child_session.clone()),
+        "the sub-thread is shown, not its parent"
+    );
+    let notice = notice_of(
+        &tasks_panel,
+        &parent_session,
+        &sub_task(&child_session.to_string()),
+        &mut panels.cx,
+    );
+    assert!(
+        notice.as_deref() != Some("Thread no longer exists"),
+        "the sub-thread exists: {notice:?}"
+    );
+}
+
+#[gpui::test]
+async fn panel_sub_thread_gone_says_so_even_though_its_parent_exists(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    // A sub-thread no metadata row knows: deleted since it was recorded.
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent_session, "sub-gone", "Gone")),
+    );
+    let tasks_panel = panels.tasks_panel.clone();
+    let item = key(&parent_session.to_string(), &sub_task("sub-gone"));
+    let windows = window_count(&mut panels.cx);
+
+    open_from(&tasks_panel, &item, &mut panels.cx);
+
+    assert_eq!(
+        notice_of(
+            &tasks_panel,
+            &parent_session,
+            &sub_task("sub-gone"),
+            &mut panels.cx
+        )
+        .as_deref(),
+        Some("Thread no longer exists")
+    );
+    assert_eq!(
+        active_session(&panels),
+        Some(parent_session),
+        "nothing else is opened in its place"
+    );
+    assert_eq!(window_count(&mut panels.cx), windows, "no window is opened");
+}
+
+// ── Filters (R7.4) ─────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_running_is_active_only_and_idle_is_finished_only(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = sid("p1");
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent, "sub-run", "Runner")),
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Running(sub_record(&parent, "sub-run", "Runner")),
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent, "sub-idle", "Sleeper")),
+    );
+    let running = ("p1".to_string(), sub_task("sub-run"));
+    let idle = ("p1".to_string(), sub_task("sub-idle"));
+
+    only_filter(&mut panels, TaskFilter::Finished);
+    let finished = visible_keys(&mut panels);
+    assert!(
+        !finished.contains(&running),
+        "a running sub-thread is not Finished"
+    );
+    assert!(finished.contains(&idle), "an idle sub-thread is Finished");
+
+    only_filter(&mut panels, TaskFilter::Active);
+    let active = visible_keys(&mut panels);
+    assert!(!active.contains(&idle), "an idle sub-thread is not Active");
+    assert!(active.contains(&running), "a running sub-thread is Active");
+
+    only_filter(&mut panels, TaskFilter::Failed);
+    let failed = visible_keys(&mut panels);
+    assert!(
+        !failed.contains(&running) && !failed.contains(&idle),
+        "Failed never holds a sub-thread"
+    );
+}
+
+// ── Text filter (R7.5) ─────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_text_filter_matches_the_title_not_the_derived_id(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = sid("p1");
+    emit_sub(
+        &mut panels,
