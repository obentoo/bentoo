--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_reporter.rs
@@ -0,0 +1,389 @@
+//! Story 040 — the tasks card reports sub-threads as task activity (design.md,
+//! SubThreadReporter).
+//!
+//! The reporter lives inside the card because the card is what
+//! `TaskHistoryStore::register_card` already subscribes to in every window: one more event type
+//! on it reaches the history with no new registration.
+
+use std::time::SystemTime;
+
+use acp_thread::{AcpThread, ThreadStatus};
+use agent_client_protocol::v2::schema as acp_v2;
+use collections::{HashMap, HashSet};
+use gpui::{App, Context, Entity, EventEmitter, SharedString, Subscription, Task};
+
+use crate::TasksCard;
+use crate::tasks_card::unix_ms;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::ThreadOrganizationStore;
+
+#[derive(Clone, Debug)]
+pub enum SubThreadActivity {
+    Linked(SubThreadRecord),
+    Running(SubThreadRecord),
+    Idle(SubThreadRecord),
+    Retitled(SubThreadRecord),
+}
+
+#[derive(Clone, Debug)]
+pub struct SubThreadRecord {
+    pub parent_session: acp_v2::SessionId,
+    pub sub_session: acp_v2::SessionId,
+    pub title: SharedString,
+    pub project: SharedString,
+    pub at_ms: i64,
+}
+
+impl EventEmitter<SubThreadActivity> for TasksCard {}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum SubThreadState {
+    Running,
+    Idle,
+}
+
+/// The card's memory of what it already told about sub-threads, so that a store that notifies
+/// many times, or a thread held through two views, is still one event per change (R5.2).
+pub(crate) struct SubThreadReporter {
+    /// Each reported sub-thread with the parent it was reported under.
+    reported_links: HashMap<ThreadId, ThreadId>,
+    /// Links already logged as unresolvable, so a dangling link is logged once, not per notify.
+    unresolved_links: HashSet<ThreadId>,
+    last_state: HashMap<acp_v2::SessionId, SubThreadState>,
+    last_title: HashMap<acp_v2::SessionId, SharedString>,
+    _organization_observation: Option<Subscription>,
+    _first_report: Option<Task<()>>,
+}
+
+impl SubThreadReporter {
+    /// Without an organization store there are no links, and so nothing to report, ever.
+    pub(crate) fn new(cx: &mut Context<TasksCard>) -> Self {
+        let Some(organization) = ThreadOrganizationStore::try_global(cx) else {
+            return Self::inert();
+        };
+        let observation = cx.observe(&organization, |card, _, cx| {
+            card.report_sub_thread_links(cx)
+        });
+        // Spawned rather than deferred: a deferred effect runs when the update that created the
+        // card ends, before `register_card` can have subscribed, and the links older than the card
+        // would reach nobody.
+        let first_report = cx.spawn(async move |card, cx| {
+            // A card dropped before this ran has nobody left to tell.
+            card.update(cx, |card, cx| card.report_sub_thread_links(cx))
+                .ok();
+        });
+        Self {
+            _organization_observation: Some(observation),
+            _first_report: Some(first_report),
+            ..Self::inert()
+        }
+    }
+
+    fn inert() -> Self {
+        Self {
+            reported_links: HashMap::default(),
+            unresolved_links: HashSet::default(),
+            last_state: HashMap::default(),
+            last_title: HashMap::default(),
+            _organization_observation: None,
+            _first_report: None,
+        }
+    }
+
+    /// The links the store holds that were not reported yet, each as `Linked`, in the store's
+    /// order. A link that went away is forgotten, so linking that thread again reports again.
+    fn take_new_links(&mut self, cx: &App) -> Vec<SubThreadActivity> {
+        let Some(organization) = ThreadOrganizationStore::try_global(cx) else {
+            return Vec::new();
+        };
+        let organization = organization.read(cx);
+        let links: Vec<(ThreadId, ThreadId)> = organization
+            .sub_threads()
+            .into_iter()
+            .filter_map(|child| Some((child, organization.parent(child)?.0)))
+            .collect();
+        let current: HashMap<ThreadId, ThreadId> = links.iter().copied().collect();
+        self.reported_links
+            .retain(|child, parent| current.get(child) == Some(parent));
+        self.unresolved_links
+            .retain(|child| current.contains_key(child));
+
+        let mut activity = Vec::new();
+        for (child, parent) in links {
+            if self.reported_links.contains_key(&child) {
+                continue;
+            }
+            match resolve_link(child, parent, cx) {
+                Some(record) => {
+                    self.reported_links.insert(child, parent);
+                    self.unresolved_links.remove(&child);
+                    activity.push(SubThreadActivity::Linked(record));
+                }
+                None => {
+                    if self.unresolved_links.insert(child) {
+                        log::debug!(
+                            "zeo_sub_thread event=link_skipped child_thread={} parent_thread={} \
+                             reason=no_session",
+                            child.to_key_string(),
+                            parent.to_key_string()
+                        );
+                    }
+                }
+            }
+        }
+        activity
+    }
+}
+
+impl TasksCard {
+    /// Called on every notify of the organization store, and once after creation.
+    pub(crate) fn report_sub_thread_links(&mut self, cx: &mut Context<Self>) {
+        for activity in self.sub_thread_reporter.take_new_links(cx) {
+            let record = match &activity {
+                SubThreadActivity::Linked(record) => Some(record.clone()),
+                _ => None,
+            };
+            self.emit_sub_thread_activity(activity, cx);
+            // 039 records a clean sub-thread's link deferred, after its first turn has already
+            // sent `StatusChanged`; without this, that turn would never be reported Running.
+            if let Some(record) = record {
+                self.report_running_if_generating(record, cx);
+            }
+        }
+    }
+
+    /// Every link the organization store holds, as `Linked`, then `Running` for each held
+    /// sub-thread mid-turn. `TaskHistoryStore::register_card` subscribes after the card exists,
+    /// often long after its first report ran, so it calls this right after subscribing; the
+    /// history's link upsert is idempotent, so hearing a link twice changes nothing.
+    pub fn replay_sub_thread_activity(&mut self, cx: &mut Context<Self>) {
+        let Some(organization) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let links: Vec<(ThreadId, ThreadId)> = {
+            let organization = organization.read(cx);
+            organization
+                .sub_threads()
+                .into_iter()
+                .filter_map(|child| Some((child, organization.parent(child)?.0)))
+                .collect()
+        };
+        for (child, parent) in links {
+            let Some(record) = resolve_link(child, parent, cx) else {
+                continue;
+            };
+            let reporter = &mut self.sub_thread_reporter;
+            reporter.reported_links.insert(child, parent);
+            reporter.unresolved_links.remove(&child);
+            self.emit_sub_thread_activity(SubThreadActivity::Linked(record.clone()), cx);
+            if let Some(thread) = self.held_thread(&record.sub_session)
+                && thread.read(cx).status() == ThreadStatus::Generating
+            {
+                self.sub_thread_reporter
+                    .last_state
+                    .insert(record.sub_session.clone(), SubThreadState::Running);
+                self.emit_sub_thread_activity(SubThreadActivity::Running(record), cx);
+            }
+        }
+    }
+
+    fn report_running_if_generating(&mut self, record: SubThreadRecord, cx: &mut Context<Self>) {
+        let Some(thread) = self.held_thread(&record.sub_session) else {
+            return;
+        };
+        if thread.read(cx).status() != ThreadStatus::Generating {
+            return;
+        }
+        let reporter = &mut self.sub_thread_reporter;
+        if reporter.last_state.get(&record.sub_session) == Some(&SubThreadState::Running) {
+            return;
+        }
+        reporter
+            .last_state
+            .insert(record.sub_session.clone(), SubThreadState::Running);
+        self.emit_sub_thread_activity(SubThreadActivity::Running(record), cx);
+    }
+
+    /// A sub-thread the card stopped holding mid-turn has stopped generating with it: report it
+    /// Idle, or the history would keep it running until the next startup sweep.
+    pub(crate) fn report_unheld_sub_threads_idle(
+        &mut self,
+        held: &HashSet<acp_v2::SessionId>,
+        cx: &mut Context<Self>,
+    ) {
+        let stopped: Vec<acp_v2::SessionId> = self
+            .sub_thread_reporter
+            .last_state
+            .iter()
+            .filter(|(session, state)| {
+                **state == SubThreadState::Running && !held.contains(*session)
+            })
+            .map(|(session, _)| session.clone())
+            .collect();
+        for session in stopped {
+            // Kept as Idle rather than forgotten, so the thread held again re-emits nothing.
+            self.sub_thread_reporter
+                .last_state
+                .insert(session.clone(), SubThreadState::Idle);
+            if let Some(record) = record_of_session(&session, cx) {
+                self.emit_sub_thread_activity(SubThreadActivity::Idle(record), cx);
+            }
+        }
+    }
+
+    /// `StatusChanged` of a held root thread: `Running` or `Idle` when it is a sub-thread, once
+    /// per change of state (R5.3, R5.9).
+    pub(crate) fn report_sub_thread_status(
+        &mut self,
+        thread: &Entity<AcpThread>,
+        cx: &mut Context<Self>,
+    ) {
+        let state = match thread.read(cx).status() {
+            ThreadStatus::Generating => SubThreadState::Running,
+            ThreadStatus::Idle => SubThreadState::Idle,
+            // Not yet known to be either; the confirmed status follows with its own event.
+            ThreadStatus::Unconfirmed => return,
+        };
+        let Some(record) = self.sub_thread_record_of(thread, cx) else {
+            return;
+        };
+        let reporter = &mut self.sub_thread_reporter;
+        if reporter.last_state.get(&record.sub_session) == Some(&state) {
+            return;
+        }
+        reporter
+            .last_state
+            .insert(record.sub_session.clone(), state);
+        self.emit_sub_thread_activity(
+            match state {
+                SubThreadState::Running => SubThreadActivity::Running(record),
+                SubThreadState::Idle => SubThreadActivity::Idle(record),
+            },
+            cx,
+        );
+    }
+
+    /// `TitleUpdated` of a held root thread: `Retitled` with the new title when it is a
+    /// sub-thread, once per distinct title (R5.5).
+    pub(crate) fn report_sub_thread_title(
+        &mut self,
+        thread: &Entity<AcpThread>,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(title) = thread.read(cx).title() else {
+            return;
+        };
+        let Some(mut record) = self.sub_thread_record_of(thread, cx) else {
+            return;
+        };
+        let reporter = &mut self.sub_thread_reporter;
+        if reporter.last_title.get(&record.sub_session) == Some(&title) {
+            return;
+        }
+        reporter
+            .last_title
+            .insert(record.sub_session.clone(), title.clone());
+        // The thread's own title, not the stored one: the metadata store may follow this same
+        // event after the card has heard it.
+        record.title = title;
+        self.emit_sub_thread_activity(SubThreadActivity::Retitled(record), cx);
+    }
+
+    /// The record of `thread` when it is a sub-thread whose link resolves. A link heard here
+    /// before the store's notify reached the card is reported first, so the history never gets a
+    /// status for an item it has not created.
+    fn sub_thread_record_of(
+        &mut self,
+        thread: &Entity<AcpThread>,
+        cx: &mut Context<Self>,
+    ) -> Option<SubThreadRecord> {
+        let organization = ThreadOrganizationStore::try_global(cx)?;
+        let session_id = thread.read(cx).session_id().clone();
+        let child = ThreadMetadataStore::try_global(cx)?
+            .read(cx)
+            .entry_by_session(&session_id)?
+            .thread_id;
+        let (parent, _) = organization.read(cx).parent(child)?;
+        let record = resolve_link(child, parent, cx)?;
+        let reporter = &mut self.sub_thread_reporter;
+        if reporter.reported_links.get(&child) != Some(&parent) {
+            reporter.reported_links.insert(child, parent);
+            reporter.unresolved_links.remove(&child);
+            self.emit_sub_thread_activity(SubThreadActivity::Linked(record.clone()), cx);
+        }
+        Some(record)
+    }
+}
+
+/// The record of a sub-thread known only by its session id, for a thread the card no longer
+/// holds.
+fn record_of_session(session: &acp_v2::SessionId, cx: &App) -> Option<SubThreadRecord> {
+    let child = ThreadMetadataStore::try_global(cx)?
+        .read(cx)
+        .entry_by_session(session)?
+        .thread_id;
+    let (parent, _) = ThreadOrganizationStore::try_global(cx)?
+        .read(cx)
+        .parent(child)?;
+    resolve_link(child, parent, cx)
+}
+
+/// Reads `ThreadMetadataStore`, so it must not run inside one of that store's updates; the
+/// card's callbacks run as effects, after any update has ended.
+fn resolve_link(child: ThreadId, parent: ThreadId, cx: &App) -> Option<SubThreadRecord> {
+    let metadata = ThreadMetadataStore::try_global(cx)?;
+    let metadata = metadata.read(cx);
+    let child = metadata.entry(child)?;
+    let sub_session = child.session_id.clone()?;
+    let parent_session = metadata.entry(parent)?.session_id.clone()?;
+    Some(SubThreadRecord {
+        parent_session,
+        sub_session,
+        title: child.display_title(),
+        project: project_of(child),
+        at_ms: unix_ms(SystemTime::now()),
+    })
+}
+
+/// The last component of the thread's first folder, as the card names a held thread's project.
+pub(crate) fn project_of(metadata: &ThreadMetadata) -> SharedString {
+    metadata
+        .folder_paths()
+        .paths()
+        .first()
+        .and_then(|path| path.file_name())
+        .map(|name| SharedString::from(name.to_string_lossy().into_owned()))
+        .unwrap_or_default()
+}
+
+impl TasksCard {
+    /// The card's own rows first, then everyone listening: one source for both (R6, R5).
+    fn emit_sub_thread_activity(&mut self, activity: SubThreadActivity, cx: &mut Context<Self>) {
+        self.note_sub_thread_activity(&activity, cx);
+        emit_activity(activity, cx);
+    }
+}
+
+fn emit_activity(activity: SubThreadActivity, cx: &mut Context<TasksCard>) {
+    let (event, record) = match &activity {
+        SubThreadActivity::Linked(record) => ("linked", record),
+        SubThreadActivity::Running(record) => ("running", record),
+        SubThreadActivity::Idle(record) => ("idle", record),
+        SubThreadActivity::Retitled(record) => ("retitled", record),
+    };
+    // Session ids only: a title is user text and stays out of the log (R8.1).
+    log::info!(
+        "zeo_sub_thread event={event} parent_session={} sub_session={}",
+        record.parent_session,
+        record.sub_session
+    );
+    cx.emit(activity);
+}
+
