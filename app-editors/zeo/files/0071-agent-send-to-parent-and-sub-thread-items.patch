--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/sub_thread_row_tests.rs
@@ -0,0 +1,337 @@
+// Story 040, task 5.1 — sub-thread rows in the Agent Tasks panel (R7.1–R7.5, R7.7; Q11, Q12).
+// Module path: `panel::sub_thread_row_tests` (the production row lives in
+// `panel/sub_thread_row.rs`, so the test module takes another name). Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/sub_thread_row_tests.rs"]
+//     mod sub_thread_row_tests;
+//
+// Validation filter: `cargo test -p agent_tasks_panel -- panel` (names carry `panel_sub_thread`).
+//
+// Contract (design.md §AgentTasksPanel rows):
+//   - a `TaskOrigin::SubThread` entry is listed in its parent's group (`PanelGroup::session_id` =
+//     the parent's session) with the chip "Sub-thread" and the state Running when
+//     `entry.record.status == Running`, else Idle (design.md 2026-10-20); no Stop,
+//     no Open Log, no Expand (`PanelRow::can_stop` and `can_open_log` false);
+//   - filters: Active = running sub-threads too; Finished = sub-threads not running; Failed never
+//     holds one; the text filter matches the description (the title);
+//   - activation strips `zeo-sub-thread:` and opens THAT session through `open_agent_session`;
+//     with no metadata row for it the row says "Thread no longer exists".
+// Assumed beyond design.md — the debug selectors, kept in `CHIP` and `STATE` below so a rename is
+// one edit: `agent-tasks-sub-thread-chip-{task_id}` on the chip, and
+// `agent-tasks-sub-thread-state-{running|idle}-{task_id}` on the state label.
+// The store is fed as story 014's panel tests feed it: events on the agent panel's real card.
+//
+// Hostile halves first:
+//   - activation must open the SUB-thread, never the parent whose session keys the row; a
+//     sub-thread whose own thread is gone says so even though its parent exists (the shipped
+//     `open_task` checks the key's session — the parent's — and would open it);
+//   - a running sub-thread is not Finished and an idle one is not Active; neither is Failed;
+//   - the derived id `zeo-sub-thread:…` is not text the filter matches; the title is;
+//   - an adapter row keeps Stop and has no chip.
+
+use acp_thread::AgentTaskStatus;
+use agent_client_protocol::v2::schema as acp_v2;
+use agent_ui::{SubThreadActivity, SubThreadRecord, TasksCard};
+use gpui::{Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTasksPanel, TaskFilter};
+
+const PREFIX: &str = "zeo-sub-thread:";
+
+fn chip_selector(task_id: &str) -> String {
+    format!("agent-tasks-sub-thread-chip-{task_id}")
+}
+
+fn state_selector(state: &str, task_id: &str) -> String {
+    format!("agent-tasks-sub-thread-state-{state}-{task_id}")
+}
+
+fn sub_record(parent: &acp_v2::SessionId, sub: &str, title: &str) -> SubThreadRecord {
+    SubThreadRecord {
+        parent_session: parent.clone(),
+        sub_session: sid(sub),
+        title: title.to_string().into(),
+        project: "project".into(),
+        at_ms: 1_000,
+    }
+}
+
+fn card_of(panels: &Panels) -> Entity<TasksCard> {
+    panels
+        .agent_panel
+        .read_with(&panels.cx, |panel, _| panel.tasks_card().clone())
+}
+
+fn emit_sub(panels: &mut Panels, activity: SubThreadActivity) {
+    let card = card_of(panels);
+    card.update(&mut panels.cx, |_, cx| cx.emit(activity));
+    panels.cx.run_until_parked();
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_tasks_panel(panels: &mut Panels) {
+    let workspace = panels.workspace.clone();
+    workspace.update_in(&mut panels.cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(&mut panels.cx);
+}
+
+fn painted(panels: &mut Panels, selector: String) -> bool {
+    let selector: &'static str = Box::leak(selector.into_boxed_str());
+    panels.cx.debug_bounds(selector).is_some()
+}
+
+fn only_filter(panels: &mut Panels, only: TaskFilter) {
+    let panel = panels.tasks_panel.clone();
+    panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, filter == only, cx);
+        }
+    });
+    panels.cx.run_until_parked();
+}
+
+fn sub_task(sub: &str) -> String {
+    format!("{PREFIX}{sub}")
+}
+
+// ── Activation (R7.2, R7.3) ────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_activation_opens_the_sub_thread_not_the_parent(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let child = open_live_thread(&mut panels, "Child");
+    let child_session = session_of(&child, &panels.cx);
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    assert_eq!(
+        active_session(&panels),
+        Some(parent_session.clone()),
+        "precondition"
+    );
+
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(
+            &parent_session,
+            &child_session.to_string(),
+            "Child",
+        )),
+    );
+    let item = key(
+        &parent_session.to_string(),
+        &sub_task(&child_session.to_string()),
+    );
+    let tasks_panel = panels.tasks_panel.clone();
+    open_from(&tasks_panel, &item, &mut panels.cx);
+
+    assert_eq!(
+        active_session(&panels),
+        Some(child_session.clone()),
+        "the sub-thread is shown, not its parent"
+    );
+    let notice = notice_of(
+        &tasks_panel,
+        &parent_session,
+        &sub_task(&child_session.to_string()),
+        &mut panels.cx,
+    );
+    assert!(
+        notice.as_deref() != Some("Thread no longer exists"),
+        "the sub-thread exists: {notice:?}"
+    );
+}
+
+#[gpui::test]
+async fn panel_sub_thread_gone_says_so_even_though_its_parent_exists(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    // A sub-thread no metadata row knows: deleted since it was recorded.
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent_session, "sub-gone", "Gone")),
+    );
+    let tasks_panel = panels.tasks_panel.clone();
+    let item = key(&parent_session.to_string(), &sub_task("sub-gone"));
+    let windows = window_count(&mut panels.cx);
+
+    open_from(&tasks_panel, &item, &mut panels.cx);
+
+    assert_eq!(
+        notice_of(
+            &tasks_panel,
+            &parent_session,
+            &sub_task("sub-gone"),
+            &mut panels.cx
+        )
+        .as_deref(),
+        Some("Thread no longer exists")
+    );
+    assert_eq!(
+        active_session(&panels),
+        Some(parent_session),
+        "nothing else is opened in its place"
+    );
+    assert_eq!(window_count(&mut panels.cx), windows, "no window is opened");
+}
+
+// ── Filters (R7.4) ─────────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_running_is_active_only_and_idle_is_finished_only(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = sid("p1");
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent, "sub-run", "Runner")),
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Running(sub_record(&parent, "sub-run", "Runner")),
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent, "sub-idle", "Sleeper")),
+    );
+    let running = ("p1".to_string(), sub_task("sub-run"));
+    let idle = ("p1".to_string(), sub_task("sub-idle"));
+
+    only_filter(&mut panels, TaskFilter::Finished);
+    let finished = visible_keys(&mut panels);
+    assert!(
+        !finished.contains(&running),
+        "a running sub-thread is not Finished"
+    );
+    assert!(finished.contains(&idle), "an idle sub-thread is Finished");
+
+    only_filter(&mut panels, TaskFilter::Active);
+    let active = visible_keys(&mut panels);
+    assert!(!active.contains(&idle), "an idle sub-thread is not Active");
+    assert!(active.contains(&running), "a running sub-thread is Active");
+
+    only_filter(&mut panels, TaskFilter::Failed);
+    let failed = visible_keys(&mut panels);
+    assert!(
+        !failed.contains(&running) && !failed.contains(&idle),
+        "Failed never holds a sub-thread"
+    );
+}
+
+// ── Text filter (R7.5) ─────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_text_filter_matches_the_title_not_the_derived_id(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = sid("p1");
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent, "sub-a", "Quokka research")),
+    );
+    let item = ("p1".to_string(), sub_task("sub-a"));
+    let tasks_panel = panels.tasks_panel.clone();
+
+    tasks_panel.update_in(&mut panels.cx, |panel, window, cx| {
+        panel.set_filter_query("zeo-sub-thread", window, cx)
+    });
+    panels.cx.run_until_parked();
+    assert!(
+        !visible_keys(&mut panels).contains(&item),
+        "the derived id is not text the row shows"
+    );
+
+    tasks_panel.update_in(&mut panels.cx, |panel, window, cx| {
+        panel.set_filter_query("quokka", window, cx)
+    });
+    panels.cx.run_until_parked();
+    assert!(
+        visible_keys(&mut panels).contains(&item),
+        "the title matches"
+    );
+}
+
+// ── Row shape (R7.1, R7.7) ─────────────────────────────────────────────────
+
+#[gpui::test]
+async fn panel_sub_thread_row_has_its_chip_and_no_stop_or_log_beside_an_adapter_row(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let parent = open_live_thread(&mut panels, "Parent");
+    let parent_session = session_of(&parent, &panels.cx);
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Linked(sub_record(&parent_session, "sub-a", "Alpha")),
+    );
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Running(sub_record(&parent_session, "sub-a", "Alpha")),
+    );
+    show_tasks_panel(&mut panels);
+
+    let groups = groups(&mut panels);
+    let group = groups
+        .iter()
+        .find(|group| group.session_id == parent_session)
+        .expect("the parent's group is listed");
+    let sub_row = group
+        .rows
+        .iter()
+        .find(|row| row.entry.record.task_id.as_ref() == sub_task("sub-a"))
+        .expect("the sub-thread is listed in its parent's group");
+    assert!(!sub_row.can_stop, "no Stop on a sub-thread row");
+    assert!(!sub_row.can_open_log, "no Open Log on a sub-thread row");
+    let adapter_row = group
+        .rows
+        .iter()
+        .find(|row| row.entry.record.task_id.as_ref() == "t1")
+        .expect("the adapter task is listed");
+    assert!(adapter_row.can_stop, "the adapter row keeps Stop");
+
+    assert!(
+        !painted(&mut panels, chip_selector("t1")),
+        "an adapter row has no Sub-thread chip"
+    );
+    assert!(
+        painted(&mut panels, chip_selector(&sub_task("sub-a"))),
+        "the chip is drawn"
+    );
+    assert!(
+        painted(&mut panels, state_selector("running", &sub_task("sub-a"))),
+        "a running sub-thread reads Running"
+    );
+
+    emit_sub(
+        &mut panels,
+        SubThreadActivity::Idle(sub_record(&parent_session, "sub-a", "Alpha")),
+    );
+    draw(&mut panels.cx);
+    assert!(
+        painted(&mut panels, state_selector("idle", &sub_task("sub-a"))),
+        "a stopped sub-thread reads Idle"
+    );
+    let row = find_row(&mut panels, &parent_session.to_string(), &sub_task("sub-a"))
+        .expect("still listed once idle");
+    assert_ne!(row.entry.record.status, AgentTaskStatus::Running);
+}
diff --git a/crates/agent_tasks_panel/src/panel/waiting_label_tests.rs b/crates/agent_tasks_panel/src/panel/waiting_label_tests.rs
new file mode 100644
index 0000000..d7ccc7e
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/waiting_label_tests.rs
@@ -0,0 +1,276 @@
+// Story 064, task 11.1 — the Agent Tasks panel's row for a subagent that needs the operator reads
+// "Waiting for you", never "Running"; a running one keeps "Running"; nothing new is persisted
+// (R1.8). Fixup of `0071`. Module path: `panel::waiting_label`; wired in `src/panel.rs` beside
+// `mod native_subagent;`:
+//
+//     #[cfg(test)]
+//     #[path = "panel/waiting_label_tests.rs"]
+//     mod waiting_label;
+//
+// Validation filter: `cargo test -p agent_tasks_panel panel`. Fixtures: `native_subagent_support.rs`.
+//
+// Contract (design.md, "Waiting text (R1.8)"): the row's status text is `row_detail(&TaskRecord)`,
+// the panel's own (private, reached as `super::row_detail`), which `render_row` paints for every
+// row that is neither a sub-thread nor carrying a notice; the Waiting state reaches it as a
+// live-only flag on the `TaskRecord` the card hands over, laid over the stored record by
+// `panel_row`. `record.status` stays `AgentTaskStatus::Running`, in the row, in the store and in
+// the history db, and `agent_task_history` gains no column. If the flag lands elsewhere, adjust
+// `detail` below only.
+//
+// Hostile halves first:
+//   - Waiting must NOT collapse into Running: the waiting child's row text is not "Running";
+//   - Running must NOT split into Waiting: a running sibling and a feed task of the same parent
+//     keep "Running";
+//   - Waiting must NOT be persisted: the stored record and the db say Running (or nothing) while
+//     the child waits, the db's columns are the ones it had before, and no stored status reads
+//     "waiting" — also after the child ends;
+//   - then the benign half: the child runs again and its row reads Running.
+
+use acp_thread::AgentTaskStatus;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{Entity, TestAppContext};
+
+use crate::native_subagent_support::*;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, TaskHistoryStore};
+
+/// The status text R1.8 names, byte for byte.
+const WAITING: &str = "Waiting for you";
+
+fn detail(row: &super::PanelRow) -> String {
+    super::row_detail(&row.entry.record)
+}
+
+fn report_waiting(child: &Entity<acp_thread::AcpThread>, panels: &mut Panels) {
+    report(
+        child,
+        acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new()),
+        &mut panels.cx,
+    );
+}
+
+fn row(panels: &mut Panels, parent: &acp_v2::SessionId, task: &str) -> super::PanelRow {
+    find_row(panels, &parent.to_string(), task)
+        .unwrap_or_else(|| panic!("{task} is a row of the parent's group"))
+}
+
+async fn columns(db: &AgentTaskHistoryDb) -> Vec<String> {
+    db.write(|connection| {
+        connection
+            .select::<String>("SELECT name FROM pragma_table_info('agent_task_history')")
+            .expect("select")()
+        .expect("run")
+    })
+    .await
+}
+
+async fn stored_statuses(db: &AgentTaskHistoryDb) -> Vec<(String, String)> {
+    db.write(|connection| {
+        connection
+            .select::<(String, String)>("SELECT task_id, status FROM agent_task_history")
+            .expect("select")()
+        .expect("run")
+    })
+    .await
+}
+
+/// The record the store holds for `key`, without the card's live values laid over it.
+fn store_status(panels: &mut Panels, parent: &acp_v2::SessionId, task: &str) -> AgentTaskStatus {
+    panels.cx.update(|_, cx| {
+        let store = TaskHistoryStore::try_global(cx).expect("the crate's init made the store");
+        store
+            .read(cx)
+            .records()
+            .iter()
+            .find(|entry| {
+                entry.record.session_id == *parent && entry.record.task_id.as_ref() == task
+            })
+            .map(|entry| entry.record.status)
+            .unwrap_or_else(|| panic!("the store holds {task}"))
+    })
+}
+
+fn assert_reads_waiting(text: &str, what: &str) {
+    assert!(
+        text.starts_with(WAITING),
+        "{what}: a waiting row reads {WAITING:?}, it read {text:?}"
+    );
+    assert!(
+        !text.contains("Running"),
+        "{what}: a waiting row never reads \"Running\": {text:?}"
+    );
+}
+
+// ── R1.8 — Waiting is not Running ───────────────────────────────────────────
+
+/// Hostile: Alpha waits for the operator, Bravo runs. Alpha's row reads "Waiting for you";
+/// Bravo's keeps "Running". Today both read "Running".
+#[gpui::test]
+async fn panel_waiting_label_child_in_requires_action_reads_waiting_for_you(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    let bravo = spawn_child(&parent, &connection, "bravo", "Bravo", &mut panels.cx);
+    report_waiting(&alpha, &mut panels);
+    report_running(&bravo, &mut panels.cx);
+
+    let alpha_row = row(&mut panels, &parent_session, "acp-subagent:alpha");
+    let bravo_row = row(&mut panels, &parent_session, "acp-subagent:bravo");
+    assert!(
+        detail(&bravo_row).starts_with("Running") && !detail(&bravo_row).contains(WAITING),
+        "a running sibling keeps \"Running\": {:?}",
+        detail(&bravo_row)
+    );
+    // The waiting row is still a live row: Stop reaches it, Archive does not.
+    assert_eq!(
+        alpha_row.entry.record.status,
+        AgentTaskStatus::Running,
+        "the row's status stays Running; only its text changes"
+    );
+    assert!(alpha_row.can_stop, "a waiting child can still be stopped");
+    assert!(!alpha_row.can_archive, "a waiting child is not archivable");
+    assert_reads_waiting(&detail(&alpha_row), "Alpha");
+}
+
+/// Hostile converse, third element: a feed task of the same parent has no Waiting state and
+/// keeps "Running" beside a waiting child.
+#[gpui::test]
+async fn panel_waiting_label_feed_task_beside_a_waiting_child_reads_running(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    report_waiting(&alpha, &mut panels);
+    send_tasks(
+        &parent,
+        vec![wire_task("t1", "running", 1_000, Some((500, 4)))],
+        &mut panels.cx,
+    );
+
+    let feed = row(&mut panels, &parent_session, "t1");
+    assert_eq!(
+        detail(&feed),
+        "Running · 500 tokens · 4 tool uses",
+        "a feed task reads as it always has"
+    );
+    assert_reads_waiting(
+        &detail(&row(&mut panels, &parent_session, "acp-subagent:alpha")),
+        "Alpha",
+    );
+}
+
+// ── R1.8 — nothing new is persisted ─────────────────────────────────────────
+
+/// Hostile: Waiting is live-only. While Alpha waits, the store's record says Running and the db
+/// holds no "waiting"; when Alpha ends, the db row says completed; the table's columns never
+/// change.
+#[gpui::test]
+async fn panel_waiting_label_is_never_persisted(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let columns_before = columns(&db).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    report_waiting(&alpha, &mut panels);
+
+    // Read now, asserted last: the persistence checks below hold today and must keep holding.
+    let waiting_text = detail(&row(&mut panels, &parent_session, "acp-subagent:alpha"));
+    assert_eq!(
+        store_status(&mut panels, &parent_session, "acp-subagent:alpha"),
+        AgentTaskStatus::Running,
+        "the store's record stays Running while the child waits"
+    );
+    let while_waiting = stored_statuses(&db).await;
+    assert!(
+        while_waiting
+            .iter()
+            .filter(|(task, _)| task == "acp-subagent:alpha")
+            .all(|(_, status)| status == "running"),
+        "a waiting child is stored as running, if at all: {while_waiting:?}"
+    );
+    assert_eq!(
+        columns(&db).await,
+        columns_before,
+        "agent_task_history gains no column"
+    );
+
+    report_done(&alpha, &mut panels.cx);
+
+    let after = stored_statuses(&db).await;
+    assert!(
+        after
+            .iter()
+            .any(|(task, status)| task == "acp-subagent:alpha" && status == "completed"),
+        "the ended child is recorded as completed: {after:?}"
+    );
+    assert!(
+        after
+            .iter()
+            .all(|(_, status)| !status.to_lowercase().contains("wait")),
+        "no stored status reads waiting: {after:?}"
+    );
+    assert_eq!(columns(&db).await, columns_before, "still no new column");
+    assert_eq!(
+        detail(&row(&mut panels, &parent_session, "acp-subagent:alpha")),
+        "Completed",
+        "the ended row reads its outcome"
+    );
+    assert_reads_waiting(&waiting_text, "Alpha, while it waited");
+}
+
+// ── Benign — Waiting does not stick ─────────────────────────────────────────
+
+/// The operator answers and the child runs again: its row reads "Running" once more.
+#[gpui::test]
+async fn panel_waiting_label_child_running_again_reads_running(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = rfd_connection();
+    let parent = open_thread_on(
+        &panels.agent_panel,
+        connection.clone(),
+        "Parent",
+        &mut panels.cx,
+    );
+    let parent_session = session_of(&parent, &panels.cx);
+    let alpha = spawn_child(&parent, &connection, "alpha", "Alpha", &mut panels.cx);
+    report_waiting(&alpha, &mut panels);
+    assert_reads_waiting(
+        &detail(&row(&mut panels, &parent_session, "acp-subagent:alpha")),
+        "Alpha, waiting",
+    );
+
+    report_running(&alpha, &mut panels.cx);
+
+    let text = detail(&row(&mut panels, &parent_session, "acp-subagent:alpha"));
+    assert!(
+        text.starts_with("Running") && !text.contains(WAITING),
+        "back to Running: {text:?}"
+    );
+}
