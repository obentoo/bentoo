+    );
+    let charlie = find(&rows, "p1", &format!("{PREFIX}sub-c")).expect("a new item is recorded");
+    assert_eq!(charlie.origin, TaskOrigin::SubThread);
+}
+
+// ── Benign ─────────────────────────────────────────────────────────────────
+
+// The archived-only rule is kept: an item that is not archived is neither deleted nor tombstoned.
+#[gpui::test]
+async fn history_db_tombstone_unarchived_item_is_not_deleted(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_tombstone_unarchived").await;
+    tombstone_upsert(
+        &db,
+        &tombstone_sub_record("p1", "sub-a", "Alpha", 1_000),
+        "completed",
+    )
+    .await;
+
+    let removed = db
+        .delete(&[sub_key("p1", "sub-a")])
