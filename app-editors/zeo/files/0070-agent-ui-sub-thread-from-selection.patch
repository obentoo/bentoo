--- /dev/null
+++ b/crates/acp_thread/src/connection/fork_tests.rs
@@ -0,0 +1,460 @@
+// Story 039, tasks 3.1 and 3.3 — fork as an optional capability of every agent connection
+// (R6.4, R3.3; Q4, Q5): `AgentConnection::supports_fork_session` / `fork_session` with refusing
+// defaults, the test stub's opt-in `StubAgentConnection::with_fork_support` / `forked_from`, and
+// the `AcpThread` fork mark that keeps an empty fork from being a draft.
+//
+// Materialize with, in `crates/acp_thread/src/connection.rs` (a non-mod-rs file, so this resolves
+// to `crates/acp_thread/src/connection/fork_tests.rs`):
+//     #[cfg(test)]
+//     mod fork_tests;
+// Filter: `cargo test -p acp_thread fork` (paths `connection::fork_tests::…`).
+//
+// Contract (design.md *Fork in the connection*):
+//   fn supports_fork_session(&self) -> bool { false }
+//   fn fork_session(self: Rc<Self>, session_id: &acp_v2::SessionId, project: Entity<Project>,
+//                   work_dirs: PathList, cx: &mut App) -> Task<Result<Entity<AcpThread>>>
+//       default: an error, nothing sent ("Forking sessions is not supported")
+//   StubAgentConnection::with_fork_support(self) -> Self   (its forked thread is marked forked)
+//   StubAgentConnection::forked_from(&self) -> Vec<acp_v2::SessionId>
+//
+// Task 3.3 shares this file (design.md *A forked thread is not a draft*):
+//   AcpThread::mark_forked_from(&mut self, parent: acp_v2::SessionId)
+//   AcpThread::forked_from(&self) -> Option<&acp_v2::SessionId>
+//   is_draft_thread() == entries().is_empty() && forked_from().is_none()
+//
+// Hostile halves first (identity: a fork is a NEW session of the SAME conversation):
+//   - wrong collapse: the fork must never hand back the parent's session or thread, and two forks
+//     of one parent are two sessions, not one;
+//   - wrong split: the forked session, asked for again by id, is the thread the fork registered —
+//     not a second thread under the same id. THIS ONE GOES BEYOND design.md's stub contract: it is
+//     what lets task 4.3 open the fork over the stub with "no load request sent" (design.md's
+//     Decision relies on `AcpConnection::open_or_create_session` returning the registered thread;
+//     the stub's `load_session` built a fresh thread at the series tip).
+
+use std::cell::Cell;
+use std::path::Path;
+use std::rc::Rc;
+
+use agent_client_protocol::schema::{v1 as acp_v1, v2 as acp_v2};
+use gpui::{App, Entity, SharedString, Task, TestAppContext};
+use project::{AgentId, FakeFs, Project};
+use settings::SettingsStore;
+use util::path_list::PathList;
+
+use super::*;
+use crate::{AcpThread, AgentThreadEntry};
+
+fn init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let mut settings_store = SettingsStore::test(cx);
+        settings_store.register_setting::<feature_flags::FeatureFlagsSettings>();
+        cx.set_global(settings_store);
+    });
+}
+
+async fn project(cx: &mut TestAppContext) -> Entity<Project> {
+    let fs = FakeFs::new(cx.executor());
+    Project::test(fs, [], cx).await
+}
+
+fn work_dirs() -> PathList {
+    PathList::new(&[Path::new("/work/app"), Path::new("/work/lib")])
+}
+
+fn agent_says(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+fn session_of(thread: &Entity<AcpThread>, cx: &TestAppContext) -> acp_v2::SessionId {
+    thread.read_with(cx, |thread, _| thread.session_id().clone())
+}
+
+fn entry_count(thread: &Entity<AcpThread>, cx: &TestAppContext) -> usize {
+    thread.read_with(cx, |thread, _| thread.entries().len())
+}
+
+fn user_messages(thread: &Entity<AcpThread>, cx: &TestAppContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .filter(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)))
+            .count()
+    })
+}
+
+/// A session of `connection` that has had one turn: a user message and the agent's reply.
+async fn parent_with_a_turn(
+    connection: &Rc<StubAgentConnection>,
+    project: &Entity<Project>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    let thread = cx
+        .update(|cx| {
+            connection
+                .clone()
+                .new_session(project.clone(), work_dirs(), cx)
+        })
+        .await
+        .expect("the stub opens a session");
+    connection.set_next_prompt_updates(vec![agent_says("Noted.")]);
+    thread
+        .update(cx, |thread, cx| thread.send_raw("Remember QZ-1.", cx))
+        .await
+        .expect("the parent's turn completes");
+    cx.run_until_parked();
+    assert_eq!(
+        entry_count(&thread, cx),
+        2,
+        "fixture: the parent has a turn"
+    );
+    thread
+}
+
+async fn fork(
+    connection: &Rc<StubAgentConnection>,
+    parent: &acp_v2::SessionId,
+    project: &Entity<Project>,
+    cx: &mut TestAppContext,
+) -> anyhow::Result<Entity<AcpThread>> {
+    let task = cx.update(|cx| {
+        connection
+            .clone()
+            .fork_session(parent, project.clone(), work_dirs(), cx)
+    });
+    let result = task.await;
+    cx.run_until_parked();
+    result
+}
+
+/// An agent connection that implements only what the trait requires, so its fork answers are the
+/// trait's defaults. It counts the sessions it is asked to create: a default fork creates none.
+#[derive(Default)]
+struct ForklessAgentConnection {
+    new_sessions: Cell<usize>,
+}
+
+impl AgentConnection for ForklessAgentConnection {
+    fn agent_id(&self) -> AgentId {
+        AgentId::new("forkless")
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "forkless".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        _project: Entity<Project>,
+        _work_dirs: PathList,
+        _cx: &mut App,
+    ) -> Task<anyhow::Result<Entity<AcpThread>>> {
+        self.new_sessions.set(self.new_sessions.get() + 1);
+        Task::ready(Err(anyhow::anyhow!("no session is created by this fake")))
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(
+        &self,
+        _method: acp_v2::AuthMethodId,
+        _cx: &mut App,
+    ) -> Task<anyhow::Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) -> anyhow::Result<()> {
+        Ok(())
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn std::any::Any> {
+        self
+    }
+}
+
+// R6.4 — a connection type that does not implement fork reports it and refuses, creating nothing.
+#[gpui::test]
+async fn fork_default_reports_unsupported_and_refuses_without_side_effects(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(ForklessAgentConnection::default());
+    assert!(
+        !connection.supports_fork_session(),
+        "the default is no fork"
+    );
+
+    let parent = acp_v2::SessionId::new("parent-of-a-forkless-agent");
+    let result = cx
+        .update(|cx| {
+            connection
+                .clone()
+                .fork_session(&parent, project.clone(), work_dirs(), cx)
+        })
+        .await;
+    cx.run_until_parked();
+
+    let error = result.expect_err("R6.4: the default answers a fork request with an error");
+    assert!(
+        format!("{error:#}")
+            .to_lowercase()
+            .contains("not supported"),
+        "the error says fork is not supported, got: {error:#}"
+    );
+    assert_eq!(
+        connection.new_sessions.get(),
+        0,
+        "a refused fork must not fall back to creating a session"
+    );
+}
+
+// R6.4 over the stub every existing test uses: without the opt-in it keeps the default — no fork
+// reported, a refusal, nothing recorded, the parent untouched.
+#[gpui::test]
+async fn fork_stub_without_fork_support_refuses_and_records_nothing(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+    assert!(!connection.supports_fork_session());
+
+    let result = fork(&connection, &parent_id, &project, cx).await;
+
+    assert!(result.is_err(), "a stub without fork refuses");
+    assert!(connection.forked_from().is_empty(), "nothing recorded");
+    assert_eq!(entry_count(&parent, cx), 2, "the parent is untouched");
+}
+
+// Hostile half (wrong collapse) — the fork is a new session and a new thread, never the parent's,
+// and it starts empty although the parent has a turn: the stub replays nothing.
+#[gpui::test]
+async fn fork_hostile_never_hands_back_the_parent_session(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new().with_fork_support());
+    assert!(
+        connection.supports_fork_session(),
+        "the opt-in reports fork"
+    );
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+
+    let forked = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("a stub with fork forks");
+
+    assert_ne!(session_of(&forked, cx), parent_id, "a NEW session id");
+    assert_ne!(forked, parent, "a NEW thread, not the parent's entity");
+    assert_eq!(
+        entry_count(&forked, cx),
+        0,
+        "nothing replayed into the fork"
+    );
+    assert_eq!(
+        forked.read_with(cx, |thread, _| thread.forked_from().cloned()),
+        Some(parent_id.clone()),
+        "the forked thread is marked with its parent"
+    );
+    assert_eq!(
+        parent.read_with(cx, |thread, _| thread.forked_from().cloned()),
+        None,
+        "the mark is the fork's, never the parent's"
+    );
+    assert_eq!(entry_count(&parent, cx), 2, "the parent is untouched");
+    assert_eq!(
+        forked.read_with(cx, |thread, _| thread.work_dirs().cloned()),
+        Some(work_dirs()),
+        "the fork runs in the directories it was given"
+    );
+}
+
+// Hostile half (wrong collapse, again) — two forks of one parent are two sessions and two threads.
+#[gpui::test]
+async fn fork_hostile_two_forks_of_one_parent_are_two_sessions(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new().with_fork_support());
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+
+    let first = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("first fork");
+    let second = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("second fork");
+
+    assert_ne!(first, second);
+    assert_ne!(session_of(&first, cx), session_of(&second, cx));
+    assert_eq!(connection.forked_from(), vec![parent_id.clone(), parent_id]);
+}
+
+// Hostile half (wrong split, the converse) — the forked session asked for again by its id is the
+// thread the fork registered, still empty: no second thread, no replay. Task 4.3 relies on it to
+// open the fork in a view over the stub the way Zeo opens it over ACP (design.md, Decision).
+#[gpui::test]
+async fn fork_hostile_a_forked_session_reopened_by_id_is_the_registered_thread(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(
+        StubAgentConnection::new()
+            .with_supports_load_session(true)
+            .with_fork_support(),
+    );
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+    let forked = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("fork");
+    let forked_id = session_of(&forked, cx);
+
+    let reopened = cx
+        .update(|cx| {
+            connection.clone().load_session(
+                forked_id.clone(),
+                project.clone(),
+                work_dirs(),
+                None,
+                cx,
+            )
+        })
+        .await
+        .expect("the forked session can be opened by id");
+    cx.run_until_parked();
+
+    assert_eq!(reopened, forked, "the same thread, not a second one");
+    assert_eq!(entry_count(&reopened, cx), 0);
+}
+
+// The stub records the parent it was asked to fork — not the new id, and the right one of two.
+#[gpui::test]
+async fn fork_stub_records_the_parent_it_was_asked_to_fork(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new().with_fork_support());
+    let _other = parent_with_a_turn(&connection, &project, cx).await;
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+
+    let forked = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("fork");
+
+    assert_eq!(connection.forked_from(), vec![parent_id]);
+    assert!(
+        !connection.forked_from().contains(&session_of(&forked, cx)),
+        "the new id is not what is recorded"
+    );
+}
+
+// R3.4 at the connection: a prompt on the fork lands in the fork and never in the parent.
+#[gpui::test]
+async fn fork_a_prompt_on_the_fork_reaches_the_fork_only(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new().with_fork_support());
+    let parent = parent_with_a_turn(&connection, &project, cx).await;
+    let parent_id = session_of(&parent, cx);
+    let forked = fork(&connection, &parent_id, &project, cx)
+        .await
+        .expect("fork");
+
+    connection.set_next_prompt_updates(vec![agent_says("QZ-1")]);
+    forked
+        .update(cx, |thread, cx| thread.send_raw("Which token?", cx))
+        .await
+        .expect("the fork answers");
+    cx.run_until_parked();
+
+    assert_eq!(user_messages(&forked, cx), 1, "the fork got the prompt");
+    assert_eq!(user_messages(&parent, cx), 1, "the parent kept its own one");
+    assert_eq!(entry_count(&parent, cx), 2, "the parent is untouched");
+}
+
+// ── Task 3.3: a forked thread is not a draft (R3.3) ─────────────────────────
+
+fn is_draft(thread: &Entity<AcpThread>, cx: &TestAppContext) -> bool {
+    thread.read_with(cx, |thread, _| thread.is_draft_thread())
+}
+
+fn mark(thread: &Entity<AcpThread>, parent: &str, cx: &mut TestAppContext) {
+    let parent = acp_v2::SessionId::new(parent);
+    thread.update(cx, |thread, _| thread.mark_forked_from(parent));
+}
+
+async fn empty_thread(
+    connection: &Rc<StubAgentConnection>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    let project = project(cx).await;
+    cx.update(|cx| connection.clone().new_session(project, work_dirs(), cx))
+        .await
+        .expect("a session")
+}
+
+// Hostile half first — marking is what turns an empty thread from a draft into a real one; an
+// empty unmarked thread stays a draft exactly as upstream has it.
+#[gpui::test]
+async fn fork_draft_an_empty_thread_is_a_draft_until_marked_forked(cx: &mut TestAppContext) {
+    init(cx);
+    let connection = Rc::new(StubAgentConnection::new());
+    let thread = empty_thread(&connection, cx).await;
+    assert_eq!(entry_count(&thread, cx), 0, "fixture: empty");
+    assert!(
+        is_draft(&thread, cx),
+        "an empty unforked thread is a draft (unchanged)"
+    );
+    assert_eq!(thread.read_with(cx, |t, _| t.forked_from().cloned()), None);
+
+    mark(&thread, "parent-1", cx);
+
+    assert!(
+        !is_draft(&thread, cx),
+        "an empty FORKED thread is not a draft"
+    );
+    assert_eq!(
+        thread.read_with(cx, |t, _| t.forked_from().cloned()),
+        Some(acp_v2::SessionId::new("parent-1"))
+    );
+}
+
+// The mark outlives the thread's first entries.
+#[gpui::test]
+async fn fork_draft_the_mark_survives_entries(cx: &mut TestAppContext) {
+    init(cx);
+    let connection = Rc::new(StubAgentConnection::new());
+    let thread = empty_thread(&connection, cx).await;
+    mark(&thread, "parent-1", cx);
+
+    connection.set_next_prompt_updates(vec![agent_says("Here.")]);
+    thread
+        .update(cx, |thread, cx| thread.send_raw("Still there?", cx))
+        .await
+        .expect("a turn");
+    cx.run_until_parked();
+
+    assert_eq!(entry_count(&thread, cx), 2, "fixture: entries arrived");
+    assert_eq!(
+        thread.read_with(cx, |t, _| t.forked_from().cloned()),
+        Some(acp_v2::SessionId::new("parent-1"))
+    );
+    assert!(!is_draft(&thread, cx));
+}
+
+// Unchanged upstream behaviour: an unmarked thread with entries is not a draft.
+#[gpui::test]
+async fn fork_draft_an_unmarked_thread_with_entries_is_not_a_draft(cx: &mut TestAppContext) {
+    init(cx);
+    let project = project(cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    let thread = parent_with_a_turn(&connection, &project, cx).await;
+
+    assert!(!is_draft(&thread, cx));
+    assert_eq!(thread.read_with(cx, |t, _| t.forked_from().cloned()), None);
+}
