+//! The "↳" marker on a sub-thread's row in the threads sidebar (story 039, R5). `sidebar.rs` only
+//! hands the result to `ThreadItem::badge` through one hook line in `render_thread`.
+
+use agent_ui::ThreadId;
+use agent_ui::thread_metadata_store::ThreadMetadataStore;
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use gpui::{App, SharedString};
+use ui::{IconName, ThreadItem};
+
+/// The tree has no `CornerDownRight`; `ArrowDownRight` is the closest existing glyph to "↳", and
+/// design.md rules out a new SVG.
+const SUB_THREAD_ICON: IconName = IconName::ArrowDownRight;
+
+/// The marker for a thread with a parent link: the icon and a tooltip naming the parent's title,
+/// or the deleted wording once the parent's metadata is gone (R5.5). `None` for a thread with no
+/// link (R5.2), and without the organization store, where no link can be recorded.
+///
+/// The link lives in the global store every window's sidebar observes, which is what makes it
+/// show in every window (R5.3) and survive a restart (R5.4) without any state here.
+pub(crate) fn sub_thread_badge(thread_id: ThreadId, cx: &App) -> Option<(IconName, SharedString)> {
+    let store = ThreadOrganizationStore::try_global(cx)?;
+    let (parent, _kind) = store.read(cx).parent(thread_id)?;
+    let parent_title = ThreadMetadataStore::try_global(cx)
+        .and_then(|metadata| Some(metadata.read(cx).entry(parent)?.display_title()));
+    let tooltip = match parent_title {
+        Some(title) => format!("Sub-thread of {title}"),
+        None => "Sub-thread of a deleted thread".to_string(),
+    };
+    Some((SUB_THREAD_ICON, tooltip.into()))
+}
+
+/// `render_thread`'s hook: adds the marker after any badge already on the row. `ThreadItem` keeps
+/// its badges in a list, so a devtools sub-thread shows both, devtools first.
+pub(crate) fn mark_sub_thread(item: ThreadItem, thread_id: ThreadId, cx: &App) -> ThreadItem {
+    match sub_thread_badge(thread_id, cx) {
+        Some((icon, tooltip)) => item.badge(icon, tooltip),
+        None => item,
+    }
+}
