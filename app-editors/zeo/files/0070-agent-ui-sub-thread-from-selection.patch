+++ b/crates/sidebar/src/sidebar_sub_thread_tests.rs
@@ -0,0 +1,328 @@
+// Story 039, task 5.3 — the "↳" marker on a sub-thread's row in the threads sidebar (R5.1–R5.5;
+// Q5).
+//
+// Materialize with, in `crates/sidebar/src/sidebar.rs`, beside `mod sidebar_pinned_tests;` (0049,
+// applied before this patch) — never beside `mod sidebar_devtools_tests;`, which 0063 adds after
+// it:
+//     #[cfg(test)]
+//     mod sidebar_sub_thread_tests;
+// Filter: `cargo test -p sidebar sub_thread` (paths `sidebar_sub_thread_tests::…`).
+//
+// Contract (design.md *Sidebar marker*): `crate::sub_thread_marker::sub_thread_badge(thread_id,
+// cx) -> Option<(IconName, SharedString)>` — `Some((<an arrow icon>, "Sub-thread of <parent
+// title>"))` for a linked thread, the tooltip "Sub-thread of a deleted thread" when the parent's
+// metadata is gone, `None` otherwise; `render_thread` hands it to story 037's badge.
+//
+// Uses only 039's API. The one exception is the PAINTED check (`marker_painted`), the only line
+// naming the badge's debug selector: `THREAD_ITEM_BADGE`, which `ThreadItem` paints at the series
+// tip (0063). If story 037's generalised badge renames it, adjust it there.
+//
+// Reuses story 032's `pub(super)` helpers from `sidebar_tests.rs`. Links are written through the
+// real store (`ThreadOrganizationStore::set_parent`); a restart is `thread_organization::init`
+// again over the same per-test database, then a new window (story 032's recipe).
+//
+// Hostile halves first:
+//   - the marker follows the LINK, not a title: an unlinked thread titled like a sub-thread gets
+//     none, and the tooltip names the PARENT's title, never the row's own;
+//   - a link moves nothing and adds nothing: the rows, in order, are exactly those of the same
+//     threads unlinked (no indent, no second row under the parent);
+//   - the marker is not the devtools badge (a different icon).
+
+use super::*;
+use crate::sidebar_tests::{
+    init_test, save_thread_metadata_with_main_paths, setup_sidebar, visible_entries_as_strings,
+};
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use agent_ui::thread_organization::{ForkKind, ThreadOrganizationStore};
+use fs::FakeFs;
+use gpui::{TestAppContext, VisualTestContext};
+use std::cell::Cell;
+use std::rc::Rc;
+use ui::IconName;
+use util::path_list::PathList;
+
+use crate::sub_thread_marker::sub_thread_badge;
+
+const ALPHA: &str = "/alpha";
+
+async fn init_alpha(cx: &mut TestAppContext) -> Entity<project::Project> {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(ALPHA, serde_json::json!({ "src": {} }))
+        .await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        agent_ui::thread_organization::init(cx);
+    });
+    cx.run_until_parked();
+    project::Project::test(fs, [ALPHA.as_ref()], cx).await
+}
+
+/// A window on `project` with its sidebar open.
+fn window(
+    project: Entity<project::Project>,
+    cx: &mut TestAppContext,
+) -> (Entity<Sidebar>, VisualTestContext) {
+    let (multi_workspace, vcx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, vcx);
+    (sidebar, vcx.clone())
+}
+
+/// A thread with a sent message in `ALPHA`; a later `minute` sorts higher.
+fn thread(session: &str, title: &str, minute: u32, cx: &mut TestAppContext) -> ThreadId {
+    let paths = PathList::new(&[ALPHA]);
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        paths.clone(),
+        paths,
+        chrono::TimeZone::with_ymd_and_hms(&chrono::Utc, 2026, 10, 20, 12, minute, 0).unwrap(),
+        cx,
+    );
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|e| {
+                e.session_id
+                    .as_ref()
+                    .is_some_and(|s| s.0.as_ref() == session)
+            })
+            .map(|e| e.thread_id)
+            .expect("saved")
+    })
+}
+
+fn link(child: ThreadId, parent: ThreadId, kind: ForkKind, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_parent(child, parent, kind, cx)
+                .expect("two saved threads can be linked")
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn badge(id: ThreadId, cx: &mut TestAppContext) -> Option<(IconName, String)> {
+    cx.update(|cx| sub_thread_badge(id, cx))
+        .map(|(icon, tip)| (icon, tip.to_string()))
+}
+
+fn tooltip(id: ThreadId, cx: &mut TestAppContext) -> Option<String> {
+    badge(id, cx).map(|(_, tip)| tip)
+}
+
+/// The thread rows, trimmed, in order.
+fn rows(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    visible_entries_as_strings(sidebar, cx)
+        .into_iter()
+        .filter(|row| row.starts_with("  "))
+        .map(|row| row.trim().to_string())
+        .collect()
+}
+
+/// `(title, tooltip)` for every thread row the sidebar lists, in order.
+fn row_markers(
+    sidebar: &Entity<Sidebar>,
+    cx: &mut VisualTestContext,
+) -> Vec<(String, Option<String>)> {
+    let ids: Vec<(String, ThreadId)> = sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::Thread(t) => {
+                    Some((t.metadata.display_title().to_string(), t.metadata.thread_id))
+                }
+                _ => None,
+            })
+            .collect()
+    });
+    ids.into_iter()
+        .map(|(title, id)| (title, tooltip(id, cx)))
+        .collect()
+}
+
+/// SEAM — whether a badge is painted anywhere in this window's sidebar.
+fn marker_painted(cx: &mut VisualTestContext) -> bool {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+    cx.debug_bounds("THREAD_ITEM_BADGE").is_some()
+}
+
+// Hostile half — the marker follows the link, not a title, and names the PARENT.
+#[gpui::test]
+async fn sub_thread_hostile_marker_follows_the_link_and_names_the_parent(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (sidebar, mut vcx) = window(project, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let lookalike = thread("s-lookalike", "Sub-thread of Plan the release", 2, cx);
+    let child = thread("s-child", "Why ship first", 3, cx);
+
+    link(child, parent, ForkKind::Clean, cx);
+
+    assert_eq!(tooltip(lookalike, cx), None, "R5.2: a title is not a link");
+    assert_eq!(
+        tooltip(parent, cx),
+        None,
+        "R5.2: the parent is not a sub-thread"
+    );
+    assert_eq!(
+        tooltip(child, cx).as_deref(),
+        Some("Sub-thread of Plan the release"),
+        "R5.1: the parent's title, not the row's own"
+    );
+    assert_eq!(
+        row_markers(&sidebar, &mut vcx)
+            .into_iter()
+            .filter(|(_, tip)| tip.is_some())
+            .map(|(title, _)| title)
+            .collect::<Vec<_>>(),
+        vec!["Why ship first".to_string()],
+        "exactly one row carries the marker"
+    );
+}
+
+// Hostile half — a link moves nothing and adds nothing: same rows, same order, one row each.
+#[gpui::test]
+async fn sub_thread_hostile_a_linked_row_keeps_its_usual_place(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (sidebar, mut vcx) = window(project, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let _middle = thread("s-middle", "Unrelated work", 2, cx);
+    let child = thread("s-child", "Why ship first", 3, cx);
+    let before = rows(&sidebar, &mut vcx);
+
+    link(child, parent, ForkKind::WithContext, cx);
+
+    assert_eq!(
+        rows(&sidebar, &mut vcx),
+        before,
+        "R5.1: a normal row at its usual place"
+    );
+}
+
+// The marker is a marker of its own, not the devtools badge.
+#[gpui::test]
+async fn sub_thread_hostile_marker_is_not_the_devtools_badge(cx: &mut TestAppContext) {
+    let _project = init_alpha(cx).await;
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    link(child, parent, ForkKind::WithContext, cx);
+
+    let (icon, _) = badge(child, cx).expect("a marker");
+    assert_ne!(icon, IconName::ToolWeb, "the devtools badge's icon");
+}
+
+// R5.1, R5.2 — painted for a linked row, not painted when no row is linked.
+#[gpui::test]
+async fn sub_thread_marker_is_painted_only_with_a_link(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (_sidebar, mut vcx) = window(project, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    assert!(!marker_painted(&mut vcx), "R5.2: no link, no marker");
+
+    link(child, parent, ForkKind::Clean, cx);
+
+    assert!(marker_painted(&mut vcx), "R5.1");
+}
+
+// R5.5 — the parent deleted: the sub-thread keeps its row and its marker, with the deleted wording.
+#[gpui::test]
+async fn sub_thread_survives_a_deleted_parent(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (sidebar, mut vcx) = window(project, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    link(child, parent, ForkKind::WithContext, cx);
+
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(parent, cx))
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        rows(&sidebar, &mut vcx),
+        vec!["Why ship first".to_string()],
+        "the row stays"
+    );
+    assert_eq!(
+        tooltip(child, cx).as_deref(),
+        Some("Sub-thread of a deleted thread")
+    );
+}
+
+// The tooltip follows a renamed parent.
+#[gpui::test]
+async fn sub_thread_tooltip_follows_a_renamed_parent(cx: &mut TestAppContext) {
+    let _project = init_alpha(cx).await;
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    link(child, parent, ForkKind::Clean, cx);
+
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.set_title_override(parent, "Ship it".into(), cx)
+        })
+    });
+    cx.run_until_parked();
+
+    assert_eq!(tooltip(child, cx).as_deref(), Some("Sub-thread of Ship it"));
+}
+
+// R5.3 — a link recorded with two windows open reaches the other window's sidebar without a
+// restart: it re-renders and paints the marker.
+#[gpui::test]
+async fn sub_thread_marker_reaches_every_window(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (_sidebar_a, _vcx_a) = window(project, cx);
+    let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+    let other = project::Project::test(fs, [ALPHA.as_ref()], cx).await;
+    let (sidebar_b, mut vcx_b) = window(other, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    assert!(!marker_painted(&mut vcx_b), "fixture: nothing linked yet");
+    let notified = Rc::new(Cell::new(0usize));
+    let counter = notified.clone();
+    let _watch = cx.update(|cx| cx.observe(&sidebar_b, move |_, _| counter.set(counter.get() + 1)));
+
+    link(child, parent, ForkKind::WithContext, cx);
+
+    assert!(notified.get() > 0, "R5.3: window B's sidebar re-rendered");
+    assert!(marker_painted(&mut vcx_b), "R5.3: and paints the marker");
+}
+
+// R5.4 — after a restart (a new store over the same database, a new window) the marker is back.
+#[gpui::test]
+async fn sub_thread_marker_survives_a_restart(cx: &mut TestAppContext) {
+    let project = init_alpha(cx).await;
+    let (_sidebar, _vcx) = window(project, cx);
+    let parent = thread("s-parent", "Plan the release", 1, cx);
+    let child = thread("s-child", "Why ship first", 2, cx);
+    link(child, parent, ForkKind::Clean, cx);
+
+    cx.run_until_parked();
+    cx.update(|cx| agent_ui::thread_organization::init(cx));
+    cx.run_until_parked();
+    let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+    let reopened = project::Project::test(fs, [ALPHA.as_ref()], cx).await;
+    let (sidebar, mut vcx) = window(reopened, cx);
+
+    assert_eq!(
+        tooltip(child, cx).as_deref(),
+        Some("Sub-thread of Plan the release"),
+        "R5.4: the link was read back"
+    );
+    assert!(marker_painted(&mut vcx), "R5.4: and painted");
+    assert_eq!(
+        row_markers(&sidebar, &mut vcx)
+            .into_iter()
+            .filter(|(_, tip)| tip.is_some())
+            .count(),
+        1
+    );
+}
