diff --git a/crates/agent_ui/src/conversation_view/sub_thread_header.rs b/crates/agent_ui/src/conversation_view/sub_thread_header.rs
new file mode 100644
index 0000000..a44821a
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/sub_thread_header.rs
@@ -0,0 +1,258 @@
+//! Story 039 (R4): "Sub-thread of: <parent>" and the inherited band above a sub-thread's
+//! messages. Re-rendered by `ConversationView`'s observation of both stores
+//! (`crate::sub_thread::observe_sub_thread_stores`): `ThreadView` observes neither.
+
+use gpui::{AnyElement, App, Context, Div, Focusable, SharedString, WeakEntity};
+use ui::prelude::*;
+use workspace::Workspace;
+
+use super::thread_view::ThreadView;
+use super::{ConversationView, ServerState};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use crate::{Agent, AgentPanel, AgentThreadSource};
+
+/// `None` when `thread_id` has no parent link (R4.7). A parent whose metadata is gone was
+/// deleted: the organization store keeps a child's link to it (R4.3).
+pub fn render_sub_thread_header(
+    thread_id: ThreadId,
+    inherited: Option<usize>,
+    workspace: WeakEntity<Workspace>,
+    cx: &App,
+) -> Option<AnyElement> {
+    let (parent_id, kind) = ThreadOrganizationStore::try_global(cx)?
+        .read(cx)
+        .parent(thread_id)?;
+    let parent = ThreadMetadataStore::try_global(cx)
+        .and_then(|store| store.read(cx).entry(parent_id).cloned());
+    let Some(parent) = parent else {
+        return Some(
+            header_frame(cx)
+                .child(deleted_parent_header())
+                .into_any_element(),
+        );
+    };
+    let title = parent.display_title();
+    let band = (kind == ForkKind::WithContext).then(|| inherited_band(inherited, &title));
+    Some(
+        header_frame(cx)
+            .child(parent_header(parent, title, workspace))
+            .children(band)
+            .into_any_element(),
+    )
+}
+
+fn header_frame(cx: &App) -> Div {
+    v_flex()
+        .px_4()
+        .py_1()
+        .gap_0p5()
+        .border_b_1()
+        .border_color(cx.theme().colors().border_variant)
+}
+
+fn parent_header(
+    parent: ThreadMetadata,
+    title: SharedString,
+    workspace: WeakEntity<Workspace>,
+) -> impl IntoElement {
+    let header_text = format!("Sub-thread of: {title}");
+    h_flex()
+        .gap_1()
+        .debug_selector(move || format!("SUB_THREAD_HEADER-{header_text}"))
+        .child(
+            Label::new("Sub-thread of:")
+                .size(LabelSize::Small)
+                .color(Color::Muted),
+        )
+        .child(
+            div()
+                .debug_selector(|| "SUB_THREAD_PARENT".to_string())
+                .child(
+                    Button::new("sub-thread-parent", title)
+                        .label_size(LabelSize::Small)
+                        .tab_index(0_isize)
+                        .on_click(move |_, window, cx| {
+                            open_parent(&parent, &workspace, window, cx)
+                        }),
+                ),
+        )
+}
+
+fn deleted_parent_header() -> impl IntoElement {
+    const TEXT: &str = "Sub-thread of a deleted thread";
+    div()
+        .debug_selector(|| format!("SUB_THREAD_HEADER-{TEXT}"))
+        .child(Label::new(TEXT).size(LabelSize::Small).color(Color::Muted))
+}
+
+/// R4.4 / R4.5: the count is known only for a fork made in this session.
+fn inherited_band(inherited: Option<usize>, title: &SharedString) -> Div {
+    let text = match inherited {
+        Some(count) => format!("Inherited {count} messages from {title}"),
+        None => format!("Inherited the conversation of {title}"),
+    };
+    let selector = format!("SUB_THREAD_BAND-{text}");
+    div().debug_selector(move || selector).child(
+        Label::new(text)
+            .size(LabelSize::Small)
+            .color(Color::Muted)
+            .truncate(),
+    )
+}
+
+fn open_parent(
+    parent: &ThreadMetadata,
+    workspace: &WeakEntity<Workspace>,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let panel = workspace
+        .upgrade()
+        .and_then(|workspace| workspace.read(cx).panel::<AgentPanel>(cx));
+    let Some(panel) = panel else {
+        log::warn!(
+            "zeo_sub_thread event=open_parent_failed parent={} reason=no_agent_panel",
+            parent.thread_id.to_key_string()
+        );
+        return;
+    };
+    panel.update(cx, |panel, cx| {
+        panel.load_agent_thread(
+            Agent::from(parent.agent_id.clone()),
+            parent.thread_id,
+            Some(parent.folder_paths().clone()),
+            parent.title.clone(),
+            true,
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        )
+    });
+}
+
+impl ThreadView {
+    /// The one hook `ThreadView`'s render calls, above the entries. Only the root thread of a
+    /// conversation is a sub-thread; a subagent's view inside it is not.
+    pub(super) fn sub_thread_header(&self, cx: &App) -> Option<AnyElement> {
+        if self.parent_session_id.is_some() {
+            return None;
+        }
+        let inherited = self
+            .server_view
+            .upgrade()
+            .and_then(|view| view.read(cx).sub_thread.inherited_messages());
+        render_sub_thread_header(self.root_thread_id, inherited, self.workspace.clone(), cx)
+    }
+}
+
+// R4.9, word for word.
+const NEVER_USED_FORK_TEXT: &str = "This sub-thread was never used and can't be reopened";
+
+/// A reopen through the real ACP connection fails inside `open_or_create_session`'s shared task,
+/// which holds the error as `Arc<anyhow::Error>`; its caller re-wraps that `Arc` with `anyhow!`,
+/// and an `Arc<anyhow::Error>` is no `std::error::Error`, so anyhow keeps it as an ad-hoc message
+/// and a direct downcast to `acp::Error` misses it. Found by the task 8.1 live proof, 2026-10-23:
+/// the GPUI tests' fake connection skips that task.
+fn is_resource_not_found(error: &anyhow::Error) -> bool {
+    let acp_error = error
+        .downcast_ref::<agent_client_protocol::Error>()
+        .or_else(|| {
+            error
+                .downcast_ref::<std::sync::Arc<anyhow::Error>>()
+                .and_then(|shared| shared.downcast_ref::<agent_client_protocol::Error>())
+        });
+    acp_error.is_some_and(|error| error.code == agent_client_protocol::ErrorCode::ResourceNotFound)
+}
+
+#[cfg(test)]
+mod resource_not_found_tests {
+    use super::is_resource_not_found;
+    use agent_client_protocol::Error as AcpError;
+    use std::sync::Arc;
+
+    #[test]
+    fn found_directly_and_through_the_shared_load_task() {
+        let direct = anyhow::anyhow!(AcpError::resource_not_found(None));
+        assert!(is_resource_not_found(&direct));
+        // The shape `open_or_create_session` hands back: `anyhow!(Arc<anyhow::Error>)`.
+        let shared = anyhow::anyhow!(Arc::new(anyhow::anyhow!(AcpError::resource_not_found(
+            None
+        ))));
+        assert!(is_resource_not_found(&shared));
+    }
+
+    #[test]
+    fn other_codes_and_plain_messages_are_not() {
+        let internal = anyhow::anyhow!(Arc::new(anyhow::anyhow!(AcpError::internal_error())));
+        assert!(!is_resource_not_found(&internal));
+        let message = anyhow::anyhow!("Resource not found");
+        assert!(!is_resource_not_found(&message));
+    }
+}
+
+impl ConversationView {
+    /// R4.9. The adapter reloads a fork by resuming its SDK session, and a fork nobody prompted
+    /// left no transcript, so after a restart the reload answers resource-not-found (the 2026-10-21
+    /// probe, claude-agent-acp-plus 0.30.0). Only a with-context sub-thread lost something to it: a
+    /// clean one, an unlinked thread or another code keeps upstream's load error. `map_acp_error`
+    /// keeps the `acp::Error` inside the `anyhow::Error`, under any context it adds.
+    pub(super) fn is_never_used_fork(&self, error: &anyhow::Error, cx: &App) -> bool {
+        is_resource_not_found(error)
+            && ThreadOrganizationStore::try_global(cx)
+                .and_then(|store| store.read(cx).parent(self.thread_id))
+                .is_some_and(|(_, kind)| kind == ForkKind::WithContext)
+    }
+
+    /// Logged here, at the one transition into the state, so a re-render never repeats it. Focus
+    /// leaves a thread view about to be dropped, as `handle_load_error` does; `set_server_state`
+    /// keeps an open fork's unsent draft as saved input, as it does for a load error.
+    pub(super) fn show_sub_thread_unavailable(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if let Some(view) = self.root_thread_view()
+            && view
+                .read(cx)
+                .message_editor
+                .focus_handle(cx)
+                .is_focused(window)
+        {
+            self.focus_handle.focus(window, cx);
+        }
+        let session = ThreadMetadataStore::try_global(cx)
+            .and_then(|store| store.read(cx).entry(self.thread_id)?.session_id.clone())
+            .map_or_else(|| "none".to_string(), |session| session.to_string());
+        log::warn!(
+            "zeo_sub_thread event=unavailable thread={} session={session} code=-32002",
+            self.thread_id.to_key_string()
+        );
+        self.set_server_state(ServerState::SubThreadUnavailable, cx);
+    }
+
+    pub(super) fn sub_thread_unavailable_title(&self, cx: &App) -> SharedString {
+        ThreadMetadataStore::try_global(cx)
+            .and_then(|store| Some(store.read(cx).entry(self.thread_id)?.display_title()))
+            .unwrap_or_else(|| crate::DEFAULT_THREAD_TITLE.into())
+    }
+
+    /// The header stays above the state (R4.9), its parent title still opens the parent.
+    pub(super) fn render_sub_thread_unavailable(&self, cx: &App) -> AnyElement {
+        let inherited = self.sub_thread.inherited_messages();
+        let header =
+            render_sub_thread_header(self.thread_id, inherited, self.workspace.clone(), cx);
+        v_flex()
+            .flex_1()
+            .size_full()
+            .children(header)
+            .child(
+                v_flex().flex_1().items_center().justify_center().child(
+                    div()
+                        .debug_selector(|| format!("SUB_THREAD_UNAVAILABLE-{NEVER_USED_FORK_TEXT}"))
+                        .child(Label::new(NEVER_USED_FORK_TEXT).color(Color::Muted)),
+                ),
+            )
+            .into_any_element()
+    }
+}
