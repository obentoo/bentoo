+//! Story 039, task 10.1 — a fork keeps the parent's thread configuration (R6.5, R6.6; Q4, Q5):
+//! the real `AcpConnection` against a scripted agent on the SDK's in-memory channel, with the
+//! production client handler set, so the fork's `session/set_config_option` and
+//! `session/set_mode` requests travel exactly as they do to the Plus adapter.
+//!
+//! Materialize with, in `crates/agent_servers/src/acp/v1.rs`, beside `mod fork_session_tests;`:
+//!     #[cfg(test)]
+//!     mod fork_config_tests;
+//! Filter: `cargo test -p agent_servers fork_config` (paths `acp::v1::fork_config_tests::…`).
+//!
+//! Contract (design.md *Fork over ACP v1* → *Configuration of the fork*, decided 2026-10-21 after
+//! the 3.2 tech review, finding F1):
+//!   - with a record for (entry, parent): the fork opens as a reopen opens a session — only the
+//!     recorded values the agent offers are sent, and the entry defaults never apply;
+//!   - without one: the new-session path, the entry defaults (R6.6);
+//!   - afterwards the fork's own session id holds the parent's record, so it reopens with it.
+//!
+//! Hostile halves first: the defaults must not win over a record (wrong collapse of "fork" into
+//! "new session"); the record of the same session under ANOTHER entry must not be taken for the
+//! parent's (a third element sharing the session id); the fork's record must exist even when the
+//! agent already reports the parent's values and nothing changes — the case a change-driven
+//! recorder never writes.
+//!
+//! Two agent shapes, because Zeo keeps `SessionModeState` only when an agent has no config
+//! options (`config_state`): the Plus shape carries the mode as the `mode` select option; the
+//! legacy shape carries it as a session mode, restored with `session/set_mode`.
+
+use std::collections::HashMap as StdHashMap;
+use std::sync::Mutex;
+
+use super::thread_config_test_support::*;
+use super::*;
+use crate::thread_config_store::{RecordedConfig, RecordedValue};
+
+const PLUS: &str = "Claude Agent (Plus)";
+const OTHER_ENTRY: &str = "Claude Agent";
+const PARENT: &str = "parent-1";
+const FORKED: &str = "forked-1";
+
+/// What the agent reports for every session it opens — the parent's `session/load` and the
+/// fork's `session/fork` alike — and keeps per session as values are set.
+#[derive(Clone, Default)]
+struct ForkScript {
+    config_options: Option<Vec<acp::SessionConfigOption>>,
+    modes: Option<acp::SessionModeState>,
+}
+
+/// One request the agent received, with the session it names.
+#[derive(Clone, Debug, PartialEq)]
+enum Sent {
+    Config {
+        session: String,
+        config_id: String,
+        value: serde_json::Value,
+    },
+    Mode {
+        session: String,
+        mode_id: String,
+    },
+}
+
+struct ForkConfigAgent {
+    connection: Rc<AcpConnection>,
+    project: Entity<Project>,
+    sent: Arc<Mutex<Vec<Sent>>>,
+    _keep_alive: Task<()>,
+}
+
+impl ForkConfigAgent {
+    async fn connect(
+        script: ForkScript,
+        project: Entity<Project>,
+        cx: &mut gpui::TestAppContext,
+    ) -> Self {
+        let sent: Arc<Mutex<Vec<Sent>>> = Arc::default();
+        // Per session, so setting a value on the parent never shows up in what the fork reports.
+        let options_by_session: Arc<Mutex<StdHashMap<String, Vec<acp::SessionConfigOption>>>> =
+            Arc::default();
+        let script = Arc::new(script);
+
+        let (client_transport, agent_transport) = agent_client_protocol::Channel::duplex();
+        let agent_future = Agent
+            .builder()
+            .name("fork-config-agent")
+            .on_receive_request(
+                async move |req: acp::InitializeRequest, responder, _cx| {
+                    responder.respond(
+                        acp::InitializeResponse::new(req.protocol_version).agent_capabilities(
+                            acp::AgentCapabilities::default()
+                                .load_session(true)
+                                .session_capabilities(
+                                    acp::SessionCapabilities::default()
+                                        .close(acp::SessionCloseCapabilities::new())
+                                        .fork(acp::SessionForkCapabilities::new()),
+                                ),
+                        ),
+                    )
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let script = script.clone();
+                    let options_by_session = options_by_session.clone();
+                    async move |req: acp::LoadSessionRequest, responder, _cx| {
+                        if let Some(options) = script.config_options.clone() {
+                            options_by_session
+                                .lock()
+                                .expect("agent options")
+                                .insert(req.session_id.0.to_string(), options);
+                        }
+                        responder.respond(
+                            acp::LoadSessionResponse::new()
+                                .config_options(script.config_options.clone())
+                                .modes(script.modes.clone()),
+                        )
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let script = script.clone();
+                    let options_by_session = options_by_session.clone();
+                    async move |_req: acp::ForkSessionRequest, responder, _cx| {
+                        if let Some(options) = script.config_options.clone() {
+                            options_by_session
+                                .lock()
+                                .expect("agent options")
+                                .insert(FORKED.to_string(), options);
+                        }
+                        responder.respond(
+                            acp::ForkSessionResponse::new(acp::SessionId::new(FORKED))
+                                .config_options(script.config_options.clone())
+                                .modes(script.modes.clone()),
+                        )
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let sent = sent.clone();
+                    let options_by_session = options_by_session.clone();
+                    async move |req: acp::SetSessionConfigOptionRequest, responder, _cx| {
+                        let params = serde_json::to_value(&req).expect("set config params");
+                        let session = req.session_id.0.to_string();
+                        let config_id = params["configId"].as_str().unwrap_or_default().to_string();
+                        let value = params["value"].clone();
+                        sent.lock().expect("sent").push(Sent::Config {
+                            session: session.clone(),
+                            config_id: config_id.clone(),
+                            value: value.clone(),
+                        });
+                        let list = {
+                            let mut guard = options_by_session.lock().expect("agent options");
+                            let list = guard.entry(session).or_default();
+                            for option in list.iter_mut() {
+                                if option.id.0.as_ref() != config_id {
+                                    continue;
+                                }
+                                match &mut option.kind {
+                                    acp::SessionConfigKind::Select(select) => {
+                                        if let Some(id) = value.as_str() {
+                                            select.current_value =
+                                                acp::SessionConfigValueId::new(id.to_string());
+                                        }
+                                    }
+                                    acp::SessionConfigKind::Boolean(boolean) => {
+                                        if let Some(flag) = value.as_bool() {
+                                            boolean.current_value = flag;
+                                        }
+                                    }
+                                    #[allow(unreachable_patterns)]
+                                    _ => {}
+                                }
+                            }
+                            list.clone()
+                        };
+                        responder.respond(acp::SetSessionConfigOptionResponse::new(list))
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let sent = sent.clone();
+                    async move |req: acp::SetSessionModeRequest, responder, _cx| {
+                        sent.lock().expect("sent").push(Sent::Mode {
+                            session: req.session_id.0.to_string(),
+                            mode_id: req.mode_id.0.to_string(),
+                        });
+                        responder.respond(acp::SetSessionModeResponse::new())
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                async move |_req: acp::CloseSessionRequest, responder, _cx| {
+                    responder.respond(acp::CloseSessionResponse::new())
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_notification(
+                async move |_notif: acp::CancelNotification, _cx| Ok(()),
+                agent_client_protocol::on_receive_notification!(),
+            )
+            .connect_to(agent_transport);
+        let agent_io_task = cx.background_spawn(agent_future);
+
+        let sessions: Rc<RefCell<HashMap<acp_v2::SessionId, AcpSession>>> =
+            Rc::new(RefCell::new(HashMap::default()));
+        let client_session_list: Rc<RefCell<Option<Rc<AcpSessionList>>>> =
+            Rc::new(RefCell::new(None));
+        let (dispatch_tx, dispatch_rx) = mpsc::unbounded::<ForegroundWork>();
+        let (connection_tx, connection_rx) = futures::channel::oneshot::channel();
+        let client_future = connect_client_future(
+            "zed-test",
+            client_transport,
+            dispatch_tx.clone(),
+            connection_tx,
+            futures::future::pending(),
+        );
+        let client_io_task = cx.background_spawn(async move {
+            client_future.await.ok();
+        });
+        let client_conn: ConnectionTo<Agent> = connection_rx
+            .await
+            .expect("failed to receive ACP connection handle");
+        let response = client_conn
+            .send_request(acp::InitializeRequest::new(ProtocolVersion::V1))
+            .block_task()
+            .await
+            .expect("failed to initialize ACP connection");
+
+        let request_elicitations = cx.new(|_| ElicitationStore::default());
+        let dispatch_context = ClientContext {
+            sessions: sessions.clone(),
+            pending_session_updates: None,
+            accepts_subagent_updates: false,
+            session_list: client_session_list.clone(),
+            request_elicitations: request_elicitations.clone(),
+            active_request_scopes: None,
+        };
+        let dispatch_task = cx.spawn({
+            let mut dispatch_rx = dispatch_rx;
+            move |cx| async move {
+                let mut cx = cx;
+                while let Some(work) = futures::StreamExt::next(&mut dispatch_rx).await {
+                    work.run(&mut cx, &dispatch_context);
+                }
+            }
+        });
+        let agent_server_store =
+            project.read_with(cx, |project, _| project.agent_server_store().downgrade());
+        let mut connection = cx.update(|cx| {
+            AcpConnection::new_for_test(
+                client_conn,
+                sessions,
+                response.agent_capabilities,
+                false,
+                request_elicitations,
+                agent_server_store,
+                client_io_task,
+                dispatch_tx,
+                dispatch_task,
+                cx,
+            )
+        });
+        // Half of the record's key: the entry the parent was recorded under.
+        connection.id = AgentId::new(PLUS);
+        let keep_alive = cx.background_spawn(async move {
+            agent_io_task.await.ok();
+        });
+
+        Self {
+            connection: Rc::new(connection),
+            project,
+            sent,
+            _keep_alive: keep_alive,
+        }
+    }
+
+    /// The entry's `default_mode` and `default_config_options`.
+    fn set_defaults(&self, mode: Option<&str>, options: Vec<(&str, AgentConfigOptionValue)>) {
+        self.connection.defaults.set(
+            mode.map(|mode| acp_v2::SessionConfigValueId::new(mode.to_string())),
+            options
+                .into_iter()
+                .map(|(id, value)| (id.to_string(), value))
+                .collect(),
+        );
+    }
+
+    fn work_dirs() -> PathList {
+        PathList::new(&[std::path::Path::new(WORK_DIR)])
+    }
+
+    /// The parent the fork is asked about: a session the connection already holds, opened as a
+    /// reopened thread is.
+    async fn open_parent(&self, cx: &mut gpui::TestAppContext) -> Entity<AcpThread> {
+        let thread = cx
+            .update(|cx| {
+                self.connection.clone().load_session(
+                    acp_v2::SessionId::new(PARENT),
+                    self.project.clone(),
+                    Self::work_dirs(),
+                    None,
+                    cx,
+                )
+            })
+            .await
+            .expect("the parent session opens");
+        cx.run_until_parked();
+        thread
+    }
+
+    async fn fork(&self, cx: &mut gpui::TestAppContext) -> Result<Entity<AcpThread>> {
+        let result = cx
+            .update(|cx| {
+                self.connection.clone().fork_session(
+                    &acp_v2::SessionId::new(PARENT),
+                    self.project.clone(),
+                    Self::work_dirs(),
+                    cx,
+                )
+            })
+            .await;
+        // The restoration (or the defaults) is detached; let every answer and record write land.
+        cx.run_until_parked();
+        result
+    }
+
+    /// `(config id, wire value)` of every `session/set_config_option` naming the fork, sorted.
+    fn fork_config_requests(&self) -> Vec<(String, serde_json::Value)> {
+        let mut requests: Vec<(String, serde_json::Value)> = self
+            .sent
+            .lock()
+            .expect("sent")
+            .iter()
+            .filter_map(|sent| match sent {
+                Sent::Config {
+                    session,
+                    config_id,
+                    value,
+                } if session == FORKED => Some((config_id.clone(), value.clone())),
+                _ => None,
+            })
+            .collect();
+        requests.sort_by(|a, b| a.0.cmp(&b.0));
+        requests
+    }
+
+    /// Mode ids of every `session/set_mode` naming the fork, in order.
+    fn fork_mode_requests(&self) -> Vec<String> {
+        self.sent
+            .lock()
+            .expect("sent")
+            .iter()
+            .filter_map(|sent| match sent {
+                Sent::Mode { session, mode_id } if session == FORKED => Some(mode_id.clone()),
+                _ => None,
+            })
+            .collect()
+    }
+
+    /// The value Zeo holds for one of the fork's options: a JSON string or bool.
+    fn fork_option(&self, config_id: &str) -> Option<serde_json::Value> {
+        let sessions = self.connection.sessions.borrow();
+        let session = sessions.get(&acp_v2::SessionId::new(FORKED))?;
+        let options = session.config_options.as_ref()?.config_options.borrow();
+        let option = options
+            .iter()
+            .find(|option| option.config_id.0.as_ref() == config_id)?;
+        match &option.kind {
+            acp_v2::SessionConfigKind::Select(select) => {
+                Some(serde_json::json!(select.current_value.0.as_ref()))
+            }
+            acp_v2::SessionConfigKind::Boolean(boolean) => {
+                Some(serde_json::json!(boolean.current_value))
+            }
+            _ => None,
+        }
+    }
+
+    fn fork_mode(&self) -> Option<String> {
+        let sessions = self.connection.sessions.borrow();
+        let session = sessions.get(&acp_v2::SessionId::new(FORKED))?;
+        let modes = session.session_modes.as_ref()?;
+        Some(modes.borrow().current_mode_id.0.to_string())
+    }
+}
+
+/// The Plus shape: model, mode and effort are selects, `fast` a session-scoped toggle.
+fn plus_script(model: &str, mode: &str, effort: &str) -> ForkScript {
+    ForkScript {
+        config_options: Some(vec![
+            select("model", model, &["sonnet", "opus", "haiku"]),
+            select("mode", mode, &["default", "plan", "auto"]),
+            select("effort", effort, &["low", "high"]),
+            boolean("fast", false),
+        ]),
+        modes: None,
+    }
+}
+
+/// The entry defaults of the Plus entry: every one differs from what the parent recorded.
+fn plus_defaults(agent: &ForkConfigAgent) {
+    agent.set_defaults(
+        None,
+        vec![
+            ("model", AgentConfigOptionValue::ValueId("haiku".into())),
+            ("mode", AgentConfigOptionValue::ValueId("auto".into())),
+            ("effort", AgentConfigOptionValue::ValueId("low".into())),
+            ("fast", AgentConfigOptionValue::Boolean(true)),
+        ],
+    );
+}
+
+/// The parent's thread-local choice, covering every select the Plus shape offers.
+fn parent_record() -> RecordedConfig {
+    recorded_config(
+        None,
+        vec![
+            ("model", RecordedValue::Id("opus".into())),
+            ("mode", RecordedValue::Id("plan".into())),
+            ("effort", RecordedValue::Id("high".into())),
+        ],
+    )
+}
+
+fn plus_entry_defaults_on_the_wire() -> Vec<(String, serde_json::Value)> {
+    vec![
+        wire("effort", serde_json::json!("low")),
+        wire("fast", serde_json::json!(true)),
+        wire("mode", serde_json::json!("auto")),
+        wire("model", serde_json::json!("haiku")),
+    ]
+}
+
+// Hostile half (wrong collapse of "fork" into "new session") first — R6.5: the parent recorded
+// model `opus`, mode `plan`, effort `high`; the agent reports `sonnet` / `default` / `high` for the
+// fork; the entry defaults say `haiku` / `auto` / `low` / fast on. Only the recorded values that
+// differ are sent, and not one default — `effort` is already the recorded value, so its differing
+// default must not be sent either.
+#[gpui::test]
+async fn fork_config_entry_defaults_never_override_the_parents_record(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent =
+        ForkConfigAgent::connect(plus_script("sonnet", "default", "high"), project, cx).await;
+    plus_defaults(&agent);
+    record(PLUS, PARENT, parent_record(), cx).await;
+    let _parent = agent.open_parent(cx).await;
+
+    let _forked = agent.fork(cx).await.expect("the agent forks");
+
+    assert_eq!(
+        agent.fork_config_requests(),
+        vec![
+            wire("mode", serde_json::json!("plan")),
+            wire("model", serde_json::json!("opus")),
+        ],
+        "the fork receives the parent's differing recorded values and no entry default"
+    );
+    assert_eq!(agent.fork_option("model"), Some(serde_json::json!("opus")));
+    assert_eq!(agent.fork_option("mode"), Some(serde_json::json!("plan")));
+    assert_eq!(
+        agent.fork_option("effort"),
+        Some(serde_json::json!("high")),
+        "the recorded effort stands over the `low` default"
+    );
+    // A toggle is never recorded (`snapshot`), and with a record the defaults never apply —
+    // design.md: the fork opens the way a reopen opens a session.
+    assert_eq!(
+        agent.fork_option("fast"),
+        Some(serde_json::json!(false)),
+        "the `fast` default is not applied over a recorded parent"
+    );
+    assert!(
+        agent.fork_mode_requests().is_empty(),
+        "the Plus shape carries the mode as an option; no session/set_mode"
+    );
+}
+
+// R6.5, legacy shape — an agent with session modes and no config options: the parent recorded
+// `plan`, the entry's default mode is `acceptEdits`, the agent reports `default`. The fork gets one
+// `session/set_mode` with `plan`, and never the default.
+#[gpui::test]
+async fn fork_config_parent_mode_replaces_the_entry_default_mode(cx: &mut gpui::TestAppContext) {
+    let project = init(cx).await;
+    let agent = ForkConfigAgent::connect(
+        ForkScript {
+            config_options: None,
+            modes: Some(modes("default", &["default", "plan", "acceptEdits"])),
+        },
+        project,
+        cx,
+    )
+    .await;
+    agent.set_defaults(Some("acceptEdits"), Vec::new());
+    record(PLUS, PARENT, recorded_config(Some("plan"), Vec::new()), cx).await;
+    let _parent = agent.open_parent(cx).await;
+
+    let _forked = agent.fork(cx).await.expect("the agent forks");
+
+    assert_eq!(
+        agent.fork_mode_requests(),
+        vec!["plan".to_string()],
+        "the fork receives the parent's recorded mode, not the entry's default mode"
+    );
+    assert_eq!(agent.fork_mode(), Some("plan".to_string()));
+}
+
+// Hostile half (a third element sharing the session id) — R6.6: the same session id recorded
+// under ANOTHER entry is not the parent's record. The fork gets the entry defaults, as a parent
+// with no record does.
+#[gpui::test]
+async fn fork_config_another_entrys_record_of_the_same_session_is_not_applied(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent =
+        ForkConfigAgent::connect(plus_script("sonnet", "default", "high"), project, cx).await;
+    plus_defaults(&agent);
+    record(OTHER_ENTRY, PARENT, parent_record(), cx).await;
+    let _parent = agent.open_parent(cx).await;
+
+    let _forked = agent.fork(cx).await.expect("the agent forks");
+
+    assert_eq!(
+        agent.fork_config_requests(),
+        plus_entry_defaults_on_the_wire(),
+        "another entry's record is not the parent's: the fork gets the entry defaults"
+    );
+    assert_eq!(agent.fork_option("model"), Some(serde_json::json!("haiku")));
+}
+
+// Benign half — R6.6: the parent has no record at all; the fork gets the entry defaults, exactly as
+// a new session does.
+#[gpui::test]
+async fn fork_config_parent_without_a_record_gets_the_entry_defaults(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent =
+        ForkConfigAgent::connect(plus_script("sonnet", "default", "high"), project, cx).await;
+    plus_defaults(&agent);
+    let _parent = agent.open_parent(cx).await;
+    assert_eq!(
+        recorded(PLUS, PARENT, cx),
+        None,
+        "fixture: no parent record"
+    );
+
+    let _forked = agent.fork(cx).await.expect("the agent forks");
+
+    assert_eq!(
+        agent.fork_config_requests(),
+        plus_entry_defaults_on_the_wire()
+    );
+    assert_eq!(agent.fork_option("model"), Some(serde_json::json!("haiku")));
+    assert_eq!(agent.fork_option("mode"), Some(serde_json::json!("auto")));
+}
+
+// Hostile half (the fork's record never written) — the agent already reports the parent's values
+// for the fork, so nothing is sent and nothing changes: the fork's session id must still hold the
+// parent's record afterwards, and the parent's record is left as it was.
+#[gpui::test]
+async fn fork_config_the_fork_holds_the_parents_record_under_its_own_id(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent = ForkConfigAgent::connect(plus_script("opus", "plan", "high"), project, cx).await;
+    plus_defaults(&agent);
+    record(PLUS, PARENT, parent_record(), cx).await;
+    let _parent = agent.open_parent(cx).await;
+
+    let _forked = agent.fork(cx).await.expect("the agent forks");
+
+    assert!(
+        agent.fork_config_requests().is_empty(),
+        "the agent already holds the parent's values: nothing to send, no default either"
+    );
+    assert_eq!(
+        recorded(PLUS, FORKED, cx),
+        Some(parent_record()),
+        "the fork reopens with the parent's record"
+    );
+    assert_eq!(
+        recorded(PLUS, PARENT, cx),
+        Some(parent_record()),
+        "the parent's record is untouched"
+    );
+}
+
+// R6.5 with a stale record — a recorded value the agent does not offer for the fork (`opus-legacy`,
+// mode `ghost`) and an option it no longer has (`retired`) are skipped without failing the fork:
+// those options keep the agent's value, no default fills the gap, and the offered recorded value
+// (`effort: low`) is still sent.
+#[gpui::test]
+async fn fork_config_a_recorded_value_the_agent_does_not_offer_is_skipped(
+    cx: &mut gpui::TestAppContext,
+) {
+    let project = init(cx).await;
+    let agent =
+        ForkConfigAgent::connect(plus_script("sonnet", "default", "high"), project, cx).await;
+    plus_defaults(&agent);
+    record(
+        PLUS,
+        PARENT,
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus-legacy".into())),
+                ("mode", RecordedValue::Id("ghost".into())),
+                ("effort", RecordedValue::Id("low".into())),
+                ("retired", RecordedValue::Id("on".into())),
+            ],
+        ),
+        cx,
+    )
+    .await;
+    let _parent = agent.open_parent(cx).await;
+
+    let forked = agent.fork(cx).await;
+
+    assert!(
+        forked.is_ok(),
+        "an unoffered recorded value does not fail the fork"
+    );
+    assert!(
+        agent
+            .connection
+            .sessions
+            .borrow()
+            .contains_key(&acp_v2::SessionId::new(FORKED)),
+        "the fork is registered"
+    );
+    assert_eq!(
+        agent.fork_config_requests(),
+        vec![wire("effort", serde_json::json!("low"))],
+        "only the offered recorded value is sent; no default replaces the skipped ones"
+    );
+    assert_eq!(
+        agent.fork_option("model"),
+        Some(serde_json::json!("sonnet")),
+        "the agent's model stands; neither `opus-legacy` nor the `haiku` default"
+    );
+    assert_eq!(
+        agent.fork_option("mode"),
+        Some(serde_json::json!("default")),
+        "the agent's mode stands; neither `ghost` nor the `auto` default"
+    );
+}
diff --git a/crates/agent_servers/src/acp/v1/fork_session_tests.rs b/crates/agent_servers/src/acp/v1/fork_session_tests.rs
new file mode 100644
index 0000000..49f2b79
--- /dev/null
+++ b/crates/agent_servers/src/acp/v1/fork_session_tests.rs
@@ -0,0 +1,446 @@
+//! Story 039, task 3.2 — `session/fork` over ACP v1 (R6.1, R6.2, R6.3; Q4, Q5, Q7): the real
+//! `AcpConnection` against a scripted agent on the SDK's in-memory channel, with the production
+//! client handler set, so the fork request travels exactly as it does to the Plus adapter.
+//!
+//! Materialize with, in `crates/agent_servers/src/acp/v1.rs`, beside `mod round_trip_tests;`:
+//!     #[cfg(test)]
+//!     mod fork_session_tests;
+//! Filter: `cargo test -p agent_servers fork` (paths `acp::v1::fork_session_tests::…`).
+//!
+//! Contract (design.md *Fork over ACP v1*):
+//!   - `supports_fork_session()` is `sessionCapabilities.fork` (R6.1, R6.2);
+//!   - `SessionDirectories::into_fork_session_request(self, session_id: acp_v2::SessionId,
+//!     mcp_servers: Vec<acp::McpServer>) -> acp::ForkSessionRequest`;
+//!   - `fork_session(parent, project, work_dirs, cx)`: no capability → an error and no request;
+//!     otherwise ONE `session/fork` with the parent id, the work dirs (first = cwd, the rest =
+//!     additional directories) and `mcp_servers_for_project`, and the thread for the answered id
+//!     registered as `new_session` registers one and marked `mark_forked_from(parent)` (R6.3,
+//!     task 3.3); a refusal registers nothing; a caller gone
+//!     before the answer leaves the answered session closed (copying `new_session`).
+//!
+//! Hostile halves first: the registered thread is the ANSWERED id's, never the parent's (wrong
+//! collapse); asked for again by id it is the same thread, opened without a `session/load` (wrong
+//! split — design.md's Decision depends on it).
+//!
+//! Gap, named: the fixture project has no context servers, so the MCP list compared is empty. The
+//! unit test below carries a non-empty list through the request builder.
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use super::*;
+use futures::StreamExt as _;
+
+const CWD: &str = "/a";
+const EXTRA: &str = "/b";
+const PARENT: &str = "parent-1";
+const FORKED: &str = "forked-1";
+
+#[derive(Clone, Copy)]
+enum ForkAnswer {
+    /// Answers `session/fork` at once with `FORKED`.
+    Forked,
+    /// Answers with an internal error.
+    Refused,
+    /// Answers with `FORKED` only after `release`.
+    Held,
+}
+
+struct ForkAgent {
+    connection: Rc<AcpConnection>,
+    project: Entity<Project>,
+    forks: Arc<Mutex<Vec<acp::ForkSessionRequest>>>,
+    loads: Arc<AtomicUsize>,
+    closes: Arc<Mutex<Vec<acp::SessionId>>>,
+    release: async_channel::Sender<()>,
+    _keep_alive: Task<()>,
+}
+
+impl ForkAgent {
+    async fn connect(
+        advertises_fork: bool,
+        answer: ForkAnswer,
+        cx: &mut gpui::TestAppContext,
+    ) -> Self {
+        cx.update(|cx| {
+            let store = settings::SettingsStore::test(cx);
+            cx.set_global(store);
+            cx.set_global(db::AppDatabase::test_new());
+        });
+        let fs = fs::FakeFs::new(cx.executor());
+        fs.insert_tree("/", serde_json::json!({ "a": {}, "b": {} }))
+            .await;
+        let project = project::Project::test(fs, [std::path::Path::new(CWD)], cx).await;
+
+        let forks: Arc<Mutex<Vec<acp::ForkSessionRequest>>> = Arc::default();
+        let loads = Arc::new(AtomicUsize::new(0));
+        let closes: Arc<Mutex<Vec<acp::SessionId>>> = Arc::default();
+        let (release, released) = async_channel::bounded::<()>(1);
+
+        let (client_transport, agent_transport) = agent_client_protocol::Channel::duplex();
+        let agent_future = Agent
+            .builder()
+            .name("fork-agent")
+            .on_receive_request(
+                async move |req: acp::InitializeRequest, responder, _cx| {
+                    let session_capabilities = acp::SessionCapabilities::default()
+                        .close(acp::SessionCloseCapabilities::new())
+                        .additional_directories(
+                            acp::SessionAdditionalDirectoriesCapabilities::new(),
+                        );
+                    let session_capabilities = if advertises_fork {
+                        session_capabilities.fork(acp::SessionForkCapabilities::new())
+                    } else {
+                        session_capabilities
+                    };
+                    responder.respond(
+                        acp::InitializeResponse::new(req.protocol_version).agent_capabilities(
+                            acp::AgentCapabilities::default()
+                                .load_session(true)
+                                .session_capabilities(session_capabilities),
+                        ),
+                    )
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let loads = loads.clone();
+                    async move |_req: acp::LoadSessionRequest, responder, _cx| {
+                        loads.fetch_add(1, Ordering::SeqCst);
+                        responder.respond(acp::LoadSessionResponse::new())
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let forks = forks.clone();
+                    async move |req: acp::ForkSessionRequest, responder, _cx| {
+                        forks.lock().expect("fork requests").push(req);
+                        match answer {
+                            ForkAnswer::Forked => responder.respond(acp::ForkSessionResponse::new(
+                                acp::SessionId::new(FORKED),
+                            )),
+                            ForkAnswer::Refused => {
+                                responder.respond_with_error(acp::Error::internal_error())
+                            }
+                            ForkAnswer::Held => {
+                                released.recv().await.ok();
+                                responder.respond(acp::ForkSessionResponse::new(
+                                    acp::SessionId::new(FORKED),
+                                ))
+                            }
+                        }
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let closes = closes.clone();
+                    async move |req: acp::CloseSessionRequest, responder, _cx| {
+                        closes.lock().expect("close requests").push(req.session_id);
+                        responder.respond(acp::CloseSessionResponse::new())
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_notification(
+                async move |_notif: acp::CancelNotification, _cx| Ok(()),
+                agent_client_protocol::on_receive_notification!(),
+            )
+            .connect_to(agent_transport);
+        let agent_io_task = cx.background_spawn(agent_future);
+
+        let sessions: Rc<RefCell<HashMap<acp_v2::SessionId, AcpSession>>> =
+            Rc::new(RefCell::new(HashMap::default()));
+        let client_session_list: Rc<RefCell<Option<Rc<AcpSessionList>>>> =
+            Rc::new(RefCell::new(None));
+        let (dispatch_tx, dispatch_rx) = mpsc::unbounded::<ForegroundWork>();
+        let (connection_tx, connection_rx) = futures::channel::oneshot::channel();
+        let client_future = connect_client_future(
+            "zed-test",
+            client_transport,
+            dispatch_tx.clone(),
+            connection_tx,
+            futures::future::pending(),
+        );
+        let client_io_task = cx.background_spawn(async move {
+            client_future.await.ok();
+        });
+        let client_conn: ConnectionTo<Agent> = connection_rx
+            .await
+            .expect("failed to receive ACP connection handle");
+        let response = client_conn
+            .send_request(acp::InitializeRequest::new(ProtocolVersion::V1))
+            .block_task()
+            .await
+            .expect("failed to initialize ACP connection");
+
+        let request_elicitations = cx.new(|_| ElicitationStore::default());
+        let dispatch_context = ClientContext {
+            sessions: sessions.clone(),
+            pending_session_updates: None,
+            accepts_subagent_updates: false,
+            session_list: client_session_list.clone(),
+            request_elicitations: request_elicitations.clone(),
+            active_request_scopes: None,
+        };
+        let dispatch_task = cx.spawn({
+            let mut dispatch_rx = dispatch_rx;
+            move |cx| async move {
+                let mut cx = cx;
+                while let Some(work) = dispatch_rx.next().await {
+                    work.run(&mut cx, &dispatch_context);
+                }
+            }
+        });
+        let agent_server_store =
+            project.read_with(cx, |project, _| project.agent_server_store().downgrade());
+        let connection = cx.update(|cx| {
+            AcpConnection::new_for_test(
+                client_conn,
+                sessions,
+                response.agent_capabilities,
+                false,
+                request_elicitations,
+                agent_server_store,
+                client_io_task,
+                dispatch_tx,
+                dispatch_task,
+                cx,
+            )
+        });
+        let keep_alive = cx.background_spawn(async move {
+            agent_io_task.await.ok();
+        });
+
+        Self {
+            connection: Rc::new(connection),
+            project,
+            forks,
+            loads,
+            closes,
+            release,
+            _keep_alive: keep_alive,
+        }
+    }
+
+    fn work_dirs() -> PathList {
+        PathList::new(&[std::path::Path::new(CWD), std::path::Path::new(EXTRA)])
+    }
+
+    /// The parent the fork is asked about: a session the connection already holds.
+    async fn open_parent(&self, cx: &mut gpui::TestAppContext) -> Entity<AcpThread> {
+        let thread = cx
+            .update(|cx| {
+                self.connection.clone().load_session(
+                    acp_v2::SessionId::new(PARENT),
+                    self.project.clone(),
+                    Self::work_dirs(),
+                    None,
+                    cx,
+                )
+            })
+            .await
+            .expect("the parent session opens");
+        cx.run_until_parked();
+        self.loads.store(0, Ordering::SeqCst);
+        thread
+    }
+
+    fn fork(&self, cx: &mut gpui::TestAppContext) -> Task<Result<Entity<AcpThread>>> {
+        cx.update(|cx| {
+            self.connection.clone().fork_session(
+                &acp_v2::SessionId::new(PARENT),
+                self.project.clone(),
+                Self::work_dirs(),
+                cx,
+            )
+        })
+    }
+
+    fn fork_requests(&self) -> Vec<acp::ForkSessionRequest> {
+        self.forks.lock().expect("fork requests").clone()
+    }
+
+    fn registered(&self, id: &str) -> bool {
+        self.connection
+            .sessions
+            .borrow()
+            .contains_key(&acp_v2::SessionId::new(id))
+    }
+}
+
+fn session_of(thread: &Entity<AcpThread>, cx: &gpui::TestAppContext) -> acp_v2::SessionId {
+    thread.read_with(cx, |thread, _| thread.session_id().clone())
+}
+
+// The builder carries all four fields, a non-empty MCP list included (design.md, Testing
+// Strategy: unit).
+#[test]
+fn fork_request_carries_parent_id_directories_and_mcp_servers() {
+    let servers = vec![acp::McpServer::Stdio(acp::McpServerStdio::new(
+        "notes",
+        "/usr/bin/notes-mcp",
+    ))];
+    let directories = SessionDirectories {
+        cwd: PathBuf::from(CWD),
+        additional_directories: vec![PathBuf::from(EXTRA)],
+    };
+
+    let request =
+        directories.into_fork_session_request(acp_v2::SessionId::new(PARENT), servers.clone());
+
+    assert_eq!(request.session_id, acp::SessionId::new(PARENT));
+    assert_eq!(request.cwd, PathBuf::from(CWD));
+    assert_eq!(request.additional_directories, vec![PathBuf::from(EXTRA)]);
+    assert_eq!(request.mcp_servers, servers);
+}
+
+// Hostile half (wrong collapse) first — R6.1, R6.3: with the capability, ONE request naming the
+// PARENT, its directories and the project's MCP servers; the thread returned and registered is
+// the ANSWERED id's, a new thread beside the parent's, not the parent's.
+#[gpui::test]
+async fn fork_sends_one_request_and_registers_the_answered_session(cx: &mut gpui::TestAppContext) {
+    let agent = ForkAgent::connect(true, ForkAnswer::Forked, cx).await;
+    assert!(agent.connection.supports_fork_session(), "R6.1");
+    let parent = agent.open_parent(cx).await;
+
+    let forked = agent.fork(cx).await.expect("the agent forks");
+    cx.run_until_parked();
+
+    let requests = agent.fork_requests();
+    assert_eq!(requests.len(), 1, "exactly one session/fork");
+    let request = &requests[0];
+    assert_eq!(
+        request.session_id,
+        acp::SessionId::new(PARENT),
+        "names the parent"
+    );
+    assert_eq!(
+        request.cwd,
+        PathBuf::from(CWD),
+        "the parent's working directory"
+    );
+    assert_eq!(
+        request.additional_directories,
+        vec![PathBuf::from(EXTRA)],
+        "the parent's additional directories"
+    );
+    let expected_servers = cx.update(|cx| mcp_servers_for_project(&agent.project, cx));
+    assert_eq!(
+        request.mcp_servers, expected_servers,
+        "the project's MCP servers"
+    );
+
+    assert_eq!(session_of(&forked, cx), acp_v2::SessionId::new(FORKED));
+    assert_ne!(forked, parent, "a new thread, not the parent's");
+    assert!(agent.registered(FORKED), "registered under the answered id");
+    assert_eq!(
+        forked.read_with(cx, |thread, _| thread.forked_from().cloned()),
+        Some(acp_v2::SessionId::new(PARENT)),
+        "marked forked from the parent (task 3.3), so it is not a draft while empty"
+    );
+    assert!(!forked.read_with(cx, |thread, _| thread.is_draft_thread()));
+    assert_eq!(
+        parent.read_with(cx, |thread, _| thread.forked_from().cloned()),
+        None,
+        "the parent carries no mark"
+    );
+    assert!(agent.registered(PARENT), "the parent stays registered");
+    assert_eq!(session_of(&parent, cx), acp_v2::SessionId::new(PARENT));
+}
+
+// Hostile half (wrong split) — the registered fork, opened again by id, is the same thread and no
+// `session/load` is sent: nothing can be replayed into the view that attaches to it.
+#[gpui::test]
+async fn fork_registered_thread_reopens_without_a_load_request(cx: &mut gpui::TestAppContext) {
+    let agent = ForkAgent::connect(true, ForkAnswer::Forked, cx).await;
+    let _parent = agent.open_parent(cx).await;
+    let forked = agent.fork(cx).await.expect("the agent forks");
+    cx.run_until_parked();
+
+    let reopened = cx
+        .update(|cx| {
+            agent.connection.clone().load_session(
+                acp_v2::SessionId::new(FORKED),
+                agent.project.clone(),
+                ForkAgent::work_dirs(),
+                None,
+                cx,
+            )
+        })
+        .await
+        .expect("the forked session opens");
+    cx.run_until_parked();
+
+    assert_eq!(reopened, forked, "the registered thread itself");
+    assert_eq!(
+        agent.loads.load(Ordering::SeqCst),
+        0,
+        "no session/load was sent"
+    );
+}
+
+// R6.2 — without the capability: reported as unsupported, refused, and nothing reaches the agent.
+#[gpui::test]
+async fn fork_without_the_capability_refuses_and_sends_nothing(cx: &mut gpui::TestAppContext) {
+    let agent = ForkAgent::connect(false, ForkAnswer::Forked, cx).await;
+    assert!(!agent.connection.supports_fork_session(), "R6.2");
+    let _parent = agent.open_parent(cx).await;
+
+    let result = agent.fork(cx).await;
+    cx.run_until_parked();
+
+    assert!(result.is_err(), "refused");
+    assert!(agent.fork_requests().is_empty(), "no session/fork was sent");
+    assert!(!agent.registered(FORKED));
+}
+
+// A refused fork returns the error and registers nothing — no session, no pending session.
+#[gpui::test]
+async fn fork_refused_by_the_agent_registers_nothing(cx: &mut gpui::TestAppContext) {
+    let agent = ForkAgent::connect(true, ForkAnswer::Refused, cx).await;
+    let _parent = agent.open_parent(cx).await;
+    let sessions_before = agent.connection.sessions.borrow().len();
+
+    let result = agent.fork(cx).await;
+    cx.run_until_parked();
+
+    assert!(result.is_err(), "the agent's refusal is an error");
+    assert_eq!(agent.fork_requests().len(), 1, "it was asked once");
+    assert_eq!(agent.connection.sessions.borrow().len(), sessions_before);
+    assert!(agent.connection.pending_sessions.borrow().is_empty());
+    assert!(
+        agent.closes.lock().expect("closes").is_empty(),
+        "nothing to close"
+    );
+}
+
+// A caller gone before the answer: the answered session is not registered and is closed, as
+// `new_session` closes an abandoned one (design.md, *Fork over ACP v1*).
+#[gpui::test]
+async fn fork_abandoned_before_the_answer_closes_the_answered_session(
+    cx: &mut gpui::TestAppContext,
+) {
+    let agent = ForkAgent::connect(true, ForkAnswer::Held, cx).await;
+    let _parent = agent.open_parent(cx).await;
+
+    let pending = agent.fork(cx);
+    cx.run_until_parked();
+    assert_eq!(agent.fork_requests().len(), 1, "the request is in flight");
+    drop(pending);
+    cx.run_until_parked();
+
+    agent.release.try_send(()).expect("release the answer");
+    cx.run_until_parked();
+
+    assert!(!agent.registered(FORKED), "nobody holds the fork");
+    assert_eq!(
+        agent.closes.lock().expect("closes").clone(),
+        vec![acp::SessionId::new(FORKED)],
+        "the answered session is closed, the parent is not"
+    );
+}
