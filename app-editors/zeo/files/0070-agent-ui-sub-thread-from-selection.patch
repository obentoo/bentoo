+mod header;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/reopen.rs"]
+mod reopen;
diff --git a/crates/agent_ui/src/sub_thread/forked_sub_thread.rs b/crates/agent_ui/src/sub_thread/forked_sub_thread.rs
new file mode 100644
index 0000000..54b2213
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread/forked_sub_thread.rs
@@ -0,0 +1,221 @@
+//! The "with context" sub-thread (story 039, R3): fork the parent session over ACP and open the
+//! fork's registered thread, or fail the one way R3.6 describes.
+
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, ProtocolErrorInfo};
+use agent_client_protocol::schema::v2 as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{AsyncApp, Context, Entity, Task, Window};
+use util::ResultExt as _;
+use util::path_list::PathList;
+use workspace::Toast;
+use workspace::notifications::NotificationId;
+
+use super::{PendingParentLink, SubThreadRequest, log_sub_thread_created, quote_excerpt};
+use crate::conversation_view::{ConversationView, RootThreadUpdated};
+use crate::thread_organization::ForkKind;
+use crate::{AgentInitialContent, AgentPanel, AgentThreadSource};
+
+impl AgentPanel {
+    /// R3: forks the parent session and opens the fork's registered thread. Every failure on the
+    /// way, whatever its cause, is the one of R3.6: a toast, a warning, nothing opened or linked.
+    pub(super) fn open_forked_sub_thread(
+        &mut self,
+        request: SubThreadRequest,
+        focus: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<Entity<ConversationView>>> {
+        // R3.8: without directories the fork request could not say where the session works.
+        let Some(work_dirs) = request.work_dirs.clone() else {
+            let error = anyhow!("the parent thread has no working directories");
+            return Task::ready(Err(self.sub_thread_fork_failed(
+                &request.parent_session_id,
+                error,
+                cx,
+            )));
+        };
+        let store = self.connection_store().read(cx);
+        let connecting = store
+            .entry(&request.agent)
+            .map(|entry| entry.read(cx).wait_for_connection());
+        let project = store.project().clone();
+        let agent_id = request.agent.id();
+        let parent_session = request.parent_session_id.clone();
+        cx.spawn_in(window, async move |this, cx| {
+            let forked: Result<(Rc<dyn AgentConnection>, Entity<AcpThread>)> = async {
+                let connecting =
+                    connecting.ok_or_else(|| anyhow!("agent {agent_id} has no connection"))?;
+                let connection = connecting.await.map_err(anyhow::Error::new)?.connection;
+                let thread = cx
+                    .update(|_, cx| {
+                        connection.clone().fork_session(
+                            &parent_session,
+                            project,
+                            work_dirs.clone(),
+                            cx,
+                        )
+                    })?
+                    .await?;
+                Ok((connection, thread))
+            }
+            .await;
+            let opened = forked.and_then(|(connection, thread)| {
+                let fork = thread.clone();
+                this.update_in(cx, |panel, window, cx| {
+                    panel.open_forked_thread(request, thread, work_dirs, focus, window, cx)
+                })
+                // The fork exists in the agent and is registered, so v1's abandoned-fork close
+                // will not fire: nothing else would ever close it.
+                .inspect_err(|_| close_abandoned_fork(connection, &fork, cx))
+            });
+            opened.inspect_err(|error| {
+                // A released panel takes its toast with it; the warning below still says why.
+                if this
+                    .update(cx, |panel, cx| panel.show_sub_thread_failed_toast(cx))
+                    .is_err()
+                {
+                    log::debug!("zeo_sub_thread event=toast_skipped reason=panel_released");
+                }
+                warn_sub_thread_fork_failed(&parent_session, error);
+            })
+        })
+    }
+
+    /// The fork exists in the agent: open its registered thread rather than load it (design
+    /// *Decision*), with the quote unsent, and leave the link to the view's first metadata save.
+    fn open_forked_thread(
+        &mut self,
+        request: SubThreadRequest,
+        thread: Entity<AcpThread>,
+        work_dirs: PathList,
+        focus: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Entity<ConversationView> {
+        let fork_session = thread.read(cx).session_id().clone();
+        let quote =
+            acp_v2::ContentBlock::Text(acp_v2::TextContent::new(quote_excerpt(&request.excerpt)));
+        let opened = self.create_agent_thread_with_server_for_external_session(
+            request.agent,
+            None,
+            fork_session.clone(),
+            Some(work_dirs),
+            None,
+            Some(AgentInitialContent::ContentBlock {
+                blocks: vec![quote],
+                auto_submit: false,
+            }),
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        );
+        let view = self.show_agent_thread(opened, focus, window, cx);
+        let child = view.read(cx).thread_id;
+        view.update(cx, |view, _| {
+            view.set_pending_parent_link(PendingParentLink {
+                child,
+                parent: request.parent_thread_id,
+                kind: ForkKind::WithContext,
+            });
+            view.sub_thread.inherited_messages = request.inherited_messages;
+        });
+        hold_fork_until_attached(&view, thread, cx);
+        log_sub_thread_created(
+            &request.parent_session_id,
+            &fork_session,
+            ForkKind::WithContext,
+            request.excerpt.chars().count(),
+        );
+        view
+    }
+
+    fn sub_thread_fork_failed(
+        &self,
+        parent_session: &acp_v2::SessionId,
+        error: anyhow::Error,
+        cx: &mut Context<Self>,
+    ) -> anyhow::Error {
+        self.show_sub_thread_failed_toast(cx);
+        warn_sub_thread_fork_failed(parent_session, &error);
+        error
+    }
+
+    fn show_sub_thread_failed_toast(&self, cx: &mut Context<Self>) {
+        struct SubThreadFailedToast;
+        self.panel_workspace()
+            .update(cx, |workspace, cx| {
+                workspace.show_toast(
+                    Toast::new(
+                        NotificationId::unique::<SubThreadFailedToast>(),
+                        "Couldn't create the sub-thread",
+                    ),
+                    cx,
+                );
+            })
+            .log_err();
+    }
+}
+
+/// R3.6. `code` is the agent's JSON-RPC error code, `none` when the failure is not the agent's
+/// (no work dirs, no connection, a released panel). The error text is the agent's or Zeo's,
+/// never the user's.
+fn warn_sub_thread_fork_failed(parent_session: &acp_v2::SessionId, error: &anyhow::Error) {
+    let code = ProtocolErrorInfo::from_error(error)
+        .map_or_else(|| "none".to_string(), |info| info.code.to_string());
+    log::warn!(
+        "zeo_sub_thread event=fork_failed parent_session={parent_session} code={code} error={:?}",
+        format!("{error:#}")
+    );
+}
+
+/// Design *Error Handling Strategy*: a fork whose panel or window went away before it could be
+/// shown is closed in the agent when the agent supports close; otherwise it stays open there until
+/// the agent exits, which is worth a warning. Detached: the failure has already been decided.
+fn close_abandoned_fork(
+    connection: Rc<dyn AgentConnection>,
+    fork: &Entity<AcpThread>,
+    cx: &AsyncApp,
+) {
+    cx.update(|cx| {
+        let session = fork.read(cx).session_id().clone();
+        if !connection.supports_close_session() {
+            log::warn!("zeo_sub_thread event=fork_abandoned session={session} close=unsupported");
+            return;
+        }
+        let closing = connection.close_session(&session, cx);
+        cx.spawn(async move |_| match closing.await {
+            Ok(()) => {
+                log::debug!("zeo_sub_thread event=fork_abandoned session={session} close=ok")
+            }
+            Err(error) => log::warn!(
+                "zeo_sub_thread event=fork_abandoned session={session} close=failed error={:?}",
+                format!("{error:#}")
+            ),
+        })
+        .detach();
+    });
+}
+
+/// `fork_session` registers its thread weakly, and the view loads it only after the open returns:
+/// without this strong reference the load would find the registration dead and send a real
+/// `session/load` (design *Implementation Gotchas*). Dropped once the view has attached it.
+fn hold_fork_until_attached(
+    view: &Entity<ConversationView>,
+    thread: Entity<AcpThread>,
+    cx: &mut Context<AgentPanel>,
+) {
+    let fork_session = thread.read(cx).session_id().clone();
+    let mut held = Some(thread);
+    cx.subscribe(view, move |_, view, _: &RootThreadUpdated, cx| {
+        let attached = view
+            .read(cx)
+            .root_thread(cx)
+            .is_some_and(|root| *root.read(cx).session_id() == fork_session);
+        if attached {
+            held.take();
+        }
+    })
+    .detach();
+}
diff --git a/crates/agent_ui/src/sub_thread/message_menu.rs b/crates/agent_ui/src/sub_thread/message_menu.rs
new file mode 100644
index 0000000..5966c0c
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread/message_menu.rs
@@ -0,0 +1,133 @@
+//! The two sub-thread entries in an agent message's context menu (story 039, R1).
+
+use acp_thread::ThreadStatus;
+use gpui::{App, Entity, SharedString, Window};
+use ui::{ContextMenu, ContextMenuEntry, DocumentationSide, Label, prelude::*};
+
+use super::{SubThreadRequest, inherited_message_count};
+use crate::AgentPanel;
+use crate::conversation_view::ThreadView;
+use crate::thread_organization::ForkKind;
+
+/// R1.6's tooltip, shown beside the disabled entry the way upstream's menus explain theirs.
+const WAIT_FOR_TURN: &str = "Wait for the turn to end";
+
+/// Adds "Clean sub-thread" and, when the agent can fork a session and open the fork, "Sub-thread
+/// with context" after a separator. `offers_sub_threads` is the caller's word that the menu belongs
+/// to an agent's message (not a thinking block, R1.5); `excerpt` is the selection, as Markdown when
+/// it has some. Anything else leaves the menu as it was (R1.4, R1.7).
+pub(crate) fn menu_entries(
+    menu: ContextMenu,
+    thread_view: &Entity<ThreadView>,
+    excerpt: Option<SharedString>,
+    offers_sub_threads: bool,
+    cx: &App,
+) -> ContextMenu {
+    let Some(excerpt) = excerpt.filter(|excerpt| !excerpt.trim().is_empty()) else {
+        return menu;
+    };
+    if !offers_sub_threads {
+        return menu;
+    }
+    let thread = thread_view.read(cx).thread.read(cx);
+    let connection = thread.connection();
+    // R1.8: the panel opens a fork through the load-or-resume path, so without either the fork
+    // would exist in the agent and never be shown.
+    let offers_fork = connection.supports_fork_session()
+        && (connection.supports_load_session() || connection.supports_resume_session());
+    let turn_running = thread.status() != ThreadStatus::Idle;
+
+    let entry = |label: &'static str, kind: ForkKind| {
+        let thread_view = thread_view.clone();
+        let excerpt = excerpt.clone();
+        ContextMenuEntry::new(label).handler(move |window, cx| {
+            open_from_menu(&thread_view, kind, excerpt.clone(), window, cx)
+        })
+    };
+    menu.separator()
+        .item(entry("Clean sub-thread", ForkKind::Clean))
+        .when(offers_fork, |menu| {
+            let fork = entry("Sub-thread with context", ForkKind::WithContext);
+            menu.item(if turn_running {
+                fork.disabled(true)
+                    .documentation_aside(DocumentationSide::Left, |_| {
+                        Label::new(WAIT_FOR_TURN).into_any_element()
+                    })
+            } else {
+                fork
+            })
+        })
+}
+
+impl ThreadView {
+    /// R1.9: false in a subagent's view, where the session is the subagent's while the panel's
+    /// thread id is the root conversation's, so a fork would inherit one and link the other.
+    /// `parent_session_id` alone misses it: only the native agent sets it, and an ACP adapter's
+    /// subagent is loaded with `None` (`agent_servers/src/acp/v1.rs`), so the root session decides.
+    pub(crate) fn shows_root_session(&self, cx: &App) -> bool {
+        self.parent_session_id.is_none()
+            && self.server_view.upgrade().is_some_and(|conversation| {
+                conversation.read(cx).root_session_id.as_ref() == Some(&self.session_id)
+            })
+    }
+}
+
+/// Builds the request from the thread as it is at the click, and opens it focused.
+fn open_from_menu(
+    thread_view: &Entity<ThreadView>,
+    kind: ForkKind,
+    excerpt: SharedString,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let view = thread_view.read(cx);
+    let thread = view.thread.read(cx);
+    let parent_session_id = thread.session_id().clone();
+    let kind_label = super::fork_kind_label(kind);
+    // The panel's key for the conversation, not the connection's own agent id: the connection
+    // store, which the fork goes through, is keyed by it.
+    let Some(agent) = view
+        .server_view
+        .upgrade()
+        .map(|conversation| conversation.read(cx).agent_key().clone())
+    else {
+        log::warn!(
+            "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind={kind_label} reason=no_conversation"
+        );
+        return;
+    };
+    let request = SubThreadRequest {
+        parent_thread_id: view.root_thread_id,
+        parent_session_id: parent_session_id.clone(),
+        agent,
+        work_dirs: thread.work_dirs().cloned(),
+        kind,
+        excerpt,
+        inherited_messages: match kind {
+            ForkKind::WithContext => Some(inherited_message_count(thread.entries())),
+            ForkKind::Clean => None,
+        },
+    };
+    let Some(panel) = view
+        .workspace
+        .upgrade()
+        .and_then(|workspace| workspace.read(cx).panel::<AgentPanel>(cx))
+    else {
+        log::warn!(
+            "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind={kind_label} reason=no_agent_panel"
+        );
+        return;
+    };
+    let opening = panel.update(cx, |panel, cx| {
+        panel.open_sub_thread(request, true, window, cx)
+    });
+    // Detached, not dropped: dropping the task would cancel a fork in flight without a word.
+    cx.spawn(async move |_| {
+        if let Err(error) = opening.await {
+            log::warn!(
+                "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind={kind_label} source=menu: {error:#}"
+            );
+        }
+    })
+    .detach();
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/clean.rs b/crates/agent_ui/src/sub_thread_tests/clean.rs
new file mode 100644
index 0000000..67f6725
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/clean.rs
@@ -0,0 +1,385 @@
+// Story 039, task 4.2 — "Clean sub-thread": a new prefilled thread whose parent link is recorded on
+// its first send (R2.1–R2.6, R7.1, R7.2; Q4, Q13). Wiring and seams: `support.rs`. Filter:
+// `cargo test -p agent_ui sub_thread::clean`.
+//
+// Contract: `open_sub_thread(SubThreadRequest { kind: ForkKind::Clean, .. }, focus, ..)` opens the
+// thread through `0045`'s `new_thread_with_prefilled_prompt`, which now returns
+// `Option<Entity<ConversationView>>` (`None` for an unavailable agent, and `open_sub_thread` then
+// resolves to `Err`); the link waits for the first send because
+// `ThreadOrganizationStore::set_parent` refuses a draft (story 031).
+//
+// Hostile halves first (identity of the pending link):
+//   - wrong collapse: a pending link belongs to ITS draft — another draft getting its first
+//     message must not take it, and a discarded draft's link must not land anywhere;
+//   - wrong split: a second message in the same sub-thread records nothing more (no second
+//     `set_parent`, so no "already has a parent" refusal in the log).
+
+use gpui::{Focusable as _, TestAppContext};
+use project::AgentId;
+
+use super::test_support::*;
+use crate::Agent;
+use crate::thread_organization::ForkKind;
+use acp_thread::StubAgentConnection;
+
+const EXCERPT: &str = "Ship **v2** first\n\nthen tag";
+const QUOTED: &str = "> Ship **v2** first\n>\n> then tag\n\n";
+
+fn clean(parent: &Parent, excerpt: &str) -> super::SubThreadRequest {
+    request(parent, ForkKind::Clean, excerpt, None)
+}
+
+// Hostile half (wrong collapse) — two pending clean sub-threads of one parent: the first message
+// of B links B only; A stays unlinked until its own first message.
+#[gpui::test]
+async fn clean_hostile_a_pending_link_belongs_to_its_own_draft(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, "Tag"), &mut cx);
+    let a = active_id(&h, &cx);
+    open_sub_thread(&h, clean(&parent, "ship"), &mut cx);
+    let b = active_id(&h, &cx);
+    assert_ne!(a, b, "fixture: two sub-threads");
+
+    send_text(&h, "Why ship first?", &mut cx);
+
+    assert_eq!(parent_link(b, &mut cx), Some((parent.id, ForkKind::Clean)));
+    assert_eq!(parent_link(a, &mut cx), None, "A is still a draft");
+    assert_eq!(children(parent.id, &mut cx), vec![b]);
+
+    activate(&h, a, &mut cx);
+    send_text(&h, "Why tag?", &mut cx);
+    assert_eq!(parent_link(a, &mut cx), Some((parent.id, ForkKind::Clean)));
+}
+
+// Hostile half (wrong collapse) — R2.4: a draft discarded before its first message records
+// nothing, and the next thread to get a first message does not inherit its pending link.
+#[gpui::test]
+async fn clean_hostile_a_discarded_draft_records_nothing(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+    let child = active_id(&h, &cx);
+
+    remove(&h, child, &mut cx);
+    let next = active_id(&h, &cx);
+    assert_ne!(next, child, "fixture: the discarded draft is gone");
+    send_text(&h, "Something else entirely.", &mut cx);
+
+    assert_eq!(parent_link(child, &mut cx), None);
+    assert_eq!(
+        parent_link(next, &mut cx),
+        None,
+        "the pending link died with its draft"
+    );
+    assert!(
+        children(parent.id, &mut cx).is_empty(),
+        "R2.4: no link stored"
+    );
+}
+
+// Hostile half (wrong split) — a second message records nothing more: one link, and no refused
+// second `set_parent` in the log.
+#[gpui::test]
+async fn clean_hostile_a_second_message_records_nothing_more(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+    let child = active_id(&h, &cx);
+    capture_logs();
+
+    send_text(&h, "First.", &mut cx);
+    send_text(&h, "Second.", &mut cx);
+
+    assert_eq!(
+        parent_link(child, &mut cx),
+        Some((parent.id, ForkKind::Clean))
+    );
+    assert_eq!(children(parent.id, &mut cx), vec![child]);
+    assert!(
+        all_lines_lowercased()
+            .iter()
+            .all(|line| !line.contains("already has a parent")),
+        "set_parent is called once per sub-thread"
+    );
+}
+
+// R2.1, R2.2 — a new thread with the parent's agent, in the same project, focused, holding the
+// quoted excerpt unsent; the parent is unchanged and kept; no link before the first send (R2.3).
+#[gpui::test]
+async fn clean_opens_a_focused_thread_with_the_quote_unsent(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(
+        &h,
+        vec![agent_says("Ship **v2** first, then tag.")],
+        &mut cx,
+    );
+    let parent_entries = entry_count(&parent.thread, &cx);
+    let parent_dirs = parent.thread.read_with(&cx, |t, _| t.work_dirs().cloned());
+    let toasts_before = toasts(&h, &cx);
+
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+
+    let child = active_id(&h, &cx);
+    assert_ne!(child, parent.id, "R2.1: a new thread");
+    let child_thread = active_thread(&h, &cx);
+    assert_ne!(
+        child_thread.read_with(&cx, |t, _| t.session_id().clone()),
+        parent.session
+    );
+    assert_eq!(
+        active_agent_id(&h, &cx),
+        AgentId::new("stub"),
+        "R2.1: the parent's agent"
+    );
+    assert_eq!(
+        child_thread.read_with(&cx, |t, _| t.work_dirs().cloned()),
+        parent_dirs,
+        "R2.1: the same project"
+    );
+    assert!(composer_focused(&h, &mut cx), "R2.1: focused");
+    assert_eq!(
+        composer(&h, child, &cx).as_deref(),
+        Some(QUOTED),
+        "R2.2: the quote"
+    );
+    assert_eq!(entry_count(&child_thread, &cx), 0, "R2.2: nothing sent");
+    assert_eq!(
+        entry_count(&parent.thread, &cx),
+        parent_entries,
+        "R2.1: parent unchanged"
+    );
+    assert!(
+        h.panel
+            .read_with(&cx, |p, _| p.retained_threads().contains_key(&parent.id))
+    );
+    assert_eq!(toasts(&h, &cx), toasts_before, "no toast on success");
+    assert_eq!(
+        parent_link(child, &mut cx),
+        None,
+        "R2.3: no link before the first send"
+    );
+}
+
+// R2.3 — the first message records the link, with fork kind `clean`.
+#[gpui::test]
+async fn clean_first_message_records_the_clean_link(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+    let child = active_id(&h, &cx);
+
+    send_text(&h, "Why first?", &mut cx);
+
+    assert_eq!(
+        parent_link(child, &mut cx),
+        Some((parent.id, ForkKind::Clean))
+    );
+    assert_eq!(
+        parent_link(parent.id, &mut cx),
+        None,
+        "the parent gets no parent"
+    );
+}
+
+// R2.5 — an agent that is no longer available: nothing opens, `0045`'s toast, no link.
+#[gpui::test]
+async fn clean_for_an_unavailable_agent_opens_nothing(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    let retained_before = retained(&h, &cx);
+    let toasts_before = toasts(&h, &cx);
+    let mut gone = clean(&parent, EXCERPT);
+    gone.agent = Agent::Custom {
+        id: AgentId::new("retired-agent"),
+    };
+
+    let result = try_open_sub_thread(&h, gone, true, &mut cx);
+
+    assert!(result.is_err(), "the open resolves to an error");
+    assert_eq!(active_id(&h, &cx), parent.id, "nothing opened");
+    assert_eq!(retained(&h, &cx), retained_before);
+    assert_eq!(toasts(&h, &cx), toasts_before + 1, "one toast");
+    assert!(children(parent.id, &mut cx).is_empty());
+}
+
+// `new_thread_with_prefilled_prompt(agent, source_session, text, focus, window, cx)` answers with
+// the conversation it opened — the one now shown —
+// and with `None`, opening nothing, for an agent that is gone (0045's toast).
+#[gpui::test]
+async fn clean_prefilled_open_returns_the_opened_conversation(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    let toasts_before = toasts(&h, &cx);
+
+    let gone = h.panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            Agent::Custom {
+                id: AgentId::new("retired-agent"),
+            },
+            parent.session.clone(),
+            QUOTED.to_string(),
+            true,
+            window,
+            cx,
+        )
+    });
+    settle(&mut cx);
+    assert!(gone.is_none(), "an unavailable agent opens nothing");
+    assert_eq!(active_id(&h, &cx), parent.id);
+    assert_eq!(toasts(&h, &cx), toasts_before + 1);
+
+    let opened = h.panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread_with_prefilled_prompt(
+            Agent::Stub,
+            parent.session.clone(),
+            QUOTED.to_string(),
+            true,
+            window,
+            cx,
+        )
+    });
+    settle(&mut cx);
+    let opened = opened.expect("an available agent opens a conversation");
+    assert_eq!(
+        h.panel
+            .read_with(&cx, |panel, _| panel.active_conversation_view().cloned()),
+        Some(opened),
+        "the returned conversation is the active one"
+    );
+    assert_eq!(
+        composer(&h, active_id(&h, &cx), &cx).as_deref(),
+        Some(QUOTED)
+    );
+}
+
+// Hostile half (wrong collapse) — R2.6: a clean sub-thread emptied before its first message
+// becomes the panel's reusable empty draft; the next New Thread reuses that very view, and its
+// first message — unrelated to the parent — records no link.
+#[gpui::test]
+async fn clean_hostile_an_emptied_draft_reused_by_new_thread_records_nothing(
+    cx: &mut TestAppContext,
+) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+    let child = active_id(&h, &cx);
+
+    type_text(&h, "", &mut cx);
+    settle(&mut cx);
+    assert_eq!(
+        h.panel
+            .read_with(&cx, |panel, cx| panel.ephemeral_draft_thread_id(cx)),
+        Some(child),
+        "precondition: the emptied view is the panel's reusable draft"
+    );
+    h.panel.update_in(&mut cx, |panel, window, cx| {
+        panel.new_thread(&crate::NewThread, window, cx)
+    });
+    settle(&mut cx);
+    assert_eq!(
+        active_id(&h, &cx),
+        child,
+        "precondition: New Thread reused the view"
+    );
+    send_text(&h, "Something unrelated.", &mut cx);
+
+    assert_eq!(
+        parent_link(child, &mut cx),
+        None,
+        "R2.6: the pending link was dropped"
+    );
+    assert!(children(parent.id, &mut cx).is_empty());
+}
+
+// `focus: false` reaches 0045: the clean sub-thread opens, quoted, without taking the focus.
+#[gpui::test]
+async fn clean_unfocused_open_does_not_take_the_focus(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+
+    let view = try_open_sub_thread(&h, clean(&parent, EXCERPT), false, &mut cx)
+        .expect("the clean sub-thread opens");
+
+    let thread_view = view
+        .read_with(&cx, |view, _| view.active_thread().cloned())
+        .expect("its thread view");
+    let editor = thread_view.read_with(&cx, |view, _| view.message_editor.clone());
+    assert!(
+        !cx.update(|window, cx| editor.focus_handle(cx).contains_focused(window, cx)),
+        "its composer did not take the focus"
+    );
+    assert_eq!(editor.read_with(&cx, |editor, cx| editor.text(cx)), QUOTED);
+}
+
+// R7.2 — the store refuses the link (the parent was deleted before the first message): the
+// sub-thread stays open with its message, and a warning names both thread ids and the refusal.
+#[gpui::test]
+async fn clean_refused_link_keeps_the_thread_and_warns_with_both_ids(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("Tag, then ship.")], &mut cx);
+    open_sub_thread(&h, clean(&parent, EXCERPT), &mut cx);
+    let child = active_id(&h, &cx);
+    remove(&h, parent.id, &mut cx);
+    assert_eq!(
+        active_id(&h, &cx),
+        child,
+        "fixture: the sub-thread is still active"
+    );
+    capture_logs();
+
+    send_text(&h, "Still here?", &mut cx);
+
+    assert_eq!(active_id(&h, &cx), child, "the sub-thread stays open");
+    assert_eq!(
+        user_messages(&active_thread(&h, &cx), &cx),
+        1,
+        "its message was sent"
+    );
+    assert_eq!(parent_link(child, &mut cx), None, "nothing stored");
+    let child_key = child.to_key_string().to_lowercase();
+    let parent_key = parent.id.to_key_string().to_lowercase();
+    assert!(
+        all_lines_lowercased()
+            .iter()
+            .any(|line| line.contains(&child_key)
+                && line.contains(&parent_key)
+                && line.contains("unknown")),
+        "a warning names both ids and the store's refusal: {:?}",
+        all_lines_lowercased()
+    );
+}
+
+// R7.1 — one `zeo_sub_thread event=created` line with both sessions, `kind=clean` and the
+// excerpt's length in CHARACTERS; never the excerpt's text or a title. The excerpt is 12
+// characters in 16 bytes, so a byte count is caught.
+#[gpui::test]
+async fn clean_logs_kind_and_length_never_text(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("naïve café ☕")], &mut cx);
+    capture_logs();
+    let excerpt = "naïve café ☕";
+    assert_eq!(
+        (excerpt.chars().count(), excerpt.len()),
+        (12, 16),
+        "fixture"
+    );
+
+    open_sub_thread(&h, clean(&parent, excerpt), &mut cx);
+    let child_session = active_thread(&h, &cx).read_with(&cx, |t, _| t.session_id().0.to_string());
+    send_text(&h, "Why?", &mut cx);
+
+    // A clean sub-thread's session is accepted by the store only from its first message, so the
+    // line may come at open or at link time — once.
+    assert_one_created_line(&parent.session.0, &child_session, "clean", 12);
+    for line in all_lines_lowercased() {
+        assert!(
+            !line.contains("naïve café"),
+            "the excerpt reached a log: {line}"
+        );
+        assert!(
+            !line.contains(&PARENT_TITLE.to_lowercase()),
+            "a title reached a log: {line}"
+        );
+    }
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/fork.rs b/crates/agent_ui/src/sub_thread_tests/fork.rs
new file mode 100644
index 0000000..9099337
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/fork.rs
@@ -0,0 +1,329 @@
+// Story 039, task 4.3 — "Sub-thread with context": fork the parent session and open the fork,
+// empty, with the quote unsent and the link recorded at once (R3.1–R3.7, R7.1; Q4, Q13). Wiring
+// and seams: `support.rs`. Filter: `cargo test -p agent_ui sub_thread::fork`.
+//
+// Contract: `open_sub_thread(SubThreadRequest { kind: ForkKind::WithContext, .. }, focus, ..)`
+// fails at once without work dirs (R3.8); otherwise calls the parent connection's
+// `fork_session`, whose thread is marked `forked_from` (task 3.3) and so is saved with its session
+// id while still empty; opens that registered session (no `session/load`, design.md Decision),
+// keeping the forked entity alive until the view's first `RootThreadUpdated`; and records the
+// link through `PendingParentLink { kind: WithContext }` before anything is sent.
+//
+// "No load request" over the stub: the stub builds a thread only on `new_session`, `load_session`
+// or `fork_session`; task 3.1 pins that a forked id reopened is the registered thread. So the
+// observable here is that the view shows the fork EMPTY, on the fork's session, with exactly one
+// fork asked of the connection. The ACP-level "no session/load on the wire" is task 3.2's
+// `fork_registered_thread_reopens_without_a_load_request`.
+//
+// Hostile halves first (identity of a fork):
+//   - wrong collapse: a message in the fork never lands in the parent, and a second fork of the
+//     same parent is a second thread with its own link, not the first one re-shown;
+//   - wrong split: the second fork leaves the first fork's link and composer exactly as they were.
+
+use gpui::{Entity, Focusable as _, TestAppContext, VisualTestContext};
+use project::AgentId;
+
+use super::test_support::*;
+use crate::ConversationView;
+use crate::thread_metadata_store::ThreadMetadataStore;
+use crate::thread_organization::ForkKind;
+use acp_thread::StubAgentConnection;
+
+const EXCERPT: &str = "**Quincunx**";
+const QUOTED: &str = "> **Quincunx**\n\n";
+
+fn forking() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_fork_support()
+}
+
+fn with_context(parent: &Parent, excerpt: &str) -> super::SubThreadRequest {
+    request(parent, ForkKind::WithContext, excerpt, Some(2))
+}
+
+fn session_of(h: &Harness, cx: &gpui::VisualTestContext) -> String {
+    active_thread(h, cx).read_with(cx, |t, _| t.session_id().0.to_string())
+}
+
+// Hostile half (wrong collapse) — R3.4: a message sent in the fork reaches the fork's session and
+// never the parent's.
+#[gpui::test]
+async fn fork_hostile_a_message_in_the_fork_never_reaches_the_parent(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    open_sub_thread(&h, with_context(&parent, EXCERPT), &mut cx);
+    let fork = active_thread(&h, &cx);
+    assert_eq!(user_messages(&parent.thread, &cx), 1, "fixture");
+
+    h.connection
+        .set_next_prompt_updates(vec![agent_says("It is the token.")]);
+    send_text(&h, "Which token?", &mut cx);
+
+    assert_eq!(user_messages(&fork, &cx), 1, "the fork got the message");
+    assert_eq!(user_messages(&parent.thread, &cx), 1, "the parent did not");
+}
+
+// Hostile half (wrong collapse, then wrong split) — R3.7: a second fork is a second thread with
+// its own link, and the first fork keeps its link and its composer.
+#[gpui::test]
+async fn fork_hostile_a_second_fork_is_a_second_thread(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    open_sub_thread(&h, with_context(&parent, EXCERPT), &mut cx);
+    let first = active_id(&h, &cx);
+    let first_session = session_of(&h, &cx);
+
+    open_sub_thread(&h, with_context(&parent, "Quincunx pattern"), &mut cx);
+    let second = active_id(&h, &cx);
+
+    assert_ne!(second, first, "a second thread");
+    assert_ne!(session_of(&h, &cx), first_session, "on a second session");
+    assert_eq!(
+        h.connection.forked_from(),
+        vec![parent.session.clone(), parent.session.clone()]
+    );
+    assert_eq!(
+        parent_link(first, &mut cx),
+        Some((parent.id, ForkKind::WithContext))
+    );
+    assert_eq!(
+        parent_link(second, &mut cx),
+        Some((parent.id, ForkKind::WithContext))
+    );
+    let mut kids = children(parent.id, &mut cx);
+    kids.sort_by_key(|id| id.to_key_string());
+    let mut expected = vec![first, second];
+    expected.sort_by_key(|id| id.to_key_string());
+    assert_eq!(kids, expected);
+    assert_eq!(
+        composer(&h, first, &cx).as_deref(),
+        Some(QUOTED),
+        "the first is untouched"
+    );
+}
+
+// R3.1, R3.2, R3.3, R3.5 — the parent's agent is asked to fork the parent; the fork opens focused,
+// empty, with the quote unsent, linked `with_context` before anything is sent; the parent's
+// messages, composer and session are unchanged.
+#[gpui::test]
+async fn fork_opens_the_forked_session_linked_at_once(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    type_text(&h, "a draft the parent keeps", &mut cx);
+    let parent_entries = entry_count(&parent.thread, &cx);
+
+    open_sub_thread(&h, with_context(&parent, EXCERPT), &mut cx);
+
+    assert_eq!(
+        h.connection.forked_from(),
+        vec![parent.session.clone()],
+        "R3.1: one fork"
+    );
+    let child = active_id(&h, &cx);
+    let fork = active_thread(&h, &cx);
+    assert_ne!(child, parent.id, "R3.1: a new thread");
+    assert_ne!(fork, parent.thread);
+    assert_ne!(
+        session_of(&h, &cx),
+        parent.session.0.to_string(),
+        "on the fork's session"
+    );
+    assert_eq!(
+        active_agent_id(&h, &cx),
+        AgentId::new("stub"),
+        "the parent's agent"
+    );
+    assert!(composer_focused(&h, &mut cx), "R3.1: focused");
+    assert_eq!(
+        entry_count(&fork, &cx),
+        0,
+        "the fork opens empty: nothing replayed"
+    );
+    assert_eq!(
+        composer(&h, child, &cx).as_deref(),
+        Some(QUOTED),
+        "R3.2: the quote"
+    );
+    assert_eq!(
+        parent_link(child, &mut cx),
+        Some((parent.id, ForkKind::WithContext)),
+        "R3.3: linked before any send"
+    );
+    assert_eq!(
+        entry_count(&parent.thread, &cx),
+        parent_entries,
+        "R3.5: messages"
+    );
+    assert_eq!(
+        composer(&h, parent.id, &cx).as_deref(),
+        Some("a draft the parent keeps"),
+        "R3.5: composer"
+    );
+    assert_eq!(
+        parent.thread.read_with(&cx, |t, _| t.session_id().clone()),
+        parent.session,
+        "R3.5: session"
+    );
+}
+
+/// R3.6's failure, whatever caused it: an `Err`, no thread, no link, one toast, a warning naming
+/// the parent session. Both callers fail without an agent error (a stub with no fork, no work
+/// dirs), so the warning carries `code=none`.
+fn assert_fork_failed(
+    h: &Harness,
+    parent: &Parent,
+    result: anyhow::Result<Entity<ConversationView>>,
+    (retained_before, toasts_before): (usize, usize),
+    cx: &mut VisualTestContext,
+) {
+    assert!(result.is_err(), "the open resolves to an error");
+    assert_eq!(active_id(h, cx), parent.id, "no thread opened");
+    assert_eq!(retained(h, cx), retained_before);
+    assert!(children(parent.id, cx).is_empty(), "no link");
+    assert_eq!(toasts(h, cx), toasts_before + 1, "the toast");
+    assert!(
+        has_fork_failure_line(&parent.session.0),
+        "a warning names the parent session with code=none: {:?}",
+        all_lines_lowercased()
+    );
+}
+
+// R3.6 — the fork fails (here: an agent without fork).
+#[gpui::test]
+async fn fork_failure_opens_nothing_and_warns(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    let before = (retained(&h, &cx), toasts(&h, &cx));
+    capture_logs();
+
+    let result = try_open_sub_thread(&h, with_context(&parent, EXCERPT), true, &mut cx);
+
+    assert_fork_failed(&h, &parent, result, before, &mut cx);
+}
+
+// R3.8 — no work dirs: the same failure, and no fork is even asked of an agent that could fork.
+#[gpui::test]
+async fn fork_without_work_dirs_fails_before_asking(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    let before = (retained(&h, &cx), toasts(&h, &cx));
+    capture_logs();
+    let mut homeless = with_context(&parent, EXCERPT);
+    homeless.work_dirs = None;
+
+    let result = try_open_sub_thread(&h, homeless, true, &mut cx);
+
+    assert!(
+        h.connection.forked_from().is_empty(),
+        "R3.8: no fork request"
+    );
+    assert_fork_failed(&h, &parent, result, before, &mut cx);
+}
+
+// R3.3 — the fork is not a draft: while it still has no entries its metadata already carries its
+// session id (which is what lets the store admit the link), and the view holds the thread the fork
+// registered — marked forked from the parent — not one rebuilt by a load.
+#[gpui::test]
+async fn fork_metadata_carries_the_session_while_empty(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+
+    open_sub_thread(&h, with_context(&parent, EXCERPT), &mut cx);
+
+    let child = active_id(&h, &cx);
+    let fork = active_thread(&h, &cx);
+    assert_eq!(entry_count(&fork, &cx), 0, "still empty");
+    assert_eq!(
+        fork.read_with(&cx, |t, _| t.forked_from().cloned()),
+        Some(parent.session),
+        "the registered, marked thread"
+    );
+    assert!(!fork.read_with(&cx, |t, _| t.is_draft_thread()));
+    let saved = cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(child)
+            .and_then(|entry| entry.session_id.clone())
+    });
+    assert_eq!(
+        saved,
+        Some(fork.read_with(&cx, |t, _| t.session_id().clone())),
+        "saved with its session id while it has no entries"
+    );
+}
+
+// `focus: false` — the sub-thread opens, quoted and linked, without taking the focus.
+#[gpui::test]
+async fn fork_unfocused_open_does_not_take_the_focus(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+
+    let view = try_open_sub_thread(&h, with_context(&parent, EXCERPT), false, &mut cx)
+        .expect("the fork opens");
+
+    let thread_view = view
+        .read_with(&cx, |view, _| view.active_thread().cloned())
+        .expect("the fork's thread view");
+    let editor = thread_view.read_with(&cx, |view, _| view.message_editor.clone());
+    assert!(
+        !cx.update(|window, cx| editor.focus_handle(cx).contains_focused(window, cx)),
+        "its composer did not take the focus"
+    );
+    let child = thread_view.read_with(&cx, |view, cx| view.thread.read(cx).session_id().clone());
+    assert_ne!(child, parent.session, "a fork was opened all the same");
+    assert_eq!(h.connection.forked_from(), vec![parent.session]);
+}
+
+// The forked entity is held only until the view has it: once the sub-thread is closed, nothing
+// keeps its thread alive. Control first: a clean sub-thread's thread is released the same way.
+#[gpui::test]
+async fn fork_forked_thread_is_released_with_its_view(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::Clean, EXCERPT, None),
+        &mut cx,
+    );
+    let control = active_thread(&h, &cx).downgrade();
+    remove(&h, active_id(&h, &cx), &mut cx);
+    assert!(
+        control.upgrade().is_none(),
+        "precondition: a closed thread is released"
+    );
+
+    open_sub_thread(&h, with_context(&parent, EXCERPT), &mut cx);
+    let fork = active_thread(&h, &cx).downgrade();
+    remove(&h, active_id(&h, &cx), &mut cx);
+    assert!(
+        fork.upgrade().is_none(),
+        "no strong reference outlives the view"
+    );
+}
+
+// R7.1 — one `zeo_sub_thread event=created` line with both sessions, `kind=with_context` and the
+// excerpt's length in characters (12 chars, 16 bytes); never the excerpt's text or a title.
+#[gpui::test]
+async fn fork_logs_ids_kind_and_length_never_text(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says("naïve café ☕")], &mut cx);
+    capture_logs();
+    let excerpt = "naïve café ☕";
+
+    open_sub_thread(&h, with_context(&parent, excerpt), &mut cx);
+
+    let child_session = session_of(&h, &cx);
+    assert_one_created_line(&parent.session.0, &child_session, "with_context", 12);
+    for line in all_lines_lowercased() {
+        assert!(
+            !line.contains("naïve café"),
+            "the excerpt reached a log: {line}"
+        );
+        assert!(
+            !line.contains(&PARENT_TITLE.to_lowercase()),
+            "a title reached a log: {line}"
+        );
+    }
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/fork_abandoned.rs b/crates/agent_ui/src/sub_thread_tests/fork_abandoned.rs
new file mode 100644
index 0000000..9e07d4e
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/fork_abandoned.rs
@@ -0,0 +1,155 @@
+// Story 039, task 4.3 review fix F1 — a fork the agent made but the panel could not show (it was
+// released between the fork and the open) is closed in the agent, and the open still fails the
+// R3.6 way. Filter: `cargo test -p agent_ui sub_thread::fork_abandoned`.
+//
+// The panel is released between `open_sub_thread` and the first poll of its task: the fork asks
+// only the window, which stays, so the stub forks and the open is what fails.
+
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::schema::v2 as acp;
+use futures::FutureExt as _;
+use gpui::{TestAppContext, VisualTestContext};
+
+use super::test_support::*;
+use crate::thread_organization::ForkKind;
+
+const EXCERPT: &str = "**Quincunx**";
+
+fn forking_and_closing(supports_close: bool) -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_fork_support()
+        .with_supports_close_session(supports_close)
+        // Only the abandoned fork may be closed: the parent's release must not count.
+        .with_close_sessions_on_release(false)
+}
+
+/// Asks for a fork, releases the panel before the task runs, and returns the connection, the
+/// parent's session and what the task resolved to.
+async fn fork_then_release_the_panel(
+    connection: StubAgentConnection,
+    cx: &mut TestAppContext,
+) -> (
+    StubAgentConnection,
+    acp::SessionId,
+    anyhow::Result<gpui::Entity<crate::ConversationView>>,
+    VisualTestContext,
+) {
+    let (h, mut cx) = setup(connection, cx).await;
+    let parent = open_parent(&h, vec![agent_says(EXCERPT)], &mut cx);
+    h.connection.take_close_session_calls();
+    capture_logs();
+    let Harness {
+        panel,
+        workspace,
+        connection,
+    } = h;
+
+    let task = panel.update_in(&mut cx, |panel, window, cx| {
+        panel.open_sub_thread(
+            request(&parent, ForkKind::WithContext, EXCERPT, Some(2)),
+            true,
+            window,
+            cx,
+        )
+    });
+    let released = panel.downgrade();
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.remove_panel(&panel, window, cx)
+    });
+    drop(panel);
+    settle(&mut cx);
+
+    assert!(
+        released.upgrade().is_none(),
+        "fixture: the panel is gone before the fork opens"
+    );
+    assert_eq!(
+        connection.forked_from(),
+        vec![parent.session.clone()],
+        "fixture: the agent forked"
+    );
+    let result = task
+        .now_or_never()
+        .expect("open_sub_thread resolves once the window has settled");
+    (connection, parent.session, result, cx)
+}
+
+fn abandoned_lines(session: &acp::SessionId) -> Vec<String> {
+    let session = format!("session={}", session.0.to_lowercase());
+    all_lines_lowercased()
+        .into_iter()
+        .filter(|line| {
+            let words: Vec<&str> = line.split_whitespace().collect();
+            words.contains(&"event=fork_abandoned") && words.contains(&session.as_str())
+        })
+        .collect()
+}
+
+#[gpui::test]
+async fn fork_abandoned_by_a_released_panel_is_closed_in_the_agent(cx: &mut TestAppContext) {
+    let (connection, parent_session, result, _cx) =
+        fork_then_release_the_panel(forking_and_closing(true), cx).await;
+
+    assert!(result.is_err(), "nothing was shown, so the open fails");
+    let closed = connection.take_close_session_calls();
+    assert_eq!(closed.len(), 1, "the fork is closed once: {closed:?}");
+    assert_ne!(closed[0], parent_session, "the fork, never the parent");
+    assert!(
+        has_fork_failure_line(&parent_session.0),
+        "R3.6's warning is still written"
+    );
+    assert!(
+        abandoned_lines(&closed[0])
+            .iter()
+            .all(|line| line.split_whitespace().any(|word| word == "close=ok")),
+        "a successful close is not reported as a failure"
+    );
+}
+
+#[gpui::test]
+async fn fork_abandoned_close_failure_is_warned_with_the_fork_session(cx: &mut TestAppContext) {
+    let connection = forking_and_closing(true);
+    let refusal = connection.defer_next_close_response();
+    refusal
+        .send(Err(anyhow::anyhow!("the agent refused the close")))
+        .expect("fixture: the close response is waited on");
+    let (connection, parent_session, result, _cx) =
+        fork_then_release_the_panel(connection, cx).await;
+
+    assert!(result.is_err());
+    let closed = connection.take_close_session_calls();
+    assert_eq!(closed.len(), 1, "{closed:?}");
+    let lines = abandoned_lines(&closed[0]);
+    assert!(
+        lines
+            .iter()
+            .any(|line| line.split_whitespace().any(|word| word == "close=failed")),
+        "the refused close names the fork: {:?}",
+        all_lines_lowercased()
+    );
+    assert!(has_fork_failure_line(&parent_session.0));
+}
+
+#[gpui::test]
+async fn fork_abandoned_without_close_support_is_warned(cx: &mut TestAppContext) {
+    let (connection, parent_session, result, _cx) =
+        fork_then_release_the_panel(forking_and_closing(false), cx).await;
+
+    assert!(result.is_err());
+    assert!(
+        connection.take_close_session_calls().is_empty(),
+        "no close is asked of an agent that cannot close"
+    );
+    let unsupported: Vec<String> = all_lines_lowercased()
+        .into_iter()
+        .filter(|line| {
+            let words: Vec<&str> = line.split_whitespace().collect();
+            words.contains(&"event=fork_abandoned")
+                && words.contains(&"close=unsupported")
+                && !words.contains(&format!("session={}", parent_session.0.to_lowercase()).as_str())
+        })
+        .collect();
+    assert_eq!(unsupported.len(), 1, "{:?}", all_lines_lowercased());
+    assert!(has_fork_failure_line(&parent_session.0));
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/header.rs b/crates/agent_ui/src/sub_thread_tests/header.rs
new file mode 100644
index 0000000..7da88f6
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/header.rs
@@ -0,0 +1,272 @@
+// Story 039, task 5.2 — "Sub-thread of: <parent>" and the inherited band above a sub-thread's
+// messages (R4.1–R4.8; Q12). Wiring and the three SEAMS (`header_selector`, `band_selector`,
+// `PARENT_BUTTON`): `support.rs`. Filter: `cargo test -p agent_ui sub_thread::header`.
+//
+// Contract: `render_sub_thread_header(thread_id, inherited: Option<usize>, workspace, cx) ->
+// Option<AnyElement>`, placed above the entries by one hook in `ThreadView`'s render, and
+// re-rendered because `ConversationView` observes `ThreadOrganizationStore` and
+// `ThreadMetadataStore` and notifies its thread view (design.md v2: `ThreadView` observes neither).
+// `painted` refreshes the whole window, so the observation itself is asserted by counting the
+// thread view's notifications.
+//
+// Hostile halves first:
+//   - no link, no header — and a clean draft whose link is still PENDING has none either;
+//   - N is the count at the moment of the fork: the parent's later turns do not change it.
+// The menu-driven case relies on task 5.1's entries.
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use gpui::TestAppContext;
+
+use super::test_support::*;
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use acp_thread::StubAgentConnection;
+
+const REPLY: &str = "**Quincunx**";
+
+fn forking() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_fork_support()
+}
+
+fn header_of(title: &str) -> String {
+    header_selector(&format!("Sub-thread of: {title}"))
+}
+
+fn counted_band(n: usize, title: &str) -> String {
+    band_selector(&format!("Inherited {n} messages from {title}"))
+}
+
+fn whole_band(title: &str) -> String {
+    band_selector(&format!("Inherited the conversation of {title}"))
+}
+
+fn deleted_header() -> String {
+    header_selector("Sub-thread of a deleted thread")
+}
+
+fn no_header_at_all(cx: &mut gpui::VisualTestContext) -> bool {
+    !painted(&header_of(PARENT_TITLE), cx)
+        && !painted(&deleted_header(), cx)
+        && !painted(PARENT_BUTTON, cx)
+}
+
+// Hostile half — R4.7: a thread with no link has no header and no band; a clean sub-thread whose
+// link is only pending (no message yet) has none either.
+#[gpui::test]
+async fn header_hostile_no_link_no_header(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    assert!(no_header_at_all(&mut cx), "the parent itself");
+
+    open_sub_thread(&h, request(&parent, ForkKind::Clean, REPLY, None), &mut cx);
+    assert!(no_header_at_all(&mut cx), "a pending link is not a link");
+    assert!(!painted(&whole_band(PARENT_TITLE), &mut cx));
+}
+
+// Hostile half — R4.4: N is counted when the fork is made; two more messages in the parent
+// afterwards leave the band at 2.
+#[gpui::test]
+async fn header_hostile_the_count_is_taken_at_the_moment_of_the_fork(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    select_word("message-content-1-0-0", &mut cx);
+    right_click("message-content-1-0-0", &mut cx);
+    click_menu("Sub-thread with context", &mut cx);
+    let child = active_id(&h, &cx);
+    assert!(
+        painted(&counted_band(2, PARENT_TITLE), &mut cx),
+        "one user + one agent message"
+    );
+
+    activate(&h, parent.id, &mut cx);
+    h.connection
+        .set_next_prompt_updates(vec![agent_says("More.")]);
+    send_text(&h, "Anything else?", &mut cx);
+    activate(&h, child, &mut cx);
+
+    assert!(painted(&counted_band(2, PARENT_TITLE), &mut cx), "still 2");
+    assert!(
+        !painted(&counted_band(4, PARENT_TITLE), &mut cx),
+        "not the live count"
+    );
+}
+
+// R4.1, R4.4 — a forked sub-thread: the header names the parent, the band the known count.
+#[gpui::test]
+async fn header_with_context_shows_the_parent_and_the_count(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(5)),
+        &mut cx,
+    );
+
+    assert!(painted(&header_of(PARENT_TITLE), &mut cx), "R4.1");
+    assert!(
+        painted(PARENT_BUTTON, &mut cx),
+        "R4.2: the title is a button"
+    );
+    assert!(painted(&counted_band(5, PARENT_TITLE), &mut cx), "R4.4");
+    assert!(!painted(&whole_band(PARENT_TITLE), &mut cx));
+}
+
+// R4.5 — the count unknown: the band names the conversation instead of a number.
+#[gpui::test]
+async fn header_with_context_and_unknown_count(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, None),
+        &mut cx,
+    );
+
+    assert!(painted(&whole_band(PARENT_TITLE), &mut cx), "R4.5");
+    assert!(
+        !painted(&counted_band(0, PARENT_TITLE), &mut cx),
+        "no invented zero"
+    );
+}
+
+// R4.6 — a clean sub-thread, once linked, has the header and no band.
+#[gpui::test]
+async fn header_clean_has_no_band(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::Clean, REPLY, Some(2)),
+        &mut cx,
+    );
+    send_text(&h, "Why?", &mut cx);
+
+    assert!(painted(&header_of(PARENT_TITLE), &mut cx), "R4.1");
+    assert!(!painted(&counted_band(2, PARENT_TITLE), &mut cx), "R4.6");
+    assert!(!painted(&whole_band(PARENT_TITLE), &mut cx), "R4.6");
+}
+
+// R4.2 — clicking the parent title opens the parent.
+#[gpui::test]
+async fn header_parent_title_opens_the_parent(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(2)),
+        &mut cx,
+    );
+
+    click(PARENT_BUTTON, &mut cx);
+
+    assert_eq!(active_id(&h, &cx), parent.id);
+}
+
+// R4.3 — the parent deleted: the header says so and is not clickable.
+#[gpui::test]
+async fn header_deleted_parent_is_named_and_not_clickable(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(2)),
+        &mut cx,
+    );
+    let child = active_id(&h, &cx);
+
+    remove(&h, parent.id, &mut cx);
+    assert_eq!(active_id(&h, &cx), child, "fixture");
+
+    assert!(painted(&deleted_header(), &mut cx), "R4.3");
+    assert!(!painted(PARENT_BUTTON, &mut cx), "not clickable");
+    assert!(!painted(&header_of(PARENT_TITLE), &mut cx));
+}
+
+// R4.8 — the header is re-rendered through `ConversationView`'s observation of both stores: a
+// metadata change (the parent renamed) and an organization change (the parent pinned) each
+// notify the sub-thread's thread view, with no event of the thread's own.
+#[gpui::test]
+async fn header_rerenders_on_either_store_change(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    let view = open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(2)),
+        &mut cx,
+    );
+    let thread_view = view
+        .read_with(&cx, |view, _| view.active_thread().cloned())
+        .expect("the sub-thread's thread view");
+    let notified = Rc::new(Cell::new(0usize));
+    let counter = notified.clone();
+    let _watch =
+        cx.update(|_, cx| cx.observe(&thread_view, move |_, _| counter.set(counter.get() + 1)));
+
+    rename(parent.id, "Ship it", &mut cx);
+    let after_rename = notified.get();
+    assert!(
+        after_rename > 0,
+        "a metadata change notifies the thread view"
+    );
+
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.pin(parent.id, cx))
+            .expect("the parent can be pinned")
+    });
+    settle(&mut cx);
+    assert!(
+        notified.get() > after_rename,
+        "an organization change notifies it too"
+    );
+}
+
+// R4.8 — the parent renamed: the header and the band show the new title.
+#[gpui::test]
+async fn header_follows_a_renamed_parent(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(2)),
+        &mut cx,
+    );
+
+    rename(parent.id, "Ship it", &mut cx);
+
+    assert!(painted(&header_of("Ship it"), &mut cx), "R4.8 header");
+    assert!(painted(&counted_band(2, "Ship it"), &mut cx), "R4.8 band");
+    assert!(!painted(&header_of(PARENT_TITLE), &mut cx));
+}
+
+// R4.1 — the header sits above the sub-thread's messages.
+#[gpui::test]
+async fn header_sits_above_the_messages(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    open_sub_thread(
+        &h,
+        request(&parent, ForkKind::WithContext, REPLY, Some(2)),
+        &mut cx,
+    );
+    h.connection
+        .set_next_prompt_updates(vec![agent_says("Answer.")]);
+    send_text(&h, "Question?", &mut cx);
+
+    draw(&mut cx);
+    let header = cx
+        .debug_bounds(header_of(PARENT_TITLE).leak())
+        .expect("the header is painted");
+    let reply = cx
+        .debug_bounds("message-content-1-0-0")
+        .expect("the sub-thread's reply is painted");
+    assert!(
+        header.origin.y < reply.origin.y,
+        "{header:?} above {reply:?}"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/menu.rs b/crates/agent_ui/src/sub_thread_tests/menu.rs
new file mode 100644
index 0000000..1bec946
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/menu.rs
@@ -0,0 +1,254 @@
+// Story 039, task 5.1 — the two entries in an agent message's context menu (R1.1–R1.8; Q12).
+// Wiring: `support.rs`. Filter: `cargo test -p agent_ui sub_thread::menu`.
+//
+// Driven like upstream's own menu tests (`test_message_context_menu_copies_selected_content`): a
+// double-click selects a word of a painted content leaf (`message-content-<entry>-<chunk>-<block>`),
+// a right-click opens the menu, and every entry is found by the `MENU_ITEM-<label>` selector
+// upstream's `ContextMenu` paints. The parent's reply is one chunk, `**Quincunx**`, so the
+// selection's Markdown is `**Quincunx**` and its text `Quincunx`.
+//
+// Hostile halves first — where the entries must NOT appear: no selection; a selection inside a
+// THINKING block, whose content reaches `render_message_context_menu` through the same
+// `render_message_content` call site as an agent chunk and is told apart only by the
+// `offers_slash_commands` flag that site already carries (`0045`: set for an agent's message,
+// never for a thought) — design.md v2 passes it on as the menu's `bool`; the thinking HEADER,
+// whose call site passes `false`; the fork entry without the capability; and the fork entry when
+// the agent forks but can neither load nor resume (R1.8). The tests drive behaviour only, so they
+// hold whatever the flag is called.
+//
+// Not covered here: the disabled entry's tooltip TEXT, fixed as "Wait for the turn to end" (R1.6;
+// a GPUI test cannot read a tooltip's label); the entry is asserted present and inert while the
+// turn runs. User messages and tool
+// calls never reach this menu (design.md), so they have no UI case.
+
+use gpui::{BorrowAppContext as _, TestAppContext, VisualTestContext, point, px};
+use settings::SettingsStore;
+
+use super::test_support::*;
+use crate::thread_organization::ForkKind;
+use acp_thread::{AgentConnection as _, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp_v1;
+
+const REPLY: &str = "**Quincunx**";
+const LEAF: &str = "message-content-1-0-0";
+const CLEAN: &str = "Clean sub-thread";
+const FORK: &str = "Sub-thread with context";
+
+fn forking() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_fork_support()
+}
+
+fn open_menu_on_selection(leaf: &str, cx: &mut VisualTestContext) {
+    select_word(leaf, cx);
+    right_click(leaf, cx);
+    assert!(
+        menu_has("Copy", cx),
+        "precondition: the selection reached the menu"
+    );
+}
+
+// Hostile half — R1.4: a right-click with no selection offers neither entry.
+#[gpui::test]
+async fn menu_hostile_no_selection_offers_neither_entry(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let _parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    right_click(LEAF, &mut cx);
+
+    assert!(
+        menu_has("Copy This Agent Response", &mut cx),
+        "precondition: the menu opened"
+    );
+    assert!(!menu_has(CLEAN, &mut cx));
+    assert!(!menu_has(FORK, &mut cx));
+}
+
+// Hostile half — R1.5: text selected in a thinking block, and its header, offer neither entry,
+// although the same menu builder serves them.
+#[gpui::test]
+async fn menu_hostile_a_thinking_block_offers_neither_entry(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    cx.update(|_, cx| {
+        cx.update_global::<SettingsStore, _>(|store, cx| {
+            store
+                .set_user_settings(
+                    r#"{ "agent": { "thinking_display": "always_expanded" } }"#,
+                    cx,
+                )
+                .expect("thinking display setting");
+        })
+    });
+    let _parent = open_parent(
+        &h,
+        vec![agent_thinks("**Pondering**"), agent_says(REPLY)],
+        &mut cx,
+    );
+    let thought = "message-content-1-0-0";
+
+    open_menu_on_selection(thought, &mut cx);
+    assert!(!menu_has(CLEAN, &mut cx), "a thinking block's selection");
+    assert!(!menu_has(FORK, &mut cx), "a thinking block's selection");
+    dismiss_menu(&mut cx);
+
+    // The header row sits right above the thought's content.
+    draw(&mut cx);
+    let content = cx.debug_bounds(thought).expect("the thought is painted");
+    right_click_at(content.origin + point(px(12.), px(-10.)), &mut cx);
+    assert!(
+        menu_has("Copy This Agent Response", &mut cx),
+        "precondition: the header's menu opened (tune the offset if not)"
+    );
+    assert!(!menu_has(CLEAN, &mut cx), "a thinking header");
+    assert!(!menu_has(FORK, &mut cx), "a thinking header");
+
+    // Control: the agent's own text in the same entry does offer them.
+    dismiss_menu(&mut cx);
+    open_menu_on_selection("message-content-1-1-0", &mut cx);
+    assert!(
+        menu_has(CLEAN, &mut cx),
+        "control: the agent text of the same reply"
+    );
+}
+
+// Hostile half — R1.3: an agent that does not advertise fork gets the clean entry only.
+#[gpui::test]
+async fn menu_hostile_without_fork_only_the_clean_entry(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let _parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_menu_on_selection(LEAF, &mut cx);
+
+    assert!(menu_has(CLEAN, &mut cx), "R1.1");
+    assert!(!menu_has(FORK, &mut cx), "R1.3");
+}
+
+// Hostile half — R1.8: fork advertised, but the agent can neither load nor resume a session, so
+// the panel could not open the fork: the clean entry only. (The stub never resumes; load is off.)
+#[gpui::test]
+async fn menu_hostile_fork_without_load_or_resume_only_the_clean_entry(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new().with_fork_support();
+    assert!(
+        !connection.supports_load_session() && !connection.supports_resume_session(),
+        "fixture: neither load nor resume"
+    );
+    let (h, mut cx) = setup(connection, cx).await;
+    let _parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_menu_on_selection(LEAF, &mut cx);
+
+    assert!(menu_has(CLEAN, &mut cx), "R1.1");
+    assert!(!menu_has(FORK, &mut cx), "R1.8");
+}
+
+// R1.1, R1.2, R1.7 — with a selection and the capability: both entries, and the five existing
+// ones as before.
+#[gpui::test]
+async fn menu_with_a_selection_offers_both_and_keeps_the_existing_entries(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let _parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_menu_on_selection(LEAF, &mut cx);
+
+    assert!(menu_has(CLEAN, &mut cx), "R1.1");
+    assert!(menu_has(FORK, &mut cx), "R1.2");
+    for existing in [
+        "Copy",
+        "Copy as Markdown",
+        "Copy This Agent Response",
+        "Open Thread as Markdown",
+    ] {
+        assert!(menu_has(existing, &mut cx), "R1.7: {existing}");
+    }
+    assert!(
+        menu_has("Scroll to Top", &mut cx) || menu_has("Scroll to Bottom", &mut cx),
+        "R1.7: the scroll entry (its label follows the scroll position)"
+    );
+}
+
+// R1.6 — while the parent's turn runs the fork entry is shown but does nothing; once the turn
+// ends it forks. The clean entry stays.
+#[gpui::test]
+async fn menu_fork_entry_is_inert_while_the_turn_runs(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    send_text(&h, "And then?", &mut cx); // no reply queued: the turn stays open
+    assert_eq!(
+        parent.thread.read_with(&cx, |t, _| t.status()),
+        acp_thread::ThreadStatus::Generating,
+        "fixture: a running turn"
+    );
+
+    open_menu_on_selection(LEAF, &mut cx);
+    assert!(menu_has(CLEAN, &mut cx), "the clean entry is offered");
+    assert!(menu_has(FORK, &mut cx), "R1.6: shown");
+    click_menu(FORK, &mut cx);
+    assert!(
+        h.connection.forked_from().is_empty(),
+        "R1.6: disabled, nothing forked"
+    );
+    assert_eq!(active_id(&h, &cx), parent.id, "nothing opened");
+
+    // End the turn BEFORE pressing escape: with the menu already closed, escape would reach the
+    // thread view and cancel the running turn.
+    h.connection
+        .end_turn(parent.session.clone(), acp_v1::StopReason::EndTurn);
+    settle(&mut cx);
+    dismiss_menu(&mut cx);
+    open_menu_on_selection(LEAF, &mut cx);
+    click_menu(FORK, &mut cx);
+    assert_eq!(
+        h.connection.forked_from(),
+        vec![parent.session.clone()],
+        "enabled again"
+    );
+}
+
+// R1.1 → R2.2 — the clean entry opens the clean sub-thread with the selection's MARKDOWN quoted.
+#[gpui::test]
+async fn menu_clean_entry_opens_the_quoted_selection(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_menu_on_selection(LEAF, &mut cx);
+    click_menu(CLEAN, &mut cx);
+
+    let child = active_id(&h, &cx);
+    assert_ne!(child, parent.id);
+    assert_eq!(
+        composer(&h, child, &cx).as_deref(),
+        Some("> **Quincunx**\n\n")
+    );
+    assert!(
+        h.connection.forked_from().is_empty(),
+        "the clean entry does not fork"
+    );
+    assert_eq!(
+        parent_link(child, &mut cx),
+        None,
+        "linked on its first send only"
+    );
+}
+
+// R1.2 → R3.1–R3.3 — the fork entry forks the parent and opens the fork, quoted and linked.
+#[gpui::test]
+async fn menu_fork_entry_opens_the_quoted_fork(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let parent = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+
+    open_menu_on_selection(LEAF, &mut cx);
+    click_menu(FORK, &mut cx);
+
+    let child = active_id(&h, &cx);
+    assert_ne!(child, parent.id);
+    assert_eq!(h.connection.forked_from(), vec![parent.session.clone()]);
+    assert_eq!(
+        composer(&h, child, &cx).as_deref(),
+        Some("> **Quincunx**\n\n")
+    );
+    assert_eq!(
+        parent_link(child, &mut cx),
+        Some((parent.id, ForkKind::WithContext))
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/menu_subagent.rs b/crates/agent_ui/src/sub_thread_tests/menu_subagent.rs
new file mode 100644
index 0000000..a42e2ac
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/menu_subagent.rs
@@ -0,0 +1,187 @@
+// Story 039, task 11.1 — no sub-thread entries in a subagent's thread view (R1.9; refine v5).
+// Wiring: `support.rs`, mounted as `mod menu_subagent` beside `mod menu` in `sub_thread.rs`.
+// Filter: `cargo test -p agent_ui sub_thread::menu` (selects this file and `menu.rs`).
+//
+// Why: in a subagent's view the clicked thread's session is the SUBAGENT's while the panel's thread
+// id is the root conversation's, so a fork there would inherit one conversation and link another
+// (the 6.1 contract check, `.draft/contract-check.md`).
+//
+// The subagent is reached the way an external agent's subagent reaches Zeo: the root thread
+// announces it (`subagent_spawned`, after an Agent tool call carrying `subagent_session_info`), the
+// conversation loads its session through the connection, and the conversation navigates to it.
+// The subagent's view is told apart by what it shows, never by a field the fixture sets, so the
+// test holds whatever the gate reads.
+//
+// Hostile half first: the subagent's view must offer neither entry although its block is an agent
+// message with a selection, exactly like the root's. Its converse: the root view of the SAME
+// conversation, before and after the subagent was shown, still offers both — a gate keyed on "this
+// conversation has a subagent", or one left set after visiting it, would wrongly remove them there.
+
+use acp_thread::{AcpThread, StubAgentConnection};
+use agent_client_protocol::schema::{v1 as acp_v1, v2 as acp};
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use serde_json::json;
+
+use super::test_support::*;
+use crate::ConversationView;
+
+const REPLY: &str = "**Quincunx**";
+/// The root's reply: entry 0 is the user's message, entry 1 the agent's.
+const ROOT_LEAF: &str = "message-content-1-0-0";
+/// The subagent's reply is its thread's first entry.
+const SUBAGENT_LEAF: &str = "message-content-0-0-0";
+const SUBAGENT_SESSION: &str = "subagent-session";
+const CLEAN: &str = "Clean sub-thread";
+const FORK: &str = "Sub-thread with context";
+
+fn forking() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_fork_support()
+}
+
+fn conversation(h: &Harness, cx: &VisualTestContext) -> Entity<ConversationView> {
+    h.panel
+        .read_with(cx, |panel, _| panel.active_conversation_view().cloned())
+        .expect("a conversation is active")
+}
+
+/// The session of the thread view the conversation shows — the panel's own accessors always
+/// answer with the root thread, whichever view is on screen.
+fn shown_session(h: &Harness, cx: &VisualTestContext) -> acp::SessionId {
+    conversation(h, cx).read_with(cx, |view, cx| {
+        view.active_thread()
+            .expect("a thread view is shown")
+            .read(cx)
+            .thread
+            .read(cx)
+            .session_id()
+            .clone()
+    })
+}
+
+/// The root announces a subagent the way an external agent does; its session is loaded into the
+/// same conversation and has answered with `REPLY`.
+fn spawn_subagent(
+    h: &Harness,
+    root: &Entity<AcpThread>,
+    cx: &mut VisualTestContext,
+) -> acp::SessionId {
+    let session = acp::SessionId::new(SUBAGENT_SESSION);
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        acp_thread::SUBAGENT_SESSION_INFO_META_KEY.to_string(),
+        json!({ "session_id": SUBAGENT_SESSION, "message_start_index": 0 }),
+    );
+    let call = acp_v1::ToolCall::new("toolu_agent", "Agent explore").meta(meta);
+    root.update(cx, |thread, cx| {
+        thread
+            .handle_session_update(acp_v1::SessionUpdate::ToolCall(call), cx)
+            .expect("the Agent tool call applies");
+    });
+    let root_session = root.read_with(cx, |thread, _| thread.session_id().clone());
+    conversation(h, cx).update(cx, |view, cx| {
+        view.load_subagent_session_for_test(session.clone(), root_session, cx)
+    });
+    settle(cx);
+    let loaded = conversation(h, cx).read_with(cx, |view, _| view.thread_view(&session).is_some());
+    assert!(
+        loaded,
+        "fixture: the subagent's session is loaded into the conversation"
+    );
+    cx.update(|_, cx| {
+        h.connection
+            .send_update(session.clone(), agent_says(REPLY), cx)
+    });
+    settle(cx);
+    session
+}
+
+fn show(h: &Harness, session: &acp::SessionId, cx: &mut VisualTestContext) {
+    conversation(h, cx).update_in(cx, |view, window, cx| {
+        view.navigate_to_thread(session.clone(), window, cx)
+    });
+    settle(cx);
+    assert_eq!(
+        &shown_session(h, cx),
+        session,
+        "fixture: that thread is on screen"
+    );
+}
+
+fn open_menu_on_selection(leaf: &str, cx: &mut VisualTestContext) {
+    select_word(leaf, cx);
+    right_click(leaf, cx);
+    assert!(
+        menu_has("Copy", cx),
+        "precondition: the selection reached the menu"
+    );
+}
+
+fn assert_existing_entries(cx: &mut VisualTestContext, which: &str) {
+    for existing in [
+        "Copy",
+        "Copy as Markdown",
+        "Copy This Agent Response",
+        "Open Thread as Markdown",
+    ] {
+        assert!(menu_has(existing, cx), "R1.7 in {which}: {existing}");
+    }
+    assert!(
+        menu_has("Scroll to Top", cx) || menu_has("Scroll to Bottom", cx),
+        "R1.7 in {which}: the scroll entry (its label follows the scroll position)"
+    );
+}
+
+// Hostile half — R1.9: a selection in a subagent's agent message offers neither entry, and the
+// five existing entries stay.
+#[gpui::test]
+async fn menu_subagent_view_offers_neither_entry(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let root = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    let subagent = spawn_subagent(&h, &root.thread, &mut cx);
+    assert_ne!(subagent, root.session, "fixture: two sessions");
+
+    show(&h, &subagent, &mut cx);
+    open_menu_on_selection(SUBAGENT_LEAF, &mut cx);
+
+    assert!(!menu_has(CLEAN, &mut cx), "R1.9: a subagent's view");
+    assert!(!menu_has(FORK, &mut cx), "R1.9: a subagent's view");
+    assert_existing_entries(&mut cx, "a subagent's view");
+    assert!(
+        h.connection.forked_from().is_empty(),
+        "nothing was forked from the subagent"
+    );
+}
+
+// Converse — the root view of the same conversation keeps both entries, before the subagent is
+// shown and after the view comes back from it (R1.1, R1.2, R1.9).
+#[gpui::test]
+async fn menu_subagent_root_view_still_offers_both_entries(cx: &mut TestAppContext) {
+    let (h, mut cx) = setup(forking(), cx).await;
+    let root = open_parent(&h, vec![agent_says(REPLY)], &mut cx);
+    let subagent = spawn_subagent(&h, &root.thread, &mut cx);
+    assert_eq!(
+        shown_session(&h, &cx),
+        root.session,
+        "fixture: the root is shown"
+    );
+
+    open_menu_on_selection(ROOT_LEAF, &mut cx);
+    assert!(menu_has(CLEAN, &mut cx), "root view, subagent loaded: R1.1");
+    assert!(menu_has(FORK, &mut cx), "root view, subagent loaded: R1.2");
+    assert_existing_entries(&mut cx, "the root view");
+    dismiss_menu(&mut cx);
+
+    show(&h, &subagent, &mut cx);
+    show(&h, &root.session, &mut cx);
+    open_menu_on_selection(ROOT_LEAF, &mut cx);
+    assert!(
+        menu_has(CLEAN, &mut cx),
+        "root view, back from the subagent: R1.1"
+    );
+    assert!(
+        menu_has(FORK, &mut cx),
+        "root view, back from the subagent: R1.2"
+    );
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/pure.rs b/crates/agent_ui/src/sub_thread_tests/pure.rs
new file mode 100644
index 0000000..f0f9898
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/pure.rs
@@ -0,0 +1,221 @@
+// Story 039, task 4.1 — the two pure helpers of `crates/agent_ui/src/sub_thread.rs` (R2.2, R3.2,
+// R4.4; Q5). Wiring: see `support.rs` (this module needs none of it). Filter:
+// `cargo test -p agent_ui sub_thread::pure`.
+//
+// Contract (design.md *Sub-thread orchestration*):
+//   pub fn quote_excerpt(excerpt: &str) -> String — the selection's trailing whitespace trimmed
+//     first; then every line prefixed `> ` (an empty line becomes `>`); then `\n\n`.
+//   pub fn inherited_message_count(entries: &[AgentThreadEntry]) -> usize — user and agent
+//     messages; tool calls and thinking-only entries are not messages.
+//
+// Hostile halves first:
+//   - quoting must not collapse what the selection keeps apart: an interior blank line stays a
+//     line of its own (`>`), and only the selection's END is trimmed — an interior line's two
+//     trailing spaces (a Markdown hard break) and a code line's leading indentation survive;
+//   - counting must neither collapse nor split: a thought-only entry and a tool call are not
+//     messages, and an agent entry holding a thought AND text is ONE message, not two.
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection as _, AgentThreadEntry, StubAgentConnection};
+use agent_client_protocol::schema::v1 as acp_v1;
+use fs::FakeFs;
+use gpui::{Entity, TestAppContext};
+use project::Project;
+use util::path_list::PathList;
+
+use super::{inherited_message_count, quote_excerpt};
+
+// ── quote_excerpt ──────────────────────────────────────────────────────────
+
+#[test]
+fn pure_quote_hostile_an_interior_blank_line_stays_a_bare_marker() {
+    assert_eq!(quote_excerpt("first\n\nsecond"), "> first\n>\n> second\n\n");
+    assert!(
+        !quote_excerpt("first\n\nsecond").contains("> \n"),
+        "an empty line is `>`, with no trailing space"
+    );
+}
+
+#[test]
+fn pure_quote_hostile_only_the_selection_end_is_trimmed() {
+    // "line  " ends in a Markdown hard break: it is inside the selection, so it stays.
+    assert_eq!(
+        quote_excerpt("line  \nnext \n\n  \t"),
+        "> line  \n> next\n\n",
+        "trailing whitespace of the selection is trimmed, an interior line's is kept"
+    );
+    assert_eq!(
+        quote_excerpt("    let x = 1;\n    x"),
+        ">     let x = 1;\n>     x\n\n",
+        "leading indentation is kept"
+    );
+}
+
+#[test]
+fn pure_quote_one_line() {
+    assert_eq!(quote_excerpt("Ship it"), "> Ship it\n\n");
+}
+
+#[test]
+fn pure_quote_several_lines() {
+    assert_eq!(
+        quote_excerpt("Tag the release.\nThen publish."),
+        "> Tag the release.\n> Then publish.\n\n"
+    );
+}
+
+#[test]
+fn pure_quote_keeps_markdown_verbatim() {
+    assert_eq!(
+        quote_excerpt("**Bump** `zeo` to [0.6](https://zeoeditor.dev)\n- then tag"),
+        "> **Bump** `zeo` to [0.6](https://zeoeditor.dev)\n> - then tag\n\n"
+    );
+}
+
+#[test]
+fn pure_quote_always_ends_with_exactly_one_empty_line() {
+    for excerpt in ["a", "a\nb", "a\n\n\n", "a\r\n"] {
+        let quoted = quote_excerpt(excerpt);
+        assert!(quoted.ends_with("\n\n"), "{excerpt:?} -> {quoted:?}");
+        assert!(!quoted.ends_with("\n\n\n"), "{excerpt:?} -> {quoted:?}");
+    }
+}
+
+// ── inherited_message_count ────────────────────────────────────────────────
+
+fn user(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+fn says(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+fn thinks(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::AgentThoughtChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+fn tool(id: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::ToolCall(acp_v1::ToolCall::new(
+        acp_v1::ToolCallId::new(id.to_string()),
+        "Read the changelog",
+    ))
+}
+
+/// A thread whose transcript is exactly `updates`, as an agent would stream (or replay) them.
+async fn thread_of(
+    updates: Vec<acp_v1::SessionUpdate>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    crate::test_support::init_test(cx);
+    let project = Project::test(FakeFs::new(cx.executor()), [], cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    let thread = cx
+        .update(|cx| {
+            connection
+                .clone()
+                .new_session(project, PathList::new(&[Path::new("/project")]), cx)
+        })
+        .await
+        .expect("a stub session");
+    let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+    for update in updates {
+        cx.update(|cx| connection.send_update(session_id.clone(), update, cx));
+    }
+    cx.run_until_parked();
+    thread
+}
+
+/// The entries' shapes: "user", "agent" (with text), "thought" (thought only), "tool".
+fn shapes(thread: &Entity<AcpThread>, cx: &TestAppContext) -> Vec<&'static str> {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .map(|entry| match entry {
+                AgentThreadEntry::UserMessage(_) => "user",
+                AgentThreadEntry::AssistantMessage(message) => {
+                    if message.chunks.iter().any(|chunk| {
+                        matches!(chunk, acp_thread::AssistantMessageChunk::Message { .. })
+                    }) {
+                        "agent"
+                    } else {
+                        "thought"
+                    }
+                }
+                AgentThreadEntry::ToolCall(_) => "tool",
+                _ => "other",
+            })
+            .collect()
+    })
+}
+
+fn count(thread: &Entity<AcpThread>, cx: &TestAppContext) -> usize {
+    thread.read_with(cx, |thread, _| inherited_message_count(thread.entries()))
+}
+
+#[gpui::test]
+async fn pure_count_hostile_thoughts_and_tool_calls_are_not_messages(cx: &mut TestAppContext) {
+    let thread = thread_of(
+        vec![
+            user("Plan it"),
+            thinks("Weighing it"),
+            tool("t1"),
+            says("Done"),
+        ],
+        cx,
+    )
+    .await;
+    assert_eq!(
+        shapes(&thread, cx),
+        ["user", "thought", "tool", "agent"],
+        "fixture"
+    );
+    assert_eq!(count(&thread, cx), 2);
+}
+
+#[gpui::test]
+async fn pure_count_hostile_one_agent_entry_is_one_message_whatever_its_chunks(
+    cx: &mut TestAppContext,
+) {
+    let thread = thread_of(
+        vec![
+            user("Plan it"),
+            thinks("Weighing it"),
+            says("Step one."),
+            says(" Step two."),
+        ],
+        cx,
+    )
+    .await;
+    assert_eq!(
+        shapes(&thread, cx),
+        ["user", "agent"],
+        "fixture: one agent entry"
+    );
+    assert_eq!(count(&thread, cx), 2, "per entry, not per chunk");
+}
+
+#[gpui::test]
+async fn pure_count_users_and_agents_across_turns(cx: &mut TestAppContext) {
+    let thread = thread_of(
+        vec![user("One"), says("Two"), user("Three"), says("Four")],
+        cx,
+    )
+    .await;
+    assert_eq!(
+        shapes(&thread, cx),
+        ["user", "agent", "user", "agent"],
+        "fixture"
+    );
+    assert_eq!(count(&thread, cx), 4);
+}
+
+#[gpui::test]
+async fn pure_count_an_empty_thread_is_zero(cx: &mut TestAppContext) {
+    let thread = thread_of(Vec::new(), cx).await;
+    assert_eq!(count(&thread, cx), 0);
+    assert_eq!(inherited_message_count(&[]), 0);
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/reopen.rs b/crates/agent_ui/src/sub_thread_tests/reopen.rs
new file mode 100644
index 0000000..ed2eb7f
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/reopen.rs
@@ -0,0 +1,276 @@
+// Story 039, task 5.4 — a never-used fork that cannot be reopened (R4.9; Q4). Wiring: `support.rs`,
+// plus, in `crates/agent_ui/src/sub_thread.rs`:
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/reopen.rs"]
+//     mod reopen;                                         // 5.4
+// Filter: `cargo test -p agent_ui sub_thread::reopen`.
+//
+// Contract (design.md v2 *Header and band*, never-used fork): when reopening a thread fails,
+// `ConversationView`'s load-result match checks — before the error becomes a `LoadError` —
+// whether it downcasts to `acp::Error` with code `ResourceNotFound` (-32002) AND the organization
+// store links this thread `with_context`. Only then it shows the `SubThreadUnavailable` state: the
+// header plus "This sub-thread was never used and can't be reopened". Any other case keeps
+// upstream's `handle_load_error` (`ConversationView::load_error()` is `Some`). Row and link stay.
+//
+// Why it happens (story.md, Constraints): the adapter resumes a fork's SDK session to load it, and
+// a fork never prompted has no transcript, so a reload after a restart answers resource-not-found.
+// Here a fake connection answers every `session/load` with the chosen code.
+//
+// SEAM — the one element design.md names no selector for: the state's text, found as
+// `SUB_THREAD_UNAVAILABLE-<the whole text>` (adjust `unavailable_selector` if it is named
+// otherwise). The header keeps support.rs's `SUB_THREAD_HEADER-<text>`.
+//
+// Hostile halves first — the state needs BOTH conditions: the same -32002 on an unlinked or a
+// clean-linked thread, and another code on a with-context thread, all keep the generic error.
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, StubAgentConnection};
+use agent_client_protocol::schema::v2 as acp;
+use chrono::Utc;
+use gpui::{App, Entity, SharedString, Task, TestAppContext, VisualTestContext};
+use project::{AgentId, Project, WorktreePaths};
+use util::path_list::PathList;
+
+use super::test_support::*;
+use crate::test_support::StubAgentServer;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use crate::{Agent, AgentThreadSource};
+
+const NOT_FOUND: i32 = -32002;
+const INTERNAL: i32 = -32603;
+const UNAVAILABLE_TEXT: &str = "This sub-thread was never used and can't be reopened";
+
+fn unavailable_selector() -> String {
+    format!("SUB_THREAD_UNAVAILABLE-{UNAVAILABLE_TEXT}")
+}
+
+/// The Plus adapter reloading a session it cannot find: every `session/load` answers an
+/// `acp::Error` with `code`, wrapped in `anyhow` as `map_acp_error` wraps it.
+#[derive(Clone)]
+struct RefusingReloadConnection {
+    code: i32,
+}
+
+impl AgentConnection for RefusingReloadConnection {
+    fn agent_id(&self) -> AgentId {
+        AgentId::new("stub")
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "stub".into()
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        _project: Entity<Project>,
+        _work_dirs: PathList,
+        _cx: &mut App,
+    ) -> Task<anyhow::Result<Entity<AcpThread>>> {
+        Task::ready(Err(anyhow::anyhow!("these tests only reopen threads")))
+    }
+
+    fn supports_load_session(&self) -> bool {
+        true
+    }
+
+    fn load_session(
+        self: Rc<Self>,
+        _session_id: acp::SessionId,
+        _project: Entity<Project>,
+        _work_dirs: PathList,
+        _title: Option<SharedString>,
+        _cx: &mut App,
+    ) -> Task<anyhow::Result<Entity<AcpThread>>> {
+        let error = agent_client_protocol::Error::new(self.code, "Resource not found");
+        Task::ready(Err(anyhow::Error::new(error)))
+    }
+
+    fn auth_methods(&self) -> &[acp::AuthMethod] {
+        &[]
+    }
+
+    fn authenticate(&self, _method: acp::AuthMethodId, _cx: &mut App) -> Task<anyhow::Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn cancel(&self, _session_id: &acp::SessionId, _cx: &mut App) -> anyhow::Result<()> {
+        Ok(())
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn std::any::Any> {
+        self
+    }
+}
+
+/// A panel whose `Agent::Stub` answers every reload with `code`.
+async fn refusing_panel(code: i32, cx: &mut TestAppContext) -> (Harness, VisualTestContext) {
+    let (h, mut cx) = setup(StubAgentConnection::new(), cx).await;
+    let store = h
+        .panel
+        .read_with(&cx, |panel, _| panel.connection_store().clone());
+    store.update(&mut cx, |store, cx| {
+        store.restart_connection(
+            Agent::Stub,
+            Rc::new(
+                StubAgentServer::new(RefusingReloadConnection { code }).with_connection_agent_id(),
+            ),
+            cx,
+        );
+    });
+    cx.run_until_parked();
+    (h, cx)
+}
+
+/// A saved thread of `PROJECT` on the stub agent, with a session (a sent message or a fork).
+fn saved_thread(session: &str, title: &str, cx: &mut VisualTestContext) -> ThreadId {
+    let now = Utc::now();
+    let metadata = ThreadMetadata {
+        thread_id: ThreadId::new(),
+        session_id: Some(acp::SessionId::new(session)),
+        agent_id: AgentId::new("stub"),
+        title: Some(title.to_string().into()),
+        title_override: None,
+        updated_at: now,
+        created_at: Some(now),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(PROJECT)])),
+        remote_connection: None,
+        archived: false,
+    };
+    let id = metadata.thread_id;
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+    id
+}
+
+fn link(child: ThreadId, parent: ThreadId, kind: ForkKind, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_parent(child, parent, kind, cx)
+                .expect("two saved threads can be linked")
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// Reopens `id` the way the sidebar and the history do.
+fn reopen(h: &Harness, id: ThreadId, cx: &mut VisualTestContext) {
+    h.panel.update_in(cx, |panel, window, cx| {
+        panel.load_agent_thread(
+            Agent::Stub,
+            id,
+            Some(PathList::new(&[Path::new(PROJECT)])),
+            None,
+            true,
+            AgentThreadSource::Sidebar,
+            window,
+            cx,
+        )
+    });
+    settle(cx);
+}
+
+fn generic_load_error(h: &Harness, cx: &VisualTestContext) -> bool {
+    h.panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .is_some_and(|view| view.read(cx).load_error().is_some())
+    })
+}
+
+struct Fixture {
+    h: Harness,
+    cx: VisualTestContext,
+    parent: ThreadId,
+    child: ThreadId,
+}
+
+/// A parent and a child saved on the stub agent, the child linked with `kind` (or not), then
+/// reopened on an agent answering `code`.
+async fn reopened(code: i32, kind: Option<ForkKind>, cx: &mut TestAppContext) -> Fixture {
+    let (h, mut cx) = refusing_panel(code, cx).await;
+    let parent = saved_thread("parent-session", PARENT_TITLE, &mut cx);
+    let child = saved_thread("never-used-fork", "Forkling", &mut cx);
+    if let Some(kind) = kind {
+        link(child, parent, kind, &mut cx);
+    }
+    reopen(&h, child, &mut cx);
+    assert_eq!(
+        active_id(&h, &cx),
+        child,
+        "fixture: the child is the one reopened"
+    );
+    Fixture {
+        h,
+        cx,
+        parent,
+        child,
+    }
+}
+
+// Hostile half — the same -32002 on a thread with no link is an ordinary load failure.
+#[gpui::test]
+async fn reopen_hostile_unlinked_thread_keeps_the_generic_error(cx: &mut TestAppContext) {
+    let Fixture { h, mut cx, .. } = reopened(NOT_FOUND, None, cx).await;
+    assert!(generic_load_error(&h, &cx), "upstream's load error");
+    assert!(!painted(&unavailable_selector(), &mut cx));
+}
+
+// Hostile half — a CLEAN sub-thread inherited nothing to lose: generic error, no special state.
+#[gpui::test]
+async fn reopen_hostile_clean_sub_thread_keeps_the_generic_error(cx: &mut TestAppContext) {
+    let Fixture { h, mut cx, .. } = reopened(NOT_FOUND, Some(ForkKind::Clean), cx).await;
+    assert!(generic_load_error(&h, &cx), "upstream's load error");
+    assert!(!painted(&unavailable_selector(), &mut cx));
+}
+
+// Hostile half — a with-context sub-thread failing with ANOTHER code is an ordinary failure.
+#[gpui::test]
+async fn reopen_hostile_other_error_code_keeps_the_generic_error(cx: &mut TestAppContext) {
+    let Fixture { h, mut cx, .. } = reopened(INTERNAL, Some(ForkKind::WithContext), cx).await;
+    assert!(generic_load_error(&h, &cx), "upstream's load error");
+    assert!(!painted(&unavailable_selector(), &mut cx));
+}
+
+// R4.9 — a with-context sub-thread whose reload is not found: its own state with the header, and
+// its row and link kept.
+#[gpui::test]
+async fn reopen_never_used_fork_shows_its_own_state(cx: &mut TestAppContext) {
+    let Fixture {
+        h,
+        mut cx,
+        parent,
+        child,
+    } = reopened(NOT_FOUND, Some(ForkKind::WithContext), cx).await;
+
+    assert!(
+        painted(&unavailable_selector(), &mut cx),
+        "R4.9: the state's text"
+    );
+    assert!(
+        painted(
+            &header_selector(&format!("Sub-thread of: {PARENT_TITLE}")),
+            &mut cx
+        ),
+        "R4.9: the header stays"
+    );
+    assert_eq!(
+        parent_link(child, &mut cx),
+        Some((parent, ForkKind::WithContext)),
+        "R4.9: the link stays"
+    );
+    assert!(
+        cx.update(|_, cx| ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(child)
+            .is_some()),
+        "R4.9: the row stays"
+    );
+    assert_eq!(active_id(&h, &cx), child, "nothing else was opened instead");
+}
diff --git a/crates/agent_ui/src/sub_thread_tests/support.rs b/crates/agent_ui/src/sub_thread_tests/support.rs
new file mode 100644
index 0000000..a2a6293
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread_tests/support.rs
@@ -0,0 +1,500 @@
+// Story 039 — shared fixtures for the sub-thread tests of tasks 4.2–5.4 (task 4.1's `pure` needs
+// none of them). One file per sub-task, so a sub-task's Green never depends on a later sub-task's
+// API (a test module naming a missing item breaks the whole crate's test build), and no file
+// passes 500 lines.
+//
+// Wired INSIDE `crates/agent_ui/src/sub_thread.rs`, so the test paths match the Validation
+// filters `sub_thread::{pure,clean,fork,menu,header,reopen}`:
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/pure.rs"]
+//     mod pure;                                           // 4.1
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/support.rs"]
+//     mod test_support;                                   // with 4.2
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/clean.rs"]
+//     mod clean;                                          // 4.2
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/fork.rs"]
+//     mod fork;                                           // 4.3
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/menu.rs"]
+//     mod menu;                                           // 5.1
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/header.rs"]
+//     mod header;                                         // 5.2
+//     #[cfg(test)]
+//     #[path = "sub_thread_tests/reopen.rs"]
+//     mod reopen;                                         // 5.4
+// (tasks.md names one file, `sub_thread_tests.rs`; it is split for the two reasons above.)
+//
+// Contract (design.md *Sub-thread orchestration*): `SubThreadRequest { parent_thread_id,
+// parent_session_id, agent, work_dirs, kind, excerpt, inherited_messages }` and
+// `AgentPanel::open_sub_thread(&mut self, request, focus: bool, window, cx) ->
+// Task<Result<Entity<ConversationView>>>`.
+//
+// One stub for every thread: the parent, the clean sub-threads and the forks all run on ONE
+// `StubAgentConnection` registered as `Agent::Stub` in the panel's connection store — as every
+// thread of one external agent shares one `AcpConnection` in Zeo — so the session a fork
+// registers is the one the forked view attaches to.
+//
+// SEAMS — the only lines naming elements design.md does not name (adjust HERE if the
+// implementation names them otherwise; each is a debug selector):
+//   `header_selector(text)`  "SUB_THREAD_HEADER-<the header's whole text>"
+//   `band_selector(text)`    "SUB_THREAD_BAND-<the band's whole text>"
+//   `PARENT_BUTTON`          "SUB_THREAD_PARENT", the clickable parent title
+// The menu needs no seam: upstream's `ContextMenu` paints every entry as `MENU_ITEM-<label>`.
+
+use std::path::Path;
+use std::rc::Rc;
+use std::time::Duration;
+
+use acp_thread::{AcpThread, AgentThreadEntry, StubAgentConnection};
+use agent_client_protocol::schema::{v1 as acp_v1, v2 as acp};
+use fs::FakeFs;
+use futures::FutureExt as _;
+use gpui::{
+    AppContext as _, Entity, Focusable as _, Modifiers, MouseButton, SharedString, TestAppContext,
+    VisualTestContext, point, px,
+};
+use project::{AgentId, Project};
+use serde_json::json;
+use util::path_list::PathList;
+use workspace::{MultiWorkspace, Workspace};
+
+use super::SubThreadRequest;
+use crate::test_support::StubAgentServer;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use crate::{Agent, AgentPanel, ConversationView, NewExternalAgentThread};
+
+pub const PROJECT: &str = "/project";
+pub const PARENT_TITLE: &str = "Plan the release";
+
+pub fn header_selector(text: &str) -> String {
+    format!("SUB_THREAD_HEADER-{text}")
+}
+
+pub fn band_selector(text: &str) -> String {
+    format!("SUB_THREAD_BAND-{text}")
+}
+
+pub const PARENT_BUTTON: &str = "SUB_THREAD_PARENT";
+
+pub struct Harness {
+    pub panel: Entity<AgentPanel>,
+    pub workspace: Entity<Workspace>,
+    pub connection: StubAgentConnection,
+}
+
+pub struct Parent {
+    pub id: ThreadId,
+    pub session: acp::SessionId,
+    pub thread: Entity<AcpThread>,
+}
+
+/// A visible agent panel on `PROJECT`, the organization store installed as Zeo installs it, and
+/// `connection` serving `Agent::Stub`.
+pub async fn setup(
+    connection: StubAgentConnection,
+    cx: &mut TestAppContext,
+) -> (Harness, VisualTestContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        cx.bind_keys([gpui::KeyBinding::new("escape", menu::Cancel, Some("menu"))]); // no keymap
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        crate::thread_organization::init(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree(PROJECT, json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new(PROJECT)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    vcx.simulate_resize(gpui::size(px(1200.), px(800.)));
+    let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    vcx.run_until_parked();
+    let store = panel.read_with(&vcx, |panel, _| panel.connection_store().clone());
+    store.update(&mut vcx, |store, cx| {
+        store.restart_connection(
+            Agent::Stub,
+            Rc::new(StubAgentServer::new(connection.clone()).with_connection_agent_id()),
+            cx,
+        );
+    });
+    vcx.run_until_parked();
+    (
+        Harness {
+            panel,
+            workspace,
+            connection,
+        },
+        vcx,
+    )
+}
+
+pub fn agent_says(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+pub fn agent_thinks(text: &str) -> acp_v1::SessionUpdate {
+    acp_v1::SessionUpdate::AgentThoughtChunk(acp_v1::ContentChunk::new(text.into()))
+}
+
+/// Lets deferred work (a would-be auto-submit, a deferred store write) run out.
+pub fn settle(cx: &mut VisualTestContext) {
+    cx.run_until_parked();
+    cx.executor().advance_clock(Duration::from_secs(5));
+    cx.run_until_parked();
+}
+
+pub fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Types `text` into the active thread's composer and sends it.
+pub fn send_text(h: &Harness, text: &str, cx: &mut VisualTestContext) {
+    let view = h
+        .panel
+        .read_with(cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("an active thread view");
+    let editor = view.read_with(cx, |view, _| view.message_editor.clone());
+    editor.update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    view.update_in(cx, |view, window, cx| view.send(window, cx));
+    settle(cx);
+}
+
+/// Types `text` into the active composer without sending it.
+pub fn type_text(h: &Harness, text: &str, cx: &mut VisualTestContext) {
+    let view = h
+        .panel
+        .read_with(cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("an active thread view");
+    let editor = view.read_with(cx, |view, _| view.message_editor.clone());
+    editor.update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    cx.run_until_parked();
+}
+
+/// A thread on `Agent::Stub` that has had one turn answered with `reply`, titled `PARENT_TITLE`.
+pub fn open_parent(
+    h: &Harness,
+    reply: Vec<acp_v1::SessionUpdate>,
+    cx: &mut VisualTestContext,
+) -> Parent {
+    h.panel.update_in(cx, |panel, window, cx| {
+        panel.new_external_agent_thread(
+            &NewExternalAgentThread {
+                agent: AgentId::new("stub"),
+            },
+            window,
+            cx,
+        )
+    });
+    cx.run_until_parked();
+    h.connection.set_next_prompt_updates(reply);
+    send_text(h, "Plan the release, please.", cx);
+    let id = active_id(h, cx);
+    let thread = active_thread(h, cx);
+    let session = thread.read_with(cx, |thread, _| thread.session_id().clone());
+    rename(id, PARENT_TITLE, cx);
+    assert!(
+        entry_count(&thread, cx) >= 2,
+        "fixture: the parent has a turn"
+    );
+    Parent {
+        id,
+        session,
+        thread,
+    }
+}
+
+pub fn request(
+    parent: &Parent,
+    kind: ForkKind,
+    excerpt: &str,
+    inherited_messages: Option<usize>,
+) -> SubThreadRequest {
+    SubThreadRequest {
+        parent_thread_id: parent.id,
+        parent_session_id: parent.session.clone(),
+        agent: Agent::Stub,
+        work_dirs: Some(PathList::new(&[Path::new(PROJECT)])),
+        kind,
+        excerpt: SharedString::from(excerpt.to_string()),
+        inherited_messages,
+    }
+}
+
+/// Opens a sub-thread and returns what `open_sub_thread`'s task resolved to, once the panel has
+/// settled (the stub answers at once, so the task is done by then).
+pub fn try_open_sub_thread(
+    h: &Harness,
+    request: SubThreadRequest,
+    focus: bool,
+    cx: &mut VisualTestContext,
+) -> anyhow::Result<Entity<ConversationView>> {
+    let task = h.panel.update_in(cx, |panel, window, cx| {
+        panel.open_sub_thread(request, focus, window, cx)
+    });
+    settle(cx);
+    task.now_or_never()
+        .expect("open_sub_thread resolves once the panel has settled")
+}
+
+/// A focused open that must succeed; the returned conversation is the active one.
+pub fn open_sub_thread(
+    h: &Harness,
+    request: SubThreadRequest,
+    cx: &mut VisualTestContext,
+) -> Entity<ConversationView> {
+    let view = try_open_sub_thread(h, request, true, cx).expect("the sub-thread opens");
+    assert_eq!(
+        h.panel
+            .read_with(cx, |panel, _| panel.active_conversation_view().cloned()),
+        Some(view.clone()),
+        "the returned conversation is the one shown"
+    );
+    view
+}
+
+// ── Reads ──────────────────────────────────────────────────────────────────
+
+pub fn active_id(h: &Harness, cx: &VisualTestContext) -> ThreadId {
+    h.panel
+        .read_with(cx, |panel, cx| panel.active_thread_id(cx))
+        .expect("an active thread")
+}
+
+pub fn active_thread(h: &Harness, cx: &VisualTestContext) -> Entity<AcpThread> {
+    h.panel
+        .read_with(cx, |panel, cx| panel.active_agent_thread(cx))
+        .expect("an active agent thread")
+}
+
+pub fn active_agent_id(h: &Harness, cx: &VisualTestContext) -> AgentId {
+    h.panel.read_with(cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .expect("a conversation is active")
+            .read(cx)
+            .agent_key()
+            .id()
+    })
+}
+
+pub fn composer(h: &Harness, id: ThreadId, cx: &VisualTestContext) -> Option<String> {
+    h.panel.read_with(cx, |panel, cx| panel.editor_text(id, cx))
+}
+
+pub fn composer_focused(h: &Harness, cx: &mut VisualTestContext) -> bool {
+    let view = h
+        .panel
+        .read_with(cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("an active thread view");
+    let editor = view.read_with(cx, |view, _| view.message_editor.clone());
+    cx.update(|window, cx| editor.focus_handle(cx).contains_focused(window, cx))
+}
+
+pub fn entry_count(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| thread.entries().len())
+}
+
+pub fn user_messages(thread: &Entity<AcpThread>, cx: &VisualTestContext) -> usize {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .filter(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)))
+            .count()
+    })
+}
+
+pub fn parent_link(child: ThreadId, cx: &mut VisualTestContext) -> Option<(ThreadId, ForkKind)> {
+    cx.update(|_, cx| ThreadOrganizationStore::global(cx).read(cx).parent(child))
+}
+
+pub fn children(parent: ThreadId, cx: &mut VisualTestContext) -> Vec<ThreadId> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .children(parent)
+    })
+}
+
+pub fn toasts(h: &Harness, cx: &VisualTestContext) -> usize {
+    h.workspace
+        .read_with(cx, |workspace, _| workspace.notification_ids().len())
+}
+
+pub fn retained(h: &Harness, cx: &VisualTestContext) -> usize {
+    h.panel
+        .read_with(cx, |panel, _| panel.retained_threads().len())
+}
+
+pub fn rename(id: ThreadId, title: &str, cx: &mut VisualTestContext) {
+    let title = SharedString::from(title.to_string());
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .update(cx, |store, cx| store.set_title_override(id, title, cx))
+    });
+    cx.run_until_parked();
+}
+
+pub fn activate(h: &Harness, id: ThreadId, cx: &mut VisualTestContext) {
+    h.panel.update_in(cx, |panel, window, cx| {
+        panel.activate_retained_thread(id, true, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(active_id(h, cx), id, "fixture: the thread is active again");
+}
+
+pub fn remove(h: &Harness, id: ThreadId, cx: &mut VisualTestContext) {
+    h.panel
+        .update_in(cx, |panel, window, cx| panel.remove_thread(id, window, cx));
+    settle(cx);
+}
+
+// ── The rendered panel ─────────────────────────────────────────────────────
+
+pub fn painted(selector: &str, cx: &mut VisualTestContext) -> bool {
+    draw(cx);
+    cx.debug_bounds(selector.to_string().leak()).is_some()
+}
+
+/// Double-clicks a word of the content leaf `selector` (upstream's selection recipe,
+/// `test_message_context_menu_copies_selected_content`).
+pub fn select_word(selector: &str, cx: &mut VisualTestContext) {
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector.to_string().leak())
+        .expect("the content leaf is painted");
+    let position = bounds.origin + point(px(12.), bounds.size.height / 2.);
+    cx.simulate_event(gpui::MouseDownEvent {
+        position,
+        button: MouseButton::Left,
+        modifiers: Modifiers::default(),
+        click_count: 2,
+        first_mouse: false,
+    });
+    cx.simulate_mouse_up(position, MouseButton::Left, Modifiers::default());
+    cx.run_until_parked();
+}
+
+pub fn right_click_at(position: gpui::Point<gpui::Pixels>, cx: &mut VisualTestContext) {
+    cx.simulate_mouse_down(position, MouseButton::Right, Modifiers::default());
+    cx.simulate_mouse_up(position, MouseButton::Right, Modifiers::default());
+    draw(cx);
+}
+
+pub fn right_click(selector: &str, cx: &mut VisualTestContext) {
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector.to_string().leak())
+        .expect("the content leaf is painted");
+    right_click_at(bounds.origin + point(px(12.), bounds.size.height / 2.), cx);
+}
+
+pub fn menu_has(label: &str, cx: &mut VisualTestContext) -> bool {
+    cx.debug_bounds(format!("MENU_ITEM-{label}").leak())
+        .is_some()
+}
+
+pub fn click_menu(label: &str, cx: &mut VisualTestContext) {
+    let item = cx
+        .debug_bounds(format!("MENU_ITEM-{label}").leak())
+        .unwrap_or_else(|| panic!("the menu shows {label}"));
+    cx.simulate_click(item.center(), Modifiers::default());
+    settle(cx);
+}
+
+pub fn dismiss_menu(cx: &mut VisualTestContext) {
+    // No frame loop here, and `right_click_menu` focuses a menu on its second frame.
+    for _ in 0..2 {
+        cx.update(|window, cx| window.simulate_next_frame(cx));
+    }
+    cx.simulate_keystrokes("escape");
+    draw(cx);
+}
+
+pub fn click(selector: &str, cx: &mut VisualTestContext) {
+    draw(cx);
+    let bounds = cx
+        .debug_bounds(selector.to_string().leak())
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::default());
+    settle(cx);
+}
+
+// ── Log lines (the capture of patch 0048's test helpers) ───────────────────
+
+pub(crate) use crate::thread_organization::test_helpers::{all_lines_lowercased, capture_logs};
+
+/// The line's words, split on anything that is not a letter, a digit, '-' or '_'.
+pub fn tokens(line: &str) -> Vec<&str> {
+    line.split(|c: char| !(c.is_alphanumeric() || c == '-' || c == '_'))
+        .filter(|token| !token.is_empty())
+        .collect()
+}
+
+/// Captured lines that carry every one of `words` as a whole token.
+pub fn lines_with_tokens(words: &[&str]) -> Vec<String> {
+    all_lines_lowercased()
+        .into_iter()
+        .filter(|line| {
+            let tokens = tokens(line);
+            words
+                .iter()
+                .all(|word| tokens.contains(&word.to_lowercase().as_str()))
+        })
+        .collect()
+}
+
+/// R7.1's line, `zeo_sub_thread event=created parent_session=<id> session=<id>
+/// kind=<with_context|clean> excerpt_chars=<n>`: exactly one, with exactly these values. Read
+/// word by word, so `session=` never matches inside `parent_session=`.
+pub fn assert_one_created_line(parent_session: &str, session: &str, kind: &str, chars: usize) {
+    let created: Vec<Vec<String>> = all_lines_lowercased()
+        .into_iter()
+        .map(|line| line.split_whitespace().map(str::to_string).collect())
+        .filter(|words: &Vec<String>| {
+            words.iter().any(|w| w == "zeo_sub_thread")
+                && words.iter().any(|w| w == "event=created")
+        })
+        .collect();
+    assert_eq!(
+        created.len(),
+        1,
+        "one created line per sub-thread: {:?}",
+        all_lines_lowercased()
+    );
+    for expected in [
+        format!("parent_session={}", parent_session.to_lowercase()),
+        format!("session={}", session.to_lowercase()),
+        format!("kind={kind}"),
+        format!("excerpt_chars={chars}"),
+    ] {
+        assert!(
+            created[0].contains(&expected),
+            "{expected} missing from {:?}",
+            created[0]
+        );
+    }
+}
+
+/// A captured warning about a failed fork naming `parent_session` and carrying `code=none`
+/// (R3.6: not an agent error).
+pub fn has_fork_failure_line(parent_session: &str) -> bool {
+    lines_with_tokens(&[parent_session])
+        .iter()
+        .any(|line| line.split_whitespace().any(|word| word == "code=none"))
+}
