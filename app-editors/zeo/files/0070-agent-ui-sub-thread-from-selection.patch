diff --git a/crates/agent_ui/src/sub_thread.rs b/crates/agent_ui/src/sub_thread.rs
new file mode 100644
index 0000000..59a1fd1
--- /dev/null
+++ b/crates/agent_ui/src/sub_thread.rs
@@ -0,0 +1,350 @@
+//! Sub-threads opened from a selection in a thread (story 039): a clean thread that starts
+//! from the quoted excerpt, or a fork of the parent session that inherits its conversation.
+
+mod forked_sub_thread;
+mod message_menu;
+
+pub(crate) use message_menu::menu_entries;
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use acp_thread::{AgentThreadEntry, AssistantMessageChunk};
+use agent_client_protocol::schema::v2 as acp_v2;
+use anyhow::{Result, anyhow};
+use gpui::{App, Context, Entity, SharedString, Subscription, Task, Window};
+use util::path_list::PathList;
+
+use crate::conversation_view::{ConversationView, RootThreadUpdated};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::{ForkKind, ThreadOrganizationStore};
+use crate::{Agent, AgentPanel};
+
+/// What the "sub-thread" menu entries hand to the panel.
+pub struct SubThreadRequest {
+    pub parent_thread_id: ThreadId,
+    pub parent_session_id: acp_v2::SessionId,
+    pub agent: Agent,
+    pub work_dirs: Option<PathList>,
+    pub kind: ForkKind,
+    pub excerpt: SharedString,
+    /// Known only when the fork is made (R4.4); `None` after a restart (R4.5).
+    pub inherited_messages: Option<usize>,
+}
+
+/// The selection as a Markdown quote followed by an empty line, so the composer opens with the
+/// cursor below it (R2.2, R3.2). Only the selection's end is trimmed: an interior line's
+/// trailing spaces are a Markdown hard break, and leading indentation is code.
+pub fn quote_excerpt(excerpt: &str) -> String {
+    let mut quoted = String::new();
+    for line in excerpt.trim_end().lines() {
+        if line.is_empty() {
+            quoted.push('>');
+        } else {
+            quoted.push_str("> ");
+            quoted.push_str(line);
+        }
+        quoted.push('\n');
+    }
+    quoted.push('\n');
+    quoted
+}
+
+/// The user and agent messages a fork inherits (R4.4). Counted per entry, not per chunk; an
+/// agent entry holding only thoughts is not a message, and neither is a tool call.
+pub fn inherited_message_count(entries: &[AgentThreadEntry]) -> usize {
+    entries
+        .iter()
+        .filter(|entry| match entry {
+            // A message between sessions, such as a parent and its subagent, is part of the
+            // transcript the fork inherits.
+            AgentThreadEntry::UserMessage(_) | AgentThreadEntry::SessionMessage(_) => true,
+            AgentThreadEntry::AssistantMessage(message) => message
+                .chunks
+                .iter()
+                .any(|chunk| matches!(chunk, AssistantMessageChunk::Message { .. })),
+            AgentThreadEntry::ToolCall(_)
+            | AgentThreadEntry::Elicitation(_)
+            | AgentThreadEntry::ContextCompaction(_) => false,
+        })
+        .count()
+}
+
+/// A sub-thread's link to its parent, held by the child's view until the child has a session:
+/// the organization store refuses to link a draft (story 031), and a clean sub-thread stays one
+/// until its first message.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct PendingParentLink {
+    pub child: ThreadId,
+    pub parent: ThreadId,
+    pub kind: ForkKind,
+}
+
+/// What a `ConversationView` keeps for the sub-thread it may be.
+#[derive(Default)]
+pub(crate) struct SubThreadViewState {
+    pending_parent_link: Option<PendingParentLink>,
+    // Known only when the fork is made (R4.4); read by the inherited band.
+    inherited_messages: Option<usize>,
+}
+
+impl SubThreadViewState {
+    pub(crate) fn inherited_messages(&self) -> Option<usize> {
+        self.inherited_messages
+    }
+}
+
+impl AgentPanel {
+    /// Opens a sub-thread of `request.parent_thread_id` with the quoted excerpt in its composer,
+    /// unsent, and resolves to its conversation. Takes ids and text rather than a thread view, so
+    /// a caller other than the message menu (a devtools sub-thread) can use it.
+    pub fn open_sub_thread(
+        &mut self,
+        request: SubThreadRequest,
+        focus: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<Entity<ConversationView>>> {
+        match request.kind {
+            ForkKind::Clean => Task::ready(self.open_clean_sub_thread(request, focus, window, cx)),
+            ForkKind::WithContext => self.open_forked_sub_thread(request, focus, window, cx),
+        }
+    }
+
+    fn open_clean_sub_thread(
+        &mut self,
+        request: SubThreadRequest,
+        focus: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Result<Entity<ConversationView>> {
+        let SubThreadRequest {
+            parent_thread_id,
+            parent_session_id,
+            agent,
+            excerpt,
+            ..
+        } = request;
+        let agent_id = agent.id();
+        let Some(view) = self.new_thread_with_prefilled_prompt(
+            agent,
+            parent_session_id.clone(),
+            quote_excerpt(&excerpt),
+            focus,
+            window,
+            cx,
+        ) else {
+            // 0045 opens nothing in two cases. A panel with no open project is skipped without a
+            // word, so it is said here; a gone agent has already had 0045's toast and warning
+            // (R2.5), and nothing is added to them.
+            if !self.has_open_project(cx) {
+                log::warn!(
+                    "zeo_sub_thread event=open_failed parent_session={parent_session_id} kind=clean reason=no_open_project"
+                );
+                return Err(anyhow!("the agent panel has no open project"));
+            }
+            return Err(anyhow!("agent {agent_id} is not available"));
+        };
+        let child = view.read(cx).thread_id;
+        view.update(cx, |view, _| {
+            view.set_pending_parent_link(PendingParentLink {
+                child,
+                parent: parent_thread_id,
+                kind: ForkKind::Clean,
+            })
+        });
+        log_created_once_connected(
+            &view,
+            parent_session_id,
+            ForkKind::Clean,
+            excerpt.chars().count(),
+            cx,
+        );
+        Ok(view)
+    }
+}
+
+/// A clean sub-thread's session exists only once its view has connected, after the open returns.
+fn log_created_once_connected(
+    view: &Entity<ConversationView>,
+    parent_session: acp_v2::SessionId,
+    kind: ForkKind,
+    excerpt_chars: usize,
+    cx: &mut Context<AgentPanel>,
+) {
+    fn root_session(view: &Entity<ConversationView>, cx: &App) -> Option<acp_v2::SessionId> {
+        let thread = view.read(cx).root_thread(cx)?;
+        Some(thread.read(cx).session_id().clone())
+    }
+    if let Some(session) = root_session(view, cx) {
+        log_sub_thread_created(&parent_session, &session, kind, excerpt_chars);
+        return;
+    }
+    let mut parent_session = Some(parent_session);
+    cx.subscribe(view, move |_, view, _: &RootThreadUpdated, cx| {
+        if parent_session.is_some()
+            && let Some(session) = root_session(&view, cx)
+            && let Some(parent_session) = parent_session.take()
+        {
+            log_sub_thread_created(&parent_session, &session, kind, excerpt_chars);
+        }
+    })
+    .detach();
+}
+
+/// R7.1. Ids, the kind and a length only: the excerpt and the titles are the user's text.
+/// `zeo_sub_thread` is in the message, not the log target, so every sink (and 0048's test
+/// capture, which reads only the message) sees it.
+pub(crate) fn log_sub_thread_created(
+    parent_session: &acp_v2::SessionId,
+    session: &acp_v2::SessionId,
+    kind: ForkKind,
+    excerpt_chars: usize,
+) {
+    log::info!(
+        "zeo_sub_thread event=created parent_session={parent_session} session={session} kind={} excerpt_chars={excerpt_chars}",
+        fork_kind_label(kind)
+    );
+}
+
+// 0048 keeps its own spelling private; this is the same one, for log lines.
+fn fork_kind_label(kind: ForkKind) -> &'static str {
+    match kind {
+        ForkKind::WithContext => "with_context",
+        ForkKind::Clean => "clean",
+    }
+}
+
+/// Writes the link once; a refusal leaves the sub-thread open and usable (R7.2). The caller has
+/// already dropped the pending link, so a refused link is never retried: `set_parent` would
+/// refuse every later attempt the same way, or with "already has a parent".
+pub(crate) fn record_parent_link(child: ThreadId, parent: ThreadId, kind: ForkKind, cx: &mut App) {
+    static STORE_ABSENT_WARNED: AtomicBool = AtomicBool::new(false);
+    let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+        if !STORE_ABSENT_WARNED.swap(true, Ordering::Relaxed) {
+            log::warn!(
+                "zeo_sub_thread event=link_failed reason=no_organization_store: sub-thread links are not recorded"
+            );
+        }
+        return;
+    };
+    if let Err(error) = store.update(cx, |store, cx| store.set_parent(child, parent, kind, cx)) {
+        log::warn!(
+            "zeo_sub_thread event=link_failed child={} parent={} kind={}: {error}",
+            child.to_key_string(),
+            parent.to_key_string(),
+            fork_kind_label(kind)
+        );
+    }
+}
+
+/// R2.6: a clean sub-thread whose composer was emptied is reused as the panel's next new thread,
+/// which is no longer the sub-thread. Dropped here, at the reuse, rather than when the view moves
+/// into the draft slot: a first send also empties the composer, and the view passes through that
+/// slot until the sent message lands.
+pub(crate) fn drop_link_of_reused_draft(
+    draft: &Entity<ConversationView>,
+    has_editor_content: bool,
+    cx: &mut App,
+) {
+    if !has_editor_content {
+        draft.update(cx, |view, _| view.take_pending_parent_link());
+    }
+}
+
+/// The observations a `ConversationView` keeps for its sub-thread state: the pending link waits
+/// on the metadata store, and the header (R4) changes with both stores.
+pub(crate) fn observe_sub_thread_stores(cx: &mut Context<ConversationView>) -> Vec<Subscription> {
+    let mut subscriptions = Vec::new();
+    if let Some(metadata) = ThreadMetadataStore::try_global(cx) {
+        subscriptions.push(cx.observe(&metadata, |view, _, cx| view.sub_thread_stores_changed(cx)));
+    }
+    if let Some(organization) = ThreadOrganizationStore::try_global(cx) {
+        subscriptions.push(cx.observe(&organization, |view, _, cx| {
+            view.sub_thread_stores_changed(cx)
+        }));
+    }
+    subscriptions
+}
+
+/// The metadata store withholds a draft's session id, and the organization store admits only a
+/// thread that has one.
+fn thread_has_session(thread_id: ThreadId, cx: &App) -> bool {
+    ThreadMetadataStore::try_global(cx).is_some_and(|store| {
+        store
+            .read(cx)
+            .entry(thread_id)
+            .is_some_and(|entry| !entry.is_draft())
+    })
+}
+
+impl ConversationView {
+    pub(crate) fn set_pending_parent_link(&mut self, link: PendingParentLink) {
+        self.sub_thread.pending_parent_link = Some(link);
+    }
+
+    pub(crate) fn take_pending_parent_link(&mut self) -> Option<PendingParentLink> {
+        self.sub_thread.pending_parent_link.take()
+    }
+
+    fn sub_thread_stores_changed(&mut self, cx: &mut Context<Self>) {
+        if self
+            .sub_thread
+            .pending_parent_link
+            .is_some_and(|link| thread_has_session(link.child, cx))
+            && let Some(link) = self.take_pending_parent_link()
+        {
+            // Deferred: a store write reached from a metadata-store change re-enters it (story
+            // 031), and the organization store reads the metadata store to admit the link.
+            cx.defer(move |cx| record_parent_link(link.child, link.parent, link.kind, cx));
+        }
+        let linked = ThreadOrganizationStore::try_global(cx)
+            .is_some_and(|store| store.read(cx).parent(self.thread_id).is_some());
+        if !linked {
+            return;
+        }
+        match self.root_thread_view() {
+            Some(thread_view) => thread_view.update(cx, |_, cx| cx.notify()),
+            // The unavailable state (R4.9) draws the header itself, with no thread view.
+            None => cx.notify(),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "sub_thread_tests/pure.rs"]
+mod pure;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/support.rs"]
+mod test_support;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/clean.rs"]
+mod clean;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/fork.rs"]
+mod fork;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/fork_abandoned.rs"]
+mod fork_abandoned;
+
+// A frozen assertion clones a session id on its last use; the lint is silenced here rather than
+// edited there.
+#[cfg(test)]
+#[allow(clippy::redundant_clone)]
+#[path = "sub_thread_tests/menu.rs"]
+mod menu;
+
+#[cfg(test)]
+#[path = "sub_thread_tests/menu_subagent.rs"]
+mod menu_subagent;
+
+#[cfg(test)]
