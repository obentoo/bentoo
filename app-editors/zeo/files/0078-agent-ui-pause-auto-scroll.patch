+    /// Pausing puts the list in `FollowMode::Normal`, so it never follows the tail, even when
+    /// the view sits at the bottom. A plain scroll up only stops following until the bottom is
+    /// reached again, which is the implicit pause upstream already has. Resuming is
+    /// `FollowMode::Tail`, which snaps to the end.
+    pub(crate) fn toggle_auto_scroll_pause(&mut self, cx: &mut Context<Self>) {
+        if self.auto_scroll_paused_at.take().is_some() {
+            self.list_state.set_follow_mode(gpui::FollowMode::Tail);
+        } else {
+            self.auto_scroll_paused_at = Some(self.thread.read(cx).entries().len());
+            self.list_state.set_follow_mode(gpui::FollowMode::Normal);
+        }
+        cx.notify();
+    }
+
     fn is_last_turn_in_progress(&self, cx: &App) -> bool {
         let thread = self.thread.read(cx);
         matches!(thread.status(), ThreadStatus::Generating)
