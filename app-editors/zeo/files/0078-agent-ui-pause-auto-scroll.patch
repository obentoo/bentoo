         div()
             .absolute()
@@ -8976,6 +8989,23 @@ impl ThreadView {
                     .bg(cx.theme().colors().elevated_surface_background)
                     .opacity(0.4)
                     .hover(|s| s.opacity(1.))
+                    .child(
+                        IconButton::new("floating_toggle_auto_scroll", pause_icon)
+                            .icon_size(IconSize::Small)
