From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zed-patches <zed-patches@localhost>
Date: Tue, 24 Nov 2026 17:37:38 -0300
Subject: [PATCH] settings_ui: the jail's pages carry the Zeo badge too

The ai-jail group's half of 0172 (operator ask 10 of 2026-11-23): Agent
Sandbox, Agent Memory and Secrets are pages of this group (0057, 0162), so
their titles join zeo_badge::ZEO_PAGE_TITLES here. Kept apart from 0172 so
that a build without USE ai-jail still badges the default group's settings
and its guard test does not look for pages that build does not have.

Tests: zeo_badge_tests.rs -- the guard now also finds the three pages, and
the predicate marks Agent Sandbox as Zeo's.
---

diff --git a/crates/settings_ui/src/zeo_badge.rs b/crates/settings_ui/src/zeo_badge.rs
index a566d85..1be40bd 100644
--- a/crates/settings_ui/src/zeo_badge.rs
+++ b/crates/settings_ui/src/zeo_badge.rs
@@ -23,7 +23,12 @@ pub(crate) const ZEO_SETTING_PATHS: &[&str] = &[
 ];
 
 /// The title of every sub-page that is Zeo's alone.
-pub(crate) const ZEO_PAGE_TITLES: &[&str] = &["Panel Button Order"];
+pub(crate) const ZEO_PAGE_TITLES: &[&str] = &[
+    "Panel Button Order",
+    "Agent Sandbox (ai-jail)",
+    "Agent Memory (ai-memory)",
+    "Secrets",
+];
 
 const BADGE: &str = "Zeo";
 const TOOLTIP: &str = "Added by Zeo: Zed does not have this setting.";
diff --git a/crates/settings_ui/src/zeo_badge_tests.rs b/crates/settings_ui/src/zeo_badge_tests.rs
index 31c3534..30f194f 100644
--- a/crates/settings_ui/src/zeo_badge_tests.rs
+++ b/crates/settings_ui/src/zeo_badge_tests.rs
@@ -64,5 +64,6 @@ fn zeo_badge_marks_zeo_settings_and_pages_only() {
     );
     assert!(!is_zeo_setting(None), "a row with no settings.json path");
     assert!(is_zeo_page("Panel Button Order"));
+    assert!(is_zeo_page("Agent Sandbox (ai-jail)"));
     assert!(!is_zeo_page("Edit Predictions"), "Zed's own page");
 }
