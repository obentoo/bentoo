+/// The defaults: no server (each reaches outside the jail), skills on (as in 0.20.0).
+#[gpui::test]
+async fn capabilities_tests_defaults_are_no_server_and_skills_on(cx: &mut TestAppContext) {
+    init(
+        json!({ "agent_sandbox": { "projects": { ROOT: { "enabled": true } } } }),
+        cx,
+    )
+    .await;
+    cx.update(|cx| {
+        let sandbox = AgentSandboxSettings::get_global(cx);
+        assert!(sandbox.mcp_servers_for_key(Some(ROOT)).is_empty());
+        assert!(sandbox.mcp_servers_for_key(None).is_empty());
+        assert!(sandbox.skills_for_key(Some(ROOT)));
+        assert!(sandbox.skills_for_key(None));
+    });
+}
+
+// Round 2 (operator, 2026-11-22): a default in `agent_sandbox.capabilities`, the project's own
+// replacing it field by field, an explicit empty list meaning none.
+
+#[gpui::test]
+async fn capabilities_tests_the_default_applies_and_a_project_overrides_field_by_field(
+    cx: &mut TestAppContext,
+) {
+    init(
+        json!({ "agent_sandbox": {
+            "capabilities": { "mcp_servers": ["files", "zeo-lsp"], "skills": false },
+            "projects": {
+                ROOT: { "capabilities": { "mcp_servers": [] } },
+                "/w/lib": { "capabilities": { "skills": true } },
+                "/w/other": {}
+            }
+        } }),
+        cx,
+    )
+    .await;
+    cx.update(|cx| {
+        let sandbox = AgentSandboxSettings::get_global(cx);
+        assert!(
+            sandbox.mcp_servers_for_key(Some(ROOT)).is_empty(),
+            "a project's [] is none, whatever the default"
+        );
+        assert!(sandbox.mcp_servers_set_for_key(Some(ROOT)));
+        assert!(
+            !sandbox.skills_for_key(Some(ROOT)),
+            "skills follow the default"
+        );
+        assert!(!sandbox.skills_set_for_key(Some(ROOT)));
+        assert_eq!(
+            sandbox.mcp_servers_for_key(Some("/w/lib")),
+            ["files", "zeo-lsp"]
+        );
+        assert!(sandbox.skills_for_key(Some("/w/lib")));
+        assert_eq!(
+            sandbox.mcp_servers_for_key(Some("/w/other")),
+            ["files", "zeo-lsp"]
+        );
+        assert_eq!(sandbox.mcp_servers_for_key(None), ["files", "zeo-lsp"]);
+    });
+}
+
+#[gpui::test]
+async fn capabilities_tests_a_first_choice_starts_from_the_default_and_reset_returns_to_it(
+    cx: &mut TestAppContext,
+) {
+    let fs = init(
+        json!({ "agent_sandbox": {
+            "capabilities": { "mcp_servers": ["files"] },
+            "projects": { ROOT: { "enabled": true } }
+        } }),
+        cx,
+    )
+    .await;
+    let cx = cx.add_empty_window();
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "docs", true, &[], window, cx)
+    });
+    assert!(task.await);
+    cx.run_until_parked();
+    assert_eq!(
+        chosen(cx),
+        ["docs", "files"],
+        "the default list, plus the new one"
+    );
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "files", false, &[], window, cx)
+    });
+    assert!(task.await);
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "docs", false, &[], window, cx)
+    });
+    assert!(task.await);
+    cx.run_until_parked();
+    assert!(chosen(cx).is_empty(), "the project's own empty list");
+    let file: Value =
+        serde_json_lenient::from_str(&fs.load(paths::settings_file()).await.expect("file"))
+            .expect("settings JSON");
+    assert_eq!(
+        file["agent_sandbox"]["projects"][ROOT]["capabilities"]["mcp_servers"],
+        json!([]),
+        "written as [] -- none -- not dropped"
+    );
+
+    let task = cx.update(|_, cx| reset_project_mcp_servers(Path::new(ROOT), cx));
+    assert!(task.await);
+    cx.run_until_parked();
+    assert_eq!(chosen(cx), ["files"], "the default again");
+    let file: Value =
+        serde_json_lenient::from_str(&fs.load(paths::settings_file()).await.expect("file"))
+            .expect("settings JSON");
+    assert!(
+        file["agent_sandbox"]["projects"][ROOT]
+            .get("capabilities")
+            .is_none(),
+        "nothing of the project's own left: {file}"
+    );
+    assert_eq!(
+        file["agent_sandbox"]["projects"][ROOT]["enabled"],
+        json!(true)
+    );
+}
