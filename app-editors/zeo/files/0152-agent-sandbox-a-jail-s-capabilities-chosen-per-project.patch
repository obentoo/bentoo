+use std::sync::Arc;
+
+use project::context_server_store::{ContextServerConfiguration, ContextServerStatus};
+use settings::ContextServerCommand;
+
+use super::*;
+
+fn stdio(args: &[&str]) -> Option<Arc<ContextServerConfiguration>> {
+    Some(Arc::new(ContextServerConfiguration::Custom {
+        command: ContextServerCommand {
+            path: "/usr/bin/node".into(),
+            args: args.iter().map(|arg| arg.to_string()).collect(),
+            env: None,
+            timeout: None,
+        },
+        remote: false,
+        launcher: None,
+    }))
+}
+
+fn servers() -> Vec<(
+    String,
+    Option<Arc<ContextServerConfiguration>>,
+    ContextServerStatus,
+)> {
+    vec![
+        (
+            "mcp-server-figma".to_string(),
+            stdio(&["bin.js", "--figma-api-key=figd_VALUE", "--stdio"]),
+            ContextServerStatus::Running,
+        ),
+        (
+            "files".to_string(),
+            stdio(&["/w/app/tool.js"]),
+            ContextServerStatus::Stopped,
+        ),
+    ]
+}
+
+#[test]
+fn agent_jail_capabilities_tests_list_servers_off_by_default_with_zeo_lsp() {
+    let rows = server_rows(servers(), &[], true);
+    let names: Vec<&str> = rows.iter().map(|row| row.name.as_str()).collect();
+    assert_eq!(names, ["files", "mcp-server-figma", ZEO_LSP]);
+    assert!(
+        rows.iter().all(|row| !row.chosen),
+        "nothing chosen by default"
+    );
+}
+
+#[test]
+fn agent_jail_capabilities_tests_a_secret_server_says_so_and_asks() {
+    let rows = server_rows(servers(), &[], false);
+    let figma = rows
+        .iter()
+        .find(|row| row.name == "mcp-server-figma")
+        .expect("listed");
+    assert_eq!(
+        figma.secrets,
+        [SecretSite::Argument("--figma-api-key".into())]
+    );
+    assert!(
+        figma
+            .note
+            .contains("Carries a secret (argument --figma-api-key)"),
+        "{}",
+        figma.note
+    );
+    assert!(!figma.note.contains("figd_VALUE"), "never the value");
+    let (_, detail) = prompt_for(figma).expect("a secret server asks");
+    assert!(detail.contains("the secret stays outside"));
+    let files = rows.iter().find(|row| row.name == "files").expect("listed");
+    assert!(prompt_for(files).is_none(), "a plain server does not ask");
+}
+
+#[test]
+fn agent_jail_capabilities_tests_choices_show_and_survive_a_removed_server() {
+    let chosen = ["files".to_string(), "gone".to_string(), ZEO_LSP.to_string()];
+    let rows = server_rows(servers(), &chosen, false);
+    let chosen_names: Vec<&str> = rows
+        .iter()
+        .filter(|row| row.chosen)
+        .map(|row| row.name.as_str())
+        .collect();
+    assert_eq!(chosen_names, ["files", "gone", ZEO_LSP]);
+    let gone = rows
+        .iter()
+        .find(|row| row.name == "gone")
+        .expect("still listed");
+    assert_eq!(gone.note, "Not configured in this project");
+}
+
+/// Hostile: with `agent.zeo_lsp` off and not chosen, zeo-lsp is not offered.
+#[test]
+fn agent_jail_capabilities_tests_zeo_lsp_off_is_not_offered() {
+    let rows = server_rows(servers(), &[], false);
+    assert!(rows.iter().all(|row| row.name != ZEO_LSP));
+}
+
+// Round 2 (operator, 2026-11-22): where the value in force comes from, and the notice's anchor.
+
+#[test]
+fn agent_jail_capabilities_tests_say_where_the_value_in_force_comes_from() {
+    assert_eq!(source_label(false), "Default for every project");
+    assert_eq!(source_label(true), "Set for this project");
+}
+
+#[test]
+fn agent_jail_capabilities_tests_the_anchor_is_taken_once_and_only_by_its_page() {
+    request_anchor(CAPABILITIES_ANCHOR);
+    assert!(!take_anchor("elsewhere"), "another anchor leaves it");
+    assert!(take_anchor(CAPABILITIES_ANCHOR));
+    assert!(!take_anchor(CAPABILITIES_ANCHOR), "taken once");
+    request_anchor(CAPABILITIES_ANCHOR);
+    request_anchor("");
+    assert!(
+        !take_anchor(CAPABILITIES_ANCHOR),
+        "a plain path clears a stale anchor"
+    );
+}
