+use super::*;
+
+const ROOT: &str = "/w/app";
+const VALUE: &str = "figd_SECRET_VALUE";
+
+fn stdio(args: &[&str], env: &[(&str, &str)]) -> Vec<SecretSite> {
+    let args: Vec<String> = args.iter().map(|arg| arg.to_string()).collect();
+    secret_sites(ServerShape::Stdio {
+        args: &args,
+        env: env.to_vec(),
+    })
+}
+
+#[test]
+fn capabilities_tests_a_flag_carrying_a_key_is_a_secret_either_way() {
+    assert_eq!(
+        stdio(
+            &["bin.js", &format!("--figma-api-key={VALUE}"), "--stdio"],
+            &[]
+        ),
+        [SecretSite::Argument("--figma-api-key".into())]
+    );
+    assert_eq!(
+        stdio(&["bin.js", "--figma-api-key", VALUE, "--stdio"], &[]),
+        [SecretSite::Argument("--figma-api-key".into())]
+    );
+}
+
+#[test]
+fn capabilities_tests_env_names_and_bearer_values_are_secrets() {
+    assert_eq!(
+        stdio(&[], &[("FIGMA_API_KEY", VALUE), ("PATH", "/usr/bin")]),
+        [SecretSite::Env("FIGMA_API_KEY".into())]
+    );
+    assert_eq!(
+        stdio(&["--header", "x", "Bearer abc"], &[]),
+        [SecretSite::Argument("#3".into())]
+    );
+}
+
+/// Hostile: names that only look alike, empty values and plain switches are not secrets.
+#[test]
+fn capabilities_tests_lookalikes_and_empty_values_are_not_secrets() {
+    assert!(
+        stdio(
+            &["--author", "me", "--stdio", "--api-key="],
+            &[("GIT_AUTHOR_NAME", "me"), ("GITHUB_TOKEN", "")],
+        )
+        .is_empty()
+    );
+    assert!(
+        stdio(&["--verbose", "--token"], &[]).is_empty(),
+        "a flag with no value"
+    );
+}
+
+#[test]
+fn capabilities_tests_http_headers_and_url_parameters() {
+    let sites = secret_sites(ServerShape::Http {
+        url: "https://mcp.example.com/mcp?token=abc&region=eu",
+        headers: vec![
+            ("X-Trace", "1"),
+            ("Authorization", "Bearer abc"),
+            ("X-Custom", "Basic Zm9v"),
+        ],
+    });
+    assert_eq!(
+        sites,
+        [
+            SecretSite::Header("Authorization".into()),
+            SecretSite::Header("X-Custom".into()),
+            SecretSite::UrlParameter("token".into()),
+        ]
+    );
+}
+
+#[test]
+fn capabilities_tests_an_extensions_own_settings_and_oauth_count() {
+    let extension = ContextServerConfiguration::Extension {
+        command: ContextServerCommand {
+            path: "/usr/bin/node".into(),
+            args: vec!["bin.js".into(), "--stdio".into()],
+            env: None,
+            timeout: None,
+        },
+        settings: json!({ "figma": { "api_key": VALUE }, "theme": "dark" }),
+        remote: false,
+    };
+    assert_eq!(
+        secret_sites_of(&extension),
+        [SecretSite::ExtensionSetting("figma.api_key".into())]
+    );
+    let oauth: project::project_settings::OAuthClientSettings =
+        serde_json::from_value(json!({ "client_id": "zeo", "client_secret": "s" }))
+            .expect("oauth settings");
+    let http = ContextServerConfiguration::Http {
+        url: "https://mcp.example.com/mcp".parse().expect("url"),
+        headers: Default::default(),
+        timeout: None,
+        oauth: Some(oauth),
+    };
+    assert_eq!(secret_sites_of(&http), [SecretSite::OAuthClientSecret]);
+}
+
+#[test]
+fn capabilities_tests_the_prompt_names_the_place_never_the_value() {
+    let (message, detail) =
+        secret_prompt("figma", &[SecretSite::Argument("--figma-api-key".into())]);
+    assert_eq!(message, "Allow \"figma\" in this project's jail?");
+    assert!(detail.contains("argument --figma-api-key"), "{detail}");
+    assert!(detail.contains("the secret stays outside"), "{detail}");
+    assert!(
+        detail.contains("does not get it"),
+        "an agent that cannot proxy: {detail}"
+    );
+    assert!(!detail.contains(VALUE));
+}
+
+async fn init(user: Value, cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        <dyn Fs>::set_global(fs.clone(), cx);
+        crate::init(cx);
+    });
+    fs.create_dir(paths::config_dir())
+        .await
+        .expect("config dir");
+    fs.insert_file(paths::settings_file(), user.to_string().into_bytes())
+        .await;
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&user.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+    cx.run_until_parked();
+    fs
+}
+
+fn chosen(cx: &mut VisualTestContext) -> Vec<String> {
+    cx.update(|_, cx| {
+        AgentSandboxSettings::get_global(cx)
+            .mcp_servers_for_key(Some(ROOT))
+            .to_vec()
+    })
+}
+
+#[gpui::test]
+async fn capabilities_tests_a_secret_server_asks_and_cancel_writes_nothing(
+    cx: &mut TestAppContext,
+) {
+    let fs = init(json!({ "agent_sandbox": { "projects": { ROOT: {} } } }), cx).await;
+    let before = fs.load(paths::settings_file()).await.expect("file");
+    let secrets = [SecretSite::Env("FIGMA_API_KEY".into())];
+    let cx = cx.add_empty_window();
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "figma", true, &secrets, window, cx)
+    });
+    cx.run_until_parked();
+    let (message, detail) = cx
+        .pending_prompt()
+        .expect("turning a secret server on asks");
+    assert!(message.contains("figma") && detail.contains("FIGMA_API_KEY"));
+    cx.simulate_prompt_answer("Cancel");
+    assert!(!task.await, "Cancel saves nothing");
+    cx.run_until_parked();
+    assert_eq!(fs.load(paths::settings_file()).await.expect("file"), before);
+}
+
+#[gpui::test]
+async fn capabilities_tests_allow_adds_the_server_and_off_never_asks(cx: &mut TestAppContext) {
+    init(json!({ "agent_sandbox": { "projects": { ROOT: {} } } }), cx).await;
+    let secrets = [SecretSite::Env("FIGMA_API_KEY".into())];
+    let cx = cx.add_empty_window();
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "figma", true, &secrets, window, cx)
+    });
+    cx.run_until_parked();
+    cx.simulate_prompt_answer("Allow");
+    assert!(task.await);
+    cx.run_until_parked();
+    assert_eq!(chosen(cx), ["figma"]);
+
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "figma", false, &secrets, window, cx)
+    });
+    cx.run_until_parked();
+    assert!(!cx.has_pending_prompt(), "turning a server off never asks");
+    assert!(task.await);
+    cx.run_until_parked();
+    assert!(chosen(cx).is_empty());
+}
+
+#[gpui::test]
+async fn capabilities_tests_a_plain_server_skills_and_connectors_write_at_once(
+    cx: &mut TestAppContext,
+) {
+    init(json!({}), cx).await;
+    let cx = cx.add_empty_window();
+    let task = cx.update(|window, cx| {
+        set_project_mcp_server(Path::new(ROOT), "files", true, &[], window, cx)
+    });
+    cx.run_until_parked();
+    assert!(!cx.has_pending_prompt(), "no secret, no question");
+    assert!(task.await);
+    let task = cx.update(|_, cx| set_project_skills(Path::new(ROOT), false, cx));
+    assert!(task.await);
+    let task = cx.update(|_, cx| set_project_connectors(Path::new(ROOT), true, cx));
+    assert!(task.await);
+    cx.run_until_parked();
+    assert_eq!(chosen(cx), ["files"]);
+    cx.update(|_, cx| {
+        let sandbox = AgentSandboxSettings::get_global(cx);
+        assert!(!sandbox.skills_for_key(Some(ROOT)));
+        assert!(sandbox.claude_ai_connectors_for_key(Some(ROOT)));
+    });
+}
