+// ---- R4.5, R4.6, R4.7 — the thread's task actions ---------------------------------
+
+/// A connection that overrides the two task actions and records what it was asked.
+struct TaskActionsConnection {
+    sessions: Arc<parking_lot::Mutex<HashMap<acp_v2::SessionId, WeakEntity<AcpThread>>>>,
+    stop_calls: Rc<RefCell<Vec<(acp_v2::SessionId, String)>>>,
+    background_calls: Rc<RefCell<Vec<(acp_v2::SessionId, String)>>>,
+    stop_error: Option<&'static str>,
+    backgrounded: bool,
+}
+
+impl TaskActionsConnection {
+    fn new() -> Self {
+        Self {
+            sessions: Arc::default(),
+            stop_calls: Rc::default(),
+            background_calls: Rc::default(),
+            stop_error: None,
+            backgrounded: true,
+        }
+    }
+}
+
+impl AgentConnection for TaskActionsConnection {
+    fn agent_id(&self) -> AgentId {
+        AgentId::new("task-actions")
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "task-actions".into()
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<gpui::Result<Entity<AcpThread>>> {
+        let session_id = acp_v2::SessionId::new("task-actions-session");
+        let action_log = cx.new(|_| ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id.clone(),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        self.sessions.lock().insert(session_id, thread.downgrade());
+        Task::ready(Ok(thread))
+    }
+
+    fn authenticate(&self, _method: acp_v2::AuthMethodId, _cx: &mut App) -> Task<gpui::Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: acp_v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<acp_v1::PromptResponse>> {
+        Task::ready(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) {}
+
+    fn stop_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<()>> {
+        self.stop_calls
+            .borrow_mut()
+            .push((session_id.clone(), task_id.to_string()));
+        match self.stop_error {
+            Some(message) => Task::ready(Err(anyhow::anyhow!(
+                "_claude/tasks/stop failed for {task_id}: {message}"
+            ))),
+            None => Task::ready(Ok(())),
+        }
+    }
+
+    fn background_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        tool_call_id: &str,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<bool>> {
+        self.background_calls
+            .borrow_mut()
+            .push((session_id.clone(), tool_call_id.to_string()));
+        Task::ready(Ok(self.backgrounded))
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
