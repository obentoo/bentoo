@@ -0,0 +1,52 @@
+// Story 012 — regressions found by the tech review of the task model, beyond the
+// pre-authored tests. Included after `acp_thread_tasks_tests.rs` (it reuses that
+// file's helpers).
+
+#[gpui::test]
+async fn test_claude_tasks_restarted_task_is_announced_again(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    for status in ["running", "completed", "running", "completed"] {
+        tasks_send(
+            &thread,
+            tasks_snapshot(vec![tasks_wire_task("x", status, 1_000)]),
+            cx,
+        );
+    }
+
+    assert_eq!(
+        events.borrow().ended,
+        vec![
+            ("x".to_string(), "completed"),
+            ("x".to_string(), "completed")
+        ]
+    );
+}
+
+#[gpui::test]
+async fn test_claude_tasks_restarted_task_that_vanishes_ends_as_interrupted(
+    cx: &mut TestAppContext,
+) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    for status in ["running", "completed", "running"] {
+        tasks_send(
+            &thread,
+            tasks_snapshot(vec![tasks_wire_task("x", status, 1_000)]),
+            cx,
+        );
+    }
+    tasks_send(&thread, tasks_snapshot(vec![]), cx);
+
+    assert_eq!(
+        events.borrow().ended,
+        vec![
+            ("x".to_string(), "completed"),
+            ("x".to_string(), "interrupted")
+        ]
+    );
+    assert_eq!(
+        tasks_ids(&thread, cx),
+        vec![("x".to_string(), "interrupted")]
+    );
+}
diff --git a/crates/acp_thread/src/acp_thread_tasks_tests.rs b/crates/acp_thread/src/acp_thread_tasks_tests.rs
new file mode 100644
index 0000000..5062ed9
--- /dev/null
+++ b/crates/acp_thread/src/acp_thread_tasks_tests.rs
@@ -0,0 +1,848 @@
+// Story 012 / patch 0032 — the agent task model in `AcpThread` (R4.1–R4.9) and the
+// `_claude/tasks` contract fixture (Q12).
+//
+// Included at the end of `mod tests` in `acp_thread.rs`:
+//
+//     include!("acp_thread_tasks_tests.rs");
+//
+// so it shares that module's imports and `FakeAgentConnection`. Every test name
+// carries `tasks` (filter `cargo test -p acp_thread tasks`), the connection actions
+// carry `task_actions`, and the fixture test carries `contract`.
+
+const TASKS_KEY: &str = "_claude/tasks";
+const CONTRACT_FIXTURE: &str = include_str!("test_data/claude_tasks_snapshot.json");
+
+fn tasks_ms(ms: u64) -> std::time::SystemTime {
+    std::time::UNIX_EPOCH + std::time::Duration::from_millis(ms)
+}
+
+/// The wire word for a status: exhaustive, so a sixth variant fails to compile here.
+fn tasks_status_word(status: &AgentTaskStatus) -> &'static str {
+    match status {
+        AgentTaskStatus::Running => "running",
+        AgentTaskStatus::Completed => "completed",
+        AgentTaskStatus::Failed => "failed",
+        AgentTaskStatus::Stopped => "stopped",
+        AgentTaskStatus::Interrupted => "interrupted",
+    }
+}
+
+/// One wire task. `status` is the wire word; `ended_at` is set for ended statuses.
+fn tasks_wire_task(id: &str, status: &str, started_at: u64) -> serde_json::Value {
+    let ended = status != "running";
+    serde_json::json!({
+        "id": id,
+        "toolCallId": format!("toolu_{id}"),
+        "type": "shell",
+        "description": format!("Task {id}"),
+        "background": true,
+        "depth": 0,
+        "status": status,
+        "startedAt": started_at,
+        "endedAt": if ended { Some(started_at + 1_000) } else { None },
+        "usage": null,
+        "lastTool": null,
+        "summary": null,
+    })
+}
+
+fn tasks_update(payload: serde_json::Value) -> acp_v1::SessionInfoUpdate {
+    let mut meta = serde_json::Map::new();
+    meta.insert(TASKS_KEY.to_string(), payload);
+    acp_v1::SessionInfoUpdate::new().meta(meta)
+}
+
+fn tasks_snapshot(tasks: Vec<serde_json::Value>) -> acp_v1::SessionInfoUpdate {
+    tasks_update(serde_json::json!({ "tasks": tasks }))
+}
+
+#[derive(Default)]
+struct TasksEvents {
+    updated: usize,
+    ended: Vec<(String, &'static str)>,
+}
+
+async fn tasks_thread(
+    connection: Rc<dyn AgentConnection>,
+    cx: &mut TestAppContext,
+) -> (Entity<AcpThread>, Rc<RefCell<TasksEvents>>) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let thread = cx
+        .update(|cx| {
+            connection.new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx)
+        })
+        .await
+        .unwrap();
+
+    let events = Rc::new(RefCell::new(TasksEvents::default()));
+    let sink = events.clone();
+    thread.update(cx, |_thread, cx| {
+        cx.subscribe(
+            &thread,
+            move |_thread, _event_thread, event: &AcpThreadEvent, _cx| match event {
+                AcpThreadEvent::TasksUpdated => sink.borrow_mut().updated += 1,
+                AcpThreadEvent::TaskEnded { task_id, status } => sink
+                    .borrow_mut()
+                    .ended
+                    .push((task_id.to_string(), tasks_status_word(status))),
+                _ => {}
+            },
+        )
+        .detach();
+    });
+    (thread, events)
+}
+
+fn tasks_send(
+    thread: &Entity<AcpThread>,
+    update: acp_v1::SessionInfoUpdate,
+    cx: &mut TestAppContext,
+) {
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(acp_v1::SessionUpdate::SessionInfoUpdate(update), cx)
+        })
+        .expect("session info update should succeed");
+}
+
+fn tasks_ids(thread: &Entity<AcpThread>, cx: &mut TestAppContext) -> Vec<(String, &'static str)> {
+    thread.read_with(cx, |thread, _| {
+        thread
+            .tasks()
+            .iter()
+            .map(|task| (task.id.to_string(), tasks_status_word(&task.status)))
+            .collect()
+    })
+}
+
+// ---- R4.1 -------------------------------------------------------------------------
+
+#[gpui::test]
+async fn test_claude_tasks_snapshot_replaces_the_list_and_notifies(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    tasks_send(
