+#[gpui::test]
+async fn test_task_actions_background_reads_backgrounded(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        Arc::new(|_method, params| {
+            let moved = params.get("toolCallId").and_then(|v| v.as_str()) == Some("toolu_fg");
+            Ok(serde_json::json!({ "backgrounded": moved }))
+        }),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let moved = cx
+        .update(|cx| peer.connection.clone().background_task(&session_id, "toolu_fg", cx))
+        .await
+        .expect("background succeeds");
+    let not_moved = cx
+        .update(|cx| peer.connection.clone().background_task(&session_id, "toolu_other", cx))
+        .await
+        .expect("false is an answer, not an error");
+
+    assert!(moved);
+    assert!(!not_moved);
+    assert_eq!(
+        task_actions_requests(&peer)[0],
+        (
+            "_claude/tasks/background".to_string(),
+            serde_json::json!({ "sessionId": session_id.to_string(), "toolCallId": "toolu_fg" }),
+        )
+    );
+}
