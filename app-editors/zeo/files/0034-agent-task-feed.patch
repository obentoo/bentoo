+// R4.7, the converse: any entry id and any name, with the capability, is supported —
+// the fork and the published package report different names.
+#[gpui::test]
+async fn test_task_actions_supported_for_any_name_advertising_the_capability(
+    cx: &mut gpui::TestAppContext,
+) {
+    for (entry, name, version) in [
+        ("some-entry", "@lucascouts/claude-agent-acp-fork", 1),
+        ("another-entry", "an-unrelated-name", 2),
+    ] {
+        let peer = connect_task_actions_peer(
+            entry,
+            name,
+            tasks_capability_v(version),
+            task_actions_ok(),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+        cx.update(|cx| peer.connection.clone().stop_task(&session_id, "b1", cx))
+            .await
+            .unwrap_or_else(|error| panic!("{entry}/{name} v{version}: {error:#}"));
+        assert_eq!(task_actions_requests(&peer).len(), 1);
+    }
+}
+
+// R4.11, session close: running tasks become Interrupted and are announced once;
+// ended tasks are left alone.
+#[gpui::test]
+async fn test_task_actions_close_session_interrupts_running_tasks_once(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer =
+        connect_task_actions_peer(PLUS_ENTRY, PLUS_NAME, tasks_capability_v(1), task_actions_ok(), cx)
+            .await;
+    let (thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let ended: Rc<RefCell<Vec<(String, bool)>>> = Rc::default();
+    let sink = ended.clone();
+    thread.update(cx, |_thread, cx| {
+        cx.subscribe(
+            &thread,
+            move |_thread, _event_thread, event: &acp_thread::AcpThreadEvent, _cx| {
+                if let acp_thread::AcpThreadEvent::TaskEnded { task_id, status } = event {
+                    sink.borrow_mut().push((
+                        task_id.to_string(),
+                        matches!(status, acp_thread::AgentTaskStatus::Interrupted),
+                    ));
+                }
+            },
+        )
+        .detach();
+    });
+
+    let task = |id: &str, status: &str| {
+        serde_json::json!({
+            "id": id, "toolCallId": null, "type": "shell", "description": id,
+            "background": true, "depth": 0, "status": status, "startedAt": 1_000,
+            "endedAt": if status == "running" { None } else { Some(2_000) },
+            "usage": null, "lastTool": null, "summary": null,
+        })
+    };
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/tasks".to_string(),
+        serde_json::json!({ "tasks": [task("r1", "running"), task("d1", "completed")] }),
+    );
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp::SessionUpdate::SessionInfoUpdate(acp::SessionInfoUpdate::new().meta(meta)),
+                cx,
+            )
+        })
+        .expect("snapshot applies");
+    assert_eq!(*ended.borrow(), vec![("d1".to_string(), false)]);
+
+    cx.update(|cx| peer.connection.clone().close_session(&session_id, cx))
+        .await
+        .expect("close succeeds");
+    cx.run_until_parked();
+
+    thread.read_with(cx, |thread, _| {
+        let statuses: Vec<(String, bool)> = thread
+            .tasks()
+            .iter()
+            .map(|t| {
+                (
+                    t.id.to_string(),
+                    matches!(t.status, acp_thread::AgentTaskStatus::Interrupted),
+                )
+            })
+            .collect();
+        assert_eq!(
+            statuses,
+            vec![("r1".to_string(), true), ("d1".to_string(), false)]
+        );
+    });
+    assert_eq!(
+        *ended.borrow(),
+        vec![("d1".to_string(), false), ("r1".to_string(), true)]
+    );
+}
