+/// The `_meta` key the ACP adapter writes the full task snapshot under, on a
+/// `session_info_update`: every running task plus each ended one until it has been
+/// published once. A level, not a stream — each snapshot replaces the previous one.
+///
+/// Kept apart from [`CLAUDE_BACKGROUND_TASKS_META_KEY`] so an adapter that only sends
+/// the count keeps patch `0029`'s background status working.
+const CLAUDE_TASKS_META_KEY: &str = "_claude/tasks";
+
+pub type AgentTaskId = SharedString;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AgentTaskStatus {
+    Running,
+    Completed,
+    Failed,
+    Stopped,
+    Interrupted,
+}
+
+impl AgentTaskStatus {
+    pub fn is_running(&self) -> bool {
+        matches!(self, AgentTaskStatus::Running)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AgentTaskUsage {
+    pub tokens: u64,
+    pub tool_uses: u64,
+    pub duration: Duration,
+}
+
+/// A unit of agent work that can outlive the turn that started it: a background shell,
+/// a subagent, a monitor.
+#[derive(Debug, Clone, PartialEq)]
+pub struct AgentTask {
+    pub id: AgentTaskId,
+    pub tool_call_id: Option<acp_v2::ToolCallId>,
+    pub kind: SharedString,
+    pub description: SharedString,
+    pub background: bool,
+    pub depth: u32,
+    pub status: AgentTaskStatus,
+    pub started_at: SystemTime,
+    pub ended_at: Option<SystemTime>,
+    pub usage: Option<AgentTaskUsage>,
+    pub last_tool: Option<SharedString>,
+    pub summary: Option<SharedString>,
+}
+
+#[derive(Deserialize)]
+struct WireTasksSnapshot {
+    tasks: Vec<WireTask>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WireTask {
+    id: String,
+    tool_call_id: Option<String>,
+    #[serde(rename = "type")]
+    kind: String,
+    description: String,
+    background: bool,
+    depth: u32,
+    status: WireTaskStatus,
+    started_at: u64,
+    ended_at: Option<u64>,
+    usage: Option<WireTaskUsage>,
+    last_tool: Option<String>,
+    summary: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "lowercase")]
+enum WireTaskStatus {
+    Running,
+    Completed,
+    Failed,
+    Stopped,
+    Interrupted,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WireTaskUsage {
+    tokens: u64,
+    tool_uses: u64,
+    duration_ms: u64,
+}
+
+/// `SystemTime + Duration` panics on overflow (reachable on Windows with a
+/// garbage timestamp), so an unrepresentable time falls back to the epoch.
+fn system_time_from_millis(millis: u64) -> SystemTime {
+    UNIX_EPOCH
+        .checked_add(Duration::from_millis(millis))
+        .unwrap_or(UNIX_EPOCH)
+}
+
+impl From<WireTask> for AgentTask {
+    fn from(task: WireTask) -> Self {
+        AgentTask {
+            id: task.id.into(),
+            tool_call_id: task.tool_call_id.map(acp_v2::ToolCallId::new),
+            kind: task.kind.into(),
+            description: task.description.into(),
+            background: task.background,
+            depth: task.depth,
+            status: match task.status {
+                WireTaskStatus::Running => AgentTaskStatus::Running,
+                WireTaskStatus::Completed => AgentTaskStatus::Completed,
+                WireTaskStatus::Failed => AgentTaskStatus::Failed,
+                WireTaskStatus::Stopped => AgentTaskStatus::Stopped,
+                WireTaskStatus::Interrupted => AgentTaskStatus::Interrupted,
+            },
+            started_at: system_time_from_millis(task.started_at),
+            ended_at: task.ended_at.map(system_time_from_millis),
+            usage: task.usage.map(|usage| AgentTaskUsage {
+                tokens: usage.tokens,
+                tool_uses: usage.tool_uses,
+                duration: Duration::from_millis(usage.duration_ms),
+            }),
+            last_tool: task.last_tool.map(SharedString::from),
+            summary: task.summary.map(SharedString::from),
+        }
+    }
+}
