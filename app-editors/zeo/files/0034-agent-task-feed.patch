+// R4.7, hostile half first: an agent that LOOKS like the Claude adapter — the
+// registry's Claude entry id, the published package's own name — but does not
+// advertise the capability is not sent a `_claude/*` request.
+#[gpui::test]
+async fn test_task_actions_unsupported_without_the_capability_even_for_claude_names(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        crate::CLAUDE_AGENT_ID,
+        PLUS_NAME,
+        None,
+        Arc::new(|_method, _params| Ok(serde_json::json!({ "backgrounded": true }))),
+        cx,
+    )
+    .await;
+    assert_task_actions_unsupported(&peer, cx).await;
+}
