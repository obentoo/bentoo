diff --git a/crates/agent_servers/src/acp_task_actions_tests.rs b/crates/agent_servers/src/acp_task_actions_tests.rs
new file mode 100644
index 0000000..86f4c71
--- /dev/null
+++ b/crates/agent_servers/src/acp_task_actions_tests.rs
@@ -0,0 +1,505 @@
+// Story 012 / patch 0032 — `AcpConnection::{stop_task, background_task}` against a
+// fake ACP peer (R4.5, R4.6, R4.7, R2.7) and session close interrupting tasks (R4.11).
+//
+// R4.7's gate is the `_claude/tasks` capability the agent advertises in
+// `initialize` (`agentCapabilities._meta["_claude/tasks"].version >= 1`), never the
+// entry id or the agent's self-reported name.
+//
+// Included at the end of `mod tests` in `acp.rs`:
+//
+//     include!("acp_task_actions_tests.rs");
+//
+// so it shares that module's imports and may set `AcpConnection`'s private `id` and
+// `telemetry_id` (the agent's self-reported name). Filter: `cargo test -p agent_servers
+// task_actions`.
+
+type TaskActionsReply = Arc<
+    dyn Fn(&str, &serde_json::Value) -> Result<serde_json::Value, agent_client_protocol::Error>
+        + Send
+        + Sync,
+>;
+
+struct TaskActionsPeer {
+    connection: Rc<AcpConnection>,
+    project: Entity<project::Project>,
+    requests: Arc<std::sync::Mutex<Vec<(String, serde_json::Value)>>>,
+    _keep_agent_alive: Task<anyhow::Result<()>>,
+}
+
+/// A fake agent that answers initialize, session/new and session/close, records
+/// every other request, and answers it with `reply`. `agent_id` is the id Zed
+/// registered the agent under; `agent_name` is what the agent reports about itself;
+/// `tasks_capability` is the value it advertises under `_claude/tasks`, if any.
+async fn connect_task_actions_peer(
+    agent_id: &str,
+    agent_name: &str,
+    tasks_capability: Option<serde_json::Value>,
+    reply: TaskActionsReply,
+    cx: &mut gpui::TestAppContext,
+) -> TaskActionsPeer {
+    cx.update(|cx| {
+        let store = settings::SettingsStore::test(cx);
+        cx.set_global(store);
+    });
+
+    let fs = fs::FakeFs::new(cx.executor());
+    fs.insert_tree("/", serde_json::json!({ "a": {} })).await;
+    let project = project::Project::test(fs, [std::path::Path::new("/a")], cx).await;
+
+    let requests: Arc<std::sync::Mutex<Vec<(String, serde_json::Value)>>> = Arc::default();
+    let (client_transport, agent_transport) = agent_client_protocol::Channel::duplex();
+    let sessions: Rc<RefCell<HashMap<acp_v2::SessionId, AcpSession>>> =
+        Rc::new(RefCell::new(HashMap::default()));
+    let client_session_list: Rc<RefCell<Option<Rc<AcpSessionList>>>> = Rc::new(RefCell::new(None));
+
+    let mut capabilities = acp::AgentCapabilities::default().session_capabilities(
+        acp::SessionCapabilities::default().close(acp::SessionCloseCapabilities::new()),
+    );
+    if let Some(value) = tasks_capability {
+        let mut meta = serde_json::Map::new();
+        meta.insert("_claude/tasks".to_string(), value);
+        capabilities = capabilities.meta(meta);
+    }
+    let agent_info = acp::Implementation::new(agent_name.to_string(), "1.0.0".to_string());
+    let agent_future = Agent
+        .v1()
+        .name("task-actions-agent")
+        .on_receive_request(
+            async move |req: acp::InitializeRequest, responder, _cx| {
+                responder.respond(
+                    acp::InitializeResponse::new(req.protocol_version)
+                        .agent_capabilities(capabilities.clone())
+                        .agent_info(agent_info.clone()),
+                )
+            },
+            agent_client_protocol::on_receive_request!(),
+        )
+        .on_receive_request(
+            async move |_req: acp::CloseSessionRequest, responder, _cx| {
+                responder.respond(acp::CloseSessionResponse::new())
+            },
+            agent_client_protocol::on_receive_request!(),
+        )
+        .on_receive_request(
+            async move |_req: acp::NewSessionRequest, responder, _cx| {
+                responder.respond(acp::NewSessionResponse::new(acp::SessionId::new(
+                    "task-session",
+                )))
+            },
+            agent_client_protocol::on_receive_request!(),
+        )
+        .on_receive_request(
+            {
+                let requests = requests.clone();
+                async move |req: agent_client_protocol::UntypedMessage, responder, _cx| {
+                    requests
+                        .lock()
+                        .expect("requests mutex")
+                        .push((req.method().to_string(), req.params().clone()));
+                    match reply(req.method(), req.params()) {
+                        Ok(value) => responder.respond(value),
+                        Err(error) => responder.respond_with_error(error),
+                    }
+                }
+            },
+            agent_client_protocol::on_receive_request!(),
+        )
+        .connect_with(agent_transport, async move |_agent| {
+            futures::future::pending::<Result<(), agent_client_protocol::Error>>().await
+        });
+    let agent_io_task = cx.background_spawn(agent_future);
+
+    let (dispatch_tx, dispatch_rx) = mpsc::unbounded::<ForegroundWork>();
+    let (connection_tx, connection_rx) = futures::channel::oneshot::channel();
+    let client_future = connect_client_future(
+        "zed-test",
+        client_transport,
+        dispatch_tx.clone(),
+        connection_tx,
+        futures::future::pending(),
+    );
+    let client_io_task = cx.background_spawn(async move {
+        client_future.await.ok();
+    });
+    let client_conn: ConnectionTo<Agent> = connection_rx
+        .await
+        .expect("failed to receive ACP connection handle");
+    let response = client_conn
+        .send_request(acp::InitializeRequest::new(ProtocolVersion::V1))
+        .block_task()
+        .await
+        .expect("failed to initialize ACP connection");
+
+    let request_elicitations = cx.new(|_| ElicitationStore::default());
+    let dispatch_context = ClientContext {
+        sessions: sessions.clone(),
+        session_list: client_session_list.clone(),
+        request_elicitations: request_elicitations.clone(),
+        active_request_scopes: None,
+        pending_session_updates: None,
+        accepts_subagent_updates: false,
+    };
+    let dispatch_task = cx.spawn({
+        let mut dispatch_rx = dispatch_rx;
+        move |cx| async move {
+            let mut cx = cx;
+            while let Some(work) = dispatch_rx.next().await {
+                work.run(&mut cx, &dispatch_context);
+            }
+        }
+    });
+    let agent_server_store =
+        project.read_with(cx, |project, _| project.agent_server_store().downgrade());
+
+    let mut connection = cx.update(|cx| {
+        AcpConnection::new_for_test(
+            client_conn,
+            sessions,
+            response.agent_capabilities,
+            false,
+            request_elicitations,
+            agent_server_store,
+            client_io_task,
+            dispatch_tx,
+            dispatch_task,
+            cx,
+        )
+    });
+    connection.id = AgentId::new(agent_id.to_string());
+    connection.telemetry_id = SharedString::from(agent_name.to_string());
+
+    let keep_agent_alive = cx.background_spawn(async move {
+        agent_io_task.await.ok();
+        anyhow::Ok(())
+    });
+
+    TaskActionsPeer {
+        connection: Rc::new(connection),
+        project,
+        requests,
+        _keep_agent_alive: keep_agent_alive,
+    }
+}
+
+fn tasks_capability_v(version: u64) -> Option<serde_json::Value> {
+    Some(serde_json::json!({ "version": version }))
+}
+
+/// Zeo's working entry: a custom id, and the published package's own name.
+const PLUS_ENTRY: &str = "Claude Agent (Plus)";
+const PLUS_NAME: &str = "@lucascouts/claude-agent-acp-plus";
+
+async fn task_actions_session(
+    peer: &TaskActionsPeer,
+    cx: &mut gpui::TestAppContext,
+) -> (Entity<AcpThread>, acp_v2::SessionId) {
+    let thread = cx
+        .update(|cx| {
+            peer.connection.clone().new_session(
+                peer.project.clone(),
+                PathList::new(&[std::path::Path::new("/a")]),
+                cx,
+            )
+        })
+        .await
+        .expect("new session");
+    let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+    (thread, session_id)
+}
+
+fn task_actions_requests(peer: &TaskActionsPeer) -> Vec<(String, serde_json::Value)> {
+    peer.requests.lock().expect("requests mutex").clone()
+}
+
+fn task_actions_ok() -> TaskActionsReply {
+    Arc::new(|_method, _params| Ok(serde_json::json!({})))
+}
+
+#[gpui::test]
+async fn test_task_actions_stop_sends_the_request_and_succeeds(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        task_actions_ok(),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    cx.update(|cx| peer.connection.clone().stop_task(&session_id, "b1", cx))
+        .await
+        .expect("stop succeeds");
+
+    assert_eq!(
+        task_actions_requests(&peer),
+        vec![(
+            "_claude/tasks/stop".to_string(),
+            serde_json::json!({ "sessionId": session_id.to_string(), "taskId": "b1" }),
+        )]
+    );
+}
+
+#[gpui::test]
+async fn test_task_actions_stop_returns_the_agents_error(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        Arc::new(|_method, _params| {
+            Err(agent_client_protocol::Error::new(
+                -32602,
+                "task b1 is not running",
+            ))
+        }),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let error = cx
+        .update(|cx| peer.connection.clone().stop_task(&session_id, "b1", cx))
+        .await
+        .expect_err("the agent's JSON-RPC error reaches the caller");
+    let text = format!("{error:#}");
+    assert!(text.contains("_claude/tasks/stop failed for b1"), "{text}");
+    assert!(text.contains("task b1 is not running"), "{text}");
+}
+
+#[gpui::test]
+async fn test_task_actions_background_reads_backgrounded(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        Arc::new(|_method, params| {
+            let moved = params.get("toolCallId").and_then(|v| v.as_str()) == Some("toolu_fg");
+            Ok(serde_json::json!({ "backgrounded": moved }))
+        }),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let moved = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .background_task(&session_id, "toolu_fg", cx)
+        })
+        .await
+        .expect("background succeeds");
+    let not_moved = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .background_task(&session_id, "toolu_other", cx)
+        })
+        .await
+        .expect("false is an answer, not an error");
+
+    assert!(moved);
+    assert!(!not_moved);
+    assert_eq!(
+        task_actions_requests(&peer)[0],
+        (
+            "_claude/tasks/background".to_string(),
+            serde_json::json!({ "sessionId": session_id.to_string(), "toolCallId": "toolu_fg" }),
+        )
+    );
+}
+
+#[gpui::test]
+async fn test_task_actions_background_missing_field_is_an_error_not_false(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        task_actions_ok(),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let result = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .background_task(&session_id, "toolu_fg", cx)
+        })
+        .await;
+    assert!(
+        result.is_err(),
+        "a response without `backgrounded` must not read as false"
+    );
+}
+
+/// Both actions answer "unsupported" and nothing reaches the agent.
+async fn assert_task_actions_unsupported(peer: &TaskActionsPeer, cx: &mut gpui::TestAppContext) {
+    let (_thread, session_id) = task_actions_session(peer, cx).await;
+    let stop = cx
+        .update(|cx| peer.connection.clone().stop_task(&session_id, "b1", cx))
+        .await;
+    let background = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .background_task(&session_id, "toolu_fg", cx)
+        })
+        .await;
+    assert!(stop.is_err());
+    assert!(background.is_err());
+    for error in [stop.unwrap_err(), background.unwrap_err()] {
+        let text = error.to_string().to_lowercase();
+        assert!(
+            text.contains("not supported") || text.contains("unsupported"),
+            "{text}"
+        );
+    }
+    assert!(
+        task_actions_requests(peer).is_empty(),
+        "nothing reached the agent"
+    );
+}
+
+// R4.7, hostile half first: an agent that LOOKS like the Claude adapter — the
+// registry's Claude entry id, the published package's own name — but does not
+// advertise the capability is not sent a `_claude/*` request.
+#[gpui::test]
+async fn test_task_actions_unsupported_without_the_capability_even_for_claude_names(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        crate::CLAUDE_AGENT_ID,
+        PLUS_NAME,
+        None,
+        Arc::new(|_method, _params| Ok(serde_json::json!({ "backgrounded": true }))),
+        cx,
+    )
+    .await;
+    assert_task_actions_unsupported(&peer, cx).await;
+}
+
+#[gpui::test]
+async fn test_task_actions_unsupported_for_capability_version_zero(cx: &mut gpui::TestAppContext) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(0),
+        task_actions_ok(),
+        cx,
+    )
+    .await;
+    assert_task_actions_unsupported(&peer, cx).await;
+}
+
+// R4.7, the converse: any entry id and any name, with the capability, is supported —
+// the fork and the published package report different names.
+#[gpui::test]
+async fn test_task_actions_supported_for_any_name_advertising_the_capability(
+    cx: &mut gpui::TestAppContext,
+) {
+    for (entry, name, version) in [
+        ("some-entry", "@lucascouts/claude-agent-acp-fork", 1),
+        ("another-entry", "an-unrelated-name", 2),
+    ] {
+        let peer = connect_task_actions_peer(
+            entry,
+            name,
+            tasks_capability_v(version),
+            task_actions_ok(),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+        cx.update(|cx| peer.connection.clone().stop_task(&session_id, "b1", cx))
+            .await
+            .unwrap_or_else(|error| panic!("{entry}/{name} v{version}: {error:#}"));
+        assert_eq!(task_actions_requests(&peer).len(), 1);
+    }
+}
+
+// R4.11, session close: running tasks become Interrupted and are announced once;
+// ended tasks are left alone.
+#[gpui::test]
+async fn test_task_actions_close_session_interrupts_running_tasks_once(
+    cx: &mut gpui::TestAppContext,
+) {
+    let peer = connect_task_actions_peer(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        tasks_capability_v(1),
+        task_actions_ok(),
+        cx,
+    )
+    .await;
+    let (thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let ended: Rc<RefCell<Vec<(String, bool)>>> = Rc::default();
+    let sink = ended.clone();
+    thread.update(cx, |_thread, cx| {
+        cx.subscribe(
+            &thread,
+            move |_thread, _event_thread, event: &acp_thread::AcpThreadEvent, _cx| {
+                if let acp_thread::AcpThreadEvent::TaskEnded { task_id, status } = event {
+                    sink.borrow_mut().push((
+                        task_id.to_string(),
+                        matches!(status, acp_thread::AgentTaskStatus::Interrupted),
+                    ));
+                }
+            },
+        )
+        .detach();
+    });
+
+    let task = |id: &str, status: &str| {
+        serde_json::json!({
+            "id": id, "toolCallId": null, "type": "shell", "description": id,
+            "background": true, "depth": 0, "status": status, "startedAt": 1_000,
+            "endedAt": if status == "running" { None } else { Some(2_000) },
+            "usage": null, "lastTool": null, "summary": null,
+        })
+    };
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/tasks".to_string(),
+        serde_json::json!({ "tasks": [task("r1", "running"), task("d1", "completed")] }),
+    );
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp::SessionUpdate::SessionInfoUpdate(acp::SessionInfoUpdate::new().meta(meta)),
+                cx,
+            )
+        })
+        .expect("snapshot applies");
+    assert_eq!(*ended.borrow(), vec![("d1".to_string(), false)]);
+
+    cx.update(|cx| peer.connection.clone().close_session(&session_id, cx))
+        .await
+        .expect("close succeeds");
+    cx.run_until_parked();
+
+    thread.read_with(cx, |thread, _| {
+        let statuses: Vec<(String, bool)> = thread
+            .tasks()
+            .iter()
+            .map(|t| {
+                (
+                    t.id.to_string(),
+                    matches!(t.status, acp_thread::AgentTaskStatus::Interrupted),
+                )
+            })
+            .collect();
+        assert_eq!(
+            statuses,
+            vec![("r1".to_string(), true), ("d1".to_string(), false)]
+        );
+    });
+    assert_eq!(
+        *ended.borrow(),
+        vec![("d1".to_string(), false), ("r1".to_string(), true)]
+    );
+}
