diff --git a/crates/acp_thread/src/subagent_rows.rs b/crates/acp_thread/src/subagent_rows.rs
new file mode 100644
index 0000000..75fb83f
--- /dev/null
+++ b/crates/acp_thread/src/subagent_rows.rs
@@ -0,0 +1,155 @@
+//! Zeo's task surfaces read ACP subagents from Zed's own registry (`AcpThread::subagents()`),
+//! so a child is listed whichever adapter spawned it. Story 064; the rows replace nothing
+//! upstream draws — the inline card keeps reading the child directly.
+
+use std::time::{Instant, SystemTime};
+
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{App, SharedString};
+
+use crate::{AcpThread, ForegroundActivity};
+
+/// Six outcomes, because the card's four (`Running`, `Completed`, `Failed`, `Canceled`) fold
+/// `RequiresAction` into Running and an unconfirmed state into the idle default — and both
+/// the sidebar and the tray have to tell those apart (R1.3).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SubagentRowStatus {
+    Running,
+    Waiting,
+    Done,
+    Failed,
+    Canceled,
+    Unknown,
+}
+
+impl SubagentRowStatus {
+    pub fn is_active(self) -> bool {
+        matches!(self, Self::Running | Self::Waiting)
+    }
+
+    pub fn is_terminal(self) -> bool {
+        matches!(self, Self::Done | Self::Failed | Self::Canceled)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct SubagentRow {
+    pub child_session_id: acp_v2::SessionId,
+    pub label: SharedString,
+    pub status: SubagentRowStatus,
+    /// The agent's own cancel grant (`capabilities.cancel`); Zed never forces a stop.
+    pub can_cancel: bool,
+    pub error: Option<SharedString>,
+    /// Wall-clock, like `AgentTask::started_at`, so merged rows sort and persist alike.
+    pub started_at: Option<SystemTime>,
+}
+
+/// What a thread's children add to its own state in the sidebar. Waiting outranks Running:
+/// the thread waits for an answer while any child does (R4.2).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChildActivity {
+    None,
+    Running,
+    Waiting,
+}
+
+/// One row per registered child, in registration order. Forks and sub-threads name a parent
+/// too, but are never registered, so they never appear here.
+pub fn subagent_rows(parent: &AcpThread, cx: &App) -> Vec<SubagentRow> {
+    parent
+        .subagents()
+        .map(|child| subagent_row(child.read(cx)))
+        .collect()
+}
+
+pub fn any_child_active(parent: &AcpThread, cx: &App) -> ChildActivity {
+    let mut activity = ChildActivity::None;
+    for child in parent.subagents() {
+        match subagent_row_status(child.read(cx)).0 {
+            SubagentRowStatus::Waiting => return ChildActivity::Waiting,
+            SubagentRowStatus::Running => activity = ChildActivity::Running,
+            _ => {}
+        }
+    }
+    activity
+}
+
+fn subagent_row(child: &AcpThread) -> SubagentRow {
+    let association = child.subagent_association();
+    // The parent's label describes the child in the parent's view, so it wins (R1.2).
+    let label = association
+        .and_then(|association| association.title.clone())
+        .or_else(|| child.title())
+        .unwrap_or_else(|| SharedString::new_static("Subagent"));
+    let (status, error) = subagent_row_status(child);
+    SubagentRow {
+        child_session_id: child.session_id().clone(),
+        label,
+        status,
+        can_cancel: association.is_some_and(|association| association.can_cancel),
+        error,
+        started_at: child.activity_started_at().map(wall_clock),
+    }
+}
+
+fn subagent_row_status(child: &AcpThread) -> (SubagentRowStatus, Option<SharedString>) {
+    match child.foreground_activity() {
+        ForegroundActivity::Running => (SubagentRowStatus::Running, None),
+        ForegroundActivity::RequiresAction => (SubagentRowStatus::Waiting, None),
+        // A replayed or not-yet-reported state is history, not the child's current one (R1.7).
+        ForegroundActivity::Unconfirmed | ForegroundActivity::Unknown => {
+            (SubagentRowStatus::Unknown, None)
+        }
+        ForegroundActivity::Idle => match child.foreground_state() {
+            Some(acp_v2::StateUpdate::Idle(idle)) => idle_outcome(idle),
+            _ => (SubagentRowStatus::Unknown, None),
+        },
+    }
+}
+
+fn wall_clock(instant: Instant) -> SystemTime {
+    SystemTime::now()
+        .checked_sub(instant.elapsed())
+        .unwrap_or(SystemTime::UNIX_EPOCH)
+}
+
+/// How an ACP subagent's work ended, with the error to show for a failure. Shared with the
+/// inline subagent card so the two never disagree about an outcome. Idle with no stop reason,
+/// or with one this version does not know, is a normal end, as it is for any ACP session.
+pub fn idle_outcome(idle: &acp_v2::IdleStateUpdate) -> (SubagentRowStatus, Option<SharedString>) {
+    match &idle.stop_reason {
+        Some(acp_v2::StopReason::Cancelled) => (SubagentRowStatus::Canceled, None),
+        Some(acp_v2::StopReason::Error(error)) => (
+            SubagentRowStatus::Failed,
+            error
+                .error
+                .as_ref()
+                .map(|error| error.message.trim())
+                .filter(|message| !message.is_empty())
+                .map(|message| message.to_string().into()),
+        ),
+        Some(acp_v2::StopReason::MaxTokens) => (
+            SubagentRowStatus::Failed,
+            Some("The subagent reached its token limit.".into()),
+        ),
+        Some(acp_v2::StopReason::MaxTurnRequests) => (
+            SubagentRowStatus::Failed,
+            Some("The subagent reached its limit of model requests.".into()),
+        ),
+        Some(acp_v2::StopReason::Refusal) => (
+            SubagentRowStatus::Failed,
+            Some("The subagent's model refused to continue.".into()),
+        ),
+        _ => (SubagentRowStatus::Done, None),
+    }
+}
+
