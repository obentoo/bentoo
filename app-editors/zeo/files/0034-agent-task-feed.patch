+        cx,
+    );
+    assert_eq!(
+        tasks_ids(&thread, cx),
+        vec![("t1".to_string(), "running"), ("t3".to_string(), "running")]
+    );
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(thread.tasks()[0].description.to_string(), "Renamed task")
+    });
+    assert_eq!(events.borrow().updated, 2);
+}
