+#[gpui::test]
+async fn test_claude_tasks_absent_key_leaves_the_list_and_present_empty_clears_it(
+    cx: &mut TestAppContext,
+) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![
+            tasks_wire_task("r1", "running", 1_000),
+            tasks_wire_task("d1", "completed", 2_000),
+        ]),
+        cx,
+    );
+    assert_eq!(events.borrow().updated, 1);
+    assert_eq!(events.borrow().ended, vec![("d1".to_string(), "completed")]);
+
+    // A title-only update rides the same notification.
+    tasks_send(
+        &thread,
+        acp_v1::SessionInfoUpdate::new().title("Renamed"),
+        cx,
+    );
+    // So does an update carrying only patch 0029's key.
+    let mut only_background = serde_json::Map::new();
+    only_background.insert(
+        CLAUDE_BACKGROUND_TASKS_META_KEY.to_string(),
+        serde_json::json!({ "count": 0, "tasks": [] }),
+    );
+    tasks_send(
+        &thread,
+        acp_v1::SessionInfoUpdate::new().meta(only_background),
+        cx,
+    );
+    // And an update with unrelated meta.
+    let mut unrelated = serde_json::Map::new();
+    unrelated.insert(
+        "_claude/other".to_string(),
+        serde_json::json!({ "tasks": [] }),
+    );
+    tasks_send(
+        &thread,
+        acp_v1::SessionInfoUpdate::new().meta(unrelated),
+        cx,
+    );
+
+    // Nothing changed: the running task did not "vanish" (no R4.10 interrupt either).
+    assert_eq!(
+        tasks_ids(&thread, cx),
+        vec![
+            ("r1".to_string(), "running"),
+            ("d1".to_string(), "completed")
+        ]
+    );
+    assert_eq!(events.borrow().updated, 1, "no change, no notification");
+    assert_eq!(events.borrow().ended, vec![("d1".to_string(), "completed")]);
+
+    // The converse: a PRESENT empty list is real news and clears the list.
+    tasks_send(
+        &thread,
+        tasks_snapshot(vec![tasks_wire_task("r1", "completed", 1_000)]),
+        cx,
+    );
+    tasks_send(&thread, tasks_snapshot(vec![]), cx);
+    assert_eq!(tasks_ids(&thread, cx), vec![]);
+    assert_eq!(events.borrow().updated, 3);
