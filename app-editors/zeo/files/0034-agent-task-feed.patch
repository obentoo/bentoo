+    pub fn stop_task(&self, task_id: &str, cx: &mut App) -> Task<Result<()>> {
+        self.connection
+            .clone()
+            .stop_task(self.session_id(), task_id, cx)
+    }
+
+    /// Resolves to `false` when the agent had nothing to move to the background.
+    pub fn background_task(&self, tool_call_id: &str, cx: &mut App) -> Task<Result<bool>> {
+        self.connection
+            .clone()
+            .background_task(self.session_id(), tool_call_id, cx)
+    }
+
+    fn apply_tasks_snapshot(&mut self, snapshot: WireTasksSnapshot, cx: &mut Context<Self>) {
+        let mut tasks: Vec<AgentTask> = snapshot.tasks.into_iter().map(AgentTask::from).collect();
+
+        // A running task whose ending never reached us is gone without a word: keep it
+        // once, as interrupted, so its ending is still shown and announced.
+        let now = SystemTime::now();
+        for previous in &self.tasks {
+            if previous.status.is_running()
+                && !self.announced_task_endings.contains(&previous.id)
+                && !tasks.iter().any(|task| task.id == previous.id)
+            {
+                let mut interrupted = previous.clone();
+                interrupted.status = AgentTaskStatus::Interrupted;
+                interrupted.ended_at = Some(now);
+                tasks.push(interrupted);
+            }
+        }
+        tasks.sort_by_key(|task| task.started_at);
+
+        // Forget an ending once its id leaves the list, or comes back running:
+        // a resumed subagent restarts under the same id, and its next ending
+        // is news again.
+        self.announced_task_endings.retain(|id| {
+            tasks
+                .iter()
+                .any(|task| &task.id == id && !task.status.is_running())
+        });
+        if tasks != self.tasks {
+            self.tasks = tasks;
+            cx.emit(AcpThreadEvent::TasksUpdated);
+        }
+        self.announce_task_endings(cx);
+    }
+
+    fn announce_task_endings(&mut self, cx: &mut Context<Self>) {
+        for task in &self.tasks {
+            if !task.status.is_running() && self.announced_task_endings.insert(task.id.clone()) {
+                cx.emit(AcpThreadEvent::TaskEnded {
+                    task_id: task.id.clone(),
+                    status: task.status,
+                });
+            }
+        }
+    }
+
+    /// Marks every running task interrupted and announces each ending once. For the
+    /// paths where the agent can no longer report on its tasks: its process exited, or
+    /// the session was closed.
+    pub fn interrupt_running_tasks(&mut self, cx: &mut Context<Self>) {
+        let now = SystemTime::now();
+        let mut changed = false;
+        for task in &mut self.tasks {
+            if task.status.is_running() {
+                task.status = AgentTaskStatus::Interrupted;
+                task.ended_at = Some(now);
+                changed = true;
+            }
+        }
+        if changed {
+            cx.emit(AcpThreadEvent::TasksUpdated);
+            self.announce_task_endings(cx);
+        }
+    }
+
