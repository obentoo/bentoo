+// ---- R4.5, R4.6, R4.7 — the thread's task actions ---------------------------------
+
+/// A connection that overrides the two task actions and records what it was asked.
+struct TaskActionsConnection {
+    sessions: Arc<parking_lot::Mutex<HashMap<acp_v2::SessionId, WeakEntity<AcpThread>>>>,
+    stop_calls: Rc<RefCell<Vec<(acp_v2::SessionId, String)>>>,
+    background_calls: Rc<RefCell<Vec<(acp_v2::SessionId, String)>>>,
+    stop_error: Option<&'static str>,
+    backgrounded: bool,
+}
+
+impl TaskActionsConnection {
+    fn new() -> Self {
+        Self {
+            sessions: Arc::default(),
+            stop_calls: Rc::default(),
+            background_calls: Rc::default(),
+            stop_error: None,
+            backgrounded: true,
+        }
+    }
+}
+
+impl AgentConnection for TaskActionsConnection {
+    fn agent_id(&self) -> AgentId {
+        AgentId::new("task-actions")
+    }
+
+    fn telemetry_id(&self) -> SharedString {
+        "task-actions".into()
+    }
+
+    fn auth_methods(&self) -> &[acp_v2::AuthMethod] {
+        &[]
+    }
+
+    fn new_session(
+        self: Rc<Self>,
+        project: Entity<Project>,
+        work_dirs: PathList,
+        cx: &mut App,
+    ) -> Task<gpui::Result<Entity<AcpThread>>> {
+        let session_id = acp_v2::SessionId::new("task-actions-session");
+        let action_log = cx.new(|_| ActionLog::new(project.clone()));
+        let thread = cx.new(|cx| {
+            AcpThread::new(
+                None,
+                None,
+                Some(work_dirs),
+                self.clone(),
+                project,
+                action_log,
+                session_id.clone(),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        });
+        self.sessions.lock().insert(session_id, thread.downgrade());
+        Task::ready(Ok(thread))
+    }
+
+    fn authenticate(&self, _method: acp_v2::AuthMethodId, _cx: &mut App) -> Task<gpui::Result<()>> {
+        Task::ready(Ok(()))
+    }
+
+    fn prompt(
+        &self,
+        _params: acp_v2::PromptRequest,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<acp_v1::PromptResponse>> {
+        Task::ready(Ok(acp_v1::PromptResponse::new(acp_v1::StopReason::EndTurn)))
+    }
+
+    fn cancel(&self, _session_id: &acp_v2::SessionId, _cx: &mut App) -> gpui::Result<()> {
+        Ok(())
+    }
+
+    fn stop_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        task_id: &str,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<()>> {
+        self.stop_calls
+            .borrow_mut()
+            .push((session_id.clone(), task_id.to_string()));
+        match self.stop_error {
+            Some(message) => Task::ready(Err(anyhow::anyhow!(
+                "_claude/tasks/stop failed for {task_id}: {message}"
+            ))),
+            None => Task::ready(Ok(())),
+        }
+    }
+
+    fn background_task(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        tool_call_id: &str,
+        _cx: &mut App,
+    ) -> Task<gpui::Result<bool>> {
+        self.background_calls
+            .borrow_mut()
+            .push((session_id.clone(), tool_call_id.to_string()));
+        Task::ready(Ok(self.backgrounded))
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+#[gpui::test]
+async fn test_task_actions_thread_delegates_to_its_connection(cx: &mut TestAppContext) {
+    let connection = Rc::new(TaskActionsConnection::new());
+    let stop_calls = connection.stop_calls.clone();
+    let background_calls = connection.background_calls.clone();
+    let (thread, _events) = tasks_thread(connection, cx).await;
+    let session_id = acp_v2::SessionId::new("task-actions-session");
+
+    thread
+        .update(cx, |thread, cx| thread.stop_task("b1", cx))
+        .await
+        .expect("stop succeeds");
+    let moved = thread
+        .update(cx, |thread, cx| thread.background_task("toolu_fg", cx))
+        .await
+        .expect("background succeeds");
+
+    assert!(moved);
+    assert_eq!(
+        *stop_calls.borrow(),
+        vec![(session_id.clone(), "b1".to_string())]
+    );
+    assert_eq!(
+        *background_calls.borrow(),
+        vec![(session_id, "toolu_fg".to_string())]
+    );
+}
+
+#[gpui::test]
+async fn test_task_actions_thread_returns_the_agents_error_and_false(cx: &mut TestAppContext) {
+    let mut connection = TaskActionsConnection::new();
+    connection.stop_error = Some("task b1 is not running");
+    connection.backgrounded = false;
+    let (thread, _events) = tasks_thread(Rc::new(connection), cx).await;
+
+    let error = thread
+        .update(cx, |thread, cx| thread.stop_task("b1", cx))
+        .await
+        .expect_err("the agent's error reaches the caller");
+    assert!(
+        error.to_string().contains("task b1 is not running"),
+        "{error}"
+    );
+
+    let moved = thread
+        .update(cx, |thread, cx| thread.background_task("toolu_none", cx))
+        .await
+        .expect("an answer of false is not an error");
+    assert!(!moved);
+}
+
+#[gpui::test]
+async fn test_task_actions_unsupported_for_an_agent_without_them(cx: &mut TestAppContext) {
+    // FakeAgentConnection does not override the actions: the trait defaults answer.
+    let (thread, _events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    thread.read_with(cx, |thread, _| assert!(thread.tasks().is_empty()));
+    let stop = thread
+        .update(cx, |thread, cx| thread.stop_task("b1", cx))
+        .await
+        .expect_err("stop is unsupported");
+    let background = thread
+        .update(cx, |thread, cx| thread.background_task("toolu_fg", cx))
+        .await
+        .expect_err("background is unsupported");
+    for error in [stop, background] {
+        let text = error.to_string().to_lowercase();
+        assert!(
+            text.contains("not supported") || text.contains("unsupported"),
+            "{text}"
+        );
+    }
+}
