+++ b/crates/acp_thread/src/subagent_rows_test_support.rs
@@ -0,0 +1,165 @@
+// Story 064, task 1.1 — shared rig of the `subagent_rows` tests (see `subagent_rows_tests.rs` for
+// the contract). Wired at the end of `crates/acp_thread/src/subagent_rows.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "subagent_rows_test_support.rs"]
+//     mod test_support;
+//
+// Every item is `pub(super)`, so the two test modules beside it reach it as
+// `super::test_support::*`.
+
+use std::{path::Path, rc::Rc};
+
+use action_log::ActionLog;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{AppContext as _, Entity, SharedString, TestAppContext};
+use project::{FakeFs, Project};
+use settings::SettingsStore;
+use util::path;
+use util::path_list::PathList;
+
+use super::{ChildActivity, SubagentRow, SubagentRowStatus, any_child_active, subagent_rows};
+use crate::{AcpThread, AgentConnection as _, StubAgentConnection};
+
+// ── Rig ─────────────────────────────────────────────────────────────────────
+
+pub(super) struct SubagentRowsRig {
+    pub(super) parent: Entity<AcpThread>,
+    pub(super) connection: Rc<StubAgentConnection>,
+}
+
+pub(super) async fn subagent_rows_rig(cx: &mut TestAppContext) -> SubagentRowsRig {
+    cx.update(|cx| {
+        let mut settings_store = SettingsStore::test(cx);
+        settings_store.register_setting::<feature_flags::FeatureFlagsSettings>();
+        cx.set_global(settings_store);
+    });
+    let project = Project::test(FakeFs::new(cx.executor()), [], cx).await;
+    let connection = Rc::new(StubAgentConnection::new());
+    let parent = cx
+        .update(|cx| {
+            connection
+                .clone()
+                .new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx)
+        })
+        .await
+        .expect("the parent session should be created");
+    SubagentRowsRig { parent, connection }
+}
+
+/// An ACP subagent of the rig's parent, registered as the parent's `subagent_update` does:
+/// agent-owned, so its activity comes only from the agent's reports (Unconfirmed until one).
+pub(super) fn subagent_rows_child(
+    rig: &SubagentRowsRig,
+    session_id: &str,
+    own_title: Option<&str>,
+    cx: &mut TestAppContext,
+) -> Entity<AcpThread> {
+    let (parent_session_id, project) = rig.parent.read_with(cx, |thread, _| {
+        (thread.session_id().clone(), thread.project().clone())
+    });
+    let connection = rig.connection.clone();
+    let session_id = acp_v2::SessionId::new(session_id);
+    let own_title = own_title.map(|title| SharedString::from(title.to_string()));
+    let child = cx.update(|cx| {
+        let action_log = cx.new(|_| ActionLog::new(project.clone()));
+        cx.new(|cx| {
+            AcpThread::new(
+                Some(parent_session_id),
+                own_title,
+                None,
+                connection,
+                project,
+                action_log,
+                session_id,
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+            .agent_owned()
+        })
+    });
+    cx.update(|cx| rig.connection.track_session(&child, cx));
+    rig.parent
+        .update(cx, |parent, cx| parent.register_subagent(child.clone(), cx));
+    child
+}
+
+/// What the parent's `subagent_update` reports about the child, as the wire carries it.
+pub(super) fn subagent_rows_associate(
+    child: &Entity<AcpThread>,
+    association: serde_json::Value,
+    cx: &mut TestAppContext,
+) {
+    let session_id = child.read_with(cx, |thread, _| thread.session_id().to_string());
+    let mut update = association;
+    update["sessionId"] = serde_json::json!(session_id);
+    let update: acp_v2::SubagentUpdate =
+        serde_json::from_value(update).expect("a well-formed subagent update");
+    child.update(cx, |thread, cx| {
+        thread
+            .update_subagent_association(&update, cx)
+            .expect("the child is an ACP subagent")
+    });
+}
+
+pub(super) fn subagent_rows_report(
+    child: &Entity<AcpThread>,
+    state: acp_v2::StateUpdate,
+    cx: &mut TestAppContext,
+) {
+    child.update(cx, |thread, cx| {
+        thread
+            .update_session_state(state, cx)
+            .expect("an agent-owned child reports its state")
+    });
+}
+
+pub(super) fn subagent_rows_running() -> acp_v2::StateUpdate {
+    acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new())
+}
+
+pub(super) fn subagent_rows_requires_action() -> acp_v2::StateUpdate {
+    acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new())
+}
+
+pub(super) fn subagent_rows_idle(stop_reason: Option<acp_v2::StopReason>) -> acp_v2::StateUpdate {
+    let idle = acp_v2::IdleStateUpdate::new();
+    acp_v2::StateUpdate::Idle(match stop_reason {
+        Some(stop_reason) => idle.stop_reason(stop_reason),
+        None => idle,
+    })
+}
+
+pub(super) fn subagent_rows_error(message: &str) -> acp_v2::StopReason {
+    let mut error = acp_v2::Error::internal_error();
+    error.message = message.to_string();
+    acp_v2::StopReason::Error(acp_v2::ErrorStopReason::new().error(error))
+}
+
+pub(super) fn subagent_rows_of(rig: &SubagentRowsRig, cx: &mut TestAppContext) -> Vec<SubagentRow> {
+    rig.parent
+        .read_with(cx, |parent, cx| subagent_rows(parent, cx))
+}
+
+pub(super) fn subagent_rows_activity(
+    rig: &SubagentRowsRig,
+    cx: &mut TestAppContext,
+) -> ChildActivity {
+    rig.parent
+        .read_with(cx, |parent, cx| any_child_active(parent, cx))
+}
+
+pub(super) fn subagent_rows_find(rows: &[SubagentRow], session_id: &str) -> SubagentRow {
+    rows.iter()
+        .find(|row| row.child_session_id.to_string() == session_id)
+        .unwrap_or_else(|| panic!("child {session_id} has a row: {rows:?}"))
+        .clone()
+}
+
+pub(super) fn subagent_rows_status(
+    rig: &SubagentRowsRig,
+    session_id: &str,
+    cx: &mut TestAppContext,
+) -> SubagentRowStatus {
+    subagent_rows_find(&subagent_rows_of(rig, cx), session_id).status
+}
diff --git a/crates/acp_thread/src/subagent_rows_tests.rs b/crates/acp_thread/src/subagent_rows_tests.rs
new file mode 100644
index 0000000..7cf8d08
--- /dev/null
+++ b/crates/acp_thread/src/subagent_rows_tests.rs
@@ -0,0 +1,190 @@
+// Story 064, task 1.1 — native subagent rows: labels, status mapping, replay (R1.2, R1.3, R1.7)
+// and the children's combined activity the sidebar reads (R4.1, R4.2 via `any_child_active`).
+//
+// Wired at the end of `crates/acp_thread/src/subagent_rows.rs` (new, fixup of 0034) as
+//
+//     #[cfg(test)]
+//     #[path = "subagent_rows_test_support.rs"]
+//     mod test_support;
+//     #[cfg(test)]
+//     #[path = "subagent_rows_tests.rs"]
+//     mod tests;
+//     #[cfg(test)]
+//     #[path = "subagent_rows_identity_tests.rs"]
+//     mod identity_tests;
+//
+// This file holds the status mapping (R1.3); `subagent_rows_identity_tests.rs` holds labels and
+// identity (R1.2), replay (R1.7) and `any_child_active`.
+//
+// Validation filter: `cargo test -p acp_thread subagent_rows`.
+//
+// Contract (design.md §SubagentRowSource, §Data Models):
+//   - `pub fn subagent_rows(parent: &AcpThread, cx: &App) -> Vec<SubagentRow>`, one row per
+//     registered child (`AcpThread::subagents()`), in registration order;
+//   - `pub fn any_child_active(parent: &AcpThread, cx: &App) -> ChildActivity`,
+//     `ChildActivity::{None, Running, Waiting}`;
+//   - `SubagentRow { child_session_id, label, status, can_cancel, error, started_at }`.
+// Assumed beyond design.md (adjust HERE, not in each test):
+//   - design.md types `status` as `TaskActivity`, a name `agent_ui` already uses for its
+//     history event (and which `acp_thread` cannot reach). This file names the status enum
+//     `SubagentRowStatus { Running, Waiting, Done, Failed, Canceled, Unknown }` — R1.3's words —
+//     declared in `subagent_rows.rs`, deriving `Clone, Copy, Debug, PartialEq, Eq`;
+//   - `ChildActivity` derives `Debug, PartialEq, Eq`; `SubagentRow` derives `Clone, Debug`;
+//   - field types: `child_session_id: acp_v2::SessionId`, `label: SharedString`,
+//     `can_cancel: bool`, `error: Option<SharedString>`. `started_at` is not read here.
+//   - When `ChildActivity` has both a Running and a Waiting child, it reads Waiting: R4.2 shows
+//     the thread as waiting for an answer while ANY child is Waiting.
+//   - An `Unknown` child counts as neither Running nor Waiting (R4.1 and R4.4 name only those
+//     two).
+//
+// Hostile halves first, per requirement:
+//   - R1.3: RequiresAction must not collapse into Running (Zed's own card does exactly that),
+//     Idle-with-error / limit / refusal must not collapse into Done, Idle-cancelled must not
+//     collapse into Failed or Done, Unconfirmed / Unknown must not read Done (the idle default)
+//     nor Running; only then the plain Running and Done rows.
+//   - R1.2: the association title wins over the child's own title; two children sharing a
+//     title stay two rows, each with its own session id; then the fallbacks.
+//   - R1.7: a child the replay left Done or Running reads Unknown afterwards, never Done or
+//     Running, and loses its Stop grant; its title stays.
+//   - a thread that names the parent but is not registered (a fork, 0070) is never a row.
+
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::TestAppContext;
+
+use super::SubagentRowStatus;
+use super::test_support::*;
+
+// ── R1.3: status mapping, hostile halves first ─────────────────────────────
+
+// Zed's inline card reads RequiresAction as Running (subagent_card.rs `from_reported_state`):
+// the row must not.
+#[gpui::test]
+async fn subagent_rows_requires_action_reads_waiting_never_running(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let child = subagent_rows_child(&rig, "c-wait", None, cx);
+    subagent_rows_report(&child, subagent_rows_running(), cx);
+    assert_eq!(
+        subagent_rows_status(&rig, "c-wait", cx),
+        SubagentRowStatus::Running,
+        "precondition: a running child reads Running"
+    );
+
+    subagent_rows_report(&child, subagent_rows_requires_action(), cx);
+    assert_eq!(
+        subagent_rows_status(&rig, "c-wait", cx),
+        SubagentRowStatus::Waiting,
+        "requires_action is Waiting, distinct from Running"
+    );
+}
+
+// Idle is not one outcome: an error, a limit or a refusal is Failed, never Done.
+#[gpui::test]
+async fn subagent_rows_idle_with_error_limit_or_refusal_reads_failed(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let cases = [
+        ("c-error", subagent_rows_error("Authentication required")),
+        ("c-max-tokens", acp_v2::StopReason::MaxTokens),
+        ("c-max-turns", acp_v2::StopReason::MaxTurnRequests),
+        ("c-refusal", acp_v2::StopReason::Refusal),
+    ];
+    for (session_id, stop_reason) in cases.clone() {
+        let child = subagent_rows_child(&rig, session_id, None, cx);
+        subagent_rows_report(&child, subagent_rows_running(), cx);
+        subagent_rows_report(&child, subagent_rows_idle(Some(stop_reason)), cx);
+    }
+
+    let rows = subagent_rows_of(&rig, cx);
+    for (session_id, _) in cases {
+        let row = subagent_rows_find(&rows, session_id);
+        assert_eq!(
+            row.status,
+            SubagentRowStatus::Failed,
+            "{session_id}: idle with an error, a limit or a refusal is Failed"
+        );
+        assert!(
+            row.error.is_some(),
+            "{session_id}: a Failed row says why: {row:?}"
+        );
+    }
+    let error = subagent_rows_find(&rows, "c-error").error;
+    assert!(
+        error
+            .as_ref()
+            .is_some_and(|message| message.contains("Authentication required")),
+        "the agent's own error message is the row's error: {error:?}"
+    );
+}
+
+// Cancelled is its own outcome: neither Failed nor Done, and it carries no error.
+#[gpui::test]
+async fn subagent_rows_idle_cancelled_reads_canceled_not_failed_or_done(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let child = subagent_rows_child(&rig, "c-cancel", None, cx);
+    subagent_rows_report(&child, subagent_rows_running(), cx);
+    subagent_rows_report(
+        &child,
+        subagent_rows_idle(Some(acp_v2::StopReason::Cancelled)),
+        cx,
+    );
+
+    let row = subagent_rows_find(&subagent_rows_of(&rig, cx), "c-cancel");
+    assert_eq!(row.status, SubagentRowStatus::Canceled);
+    assert_eq!(row.error, None, "a cancellation is not an error");
+}
+
+// A child that has reported nothing (Unconfirmed), or reported that it cannot tell (Unknown),
+// is Unknown: not Done (the session's idle default) and not Running.
+#[gpui::test]
+async fn subagent_rows_unconfirmed_and_unknown_read_unknown(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let _silent = subagent_rows_child(&rig, "c-silent", None, cx);
+    let unsure = subagent_rows_child(&rig, "c-unsure", None, cx);
+    subagent_rows_report(&unsure, subagent_rows_running(), cx);
+    subagent_rows_report(
+        &unsure,
+        acp_v2::StateUpdate::Unknown(acp_v2::UnknownStateUpdate::new()),
+        cx,
+    );
+
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&rows, "c-silent").status,
+        SubagentRowStatus::Unknown,
+        "no report yet: Unknown, not the idle default"
+    );
+    assert_eq!(
+        subagent_rows_find(&rows, "c-unsure").status,
+        SubagentRowStatus::Unknown,
+        "reported unknown after running: Unknown, not still Running"
+    );
+}
+
+// Benign half: Running, and Idle with no stop reason or `end_turn`, which is Done.
+#[gpui::test]
+async fn subagent_rows_running_and_plain_idle_read_running_and_done(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let running = subagent_rows_child(&rig, "c-run", None, cx);
+    let bare = subagent_rows_child(&rig, "c-bare", None, cx);
+    let ended = subagent_rows_child(&rig, "c-end", None, cx);
+    subagent_rows_report(&running, subagent_rows_running(), cx);
+    for child in [&bare, &ended] {
+        subagent_rows_report(child, subagent_rows_running(), cx);
+    }
+    subagent_rows_report(&bare, subagent_rows_idle(None), cx);
+    subagent_rows_report(
+        &ended,
+        subagent_rows_idle(Some(acp_v2::StopReason::EndTurn)),
+        cx,
+    );
+
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&rows, "c-run").status,
+        SubagentRowStatus::Running
+    );
+    for session_id in ["c-bare", "c-end"] {
+        let row = subagent_rows_find(&rows, session_id);
+        assert_eq!(row.status, SubagentRowStatus::Done, "{session_id}");
+        assert_eq!(row.error, None, "{session_id}: Done carries no error");
+    }
+}
