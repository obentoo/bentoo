+#[path = "subagent_rows_identity_tests.rs"]
+mod identity_tests;
+#[cfg(test)]
+#[path = "subagent_rows_test_support.rs"]
+mod test_support;
+#[cfg(test)]
+#[path = "subagent_rows_tests.rs"]
+mod tests;
diff --git a/crates/acp_thread/src/subagent_rows_identity_tests.rs b/crates/acp_thread/src/subagent_rows_identity_tests.rs
new file mode 100644
index 0000000..d358529
