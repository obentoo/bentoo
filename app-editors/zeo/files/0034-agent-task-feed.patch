+++ b/crates/acp_thread/src/subagent_rows_identity_tests.rs
@@ -0,0 +1,259 @@
+// Story 064, task 1.1 (second half) — labels and identity (R1.2), replay (R1.7) and the
+// children's combined activity (`any_child_active`, read by R4.1/R4.2). Contract, assumptions and
+// wiring: see the header of `subagent_rows_tests.rs`. Filter: `cargo test -p acp_thread
+// subagent_rows`.
+
+use action_log::ActionLog;
+use agent_client_protocol::v2::schema as acp_v2;
+use gpui::{AppContext as _, TestAppContext};
+
+use super::test_support::*;
+use super::{ChildActivity, SubagentRowStatus};
+use crate::AcpThread;
+
+// ── R1.2: labels and identity ──────────────────────────────────────────────
+
+// The parent's label for the child describes it in the parent's view and wins over the
+// child's own title.
+#[gpui::test]
+async fn subagent_rows_association_title_wins_over_the_childs_own_title(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let child = subagent_rows_child(&rig, "c-1", Some("Child's own title"), cx);
+    subagent_rows_associate(
+        &child,
+        serde_json::json!({ "title": "Explore the parser" }),
+        cx,
+    );
+
+    let row = subagent_rows_find(&subagent_rows_of(&rig, cx), "c-1");
+    assert_eq!(row.label.as_ref(), "Explore the parser");
+}
+
+// Two distinct children that share a title are two rows, each named by its own session.
+#[gpui::test]
+async fn subagent_rows_two_children_with_one_title_are_two_rows(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let first = subagent_rows_child(&rig, "c-a", Some("Same"), cx);
+    let second = subagent_rows_child(&rig, "c-b", Some("Same"), cx);
+    for child in [&first, &second] {
+        subagent_rows_associate(child, serde_json::json!({ "title": "Explore" }), cx);
+    }
+    subagent_rows_report(&first, subagent_rows_running(), cx);
+    subagent_rows_report(&second, subagent_rows_requires_action(), cx);
+
+    let rows = subagent_rows_of(&rig, cx);
+    let ids: Vec<String> = rows
+        .iter()
+        .map(|row| row.child_session_id.to_string())
+        .collect();
+    assert_eq!(
+        ids,
+        ["c-a", "c-b"],
+        "one row per child, in registration order"
+    );
+    assert!(rows.iter().all(|row| row.label.as_ref() == "Explore"));
+    assert_eq!(
+        subagent_rows_find(&rows, "c-a").status,
+        SubagentRowStatus::Running
+    );
+    assert_eq!(
+        subagent_rows_find(&rows, "c-b").status,
+        SubagentRowStatus::Waiting,
+        "each row reads its own child, never its namesake's"
+    );
+}
+
+// Fallbacks: a cleared association title gives the child's title; neither gives "Subagent".
+#[gpui::test]
+async fn subagent_rows_label_falls_back_to_child_title_then_subagent(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let titled = subagent_rows_child(&rig, "c-titled", Some("Child's own title"), cx);
+    subagent_rows_associate(
+        &titled,
+        serde_json::json!({ "title": "Parent's label" }),
+        cx,
+    );
+    subagent_rows_associate(&titled, serde_json::json!({ "title": null }), cx);
+    let _bare = subagent_rows_child(&rig, "c-bare", None, cx);
+
+    let rows = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&rows, "c-titled").label.as_ref(),
+        "Child's own title",
+        "a cleared association title falls back to the child's title"
+    );
+    assert_eq!(
+        subagent_rows_find(&rows, "c-bare").label.as_ref(),
+        "Subagent"
+    );
+}
+
+// The Stop grant is the association's `can_cancel`, never assumed.
+#[gpui::test]
+async fn subagent_rows_can_cancel_follows_the_association(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let granted = subagent_rows_child(&rig, "c-granted", None, cx);
+    let _refused = subagent_rows_child(&rig, "c-refused", None, cx);
+    subagent_rows_associate(
+        &granted,
+        serde_json::json!({ "capabilities": { "cancel": {} } }),
+        cx,
+    );
+
+    let rows = subagent_rows_of(&rig, cx);
+    assert!(subagent_rows_find(&rows, "c-granted").can_cancel);
+    assert!(!subagent_rows_find(&rows, "c-refused").can_cancel);
+}
+
+// Only registered children are rows: a thread that names the parent but was never registered
+// (a fork, 0070, or a sub-thread) is not a subagent.
+#[gpui::test]
+async fn subagent_rows_unregistered_threads_are_not_rows(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    assert!(
+        subagent_rows_of(&rig, cx).is_empty(),
+        "no children, no rows"
+    );
+    assert_eq!(subagent_rows_activity(&rig, cx), ChildActivity::None);
+
+    let (parent_session_id, project) = rig.parent.read_with(cx, |thread, _| {
+        (thread.session_id().clone(), thread.project().clone())
+    });
+    let connection = rig.connection.clone();
+    let _stray = cx.update(|cx| {
+        let action_log = cx.new(|_| ActionLog::new(project.clone()));
+        cx.new(|cx| {
+            AcpThread::new(
+                Some(parent_session_id),
+                Some("Not registered".into()),
+                None,
+                connection,
+                project,
+                action_log,
+                acp_v2::SessionId::new("c-stray"),
+                watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                cx,
+            )
+        })
+    });
+    let registered = subagent_rows_child(&rig, "c-registered", None, cx);
+    subagent_rows_report(&registered, subagent_rows_running(), cx);
+
+    let ids: Vec<String> = subagent_rows_of(&rig, cx)
+        .iter()
+        .map(|row| row.child_session_id.to_string())
+        .collect();
+    assert_eq!(ids, ["c-registered"]);
+}
+
+// ── R1.7: replay ───────────────────────────────────────────────────────────
+
+// A load replays the children's states as history: afterwards a child the replay left Done or
+// Running reads Unknown, keeps its title, and cannot be stopped until the agent reports again.
+#[gpui::test]
+async fn subagent_rows_replayed_children_read_unknown_never_done_or_running(
+    cx: &mut TestAppContext,
+) {
+    let rig = subagent_rows_rig(cx).await;
+    let done = subagent_rows_child(&rig, "c-done", None, cx);
+    let running = subagent_rows_child(&rig, "c-running", None, cx);
+    for (child, title) in [(&done, "Replayed done"), (&running, "Replayed running")] {
+        subagent_rows_associate(
+            child,
+            serde_json::json!({ "title": title, "capabilities": { "cancel": {} } }),
+            cx,
+        );
+        subagent_rows_report(child, subagent_rows_running(), cx);
+    }
+    subagent_rows_report(&done, subagent_rows_idle(None), cx);
+    let before = subagent_rows_of(&rig, cx);
+    assert_eq!(
+        subagent_rows_find(&before, "c-done").status,
+        SubagentRowStatus::Done,
+        "precondition: the replay left one child Done"
+    );
+    assert_eq!(
+        subagent_rows_find(&before, "c-running").status,
+        SubagentRowStatus::Running,
+        "precondition: and one Running"
+    );
+
+    rig.parent.update(cx, |parent, cx| {
+        parent.invalidate_replayed_subagent_state(cx)
+    });
+
+    let after = subagent_rows_of(&rig, cx);
+    for (session_id, title) in [
+        ("c-done", "Replayed done"),
+        ("c-running", "Replayed running"),
+    ] {
+        let row = subagent_rows_find(&after, session_id);
+        assert_eq!(
+            row.status,
+            SubagentRowStatus::Unknown,
+            "{session_id}: a replayed state is history, not the child's current state"
+        );
+        assert_eq!(row.label.as_ref(), title, "{session_id}: the title stays");
+        assert!(
+            !row.can_cancel,
+            "{session_id}: a replayed cancel grant is withdrawn"
+        );
+    }
+    assert_eq!(
+        subagent_rows_activity(&rig, cx),
+        ChildActivity::None,
+        "replayed children never keep the thread in Background"
+    );
+}
+
+// ── any_child_active (feeds R4.1, R4.2) ───────────────────────────────────
+
+// Waiting must not collapse into Running when both are present: the thread is waiting for an
+// answer while any child is.
+#[gpui::test]
+async fn subagent_rows_any_child_active_waiting_wins_over_running(cx: &mut TestAppContext) {
+    let rig = subagent_rows_rig(cx).await;
+    let runner = subagent_rows_child(&rig, "c-run", None, cx);
+    let waiter = subagent_rows_child(&rig, "c-wait", None, cx);
+    subagent_rows_report(&runner, subagent_rows_running(), cx);
+    subagent_rows_report(&waiter, subagent_rows_running(), cx);
+    subagent_rows_report(&waiter, subagent_rows_requires_action(), cx);
+
+    assert_eq!(subagent_rows_activity(&rig, cx), ChildActivity::Waiting);
+}
+
+// Only Running and Waiting children count: Done, Failed, Canceled and Unknown ones do not, so an
+// idle parent with only those reads None (R4.4).
+#[gpui::test]
+async fn subagent_rows_any_child_active_ignores_ended_and_unknown_children(
+    cx: &mut TestAppContext,
+) {
+    let rig = subagent_rows_rig(cx).await;
+    let done = subagent_rows_child(&rig, "c-done", None, cx);
+    let failed = subagent_rows_child(&rig, "c-failed", None, cx);
+    let canceled = subagent_rows_child(&rig, "c-canceled", None, cx);
+    let _unknown = subagent_rows_child(&rig, "c-unknown", None, cx);
+    for child in [&done, &failed, &canceled] {
+        subagent_rows_report(child, subagent_rows_running(), cx);
+    }
+    subagent_rows_report(&done, subagent_rows_idle(None), cx);
+    subagent_rows_report(
+        &failed,
+        subagent_rows_idle(Some(subagent_rows_error("boom"))),
+        cx,
+    );
+    subagent_rows_report(
+        &canceled,
+        subagent_rows_idle(Some(acp_v2::StopReason::Cancelled)),
+        cx,
+    );
+    assert_eq!(subagent_rows_activity(&rig, cx), ChildActivity::None);
+
+    let late = subagent_rows_child(&rig, "c-late", None, cx);
+    subagent_rows_report(&late, subagent_rows_running(), cx);
+    assert_eq!(
+        subagent_rows_activity(&rig, cx),
+        ChildActivity::Running,
+        "one running child is enough, however many have ended"
+    );
+}
diff --git a/crates/acp_thread/src/subagent_rows_test_support.rs b/crates/acp_thread/src/subagent_rows_test_support.rs
