+// Story 012 — regressions found by the tech review of the task model, beyond the
+// pre-authored tests. Included after `acp_thread_tasks_tests.rs` (it reuses that
+// file's helpers).
+
+#[gpui::test]
+async fn test_claude_tasks_restarted_task_is_announced_again(cx: &mut TestAppContext) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    for status in ["running", "completed", "running", "completed"] {
+        tasks_send(
+            &thread,
+            tasks_snapshot(vec![tasks_wire_task("x", status, 1_000)]),
+            cx,
+        );
+    }
+
+    assert_eq!(
+        events.borrow().ended,
+        vec![
+            ("x".to_string(), "completed"),
+            ("x".to_string(), "completed")
+        ]
+    );
+}
+
+#[gpui::test]
+async fn test_claude_tasks_restarted_task_that_vanishes_ends_as_interrupted(
+    cx: &mut TestAppContext,
+) {
+    let (thread, events) = tasks_thread(Rc::new(FakeAgentConnection::new()), cx).await;
+
+    for status in ["running", "completed", "running"] {
+        tasks_send(
+            &thread,
+            tasks_snapshot(vec![tasks_wire_task("x", status, 1_000)]),
+            cx,
+        );
+    }
+    tasks_send(&thread, tasks_snapshot(vec![]), cx);
+
+    assert_eq!(
+        events.borrow().ended,
+        vec![
+            ("x".to_string(), "completed"),
+            ("x".to_string(), "interrupted")
+        ]
+    );
+    assert_eq!(
+        tasks_ids(&thread, cx),
+        vec![("x".to_string(), "interrupted")]
+    );
+}
