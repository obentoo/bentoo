+async fn test_task_actions_unsupported_for_capability_version_zero(cx: &mut gpui::TestAppContext) {
+    let peer =
+        connect_task_actions_peer(PLUS_ENTRY, PLUS_NAME, tasks_capability_v(0), task_actions_ok(), cx)
+            .await;
