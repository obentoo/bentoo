From bd1ac617f185411c6f3323b16de7f400000ca40f Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Fri, 27 Nov 2026 08:36:11 -0300
Subject: [PATCH] agent_ui: a remote project's lock warns that its agent runs
 unjailed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo next §6.53. Zed's remote projects run the agent on the remote
machine, where Zeo's jail does not reach (0057 records them as
`Reason::Remote`). The lock showed that the way it shows a jail turned
off -- a muted open lock -- though a remote agent cannot be jailed at
all and acts with everything the remote account can.

The open lock is now in warning colour for a remote project, and its
tooltip adds that the agent runs unjailed there, with everything the
account can read, write and reach. The sentence is in the nine
languages.

Test: agent_jail_status_tests.rs -- the remote summary's colour and
line.
---

diff --git a/crates/agent_ui/src/agent_jail_status.rs b/crates/agent_ui/src/agent_jail_status.rs
index b07ab03..111086d 100644
--- a/crates/agent_ui/src/agent_jail_status.rs
+++ b/crates/agent_ui/src/agent_jail_status.rs
@@ -154,6 +154,8 @@ pub fn jail_status_summary(record: &LaunchRecord, drifted: bool) -> JailStatusSu
         }
         Reason::Remote => {
             lines.push(t!("agent-jail-status-remote").into());
+            // Zeo next §6.53: a remote project's agent runs unjailed, so the lock warns.
+            lines.push(t!("agent-jail-status-remote-unjailed").into());
             IconName::LockOff
         }
         Reason::NotClaude => {
@@ -176,7 +178,7 @@ pub fn jail_status_summary(record: &LaunchRecord, drifted: bool) -> JailStatusSu
         lines.push(drifted_line().into());
     }
 
-    let color = if outdated_version.is_some() {
+    let color = if outdated_version.is_some() || record.reason == Reason::Remote {
         Color::Warning
     } else if icon == IconName::Lock {
         Color::Default
diff --git a/crates/agent_ui/src/agent_jail_status_tests.rs b/crates/agent_ui/src/agent_jail_status_tests.rs
index 64ec4c5..66d522d 100644
--- a/crates/agent_ui/src/agent_jail_status_tests.rs
+++ b/crates/agent_ui/src/agent_jail_status_tests.rs
@@ -161,6 +161,13 @@ mod icon {
             "{:?}",
             remote.lines
         );
+        // Zeo next §6.53: unjailed on the remote machine, and the lock says so in warning colour.
+        assert_eq!(remote.color, Color::Warning);
+        assert!(
+            remote.lines.iter().any(|line| line.contains("unjailed")),
+            "{:?}",
+            remote.lines
+        );
     }
 
     #[test]
