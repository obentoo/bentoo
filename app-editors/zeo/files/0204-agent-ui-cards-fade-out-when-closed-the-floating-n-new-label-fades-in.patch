index 285c161..75dd426 100644
--- a/crates/agent_ui/src/card_fade.rs
+++ b/crates/agent_ui/src/card_fade.rs
@@ -9,27 +9,49 @@
 //!
 //! GPUI keeps an animation's start in the element state of its id, and drops that state when the
 //! element is not drawn in a frame, so a card fades again each time it reappears -- and not on the
-//! frames in between, where it is redrawn with the same id. Only appearing is animated: fading out
-//! needs the card kept on screen after its state says it is gone, which no card here supports yet.
-//! The floating thread controls are left alone: they are always present, and their hover change is
-//! a style, not an appearance.
+//! frames in between, where it is redrawn with the same id.
+//!
+//! Leaving (§6.52, patch 0204): a card closed from Zeo's own controls -- the `/btw` card's close,
+//! a tasks-card row's dismiss and "Clear finished" -- stays on screen for [`CARD_FADE_OUT`] while
+//! it fades to invisible, and only then does its owner run the close it would have run at once.
+//! Nothing is copied to draw it: the card's state is still there, marked as leaving, which is why
+//! the question card is not faded out -- it closes because the agent resolved the question, and
+//! by then what it showed is gone. A leaving card draws under its own id (`<id>-out`), so the
+//! fade-out starts fresh rather than continuing the fade-in's clock. The floating thread controls
+//! are always present; only their "N new" label appears, and it fades in like a card.
 
 use std::time::Duration;
 
 use gpui::{
-    Animation, AnimationExt as _, AnyElement, App, ElementId, IntoElement, Styled, ease_out_quint,
+    Animation, AnimationExt as _, AnyElement, App, ElementId, IntoElement, SharedString, Styled,
+    ease_out_quint,
 };
 
 /// How long a card takes to fade in: short enough to read as a response to what caused it.
 pub(crate) const CARD_FADE_IN: Duration = Duration::from_millis(150);
 
+/// How long a closed card stays on screen fading out before its owner removes it. The same as
+/// the fade-in, so opening and closing read as one motion played both ways.
+pub(crate) const CARD_FADE_OUT: Duration = CARD_FADE_IN;
+
 /// The opacity a fade-in draws at `delta`, the animation's eased progress in `0.0..=1.0`.
 pub(crate) fn fade_in_opacity(delta: f32) -> f32 {
     delta.clamp(0., 1.)
 }
 
-/// A card's root, fading in when it appears.
-pub(crate) trait FadeIn: Styled + IntoElement + 'static {
+/// The opacity a fade-out draws at `delta`: the fade-in played backwards.
+pub(crate) fn fade_out_opacity(delta: f32) -> f32 {
+    1. - fade_in_opacity(delta)
+}
+
+/// Whether a close should wait for a fade-out: not when the platform asks for reduced motion,
+/// where the card goes at once, as it did before 0204.
+pub(crate) fn close_waits_for_fade(cx: &App) -> bool {
+    !cx.reduce_motion()
+}
+
+/// A card's root, fading in when it appears and out while it leaves.
+pub(crate) trait CardFade: Styled + IntoElement + 'static {
     /// This card as an element that fades in under `id` unless the platform asks for reduced
     /// motion. `id` must be stable while the card stays up and unique among the cards.
     fn fade_in(self, id: impl Into<ElementId>, cx: &App) -> AnyElement {
@@ -43,9 +65,32 @@ pub(crate) trait FadeIn: Styled + IntoElement + 'static {
         )
         .into_any_element()
     }
+
+    /// This card fading out under `id` -- a leaving card's own id, never its fade-in's. It ends
+    /// invisible and stays so until its owner stops drawing it.
+    fn fade_out(self, id: impl Into<ElementId>, cx: &App) -> AnyElement {
+        if cx.reduce_motion() {
+            return self.into_any_element();
+        }
+        self.with_animation(
+            id,
+            Animation::new(CARD_FADE_OUT).with_easing(ease_out_quint()),
+            |card, delta| card.opacity(fade_out_opacity(delta)),
+        )
+        .into_any_element()
+    }
+
+    /// [`Self::fade_in`] under `id`, or [`Self::fade_out`] under `<id>-out` while `leaving`.
+    fn fade(self, id: &'static str, leaving: bool, cx: &App) -> AnyElement {
+        if leaving {
+            self.fade_out(SharedString::from(format!("{id}-out")), cx)
+        } else {
+            self.fade_in(id, cx)
+        }
+    }
 }
 
-impl<E: Styled + IntoElement + 'static> FadeIn for E {}
+impl<E: Styled + IntoElement + 'static> CardFade for E {}
 
 #[cfg(test)]
 mod tests {
@@ -64,5 +109,14 @@ mod tests {
     #[test]
     fn card_fade_is_short_enough_to_read_as_a_response() {
         assert!(CARD_FADE_IN <= Duration::from_millis(200));
+        assert!(CARD_FADE_OUT <= Duration::from_millis(200));
+    }
+
+    #[test]
+    fn card_fade_out_starts_opaque_and_ends_invisible() {
+        assert_eq!(fade_out_opacity(0.), 1.);
+        assert_eq!(fade_out_opacity(1.), 0.);
+        assert_eq!(fade_out_opacity(1.2), 0.);
+        assert_eq!(fade_out_opacity(-0.1), 1.);
     }
 }
