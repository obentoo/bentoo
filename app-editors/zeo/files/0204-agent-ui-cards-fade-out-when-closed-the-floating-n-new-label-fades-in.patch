+++ b/crates/agent_ui/src/conversation_view/thread_view/tests/card_fade_out_tests.rs
@@ -0,0 +1,107 @@
+//! Zeo: the `/btw` card fades out when closed, and only then goes (proposal §6.52, patch 0204);
+//! under reduce motion it goes at once, as before. Filter: `card_fade_out_tests`.
+//!
+//! The card is opened with the bare `/btw` usage note, which asks the agent nothing, so the
+//! stub connection needs no side-question support.
+//!
+//! Resolves to `crates/agent_ui/src/conversation_view/thread_view/tests/card_fade_out_tests.rs`.
+
+use std::time::Duration;
+
+use gpui::VisualTestContext;
+
+use super::super::side_question_card::SideQuestionInvocation;
+use super::elicitation_decline_harness::*;
+use crate::card_fade::CARD_FADE_OUT;
+
+fn open_card(view: &gpui::Entity<super::super::ThreadView>, cx: &mut VisualTestContext) {
+    view.update(cx, |view, cx| {
+        view.show_side_question(SideQuestionInvocation::Usage, cx)
+    });
+    draw(cx);
+}
+
+fn close_card(view: &gpui::Entity<super::super::ThreadView>, cx: &mut VisualTestContext) {
+    view.update(cx, |view, cx| view.dismiss_side_question(cx));
+    draw(cx);
+}
+
+fn card_is_open(view: &gpui::Entity<super::super::ThreadView>, cx: &VisualTestContext) -> bool {
+    view.read_with(cx, |view, _| view.side_question_card.is_some())
+}
+
+fn card_is_leaving(view: &gpui::Entity<super::super::ThreadView>, cx: &VisualTestContext) -> bool {
+    view.read_with(cx, |view, _| view.side_question_card_is_leaving())
+}
+
+fn past_the_fade(cx: &mut VisualTestContext) {
+    cx.executor()
+        .advance_clock(CARD_FADE_OUT + Duration::from_millis(50));
+    draw(cx);
+}
+
+#[gpui::test]
+async fn a_closed_card_stays_while_it_fades_then_goes(cx: &mut gpui::TestAppContext) {
+    let (view, _thread, mut cx) = setup(cx).await;
+    open_card(&view, &mut cx);
+    assert!(card_is_open(&view, &cx), "fixture: the usage card is up");
+
+    close_card(&view, &mut cx);
+    assert!(
+        card_is_open(&view, &cx) && card_is_leaving(&view, &cx),
+        "right after Close the card is still drawn, fading out"
+    );
+    assert!(
+        cx.debug_bounds("side-question-card").is_some(),
+        "the leaving card is painted"
+    );
+
+    past_the_fade(&mut cx);
+    assert!(!card_is_open(&view, &cx), "the fade over, the card is gone");
+}
+
+#[gpui::test]
+async fn reduce_motion_closes_at_once(cx: &mut gpui::TestAppContext) {
+    let (view, _thread, mut cx) = setup(cx).await;
+    cx.update(|_, cx| cx.set_reduce_motion(true));
+    open_card(&view, &mut cx);
+
+    close_card(&view, &mut cx);
+    assert!(!card_is_open(&view, &cx), "no fade: Close removes the card");
+}
+
+#[gpui::test]
+async fn a_second_close_while_fading_changes_nothing(cx: &mut gpui::TestAppContext) {
+    let (view, _thread, mut cx) = setup(cx).await;
+    open_card(&view, &mut cx);
+    close_card(&view, &mut cx);
+    cx.executor().advance_clock(CARD_FADE_OUT / 2);
+    close_card(&view, &mut cx);
+
+    // Had the second Close restarted the clock, the card would still be here.
+    cx.executor()
+        .advance_clock(CARD_FADE_OUT / 2 + Duration::from_millis(20));
+    draw(&mut cx);
+    assert!(
+        !card_is_open(&view, &cx),
+        "the first Close's fade decides when the card goes"
+    );
+}
+
+#[gpui::test]
+async fn a_new_question_replaces_a_leaving_card_and_stays(cx: &mut gpui::TestAppContext) {
+    let (view, _thread, mut cx) = setup(cx).await;
+    open_card(&view, &mut cx);
+    close_card(&view, &mut cx);
+    open_card(&view, &mut cx);
+    assert!(
+        card_is_open(&view, &cx) && !card_is_leaving(&view, &cx),
+        "the new card is not leaving"
+    );
+
+    past_the_fade(&mut cx);
+    assert!(
+        card_is_open(&view, &cx),
+        "the old card's fade went with it and did not close the new one"
+    );
+}
