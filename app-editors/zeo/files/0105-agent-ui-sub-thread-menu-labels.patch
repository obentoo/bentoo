From eae47b2a873b6c4f1fdef2606b6c1587abcbc123 Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Fri, 13 Nov 2026 16:12:24 -0300
Subject: [PATCH] agent_ui: the sub-thread menu entries say what they do

Zeo 0.10.2, on the operator's request: in an agent message's context
menu (0070), "Sub-thread with context" becomes "Fork to a sub-thread"
and "Clean sub-thread" becomes "Open to a new sub-thread". Labels
only; ForkKind, the log values and the behaviour are unchanged.

Tests: sub_thread_tests::menu, ::menu_subagent and ::header follow the
new labels.
---

diff --git a/crates/agent_ui/src/sub_thread/message_menu.rs b/crates/agent_ui/src/sub_thread/message_menu.rs
index 5966c0c..0e18ef6 100644
--- a/crates/agent_ui/src/sub_thread/message_menu.rs
+++ b/crates/agent_ui/src/sub_thread/message_menu.rs
@@ -12,10 +12,10 @@ use crate::thread_organization::ForkKind;
 /// R1.6's tooltip, shown beside the disabled entry the way upstream's menus explain theirs.
 const WAIT_FOR_TURN: &str = "Wait for the turn to end";
 
-/// Adds "Clean sub-thread" and, when the agent can fork a session and open the fork, "Sub-thread
-/// with context" after a separator. `offers_sub_threads` is the caller's word that the menu belongs
-/// to an agent's message (not a thinking block, R1.5); `excerpt` is the selection, as Markdown when
-/// it has some. Anything else leaves the menu as it was (R1.4, R1.7).
+/// Adds "Open to a new sub-thread" and, when the agent can fork a session and open the fork,
+/// "Fork to a sub-thread" after a separator. `offers_sub_threads` is the caller's word that the
+/// menu belongs to an agent's message (not a thinking block, R1.5); `excerpt` is the selection,
+/// as Markdown when it has some. Anything else leaves the menu as it was (R1.4, R1.7).
 pub(crate) fn menu_entries(
     menu: ContextMenu,
     thread_view: &Entity<ThreadView>,
@@ -45,9 +45,9 @@ pub(crate) fn menu_entries(
         })
     };
     menu.separator()
-        .item(entry("Clean sub-thread", ForkKind::Clean))
+        .item(entry("Open to a new sub-thread", ForkKind::Clean))
         .when(offers_fork, |menu| {
-            let fork = entry("Sub-thread with context", ForkKind::WithContext);
+            let fork = entry("Fork to a sub-thread", ForkKind::WithContext);
             menu.item(if turn_running {
                 fork.disabled(true)
                     .documentation_aside(DocumentationSide::Left, |_| {
