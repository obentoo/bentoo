+// ---------------------------------------------------------------------------
+// R2.1 hostile split -- a multi-line recalled message: Down is caret movement until the
+// caret reaches its last line
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_down_on_a_multiline_message_moves_the_caret_until_the_last_line(
+    cx: &mut TestAppContext,
+) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    let multiline = "alpha one\nalpha two";
+    send(&view, &connection, multiline, cx);
+    send(&view, &connection, "beta", cx);
+    focus_composer(&view, cx);
+
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "beta");
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), multiline);
+
+    set_caret(&view, 0, cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        multiline,
+        "R2.1: Down on line 1 of 2 is caret movement, not a history step"
+    );
+    assert_eq!(caret(&view, cx).0.row, 1);
+
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "beta",
+        "R2.1: last line -> next newer"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "", "R2.2: the empty draft");
+}
