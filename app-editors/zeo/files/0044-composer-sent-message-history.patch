+// ---------------------------------------------------------------------------
+// Review follow-ups (not in the authored set): the other two keymaps, and the
+// persisted draft while browsing
+// ---------------------------------------------------------------------------
+
+/// Windows has its own `AcpThread > Editor` block, and vim.json loads after the
+/// default keymaps, so without its own block vim::Up/Down would shadow recall in
+/// normal mode.
+#[gpui::test]
+fn recall_keys_are_bound_on_windows_and_in_vim(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        for (keymap, context) in [
+            ("keymaps/default-windows.json", "AcpThread"),
+            ("keymaps/vim.json", "MessageEditor"),
+        ] {
+            let bindings = settings::KeymapFile::load_asset_allow_partial_failure(keymap, cx)
+                .expect("keymap loads");
+            for (key, action) in [
+                ("up", "agent::RecallOlderMessage"),
+                ("down", "agent::RecallNewerMessage"),
+            ] {
+                let bound = bindings.iter().any(|binding| {
+                    binding.action().name() == action
+                        && binding.keystrokes().len() == 1
+                        && binding.keystrokes()[0].unparse() == key
+                        && format!("{:?}", binding.predicate()).contains(context)
+                });
+                assert!(bound, "{keymap}: `{key}` must be bound to {action}");
+            }
+        }
+    });
+}
