+// ---------------------------------------------------------------------------
+// R1.5 -- mentions and attachments come back as the edit-message path rebuilds them
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_restores_mentions_and_attachments_like_edit_message(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    let thread_view = active_thread(&view, cx);
+    let session_id =
+        thread_view.read_with(cx, |view, cx| view.thread.read(cx).session_id().clone());
+
+    let mention_uri = "file:///project/file.txt";
+    cx.update(|_, cx| {
+        for block in [
+            acp_v1::ContentBlock::Text(acp_v1::TextContent::new("Look at ".to_string())),
+            acp_v1::ContentBlock::ResourceLink(acp_v1::ResourceLink::new("file.txt", mention_uri)),
+            png_image(),
+        ] {
+            connection.send_update(
+                session_id.clone(),
+                acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new(block)),
+                cx,
+            );
+        }
+        connection.send_update(
+            session_id.clone(),
+            acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new("Looked.".into())),
+            cx,
+        );
+    });
+    cx.run_until_parked();
+
+    let (user_ix, reference_editor) = thread_view.read_with(cx, |view, cx| {
+        let entries = view.thread.read(cx).entries();
+        let user_ixs: Vec<usize> = entries
+            .iter()
+            .enumerate()
+            .filter(|(_, entry)| matches!(entry, AgentThreadEntry::UserMessage(_)))
+            .map(|(ix, _)| ix)
+            .collect();
+        assert_eq!(user_ixs.len(), 1, "precondition: one operator message");
+        let editor = view
+            .entry_view_state
+            .read(cx)
+            .entry(user_ixs[0])
+            .and_then(|entry| entry.message_editor())
+            .cloned()
+            .expect("precondition: the edit-message editor exists for the user message");
+        (user_ixs[0], editor)
+    });
+    let _ = user_ix;
+    let expected_text = reference_editor.read_with(cx, |editor, cx| editor.text(cx));
+    let expected_blocks =
+        reference_editor.read_with(cx, |editor, cx| editor.draft_content_blocks_snapshot(cx));
+    let expected_mentions =
+        reference_editor.read_with(cx, |editor, cx| editor.mention_set().read(cx).mentions());
+
+    focus_composer(&view, cx);
+    press("up", cx);
+
+    let composer = message_editor(&view, cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        expected_text,
+        "R1.5: same text as the edit-message reconstruction"
+    );
+    let blocks = composer.read_with(cx, |editor, cx| editor.draft_content_blocks_snapshot(cx));
+    assert_eq!(
+        blocks, expected_blocks,
+        "R1.5: same content blocks as edit-message"
+    );
+    assert!(
+        blocks.iter().any(|block| matches!(
+            block,
+            acp_v2::ContentBlock::ResourceLink(link) if link.uri == mention_uri
+        )),
+        "R1.5: the mention is a mention again, not plain text: {blocks:?}"
+    );
+    assert!(
+        blocks
+            .iter()
+            .any(|block| matches!(block, acp_v2::ContentBlock::Image(_))),
+        "R1.5: the attachment comes back: {blocks:?}"
+    );
+    let mentions = composer.read_with(cx, |editor, cx| editor.mention_set().read(cx).mentions());
+    assert_eq!(
+        mentions, expected_mentions,
+        "R1.5: same mention set as edit-message"
+    );
+}
