new file mode 100644
index 0000000..580e9fc
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/sent_history/tests.rs
@@ -0,0 +1,385 @@
+//! Unit tests for `SentMessageHistory` (story 018, Task 2.1).
+//!
+//! Wiring: `crates/agent_ui/src/conversation_view/sent_history.rs` declares
+//! `#[cfg(test)] mod tests;`, which resolves to this file.
+//!
+//! Contract under test (from the sub-task Objective): a per-thread model holding the
+//! browse position and the saved draft, with `start(entries, draft)`, `older()`,
+//! `newer()` returning the entry index to show or the `Draft`, and `end()`.
+//!
+//! The only lines tied to the model's exact signature are in the "contract adapter"
+//! section below; if the implementation's names drift, change them there only.
+//!
+//! Identity rules are tested hostile-half first (see each test's comment): the fixture
+//! that would make the rule wrongly collapse two things, then the one that would make it
+//! wrongly split one thing, then the benign case.
+
+use std::sync::Arc;
+
+use acp_thread::{
+    AgentThreadEntry, AssistantMessage, AssistantMessageChunk, MessageContent, MessageIdentity,
+    UserMessage,
+};
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{App, TestAppContext};
+use language::LanguageRegistry;
+
+use crate::conversation_view::sent_history::{Recall, SentMessageHistory};
+
+// ---------------------------------------------------------------------------
+// Contract adapter
+// ---------------------------------------------------------------------------
+
+type Draft = Vec<acp_v2::ContentBlock>;
+
+/// What the composer is told to show after one step of the history.
+#[derive(Debug, PartialEq)]
+enum Shown {
+    /// The user message at this index of `AcpThread::entries()`.
+    Entry(usize),
+    /// The draft that was in the composer when browsing started.
+    Draft(Draft),
+    /// No history step happened: the caller falls back to caret movement.
+    Nothing,
+}
+
+fn shown(step: Option<Recall>) -> Shown {
+    match step {
+        Some(Recall::Entry(ix)) => Shown::Entry(ix),
+        Some(Recall::Draft(draft)) => Shown::Draft(draft),
+        None => Shown::Nothing,
+    }
+}
+
+fn start(history: &mut SentMessageHistory, entries: &[AgentThreadEntry], draft: Draft) -> Shown {
+    shown(history.start(entries, draft))
+}
+
+fn older(history: &mut SentMessageHistory) -> Shown {
+    shown(history.older())
+}
+
+fn newer(history: &mut SentMessageHistory) -> Shown {
+    shown(history.newer())
+}
+
+// ---------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------
+
+fn draft(text: &str) -> Draft {
+    vec![acp_v2::ContentBlock::Text(acp_v2::TextContent::new(
+        text.to_string(),
+    ))]
+}
+
+fn languages(cx: &App) -> Arc<LanguageRegistry> {
+    Arc::new(LanguageRegistry::test(cx.background_executor().clone()))
+}
+
+fn user_message(text: &str, is_optimistic: bool, indented: bool, cx: &mut App) -> AgentThreadEntry {
+    let languages = languages(cx);
+    AgentThreadEntry::UserMessage(UserMessage {
+        identity: MessageIdentity::Legacy(None),
+        meta: None,
+        client_id: None,
+        is_optimistic,
+        content: MessageContent::new(text.into(), &languages, util::paths::PathStyle::local(), cx),
+        checkpoint: None,
+        indented,
+    })
+}
+
+/// A message the operator typed and sent in this session. The client pushes it itself,
+/// so it is optimistic -- and it stays optimistic for the rest of the session when the
+/// agent does not echo it back. It is SENT, not queued.
+fn sent_live(text: &str, cx: &mut App) -> AgentThreadEntry {
+    user_message(text, true, false, cx)
+}
+
+/// An operator message replayed by the agent when a thread is reopened.
+fn sent_restored(text: &str, cx: &mut App) -> AgentThreadEntry {
+    user_message(text, false, false, cx)
+}
+
+/// A prompt shown inside a subagent's output: a `UserMessage`, but not the operator's.
+fn subagent_prompt(text: &str, cx: &mut App) -> AgentThreadEntry {
+    user_message(text, false, true, cx)
+}
+
+fn agent(text: &str, cx: &mut App) -> AgentThreadEntry {
+    let languages = languages(cx);
+    AgentThreadEntry::AssistantMessage(AssistantMessage {
+        chunks: vec![AssistantMessageChunk::from_str(
+            text,
+            &languages,
+            util::paths::PathStyle::local(),
+            cx,
+        )],
+        indented: false,
+        is_subagent_output: false,
+    })
+}
+
+/// An operator message whose content is missing: nothing to rebuild in the composer.
+fn without_content() -> AgentThreadEntry {
+    AgentThreadEntry::UserMessage(UserMessage {
+        identity: MessageIdentity::Legacy(None),
+        meta: None,
+        client_id: None,
+        is_optimistic: false,
+        content: MessageContent::default(),
+        checkpoint: None,
+        indented: false,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// R4.1 -- only the operator's own messages
+// ---------------------------------------------------------------------------
+
+/// Hostile half 1 (wrong collapse): entries that LOOK like operator messages -- a subagent
+/// prompt (a `UserMessage`, even the newest entry) and an agent reply with the same text
+/// as an operator message -- must never be offered.
+#[gpui::test]
+fn sent_history_never_offers_subagent_prompts_or_agent_messages(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("deploy it", cx),        // 0
+            agent("deploy it", cx),            // 1 -- same text, agent's
+            subagent_prompt("deploy it", cx),  // 2 -- same text, subagent's
+            sent_live("now roll back", cx),    // 3
+            agent("rolled back", cx),          // 4
+            subagent_prompt("check logs", cx), // 5 -- newest entry, not the operator's
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, draft("")), Shown::Entry(3));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        assert_eq!(
+            older(&mut history),
+            Shown::Entry(0),
+            "R1.3: saturates at the oldest"
+        );
+        assert_eq!(newer(&mut history), Shown::Entry(3));
+        assert_eq!(newer(&mut history), Shown::Draft(draft("")));
+    });
+}
+
+/// Hostile half 2 (wrong split): the operator's messages come in different shapes -- sent
+/// live in this session (optimistic, never echoed) and replayed from a previous run
+/// (not optimistic). Both are the operator's sent messages and both must be offered.
+/// R4.4's "queued" messages are not thread entries at all, so being optimistic must not
+/// be mistaken for being queued.
+#[gpui::test]
+fn sent_history_offers_live_and_restored_operator_messages_alike(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_restored("from the previous run", cx), // 0
+            agent("ok", cx),                            // 1
+            sent_live("from this run", cx),             // 2
+            agent("ok", cx),                            // 3
+            sent_live("just sent, no reply yet", cx),   // 4
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, draft("")), Shown::Entry(4));
+        assert_eq!(older(&mut history), Shown::Entry(2));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+    });
+}
+
+/// R1.2: the history steps through sent MESSAGES, not distinct texts. Two sends of the
+/// same text are two messages; collapsing them would make one Up appear to do nothing.
+#[gpui::test]
+fn sent_history_keeps_repeated_texts_as_separate_messages(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("run the tests", cx), // 0
+            agent("2 failures", cx),        // 1
+            sent_live("run the tests", cx), // 2
+            agent("all green", cx),         // 3
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, draft("")), Shown::Entry(2));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+    });
+}
+
+// ---------------------------------------------------------------------------
+// R1.1-R1.4, R2.1-R2.2, R3.3 -- walking and the saved draft
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+fn sent_history_walks_newest_first_saturates_and_returns_the_draft(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("first", cx),  // 0
+            agent("a", cx),          // 1
+            sent_live("second", cx), // 2
+            agent("b", cx),          // 3
+            sent_live("third", cx),  // 4
+            agent("c", cx),          // 5
+        ];
+        let mut history = SentMessageHistory::default();
+
+        // R1.1 / R1.2 / R1.3
+        assert_eq!(
+            start(&mut history, &entries, draft("half-typed")),
+            Shown::Entry(4)
+        );
+        assert_eq!(older(&mut history), Shown::Entry(2));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        // R2.1
+        assert_eq!(newer(&mut history), Shown::Entry(2));
+        assert_eq!(newer(&mut history), Shown::Entry(4));
+        // R2.2 / R3.3: the draft given to `start`, unchanged by the walk
+        assert_eq!(newer(&mut history), Shown::Draft(draft("half-typed")));
+        // Restoring the draft ends browsing: another step is not a history step.
+        assert_eq!(newer(&mut history), Shown::Nothing);
+        assert_eq!(older(&mut history), Shown::Nothing);
+    });
+}
+
+/// R2.2: "including an empty draft" -- an empty composer is restored as empty, not as
+/// "no draft".
+#[gpui::test]
+fn sent_history_restores_an_empty_draft(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![sent_live("only", cx)];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, Vec::new()), Shown::Entry(0));
+        assert_eq!(newer(&mut history), Shown::Draft(Vec::new()));
+    });
+}
+
+/// R1.4: no operator message means no history step, so the caller moves the caret.
+/// Hostile: entries that are all NOT the operator's still count as "no message sent".
+#[gpui::test]
+fn sent_history_without_operator_messages_does_not_start(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let mut history = SentMessageHistory::default();
+        assert_eq!(start(&mut history, &[], draft("x")), Shown::Nothing);
+
+        let not_the_operators = vec![agent("hello", cx), subagent_prompt("look around", cx)];
+        assert_eq!(
+            start(&mut history, &not_the_operators, draft("x")),
+            Shown::Nothing
+        );
+        // Not browsing: Down is not a history step either (R2.3).
+        assert_eq!(newer(&mut history), Shown::Nothing);
+    });
+}
+
+// ---------------------------------------------------------------------------
+// R3.4 / R4.3 -- ending and restarting
+// ---------------------------------------------------------------------------
+
+/// After `end()`, the next `start` begins again at the newest message and saves the NEW
+/// draft. Hostile: a stale saved draft or a stale position surviving `end()`.
+#[gpui::test]
+fn sent_history_end_forgets_position_and_draft(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("first", cx),
+            agent("a", cx),
+            sent_live("second", cx),
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(
+            start(&mut history, &entries, draft("old draft")),
+            Shown::Entry(2)
+        );
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        history.end();
+
+        assert_eq!(
+            newer(&mut history),
+            Shown::Nothing,
+            "not browsing after end()"
+        );
+        assert_eq!(
+            start(&mut history, &entries, draft("edited")),
+            Shown::Entry(2)
+        );
+        assert_eq!(newer(&mut history), Shown::Draft(draft("edited")));
+    });
+}
+
+/// R4.3 / Task 4: the list is taken from the entries given to each `start`, not cached.
+/// Hostile third element: a message sent after the previous browse must be the first one
+/// offered by the next.
+#[gpui::test]
+fn sent_history_start_reads_the_current_entries(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let mut entries = vec![sent_live("first", cx), agent("a", cx)];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, draft("")), Shown::Entry(0));
+        history.end();
+
+        entries.push(sent_live("second", cx)); // 2
+        entries.push(agent("b", cx)); // 3
+        assert_eq!(start(&mut history, &entries, draft("")), Shown::Entry(2));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+    });
+}
+
+// ---------------------------------------------------------------------------
+// Q4 -- an entry that cannot be rebuilt is skipped
+// ---------------------------------------------------------------------------
+
+/// Q4: an operator message with no content cannot be rebuilt in the composer; it is
+/// skipped in both directions instead of showing an empty composer.
+#[gpui::test]
+fn sent_history_skips_a_message_without_content(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("first", cx), // 0
+            without_content(),      // 1
+            sent_live("third", cx), // 2
+            without_content(),      // 3 -- newest
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(start(&mut history, &entries, draft("d")), Shown::Entry(2));
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        assert_eq!(newer(&mut history), Shown::Entry(2));
+        assert_eq!(newer(&mut history), Shown::Draft(draft("d")));
+    });
+}
+
+/// Validation fix round 2: abandoning hands back the saved draft and ends
+/// browsing, so a caller can put the draft back in the composer.
+#[gpui::test]
+fn sent_history_abandon_returns_the_draft_and_ends_browsing(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let entries = vec![
+            sent_live("first", cx),
+            agent("a", cx),
+            sent_live("second", cx),
+        ];
+        let mut history = SentMessageHistory::default();
+
+        assert_eq!(
+            history.abandon(),
+            None,
+            "nothing to abandon when not browsing"
+        );
+        assert_eq!(
+            start(&mut history, &entries, draft("kept")),
+            Shown::Entry(2)
+        );
+        assert_eq!(older(&mut history), Shown::Entry(0));
+        assert_eq!(history.abandon(), Some(draft("kept")));
+        assert_eq!(
+            newer(&mut history),
+            Shown::Nothing,
+            "not browsing after abandon()"
+        );
+    });
+}
diff --git a/crates/agent_ui/src/conversation_view/tests/recall_end_point_tests.rs b/crates/agent_ui/src/conversation_view/tests/recall_end_point_tests.rs
new file mode 100644
index 0000000..ada3d9c
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/tests/recall_end_point_tests.rs
@@ -0,0 +1,294 @@
+//! Composer recall: one end point for browsing (story 018, Task 8.1).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view.rs`'s `mod tests { .. }`, declare
+//! `mod recall_end_point_tests;` (resolves to this file). Uses the harness in
+//! `recall_tests.rs` (Task 3.1).
+//!
+//! Contract (R4.3, R4.5, R2.4): whatever path an operator message enters the thread by,
+//! browsing ends and the next Up starts from that message. When the message did NOT come
+//! from the composer, the composer is put back on the draft browsing started from; when it
+//! DID, the composer stays empty -- the old draft is not resurrected over a send. A
+//! recalled message that stops existing ends browsing with the draft back.
+//!
+//! Order follows the hostile-half rule: the composer send (where restoring the draft
+//! would be the wrong collapse) comes before the queue's Send Now (where leaving the
+//! browse alive would be the wrong split).
+
+use super::recall_tests::{
+    composer_text, composer_with_stub, focus_composer, press, send, type_draft,
+};
+use super::*;
+use gpui::{TestAppContext, VisualTestContext};
+
+/// The operator's own messages in the thread, oldest first.
+fn operator_messages(view: &Entity<ConversationView>, cx: &mut VisualTestContext) -> Vec<String> {
+    active_thread(view, cx).read_with(cx, |view, cx| {
+        view.thread
+            .read(cx)
+            .entries()
+            .iter()
+            .filter_map(|entry| entry.user_message())
+            .filter(|message| !message.indented)
+            .map(|message| message.content.to_markdown(cx).trim().to_string())
+            .collect()
+    })
+}
+
+fn next_turn_says(connection: &StubAgentConnection, text: &'static str) {
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new(text.into()),
+    )]);
+}
+
+// ---------------------------------------------------------------------------
+// R4.3 hostile half -- a composer send must NOT bring the old draft back
+// ---------------------------------------------------------------------------
+
+/// The operator sends the recalled message itself, unedited, from the composer. Browsing
+/// ends, but the composer was the source of the message: it stays empty, and the draft
+/// saved when browsing started ("old draft") is gone for good -- also from the next
+/// browse, whose own saved draft is the empty composer.
+#[gpui::test]
+async fn recall_end_point_composer_send_leaves_the_composer_empty(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "alpha", cx);
+    send(&view, &connection, "bravo", cx);
+
+    type_draft(&view, "old draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "alpha", "precondition: browsing");
+
+    // Send exactly what is shown -- no retyping, so browsing is still on when send runs.
+    next_turn_says(&connection, "Again.");
+    active_thread(&view, cx).update_in(cx, |thread, window, cx| thread.send(window, cx));
+    cx.run_until_parked();
+    assert_eq!(
+        operator_messages(&view, cx),
+        vec!["alpha", "bravo", "alpha"],
+        "precondition: the recalled message was sent"
+    );
+
+    assert_eq!(
+        composer_text(&view, cx),
+        "",
+        "R4.5 converse: a message sent from the composer does not restore the old draft"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "alpha",
+        "R4.3: the next Up starts from the message just sent"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "bravo",
+        "R4.3: a fresh walk, not the old browse's position"
+    );
+    press("down", cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "",
+        "the new browse saved the empty composer, not \"old draft\""
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R4.3 + R4.5 -- a queued message sent with Send Now while browsing
+// ---------------------------------------------------------------------------
+
+/// Send Now dispatches a queued message without going through the composer. The composer
+/// still shows a recalled message, which was never the operator's draft: browsing must end
+/// with the saved draft back (R4.5), and the next Up must start from the message that just
+/// entered the thread from the queue (R4.3).
+#[gpui::test]
+async fn recall_end_point_send_now_from_the_queue_restores_the_draft(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "first", cx);
+    send(&view, &connection, "second", cx);
+
+    let thread_view = active_thread(&view, cx);
+    thread_view.update_in(cx, |thread, window, cx| {
+        thread.add_to_queue(
+            vec![acp_v2::ContentBlock::Text(acp_v2::TextContent::new(
+                "queued one".to_string(),
+            ))],
+            vec![],
+            window,
+            cx,
+        );
+    });
+    cx.run_until_parked();
+
+    type_draft(&view, "my draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "second", "precondition: browsing");
+
+    next_turn_says(&connection, "Done with the queue.");
+    thread_view.update_in(cx, |thread, window, cx| {
+        let id = thread
+            .message_queue
+            .first_id()
+            .expect("precondition: the message is queued");
+        thread.send_queued_message_now(id, window, cx);
+    });
+    cx.run_until_parked();
+    let queue_len = thread_view.read_with(cx, |thread, _| thread.message_queue.len());
+    assert_eq!(queue_len, 0, "precondition: Send Now took it off the queue");
+    assert_eq!(
+        operator_messages(&view, cx),
+        vec!["first", "second", "queued one"],
+        "precondition: the queued message entered the thread"
+    );
+
+    assert_eq!(
+        composer_text(&view, cx),
+        "my draft",
+        "R4.5: a message sent from the queue ends browsing and puts the saved draft back"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "queued one",
+        "R4.3: the next Up starts from the message just sent from the queue"
+    );
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "second");
+    press("down", cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "my draft",
+        "the draft survives the second browse too"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R2.4 -- the recalled message stops existing under the browse
+// ---------------------------------------------------------------------------
+
+fn rewind_to_operator_message(
+    view: &Entity<ConversationView>,
+    nth: usize,
+    cx: &mut VisualTestContext,
+) -> Task<Result<()>> {
+    let thread = active_thread(view, cx).read_with(cx, |view, _| view.thread.clone());
+    let client_id = thread.read_with(cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .filter_map(|entry| entry.user_message())
+            .filter(|message| !message.indented)
+            .nth(nth)
+            .and_then(|message| message.client_id.clone())
+            .expect("precondition: the message has a client id to rewind to")
+    });
+    thread.update(cx, |thread, cx| thread.rewind(client_id, cx))
+}
+
+/// The thread is rewound to before "second" while the composer shows "third": both
+/// messages the browse knows about past "first" are gone. The next step must not walk on
+/// to an entry that no longer exists -- browsing ends with the saved draft back -- and a
+/// fresh Up then starts from what is left.
+#[gpui::test]
+async fn recall_end_point_truncated_entries_end_browsing_with_the_draft(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "first", cx);
+    send(&view, &connection, "second", cx);
+    send(&view, &connection, "third", cx);
+
+    type_draft(&view, "my draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "third", "precondition: browsing");
+
+    rewind_to_operator_message(&view, 1, cx)
+        .await
+        .expect("precondition: the rewind succeeds");
+    cx.run_until_parked();
+    assert_eq!(
+        operator_messages(&view, cx),
+        vec!["first"],
+        "precondition: second and third were truncated"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "my draft",
+        "R2.4: a recalled message that no longer exists ends browsing with the draft back"
+    );
+
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "first",
+        "a fresh browse starts from what survived the truncation"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "my draft");
+}
+
+/// Hostile third element: after the truncation, the stale index is occupied again -- by a
+/// subagent prompt, a `UserMessage` that is not the operator's. The index exists, the
+/// recalled message does not; browsing must still end with the draft back rather than
+/// show the subagent's prompt as if it were the operator's.
+#[gpui::test]
+async fn recall_end_point_a_reused_stale_index_still_ends_browsing(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "first", cx);
+    send(&view, &connection, "second", cx);
+    send(&view, &connection, "third", cx);
+
+    type_draft(&view, "my draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "third", "precondition: browsing");
+
+    rewind_to_operator_message(&view, 1, cx)
+        .await
+        .expect("precondition: the rewind succeeds");
+    cx.run_until_parked();
+    let thread = active_thread(&view, cx).read_with(cx, |view, _| view.thread.clone());
+    thread.update(cx, |thread, cx| {
+        thread.push_user_content_block_with_indent(
+            None,
+            "subagent: check the logs".into(),
+            true,
+            cx,
+        );
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        operator_messages(&view, cx),
+        vec!["first"],
+        "precondition: the subagent prompt is not an operator message"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "my draft",
+        "R2.4: the stale position now holds another entry -- browsing ends with the draft"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "first",
+        "a fresh browse skips the subagent prompt"
+    );
+}
diff --git a/crates/agent_ui/src/conversation_view/tests/recall_ends_tests.rs b/crates/agent_ui/src/conversation_view/tests/recall_ends_tests.rs
new file mode 100644
index 0000000..3529b12
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/tests/recall_ends_tests.rs
@@ -0,0 +1,347 @@
+//! Composer recall: when browsing ends, and whose history it is (story 018, Task 3.2).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view.rs`'s `mod tests { .. }`, declare
+//! `mod recall_ends_tests;` (resolves to this file). Uses the harness in
+//! `recall_tests.rs` (Task 3.1), declared beside it.
+//!
+//! Behaviour-level: real default keymap, real keystrokes, real send path.
+
+use super::recall_tests::{
+    bind_default_keymap, composer_text, composer_with_stub, focus_composer, press, send, type_draft,
+};
+use super::*;
+use gpui::{TestAppContext, VisualTestContext};
+
+/// Sends whatever is in the composer right now, as the operator pressing Enter would.
+fn send_composer_as_is(
+    view: &Entity<ConversationView>,
+    connection: &StubAgentConnection,
+    cx: &mut VisualTestContext,
+) {
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new("Done again.".into()),
+    )]);
+    active_thread(view, cx).update_in(cx, |thread, window, cx| thread.send(window, cx));
+    cx.run_until_parked();
+}
+
+// ---------------------------------------------------------------------------
+// R3.4 -- an edit ends browsing
+// ---------------------------------------------------------------------------
+
+/// The recall's own replacement of the composer is NOT an operator edit (otherwise the
+/// second Up would restart at the newest); typing into the recalled text IS one.
+#[gpui::test]
+async fn recall_ends_when_the_recalled_message_is_edited(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "alpha", cx);
+    send(&view, &connection, "bravo", cx);
+    send(&view, &connection, "charlie", cx);
+
+    type_draft(&view, "old draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "bravo",
+        "the recall itself must not end browsing"
+    );
+
+    cx.simulate_input("!");
+    cx.run_until_parked();
+    let edited = composer_text(&view, cx);
+    assert!(
+        edited.contains("bravo") && edited.contains('!'),
+        "precondition: the operator edited the recalled text, got {edited:?}"
+    );
+
+    // Browsing ended: Up starts again from the most recent message. Had it continued,
+    // Up would have gone on to "alpha".
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "charlie",
+        "R3.4: next Up starts from the most recent message"
+    );
+    // ...and the edited text is the draft Down restores, not the one from before.
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        edited,
+        "R3.4: the edited text became the new draft"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R4.3 -- sending ends browsing
+// ---------------------------------------------------------------------------
+
+/// Hostile third element: the resent text equals a message already in the history, so
+/// only its POSITION tells the two apart. A stale browse position would walk on to
+/// "alpha"; a stale saved draft would bring back "old draft".
+#[gpui::test]
+async fn recall_ends_when_a_message_is_sent(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "alpha", cx);
+    send(&view, &connection, "bravo", cx);
+    send(&view, &connection, "charlie", cx);
+
+    type_draft(&view, "old draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "bravo");
+
+    send_composer_as_is(&view, &connection, cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "",
+        "precondition: the resend went out"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "bravo",
+        "R4.3: the message just sent comes first"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "charlie",
+        "R4.3: then the one sent before it, not the stale position's neighbour"
+    );
+    press("down", cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "",
+        "R4.3: the draft is the empty composer after the send, not the old draft"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R4.2 -- each thread has its own history, including a reopened thread's
+// ---------------------------------------------------------------------------
+
+fn new_conversation_view(
+    connection: &StubAgentConnection,
+    resume_session_id: Option<acp_v2::SessionId>,
+    workspace: &Entity<workspace::Workspace>,
+    project: &Entity<Project>,
+    cx: &mut VisualTestContext,
+) -> Entity<ConversationView> {
+    let thread_store = cx.update(|_window, cx| cx.new(|cx| ThreadStore::new(cx)));
+    let connection_store =
+        cx.update(|_window, cx| cx.new(|cx| AgentConnectionStore::new(project.clone(), cx)));
+    let view = cx.update(|window, cx| {
+        cx.new(|cx| {
+            ConversationView::new(
+                Rc::new(StubAgentServer::new(connection.clone())),
+                connection_store,
+                Agent::Custom { id: "Test".into() },
+                resume_session_id,
+                None,
+                None,
+                None,
+                None,
+                workspace.downgrade(),
+                project.clone(),
+                Some(thread_store),
+                AgentThreadSource::AgentPanel,
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    view
+}
+
+/// Hostile half (wrong collapse): two threads side by side must not share a history.
+#[gpui::test]
+async fn recall_ends_at_the_thread_boundary(cx: &mut TestAppContext) {
+    init_test(cx);
+    bind_default_keymap(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+
+    let connection_a = StubAgentConnection::new();
+    let connection_b = StubAgentConnection::new();
+    let view_a = new_conversation_view(&connection_a, None, &workspace, &project, cx);
+    let view_b = new_conversation_view(&connection_b, None, &workspace, &project, cx);
+
+    add_to_workspace(view_a.clone(), cx);
+    send(&view_a, &connection_a, "alpha in A", cx);
+    add_to_workspace(view_b.clone(), cx);
+    send(&view_b, &connection_b, "bravo in B", cx);
+
+    focus_composer(&view_b, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view_b, cx),
+        "bravo in B",
+        "R4.2: B's own message"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view_b, cx),
+        "bravo in B",
+        "R4.2: B's oldest is B's -- A's message is not in B's history"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view_b, cx), "");
+
+    // Switch back to A.
+    add_to_workspace(view_a.clone(), cx);
+    focus_composer(&view_a, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view_a, cx),
+        "alpha in A",
+        "R4.2: A's own message"
+    );
+    press("up", cx);
+    assert_eq!(composer_text(&view_a, cx), "alpha in A");
+}
+
+/// Hostile half (wrong split): a reopened thread's replayed messages and the messages sent
+/// after reopening are one history.
+#[gpui::test]
+async fn recall_ends_reopened_thread_keeps_restored_messages(cx: &mut TestAppContext) {
+    init_test(cx);
+    bind_default_keymap(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+
+    let connection = StubAgentConnection::new().with_supports_load_session(true);
+    let session_id = acp_v2::SessionId::new("reopened-session");
+    let view = new_conversation_view(
+        &connection,
+        Some(session_id.clone()),
+        &workspace,
+        &project,
+        cx,
+    );
+    add_to_workspace(view.clone(), cx);
+
+    // The agent replays the previous run, as `session/load` does.
+    cx.update(|_, cx| {
+        connection.send_update(
+            session_id.clone(),
+            acp_v1::SessionUpdate::UserMessageChunk(acp_v1::ContentChunk::new(
+                "restored question".into(),
+            )),
+            cx,
+        );
+        connection.send_update(
+            session_id.clone(),
+            acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(
+                "restored answer".into(),
+            )),
+            cx,
+        );
+    });
+    cx.run_until_parked();
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "restored question",
+        "R4.2: a message restored from a previous run is in the history"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "");
+
+    send(&view, &connection, "live follow-up", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "live follow-up");
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "restored question",
+        "R4.2: restored and live messages form one history"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R4.3 / R2.2 -- resubmitting an edited earlier message (validation fix round 2)
+// ---------------------------------------------------------------------------
+
+/// `regenerate` resends an earlier message from its own editor and never goes
+/// through the composer's send, so it must end browsing itself. The recalled
+/// text in the composer was never the operator's draft: the draft comes back.
+#[gpui::test]
+async fn recall_ends_when_an_earlier_message_is_resubmitted(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "alpha", cx);
+    send(&view, &connection, "bravo", cx);
+
+    type_draft(&view, "my draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "bravo", "precondition: browsing");
+
+    let thread_view = active_thread(&view, cx);
+    let (alpha_ix, alpha_editor) = thread_view.read_with(cx, |view, cx| {
+        let alpha_ix = view
+            .thread
+            .read(cx)
+            .entries()
+            .iter()
+            .position(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)))
+            .expect("precondition: alpha is in the thread");
+        let editor = view
+            .entry_view_state
+            .read(cx)
+            .entry(alpha_ix)
+            .and_then(|entry| entry.message_editor())
+            .cloned()
+            .expect("precondition: alpha has an edit-message editor");
+        (alpha_ix, editor)
+    });
+    alpha_editor.update_in(cx, |editor, window, cx| {
+        editor.set_text("alpha edited", window, cx)
+    });
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new("Redone.".into()),
+    )]);
+    thread_view.update_in(cx, |view, window, cx| {
+        view.regenerate(alpha_ix, alpha_editor.clone(), window, cx)
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        composer_text(&view, cx),
+        "my draft",
+        "R2.2: the recalled message is replaced by the draft browsing started from"
+    );
+    focus_composer(&view, cx);
+    set_caret_to_start(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "alpha edited",
+        "R4.3: the next Up starts from the message just resubmitted"
+    );
+}
+
+fn set_caret_to_start(view: &Entity<ConversationView>, cx: &mut VisualTestContext) {
+    message_editor(view, cx).update_in(cx, |editor, window, cx| {
+        editor.set_cursor_offset(0, window, cx)
+    });
+    cx.run_until_parked();
+}
diff --git a/crates/agent_ui/src/conversation_view/tests/recall_indices_tests.rs b/crates/agent_ui/src/conversation_view/tests/recall_indices_tests.rs
new file mode 100644
index 0000000..51ed194
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/tests/recall_indices_tests.rs
@@ -0,0 +1,154 @@
+//! Composer recall vs. a thread whose entries keep changing (story 018, Task 4.1).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view.rs`'s `mod tests { .. }`, declare
+//! `mod recall_indices_tests;` (resolves to this file). Uses the harness in
+//! `recall_tests.rs` (Task 3.1).
+//!
+//! Contract: whatever the composer recalls is always one of the operator's own messages
+//! of the current thread -- never an agent message, never a subagent prompt, never a
+//! queued message -- even while the agent streams new entries during browsing.
+
+use super::recall_tests::{
+    composer_text, composer_with_stub, focus_composer, press, send, type_draft,
+};
+use super::*;
+use gpui::{TestAppContext, VisualTestContext};
+
+/// Sends `text` and leaves the agent's turn open, so entries can stream in afterwards.
+fn send_and_keep_turn_open(
+    view: &Entity<ConversationView>,
+    text: &str,
+    cx: &mut VisualTestContext,
+) {
+    type_draft(view, text, cx);
+    active_thread(view, cx).update_in(cx, |thread, window, cx| thread.send(window, cx));
+    cx.run_until_parked();
+}
+
+fn stream_agent_chunk(
+    connection: &StubAgentConnection,
+    session_id: &acp_v2::SessionId,
+    text: &'static str,
+    cx: &mut VisualTestContext,
+) {
+    cx.update(|_, cx| {
+        connection.send_update(
+            session_id.clone(),
+            acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new(text.into())),
+            cx,
+        );
+    });
+    cx.run_until_parked();
+}
+
+/// A subagent's prompt, rendered indented in the parent thread: a `UserMessage` entry that
+/// is not the operator's.
+fn stream_subagent_prompt(thread: &Entity<AcpThread>, text: &str, cx: &mut VisualTestContext) {
+    thread.update(cx, |thread, cx| {
+        thread.push_user_content_block_with_indent(None, text.into(), true, cx);
+    });
+    cx.run_until_parked();
+}
+
+/// Hostile third element: while browsing, entries that are NOT the operator's arrive --
+/// including a subagent prompt that is newer than every operator message. Every step must
+/// land on an operator message, and a fresh Up must skip the subagent prompt.
+#[gpui::test]
+async fn recall_indices_stay_on_operator_messages_while_entries_stream(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "first", cx);
+    send(&view, &connection, "second", cx);
+    send_and_keep_turn_open(&view, "third", cx);
+
+    let thread = active_thread(&view, cx).read_with(cx, |view, _| view.thread.clone());
+    let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "third");
+
+    stream_agent_chunk(&connection, &session_id, "Working on it", cx);
+    stream_subagent_prompt(&thread, "subagent: check the logs", cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "second",
+        "R4.1: streaming did not shift the walk"
+    );
+
+    stream_agent_chunk(&connection, &session_id, "Still working", cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "first");
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "second");
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "third");
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "", "back to the empty draft");
+
+    // A fresh browse: the newest UserMessage entry is the subagent's prompt.
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "third",
+        "R4.1: the subagent's prompt is not the operator's message"
+    );
+    press("down", cx);
+
+    cx.update(|_, _| connection.end_turn(session_id.clone(), acp_v1::StopReason::EndTurn));
+    cx.run_until_parked();
+}
+
+/// R4.4. Hostile split: a message sent in this session stays optimistic in the thread (the
+/// stub, like many agents, never echoes it) -- it is SENT and belongs in the history. A
+/// queued message is not sent and does not.
+#[gpui::test]
+async fn recall_indices_leave_queued_messages_out(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "sent one", cx);
+
+    let thread_view = active_thread(&view, cx);
+    thread_view.read_with(cx, |view, cx| {
+        let sent_is_optimistic = view.thread.read(cx).entries().iter().any(|entry| {
+            matches!(entry, AgentThreadEntry::UserMessage(message) if message.is_optimistic)
+        });
+        assert!(
+            sent_is_optimistic,
+            "precondition: a live-sent message is optimistic, yet sent"
+        );
+    });
+
+    thread_view.update_in(cx, |thread, window, cx| {
+        thread.add_to_queue(
+            vec![acp_v2::ContentBlock::Text(acp_v2::TextContent::new(
+                "queued one".to_string(),
+            ))],
+            vec![],
+            window,
+            cx,
+        );
+    });
+    cx.run_until_parked();
+
+    type_draft(&view, "draft", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "sent one",
+        "R4.4: the sent message, not the queued one"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "sent one",
+        "R4.4: nothing older -- the queue is not history"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "draft");
+
+    let queue_len = thread_view.read_with(cx, |thread, _| thread.message_queue.len());
+    assert_eq!(queue_len, 1, "browsing the history leaves the queue alone");
+}
diff --git a/crates/agent_ui/src/conversation_view/tests/recall_tests.rs b/crates/agent_ui/src/conversation_view/tests/recall_tests.rs
new file mode 100644
index 0000000..949d577
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/tests/recall_tests.rs
@@ -0,0 +1,580 @@
+//! Composer Up/Down recall (story 018, Task 3.1).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view.rs`'s `mod tests { .. }`, declare
+//! `mod recall_tests;` -- an inline module of a non-mod-rs file, so this resolves to
+//! `crates/agent_ui/src/conversation_view/tests/recall_tests.rs`.
+//!
+//! Behaviour-level: the tests drive the real keymap (`keymaps/default-linux.json`) with
+//! real keystrokes into a focused composer, and send through `ThreadView::send`. Only the
+//! action NAMES `agent::RecallOlderMessage` / `agent::RecallNewerMessage` are pinned
+//! (by the keymap test); no new Rust signature is.
+//!
+//! Every test ends with a step that needs the feature, so none of them is green before
+//! the feature exists -- including the ones whose first half checks that caret movement
+//! is NOT hijacked (R1.4, R2.3, R3.1, R3.2).
+
+use super::*;
+use editor::MultiBufferOffset;
+use gpui::{TestAppContext, VisualTestContext};
+use rope::Point;
+
+// ---------------------------------------------------------------------------
+// Harness -- shared with `recall_ends_tests.rs` and `recall_indices_tests.rs`
+// ---------------------------------------------------------------------------
+
+pub(super) fn bind_default_keymap(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let mut bindings = settings::KeymapFile::load_asset_allow_partial_failure(
+            "keymaps/default-linux.json",
+            cx,
+        )
+        .expect("the default keymap loads");
+        for binding in &mut bindings {
+            binding.set_meta(settings::KeybindSource::Default.meta());
+        }
+        cx.bind_keys(bindings);
+    });
+}
+
+pub(super) async fn composer_with_stub<'a>(
+    connection: &StubAgentConnection,
+    cx: &'a mut TestAppContext,
+) -> (Entity<ConversationView>, &'a mut VisualTestContext) {
+    init_test(cx);
+    bind_default_keymap(cx);
+    let (view, cx) = setup_conversation_view(StubAgentServer::new(connection.clone()), cx).await;
+    add_to_workspace(view.clone(), cx);
+    (view, cx)
+}
+
+/// Sends `text` through the composer and lets the agent's turn end.
+pub(super) fn send(
+    view: &Entity<ConversationView>,
+    connection: &StubAgentConnection,
+    text: &str,
+    cx: &mut VisualTestContext,
+) {
+    connection.set_next_prompt_updates(vec![acp_v1::SessionUpdate::AgentMessageChunk(
+        acp_v1::ContentChunk::new("Done.".into()),
+    )]);
+    type_draft(view, text, cx);
+    active_thread(view, cx).update_in(cx, |thread, window, cx| thread.send(window, cx));
+    cx.run_until_parked();
+    assert_eq!(
+        composer_text(view, cx),
+        "",
+        "precondition: sending empties the composer"
+    );
+}
+
+pub(super) fn type_draft(view: &Entity<ConversationView>, text: &str, cx: &mut VisualTestContext) {
+    message_editor(view, cx).update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    cx.run_until_parked();
+}
+
+pub(super) fn composer_text(view: &Entity<ConversationView>, cx: &mut VisualTestContext) -> String {
+    message_editor(view, cx).read_with(cx, |editor, cx| editor.text(cx))
+}
+
+pub(super) fn focus_composer(view: &Entity<ConversationView>, cx: &mut VisualTestContext) {
+    let editor = message_editor(view, cx);
+    cx.focus(&editor);
+    cx.run_until_parked();
+}
+
+pub(super) fn press(keys: &str, cx: &mut VisualTestContext) {
+    cx.simulate_keystrokes(keys);
+    cx.run_until_parked();
+}
+
+pub(super) fn set_caret(
+    view: &Entity<ConversationView>,
+    offset: usize,
+    cx: &mut VisualTestContext,
+) {
+    message_editor(view, cx).update_in(cx, |editor, window, cx| {
+        editor.set_cursor_offset(offset, window, cx)
+    });
+    cx.run_until_parked();
+}
+
+pub(super) fn select_all(view: &Entity<ConversationView>, cx: &mut VisualTestContext) {
+    message_editor(view, cx).update_in(cx, |message_editor, window, cx| {
+        message_editor.editor().update(cx, |editor, cx| {
+            let len = editor.text(cx).len();
+            editor.change_selections(Default::default(), window, cx, |selections| {
+                selections.select_ranges([MultiBufferOffset(0)..MultiBufferOffset(len)]);
+            });
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// (caret head, whether text is selected)
+pub(super) fn caret(view: &Entity<ConversationView>, cx: &mut VisualTestContext) -> (Point, bool) {
+    message_editor(view, cx).update_in(cx, |message_editor, _window, cx| {
+        message_editor.editor().update(cx, |editor, cx| {
+            let snapshot = editor.display_snapshot(cx);
+            let selection = editor.selections.newest::<Point>(&snapshot);
+            (selection.head(), !selection.is_empty())
+        })
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Bindings
+// ---------------------------------------------------------------------------
+
+/// Constraint: both keymaps change; the recall actions are bound to plain Up/Down in the
+/// composer's context.
+#[gpui::test]
+fn recall_keys_are_bound_in_the_composer_in_both_keymaps(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.update(|cx| {
+        for keymap in ["keymaps/default-linux.json", "keymaps/default-macos.json"] {
+            let bindings = settings::KeymapFile::load_asset_allow_partial_failure(keymap, cx)
+                .expect("keymap loads");
+            for (key, action) in [
+                ("up", "agent::RecallOlderMessage"),
+                ("down", "agent::RecallNewerMessage"),
+            ] {
+                let bound = bindings.iter().any(|binding| {
+                    binding.action().name() == action
+                        && binding.keystrokes().len() == 1
+                        && binding.keystrokes()[0].unparse() == key
+                        && format!("{:?}", binding.predicate()).contains("AcpThread")
+                });
+                assert!(
+                    bound,
+                    "{keymap}: `{key}` must be bound to {action} in the composer (AcpThread > Editor)"
+                );
+            }
+        }
+    });
+}
+
+// ---------------------------------------------------------------------------
+// R1.1, R1.2, R1.3, R2.1, R2.2, R3.3
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_up_walks_back_and_down_restores_the_draft(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "first", cx);
+    send(&view, &connection, "second", cx);
+    send(&view, &connection, "third", cx);
+
+    type_draft(&view, "half-typed", cx);
+    focus_composer(&view, cx);
+
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "third",
+        "R1.1: the most recent sent message"
+    );
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "second",
+        "R1.2: the next older one"
+    );
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "first");
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "first",
+        "R1.3: stays on the oldest"
+    );
+
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "second",
+        "R2.1: the next newer one"
+    );
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "third");
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "half-typed",
+        "R2.2 / R3.3: the draft from when browsing started"
+    );
+}
+
+/// R2.2: "including an empty draft".
+#[gpui::test]
+async fn recall_down_restores_an_empty_draft(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "only message", cx);
+    focus_composer(&view, cx);
+
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "only message");
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "");
+    // Browsing ended with the restore: Down is caret movement again, nothing comes back.
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "");
+}
+
+// ---------------------------------------------------------------------------
+// R1.4 -- no history, Up is caret movement
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_up_without_sent_messages_moves_the_caret(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+
+    type_draft(&view, "abc def", cx);
+    focus_composer(&view, cx);
+    set_caret(&view, 4, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "abc def",
+        "R1.4: nothing to recall"
+    );
+    assert_eq!(
+        caret(&view, cx),
+        (Point::new(0, 0), false),
+        "R1.4: Up on the first line moves the caret as it does today"
+    );
+
+    // Once a message is sent, the same key on the same line recalls it.
+    send(&view, &connection, "hello", cx);
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "hello");
+}
+
+// ---------------------------------------------------------------------------
+// R3.1 / R3.3 -- Up below the first line is caret movement; the multi-line draft survives
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_up_on_a_later_line_moves_the_caret_first(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "sent before", cx);
+
+    let draft = "line one\nline two";
+    type_draft(&view, draft, cx);
+    focus_composer(&view, cx);
+    set_caret(&view, draft.len(), cx);
+
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        draft,
+        "R3.1: no recall from line 2"
+    );
+    assert_eq!(caret(&view, cx).0.row, 0, "R3.1: the caret moved up a line");
+
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "sent before",
+        "first line: recall"
+    );
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        draft,
+        "R3.3: the multi-line draft comes back"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// R2.3 -- Down while not browsing is caret movement
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_down_when_not_browsing_moves_the_caret(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "sent before", cx);
+
+    let draft = "top\nbottom";
+    type_draft(&view, draft, cx);
+    focus_composer(&view, cx);
+    set_caret(&view, 1, cx);
+
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), draft);
+    assert_eq!(caret(&view, cx).0.row, 1, "R2.3: Down moved the caret");
+    // On the last line and not browsing: still nothing but caret movement.
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        draft,
+        "R2.3: Down on the last line recalls nothing"
+    );
+
+    set_caret(&view, 0, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "sent before");
+}
