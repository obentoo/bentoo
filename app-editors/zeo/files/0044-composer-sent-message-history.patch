+/// A recalled message is shown, not written: the thread's persisted draft stays
+/// the one browsing started from, so switching away mid-browse loses nothing.
+#[gpui::test]
+async fn recall_does_not_persist_a_recalled_message_as_the_draft(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "sent before", cx);
+
+    type_draft(&view, "my draft", cx);
+    let thread_view = active_thread(&view, cx);
+    let persisted = |cx: &mut VisualTestContext| {
+        thread_view.read_with(cx, |view, cx| {
+            view.thread
+                .read(cx)
+                .draft_prompt()
+                .map(|blocks| blocks.to_vec())
+        })
+    };
+    let before = persisted(cx);
+    assert!(
+        before.is_some(),
+        "precondition: the typed draft was persisted"
+    );
+
+    focus_composer(&view, cx);
+    press("up", cx);
+    assert_eq!(composer_text(&view, cx), "sent before");
+    assert_eq!(
+        persisted(cx),
+        before,
+        "the recalled message is not the draft"
+    );
+
+    press("down", cx);
+    assert_eq!(composer_text(&view, cx), "my draft");
+}
