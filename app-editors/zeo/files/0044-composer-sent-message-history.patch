+// ---------------------------------------------------------------------------
+// R3.2 -- a selection is never hijacked
+// ---------------------------------------------------------------------------
+
+#[gpui::test]
+async fn recall_keys_leave_a_selection_alone(cx: &mut TestAppContext) {
+    let connection = StubAgentConnection::new();
+    let (view, cx) = composer_with_stub(&connection, cx).await;
+    send(&view, &connection, "sent before", cx);
+
+    type_draft(&view, "draft text", cx);
+    focus_composer(&view, cx);
+
+    select_all(&view, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "draft text",
+        "R3.2: Up with a selection"
+    );
+
+    set_caret(&view, 5, cx);
+    press("shift-up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "draft text",
+        "R3.2: Shift-Up extends"
+    );
+    assert!(caret(&view, cx).1, "R3.2: Shift-Up made a selection");
+
+    set_caret(&view, 0, cx);
+    press("up", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "sent before",
+        "no selection: recall"
+    );
+
+    // Browsing; selecting is not editing, and Down with a selection is not a step.
+    select_all(&view, cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "sent before",
+        "R3.2: Down with a selection does not walk"
+    );
+    set_caret(&view, "sent before".len(), cx);
+    press("down", cx);
+    assert_eq!(
+        composer_text(&view, cx),
+        "draft text",
+        "the saved draft survives"
+    );
+}
