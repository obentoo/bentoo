diff --git a/crates/agent_ui/src/conversation_view/sent_history.rs b/crates/agent_ui/src/conversation_view/sent_history.rs
new file mode 100644
index 0000000..b8350f1
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/sent_history.rs
@@ -0,0 +1,123 @@
+//! Shell-style history of the messages the operator sent in one thread.
+//!
+//! The composer walks it with Up and Down: Up recalls the operator's earlier
+//! messages, newest first, and Down walks back towards the draft that was in the
+//! composer when browsing started. The model only answers *which* entry to show;
+//! rebuilding it in the composer is the caller's job.
+
+use acp_thread::AgentThreadEntry;
+use agent_client_protocol::schema::v2 as acp_v2;
+
+/// What the composer shows after one step through the history.
+#[derive(Debug, PartialEq)]
+pub enum Recall {
+    /// The operator message at this index of `AcpThread::entries()`.
+    Entry(usize),
+    /// The draft that was in the composer when browsing started.
+    Draft(Vec<acp_v2::ContentBlock>),
+}
+
+#[derive(Default)]
+pub struct SentMessageHistory {
+    browsing: Option<Browse>,
+    skipped: Vec<usize>,
+}
+
+struct Browse {
+    /// Indices of the operator's messages, newest first.
+    entries: Vec<usize>,
+    /// Position in `entries` of the message shown now.
+    position: usize,
+    draft: Vec<acp_v2::ContentBlock>,
+}
+
+impl SentMessageHistory {
+    /// Starts browsing from the newest operator message in `entries`, keeping
+    /// `draft` for the walk back. Returns `None`, and does not start, when the
+    /// thread has no operator message to recall.
+    ///
+    /// The list is read from `entries` on every call and never cached across
+    /// sends, so a message sent since the last browse is the first one offered.
+    pub fn start(
+        &mut self,
+        entries: &[AgentThreadEntry],
+        draft: Vec<acp_v2::ContentBlock>,
+    ) -> Option<Recall> {
+        self.browsing = None;
+        self.skipped.clear();
+
+        let mut sent = Vec::new();
+        for (ix, entry) in entries.iter().enumerate().rev() {
+            // `indented` marks a subagent's prompt rendered inside this thread:
+            // a `UserMessage`, but not one the operator wrote. Queued messages are
+            // not thread entries at all, and a live-sent message stays optimistic
+            // for good when the agent does not echo it, so `is_optimistic` says
+            // nothing about whether a message was sent.
+            let Some(message) = entry.user_message() else {
+                continue;
+            };
+            if message.indented {
+                continue;
+            }
+            if message.content.source_blocks().is_empty() {
+                self.skipped.push(ix);
+                continue;
+            }
+            sent.push(ix);
+        }
+
+        let newest = *sent.first()?;
+        self.browsing = Some(Browse {
+            entries: sent,
+            position: 0,
+            draft,
+        });
+        Some(Recall::Entry(newest))
+    }
+
+    /// The next older message, staying on the oldest once it is reached.
+    /// `None` when not browsing.
+    pub fn older(&mut self) -> Option<Recall> {
+        let browse = self.browsing.as_mut()?;
+        browse.position = (browse.position + 1).min(browse.entries.len() - 1);
+        Some(Recall::Entry(browse.entries[browse.position]))
+    }
+
+    /// The next newer message, or — past the newest — the saved draft, which
+    /// also ends browsing. `None` when not browsing.
+    pub fn newer(&mut self) -> Option<Recall> {
+        let browse = self.browsing.as_mut()?;
+        if browse.position == 0 {
+            let browse = self.browsing.take()?;
+            return Some(Recall::Draft(browse.draft));
+        }
+        browse.position -= 1;
+        Some(Recall::Entry(browse.entries[browse.position]))
+    }
+
+    /// Ends browsing and hands back the saved draft, for when the composer
+    /// still shows a recalled message that the operator never chose to keep.
+    /// `None` when not browsing.
+    pub fn abandon(&mut self) -> Option<Vec<acp_v2::ContentBlock>> {
+        self.browsing.take().map(|browse| browse.draft)
+    }
+
+    /// Forgets the position and the saved draft: the next `start` begins again
+    /// from the newest message.
+    pub fn end(&mut self) {
+        self.browsing = None;
+    }
+
+    pub fn is_browsing(&self) -> bool {
+        self.browsing.is_some()
+    }
+
+    /// Operator messages the last `start` passed over because they carry no
+    /// content to rebuild in the composer.
+    pub fn skipped_entries(&self) -> &[usize] {
+        &self.skipped
+    }
+}
+
+#[cfg(test)]
+mod tests;
