     thread.update(cx, |thread, cx| thread.cancel(cx)).await;
     let events = events.collect::<Vec<_>>().await;
-    let last_event = events.last();
+    // Zeo: a tool that honours cancellation reports its own failed update, and it can
+    // land after the Stop -- so the stream must close and carry the Stop, wherever.
