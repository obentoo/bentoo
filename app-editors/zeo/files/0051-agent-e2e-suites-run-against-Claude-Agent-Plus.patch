diff --git a/crates/agent_servers/src/zeo_plus_e2e_tests.rs b/crates/agent_servers/src/zeo_plus_e2e_tests.rs
new file mode 100644
index 0000000..bdd674d
--- /dev/null
+++ b/crates/agent_servers/src/zeo_plus_e2e_tests.rs
@@ -0,0 +1,69 @@
+//! Zeo: upstream's shared e2e suite, run against the Claude Agent (Plus) adapter.
+//!
+//! Upstream runs `common_e2e_tests!` only against Zed's native agent, which is not
+//! the agent Zeo ships. This runs the same six scenarios -- a prompt and a reply, a
+//! path mention, a tool call, a tool call behind a permission prompt, cancel, and
+//! dropping the thread -- through the external ACP adapter, the path every Zeo
+//! thread with Claude Agent (Plus) takes.
+//!
+//! Ignored unless built with `--features e2e`. They spawn the real adapter, which
+//! talks to the real model: `ZEO_E2E_PLUS_COMMAND` names the binary (default: the
+//! Portage-installed `/usr/bin/claude-agent-acp-plus`).
+//!
+//! The adapter runs with an empty `CLAUDE_CONFIG_DIR` of its own. Without it, the
+//! operator's own Claude Code settings decide the outcome: a `"Bash"` allow rule
+//! means the permission prompt two scenarios wait for never comes. Isolated, it
+//! also has no login, so it authenticates with `ANTHROPIC_API_KEY`, which must be
+//! set in the environment -- and the runs bill that key, not a subscription.
+
+use crate::CustomAgentServer;
+use collections::HashMap;
+use project::agent_server_store::{
+    AgentId, AgentServerCommand, AllAgentServersSettings, CustomAgentServerSettings,
+};
+use settings::Settings as _;
+use std::path::PathBuf;
+
+const AGENT_ID: &str = "claude-agent-acp-plus-e2e";
+
+/// An empty Claude Code config directory, one per test process.
+fn isolated_claude_config_dir() -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("zeo-plus-e2e-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("creating the isolated Claude config dir");
+    dir
+}
+
+fn plus_command() -> PathBuf {
+    std::env::var_os("ZEO_E2E_PLUS_COMMAND")
+        .filter(|command| !command.is_empty())
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("/usr/bin/claude-agent-acp-plus"))
+}
+
+crate::common_e2e_tests!(
+    async |_fs, cx| {
+        cx.update(|cx| {
+            AllAgentServersSettings::override_global(
+                AllAgentServersSettings(HashMap::from_iter([(
+                    AGENT_ID.to_string(),
+                    CustomAgentServerSettings::Custom {
+                        command: AgentServerCommand {
+                            path: plus_command(),
+                            args: Vec::new(),
+                            env: Some(HashMap::from_iter([(
+                                "CLAUDE_CONFIG_DIR".to_string(),
+                                isolated_claude_config_dir().to_string_lossy().into_owned(),
+                            )])),
+                        },
+                        default_mode: None,
+                        default_config_options: HashMap::default(),
+                        favorite_config_option_values: HashMap::default(),
+                    },
+                )])),
+                cx,
+            );
+        });
+        CustomAgentServer::new(AgentId::new(AGENT_ID))
+    },
+    allow_option_id = "allow-once"
+);
