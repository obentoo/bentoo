From a30787b42b883c75c4dea3fe349cbbe7307c3830 Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Fri, 27 Nov 2026 08:36:11 -0300
Subject: [PATCH] agent_ui: the kill switch from the palette
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo next §6.53. The lock's Stop (0141) ended a jail; the proposal asks
for one "Stop agent" action in the agent panel and the palette that
kills the jail's process tree and cuts its egress.

- `agent::StopJailedAgent` reaches the active thread's jail from the
  palette, wherever focus is, asking first exactly as the lock's Stop
  does. Without a running jail it does nothing and logs that.
- `agent_sandbox::control::kill_switch` is what both call: it thaws a
  paused jail (a frozen process acts on the signal only once it runs),
  then sends ai-jail its SIGTERM. ai-jail's egress proxy lives in that
  process, so ending it ends every connection the jail had open -- the
  egress cut needs no second step.
- Each press is logged as `event=kill_switch_pressed` with its source
  (`button`, `palette`) and whether the jail was paused; the signal's
  outcome keeps its own `event=kill_switch` line.

Not yet: killing §6.9's restricted ssh-agent, which does not exist
yet; it joins kill_switch when it does.

Test: control.rs -- the kill switch terminates a running process and
refuses pid 1.
---

diff --git a/crates/agent_sandbox/src/control.rs b/crates/agent_sandbox/src/control.rs
index 5b50b11..7fb97bc 100644
--- a/crates/agent_sandbox/src/control.rs
+++ b/crates/agent_sandbox/src/control.rs
@@ -27,6 +27,22 @@ pub fn stop_jail(pid: u32) -> io::Result<()> {
     }
 }
 
+/// The kill switch (Zeo next §6.53): thaws a paused jail first -- a frozen process only acts on
+/// the signal once it runs again -- then stops it. Killing ai-jail also ends its egress proxy,
+/// which lives in that process, so every connection the jail had open ends with it. `source`
+/// says where the operator pressed it (`button`, `palette`), for the log line.
+pub fn kill_switch(pid: u32, paused: bool, source: &'static str) -> io::Result<()> {
+    if paused {
+        if let Err(error) = jail_scope_dir(pid).and_then(|scope| set_frozen(&scope, false)) {
+            log::warn!(
+                "agent_sandbox event=kill_switch_thaw pid={pid} source={source} outcome=failed error={error}"
+            );
+        }
+    }
+    log::info!("agent_sandbox event=kill_switch_pressed pid={pid} source={source} paused={paused}");
+    stop_jail(pid)
+}
+
 #[cfg(not(unix))]
 pub fn stop_jail(_pid: u32) -> io::Result<()> {
     Err(io::Error::new(
@@ -91,6 +107,23 @@ pub fn set_frozen(scope_dir: &std::path::Path, frozen: bool) -> io::Result<()> {
 mod tests {
     use super::*;
 
+    #[test]
+    #[allow(
+        clippy::disallowed_methods,
+        reason = "the signal must reach a real child, outside any executor"
+    )]
+    fn the_kill_switch_terminates_a_running_jail() {
+        use std::os::unix::process::ExitStatusExt as _;
+        let mut child = std::process::Command::new("sleep")
+            .arg("30")
+            .spawn()
+            .expect("sleep");
+        kill_switch(child.id(), false, "test").expect("signalled");
+        let status = child.wait().expect("wait");
+        assert_eq!(status.signal(), Some(libc::SIGTERM), "{status:?}");
+        assert!(kill_switch(1, false, "test").is_err(), "pid 1 is init");
+    }
+
     #[test]
     #[allow(
         clippy::disallowed_methods,
diff --git a/crates/agent_ui/src/agent_panel.rs b/crates/agent_ui/src/agent_panel.rs
index 95d1ed5..e640af6 100644
--- a/crates/agent_ui/src/agent_panel.rs
+++ b/crates/agent_ui/src/agent_panel.rs
@@ -603,6 +603,22 @@ pub fn init(cx: &mut App) {
                 .register_action(|_workspace, _: &ResetTrialEndUpsell, _window, cx| {
                     TrialEndUpsell::set_dismissed(false, cx);
                 })
+                // Zeo next §6.53: the kill switch, reachable from the palette wherever focus is.
+                .register_action(|workspace, _: &crate::StopJailedAgent, window, cx| {
+                    let thread_view = workspace
+                        .panel::<AgentPanel>(cx)
+                        .and_then(|panel| panel.read(cx).active_thread_view(cx));
+                    let stopped = thread_view.is_some_and(|thread_view| {
+                        thread_view.update(cx, |thread_view, cx| {
+                            thread_view.stop_jailed_agent(window, cx)
+                        })
+                    });
+                    if !stopped {
+                        log::info!(
+                            "agent_sandbox event=kill_switch_pressed source=palette outcome=no_running_jail"
+                        );
+                    }
+                })
                 .register_action(|_workspace, _: &ResetFastModeWarnings, _window, cx| {
                     reset_fast_mode_warnings(cx);
                 })
