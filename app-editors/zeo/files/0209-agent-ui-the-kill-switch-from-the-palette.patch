@@ -7543,6 +7538,42 @@ impl ThreadView {
 
     /// Restarts the agent so a changed sandbox setting applies (§6.50). The thread is resumed
     /// on the new process; a turn in progress would be cut, so that case asks first.
+    /// The kill switch from the palette (`agent::StopJailedAgent`, Zeo next §6.53): asks first, as
+    /// the lock's Stop does, then ends everything in this thread's jail, its network with it.
+    /// Returns whether the thread has a running jail to stop.
+    pub(crate) fn stop_jailed_agent(&self, window: &mut Window, cx: &mut App) -> bool {
+        let Some(project) = self.project.upgrade() else {
+            return false;
+        };
+        let Some(root) = agent_sandbox::launch::project_root(&project, cx) else {
+            return false;
+        };
+        let Some(record) = agent_sandbox::LaunchRegistry::get(&self.agent_id, &root, cx) else {
+            return false;
+        };
+        let Some(pid) = record.jail_pid else {
+            return false;
+        };
+        let paused = record.paused;
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            "Stop the agent?",
+            Some(
+                "Everything running in the jail ends now. Pause keeps it instead, with \
+                 nothing lost.",
+            ),
+            &["Stop", "Cancel"],
+            cx,
+        );
+        cx.spawn(async move |_| {
+            if answer.await == Ok(0) {
+                agent_sandbox::control::kill_switch(pid, paused, "palette").log_err();
+            }
+        })
+        .detach();
+        true
+    }
+
