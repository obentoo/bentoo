+/// The group header labels, in list order.
+fn header_labels(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::ProjectHeader { label, .. } => Some(label.to_string()),
+                _ => None,
+            })
+            .collect()
+    })
+}
+
+/// The label of `thread_id`'s pinned row, if it has one.
+fn pinned_label(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) -> Option<String> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .find_map(|entry| match entry {
+                ListEntry::Thread(thread) if thread.metadata.thread_id == thread_id => thread
+                    .pinned_project_label
+                    .as_ref()
+                    .map(|label| label.to_string()),
+                _ => None,
+            })
+    })
+}
