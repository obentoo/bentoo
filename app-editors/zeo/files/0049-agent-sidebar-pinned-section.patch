+    let panel_gamma = add_panel(&workspace_gamma, cx);
+    let session = live_thread_in(&panel_gamma, cx);
+    let thread = save_with_agent(&session, "Ship release", GAMMA, ZED_AGENT_ID.clone(), cx);
+    store_pin(thread, cx);
