+// ═══ Tech review fixes (3.1) ═══════════════════════════════════════════════
+
+fn local_key(path: &str) -> ProjectGroupKey {
+    ProjectGroupKey::new(None, PathList::new(&[PathBuf::from(path)]))
+}
+
+fn group_header_has_notifications(
+    sidebar: &Entity<Sidebar>,
+    key: &ProjectGroupKey,
+    cx: &mut VisualTestContext,
+) -> Option<bool> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .find_map(|entry| match entry {
+                ListEntry::ProjectHeader {
+                    key: header_key,
+                    has_notifications,
+                    ..
+                } if header_key == key => Some(*has_notifications),
+                _ => None,
+            })
+    })
+}
+
+// R4.4 — the thread switcher activates its selection in THIS window, so a pinned row whose project
+// is open only in another window is left out of it (offering it would adopt that window's
+// workspace here); a pinned row of this window is still offered.
+#[gpui::test]
+async fn switcher_leaves_out_a_pinned_row_open_in_another_window(cx: &mut TestAppContext) {
+    let (_fs, project_a) = init_pinned_test(cx).await;
+    let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+    let project_b = project::Project::test(fs, [BETA.as_ref()], cx).await;
+    let window_a = cx.add_window(|window, cx| MultiWorkspace::test_new(project_a, window, cx));
+    let window_b = cx.add_window(|window, cx| MultiWorkspace::test_new(project_b, window, cx));
+    let mw_a = window_a.root(cx).unwrap();
+    let mw_b = window_b.root(cx).unwrap();
+    let cx_b = &mut VisualTestContext::from_window(window_b.into(), cx);
+    let _sidebar_b = setup_sidebar(&mw_b, cx_b);
+    let cx_a = &mut VisualTestContext::from_window(window_a.into(), cx);
+    let sidebar_a = setup_sidebar(&mw_a, cx_a);
+    let in_alpha = save_in("a1", "Fix login", ALPHA, 2, cx_a);
+    let in_beta = save_in("b1", "Ship release", BETA, 1, cx_a);
+    store_pin(in_alpha, cx_a);
+    store_pin(in_beta, cx_a);
+    assert_eq!(
+        pinned_entries(&sidebar_a, cx_a),
+        vec![
+            "v [alpha]",
+            "v Pinned",
+            "  Ship release · beta",
+            "  Fix login · alpha"
+        ],
+        "fixture: both pinned rows are listed in this window"
+    );
+
+    let offered: Vec<ThreadId> = sidebar_a.read_with(cx_a, |sidebar, cx| {
+        sidebar
+            .mru_entries_for_switcher(cx)
+            .into_iter()
+            .filter_map(|entry| match entry {
+                ThreadSwitcherEntry::Thread(thread) => Some(thread.metadata.thread_id),
+                ThreadSwitcherEntry::Terminal(_) => None,
+            })
+            .collect()
+    });
+
+    assert_eq!(offered, vec![in_alpha]);
+}
