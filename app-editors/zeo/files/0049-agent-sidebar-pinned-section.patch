@@ -0,0 +1,200 @@
+//! The Pinned section: pinned threads are listed once, after the last project group, in the
+//! organization store's order. Rows come from the store rather than from this window's groups,
+//! which is what lets a thread of a project open nowhere be listed and opened from here.
+
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use action_log::DiffStats;
+use agent_ui::ThreadId;
+use agent_ui::thread_metadata_store::{
+    ThreadMetadata, ThreadMetadataStore, worktree_info_from_thread_paths,
+};
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use agent_ui::threads_archive_view::fuzzy_match_positions;
+use gpui::{App, Entity, SharedString};
+use project::AgentId;
+use ui::{AgentThreadStatus, IconName};
+use workspace::{ProjectGroupKey, Workspace};
+
+use crate::{
+    LiveRowContext, Sidebar, ThreadEntry, ThreadEntryWorkspace, acp,
+    all_thread_infos_for_workspace, apply_live_row_state,
+};
+
+/// The pinned thread ids, newest pin first. Empty when the store is not installed, which leaves
+/// the sidebar exactly as it was before pinning existed.
+pub(crate) fn pinned_thread_ids(cx: &App) -> Vec<ThreadId> {
+    ThreadOrganizationStore::try_global(cx)
+        .map(|store| store.read(cx).pinned().collect())
+        .unwrap_or_default()
+}
+
+/// What the group loop of a rebuild already computed, reused for the pinned rows.
+pub(crate) struct PinnedBuildContext<'a> {
+    /// This window's workspaces: the only ones whose live state a pinned row shows.
+    pub workspaces: &'a [Entity<Workspace>],
+    pub active_workspace: Option<&'a Entity<Workspace>>,
+    /// The group headers' disambiguation, whose paths the pinned labels are disambiguated against.
+    pub path_detail_map: &'a HashMap<PathBuf, usize>,
+    pub branch_by_path: &'a HashMap<PathBuf, SharedString>,
+    pub resolve_agent_icon: &'a dyn Fn(&AgentId) -> (IconName, Option<SharedString>),
+    pub new_live_statuses: &'a mut HashMap<acp::SessionId, (AgentThreadStatus, ThreadId)>,
+    pub notified_threads: &'a mut HashSet<ThreadId>,
+}
+
+/// One row per pinned id, in the given order, skipping ids with no metadata, archived threads and
+/// drafts.
+pub(crate) fn build_pinned_rows(
+    sidebar: &Sidebar,
+    pinned: &[ThreadId],
+    context: PinnedBuildContext<'_>,
+    cx: &App,
+) -> Vec<Arc<ThreadEntry>> {
+    if pinned.is_empty() {
+        return Vec::new();
+    }
+
+    let store = ThreadMetadataStore::global(cx).read(cx);
+    let pinned_threads: Vec<(&ThreadMetadata, ProjectGroupKey)> = pinned
+        .iter()
+        .filter_map(|thread_id| store.entry(*thread_id))
+        .filter(|metadata| !metadata.archived && !metadata.is_draft())
+        .map(|metadata| {
+            // Derived from the thread alone, so the label does not change with where its project
+            // happens to be open.
+            let key = ProjectGroupKey::from_worktree_paths(
+                &metadata.worktree_paths,
+                metadata.remote_connection.clone(),
+            );
+            (metadata, key)
+        })
+        .collect();
+    if pinned_threads.is_empty() {
+        return Vec::new();
+    }
+
+    let pinned_detail_map = pinned_detail_map(
+        context.path_detail_map,
+        pinned_threads.iter().map(|(_, key)| key),
+    );
+
+    let live_info_by_session = context
+        .workspaces
+        .iter()
+        .flat_map(|workspace| all_thread_infos_for_workspace(workspace, cx))
+        .map(|info| (info.session_id.clone(), info))
+        .collect();
+    let live_context = LiveRowContext {
+        live_info_by_session: &live_info_by_session,
+        old_statuses: &sidebar.live_thread_statuses,
+        active_entry: sidebar.active_entry.as_ref(),
+        active_workspace: context.active_workspace,
+    };
+
+    pinned_threads
+        .into_iter()
+        .map(|(metadata, key)| {
+            let label = key.display_name(&pinned_detail_map);
+            let workspace = resolve_workspace(sidebar, metadata, key, cx);
+            let (icon, icon_from_external_svg) = (context.resolve_agent_icon)(&metadata.agent_id);
+            let worktrees =
+                worktree_info_from_thread_paths(&metadata.worktree_paths, context.branch_by_path);
+            let mut row = Arc::new(ThreadEntry {
+                metadata: metadata.clone(),
+                icon,
+                icon_from_external_svg,
+                status: AgentThreadStatus::default(),
+                workspace,
+                is_live: false,
+                is_background: false,
+                is_title_generating: false,
+                draft: None,
+                highlight_positions: Vec::new(),
+                worktrees,
+                diff_stats: DiffStats::default(),
+                pinned_project_label: Some(label),
+            });
+            apply_live_row_state(
+                &mut row,
+                &live_context,
+                context.new_live_statuses,
+                context.notified_threads,
+            );
+            row
+        })
+        .collect()
+}
+
+/// With filter text, the rows whose title or project label matches it. A title match records its
+/// highlight positions, as a group row's does; a match on the label alone keeps the row with no
+/// title highlights. With no text every row is kept unchanged.
+pub(crate) fn filter_pinned_rows(
+    rows: Vec<Arc<ThreadEntry>>,
+    query: &str,
+) -> Vec<Arc<ThreadEntry>> {
+    if query.is_empty() {
+        return rows;
+    }
+    rows.into_iter()
+        .filter_map(|mut row| {
+            if let Some(positions) =
+                fuzzy_match_positions(query, row.metadata.display_title().as_ref())
+            {
+                Arc::make_mut(&mut row).highlight_positions = positions;
+                return Some(row);
+            }
+            let label_matched = row
+                .pinned_project_label
+                .as_ref()
+                .is_some_and(|label| fuzzy_match_positions(query, label).is_some());
+            label_matched.then_some(row)
+        })
+        .collect()
+}
+
+/// The group headers' paths plus every pinned project's, so two pinned projects sharing a folder
+/// name get distinct labels. Group headers keep their own map: a pin never relabels a header.
+fn pinned_detail_map<'a>(
+    path_detail_map: &HashMap<PathBuf, usize>,
+    pinned_keys: impl Iterator<Item = &'a ProjectGroupKey>,
+) -> HashMap<PathBuf, usize> {
+    let mut all_paths: Vec<PathBuf> = path_detail_map
+        .keys()
+        .cloned()
+        .chain(pinned_keys.flat_map(|key| key.path_list().paths().iter().cloned()))
+        .collect();
+    all_paths.sort_unstable();
+    all_paths.dedup();
+    let details = util::disambiguate::compute_disambiguation_details(&all_paths, |path, detail| {
+        project::path_suffix(path, detail)
+    });
+    all_paths.into_iter().zip(details).collect()
+}
+
+/// The History view's order: a workspace of this window, else one open in another window, else a
+/// closed row that opens the project here.
+fn resolve_workspace(
+    sidebar: &Sidebar,
+    metadata: &ThreadMetadata,
+    key: ProjectGroupKey,
+    cx: &App,
+) -> ThreadEntryWorkspace {
+    let folder_paths = metadata.folder_paths();
+    let remote_connection = metadata.remote_connection.as_ref();
+    if let Some(workspace) =
+        sidebar.find_current_workspace_for_path_list(folder_paths, remote_connection, cx)
+    {
+        return ThreadEntryWorkspace::Open(workspace);
+    }
+    if let Some((_, workspace)) =
+        sidebar.find_open_workspace_for_path_list(folder_paths, remote_connection, cx)
+    {
+        return ThreadEntryWorkspace::Open(workspace);
+    }
+    ThreadEntryWorkspace::Closed {
+        folder_paths: folder_paths.clone(),
+        project_group_key: key,
+    }
+}
