+// R2.4 — a collapsed group's header reports only the notifications of the rows it would show: a
+// pinned thread's notification is reported by the Pinned header, not by its project's header.
+#[gpui::test]
+async fn collapsed_groups_header_does_not_report_a_pinned_threads_notification(
+    cx: &mut TestAppContext,
+) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    save_in("a1", "Fix login", ALPHA, 2, cx);
+    let pinned = save_in("a2", "Write docs", ALPHA, 1, cx);
+    store_pin(pinned, cx);
+    let alpha_key = local_key(ALPHA);
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.toggle_collapse(&alpha_key, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec!["> [alpha]", "v Pinned", "  Write docs · alpha"],
+        "fixture: the pinned thread's group is collapsed"
+    );
+
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.contents.notified_threads.insert(pinned);
+        sidebar.update_entries(cx);
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        group_header_has_notifications(&sidebar, &alpha_key, cx),
+        Some(false),
+        "the collapsed group's header"
+    );
+    assert_eq!(
+        pinned_header_has_notifications(&sidebar, cx),
+        Some(true),
+        "the Pinned header"
+    );
+}
