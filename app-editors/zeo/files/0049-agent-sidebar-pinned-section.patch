+// design.md "Back-walks…" — NextProject from the last project group wraps to the first group and
+// PreviousProject from the first wraps to the last: the cycle never stops on, nor selects, the
+// Pinned header.
+#[gpui::test]
+async fn project_cycling_skips_the_pinned_header(cx: &mut TestAppContext) {
+    let (fs, multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let alpha = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let beta = open_in_window(BETA, &fs, &multi_workspace, cx).await;
+    save_in("b1", "Read mail", BETA, 3, cx);
+    save_in("a1", "Fix login", ALPHA, 2, cx);
+    let pinned = save_in("a2", "Write docs", ALPHA, 1, cx);
+    store_pin(pinned, cx);
+    assert_eq!(
+        header_labels(&sidebar, cx),
+        vec!["beta", "alpha"],
+        "fixture: beta is the first group, alpha the last"
+    );
+    let header = pinned_header_ix(&sidebar, cx).expect("fixture: a Pinned section");
+
+    multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.activate(alpha.clone(), None, window, cx)
+    });
+    cx.run_until_parked();
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.on_next_project(&NextProject, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        multi_workspace.read_with(cx, |mw, _| mw.workspace().clone()),
+        beta,
+        "NextProject from the last group wraps to the first"
