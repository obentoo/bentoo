+    );
+
+    archive(second, cx);
+    archive(third, cx);
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec!["v [alpha]"],
+        "with every pinned thread archived, no Pinned header"
+    );
+}
