+// ═══ Task 4.3 — TogglePinSelectedThread ════════════════════════════════════
+
+// R1.6 hostile half first — on a project header or the Pinned header the action changes nothing;
+// R1.5 — on a thread row it pins, and on a pinned row it unpins.
+#[gpui::test]
+async fn toggle_pin_action_acts_only_on_a_selected_thread_row(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let fix_login = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let write_docs = save_in("a2", "Write docs", ALPHA, 1, cx);
+    store_pin(write_docs, cx);
+    let before = pinned_entries(&sidebar, cx);
+
+    select(&sidebar, 0, cx);
+    cx.dispatch_action(TogglePinSelectedThread);
+    cx.run_until_parked();
+    assert_eq!(
+        stored_pins(cx),
+        vec![write_docs],
+        "a project header: nothing changes"
+    );
+
+    let header = pinned_header_ix(&sidebar, cx).expect("a Pinned header");
+    select(&sidebar, header, cx);
+    cx.dispatch_action(TogglePinSelectedThread);
+    cx.run_until_parked();
+    assert_eq!(
+        stored_pins(cx),
+        vec![write_docs],
+        "the Pinned header: nothing changes"
+    );
+    assert_eq!(
+        pinned_entries(&sidebar, cx)
+            .into_iter()
+            .map(|line| line.trim_end_matches("  <== selected").to_string())
+            .collect::<Vec<_>>(),
+        before
+    );
+
+    let ix = group_row_ix(&sidebar, fix_login, cx);
+    select(&sidebar, ix, cx);
+    cx.dispatch_action(TogglePinSelectedThread);
+    cx.run_until_parked();
+    assert_eq!(
+        stored_pins(cx),
+        vec![fix_login, write_docs],
+        "a thread row is pinned"
+    );
+
+    let ix = pinned_row_ix(&sidebar, write_docs, cx);
+    select(&sidebar, ix, cx);
+    cx.dispatch_action(TogglePinSelectedThread);
+    cx.run_until_parked();
+    assert_eq!(stored_pins(cx), vec![fix_login], "a pinned row is unpinned");
+}
