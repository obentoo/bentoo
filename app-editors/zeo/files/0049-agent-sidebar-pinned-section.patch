+}
+
+fn confirm_at(sidebar: &Entity<Sidebar>, ix: usize, cx: &mut VisualTestContext) {
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.selection = Some(ix);
+        sidebar.confirm(&Confirm, window, cx);
+    });
+    cx.run_until_parked();
+}
+
+fn toggle_pin(sidebar: &Entity<Sidebar>, thread_id: ThreadId, cx: &mut VisualTestContext) {
+    sidebar.update(cx, |sidebar, cx| sidebar.toggle_pin(thread_id, cx));
+    cx.run_until_parked();
+}
+
+/// The bounds of entry `ix`, after a frame of the window (the sidebar is open in it).
+fn entry_bounds(
+    sidebar: &Entity<Sidebar>,
+    ix: usize,
+    cx: &mut VisualTestContext,
+) -> Bounds<Pixels> {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .list_state
+            .bounds_for_item(ix)
+            .expect("the entry is rendered")
+    })
+}
+
+fn right_click(position: Point<Pixels>, cx: &mut VisualTestContext) {
+    cx.simulate_mouse_down(position, MouseButton::Right, Modifiers::none());
+    cx.simulate_mouse_up(position, MouseButton::Right, Modifiers::none());
+    cx.run_until_parked();
+}
+
+// ── Log capture (R1.8, Q4) ─────────────────────────────────────────────────
+//
+// Story 031's capture (patch 0035's), which the sidebar crate has no copy of: a process-wide
+// logger writing into a thread-local buffer, so parallel tests do not see each other's lines.
+
+thread_local! {
+    static CAPTURED: RefCell<Vec<(log::Level, String)>> = const { RefCell::new(Vec::new()) };
+}
+
+struct CaptureLogger;
+
+impl log::Log for CaptureLogger {
+    fn enabled(&self, _metadata: &log::Metadata) -> bool {
+        true
+    }
+
+    fn log(&self, record: &log::Record) {
+        let line = record.args().to_string();
+        CAPTURED.with(|captured| captured.borrow_mut().push((record.level(), line)));
+    }
+
+    fn flush(&self) {}
+}
+
+static INSTALL: Once = Once::new();
+
+/// Starts capturing log lines on this thread. Panics when another logger owns the process,
+/// rather than letting a log assertion pass or fail for the wrong reason.
+fn capture_logs() {
+    INSTALL.call_once(|| {
+        log::set_boxed_logger(Box::new(CaptureLogger))
+            .expect("another logger is installed; the log capture cannot run");
+        log::set_max_level(log::LevelFilter::Trace);
+    });
+    CAPTURED.with(|captured| captured.borrow_mut().clear());
+}
+
+fn warn_lines() -> Vec<String> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .filter(|(level, _)| *level == log::Level::Warn)
+            .map(|(_, line)| line.clone())
+            .collect()
+    })
+}
+
+// ═══ Task 3.1 — rows: skipped in groups, built after the loop ══════════════
+
+// R2.2, R2.1, R2.3, R2.4, R2.7 — no pins, no header; with pins, one section after the LAST group,
+// newest pin first, each row naming its project, and the pinned threads gone from their groups.
+#[gpui::test]
+async fn pinned_section_follows_the_last_group_in_store_order(cx: &mut TestAppContext) {
+    let (fs, multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    open_in_window(BETA, &fs, &multi_workspace, cx).await;
+    let fix_login = save_in("a1", "Fix login", ALPHA, 3, cx);
+    let write_docs = save_in("a2", "Write docs", ALPHA, 2, cx);
+    let ship_release = save_in("b1", "Ship release", BETA, 1, cx);
+    let read_mail = save_in("b2", "Read mail", BETA, 0, cx);
+
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [beta]",
+            "  Ship release",
+            "  Read mail",
+            "v [alpha]",
+            "  Fix login",
+            "  Write docs",
+        ],
+        "no pinned thread, no Pinned header (the most recently opened project is listed first)"
+    );
+
+    store_pin(write_docs, cx);
+    store_pin(ship_release, cx);
+
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [beta]",
+            "  Read mail",
+            "v [alpha]",
+            "  Fix login",
+            "v Pinned",
+            "  Ship release · beta",
+            "  Write docs · alpha",
+        ],
+        "the section follows the last group, in stored order (newest pin first)"
+    );
+    for thread_id in [fix_login, write_docs, ship_release, read_mail] {
+        assert_eq!(
+            rows_of(&sidebar, thread_id, cx),
+            1,
+            "every thread is shown exactly once"
+        );
+    }
+}
+
+// R2.4 hostile half (shown once, never twice and never zero) on every path a group finds a thread
+// by: its project's main path, a linked worktree's folder (main path = the project), a row whose
+// stored main path disagrees with its folders, and a collapsed group (which never loads threads).
+#[gpui::test]
+async fn pinned_thread_is_shown_exactly_once_on_every_group_path(cx: &mut TestAppContext) {
+    let (fs, multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    open_in_window(BETA, &fs, &multi_workspace, cx).await;
+    let by_main_path = save_in("main", "By main path", ALPHA, 4, cx);
+    let in_linked_worktree = save(
+        "linked",
+        "In linked worktree",
+        "/alpha-feature",
+        ALPHA,
+        3,
+        cx,
+    );
+    let stale_main_path = save("stale", "Stale main path", ALPHA, "/elsewhere", 2, cx);
+    let in_beta = save_in("beta", "In beta", BETA, 1, cx);
+    let unpinned = save_in("plain", "Not pinned", ALPHA, 0, cx);
+    let pinned = [by_main_path, in_linked_worktree, stale_main_path, in_beta];
+    for thread_id in pinned {
+        assert_eq!(
+            rows_of(&sidebar, thread_id, cx),
+            1,
+            "fixture: the thread is shown once, in a group, before it is pinned"
+        );
+        store_pin(thread_id, cx);
+    }
+
+    let header = pinned_header_ix(&sidebar, cx).expect("a Pinned header");
+    for thread_id in pinned {
+        assert_eq!(
+            rows_of(&sidebar, thread_id, cx),
+            1,
+            "a pinned thread is shown exactly once: {:?}",
+            pinned_entries(&sidebar, cx)
+        );
+        assert!(
+            pinned_row_ix(&sidebar, thread_id, cx) > header,
+            "and it is in the section"
+        );
+    }
+    assert_eq!(rows_of(&sidebar, unpinned, cx), 1);
+    assert!(group_row_ix(&sidebar, unpinned, cx) < header);
+
+    // A collapsed group never loads its threads; its pinned threads must still be shown once.
+    // Opening BETA made it the active workspace: find ALPHA's group by its own path.
+    let alpha_key = multi_workspace.read_with(cx, |mw, cx| {
+        mw.workspaces()
+            .find(|workspace| workspace_path_list(workspace, cx).paths() == [PathBuf::from(ALPHA)])
+            .expect("fixture: ALPHA is open in this window")
+            .read(cx)
+            .project()
+            .read(cx)
+            .project_group_key(cx)
+    });
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.toggle_collapse(&alpha_key, window, cx)
+    });
+    cx.run_until_parked();
+    let entries = pinned_entries(&sidebar, cx);
+    // The groups are listed most recently opened first, so ALPHA is not necessarily first.
+    assert!(
+        entries.iter().any(|entry| entry == "> [alpha]"),
+        "{entries:?}"
+    );
+    for thread_id in pinned {
+        assert_eq!(
+            rows_of(&sidebar, thread_id, cx),
+            1,
+            "collapsed group: {entries:?}"
+        );
+    }
+    assert_eq!(
+        rows_of(&sidebar, unpinned, cx),
+        0,
+        "the collapsed group hides its own rows"
+    );
+}
+
+// R2.7 — a pinned row names the project the thread belongs to: for a linked worktree that is the
+// main project, not the worktree folder; and the label is the same text the project's group header
+// shows (including its disambiguation), so two projects with the same folder name stay apart.
+#[gpui::test]
+async fn pinned_row_label_is_the_projects_group_label(cx: &mut TestAppContext) {
+    let (fs, project) = init_pinned_test(cx).await;
+    fs.insert_tree("/work/app", serde_json::json!({ "src": {} }))
+        .await;
+    fs.insert_tree("/personal/app", serde_json::json!({ "src": {} }))
+        .await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+    open_in_window("/work/app", &fs, &multi_workspace, cx).await;
+    open_in_window("/personal/app", &fs, &multi_workspace, cx).await;
+    let linked = save("linked", "Linked", "/alpha-feature", ALPHA, 3, cx);
+    let at_work = save_in("work", "At work", "/work/app", 2, cx);
+    let at_home = save_in("home", "At home", "/personal/app", 1, cx);
+    for thread_id in [linked, at_work, at_home] {
+        store_pin(thread_id, cx);
+    }
+
+    let (headers, labels) = sidebar.read_with(cx, |sidebar, _| {
+        let headers: Vec<String> = sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::ProjectHeader { label, .. } => Some(label.to_string()),
+                _ => None,
+            })
+            .collect();
+        let labels: HashMap<ThreadId, String> = sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::Thread(thread) => thread
+                    .pinned_project_label
+                    .as_ref()
+                    .map(|label| (thread.metadata.thread_id, label.to_string())),
+                _ => None,
+            })
+            .collect();
+        (headers, labels)
+    });
+    assert_eq!(labels.get(&linked).map(String::as_str), Some("alpha"));
+    let work_label = labels
+        .get(&at_work)
+        .expect("a pinned row for the work thread");
