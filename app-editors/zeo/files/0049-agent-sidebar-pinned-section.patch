+}
+
+/// Saves a thread with a sent message whose folders are `folder` and whose project (main
+/// worktree) is `main`; a later `hour` sorts higher in its group.
+fn save(
+    session: &str,
+    title: &str,
+    folder: &str,
+    main: &str,
+    hour: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        PathList::new(&[PathBuf::from(folder)]),
+        PathList::new(&[PathBuf::from(main)]),
+        chrono::TimeZone::with_ymd_and_hms(&Utc, 2024, 1, 1, hour, 0, 0).unwrap(),
+        cx,
+    );
+    thread_id_of(session, cx)
+}
+
+/// A thread of the local project `folder`.
+fn save_in(
+    session: &str,
+    title: &str,
+    folder: &str,
+    hour: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    save(session, title, folder, folder, hour, cx)
+}
+
+fn thread_id_of(session: &str, cx: &mut VisualTestContext) -> ThreadId {
+    let session_id = acp::SessionId::new(Arc::from(session));
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|entry| entry.session_id.as_ref() == Some(&session_id))
+            .map(|entry| entry.thread_id)
+            .expect("the thread was saved")
+    })
+}
+
+// ── The store, driven directly (task 3 tests) ──────────────────────────────
+
+fn store_pin(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.pin(thread_id, cx))
+    })
+    .expect("the store accepts a pin of a known thread with a message");
+    cx.run_until_parked();
+}
+
+fn stored_pins(cx: &mut VisualTestContext) -> Vec<ThreadId> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .pinned()
+            .collect()
+    })
+}
+
+fn archive(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(thread_id, None, cx))
+    });
+    cx.run_until_parked();
+}
+
+fn unarchive(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.unarchive(thread_id, cx))
+    });
+    cx.run_until_parked();
+}
+
+fn delete(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(thread_id, cx))
+    });
+    cx.run_until_parked();
+}
+
+// ── Reading the sidebar ────────────────────────────────────────────────────
+
+/// `visible_entries_as_strings`, with the Pinned header and pinned rows in the format documented
+/// at the top of this file.
+fn pinned_entries(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    let base = visible_entries_as_strings(sidebar, cx);
+    sidebar.read_with(cx, |sidebar, _cx| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .enumerate()
+            .zip(base)
+            .map(|((ix, entry), line)| {
+                let selected = if sidebar.selection == Some(ix) {
+                    "  <== selected"
+                } else {
+                    ""
+                };
+                match entry {
+                    ListEntry::PinnedHeader { .. } => {
+                        let icon = if sidebar.pinned_collapsed { ">" } else { "v" };
+                        format!("{icon} Pinned{selected}")
+                    }
+                    ListEntry::Thread(thread) => match &thread.pinned_project_label {
+                        Some(label) => {
+                            let title = thread.metadata.display_title();
+                            let live = if thread.is_live { " *" } else { "" };
+                            let status = match thread.status {
+                                AgentThreadStatus::Running => " (running)",
+                                AgentThreadStatus::Error => " (error)",
+                                AgentThreadStatus::WaitingForConfirmation => " (waiting)",
+                                _ => "",
+                            };
+                            let notified = if sidebar
+                                .contents
+                                .is_thread_notified(&thread.metadata.thread_id)
+                            {
+                                " (!)"
+                            } else {
+                                ""
+                            };
+                            format!("  {title} · {label}{live}{status}{notified}{selected}")
+                        }
+                        None => line,
+                    },
+                    _ => line,
+                }
+            })
+            .collect()
+    })
+}
+
+/// How many entries are a row (group or pinned) of `thread_id`.
+fn rows_of(sidebar: &Entity<Sidebar>, thread_id: ThreadId, cx: &mut VisualTestContext) -> usize {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .filter(|entry| {
+                matches!(entry, ListEntry::Thread(thread) if thread.metadata.thread_id == thread_id)
+            })
+            .count()
+    })
+}
+
+/// The index of the Pinned header, if any.
+fn pinned_header_ix(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Option<usize> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| matches!(entry, ListEntry::PinnedHeader { .. }))
+    })
+}
+
+/// The index of the pinned row of `thread_id` (a row whose `pinned_project_label` is set).
+fn pinned_row_ix(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) -> usize {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread)
+                    if thread.metadata.thread_id == thread_id
+                        && thread.pinned_project_label.is_some())
+            })
+            .expect("the thread has a pinned row")
+    })
+}
+
+fn group_row_ix(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) -> usize {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread)
+                    if thread.metadata.thread_id == thread_id
+                        && thread.pinned_project_label.is_none())
+            })
+            .expect("the thread has a row in its group")
+    })
+}
+
+fn select(sidebar: &Entity<Sidebar>, ix: usize, cx: &mut VisualTestContext) {
+    focus_sidebar(sidebar, cx);
+    sidebar.update_in(cx, |sidebar, _window, cx| {
+        sidebar.selection = Some(ix);
+        cx.notify();
+    });
