+// Story 032 — the Pinned section of the agent sidebar (tasks 3.1–3.4, 4.1–4.3).
+//
+// Materialize with, in `crates/sidebar/src/sidebar.rs`, beside `mod sidebar_tests;`:
+//     #[cfg(test)]
+//     mod sidebar_pinned_tests;
+// Filter: `cargo test -p sidebar pinned`.
+//
+// Helpers reused from `sidebar_tests.rs` must become `pub(super)` there (nothing else changes in
+// them): `init_test`, `init_test_project_with_agent_panel`, `setup_sidebar`,
+// `setup_sidebar_with_agent_panel`, `save_thread_metadata_with_main_paths`,
+// `save_test_thread_metadata`, `visible_entries_as_strings`, `focus_sidebar`,
+// `enter_renamed_title`, `type_in_search`, `assert_project_header_has_threads`.
+//
+// TEXT FORMAT (the one exact format these tests assert). `pinned_entries` below wraps
+// `visible_entries_as_strings` and owns the two new shapes, so the tests do not depend on how that
+// helper is extended (it only needs a `ListEntry::PinnedHeader` arm to compile; printing
+// `"{v|>} Pinned{selected}"` there too is recommended, for consistency):
+//   - the Pinned header:   "v Pinned"  (expanded)  /  "> Pinned"  (collapsed, `pinned_collapsed`)
+//                          — no brackets, so it can never be confused with a project named
+//                          "Pinned", whose header is "v [Pinned]";
+//   - a pinned row:        "  {title} · {project label}{ *}{ (status)}{ (!)}"
+//                          i.e. the usual row with " · {label}" right after the title and no
+//                          worktree chips (the label takes their place, design.md);
+//   - everything else:     exactly `visible_entries_as_strings`.
+//   A selected entry ends in "  <== selected", as everywhere else.
+// A pinned row is a `ListEntry::Thread` whose `pinned_project_label` is `Some`.
+//
+// The store is installed with `agent_ui::thread_organization::init(cx)` BEFORE the sidebar is
+// created (the sidebar observes it from `Sidebar::new`). `init_test` already gives every test its
+// own `db::AppDatabase::test_new()`, which is the connection `ThreadOrganizationDb::global` uses,
+// so pins never leak between tests.
+//
+// Hostile halves come first in every identity rule: a pinned thread appears exactly once (not
+// zero, not twice) on every group path; a group whose only threads are pinned keeps its header
+// with no "No threads yet" while a truly empty group still shows it; the action on a header does
+// nothing while on a thread it toggles; the filter keeps a label-only match without title
+// highlights and drops a non-match.
+
+use super::*;
+use crate::sidebar_tests::{
+    assert_project_header_has_threads, enter_renamed_title, focus_sidebar, init_test,
+    init_test_project_with_agent_panel, save_test_thread_metadata,
+    save_thread_metadata_with_main_paths, setup_sidebar, setup_sidebar_with_agent_panel,
+    type_in_search, visible_entries_as_strings,
+};
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::schema::v1 as acp_v1;
+use agent_ui::test_support::{active_session_id, open_thread_with_connection, send_message};
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use fs::FakeFs;
+use gpui::{Bounds, MouseButton, Point, TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+use std::cell::RefCell;
+use std::sync::Once;
+
+const ALPHA: &str = "/alpha";
+const BETA: &str = "/beta";
+const GAMMA: &str = "/gamma";
+/// Never opened in any window by these tests unless a test opens it on purpose.
+const DELTA: &str = "/delta";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// Sidebar test globals, a FakeFs holding every project folder, and the organization store.
+/// Returns the fs and a project for `ALPHA`.
+async fn init_pinned_test(cx: &mut TestAppContext) -> (Arc<FakeFs>, Entity<project::Project>) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    for path in [ALPHA, BETA, GAMMA, DELTA] {
+        fs.insert_tree(path, serde_json::json!({ "src": {} })).await;
+    }
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        agent_ui::thread_organization::init(cx);
+    });
+    cx.run_until_parked();
+    let project = project::Project::test(fs.clone(), [ALPHA.as_ref()], cx).await;
