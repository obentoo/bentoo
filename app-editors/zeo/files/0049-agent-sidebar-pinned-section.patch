+/// What a rebuild reads to give a thread row its live state.
+struct LiveRowContext<'a> {
+    live_info_by_session: &'a HashMap<acp::SessionId, ActiveThreadInfo>,
+    old_statuses: &'a HashMap<acp::SessionId, (AgentThreadStatus, ThreadId)>,
+    active_entry: Option<&'a ActiveEntry>,
+    active_workspace: Option<&'a Entity<Workspace>>,
+}
+
+/// Group rows and pinned rows share this, so a thread is marked notified by one rule wherever
+/// it is listed. Recording the status is what lets the next rebuild see a turn end.
+fn apply_live_row_state(
+    thread: &mut Arc<ThreadEntry>,
+    context: &LiveRowContext<'_>,
+    new_live_statuses: &mut HashMap<acp::SessionId, (AgentThreadStatus, ThreadId)>,
+    notified_threads: &mut HashSet<ThreadId>,
+) {
+    if let Some(session_id) = thread.metadata.session_id.clone() {
+        if let Some(info) = context.live_info_by_session.get(&session_id) {
+            let status = info.status;
+            let thread_id = thread.metadata.thread_id;
+            Arc::make_mut(thread).apply_active_info(info);
+            new_live_statuses.insert(session_id, (status, thread_id));
+        }
+    }
+
+    let session_id = &thread.metadata.session_id;
+    let is_active_thread = context.active_entry.is_some_and(|entry| {
+        entry.is_active_thread(&thread.metadata.thread_id)
+            && context
+                .active_workspace
+                .is_some_and(|active| active == entry.workspace())
+    });
+
+    if thread.status == AgentThreadStatus::Completed
+        && !is_active_thread
+        && session_id
+            .as_ref()
+            .and_then(|sid| context.old_statuses.get(sid))
+            .is_some_and(|(s, _)| *s == AgentThreadStatus::Running)
+    {
+        notified_threads.insert(thread.metadata.thread_id);
+    }
+
+    if is_active_thread && !thread.is_background {
+        notified_threads.remove(&thread.metadata.thread_id);
+    }
+}
