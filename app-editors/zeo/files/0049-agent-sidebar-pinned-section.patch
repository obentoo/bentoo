+    assert!(
+        row_is_live,
+        "fixture: the pinned row is live (gamma is in this window)"
+    );
+    assert_eq!(
+        editors(&workspace_alpha, cx),
+        Vec::new(),
+        "fixture: alpha has no editor"
+    );
+    assert_eq!(
+        editors(&workspace_gamma, cx),
+        Vec::new(),
+        "fixture: gamma has no editor"
+    );
+
+    open_pinned_row_menu(&sidebar, thread, cx);
+    let entry = cx
+        .debug_bounds("MENU_ITEM-Open Thread as Markdown")
+        .expect("the entry is offered");
+    cx.simulate_click(entry.center(), Modifiers::none());
+    cx.run_until_parked();
+
+    assert_eq!(
+        editors(&workspace_gamma, cx).len(),
+        1,
+        "the Markdown opens in the row's own workspace"
+    );
+    assert_eq!(
+        editors(&workspace_alpha, cx),
+        Vec::new(),
+        "not in the active workspace"
+    );
+}
