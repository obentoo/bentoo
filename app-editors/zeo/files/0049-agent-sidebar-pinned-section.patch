+    /// The one writer of a pin from the sidebar. It must run outside any `ThreadMetadataStore`
+    /// update: the store reads that entity to refuse drafts and unknown threads.
+    fn toggle_pin(&mut self, thread_id: ThreadId, cx: &mut Context<Self>) {
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let is_pinned = Self::is_pinned_in(&store, thread_id, cx);
+        let result = store.update(cx, |store, cx| {
+            if is_pinned {
+                store.unpin(thread_id, cx)
+            } else {
+                store.pin(thread_id, cx)
+            }
+        });
+        if let Err(error) = result {
+            log::warn!("sidebar: pin toggle refused for thread {thread_id:?}: {error}");
+        }
+    }
+
+    /// Whether `thread_id` is pinned, as every pin entry point must read it to name and perform
