+// R3.1, R3.2, R3.3 — archiving hides a pinned thread from the section (and from its group) but
+// keeps it pinned; unarchiving puts it back at its stored position; deleting removes it.
+#[gpui::test]
+async fn archived_and_deleted_pinned_threads_leave_the_section(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let first = save_in("t1", "First", ALPHA, 1, cx);
+    let second = save_in("t2", "Second", ALPHA, 2, cx);
+    let third = save_in("t3", "Third", ALPHA, 3, cx);
+    for thread_id in [first, second, third] {
+        store_pin(thread_id, cx);
+    }
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [alpha]",
+            "v Pinned",
+            "  Third · alpha",
+            "  Second · alpha",
+            "  First · alpha"
+        ]
+    );
+
+    archive(second, cx);
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [alpha]",
+            "v Pinned",
+            "  Third · alpha",
+            "  First · alpha"
+        ],
+        "an archived pinned thread is shown nowhere"
+    );
+    assert_eq!(
+        stored_pins(cx),
+        vec![third, second, first],
+        "and it stays pinned"
+    );
+
+    unarchive(second, cx);
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [alpha]",
+            "v Pinned",
+            "  Third · alpha",
+            "  Second · alpha",
+            "  First · alpha"
+        ],
+        "unarchived, it is back at its stored position"
