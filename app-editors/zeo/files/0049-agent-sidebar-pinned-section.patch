+// R6.3 — the Pinned header closes the last group's section: the neighbour of that group's last
+// row is the row above it in the group, never a pinned row below.
+#[gpui::test]
+async fn neighbour_of_the_last_groups_last_row_stays_in_its_group(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let newest = save_in("a1", "Fix login", ALPHA, 3, cx);
+    let pinned = save_in("a2", "Write docs", ALPHA, 2, cx);
+    let oldest = save_in("a3", "Old work", ALPHA, 1, cx);
+    store_pin(pinned, cx);
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [alpha]",
+            "  Fix login",
+            "  Old work",
+            "v Pinned",
+            "  Write docs · alpha"
+        ],
+        "fixture: the last group's last row sits right above the Pinned section"
+    );
+
+    let position = group_row_ix(&sidebar, oldest, cx);
+    let neighbour = sidebar.read_with(cx, |sidebar, _| {
+        match sidebar.neighboring_activatable_entry(position) {
+            Some(ActivatableEntry::Thread { metadata }) => Some(metadata.thread_id),
+            _ => None,
+        }
+    });
+
+    assert_eq!(neighbour, Some(newest));
+}
+
+// R4.2 — with a pinned row selected, a new thread in "the selected group" goes to that row's own
+// project, not to the group listed just above the Pinned section; the Pinned header itself
+// selects no group.
+#[gpui::test]
+async fn a_selected_pinned_row_selects_its_own_project(cx: &mut TestAppContext) {
+    let (fs, multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    open_in_window(BETA, &fs, &multi_workspace, cx).await;
+    save_in("b1", "Ship release", BETA, 3, cx);
+    let in_alpha = save_in("a1", "Fix login", ALPHA, 2, cx);
+    let elsewhere = save_in("d1", "Plan trip", DELTA, 1, cx);
+    store_pin(in_alpha, cx);
+    store_pin(elsewhere, cx);
+    assert_eq!(
+        pinned_entries(&sidebar, cx),
+        vec![
+            "v [beta]",
+            "  Ship release",
+            "v [alpha]",
+            "v Pinned",
+            "  Plan trip · delta",
+            "  Fix login · alpha"
+        ],
+        "fixture: ALPHA is the group above Pinned; DELTA is open nowhere"
+    );
+
+    let selected_key = |ix: usize, cx: &mut VisualTestContext| {
+        select(&sidebar, ix, cx);
+        sidebar.read_with(cx, |sidebar, cx| sidebar.selected_group_key(cx))
+    };
+
+    let ix = pinned_row_ix(&sidebar, elsewhere, cx);
+    assert_eq!(
+        selected_key(ix, cx),
+        Some(local_key(DELTA)),
+        "a closed pinned row"
+    );
+    let ix = pinned_row_ix(&sidebar, in_alpha, cx);
+    assert_eq!(
+        selected_key(ix, cx),
+        Some(local_key(ALPHA)),
+        "an open pinned row"
+    );
+    let ix = pinned_header_ix(&sidebar, cx).expect("fixture: the Pinned header is shown");
+    assert_eq!(selected_key(ix, cx), None, "the Pinned header");
+}
