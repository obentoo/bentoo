+// R2.10 — the Pinned header is a header for the sticky-header and header-navigation index, and
+// when the list is scrolled into the pinned rows a sticky header is rendered.
+#[gpui::test]
+async fn pinned_header_is_the_sticky_header_over_pinned_rows(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    // A list shorter than the window clamps its scroll back to the top on every redraw.
+    cx.simulate_resize(gpui::size(px(400.), px(160.)));
+    for hour in 0..6 {
+        save_in(
+            &format!("a{hour}"),
+            &format!("Group thread {hour}"),
+            ALPHA,
+            hour,
+            cx,
+        );
+    }
+    let mut pins = Vec::new();
+    for hour in 6..12 {
+        pins.push(save_in(
+            &format!("d{hour}"),
+            &format!("Pinned thread {hour}"),
+            DELTA,
+            hour,
+            cx,
+        ));
+    }
+    for thread_id in &pins {
+        store_pin(*thread_id, cx);
+    }
+    let header = pinned_header_ix(&sidebar, cx).expect("a Pinned header");
+    sidebar.read_with(cx, |sidebar, _| {
+        assert!(
+            sidebar.contents.project_header_indices.contains(&header),
+            "the Pinned header is indexed as a header: {:?}",
+            sidebar.contents.project_header_indices
+        );
+    });
+
+    let draw = |cx: &mut VisualTestContext| {
+        cx.draw(
+            gpui::point(px(0.), px(0.)),
+            gpui::size(px(400.), px(160.)),
+            |_, _| sidebar.clone().into_any_element(),
+        );
+        cx.run_until_parked();
+    };
+    draw(cx);
+    sidebar.update_in(cx, |sidebar, _window, cx| {
+        sidebar.list_state.scroll_to(gpui::ListOffset {
+            item_ix: header + 2,
+            offset_in_item: px(4.),
+        });
+        cx.notify();
+    });
+    draw(cx);
+
+    let has_sticky_header = sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.render_sticky_header(window, cx).is_some()
+    });
+    assert!(
+        has_sticky_header,
+        "scrolled into the pinned rows, \"Pinned\" sticks at the top"
+    );
+}
