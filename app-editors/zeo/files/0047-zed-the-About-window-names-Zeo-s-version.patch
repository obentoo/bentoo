@@ -5862,6 +5917,27 @@ mod tests {
 
     /// Checks that action namespaces are the expected set. The purpose of this is to prevent typos
     /// and let you know when introducing a new namespace.
+    /// 0047: the About window shows Zeo's package version only on the Zeo channel and
+    /// only when the package set one, and titles it by the part before the snapshot.
+    #[test]
+    fn test_about_window_package_version() {
+        use super::{package_version_for, short_version};
+        assert_eq!(
+            package_version_for(Some("0.2.1_p20261008"), ReleaseChannel::Zeo),
+            Some("0.2.1_p20261008")
+        );
+        assert_eq!(package_version_for(Some(""), ReleaseChannel::Zeo), None);
+        assert_eq!(package_version_for(None, ReleaseChannel::Zeo), None);
+        assert_eq!(
+            package_version_for(Some("0.2.1_p20261008"), ReleaseChannel::Stable),
+            None,
+            "another channel keeps Zed's version"
+        );
+        assert_eq!(short_version("0.2.1_p20261008"), "0.2.1");
+        assert_eq!(short_version("0.2.1_p20261008-r1"), "0.2.1");
+        assert_eq!(short_version("0.2.1"), "0.2.1");
+    }
+
