diff --git a/crates/agent_ui/src/conversation_view/thread_view/context_usage_card.rs b/crates/agent_ui/src/conversation_view/thread_view/context_usage_card.rs
new file mode 100644
index 0000000..625bd3e
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/thread_view/context_usage_card.rs
@@ -0,0 +1,366 @@
+//! The context ring's breakdown card (Zeo next proposal §6.34, ask 57).
+//!
+//! A click on the context ring asks the agent what fills the window (`_claude/context/usage`,
+//! Claude Agent (Plus) 0.38.0) and opens a card above the composer: "Context Usage", a "View
+//! Report" link (ask 58, `context_usage_report`), a control that hides it, how full the window
+//! is, a segmented bar and one row per category. Free space and the compaction buffer are the
+//! bar's empty part, never rows. Hover keeps the ring's tooltip; the card is asked for on a
+//! click only, because the agent's full count costs it token-count calls.
+//!
+//! The card belongs to the thread view, so each thread keeps its own; a second click on the
+//! ring, or the hide control, closes it, and the next click asks again.
+
+use acp_thread::context_usage::{ContextUsageDetail, ContextUsageReport};
+use gpui::{AnyElement, App, Context, Hsla, SharedString, Task, Window, px, relative};
+use ui::{IconButton, IconName, IconSize, Label, LabelSize, Tooltip, prelude::*};
+
+use super::ThreadView;
+use super::content_column::content_column;
+
+/// What the card shows while it is open.
+pub(crate) enum ContextUsageCardState {
+    Loading,
+    Ready(ContextUsageReport),
+    Failed(SharedString),
+}
+
+/// The open card, with the request that fills it.
+pub(crate) struct ContextUsageCard {
+    pub(crate) state: ContextUsageCardState,
+    _fetch: Task<()>,
+}
+
+/// How a category is painted: the agent's own instructions muted, every other row in one of
+/// the theme's accents. The agent sends a colour too, but it is the CLI's theme name
+/// (`promptBorder`, `claude`, ...), which means nothing to Zeo's themes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CategoryPaint {
+    Muted,
+    Accent(usize),
+}
+
+/// The SDK's stable category ids, in the order their accents are handed out, so a category
+/// keeps its colour from one card to the next however the rows are sorted.
+const ACCENT_ORDER: [&str; 8] = [
+    "system_tools",
+    "memory_files",
+    "skills",
+    "mcp_tools",
+    "mcp_instructions",
+    "custom_agents",
+    "messages",
+    "system_tools_deferred",
+];
+
+/// The paint for the row at `position`: by `id` when it is one the SDK documents, else after
+/// the documented ones, by position, so two unknown rows still differ.
+pub(crate) fn category_paint(id: Option<&str>, position: usize) -> CategoryPaint {
+    if id == Some("system_prompt") {
+        return CategoryPaint::Muted;
+    }
+    let documented = id.and_then(|id| ACCENT_ORDER.iter().position(|known| *known == id));
+    CategoryPaint::Accent(documented.unwrap_or(ACCENT_ORDER.len() + position))
+}
+
+/// Each category's share of the window, for the bar's segments. A total the agent reports
+/// above the window (it can, while a compaction is due) is scaled down, so the segments never
+/// overflow the bar.
+pub(crate) fn segment_fractions(report: &ContextUsageReport) -> Vec<f32> {
+    if report.max_tokens == 0 {
+        return vec![0.; report.categories.len()];
+    }
+    let used: u64 = report
+        .categories
+        .iter()
+        .map(|category| category.tokens)
+        .sum();
+    let scale = if used > report.max_tokens {
+        report.max_tokens as f64 / used as f64
+    } else {
+        1.
+    };
+    report
+        .categories
+        .iter()
+        .map(|category| (category.tokens as f64 * scale / report.max_tokens as f64) as f32)
+        .collect()
+}
+
+/// "12% Full", from the agent's own percentage.
+pub(crate) fn full_label(percentage: f64) -> String {
+    format!("{}% Full", percentage.clamp(0., 100.).round() as u32)
+}
+
+/// "~31.4K / 256K Tokens": approximate, because a mid-turn answer is an estimate and a full
+/// one is already stale by the next message.
+pub(crate) fn tokens_label(total_tokens: u64, max_tokens: u64) -> String {
+    format!(
+        "~{} / {} Tokens",
+        crate::humanize_token_count(total_tokens),
+        crate::humanize_token_count(max_tokens)
+    )
+}
+
+impl ThreadView {
+    /// Opens the card and asks the agent for the breakdown, or closes an open card. Nothing
+    /// happens when the agent does not report its context usage, so the ring's click keeps
+    /// only its quota refresh there.
+    pub(super) fn toggle_context_usage_card(&mut self, cx: &mut Context<Self>) {
+        if self.context_usage_card.take().is_some() {
+            cx.notify();
+            return;
+        }
+        let connection = self.thread.read(cx).connection().clone();
+        if !connection.supports_context_usage() {
+            return;
+        }
+        let session_id = self.thread.read(cx).session_id().clone();
+        let request = connection.context_usage(&session_id, cx);
+        let fetch = cx.spawn(async move |this, cx| {
+            let result = request.await;
+            this.update(cx, |this, cx| {
+                // Closed while the agent answered: the answer has nowhere to go.
+                let Some(card) = this.context_usage_card.as_mut() else {
+                    return;
+                };
+                card.state = match result {
+                    Ok(report) => ContextUsageCardState::Ready(report),
+                    Err(error) => {
+                        log::warn!(
+                            "context usage request failed: session={session_id} error={error:#}"
+                        );
+                        ContextUsageCardState::Failed(error.to_string().into())
+                    }
+                };
+                cx.notify();
+            })
+            .ok();
+        });
+        self.context_usage_card = Some(ContextUsageCard {
+            state: ContextUsageCardState::Loading,
+            _fetch: fetch,
+        });
+        cx.notify();
+    }
+
+    pub(super) fn render_context_usage_card(&self, cx: &Context<Self>) -> Option<AnyElement> {
+        let card = self.context_usage_card.as_ref()?;
+        let colors = cx.theme().colors();
+        let report = match &card.state {
+            ContextUsageCardState::Ready(report) => Some(report),
+            _ => None,
+        };
+
+        let header = h_flex()
+            .w_full()
+            .justify_between()
+            .child(
+                h_flex()
+                    .gap_2()
+                    .child(Label::new("Context Usage").size(LabelSize::Small))
+                    .child(
+                        Button::new("context-usage-view-report", "View Report")
+                            .label_size(LabelSize::Small)
+                            .color(Color::Muted)
+                            .disabled(report.is_none())
+                            .tooltip(Tooltip::text("Open the full report in an editor tab"))
+                            .on_click(cx.listener(|this, _, window, cx| {
+                                this.open_context_usage_report(window, cx);
+                            })),
+                    ),
+            )
+            .child(
+                IconButton::new("context-usage-hide", IconName::Dash)
+                    .icon_size(IconSize::Small)
+                    .icon_color(Color::Muted)
+                    .aria_label("Hide Context Usage")
+                    .tooltip(Tooltip::text("Hide Context Usage"))
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        this.context_usage_card = None;
+                        cx.notify();
+                    })),
+            );
+
+        let body = match &card.state {
+            ContextUsageCardState::Loading => Label::new("Reading the context window…")
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .into_any_element(),
+            ContextUsageCardState::Failed(reason) => {
+                Label::new(format!("Couldn't read the context usage: {reason}"))
+                    .size(LabelSize::Small)
+                    .color(Color::Error)
+                    .into_any_element()
+            }
+            ContextUsageCardState::Ready(report) => self.render_context_usage_body(report, cx),
+        };
+
+        let card = v_flex()
+            .id("context-usage-card")
+            .debug_selector(|| "context-usage-card".into())
+            .mx_2()
+            .mb_1()
+            .p_2()
+            .gap_1p5()
+            .rounded_md()
+            .border_1()
+            .border_color(colors.border)
+            .bg(colors.panel_background)
+            .shadow_sm()
+            .child(header)
+            .child(body);
+        // The composer's column (§6.30), as the question card and the docked tasks bar.
+        Some(content_column(card, cx).into_any_element())
+    }
+
+    fn render_context_usage_body(
+        &self,
+        report: &ContextUsageReport,
+        cx: &Context<Self>,
+    ) -> AnyElement {
+        let colors = cx.theme().colors();
+        let paints: Vec<Hsla> = report
+            .categories
+            .iter()
+            .enumerate()
+            .map(|(position, category)| {
+                category_hsla(category_paint(category.id.as_deref(), position), cx)
+            })
+            .collect();
+
+        let bar = h_flex()
+            .debug_selector(|| "context-usage-bar".into())
+            .w_full()
+            .h(px(6.))
+            .gap_px()
+            .rounded_sm()
+            .overflow_hidden()
+            .bg(colors.element_background)
+            .children(
+                segment_fractions(report)
+                    .into_iter()
+                    .zip(paints.iter().copied())
+                    .filter(|(fraction, _)| *fraction > 0.)
+                    .map(|(fraction, paint)| {
+                        div().h_full().w(relative(fraction)).flex_none().bg(paint)
+                    }),
+            );
+
+        let rows =
+            report
+                .categories
+                .iter()
+                .zip(paints)
+                .enumerate()
+                .map(|(ix, (category, paint))| {
+                    category_row(ix, &category.name, category.tokens, paint, cx)
+                });
+
+        v_flex()
+            .gap_1p5()
+            .child(
+                h_flex()
+                    .w_full()
+                    .justify_between()
+                    .child(
+                        Label::new(full_label(report.percentage))
+                            .size(LabelSize::XSmall)
+                            .color(Color::Muted),
+                    )
+                    .child(
+                        Label::new(tokens_label(report.total_tokens, report.max_tokens))
+                            .size(LabelSize::XSmall)
+                            .color(Color::Muted),
+                    ),
+            )
+            .child(bar)
+            .child(v_flex().children(rows))
+            .when(report.detail == ContextUsageDetail::Summary, |this| {
+                this.child(
+                    Label::new(
+                        "Estimated while the agent works. Reopen the card when the turn ends \
+                         for the full count.",
+                    )
+                    .size(LabelSize::XSmall)
+                    .color(Color::Muted),
+                )
+            })
+            .into_any_element()
+    }
+
+    /// "View Report": the breakdown as a Markdown document, in an editor tab with its preview.
+    fn open_context_usage_report(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let Some(ContextUsageCard {
+            state: ContextUsageCardState::Ready(report),
+            ..
+        }) = self.context_usage_card.as_ref()
+        else {
+            return;
+        };
+        let Some(workspace) = self.workspace.upgrade() else {
+            return;
+        };
+        let thread_title = self
+            .thread
+            .read(cx)
+            .title()
+            .unwrap_or_else(|| crate::DEFAULT_THREAD_TITLE.into())
+            .to_string();
+        let repository = self.project.upgrade().map(|project| {
+            project
+                .read(cx)
+                .visible_worktrees(cx)
+                .map(|worktree| worktree.read(cx).root_name_str().to_string())
+                .collect::<Vec<_>>()
+                .join(", ")
+        });
+        let markdown = super::context_usage_report::context_usage_markdown(
+            report,
+            &thread_title,
+            repository.as_deref().filter(|names| !names.is_empty()),
+        );
+        super::context_usage_report::open_context_usage_report(markdown, workspace, window, cx)
+            .detach_and_log_err(cx);
+    }
+}
+
+/// One category: its colour, its name, its tokens.
+fn category_row(ix: usize, name: &str, tokens: u64, paint: Hsla, cx: &App) -> impl IntoElement {
+    h_flex()
+        .id(("context-usage-row", ix))
+        .w_full()
+        .px_1()
+        .py_0p5()
+        .justify_between()
+        .rounded_sm()
+        .hover(|style| style.bg(cx.theme().colors().element_hover))
+        .child(
+            h_flex()
+                .gap_2()
+                .child(div().size(px(10.)).rounded_xs().flex_none().bg(paint))
+                .child(Label::new(name.to_string()).size(LabelSize::Small)),
+        )
+        .child(
+            Label::new(crate::humanize_token_count(tokens))
+                .size(LabelSize::Small)
+                .color(Color::Muted),
+        )
+}
+
+fn category_hsla(paint: CategoryPaint, cx: &App) -> Hsla {
+    match paint {
+        CategoryPaint::Muted => cx.theme().colors().text_muted,
+        CategoryPaint::Accent(slot) => {
+            let accents = &cx.theme().accents().0;
+            if accents.is_empty() {
+                cx.theme().colors().text_accent
+            } else {
+                accents[slot % accents.len()]
+            }
+        }
+    }
+}
+
