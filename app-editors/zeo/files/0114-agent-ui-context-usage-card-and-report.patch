+use acp_thread::context_usage::{
+    ContextUsageAutoCompact, ContextUsageCategory, ContextUsageDetail, ContextUsageMcpTool,
+    ContextUsageMemoryFile, ContextUsageReport, ContextUsageSkill, ContextUsageTool,
+};
+use indoc::indoc;
+use pretty_assertions::assert_eq;
+
+use super::{context_usage_markdown, group_thousands};
+
+fn category(id: Option<&str>, name: &str, tokens: u64) -> ContextUsageCategory {
+    ContextUsageCategory {
+        id: id.map(Into::into),
+        name: name.into(),
+        tokens,
+    }
+}
+
+/// An estimate taken mid-turn, with a row the SDK gave no id, a `|` in a name, MCP tools out
+/// of server order, and skills sent without their category.
+fn report() -> ContextUsageReport {
+    ContextUsageReport {
+        detail: ContextUsageDetail::Summary,
+        model: "claude-opus-5-5".into(),
+        total_tokens: 15_045,
+        max_tokens: 200_000,
+        percentage: 7.52,
+        auto_compact: ContextUsageAutoCompact {
+            enabled: true,
+            threshold: Some(180_000.),
+        },
+        categories: vec![
+            category(Some("memory_files"), "Memory files", 13_600),
+            category(Some("messages"), "Messages", 1_000),
+            category(Some("mcp_tools"), "MCP tools", 400),
+            category(None, "Mystery | row", 45),
+        ],
+        tools: vec![ContextUsageTool {
+            name: "Read".into(),
+            call_tokens: 120,
+            result_tokens: 4_000,
+        }],
+        mcp_tools: vec![
+            ContextUsageMcpTool {
+                name: "search".into(),
+                server_name: "brave".into(),
+                tokens: 300,
+            },
+            ContextUsageMcpTool {
+                name: "fetch".into(),
+                server_name: "alpha".into(),
+                tokens: 100,
+            },
+        ],
+        memory_files: vec![ContextUsageMemoryFile {
+            path: "/w/CLAUDE.md".into(),
+            kind: "Project".into(),
+            tokens: 13_600,
+        }],
+        skills: vec![ContextUsageSkill {
+            name: "zeo-proof".into(),
+            source: "projectSettings".into(),
+            tokens: 90,
+        }],
+        agents: Vec::new(),
+    }
+}
+
+#[test]
+fn the_report_snapshot() {
+    let markdown = context_usage_markdown(&report(), "Fix the\nbuild", Some("zeo"));
+    assert_eq!(
+        markdown,
+        indoc! {"
+            Context Usage Report
+
+            # Fix the build
+
+            | Repository | Context size | Tokens used |
+            | --- | --- | --- |
+            | zeo | 200k | ~15k (8%) |
+
+            Model: `claude-opus-5-5`. Auto-compact: on, at 180,000 tokens.
+
+            > Estimated: a turn was running, so the agent counted locally instead of asking for an exact count. Open the report again when the turn ends for the full count.
+
+            The context window holds everything the agent reads on every turn: its own instructions, the tools it can call, your memory files and skills, and the conversation itself. It can only hold so much. As it fills, the agent has less room to work, and near the limit the conversation is compacted: older turns are summarized to make room. Some of what is here is set up by the agent; the rest is yours to control.
+
+            ## Categories
+
+            | Category | Tokens | Share of the window |
+            | --- | ---: | ---: |
+            | Memory files | 13,600 | 6.8% |
+            | Messages | 1,000 | 0.5% |
+            | MCP tools | 400 | 0.2% |
+            | Mystery \\| row | 45 | 0.0% |
+            | Free space and compaction buffer | 184,955 | 92.5% |
+
+            ## Memory files — 13,600 tokens
+
+            Memory files (CLAUDE.md and the files it imports), read into every turn. Yours to control: shorter memory files leave more room for the work.
+
+            | File | Kind | Tokens |
