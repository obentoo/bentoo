 #[cfg(test)]
 mod fork_config_tests;
 
@@ -2357,6 +2386,30 @@ impl AgentConnection for AcpConnection {
             .spawn(async move { parse_rewind_answer(&request.await?) })
     }
 
+    fn supports_context_usage(&self) -> bool {
+        self.agent_advertises(CLAUDE_CONTEXT_CAPABILITY)
+    }
+
+    fn context_usage(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        cx: &mut App,
+    ) -> Task<Result<acp_thread::context_usage::ContextUsageReport>> {
