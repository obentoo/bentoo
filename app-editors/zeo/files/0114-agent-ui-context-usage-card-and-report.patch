+//! "View Report" on the context card (Zeo next proposal §6.34, ask 58), in its simplest form
+//! (operator, 2026-11-14): the breakdown written as a Markdown document into an untitled
+//! buffer, opened with Zed's Markdown preview. The donut chart of the reference is a later step.
+//!
+//! The document says what each category is and whether it is the agent's or the user's to
+//! control, because the numbers alone do not tell a reader what to do about them.
+
+use std::fmt::Write as _;
+
+use acp_thread::context_usage::{ContextUsageDetail, ContextUsageReport};
+use anyhow::Result;
+use gpui::{App, Entity, Task, Window};
+use workspace::Workspace;
+
+/// The tab's title.
+const REPORT_TITLE: &str = "Context Usage";
+
+/// What a category is, by the SDK's stable id. An id the SDK adds later gets no description,
+/// never a wrong one.
+fn category_description(id: &str) -> Option<&'static str> {
+    Some(match id {
+        "system_prompt" => {
+            "The agent's own instructions, sent at the start of every turn: how it behaves, how \
+             it uses its tools, the rules of the session. Set up by the agent."
+        }
+        "system_tools" => {
+            "The definitions of the agent's built-in tools (reading files, running commands, \
+             searching), which the model reads on every turn to know what it can call. Set up by \
+             the agent."
+        }
+        "mcp_tools" => {
+            "The definitions of the tools your MCP servers expose. Yours to control: a server \
+             you turn off takes its tools out of the window."
+        }
+        "mcp_instructions" => {
+            "The instructions your MCP servers add to the agent's prompt. Yours to control, with \
+             the servers themselves."
+        }
+        "custom_agents" => {
+            "The descriptions of the subagents the agent can delegate to, so it knows when to \
+             call each one. Yours to control, beyond the built-in ones."
+        }
+        "memory_files" => {
+            "Memory files (CLAUDE.md and the files it imports), read into every turn. Yours to \
+             control: shorter memory files leave more room for the work."
+        }
+        "skills" => {
+            "The name and description of every skill the agent can load; a skill's body enters \
+             the window only once it is used. Yours to control."
+        }
+        "messages" => {
+            "The conversation itself: your messages, the agent's replies, and every tool call \
+             and result. It grows with each turn until a compaction summarizes it."
+        }
+        _ => return None,
+    })
+}
+
+/// `13600` as `13,600`.
+pub(crate) fn group_thousands(value: u64) -> String {
+    let digits = value.to_string();
+    let mut grouped = String::with_capacity(digits.len() + digits.len() / 3);
+    for (ix, digit) in digits.chars().enumerate() {
+        if ix > 0 && (digits.len() - ix).is_multiple_of(3) {
+            grouped.push(',');
+        }
+        grouped.push(digit);
+    }
+    grouped
+}
+
+/// Text from the agent made safe for one table cell: a `|` would end the cell, a newline the
+/// row.
+fn cell(text: &str) -> String {
+    text.replace('|', "\\|").replace(['\r', '\n'], " ")
+}
+
+fn share(tokens: u64, max_tokens: u64) -> String {
+    if max_tokens == 0 {
+        return "–".to_string();
+    }
+    format!("{:.1}%", tokens as f64 * 100. / max_tokens as f64)
+}
+
+/// The sub-rows a category has, as a Markdown table, or `None` when the agent sent none.
+fn sub_table(id: &str, report: &ContextUsageReport) -> Option<String> {
+    let mut table = String::new();
+    match id {
+        "messages" if !report.tools.is_empty() => {
+            table.push_str("| Tool | Calls | Results | Total |\n| --- | ---: | ---: | ---: |\n");
+            for tool in &report.tools {
+                let _ = writeln!(
+                    table,
+                    "| {} | {} | {} | {} |",
+                    cell(&tool.name),
+                    group_thousands(tool.call_tokens),
+                    group_thousands(tool.result_tokens),
+                    group_thousands(tool.call_tokens + tool.result_tokens)
+                );
+            }
+        }
+        "mcp_tools" if !report.mcp_tools.is_empty() => {
+            // By server, as the proposal asks; within one, the agent's order (largest first).
+            let mut tools: Vec<_> = report.mcp_tools.iter().collect();
+            tools.sort_by(|a, b| a.server_name.cmp(&b.server_name));
+            table.push_str("| Server | Tool | Tokens |\n| --- | --- | ---: |\n");
+            for tool in tools {
+                let _ = writeln!(
+                    table,
+                    "| {} | {} | {} |",
+                    cell(&tool.server_name),
+                    cell(&tool.name),
+                    group_thousands(tool.tokens)
+                );
+            }
+        }
+        "memory_files" if !report.memory_files.is_empty() => {
+            table.push_str("| File | Kind | Tokens |\n| --- | --- | ---: |\n");
+            for file in &report.memory_files {
+                let _ = writeln!(
+                    table,
+                    "| `{}` | {} | {} |",
+                    cell(&file.path).replace('`', "'"),
+                    cell(&file.kind),
+                    group_thousands(file.tokens)
+                );
+            }
+        }
+        "skills" if !report.skills.is_empty() => {
+            table.push_str("| Skill | Source | Tokens |\n| --- | --- | ---: |\n");
+            for skill in &report.skills {
+                let _ = writeln!(
+                    table,
+                    "| {} | {} | {} |",
+                    cell(&skill.name),
+                    cell(&skill.source),
+                    group_thousands(skill.tokens)
+                );
+            }
+        }
+        "custom_agents" if !report.agents.is_empty() => {
+            table.push_str("| Agent | Source | Tokens |\n| --- | --- | ---: |\n");
+            for agent in &report.agents {
+                let _ = writeln!(
+                    table,
+                    "| {} | {} | {} |",
+                    cell(&agent.agent_type),
+                    cell(&agent.source),
+                    group_thousands(agent.tokens)
+                );
+            }
+        }
+        _ => return None,
+    }
+    Some(table)
+}
+
+/// The sub-tables by the category they belong to, with the heading each gets when the agent
+/// sent its rows without the category (so nothing it sent is dropped).
+const SUB_TABLES: [(&str, &str); 5] = [
+    ("messages", "Tools in the conversation"),
+    ("mcp_tools", "MCP tools"),
+    ("memory_files", "Memory files"),
+    ("skills", "Skills"),
+    ("custom_agents", "Subagents"),
+];
+
+/// The report, as the Markdown the editor tab shows.
+pub(crate) fn context_usage_markdown(
+    report: &ContextUsageReport,
+    thread_title: &str,
+    repository: Option<&str>,
+) -> String {
+    let mut md = String::new();
+    let used = crate::humanize_token_count(report.total_tokens);
+    let window = crate::humanize_token_count(report.max_tokens);
+    let percentage = report.percentage.clamp(0., 100.).round() as u32;
+
+    md.push_str("Context Usage Report\n\n");
+    let _ = writeln!(md, "# {}\n", thread_title.replace(['\r', '\n'], " "));
+    md.push_str("| Repository | Context size | Tokens used |\n| --- | --- | --- |\n");
+    let _ = writeln!(
+        md,
+        "| {} | {window} | ~{used} ({percentage}%) |\n",
+        cell(repository.unwrap_or("–"))
+    );
+    let _ = write!(md, "Model: `{}`. ", report.model.replace('`', "'"));
+    match (report.auto_compact.enabled, report.auto_compact.threshold) {
+        (true, Some(threshold)) => {
+            let _ = writeln!(
+                md,
+                "Auto-compact: on, at {} tokens.\n",
+                group_thousands(threshold.max(0.).round() as u64)
+            );
+        }
+        (true, None) => md.push_str("Auto-compact: on.\n\n"),
+        (false, _) => md.push_str("Auto-compact: off.\n\n"),
+    }
+    if report.detail == ContextUsageDetail::Summary {
+        md.push_str(
+            "> Estimated: a turn was running, so the agent counted locally instead of asking \
+             for an exact count. Open the report again when the turn ends for the full count.\n\n",
+        );
+    }
+    md.push_str(
+        "The context window holds everything the agent reads on every turn: its own \
+         instructions, the tools it can call, your memory files and skills, and the conversation \
+         itself. It can only hold so much. As it fills, the agent has less room to work, and \
+         near the limit the conversation is compacted: older turns are summarized to make room. \
+         Some of what is here is set up by the agent; the rest is yours to control.\n\n",
+    );
+
+    md.push_str("## Categories\n\n");
+    md.push_str("| Category | Tokens | Share of the window |\n| --- | ---: | ---: |\n");
+    for category in &report.categories {
+        let _ = writeln!(
+            md,
+            "| {} | {} | {} |",
+            cell(&category.name),
+            group_thousands(category.tokens),
+            share(category.tokens, report.max_tokens)
+        );
+    }
+    let free = report.max_tokens.saturating_sub(report.total_tokens);
+    let _ = writeln!(
+        md,
+        "| Free space and compaction buffer | {} | {} |\n",
+        group_thousands(free),
+        share(free, report.max_tokens)
+    );
+
+    let mut emitted = Vec::new();
+    for category in &report.categories {
+        let id = category.id.as_deref().unwrap_or_default();
+        let _ = writeln!(
+            md,
+            "## {} — {} tokens\n",
+            category.name.replace(['\r', '\n'], " "),
+            group_thousands(category.tokens)
+        );
+        if let Some(description) = category_description(id) {
+            let _ = writeln!(md, "{description}\n");
+        }
+        if let Some(table) = sub_table(id, report) {
+            let _ = writeln!(md, "{table}");
+            emitted.push(id);
+        }
+    }
+    for (id, heading) in SUB_TABLES {
+        if emitted.contains(&id) {
+            continue;
+        }
+        if let Some(table) = sub_table(id, report) {
+            let _ = writeln!(md, "## {heading}\n\n{table}");
+        }
+    }
+    md.truncate(md.trim_end().len());
+    md.push('\n');
+    md
+}
+
+/// Writes `markdown` into an untitled buffer and opens Zed's Markdown preview of it.
+pub(crate) fn open_context_usage_report(
+    markdown: String,
+    workspace: Entity<Workspace>,
+    window: &mut Window,
+    cx: &mut App,
+) -> Task<Result<()>> {
+    let opened = super::open_markdown_in_workspace(
+        REPORT_TITLE.to_string(),
+        markdown,
+        workspace,
+        window,
+        cx,
+    );
+    window.spawn(cx, async move |cx| {
+        opened.await?;
+        // The editor just opened is the focused item, which is what OpenPreview previews.
+        cx.update(|window, cx| {
+            window.dispatch_action(Box::new(zed_actions::preview::markdown::OpenPreview), cx)
+        })?;
+        anyhow::Ok(())
+    })
+}
