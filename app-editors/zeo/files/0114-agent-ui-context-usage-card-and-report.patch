+// Zeo next proposal §6.34 (ask 57): the context card's pure parts. Filter: `context_usage_card`.
+
+use acp_thread::context_usage::{
+    ContextUsageAutoCompact, ContextUsageCategory, ContextUsageDetail, ContextUsageReport,
+};
+
+use super::{CategoryPaint, category_paint, full_label, segment_fractions, tokens_label};
+
+fn report(max_tokens: u64, tokens: &[u64]) -> ContextUsageReport {
+    ContextUsageReport {
+        detail: ContextUsageDetail::Full,
+        model: "m".into(),
+        total_tokens: tokens.iter().sum(),
+        max_tokens,
+        percentage: 0.,
+        auto_compact: ContextUsageAutoCompact {
+            enabled: true,
+            threshold: None,
+        },
+        categories: tokens
+            .iter()
+            .map(|&tokens| ContextUsageCategory {
+                id: None,
+                name: "c".into(),
+                tokens,
+            })
+            .collect(),
+        tools: Vec::new(),
+        mcp_tools: Vec::new(),
+        memory_files: Vec::new(),
+        skills: Vec::new(),
+        agents: Vec::new(),
+    }
+}
+
+#[test]
+fn a_category_keeps_its_colour_wherever_it_sorts() {
+    assert_eq!(
+        category_paint(Some("memory_files"), 0),
+        category_paint(Some("memory_files"), 5)
+    );
+    assert_eq!(
+        category_paint(Some("system_prompt"), 3),
+        CategoryPaint::Muted
+    );
+    assert_ne!(
+        category_paint(Some("skills"), 0),
+        category_paint(Some("messages"), 0)
+    );
+}
+
+/// Unknown ids, and rows from a CLI that predates `id`, are painted after the documented ones
+/// and by position, so two of them never share a colour with each other or a known row.
+#[test]
+fn unknown_rows_get_their_own_colours() {
+    let first = category_paint(Some("from_the_future"), 0);
+    let second = category_paint(None, 1);
+    assert_ne!(first, second);
+    for (position, known) in super::ACCENT_ORDER.iter().enumerate() {
+        let known = category_paint(Some(known), position);
+        assert_ne!(first, known);
+        assert_ne!(second, known);
+    }
+}
+
+#[test]
+fn segments_are_shares_of_the_window() {
+    let fractions = segment_fractions(&report(1_000, &[500, 250]));
+    assert_eq!(fractions, vec![0.5, 0.25]);
+}
+
+/// Hostile: a total above the window must not draw segments past the bar's end.
+#[test]
+fn segments_never_overflow_the_bar() {
+    let fractions = segment_fractions(&report(1_000, &[900, 600]));
+    let sum: f32 = fractions.iter().sum();
+    assert!(sum <= 1.0 + f32::EPSILON, "{fractions:?}");
+    assert!(fractions[0] > fractions[1]);
+}
+
+#[test]
+fn a_window_of_zero_draws_nothing() {
+    assert_eq!(segment_fractions(&report(0, &[10])), vec![0.]);
+}
+
+#[test]
+fn the_labels_read_as_the_reference_does() {
+    assert_eq!(full_label(12.3), "12% Full");
+    assert_eq!(full_label(140.), "100% Full");
+    assert_eq!(tokens_label(31_400, 256_000), "~31k / 256k Tokens");
+}
