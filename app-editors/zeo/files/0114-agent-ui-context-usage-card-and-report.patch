diff --git a/crates/acp_thread/src/context_usage.rs b/crates/acp_thread/src/context_usage.rs
new file mode 100644
index 0000000..4d7f070
--- /dev/null
+++ b/crates/acp_thread/src/context_usage.rs
@@ -0,0 +1,111 @@
+//! What fills a session's context window (Zeo next proposal §6.34, asks 57 and 58).
+//!
+//! The shape is Claude Agent (Plus) 0.38.0's `_claude/context/usage` answer (its
+//! `context-usage.ts`), which keeps the Agent SDK's `getContextUsage` breakdown and drops the
+//! CLI's grid. Only `used` categories arrive: free space and the compaction buffer are the
+//! window's remainder, so the client draws them as the bar's empty part, never as rows.
+//!
+//! Fields a later adapter adds are ignored, and a category's `id` stays optional, because the
+//! SDK says a CLI that predates it omits it and a later one may add values.
+
+use serde::Deserialize;
+
+/// Whether the agent counted the window with the API (`Full`) or estimated it locally while a
+/// turn was running (`Summary`): plus asks for the full count on an idle session only.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ContextUsageDetail {
+    Full,
+    Summary,
+}
+
+/// One `used` row of the window: the system prompt, tool definitions, memory files, skills,
+/// the conversation, and so on.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct ContextUsageCategory {
+    /// The SDK's stable name for the row (`system_prompt`, `messages`, ...); match on this,
+    /// never on `name`, which is English text.
+    #[serde(default)]
+    pub id: Option<String>,
+    pub name: String,
+    pub tokens: u64,
+}
+
+/// The tokens one tool's calls and results take in the conversation.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ContextUsageTool {
+    pub name: String,
+    pub call_tokens: u64,
+    pub result_tokens: u64,
+}
+
+/// One MCP tool's definition.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ContextUsageMcpTool {
+    pub name: String,
+    pub server_name: String,
+    pub tokens: u64,
+}
+
+/// One memory file (CLAUDE.md and the like) loaded into the window.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct ContextUsageMemoryFile {
+    pub path: String,
+    /// Where the file comes from (`Project`, `User`, ...), as the SDK names it.
+    #[serde(rename = "type")]
+    pub kind: String,
+    pub tokens: u64,
+}
+
+/// One skill's frontmatter in the window.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct ContextUsageSkill {
+    pub name: String,
+    pub source: String,
+    pub tokens: u64,
+}
+
+/// One subagent definition in the window.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ContextUsageAgent {
+    pub agent_type: String,
+    pub source: String,
+    pub tokens: u64,
+}
+
+/// The whole breakdown, as `AgentConnection::context_usage` answers it.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ContextUsageReport {
+    pub detail: ContextUsageDetail,
+    pub model: String,
+    pub total_tokens: u64,
+    pub max_tokens: u64,
+    /// How full the window is, 0 to 100, as the agent computed it.
+    pub percentage: f64,
+    pub auto_compact: ContextUsageAutoCompact,
+    /// Sorted by tokens, largest first, by the adapter.
+    pub categories: Vec<ContextUsageCategory>,
+    #[serde(default)]
+    pub tools: Vec<ContextUsageTool>,
+    #[serde(default)]
+    pub mcp_tools: Vec<ContextUsageMcpTool>,
+    #[serde(default)]
+    pub memory_files: Vec<ContextUsageMemoryFile>,
+    #[serde(default)]
+    pub skills: Vec<ContextUsageSkill>,
+    #[serde(default)]
+    pub agents: Vec<ContextUsageAgent>,
+}
+
+/// Whether the agent compacts the conversation on its own, and at how many tokens.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct ContextUsageAutoCompact {
+    pub enabled: bool,
+    /// A token count, kept as the agent sent it (a JSON number).
+    #[serde(default)]
+    pub threshold: Option<f64>,
+}
