@@ -0,0 +1,98 @@
+// Zeo next proposal §6.34 (asks 57, 58): reading Claude Agent (Plus) 0.38.0's
+// `_claude/context/usage` answer. Filter: `v1::context_usage_tests`.
+
+use acp_thread::context_usage::ContextUsageDetail;
+use serde_json::json;
+
+use super::parse_context_usage_answer;
+
+/// An `ok` answer as plus 0.38.0's `shapeContextUsage` writes it, `color` included: the client
+/// paints by `id`, so the CLI's colour names are read past.
+fn ok_answer() -> serde_json::Value {
+    json!({
+        "status": "ok",
+        "detail": "full",
+        "model": "claude-opus-5-5",
+        "totalTokens": 31_400,
+        "maxTokens": 256_000,
+        "percentage": 12.3,
+        "autoCompact": { "enabled": true, "threshold": 200_000 },
+        "categories": [
+            { "id": "memory_files", "name": "Memory files", "tokens": 13_600, "color": "claude" },
+            { "id": "system_prompt", "name": "System prompt", "tokens": 1_800, "color": "promptBorder" },
+            { "name": "Messages", "tokens": 855, "color": "purple" },
+        ],
+        "tools": [{ "name": "Read", "callTokens": 120, "resultTokens": 4_000 }],
+        "mcpTools": [{ "name": "search", "serverName": "brave", "tokens": 300 }],
+        "memoryFiles": [{ "path": "/w/CLAUDE.md", "type": "Project", "tokens": 13_600 }],
+        "skills": [{ "name": "zeo-proof", "source": "projectSettings", "tokens": 90 }],
+        "agents": [{ "agentType": "Explore", "source": "built-in", "tokens": 400 }],
+    })
+}
+
+#[test]
+fn an_ok_answer_is_read_whole() {
+    let report = parse_context_usage_answer(ok_answer()).expect("ok");
+    assert_eq!(report.detail, ContextUsageDetail::Full);
+    assert_eq!(report.total_tokens, 31_400);
+    assert_eq!(report.max_tokens, 256_000);
+    assert_eq!(report.auto_compact.threshold, Some(200_000.0));
+    assert_eq!(report.categories.len(), 3);
+    assert_eq!(report.categories[0].id.as_deref(), Some("memory_files"));
+    // A CLI that predates `id` omits it; the row is kept, without one.
+    assert_eq!(report.categories[2].id, None);
+    assert_eq!(report.tools[0].result_tokens, 4_000);
+    assert_eq!(report.mcp_tools[0].server_name, "brave");
+    assert_eq!(report.memory_files[0].kind, "Project");
+    assert_eq!(report.agents[0].agent_type, "Explore");
+}
+
+/// A later adapter may add fields and ids; neither may cost the user the card.
+#[test]
+fn unknown_fields_and_ids_are_tolerated() {
+    let mut answer = ok_answer();
+    answer["slashCommands"] = json!({ "totalCommands": 3 });
+    answer["categories"][0]["id"] = json!("a_category_from_the_future");
+    answer["categories"][0]["isDeferred"] = json!(false);
+    let report = parse_context_usage_answer(answer).expect("ok");
+    assert_eq!(
+        report.categories[0].id.as_deref(),
+        Some("a_category_from_the_future")
+    );
+}
+
+#[test]
+fn the_estimate_while_a_turn_runs_says_so() {
+    let mut answer = ok_answer();
+    answer["detail"] = json!("summary");
+    let report = parse_context_usage_answer(answer).expect("ok");
+    assert_eq!(report.detail, ContextUsageDetail::Summary);
+}
+
+/// Hostile: a missing total must be an error naming it, never a zero that draws an empty bar.
+#[test]
+fn a_missing_field_is_named() {
+    let mut answer = ok_answer();
+    answer.as_object_mut().unwrap().remove("maxTokens");
+    let error = parse_context_usage_answer(answer).unwrap_err().to_string();
+    assert!(error.contains("maxTokens"), "{error}");
+}
+
+#[test]
+fn unavailable_carries_the_agents_reason() {
+    let error = parse_context_usage_answer(json!({
+        "status": "unavailable",
+        "message": "The session has ended.",
+    }))
+    .unwrap_err()
+    .to_string();
+    assert_eq!(error, "The session has ended.");
+}
+
+#[test]
+fn an_unknown_status_is_an_error() {
+    let error = parse_context_usage_answer(json!({ "status": "later" }))
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("unknown status"), "{error}");
+}
