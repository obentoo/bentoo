+/// Reads a `_claude/context/usage` answer (plus 0.38.0's `ContextUsageReport`). `ok` is read
+/// strictly, so a missing or wrong-typed field is an error naming it; `unavailable` carries the
+/// agent's reason (the session ended, the SDK refused), which the card shows as it is.
+fn parse_context_usage_answer(
+    answer: serde_json::Value,
+) -> Result<acp_thread::context_usage::ContextUsageReport> {
+    match answer.get("status").and_then(|status| status.as_str()) {
+        Some("ok") => serde_json::from_value(answer)
+            .map_err(|error| anyhow!("{CLAUDE_CONTEXT_USAGE_METHOD} answered: {error}")),
+        Some("unavailable") => Err(anyhow!(
+            "{}",
+            answer
+                .get("message")
+                .and_then(|message| message.as_str())
+                .unwrap_or("The agent could not read its context window.")
+        )),
+        other => Err(anyhow!(
+            "{CLAUDE_CONTEXT_USAGE_METHOD} answered an unknown status {other:?}"
+        )),
+    }
+}
+
 /// Reads a `_claude/tasks/output` result strictly: a missing or wrong-typed field is an
 /// error naming it, never a default value.
 fn parse_task_output(response: &serde_json::Value) -> Result<acp_thread::TaskOutput> {
@@ -2066,6 +2092,9 @@ mod fork_session_tests;
 #[cfg(test)]
