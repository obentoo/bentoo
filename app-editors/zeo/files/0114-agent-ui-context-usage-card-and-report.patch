+/// A full count carries no estimate note, and a window with no repository says so.
+#[test]
+fn a_full_count_has_no_estimate_note() {
+    let mut report = report();
+    report.detail = ContextUsageDetail::Full;
+    report.auto_compact.enabled = false;
+    let markdown = context_usage_markdown(&report, "T", None);
+    assert!(!markdown.contains("Estimated"), "{markdown}");
+    assert!(markdown.contains("| – | 200k |"), "{markdown}");
+    assert!(markdown.contains("Auto-compact: off."), "{markdown}");
+}
