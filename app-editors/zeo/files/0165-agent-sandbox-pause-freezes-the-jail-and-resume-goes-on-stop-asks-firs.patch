+    /// Pauses launch `id` for the operator (ask of 2026-11-23): `freeze` gets the ai-jail
+    /// process, and only a freeze that worked marks the launch paused. Nothing is lost -- the
+    /// processes keep their memory -- and `set_paused(id, false)` after a thaw resumes it.
+    pub fn pause_by_operator_with(
+        id: LaunchId,
+        cx: &mut App,
+        freeze: impl FnOnce(u32) -> std::io::Result<()>,
+    ) -> std::io::Result<()> {
+        let pid = Self::launch(id, cx)
+            .and_then(|record| record.jail_pid)
+            .ok_or_else(|| {
+                std::io::Error::new(
+                    std::io::ErrorKind::NotFound,
+                    "the jail's process is not known",
+                )
+            })?;
+        match freeze(pid) {
+            Ok(()) => {
+                log::info!("agent_sandbox event=operator_pause pid={pid} outcome=frozen");
+                Self::set_paused(id, true, cx);
+                let registry = cx.default_global::<Self>();
+                if !registry.operator_paused.contains(&id) {
+                    registry.operator_paused.push(id);
+                }
+                Ok(())
+            }
+            Err(error) => {
+                log::warn!(
+                    "agent_sandbox event=operator_pause pid={pid} outcome=failed error={error}"
+                );
+                Err(error)
+            }
+        }
+    }
+
+    /// [`Self::pause_by_operator_with`] freezing ai-jail's systemd scope.
+    pub fn pause_by_operator(id: LaunchId, cx: &mut App) -> std::io::Result<()> {
+        Self::pause_by_operator_with(id, cx, |pid| {
+            crate::control::jail_scope_dir(pid)
+                .and_then(|scope| crate::control::set_frozen(&scope, true))
+        })
+    }
+
+    /// Whether launch `id` is paused because the operator paused it.
+    pub fn paused_by_operator(id: LaunchId, cx: &App) -> bool {
+        cx.try_global::<Self>()
+            .is_some_and(|registry| registry.operator_paused.contains(&id))
     }
 
     /// Records the ai-jail process of launch `id` (Zeo next §6.54).
@@ -1447,6 +1504,7 @@ impl LaunchRegistry {
             }
