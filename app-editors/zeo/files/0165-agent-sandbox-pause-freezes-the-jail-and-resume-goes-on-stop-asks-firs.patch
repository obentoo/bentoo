diff --git a/crates/agent_sandbox/src/operator_pause_tests.rs b/crates/agent_sandbox/src/operator_pause_tests.rs
new file mode 100644
index 0000000..2f89ef3
--- /dev/null
+++ b/crates/agent_sandbox/src/operator_pause_tests.rs
@@ -0,0 +1,99 @@
+// Operator ask of 2026-11-23: Pause freezes the jail and Resume goes on with nothing lost; the
+// kill switch stays the way to end it. Filter: `operator_pause`.
+use std::io;
+use std::path::PathBuf;
+
+use gpui::TestAppContext;
+use project::agent_server_store::AgentId;
+
+use crate::launch::{LaunchRecord, LaunchRegistry, MemoryPort, Reason};
+
+fn running(pid: Option<u32>) -> LaunchRecord {
+    LaunchRecord {
+        agent_id: AgentId::new("Test"),
+        project_root: PathBuf::from("/w/app"),
+        reason: Reason::On,
+        ai_jail_version: Some(semver::Version::parse("3.5.0").expect("version")),
+        ai_jail_path: None,
+        rw_maps: Vec::new(),
+        allow_hosts: Vec::new(),
+        forward_ports: Vec::new(),
+        memory_port: MemoryPort::Off,
+        settings_fingerprint: 0,
+        memory_fingerprint: 0,
+        settings_key: None,
+        jail_pid: pid,
+        paused: false,
+        claude_config_dir: None,
+        ai_jail_missing: false,
+    }
+}
+
+#[gpui::test]
+fn operator_pause_freezes_the_jail_and_marks_who_paused_it(cx: &mut TestAppContext) {
+    let id = cx.update(|cx| LaunchRegistry::register(running(Some(4242)), cx));
+    let mut frozen = Vec::new();
+    let result = cx.update(|cx| {
+        LaunchRegistry::pause_by_operator_with(id, cx, |pid| {
+            frozen.push(pid);
+            Ok(())
+        })
+    });
+    assert!(result.is_ok());
+    assert_eq!(
+        frozen,
+        vec![4242],
+        "the jail's own process is the one frozen"
+    );
+    let record = cx
+        .update(|cx| LaunchRegistry::launch(id, cx))
+        .expect("registered");
+    assert!(record.paused, "a paused jail shows as paused");
+    assert!(
+        cx.update(|cx| LaunchRegistry::paused_by_operator(id, cx)),
+        "and as paused by the operator, not by the disk quota"
+    );
+
+    cx.update(|cx| LaunchRegistry::set_paused(id, false, cx));
+    assert!(
+        !cx.update(|cx| LaunchRegistry::paused_by_operator(id, cx)),
+        "Resume clears who paused it"
+    );
+}
+
+/// Hostile: a freeze that fails leaves the jail running and says so; nothing claims a pause.
+#[gpui::test]
+fn operator_pause_that_cannot_freeze_does_not_mark_a_pause(cx: &mut TestAppContext) {
+    let id = cx.update(|cx| LaunchRegistry::register(running(Some(4242)), cx));
+    let result = cx.update(|cx| {
+        LaunchRegistry::pause_by_operator_with(id, cx, |_| {
+            Err(io::Error::new(io::ErrorKind::NotFound, "no ai-jail scope"))
+        })
+    });
+    assert!(result.is_err());
+    let record = cx
+        .update(|cx| LaunchRegistry::launch(id, cx))
+        .expect("registered");
+    assert!(!record.paused);
+    assert!(!cx.update(|cx| LaunchRegistry::paused_by_operator(id, cx)));
+}
+
+/// Hostile: a launch whose ai-jail process is not known yet has nothing to freeze.
+#[gpui::test]
+fn operator_pause_without_a_jail_process_freezes_nothing(cx: &mut TestAppContext) {
+    let id = cx.update(|cx| LaunchRegistry::register(running(None), cx));
+    let mut called = false;
+    let result = cx.update(|cx| {
+        LaunchRegistry::pause_by_operator_with(id, cx, |_| {
+            called = true;
+            Ok(())
+        })
+    });
+    assert!(result.is_err());
+    assert!(!called);
+    assert!(
+        !cx.update(|cx| LaunchRegistry::launch(id, cx))
+            .unwrap()
+            .paused
+    );
+}
