@@ -0,0 +1,88 @@
+// Operator ask of 2026-11-23: beside the lock of a running jail, Pause freezes it and Resume goes
+// on with nothing lost; Stop still ends it, now after a confirmation. Filter: `pause::`.
+use gpui::UpdateGlobal as _;
+use settings::SettingsStore;
+
+use super::*;
+
+/// The sandbox settings of now (the same helper as `icon::sandbox_settings`, which is private).
+fn sandbox_settings(value: serde_json::Value, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&value.to_string(), cx)
+                .result()
+                .expect("settings");
+        })
+    });
+}
+
+/// Above any pid_max the kernel allows (2^22), so no real process can ever be signalled here,
+/// even by a Stop that skipped its confirmation.
+const NO_SUCH_PID: u32 = 4_194_399;
+
+fn running_jail() -> LaunchRecord {
+    let mut record = record("/w/app", Reason::On, Some("3.5.0"));
+    record.jail_pid = Some(NO_SUCH_PID);
+    record
+}
+
+async fn jailed_window(cx: &mut TestAppContext) -> (Win, agent_sandbox::launch::LaunchId) {
+    let fs = init(cx);
+    sandbox_settings(json!({ "agent_sandbox": { "enabled": true } }), cx);
+    let id = cx.update(|cx| LaunchRegistry::register(running_jail(), cx));
+    let win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    (win, id)
+}
+
+#[gpui::test]
+async fn a_running_jail_offers_pause_beside_stop(cx: &mut TestAppContext) {
+    let (mut win, _) = jailed_window(cx).await;
+    assert!(
+        win.cx.debug_bounds("ICON-DebugPause").is_some(),
+        "Pause is drawn for a jail whose process runs"
+    );
+    assert!(win.cx.debug_bounds("ICON-Stop").is_some(), "Stop stays");
+}
+
+#[gpui::test]
+async fn an_operator_pause_reads_paused_and_offers_resume(cx: &mut TestAppContext) {
+    let (mut win, id) = jailed_window(cx).await;
+    win.cx
+        .update(|_, cx| LaunchRegistry::pause_by_operator_with(id, cx, |_| Ok(())))
+        .expect("the stub freeze succeeds");
+    win.cx.update(|window, _| window.refresh());
+    win.cx.run_until_parked();
+    assert!(
+        win.cx.debug_bounds("agent-jail-paused-operator").is_some(),
+        "the operator's pause says Paused, not the disk quota's label"
+    );
+    assert!(win.cx.debug_bounds("agent-jail-paused-disk").is_none());
+    assert!(
+        win.cx.debug_bounds("ICON-DebugPause").is_none(),
+        "a paused jail offers Resume, not Pause again"
+    );
+}
+
+/// Hostile: Stop ends everything in the jail, so a click only asks; Cancel leaves it running.
+#[gpui::test]
+async fn stop_asks_before_it_ends_the_jail(cx: &mut TestAppContext) {
+    let (mut win, id) = jailed_window(cx).await;
+    let stop = win.cx.debug_bounds("ICON-Stop").expect("Stop is drawn");
+    win.cx
+        .simulate_click(stop.center(), gpui::Modifiers::default());
+    win.cx.run_until_parked();
+    assert!(
+        win.cx.has_pending_prompt(),
+        "Stop asks for a confirmation first"
+    );
+    win.cx.simulate_prompt_answer("Cancel");
+    win.cx.run_until_parked();
+    assert!(
+        win.cx
+            .update(|_, cx| LaunchRegistry::launch(id, cx))
+            .is_some(),
+        "Cancel leaves the launch as it was"
+    );
+}
