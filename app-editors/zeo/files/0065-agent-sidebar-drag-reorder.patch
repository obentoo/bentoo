@@ -0,0 +1,2248 @@
+// Story 036 — drag to reorder projects, threads and pinned threads (tasks 3.1, 4.1, 5.1, 6.1,
+// 6.2, 6.3, 7.1). One file, one module per task:
+//   pure            task 3.1  reordered, project_steps, group_thread_ids, row_origin,
+//                             apply_manual_order, payload identity (no window)
+//   manual_order    task 4.1  manual_slots / sort_mode_of and hook 2 (Recent untouched, Manual
+//                             bands, activity ignored, new thread on top, restart, every window)
+//   project_drag    task 5.1  drop_project_header (steps, own header, per window, persisted)
+//   thread_drag     task 6.1  drop_thread_row for group rows (whole order, Manual, refusals)
+//   pinned_drag     task 6.2  drop_thread_row for pinned rows (index in the store's full order)
+//   drag_offer      task 6.3  thread_row_drag / project_header_drag with a real simulated pointer
+//                             (what can be dragged where, click vs drag)
+//   sort_by_recent  task 7.1  "Sort by Recent" menu entry and sort_project_by_recent
+//
+// Materialize as `crates/sidebar/src/sidebar_organization_tests.rs`, wired in `sidebar.rs` beside
+// `mod sidebar_pinned_tests;`:
+//     #[cfg(test)]
+//     mod sidebar_organization_tests;
+// Filter: `cargo test -p sidebar organization`.
+//
+// What the tests need from the code, beyond design.md's signatures:
+//   - The handlers this file calls directly — `drop_project_header`, `drop_thread_row`,
+//     `sort_project_by_recent` — live in `organization.rs`'s `impl Sidebar`, so they must be at
+//     least `pub(super)` (a private method of a child module is invisible to this sibling module).
+//     The payload structs' fields are `pub`, as design.md shows them.
+//   - `capture_logs` and `warn_lines` in `sidebar_pinned_tests.rs` become `pub(super)` (nothing
+//     else changes in them). They are imported, not copied: `log::set_boxed_logger` succeeds once
+//     per process, and a second copy of the capture would panic with "another logger is
+//     installed" in whichever file ran second.
+//
+// The store is installed with `agent_ui::thread_organization::init(cx)` BEFORE the sidebar is
+// created (the sidebar observes it from `Sidebar::new`); `init_test` gives every test its own
+// database, so orders never leak between tests.
+//
+// Drops are driven two ways. Most tests call the drop handler directly with a payload, as
+// `project_panel_tests.rs` `drag_entries_onto` does: that is the contract design.md names. The
+// `drag_offer` module drives a real pointer through `simulate_mouse_down/move/up`, so at least one
+// scenario per drag kind crosses the GPUI drag-and-drop boundary for real (on_drag, can_drop,
+// on_drop, the drag threshold) — what a direct call cannot prove.
+//
+// Hostile halves come first in every identity rule:
+//   - activity after a drag must NOT reorder a Manual project, while the same activity DOES reorder
+//     a Recent one (the converse, proving the activity fixture is real);
+//   - a new thread lands ABOVE the slotted ones even when its timestamp is older than all of them;
+//   - "Sort by Recent" on alpha leaves beta Manual with its slots;
+//   - a drop on another group's row, a pinned row, a header or a stale index is a no-op;
+//   - the pinned index is taken in the store's FULL pinned order, with an archived (hidden) pin in
+//     the way, in the direction where the visible index would give a different answer;
+//   - moving down places after the target, moving up places before it;
+//   - a drop on the own row changes neither the order nor the MODE (a Recent project stays
+//     Recent: re-recording the current order would wrongly flip it to Manual);
+//   - one thread produces two DIFFERENT origins (group row vs pinned row), while two keys built
+//     from the same path are the SAME origin; and a project whose folder is named "Pinned" is a
+//     group, never the Pinned section (a third element colliding with a derived value);
+//   - refusal warnings carry a count or an id, never a thread title or a folder path.
+//
+// Known gaps, reported rather than faked:
+//   - R3.6: `ThreadOrganizationStore::set_sort_mode` has no `Err` path at series tip d945c3b, so
+//     a refused "Sort by Recent" cannot be produced through the real store.
+//   - R1.7: a group that leaves the window between steps cannot be produced from outside one
+//     synchronous `multi_workspace.update`; the reachable half (the dragged group already gone)
+//     is asserted to change nothing and to log no path.
+//   - R1.3, R2.9, R4.3 (the edge highlight) and R1.8 (no drag from the sticky header) are render
+//     details with no observable state; the same-origin `can_drop` gate behind R2.9 is covered by
+//     the foreign-drop tests.
+
+use super::*;
+use crate::sidebar_pinned_tests::{capture_logs, warn_lines};
+use crate::sidebar_tests::{
+    init_test, init_test_project_with_agent_panel, setup_sidebar, setup_sidebar_with_agent_panel,
+    type_in_search, visible_entries_as_strings,
+};
+use agent_ui::thread_organization::{ProjectKey, SortMode, ThreadOrganizationStore};
+use fs::FakeFs;
+use gpui::{Bounds, MouseButton, Point, TestAppContext, VisualTestContext, point};
+use organization::{DraggedProjectHeader, DraggedThreadRow, RowOrigin};
+
+const ALPHA: &str = "/alpha";
+const BETA: &str = "/beta";
+const GAMMA: &str = "/gamma";
+/// Never opened in any window: a group key that is not in the window.
+const DELTA: &str = "/delta";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// Sidebar test globals, a FakeFs with every project folder and, when `with_store`, the
+/// organization store. Returns the fs and a project for `ALPHA`.
+async fn init_org_test(
+    with_store: bool,
+    cx: &mut TestAppContext,
+) -> (Arc<FakeFs>, Entity<project::Project>) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    for path in [ALPHA, BETA, GAMMA, DELTA] {
+        fs.insert_tree(path, serde_json::json!({ "src": {} })).await;
+    }
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        if with_store {
+            agent_ui::thread_organization::init(cx);
+        }
+    });
+    cx.run_until_parked();
+    let project = project::Project::test(fs.clone(), [ALPHA.as_ref()], cx).await;
+    (fs, project)
+}
+
+/// A window on `ALPHA` with its sidebar open, the organization store installed.
+async fn alpha_window(
+    cx: &mut TestAppContext,
+) -> (
+    Arc<FakeFs>,
+    Entity<MultiWorkspace>,
+    Entity<Sidebar>,
+    &mut VisualTestContext,
+) {
+    let (fs, project) = init_org_test(true, cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+    (fs, multi_workspace, sidebar, cx)
+}
+
+/// Opens `path` as another project group of this window.
+async fn open_in_window(
+    path: &str,
+    fs: &Arc<FakeFs>,
+    multi_workspace: &Entity<MultiWorkspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<Workspace> {
+    let project = project::Project::test(fs.clone() as Arc<dyn fs::Fs>, [path.as_ref()], cx).await;
+    let workspace = multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.test_add_workspace(project, window, cx)
+    });
+    cx.run_until_parked();
+    workspace
+}
+
+fn at(hour: u32) -> DateTime<Utc> {
+    chrono::TimeZone::with_ymd_and_hms(&Utc, 2024, 1, 1, hour, 0, 0).unwrap()
+}
+
+fn local_key(path: &str) -> ProjectGroupKey {
+    ProjectGroupKey::new(None, PathList::new(&[PathBuf::from(path)]))
+}
+
+fn find_thread_id(session_id: &acp::SessionId, cx: &mut VisualTestContext) -> Option<ThreadId> {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|entry| entry.session_id.as_ref() == Some(session_id))
+            .map(|entry| entry.thread_id)
+    })
+}
+
+fn metadata_for(
+    thread_id: ThreadId,
+    session_id: Option<acp::SessionId>,
+    title: &str,
+    folder: &str,
+    created: Option<u32>,
+    updated: u32,
+) -> ThreadMetadata {
+    let paths = PathList::new(&[PathBuf::from(folder)]);
+    ThreadMetadata {
+        thread_id,
+        session_id,
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: Some(SharedString::from(title.to_string())),
+        title_override: None,
+        updated_at: at(updated),
+        created_at: created.map(at),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_path_lists(paths.clone(), paths)
+            .expect("fixture: one folder is a valid worktree path list"),
+        archived: false,
+        remote_connection: None,
+    }
+}
+
+fn store_metadata(metadata: ThreadMetadata, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+}
+
+/// Saves (or re-saves, keeping its id) a thread with a sent message in the local project
+/// `folder`. `updated` is the last activity; `created` is the creation time (`None` like a legacy
+/// row, which falls back to `updated`).
+fn save_thread(
+    session: &str,
+    title: &str,
+    folder: &str,
+    created: Option<u32>,
+    updated: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    let session_id = acp::SessionId::new(Arc::from(session));
+    let thread_id = find_thread_id(&session_id, cx).unwrap_or_else(ThreadId::new);
+    store_metadata(
+        metadata_for(thread_id, Some(session_id), title, folder, created, updated),
+        cx,
+    );
+    thread_id
+}
+
+/// A thread created at `hour` and last active at `hour`.
+fn save_in(
+    session: &str,
+    title: &str,
+    folder: &str,
+    hour: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    save_thread(session, title, folder, Some(hour), hour, cx)
+}
+
+/// Activity on a thread, the way the sidebar records a sent message.
+fn touch(thread_id: ThreadId, hour: u32, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.update_interacted_at(&thread_id, at(hour), cx)
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn archive(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(thread_id, None, cx))
+    });
+    cx.run_until_parked();
+}
+
+// ── The store, read and seeded directly ────────────────────────────────────
+
+fn mode(path: &str, cx: &mut VisualTestContext) -> SortMode {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .sort_mode(&ProjectKey::from_group(&local_key(path)))
+    })
+}
+
+fn slot(thread_id: ThreadId, path: &str, cx: &mut VisualTestContext) -> Option<u32> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .manual_position_in(thread_id, &ProjectKey::from_group(&local_key(path)))
+    })
+}
+
+/// Seeds a Manual order straight into the store (a fixture, not the code under test).
+fn record_order(path: &str, order: &[ThreadId], cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store.set_manual_order(ProjectKey::from_group(&local_key(path)), order, cx)
+        })
+    })
+    .expect("fixture: the store accepts an order of known threads with a message");
+    cx.run_until_parked();
+}
+
+fn store_pin(thread_id: ThreadId, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.pin(thread_id, cx))
+    })
+    .expect("fixture: the store accepts a pin of a known thread with a message");
+    cx.run_until_parked();
+}
+
+fn stored_pins(cx: &mut VisualTestContext) -> Vec<ThreadId> {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .pinned()
+            .collect()
+    })
+}
+
+// ── Reading the sidebar ────────────────────────────────────────────────────
+
+/// `visible_entries_as_strings`, with a pinned row written "  {title} · {project label}" so it
+/// can never be confused with the thread's group row.
+fn lines(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    let base = visible_entries_as_strings(sidebar, cx);
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .zip(base)
+            .map(|(entry, line)| match entry {
+                ListEntry::Thread(thread) => match &thread.pinned_project_label {
+                    Some(label) => format!("  {} · {label}", thread.metadata.display_title()),
+                    None => line,
+                },
+                _ => line,
+            })
+            .collect()
+    })
+}
+
+/// The header lines only, in screen order.
+fn headers(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<String> {
+    lines(sidebar, cx)
+        .into_iter()
+        .filter(|line| line.starts_with("v [") || line.starts_with("> ["))
+        .collect()
+}
+
+/// The window's project order as upstream stores it.
+fn window_order(
+    multi_workspace: &Entity<MultiWorkspace>,
+    cx: &mut VisualTestContext,
+) -> Vec<String> {
+    multi_workspace.read_with(cx, |mw, _| {
+        mw.project_group_keys()
+            .iter()
+            .map(|key| {
+                key.path_list()
+                    .paths()
+                    .iter()
+                    .map(|path| path.to_string_lossy().into_owned())
+                    .collect::<Vec<_>>()
