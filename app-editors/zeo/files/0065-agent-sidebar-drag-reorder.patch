+/// Drops the group row of `dragged` (payload origin: its own group, `path`) on entry `target_ix`.
+fn drop_group_row(
+    sidebar: &Entity<Sidebar>,
+    dragged: ThreadId,
+    path: &str,
+    target_ix: usize,
+    cx: &mut VisualTestContext,
+) {
+    let from_ix = group_row_ix(sidebar, dragged, cx);
+    let payload = DraggedThreadRow {
+        thread_id: dragged,
+        origin: RowOrigin::Group(local_key(path)),
+        title: "dragged".into(),
+        from_ix,
+    };
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.drop_thread_row(&payload, target_ix, cx)
+    });
+    cx.run_until_parked();
+}
+
+/// Drops the pinned row of `dragged` on entry `target_ix`.
+fn drop_pinned_row(
+    sidebar: &Entity<Sidebar>,
+    dragged: ThreadId,
+    from_ix: usize,
+    target_ix: usize,
+    cx: &mut VisualTestContext,
+) {
+    let payload = DraggedThreadRow {
+        thread_id: dragged,
+        origin: RowOrigin::Pinned,
+        title: "dragged".into(),
+        from_ix,
+    };
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.drop_thread_row(&payload, target_ix, cx)
+    });
+    cx.run_until_parked();
+}
+
+/// Drops the header of `dragged` on the header of `target`.
+fn drop_header(sidebar: &Entity<Sidebar>, dragged: &str, target: &str, cx: &mut VisualTestContext) {
+    let from_ix = sidebar.read_with(cx, |sidebar, _| {
+        let key = local_key(dragged);
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| matches!(entry, ListEntry::ProjectHeader { key: k, .. } if *k == key))
+            .unwrap_or(0)
+    });
+    let payload = DraggedProjectHeader {
+        key: local_key(dragged),
+        label: dragged.trim_start_matches('/').to_string().into(),
+        from_ix,
+    };
+    let target = local_key(target);
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.drop_project_header(&payload, &target, cx)
+    });
+    cx.run_until_parked();
+}
