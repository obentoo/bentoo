+
+/// The bounds of entry `ix`, after a frame of the window.
+fn entry_bounds(
+    sidebar: &Entity<Sidebar>,
+    ix: usize,
+    cx: &mut VisualTestContext,
+) -> Bounds<Pixels> {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .list_state
+            .bounds_for_item(ix)
+            .expect("the entry is rendered")
+    })
+}
+
+/// Press at `from`, move 6 px (past GPUI's 2 px drag threshold) with the button held, glide to
+/// `to`, release there. Returns whether a drag was active after the first move.
+fn pointer_drag(from: Point<Pixels>, to: Point<Pixels>, cx: &mut VisualTestContext) -> bool {
+    cx.simulate_mouse_down(from, MouseButton::Left, Modifiers::none());
+    cx.simulate_mouse_move(
+        point(from.x, from.y + px(6.)),
+        MouseButton::Left,
+        Modifiers::none(),
+    );
+    let started = cx.update(|_, cx| cx.has_active_drag());
+    let middle = point((from.x + to.x) / 2., (from.y + to.y) / 2.);
+    cx.simulate_mouse_move(middle, MouseButton::Left, Modifiers::none());
+    cx.simulate_mouse_move(to, MouseButton::Left, Modifiers::none());
+    cx.simulate_mouse_up(to, MouseButton::Left, Modifiers::none());
+    cx.run_until_parked();
+    started
+}
+
+/// Press at `from` and move past the threshold, then release where it started; returns whether a
+/// drag started. Used where only "is a drag offered here" is asked.
+fn drag_starts_at(from: Point<Pixels>, cx: &mut VisualTestContext) -> bool {
+    pointer_drag(from, from, cx)
+}
+
+fn right_click(position: Point<Pixels>, cx: &mut VisualTestContext) {
+    cx.simulate_mouse_down(position, MouseButton::Right, Modifiers::none());
+    cx.simulate_mouse_up(position, MouseButton::Right, Modifiers::none());
+    cx.run_until_parked();
+}
