+    // ── reordered (R2.3, R2.10, R4.2) ──────────────────────────────────────
+
+    #[test]
+    fn reordered_refuses_the_own_row_and_missing_ids() {
+        let [a, b, c] = [ThreadId::new(), ThreadId::new(), ThreadId::new()];
+        let ids = [a, b, c];
+        // Hostile first: the own row must be None, never Some(the same order), or the caller
+        // would record it and flip a Recent project to Manual (R2.10).
+        assert_eq!(
+            reordered(&ids, b, b),
+            None,
+            "a drop on the own row is no move"
+        );
+        assert_eq!(
+            reordered(&ids, ThreadId::new(), b),
+            None,
+            "dragged id not in the group"
+        );
+        assert_eq!(
+            reordered(&ids, a, ThreadId::new()),
+            None,
+            "target id not in the group"
+        );
+        assert_eq!(reordered(&[], a, b), None, "an empty group");
+    }
+
+    #[test]
+    fn reordered_places_after_when_moving_down_and_before_when_moving_up() {
+        let [a, b, c, d] = [
+            ThreadId::new(),
+            ThreadId::new(),
+            ThreadId::new(),
+            ThreadId::new(),
+        ];
+        let ids = [a, b, c, d];
+        assert_eq!(
+            reordered(&ids, a, c),
+            Some(vec![b, c, a, d]),
+            "down: right after"
+        );
+        assert_eq!(
+            reordered(&ids, d, b),
+            Some(vec![a, d, b, c]),
+            "up: right before"
+        );
+        // The two converse adjacent moves reach the same order from opposite sides.
+        assert_eq!(
+            reordered(&ids, a, b),
+            Some(vec![b, a, c, d]),
+            "adjacent down"
+        );
+        assert_eq!(reordered(&ids, b, a), Some(vec![b, a, c, d]), "adjacent up");
+        assert_eq!(
+            reordered(&ids, a, d),
+            Some(vec![b, c, d, a]),
+            "first onto last"
+        );
+        assert_eq!(
+            reordered(&ids, d, a),
+            Some(vec![d, a, b, c]),
+            "last onto first"
+        );
+    }
+
+    #[test]
+    fn reordered_is_a_permutation_for_every_pair() {
+        let ids: Vec<ThreadId> = (0..5).map(|_| ThreadId::new()).collect();
+        for &dragged in &ids {
+            for &target in &ids {
+                let Some(order) = reordered(&ids, dragged, target) else {
+                    assert_eq!(dragged, target, "only the own row yields None");
+                    continue;
+                };
+                assert_eq!(order.len(), ids.len(), "no thread is lost or duplicated");
+                for id in &ids {
+                    assert_eq!(order.iter().filter(|x| *x == id).count(), 1);
+                }
+                let at_target = order.iter().position(|x| *x == target);
+                let at_dragged = order.iter().position(|x| *x == dragged);
+                let was_above =
+                    ids.iter().position(|x| *x == dragged) < ids.iter().position(|x| *x == target);
+                if was_above {
+                    assert_eq!(at_dragged, at_target.map(|t| t + 1), "moved down: after");
+                } else {
+                    assert_eq!(at_dragged.map(|d| d + 1), at_target, "moved up: before");
+                }
+            }
+        }
+    }
