+++ b/crates/sidebar/src/organization.rs
@@ -0,0 +1,523 @@
+//! Drag to reorder projects, threads and pinned threads.
+//!
+//! New organization UI lives here; `sidebar.rs` only calls into it through one-line hooks.
+
+use std::cmp::Reverse;
+use std::collections::HashMap;
+
+use agent_ui::ThreadId;
+use agent_ui::thread_organization::{ProjectKey, SortMode, ThreadOrganizationStore};
+use chrono::{DateTime, Utc};
+use gpui::{DismissEvent, Div, Stateful, StyleRefinement, WeakEntity};
+use ui::ContextMenu;
+use ui::prelude::*;
+use workspace::ProjectGroupKey;
+
+use crate::{DraftKind, ListEntry, Sidebar, ThreadEntry};
+
+/// What a dropped project header carries. `from_ix` only picks the highlight edge: a drop
+/// resolves keys against the window's order at drop time, since a rebuild can shift indices.
+#[derive(Clone)]
+pub(crate) struct DraggedProjectHeader {
+    pub key: ProjectGroupKey,
+    pub label: SharedString,
+    pub from_ix: usize,
+}
+
+/// Where a thread row sits. A thread's group row and its pinned row have different origins,
+/// which is what keeps a drag inside its own list.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum RowOrigin {
+    Group(ProjectGroupKey),
+    Pinned,
+}
+
+/// What a dropped thread row carries. `from_ix` only picks the highlight edge: a drop resolves
+/// ids against the entries at drop time, since a rebuild can shift indices.
+#[derive(Clone)]
+pub(crate) struct DraggedThreadRow {
+    pub thread_id: ThreadId,
+    pub origin: RowOrigin,
+    pub title: SharedString,
+    pub from_ix: usize,
+}
+
+/// The floating preview while dragging: one muted label, like a dragged tab.
+pub(crate) struct DragPreview {
+    label: SharedString,
+}
+
+impl Render for DragPreview {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors();
+        div()
+            .px_2()
+            .py_1()
+            .rounded_sm()
+            .border_1()
+            .border_color(colors.border)
+            .bg(colors.elevated_surface_background)
+            .child(
+                Label::new(self.label.clone())
+                    .size(LabelSize::Small)
+                    .color(Color::Muted),
+            )
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum StepDirection {
+    Up,
+    Down,
+}
+
+/// The drop-target highlight of a vertical list: the background, plus a 2px border on the
+/// side where the dragged item will land (below the target when it moves down, above it when
+/// it moves up).
+pub(crate) fn drop_edge(
+    style: StyleRefinement,
+    ix: usize,
+    from_ix: usize,
+    cx: &App,
+) -> StyleRefinement {
+    let colors = cx.theme().colors();
+    let style = style
+        .bg(colors.drop_target_background)
+        .border_color(colors.drop_target_border)
+        .border_0();
+    if ix > from_ix {
+        style.border_b_2()
+    } else if ix < from_ix {
+        style.border_t_2()
+    } else {
+        style
+    }
+}
+
+/// `ids` with `dragged` moved onto `target`: right after it when moving down, right before it
+/// when moving up. `None` when the move would change nothing or either id is not in `ids`, so a
+/// caller never re-records an unchanged order.
+pub(crate) fn reordered(
+    ids: &[ThreadId],
+    dragged: ThreadId,
+    target: ThreadId,
+) -> Option<Vec<ThreadId>> {
+    if dragged == target {
+        return None;
+    }
+    let from = ids.iter().position(|id| *id == dragged)?;
+    let to = ids.iter().position(|id| *id == target)?;
+    let mut order = ids.to_vec();
+    let moved = order.remove(from);
+    // After the removal, inserting at the target's former index lands after the target when
+    // it was below `dragged` (it shifted up by one) and before it when it was above.
+    order.insert(to, moved);
+    Some(order)
+}
+
+/// The direction and number of single swaps that bring `dragged` to `target`'s former index.
+/// `None` when they are the same key or either is not in `keys`.
+pub(crate) fn project_steps(
+    keys: &[ProjectGroupKey],
+    dragged: &ProjectGroupKey,
+    target: &ProjectGroupKey,
+) -> Option<(StepDirection, usize)> {
+    let from = keys.iter().position(|key| key == dragged)?;
+    let to = keys.iter().position(|key| key == target)?;
+    if to > from {
+        Some((StepDirection::Down, to - from))
+    } else if to < from {
+        Some((StepDirection::Up, from - to))
+    } else {
+        None
+    }
+}
+
+/// The ids of the thread rows of the group that entry `ix` belongs to, in screen order. Drafts
+/// are skipped (the store refuses them) and so are terminals (they have no `ThreadId`). Empty
+/// in the Pinned section and for a stale index.
+pub(crate) fn group_thread_ids(entries: &[ListEntry], ix: usize) -> Vec<ThreadId> {
+    let Some(header_ix) = nearest_header(entries, ix) else {
+        return Vec::new();
+    };
+    let Some(ListEntry::ProjectHeader { .. }) = entries.get(header_ix) else {
+        return Vec::new();
+    };
+    entries
+        .iter()
+        .skip(header_ix + 1)
+        .take_while(|entry| !is_header(entry))
+        .filter_map(|entry| match entry {
+            ListEntry::Thread(thread) if thread.draft.is_none() && !thread.metadata.is_draft() => {
+                Some(thread.metadata.thread_id)
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+/// The origin of entry `ix`: the group of the nearest project header above it, or the Pinned
+/// section. `None` for a stale index.
+pub(crate) fn row_origin(entries: &[ListEntry], ix: usize) -> Option<RowOrigin> {
+    match entries.get(nearest_header(entries, ix)?)? {
+        ListEntry::ProjectHeader { key, .. } => Some(RowOrigin::Group(key.clone())),
+        ListEntry::PinnedHeader { .. } => Some(RowOrigin::Pinned),
+        ListEntry::Thread(_) | ListEntry::Terminal(_) => None,
+    }
+}
+
+/// Each given thread's recorded place in the project of `key`. `None` without the store or when
+/// the project is in Recent mode, so a Recent project keeps exactly the upstream sort. The ids
+/// come from the caller because the store does not list a project's threads. Read only.
+pub(crate) fn manual_slots(
+    key: &ProjectGroupKey,
+    thread_ids: &[ThreadId],
+    cx: &App,
+) -> Option<HashMap<ThreadId, u32>> {
+    let store = ThreadOrganizationStore::try_global(cx)?;
+    let store = store.read(cx);
+    let project = ProjectKey::from_group(key);
+    if store.sort_mode(&project) != SortMode::Manual {
+        return None;
+    }
+    Some(
+        thread_ids
+            .iter()
+            .filter_map(|&thread_id| {
+                let slot = store.manual_position_in(thread_id, &project)?;
+                Some((thread_id, slot))
+            })
+            .collect(),
+    )
+}
+
+/// Re-sorts one group's rows into its recorded order when the project is in Manual mode; a
+/// Recent project, or no store, leaves the upstream sort untouched.
+pub(crate) fn order_manually(rows: &mut Vec<ListEntry>, key: &ProjectGroupKey, cx: &App) {
+    let thread_ids: Vec<ThreadId> = rows
+        .iter()
+        .filter_map(|entry| match entry {
+            ListEntry::Thread(thread) => Some(thread.metadata.thread_id),
+            _ => None,
+        })
+        .collect();
+    if let Some(slots) = manual_slots(key, &thread_ids, cx) {
+        apply_manual_order(rows, &slots);
+    }
+}
+
+/// The project's sort mode; `None` without the store.
+pub(crate) fn sort_mode_of(key: &ProjectGroupKey, cx: &App) -> Option<SortMode> {
+    let store = ThreadOrganizationStore::try_global(cx)?;
+    Some(store.read(cx).sort_mode(&ProjectKey::from_group(key)))
+}
+
+/// Re-sorts one group's rows for a Manual project, stably, into three bands: empty drafts; rows
+/// with no slot (drafts with text, threads new since the last drag, terminals), newest created
+/// first; then slotted threads by slot. Activity (`interacted_at`) is never read, so using a
+/// thread does not move it.
+pub(crate) fn apply_manual_order(rows: &mut Vec<ListEntry>, slots: &HashMap<ThreadId, u32>) {
+    rows.sort_by_cached_key(|row| manual_key(row, slots));
+}
+
+/// Variant order is band order; within a band the field orders.
+#[derive(PartialEq, Eq, PartialOrd, Ord)]
+enum ManualKey {
+    /// Not expected among one group's rows; kept first and in place rather than panicking.
+    Header,
+    EmptyDraft,
+    Unplaced(Reverse<DateTime<Utc>>),
+    Placed(u32),
+}
+
+fn manual_key(row: &ListEntry, slots: &HashMap<ThreadId, u32>) -> ManualKey {
+    match row {
+        ListEntry::Thread(thread) if thread.draft == Some(DraftKind::Empty) => {
+            ManualKey::EmptyDraft
+        }
+        ListEntry::Thread(thread) => {
+            let slot = match thread.draft {
+                Some(_) => None,
+                None => slots.get(&thread.metadata.thread_id).copied(),
+            };
+            match slot {
+                Some(slot) => ManualKey::Placed(slot),
+                None => ManualKey::Unplaced(Reverse(
+                    thread
+                        .metadata
+                        .created_at
+                        .unwrap_or(thread.metadata.updated_at),
+                )),
+            }
+        }
+        ListEntry::Terminal(terminal) => ManualKey::Unplaced(Reverse(terminal.metadata.created_at)),
+        ListEntry::ProjectHeader { .. } | ListEntry::PinnedHeader { .. } => ManualKey::Header,
+    }
+}
+
+fn is_header(entry: &ListEntry) -> bool {
+    matches!(
+        entry,
+        ListEntry::ProjectHeader { .. } | ListEntry::PinnedHeader { .. }
+    )
+}
+
+/// The index of the nearest header at or before `ix`, or `None` when `ix` is stale or no
+/// header precedes it.
+fn nearest_header(entries: &[ListEntry], ix: usize) -> Option<usize> {
+    entries.get(..=ix)?.iter().rposition(is_header)
+}
+
+impl Sidebar {
+    /// Moves the dragged project to the target header's former place in this window, one
+    /// upstream swap per step, so the order is emitted, persisted per window and notified exactly
+    /// as "Move Up"/"Move Down" do. Keys are resolved against the window's order at drop time.
+    /// Logs never name a folder.
+    pub(super) fn drop_project_header(
+        &mut self,
+        dragged: &DraggedProjectHeader,
+        target: &ProjectGroupKey,
+        cx: &mut Context<Self>,
+    ) {
+        let from_ix = dragged.from_ix;
+        let keys = match self.multi_workspace.read_with(cx, |multi_workspace, _| {
+            multi_workspace.project_group_keys()
+        }) {
+            Ok(keys) => keys,
+            Err(error) => {
+                log::warn!(
+                    "sidebar: project drop ignored, window is gone (from {from_ix}): {error}"
+                );
+                return;
+            }
+        };
+        let position = |key: &ProjectGroupKey| keys.iter().position(|k| k == key);
+        let (Some(from), Some(to)) = (position(&dragged.key), position(target)) else {
+            log::warn!("sidebar: project drop ignored, group no longer in window (from {from_ix})");
+            return;
+        };
+        // `None` here means the own header: nothing to move.
+        let Some((direction, steps)) = project_steps(&keys, &dragged.key, target) else {
+            return;
+        };
+        let key = dragged.key.clone();
+        let stopped_at = self.multi_workspace.update(cx, |multi_workspace, cx| {
+            (1..=steps).find(|_| {
+                let moved = match direction {
+                    StepDirection::Up => multi_workspace.move_project_group_up(&key, cx),
+                    StepDirection::Down => multi_workspace.move_project_group_down(&key, cx),
+                };
+                !moved
+            })
+        });
+        match stopped_at {
+            Ok(None) => {}
+            Ok(Some(step)) => log::warn!(
+                "sidebar: project move stopped at step {step} of {steps} (from {from} to {to})"
+            ),
+            Err(error) => {
+                log::warn!(
+                    "sidebar: project drop ignored, window is gone (from {from_ix}): {error}"
+                )
+            }
+        }
+    }
+
+    /// Moves the dragged thread row onto entry `target_ix` of its own list. The target is
+    /// resolved against the entries at drop time, since a rebuild can shift indices: a target
+    /// that is no longer a thread row of the dragged row's origin changes nothing. Called from
+    /// the drop listener only, outside any `ThreadMetadataStore` update.
+    pub(super) fn drop_thread_row(
+        &mut self,
+        dragged: &DraggedThreadRow,
+        target_ix: usize,
+        cx: &mut Context<Self>,
+    ) {
+        // A filtered list shows part of the order, and recording it would drop every hidden
+        // thread's place. The drag-offer gate is not enough: text typed mid-drag gets past it.
+        if self.has_filter_query(cx) {
+            return;
+        }
+        // Without the store no drag is offered, so there is nothing to report.
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let Some(ListEntry::Thread(target)) = self.contents.entries.get(target_ix) else {
+            return;
+        };
+        if row_origin(&self.contents.entries, target_ix).as_ref() != Some(&dragged.origin) {
+            return;
+        }
+        let target_id = target.metadata.thread_id;
+        match &dragged.origin {
+            RowOrigin::Group(key) => {
+                let ids = group_thread_ids(&self.contents.entries, target_ix);
+                let Some(order) = reordered(&ids, dragged.thread_id, target_id) else {
+                    return;
+                };
+                // The whole group as shown: a thread left out of the order loses its place.
+                let result = store.update(cx, |store, cx| {
+                    store.set_manual_order(ProjectKey::from_group(key), &order, cx)
+                });
+                if let Err(error) = result {
+                    log::warn!(
+                        "sidebar: manual order refused for {} threads: {error}",
+                        order.len()
+                    );
+                    // The rows on screen disagree with the stores; show the stores' truth again.
+                    self.schedule_update_entries(false, cx);
+                }
+            }
+            RowOrigin::Pinned => {
+                if dragged.thread_id == target_id {
+                    return;
+                }
+                // The section hides archived, draft and unknown pins, so an index among the
+                // visible rows would land off by one next to a hidden pin.
+                let Some(to_index) = store
+                    .read(cx)
+                    .pinned()
+                    .position(|pinned| pinned == target_id)
+                else {
+                    // Unpinned elsewhere during the drag: no other index is the user's intent.
+                    return;
+                };
+                let result = store.update(cx, |store, cx| {
+                    store.move_pinned(dragged.thread_id, to_index, cx)
+                });
+                if let Err(error) = result {
+                    log::warn!(
+                        "sidebar: pinned move refused for thread {}: {error}",
+                        dragged.thread_id.to_key_string()
+                    );
+                }
+            }
+        }
+    }
+
+    /// Makes a thread row of a project group or of the Pinned section a drag source and a drop
+    /// target for rows of the same list. The row is returned unchanged without the store (no
+    /// drag, R2.12) and while filtering (a partial list cannot be reordered, R5.1). A new wrapper
+    /// carries the drag, since `on_drag` may be called only once per element. Drafts and
+    /// terminals never reach this hook (R5.2).
+    pub(crate) fn thread_row_drag(
+        &self,
+        row: AnyElement,
+        ix: usize,
+        thread: &ThreadEntry,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        if ThreadOrganizationStore::try_global(cx).is_none() || self.has_filter_query(cx) {
+            return row;
+        }
+        let Some(origin) = row_origin(&self.contents.entries, ix) else {
+            return row;
+        };
+        let payload = DraggedThreadRow {
+            thread_id: thread.metadata.thread_id,
+            origin: origin.clone(),
+            title: thread.metadata.display_title(),
+            from_ix: ix,
+        };
+        div()
+            .id(("thread-drag", ix))
+            .child(row)
+            .on_drag(payload, |dragged, _, _, cx| {
+                cx.new(|_| DragPreview {
+                    label: dragged.title.clone(),
+                })
+            })
+            // Gates both the highlight and the drop: a row of another list is no target.
+            .can_drop(move |value, _, _| {
+                value
+                    .downcast_ref::<DraggedThreadRow>()
+                    .is_some_and(|dragged| dragged.origin == origin)
+            })
+            .drag_over::<DraggedThreadRow>(move |style, dragged, _, cx| {
+                drop_edge(style, ix, dragged.from_ix, cx)
+            })
+            .on_drop(cx.listener(move |this, dragged: &DraggedThreadRow, _, cx| {
+                this.drop_thread_row(dragged, ix, cx)
+            }))
+            .into_any_element()
+    }
+
+    /// Makes a list header a drag source and a drop target for other project headers. The
+    /// sticky copy at the top is left alone, so each group has one drag source. The drop is
+    /// typed: a dragged thread row finds no listener on a header.
+    pub(crate) fn project_header_drag(
+        &self,
+        header: Stateful<Div>,
+        ix: usize,
+        is_sticky: bool,
+        key: &ProjectGroupKey,
+        cx: &mut Context<Self>,
+    ) -> Stateful<Div> {
+        if is_sticky {
+            return header;
+        }
+        // The rendered header shadows its label parameter, so the label is read from the entry.
+        let Some(ListEntry::ProjectHeader { label, .. }) = self.contents.entries.get(ix) else {
+            return header;
+        };
+        let payload = DraggedProjectHeader {
+            key: key.clone(),
+            label: label.clone(),
+            from_ix: ix,
+        };
+        let target = key.clone();
+        header
+            .on_drag(payload, |dragged, _, _, cx| {
+                cx.new(|_| DragPreview {
+                    label: dragged.label.clone(),
+                })
+            })
+            .drag_over::<DraggedProjectHeader>(move |style, dragged, _, cx| {
+                drop_edge(style, ix, dragged.from_ix, cx)
+            })
+            .on_drop(
+                cx.listener(move |this, dragged: &DraggedProjectHeader, _, cx| {
+                    this.drop_project_header(dragged, &target, cx)
+                }),
+            )
+    }
+}
+
+/// Adds "Sort by Recent" to a project header menu, only for a Manual project. Called from the
+/// menu's builder, so the mode is read when the menu opens rather than when the sidebar rendered.
+pub(crate) fn sort_by_recent_entry(
+    menu: ContextMenu,
+    sidebar: WeakEntity<Sidebar>,
+    key: ProjectGroupKey,
+    weak_menu: WeakEntity<ContextMenu>,
+    cx: &App,
+) -> ContextMenu {
+    if sort_mode_of(&key, cx) != Some(SortMode::Manual) {
+        return menu;
+    }
+    menu.separator()
+        .entry("Sort by Recent", None, move |_window, cx| {
+            if let Err(error) =
+                sidebar.update(cx, |sidebar, cx| sidebar.sort_project_by_recent(&key, cx))
+            {
+                log::warn!("sidebar: sort by recent ignored, sidebar is gone: {error}");
+            }
+            weak_menu.update(cx, |_, cx| cx.emit(DismissEvent)).ok();
+        })
+}
+
+impl Sidebar {
+    /// Returns one project to most-recent-first, discarding only its recorded thread places.
+    /// On a project already in Recent mode the store writes nothing. Logs never name a folder.
+    pub(super) fn sort_project_by_recent(&mut self, key: &ProjectGroupKey, cx: &mut Context<Self>) {
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let result = store.update(cx, |store, cx| {
+            store.set_sort_mode(ProjectKey::from_group(key), SortMode::Recent, cx)
+        });
+        if let Err(error) = result {
+            log::warn!("sidebar: sort by recent refused: {error}");
+        }
+    }
+}
