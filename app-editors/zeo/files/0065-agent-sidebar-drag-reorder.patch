+        cx: &mut TestAppContext,
+    ) -> (
+        Entity<Sidebar>,
+        [ThreadId; 3],
+        [ThreadId; 2],
+        &mut VisualTestContext,
+    ) {
+        let (fs, mw, sidebar, cx) = alpha_window(cx).await;
+        open_in_window(BETA, &fs, &mw, cx).await;
+        let newest = save_in("n", "Newest", ALPHA, 3, cx);
+        let middle = save_in("m", "Middle", ALPHA, 2, cx);
+        let oldest = save_in("o", "Oldest", ALPHA, 1, cx);
+        let b_new = save_in("bn", "B new", BETA, 3, cx);
+        let b_old = save_in("bo", "B old", BETA, 1, cx);
+        (sidebar, [newest, middle, oldest], [b_new, b_old], cx)
+    }
+
+    fn open_header_menu(sidebar: &Entity<Sidebar>, path: &str, cx: &mut VisualTestContext) {
+        let ix = header_ix(sidebar, path, cx);
+        right_click(entry_bounds(sidebar, ix, cx).center(), cx);
+        cx.debug_bounds("MENU_ITEM-Remove")
+            .expect("fixture: the project header menu is open");
+    }
+
+    fn close_menu(cx: &mut VisualTestContext) {
+        // A test window never runs the next frame that focuses the menu, so "escape" cannot
+        // reach it; a click outside dismisses it through its mouse-down-out handler instead.
+        let size = cx.update(|window, _| window.viewport_size());
+        let outside = point(size.width - px(2.), size.height - px(2.));
+        cx.simulate_mouse_down(outside, MouseButton::Left, Modifiers::none());
+        cx.simulate_mouse_up(outside, MouseButton::Left, Modifiers::none());
+        cx.run_until_parked();
+    }
+
+    // R3.2 (hostile first), R3.1: offered only in Manual, read when the menu opens.
+    #[gpui::test]
+    async fn the_entry_follows_the_mode_at_menu_open_time(cx: &mut TestAppContext) {
+        let (sidebar, [newest, middle, oldest], _beta, cx) = two_projects(cx).await;
+
+        open_header_menu(&sidebar, ALPHA, cx);
+        assert!(
+            cx.debug_bounds("MENU_ITEM-Sort by Recent").is_none(),
+            "a Recent project is not offered Sort by Recent"
+        );
+        close_menu(cx);
+
+        // Turned Manual after the sidebar rendered: the next open must see it.
+        record_order(ALPHA, &[oldest, newest, middle], cx);
+        open_header_menu(&sidebar, ALPHA, cx);
+        assert!(
+            cx.debug_bounds("MENU_ITEM-Sort by Recent").is_some(),
+            "a Manual project is offered Sort by Recent"
+        );
+        close_menu(cx);
+
+        open_header_menu(&sidebar, BETA, cx);
+        assert!(
+            cx.debug_bounds("MENU_ITEM-Sort by Recent").is_none(),
+            "beta, still Recent, is not offered it"
+        );
+    }
+
+    // R3.3, R3.4 (hostile: beta keeps Manual and its slots), through the real menu entry.
+    #[gpui::test]
+    async fn sort_by_recent_returns_only_that_project(cx: &mut TestAppContext) {
+        let (sidebar, [newest, middle, oldest], [b_new, b_old], cx) = two_projects(cx).await;
+        record_order(ALPHA, &[oldest, newest, middle], cx);
+        record_order(BETA, &[b_old, b_new], cx);
+        save_thread("o", "Oldest", ALPHA, Some(1), 23, cx);
+        touch(oldest, 23, cx);
+
+        open_header_menu(&sidebar, ALPHA, cx);
+        let item = cx
+            .debug_bounds("MENU_ITEM-Sort by Recent")
+            .expect("a Manual project is offered Sort by Recent");
+        cx.simulate_click(item.center(), Modifiers::none());
+        cx.run_until_parked();
+
+        assert_eq!(mode(BETA, cx), SortMode::Manual, "beta stays Manual");
+        assert_eq!(
+            (slot(b_old, BETA, cx), slot(b_new, BETA, cx)),
+            (Some(0), Some(1))
+        );
+        assert_eq!(mode(ALPHA, cx), SortMode::Recent);
+        assert_eq!(
+            (
+                slot(oldest, ALPHA, cx),
+                slot(newest, ALPHA, cx),
+                slot(middle, ALPHA, cx)
+            ),
+            (None, None, None),
+            "alpha's places are discarded"
+        );
+        assert_eq!(
+            lines(&sidebar, cx),
+            vec![
+                "v [beta]",
+                "  B old",
+                "  B new",
+                "v [alpha]",
+                "  Oldest",
+                "  Newest",
+                "  Middle"
+            ],
+            "alpha by most recent activity (Oldest was just active), beta in its recorded order"
+        );
+        assert!(
+            cx.debug_bounds("MENU_ITEM-Sort by Recent").is_none(),
+            "the menu was dismissed"
+        );
+    }
+
+    // R3.5: chosen in window A, the project is Recent in window B.
+    #[gpui::test]
+    async fn sort_by_recent_shows_in_every_window(cx: &mut TestAppContext) {
+        let (_fs, project_a) = init_org_test(true, cx).await;
+        let fs = cx.update(|cx| <dyn fs::Fs>::global(cx));
+        let project_b = project::Project::test(fs, [ALPHA.as_ref()], cx).await;
+        let window_a = cx.add_window(|window, cx| MultiWorkspace::test_new(project_a, window, cx));
+        let window_b = cx.add_window(|window, cx| MultiWorkspace::test_new(project_b, window, cx));
+        let mw_a = window_a.root(cx).unwrap();
+        let mw_b = window_b.root(cx).unwrap();
+        let cx_b = &mut VisualTestContext::from_window(window_b.into(), cx);
+        let sidebar_b = setup_sidebar(&mw_b, cx_b);
+        let cx_a = &mut VisualTestContext::from_window(window_a.into(), cx);
+        let sidebar_a = setup_sidebar(&mw_a, cx_a);
+        let newest = save_in("n", "Newest", ALPHA, 3, cx_a);
+        let oldest = save_in("o", "Oldest", ALPHA, 1, cx_a);
+        record_order(ALPHA, &[oldest, newest], cx_a);
+        cx_b.run_until_parked();
+        assert_eq!(
+            lines(&sidebar_b, cx_b),
+            vec!["v [alpha]", "  Oldest", "  Newest"],
+            "fixture"
+        );
+
+        sidebar_a.update(cx_a, |sidebar, cx| {
+            sidebar.sort_project_by_recent(&local_key(ALPHA), cx)
+        });
+        cx_a.run_until_parked();
+        cx_b.run_until_parked();
+
+        assert_eq!(
+            lines(&sidebar_b, cx_b),
+            vec!["v [alpha]", "  Newest", "  Oldest"]
+        );
+    }
+
+    // R3.3 on a project already Recent: nothing changes and nothing is logged as a refusal.
+    #[gpui::test]
+    async fn sort_by_recent_on_a_recent_project_is_quiet(cx: &mut TestAppContext) {
+        let (sidebar, _alpha, _beta, cx) = two_projects(cx).await;
+        let before = lines(&sidebar, cx);
+        capture_logs();
+
+        sidebar.update(cx, |sidebar, cx| {
+            sidebar.sort_project_by_recent(&local_key(ALPHA), cx)
+        });
+        cx.run_until_parked();
+
+        assert_eq!(lines(&sidebar, cx), before);
+        assert_eq!(mode(ALPHA, cx), SortMode::Recent);
+        assert_eq!(warn_lines(), Vec::<String>::new());
+    }
+}
