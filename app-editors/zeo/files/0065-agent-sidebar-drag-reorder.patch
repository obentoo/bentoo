diff --git a/crates/sidebar/src/sidebar_organization_filter_tests.rs b/crates/sidebar/src/sidebar_organization_filter_tests.rs
new file mode 100644
index 0000000..48c8d98
--- /dev/null
+++ b/crates/sidebar/src/sidebar_organization_filter_tests.rs
@@ -0,0 +1,189 @@
+// A thread drop while the list is filtered records nothing (R5.1, R2.11, R2.2).
+//
+// `set_manual_order` replaces a project's whole order, and a filtered list shows only part of
+// it: a drop there would take every hidden thread out of the order. The search text is
+// covered over a Manual project whose hidden thread must keep its slot, and over a Recent
+// project that must stay Recent.
+
+use super::*;
+use crate::sidebar_tests::{
+    init_test, save_thread_metadata_with_main_paths, setup_sidebar, type_in_search,
+    visible_entries_as_strings,
+};
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use agent_ui::thread_organization::{ProjectKey, SortMode, ThreadOrganizationStore};
+use fs::FakeFs;
+use gpui::{TestAppContext, VisualTestContext};
+use organization::{DraggedThreadRow, RowOrigin};
+use pretty_assertions::assert_eq;
+use std::path::PathBuf;
+use util::path_list::PathList;
+
+const ALPHA: &str = "/alpha";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// A window on `ALPHA` with its sidebar open and the organization store installed.
+async fn alpha_window(cx: &mut TestAppContext) -> (Entity<Sidebar>, &mut VisualTestContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(ALPHA, serde_json::json!({ "src": {} }))
+        .await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        agent_ui::thread_organization::init(cx);
+    });
+    cx.run_until_parked();
+    let project = project::Project::test(fs.clone(), [ALPHA.as_ref()], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+    (sidebar, cx)
+}
+
+fn alpha_key() -> ProjectKey {
+    ProjectKey::from_group(&ProjectGroupKey::new(
+        None,
+        PathList::new(&[PathBuf::from(ALPHA)]),
+    ))
+}
+
+/// Saves a thread with a sent message in `ALPHA`, last active at `minute`.
+fn thread(session: &str, title: &str, minute: u32, cx: &mut VisualTestContext) -> ThreadId {
+    let paths = PathList::new(&[ALPHA]);
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        paths.clone(),
+        paths,
+        chrono::TimeZone::with_ymd_and_hms(&chrono::Utc, 2026, 10, 17, 12, minute, 0).unwrap(),
+        cx,
+    );
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|entry| {
+                entry
+                    .session_id
+                    .as_ref()
+                    .is_some_and(|id| id.0.as_ref() == session)
+            })
+            .map(|entry| entry.thread_id)
+            .expect("fixture: the thread was saved")
+    })
+}
+
+/// Seeds a Manual order straight into the store (a fixture, not the code under test).
+fn record_order(order: &[ThreadId], cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store.set_manual_order(alpha_key(), order, cx)
+        })
+    })
+    .expect("fixture: the store accepts an order of known threads with a message");
+    cx.run_until_parked();
+}
+
+// ── Reading the store and the sidebar ──────────────────────────────────────
+
+fn mode(cx: &mut VisualTestContext) -> SortMode {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .sort_mode(&alpha_key())
+    })
+}
+
+fn slots(threads: &[ThreadId], cx: &mut VisualTestContext) -> Vec<Option<u32>> {
+    cx.update(|_, cx| {
+        let store = ThreadOrganizationStore::global(cx).read(cx);
+        threads
+            .iter()
+            .map(|thread_id| store.manual_position_in(*thread_id, &alpha_key()))
+            .collect()
+    })
+}
+
+fn row_ix(sidebar: &Entity<Sidebar>, thread_id: ThreadId, cx: &mut VisualTestContext) -> usize {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .position(|entry| {
+                matches!(entry, ListEntry::Thread(thread)
+                    if thread.metadata.thread_id == thread_id
+                        && thread.pinned_project_label.is_none())
+            })
+            .expect("fixture: the thread has a row in its group")
+    })
+}
+
+/// Drops the group row of `dragged` on the group row of `target`, the way the drop listener does.
+fn drop_on(
+    sidebar: &Entity<Sidebar>,
+    dragged: ThreadId,
+    target: ThreadId,
+    cx: &mut VisualTestContext,
+) {
+    let from_ix = row_ix(sidebar, dragged, cx);
+    let target_ix = row_ix(sidebar, target, cx);
+    let payload = DraggedThreadRow {
+        thread_id: dragged,
+        origin: RowOrigin::Group(ProjectGroupKey::new(
+            None,
+            PathList::new(&[PathBuf::from(ALPHA)]),
+        )),
+        title: "dragged".into(),
+        from_ix,
+    };
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.drop_thread_row(&payload, target_ix, cx)
+    });
+    cx.run_until_parked();
+}
+
+// ── The search text ────────────────────────────────────────────────────────
+
+// R5.1: text typed while the pointer is held gets past the drag-offer gate; the drop itself
+// still records nothing, and the thread the text hides keeps its slot.
+#[gpui::test]
+async fn filter_text_drop_keeps_the_hidden_threads_in_place(cx: &mut TestAppContext) {
+    let (sidebar, cx) = alpha_window(cx).await;
+    let other = thread("s-other", "Refactor parser", 3, cx);
+    let first = thread("s-first", "Fix the header", 2, cx);
+    let second = thread("s-second", "Fix the footer", 1, cx);
+    record_order(&[other, first, second], cx);
+    type_in_search(&sidebar, "fix", cx);
+    let before = visible_entries_as_strings(&sidebar, cx);
+    assert!(
+        !before.iter().any(|line| line.contains("Refactor parser")),
+        "fixture: the search text hides the other thread"
+    );
+
+    drop_on(&sidebar, second, first, cx);
+
+    assert_eq!(
+        slots(&[other, first, second], cx),
+        vec![Some(0), Some(1), Some(2)],
+        "a drop while the filter has text records nothing"
+    );
+    assert_eq!(mode(cx), SortMode::Manual, "the mode is unchanged");
+    assert_eq!(visible_entries_as_strings(&sidebar, cx), before);
+}
+
+// R2.2: a Recent project shown through the search text stays Recent.
+#[gpui::test]
+async fn filter_text_drop_leaves_a_recent_project_recent(cx: &mut TestAppContext) {
+    let (sidebar, cx) = alpha_window(cx).await;
+    let _other = thread("s-other", "Refactor parser", 3, cx);
+    let first = thread("s-first", "Fix the header", 2, cx);
+    let second = thread("s-second", "Fix the footer", 1, cx);
+    type_in_search(&sidebar, "fix", cx);
+
+    drop_on(&sidebar, second, first, cx);
+
+    assert_eq!(mode(cx), SortMode::Recent, "nothing recorded");
+    assert_eq!(slots(&[first, second], cx), vec![None, None]);
+}
