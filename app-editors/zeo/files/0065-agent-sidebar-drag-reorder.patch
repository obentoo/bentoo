+
+    #[test]
+    fn applying_the_steps_lands_on_the_targets_former_index_for_every_pair() {
+        let keys: Vec<ProjectGroupKey> = (0..4).map(|i| local_key(&format!("/k{i}"))).collect();
+        for from in 0..keys.len() {
+            for to in 0..keys.len() {
+                let steps = project_steps(&keys, &keys[from], &keys[to]);
+                if from == to {
+                    assert!(steps.is_none());
+                    continue;
+                }
+                let Some((direction, n)) = steps else {
+                    panic!("{from} -> {to} must move");
+                };
+                let mut order = keys.clone();
+                let mut ix = from;
+                for _ in 0..n {
+                    match direction {
+                        StepDirection::Up => {
+                            order.swap(ix - 1, ix);
+                            ix -= 1;
+                        }
+                        StepDirection::Down => {
+                            order.swap(ix, ix + 1);
+                            ix += 1;
+                        }
+                    }
+                }
+                assert_eq!(
+                    order[to], keys[from],
+                    "{from} -> {to} lands at the target's index"
+                );
+            }
+        }
+    }
