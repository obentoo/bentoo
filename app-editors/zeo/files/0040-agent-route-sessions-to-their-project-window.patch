@@ -0,0 +1,427 @@
+// Story 024, task 3.1 — a task opens in its own project's window (R1.1, R1.2, R1.4, R1.6,
+// R1.7, Q4). Module path: `panel::open_routing`. Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/open_routing_tests.rs"]
+//     mod open_routing;
+//
+// Validation filters: `panel_actions_open_` and `panel_actions_click_`.
+//
+// Fixtures shared with the route-agreement tests live in `test_helpers.rs` (story-024 block):
+// every window is built over ONE `FakeFs`, so the router's `workspace::open_paths` sees all of
+// them. Hostile fixtures come first, per requirement: window B's folder `/work/zed-patches`
+// carries A's `/work/zed` as a prefix, so a match by name prefix would wrongly collapse the
+// two projects into one.
+
+use std::path::{Path, PathBuf};
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::AgentPanel;
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use gpui::{AppContext as _, KeyDownEvent, KeyUpEvent, Keystroke, TestAppContext};
+use workspace::{MultiWorkspace, PathList, Workspace};
+
+use crate::AgentTasksPanel;
+use crate::test_helpers::*;
+
+fn conversation_count(
+    agent_panel: &gpui::Entity<AgentPanel>,
+    cx: &gpui::VisualTestContext,
+) -> usize {
+    agent_panel.read_with(cx, |panel, _| panel.conversation_views().len())
+}
+
+// R1.1, R1.3 — THE BUG: a task of project A, opened from the Agent Tasks panel of window B,
+// opens in A (raised, holding the thread) and never in B; the row's folders stay A's.
+// Fails today: `open_task` opens the thread in the panel's own window.
+#[gpui::test]
+async fn panel_actions_open_from_another_window_lands_in_its_project(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let session = thread_with_task(&mut a, "Thread of A", "t");
+    // A shows a later thread, so "held by A" below means brought forward, not left open.
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let agent_panel_a = a.agent_panel().clone();
+    assert_ne!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert_eq!(
+        row_folders(&session, &mut a.cx),
+        Some(vec![PathBuf::from("/work/zed")]),
+        "precondition: the thread's metadata row records A's folder"
+    );
+    let thread_id = row_thread_id(&session, &mut a.cx);
+
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(b.any_window()),
+        "precondition: B is the active window"
+    );
+    let agent_panel_b = b.agent_panel().clone();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let windows = window_count(&mut b.cx);
+    let conversations_in_b = conversation_count(&agent_panel_b, &b.cx);
+
+    open_from(&tasks_panel_b, &key(&session.to_string(), "t"), &mut b.cx);
+    a.cx.run_until_parked();
+
+    assert_eq!(
+        shown_session(&agent_panel_a, &a.cx),
+        Some(session.clone()),
+        "the thread opens in its project's window (A), not in the panel's window (B)"
+    );
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(a.any_window()),
+        "A is raised"
+    );
+    assert!(
+        !shows_thread(&agent_panel_b, thread_id, &b.cx),
+        "B's agent panel does not show A's thread"
+    );
+    assert_eq!(
+        conversation_count(&agent_panel_b, &b.cx),
+        conversations_in_b,
+        "B's agent panel holds no new conversation"
+    );
+    assert_eq!(window_count(&mut b.cx), windows, "no window is opened");
+    assert_eq!(
+        row_folders(&session, &mut b.cx),
+        Some(vec![PathBuf::from("/work/zed")]),
+        "the metadata row keeps A's folder"
+    );
+    assert_eq!(notice_of(&tasks_panel_b, &session, "t", &mut b.cx), None);
+}
+
+// R1.2 — no window holds the thread's folders: one is opened over them, as `zeo <folder>`
+// would, and raised; B is left alone. Every new workspace gets an agent panel, as Zeo's
+// `initialize_workspace` gives it one.
+#[gpui::test]
+async fn panel_actions_open_with_no_window_for_the_project_opens_one(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let session = thread_with_task(&mut a, "Thread of A", "t");
+    let thread_id = row_thread_id(&session, &mut a.cx);
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    let b_window = b.window;
+
+    // Close A: the thread's metadata row and its task record outlive the window.
+    let ProjectWindow {
+        window: a_window,
+        workspace: a_workspace,
+        agent_panel: a_agent_panel,
+        cx: mut a_cx,
+        ..
+    } = a;
+    drop((a_workspace, a_agent_panel));
+    a_cx.update(|window, _| window.remove_window());
+    a_cx.run_until_parked();
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    assert_eq!(window_count(&mut b.cx), 1, "precondition: only B is open");
+    assert_eq!(
+        row_folders(&session, &mut b.cx),
+        Some(vec![PathBuf::from("/work/zed")]),
+        "precondition: the row outlived its window"
+    );
+
+    cx.update(|cx| {
+        cx.observe_new(|workspace: &mut Workspace, window, cx| {
+            let Some(window) = window else { return };
+            if workspace.panel::<AgentPanel>(cx).is_none() {
+                let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+                workspace.add_panel(panel, window, cx);
+            }
+        })
+        .detach();
+    });
+    let agent_panel_b = b.agent_panel().clone();
+    let tasks_panel_b = b.tasks_panel().clone();
+
+    open_from(&tasks_panel_b, &key(&session.to_string(), "t"), &mut b.cx);
+
+    let opened = b.cx.update(|_, cx| {
+        cx.windows()
+            .into_iter()
+            .filter_map(|window| window.downcast::<MultiWorkspace>())
+            .filter(|window| *window != b_window && *window != a_window)
+            .find(|window| {
+                window.read(cx).is_ok_and(|multi_workspace| {
+                    multi_workspace
+                        .workspace()
+                        .read(cx)
+                        .project()
+                        .read(cx)
+                        .visible_worktrees(cx)
+                        .any(|worktree| {
+                            worktree.read(cx).abs_path().as_ref() == Path::new("/work/zed")
+                        })
+                })
+            })
+    });
+    let opened = opened.expect("a window is opened over the thread's folder");
+    assert_eq!(window_count(&mut b.cx), 2, "exactly one window is opened");
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(opened.into()),
+        "the new window is raised"
+    );
+    assert!(
+        !shows_thread(&agent_panel_b, thread_id, &b.cx),
+        "B's agent panel does not take the thread"
+    );
+    assert_eq!(
+        row_folders(&session, &mut b.cx),
+        Some(vec![PathBuf::from("/work/zed")]),
+        "the metadata row keeps its folder"
+    );
+}
+
+// R1.4 — a thread whose row names a remote host opens in the panel's own window and never
+// through `open_paths`. Hostile: a LOCAL window holds the very path the remote row names, so
+// resolving remote folders as local ones would wrongly send the thread there.
+#[gpui::test]
+async fn panel_actions_open_remote_thread_stays_in_this_window(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    db.insert_started(&record(
+        "remote-session",
+        "t",
+        AgentTaskStatus::Running,
+        1_000,
+    ))
+    .await
+    .unwrap();
+    db.update_ended(&record(
+        "remote-session",
+        "t",
+        AgentTaskStatus::Completed,
+        1_000,
+    ))
+    .await
+    .unwrap();
+    let thread_id = ThreadId::new();
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(sid("remote-session")),
+                    agent_id: "stub".into(),
+                    title: Some("Remote thread".into()),
+                    title_override: None,
+                    updated_at: Default::default(),
+                    created_at: None,
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(&PathList::new(&[
+                        Path::new("/work/zed"),
+                    ])),
+                    remote_connection: Some(remote::RemoteConnectionOptions::Ssh(
+                        remote::SshConnectionOptions::default(),
+                    )),
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let a = project_window(&fs, &["/work/zed"], true, false, cx).await;
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let agent_panel_a = a.agent_panel().clone();
+    let agent_panel_b = b.agent_panel().clone();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let windows = window_count(&mut b.cx);
+
+    open_from(&tasks_panel_b, &key("remote-session", "t"), &mut b.cx);
+
+    assert_eq!(window_count(&mut b.cx), windows, "no window is opened");
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(b.any_window()),
+        "the panel's window keeps focus"
+    );
+    assert!(
+        !shows_thread(&agent_panel_a, thread_id, &a.cx),
+        "the local window over the same path name does not take a remote thread"
+    );
+    // Whether B then SHOWS the thread depends on the stub agent loading a remote row, which
+    // this rig does not provide; the routing decision is what is asserted here.
+    let _ = agent_panel_b;
+}
+
+// R1.6, Q4 — the routing fails (the thread's window has no agent panel to load it in): the
+// row says why, one WARN line names the session and the task, and nothing falls back to
+// opening the thread in the panel's window. Fails today: it opens in B, with no notice.
+#[gpui::test]
+async fn panel_actions_open_failure_shows_the_reason(cx: &mut TestAppContext) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    // The task ends first: a running task leaves the list with the card that holds it.
+    let agent_panel_a = a.agent_panel().clone();
+    let thread = open_thread_on(
+        &agent_panel_a,
+        StopConnection::new(),
+        "Thread of A",
+        &mut a.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("task-r16", "running", 1_000, None)],
+        &mut a.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![wire_task("task-r16", "completed", 1_000, Some((10, 1)))],
+        &mut a.cx,
+    );
+    let session = session_of(&thread, &a.cx);
+    drop(thread);
+    let thread_id = row_thread_id(&session, &mut a.cx);
+    // A keeps its folder but loses its agent panel (as with AI turned off there).
+    a.workspace.update_in(&mut a.cx, |workspace, window, cx| {
+        workspace.remove_panel(&agent_panel_a, window, cx);
+    });
+    drop(agent_panel_a);
+    a.agent_panel = None;
+    a.cx.run_until_parked();
+
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let agent_panel_b = b.agent_panel().clone();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let conversations_in_b = conversation_count(&agent_panel_b, &b.cx);
+
+    capture_logs();
+    open_from(
+        &tasks_panel_b,
+        &key(&session.to_string(), "task-r16"),
+        &mut b.cx,
+    );
+    // Story 024 run: A has no panels task left to await, so the router waits for an agent
+    // panel up to its 60 s safety net before it reports; move the clock past it.
+    b.cx.executor()
+        .advance_clock(std::time::Duration::from_secs(61));
+    b.cx.run_until_parked();
+
+    let notice = notice_of(&tasks_panel_b, &session, "task-r16", &mut b.cx)
+        .expect("the row says why the thread did not open");
+    assert!(
+        !notice.contains("Thread no longer exists"),
+        "the thread exists; the routing failed: {notice:?}"
+    );
+    let session_text = session.to_string();
+    let warns = warn_lines();
+    assert!(
+        warns
+            .iter()
+            .any(|line| line.contains(&session_text) && line.contains("task-r16")),
+        "one WARN line names the session and the task: {warns:?}"
+    );
+    assert!(
+        !shows_thread(&agent_panel_b, thread_id, &b.cx),
+        "a failed route does not fall back to the panel's window"
+    );
+    assert_eq!(
+        conversation_count(&agent_panel_b, &b.cx),
+        conversations_in_b,
+        "B's agent panel holds no new conversation"
+    );
+}
+
+// R1.7 — a row clicked through its REAL click listener, with the Agent Tasks panel and the
+// agent panel in the same (left) dock, opens the thread without GPUI panicking with
+// "cannot update AgentTasksPanel while it is already being updated". The click is the
+// keyboard activation of the row's Open control (Enter down + up on its focus handle), which
+// runs the same `on_click` listener a mouse click does. Fails today with that panic.
+#[gpui::test]
+async fn panel_actions_click_in_a_shared_dock_opens_without_panicking(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Clicked thread");
+    send_tasks(
+        &thread,
+        vec![wire_task("clicked", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let _later = open_live_thread(&mut panels, "Later thread");
+    let session = session_of(&thread, &panels.cx);
+    assert_ne!(active_session(&panels), Some(session.clone()));
+
+    // Story 024 run: story 022 docks the Agent Tasks panel at the bottom by default, so put
+    // it in the agent panel's (left) dock, as an operator can.
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            workspace::dock::Panel::set_position(
+                panel,
+                workspace::dock::DockPosition::Left,
+                window,
+                cx,
+            );
+            cx.notify();
+        });
+    panels.cx.run_until_parked();
+
+    let (tasks_in_left, agent_in_left) = panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        let dock = workspace.left_dock().read(cx);
+        (
+            dock.panel::<AgentTasksPanel>().is_some(),
+            dock.panel::<AgentPanel>().is_some(),
+        )
+    });
+    assert!(
+        tasks_in_left && agent_in_left,
+        "precondition: both panels share the left dock (tasks: {tasks_in_left}, agent: {agent_in_left})"
+    );
+
+    // Show the Agent Tasks panel in that dock, so its rows are painted.
+    panels
+        .workspace
+        .update_in(&mut panels.cx, |workspace, window, cx| {
+            workspace.focus_panel::<AgentTasksPanel>(window, cx);
+        });
+    panels.cx.run_until_parked();
+    let target = key(&session.to_string(), "clicked");
+    let open_control = panels
+        .tasks_panel
+        .read_with(&panels.cx, |panel, _| {
+            panel
+                .row_focus_handles
+                .get(&target)
+                .map(|focus| focus.open.clone())
+        })
+        .expect("the row is painted");
+    panels
+        .cx
+        .update(|window, cx| window.focus(&open_control, cx));
+    panels.cx.run_until_parked();
+
+    let enter = Keystroke::parse("enter").unwrap();
+    panels.cx.simulate_event(KeyDownEvent {
+        keystroke: enter.clone(),
+        is_held: false,
+        prefer_character_input: false,
+    });
+    panels.cx.simulate_event(KeyUpEvent { keystroke: enter });
+    panels.cx.run_until_parked();
+
+    assert_eq!(
+        active_session(&panels),
+        Some(session),
+        "the clicked row's thread is open"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/route_agreement_tests.rs b/crates/agent_tasks_panel/src/panel/route_agreement_tests.rs
