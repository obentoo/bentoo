+++ b/crates/agent_tasks_panel/src/panel/route_agreement_tests.rs
@@ -0,0 +1,144 @@
+// Story 024, task 4.1 — the entry points agree on where a session opens (R1.3, R1.5, Q11).
+// Module path: `panel::route_agreement`. Wired in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/route_agreement_tests.rs"]
+//     mod route_agreement;
+//
+// Validation filter: `route_agreement_`. The tray half of the agreement is crate `zed`'s
+// `agent_session_route_*` test (this crate cannot depend on `zed`); the card half is
+// agent_ui's unchanged `test_open_task_scrolls_to_the_tool_call_that_started_it`.
+//
+// Contract assumed (design.md "Interface"): `agent_ui::{open_agent_session,
+// OpenAgentSessionOptions, OpenedAgentSession}` at agent_ui's root. If the router lands under
+// another path, adjust the `use` below only.
+//
+// Hostile fixtures, collapse first: B's `/work/zed-patches` carries A's `/work/zed` as a
+// prefix, and a third window C holds `/work/zed/crates`, a folder INSIDE A's — neither may be
+// taken for A. Then the split: the second entry point must bring forward the conversation the
+// first one left in A, never open a second one for the same session.
+
+use std::path::PathBuf;
+
+use agent_ui::{AgentPanel, OpenAgentSessionOptions, open_agent_session};
+use gpui::{Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+
+fn conversation_count(agent_panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> usize {
+    agent_panel.read_with(cx, |panel, _| panel.conversation_views().len())
+}
+
+#[gpui::test]
+async fn route_agreement_router_and_panel_row_open_a_session_in_its_project_window(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    cx.update(|cx| crate::init(cx));
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed/crates", "/work/zed-patches"]).await;
+
+    let mut a = project_window(&fs, &["/work/zed"], true, true, cx).await;
+    let session = thread_with_task(&mut a, "Thread of A", "t");
+    let _later = thread_with_task(&mut a, "Later thread of A", "u");
+    let thread_id = row_thread_id(&session, &mut a.cx);
+    let agent_panel_a = a.agent_panel().clone();
+    let c = project_window(&fs, &["/work/zed/crates"], true, false, cx).await;
+    let agent_panel_c = c.agent_panel().clone();
+    let mut b = project_window(&fs, &["/work/zed-patches"], true, true, cx).await;
+    let agent_panel_b = b.agent_panel().clone();
+    let tasks_panel_b = b.tasks_panel().clone();
+    let windows = window_count(&mut b.cx);
+    let a_folders = Some(vec![PathBuf::from("/work/zed")]);
+    assert_eq!(row_folders(&session, &mut a.cx), a_folders, "precondition");
+
+    // 1. The router, called as the panel calls it: B as the fallback window.
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let conversations_in_a = conversation_count(&agent_panel_a, &a.cx);
+    let app_state = b
+        .workspace
+        .read_with(&b.cx, |workspace, _| workspace.app_state().clone());
+    let b_window = b.any_window();
+    let routing = b.cx.update(|_, cx| {
+        open_agent_session(
+            session.clone(),
+            OpenAgentSessionOptions {
+                cwd: None,
+                fallback_window: Some(b_window),
+                tool_call_id: None,
+            },
+            app_state,
+            cx,
+        )
+    });
+    b.cx.run_until_parked();
+    let opened = routing.await.expect("the router opens A's session");
+    assert_eq!(
+        opened.window,
+        a.any_window(),
+        "the router returns A's window"
+    );
+    assert_eq!(
+        opened.workspace, a.workspace,
+        "the router returns A's workspace"
+    );
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(a.any_window()),
+        "A is raised"
+    );
+    assert_eq!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    assert!(
+        !shows_thread(&agent_panel_b, thread_id, &b.cx),
+        "not in B (name prefix)"
+    );
+    assert!(
+        !shows_thread(&agent_panel_c, thread_id, &c.cx),
+        "not in C (sub-folder)"
+    );
+    assert_eq!(
+        conversation_count(&agent_panel_a, &a.cx),
+        conversations_in_a,
+        "A's held conversation is brought forward, not duplicated"
+    );
+    assert_eq!(window_count(&mut b.cx), windows, "no window is opened");
+    assert_eq!(
+        row_folders(&session, &mut b.cx),
+        a_folders,
+        "after the router"
+    );
+
+    // 2. The panel's row, from B, after A moved on to another thread.
+    let _another = thread_with_task(&mut a, "Another thread of A", "v");
+    assert_ne!(shown_session(&agent_panel_a, &a.cx), Some(session.clone()));
+    b.cx.update(|window, _| window.activate_window());
+    b.cx.run_until_parked();
+    let conversations_in_a = conversation_count(&agent_panel_a, &a.cx);
+
+    open_from(&tasks_panel_b, &key(&session.to_string(), "t"), &mut b.cx);
+
+    assert_eq!(
+        active_window(&mut b.cx),
+        Some(a.any_window()),
+        "A is raised again"
+    );
+    assert_eq!(
+        shown_session(&agent_panel_a, &a.cx),
+        Some(session.clone()),
+        "the panel row lands where the router did"
+    );
+    assert!(!shows_thread(&agent_panel_b, thread_id, &b.cx));
+    assert!(!shows_thread(&agent_panel_c, thread_id, &c.cx));
+    assert_eq!(
+        conversation_count(&agent_panel_a, &a.cx),
+        conversations_in_a,
+        "one conversation per session, whichever entry point opened it"
+    );
+    assert_eq!(window_count(&mut b.cx), windows);
+    assert_eq!(
+        row_folders(&session, &mut b.cx),
+        a_folders,
+        "after the panel row"
+    );
+    assert_eq!(notice_of(&tasks_panel_b, &session, "t", &mut b.cx), None);
+}
