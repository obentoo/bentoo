+// Story 024, task 2.1 — `open_agent_session` resolves a session's window from its metadata
+// row (R1.1, R1.2 via `open_paths`, R1.3, R1.4, R1.5, Q4). Wired in
+// `src/agent_session_router.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "agent_session_router/routing_tests.rs"]
+//     mod routing;
+//
+// Validation filter: `agent_session_router`. Contract (design.md "Interface"):
+// `crate::{open_agent_session, OpenAgentSessionOptions, OpenedAgentSession}` re-exported at
+// agent_ui's root, as `agent_ui::open_agent_session` is named; adjust the `use` only.
+//
+// Hostile fixtures before benign ones, for "the window that holds the thread's folders":
+//   - wrongly COLLAPSE: `/work/zed-patches` (A's name as a prefix) and `/work/zed/crates` (a
+//     folder inside A's) must never be taken for `/work/zed`; a remote row naming
+//     `/work/zed` must never be taken for the local window over `/work/zed`.
+//   - wrongly SPLIT: a two-folder thread must come back to the window holding both folders,
+//     added in the other order, and no third window may be opened for it; a window holding
+//     only one of the two must not take it.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::schema::v2 as acp_v2;
+use fs::FakeFs;
+use gpui::{
+    AnyWindowHandle, AppContext as _, Entity, TestAppContext, VisualTestContext, WindowHandle,
+};
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList, Workspace};
+
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::{AgentPanel, OpenAgentSessionOptions, open_agent_session};
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext, roots: &[&str]) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    for root in roots {
+        fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    }
+    fs
+}
+
+struct Win {
+    window: WindowHandle<MultiWorkspace>,
+    workspace: Entity<Workspace>,
+    panel: Option<Entity<AgentPanel>>,
+    cx: VisualTestContext,
+}
+
+impl Win {
+    fn any(&self) -> AnyWindowHandle {
+        self.window.into()
+    }
+
+    fn panel(&self) -> Entity<AgentPanel> {
+        self.panel.clone().expect("this window has an agent panel")
+    }
+}
+
+async fn window(
+    fs: &Arc<FakeFs>,
+    roots: &[&str],
+    with_panel: bool,
+    cx: &mut TestAppContext,
+) -> Win {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    let panel = with_panel.then(|| {
+        let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+            let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+            workspace.add_panel(panel.clone(), window, cx);
+            workspace.focus_panel::<AgentPanel>(window, cx);
+            panel
+        });
+        vcx.run_until_parked();
+        panel
+    });
+    Win {
+        window,
+        workspace,
+        panel,
+        cx: vcx,
+    }
+}
+
+/// A live, persisted thread in `win`'s agent panel; returns its session and thread id.
+fn live_thread(win: &mut Win) -> (acp_v2::SessionId, ThreadId) {
+    let panel = win.panel();
+    crate::test_support::open_thread_with_connection(
+        &panel,
+        StubAgentConnection::new(),
+        &mut win.cx,
+    );
+    crate::test_support::send_message(&panel, &mut win.cx);
+    win.cx.run_until_parked();
+    (
+        crate::test_support::active_session_id(&panel, &win.cx),
+        crate::test_support::active_thread_id(&panel, &win.cx),
+    )
+}
+
+fn save_row(
+    session: &acp_v2::SessionId,
+    folders: &[&str],
+    remote: bool,
+    cx: &mut TestAppContext,
+) -> ThreadId {
+    let thread_id = ThreadId::new();
+    let folders: Vec<&Path> = folders.iter().map(|folder| Path::new(*folder)).collect();
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Saved thread".into()),
+                    title_override: None,
+                    updated_at: chrono::Utc::now(),
+                    created_at: None,
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(&PathList::new(
+                        &folders,
+                    )),
+                    remote_connection:
+                        remote.then(|| {
+                            remote::RemoteConnectionOptions::Ssh(
+                                remote::SshConnectionOptions::default(),
+                            )
+                        }),
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+fn shows(panel: &Entity<AgentPanel>, thread_id: ThreadId, cx: &VisualTestContext) -> bool {
+    panel.read_with(cx, |panel, cx| {
+        panel.active_thread_id(cx) == Some(thread_id)
+    })
+}
+
+fn shown_session(panel: &Entity<AgentPanel>, cx: &VisualTestContext) -> Option<acp_v2::SessionId> {
+    panel.read_with(cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().clone())
+    })
+}
+
+fn folders_of(session: &acp_v2::SessionId, cx: &mut TestAppContext) -> Option<Vec<PathBuf>> {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_by_session(session)
+            .map(|metadata| metadata.folder_paths().paths().to_vec())
+    })
+}
+
+fn route(
+    session: &acp_v2::SessionId,
+    cwd: Option<&str>,
+    fallback: &Win,
+    cx: &mut TestAppContext,
+) -> gpui::Task<anyhow::Result<crate::OpenedAgentSession>> {
+    let app_state = fallback
+        .workspace
+        .read_with(cx, |workspace, _| workspace.app_state().clone());
+    let fallback_window = fallback.any();
+    let session = session.clone();
+    let cwd = cwd.map(PathBuf::from);
+    cx.update(|cx| {
+        open_agent_session(
+            session,
+            OpenAgentSessionOptions {
+                cwd,
+                fallback_window: Some(fallback_window),
+                tool_call_id: None,
+            },
+            app_state,
+            cx,
+        )
+    })
+}
+
+fn activate(win: &mut Win) {
+    win.cx.update(|window, _| window.activate_window());
+    win.cx.run_until_parked();
+}
+
+// R1.1, R1.3 — wrongly collapse: neither the prefix-named window (B, the caller's fallback
+// and the active one) nor the window over a folder inside A's (C) is taken for A.
+#[gpui::test]
+async fn agent_session_router_opens_in_the_window_holding_the_folders_not_the_fallback(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed/crates", "/work/zed-patches"]).await;
+    let mut a = window(&fs, &["/work/zed"], true, cx).await;
+    let (session, thread_id) = live_thread(&mut a);
+    let (_later, _) = live_thread(&mut a);
+    assert_ne!(shown_session(&a.panel(), &a.cx), Some(session.clone()));
+    let c = window(&fs, &["/work/zed/crates"], true, cx).await;
+    let mut b = window(&fs, &["/work/zed-patches"], true, cx).await;
+    activate(&mut b);
+    let windows = cx.update(|cx| cx.windows().len());
+
+    let routing = route(&session, None, &b, cx);
+    cx.run_until_parked();
+    let opened = routing.await.expect("the session opens");
+
+    assert_eq!(opened.window, a.any(), "A's window is returned");
+    assert_eq!(opened.workspace, a.workspace, "A's workspace is returned");
+    assert_eq!(
+        cx.update(|cx| cx.active_window()),
+        Some(a.any()),
+        "A is raised"
+    );
+    assert_eq!(shown_session(&a.panel(), &a.cx), Some(session.clone()));
+    assert!(
+        !shows(&b.panel(), thread_id, &b.cx),
+        "not the prefix-named fallback"
+    );
+    assert!(
+        !shows(&c.panel(), thread_id, &c.cx),
+        "not the sub-folder window"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    assert_eq!(
+        folders_of(&session, cx),
+        Some(vec![PathBuf::from("/work/zed")]),
+        "the metadata row keeps its folders"
+    );
+}
+
+// R1.1 — wrongly split: the window holding both folders (added in the other order) takes a
+// two-folder thread; a window holding one of them does not; no third window is opened.
+#[gpui::test]
+async fn agent_session_router_reuses_the_window_holding_every_folder_in_any_order(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/multi/alpha", "/multi/beta"]).await;
+    let mut both = window(&fs, &["/multi/beta", "/multi/alpha"], true, cx).await;
+    let (session, thread_id) = live_thread(&mut both);
+    let (_later, _) = live_thread(&mut both);
+    let mut one = window(&fs, &["/multi/alpha"], true, cx).await;
+    activate(&mut one);
+    let windows = cx.update(|cx| cx.windows().len());
+    let mut recorded = folders_of(&session, cx).expect("the row exists");
+    recorded.sort();
+    assert_eq!(
+        recorded,
+        vec![PathBuf::from("/multi/alpha"), PathBuf::from("/multi/beta")],
+        "precondition: the row records both folders"
+    );
+
+    let routing = route(&session, None, &one, cx);
+    cx.run_until_parked();
+    let opened = routing.await.expect("the session opens");
+
+    assert_eq!(opened.window, both.any(), "the window holding both folders");
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no third window"
+    );
+    assert_eq!(shown_session(&both.panel(), &both.cx), Some(session));
+    assert!(
+        !shows(&one.panel(), thread_id, &one.cx),
+        "not the one-folder window"
+    );
+}
+
+// R1.4 — a remote row's folders name paths on another host: the session opens in the
+// caller's fallback window even though a LOCAL window holds a folder of the same name.
+#[gpui::test]
+async fn agent_session_router_opens_a_remote_session_in_the_fallback_window(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let a = window(&fs, &["/work/zed"], true, cx).await;
+    let mut b = window(&fs, &["/work/zed-patches"], true, cx).await;
+    let session = acp_v2::SessionId::new("remote-session");
+    let thread_id = save_row(&session, &["/work/zed"], true, cx);
+    activate(&mut b);
+    let windows = cx.update(|cx| cx.windows().len());
+
+    let routing = route(&session, None, &b, cx);
+    cx.run_until_parked();
+    let result = routing.await;
+
+    assert!(
+        !shows(&a.panel(), thread_id, &a.cx),
+        "never the local same-named window"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.active_window()),
+        Some(b.any()),
+        "B stays active"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    if let Ok(opened) = result {
+        assert_eq!(opened.window, b.any(), "the fallback window is returned");
+        assert!(shows(&b.panel(), thread_id, &b.cx));
+    }
+}
+
+// R1.1 — a session no row knows yet resolves through the caller's `cwd`, as the tray link's
+// `cwd=` does: A's window is raised, the fallback B is not used.
+#[gpui::test]
+async fn agent_session_router_falls_back_to_cwd_for_a_session_without_a_row(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let a = window(&fs, &["/work/zed"], true, cx).await;
+    let mut b = window(&fs, &["/work/zed-patches"], true, cx).await;
+    activate(&mut b);
+    let windows = cx.update(|cx| cx.windows().len());
+    let session = acp_v2::SessionId::new("session-without-a-row");
+
+    let routing = route(&session, Some("/work/zed"), &b, cx);
+    cx.run_until_parked();
+    let result = routing.await;
+
+    assert_eq!(
+        cx.update(|cx| cx.active_window()),
+        Some(a.any()),
+        "cwd's window is raised"
+    );
