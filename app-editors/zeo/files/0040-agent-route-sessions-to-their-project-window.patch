+// R1.6 — a thread whose folders were deleted is an `Err` naming the session: `open_paths`
+// would drop the missing paths and reuse the focused window, opening the thread there.
+#[gpui::test]
+async fn agent_session_router_refuses_a_session_whose_folders_no_longer_exist(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed-patches"]).await;
+    let mut fallback = window(&fs, &["/work/zed-patches"], cx).await;
+    let fallback_panel = add_agent_panel(&fallback.workspace, &mut fallback.cx);
+    let session = acp_v2::SessionId::new("session-of-a-deleted-folder");
+    let thread_id = save_row(&session, &["/work/deleted"], cx);
+    activate(&mut fallback);
+    let windows = cx.update(|cx| cx.windows().len());
+    let fallback_roots = visible_roots(&fallback.workspace, cx);
+
+    let routing = route(&session, &fallback, cx);
+    cx.run_until_parked();
+    let error = match routing.await {
+        Ok(_) => panic!("a session whose folders are gone cannot be opened"),
+        Err(error) => error,
+    };
+
+    let message = format!("{error:#}");
+    assert!(
+        message.contains("session-of-a-deleted-folder"),
+        "the error names the session: {message}"
+    );
+    assert!(
+        message.contains("no longer exist"),
+        "the error says why: {message}"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    assert_eq!(
+        visible_roots(&fallback.workspace, cx),
+        fallback_roots,
+        "the fallback window's project is unchanged"
+    );
+    assert!(
+        !shows(&fallback_panel, thread_id, cx),
+        "no fallback to the caller's window"
+    );
+}
+
+// R1.1 — a target window whose agent panel is not there yet (its panels still loading, or
+// their task taken by an earlier routing call) is waited for, not reported as panel-less.
+#[gpui::test]
+async fn agent_session_router_waits_for_an_agent_panel_that_is_still_loading(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut target = window(&fs, &["/work/zed"], cx).await;
+    let mut fallback = window(&fs, &["/work/zed-patches"], cx).await;
+    let fallback_panel = add_agent_panel(&fallback.workspace, &mut fallback.cx);
+    let session = acp_v2::SessionId::new("session-of-a-window-still-loading");
+    let thread_id = save_row(&session, &["/work/zed"], cx);
+    activate(&mut fallback);
+
+    let routing = route(&session, &fallback, cx);
+    cx.run_until_parked();
+    let target_panel = add_agent_panel(&target.workspace, &mut target.cx);
+    let opened = routing.await;
+
+    assert!(
+        shows(&target_panel, thread_id, cx),
+        "the panel that appeared shows the thread"
+    );
+    assert!(!shows(&fallback_panel, thread_id, cx));
+    assert_reached_the_thread(opened, target.any(), &target.workspace);
+}
+
+/// The routing result, which must already be there: polled once, never awaited, so no
+/// timer can have fired to produce it.
+fn resolved_without_waiting(
+    routing: gpui::Task<anyhow::Result<OpenedAgentSession>>,
+    clock_before: std::time::Instant,
+    cx: &mut TestAppContext,
+) -> anyhow::Error {
+    let result = futures::FutureExt::now_or_never(routing)
+        .expect("the routing resolves without waiting for a timer");
+    assert_eq!(
+        cx.executor().now(),
+        clock_before,
+        "the clock was not advanced"
+    );
+    match result {
+        Ok(_) => panic!("the session cannot be opened"),
+        Err(error) => error,
+    }
+}
+
+// R1.6 — the target window's panels finished loading without an agent panel (the app's
+// panels task, taken and awaited by the router): none is coming, so the `Err` is
+// immediate rather than after the safety-net timeout.
+#[gpui::test]
+async fn agent_session_router_fails_at_once_when_the_loaded_panels_have_no_agent_panel(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let target = window(&fs, &["/work/zed"], cx).await;
+    let mut fallback = window(&fs, &["/work/zed-patches"], cx).await;
+    let fallback_panel = add_agent_panel(&fallback.workspace, &mut fallback.cx);
+    let session = acp_v2::SessionId::new("session-of-a-window-loaded-without-agent-panel");
+    let thread_id = save_row(&session, &["/work/zed"], cx);
+    target.workspace.update(cx, |workspace, _| {
+        workspace.set_panels_task(gpui::Task::ready(Ok(())))
+    });
+    activate(&mut fallback);
+    let clock_before = cx.executor().now();
+
+    let routing = route(&session, &fallback, cx);
+    cx.run_until_parked();
+    let error = resolved_without_waiting(routing, clock_before, cx);
+
+    let message = format!("{error:#}");
+    assert!(
+        message.contains("session-of-a-window-loaded-without-agent-panel"),
+        "the error names the session: {message}"
+    );
+    assert!(
+        message.contains("without an agent panel"),
+        "the error says why: {message}"
+    );
+    assert!(
+        !shows(&fallback_panel, thread_id, cx),
+        "no fallback to the caller's window"
+    );
+}
+
+// R1.6 — with AI disabled no window has an agent panel: an immediate `Err` saying so, and
+// no window is opened for the thread's folders.
+#[gpui::test]
+async fn agent_session_router_fails_at_once_when_ai_is_disabled(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let mut fallback = window(&fs, &["/work/zed-patches"], cx).await;
+    let fallback_panel = add_agent_panel(&fallback.workspace, &mut fallback.cx);
+    let session = acp_v2::SessionId::new("session-while-ai-is-disabled");
+    let thread_id = save_row(&session, &["/work/zed"], cx);
+    activate(&mut fallback);
+    cx.update(|cx| {
+        project::DisableAiSettings::override_global(
+            project::DisableAiSettings { disable_ai: true },
+            cx,
+        )
+    });
