 }
+
+// ── Story 024 — windows per project, and where a session is held ───────────
+//
+// Each window is a `MultiWorkspace` over ONE shared `FakeFs`, so a router that resolves a
+// thread's folders through `workspace::open_paths` sees every window's folders on the same
+// file system, and can open a new window over folders no window holds yet.
+
+pub(crate) fn warn_lines() -> Vec<String> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .filter(|(level, _)| *level == log::Level::Warn)
+            .map(|(_, line)| line.clone())
+            .collect()
+    })
+}
+
+/// The shared file system every story-024 window is built on, holding each of `roots`.
+pub(crate) async fn shared_fs(cx: &mut TestAppContext, roots: &[&str]) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    for root in roots {
+        fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    }
+    fs
+}
+
+pub(crate) struct ProjectWindow {
+    pub window: gpui::WindowHandle<MultiWorkspace>,
+    pub workspace: Entity<Workspace>,
+    pub agent_panel: Option<Entity<AgentPanel>>,
+    pub tasks_panel: Option<Entity<AgentTasksPanel>>,
+    pub cx: VisualTestContext,
+}
+
+impl ProjectWindow {
+    pub(crate) fn any_window(&self) -> gpui::AnyWindowHandle {
+        self.window.into()
+    }
+
+    pub(crate) fn agent_panel(&self) -> &Entity<AgentPanel> {
+        self.agent_panel
+            .as_ref()
+            .expect("this window has an agent panel")
+    }
+
+    pub(crate) fn tasks_panel(&self) -> &Entity<AgentTasksPanel> {
+        self.tasks_panel
+            .as_ref()
+            .expect("this window has an Agent Tasks panel")
+    }
+}
+
+/// A window over `roots` (all on `fs`), with the agent panel and the Agent Tasks panel as
+/// asked. The crate's `init` must already have run when `with_tasks_panel` is set.
+pub(crate) async fn project_window(
+    fs: &Arc<FakeFs>,
+    roots: &[&str],
+    with_agent_panel: bool,
+    with_tasks_panel: bool,
+    cx: &mut TestAppContext,
+) -> ProjectWindow {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    vcx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    let agent_panel = with_agent_panel.then(|| {
+        let panel = workspace.update_in(&mut vcx, |workspace, window, cx| {
+            let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+            workspace.add_panel(panel.clone(), window, cx);
+            workspace.focus_panel::<AgentPanel>(window, cx);
+            panel
+        });
+        vcx.run_until_parked();
+        panel
+    });
+    let tasks_panel = if with_tasks_panel {
+        let weak = workspace.downgrade();
+        let loading = vcx.update(|window, cx| AgentTasksPanel::load(weak, window.to_async(cx)));
+        vcx.run_until_parked();
+        let tasks_panel = loading.await.expect("the Agent Tasks panel loads");
+        workspace.update_in(&mut vcx, |workspace, window, cx| {
+            workspace.add_panel(tasks_panel.clone(), window, cx);
+        });
+        vcx.run_until_parked();
+        Some(tasks_panel)
+    } else {
+        None
+    };
+    ProjectWindow {
+        window,
+        workspace,
+        agent_panel,
+        tasks_panel,
+        cx: vcx,
+    }
+}
+
+/// A live thread of `window`'s project, with one running task `task`; returns its session.
+pub(crate) fn thread_with_task(
+    window: &mut ProjectWindow,
+    title: &str,
+    task: &str,
+) -> acp_v2::SessionId {
+    let agent_panel = window.agent_panel().clone();
+    let thread = open_thread_on(&agent_panel, StopConnection::new(), title, &mut window.cx);
+    send_tasks(
+        &thread,
+        vec![wire_task(task, "running", 1_000, None)],
+        &mut window.cx,
+    );
+    session_of(&thread, &window.cx)
+}
+
+/// The folders the session's metadata row records.
+pub(crate) fn row_folders(
+    session: &acp_v2::SessionId,
+    cx: &mut VisualTestContext,
+) -> Option<Vec<std::path::PathBuf>> {
+    cx.update(|_, cx| {
+        agent_ui::thread_metadata_store::ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_by_session(session)
+            .map(|metadata| metadata.folder_paths().paths().to_vec())
+    })
+}
+
+pub(crate) fn row_thread_id(
+    session: &acp_v2::SessionId,
+    cx: &mut VisualTestContext,
+) -> agent_ui::thread_metadata_store::ThreadId {
+    cx.update(|_, cx| {
+        agent_ui::thread_metadata_store::ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_by_session(session)
+            .map(|metadata| metadata.thread_id)
+            .expect("the session has a metadata row")
+    })
+}
+
+/// The session `agent_panel` shows, if any.
+pub(crate) fn shown_session(
+    agent_panel: &Entity<AgentPanel>,
+    cx: &VisualTestContext,
+) -> Option<acp_v2::SessionId> {
+    agent_panel.read_with(cx, |panel, cx| {
+        panel
+            .active_agent_thread(cx)
+            .map(|thread| thread.read(cx).session_id().clone())
+    })
+}
+
+/// Whether `agent_panel` shows the thread `thread_id` (a loading or failed load included).
+pub(crate) fn shows_thread(
+    agent_panel: &Entity<AgentPanel>,
+    thread_id: agent_ui::thread_metadata_store::ThreadId,
+    cx: &VisualTestContext,
+) -> bool {
+    agent_panel.read_with(cx, |panel, cx| {
+        panel.active_thread_id(cx) == Some(thread_id)
+    })
+}
+
+pub(crate) fn active_window(cx: &mut VisualTestContext) -> Option<gpui::AnyWindowHandle> {
+    cx.update(|_, cx| cx.active_window())
+}
+
+pub(crate) fn window_count(cx: &mut VisualTestContext) -> usize {
+    cx.update(|_, cx| cx.windows().len())
+}
+
+/// Opens `key` from `panel` the way the panel's own code does it, and lets every spawned
+/// step (window resolution, `open_paths`, the load) run to the end.
+pub(crate) fn open_from(panel: &Entity<AgentTasksPanel>, key: &Key, cx: &mut VisualTestContext) {
+    panel.update_in(cx, |panel, window, cx| panel.open_task(key, window, cx));
+    cx.run_until_parked();
+}
+
+pub(crate) fn notice_of(
+    panel: &Entity<AgentTasksPanel>,
+    session: &acp_v2::SessionId,
+    task: &str,
+    cx: &mut VisualTestContext,
+) -> Option<SharedString> {
+    panel
+        .update(cx, |panel, cx| panel.groups(cx))
+        .into_iter()
+        .flat_map(|group| group.rows)
+        .find(|row| {
+            &row.entry.record.session_id == session && row.entry.record.task_id.as_ref() == task
+        })
+        .expect("the task is listed")
+        .notice
+}
diff --git a/crates/agent_ui/src/agent_session_router.rs b/crates/agent_ui/src/agent_session_router.rs
new file mode 100644
index 0000000..9887094
--- /dev/null
+++ b/crates/agent_ui/src/agent_session_router.rs
@@ -0,0 +1,477 @@
+//! Opens an agent session in the window that holds its thread's project.
+//!
+//! One routine for every entry point that names a session — the tray link
+//! (`zeo://agent?session=`) and the Agent Tasks panel — so both resolve a
+//! thread's window the same way. A thread belongs to a project, so it is opened
+//! in the window holding exactly that project's folders, found across every
+//! window, and not in whichever window has focus. When no window holds them, a
+//! new window is opened over exactly those folders; they are never added to an
+//! existing window.
+
+use std::collections::BTreeSet;
+use std::future::Future;
+use std::path::{Path, PathBuf};
+use std::pin::pin;
+use std::sync::Arc;
+use std::time::Duration;
+
+use acp_thread::AgentTaskId;
+use agent_client_protocol::schema::v2 as acp_v2;
+use anyhow::{Context as _, Result, anyhow};
+use fs::Fs;
+use futures::StreamExt as _;
+use futures::future::{Either, select};
+use gpui::{AnyWindowHandle, App, AsyncApp, Entity, Task, WeakEntity, WindowHandle};
+use project::DisableAiSettings;
+use settings::Settings as _;
+use util::ResultExt as _;
+use workspace::{AppState, MultiWorkspace, OpenMode, OpenOptions, Workspace, WorkspaceMatching};
+
+use crate::AgentPanel;
+use crate::conversation_view::ConversationView;
+use crate::thread_metadata_store::ThreadMetadataStore;
+
+/// How long a window may take to gain an agent panel when another caller is
+/// already awaiting its panels: a safety net, since nothing else would end that
+/// wait if the panel never arrives.
+const AGENT_PANEL_TIMEOUT: Duration = Duration::from_secs(60);
+/// How long the thread may take to load once its window shows it: the agent's
+/// connection, then its `load_session`/`resume_session`. Without a bound, an
+/// agent that never answers would leave the caller waiting forever.
+const THREAD_LOAD_TIMEOUT: Duration = Duration::from_secs(60);
+
+/// What the caller knows besides the session id.
+#[derive(Clone, Debug, Default)]
+pub struct OpenAgentSessionOptions {
+    /// The folder the link's producer saw; only consulted for a session no
+    /// metadata row knows yet (the tray link's `cwd=`).
+    pub cwd: Option<PathBuf>,
+    /// The window used when the thread has no local folders: a remote thread, or
+    /// a session with neither a row nor a `cwd`. `None` uses the active window.
+    pub fallback_window: Option<AnyWindowHandle>,
+    /// The tool call to scroll the opened thread to, once it has loaded. Only an
+    /// entry of the root thread is scrolled to; any other id opens the thread
+    /// without scrolling.
+    pub tool_call_id: Option<acp_v2::ToolCallId>,
+    /// The task the open is for, named in the log line a scroll writes.
+    pub task_id: Option<AgentTaskId>,
+}
+
+/// Where the session was opened.
+#[derive(Clone, Debug)]
+pub struct OpenedAgentSession {
+    pub window: AnyWindowHandle,
+    pub workspace: Entity<Workspace>,
+}
+
+/// Opens `session_id`'s thread in the window that holds its project, raises that
+/// window, and resolves once that window's agent panel holds a loaded
+/// conversation for the session.
+///
+/// Every failure is an `Err` naming the session and the step that failed; the
+/// thread is never opened in another window as a silent fallback.
+pub fn open_agent_session(
+    session_id: acp_v2::SessionId,
+    options: OpenAgentSessionOptions,
+    app_state: Arc<AppState>,
+    cx: &mut App,
+) -> Task<Result<OpenedAgentSession>> {
+    cx.spawn(async move |cx| {
+        let OpenAgentSessionOptions {
+            cwd,
+            fallback_window,
+            tool_call_id: _,
+        } = options;
+
+        // No window has an agent panel while AI is disabled, so refuse before
+        // resolving one: opening a window for the thread's folders would be for
+        // nothing.
+        if cx.update(|cx| DisableAiSettings::get_global(cx).disable_ai) {
+            return Err(anyhow!(
+                "open agent session {session_id}: AI is disabled, so no window has an agent \
+                 panel to open it in"
+            ));
+        }
+
+        let (window, workspace) =
+            resolve_window(&session_id, cwd, fallback_window, app_state, cx).await?;
+
+        let deadline = cx.background_executor().timer(AGENT_PANEL_TIMEOUT);
+        before(
+            deadline,
+            wait_for_agent_panel(&session_id, window, &workspace, cx),
+        )
+        .await
+        .with_context(|| {
+            format!(
+                "open agent session {session_id}: the target window has no agent panel \
+                 (waited {AGENT_PANEL_TIMEOUT:?})"
+            )
+        })??;
+
+        let conversation = window
+            .update(cx, |_, window, cx| {
+                // Raise the window before touching the panel: focusing a panel
+                // only moves focus inside Zeo, and on a desktop with virtual
+                // workspaces the window would stay on whichever desktop it was
+                // left on.
+                window.activate_window();
+                workspace.update(cx, |workspace, cx| {
+                    let panel = workspace
+                        .focus_panel::<AgentPanel>(window, cx)
+                        .with_context(|| {
+                            format!(
+                                "open agent session {session_id}: the target window has no agent \
+                                 panel"
+                            )
+                        })?;
+                    panel.update(cx, |panel, cx| {
+                        panel.open_thread_by_session(session_id.clone(), window, cx);
+                        shown_conversation(panel, &session_id, cx)
+                            .map(|view| view.downgrade())
+                            .with_context(|| {
+                                format!(
+                                    "open agent session {session_id}: the agent panel did not \
+                                     bring the thread forward"
+                                )
+                            })
+                    })
+                })
+            })
+            .with_context(|| format!("open agent session {session_id}: the window is gone"))??;
+
+        let deadline = cx.background_executor().timer(THREAD_LOAD_TIMEOUT);
+        before(deadline, wait_until_loaded(&session_id, conversation, cx))
+            .await
+            .with_context(|| {
+                format!(
+                    "open agent session {session_id}: the thread did not load within \
+                     {THREAD_LOAD_TIMEOUT:?}"
+                )
+            })??;
+
+        Ok(OpenedAgentSession {
+            window: window.into(),
+            workspace,
+        })
+    })
+}
+
+/// The window and workspace the session is opened in.
+async fn resolve_window(
+    session_id: &acp_v2::SessionId,
+    cwd: Option<PathBuf>,
+    fallback_window: Option<AnyWindowHandle>,
+    app_state: Arc<AppState>,
+    cx: &mut AsyncApp,
+) -> Result<(WindowHandle<MultiWorkspace>, Entity<Workspace>)> {
+    match agent_session_folders(session_id, cwd, cx).await {
+        Some(folders) => {
+            let exact = cx.update(|cx| window_holding_exactly(&folders, cx));
+            if let Some((window, workspace)) = exact {
+                window
+                    .update(cx, |multi_workspace, window, cx| {
+                        if multi_workspace.workspace() != &workspace {
+                            multi_workspace.activate(workspace.clone(), None, window, cx);
+                        }
+                    })
+                    .with_context(|| {
+                        format!("open agent session {session_id}: the window is gone")
+                    })?;
+                return Ok((window, workspace));
+            }
+            ensure_folders_exist(session_id, &folders, app_state.fs.as_ref()).await?;
+            // Always a new OS window over exactly these folders. The default
+            // options would instead reuse a window holding only some of them and
+            // add the rest to its project, or add them to the focused window.
+            let options = OpenOptions {
+                workspace_matching: WorkspaceMatching::None,
+                open_mode: OpenMode::NewWindow,
+                ..OpenOptions::default()
+            };
+            let opened = cx
+                .update(|cx| workspace::open_paths(&folders, app_state, options, cx))
+                .await
+                .with_context(|| {
+                    format!("open agent session {session_id}: opening a window for {folders:?}")
+                })?;
+            Ok((opened.window, opened.workspace))
+        }
+        None => {
+            let window = match fallback_window {
+                Some(window) => window.downcast::<MultiWorkspace>().with_context(|| {
+                    format!(
+                        "open agent session {session_id}: the fallback window is not a workspace \
+                         window"
+                    )
+                })?,
+                None => workspace::get_any_active_multi_workspace(app_state, cx.clone())
+                    .await
+                    .with_context(|| {
+                        format!("open agent session {session_id}: finding the active window")
+                    })?,
+            };
+            let workspace = window
+                .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+                .with_context(|| {
+                    format!("open agent session {session_id}: the fallback window is gone")
+                })?;
+            Ok((window, workspace))
+        }
+    }
+}
+
+/// A local workspace whose visible folders are exactly `folders`, in any order.
+///
+/// Matching the whole set — not a prefix, not a containing folder — keeps a
+/// window over `/work/zed-patches` or `/work/zed/crates` from taking a thread of
+/// `/work/zed`, and keeps a window holding only one of a thread's folders from
+/// taking it. The active window wins a tie.
+fn window_holding_exactly(
+    folders: &[PathBuf],
+    cx: &App,
+) -> Option<(WindowHandle<MultiWorkspace>, Entity<Workspace>)> {
+    let wanted: BTreeSet<&Path> = folders.iter().map(PathBuf::as_path).collect();
+    let active = cx.active_window();
+    let mut windows = cx.windows();
+    windows.sort_by_key(|window| Some(*window) != active);
+    windows.into_iter().find_map(|window| {
+        let window = window.downcast::<MultiWorkspace>()?;
+        let multi_workspace = window.read(cx).ok()?;
+        let workspace = multi_workspace.workspaces().find(|workspace| {
+            let project = workspace.read(cx).project().read(cx);
+            if !project.is_local() {
+                return false;
+            }
+            let roots: Vec<Arc<Path>> = project
+                .visible_worktrees(cx)
+                .map(|worktree| worktree.read(cx).abs_path())
+                .collect();
+            roots.iter().map(AsRef::as_ref).collect::<BTreeSet<&Path>>() == wanted
+        })?;
+        Some((window, workspace.clone()))
+    })
+}
+
+/// The folders the thread of an agent session belongs to.
+///
+/// The session's metadata row is the authority: it records the folders the
+/// thread was started in. `cwd` -- what the link's producer saw -- only answers
+/// for a session no row knows yet. `None` leaves the choice to the focused
+/// window, which is also what a thread on a remote host gets: its folders name
+/// paths on that host, not on this one.
+async fn agent_session_folders(
+    session_id: &acp_v2::SessionId,
+    cwd: Option<PathBuf>,
+    cx: &mut AsyncApp,
+) -> Option<Vec<PathBuf>> {
+    let store = cx.update(|cx| ThreadMetadataStore::try_global(cx));
+    let Some(store) = store else {
+        return cwd.map(|cwd| vec![cwd]);
+    };
+    // The store loads its rows from disk at startup, and a link that launched
+    // Zed arrives before that finishes; without the wait it finds no row and
+    // falls through to `cwd` for a thread it does know.
+    let reload = store.read_with(cx, |store, _| store.reload_task());
+    reload.await;
+
+    store.read_with(cx, |store, _| match store.entry_by_session(session_id) {
+        Some(metadata) if metadata.remote_connection.is_some() => None,
+        Some(metadata) => Some(metadata.folder_paths().paths().to_vec())
+            .filter(|folders| !folders.is_empty())
+            .or_else(|| cwd.map(|cwd| vec![cwd])),
+        None => cwd.map(|cwd| vec![cwd]),
+    })
+}
+
+/// Fails unless every folder is still a directory on this machine.
+///
+/// `open_paths` drops a path that no longer exists, and with nothing left to
+/// open it reuses the focused window: the thread would land there silently. A
+/// thread whose folders only partly survive is refused too, because opening the
+/// survivors would give it a different project from the one it was started in.
+async fn ensure_folders_exist(
+    session_id: &acp_v2::SessionId,
+    folders: &[PathBuf],
+    fs: &dyn Fs,
+) -> Result<()> {
+    let mut missing = Vec::new();
+    for folder in folders {
+        let metadata = fs.metadata(folder).await.with_context(|| {
+            format!("open agent session {session_id}: reading its folder {folder:?}")
+        })?;
+        if !metadata.is_some_and(|metadata| metadata.is_dir) {
+            missing.push(folder);
+        }
+    }
+    if missing.is_empty() {
+        Ok(())
+    } else if missing.len() == folders.len() {
+        Err(anyhow!(
+            "open agent session {session_id}: its folders {folders:?} no longer exist"
+        ))
+    } else {
+        Err(anyhow!(
+            "open agent session {session_id}: its folders {missing:?} no longer exist, and \
+             opening only the rest of {folders:?} would change its project"
+        ))
+    }
+}
+
+/// Resolves to `Some` with `future`'s output, or `None` once `deadline` fires.
+async fn before<T>(deadline: Task<()>, future: impl Future<Output = T>) -> Option<T> {
+    match select(pin!(future), deadline).await {
+        Either::Left((output, _)) => Some(output),
+        Either::Right(((), _)) => None,
+    }
+}
+
+/// Resolves once `workspace` has an agent panel, or fails when none will come.
+///
+/// The app adds the agent panel inside the window's panels task, so when this
+/// call takes and awaits that task itself, a panel still missing afterwards is
+/// never coming. Only when another caller took the task first — it may still be
+/// running — does it wait, for the workspace's `PanelAdded` or `window` closing;
+/// the caller bounds that wait. The window is watched rather than the workspace
+/// because the caller holds the workspace, so it is never released mid-wait. A
+/// failed panel load is logged, as the workspace itself does, and does not abort
+/// the open when the agent panel loaded anyway.
+async fn wait_for_agent_panel(
+    session_id: &acp_v2::SessionId,
+    window: WindowHandle<MultiWorkspace>,
+    workspace: &Entity<Workspace>,
+    cx: &mut AsyncApp,
+) -> Result<()> {
+    let window_id = window.window_id();
+    let window_is_open = |cx: &mut AsyncApp| {
+        cx.update(|cx| {
+            cx.windows()
+                .iter()
+                .any(|open| open.window_id() == window_id)
+        })
+    };
+    let has_agent_panel = |cx: &mut AsyncApp| {
+        workspace.read_with(cx, |workspace, cx| {
+            workspace.panel::<AgentPanel>(cx).is_some()
+        })
+    };
+    let closed = || {
+        anyhow!(
+            "open agent session {session_id}: the target window closed before its agent panel \
+             loaded"
+        )
+    };
+
+    let panels_task = workspace.update(cx, |workspace, _| workspace.take_panels_task());
+    if let Some(panels_task) = panels_task {
+        panels_task.await.log_err();
+        if !window_is_open(cx) {
+            return Err(closed());
+        }
+        if has_agent_panel(cx) {
+            return Ok(());
+        }
+        return Err(anyhow!(
+            "open agent session {session_id}: the target window loaded its panels without an \
+             agent panel"
+        ));
+    }
+
+    let (wake_tx, mut wake_rx) = futures::channel::mpsc::unbounded::<()>();
+    let (_panel_added, _window_closed) = cx.update(|cx| {
+        let panel_added = cx.subscribe(workspace, {
+            let wake_tx = wake_tx.clone();
+            move |_, event: &workspace::Event, _| {
+                if matches!(event, workspace::Event::PanelAdded(_)) {
+                    wake_tx.unbounded_send(()).ok();
+                }
+            }
+        });
+        let window_closed = cx.on_window_closed(move |_, closed_id| {
+            if closed_id == window_id {
+                wake_tx.unbounded_send(()).ok();
+            }
+        });
+        (panel_added, window_closed)
+    });
+    loop {
+        if !window_is_open(cx) {
+            return Err(closed());
+        }
+        if has_agent_panel(cx) {
+            return Ok(());
+        }
+        if wake_rx.next().await.is_none() {
+            return Err(closed());
+        }
+    }
+}
+
+/// The conversation `panel` shows for `session_id` after
+/// `open_thread_by_session`, which always makes the session's conversation the
+/// active one. Anything else showing means the panel did not open the thread.
+fn shown_conversation(
+    panel: &AgentPanel,
+    session_id: &acp_v2::SessionId,
+    cx: &App,
+) -> Option<Entity<ConversationView>> {
+    panel
+        .active_conversation_view()
+        .filter(|view| view.read(cx).root_session_id.as_ref() == Some(session_id))
+        .cloned()
+}
+
+/// Resolves once `conversation` has left its loading state: `Ok` when it holds
+/// the thread, `Err` naming the session when the load failed or the
+/// conversation was dropped first.
+///
+/// Only a weak handle is held across the wait, so a conversation dropped while
+/// loading — its window closed, or the panel moved on — is released, which
+/// drops the observer and ends the wait.
+async fn wait_until_loaded(
+    session_id: &acp_v2::SessionId,
+    conversation: WeakEntity<ConversationView>,
+    cx: &mut AsyncApp,
+) -> Result<()> {
+    let (notified_tx, mut notified_rx) = futures::channel::mpsc::unbounded::<()>();
+    let _observation = cx.update(|cx| {
+        let conversation = conversation.upgrade()?;
+        Some(cx.observe(&conversation, move |_, _| {
+            notified_tx.unbounded_send(()).ok();
+        }))
+    });
+    let closed =
+        || anyhow!("open agent session {session_id}: the conversation closed before it loaded");
+    loop {
+        let state = conversation
+            .read_with(cx, |view, _| {
+                if view.is_loading() {
+                    None
+                } else {
+                    Some(view.load_error().map(ToString::to_string))
+                }
+            })
+            .map_err(|_| closed())?;
+        match state {
+            Some(None) => return Ok(()),
+            Some(Some(error)) => {
+                return Err(anyhow!(
+                    "open agent session {session_id}: the thread failed to load: {error}"
+                ));
+            }
+            None => {
+                if notified_rx.next().await.is_none() {
+                    return Err(closed());
+                }
+            }
+        }
+    }
+}
