new file mode 100644
index 0000000..ba3e09d
--- /dev/null
+++ b/crates/zed/src/zed/agent_session_route_tests.rs
@@ -0,0 +1,168 @@
+// Story 024, task 2.2 — the tray route (`zeo://agent?session=`) opens a session in its
+// project's window, from another focused window (R2.2, R1.5). The first test of `0024`'s
+// window routing. Wired in `src/zed.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "zed/agent_session_route_tests.rs"]
+//     mod agent_session_route;
+//
+// so it reaches `tests::init_test` (a sibling inside `zed`) and the crate root's private
+// `handle_open_request`. Validation filter: `agent_session_route`.
+//
+// Hostile first: the focused window B's folder `/work/zed-patches` carries A's `/work/zed` as
+// a prefix.
+
+use std::path::PathBuf;
+
+use agent_client_protocol::schema::v2 as acp;
+use agent_ui::AgentPanel;
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use gpui::{AnyWindowHandle, AppContext as _, Entity, TestAppContext};
+use serde_json::json;
+use workspace::{MultiWorkspace, OpenMode, OpenOptions, PathList, Workspace};
+
+use super::open_listener::{OpenRequest, OpenRequestKind};
+use super::tests::init_test;
+
+async fn open_window(
+    path: &str,
+    app_state: &std::sync::Arc<workspace::AppState>,
+    cx: &mut TestAppContext,
+) -> (gpui::WindowHandle<MultiWorkspace>, Entity<Workspace>) {
+    let opened = cx
+        .update(|cx| {
+            workspace::open_paths(
+                &[PathBuf::from(path)],
+                app_state.clone(),
+                OpenOptions {
+                    open_mode: OpenMode::NewWindow,
+                    ..Default::default()
+                },
+                cx,
+            )
+        })
+        .await
+        .expect("the window opens");
+    let panels = opened
+        .workspace
+        .update(cx, |workspace, _| workspace.take_panels_task());
+    if let Some(panels) = panels {
+        panels.await.expect("the panels load");
+    }
+    // The test init registers no agent panel (Zeo loads it through `initialize_panels`
+    // with AI enabled); give each window the test one, before the route runs.
+    let workspace = opened.workspace.clone();
+    opened
+        .window
+        .update(cx, |_, window, cx| {
+            workspace.update(cx, |workspace, cx| {
+                if workspace.panel::<AgentPanel>(cx).is_none() {
+                    let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+                    workspace.add_panel(panel, window, cx);
+                }
+            })
+        })
+        .unwrap();
+    cx.run_until_parked();
+    (opened.window, opened.workspace)
+}
+
+fn agent_panel(workspace: &Entity<Workspace>, cx: &mut TestAppContext) -> Entity<AgentPanel> {
+    workspace
+        .read_with(cx, |workspace, cx| workspace.panel::<AgentPanel>(cx))
+        .expect("the window carries an agent panel")
+}
+
+fn shows(panel: &Entity<AgentPanel>, thread_id: ThreadId, cx: &mut TestAppContext) -> bool {
+    panel.read_with(cx, |panel, cx| {
+        panel.active_thread_id(cx) == Some(thread_id)
+    })
+}
+
+#[gpui::test]
+async fn agent_session_route_opens_a_session_in_its_project_window_from_another(
+    cx: &mut TestAppContext,
+) {
+    let app_state = init_test(cx);
+    let fs = app_state.fs.as_fake();
+    fs.insert_tree("/work/zed", json!({ "file.txt": "" })).await;
+    fs.insert_tree("/work/zed-patches", json!({ "file.txt": "" }))
+        .await;
+
+    let (window_a, workspace_a) = open_window("/work/zed", &app_state, cx).await;
+    let (window_b, workspace_b) = open_window("/work/zed-patches", &app_state, cx).await;
+    assert_ne!(window_a, window_b, "precondition: two windows");
+
+    let session = acp::SessionId::new("tray-session-of-a");
+    let thread_id = ThreadId::new();
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: "stub".into(),
+                    title: Some("Thread of A".into()),
+                    title_override: None,
+                    updated_at: chrono::Utc::now(),
+                    created_at: None,
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(&PathList::new(&[
+                        PathBuf::from("/work/zed"),
+                    ])),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    window_b
+        .update(cx, |_, window, _| window.activate_window())
+        .unwrap();
+    cx.run_until_parked();
+    let b: AnyWindowHandle = window_b.into();
+    assert_eq!(
+        cx.update(|cx| cx.active_window()),
+        Some(b),
+        "precondition: B is focused"
+    );
+    let windows = cx.update(|cx| cx.windows().len());
+
+    let request = OpenRequest {
+        kind: Some(OpenRequestKind::AgentPanel {
+            external_source_prompt: None,
+            session_id: Some(session.clone()),
+            cwd: None,
+        }),
+        ..Default::default()
+    };
+    cx.update(|cx| crate::handle_open_request(request, app_state.clone(), cx));
+    cx.run_until_parked();
+
+    let a: AnyWindowHandle = window_a.into();
+    assert_eq!(cx.update(|cx| cx.active_window()), Some(a), "A is raised");
+    let panel_a = agent_panel(&workspace_a, cx);
+    let panel_b = agent_panel(&workspace_b, cx);
+    assert!(
+        shows(&panel_a, thread_id, cx),
+        "A's agent panel holds the thread"
+    );
+    assert!(!shows(&panel_b, thread_id, cx), "B's agent panel does not");
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    let folders = cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_by_session(&session)
+            .map(|metadata| metadata.folder_paths().paths().to_vec())
+    });
+    assert_eq!(
+        folders,
+        Some(vec![PathBuf::from("/work/zed")]),
+        "the row keeps A's folder"
+    );
+}
