+}
+
+// R1.6 — the target window closes while the router waits for its agent panel: the wait
+// ends at once with an `Err` saying so, rather than running to the safety-net timeout.
+#[gpui::test]
+async fn agent_session_router_stops_waiting_when_the_target_window_closes(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let target = window(&fs, &["/work/zed"], cx).await;
+    let mut fallback = window(&fs, &["/work/zed-patches"], cx).await;
+    let fallback_panel = add_agent_panel(&fallback.workspace, &mut fallback.cx);
+    let session = acp_v2::SessionId::new("session-of-a-window-closed-mid-wait");
+    let thread_id = save_row(&session, &["/work/zed"], cx);
