+// Story 024, task 2.1, tech-review fix cycle 1: the routing cases the review found
+// uncovered. The pre-authored cases live in `routing_tests.rs`, which is frozen; the few
+// fixture helpers below mirror the ones it defines privately.
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use agent_client_protocol::schema::v2 as acp_v2;
+use fs::FakeFs;
+use gpui::{
+    AnyWindowHandle, AppContext as _, Entity, TestAppContext, VisualTestContext, WindowHandle,
+};
+use project::Project;
+use serde_json::json;
+use settings::Settings as _;
+use workspace::{MultiWorkspace, PathList, Workspace};
