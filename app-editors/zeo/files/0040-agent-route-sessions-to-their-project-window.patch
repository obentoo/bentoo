+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    if let Ok(opened) = result {
+        assert_eq!(opened.window, a.any());
+        assert_eq!(opened.workspace, a.workspace);
+    }
+}
+
+// R1.6, Q4 — the thread cannot be opened in its window (that window has no agent panel):
+// an `Err` naming the session, never a panic, and never a silent fallback to the caller.
+#[gpui::test]
+async fn agent_session_router_returns_an_error_naming_the_session_when_it_cannot_open(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/work/zed", "/work/zed-patches"]).await;
+    let _a = window(&fs, &["/work/zed"], false, cx).await;
+    let mut b = window(&fs, &["/work/zed-patches"], true, cx).await;
+    let session = acp_v2::SessionId::new("session-of-a-window-without-agent-panel");
+    let thread_id = save_row(&session, &["/work/zed"], false, cx);
+    activate(&mut b);
+
+    let routing = route(&session, None, &b, cx);
+    cx.run_until_parked();
+    let error = match routing.await {
+        Ok(_) => panic!("a window without an agent panel cannot open the session"),
+        Err(error) => error,
+    };
+
+    assert!(
+        format!("{error:#}").contains("session-of-a-window-without-agent-panel"),
+        "the error names the session: {error:#}"
+    );
+    assert!(
+        !shows(&b.panel(), thread_id, &b.cx),
+        "no fallback to the caller's window"
+    );
+}
