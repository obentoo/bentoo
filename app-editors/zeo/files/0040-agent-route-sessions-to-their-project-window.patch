+    let error = resolved_without_waiting(routing, clock_before, cx);
+
+    let message = format!("{error:#}");
+    assert!(
+        message.contains("session-while-ai-is-disabled"),
+        "the error names the session: {message}"
+    );
+    assert!(
+        message.contains("AI is disabled"),
+        "the error says why: {message}"
+    );
+    assert_eq!(
+        cx.update(|cx| cx.windows().len()),
+        windows,
+        "no window is opened"
+    );
+    assert!(
+        !shows(&fallback_panel, thread_id, cx),
+        "no fallback to the caller's window"
