+use crate::{AgentPanel, OpenAgentSessionOptions, OpenedAgentSession, open_agent_session};
+
+fn init(cx: &mut TestAppContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+}
+
+async fn shared_fs(cx: &mut TestAppContext, roots: &[&str]) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    for root in roots {
+        fs.insert_tree(root, json!({ "file.txt": "" })).await;
+    }
+    fs
+}
+
+struct Win {
+    window: WindowHandle<MultiWorkspace>,
+    workspace: Entity<Workspace>,
+    cx: VisualTestContext,
+}
+
+impl Win {
+    fn any(&self) -> AnyWindowHandle {
+        self.window.into()
+    }
+}
+
+async fn window(fs: &Arc<FakeFs>, roots: &[&str], cx: &mut TestAppContext) -> Win {
+    let paths: Vec<&Path> = roots.iter().map(|root| Path::new(*root)).collect();
+    let project = Project::test(fs.clone(), paths, cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    let cx = VisualTestContext::from_window(window.into(), cx);
+    Win {
+        window,
+        workspace,
+        cx,
+    }
+}
+
+fn add_agent_panel(
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<AgentPanel> {
+    let panel = workspace.update_in(cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::test_new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    panel
+}
+
+fn save_row(session: &acp_v2::SessionId, folders: &[&str], cx: &mut TestAppContext) -> ThreadId {
+    let thread_id = ThreadId::new();
+    let folders: Vec<&Path> = folders.iter().map(|folder| Path::new(*folder)).collect();
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| {
+            store.save(
+                ThreadMetadata {
+                    thread_id,
+                    session_id: Some(session.clone()),
+                    agent_id: crate::Agent::Stub.id(),
+                    title: Some("Saved thread".into()),
+                    title_override: None,
+                    updated_at: chrono::Utc::now(),
+                    created_at: None,
+                    interacted_at: None,
+                    worktree_paths: project::WorktreePaths::from_folder_paths(&PathList::new(
+                        &folders,
+                    )),
+                    remote_connection: None,
+                    archived: false,
+                },
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+fn shows(panel: &Entity<AgentPanel>, thread_id: ThreadId, cx: &mut TestAppContext) -> bool {
+    panel.read_with(cx, |panel, cx| {
+        panel.active_thread_id(cx) == Some(thread_id)
+    })
+}
+
+fn visible_roots(workspace: &Entity<Workspace>, cx: &mut TestAppContext) -> BTreeSet<PathBuf> {
+    workspace.read_with(cx, |workspace, cx| {
+        workspace
+            .project()
+            .read(cx)
+            .visible_worktrees(cx)
+            .map(|worktree| worktree.read(cx).abs_path().to_path_buf())
+            .collect()
+    })
+}
+
+fn route(
+    session: &acp_v2::SessionId,
+    fallback: &Win,
+    cx: &mut TestAppContext,
+) -> gpui::Task<anyhow::Result<OpenedAgentSession>> {
+    let app_state = fallback
+        .workspace
+        .read_with(cx, |workspace, _| workspace.app_state().clone());
+    let fallback_window = fallback.any();
+    let session = session.clone();
+    cx.update(|cx| {
+        open_agent_session(
+            session,
+            OpenAgentSessionOptions {
+                cwd: None,
+                fallback_window: Some(fallback_window),
+                tool_call_id: None,
+            },
+            app_state,
+            cx,
+        )
+    })
+}
+
+/// `Agent::Stub` — the agent of every saved row here — cannot load a session, so a route
+/// that reached the thread ends in its load error; any other `Err` is a routing failure.
+fn assert_reached_the_thread(
+    result: anyhow::Result<OpenedAgentSession>,
+    window: AnyWindowHandle,
+    workspace: &Entity<Workspace>,
+) {
+    match result {
+        Ok(opened) => {
+            assert_eq!(opened.window, window);
+            assert_eq!(&opened.workspace, workspace);
+        }
+        Err(error) => assert!(
+            format!("{error:#}").contains("the thread failed to load"),
+            "routing failed before reaching the thread: {error:#}"
+        ),
+    }
+}
+
+fn activate(win: &mut Win) {
+    win.cx.update(|window, _| window.activate_window());
+    win.cx.run_until_parked();
+}
+
+// R1.2 — a window holding only part of a thread's folders is not extended with the rest:
+// the thread gets a new OS window over exactly its folders.
+#[gpui::test]
+async fn agent_session_router_opens_a_new_window_instead_of_extending_a_partial_match(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx, &["/multi/alpha", "/multi/beta"]).await;
+    let mut one = window(&fs, &["/multi/alpha"], cx).await;
+    let one_panel = add_agent_panel(&one.workspace, &mut one.cx);
+    let session = acp_v2::SessionId::new("two-folder-session");
+    let thread_id = save_row(&session, &["/multi/alpha", "/multi/beta"], cx);
+    activate(&mut one);
+    let one_roots = visible_roots(&one.workspace, cx);
+    let windows_before = cx.update(|cx| cx.windows());
+
+    let routing = route(&session, &one, cx);
+    cx.run_until_parked();
+
+    let new_windows: Vec<AnyWindowHandle> = cx
+        .update(|cx| cx.windows())
+        .into_iter()
+        .filter(|window| !windows_before.contains(window))
+        .collect();
+    assert_eq!(new_windows.len(), 1, "one new window is opened");
+    let new_window = new_windows[0]
+        .downcast::<MultiWorkspace>()
+        .expect("the new window is a workspace window");
+    let new_workspace = new_window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    // The router waits for the new window's agent panel, which the app's panel loading adds;
+    // this test app has none, so the test adds it.
+    let mut new_cx = VisualTestContext::from_window(new_windows[0], cx);
+    let new_panel = add_agent_panel(&new_workspace, &mut new_cx);
+    let opened = routing.await;
+
+    assert_eq!(
+        visible_roots(&new_workspace, cx),
+        BTreeSet::from([PathBuf::from("/multi/alpha"), PathBuf::from("/multi/beta")]),
+        "the new window holds exactly the thread's folders"
+    );
+    assert_eq!(
+        visible_roots(&one.workspace, cx),
+        one_roots,
+        "the one-folder window's project is unchanged"
+    );
+    assert!(
+        shows(&new_panel, thread_id, cx),
+        "the new window shows the thread"
+    );
+    assert!(
+        !shows(&one_panel, thread_id, cx),
+        "not the one-folder window"
+    );
+    assert_reached_the_thread(opened, new_windows[0], &new_workspace);
+}
