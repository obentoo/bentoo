+//! Code blocks and quotes in the agent composer (Zeo next proposal §6.12, ask 11).
+//!
+//! The composer is a Markdown buffer, so fences and `>` quotes are already highlighted while
+//! typing (upstream). This adds the block look — a background and a left stripe on every row of a
+//! fenced code block and of a quote — and closes a fence as it is opened: typing ``` on a line of
+//! its own, outside a block, inserts the closing fence below and leaves the cursor after the
+//! opening one, where a language name goes.
+//!
+//! Only ``` fences count; an unclosed fence runs to the end of the draft, as CommonMark reads it.
+
+use std::ops::Range;
+
+use editor::{Editor, RowHighlightOptions};
+use gpui::{App, Context, Window};
+use language::Point;
+use theme::ActiveTheme as _;
+
+/// The row-highlight type of fenced code rows.
+pub(crate) enum ComposerCodeBlock {}
+/// The row-highlight type of quote rows.
+pub(crate) enum ComposerQuote {}
+
+/// The draft's blocks, as inclusive row ranges, top to bottom.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub(crate) struct ComposerBlockRows {
+    pub code: Vec<Range<u32>>,
+    pub quote: Vec<Range<u32>>,
+}
+
+/// Whether `line` is a fence: up to three spaces, then three backticks (CommonMark).
+fn is_fence(line: &str) -> bool {
+    let indent = line.len() - line.trim_start_matches(' ').len();
+    indent <= 3 && line[indent..].starts_with("```")
+}
+
+/// Whether `line` is a quote line: up to three spaces, then `>`.
+fn is_quote(line: &str) -> bool {
+    let indent = line.len() - line.trim_start_matches(' ').len();
+    indent <= 3 && line[indent..].starts_with('>')
+}
+
+/// The rows of every fenced code block (fences included) and every run of quote lines in `text`.
+/// A range is `start..end` with `end` inclusive, so a one-row block is `r..r`.
+pub(crate) fn scan_composer_blocks(text: &str) -> ComposerBlockRows {
+    let mut rows = ComposerBlockRows::default();
+    let mut open_fence: Option<u32> = None;
+    let mut quote_start: Option<u32> = None;
+    let mut last_row = 0;
+    for (row, line) in text.split('\n').enumerate() {
+        let row = row as u32;
+        last_row = row;
+        if let Some(start) = open_fence {
+            // A closing fence carries nothing after its backticks but whitespace.
+            if is_fence(line) && line.trim().trim_start_matches('`').is_empty() {
+                rows.code.push(start..row);
+                open_fence = None;
+            }
+            continue;
+        }
+        if is_fence(line) {
+            if let Some(start) = quote_start.take() {
+                rows.quote.push(start..row - 1);
+            }
+            open_fence = Some(row);
+        } else if is_quote(line) {
+            quote_start.get_or_insert(row);
+        } else if let Some(start) = quote_start.take() {
+            rows.quote.push(start..row - 1);
+        }
+    }
+    if let Some(start) = open_fence {
+        rows.code.push(start..last_row);
+    }
+    if let Some(start) = quote_start {
+        rows.quote.push(start..last_row);
+    }
+    rows
+}
+
+/// Whether typing just completed an opening fence at `cursor` that should be closed: the line
+/// up to the cursor is a bare fence (indent and backticks only, nothing after the cursor), and
+/// the fences above it are paired, so it opens a block rather than closing one.
+pub(crate) fn fence_to_close(text: &str, cursor: usize) -> bool {
+    let line_start = text[..cursor].rfind('\n').map_or(0, |ix| ix + 1);
+    let line_end = text[cursor..]
+        .find('\n')
+        .map_or(text.len(), |ix| cursor + ix);
+    let line = &text[line_start..line_end];
+    if cursor != line_end || !is_fence(line) || line.trim() != "```" {
+        return false;
+    }
+    let fences_above = text[..line_start]
+        .split('\n')
+        .filter(|line| is_fence(line))
+        .count();
+    fences_above % 2 == 0
+}
+
+/// Re-highlights the composer's blocks from its text as it stands.
+pub(crate) fn refresh_composer_blocks(editor: &mut Editor, cx: &mut Context<Editor>) {
+    let snapshot = editor.buffer().read(cx).snapshot(cx);
+    let rows = scan_composer_blocks(&snapshot.text());
+    editor.clear_row_highlights::<ComposerCodeBlock>();
+    editor.clear_row_highlights::<ComposerQuote>();
+    editor.set_row_highlight_left_border::<ComposerCodeBlock>(Some(|cx: &App| {
+        cx.theme().colors().border
+    }));
+    editor.set_row_highlight_left_border::<ComposerQuote>(Some(|cx: &App| {
+        cx.theme().colors().text_muted
+    }));
+    let options = RowHighlightOptions {
+        autoscroll: false,
+        include_gutter: false,
+    };
+    let anchor_range = |rows: &Range<u32>| {
+        let end = Point::new(
+            rows.end,
+            snapshot.line_len(multi_buffer::MultiBufferRow(rows.end)),
+        );
+        snapshot.anchor_before(Point::new(rows.start, 0))..snapshot.anchor_after(end)
+    };
+    for block in &rows.code {
+        editor.highlight_rows::<ComposerCodeBlock>(
+            anchor_range(block),
+            |cx| cx.theme().colors().element_background,
+            options,
+            cx,
+        );
+    }
+    for block in &rows.quote {
+        editor.highlight_rows::<ComposerQuote>(
+            anchor_range(block),
+            |cx| cx.theme().colors().ghost_element_hover,
+            options,
+            cx,
+        );
+    }
+}
+
+/// After typed input, closes a fence the input just opened. The closing fence is its own undo
+/// step, so one undo takes it back and leaves what was typed.
+pub(crate) fn close_opened_fence(
+    editor: &mut Editor,
+    window: &mut Window,
+    cx: &mut Context<Editor>,
+) {
+    if editor.read_only(cx) {
+        return;
+    }
+    let display_snapshot = editor.display_snapshot(cx);
+    let selections = editor.selections.all::<Point>(&display_snapshot);
+    let [selection] = selections.as_slice() else {
+        return;
+    };
+    if !selection.is_empty() {
+        return;
+    }
+    let cursor = selection.head();
+    let snapshot = editor.buffer().read(cx).snapshot(cx);
+    let cursor_offset = snapshot.point_to_offset(cursor).0;
+    if !fence_to_close(&snapshot.text(), cursor_offset) {
+        return;
+    }
+    editor.finalize_last_transaction(cx);
+    editor.edit([(cursor..cursor, "\n```")], cx);
+    editor.change_selections(Default::default(), window, cx, |selections| {
+        selections.select_ranges([cursor..cursor]);
+    });
+    editor.finalize_last_transaction(cx);
+}
+
