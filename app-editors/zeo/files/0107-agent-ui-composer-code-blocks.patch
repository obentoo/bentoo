+// Zeo next proposal §6.12 (ask 11): code blocks and quotes in the agent composer.
+// Filter: `composer_blocks`.
+
+use std::ops::Range;
+use std::path::Path;
+
+use editor::{Editor, EditorMode};
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, EntityInputHandler as _, TestAppContext, VisualTestContext};
+use language::Point;
+use multi_buffer::ToPoint as _;
+use pretty_assertions::assert_eq;
+use project::Project;
+use serde_json::json;
+use util::path;
+use workspace::MultiWorkspace;
+
+use super::*;
+use crate::conversation_view::tests::init_test;
+use crate::message_editor::MessageEditor;
+
+fn rows(code: &[Range<u32>], quote: &[Range<u32>]) -> ComposerBlockRows {
+    ComposerBlockRows {
+        code: code.to_vec(),
+        quote: quote.to_vec(),
+    }
+}
+
+#[test]
+fn a_fenced_block_spans_its_fences() {
+    let text = "intro\n```rust\nlet x = 1;\n```\nafter";
+    assert_eq!(scan_composer_blocks(text), rows(&[1..3], &[]));
+}
+
+#[test]
+fn an_unclosed_fence_runs_to_the_end() {
+    assert_eq!(scan_composer_blocks("a\n```\nb\nc"), rows(&[1..3], &[]));
+}
+
+#[test]
+fn a_fence_with_text_after_it_does_not_close_a_block() {
+    // "```rust" inside a block is content, as CommonMark reads it.
+    let text = "```\n```rust\n```";
+    assert_eq!(scan_composer_blocks(text), rows(&[0..2], &[]));
+}
+
+#[test]
+fn quote_lines_group_into_runs_and_not_inside_code() {
+    let text = "> one\n> two\nplain\n```\n> not a quote\n```\n  > three";
+    assert_eq!(scan_composer_blocks(text), rows(&[3..5], &[0..1, 6..6]));
+}
+
+#[test]
+fn four_spaces_of_indent_is_neither_a_fence_nor_a_quote() {
+    assert_eq!(scan_composer_blocks("    ```\n    > q"), rows(&[], &[]));
+}
+
+#[test]
+fn only_an_opening_bare_fence_at_the_cursor_is_closed() {
+    assert!(fence_to_close("```", 3));
+    assert!(fence_to_close("text\n  ```", 10));
+    // The cursor is not at the end of the fence.
+    assert!(!fence_to_close("```", 2));
+    // Something follows the backticks.
+    assert!(!fence_to_close("````", 4));
+    // An odd number of fences above: this one closes a block.
+    assert!(!fence_to_close("```\ncode\n```", 12));
+    // Two fences above: a new block opens.
+    assert!(fence_to_close("```\ncode\n```\n```", 16));
+}
+
+/// The composer's editor, with the `MessageEditor` that owns it: the subscriptions under test
+/// live as long as that entity, so a test must hold it.
+async fn composer(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<MessageEditor>,
+    Entity<Editor>,
+    &mut VisualTestContext,
+) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/project", json!({"file": ""})).await;
+    let project = Project::test(fs, [Path::new(path!("/project"))], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let message_editor = cx.update(|window, cx| {
+        cx.new(|cx| {
+            MessageEditor::new(
+                workspace.downgrade(),
+                project.downgrade(),
+                None,
+                Default::default(),
+                "Test Agent".into(),
+                "Test",
+                EditorMode::AutoHeight {
+                    min_lines: 1,
+                    max_lines: None,
+                },
+                window,
+                cx,
+            )
+        })
+    });
+    let editor = message_editor.read_with(cx, |message_editor, _| message_editor.editor().clone());
+    cx.run_until_parked();
+    (message_editor, editor, cx)
+}
+
+fn highlighted<T: 'static>(editor: &Entity<Editor>, cx: &mut VisualTestContext) -> Vec<Range<u32>> {
+    editor.update(cx, |editor, cx| {
+        let snapshot = editor.buffer().read(cx).snapshot(cx);
+        editor
+            .highlighted_rows::<T>(cx)
+            .map(|(range, _)| {
+                range.start.to_point(&snapshot).row..range.end.to_point(&snapshot).row
+            })
+            .collect()
+    })
+}
+
+/// Types the way the platform delivers a keystroke's text, through
+/// `EntityInputHandler::replace_text_in_range`: that path emits `EditorEvent::InputHandled`,
+/// which `Editor::handle_input` alone does not.
+fn type_text(editor: &Entity<Editor>, text: &str, cx: &mut VisualTestContext) {
+    for ch in text.chars() {
+        editor.update_in(cx, |editor, window, cx| {
+            editor.replace_text_in_range(None, &ch.to_string(), window, cx)
+        });
+        cx.run_until_parked();
+    }
+}
+
+fn text_and_cursor(editor: &Entity<Editor>, cx: &mut VisualTestContext) -> (String, Point) {
+    editor.update(cx, |editor, cx| {
+        let display_snapshot = editor.display_snapshot(cx);
+        let cursor = editor.selections.newest::<Point>(&display_snapshot).head();
+        (editor.text(cx), cursor)
+    })
+}
+
+#[gpui::test]
+async fn typing_a_fence_closes_it_and_one_undo_takes_the_closing_back(cx: &mut TestAppContext) {
+    let (_message_editor, editor, cx) = composer(cx).await;
+    type_text(&editor, "```", cx);
+    assert_eq!(
+        text_and_cursor(&editor, cx),
+        ("```\n```".to_string(), Point::new(0, 3)),
+        "the closing fence is below, the cursor after the opening one"
+    );
+    assert_eq!(highlighted::<ComposerCodeBlock>(&editor, cx), vec![0..1]);
+
+    editor.update_in(cx, |editor, window, cx| {
+        editor.undo(&Default::default(), window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        text_and_cursor(&editor, cx).0,
+        "```",
+        "one undo takes the closing fence back, and only it"
+    );
+
+    // Typing goes on where it was: a language name after the opening fence.
+    editor.update_in(cx, |editor, window, cx| {
+        editor.redo(&Default::default(), window, cx)
+    });
+    cx.run_until_parked();
+    editor.update_in(cx, |editor, window, cx| {
+        editor.change_selections(Default::default(), window, cx, |selections| {
+            selections.select_ranges([Point::new(0, 3)..Point::new(0, 3)])
+        })
+    });
+    type_text(&editor, "rust", cx);
+    assert_eq!(text_and_cursor(&editor, cx).0, "```rust\n```");
+}
+
+#[gpui::test]
+async fn a_fence_that_closes_a_block_is_left_alone(cx: &mut TestAppContext) {
+    let (_message_editor, editor, cx) = composer(cx).await;
+    editor.update_in(cx, |editor, window, cx| {
+        editor.set_text("```\ncode\n", window, cx);
+        editor.move_to_end(&Default::default(), window, cx);
+    });
+    cx.run_until_parked();
+    type_text(&editor, "```", cx);
+    assert_eq!(text_and_cursor(&editor, cx).0, "```\ncode\n```");
+    assert_eq!(highlighted::<ComposerCodeBlock>(&editor, cx), vec![0..2]);
+}
+
+#[gpui::test]
+async fn quotes_and_code_get_the_block_look_and_lose_it_when_removed(cx: &mut TestAppContext) {
+    let (_message_editor, editor, cx) = composer(cx).await;
+    editor.update_in(cx, |editor, window, cx| {
+        editor.set_text("> a\n> b\nplain\n```\nx\n```", window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(highlighted::<ComposerQuote>(&editor, cx), vec![0..1]);
+    assert_eq!(highlighted::<ComposerCodeBlock>(&editor, cx), vec![3..5]);
+    editor.update_in(cx, |editor, window, cx| {
+        let rows = editor.highlighted_display_rows(window, cx);
+        assert!(
+            rows.values()
+                .all(|highlight| highlight.left_border.is_some()),
+            "every block row carries the left stripe"
+        );
+        assert_eq!(rows.len(), 5);
+    });
+
+    editor.update_in(cx, |editor, window, cx| {
+        editor.set_text("plain", window, cx)
+    });
+    cx.run_until_parked();
+    assert!(highlighted::<ComposerQuote>(&editor, cx).is_empty());
+    assert!(highlighted::<ComposerCodeBlock>(&editor, cx).is_empty());
+}
