+    /// Reopens a thread by its agent session id, with the agent that owns it.
+    ///
+    /// `open_thread` is the share-link entry and resolves every id to the
+    /// native agent. A session an external agent owns then fails with "no
+    /// thread found", and the metadata row is rebound to this workspace's
+    /// folders on the way, moving the thread out of its own project. This reads
+    /// the agent and the folders off the row instead -- what the sidebar does
+    /// when a thread is clicked -- and only falls back to `open_thread` when
+    /// this machine has no row for the session at all.
+    pub fn open_thread_by_session(
+        &mut self,
+        session_id: acp_v2::SessionId,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let metadata = ThreadMetadataStore::try_global(cx)
+            .and_then(|store| store.read(cx).entry_by_session(&session_id).cloned());
+        let Some(metadata) = metadata else {
+            self.open_thread(session_id, None, None, window, cx);
+            return;
+        };
+        self.load_agent_thread(
+            crate::Agent::from(metadata.agent_id.clone()),
+            metadata.thread_id,
+            Some(metadata.folder_paths().clone()),
+            metadata.title.clone(),
+            true,
+            AgentThreadSource::AgentPanel,
+            window,
+            cx,
+        );
+    }
