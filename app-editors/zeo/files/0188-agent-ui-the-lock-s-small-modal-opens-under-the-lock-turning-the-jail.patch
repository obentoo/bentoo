+/// The lock's popover, while it is open (operator, 2026-11-25: no longer a workspace modal).
 fn quick_modal(win: &mut Win) -> Option<Entity<AgentJailQuickModal>> {
-    win.workspace.read_with(&mut win.cx, |workspace, cx| {
