+
+// Operator, 2026-11-25: the small modal opens right under the lock, and turning the jail on asks
+// once, then restarts the agent inside the jail. Hostile halves first: a centred modal fails the
+// position check; Cancel must neither save nor restart; a restart before the saved setting lands
+// would restart the agent still outside the jail.
+
+#[gpui::test]
+async fn quick_modal_opens_under_the_lock(cx: &mut TestAppContext) {
+    let fs = init(cx);
+    cx.update(|cx| LaunchRegistry::register(record("/w/app", Reason::Off, None), cx));
+    let mut win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    let lock = win.cx.debug_bounds("ICON-LockOff").expect("open lock");
+    click(&mut win, "ICON-LockOff");
+    assert!(quick_modal(&mut win).is_some(), "the popover is open");
+    let modal = win
+        .cx
+        .debug_bounds("agent-jail-quick-modal")
+        .expect("the popover is drawn");
+    assert!(
+        modal.top() >= lock.bottom(),
+        "it starts under the lock: popover {modal:?}, lock {lock:?}"
+    );
+    assert!(
+        (modal.left() - lock.left()).abs() < gpui::px(24.),
+        "and lines up with it: popover {modal:?}, lock {lock:?}"
+    );
+}
+
+#[gpui::test]
+async fn quick_modal_turning_on_asks_and_cancel_changes_nothing(cx: &mut TestAppContext) {
+    let fs = init(cx);
+    cx.update(|cx| LaunchRegistry::register(record("/w/app", Reason::Off, None), cx));
+    let mut win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    let before = thread_on_screen(&mut win);
+    click(&mut win, "ICON-LockOff");
+    click(&mut win, "agent-jail-quick-switch");
+    assert!(
+        win.cx.has_pending_prompt(),
+        "turning the jail on asks first"
+    );
+    win.cx.simulate_prompt_answer("Cancel");
+    win.cx.run_until_parked();
+    assert_eq!(
+        thread_on_screen(&mut win),
+        before,
+        "Cancel restarts nothing"
+    );
+    let saved = fs
+        .load(paths::settings_file().as_path())
+        .await
+        .unwrap_or_default();
+    assert!(
+        !saved.contains("agent_sandbox"),
+        "and saves nothing: {saved}"
+    );
+}
+
+#[gpui::test]
+async fn quick_modal_turning_on_restarts_once_the_setting_lands(cx: &mut TestAppContext) {
+    let fs = init(cx);
+    cx.update(|cx| LaunchRegistry::register(record("/w/app", Reason::Off, None), cx));
+    let mut win = window_with_stub_thread(&fs, &["/w/app"], cx).await;
+    win.cx.run_until_parked();
+    let before = thread_on_screen(&mut win);
+    click(&mut win, "ICON-LockOff");
+    click(&mut win, "agent-jail-quick-switch");
+    win.cx.simulate_prompt_answer("Turn On and Restart");
+    win.cx.run_until_parked();
+    let saved = fs
+        .load(paths::settings_file().as_path())
+        .await
+        .expect("the switch saved the settings file");
+    assert!(
+        saved.contains("\"enabled\": true"),
+        "the project is on: {saved}"
+    );
+    // The settings file's watcher has handed the saved value back by now (the test settings
+    // store reloads it): the restart waits for that, so the new agent starts inside the jail.
+    let jailed = win.cx.update(|_, cx| {
+        crate::agent_jail_quick_modal::jailed_on_next_start(
+            &AgentId::new("Test"),
+            Path::new("/w/app"),
+            cx,
+        )
+    });
+    assert!(jailed, "the setting of now jails the next start");
+    assert_ne!(
+        thread_on_screen(&mut win),
+        before,
+        "the agent restarted, without a second question"
+    );
+    assert!(!win.cx.has_pending_prompt());
+}
