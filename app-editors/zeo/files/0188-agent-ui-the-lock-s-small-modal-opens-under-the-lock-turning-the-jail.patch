+/// The entity of the thread on screen: a restart rebuilds it.
+fn thread_on_screen(win: &mut Win) -> gpui::EntityId {
+    win.panel.read_with(&mut win.cx, |panel, cx| {
+        panel
+            .active_conversation_view()
+            .expect("a conversation")
+            .read(cx)
+            .active_thread()
+            .expect("a thread")
+            .entity_id()
+    })
+}
+
+fn click(win: &mut Win, selector: &'static str) {
+    let bounds = win
+        .cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is drawn"));
+    win.cx
+        .simulate_click(bounds.center(), gpui::Modifiers::default());
+    win.cx.run_until_parked();
+}
