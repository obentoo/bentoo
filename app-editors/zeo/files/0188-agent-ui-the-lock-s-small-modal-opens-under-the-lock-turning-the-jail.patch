             self.jail_on(cx),
             move |toggle, window, cx| {
-                log::info!(
-                    "agent_sandbox event=quick_modal_toggle on={}",
-                    *toggle == ToggleState::Selected
-                );
-                // The page's own path: only `enabled` is written, and turning off asks first.
-                agent_sandbox::confirm::set_project_enabled(
-                    &root,
-                    *toggle == ToggleState::Selected,
-                    window,
-                    cx,
-                )
-                .detach();
+                let on = *toggle == ToggleState::Selected;
+                this.update(cx, |this, cx| this.set_jail(on, window, cx))
+                    .log_err();
             },
         )
         .tab_index(0);
