+/// How long a confirmed turn-on waits for its saved setting to come back through the settings
+/// file before giving up on the restart. The save is local, so this is generous.
+const SETTING_LANDS_WITHIN: Duration = Duration::from_secs(10);
+
+/// What restarts this thread's agent, without asking again: the turn-on confirmation already
+/// said a turn in progress stops.
+pub type RestartAgent = Rc<dyn Fn(&mut Window, &mut App)>;
+
 pub struct AgentJailQuickModal {
     agent_id: AgentId,
     root: PathBuf,
+    restart: RestartAgent,
+    /// A turn-on confirmation is open. One click reaches the switch's handler up to three times
+    /// (SwitchField's row, its Switch and, with a tab index, the Switch's inner element all
+    /// carry it), and each would open its own prompt, replacing the one before.
+    asking: bool,
     focus_handle: FocusHandle,
     _settings: Subscription,
 }
 
+/// Whether the next start of `agent_id` in `root` would be jailed, as the lock reads it.
+pub fn jailed_on_next_start(agent_id: &AgentId, root: &std::path::Path, cx: &App) -> bool {
+    LaunchRegistry::get(agent_id, root, cx)
+        .and_then(|record| {
+            launch::jailed_on_next_start(&record, AgentSandboxSettings::get_global(cx))
+        })
+        .unwrap_or(false)
+}
+
 impl AgentJailQuickModal {
-    pub fn new(agent_id: AgentId, root: PathBuf, cx: &mut Context<Self>) -> Self {
+    pub fn new(
+        agent_id: AgentId,
+        root: PathBuf,
+        restart: RestartAgent,
+        cx: &mut Context<Self>,
+    ) -> Self {
         Self {
             agent_id,
             root,
+            restart,
+            asking: false,
             focus_handle: cx.focus_handle(),
             // The switch shows the setting of now: a change saved from here, or from the page in
             // another window, redraws it.
@@ -37,11 +72,98 @@ impl AgentJailQuickModal {
 
     /// Whether the next start of this thread's agent would be jailed, as the lock reads it.
     pub fn jail_on(&self, cx: &App) -> bool {
-        LaunchRegistry::get(&self.agent_id, &self.root, cx)
-            .and_then(|record| {
-                launch::jailed_on_next_start(&record, AgentSandboxSettings::get_global(cx))
+        jailed_on_next_start(&self.agent_id, &self.root, cx)
+    }
+
+    /// The switch. Off goes the page's way (only `enabled` is written, and it asks first). On asks
+    /// "turn on and restart?", saves, waits for the saved setting to land, then restarts. That
+    /// wait runs on the window, not on this popover: the confirmation takes focus, and the
+    /// popover may be gone by the time the setting comes back.
+    fn set_jail(&mut self, on: bool, window: &mut Window, cx: &mut Context<Self>) {
+        if self.asking {
+            return;
+        }
+        log::info!("agent_sandbox event=quick_modal_toggle on={on}");
+        if !on {
+            let turning_off =
+                agent_sandbox::confirm::set_project_enabled(&self.root, false, window, cx);
+            self.asking = true;
+            cx.spawn(async move |this, cx| {
+                turning_off.await;
+                this.update(cx, |this, _| this.asking = false).ok();
             })
-            .unwrap_or(false)
+            .detach();
+            return;
+        }
+        let name = self
+            .root
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_else(|| self.root.to_string_lossy().into_owned());
+        let consent = agent_sandbox::confirm::confirm_turn_on_and_restart(&name, window, cx);
+        self.asking = true;
+        let (agent_id, root, restart) = (
+            self.agent_id.clone(),
+            self.root.clone(),
+            self.restart.clone(),
+        );
+        window
+            .spawn(cx, async move |cx| {
+                if !consent.await {
+                    log::info!("agent_sandbox event=quick_modal_turn_on outcome=cancelled");
+                    return;
+                }
+                let Some(save) = cx
+                    .update(|window, cx| {
+                        agent_sandbox::confirm::set_project_enabled(&root, true, window, cx)
+                    })
+                    .log_err()
+                else {
+                    return;
+                };
+                if !save.await {
+                    log::warn!("agent_sandbox event=quick_modal_turn_on outcome=not_saved");
+                    return;
+                }
+                let (landed_tx, mut landed) = mpsc::unbounded::<()>();
+                let Some(_watch) = cx
+                    .update(|_, cx| {
+                        cx.observe_global::<SettingsStore>(move |_| {
+                            landed_tx.unbounded_send(()).ok();
+                        })
+                    })
+                    .log_err()
+                else {
+                    return;
+                };
+                let mut deadline = cx.background_executor().timer(SETTING_LANDS_WITHIN).fuse();
+                loop {
+                    let Some(on) = cx
+                        .update(|_, cx| jailed_on_next_start(&agent_id, &root, cx))
+                        .log_err()
+                    else {
+                        return;
+                    };
+                    if on {
+                        log::info!("agent_sandbox event=quick_modal_turn_on outcome=restarting");
+                        cx.update(|window, cx| restart(window, cx)).log_err();
+                        return;
+                    }
+                    futures::select_biased! {
+                        _ = landed.next() => {}
+                        _ = deadline => {
+                            log::warn!(
+                                "agent_sandbox event=quick_modal_turn_on outcome=setting_not_seen \
+                                 waited_secs={}",
+                                SETTING_LANDS_WITHIN.as_secs()
+                            );
+                            return;
+                        }
+                    }
+                }
+            })
+            .detach();
+        cx.emit(DismissEvent);
     }
 
     fn open_advanced(&mut self, window: &mut Window, cx: &mut Context<Self>) {
@@ -68,25 +190,16 @@ impl Focusable for AgentJailQuickModal {
 
