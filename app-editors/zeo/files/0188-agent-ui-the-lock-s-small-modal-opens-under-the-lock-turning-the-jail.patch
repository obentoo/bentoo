+//! and turning the switch on asks once and restarts the agent inside the jail, instead of
+//! leaving an amber lock to click.
 
-use std::path::PathBuf;
+use std::{path::PathBuf, rc::Rc, time::Duration};
 
 use agent_sandbox::{AgentSandboxSettings, LaunchRegistry, launch};
+use futures::{FutureExt as _, StreamExt as _, channel::mpsc};
 use gpui::{
     App, Context, DismissEvent, EventEmitter, FocusHandle, Focusable, Render, Subscription, Window,
 };
 use project::agent_server_store::AgentId;
 use settings::{Settings as _, SettingsStore};
 use ui::{SwitchField, ToggleState, prelude::*};
+use util::ResultExt as _;
