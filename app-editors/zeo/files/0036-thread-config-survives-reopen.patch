@@ -0,0 +1,197 @@
+//! Task 3.2 — mode changes reach the recorder (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod recorder_mode_tests;` in `acp.rs`.
+
+use super::thread_config_test_support::*;
+use super::*;
+
+const AGENT: &str = "Mode Agent";
+
+fn mode_script() -> AgentScript {
+    AgentScript {
+        agent_id: AGENT,
+        new_session_id: "rm-created",
+        modes: Some(modes("default", &["default", "plan", "acceptEdits"])),
+        rejected_modes: vec!["plan"],
+        ..Default::default()
+    }
+}
+
+#[gpui::test]
+async fn recorder_mode_ignores_a_rejected_mode_and_records_an_accepted_one(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.8 (hostile: `set_mode` writes the mode optimistically before the
+    // agent answers), then R1.2.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    let _thread = agent.load("rm-pick", cx).await;
+
+    assert!(agent.pick_mode("rm-pick", "plan", cx).await.is_err());
+    assert_ne!(
+        recorded(AGENT, "rm-pick", cx)
+            .and_then(|config| config.mode)
+            .as_deref(),
+        Some("plan"),
+        "a rejected mode must not be recorded"
+    );
+
+    agent
+        .pick_mode("rm-pick", "acceptEdits", cx)
+        .await
+        .expect("accepted mode");
+    let config = recorded(AGENT, "rm-pick", cx).expect("an accepted mode is recorded");
+    assert_eq!(config.mode.as_deref(), Some("acceptEdits"));
+
+    assert!(agent.pick_mode("rm-pick", "plan", cx).await.is_err());
+    assert_eq!(
+        recorded(AGENT, "rm-pick", cx)
+            .expect("record kept")
+            .mode
+            .as_deref(),
+        Some("acceptEdits"),
+        "a rejected mode leaves the recorded mode unchanged"
+    );
+}
+
+#[gpui::test]
+async fn recorder_mode_records_a_current_mode_update_from_the_agent(cx: &mut gpui::TestAppContext) {
+    // R1.4
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    let _thread = agent.load("rm-update", cx).await;
+
+    agent.notify(
+        "rm-update",
+        acp::SessionUpdate::CurrentModeUpdate(acp::CurrentModeUpdate::new(
+            acp::SessionModeId::new("plan"),
+        )),
+        cx,
+    );
+
+    let config = recorded(AGENT, "rm-update", cx).expect("an agent mode update is recorded");
+    assert_eq!(config.mode.as_deref(), Some("plan"));
+    assert!(
+        config.options.is_empty(),
+        "a modes-only agent records no options"
+    );
+}
+
+#[gpui::test]
+async fn recorder_mode_keeps_the_reverted_mode_when_a_rejection_lands_after_an_accepted_one(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.8 — two mode picks in flight: `acceptEdits` is accepted and answered
+    // first while the cell already holds the optimistic `plan`; `plan` is then
+    // rejected and reverted. The final record must follow the reverted cell.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            gated: true,
+            ..mode_script()
+        },
+        project,
+        cx,
+    )
+    .await;
+    let _thread = agent.load("rm-race", cx).await;
+
+    let picks = agent.start_mode_picks("rm-race", &["acceptEdits", "plan"], cx);
+    cx.run_until_parked();
+    agent.open_gate(cx);
+    let mut results = Vec::new();
+    for pick in picks {
+        results.push(pick.await.is_ok());
+    }
+    cx.run_until_parked();
+
+    assert_eq!(
+        results,
+        vec![true, false],
+        "acceptEdits accepted, plan rejected"
+    );
+    assert_eq!(
+        agent.current_mode("rm-race").as_deref(),
+        Some("acceptEdits")
+    );
+    assert_eq!(
+        recorded(AGENT, "rm-race", cx)
+            .expect("recorded")
+            .mode
+            .as_deref(),
+        Some("acceptEdits"),
+        "the rejected optimistic mode must not survive in the record"
+    );
+}
+
+#[gpui::test]
+async fn recorder_mode_records_the_agents_mode_when_a_new_sessions_default_mode_is_rejected(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.6 hostile half: the entry's default mode is written optimistically,
+    // rejected and reverted — the record holds the agent's mode.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    agent.set_defaults(Some("plan"), Vec::new());
+
+    let _thread = agent.new_session(cx).await;
+
+    assert_eq!(agent.current_mode("rm-created").as_deref(), Some("default"));
+    assert_eq!(
+        recorded(AGENT, "rm-created", cx)
+            .expect("the reverted default mode is recorded")
+            .mode
+            .as_deref(),
+        Some("default")
+    );
+}
+
+#[gpui::test]
+async fn recorder_mode_records_an_accepted_default_mode_of_a_new_session(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.6
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    agent.set_defaults(Some("acceptEdits"), Vec::new());
+
+    let _thread = agent.new_session(cx).await;
+
+    assert_eq!(agent.mode_requests(), vec!["acceptEdits".to_string()]);
+    assert_eq!(
+        recorded(AGENT, "rm-created", cx)
+            .expect("an accepted default mode is recorded")
+            .mode
+            .as_deref(),
+        Some("acceptEdits")
+    );
+}
+
+/// Two picks made back to back, both accepted: the record ends on the LAST one. Each
+/// write waits for the one before it, so the older snapshot can never land over the
+/// newer -- the order 0036's header promises.
+#[gpui::test]
+async fn recorder_mode_two_rapid_accepted_picks_record_the_last(cx: &mut gpui::TestAppContext) {
+    let project = init(cx).await;
+    let script = AgentScript {
+        rejected_modes: Vec::new(),
+        ..mode_script()
+    };
+    let agent = ConfigAgent::connect(script, project, cx).await;
+    let _thread = agent.load("rm-rapid", cx).await;
+
+    let picks = agent.start_mode_picks("rm-rapid", &["acceptEdits", "plan"], cx);
+    for pick in picks {
+        pick.await.expect("both picks are accepted");
+    }
+    cx.run_until_parked();
+
+    assert_eq!(
+        recorded(AGENT, "rm-rapid", cx)
+            .expect("the picks are recorded")
+            .mode
+            .as_deref(),
+        Some("plan"),
+        "the later pick wins"
+    );
+}
diff --git a/crates/agent_servers/src/acp/recorder_tests.rs b/crates/agent_servers/src/acp/recorder_tests.rs
new file mode 100644
index 0000000..dc02398
--- /dev/null
+++ b/crates/agent_servers/src/acp/recorder_tests.rs
@@ -0,0 +1,191 @@
+//! Task 3.1 — `ConfigRecorder`: every accepted config change is recorded
+//! (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod recorder_tests;` in `acp.rs`.
+//! Hostile half first in each test: the change that must NOT be recorded.
+
+use super::thread_config_test_support::*;
+use super::*;
+use crate::thread_config_store::RecordedValue;
+
+const PLUS: &str = "Claude Agent (Plus)";
+
+fn script() -> AgentScript {
+    AgentScript {
+        agent_id: PLUS,
+        new_session_id: "rec-created",
+        config_options: Some(vec![
+            select("model", "sonnet", &["sonnet", "opus", "haiku"]),
+            select("effort", "high", &["low", "high"]),
+            boolean("web_search", false),
+        ]),
+        rejected_values: vec![("model", serde_json::json!("haiku"))],
+        side_effect: Some(("model", "opus", boolean("fast_mode", false))),
+        ..Default::default()
+    }
+}
+
+#[gpui::test]
+async fn recorder_ignores_a_rejected_pick_and_records_an_accepted_one(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.8 (hostile), then R1.1. R1.7: a Shift pick reaches this same
+    // `set_config_option`, so it is recorded the same way.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(script(), project, cx).await;
+    let _thread = agent.load("rec-pick", cx).await;
+
+    assert!(
+        agent
+            .pick("rec-pick", "model", id_value("haiku"), cx)
+            .await
+            .is_err()
+    );
+    let after_rejection = recorded(PLUS, "rec-pick", cx);
+    assert_ne!(
+        after_rejection
+            .as_ref()
+            .and_then(|config| recorded_id(config, "model"))
+            .as_deref(),
+        Some("haiku"),
+        "a rejected pick must not be recorded"
+    );
+
+    agent
+        .pick("rec-pick", "model", id_value("opus"), cx)
+        .await
+        .expect("accepted pick");
+    let after_pick = recorded(PLUS, "rec-pick", cx).expect("an accepted pick is recorded");
+    assert_eq!(recorded_id(&after_pick, "model").as_deref(), Some("opus"));
+    assert_eq!(recorded_id(&after_pick, "effort").as_deref(), Some("high"));
+    assert_eq!(recorded_bool(&after_pick, "web_search"), Some(false));
+
+    assert!(
+        agent
+            .pick("rec-pick", "model", id_value("haiku"), cx)
+            .await
+            .is_err()
+    );
+    let after_second_rejection = recorded(PLUS, "rec-pick", cx).expect("record kept");
+    assert_eq!(
+        recorded_id(&after_second_rejection, "model").as_deref(),
+        Some("opus"),
+        "a rejected pick leaves the recorded value unchanged"
+    );
+}
+
+#[gpui::test]
+async fn recorder_records_options_that_appear_as_a_side_effect(cx: &mut gpui::TestAppContext) {
+    // R1.5: the agent's full list after the change, not just the picked option.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(script(), project, cx).await;
+    let _thread = agent.load("rec-side", cx).await;
+
+    agent
+        .pick("rec-side", "model", id_value("opus"), cx)
+        .await
+        .expect("accepted pick");
+
+    let config = recorded(PLUS, "rec-side", cx).expect("recorded");
+    assert_eq!(recorded_bool(&config, "fast_mode"), Some(false));
+    assert_eq!(recorded_id(&config, "model").as_deref(), Some("opus"));
+}
+
+#[gpui::test]
+async fn recorder_records_a_config_option_update_from_the_agent(cx: &mut gpui::TestAppContext) {
+    // R1.3
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(script(), project, cx).await;
+    let _thread = agent.load("rec-update", cx).await;
+
+    agent.notify(
+        "rec-update",
+        acp::SessionUpdate::ConfigOptionUpdate(acp::ConfigOptionUpdate::new(vec![
+            select("model", "haiku", &["sonnet", "opus", "haiku"]),
+            select("effort", "low", &["low", "high"]),
+            boolean("web_search", true),
+        ])),
+        cx,
+    );
+
+    let config = recorded(PLUS, "rec-update", cx).expect("an agent update is recorded");
+    assert_eq!(recorded_id(&config, "model").as_deref(), Some("haiku"));
+    assert_eq!(recorded_id(&config, "effort").as_deref(), Some("low"));
+    assert_eq!(recorded_bool(&config, "web_search"), Some(true));
+}
+
+#[gpui::test]
+async fn recorder_records_the_defaults_a_new_session_adopted_but_not_a_rejected_one(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.6, with the hostile half from the design's gotcha: the default for
+    // `model` is rejected and reverted, so the optimistic `haiku` must never
+    // reach the record; the accepted `web_search` default must.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(script(), project, cx).await;
+    agent.set_defaults(
+        None,
+        vec![
+            ("model", AgentConfigOptionValue::ValueId("haiku".into())),
+            ("web_search", AgentConfigOptionValue::Boolean(true)),
+        ],
+    );
+
+    let _thread = agent.new_session(cx).await;
+
+    let config = recorded(PLUS, "rec-created", cx).expect("a new session's defaults are recorded");
+    assert_eq!(recorded_bool(&config, "web_search"), Some(true));
+    assert_eq!(
+        recorded_id(&config, "model").as_deref(),
+        Some("sonnet"),
+        "the rejected default is not recorded; the agent's value is"
+    );
+}
+
+#[gpui::test]
+async fn recorder_keeps_the_agents_value_when_a_rejection_lands_after_an_accepted_change(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.8, R2.7 — two restored values in flight: `model` is accepted and
+    // answered first, `effort` is rejected and its answer is held back. The
+    // final record must hold the agent's `effort`, never the rejected `low`.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            rejected_values: vec![("effort", serde_json::json!("low"))],
+            gated: true,
+            ..script()
+        },
+        project,
+        cx,
+    )
+    .await;
+    record(
+        PLUS,
+        "rec-race",
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus".into())),
+                ("effort", RecordedValue::Id("low".into())),
+            ],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("rec-race", cx).await;
+    agent.open_gate(cx);
+
+    assert_eq!(
+        agent.option_value("rec-race", "effort"),
+        Some(serde_json::json!("high"))
+    );
+    let config = recorded(PLUS, "rec-race", cx).expect("recorded");
+    assert_eq!(recorded_id(&config, "model").as_deref(), Some("opus"));
+    assert_eq!(
+        recorded_id(&config, "effort").as_deref(),
+        Some("high"),
+        "the rejected restored value must not survive in the record"
+    );
+}
diff --git a/crates/agent_servers/src/acp/restore_mode_tests.rs b/crates/agent_servers/src/acp/restore_mode_tests.rs
