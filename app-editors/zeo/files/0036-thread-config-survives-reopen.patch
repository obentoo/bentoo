+#[test]
+fn recorded_value_kinds_stay_distinct_in_json() {
+    // Hostile half (collapse): a select whose value id is "true" is not the
+    // boolean `true`, and must not come back as one.
+    let as_id = config(None, vec![("x", RecordedValue::Id("true".into()))]);
+    let as_bool = config(None, vec![("x", RecordedValue::Bool(true))]);
+    assert_ne!(as_json(&as_id), as_json(&as_bool));
+
+    let id_back: RecordedConfig =
+        serde_json::from_value(as_json(&as_id)).expect("id record deserializes");
+    let bool_back: RecordedConfig =
+        serde_json::from_value(as_json(&as_bool)).expect("bool record deserializes");
+    assert_eq!(id_of(&id_back, "x").as_deref(), Some("true"));
+    assert_eq!(bool_of(&id_back, "x"), None);
+    assert_eq!(bool_of(&bool_back, "x"), Some(true));
