+//! Task 4.1 — deleting a thread deletes its recorded config (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod thread_config_tests;` in
+//! `thread_metadata_store.rs`. Hostile halves first: the records that must
+//! SURVIVE a deletion (same session id under another agent, another thread of
+//! the same agent, a draft with no session), then the record that must go.
+
+use super::*;
+use agent_client_protocol::schema::v2 as acp_v2;
+use agent_servers::thread_config_store::{self, RecordedConfig, RecordedValue};
+use gpui::TestAppContext;
+use project::FakeFs;
+use std::path::Path;
+
+const PLUS: &str = "Claude Agent (Plus)";
+const CODEX: &str = "Codex";
+
+fn init(cx: &mut TestAppContext) {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        cx.set_global(db::AppDatabase::test_new());
+        let settings_store = settings::SettingsStore::test(cx);
+        cx.set_global(settings_store);
+        theme_settings::init(theme::LoadThemes::JustBase, cx);
+        editor::init(cx);
+        release_channel::init("0.0.0".parse().unwrap(), cx);
+        prompt_store::init(cx);
+        <dyn Fs>::set_global(fs, cx);
+        ThreadMetadataStore::init_global(cx);
+        ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    cx.run_until_parked();
+}
+
+fn thread(agent_id: &str, session_id: Option<&str>) -> ThreadMetadata {
+    let now = Utc::now();
+    ThreadMetadata {
+        thread_id: ThreadId::new(),
+        session_id: session_id.map(|id| acp_v2::SessionId::new(id.to_string())),
+        agent_id: AgentId::new(agent_id.to_string()),
+        title: Some("Thread".into()),
+        title_override: None,
+        updated_at: now,
+        created_at: Some(now),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new("/project")])),
+        remote_connection: None,
+        archived: false,
+    }
+}
+
+fn config(model: &str) -> RecordedConfig {
+    RecordedConfig {
+        mode: Some("plan".to_string()),
+        options: [("model".to_string(), RecordedValue::Id(model.to_string()))]
+            .into_iter()
+            .collect(),
+    }
+}
+
+async fn record(agent_id: &str, session_id: &str, model: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        thread_config_store::write(
+            &AgentId::new(agent_id.to_string()),
+            &acp_v2::SessionId::new(session_id.to_string()),
+            &config(model),
+            cx,
+        )
+    })
+    .await
+    .expect("seeding a record succeeds");
+}
+
+fn has_record(agent_id: &str, session_id: &str, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| {
+        thread_config_store::read(
+            &AgentId::new(agent_id.to_string()),
+            &acp_v2::SessionId::new(session_id.to_string()),
+            cx,
+        )
+    })
+    .is_some()
+}
+
+fn save(metadata: ThreadMetadata, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
