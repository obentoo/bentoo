+#[test]
+fn recorded_config_reads_and_writes_the_documented_json_shape() {
+    // R1.9: the record outlives the process, so its JSON shape is a contract
+    // (design.md, Data Models).
+    let documented = serde_json::json!({
+        "mode": "plan",
+        "options": {
+            "model": { "kind": "Id", "value": "opus" },
+            "fast": { "kind": "Bool", "value": false }
+        }
+    });
+    let parsed: RecordedConfig =
+        serde_json::from_value(documented.clone()).expect("documented shape deserializes");
+    assert_eq!(parsed.mode.as_deref(), Some("plan"));
+    assert_eq!(id_of(&parsed, "model").as_deref(), Some("opus"));
+    assert_eq!(bool_of(&parsed, "fast"), Some(false));
+    assert_eq!(parsed.options.len(), 2);
+    assert_eq!(as_json(&parsed), documented);
+
+    let without_mode = config(None, Vec::new());
+    let back: RecordedConfig =
+        serde_json::from_value(as_json(&without_mode)).expect("empty record deserializes");
+    assert_eq!(back.mode, None);
+    assert!(back.options.is_empty());
+}
