+    /// Restores a loaded thread's recorded mode when the agent offers it and
+    /// reports another. The entry's mode default is never applied here: it
+    /// stays new-session only, as upstream has it. The request is detached,
+    /// so the load never waits on its answer.
+    fn apply_recorded_mode(
+        &self,
+        session_id: &acp_v2::SessionId,
+        modes: &Rc<RefCell<acp::SessionModeState>>,
+        recorded_mode: &str,
+        mode_trigger: &ModeTrigger,
+        cx: &mut AsyncApp,
+    ) {
+        let recorded_mode = acp::SessionModeId::new(recorded_mode.to_string());
+        let agent_mode = {
+            let mut state = modes.borrow_mut();
+            if !state
+                .available_modes
+                .iter()
+                .any(|mode| mode.id == recorded_mode)
+            {
+                log::warn!(
+                    "dropping recorded mode `{}` in {} session {}: the agent does not offer it",
+                    recorded_mode,
+                    self.id,
+                    session_id.0
+                );
+                return;
+            }
+            if state.current_mode_id == recorded_mode {
+                return;
+            }
+            std::mem::replace(&mut state.current_mode_id, recorded_mode.clone())
+        };
+
+        cx.spawn({
+            let agent_id = self.id.clone();
+            let session_id = session_id.clone();
+            let modes = modes.clone();
+            let mode_trigger = mode_trigger.clone();
+            let connection = self.connection.clone();
+            async move |_| {
+                let result = connection
+                    .send_request(acp::SetSessionModeRequest::new(
+                        acp::SessionId::new(session_id.0.clone()),
+                        recorded_mode.clone(),
+                    ))
+                    .block_task()
+                    .await;
+                let Err(error) = result else {
+                    return;
+                };
+                {
+                    let mut state = modes.borrow_mut();
+                    // A mode reported or picked while the request was pending
+                    // is newer than the one the agent had at load; keep it.
+                    if state.current_mode_id == recorded_mode {
+                        state.current_mode_id = agent_mode.clone();
+                    }
+                }
+                mode_trigger.fire();
+                log::warn!(
+                    "{} rejected recorded mode `{}` in session {}, keeping `{}`: {:?}",
+                    agent_id,
+                    recorded_mode,
+                    session_id.0,
+                    agent_mode,
+                    error
+                );
+            }
+        })
+        .detach();
+    }
+}
+
+/// What restoring one config option asks of the agent.
+#[derive(Debug, Clone, PartialEq)]
+enum Choice {
+    /// Request this value: the recorded one, or the entry default.
+    Send(acp_v2::SessionConfigOptionValue),
+    /// The agent already holds the recorded value; no request is needed.
+    Skip,
+    /// Nothing to apply: no usable record and no valid default.
+    None,
+}
+
+/// Whether a select option offers `value_id`, in any group when grouped.
+fn select_offers(select: &acp_v2::SessionConfigSelect, value_id: &str) -> bool {
+    match &select.options {
+        acp_v2::SessionConfigSelectOptions::Ungrouped(options) => {
+            options.iter().any(|opt| &*opt.value.0 == value_id)
+        }
+        acp_v2::SessionConfigSelectOptions::Grouped(groups) => groups
+            .iter()
+            .any(|group| group.options.iter().any(|opt| &*opt.value.0 == value_id)),
+        _ => false,
+    }
+}
+
+/// The entry default to send for `option`, or `None` when the default is not
+/// a value the option offers (wrong kind, unknown id, or an unknown option
+/// kind). This is the validity check the default path has always applied.
+fn default_config_value(
+    option: &acp_v2::SessionConfigOption,
+    default: &AgentConfigOptionValue,
+) -> Option<acp_v2::SessionConfigOptionValue> {
+    match &option.kind {
+        acp_v2::SessionConfigKind::Select(select) => {
+            let value_id = default.as_value_id()?;
+            select_offers(select, value_id)
+                .then(|| acp_v2::SessionConfigOptionValue::id(value_id.to_string()))
+        }
+        acp_v2::SessionConfigKind::Boolean(_) => default
+            .as_bool()
+            .map(acp_v2::SessionConfigOptionValue::boolean),
+        _ => None,
+    }
+}
+
+/// Whether the agent offers `recorded` for `option`. A value of the wrong
+/// kind (a select id against a boolean, or the reverse) is not offered.
+fn recorded_is_offered(option: &acp_v2::SessionConfigOption, recorded: &RecordedValue) -> bool {
+    match (&option.kind, recorded) {
+        (acp_v2::SessionConfigKind::Select(select), RecordedValue::Id(value_id)) => {
+            select_offers(select, value_id)
+        }
+        (acp_v2::SessionConfigKind::Boolean(_), RecordedValue::Bool(_)) => true,
+        _ => false,
+    }
+}
+
+/// Decides what restoring `option` asks of the agent. A recorded value the
+/// agent offers wins over the default: `Skip` when it is already the current
+/// value, `Send` otherwise. A recorded value the agent does not offer is
+/// dropped (the caller warns, having the agent and session ids, after
+/// checking `recorded_is_offered`) and the entry default applies as on the
+/// default path. A default that is not offered yields `None`.
+fn choose_value(
+    option: &acp_v2::SessionConfigOption,
+    recorded: Option<&RecordedValue>,
+    default: Option<AgentConfigOptionValue>,
+) -> Choice {
+    if let Some(recorded) = recorded.filter(|recorded| recorded_is_offered(option, recorded)) {
+        return match (&option.kind, recorded) {
+            (acp_v2::SessionConfigKind::Select(select), RecordedValue::Id(value_id))
+                if &*select.current_value.0 == value_id.as_str() =>
+            {
+                Choice::Skip
+            }
+            (acp_v2::SessionConfigKind::Boolean(boolean), RecordedValue::Bool(value))
+                if boolean.current_value == *value =>
+            {
+                Choice::Skip
+            }
+            (_, RecordedValue::Id(value_id)) => {
+                Choice::Send(acp_v2::SessionConfigOptionValue::id(value_id.clone()))
+            }
+            (_, RecordedValue::Bool(value)) => {
+                Choice::Send(acp_v2::SessionConfigOptionValue::boolean(*value))
+            }
+        };
+    }
+
+    default
+        .and_then(|default| default_config_value(option, &default))
+        .map_or(Choice::None, Choice::Send)
 }
 
+/// Whether `value` is already `option`'s current value, so sending it would
+/// change nothing. Upstream skips such defaults; a restored value is skipped
+/// by `choose_value` itself.
+fn is_current_value(
+    option: &acp_v2::SessionConfigOption,
+    value: &acp_v2::SessionConfigOptionValue,
+) -> bool {
+    match (&option.kind, value) {
+        (
+            acp_v2::SessionConfigKind::Select(select),
+            acp_v2::SessionConfigOptionValue::Id { value },
+        ) => select.current_value == *value,
+        (
+            acp_v2::SessionConfigKind::Boolean(boolean),
+            acp_v2::SessionConfigOptionValue::Boolean { value },
+        ) => boolean.current_value == *value,
+        _ => false,
+    }
+}
+
+/// A recorded value as the user would recognise it in a log line.
+fn recorded_value_label(recorded: &RecordedValue) -> String {
+    match recorded {
+        RecordedValue::Id(value_id) => value_id.clone(),
+        RecordedValue::Bool(value) => value.to_string(),
+    }
+}
+
+#[cfg(test)]
+mod choose_value_tests;
+
+#[cfg(test)]
+mod thread_config_test_support;
+
+#[cfg(test)]
+mod restore_options_tests;
+
+#[cfg(test)]
+mod restore_mode_tests;
+
+#[cfg(test)]
+mod recorder_tests;
+
+#[cfg(test)]
+mod recorder_mode_tests;
+
+#[cfg(test)]
+mod round_trip_tests;
+
