+    init(cx);
+    record(PLUS, "s-live", "opus", cx).await;
+    let draft = thread(PLUS, None);
+    let draft_id = draft.thread_id;
+    save(draft, cx);
+    let live = thread(PLUS, Some("s-live"));
+    let live_id = live.thread_id;
+    save(live, cx);
+
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(draft_id, cx));
+    });
+    cx.run_until_parked();
+    assert!(has_record(PLUS, "s-live", cx));
+
+    // Non-vacuous: the live thread's record does go when the live thread goes.
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(live_id, cx));
+    });
+    cx.run_until_parked();
+    assert!(!has_record(PLUS, "s-live", cx));
+}
+
+#[gpui::test]
+async fn delete_all_deletes_each_threads_thread_config_record(cx: &mut TestAppContext) {
+    init(cx);
+    record(PLUS, "s-a", "opus", cx).await;
+    record(CODEX, "s-b", "gpt-5", cx).await;
+    record(PLUS, "s-kept", "haiku", cx).await;
+    let first = thread(PLUS, Some("s-a"));
+    let second = thread(CODEX, Some("s-b"));
+    let ids = vec![first.thread_id, second.thread_id];
+    save(first, cx);
+    save(second, cx);
+    save(thread(PLUS, Some("s-kept")), cx);
+
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete_all(ids, cx));
+    });
+    cx.run_until_parked();
+
+    assert!(!has_record(PLUS, "s-a", cx));
+    assert!(!has_record(CODEX, "s-b", cx));
+    assert!(has_record(PLUS, "s-kept", cx));
+}
