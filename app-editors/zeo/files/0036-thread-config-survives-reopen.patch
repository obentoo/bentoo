+        &AgentId::new("Claude Agent (Plus)"),
+        &acp_v2::SessionId::new("0199-session"),
+    )
+    .expect("key renders");
+    let after = key(
+        &AgentId::new(String::from("Claude Agent (Plus)")),
+        &acp_v2::SessionId::new(String::from("0199-session")),
+    )
+    .expect("key renders");
+    assert_eq!(before, after);
+}
