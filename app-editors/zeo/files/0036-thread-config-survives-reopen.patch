@@ -0,0 +1,51 @@
+//! Process-wide log capture for the tests of patch `0036` that must prove a
+//! failure or a dropped value is logged rather than swallowed (story 015, Q4).
+//!
+//! Materialize with `#[cfg(test)] mod test_log_capture;` in `agent_servers.rs`.
+//! The `log` crate accepts one logger per process; nothing else in this crate's
+//! test binary installs one (the e2e helpers that call `env_logger::try_init`
+//! are `#[ignore]`d without the `e2e` feature).
+
+use std::sync::{Mutex, Once};
+
+struct Capture;
+
+static RECORDS: Mutex<Vec<(log::Level, String)>> = Mutex::new(Vec::new());
+static CAPTURE: Capture = Capture;
+
+impl log::Log for Capture {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::Level::Warn
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            RECORDS
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner())
+                .push((record.level(), record.args().to_string()));
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+/// Installs the capturing logger once for the whole test process.
+pub(crate) fn install() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| {
+        log::set_logger(&CAPTURE)
+            .expect("another logger was installed before the thread-config log capture");
+        log::set_max_level(log::LevelFilter::Warn);
+    });
+}
+
+/// True when one WARN-or-ERROR line contains every needle. Tests run in
+/// parallel in one process, so callers pass needles unique to their test.
+pub(crate) fn logged(needles: &[&str]) -> bool {
+    RECORDS
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+        .iter()
+        .any(|(_, message)| needles.iter().all(|needle| message.contains(needle)))
+}
diff --git a/crates/agent_servers/src/thread_config_store.rs b/crates/agent_servers/src/thread_config_store.rs
new file mode 100644
index 0000000..da5b063
--- /dev/null
+++ b/crates/agent_servers/src/thread_config_store.rs
@@ -0,0 +1,154 @@
+//! Per-thread record of an external agent's session config (mode and config
+//! options), so a reopened thread can be restored to the state it was left in.
+//!
+//! The record lives in upstream's key-value store under its own namespace, so
+//! no table and no migration are added: a database written without this
+//! change reads as "no record", and a release without it ignores the rows.
+
+use std::collections::BTreeMap;
+
+use agent_client_protocol::schema::{v1 as acp, v2 as acp_v2};
+use anyhow::{Context as _, Result};
+use db::kvp::KeyValueStore;
+use gpui::{App, AppContext as _, Task};
+use project::AgentId;
+use serde::{Deserialize, Serialize};
+
+const NAMESPACE: &str = "acp_thread_config";
+
+/// The recorded session config of one thread.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct RecordedConfig {
+    pub mode: Option<String>,
+    pub options: BTreeMap<String, RecordedValue>,
+}
+
+/// The recorded value of one config option. The tag keeps a select whose
+/// value id is `"true"` apart from the boolean `true`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "value")]
+pub enum RecordedValue {
+    Id(String),
+    Bool(bool),
+}
+
+/// The store key of a thread: the JSON encoding of the pair
+/// `[agent_id, session_id]`. Both ids are free text, so a concatenated key
+/// could make two threads share one record; the JSON pair cannot.
+pub fn key(agent_id: &AgentId, session_id: &acp_v2::SessionId) -> Result<String> {
+    serde_json::to_string(&(agent_id.as_ref(), session_id.0.as_ref())).with_context(|| {
+        format!(
+            "rendering the thread config key of agent {} session {}",
+            agent_id.as_ref(),
+            session_id.0
+        )
+    })
+}
+
+/// Reads a thread's record. A read or parse failure is logged with both ids
+/// and reads as "no record", so it never blocks loading the thread.
+pub fn read(agent_id: &AgentId, session_id: &acp_v2::SessionId, cx: &App) -> Option<RecordedConfig> {
+    let result = key(agent_id, session_id).and_then(|key| {
+        let raw = KeyValueStore::global(cx).scoped(NAMESPACE).read(&key)?;
+        raw.map(|raw| {
+            serde_json::from_str::<RecordedConfig>(&raw).context("parsing the recorded config")
+        })
+        .transpose()
+    });
+    match result {
+        Ok(recorded) => recorded,
+        Err(error) => {
+            log::warn!(
+                "failed to read the thread config of agent {} session {}: {error:#}",
+                agent_id.as_ref(),
+                session_id.0
+            );
+            None
+        }
+    }
+}
+
+/// Replaces a thread's record. Any error names the agent and the session.
+pub fn write(
+    agent_id: &AgentId,
+    session_id: &acp_v2::SessionId,
+    recorded: &RecordedConfig,
+    cx: &App,
+) -> Task<Result<()>> {
+    let target = describe(agent_id, session_id);
+    let prepared = key(agent_id, session_id).and_then(|key| {
+        let payload = serde_json::to_string(recorded).context("serializing the recorded config")?;
+        Ok((key, payload))
+    });
+    let (key, payload) = match prepared {
+        Ok(prepared) => prepared,
+        Err(error) => {
+            return Task::ready(Err(
+                error.context(format!("writing the thread config of {target}"))
+            ));
+        }
+    };
+    let kvp = KeyValueStore::global(cx);
+    cx.background_spawn(async move {
+        kvp.scoped(NAMESPACE)
+            .write(key, payload)
+            .await
+            .with_context(|| format!("writing the thread config of {target}"))
+    })
+}
+
+/// Removes a thread's record. Any error names the agent and the session.
+pub fn delete(agent_id: &AgentId, session_id: &acp_v2::SessionId, cx: &App) -> Task<Result<()>> {
+    let target = describe(agent_id, session_id);
+    let key = match key(agent_id, session_id) {
+        Ok(key) => key,
+        Err(error) => {
+            return Task::ready(Err(
+                error.context(format!("deleting the thread config of {target}"))
+            ));
+        }
+    };
+    let kvp = KeyValueStore::global(cx);
+    cx.background_spawn(async move {
+        kvp.scoped(NAMESPACE)
+            .delete(key)
+            .await
+            .with_context(|| format!("deleting the thread config of {target}"))
+    })
+}
+
+/// Captures the current mode and the select and boolean options of a
+/// session. Any other option kind has no value this record can replay, so it
+/// is skipped.
+pub fn snapshot(
+    options: &[acp_v2::SessionConfigOption],
+    mode: Option<&acp::SessionModeId>,
+) -> RecordedConfig {
+    let options = options
+        .iter()
+        .filter_map(|option| {
+            let value = match &option.kind {
+                acp_v2::SessionConfigKind::Select(select) => {
+                    RecordedValue::Id(select.current_value.0.to_string())
+                }
+                acp_v2::SessionConfigKind::Boolean(boolean) => {
+                    RecordedValue::Bool(boolean.current_value)
+                }
+                _ => return None,
+            };
+            Some((option.config_id.0.to_string(), value))
+        })
+        .collect();
+    RecordedConfig {
+        mode: mode.map(|mode| mode.0.to_string()),
+        options,
+    }
+}
+
+fn describe(agent_id: &AgentId, session_id: &acp_v2::SessionId) -> String {
+    format!("agent {} session {}", agent_id.as_ref(), session_id.0)
+}
+
+#[cfg(test)]
+#[path = "thread_config_store_tests.rs"]
+mod thread_config_store_tests;
diff --git a/crates/agent_servers/src/thread_config_store_tests.rs b/crates/agent_servers/src/thread_config_store_tests.rs
new file mode 100644
index 0000000..f471d4a
--- /dev/null
+++ b/crates/agent_servers/src/thread_config_store_tests.rs
@@ -0,0 +1,469 @@
+//! Task 1.1 — the per-thread config store (story 015, patch `0036`).
+//!
+//! Materialize with, at the end of `thread_config_store.rs`:
+//!     #[cfg(test)]
+//!     #[path = "thread_config_store_tests.rs"]
+//!     mod tests;
+//! and `#[cfg(test)] mod test_log_capture;` in `agent_servers.rs`.
+//!
+//! Hostile halves come first in every identity group: fixtures that would make
+//! two threads share one record (collapse), then fixtures that would make one
+//! thread lose its record (split), then the benign case.
+
+use std::collections::{BTreeMap, HashSet};
+
+use agent_client_protocol::schema::{v1 as acp, v2 as acp_v2};
+use db::kvp::KeyValueStore;
+use gpui::{AppContext as _, TestAppContext};
+use project::AgentId;
+
+use super::{RecordedConfig, RecordedValue, delete, key, read, snapshot, write};
+
+const NAMESPACE: &str = "acp_thread_config";
+
+fn agent(id: &str) -> AgentId {
+    AgentId::new(id.to_string())
+}
+
+fn session(id: &str) -> acp_v2::SessionId {
+    acp_v2::SessionId::new(id.to_string())
+}
+
+fn config(mode: Option<&str>, options: Vec<(&str, RecordedValue)>) -> RecordedConfig {
+    RecordedConfig {
+        mode: mode.map(str::to_string),
+        options: options
+            .into_iter()
+            .map(|(id, value)| (id.to_string(), value))
+            .collect(),
+    }
+}
+
+fn id_of(config: &RecordedConfig, option: &str) -> Option<String> {
+    match config.options.get(option)? {
+        RecordedValue::Id(value) => Some(value.clone()),
+        RecordedValue::Bool(_) => None,
+    }
+}
+
+fn bool_of(config: &RecordedConfig, option: &str) -> Option<bool> {
+    match config.options.get(option)? {
+        RecordedValue::Bool(value) => Some(*value),
+        RecordedValue::Id(_) => None,
+    }
+}
+
+fn as_json(config: &RecordedConfig) -> serde_json::Value {
+    serde_json::to_value(config).expect("a recorded config serializes")
+}
+
+fn v2_options(options: Vec<acp::SessionConfigOption>) -> Vec<acp_v2::SessionConfigOption> {
+    acp_thread::config_options::from_v1(options).expect("v1 options convert to v2")
+}
+
+fn init_db(cx: &mut TestAppContext) {
+    cx.update(|cx| cx.set_global(db::AppDatabase::test_new()));
+}
+
+fn read_in(agent_id: &str, session_id: &str, cx: &mut TestAppContext) -> Option<RecordedConfig> {
+    cx.update(|cx| read(&agent(agent_id), &session(session_id), cx))
+}
+
+async fn write_in(
+    agent_id: &str,
+    session_id: &str,
+    recorded: &RecordedConfig,
+    cx: &mut TestAppContext,
+) {
+    cx.update(|cx| write(&agent(agent_id), &session(session_id), recorded, cx))
+        .await
+        .expect("writing a record succeeds on the test database");
+}
+
+async fn delete_in(agent_id: &str, session_id: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| delete(&agent(agent_id), &session(session_id), cx))
+        .await
+        .expect("deleting a record succeeds on the test database");
+}
