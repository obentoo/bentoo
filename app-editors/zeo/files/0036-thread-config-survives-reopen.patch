+/// Signals that a session's mode cell changed, so its recorder can snapshot
+/// it. Modes have no watch of their own, unlike config options. Every holder
+/// clones the `Rc`, as the config-options watch does with its sender.
+#[derive(Clone)]
+struct ModeTrigger(Rc<RefCell<watch::Sender<()>>>);
+
+impl ModeTrigger {
+    fn new() -> Self {
+        let (tx, _rx) = watch::channel(());
+        Self(Rc::new(RefCell::new(tx)))
+    }
+
+    fn fire(&self) {
+        // No receiver alive means no recorder, so there is nothing to record.
+        self.0.borrow_mut().send(()).ok();
+    }
+}
+
+/// Records a session's config each time it changes, so a reopened thread can
+/// be restored. It is woken only by the config-options watch and the mode
+/// trigger, which are signalled once the agent has answered (or a pending
+/// change was reverted), never by an optimistic write. The task lives in the
+/// session and ends with it.
+struct ConfigRecorder {
+    _task: Task<()>,
+}
+
+impl ConfigRecorder {
+    fn start(
+        agent_id: AgentId,
+        session_id: acp_v2::SessionId,
+        config_options: Option<&ConfigOptions>,
+        modes: Option<Rc<RefCell<acp::SessionModeState>>>,
+        mode_rx: watch::Receiver<()>,
+        cx: &App,
+    ) -> Self {
+        // Taken from the sender, the receiver starts at the current version:
+        // only changes signalled from now on wake the recorder.
+        let mut options_rx = config_options.map(|options| options.tx.borrow().receiver());
+        let options = config_options.map(|options| options.config_options.clone());
+        let mut mode_rx = Some(mode_rx);
+        let task = cx.spawn(async move |cx| {
+            let mut previous_write: Option<futures::channel::oneshot::Receiver<()>> = None;
+            while either_changed(&mut options_rx, &mut mode_rx).await {
+                // The watch coalesces wakes, so the cells are read as they are
+                // now rather than per signal.
+                let recorded = {
+                    let options = options.as_ref().map(|options| options.borrow());
+                    let mode = modes
+                        .as_ref()
+                        .map(|modes| modes.borrow().current_mode_id.clone());
+                    thread_config_store::snapshot(
+                        options.as_deref().map_or(&[], Vec::as_slice),
+                        mode.as_ref(),
+                    )
+                };
+
+                // Detached, so closing the session right after a change does
+                // not cancel its write. Each write waits for the previous one,
+                // so an older snapshot never lands over a newer one.
+                let (written_tx, written_rx) = futures::channel::oneshot::channel();
+                let previous = previous_write.replace(written_rx);
+                let write = cx.spawn({
+                    let agent_id = agent_id.clone();
+                    let session_id = session_id.clone();
+                    async move |cx| {
+                        if let Some(previous) = previous {
+                            previous.await.ok();
+                        }
+                        let result = cx
+                            .update(|cx| {
+                                thread_config_store::write(&agent_id, &session_id, &recorded, cx)
+                            })
+                            .await;
+                        written_tx.send(()).ok();
+                        result
+                    }
+                });
+                cx.update(|cx| write.detach_and_log_err(cx));
+            }
+        });
+        Self { _task: task }
+    }
+}
+
+/// Waits until either receiver signals a change. Returns `false` once both
+/// senders are gone. A closed receiver is set to `None`, since its `changed`
+/// would stay ready forever.
+async fn either_changed(
+    first: &mut Option<watch::Receiver<()>>,
+    second: &mut Option<watch::Receiver<()>>,
+) -> bool {
+    loop {
+        let (first_closed, second_closed) = match (first.as_mut(), second.as_mut()) {
+            (Some(first_rx), Some(second_rx)) => {
+                match futures::future::select(
+                    std::pin::pin!(first_rx.changed()),
+                    std::pin::pin!(second_rx.changed()),
+                )
+                .await
+                {
+                    futures::future::Either::Left((result, _)) => (result.is_err(), false),
+                    futures::future::Either::Right((result, _)) => (false, result.is_err()),
+                }
+            }
+            (Some(first_rx), None) => (first_rx.changed().await.is_err(), false),
+            (None, Some(second_rx)) => (false, second_rx.changed().await.is_err()),
+            (None, None) => return false,
+        };
+        if first_closed {
+            *first = None;
+        }
+        if second_closed {
+            *second = None;
+        }
+        if !first_closed && !second_closed {
+            return true;
+        }
+    }
+}
