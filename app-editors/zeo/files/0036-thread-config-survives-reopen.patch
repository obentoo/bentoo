index 0000000..8bce60f
--- /dev/null
+++ b/crates/agent_servers/src/acp/restore_mode_tests.rs
@@ -0,0 +1,194 @@
+//! Task 2.3 — restoring the recorded session mode on load (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod restore_mode_tests;` in `acp.rs`.
+//! The agent exposes legacy modes and no config options, the only shape in
+//! which Zeo keeps `SessionModeState` (`config_state`).
+
+use super::thread_config_test_support::*;
+use crate::test_log_capture::logged;
+
+const AGENT: &str = "Mode Agent";
+
+fn mode_script() -> AgentScript {
+    AgentScript {
+        agent_id: AGENT,
+        new_session_id: "mode-created",
+        modes: Some(modes("default", &["default", "plan", "acceptEdits"])),
+        ..Default::default()
+    }
+}
+
+#[gpui::test]
+async fn restore_mode_does_not_resend_the_mode_the_agent_already_reports(
+    cx: &mut gpui::TestAppContext,
+) {
+    // Hostile half: R2.3 for modes — the agent restored the same mode itself.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            modes: Some(modes("plan", &["default", "plan", "acceptEdits"])),
+            ..mode_script()
+        },
+        project,
+        cx,
+    )
+    .await;
+    record(
+        AGENT,
+        "m-same",
+        recorded_config(Some("plan"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("m-same", cx).await;
+
+    assert!(
+        agent.mode_requests().is_empty(),
+        "sent {:?}",
+        agent.mode_requests()
+    );
+    assert_eq!(agent.current_mode("m-same").as_deref(), Some("plan"));
+
+    // Benign half: a recorded mode that differs from the agent's IS sent.
+    record(
+        AGENT,
+        "m-differs",
+        recorded_config(Some("acceptEdits"), Vec::new()),
+        cx,
+    )
+    .await;
+    let _other = agent.load("m-differs", cx).await;
+    assert_eq!(agent.mode_requests(), vec!["acceptEdits".to_string()]);
+}
+
+#[gpui::test]
+async fn restore_mode_ignores_an_unoffered_mode_and_applies_no_mode_default_on_load(
+    cx: &mut gpui::TestAppContext,
+) {
+    // Hostile half: neither the retired recorded mode nor the entry's mode
+    // default may be sent on load — mode defaults stay new-session only.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    agent.set_defaults(Some("acceptEdits"), Vec::new());
+    record(
+        AGENT,
+        "m-retired",
+        recorded_config(Some("restore_mode_retired"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("m-retired", cx).await;
+
+    assert!(
+        agent.mode_requests().is_empty(),
+        "sent {:?}",
+        agent.mode_requests()
+    );
+    assert_eq!(agent.current_mode("m-retired").as_deref(), Some("default"));
+    assert!(
+        logged(&["restore_mode_retired"]),
+        "a warning must name the dropped mode"
+    );
+}
+
+#[gpui::test]
+async fn restore_mode_sends_the_recorded_mode_on_load(cx: &mut gpui::TestAppContext) {
+    // R2.2
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    record(
+        AGENT,
+        "m-plan",
+        recorded_config(Some("plan"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("m-plan", cx).await;
+
+    assert_eq!(agent.mode_requests(), vec!["plan".to_string()]);
+    assert_eq!(agent.current_mode("m-plan").as_deref(), Some("plan"));
+}
+
+/// The recorded mode is restored however the thread comes back: `session/resume` goes
+/// through the same open path as `session/load`, and must not skip the restore.
+#[gpui::test]
+async fn restore_mode_sends_the_recorded_mode_on_resume(cx: &mut gpui::TestAppContext) {
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    record(
+        AGENT,
+        "m-plan",
+        recorded_config(Some("plan"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.resume("m-plan", cx).await;
+
+    assert_eq!(agent.mode_requests(), vec!["plan".to_string()]);
+    assert_eq!(agent.current_mode("m-plan").as_deref(), Some("plan"));
+}
+
+#[gpui::test]
+async fn restore_mode_rejected_keeps_the_agents_mode_and_the_session_open(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R2.7 for modes.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            rejected_modes: vec!["plan"],
+            ..mode_script()
+        },
+        project,
+        cx,
+    )
+    .await;
+    record(
+        AGENT,
+        "m-reject",
+        recorded_config(Some("plan"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("m-reject", cx).await;
+
+    assert_eq!(agent.mode_requests(), vec!["plan".to_string()]);
+    assert_eq!(
+        agent.current_mode("m-reject").as_deref(),
+        Some("default"),
+        "the optimistic mode is reverted to the agent's"
+    );
+    assert!(agent.is_open("m-reject"));
+}
+
+#[gpui::test]
+async fn restore_mode_without_a_record_sends_no_mode_on_load(cx: &mut gpui::TestAppContext) {
+    // R2.6: as dev-0033, a load with no record sends no mode at all.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(mode_script(), project, cx).await;
+    agent.set_defaults(Some("plan"), Vec::new());
+    record(
+        AGENT,
+        "m-other-thread",
+        recorded_config(Some("acceptEdits"), Vec::new()),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("m-no-record", cx).await;
+
+    assert!(
+        agent.mode_requests().is_empty(),
+        "sent {:?}",
+        agent.mode_requests()
+    );
+
+    // Benign half: the thread that owns the record gets its mode back.
+    let _other = agent.load("m-other-thread", cx).await;
+    assert_eq!(agent.mode_requests(), vec!["acceptEdits".to_string()]);
+}
diff --git a/crates/agent_servers/src/acp/restore_options_tests.rs b/crates/agent_servers/src/acp/restore_options_tests.rs
new file mode 100644
index 0000000..4950ff0
--- /dev/null
+++ b/crates/agent_servers/src/acp/restore_options_tests.rs
@@ -0,0 +1,377 @@
+//! Task 2.2 — restoring recorded config options on load (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod restore_options_tests;` in `acp.rs`
+//! (needs `thread_config_test_support` and `crate::test_log_capture`).
+//! Each test drives a real `session/load` against a scripted agent and asserts
+//! the exact `session/set_config_option` requests that went over the wire.
+
+use super::thread_config_test_support::*;
+use super::*;
+use crate::test_log_capture::logged;
+use crate::thread_config_store::RecordedValue;
+
+const PLUS: &str = "Claude Agent (Plus)";
+
+fn plus_script() -> AgentScript {
+    AgentScript {
+        agent_id: PLUS,
+        new_session_id: "created-session",
+        config_options: Some(vec![
+            select("model", "sonnet", &["sonnet", "opus", "haiku"]),
+            select("effort", "high", &["low", "high"]),
+            boolean("web_search", false),
+        ]),
+        side_effect: Some(("model", "opus", boolean("fast_mode", false))),
+        ..Default::default()
+    }
+}
+
+fn plus_defaults(agent: &ConfigAgent) {
+    agent.set_defaults(
+        None,
+        vec![
+            ("model", AgentConfigOptionValue::ValueId("haiku".into())),
+            ("effort", AgentConfigOptionValue::ValueId("low".into())),
+            ("web_search", AgentConfigOptionValue::Boolean(true)),
+        ],
+    );
+}
+
+#[gpui::test]
+async fn load_with_a_record_sends_only_what_differs_and_defaults_only_what_is_unrecorded(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R2.1, R2.3, R2.5, R2.8. Hostile half first: `effort` is recorded at the
+    // value the agent restored, and its default differs — the default must
+    // not be sent over the record, and the record must not be re-sent.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(plus_script(), project, cx).await;
+    plus_defaults(&agent);
+    record(
+        PLUS,
+        "s-restore",
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus".into())),
+                ("effort", RecordedValue::Id("high".into())),
+            ],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("s-restore", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![
+            wire("model", serde_json::json!("opus")),
+            wire("web_search", serde_json::json!(true)),
+        ],
+        "only the differing recorded value and the unrecorded option's default are sent"
+    );
+    assert_eq!(
+        agent.option_value("s-restore", "model"),
+        Some(serde_json::json!("opus"))
+    );
+    assert_eq!(
+        agent.option_value("s-restore", "effort"),
+        Some(serde_json::json!("high"))
+    );
+    assert!(
+        agent.option_value("s-restore", "fast_mode").is_some(),
+        "R2.8: the full list the agent returned after the restored value is adopted"
+    );
+}
+
+#[gpui::test]
+async fn load_with_an_unavailable_recorded_value_applies_the_default_and_warns(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R2.4: the dropped value is never sent; the default takes its place and
+    // a warning names the option and the dropped value.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            agent_id: PLUS,
+            config_options: Some(vec![select("r24_model", "sonnet", &["sonnet", "haiku"])]),
+            ..Default::default()
+        },
+        project,
+        cx,
+    )
+    .await;
+    agent.set_defaults(
+        None,
+        vec![("r24_model", AgentConfigOptionValue::ValueId("haiku".into()))],
+    );
+    record(
+        PLUS,
+        "s-unavailable",
+        recorded_config(
+            None,
+            vec![("r24_model", RecordedValue::Id("r24_retired".into()))],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("s-unavailable", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![wire("r24_model", serde_json::json!("haiku"))]
+    );
+    assert!(
+        logged(&["r24_model", "r24_retired", PLUS, "s-unavailable"]),
+        "one warning must name the option, the dropped value, the agent and the session"
+    );
+    assert!(agent.is_open("s-unavailable"));
+}
+
+#[gpui::test]
+async fn load_reads_only_the_record_of_its_own_agent(cx: &mut gpui::TestAppContext) {
+    // R3.1 hostile half: another agent recorded state under the same session id.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(plus_script(), project, cx).await;
+    plus_defaults(&agent);
+    record(
+        "Codex",
+        "s-shared",
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus".into())),
+                ("effort", RecordedValue::Id("high".into())),
+                ("web_search", RecordedValue::Bool(false)),
+            ],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("s-shared", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![
+            wire("effort", serde_json::json!("low")),
+            wire("model", serde_json::json!("haiku")),
+            wire("web_search", serde_json::json!(true)),
+        ],
+        "a thread with no record of its own gets the entry defaults, not another agent's state"
+    );
+
+    // Benign half: the same session id under this agent's own record is restored.
+    let other = ConfigAgent::connect(plus_script(), agent.project.clone(), cx).await;
+    record(
+        PLUS,
+        "s-shared-own",
+        recorded_config(None, vec![("model", RecordedValue::Id("opus".into()))]),
+        cx,
+    )
+    .await;
+    let _own = other.load("s-shared-own", cx).await;
+    assert_eq!(
+        other.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))]
+    );
+}
+
+#[gpui::test]
+async fn new_session_ignores_a_record_under_its_session_id(cx: &mut gpui::TestAppContext) {
+    // R3.1, R3.3 (a fork arrives through session/new): new threads start from
+    // the entry defaults even when a record already sits under the same key.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(plus_script(), project, cx).await;
+    agent.set_defaults(
+        None,
+        vec![("model", AgentConfigOptionValue::ValueId("haiku".into()))],
+    );
+    record(
+        PLUS,
+        "created-session",
+        recorded_config(
+            None,
+            vec![
+                ("model", RecordedValue::Id("opus".into())),
+                ("web_search", RecordedValue::Bool(true)),
+            ],
+        ),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.new_session(cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![wire("model", serde_json::json!("haiku"))]
+    );
+
+    // Benign half: the same kind of record IS restored when a thread is loaded.
+    let loader = ConfigAgent::connect(plus_script(), agent.project.clone(), cx).await;
+    loader.set_defaults(
+        None,
+        vec![("model", AgentConfigOptionValue::ValueId("haiku".into()))],
+    );
+    record(
+        PLUS,
+        "s-loaded-not-new",
+        recorded_config(None, vec![("model", RecordedValue::Id("opus".into()))]),
+        cx,
+    )
+    .await;
+    let _loaded = loader.load("s-loaded-not-new", cx).await;
+    assert_eq!(
+        loader.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))]
+    );
+}
+
+#[gpui::test]
+async fn load_without_a_record_applies_the_entry_defaults_as_before(cx: &mut gpui::TestAppContext) {
+    // R2.6, R4.1: an existing thread with no record behaves as upstream's
+    // default path: every valid default is sent except one already equal to
+    // the current value (`effort` here), which upstream skips since #65233.
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(plus_script(), project, cx).await;
+    agent.set_defaults(
+        None,
+        vec![
+            ("model", AgentConfigOptionValue::ValueId("haiku".into())),
+            ("effort", AgentConfigOptionValue::ValueId("high".into())),
+            ("web_search", AgentConfigOptionValue::Boolean(true)),
+        ],
+    );
+
+    // A record of ANOTHER thread must not count as this thread's record.
+    record(
+        PLUS,
+        "s-some-other-thread",
+        recorded_config(None, vec![("model", RecordedValue::Id("opus".into()))]),
+        cx,
+    )
+    .await;
+
+    let _thread = agent.load("s-no-record", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![
+            wire("model", serde_json::json!("haiku")),
+            wire("web_search", serde_json::json!(true)),
+        ]
+    );
+
+    // Benign half: the thread that owns that record gets it back.
+    let loader = ConfigAgent::connect(plus_script(), agent.project.clone(), cx).await;
+    let _other = loader.load("s-some-other-thread", cx).await;
+    assert_eq!(
+        loader.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))]
+    );
+}
+
+#[gpui::test]
+async fn rejected_restored_value_keeps_the_agents_value_and_the_session_open(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R2.7
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            rejected_values: vec![("model", serde_json::json!("opus"))],
+            ..plus_script()
+        },
+        project,
+        cx,
+    )
+    .await;
+    record(
+        PLUS,
+        "s-rejected",
+        recorded_config(None, vec![("model", RecordedValue::Id("opus".into()))]),
+        cx,
+    )
+    .await;
+
+    let thread = agent.load("s-rejected", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))]
+    );
+    assert_eq!(
+        agent.option_value("s-rejected", "model"),
+        Some(serde_json::json!("sonnet")),
+        "the optimistic restored value is reverted to what the agent reports"
+    );
+    assert!(agent.is_open("s-rejected"));
+
+    // The thread stays usable: a later pick goes through.
+    agent
+        .pick("s-rejected", "model", id_value("haiku"), cx)
+        .await
+        .expect("a pick on the still-open session succeeds");
+    assert_eq!(
+        agent.option_value("s-rejected", "model"),
+        Some(serde_json::json!("haiku"))
+    );
+    drop(thread);
+}
+
+#[gpui::test]
+async fn thread_config_store_corrupt_record_is_logged_and_load_applies_defaults(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R3.4 (task 1.1's store, proved through the load path): an unreadable
+    // record is logged with both ids and the load proceeds as "no record".
+    let project = init(cx).await;
+    let agent = ConfigAgent::connect(
+        AgentScript {
+            agent_id: "r34 agent",
+            config_options: Some(vec![select("model", "sonnet", &["sonnet", "haiku"])]),
+            ..Default::default()
+        },
+        project,
+        cx,
+    )
+    .await;
+    agent.set_defaults(
+        None,
+        vec![("model", AgentConfigOptionValue::ValueId("haiku".into()))],
+    );
+    let raw_key = crate::thread_config_store::key(
+        &AgentId::new("r34 agent"),
+        &acp_v2::SessionId::new("r34-session"),
+    )
+    .expect("key renders");
+    cx.update(|cx| {
+        let store = db::kvp::KeyValueStore::global(cx);
+        cx.background_spawn(async move {
+            store
+                .scoped("acp_thread_config")
+                .write(raw_key, "{not json".to_string())
+                .await
+        })
+    })
+    .await
+    .expect("raw write succeeds");
+
+    let _thread = agent.load("r34-session", cx).await;
+
+    assert!(
+        agent.is_open("r34-session"),
+        "a bad record must not block the load"
+    );
+    assert_eq!(
+        agent.config_requests(),
+        vec![wire("model", serde_json::json!("haiku"))]
+    );
+    assert!(
+        logged(&["r34 agent", "r34-session"]),
+        "the read failure must be logged with the agent and the session id"
+    );
+}
