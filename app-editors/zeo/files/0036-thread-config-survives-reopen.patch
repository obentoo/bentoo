diff --git a/crates/agent_servers/src/acp/choose_value_tests.rs b/crates/agent_servers/src/acp/choose_value_tests.rs
new file mode 100644
index 0000000..2415630
--- /dev/null
+++ b/crates/agent_servers/src/acp/choose_value_tests.rs
@@ -0,0 +1,266 @@
+//! Task 2.1 — `choose_value`, the pure per-option decision (story 015, patch `0036`).
+//!
+//! Materialize with `#[cfg(test)] mod choose_value_tests;` in `acp.rs`.
+//! Contract (design.md, Restoration): `choose_value(option, recorded, default) -> Choice`
+//! with `Choice::{Send(SessionConfigOptionValue), Skip, None}`; the entry default,
+//! when it is what gets applied, comes back as `Send(default)`. The caller
+//! detects a dropped record with `recorded_is_offered(option, &RecordedValue)`.
+//! Hostile halves first: a recorded value that must NOT be sent, then the
+//! equal-to-current value that must NOT trigger a request, then the benign cases.
+
+use super::*;
+use crate::thread_config_store::RecordedValue;
+
+fn v2(option: acp::SessionConfigOption) -> acp_v2::SessionConfigOption {
+    acp_thread::config_options::from_v1(vec![option])
+        .expect("v1 option converts")
+        .remove(0)
+}
+
+fn select(id: &str, current: &str, values: &[&str]) -> acp_v2::SessionConfigOption {
+    v2(acp::SessionConfigOption::select(
+        id.to_string(),
+        id.to_string(),
+        current.to_string(),
+        values
+            .iter()
+            .map(|value| acp::SessionConfigSelectOption::new(value.to_string(), value.to_string()))
+            .collect::<Vec<_>>(),
+    ))
+}
+
+fn grouped(id: &str, current: &str, groups: &[(&str, &[&str])]) -> acp_v2::SessionConfigOption {
+    v2(acp::SessionConfigOption::select(
+        id.to_string(),
+        id.to_string(),
+        current.to_string(),
+        groups
+            .iter()
+            .map(|(group, values)| {
+                acp::SessionConfigSelectGroup::new(
+                    group.to_string(),
+                    group.to_string(),
+                    values
+                        .iter()
+                        .map(|value| {
+                            acp::SessionConfigSelectOption::new(
+                                value.to_string(),
+                                value.to_string(),
+                            )
+                        })
+                        .collect::<Vec<_>>(),
+                )
+            })
+            .collect::<Vec<_>>(),
+    ))
+}
+
+fn boolean(id: &str, current: bool) -> acp_v2::SessionConfigOption {
+    v2(acp::SessionConfigOption::boolean(
+        id.to_string(),
+        id.to_string(),
+        current,
+    ))
+}
+
+fn rec_id(value: &str) -> RecordedValue {
+    RecordedValue::Id(value.to_string())
+}
+
+fn default_id(value: &str) -> Option<AgentConfigOptionValue> {
+    Some(AgentConfigOptionValue::ValueId(value.to_string()))
+}
+
+fn describe(choice: &Choice) -> String {
+    #[allow(unreachable_patterns)]
+    match choice {
+        Choice::Send(value) => format!("Send({value:?})"),
+        Choice::Skip => "Skip".to_string(),
+        Choice::None => "None".to_string(),
+        _ => "an unexpected variant".to_string(),
+    }
+}
+
+fn assert_send(choice: Choice, expected: acp_v2::SessionConfigOptionValue) {
+    let shown = describe(&choice);
+    match choice {
+        Choice::Send(value) => assert_eq!(value, expected),
+        _ => panic!("expected Send({expected:?}), got {shown}"),
+    }
+}
+
+fn assert_skip(choice: Choice) {
+    assert!(
+        matches!(choice, Choice::Skip),
+        "expected Skip, got {}",
+        describe(&choice)
+    );
+}
+
+fn assert_nothing(choice: Choice) {
+    assert!(
+        matches!(choice, Choice::None),
+        "expected None, got {}",
+        describe(&choice)
+    );
+}
+
+// ---------------------------------------------------------------- hostile: must not send the record
+
+#[test]
+fn choose_value_drops_a_recorded_id_the_agent_no_longer_offers() {
+    // R2.4: the record names a model the agent retired — the default applies.
+    let option = select("model", "sonnet", &["sonnet", "haiku"]);
+    assert_send(
+        choose_value(&option, Some(&rec_id("opus-retired")), default_id("haiku")),
+        acp_v2::SessionConfigOptionValue::id("haiku"),
+    );
+    // ...and with no usable default there is nothing to send.
+    assert_nothing(choose_value(&option, Some(&rec_id("opus-retired")), None));
+    assert_nothing(choose_value(
+        &option,
+        Some(&rec_id("opus-retired")),
+        default_id("also-not-offered"),
+    ));
+}
+
+#[test]
+fn choose_value_drops_a_recorded_value_of_the_wrong_kind() {
+    // Collapse hazard: the select value id "true" is not the boolean `true`.
+    let toggle = boolean("fast_mode", false);
+    assert_nothing(choose_value(&toggle, Some(&rec_id("true")), None));
+    assert_send(
+        choose_value(
+            &toggle,
+            Some(&rec_id("true")),
+            Some(AgentConfigOptionValue::Boolean(false)),
+        ),
+        acp_v2::SessionConfigOptionValue::boolean(false),
+    );
+
+    let model = select("model", "sonnet", &["sonnet", "true"]);
+    assert_send(
+        choose_value(
+            &model,
+            Some(&RecordedValue::Bool(true)),
+            default_id("sonnet"),
+        ),
+        acp_v2::SessionConfigOptionValue::id("sonnet"),
+    );
+}
+
+// ---------------------------------------------------------------- hostile: must not request what the agent already has
+
+#[test]
+fn choose_value_skips_a_recorded_value_equal_to_the_agents_current_one() {
+    // R2.3, and the default must not win over a record that already holds.
+    assert_skip(choose_value(
+        &select("model", "opus", &["sonnet", "opus", "haiku"]),
+        Some(&rec_id("opus")),
+        default_id("haiku"),
+    ));
+    assert_skip(choose_value(
+        &boolean("fast_mode", true),
+        Some(&RecordedValue::Bool(true)),
+        Some(AgentConfigOptionValue::Boolean(false)),
+    ));
+    assert_skip(choose_value(
+        &grouped("effort", "high", &[("fast", &["low"]), ("deep", &["high"])]),
+        Some(&rec_id("high")),
+        None,
+    ));
+}
+
+// ---------------------------------------------------------------- split hazard: grouped and ungrouped offer alike
+
+#[test]
+fn choose_value_finds_a_recorded_id_inside_any_group() {
+    let option = grouped(
+        "model",
+        "sonnet",
+        &[("anthropic", &["sonnet", "haiku"]), ("frontier", &["opus"])],
+    );
+    assert_send(
+        choose_value(&option, Some(&rec_id("opus")), default_id("haiku")),
+        acp_v2::SessionConfigOptionValue::id("opus"),
+    );
+    // A default inside a group is valid too, as on the default path today.
+    assert_send(
+        choose_value(&option, None, default_id("opus")),
+        acp_v2::SessionConfigOptionValue::id("opus"),
+    );
+}
+
+// ---------------------------------------------------------------- benign
+
+#[test]
+fn choose_value_sends_the_recorded_value_over_the_default() {
+    // R2.1
+    assert_send(
+        choose_value(
+            &select("model", "sonnet", &["sonnet", "opus", "haiku"]),
+            Some(&rec_id("opus")),
+            default_id("haiku"),
+        ),
+        acp_v2::SessionConfigOptionValue::id("opus"),
+    );
+    assert_send(
+        choose_value(
+            &boolean("fast_mode", false),
+            Some(&RecordedValue::Bool(true)),
+            Some(AgentConfigOptionValue::Boolean(false)),
+        ),
+        acp_v2::SessionConfigOptionValue::boolean(true),
+    );
+}
+
+#[test]
+fn choose_value_without_a_record_applies_the_default_as_before() {
+    // R2.5, R2.6: the default path's own rules, unchanged.
+    let model = select("model", "sonnet", &["sonnet", "haiku"]);
+    assert_send(
+        choose_value(&model, None, default_id("haiku")),
+        acp_v2::SessionConfigOptionValue::id("haiku"),
+    );
+    // dev-0033 sends a valid default even when it equals the current value.
+    assert_send(
+        choose_value(&model, None, default_id("sonnet")),
+        acp_v2::SessionConfigOptionValue::id("sonnet"),
+    );
+    assert_nothing(choose_value(&model, None, default_id("not-offered")));
+    assert_nothing(choose_value(
+        &model,
+        None,
+        Some(AgentConfigOptionValue::Boolean(true)),
+    ));
+    assert_nothing(choose_value(&model, None, None));
+    assert_send(
+        choose_value(
+            &boolean("web_search", false),
+            None,
+            Some(AgentConfigOptionValue::Boolean(true)),
+        ),
+        acp_v2::SessionConfigOptionValue::boolean(true),
+    );
+}
+
+// ---------------------------------------------------------------- recorded_is_offered
+
+#[test]
+fn choose_value_recorded_is_offered_only_for_values_the_agent_offers() {
+    // Hostile half: values the agent does not offer for this option.
+    let model = select("model", "sonnet", &["sonnet", "haiku"]);
+    assert!(!recorded_is_offered(&model, &rec_id("opus-retired")));
+    assert!(!recorded_is_offered(&model, &RecordedValue::Bool(true)));
+    let toggle = boolean("fast_mode", false);
+    assert!(!recorded_is_offered(&toggle, &rec_id("true")));
+    let groups = grouped("effort", "high", &[("fast", &["low"]), ("deep", &["high"])]);
+    assert!(!recorded_is_offered(&groups, &rec_id("medium")));
+
+    // Benign half: what the agent does offer, ungrouped, grouped or boolean.
+    assert!(recorded_is_offered(&model, &rec_id("haiku")));
+    assert!(recorded_is_offered(&model, &rec_id("sonnet")));
+    assert!(recorded_is_offered(&groups, &rec_id("low")));
+    assert!(recorded_is_offered(&toggle, &RecordedValue::Bool(true)));
+    assert!(recorded_is_offered(&toggle, &RecordedValue::Bool(false)));
+}
diff --git a/crates/agent_servers/src/acp/recorder_mode_tests.rs b/crates/agent_servers/src/acp/recorder_mode_tests.rs
