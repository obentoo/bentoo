@@ -0,0 +1,152 @@
+//! Task 5.1 — what is recorded is what is restored, across a restart
+//! (story 015, patch `0036`): the producer (`snapshot` through the recorder)
+//! against the consumer (`choose_value` through restoration).
+//!
+//! Materialize with `#[cfg(test)] mod round_trip_tests;` in `acp.rs`.
+//! "Restart" = the first connection and its threads are dropped, and a fresh
+//! connection with a fresh agent opens the same test key-value store.
+
+use super::thread_config_test_support::*;
+use super::*;
+
+const PLUS: &str = "Claude Agent (Plus)";
+const CODEX: &str = "Codex";
+
+fn script(agent_id: &'static str) -> AgentScript {
+    AgentScript {
+        agent_id,
+        config_options: Some(vec![
+            select("model", "sonnet", &["sonnet", "opus", "haiku"]),
+            select("effort", "high", &["low", "high"]),
+            boolean("web_search", false),
+        ]),
+        ..Default::default()
+    }
+}
+
+fn entry_defaults(agent: &ConfigAgent) {
+    agent.set_defaults(
+        None,
+        vec![
+            ("model", AgentConfigOptionValue::ValueId("haiku".into())),
+            ("web_search", AgentConfigOptionValue::Boolean(true)),
+        ],
+    );
+}
+
+#[gpui::test]
+async fn round_trip_two_agents_sharing_a_session_id_restore_their_own_state(
+    cx: &mut gpui::TestAppContext,
+) {
+    // Hostile half (R3.1): one session id, two agents, two different states.
+    let project = init(cx).await;
+    {
+        let plus = ConfigAgent::connect(script(PLUS), project.clone(), cx).await;
+        let codex = ConfigAgent::connect(script(CODEX), project.clone(), cx).await;
+        let plus_thread = plus.load("shared", cx).await;
+        let codex_thread = codex.load("shared", cx).await;
+        plus.pick("shared", "model", id_value("opus"), cx)
+            .await
+            .expect("Plus pick");
+        codex
+            .pick("shared", "model", id_value("haiku"), cx)
+            .await
+            .expect("Codex pick");
+        drop(plus_thread);
+        drop(codex_thread);
+        release(cx);
+    }
+
+    let plus = ConfigAgent::connect(script(PLUS), project.clone(), cx).await;
+    let codex = ConfigAgent::connect(script(CODEX), project, cx).await;
+    let _plus_thread = plus.load("shared", cx).await;
+    let _codex_thread = codex.load("shared", cx).await;
+
+    assert_eq!(
+        plus.config_requests(),
+        vec![wire("model", serde_json::json!("opus"))]
+    );
+    assert_eq!(
+        codex.config_requests(),
+        vec![wire("model", serde_json::json!("haiku"))]
+    );
+}
+
+#[gpui::test]
+async fn round_trip_restores_picked_and_agent_reported_values_after_a_restart(
+    cx: &mut gpui::TestAppContext,
+) {
+    // R1.9, R2.1, R2.3: after the restart only the changed options are sent;
+    // `web_search`, recorded at the value the agent restores, is skipped even
+    // though the entry default differs.
+    let project = init(cx).await;
+    {
+        let agent = ConfigAgent::connect(script(PLUS), project.clone(), cx).await;
+        let thread = agent.load("s-trip", cx).await;
+        agent
+            .pick("s-trip", "model", id_value("opus"), cx)
+            .await
+            .expect("pick");
+        agent.notify(
+            "s-trip",
+            acp::SessionUpdate::ConfigOptionUpdate(acp::ConfigOptionUpdate::new(vec![
+                select("model", "opus", &["sonnet", "opus", "haiku"]),
+                select("effort", "low", &["low", "high"]),
+                boolean("web_search", false),
+            ])),
+            cx,
+        );
+        drop(thread);
+        release(cx);
+    }
+
+    let agent = ConfigAgent::connect(script(PLUS), project, cx).await;
+    entry_defaults(&agent);
+    let _thread = agent.load("s-trip", cx).await;
+
+    assert_eq!(
+        agent.config_requests(),
+        vec![
+            wire("effort", serde_json::json!("low")),
+            wire("model", serde_json::json!("opus")),
+        ]
+    );
+    assert_eq!(
+        agent.option_value("s-trip", "model"),
+        Some(serde_json::json!("opus"))
+    );
+    assert_eq!(
+        agent.option_value("s-trip", "effort"),
+        Some(serde_json::json!("low"))
+    );
+    assert_eq!(
+        agent.option_value("s-trip", "web_search"),
+        Some(serde_json::json!(false))
+    );
+}
+
+#[gpui::test]
+async fn round_trip_restores_the_mode_after_a_restart(cx: &mut gpui::TestAppContext) {
+    let mode_script = AgentScript {
+        agent_id: PLUS,
+        modes: Some(modes("default", &["default", "plan"])),
+        ..Default::default()
+    };
+    let project = init(cx).await;
+    {
+        let agent = ConfigAgent::connect(mode_script.clone(), project.clone(), cx).await;
+        let thread = agent.load("s-mode-trip", cx).await;
+        agent
+            .pick_mode("s-mode-trip", "plan", cx)
+            .await
+            .expect("mode pick");
+        drop(thread);
+        release(cx);
+    }
+
+    let agent = ConfigAgent::connect(mode_script, project, cx).await;
+    let _thread = agent.load("s-mode-trip", cx).await;
+
+    assert_eq!(agent.mode_requests(), vec!["plan".to_string()]);
+    assert_eq!(agent.current_mode("s-mode-trip").as_deref(), Some("plan"));
+}
diff --git a/crates/agent_servers/src/acp/thread_config_test_support.rs b/crates/agent_servers/src/acp/thread_config_test_support.rs
new file mode 100644
index 0000000..3ec6f96
--- /dev/null
+++ b/crates/agent_servers/src/acp/thread_config_test_support.rs
@@ -0,0 +1,658 @@
+//! Shared harness for the thread-config tests of patch `0036` (story 015):
+//! a scripted ACP agent over the real wire and the production client handler
+//! set, so picks, agent updates and loads travel exactly as in Zeo.
+//!
+//! Materialize with `#[cfg(test)] mod thread_config_test_support;` in `acp.rs`,
+//! beside `mod debug_log;`. The test files of tasks 2.2, 2.3, 3.1, 3.2 and 5.1
+//! sit beside it as sibling modules of `acp` and reach its private items.
+
+use std::sync::Mutex;
+
+use super::*;
+use crate::thread_config_store::{self, RecordedConfig, RecordedValue};
+
+pub(super) const WORK_DIR: &str = "/a";
+
+/// What the fake agent reports on `session/new` and `session/load`, and what it refuses.
+#[derive(Clone, Default)]
+pub(super) struct AgentScript {
+    /// The id Zeo knows the agent by — half of the record's key.
+    pub(super) agent_id: &'static str,
+    /// The session id the agent answers to `session/new`.
+    pub(super) new_session_id: &'static str,
+    pub(super) config_options: Option<Vec<acp::SessionConfigOption>>,
+    pub(super) modes: Option<acp::SessionModeState>,
+    /// `(config id, wire value)` pairs answered with an error.
+    pub(super) rejected_values: Vec<(&'static str, serde_json::Value)>,
+    pub(super) rejected_modes: Vec<&'static str>,
+    /// Setting `(config id, value id)` makes this option appear in the agent's list.
+    pub(super) side_effect: Option<(&'static str, &'static str, acp::SessionConfigOption)>,
+    /// Hold every rejection until `open_gate`, so an accepted answer sent
+    /// later reaches Zeo first.
+    pub(super) gated: bool,
+}
+
+pub(super) struct ConfigAgent {
+    pub(super) connection: Rc<AcpConnection>,
+    pub(super) project: Entity<Project>,
+    pub(super) agent: ConnectionTo<Client>,
+    requests: Arc<Mutex<Vec<(String, serde_json::Value)>>>,
+    gate_tx: RefCell<Option<async_channel::Sender<()>>>,
+    _keep_alive: Task<()>,
+}
+
+/// Settings, an isolated key-value store and the log capture, once per test.
+pub(super) async fn init(cx: &mut gpui::TestAppContext) -> Entity<Project> {
+    crate::test_log_capture::install();
+    cx.update(|cx| {
+        let store = settings::SettingsStore::test(cx);
+        cx.set_global(store);
+        cx.set_global(db::AppDatabase::test_new());
+    });
+    let fs = fs::FakeFs::new(cx.executor());
+    fs.insert_tree("/", serde_json::json!({ "a": {} })).await;
+    project::Project::test(fs, [std::path::Path::new(WORK_DIR)], cx).await
+}
+
+const SET_CONFIG: &str = "session/set_config_option";
+const SET_MODE: &str = "session/set_mode";
+
+impl ConfigAgent {
+    pub(super) async fn connect(
+        script: AgentScript,
+        project: Entity<Project>,
+        cx: &mut gpui::TestAppContext,
+    ) -> Self {
+        let requests: Arc<Mutex<Vec<(String, serde_json::Value)>>> =
+            Arc::new(Mutex::new(Vec::new()));
+        let options = Arc::new(Mutex::new(script.config_options.clone()));
+        let modes = Arc::new(Mutex::new(script.modes.clone()));
+        let agent_id = script.agent_id;
+        let (gate_tx, gate_rx) = async_channel::bounded::<()>(1);
+        let gate_rx = script.gated.then_some(gate_rx);
+        let script = Arc::new(script);
+
+        let (client_transport, agent_transport) = agent_client_protocol::Channel::duplex();
+        let (agent_tx, agent_rx) = futures::channel::oneshot::channel::<ConnectionTo<Client>>();
+
+        let agent_future = Agent
+            .builder()
+            .name("thread-config-agent")
+            .on_receive_request(
+                async move |req: acp::InitializeRequest, responder, _cx| {
+                    responder.respond(
+                        acp::InitializeResponse::new(req.protocol_version).agent_capabilities(
+                            acp::AgentCapabilities::default()
+                                .load_session(true)
+                                .session_capabilities(
+                                    acp::SessionCapabilities::default()
+                                        .close(acp::SessionCloseCapabilities::new())
+                                        .resume(acp::SessionResumeCapabilities::new()),
+                                ),
+                        ),
+                    )
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let options = options.clone();
+                    let modes = modes.clone();
+                    let script = script.clone();
+                    async move |_req: acp::NewSessionRequest, responder, _cx| {
+                        let current_options = options.lock().expect("agent options").clone();
+                        let current_modes = modes.lock().expect("agent modes").clone();
+                        responder.respond(
+                            acp::NewSessionResponse::new(acp::SessionId::new(
+                                script.new_session_id,
+                            ))
+                            .config_options(current_options)
+                            .modes(current_modes),
+                        )
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let options = options.clone();
+                    let modes = modes.clone();
+                    async move |_req: acp::LoadSessionRequest, responder, _cx| {
+                        let current_options = options.lock().expect("agent options").clone();
+                        let current_modes = modes.lock().expect("agent modes").clone();
+                        responder.respond(
+                            acp::LoadSessionResponse::new()
+                                .config_options(current_options)
+                                .modes(current_modes),
+                        )
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let options = options.clone();
+                    let modes = modes.clone();
+                    async move |_req: acp::ResumeSessionRequest, responder, _cx| {
+                        let current_options = options.lock().expect("agent options").clone();
+                        let current_modes = modes.lock().expect("agent modes").clone();
+                        responder.respond(
+                            acp::ResumeSessionResponse::new()
+                                .config_options(current_options)
+                                .modes(current_modes),
+                        )
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let options = options.clone();
+                    let script = script.clone();
+                    let requests = requests.clone();
+                    let gate_rx = gate_rx.clone();
+                    async move |req: acp::SetSessionConfigOptionRequest, responder, _cx| {
+                        let params = serde_json::to_value(&req).expect("set config params");
+                        requests
+                            .lock()
+                            .expect("requests")
+                            .push((SET_CONFIG.to_string(), params.clone()));
+                        let config_id = params["configId"].as_str().unwrap_or_default().to_string();
+                        let value = params["value"].clone();
+                        if script
+                            .rejected_values
+                            .iter()
+                            .any(|(id, rejected)| *id == config_id && *rejected == value)
+                        {
+                            if let Some(gate) = gate_rx.as_ref() {
+                                gate.recv().await.ok();
+                            }
+                            return responder
+                                .respond_with_error(acp::ErrorCode::InternalError.into());
+                        }
+                        let list = {
+                            let mut guard = options.lock().expect("agent options");
+                            let list = guard.get_or_insert_with(Vec::new);
+                            for option in list.iter_mut() {
+                                if option.id.0.as_ref() != config_id {
+                                    continue;
+                                }
+                                match &mut option.kind {
+                                    acp::SessionConfigKind::Select(select) => {
+                                        if let Some(id) = value.as_str() {
+                                            select.current_value =
+                                                acp::SessionConfigValueId::new(id.to_string());
+                                        }
+                                    }
+                                    acp::SessionConfigKind::Boolean(boolean) => {
+                                        if let Some(flag) = value.as_bool() {
+                                            boolean.current_value = flag;
+                                        }
+                                    }
+                                    #[allow(unreachable_patterns)]
+                                    _ => {}
+                                }
+                            }
+                            if let Some((id, trigger, extra)) = &script.side_effect
+                                && *id == config_id
+                                && value.as_str() == Some(*trigger)
+                                && !list.iter().any(|option| option.id == extra.id)
+                            {
+                                list.push(extra.clone());
+                            }
+                            list.clone()
+                        };
+                        responder.respond(acp::SetSessionConfigOptionResponse::new(list))
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                {
+                    let modes = modes.clone();
+                    let script = script.clone();
+                    let requests = requests.clone();
+                    let gate_rx = gate_rx.clone();
+                    async move |req: acp::SetSessionModeRequest, responder, _cx| {
+                        let params = serde_json::to_value(&req).expect("set mode params");
+                        requests
+                            .lock()
+                            .expect("requests")
+                            .push((SET_MODE.to_string(), params));
+                        if script
+                            .rejected_modes
+                            .iter()
+                            .any(|mode| *mode == req.mode_id.0.as_ref())
+                        {
+                            if let Some(gate) = gate_rx.as_ref() {
+                                gate.recv().await.ok();
+                            }
+                            return responder
+                                .respond_with_error(acp::ErrorCode::InternalError.into());
+                        }
+                        if let Some(state) = modes.lock().expect("agent modes").as_mut() {
+                            state.current_mode_id = req.mode_id.clone();
+                        }
+                        responder.respond(acp::SetSessionModeResponse::new())
+                    }
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_request(
+                async move |_req: acp::CloseSessionRequest, responder, _cx| {
+                    responder.respond(acp::CloseSessionResponse::new())
+                },
+                agent_client_protocol::on_receive_request!(),
+            )
+            .on_receive_notification(
+                async move |_notif: acp::CancelNotification, _cx| Ok(()),
+                agent_client_protocol::on_receive_notification!(),
+            )
+            .connect_with(agent_transport, async move |agent| {
+                agent_tx.send(agent).ok();
+                futures::future::pending::<Result<(), agent_client_protocol::Error>>().await
+            });
+        let agent_io_task = cx.background_spawn(agent_future);
+
+        let sessions: Rc<RefCell<HashMap<acp_v2::SessionId, AcpSession>>> =
+            Rc::new(RefCell::new(HashMap::default()));
+        let client_session_list: Rc<RefCell<Option<Rc<AcpSessionList>>>> =
+            Rc::new(RefCell::new(None));
+        let (dispatch_tx, dispatch_rx) = mpsc::unbounded::<ForegroundWork>();
+        let (connection_tx, connection_rx) = futures::channel::oneshot::channel();
+        let client_future = connect_client_future(
+            "zed-test",
+            client_transport,
+            dispatch_tx.clone(),
+            connection_tx,
+        );
+        let client_io_task = cx.background_spawn(async move {
+            client_future.await.ok();
+        });
+        let client_conn: ConnectionTo<Agent> = connection_rx
+            .await
+            .expect("failed to receive ACP connection handle");
+        let response = client_conn
+            .send_request(acp::InitializeRequest::new(ProtocolVersion::V1))
+            .block_task()
+            .await
+            .expect("failed to initialize ACP connection");
+        let agent = agent_rx.await.expect("receive fake agent handle");
+
+        let request_elicitations = cx.new(|_| ElicitationStore::default());
+        let dispatch_context = ClientContext {
+            sessions: sessions.clone(),
+            session_list: client_session_list.clone(),
+            request_elicitations: request_elicitations.clone(),
+        };
+        let dispatch_task = cx.spawn({
+            let mut dispatch_rx = dispatch_rx;
+            move |cx| async move {
+                let mut cx = cx;
+                while let Some(work) = dispatch_rx.next().await {
+                    work.run(&mut cx, &dispatch_context);
+                }
+            }
+        });
+        let agent_server_store =
+            project.read_with(cx, |project, _| project.agent_server_store().downgrade());
+        let mut connection = cx.update(|cx| {
+            AcpConnection::new_for_test(
+                client_conn,
+                sessions,
+                response.agent_capabilities,
+                request_elicitations,
+                agent_server_store,
+                client_io_task,
+                dispatch_tx,
+                dispatch_task,
+                cx,
+            )
+        });
+        connection.id = AgentId::new(agent_id);
+
+        let keep_alive = cx.background_spawn(async move {
+            agent_io_task.await.ok();
+        });
+
+        Self {
+            connection: Rc::new(connection),
+            project,
+            agent,
+            requests,
+            gate_tx: RefCell::new(Some(gate_tx)),
+            _keep_alive: keep_alive,
+        }
+    }
+
+    /// The entry's `default_mode` and `default_config_options`.
+    pub(super) fn set_defaults(
+        &self,
+        mode: Option<&str>,
+        options: Vec<(&str, AgentConfigOptionValue)>,
+    ) {
+        self.connection.defaults.set(
+            mode.map(|mode| acp::SessionModeId::new(mode.to_string())),
+            options
+                .into_iter()
+                .map(|(id, value)| (id.to_string(), value))
+                .collect(),
+        );
+    }
+
+    pub(super) async fn load(
+        &self,
+        session_id: &str,
+        cx: &mut gpui::TestAppContext,
+    ) -> Entity<AcpThread> {
+        let thread = cx
+            .update(|cx| {
+                self.connection.clone().load_session(
+                    acp_v2::SessionId::new(session_id.to_string()),
+                    self.project.clone(),
+                    PathList::new(&[std::path::Path::new(WORK_DIR)]),
+                    None,
+                    cx,
+                )
+            })
+            .await
+            .expect("session should load");
+        cx.run_until_parked();
+        thread
+    }
+
+    /// Opens `session_id` through `session/resume` -- the other way back into a thread.
+    pub(super) async fn resume(
+        &self,
+        session_id: &str,
+        cx: &mut gpui::TestAppContext,
+    ) -> Entity<AcpThread> {
+        let thread = cx
+            .update(|cx| {
+                self.connection.clone().resume_session(
+                    acp_v2::SessionId::new(session_id.to_string()),
+                    self.project.clone(),
+                    PathList::new(&[std::path::Path::new(WORK_DIR)]),
+                    None,
+                    cx,
+                )
+            })
+            .await
+            .expect("session should resume");
+        cx.run_until_parked();
+        thread
+    }
+
+    pub(super) async fn new_session(&self, cx: &mut gpui::TestAppContext) -> Entity<AcpThread> {
+        let thread = cx
+            .update(|cx| {
+                self.connection.clone().new_session(
+                    self.project.clone(),
+                    PathList::new(&[std::path::Path::new(WORK_DIR)]),
+                    cx,
+                )
+            })
+            .await
+            .expect("session should be created");
+        cx.run_until_parked();
+        thread
+    }
+
+    /// A menu pick, through the same entry point the UI uses.
+    pub(super) async fn pick(
+        &self,
+        session_id: &str,
+        config_id: &str,
+        value: acp_v2::SessionConfigOptionValue,
+        cx: &mut gpui::TestAppContext,
+    ) -> Result<()> {
+        let options = cx
+            .update(|cx| {
+                self.connection
+                    .session_config_options(&acp_v2::SessionId::new(session_id.to_string()), cx)
+            })
+            .expect("the session exposes config options");
+        let result = cx
+            .update(|cx| {
+                options.set_config_option(
+                    acp_v2::SessionConfigId::new(config_id.to_string()),
+                    value,
+                    cx,
+                )
+            })
+            .await;
+        cx.run_until_parked();
+        result.map(|_| ())
+    }
+
+    /// A mode pick, through the same entry point the UI uses.
+    pub(super) async fn pick_mode(
+        &self,
+        session_id: &str,
+        mode_id: &str,
+        cx: &mut gpui::TestAppContext,
+    ) -> Result<()> {
+        let modes = cx
+            .update(|cx| {
+                self.connection
+                    .session_modes(&acp_v2::SessionId::new(session_id.to_string()), cx)
+            })
+            .expect("the session exposes modes");
+        let result = cx
+            .update(|cx| modes.set_mode(acp::SessionModeId::new(mode_id.to_string()), cx))
+            .await;
+        cx.run_until_parked();
+        result
+    }
+
+    /// Releases every held rejection and lets the answers settle.
+    pub(super) fn open_gate(&self, cx: &mut gpui::TestAppContext) {
+        drop(self.gate_tx.borrow_mut().take());
+        cx.run_until_parked();
+    }
+
+    /// Several mode picks issued together, before any answer is processed —
+    /// two changes in flight at once.
+    pub(super) fn start_mode_picks(
+        &self,
+        session_id: &str,
+        mode_ids: &[&str],
+        cx: &mut gpui::TestAppContext,
+    ) -> Vec<Task<Result<()>>> {
+        let modes = cx
+            .update(|cx| {
+                self.connection
+                    .session_modes(&acp_v2::SessionId::new(session_id.to_string()), cx)
+            })
+            .expect("the session exposes modes");
+        cx.update(|cx| {
+            mode_ids
+                .iter()
+                .map(|mode| modes.set_mode(acp::SessionModeId::new(mode.to_string()), cx))
+                .collect()
+        })
+    }
+
+    /// The agent pushes a `session/update` over the wire.
+    pub(super) fn notify(
+        &self,
+        session_id: &str,
+        update: acp::SessionUpdate,
+        cx: &mut gpui::TestAppContext,
+    ) {
+        self.agent
+            .send_notification(acp::SessionNotification::new(
+                acp::SessionId::new(session_id.to_string()),
+                update,
+            ))
+            .expect("agent sends a session update");
+        cx.run_until_parked();
+    }
+
+    /// `(config id, wire value)` of every `session/set_config_option`, sorted.
+    pub(super) fn config_requests(&self) -> Vec<(String, serde_json::Value)> {
+        let mut sent: Vec<(String, serde_json::Value)> = self
+            .requests
+            .lock()
+            .expect("requests")
+            .iter()
+            .filter(|(method, _)| method == SET_CONFIG)
+            .map(|(_, params)| {
+                (
+                    params["configId"].as_str().unwrap_or_default().to_string(),
+                    params["value"].clone(),
+                )
+            })
+            .collect();
+        sent.sort_by(|a, b| a.0.cmp(&b.0));
+        sent
+    }
+
+    /// Mode ids of every `session/set_mode`, in order.
+    pub(super) fn mode_requests(&self) -> Vec<String> {
+        self.requests
+            .lock()
+            .expect("requests")
+            .iter()
+            .filter(|(method, _)| method == SET_MODE)
+            .map(|(_, params)| params["modeId"].as_str().unwrap_or_default().to_string())
+            .collect()
+    }
+
+    pub(super) fn is_open(&self, session_id: &str) -> bool {
+        self.connection
+            .sessions
+            .borrow()
+            .contains_key(&acp_v2::SessionId::new(session_id.to_string()))
+    }
+
+    /// The value Zeo currently holds for an option: a JSON string or bool.
+    pub(super) fn option_value(
+        &self,
+        session_id: &str,
+        config_id: &str,
+    ) -> Option<serde_json::Value> {
+        let sessions = self.connection.sessions.borrow();
+        let session = sessions.get(&acp_v2::SessionId::new(session_id.to_string()))?;
+        let options = session.config_options.as_ref()?.config_options.borrow();
+        let option = options
+            .iter()
+            .find(|option| option.config_id.0.as_ref() == config_id)?;
+        match &option.kind {
+            acp_v2::SessionConfigKind::Select(select) => {
+                Some(serde_json::json!(select.current_value.0.as_ref()))
+            }
+            acp_v2::SessionConfigKind::Boolean(boolean) => {
+                Some(serde_json::json!(boolean.current_value))
+            }
+            _ => None,
+        }
+    }
+
+    pub(super) fn current_mode(&self, session_id: &str) -> Option<String> {
+        let sessions = self.connection.sessions.borrow();
+        let session = sessions.get(&acp_v2::SessionId::new(session_id.to_string()))?;
+        let modes = session.session_modes.as_ref()?;
+        Some(modes.borrow().current_mode_id.0.to_string())
+    }
+}
+
+/// Drops entity handles and lets the release effects close the session.
+pub(super) fn release(cx: &mut gpui::TestAppContext) {
+    cx.run_until_parked();
+    cx.update(|_| ());
+    cx.run_until_parked();
+}
+
+pub(super) fn select(id: &str, current: &str, values: &[&str]) -> acp::SessionConfigOption {
+    acp::SessionConfigOption::select(
+        id.to_string(),
+        id.to_string(),
+        current.to_string(),
+        values
+            .iter()
+            .map(|value| acp::SessionConfigSelectOption::new(value.to_string(), value.to_string()))
+            .collect::<Vec<_>>(),
+    )
+}
+
+pub(super) fn boolean(id: &str, current: bool) -> acp::SessionConfigOption {
+    acp::SessionConfigOption::boolean(id.to_string(), id.to_string(), current)
+}
+
+pub(super) fn modes(current: &str, available: &[&str]) -> acp::SessionModeState {
+    acp::SessionModeState::new(
+        acp::SessionModeId::new(current.to_string()),
+        available
+            .iter()
+            .map(|mode| acp::SessionMode::new(mode.to_string(), mode.to_string()))
+            .collect::<Vec<_>>(),
+    )
+}
+
+pub(super) fn id_value(value: &str) -> acp_v2::SessionConfigOptionValue {
+    acp_v2::SessionConfigOptionValue::id(value.to_string())
+}
+
+pub(super) fn wire(config_id: &str, value: serde_json::Value) -> (String, serde_json::Value) {
+    (config_id.to_string(), value)
+}
+
+pub(super) fn recorded_config(
+    mode: Option<&str>,
+    options: Vec<(&str, RecordedValue)>,
+) -> RecordedConfig {
+    RecordedConfig {
+        mode: mode.map(str::to_string),
+        options: options
+            .into_iter()
+            .map(|(id, value)| (id.to_string(), value))
+            .collect(),
+    }
+}
+
+pub(super) fn recorded(
+    agent_id: &str,
+    session_id: &str,
+    cx: &mut gpui::TestAppContext,
+) -> Option<RecordedConfig> {
+    cx.update(|cx| {
+        thread_config_store::read(
+            &AgentId::new(agent_id.to_string()),
+            &acp_v2::SessionId::new(session_id.to_string()),
+            cx,
+        )
+    })
+}
+
+pub(super) async fn record(
+    agent_id: &str,
+    session_id: &str,
+    config: RecordedConfig,
+    cx: &mut gpui::TestAppContext,
+) {
+    cx.update(|cx| {
+        thread_config_store::write(
+            &AgentId::new(agent_id.to_string()),
+            &acp_v2::SessionId::new(session_id.to_string()),
+            &config,
+            cx,
+        )
+    })
+    .await
+    .expect("seeding a record succeeds");
+}
+
+pub(super) fn recorded_id(config: &RecordedConfig, option: &str) -> Option<String> {
+    match config.options.get(option)? {
+        RecordedValue::Id(value) => Some(value.clone()),
+        RecordedValue::Bool(_) => None,
+    }
+}
+
+pub(super) fn recorded_bool(config: &RecordedConfig, option: &str) -> Option<bool> {
+    match config.options.get(option)? {
+        RecordedValue::Bool(value) => Some(*value),
+        RecordedValue::Id(_) => None,
+    }
+}
