+#[gpui::test]
+async fn deleting_a_thread_deletes_only_its_own_thread_config_record(cx: &mut TestAppContext) {
+    // R3.2, with R3.1's hostile half: the same session id under another agent,
+    // and another thread of the same agent, keep their records.
+    init(cx);
+    record(PLUS, "s-1", "opus", cx).await;
+    record(CODEX, "s-1", "gpt-5", cx).await;
+    record(PLUS, "s-2", "haiku", cx).await;
+    let doomed = thread(PLUS, Some("s-1"));
+    let doomed_id = doomed.thread_id;
+    save(doomed, cx);
+    save(thread(PLUS, Some("s-2")), cx);
+
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(doomed_id, cx));
+    });
+    cx.run_until_parked();
+
+    assert!(
+        !has_record(PLUS, "s-1", cx),
+        "the deleted thread's record must go"
+    );
+    assert!(
+        has_record(CODEX, "s-1", cx),
+        "another agent's record with the same session id stays"
+    );
+    assert!(has_record(PLUS, "s-2", cx), "another thread's record stays");
+}
