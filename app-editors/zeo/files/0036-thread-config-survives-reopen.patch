+#[test]
+fn key_keeps_pairs_apart_when_a_separator_moves_between_agent_and_session() {
+    // Hostile half (collapse): an agent id is free text, so any character a
+    // concatenating key could use as a separator can sit inside either id.
+    let pairs = [
+        ("a/b", "c"),
+        ("a", "b/c"),
+        ("a:b", "c"),
+        ("a", "b:c"),
+        ("a b", "c"),
+        ("a", "b c"),
+        ("a\"", "b"),
+        ("a", "\"b"),
+        ("a\",\"b", "c"),
+        ("a", "b\",\"c"),
+        ("ab", ""),
+        ("", "ab"),
+        ("a", "b"),
+    ];
+    let keys: HashSet<String> = pairs
+        .iter()
+        .map(|(agent_id, session_id)| {
+            key(&agent(agent_id), &session(session_id)).expect("key renders")
+        })
+        .collect();
+    assert_eq!(
+        keys.len(),
+        pairs.len(),
+        "two different (agent, session) pairs rendered the same key: {keys:?}"
+    );
+}
+
+#[test]
+fn key_of_a_third_pair_cannot_spell_another_pairs_key() {
+    // Hostile half for the derived value itself: a third input whose agent id
+    // already IS the rendered key of another pair must not land on that key.
+    let rendered = key(&agent("Claude Agent (Plus)"), &session("s-1")).expect("key renders");
+    let third = key(&agent(&rendered), &session("")).expect("key renders");
+    let fourth = key(&agent(""), &session(&rendered)).expect("key renders");
+    assert_ne!(rendered, third);
+    assert_ne!(rendered, fourth);
+    assert_ne!(third, fourth);
+
+    // The key decodes back to exactly its pair, which is what makes it
+    // injective for every input, not only for the fixtures above.
+    for (agent_id, session_id) in [
+        ("Claude Agent (Plus)", "s-1"),
+        (rendered.as_str(), ""),
+        ("", rendered.as_str()),
+        ("a\",\"b", "c"),
+    ] {
+        let decoded: (String, String) = serde_json::from_str(
+            &key(&agent(agent_id), &session(session_id)).expect("key renders"),
+        )
+        .expect("the key is the JSON encoding of the pair");
+        assert_eq!(decoded, (agent_id.to_string(), session_id.to_string()));
+    }
+}
