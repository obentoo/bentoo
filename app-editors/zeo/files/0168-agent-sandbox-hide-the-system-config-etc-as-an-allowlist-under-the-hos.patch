+
+/// Bug 13 of the operator's list of 2026-11-23: Hide the System Config follows the project, then
+/// the default, and applies only under Hide the Host.
+#[test]
+fn agent_jail_host_system_config_follows_the_project_and_needs_the_host_view() {
+    let on = sandbox(
+        true,
+        false,
+        AgentSandboxProjectSettings {
+            minimal_etc: Some(true),
+            ..AgentSandboxProjectSettings::default()
+        },
+    );
+    let switches = host_switches(&on, Some("/p"));
+    assert!(switches.minimal_etc && !switches.overlay_disabled);
+    assert!(
+        !host_switches(&sandbox(true, false, Default::default()), Some("/p")).minimal_etc,
+        "off by default"
+    );
+    let shown = sandbox(
+        true,
+        false,
+        AgentSandboxProjectSettings {
+            mask_host: Some(false),
+            minimal_etc: Some(true),
+            ..AgentSandboxProjectSettings::default()
+        },
+    );
+    let switches = host_switches(&shown, Some("/p"));
+    assert!(
+        switches.minimal_etc && switches.overlay_disabled,
+        "kept as set, but disabled while the host is shown"
+    );
+}
