diff --git a/crates/agent_sandbox/src/minimal_etc_tests.rs b/crates/agent_sandbox/src/minimal_etc_tests.rs
new file mode 100644
index 0000000..ac7ffe3
--- /dev/null
+++ b/crates/agent_sandbox/src/minimal_etc_tests.rs
@@ -0,0 +1,119 @@
+// Bug 13 of the operator's list of 2026-11-23: the jail should not see the host's system
+// configuration. ai-jail 3.5.0-r5's --minimal-etc (under --mask-host) makes /etc a tmpfs holding
+// only an allowlist of the host's entries; Zeo passes it for `agent_sandbox.minimal_etc`, the
+// Agent Sandbox page's Hide the System Config. Filter: `minimal_etc`.
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use crate::host_view::{HostLayer, MASK_HOST_OPTION, MINIMAL_ETC_OPTION, host_args_for};
+use crate::launch_tests::*;
+
+/// ai-jail 3.5.0-r4's options; `minimal_etc` adds `--minimal-etc`, as 3.5.0-r5 does.
+fn help(minimal_etc: bool) -> String {
+    let extra = if minimal_etc {
+        "    --minimal-etc  Allowlisted /etc\\n"
+    } else {
+        ""
+    };
+    format!(
+        "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n    --cpus <LIST>  Pin CPUs\\n    --mask-host  Synthetic host view\\n    --overlay-system  Overlays\\n    --syscall-view  Syscalls\\n{extra}' ;; *) echo 'ai-jail 3.5.0' ;; esac"
+    )
+}
+
+fn settings(f: &Fixture, project: Value) -> Value {
+    let mut value = sandbox(f, true, project, memory_off());
+    value["agent_sandbox"]["state_root"] = json!(f.base.join("state"));
+    value
+}
+
+/// Whether the jailed command's own options (before `--`) carry `option`.
+fn has(args: &[String], option: &str) -> bool {
+    let end = args
+        .iter()
+        .position(|arg| arg == "--")
+        .unwrap_or(args.len());
+    args[..end].iter().any(|arg| arg == option)
+}
+
+fn all_exist(_: &std::path::Path) -> bool {
+    true
+}
+
+#[test]
+fn minimal_etc_rides_mask_host_only() {
+    let layer = HostLayer {
+        identity: true,
+        minimal_etc: true,
+        ..HostLayer::default()
+    };
+    let args = host_args_for(true, layer, all_exist);
+    let mask = args.iter().position(|a| a == MASK_HOST_OPTION);
+    let etc = args.iter().position(|a| a == MINIMAL_ETC_OPTION);
+    assert!(mask.is_some() && etc > mask, "{args:?}");
+    let shown = host_args_for(false, layer, all_exist);
+    assert!(
+        !shown.contains(&MINIMAL_ETC_OPTION.to_string()),
+        "no host view, no minimal /etc: {shown:?}"
+    );
+}
+
+#[gpui::test]
+async fn minimal_etc_is_passed_when_the_project_asks(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "minimal_etc": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(has(&cmd.args, MINIMAL_ETC_OPTION), "{:?}", cmd.args);
+}
+
+/// Off by default: the switch is new and stays off until it has run in daily use.
+#[gpui::test]
+async fn minimal_etc_is_off_by_default(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(!has(&cmd.args, MINIMAL_ETC_OPTION), "{:?}", cmd.args);
+}
+
+/// Hostile: an ai-jail without the option refuses the start and says what is missing, rather
+/// than starting a jail that shows the whole /etc while the switch says it is hidden.
+#[gpui::test]
+async fn minimal_etc_refuses_an_ai_jail_without_the_option(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(false));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": true, "minimal_etc": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let text = refused(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(
+        text.contains("--minimal-etc"),
+        "says what is missing: {text}"
+    );
+}
+
+/// Hostile: without the host view there is nothing to hide /etc for; it is not passed.
+#[gpui::test]
+async fn minimal_etc_needs_the_host_view(cx: &mut TestAppContext) {
+    init(cx);
+    let f = fixture("ai-jail 3.5.0");
+    write_script(&f.ai_jail, &help(true));
+    set_user_settings(
+        settings(&f, json!({ "mask_host": false, "minimal_etc": true })),
+        cx,
+    );
+    let project = project(&f, cx).await;
+    let (_, cmd) = jailed(run(&project, agent_cmd("/usr/bin/claude-agent-acp-plus"), cx).await);
+    assert!(!has(&cmd.args, MINIMAL_ETC_OPTION), "{:?}", cmd.args);
+}
