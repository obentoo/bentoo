+                            if fit.get() != next {
+                                fit.set(next);
+                                // The toggle is decided from this; show the change now.
+                                window.refresh();
+                            }
+                        },
+                        |_, _, _, _| {},
+                    )
+                    .absolute()
+                    .top_0()
+                    .left_0()
+                    .size_full(),
+                )
                 .into_any_element()
         };
         let header = h_flex()
@@ -111,21 +190,35 @@ impl ThreadView {
                     .size(IconSize::Small)
