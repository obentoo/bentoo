+
+// Zeo next proposal §6.32 (ask 53): the expand/collapse toggle shows only when the minimized
+// line hides something.
+
+#[test]
+fn a_short_single_line_that_fits_needs_no_toggle() {
+    assert!(!needs_toggle("fix the test", Some((px(80.), px(300.)))));
+}
+
+#[test]
+fn a_single_line_wider_than_its_space_needs_the_toggle() {
+    assert!(needs_toggle(
+        "a very long request",
+        Some((px(420.), px(300.)))
+    ));
+}
+
+#[test]
+fn a_second_line_always_needs_the_toggle() {
+    assert!(needs_toggle("first\nsecond", Some((px(20.), px(300.)))));
+}
+
+/// Hostile: blank lines around one line are not a second line -- the minimized header already
+/// shows everything there is.
+#[test]
+fn blank_lines_are_not_a_second_line() {
+    assert!(!needs_toggle("\n  fix it  \n\n", Some((px(30.), px(300.)))));
+}
+
+/// Hostile: before the first measurement the toggle stays, so a long message is never left
+/// without a way to expand it.
+#[test]
+fn an_unmeasured_line_keeps_the_toggle() {
+    assert!(needs_toggle("fix it", None));
+}
