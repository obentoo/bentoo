+/// Whether the minimized header hides part of the message, so the expand toggle is worth
+/// showing. `measured` is the first line's shaped width and the width the header leaves for it,
+/// from the last frame; before the first measurement the toggle stays, so a long message is never
+/// left without a way to expand it.
+pub(super) fn needs_toggle(text: &str, measured: Option<(Pixels, Pixels)>) -> bool {
+    let non_blank_lines = text.lines().filter(|line| !line.trim().is_empty()).count();
+    if non_blank_lines > 1 {
+        return true;
+    }
+    match measured {
+        Some((line_width, available)) => line_width > available,
+        None => true,
+    }
+}
+
+/// What the last frame measured for a pinned message: its entry, the first line's shaped
+/// width, and the width the header left for it.
+pub(crate) type PinnedMessageFit = std::rc::Rc<std::cell::Cell<Option<(usize, Pixels, Pixels)>>>;
+
 /// The first non-blank line of a message, for the minimized header.
 pub(super) fn first_line(text: &str) -> &str {
     text.lines()
@@ -40,7 +66,11 @@ pub(super) fn first_line(text: &str) -> &str {
 }
 
