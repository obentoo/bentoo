+    /// Ask the agent for the account quota now, rather than at its next poll.
+    ///
+    /// Called when the pointer enters the context ring, so it is bounded twice: a
+    /// request still in flight absorbs the next one, and a new request waits
+    /// [`ACCOUNT_USAGE_REFRESH_MIN_INTERVAL`] after the previous one was sent. An agent
+    /// without the capability answers with an error, which is logged at debug level
+    /// and otherwise ignored -- the ring keeps showing what the agent last pushed.
+    pub fn refresh_account_usage(&mut self, cx: &mut Context<Self>) {
+        let now = cx.background_executor().now();
+        if self.account_usage_refreshing
+            || self.account_usage_refreshed_at.is_some_and(|at| {
+                now.saturating_duration_since(at) < ACCOUNT_USAGE_REFRESH_MIN_INTERVAL
+            })
+        {
+            return;
+        }
+        self.account_usage_refreshing = true;
+        self.account_usage_refreshed_at = Some(now);
+        let session_id = self.session_id().clone();
+        let request = self
+            .connection
+            .clone()
+            .refresh_account_usage(&session_id, cx);
+        cx.spawn(async move |this, cx| {
+            let result = request.await;
+            if let Err(error) = &result {
+                log::debug!(
+                    "account usage refresh for session {}: {error:#}",
+                    session_id.0
+                );
+            }
+            this.update(cx, |this, _| this.account_usage_refreshing = false)
+                .ok();
+        })
+        .detach();
+    }
+
