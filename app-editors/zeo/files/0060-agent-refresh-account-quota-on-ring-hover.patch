+            params,
+            session_id.0.to_string(),
+        );
+        cx.foreground_executor().spawn(async move {
+            let response = request.await?;
+            response
+                .get("refreshed")
+                .and_then(serde_json::Value::as_bool)
+                .with_context(|| {
+                    format!(
+                        "{CLAUDE_USAGE_REFRESH_METHOD}: response has no boolean \
+                         `refreshed`: {response}"
+                    )
+                })
+        })
