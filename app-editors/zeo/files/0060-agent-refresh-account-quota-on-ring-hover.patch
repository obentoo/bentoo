@@ -0,0 +1,130 @@
+// Patch 0060 — `AcpConnection::refresh_account_usage` against a fake ACP peer.
+//
+// The gate is the `_claude/usage` capability the agent advertises in `initialize`
+// (`agentCapabilities._meta["_claude/usage"].version >= 1`), never the entry id or the
+// agent's self-reported name, as for `_claude/tasks`.
+//
+// Included at the end of `mod tests` in `acp.rs`, after `acp_task_actions_tests.rs`,
+// whose peer it reuses. Filter: `cargo test -p agent_servers usage_refresh`.
+
+fn usage_capability_v(version: u64) -> Option<serde_json::Map<String, serde_json::Value>> {
+    Some(serde_json::Map::from_iter([(
+        "_claude/usage".to_string(),
+        serde_json::json!({ "version": version }),
+    )]))
+}
+
+#[gpui::test]
+async fn test_usage_refresh_sends_the_session_and_reads_refreshed(cx: &mut gpui::TestAppContext) {
+    let peer = connect_peer_with_meta(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        usage_capability_v(1),
+        Arc::new(|_method, _params| Ok(serde_json::json!({ "refreshed": true }))),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let refreshed = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .refresh_account_usage(&session_id, cx)
+        })
+        .await
+        .expect("refresh succeeds");
+
+    assert!(refreshed);
+    assert_eq!(
+        task_actions_requests(&peer),
+        vec![(
+            "_claude/usage/refresh".to_string(),
+            serde_json::json!({ "sessionId": session_id.to_string() }),
+        )]
+    );
+}
+
+#[gpui::test]
+async fn test_usage_refresh_false_is_an_answer_and_a_missing_field_is_an_error(
+    cx: &mut gpui::TestAppContext,
+) {
+    let answers = Arc::new(std::sync::Mutex::new(vec![
+        serde_json::json!({}),
+        serde_json::json!({ "refreshed": false }),
+    ]));
+    let peer = connect_peer_with_meta(
+        PLUS_ENTRY,
+        PLUS_NAME,
+        usage_capability_v(1),
+        Arc::new(move |_method, _params| {
+            Ok(answers
+                .lock()
+                .expect("answers mutex")
+                .pop()
+                .expect("an answer"))
+        }),
+        cx,
+    )
+    .await;
+    let (_thread, session_id) = task_actions_session(&peer, cx).await;
+
+    let nothing_published = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .refresh_account_usage(&session_id, cx)
+        })
+        .await
+        .expect("false is an answer, not an error");
+    let malformed = cx
+        .update(|cx| {
+            peer.connection
+                .clone()
+                .refresh_account_usage(&session_id, cx)
+        })
+        .await;
+
+    assert!(!nothing_published);
+    assert!(
+        malformed.is_err(),
+        "a response without `refreshed` must not read as false"
+    );
+}
+
+// Hostile half first: an agent that advertises `_claude/tasks` but not `_claude/usage`
+// -- every Plus release before the method existed -- is not sent the request.
+#[gpui::test]
+async fn test_usage_refresh_unsupported_without_the_capability(cx: &mut gpui::TestAppContext) {
+    for meta in [
+        None,
+        Some(serde_json::Map::from_iter([(
+            "_claude/tasks".to_string(),
+            serde_json::json!({ "version": 2 }),
+        )])),
+        usage_capability_v(0),
+    ] {
+        let peer = connect_peer_with_meta(
+            crate::CLAUDE_AGENT_ID,
+            PLUS_NAME,
+            meta,
+            task_actions_ok(),
+            cx,
+        )
+        .await;
+        let (_thread, session_id) = task_actions_session(&peer, cx).await;
+        let result = cx
+            .update(|cx| {
+                peer.connection
+                    .clone()
+                    .refresh_account_usage(&session_id, cx)
+            })
+            .await;
+        let error = result.expect_err("no capability, no request");
+        assert!(error.to_string().contains("not supported"), "{error}");
+        assert!(
+            task_actions_requests(&peer).is_empty(),
+            "nothing reached the agent"
+        );
+    }
+}
