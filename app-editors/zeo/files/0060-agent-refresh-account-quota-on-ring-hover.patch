+    /// Keyed on the capability alone, like `agent_tasks_version`. Version 1 carries
+    /// `_claude/usage/refresh`; 0 when nothing is advertised.
+    fn agent_usage_version(&self) -> u64 {
+        self.agent_capabilities
+            .meta
+            .as_ref()
+            .and_then(|meta| meta.get(CLAUDE_USAGE_CAPABILITY))
+            .and_then(|capability| capability.get("version"))
+            .and_then(serde_json::Value::as_u64)
