+    fn refresh_account_usage(
+        self: Rc<Self>,
+        session_id: &acp_v2::SessionId,
+        cx: &mut App,
+    ) -> Task<Result<bool>> {
+        let version = self.agent_usage_version();
+        if version < 1 {
+            return Task::ready(Err(anyhow!(
+                "Refreshing the account usage is not supported: the agent advertises \
+                 {CLAUDE_USAGE_CAPABILITY} version {version}"
+            )));
