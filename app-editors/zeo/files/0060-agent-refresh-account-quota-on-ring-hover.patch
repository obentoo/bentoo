+    /// 0060: hovering the ring asks the agent for the quota, at most once in flight and
+    /// once per `ACCOUNT_USAGE_REFRESH_MIN_INTERVAL`, however often the pointer enters.
+    #[gpui::test]
+    async fn refresh_account_usage_is_bounded_in_flight_and_in_time(cx: &mut TestAppContext) {
+        init_test(cx);
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, [], cx).await;
+        let connection = Rc::new(FakeAgentConnection::new());
+        let thread = cx
+            .update(|cx| {
+                connection.clone().new_session(
+                    project,
+                    PathList::new(&[Path::new(path!("/test"))]),
+                    cx,
+                )
+            })
+            .await
+            .unwrap();
+        let refresh = |cx: &mut TestAppContext| {
+            thread.update(cx, |thread, cx| thread.refresh_account_usage(cx));
+            cx.run_until_parked();
+        };
+
+        // Hostile half: a slow agent and a pointer that keeps entering.
+        // Hostile half: a slow agent, still answering after the interval has passed.
+        connection.hold_usage_refreshes.set(true);
+        refresh(cx);
+        cx.executor()
+            .advance_clock(ACCOUNT_USAGE_REFRESH_MIN_INTERVAL);
+        refresh(cx);
+        assert_eq!(connection.usage_refreshes.get(), 1, "one request in flight");
+
+        for tx in connection.held_usage_refreshes.borrow_mut().drain(..) {
+            tx.send(()).ok();
+        }
+        cx.run_until_parked();
+        connection.hold_usage_refreshes.set(false);
+        refresh(cx);
+        assert_eq!(
+            connection.usage_refreshes.get(),
+            2,
+            "answered, so the next one goes"
+        );
+
+        // A pointer that keeps entering inside the interval does not ask again.
+        refresh(cx);
+        refresh(cx);
+        assert_eq!(
+            connection.usage_refreshes.get(),
+            2,
+            "inside the minimum interval"
+        );
+
+        // Benign half: once the interval has passed, the next hover asks again.
+        cx.executor()
+            .advance_clock(ACCOUNT_USAGE_REFRESH_MIN_INTERVAL);
+        refresh(cx);
+        assert_eq!(connection.usage_refreshes.get(), 3);
+    }
