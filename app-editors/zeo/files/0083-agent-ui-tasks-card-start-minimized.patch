@@ -0,0 +1,29 @@
+// Zeo next proposal §5.10 (ask 17): the tasks card can start minimized to its pill, by
+// setting; the default keeps today's open card.
+
+use agent_settings::AgentSettings;
+use gpui::{AppContext as _, TestAppContext};
+use settings::Settings as _;
+
+use super::TasksCard;
+
+fn card_starts_minimized(start_minimized: bool, cx: &mut TestAppContext) -> bool {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        let mut settings = AgentSettings::get_global(cx).clone();
+        settings.tasks_card.start_minimized = start_minimized;
+        AgentSettings::override_global(settings, cx);
+    });
+    let card = cx.new(TasksCard::new);
+    card.read_with(cx, |card, _| card.is_minimized())
+}
+
+#[gpui::test]
+fn the_card_starts_open_by_default(cx: &mut TestAppContext) {
+    assert!(!card_starts_minimized(false, cx));
+}
+
+#[gpui::test]
+fn the_card_starts_minimized_when_the_setting_says_so(cx: &mut TestAppContext) {
+    assert!(card_starts_minimized(true, cx));
+}
