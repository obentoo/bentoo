@@ -0,0 +1,366 @@
+//! The Agent Sandbox page's limits as − / + steppers (Zeo proposal §6.62, ask 85), on Zed's own
+//! `NumberField`: Shift and Alt change the step, and a click on the value still takes typing.
+//!
+//! Memory and disk growth are one size type each, stored in MiB and shown in their largest whole
+//! unit (`4G`, `1536M`). What a stepper shows is what it writes, and always with a suffix: ai-jail
+//! reads a bare number as bytes and refuses anything under 1 MiB or with a `B` suffix. CPU steps
+//! by one CPU (100 %), processes by 256. A click would rewrite the settings file each time, so the
+//! page writes once, `LIMIT_WRITE_DEBOUNCE` after the last click, and shows the pending value
+//! meanwhile so the next click counts from it.
+
+use std::{fmt, str::FromStr, time::Duration};
+
+use agent_sandbox::SandboxLimits;
+use agent_sandbox::disk_watch::parse_size;
+use gpui::{Context, Entity};
+use ui::prelude::*;
+
+use super::super::JailPageState;
+use super::{LimitField, LimitValue};
+use crate::components::{NumberField, NumberFieldMode, NumberFieldType};
+
+/// How long the page waits after the last click before it writes the limit.
+pub(crate) const LIMIT_WRITE_DEBOUNCE: Duration = Duration::from_millis(400);
+
+const MIB_PER_GIB: u64 = 1024;
+const MIB_PER_TIB: u64 = 1024 * 1024;
+
+/// `mib` in its largest whole unit; 0 stays `0`, which turns the limit off.
+fn format_mib(mib: u64) -> String {
+    if mib == 0 {
+        "0".to_string()
+    } else if mib.is_multiple_of(MIB_PER_TIB) {
+        format!("{}T", mib / MIB_PER_TIB)
+    } else if mib.is_multiple_of(MIB_PER_GIB) {
+        format!("{}G", mib / MIB_PER_GIB)
+    } else {
+        format!("{mib}M")
+    }
+}
+
+/// What a user types into a size stepper: a whole number with an optional K, M, G or T. A bare
+/// number is MiB, the unit the field steps in; a K value must be whole MiB.
+fn parse_mib(text: &str) -> Result<u64, String> {
+    let text = text.trim();
+    let refuse = || format!("{text:?} is not a size: a whole number with K, M, G or T (8G)");
+    let (digits, unit) = match text.chars().last() {
+        Some(last) if last.is_ascii_alphabetic() => {
+            (&text[..text.len() - 1], last.to_ascii_uppercase())
+        }
+        _ => (text, 'M'),
+    };
+    if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(refuse());
+    }
+    let value: u64 = digits.parse().map_err(|_| refuse())?;
+    match unit {
+        'K' if value.is_multiple_of(1024) => Ok(value / 1024),
+        'M' => Ok(value),
+        'G' => value.checked_mul(MIB_PER_GIB).ok_or_else(refuse),
+        'T' => value.checked_mul(MIB_PER_TIB).ok_or_else(refuse),
+        _ => Err(refuse()),
+    }
+}
+
+/// The largest size a stepper holds: 1024 TiB, far past any machine, and small enough that
+/// adding a step never overflows.
+const MAX_MIB: u64 = 1024 * MIB_PER_TIB;
+
+macro_rules! size_stepper {
+    ($(#[$meta:meta])* $name:ident, $step:expr, $large:expr, $small:expr) => {
+        $(#[$meta])*
+        #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+        pub(crate) struct $name(pub u64);
+
+        impl $name {
+            /// The stepper's start from a setting as the settings file holds it: any size the
+            /// limit accepts there (a bare number is bytes, as ai-jail reads it), rounded up to
+            /// whole MiB. Unset or unreadable reads as 0, no limit.
+            pub(crate) fn from_setting(text: Option<&str>) -> Self {
+                let bytes = text.and_then(parse_size).unwrap_or(0);
+                $name(bytes.div_ceil(1 << 20).min(MAX_MIB))
+            }
+        }
+
+        impl fmt::Display for $name {
+            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                f.write_str(&format_mib(self.0))
+            }
+        }
+
+        impl FromStr for $name {
+            type Err = String;
+
+            fn from_str(text: &str) -> Result<Self, String> {
+                parse_mib(text).map(|mib| $name(mib.min(MAX_MIB)))
+            }
+        }
+
+        impl NumberFieldType for $name {
+            fn default_step() -> Self {
+                $name($step)
+            }
+            fn large_step() -> Self {
+                $name($large)
+            }
+            fn small_step() -> Self {
+                $name($small)
+            }
+            fn min_value() -> Self {
+                $name(0)
+            }
+            fn max_value() -> Self {
+                $name(MAX_MIB)
+            }
+            fn saturating_add(self, rhs: Self) -> Self {
+                $name(self.0.saturating_add(rhs.0).min(MAX_MIB))
+            }
+            fn saturating_sub(self, rhs: Self) -> Self {
+                $name(self.0.saturating_sub(rhs.0))
+            }
+        }
+    };
+}
+
+size_stepper!(
+    /// The memory limit: a GiB a click, 4 GiB with Shift, 256 MiB with Alt.
+    MemoryMib,
+    MIB_PER_GIB,
+    4 * MIB_PER_GIB,
+    256
+);
+size_stepper!(
+    /// The disk growth before a pause: 5 GiB a click, 20 GiB with Shift, 1 GiB with Alt.
+    DiskMib,
+    5 * MIB_PER_GIB,
+    20 * MIB_PER_GIB,
+    MIB_PER_GIB
+);
+
+/// The CPU quota, in percent of one CPU: one CPU a click, four with Shift, a tenth with Alt.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct CpuPercent(pub u32);
+
+impl fmt::Display for CpuPercent {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{} %", self.0)
+    }
+}
+
+impl FromStr for CpuPercent {
+    type Err = String;
+
+    fn from_str(text: &str) -> Result<Self, String> {
+        let digits = text.trim().trim_end_matches('%').trim_end();
+        digits
+            .parse()
+            .map(CpuPercent)
+            .map_err(|_| format!("{text:?} is not a percentage of one CPU"))
+    }
+}
+
+/// The process and thread cap: 256 a click, 1024 with Shift, 16 with Alt.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct TaskCount(pub u64);
+
+impl fmt::Display for TaskCount {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+
+impl FromStr for TaskCount {
+    type Err = String;
+
+    fn from_str(text: &str) -> Result<Self, String> {
+        text.trim()
+            .parse()
+            .map(TaskCount)
+            .map_err(|_| format!("{text:?} is not a number of processes"))
+    }
+}
+
+macro_rules! count_stepper {
+    ($name:ident, $inner:ty, $step:expr, $large:expr, $small:expr) => {
+        impl NumberFieldType for $name {
+            fn default_step() -> Self {
+                $name($step)
+            }
+            fn large_step() -> Self {
+                $name($large)
+            }
+            fn small_step() -> Self {
+                $name($small)
+            }
+            fn min_value() -> Self {
+                $name(0)
+            }
+            fn max_value() -> Self {
+                $name(<$inner>::MAX)
+            }
+            fn saturating_add(self, rhs: Self) -> Self {
+                $name(self.0.saturating_add(rhs.0))
+            }
+            fn saturating_sub(self, rhs: Self) -> Self {
+                $name(self.0.saturating_sub(rhs.0))
+            }
+        }
+    };
+}
+
+count_stepper!(CpuPercent, u32, 100, 400, 10);
+count_stepper!(TaskCount, u64, 256, 1024, 16);
+
+/// The stepper for `field`: it starts at the value pending a write, else the value in force, else
+/// 0 (no limit), and every change goes through the limit's own rule before it is queued.
+pub(crate) fn render_stepper(
+    field: LimitField,
+    limits: &SandboxLimits,
+    pending: Option<LimitValue>,
+    state: &Entity<JailPageState>,
+    window: &mut Window,
+    cx: &mut App,
+) -> AnyElement {
+    let on = limits.effective();
+    let pending_text = pending.map(|value| match value {
+        LimitValue::Size(text) => text,
+        LimitValue::Count(count) => count.to_string(),
+    });
+    let id = format!("agent-jail-limit-{}-stepper", field.field());
+    let label = format!("{} limit for this project", field.title());
+    match field {
+        LimitField::Memory => {
+            let value = MemoryMib::from_setting(pending_text.as_deref().or(on.memory.as_deref()));
+            stepper(field, id, label, value, None, state, window, cx)
+        }
+        LimitField::DiskQuota => {
+            let value = DiskMib::from_setting(pending_text.as_deref().or(on.disk_quota.as_deref()));
+            stepper(field, id, label, value, None, state, window, cx)
+        }
+        LimitField::CpuQuota => {
+            let value = pending_text
+                .and_then(|text| text.parse().ok())
+                .or(on.cpu_quota)
+                .unwrap_or(0);
+            // Past every CPU of this machine a quota changes nothing.
+            let max = std::thread::available_parallelism()
+                .map(|cpus| u32::try_from(cpus.get()).unwrap_or(u32::MAX / 100) * 100)
+                .ok();
+            stepper(
+                field,
+                id,
+                label,
+                CpuPercent(value),
+                max.map(CpuPercent),
+                state,
+                window,
+                cx,
+            )
+        }
+        LimitField::MaxTasks => {
+            let value = pending_text
+                .and_then(|text| text.parse().ok())
+                .or(on.max_tasks)
+                .unwrap_or(0);
+            stepper(field, id, label, TaskCount(value), None, state, window, cx)
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn stepper<T: NumberFieldType + Send + Sync>(
+    field: LimitField,
+    id: String,
+    label: String,
+    value: T,
+    max: Option<T>,
+    state: &Entity<JailPageState>,
+    window: &mut Window,
+    cx: &mut App,
+) -> AnyElement {
+    let number = NumberField::new(SharedString::from(id), value, window, cx)
+        .mode(NumberFieldMode::Edit, cx)
+        .tab_index(0)
+        .aria_label(label)
+        .on_change({
+            let state = state.clone();
+            move |changed: &T, _window, cx| {
+                // Leaving the field reports its value even when nothing changed.
+                if *changed == value {
+                    return;
+                }
+                let text = changed.to_string();
+                state.update(cx, |state, cx| match field.parse(&text) {
+                    Ok(limit) => state.queue_limit(field, limit, cx),
+                    Err(rule) => state.show_limit_error(field, rule, cx),
+                });
+            }
+        });
+    match max {
+        Some(max) => number.max(max).into_any_element(),
+        None => number.into_any_element(),
+    }
+}
+
+impl JailPageState {
+    /// A stepper's click: shown at once, written once the clicks stop.
+    pub(crate) fn queue_limit(
+        &mut self,
+        field: LimitField,
+        value: LimitValue,
+        cx: &mut Context<Self>,
+    ) {
+        self.pending_limits.insert(field, value);
+        let task = cx.spawn(async move |this, cx| {
+            cx.background_executor().timer(LIMIT_WRITE_DEBOUNCE).await;
+            this.update(cx, |this, cx| this.flush_limit(field, cx)).ok();
+        });
+        self.limit_debounce.insert(field, task);
+        cx.notify();
+    }
+
+    /// The value a stepper shows while its write waits or runs.
+    pub(crate) fn pending_limit(&self, field: LimitField) -> Option<&LimitValue> {
+        self.pending_limits.get(&field)
+    }
+
+    /// Forgets a waiting click, for a reset that writes the default back instead.
+    pub(crate) fn cancel_pending_limit(&mut self, field: LimitField) {
+        self.pending_limits.remove(&field);
+        self.limit_debounce.remove(&field);
+    }
+
+    fn flush_limit(&mut self, field: LimitField, cx: &mut Context<Self>) {
+        let Some(value) = self.pending_limits.get(&field).cloned() else {
+            return;
+        };
+        let Some(root) = self.root.clone() else {
+            return;
+        };
+        let task = super::write_limit(
+            &root,
+            self.resolved_key.clone(),
+            field,
+            Some(value.clone()),
+            cx,
+        );
+        self.limit_error = None;
+        cx.spawn(async move |this, cx| {
+            let result = task.await;
+            this.update(cx, |this, cx| {
+                // A later click keeps its own pending value; only the one written settles.
+                if this.pending_limits.get(&field) == Some(&value) {
+                    this.pending_limits.remove(&field);
+                }
+                this.limit_error = result.err().map(|error| (field, error));
+                cx.notify();
+            })
+            .ok();
+        })
+        .detach();
+    }
+}
