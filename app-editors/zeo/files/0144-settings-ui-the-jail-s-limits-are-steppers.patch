+const ROOT: &str = "/w/app";
+
+async fn init(user: Value, cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        <dyn Fs>::set_global(fs.clone(), cx);
+        agent_sandbox::init(cx);
+    });
+    fs.create_dir(paths::config_dir())
+        .await
+        .expect("the config dir");
+    fs.insert_file(paths::settings_file(), user.to_string().into_bytes())
+        .await;
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&user.to_string(), cx)
+                .result()
+                .expect("settings");
+        })
+    });
+    cx.run_until_parked();
+    fs
+}
+
+async fn written_memory(fs: &Arc<FakeFs>) -> Value {
+    let text = fs
+        .load(paths::settings_file())
+        .await
+        .expect("settings file");
+    let written: Value = serde_json_lenient::from_str(&text).expect("json");
+    written["agent_sandbox"]["projects"][ROOT]["limits"]["memory"].clone()
+}
+
+/// Hostile: clicks in a row write once, after the last one, with the last value -- and the
+/// stepper shows that value meanwhile, so the next click counts from it.
+#[gpui::test]
+async fn agent_jail_steppers_write_once_after_the_last_click(cx: &mut TestAppContext) {
+    // A path that is not there: the page's probe then runs no `ai-jail --version`, whose real
+    // process the test scheduler refuses.
+    let fs = init(
+        json!({ "agent_sandbox": {
+            "ai_jail_path": "/nonexistent/ai-jail",
+            "projects": { ROOT: { "enabled": true } }
+        } }),
+        cx,
+    )
+    .await;
+    let state = cx.new(|cx| JailPageState::new(Some(Path::new(ROOT).to_path_buf()), cx));
+    cx.run_until_parked();
+    for size in ["5G", "6G"] {
+        state.update(cx, |state, cx| {
+            state.queue_limit(LimitField::Memory, LimitValue::Size(size.into()), cx)
+        });
+        cx.executor().advance_clock(Duration::from_millis(100));
+        cx.run_until_parked();
+    }
+    assert_eq!(
+        written_memory(&fs).await,
+        Value::Null,
+        "nothing is written while the clicks go on"
+    );
+    state.read_with(cx, |state, _| {
+        assert_eq!(
+            state.pending_limit(LimitField::Memory),
+            Some(&LimitValue::Size("6G".into())),
+            "the stepper shows the last click"
+        );
+    });
+    cx.executor().advance_clock(LIMIT_WRITE_DEBOUNCE);
+    cx.run_until_parked();
+    assert_eq!(written_memory(&fs).await, json!("6G"));
+    state.read_with(cx, |state, _| {
+        assert_eq!(
+            state.pending_limit(LimitField::Memory),
+            None,
+            "written, so settled"
+        );
+    });
+}
