+#[test]
+fn agent_jail_steppers_show_a_size_in_its_largest_whole_unit() {
+    assert_eq!(MemoryMib(0).to_string(), "0", "0 turns the limit off");
+    assert_eq!(MemoryMib(4096).to_string(), "4G");
+    assert_eq!(MemoryMib(1536).to_string(), "1536M");
+    assert_eq!(MemoryMib(1 << 20).to_string(), "1T");
+    assert_eq!(DiskMib(20 * 1024).to_string(), "20G");
+}
+
+#[test]
+fn agent_jail_steppers_read_k_m_g_t_and_refuse_what_ai_jail_refuses() {
+    assert_eq!("4G".parse::<MemoryMib>(), Ok(MemoryMib(4096)));
+    assert_eq!("1536m".parse::<MemoryMib>(), Ok(MemoryMib(1536)));
+    assert_eq!("1t".parse::<MemoryMib>(), Ok(MemoryMib(1 << 20)));
+    assert_eq!("2048K".parse::<MemoryMib>(), Ok(MemoryMib(2)));
+    assert_eq!(" 0 ".parse::<MemoryMib>(), Ok(MemoryMib(0)));
+    // A bare number is the unit the field steps in.
+    assert_eq!("512".parse::<MemoryMib>(), Ok(MemoryMib(512)));
+    // ai-jail's --memory refuses a `B` suffix, and a size under 1 MiB cannot be shown in MiB.
+    for bad in ["8GB", "8GiB", "512K", "lots", "", "G", "-1", "1.5G"] {
+        assert!(bad.parse::<MemoryMib>().is_err(), "{bad:?} was accepted");
+    }
+}
+
+/// Every value a stepper can show is one the limit's own rule accepts, so a click never writes
+/// something the next jailed start refuses.
+#[test]
+fn agent_jail_steppers_write_only_what_the_limit_accepts() {
+    for mib in [0, 1, 256, 1024, 1536, 4096, 1 << 20, 3 << 20] {
+        let text = MemoryMib(mib).to_string();
+        assert!(LimitField::Memory.parse(&text).is_ok(), "{text}");
+        assert_eq!(text.parse::<MemoryMib>(), Ok(MemoryMib(mib)), "{text}");
+        let text = DiskMib(mib).to_string();
+        assert!(LimitField::DiskQuota.parse(&text).is_ok(), "{text}");
+    }
+}
+
+#[test]
+fn agent_jail_steppers_step_by_a_gigabyte_a_cpu_and_256_processes() {
+    assert_eq!(MemoryMib::default_step(), MemoryMib(1024));
+    assert_eq!(DiskMib::default_step(), DiskMib(5 * 1024));
+    assert_eq!(CpuPercent::default_step(), CpuPercent(100), "one CPU");
+    assert_eq!(TaskCount::default_step(), TaskCount(256));
+    assert_eq!(
+        MemoryMib(0).saturating_sub(MemoryMib::default_step()),
+        MemoryMib(0),
+        "− stops at 0, which is no limit"
+    );
+    assert_eq!(
+        CpuPercent(300).saturating_add(CpuPercent(100)),
+        CpuPercent(400)
+    );
+}
+
+#[test]
+fn agent_jail_steppers_read_cpu_with_or_without_the_percent_sign() {
+    assert_eq!(CpuPercent(200).to_string(), "200 %");
+    for text in ["200", "200 %", "200%"] {
+        assert_eq!(text.parse::<CpuPercent>(), Ok(CpuPercent(200)), "{text}");
+    }
+    assert!("two".parse::<CpuPercent>().is_err());
+    assert_eq!("2048".parse::<TaskCount>(), Ok(TaskCount(2048)));
+}
+
+/// The value in force, as written in the settings file, is where a stepper starts.
+#[test]
+fn agent_jail_steppers_start_from_the_setting() {
+    assert_eq!(MemoryMib::from_setting(Some("8G")), MemoryMib(8192));
+    assert_eq!(MemoryMib::from_setting(Some("1073741824")), MemoryMib(1024));
+    assert_eq!(MemoryMib::from_setting(Some("0")), MemoryMib(0));
+    assert_eq!(
+        MemoryMib::from_setting(None),
+        MemoryMib(0),
+        "unset reads as no limit"
+    );
+    assert_eq!(DiskMib::from_setting(Some("20GiB")), DiskMib(20 * 1024));
+}
