+++ b/crates/settings_ui/src/pages/ui_language_picker_tests.rs
@@ -34,3 +34,12 @@ fn exactly_one_entry_is_checked_for_a_shipped_value() {
     }
     assert!(!choices.iter().any(|choice| ui_language_matches(choice, Some("eo"))));
 }
+
+#[test]
+fn an_unreviewed_translation_says_so_and_a_reviewed_one_does_not() {
+    let choices = ui_language_choices();
+    // Tests never call zeo_i18n::init, so the suffix is the English one.
+    assert_eq!(ui_language_label(&choices, Some("de")), "Deutsch (machine translation)");
+    assert_eq!(ui_language_label(&choices, Some("pt-BR")), "Português (Brasil)");
+    assert_eq!(ui_language_label(&choices, Some("en-US")), "English (United States)");
+}
