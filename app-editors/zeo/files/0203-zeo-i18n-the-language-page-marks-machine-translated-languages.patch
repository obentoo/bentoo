 }
+
+#[test]
+fn a_translation_is_marked_only_by_its_own_zeo_ftl() {
+    static SOURCES: &[LocaleSource] = &[
+        LocaleSource {
+            language: "de",
+            files: &[(
+                "de/zeo.ftl",
+                "zeo-language-name = Deutsch\nzeo-language-machine-translated = yes\n",
+            )],
+        },
+        LocaleSource {
+            language: "pt-BR",
+            files: &[("pt-BR/zeo.ftl", "zeo-language-name = Português (Brasil)\n")],
+        },
+        LocaleSource {
+            language: "en-US",
+            // Even if English carried the mark, no other language would inherit it.
+            files: &[(
+                "en-US/zeo.ftl",
+                "zeo-language-name = English (United States)\nzeo-language-machine-translated = yes\n",
+            )],
+        },
+    ];
+    let marked: Vec<(&str, bool)> = crate::catalog::shipped_languages(SOURCES)
+        .iter()
+        .map(|language| (language.tag, language.machine_translated))
+        .collect();
+    assert_eq!(marked, [("en-US", true), ("de", true), ("pt-BR", false)]);
+}
+
+#[test]
+fn the_shipped_drafts_are_marked_and_english_and_pt_br_are_not() {
+    // Reviewed state as of 0203 (2026-11-26): nobody native has reviewed es, fr, it, de, ru, ja
+    // or zh-CN. When a reviewer deletes a mark, this list loses that language.
+    let marked: Vec<&str> = crate::shipped_languages()
+        .into_iter()
+        .filter(|language| language.machine_translated)
+        .map(|language| language.tag)
+        .collect();
+    assert_eq!(marked, ["de", "es", "fr", "it", "ja", "ru", "zh-CN"]);
+}
