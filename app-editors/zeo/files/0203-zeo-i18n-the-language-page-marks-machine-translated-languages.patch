 //! The Language page's picker for `ui_language` (zed-patches 0194): System,
 //! then every language zeo_i18n ships, each named in itself, then the
 //! pseudo-locale. Picking applies at once: zeo_i18n observes the settings
-//! store and refreshes every window.
+//! store and refreshes every window. A translation no native speaker has
+//! reviewed carries "(machine translation)" after its name (0203).
 
 use gpui::{AnyElement, App, ReadGlobal, SharedString, Window};
 use settings::{SettingsStore, UiLanguageName};
@@ -29,7 +30,13 @@ pub(crate) fn ui_language_choices() -> Vec<UiLanguageChoice> {
             .into_iter()
             .map(|language| UiLanguageChoice {
                 tag: Some(language.tag.to_string()),
-                label: language.name,
+                // A draft nobody native has reviewed says so (0203), in the language
+                // the UI is in now, so the person choosing can read the warning.
+                label: if language.machine_translated {
+                    t!("settings-ui-language-machine-translated", name = language.name)
+                } else {
+                    language.name
+                },
             }),
     );
     choices.push(UiLanguageChoice {
diff --git a/crates/settings_ui/src/pages/ui_language_picker_tests.rs b/crates/settings_ui/src/pages/ui_language_picker_tests.rs
