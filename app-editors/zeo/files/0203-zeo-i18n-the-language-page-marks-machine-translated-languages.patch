 /// looking for it may not read the language the UI is in now.
 pub const LANGUAGE_NAME_ID: &str = "zeo-language-name";
 
+/// Present, with any value, in the `zeo.ftl` of a translation no native speaker
+/// has reviewed yet (zed-patches 0203): the picker marks that language, so
+/// nobody takes a drafted translation for a checked one. A reviewer deletes the
+/// line; nothing else has to change for the mark to go.
+pub const MACHINE_TRANSLATED_ID: &str = "zeo-language-machine-translated";
+
 /// A language a picker can offer.
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub struct ShippedLanguage {
@@ -45,6 +51,8 @@ pub struct ShippedLanguage {
     pub tag: &'static str,
     /// Its name in itself; the tag when its `zeo.ftl` gives none.
     pub name: String,
+    /// Whether its own `zeo.ftl` carries [`MACHINE_TRANSLATED_ID`].
+    pub machine_translated: bool,
 }
 
 /// Every language in `sources`, English first, the rest by tag. A name comes
@@ -66,9 +74,13 @@ pub fn shipped_languages(sources: &[LocaleSource]) -> Vec<ShippedLanguage> {
                 })
                 .filter(|name| !name.trim().is_empty())
                 .unwrap_or_else(|| source.language.to_string());
+            // The language's own bundle only: English never carries the mark, and
+            // a fallback must not lend it to (or hide it from) anyone.
+            let machine_translated = bundle.has_message(MACHINE_TRANSLATED_ID);
             ShippedLanguage {
                 tag: source.language,
                 name,
+                machine_translated,
             }
         })
         .collect();
diff --git a/crates/zeo_i18n/src/catalog_tests.rs b/crates/zeo_i18n/src/catalog_tests.rs
index 37c18f3c..92481b1c 100644
--- a/crates/zeo_i18n/src/catalog_tests.rs
