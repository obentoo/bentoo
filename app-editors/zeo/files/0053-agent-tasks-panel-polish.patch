@@ -0,0 +1,387 @@
+// Story 034, task 4.2 — selection gestures, rendering and the keyboard (R5.1, R5.3, R5.4, R5.5,
+// R5.8, and R2.3 for the selection). Module path: `panel::selection_gesture`. Every test name
+// starts with `selection_gesture_`, the task's validation filter. Hostile fixtures come before
+// benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/selection_gesture_tests.rs"]
+//     mod selection_gesture;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - a click on the row's label slot (`agent-tasks-row-label-{task_id}`, 0039) is a click on
+//     its open control; `Modifiers::secondary_key(cx)` toggles, `Modifiers::shift()` selects the
+//     range, no modifier clears and opens;
+//   - a selected row's open control is announced "Open thread: {label}, selected";
+//   - the action `ToggleSelected` (`agent_tasks_panel::ToggleSelected`) is defined in the panel
+//     module; both default keymaps bind it to `shift-space` in the `AgentTasksPanel` context;
+//   - Escape on the panel is `menu::Cancel`; in the filter input `editor::Cancel`;
+//   - fields `selection`, `row_focus_handles` (each `RowFocus { open, .. }`), and
+//     `filter_editor()`, `set_filter_query` (task 3); the X's selector `agent-tasks-close-panel`.
+// Not covered: the selected background colour (`element_selected`) — no paint probe in the rig;
+// the GUI proof (task 7.1) shows it.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, Focusable as _, KeyBinding, Modifiers, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use super::ToggleSelected;
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel};
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn click_row(panels: &mut Panels, selector: &'static str, modifiers: Modifiers) {
+    draw(&mut panels.cx);
+    let bounds = panels
+        .cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    panels.cx.simulate_click(bounds.center(), modifiers);
+    panels.cx.run_until_parked();
+}
+
+/// The secondary modifier is the platform's (cmd on macOS, ctrl elsewhere), read from the
+/// app since gpui asks for it there rather than at compile time.
+fn secondary_click_row(panels: &mut Panels, selector: &'static str) {
+    let modifiers = panels.cx.update(|_, cx| Modifiers::secondary_key(cx));
+    click_row(panels, selector, modifiers);
+}
+
+fn selected_tasks(panels: &mut Panels) -> Vec<String> {
+    draw(&mut panels.cx);
+    let mut tasks: Vec<String> = panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .selection
+            .iter()
+            .map(|(_, task)| task.to_string())
+            .collect()
+    });
+    tasks.sort();
+    tasks
+}
+
+fn active(panels: &Panels) -> Option<String> {
+    active_session(panels).map(|session| session.to_string())
+}
+
+fn labels(panels: &mut Panels) -> Vec<String> {
+    draw(&mut panels.cx);
+    super::RENDERED_ARIA_LABELS
+        .with_borrow(|labels| labels.iter().map(ToString::to_string).collect())
+}
+
+/// Three live threads A, B, C holding running tasks ta, tb, tc; C is the active thread.
+async fn three_threads(cx: &mut TestAppContext) -> (Panels, String, String, String) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let connection = StopConnection::new();
+    let mut sessions = Vec::new();
+    for (title, task, at) in [("A", "ta", 3_000), ("B", "tb", 2_000), ("C", "tc", 1_000)] {
+        let thread = open_thread_on(
+            &panels.agent_panel,
+            connection.clone(),
+            title,
+            &mut panels.cx,
+        );
+        send_tasks(
+            &thread,
+            vec![wire_task(task, "running", at, None)],
+            &mut panels.cx,
+        );
+        sessions.push(session_of(&thread, &panels.cx).to_string());
+    }
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    let c = sessions.pop().unwrap();
+    let b = sessions.pop().unwrap();
+    let a = sessions.pop().unwrap();
+    assert_eq!(active(&panels), Some(c.clone()), "C is the active thread");
+    (panels, a, b, c)
+}
+
+// Hostile (R5.1): a secondary-modifier click toggles the row and opens NOTHING — the active
+// thread stays, and a row whose thread is gone gets no "no longer exists" notice.
+#[gpui::test]
+async fn selection_gesture_secondary_click_selects_without_opening(cx: &mut TestAppContext) {
+    let (mut panels, _a, _b, c) = three_threads(cx).await;
+
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    assert_eq!(selected_tasks(&mut panels), vec!["ta"]);
+    assert_eq!(active(&panels), Some(c.clone()), "thread A is not opened");
+
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    assert!(
+        selected_tasks(&mut panels).is_empty(),
+        "a second one deselects"
+    );
+    assert_eq!(active(&panels), Some(c));
+}
+
+#[gpui::test]
+async fn selection_gesture_modifier_click_on_a_vanished_thread_sets_no_notice(
+    cx: &mut TestAppContext,
+) {
+    let db: AgentTaskHistoryDb = init_base(cx);
+    db.insert_started(&record("gone", "tg", AgentTaskStatus::Running, 1_000))
+        .await
+        .unwrap();
+    db.update_ended(&record("gone", "tg", AgentTaskStatus::Completed, 1_000))
+        .await
+        .unwrap();
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    secondary_click_row(&mut panels, "agent-tasks-row-label-tg");
+    click_row(&mut panels, "agent-tasks-row-label-tg", Modifiers::shift());
+    assert_eq!(
+        find_row(&mut panels, "gone", "tg").unwrap().notice,
+        None,
+        "no open was attempted"
+    );
+    click_row(&mut panels, "agent-tasks-row-label-tg", Modifiers::none());
+    assert!(
+        find_row(&mut panels, "gone", "tg")
+            .unwrap()
+            .notice
+            .is_some_and(|notice| notice.contains("Thread no longer exists")),
+        "a plain click still tries to open"
+    );
+}
+
+// Hostile (R5.2): a shift-click selects the range from the anchor and opens nothing.
+#[gpui::test]
+async fn selection_gesture_shift_click_selects_the_range_without_opening(cx: &mut TestAppContext) {
+    let (mut panels, _a, _b, c) = three_threads(cx).await;
+
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    click_row(&mut panels, "agent-tasks-row-label-tc", Modifiers::shift());
+    assert_eq!(selected_tasks(&mut panels), vec!["ta", "tb", "tc"]);
+    assert_eq!(active(&panels), Some(c), "no thread opened");
+}
+
+// Hostile (R5.3): a plain click BOTH clears the selection and opens the row's thread.
+#[gpui::test]
+async fn selection_gesture_plain_click_clears_the_selection_and_opens(cx: &mut TestAppContext) {
+    let (mut panels, a, _b, _c) = three_threads(cx).await;
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    secondary_click_row(&mut panels, "agent-tasks-row-label-tb");
+    assert_eq!(selected_tasks(&mut panels), vec!["ta", "tb"]);
+
+    click_row(&mut panels, "agent-tasks-row-label-ta", Modifiers::none());
+    assert!(
+        selected_tasks(&mut panels).is_empty(),
+        "the selection is cleared"
+    );
+    assert_eq!(active(&panels), Some(a), "and thread A is opened");
+}
+
+// R5.4: a selected row says so to screen readers; an unselected one does not.
+#[gpui::test]
+async fn selection_gesture_selected_row_is_announced(cx: &mut TestAppContext) {
+    let (mut panels, _a, _b, _c) = three_threads(cx).await;
+    secondary_click_row(&mut panels, "agent-tasks-row-label-tb");
+
+    let labels = labels(&mut panels);
+    assert!(
+        labels
+            .iter()
+            .any(|label| label == "Open thread: Task tb, selected"),
+        "{labels:?}"
+    );
+    assert!(
+        labels.iter().any(|label| label == "Open thread: Task ta"),
+        "{labels:?}"
+    );
+    assert!(
+        !labels
+            .iter()
+            .any(|label| label == "Open thread: Task ta, selected"),
+        "{labels:?}"
+    );
+}
+
+// Hostile (R5.5): ToggleSelected toggles the row whose control has focus — that row only.
+#[gpui::test]
+async fn selection_gesture_toggle_selected_acts_on_the_focused_row_only(cx: &mut TestAppContext) {
+    let (mut panels, a, b, _c) = three_threads(cx).await;
+    let focus_open = |panels: &mut Panels, session: &str, task: &str| {
+        let target = key(session, task);
+        panels
+            .tasks_panel
+            .update_in(&mut panels.cx, |panel, window, cx| {
+                let handle = panel
+                    .row_focus_handles
+                    .get(&target)
+                    .expect("the row is listed")
+                    .open
+                    .clone();
+                window.focus(&handle, cx);
+            });
+        panels.cx.run_until_parked();
+    };
+
+    focus_open(&mut panels, &b, "tb");
+    panels.cx.dispatch_action(ToggleSelected);
+    panels.cx.run_until_parked();
+    assert_eq!(selected_tasks(&mut panels), vec!["tb"]);
+
+    focus_open(&mut panels, &a, "ta");
+    panels.cx.dispatch_action(ToggleSelected);
+    panels.cx.run_until_parked();
+    assert_eq!(selected_tasks(&mut panels), vec!["ta", "tb"]);
+
+    panels.cx.dispatch_action(ToggleSelected);
+    panels.cx.run_until_parked();
+    assert_eq!(selected_tasks(&mut panels), vec!["tb"], "toggled off again");
+}
+
+// R5.5: both default keymaps bind shift-space to ToggleSelected in the panel's context.
+#[test]
+fn selection_gesture_toggle_selected_is_bound_to_shift_space_in_both_keymaps() {
+    for keymap in ["default-linux.json", "default-macos.json"] {
+        let path = format!(
+            "{}/../../assets/keymaps/{keymap}",
+            env!("CARGO_MANIFEST_DIR")
+        );
+        let text = std::fs::read_to_string(&path).unwrap_or_else(|error| panic!("{path}: {error}"));
+        let blocks: Vec<serde_json::Value> =
+            settings::parse_json_with_comments(&text).expect("the keymap parses");
+        let bound = blocks.iter().any(|block| {
+            block["context"] == "AgentTasksPanel"
+                && block["bindings"]["shift-space"] == "agent_tasks_panel::ToggleSelected"
+        });
+        assert!(
+            bound,
+            "{keymap}: shift-space → ToggleSelected in AgentTasksPanel"
+        );
+    }
+}
+
+// Hostile (R5.8, R4.5): Escape in the filter input clears its text and keeps the selection;
+// Escape elsewhere in the panel clears the selection.
+#[gpui::test]
+async fn selection_gesture_escape_clears_the_selection_outside_the_filter_input_only(
+    cx: &mut TestAppContext,
+) {
+    let (mut panels, _a, b, _c) = three_threads(cx).await;
+    panels.cx.update(|_, cx| {
+        cx.bind_keys([
+            KeyBinding::new("escape", editor::actions::Cancel, Some("Editor")),
+            KeyBinding::new("escape", menu::Cancel, None),
+        ])
+    });
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    secondary_click_row(&mut panels, "agent-tasks-row-label-tb");
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.filter_editor().focus_handle(cx).focus(window, cx)
+        });
+    panels.cx.simulate_input("Task");
+    panels.cx.run_until_parked();
+    panels.cx.simulate_keystrokes("escape");
+    panels.cx.run_until_parked();
+    let text = panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.filter_editor().read(cx).text(cx)
+    });
+    assert_eq!(text, "", "Escape in the input clears its text");
+    assert_eq!(
+        selected_tasks(&mut panels),
+        vec!["ta", "tb"],
+        "and keeps the selection"
+    );
+
+    let target = key(&b, "tb");
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            let handle = panel.row_focus_handles.get(&target).unwrap().open.clone();
+            window.focus(&handle, cx);
+        });
+    panels.cx.run_until_parked();
+    panels.cx.simulate_keystrokes("escape");
+    panels.cx.run_until_parked();
+    assert!(
+        selected_tasks(&mut panels).is_empty(),
+        "Escape on a row clears it"
+    );
+}
+
+// R2.3: the selection survives the X and reopening.
+#[gpui::test]
+async fn selection_gesture_selection_survives_the_x_and_reopening(cx: &mut TestAppContext) {
+    let (mut panels, _a, _b, _c) = three_threads(cx).await;
+    secondary_click_row(&mut panels, "agent-tasks-row-label-ta");
+    secondary_click_row(&mut panels, "agent-tasks-row-label-tc");
+
+    draw(&mut panels.cx);
+    let close = panels
+        .cx
+        .debug_bounds("agent-tasks-close-panel")
+        .expect("the X is painted");
+    panels.cx.simulate_click(close.center(), Modifiers::none());
+    panels.cx.run_until_parked();
+    panels.cx.dispatch_action(crate::ToggleFocus);
+    panels.cx.run_until_parked();
+
+    assert_eq!(selected_tasks(&mut panels), vec!["ta", "tc"]);
+}
+
+// R2.1, R5.5, Q13 (found by the GUI proof, task 7.1): in Zed `tab` is `menu::SelectNext`, not a
+// built-in focus move, so the panel's controls are reachable from the keyboard only when the panel
+// turns it into one. From the panel, Tab walks to a row, and shift-space then selects that row.
+#[gpui::test]
+async fn selection_gesture_tab_reaches_a_row_and_shift_space_selects_it(cx: &mut TestAppContext) {
+    let (mut panels, _a, _b, _c) = three_threads(cx).await;
+    panels.cx.update(|_, cx| {
+        cx.bind_keys([
+            KeyBinding::new("tab", menu::SelectNext, None),
+            KeyBinding::new("shift-tab", menu::SelectPrevious, None),
+            KeyBinding::new("shift-space", ToggleSelected, Some("AgentTasksPanel")),
+        ])
+    });
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.focus_handle(cx).focus(window, cx)
+        });
+    panels.cx.run_until_parked();
+
+    let mut on_row = false;
+    for _ in 0..12 {
+        panels.cx.simulate_keystrokes("tab");
+        panels.cx.run_until_parked();
+        on_row = panels
+            .tasks_panel
+            .update_in(&mut panels.cx, |panel, window, _| {
+                panel
+                    .row_focus_handles
+                    .values()
+                    .any(|focus| focus.open.is_focused(window))
+            });
+        if on_row {
+            break;
+        }
+    }
+    assert!(on_row, "Tab from the panel reaches a row's open control");
+
+    panels.cx.simulate_keystrokes("shift-space");
+    panels.cx.run_until_parked();
+    assert_eq!(
+        selected_tasks(&mut panels).len(),
+        1,
+        "shift-space selects the row Tab reached"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/selection_state_tests.rs b/crates/agent_tasks_panel/src/panel/selection_state_tests.rs
new file mode 100644
index 0000000..f702786
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/selection_state_tests.rs
@@ -0,0 +1,327 @@
+// Story 034, task 4.1 — selection state: toggle, range, pruning (R5.2, R5.6). Module path:
+// `panel::selection_state`. Every test name starts with `selection_state_`, the task's
+// validation filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/selection_state_tests.rs"]
+//     mod selection_state;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - fields `selection: Vec<TaskKey>` (ordered, no duplicates) and
+//     `selection_anchor: Option<TaskKey>` on `AgentTasksPanel` (read directly: child module);
+//   - `toggle_selected(&mut self, key: &TaskKey, cx)`, `select_range_to(&mut self, key:
+//     &TaskKey, cx)` over the listed rows in list order, `clear_selection(&mut self, cx)`;
+//   - pruning to the listed rows runs on every render (`list_entries`), so tests draw the panel;
+//   - `set_filter_query(&mut self, query: &str, window, cx)` (task 3.1).
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+    archived: bool,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn toggle(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.toggle_selected(&target, cx)
+    });
+    draw(&mut panels.cx);
+}
+
+fn range_to(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.select_range_to(&target, cx)
+    });
+    draw(&mut panels.cx);
+}
+
+fn clear(panels: &mut Panels) {
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.clear_selection(cx));
+    draw(&mut panels.cx);
+}
+
+fn selection(panels: &mut Panels) -> Vec<(String, String)> {
+    draw(&mut panels.cx);
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .selection
+            .iter()
+            .map(|(session, task)| (session.to_string(), task.to_string()))
+            .collect()
+    })
+}
+
+fn set(pairs: &[(&str, &str)]) -> Vec<(String, String)> {
+    let mut keys: Vec<_> = pairs
+        .iter()
+        .map(|(session, task)| (session.to_string(), task.to_string()))
+        .collect();
+    keys.sort();
+    keys
+}
+
+fn sorted(mut keys: Vec<(String, String)>) -> Vec<(String, String)> {
+    keys.sort();
+    keys
+}
+
+fn assert_no_duplicates(keys: &[(String, String)]) {
+    let mut seen = keys.to_vec();
+    seen.sort();
+    seen.dedup();
+    assert_eq!(seen.len(), keys.len(), "no key twice: {keys:?}");
+}
+
+/// List order: s1 header, a(5000), b(4000); s2 header, c(3000), [d(2500) failed, hidden],
+/// e(2000).
+async fn seed_order(db: &AgentTaskHistoryDb) {
+    seed(db, "s1", "a", AgentTaskStatus::Completed, 5_000, false).await;
+    seed(db, "s1", "b", AgentTaskStatus::Completed, 4_000, false).await;
+    seed(db, "s2", "c", AgentTaskStatus::Completed, 3_000, false).await;
+    seed(db, "s2", "d", AgentTaskStatus::Failed, 2_500, false).await;
+    seed(db, "s2", "e", AgentTaskStatus::Completed, 2_000, false).await;
+}
+
+// Hostile (wrong collapse): one task id in two sessions is two rows; selecting one never
+// selects the other.
+#[gpui::test]
+async fn selection_state_same_task_id_in_two_sessions_is_two_rows(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "t", AgentTaskStatus::Completed, 1_000, false).await;
+    seed(&db, "s2", "t", AgentTaskStatus::Completed, 1_100, false).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    toggle(&mut panels, "s1", "t");
+    assert_eq!(selection(&mut panels), set(&[("s1", "t")]));
+    toggle(&mut panels, "s2", "t");
+    assert_eq!(
+        sorted(selection(&mut panels)),
+        set(&[("s1", "t"), ("s2", "t")])
+    );
+    toggle(&mut panels, "s1", "t");
+    assert_eq!(
+        selection(&mut panels),
+        set(&[("s2", "t")]),
+        "toggling again deselects"
+    );
+}
+
+// Hostile (wrong split): a selected row stays the one selected row when newer rows push it
+// down the list and when it is renamed — the selection follows the task, not a position.
+#[gpui::test]
+async fn selection_state_follows_the_task_when_rows_shift_or_it_is_renamed(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "completed", 1_000, Some((5, 1)))],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    toggle(&mut panels, &session, "t1");
+
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("t1", "completed", 1_000, Some((5, 1))),
+            wire_task("t2", "completed", 2_000, Some((5, 1))),
+            wire_task("t3", "completed", 3_000, Some((5, 1))),
+        ],
+        &mut panels.cx,
+    );
+    assert_eq!(
+        selection(&mut panels),
+        set(&[(session.as_str(), "t1")]),
+        "two newer rows above it do not move the selection"
+    );
+
+    let target = key(&session, "t1");
+    panels.cx.update(|_, cx| {
+        TaskHistoryStore::global(cx).update(cx, |store, cx| store.rename(target, "Renamed", cx))
+    });
+    panels.cx.run_until_parked();
+    assert_eq!(
+        selection(&mut panels),
+        set(&[(session.as_str(), "t1")]),
+        "a new label is the same task"
+    );
+}
+
+// Hostile (R5.2): a range walks the LISTED rows in list order — across groups, skipping
+// headers and a row the toggles hide — in either direction, without duplicates.
+#[gpui::test]
+async fn selection_state_range_covers_listed_rows_only_in_list_order(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_order(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    toggle(&mut panels, "s1", "a");
+    range_to(&mut panels, "s2", "e");
+    let selected = selection(&mut panels);
+    assert_no_duplicates(&selected);
+    assert_eq!(
+        sorted(selected.clone()),
+        set(&[("s1", "a"), ("s1", "b"), ("s2", "c"), ("s2", "e")]),
+        "the hidden failed row d is not selected"
+    );
+    assert_eq!(
+        selected,
+        vec![
+            ("s1".to_string(), "a".to_string()),
+            ("s1".to_string(), "b".to_string()),
+            ("s2".to_string(), "c".to_string()),
+            ("s2".to_string(), "e".to_string()),
+        ],
+        "kept in list order"
+    );
+
+    range_to(&mut panels, "s2", "e");
+    assert_no_duplicates(&selection(&mut panels));
+
+    clear(&mut panels);
+    assert!(selection(&mut panels).is_empty());
+    toggle(&mut panels, "s2", "e");
+    range_to(&mut panels, "s1", "b");
+    assert_eq!(
+        sorted(selection(&mut panels)),
+        set(&[("s1", "b"), ("s2", "c"), ("s2", "e")]),
+        "upwards from the anchor"
+    );
+}
+
+// R5.2: with no anchor, or an anchor no longer listed, a range selects only the clicked row.
+#[gpui::test]
+async fn selection_state_range_without_a_listed_anchor_selects_one_row(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_order(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    range_to(&mut panels, "s1", "b");
+    assert_eq!(selection(&mut panels), set(&[("s1", "b")]), "no anchor yet");
+
+    clear(&mut panels);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Failed, true, cx)
+    });
+    draw(&mut panels.cx);
+    toggle(&mut panels, "s2", "d");
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Failed, false, cx)
+    });
+    draw(&mut panels.cx);
+    let anchor = panels
+        .tasks_panel
+        .read_with(&panels.cx, |panel, _| panel.selection_anchor.clone());
+    assert_eq!(anchor, None, "a hidden anchor is dropped");
+
+    range_to(&mut panels, "s1", "a");
+    assert_eq!(selection(&mut panels), set(&[("s1", "a")]));
+}
+
+// Hostile (R5.6): a selected row that stops being listed — text filter, toggle, archiving,
+// deletion — is DROPPED, not hidden: listing it again does not bring the selection back.
+#[gpui::test]
+async fn selection_state_drops_rows_that_stop_being_listed(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_order(&db).await;
+    seed(&db, "s3", "z", AgentTaskStatus::Completed, 1_000, true).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    for (session, task) in [("s1", "a"), ("s1", "b"), ("s2", "c"), ("s2", "e")] {
+        toggle(&mut panels, session, task);
+    }
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query("task b", window, cx)
+        });
+    draw(&mut panels.cx);
+    assert_eq!(selection(&mut panels), set(&[("s1", "b")]), "text filter");
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query("", window, cx)
+        });
+    draw(&mut panels.cx);
+    assert_eq!(
+        selection(&mut panels),
+        set(&[("s1", "b")]),
+        "clearing the text does not reselect what was dropped"
+    );
+
+    toggle(&mut panels, "s2", "c");
+    let target = key("s2", "c");
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.archive(&target, cx));
+    panels.cx.run_until_parked();
+    assert_eq!(
+        selection(&mut panels),
+        set(&[("s1", "b")]),
+        "archived out of view"
+    );
+
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Finished, false, cx);
+        panel.set_filter(TaskFilter::Archived, true, cx);
+    });
+    draw(&mut panels.cx);
+    assert!(selection(&mut panels).is_empty(), "toggle");
+
+    toggle(&mut panels, "s3", "z");
+    let doomed = key("s3", "z");
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_delete(&doomed, window, cx)
+        });
+    panels.cx.run_until_parked();
+    panels.cx.simulate_prompt_answer("Delete");
+    panels.cx.run_until_parked();
+    assert!(selection(&mut panels).is_empty(), "deletion");
+}
