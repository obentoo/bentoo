+// Story 034, task 4.3 — the selection toolbar and Archive Selected (R5.7, R6.1, R6.2, R6.3,
+// R6.4, R6.5). Module path: `panel::bulk_archive`. Every test name starts with `bulk_archive_`,
+// the task's validation filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/bulk_archive_tests.rs"]
+//     mod bulk_archive;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::archive_selected(&mut self, cx)` is what Archive Selected does;
+//   - the toolbar's controls are announced through `control_aria_label`: Clear Selection with a
+//     label containing "clear selection", Archive Selected with one containing
+//     "archive selected" (case-insensitive);
+//   - `toggle_selected(&TaskKey, cx)`, the `selection` field, `set_filter_query` (tasks 3-4).
+// Not covered: the "N selected" text (a plain label, not announced) — GUI proof (task 7.1).
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+    archived: bool,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn select(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.toggle_selected(&target, cx)
+    });
+    draw(&mut panels.cx);
+}
+
+fn archive_selected(panels: &mut Panels) {
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.archive_selected(cx));
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+}
+
+fn selection(panels: &mut Panels) -> Vec<(String, String)> {
+    draw(&mut panels.cx);
+    let mut keys: Vec<_> = panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .selection
+            .iter()
+            .map(|(session, task)| (session.to_string(), task.to_string()))
+            .collect()
+    });
+    keys.sort();
+    keys
+}
+
+fn archived(cx: &mut VisualTestContext, session: &str, task: &str) -> bool {
+    cx.update(|_, cx| {
+        let records = TaskHistoryStore::global(cx).read(cx).records().to_vec();
+        find(&records, session, task)
+            .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+            .archived
+    })
+}
+
+fn offers(panels: &mut Panels, needle: &str) -> bool {
+    draw(&mut panels.cx);
+    super::RENDERED_ARIA_LABELS.with_borrow(|labels| {
+        labels
+            .iter()
+            .any(|label| label.to_lowercase().contains(needle))
+    })
+}
+
+fn only(panels: &mut Panels, on: &[TaskFilter]) {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    draw(&mut panels.cx);
+}
+
+/// A live thread holding `run` (running) and `done` (completed); returns its session.
+fn live_thread(panels: &mut Panels) -> String {
+    let thread = open_live_thread(panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "running", 900, None),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "completed", 900, Some((10, 1))),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    session_of(&thread, &panels.cx).to_string()
+}
+
+// Hostile (R6.3): a running selected row is left unarchived AND selected; the rest of the
+// batch is archived regardless.
+#[gpui::test]
+async fn bulk_archive_leaves_a_running_selected_row_unarchived_and_selected(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "old", "past", AgentTaskStatus::Failed, 500, false).await;
+    let mut panels = open_panels(cx).await;
+    only(
+        &mut panels,
+        &[TaskFilter::Active, TaskFilter::Finished, TaskFilter::Failed],
+    );
+    let session = live_thread(&mut panels);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, &session, "run");
+    select(&mut panels, &session, "done");
+    select(&mut panels, "old", "past");
+
+    archive_selected(&mut panels);
+
+    assert!(
+        !archived(&mut panels.cx, &session, "run"),
+        "running: not archived"
+    );
+    assert!(archived(&mut panels.cx, &session, "done"));
+    assert!(archived(&mut panels.cx, "old", "past"));
+    assert_eq!(
+        selection(&mut panels),
+        vec![(session.clone(), "run".to_string())],
+        "only the running row stays selected"
+    );
+}
+
+// Hostile (R5.6, R6.2): a selected row hidden by the text filter is dropped, not archived.
+#[gpui::test]
+async fn bulk_archive_never_acts_on_a_row_the_filter_hid(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(
+        &db,
+        "s1",
+        "keep-me",
+        AgentTaskStatus::Completed,
+        1_000,
+        false,
+    )
+    .await;
+    seed(
+        &db,
+        "s1",
+        "file-me",
+        AgentTaskStatus::Completed,
+        1_100,
+        false,
+    )
+    .await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "keep-me");
+    select(&mut panels, "s1", "file-me");
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query("file-me", window, cx)
+        });
+    draw(&mut panels.cx);
+    archive_selected(&mut panels);
+
+    assert!(archived(&mut panels.cx, "s1", "file-me"));
+    assert!(
+        !archived(&mut panels.cx, "s1", "keep-me"),
+        "the row the filter hid is not archived"
+    );
+}
+
+// Hostile (R6.2): a mixed selection under Archived + Finished archives the unarchived row and
+// never toggles the already-archived one back.
+#[gpui::test]
+async fn bulk_archive_never_unarchives_an_archived_selected_row(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "z", AgentTaskStatus::Completed, 1_000, true).await;
+    seed(&db, "s1", "y", AgentTaskStatus::Completed, 1_100, false).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "z");
+    select(&mut panels, "s1", "y");
+
+    archive_selected(&mut panels);
+
+    assert!(archived(&mut panels.cx, "s1", "y"));
+    assert!(archived(&mut panels.cx, "s1", "z"), "still archived");
+    assert!(
+        selection(&mut panels).is_empty(),
+        "the selection is cleared"
+    );
+}
+
+// R5.7, R6.1, R6.5: the toolbar shows only with a selection; Archive Selected only while a
+// selected row has ended unarchived.
+#[gpui::test]
+async fn bulk_archive_toolbar_and_icon_show_only_when_they_can_act(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "arch", AgentTaskStatus::Completed, 500, true).await;
+    let mut panels = open_panels(cx).await;
+    let session = live_thread(&mut panels);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    assert!(
+        !offers(&mut panels, "clear selection"),
+        "no selection, no toolbar"
+    );
+    assert!(!offers(&mut panels, "archive selected"));
+
+    select(&mut panels, &session, "run");
+    assert!(offers(&mut panels, "clear selection"), "the toolbar shows");
+    assert!(
+        !offers(&mut panels, "archive selected"),
+        "only a running row selected: nothing to archive"
+    );
+
+    select(&mut panels, &session, "done");
+    assert!(
+        offers(&mut panels, "archive selected"),
+        "an ended row is selected"
+    );
+
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.clear_selection(cx));
+    only(&mut panels, &[TaskFilter::Archived]);
+    select(&mut panels, "s1", "arch");
+    assert!(offers(&mut panels, "clear selection"));
+    assert!(
+        !offers(&mut panels, "archive selected"),
+        "only an archived row selected: nothing to archive"
+    );
+}
+
+// R6.2: eligibility is read when Archive Selected runs — a row that ended after it was selected
+// is archived.
+#[gpui::test]
+async fn bulk_archive_reads_eligibility_when_it_runs(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "running", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, &session, "t");
+
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "completed", 1_000, Some((5, 1)))],
+        &mut panels.cx,
+    );
+    archive_selected(&mut panels);
+    assert!(archived(&mut panels.cx, &session, "t"));
+}
+
+// R6.4, Q4: the batch is one write; when it fails the rows stay archived in memory and ONE error
+// line names every session and task id.
+#[gpui::test]
+async fn bulk_archive_failed_write_keeps_memory_and_logs_one_line_with_the_ids(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(
+        &db,
+        "session-b1",
+        "task-b1",
+        AgentTaskStatus::Completed,
+        1_000,
+        false,
+    )
+    .await;
+    seed(
+        &db,
+        "session-b2",
+        "task-b2",
+        AgentTaskStatus::Completed,
+        1_100,
+        false,
+    )
+    .await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "session-b1", "task-b1");
+    select(&mut panels, "session-b2", "task-b2");
+    drop_history_table(&db).await;
+    capture_logs();
+
+    archive_selected(&mut panels);
+
+    assert!(
+        archived(&mut panels.cx, "session-b1", "task-b1"),
+        "kept in memory"
+    );
+    assert!(
+        archived(&mut panels.cx, "session-b2", "task-b2"),
+        "kept in memory"
+    );
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "hidden by the defaults this session"
+    );
+    let lines: Vec<String> = error_lines()
+        .into_iter()
+        .filter(|line| line.contains("archiv"))
+        .collect();
+    assert_eq!(lines.len(), 1, "one batch, one line: {lines:?}");
+    for id in ["session-b1", "task-b1", "session-b2", "task-b2"] {
+        assert!(lines[0].contains(id), "the line names {id}: {lines:?}");
+    }
+}
diff --git a/crates/agent_tasks_panel/src/panel/close_button_tests.rs b/crates/agent_tasks_panel/src/panel/close_button_tests.rs
new file mode 100644
index 0000000..23a601e
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/close_button_tests.rs
@@ -0,0 +1,220 @@
+// Story 034, task 2.2 — an X on the panel's top toolbar closes the panel (R2.1, R2.2, R2.3,
+// R2.4). Module path: `panel::close_button`. Every test name starts with `close_button_`, the
+// task's validation filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/close_button_tests.rs"]
+//     mod close_button;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - the X carries debug selector `agent-tasks-close-panel` and the screen-reader label
+//     "Close Agent Tasks panel" (recorded through `control_aria_label`);
+//   - the X emits `PanelEvent::Close`; the dock decides whether to close (dock.rs:772-778);
+//   - no row control is labelled as a close or dismiss action (v2: no whitelist;
+//     story 041 adds "Open Log").
+// Not covered here: Tab reaching the X (R2.1) — no focus-order probe in the rig; the GUI proof
+// (task 7.1) covers it.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, Modifiers, TestAppContext, VisualTestContext};
+use workspace::{
+    Workspace,
+    dock::{DockPosition, PanelEvent, test::TestPanel},
+};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+async fn seed(db: &AgentTaskHistoryDb, session: &str, task: &str, at: i64, archived: bool) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn tasks_panel_shown(panels: &Panels) -> bool {
+    let id = panels.tasks_panel.entity_id();
+    panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        let dock = workspace.bottom_dock().read(cx);
+        dock.is_open() && dock.visible_panel().map(|panel| panel.panel_id()) == Some(id)
+    })
+}
+
+fn left_dock_open(panels: &Panels) -> bool {
+    panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        workspace.left_dock().read(cx).is_open()
+    })
+}
+
+fn bottom_dock_open(panels: &Panels) -> bool {
+    panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        workspace.bottom_dock().read(cx).is_open()
+    })
+}
+
+fn click_close(panels: &mut Panels) {
+    draw(&mut panels.cx);
+    let bounds = panels
+        .cx
+        .debug_bounds("agent-tasks-close-panel")
+        .expect("the X is painted on the panel's toolbar");
+    panels.cx.simulate_click(bounds.center(), Modifiers::none());
+    panels.cx.run_until_parked();
+}
+
+fn stored(cx: &mut VisualTestContext) -> Vec<(String, String, bool, Option<String>)> {
+    cx.update(|_, cx| {
+        TaskHistoryStore::global(cx)
+            .read(cx)
+            .records()
+            .iter()
+            .map(|entry| {
+                let (session, task) = key_of(entry);
+                (
+                    session,
+                    task,
+                    entry.archived,
+                    entry.label.as_ref().map(ToString::to_string),
+                )
+            })
+            .collect()
+    })
+}
+
+fn painted_labels(panels: &mut Panels) -> Vec<String> {
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    super::RENDERED_ARIA_LABELS
+        .with_borrow(|labels| labels.iter().map(ToString::to_string).collect())
+}
+
+// Hostile (R2.2, R2.3): the X closes the dock showing the panel and nothing else — the agent
+// panel's dock stays open, no record changes, and the toggles are as they were on reopening.
+#[gpui::test]
+async fn close_button_closes_only_this_dock_and_changes_no_record_or_toggle(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "s1", "kept", 1_000, false).await;
+    seed(&db, "s1", "old", 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Active, false, cx);
+        panel.set_filter(TaskFilter::Failed, true, cx);
+        panel.set_filter(TaskFilter::Archived, true, cx);
+    });
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    assert!(tasks_panel_shown(&panels));
+    assert!(
+        left_dock_open(&panels),
+        "the agent panel's dock starts open"
+    );
+    let before = stored(&mut panels.cx);
+
+    click_close(&mut panels);
+
+    assert!(!bottom_dock_open(&panels), "the X closes the panel's dock");
+    assert!(left_dock_open(&panels), "another dock is not closed");
+    assert_eq!(stored(&mut panels.cx), before, "no record changed");
+
+    panels.cx.dispatch_action(crate::ToggleFocus);
+    panels.cx.run_until_parked();
+    assert!(tasks_panel_shown(&panels), "ToggleFocus reopens the panel");
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        assert!(!panel.is_filter_enabled(TaskFilter::Active));
+        assert!(panel.is_filter_enabled(TaskFilter::Finished));
+        assert!(panel.is_filter_enabled(TaskFilter::Failed));
+        assert!(panel.is_filter_enabled(TaskFilter::Archived));
+    });
+    assert_eq!(stored(&mut panels.cx), before);
+}
+
+// Hostile (R2.2): a close from this panel never closes its dock while the dock shows another
+// panel. The X emits `PanelEvent::Close`, which the dock honours only for its visible panel.
+#[gpui::test]
+async fn close_button_close_is_ignored_while_another_panel_is_shown_in_the_dock(
+    cx: &mut TestAppContext,
+) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let other = panels
+        .workspace
+        .update_in(&mut panels.cx, |workspace, window, cx| {
+            let other = cx.new(|cx| TestPanel::new(DockPosition::Bottom, 50, cx));
+            workspace.add_panel(other.clone(), window, cx);
+            workspace.focus_panel::<TestPanel>(window, cx);
+            other
+        });
+    panels.cx.run_until_parked();
+    assert!(bottom_dock_open(&panels));
+    assert!(
+        !tasks_panel_shown(&panels),
+        "the other panel is the one shown"
+    );
+
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |_, cx| cx.emit(PanelEvent::Close));
+    panels.cx.run_until_parked();
+    assert!(
+        bottom_dock_open(&panels),
+        "the dock showing another panel stays open"
+    );
+
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    click_close(&mut panels);
+    assert!(
+        !bottom_dock_open(&panels),
+        "the X closes it once it is shown"
+    );
+    drop(other);
+}
+
+// R2.1, R2.4: the X is announced once, and no row carries a close or dismiss control. (v2: the
+// row-control whitelist was dropped — story 041 adds "Open Log" to history rows, and the
+// operator asked only that rows carry no close/dismiss control.)
+#[gpui::test]
+async fn close_button_is_announced_and_rows_carry_no_close_control(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "done", 1_000, false).await;
+    seed(&db, "s1", "old", 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Archived, true, cx);
+    });
+
+    let labels = painted_labels(&mut panels);
+    assert_eq!(
+        labels
+            .iter()
+            .filter(|label| label.as_str() == "Close Agent Tasks panel")
+            .count(),
+        1,
+        "the X carries its label once: {labels:?}"
+    );
+    for label in labels.iter().filter(|label| label.contains("Task ")) {
+        let lower = label.to_lowercase();
+        assert!(
+            !lower.starts_with("close") && !lower.starts_with("dismiss"),
+            "no per-row close or dismiss: {label:?}"
+        );
+    }
+}
diff --git a/crates/agent_tasks_panel/src/panel/delete_selected_tests.rs b/crates/agent_tasks_panel/src/panel/delete_selected_tests.rs
new file mode 100644
index 0000000..c8a1a46
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/delete_selected_tests.rs
@@ -0,0 +1,357 @@
+// Story 034, task 4.4 — Delete Selected under the Archived filter (R7.2, R7.3, R7.4, R7.5,
+// R7.6). Module path: `panel::delete_selected`. Every test name starts with `delete_selected_`,
+// the task's validation filter. Hostile fixtures come before benign ones. R7.1 (per-row Delete
+// and Delete All Archived unchanged) stays proved by the `panel::delete_action` suite.
+//
+// Refine v3, task 9.1 (2026-10-11) — R7.4 modified: confirming Delete Selected removes ONLY the
+// deleted records from the selection; v2 cleared all of it. Changed against task 4.4's file:
+//   - `delete_selected_counts_and_deletes_only_the_selected_archived_rows` ended with
+//     `assert_eq!(selection_len(&mut panels), 0, "the selection is cleared")`. The selected
+//     unarchived row `s2/f` is not deleted, so under the new R7.4 it stays selected: the
+//     assertion now expects 1, and `selected_keys` pins that the one kept key is `s2/f`;
+//   - added `delete_selected_keeps_a_row_selected_while_the_prompt_was_open`;
+//   - added the `selected_keys` helper. Every other test is unchanged.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/delete_selected_tests.rs"]
+//     mod delete_selected;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::request_delete_selected(&mut self, window, cx)` is what Delete Selected
+//     does; it asks through 0042's prompt ("Delete N task records?", "The threads are not
+//     affected.", Delete / Cancel) and does nothing without an archived selected row while the
+//     Archived filter is on;
+//   - Delete Selected is announced with a label containing "delete selected"
+//     (case-insensitive);
+//   - `toggle_selected(&TaskKey, cx)` and the `selection` field (task 4.1).
+//   - Delete Selected is confirmed through `simulate_prompt_answer("Delete")`; the selection is
+//     read after the confirmation's spawned task has run (`run_until_parked`) and a redraw.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+async fn seed(db: &AgentTaskHistoryDb, session: &str, task: &str, at: i64, archived: bool) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn only(panels: &mut Panels, on: &[TaskFilter]) {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    draw(&mut panels.cx);
+}
+
+fn select(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.toggle_selected(&target, cx)
+    });
+    draw(&mut panels.cx);
+}
+
+fn request(panels: &mut Panels) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_delete_selected(window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn answer(panels: &mut Panels, button: &str) {
+    panels.cx.simulate_prompt_answer(button);
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+}
+
+fn selection_len(panels: &mut Panels) -> usize {
+    draw(&mut panels.cx);
+    panels
+        .tasks_panel
+        .read_with(&panels.cx, |panel, _| panel.selection.len())
+}
+
+/// The selection's keys, sorted, as (session, task) strings.
+fn selected_keys(panels: &mut Panels) -> Vec<(String, String)> {
+    draw(&mut panels.cx);
+    let mut keys: Vec<_> = panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .selection
+            .iter()
+            .map(|(session, task)| (session.to_string(), task.to_string()))
+            .collect()
+    });
+    keys.sort();
+    keys
+}
+
+fn in_memory(cx: &mut VisualTestContext) -> Vec<crate::HistoryEntry> {
+    cx.update(|_, cx| TaskHistoryStore::global(cx).read(cx).records().to_vec())
+}
+
+fn offers_delete_selected(panels: &mut Panels) -> bool {
+    draw(&mut panels.cx);
+    super::RENDERED_ARIA_LABELS.with_borrow(|labels| {
+        labels
+            .iter()
+            .any(|label| label.to_lowercase().contains("delete selected"))
+    })
+}
+
+// Hostile (R7.3, R7.4): with a mixed selection, the prompt counts only the selected ARCHIVED
+// rows, and confirming deletes exactly those — not the selected unarchived row, not an
+// archived row that was not selected — in memory and on disk; then only the deleted rows leave
+// the selection, so the selected unarchived row stays selected.
+#[gpui::test]
+async fn delete_selected_counts_and_deletes_only_the_selected_archived_rows(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "s1", "a1", 1_000, true).await;
+    seed(&db, "s1", "a2", 1_100, true).await;
+    seed(&db, "s1", "a3", 1_200, true).await;
+    seed(&db, "s2", "f", 1_300, false).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "a1");
+    select(&mut panels, "s1", "a2");
+    select(&mut panels, "s2", "f");
+
+    request(&mut panels);
+    let (message, detail) = panels
+        .cx
+        .pending_prompt()
+        .expect("Delete Selected asks first");
+    assert_eq!(message, "Delete 2 task records?");
+    assert_eq!(detail, "The threads are not affected.");
+    answer(&mut panels, "Delete");
+
+    let memory = in_memory(&mut panels.cx);
+    assert!(find(&memory, "s1", "a1").is_none());
+    assert!(find(&memory, "s1", "a2").is_none());
+    assert!(
+        find(&memory, "s1", "a3").is_some(),
+        "an unselected archived row stays"
+    );
+    assert!(
+        find(&memory, "s2", "f").is_some(),
+        "a selected unarchived row stays"
+    );
+    let mut stored: Vec<_> = load(&db).await.iter().map(key_of).collect();
+    stored.sort();
+    assert_eq!(
+        stored,
+        vec![
+            ("s1".to_string(), "a3".to_string()),
+            ("s2".to_string(), "f".to_string()),
+        ]
+    );
+    assert_eq!(
+        selection_len(&mut panels),
+        1,
+        "only the deleted rows leave the selection"
+    );
+    assert_eq!(
+        selected_keys(&mut panels),
+        vec![("s2".to_string(), "f".to_string())],
+        "the selected unarchived row is kept"
+    );
+}
+
+// Hostile (R7.4): a row toggled into the selection while the prompt is open is not in the
+// counted batch. Confirming deletes the counted rows only, takes exactly those out of the
+// selection, and keeps the late row — archived like the deleted ones, so a rule that drops
+// every archived or every selected row drops it too — both recorded and selected.
+#[gpui::test]
+async fn delete_selected_keeps_a_row_selected_while_the_prompt_was_open(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "a1", 1_000, true).await;
+    seed(&db, "s1", "a2", 1_100, true).await;
+    seed(&db, "s1", "late", 1_200, true).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "a1");
+    select(&mut panels, "s1", "a2");
+
+    request(&mut panels);
+    let (message, _) = panels
+        .cx
+        .pending_prompt()
+        .expect("Delete Selected asks first");
+    assert_eq!(message, "Delete 2 task records?");
+    select(&mut panels, "s1", "late");
+    answer(&mut panels, "Delete");
+
+    let memory = in_memory(&mut panels.cx);
+    assert!(find(&memory, "s1", "a1").is_none());
+    assert!(find(&memory, "s1", "a2").is_none());
+    let late = find(&memory, "s1", "late").expect("not counted, so not deleted");
+    assert!(late.archived);
+    assert!(find(&load(&db).await, "s1", "late").is_some());
+    assert_eq!(
+        selected_keys(&mut panels),
+        vec![("s1".to_string(), "late".to_string())],
+        "the deleted keys are gone and the row selected while the prompt was open stays"
+    );
+}
+
+// Hostile (R7.4, race): what the prompt counted is the batch. A counted row unarchived while it
+// is open is not deleted, and a selected row archived after it opened is not deleted either.
+#[gpui::test]
+async fn delete_selected_deletes_only_the_counted_rows_still_archived(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "kept-archived", 1_000, true).await;
+    seed(&db, "s1", "unarchived-meanwhile", 1_100, true).await;
+    seed(&db, "s2", "archived-meanwhile", 1_200, false).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "kept-archived");
+    select(&mut panels, "s1", "unarchived-meanwhile");
+    select(&mut panels, "s2", "archived-meanwhile");
+
+    request(&mut panels);
+    let (message, _) = panels.cx.pending_prompt().unwrap();
+    assert_eq!(message, "Delete 2 task records?");
+    let unarchive = key("s1", "unarchived-meanwhile");
+    let archive = key("s2", "archived-meanwhile");
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.unarchive(&unarchive, cx);
+        panel.archive(&archive, cx);
+    });
+    panels.cx.run_until_parked();
+    answer(&mut panels, "Delete");
+
+    let memory = in_memory(&mut panels.cx);
+    assert!(find(&memory, "s1", "kept-archived").is_none());
+    let unarchived = find(&memory, "s1", "unarchived-meanwhile").expect("not deleted");
+    assert!(!unarchived.archived);
+    let late = find(&memory, "s2", "archived-meanwhile").expect("not deleted");
+    assert!(late.archived, "archived after the count: not in the batch");
+    let rows = load(&db).await;
+    assert!(find(&rows, "s1", "unarchived-meanwhile").is_some());
+    assert!(find(&rows, "s2", "archived-meanwhile").is_some());
+}
+
+// Hostile (R7.2): offered — and acted on — only under Archived with an archived row selected.
+#[gpui::test]
+async fn delete_selected_is_offered_only_under_archived_with_an_archived_row_selected(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "s1", "arch", 1_000, true).await;
+    seed(&db, "s1", "fin", 1_100, false).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    select(&mut panels, "s1", "fin");
+    assert!(!offers_delete_selected(&mut panels), "Archived is off");
+    request(&mut panels);
+    assert!(!panels.cx.has_pending_prompt(), "nothing to delete");
+
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+    assert!(
+        !offers_delete_selected(&mut panels),
+        "Archived on, but only an unarchived row is selected"
+    );
+    request(&mut panels);
+    assert!(!panels.cx.has_pending_prompt());
+    assert_eq!(load(&db).await.len(), 2);
+
+    select(&mut panels, "s1", "arch");
+    assert!(offers_delete_selected(&mut panels));
+}
+
+// R7.5: Cancel deletes nothing and keeps the selection.
+#[gpui::test]
+async fn delete_selected_cancel_deletes_nothing_and_keeps_the_selection(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "a1", 1_000, true).await;
+    seed(&db, "s1", "a2", 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "s1", "a1");
+    select(&mut panels, "s1", "a2");
+
+    request(&mut panels);
+    answer(&mut panels, "Cancel");
+
+    assert_eq!(in_memory(&mut panels.cx).len(), 2);
+    assert_eq!(load(&db).await.len(), 2);
+    assert_eq!(selection_len(&mut panels), 2, "the selection is kept");
+}
+
+// R7.6, Q4: a failed delete keeps the records gone from memory and logs ONE line naming every id.
+#[gpui::test]
+async fn delete_selected_failed_write_keeps_records_gone_and_logs_one_line(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "session-d1", "task-d1", 1_000, true).await;
+    seed(&db, "session-d2", "task-d2", 1_100, true).await;
+    seed(&db, "session-d3", "task-d3", 1_200, true).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Archived]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    select(&mut panels, "session-d1", "task-d1");
+    select(&mut panels, "session-d2", "task-d2");
+    drop_history_table(&db).await;
+    capture_logs();
+
+    request(&mut panels);
+    answer(&mut panels, "Delete");
+
+    let memory = in_memory(&mut panels.cx);
+    assert!(
+        find(&memory, "session-d1", "task-d1").is_none(),
+        "gone this session"
+    );
+    assert!(
+        find(&memory, "session-d2", "task-d2").is_none(),
+        "gone this session"
+    );
+    assert!(find(&memory, "session-d3", "task-d3").is_some());
+    let lines: Vec<String> = error_lines()
+        .into_iter()
+        .filter(|line| line.contains("delet"))
+        .collect();
+    assert_eq!(lines.len(), 1, "one batch, one line: {lines:?}");
+    for id in ["session-d1", "task-d1", "session-d2", "task-d2"] {
+        assert!(lines[0].contains(id), "the line names {id}: {lines:?}");
+    }
+    assert!(
+        !lines[0].contains("task-d3"),
+        "an unselected record is not named"
+    );
+}
