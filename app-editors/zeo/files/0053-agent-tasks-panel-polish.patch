@@ -0,0 +1,308 @@
+// Story 034, task 3.1 — matching rows against the filter text (R4.2, R4.3, R4.6). Module path:
+// `panel::text_filter`. Every test name starts with `text_filter_`, the task's validation
+// filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/text_filter_tests.rs"]
+//     mod text_filter;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `fn matches_query(label: &str, description: &str, thread_title: &str, query: &str) -> bool`
+//     in the panel module (private is fine: this is a child module), with `query` already
+//     trimmed and non-empty; each field is matched on its own;
+//   - `AgentTasksPanel::set_filter_query(&mut self, query: &str, window, cx)` sets the filter
+//     text (what the input does on every edit; task 3.2 makes it set the input's text too) and
+//     `groups(cx)` applies it on top of the toggles;
+//   - the header's count is `ListEntry::Header { task_count, .. }` in `self.entries`, built on
+//     render.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use super::{ListEntry, matches_query};
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter};
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+    archived: bool,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn set_query(panels: &mut Panels, query: &str) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query(query, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+/// Every group as (session, title, row keys), the shape a header and its rows show.
+fn shape(panels: &mut Panels) -> Vec<(String, String, Vec<(String, String)>)> {
+    groups(panels)
+        .into_iter()
+        .map(|group| {
+            (
+                group.session_id.to_string(),
+                group.title.to_string(),
+                group.rows.iter().map(|row| key_of(&row.entry)).collect(),
+            )
+        })
+        .collect()
+}
+
+fn keys(pairs: &[(&str, &str)]) -> Vec<(String, String)> {
+    pairs
+        .iter()
+        .map(|(session, task)| (session.to_string(), task.to_string()))
+        .collect()
+}
+
+fn sorted(mut keys: Vec<(String, String)>) -> Vec<(String, String)> {
+    keys.sort();
+    keys
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+/// north: alpha (labelled "Deploy Pipeline"), beta, gamma; south: delta, epsilon (failed),
+/// zeta (archived). Titles are "Thread north" / "Thread south".
+async fn seed_fixture(db: &AgentTaskHistoryDb) {
+    seed(
+        db,
+        "north",
+        "alpha",
+        AgentTaskStatus::Completed,
+        1_000,
+        false,
+    )
+    .await;
+    seed(
+        db,
+        "north",
+        "beta",
+        AgentTaskStatus::Completed,
+        1_100,
+        false,
+    )
+    .await;
+    seed(db, "north", "gamma", AgentTaskStatus::Stopped, 1_200, false).await;
+    seed(
+        db,
+        "south",
+        "delta",
+        AgentTaskStatus::Completed,
+        1_300,
+        false,
+    )
+    .await;
+    seed(
+        db,
+        "south",
+        "epsilon",
+        AgentTaskStatus::Failed,
+        1_400,
+        false,
+    )
+    .await;
+    seed(db, "south", "zeta", AgentTaskStatus::Completed, 1_500, true).await;
+    db.set_label(&key("north", "alpha"), Some("Deploy Pipeline"))
+        .await
+        .unwrap();
+}
+
+// ── matches_query (Unit) ─────────────────────────────────────────────────────
+
+// Hostile (wrong collapse): text that only exists ACROSS two fields — label's end + the
+// description's start — matches nothing; neither does a query whose inner space the field lacks.
+#[test]
+fn text_filter_matches_query_never_matches_across_field_boundaries() {
+    assert!(!matches_query("Build ab", "cd step", "Thread", "abcd"));
+    assert!(!matches_query("Build ab", "cd step", "Thread", "ab cd"));
+    assert!(!matches_query(
+        "Label",
+        "Description",
+        "Title",
+        "labeldescription"
+    ));
+    assert!(!matches_query("foo", "bar", "baz", "fo o"));
+}
+
+// Hostile (wrong split): differently-cased spellings of one text are one match, Unicode
+// included; each field matches on its own.
+#[test]
+fn text_filter_matches_query_is_case_insensitive_per_field() {
+    assert!(matches_query(
+        "Deploy Pipeline",
+        "Task a",
+        "Thread",
+        "pipeline"
+    ));
+    assert!(matches_query("x", "Run CARGO tests", "Thread", "cargo"));
+    assert!(matches_query("x", "y", "Release Notes", "RELEASE"));
+    assert!(matches_query("Écrire le résumé", "y", "z", "ÉCRIRE"));
+    assert!(matches_query("ÉTÉ", "y", "z", "été"));
+    assert!(!matches_query("Deploy", "Task", "Thread", "deployment"));
+}
+
+// ── groups() with a filter text (model, through the rig) ─────────────────────
+
+// Hostile (R4.6): an empty or whitespace-only text lists exactly today's rows — same groups,
+// same titles, same rows in the same order.
+#[gpui::test]
+async fn text_filter_whitespace_only_query_lists_exactly_todays_rows(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    let today = shape(&mut panels);
+    assert!(!today.is_empty());
+
+    for query in ["   ", "\t", " \n ", ""] {
+        set_query(&mut panels, query);
+        assert_eq!(shape(&mut panels), today, "query {query:?} changes nothing");
+    }
+}
+
+// Hostile (R4.2): the text never bypasses the toggles, and never matches status text.
+#[gpui::test]
+async fn text_filter_never_bypasses_toggles_nor_matches_status_text(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+
+    set_query(&mut panels, "zeta");
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "an archived match stays hidden while Archived is off"
+    );
+    set_query(&mut panels, "epsilon");
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "a failed match stays hidden while Failed is off"
+    );
+    set_query(&mut panels, "Completed");
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "status text is not matched"
+    );
+    set_query(&mut panels, "tokens");
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "progress text is not matched"
+    );
+
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Archived, true, cx)
+    });
+    set_query(&mut panels, "zeta");
+    assert_eq!(visible_keys(&mut panels), keys(&[("south", "zeta")]));
+}
+
+// R4.2: label, description or thread title, trimmed, case-insensitive. A labelled row still
+// matches its description.
+#[gpui::test]
+async fn text_filter_matches_label_description_or_thread_title(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+
+    set_query(&mut panels, "  deploy  ");
+    assert_eq!(
+        visible_keys(&mut panels),
+        keys(&[("north", "alpha")]),
+        "label"
+    );
+    set_query(&mut panels, "TASK ALPHA");
+    assert_eq!(
+        visible_keys(&mut panels),
+        keys(&[("north", "alpha")]),
+        "a labelled row still matches its description"
+    );
+    set_query(&mut panels, "task beta");
+    assert_eq!(
+        visible_keys(&mut panels),
+        keys(&[("north", "beta")]),
+        "description"
+    );
+    set_query(&mut panels, "thread SOUTH");
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        keys(&[("south", "delta")]),
+        "thread title, toggles still applied (epsilon failed, zeta archived)"
+    );
+    set_query(&mut panels, "north");
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        keys(&[("north", "alpha"), ("north", "beta"), ("north", "gamma")])
+    );
+}
+
+// R4.3: a header is listed only with a listed row, and its count is the rows listed — not the
+// thread's total.
+#[gpui::test]
+async fn text_filter_lists_a_header_only_with_its_listed_rows_and_counts_them(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    set_query(&mut panels, "gamma");
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    let shape = shape(&mut panels);
+    assert_eq!(
+        shape,
+        vec![(
+            "north".to_string(),
+            "Thread north".to_string(),
+            keys(&[("north", "gamma")])
+        )],
+        "south has no match, so no south header"
+    );
+    let headers: Vec<(String, usize)> = panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::Header {
+                    session_id,
+                    task_count,
+                    ..
+                } => Some((session_id.to_string(), *task_count)),
+                ListEntry::Row(..) => None,
+            })
+            .collect()
+    });
+    assert_eq!(
+        headers,
+        vec![("north".to_string(), 1)],
+        "the count is the rows listed"
+    );
+}
