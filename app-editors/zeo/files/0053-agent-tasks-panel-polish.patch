+// Story 034, task 3.2 — the filter input, its empty state and Escape (R4.1, R4.4, R4.5, R2.3).
+// Module path: `panel::filter_input`. Every test name starts with `filter_input_`, the task's
+// validation filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/filter_input_tests.rs"]
+//     mod filter_input;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::filter_editor(&self) -> Entity<Editor>`, the one-line input, and the
+//     `filter_query` it keeps current on every edit;
+//   - `AgentTasksPanel::empty_message(&self, cx: &App) -> Option<SharedString>`: the text the
+//     panel shows where the list would be, `None` while a line is listed (render uses it, as it
+//     uses `status_message`);
+//   - Escape in the input is `editor::Cancel` (the default keymap's binding in an `Editor`);
+//   - the input's screen-reader label starts with "Filter tasks";
+//   - the X carries debug selector `agent-tasks-close-panel` (task 2.2);
+//   - row label slots carry `agent-tasks-row-label-{task_id}` (0039).
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, Focusable as _, KeyBinding, Modifiers, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter};
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn bind_escape(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        cx.bind_keys([
+            KeyBinding::new("escape", editor::actions::Cancel, Some("Editor")),
+            KeyBinding::new("escape", menu::Cancel, None),
+        ])
+    });
+}
+
+fn focus_input(panels: &mut Panels) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.filter_editor().focus_handle(cx).focus(window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn type_in_input(panels: &mut Panels, text: &str) {
+    focus_input(panels);
+    panels.cx.simulate_input(text);
+    panels.cx.run_until_parked();
+}
+
+fn input_text(panels: &mut Panels) -> String {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.filter_editor().read(cx).text(cx)
+    })
+}
+
+fn empty_message(panels: &mut Panels) -> Option<String> {
+    panels.tasks_panel.read_with(&panels.cx, |panel, cx| {
+        panel.empty_message(cx).map(|message| message.to_string())
+    })
+}
+
+fn tasks_panel_shown(panels: &Panels) -> bool {
+    let id = panels.tasks_panel.entity_id();
+    panels.workspace.read_with(&panels.cx, |workspace, cx| {
+        let dock = workspace.bottom_dock().read(cx);
+        dock.is_open() && dock.visible_panel().map(|panel| panel.panel_id()) == Some(id)
+    })
+}
+
+fn sorted(mut keys: Vec<(String, String)>) -> Vec<(String, String)> {
+    keys.sort();
+    keys
+}
+
+async fn seed_fixture(db: &AgentTaskHistoryDb) {
+    seed(db, "s1", "alpha", AgentTaskStatus::Completed, 1_000).await;
+    seed(db, "s1", "beta", AgentTaskStatus::Completed, 1_100).await;
+    seed(db, "s2", "gamma", AgentTaskStatus::Failed, 1_200).await;
+}
+
+// Hostile (R4.4, R4.6): the no-match message is the filter's only while the text is non-blank;
+// a blank text with no row keeps the toggles' message, and nothing of the list is painted.
+#[gpui::test]
+async fn filter_input_says_no_match_only_for_a_real_query(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    assert_eq!(empty_message(&mut panels), None, "rows are listed");
+
+    type_in_input(&mut panels, "nothing-matches-this");
+    draw(&mut panels.cx);
+    assert_eq!(
+        empty_message(&mut panels).as_deref(),
+        Some("No tasks match the filter")
+    );
+    assert!(
+        panels
+            .cx
+            .debug_bounds("agent-tasks-row-label-alpha")
+            .is_none(),
+        "no row is painted"
+    );
+
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query("   ", window, cx);
+            for filter in TaskFilter::ALL {
+                panel.set_filter(filter, false, cx);
+            }
+        });
+    draw(&mut panels.cx);
+    assert_eq!(
+        empty_message(&mut panels).as_deref(),
+        Some("No tasks match the selected filters"),
+        "a blank text is no filter"
+    );
+}
+
+// Hostile (R4.5): Escape with text clears the text — and only the text: toggles stay, and
+// every row the toggles allow comes back.
+#[gpui::test]
+async fn filter_input_escape_clears_the_text_and_keeps_the_toggles(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.set_filter(TaskFilter::Failed, true, cx)
+    });
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    bind_escape(&mut panels.cx);
+    let all = sorted(visible_keys(&mut panels));
+    assert_eq!(all.len(), 3);
+
+    type_in_input(&mut panels, "beta");
+    assert_eq!(
+        visible_keys(&mut panels),
+        vec![("s1".to_string(), "beta".to_string())]
+    );
+    panels.cx.simulate_keystrokes("escape");
+    panels.cx.run_until_parked();
+
+    assert_eq!(input_text(&mut panels), "", "Escape clears the text");
+    assert_eq!(
+        sorted(visible_keys(&mut panels)),
+        all,
+        "every allowed row is back"
+    );
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        assert!(
+            panel.is_filter_enabled(TaskFilter::Failed),
+            "toggles are untouched"
+        );
+        assert!(panel.is_filter_enabled(TaskFilter::Finished));
+    });
+}
+
+// Success metric: among 200 records, typing 4 characters of one task's description leaves
+// that row and no other.
+#[gpui::test]
+async fn filter_input_four_characters_find_one_task_among_two_hundred(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    for index in 0..199 {
+        seed(
+            &db,
+            &format!("s{}", index % 7),
+            &format!("t{index:03}"),
+            AgentTaskStatus::Completed,
+            1_000 + index as i64,
+        )
+        .await;
+    }
+    seed(&db, "s3", "zq7x-target", AgentTaskStatus::Completed, 5_000).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    assert_eq!(visible_keys(&mut panels).len(), 200);
+
+    type_in_input(&mut panels, "zq7x");
+    assert_eq!(
+        visible_keys(&mut panels),
+        vec![("s3".to_string(), "zq7x-target".to_string())]
+    );
+}
+
+// R4.1, Q13: placeholder "Filter tasks…" and a screen-reader label.
+#[gpui::test]
+async fn filter_input_shows_its_placeholder_and_label(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    let placeholder = panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel
+            .filter_editor()
+            .update(cx, |editor, cx| editor.placeholder_text(cx))
+    });
+    assert_eq!(placeholder.as_deref(), Some("Filter tasks…"));
+    let labels: Vec<String> = super::RENDERED_ARIA_LABELS
+        .with_borrow(|labels| labels.iter().map(ToString::to_string).collect());
+    assert!(
+        labels.iter().any(|label| label.starts_with("Filter tasks")),
+        "the input carries a screen-reader label: {labels:?}"
+    );
+}
+
+// R2.3: the filter text survives closing the panel with its X and reopening it.
+#[gpui::test]
+async fn filter_input_text_survives_the_x_and_reopening(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_fixture(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    type_in_input(&mut panels, "alpha");
+    draw(&mut panels.cx);
+
+    let close = panels
+        .cx
+        .debug_bounds("agent-tasks-close-panel")
+        .expect("the X is painted");
+    panels.cx.simulate_click(close.center(), Modifiers::none());
+    panels.cx.run_until_parked();
+    assert!(!tasks_panel_shown(&panels));
+
+    panels.cx.dispatch_action(crate::ToggleFocus);
+    panels.cx.run_until_parked();
+    assert!(tasks_panel_shown(&panels));
+    assert_eq!(input_text(&mut panels), "alpha");
+    assert_eq!(
+        visible_keys(&mut panels),
+        vec![("s1".to_string(), "alpha".to_string())]
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/header_archive_filter_tests.rs b/crates/agent_tasks_panel/src/panel/header_archive_filter_tests.rs
