+    /// Adds `key`'s row to the selection, or takes it out, and makes it the range anchor.
+    pub fn toggle_selected(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        if let Some(index) = self.selection.iter().position(|selected| selected == key) {
+            self.selection.remove(index);
+        } else {
+            self.selection.push(key.clone());
+        }
+        self.selection_anchor = Some(key.clone());
+        cx.notify();
+    }
+
+    /// Selects every listed row from the anchor to `key`, both included, in list order —
+    /// across groups, skipping headers and whatever the filters hide (R5.2). Without a listed
+    /// anchor there is no range, and the row is toggled alone.
+    pub fn select_range_to(&mut self, key: &TaskKey, cx: &mut Context<Self>) {
+        let listed: Vec<TaskKey> = self.listed_rows().map(row_key).collect();
+        let anchor_index = self
+            .selection_anchor
+            .as_ref()
+            .and_then(|anchor| listed.iter().position(|listed| listed == anchor));
+        let target_index = listed.iter().position(|listed| listed == key);
+        let (Some(anchor_index), Some(target_index)) = (anchor_index, target_index) else {
+            self.toggle_selected(key, cx);
+            return;
+        };
+        let range = anchor_index.min(target_index)..=anchor_index.max(target_index);
+        for row in &listed[range] {
+            if !self.selection.contains(row) {
+                self.selection.push(row.clone());
+            }
+        }
+        cx.notify();
+    }
