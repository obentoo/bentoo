@@ -0,0 +1,265 @@
+// Story 034, refine v3, task 9.2 — the group header's Archive honours the text filter (R4.7;
+// R4.6 and story 014's R3.2 for the empty text). Module path: `panel::header_archive_filter`.
+// Every test name starts with `header_archive_filter_`, the task's validation filter. Hostile
+// fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/header_archive_filter_tests.rs"]
+//     mod header_archive_filter;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `AgentTasksPanel::archive_group(&mut self, session_id: &acp_v2::SessionId, cx)` is what the
+//     group header's Archive control does;
+//   - `AgentTasksPanel::set_filter_query(&mut self, query: &str, window, cx)` sets the filter
+//     text; a blank (empty or whitespace-only) text is no filter (R4.6);
+//   - a row is "listed" when it passes the toggles AND matches the text: its label, its
+//     description ("Task <id>" from `record`/`wire_task`) or its thread's title;
+//   - `TaskHistoryStore::global(cx).read(cx).records()` is the store's memory; the history
+//     database `init_base` returns is what the store writes to;
+//   - `set_filter(TaskFilter, bool, cx)` and `TaskFilter::ALL` (story 014).
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter, TaskHistoryStore};
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn only(panels: &mut Panels, on: &[TaskFilter]) {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    draw(&mut panels.cx);
+}
+
+fn set_query(panels: &mut Panels, query: &str) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.set_filter_query(query, window, cx)
+        });
+    draw(&mut panels.cx);
+}
+
+/// Clicks the Archive control of `session`'s group header.
+fn archive_header(panels: &mut Panels, session: &str) {
+    let session_id = sid(session);
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.archive_group(&session_id, cx)
+    });
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+}
+
+/// Whether `session/task` is archived in the store's memory.
+fn archived(cx: &mut VisualTestContext, session: &str, task: &str) -> bool {
+    cx.update(|_, cx| {
+        let records = TaskHistoryStore::global(cx).read(cx).records().to_vec();
+        find(&records, session, task)
+            .unwrap_or_else(|| panic!("{session}/{task} is recorded"))
+            .archived
+    })
+}
+
+/// Whether `session/task` is archived in the history database.
+async fn archived_on_disk(db: &AgentTaskHistoryDb, session: &str, task: &str) -> bool {
+    let rows = load(db).await;
+    find(&rows, session, task)
+        .unwrap_or_else(|| panic!("{session}/{task} is stored"))
+        .archived
+}
+
+/// Three finished rows of `s1` ("Task alpha", "Task beta", "Task gamma") and, in another thread,
+/// a finished row whose description the same filter text matches ("Task beta" in `s2`).
+async fn seed_three_and_a_namesake(db: &AgentTaskHistoryDb) {
+    seed(db, "s1", "alpha", AgentTaskStatus::Completed, 1_000).await;
+    seed(db, "s1", "beta", AgentTaskStatus::Completed, 1_100).await;
+    seed(db, "s1", "gamma", AgentTaskStatus::Completed, 1_200).await;
+    seed(db, "s2", "beta", AgentTaskStatus::Completed, 1_300).await;
+}
+
+// Hostile (R4.7): a filter text lists one of the thread's three finished rows; the header's
+// Archive archives that row only. The two rows the text hides stay unarchived — in memory and
+// on disk — and the other thread's row the same text lists is not that group's, so it stays too.
+#[gpui::test]
+async fn header_archive_filter_archives_only_the_rows_the_text_lists(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_three_and_a_namesake(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    set_query(&mut panels, "beta");
+    assert_eq!(
+        visible_keys(&mut panels)
+            .into_iter()
+            .filter(|(session, _)| session == "s1")
+            .collect::<Vec<_>>(),
+        vec![("s1".to_string(), "beta".to_string())],
+        "fixture: the text lists one row of s1"
+    );
+
+    archive_header(&mut panels, "s1");
+
+    assert!(archived(&mut panels.cx, "s1", "beta"), "the listed row");
+    assert!(
+        !archived(&mut panels.cx, "s1", "alpha"),
+        "hidden by the text: not archived"
+    );
+    assert!(
+        !archived(&mut panels.cx, "s1", "gamma"),
+        "hidden by the text: not archived"
+    );
+    assert!(
+        !archived(&mut panels.cx, "s2", "beta"),
+        "another thread's row is not this header's"
+    );
+    assert!(archived_on_disk(&db, "s1", "beta").await);
+    assert!(!archived_on_disk(&db, "s1", "alpha").await);
+    assert!(!archived_on_disk(&db, "s1", "gamma").await);
+    assert!(!archived_on_disk(&db, "s2", "beta").await);
+}
+
+// Hostile (R4.7): "listed" is the toggles AND the text. A failed row the text matches but the
+// Failed toggle (off by default) hides is not listed, so the header's Archive leaves it.
+#[gpui::test]
+async fn header_archive_filter_skips_a_matching_row_the_toggles_hide(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "beta-done", AgentTaskStatus::Completed, 1_000).await;
+    seed(&db, "s1", "beta-failed", AgentTaskStatus::Failed, 1_100).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Active, TaskFilter::Finished]);
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    set_query(&mut panels, "beta");
+    assert_eq!(
+        visible_keys(&mut panels),
+        vec![("s1".to_string(), "beta-done".to_string())],
+        "fixture: Failed is off, so only the completed row is listed"
+    );
+
+    archive_header(&mut panels, "s1");
+
+    assert!(archived(&mut panels.cx, "s1", "beta-done"));
+    assert!(
+        !archived(&mut panels.cx, "s1", "beta-failed"),
+        "hidden by a toggle: not archived"
+    );
+    assert!(!archived_on_disk(&db, "s1", "beta-failed").await);
+}
+
+// Hostile (R3.4, R4.7): a running row the filter text lists is never archived by the header;
+// the group's listed row that has ended is.
+#[gpui::test]
+async fn header_archive_filter_never_archives_a_running_row(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Live");
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "running", 900, None),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    send_tasks(
+        &thread,
+        vec![
+            wire_task("done", "completed", 900, Some((10, 1))),
+            wire_task("run", "running", 1_000, None),
+        ],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx).to_string();
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    // "task" matches both descriptions ("Task done", "Task run"), case-insensitively.
+    set_query(&mut panels, "task");
+    let mut listed = visible_keys(&mut panels);
+    listed.sort();
+    assert_eq!(
+        listed,
+        vec![
+            (session.clone(), "done".to_string()),
+            (session.clone(), "run".to_string()),
+        ],
+        "fixture: the text lists both rows"
+    );
+
+    archive_header(&mut panels, &session);
+
+    assert!(
+        !archived(&mut panels.cx, &session, "run"),
+        "running: never archived"
+    );
+    assert!(archived(&mut panels.cx, &session, "done"));
+}
+
+/// Benign (R4.6, story 014 R3.2): with `query` blank the header archives every finished row of
+/// its thread, as before — and still only its thread's.
+async fn assert_blank_text_archives_every_finished_row(cx: &mut TestAppContext, query: &str) {
+    let db = init_base(cx);
+    seed_three_and_a_namesake(&db).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+    set_query(&mut panels, query);
+
+    archive_header(&mut panels, "s1");
+
+    for task in ["alpha", "beta", "gamma"] {
+        assert!(
+            archived(&mut panels.cx, "s1", task),
+            "text {query:?}: s1/{task} archived"
+        );
+        assert!(
+            archived_on_disk(&db, "s1", task).await,
+            "text {query:?}: s1/{task} archived on disk"
+        );
+    }
+    assert!(
+        !archived(&mut panels.cx, "s2", "beta"),
+        "another thread's row is not this header's"
+    );
+}
+
+// Benign (R4.6): an empty filter text archives all three finished rows, as before.
+#[gpui::test]
+async fn header_archive_filter_empty_text_archives_every_finished_row(cx: &mut TestAppContext) {
+    assert_blank_text_archives_every_finished_row(cx, "").await;
+}
+
+// Benign (R4.6): a whitespace-only filter text is no filter, so all three are archived.
+#[gpui::test]
+async fn header_archive_filter_whitespace_text_archives_every_finished_row(
+    cx: &mut TestAppContext,
+) {
+    assert_blank_text_archives_every_finished_row(cx, "   ").await;
+}
diff --git a/crates/agent_tasks_panel/src/panel/row_alignment_tests.rs b/crates/agent_tasks_panel/src/panel/row_alignment_tests.rs
new file mode 100644
index 0000000..9cd1b4e
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/row_alignment_tests.rs
@@ -0,0 +1,187 @@
+// Story 034, task 2.1 — row text is left-aligned (R1.1, R1.2, R1.3). Module path:
+// `panel::row_alignment`. Every test name starts with `row_alignment_`, the task's validation
+// filter. Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/row_alignment_tests.rs"]
+//     mod row_alignment;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - `agent-tasks-row-label-{task_id}` (0039) still marks the row's label SLOT;
+//   - `agent-tasks-row-label-text-{task_id}` marks the element holding the shown label text,
+//     as wide as that text (content-sized, never stretched to the slot), so its left edge is
+//     where the text starts;
+//   - `agent-tasks-row-detail-{task_id}` marks the element holding the progress/outcome text,
+//     content-sized the same way;
+//   - `agent-tasks-rename-{task_id}` (0039) marks the row's Rename control.
+// R1.3's tooltip (whole text kept) is 0039's and stays covered by `panel::list_label`.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{Bounds, Pixels, TestAppContext, VisualTestContext, px, size};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel};
+
+const LONG_LABEL: &str = "A very long user label that cannot possibly fit in a narrow panel \
+                          because it keeps going well past any width a dock gives a row";
+
+async fn seed_finished(db: &AgentTaskHistoryDb, session: &str, task: &str, at: i64) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+        .await
+        .unwrap();
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+/// Closes the left dock (the agent panel), opens the Agent Tasks panel in the bottom dock and
+/// makes the window `width` wide, so the panel is about that wide.
+fn show_at_width(panels: &mut Panels, width: f32) {
+    let workspace = panels.workspace.clone();
+    workspace.update_in(&mut panels.cx, |workspace, window, cx| {
+        workspace
+            .left_dock()
+            .update(cx, |dock, cx| dock.set_open(false, window, cx));
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    panels.cx.simulate_resize(size(px(width), px(900.)));
+    draw(&mut panels.cx);
+}
+
+fn bounds(cx: &mut VisualTestContext, selector: &'static str) -> Bounds<Pixels> {
+    cx.debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"))
+}
+
+// Hostile (R1.1): a SHORT label is where centring shows — the text box is narrower than its
+// slot, so a centred text starts well right of the slot's left edge. At both widths the text
+// must start at the slot's left edge.
+#[gpui::test]
+async fn row_alignment_short_label_starts_at_the_left_edge_of_its_slot(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(&db, "s1", "short", 1_000).await;
+    let mut panels = open_panels(cx).await;
+
+    for width in [320., 600.] {
+        show_at_width(&mut panels, width);
+        let slot = bounds(&mut panels.cx, "agent-tasks-row-label-short");
+        let text = bounds(&mut panels.cx, "agent-tasks-row-label-text-short");
+        assert!(
+            text.size.width < slot.size.width,
+            "at {width}px the text element hugs the text ({:?}) inside a wider slot ({:?})",
+            text.size.width,
+            slot.size.width
+        );
+        assert!(
+            (text.origin.x - slot.origin.x).abs() <= px(1.),
+            "at {width}px the label starts at its slot's left edge: text {:?}, slot {:?}",
+            text.origin.x,
+            slot.origin.x
+        );
+    }
+}
+
+// Hostile (R1.2, R1.3): a label longer than its slot is truncated at its right end and never
+// pushes the detail or the row's buttons out of the panel, at the narrowest width.
+#[gpui::test]
+async fn row_alignment_long_label_truncates_and_keeps_detail_and_buttons_inside(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed_finished(&db, "s1", "long", 1_000).await;
+    db.set_label(&key("s1", "long"), Some(LONG_LABEL))
+        .await
+        .unwrap();
+    let mut panels = open_panels(cx).await;
+
+    for width in [320., 600.] {
+        show_at_width(&mut panels, width);
+        let slot = bounds(&mut panels.cx, "agent-tasks-row-label-long");
+        let text = bounds(&mut panels.cx, "agent-tasks-row-label-text-long");
+        let detail = bounds(&mut panels.cx, "agent-tasks-row-detail-long");
+        let rename = bounds(&mut panels.cx, "agent-tasks-rename-long");
+
+        assert!(
+            (text.origin.x - slot.origin.x).abs() <= px(1.),
+            "at {width}px a truncated label still starts at the slot's left edge"
+        );
+        assert!(
+            text.right() <= slot.right() + px(1.),
+            "at {width}px the label is cut at the slot's right end: text {:?}, slot {:?}",
+            text.right(),
+            slot.right()
+        );
+        assert!(
+            detail.origin.x >= slot.right() - px(1.),
+            "at {width}px the detail sits right of the label slot"
+        );
+        assert!(
+            detail.right() <= rename.origin.x + px(1.),
+            "at {width}px the detail ends before the row's buttons"
+        );
+        assert!(
+            rename.right() <= px(width) + px(1.),
+            "at {width}px the row's buttons stay inside the panel: rename ends at {:?}",
+            rename.right()
+        );
+    }
+}
+
+// Benign (R1.1, R1.2): two rows of different label lengths start their labels at the same x,
+// and each detail is drawn at the right end of its row.
+#[gpui::test]
+async fn row_alignment_labels_of_different_lengths_share_one_left_edge(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(&db, "s1", "short", 1_000).await;
+    seed_finished(&db, "s1", "long", 1_100).await;
+    db.set_label(&key("s1", "long"), Some("A medium length label"))
+        .await
+        .unwrap();
+    let mut panels = open_panels(cx).await;
+
+    for width in [320., 600.] {
+        show_at_width(&mut panels, width);
+        let short = bounds(&mut panels.cx, "agent-tasks-row-label-text-short");
+        let long = bounds(&mut panels.cx, "agent-tasks-row-label-text-long");
+        assert!(
+            (short.origin.x - long.origin.x).abs() <= px(1.),
+            "at {width}px both labels start at one x: {:?} vs {:?}",
+            short.origin.x,
+            long.origin.x
+        );
+        let short_detail = bounds(&mut panels.cx, "agent-tasks-row-detail-short");
+        let short_rename = bounds(&mut panels.cx, "agent-tasks-rename-short");
+        assert!(
+            short_rename.origin.x - short_detail.right() <= px(24.),
+            "at {width}px the detail sits at the right end of the row, next to its buttons"
+        );
+    }
+}
+
+// Success metric (found by the GUI proof, task 7.1): a row's label starts where its group
+// header's title starts, within 1 px, so the column reads as one list under its header.
+#[gpui::test]
+async fn row_alignment_row_labels_start_under_the_group_title(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_finished(&db, "s1", "short", 1_000).await;
+    let mut panels = open_panels(cx).await;
+
+    for width in [320., 600.] {
+        show_at_width(&mut panels, width);
+        let title = bounds(&mut panels.cx, "agent-tasks-group-title-s1");
+        let label = bounds(&mut panels.cx, "agent-tasks-row-label-text-short");
+        assert!(
+            (title.origin.x - label.origin.x).abs() <= px(1.),
+            "at {width}px the row label starts under the group title: label {:?}, title {:?}",
+            label.origin.x,
+            title.origin.x
+        );
+    }
+}
diff --git a/crates/agent_tasks_panel/src/panel/scrollbar_tests.rs b/crates/agent_tasks_panel/src/panel/scrollbar_tests.rs
new file mode 100644
index 0000000..398ec39
--- /dev/null
+++ b/crates/agent_tasks_panel/src/panel/scrollbar_tests.rs
@@ -0,0 +1,220 @@
+// Story 034, task 2.3 — a vertical scrollbar on the list (R3.1, R3.2, R3.3). Module path:
+// `panel::scrollbar`. Every test name starts with `scrollbar_`, the task's validation filter.
+// Hostile fixtures come before benign ones.
+//
+// Declared in `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel/scrollbar_tests.rs"]
+//     mod scrollbar;
+//
+// Contract assumed (adjust HERE when the implementation drifts):
+//   - the scrollable list's wrapper (the element the scrollbar is drawn over) carries debug
+//     selector `agent-tasks-list`; the vertical track runs along its right edge;
+//   - the list scrolls through the panel's `scroll_handle: UniformListScrollHandle` field
+//     (read here through `ui::ScrollableHandle`);
+//   - R3.2 asks a click on the TRACK to scroll. `ui::Scrollbars::new` reserves only the thumb
+//     (`ReservedSpace::Thumb`), which ignores a click beside the thumb; the track needs
+//     `with_track_along(ScrollAxes::Vertical, ..)` or equivalent. The track-click tests pin that.
+// Not covered: the thumb's pixels (no scene probe in the rig) — the GUI proof (task 7.1).
+
+use acp_thread::AgentTaskStatus;
+use gpui::{
+    Bounds, Entity, Modifiers, MouseButton, Pixels, Point, TestAppContext, VisualTestContext, px,
+};
+use ui::ScrollableHandle as _;
+use workspace::Workspace;
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskHistoryStore};
+
+async fn seed_many(db: &AgentTaskHistoryDb, count: usize) {
+    for index in 0..count {
+        let task = format!("t{index:03}");
+        let at = 1_000 + index as i64 * 10;
+        db.insert_started(&record("s1", &task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record("s1", &task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn show_panel(workspace: &Entity<Workspace>, cx: &mut VisualTestContext) {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(cx);
+}
+
+fn list_bounds(cx: &mut VisualTestContext) -> Bounds<Pixels> {
+    cx.debug_bounds("agent-tasks-list")
+        .expect("the list is painted")
+}
+
+/// (offset scrolled, maximum offset), both as positive pixels.
+fn scroll_state(panels: &mut Panels) -> (Pixels, Pixels) {
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        (
+            panel.scroll_handle.offset().y.abs(),
+            panel.scroll_handle.max_offset().y.abs(),
+        )
+    })
+}
+
+fn archived_count(cx: &mut VisualTestContext) -> usize {
+    cx.update(|_, cx| {
+        TaskHistoryStore::global(cx)
+            .read(cx)
+            .records()
+            .iter()
+            .filter(|entry| entry.archived)
+            .count()
+    })
+}
+
+/// Hovers the list (which reveals an auto-hidden scrollbar), then returns its bounds.
+fn hover_list(panels: &mut Panels) -> Bounds<Pixels> {
+    let list = list_bounds(&mut panels.cx);
+    panels
+        .cx
+        .simulate_mouse_move(list.center(), None, Modifiers::none());
+    draw(&mut panels.cx);
+    list
+}
+
+/// The middle of the thumb's lane: `ui::Scrollbars` reserves 14px on the right and draws the
+/// 6px thumb lane 4px in from the edge, so `right - 4px` is the lane's outer border, not in it.
+fn track_point(list: Bounds<Pixels>, y: Pixels) -> Point<Pixels> {
+    Point::new(list.right() - px(7.), y)
+}
+
+// Hostile (R3.3): with every line fitting, there is nothing to scroll, and a drag down the
+// list's right edge neither scrolls nor acts on a row.
+#[gpui::test]
+async fn scrollbar_shows_no_thumb_and_scrolls_nothing_while_every_line_fits(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed_many(&db, 2).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    let (offset, max) = scroll_state(&mut panels);
+    assert_eq!(max, px(0.), "three lines fit: nothing to scroll");
+    assert_eq!(offset, px(0.));
+
+    let list = hover_list(&mut panels);
+    let top = track_point(list, list.top() + px(4.));
+    let bottom = track_point(list, list.bottom() - px(2.));
+    panels
+        .cx
+        .simulate_mouse_down(top, MouseButton::Left, Modifiers::none());
+    panels
+        .cx
+        .simulate_mouse_move(bottom, Some(MouseButton::Left), Modifiers::none());
+    panels
+        .cx
+        .simulate_mouse_up(bottom, MouseButton::Left, Modifiers::none());
+    panels.cx.run_until_parked();
+    assert_eq!(scroll_state(&mut panels).0, px(0.), "no thumb to drag");
+    assert_eq!(archived_count(&mut panels.cx), 0, "no row acted on");
+}
+
+// Hostile (R3.1, R3.2): a click on the track BELOW the thumb (not on the thumb) scrolls the
+// list down, and is the scrollbar's alone — no row control under it acts.
+#[gpui::test]
+async fn scrollbar_track_click_below_the_thumb_scrolls_down(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_many(&db, 60).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    let (offset, max) = scroll_state(&mut panels);
+    assert!(max > px(0.), "sixty rows overflow the dock");
+    assert_eq!(offset, px(0.));
+
+    let list = hover_list(&mut panels);
+    panels
+        .cx
+        .simulate_click(track_point(list, list.bottom() - px(6.)), Modifiers::none());
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+
+    let (offset, max) = scroll_state(&mut panels);
+    assert!(
+        offset > max / 2.,
+        "a click near the track's bottom scrolls near the end: {offset:?} of {max:?}"
+    );
+    assert_eq!(
+        archived_count(&mut panels.cx),
+        0,
+        "the click reached no row"
+    );
+}
+
+// R3.1: the thumb tracks the scroll position — scrolled to the end, the thumb is at the
+// bottom, so a click at the track's TOP is a track click and scrolls back up.
+#[gpui::test]
+async fn scrollbar_thumb_follows_the_list_scroll_position(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_many(&db, 60).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    panels.tasks_panel.read_with(&panels.cx, |panel, _| {
+        panel
+            .scroll_handle
+            .scroll_to_item(60, gpui::ScrollStrategy::Top)
+    });
+    draw(&mut panels.cx);
+    let (scrolled, max) = scroll_state(&mut panels);
+    assert!(scrolled > max / 2., "the list was scrolled to its end");
+
+    let list = hover_list(&mut panels);
+    panels
+        .cx
+        .simulate_click(track_point(list, list.top() + px(6.)), Modifiers::none());
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+    assert!(
+        scroll_state(&mut panels).0 < scrolled / 2.,
+        "a click above the (bottom) thumb scrolls back up"
+    );
+}
+
+// Benign (R3.2): dragging the thumb from the top to the bottom of the track scrolls to the end.
+#[gpui::test]
+async fn scrollbar_thumb_drag_scrolls_to_the_end(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed_many(&db, 60).await;
+    let mut panels = open_panels(cx).await;
+    show_panel(&panels.workspace.clone(), &mut panels.cx);
+
+    let list = hover_list(&mut panels);
+    let start = track_point(list, list.top() + px(6.));
+    let end = track_point(list, list.bottom() + px(40.));
+    panels
+        .cx
+        .simulate_mouse_down(start, MouseButton::Left, Modifiers::none());
+    panels
+        .cx
+        .simulate_mouse_move(end, Some(MouseButton::Left), Modifiers::none());
+    panels
+        .cx
+        .simulate_mouse_up(end, MouseButton::Left, Modifiers::none());
+    panels.cx.run_until_parked();
+    draw(&mut panels.cx);
+
+    let (offset, max) = scroll_state(&mut panels);
+    assert!(
+        offset >= max * 0.9,
+        "the drag reaches the end of the list: {offset:?} of {max:?}"
+    );
+}
diff --git a/crates/agent_tasks_panel/src/panel/selection_gesture_tests.rs b/crates/agent_tasks_panel/src/panel/selection_gesture_tests.rs
