@@ -9488,6 +9490,27 @@ fn dump_single_workspace(workspace: &Workspace, output: &mut String, cx: &gpui::
 /// both outrank an error, and background work (0029's tasks, or a running subagent, R4.1)
 /// marks only a thread that is otherwise idle -- it never hides a prompt, a question or an
 /// error. A subagent that has not reported, or reports Unknown, is not activity (R4.4).
+/// A custom agent's row icon, as `agent_servers::custom_agent_logo` gives its thread (Zeo §6.68,
+/// operator 2026-11-22): Claude for Claude Agent (Plus), whose idle rows showed the Terminal
+/// glyph a user reads as "running in a terminal"; Terminal for every other custom agent.
+fn custom_agent_icon(agent_id: &AgentId) -> IconName {
+    if agent_id.0.as_ref() == project::agent_registry_store::ZEO_PLUS_AGENT_ID {
+        IconName::AiClaude
+    } else {
+        IconName::Terminal
+    }
+}
+
+/// The background work a row counts (Zeo §6.68, ask 92): the adapter's `_claude/backgroundTasks`
+/// count, or the tasks its `_claude/tasks` feed reports running, whichever is larger. The count
+/// alone missed a task the feed (and the tasks card) showed running after the turn ended -- the
+/// adapter sends it separately, only when its own set changes -- and the row fell back to the
+/// agent's icon, Terminal for Claude Agent (Plus), where the background spinner belonged.
+fn background_work(count: usize, tasks: &[acp_thread::AgentTask]) -> usize {
+    let running = tasks.iter().filter(|task| task.status.is_running()).count();
+    count.max(running)
+}
+
 fn thread_row_status(
     pending_tool_call: bool,
     pending_elicitation: bool,
diff --git a/crates/sidebar/src/sidebar_task_feed_background_tests.rs b/crates/sidebar/src/sidebar_task_feed_background_tests.rs
new file mode 100644
index 0000000..ce75954
--- /dev/null
+++ b/crates/sidebar/src/sidebar_task_feed_background_tests.rs
@@ -0,0 +1,117 @@
+// Zeo proposal §6.68 (ask 92): a thread whose turn has ended while a task of its `_claude/tasks`
+// feed still runs reads Background (the accent spinner), not idle -- where the row showed the
+// agent's icon, which for Claude Agent (Plus) is the Terminal fallback. Captured on Xvfb on
+// 2026-11-22: the tasks card said "1 running" while the row showed Terminal, because the row
+// counted only `_claude/backgroundTasks`, which the adapter sends separately and only when its
+// own (non-ambient) set changes. Filter: `sidebar_task_feed_background`.
+
+use super::*;
+use crate::sidebar_tests::{
+    init_test_project_with_agent_panel, save_test_thread_metadata, setup_sidebar_with_agent_panel,
+};
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::{v1::schema as acp_v1, v2::schema as acp_v2};
+use agent_ui::test_support::{active_session_id, open_thread_with_connection, send_message};
+use gpui::{TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+
+fn status(
+    sidebar: &Entity<Sidebar>,
+    session: &acp_v2::SessionId,
+    cx: &mut VisualTestContext,
+) -> AgentThreadStatus {
+    sidebar.read_with(cx, |sidebar, _cx| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .find_map(|entry| match entry {
+                ListEntry::Thread(thread)
+                    if thread.metadata.session_id.as_ref() == Some(session) =>
+                {
+                    Some(thread.status)
+                }
+                _ => None,
+            })
+            .expect("the thread is listed")
+    })
+}
+
+fn tasks_snapshot(status: &str) -> serde_json::Map<String, serde_json::Value> {
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/tasks".to_string(),
+        serde_json::json!({ "tasks": [{
+            "id": "build1", "toolCallId": "toolu_build1", "type": "shell",
+            "description": "cargo build --release", "background": true, "depth": 0,
+            "status": status, "startedAt": 1_000, "endedAt": null, "usage": null,
+            "lastTool": null, "summary": null, "hasOutput": false, "tail": []
+        }]}),
+    );
+    meta
+}
+
+#[gpui::test]
+async fn test_sidebar_task_feed_background_a_running_task_marks_an_idle_row(
+    cx: &mut TestAppContext,
+) {
+    let project = init_test_project_with_agent_panel("/project-a", cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let (sidebar, panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    let connection = StubAgentConnection::new();
+    open_thread_with_connection(&panel, connection.clone(), cx);
+    send_message(&panel, cx);
+    let session = active_session_id(&panel, cx);
+    save_test_thread_metadata(&session, &project, cx).await;
+    connection.end_turn(session.clone(), acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+    assert_ne!(
+        status(&sidebar, &session, cx),
+        AgentThreadStatus::Background
+    );
+
+    let send = |meta, cx: &mut VisualTestContext| {
+        cx.update(|_, cx| {
+            connection.send_update(
+                session.clone(),
+                acp_v1::SessionUpdate::SessionInfoUpdate(
+                    acp_v1::SessionInfoUpdate::new().meta(meta),
+                ),
+                cx,
+            )
+        });
+        cx.run_until_parked();
+    };
+    send(tasks_snapshot("running"), cx);
+    assert_eq!(
+        status(&sidebar, &session, cx),
+        AgentThreadStatus::Background,
+        "a running task in the feed is background work"
+    );
+
+    // Hostile: an ended task is not work in progress.
+    send(tasks_snapshot("completed"), cx);
+    assert_ne!(
+        status(&sidebar, &session, cx),
+        AgentThreadStatus::Background
+    );
+}
+
+/// Operator, 2026-11-22: Claude Agent (Plus)'s rows carry Claude's icon, not Terminal; other
+/// custom agents (the TUI adapter's threads) keep Terminal.
+#[test]
+fn test_sidebar_task_feed_background_plus_rows_have_claudes_icon() {
+    assert_eq!(
+        custom_agent_icon(&AgentId::new(
+            project::agent_registry_store::ZEO_PLUS_AGENT_ID
+        )),
+        IconName::AiClaude
+    );
+    assert_eq!(
+        custom_agent_icon(&AgentId::new(
+            project::agent_registry_store::ZEO_TUI_AGENT_ID
+        )),
+        IconName::Terminal
+    );
+}
