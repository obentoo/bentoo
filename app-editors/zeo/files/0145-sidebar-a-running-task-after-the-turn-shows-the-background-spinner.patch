From 48c994078b550b6578562ce3cd868cb4962cb059 Mon Sep 17 00:00:00 2001
From: zed-patches <zed-patches@localhost>
Date: Sun, 22 Nov 2026 14:15:16 -0300
Subject: [PATCH] sidebar: a running task after the turn shows the spinner, and
 Plus has its own icon
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zeo proposal §6.68 (ask 92, 2026-11-22). The operator's screenshot showed a
sidebar thread row with Claude Agent (Plus)'s fallback icon, Terminal,
where a spinner was expected. An Xvfb capture with a fake Plus agent named
the state (docs/assets/zeo-lane-zeo-2026-11-22/, captures a/b/c):

  turn running a foreground command, thread shown   light spinner
  the same, another thread shown                    light spinner
  turn ended, not yet read                          blue dot
  turn ended, read                                  Terminal (Plus has no icon)
  turn ended, a _claude/tasks task still running    Terminal  <- the case

The tasks card said "1 running" and the row showed Terminal. The row's
Background status (0029's accent spinner) counts only the adapter's
_claude/backgroundTasks count, which Plus sends separately from its
_claude/tasks snapshot and only when its own, non-ambient set changes; a task
the snapshot reports running did not count. The row now counts the larger of
the two: background_work(count, tasks). An ended task is not work.

Amended 2026-11-22 (operator): Claude Agent (Plus) has Claude's icon
(IconName::AiClaude), so its idle rows stop showing the Terminal glyph a user
reads as "running in a terminal". Two places choose it, with one rule:
agent_servers::custom_agent_logo, the thread's own icon (CustomAgentServer
returned Terminal for every custom agent), and the sidebar's
custom_agent_icon for rows read from metadata (the sidebar does not depend on
agent_servers, so the three-line rule is repeated there). Every other custom
agent, the TUI adapter included, keeps Terminal.

Tests: custom::tests::plus_has_claudes_icon_and_other_custom_agents_terminal
and sidebar_task_feed_background_tests::
test_sidebar_task_feed_background_plus_rows_have_claudes_icon (Red seen with
Terminal for every custom agent). sidebar_task_feed_background_tests (new):
test_sidebar_task_feed_background_a_running_task_marks_an_idle_row -- an
idle row turns Background on a snapshot with a running task and back on a
completed one. Red seen with the count alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---

diff --git a/crates/agent_servers/src/custom.rs b/crates/agent_servers/src/custom.rs
index 3992b03..4e8cb07 100644
--- a/crates/agent_servers/src/custom.rs
+++ b/crates/agent_servers/src/custom.rs
@@ -22,6 +22,17 @@ pub const CURSOR_ID: &str = "cursor";
 /// whose environment carries it.
 pub const ZEO_THREAD_ENV: &str = "ZEO_THREAD";
 
+/// A custom agent's icon: Claude Agent (Plus) has Claude's (Zeo §6.68, operator 2026-11-22), so
+/// its idle thread rows stop showing the Terminal glyph a user reads as "running in a terminal";
+/// every other custom agent, the TUI adapter included, keeps Terminal.
+pub fn custom_agent_logo(agent_id: &AgentId) -> IconName {
+    if agent_id.0.as_ref() == project::agent_registry_store::ZEO_PLUS_AGENT_ID {
+        IconName::AiClaude
+    } else {
+        IconName::Terminal
+    }
+}
+
 /// A generic agent server implementation for custom user-defined agents
 pub struct CustomAgentServer {
     agent_id: AgentId,
@@ -39,7 +50,7 @@ impl AgentServer for CustomAgentServer {
     }
 
     fn logo(&self) -> IconName {
-        IconName::Terminal
+        custom_agent_logo(&self.agent_id)
     }
 
     fn default_mode(&self, cx: &App) -> Option<acp_v2::SessionConfigValueId> {
@@ -345,6 +356,22 @@ fn default_settings_for_agent() -> settings::CustomAgentServerSettings {
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    /// Zeo §6.68 (operator, 2026-11-22): Plus's threads carry Claude's icon; the TUI adapter and
+    /// other custom agents keep Terminal.
+    #[test]
+    fn plus_has_claudes_icon_and_other_custom_agents_terminal() {
+        let logo = |id: &str| CustomAgentServer::new(AgentId::new(id)).logo();
+        assert_eq!(
+            logo(project::agent_registry_store::ZEO_PLUS_AGENT_ID),
+            IconName::AiClaude
+        );
+        assert_eq!(
+            logo(project::agent_registry_store::ZEO_TUI_AGENT_ID),
+            IconName::Terminal
+        );
+        assert_eq!(logo("my-agent"), IconName::Terminal);
+    }
     use collections::HashMap;
     use gpui::TestAppContext;
     use project::agent_registry_store::{
diff --git a/crates/sidebar/src/sidebar.rs b/crates/sidebar/src/sidebar.rs
index d7ab96c..62b9ca2 100644
--- a/crates/sidebar/src/sidebar.rs
+++ b/crates/sidebar/src/sidebar.rs
@@ -100,6 +100,8 @@ mod sidebar_pinned_persist_tests;
 mod sidebar_pinned_tests;
