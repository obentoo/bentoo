+            serde_json::json!({ "label": "Open Capabilities", "path": CAPABILITIES_SETTINGS_PATH }),
+        ),
+        // A choice made there reaches the agent on its next start: the notice offers it.
+        (RESTART_ACTION_META_KEY.to_string(), serde_json::json!(true)),
+    ]);
     Some(
         acp_v2::Notice::new(acp_v2::NoticeSeverity::Info, title)
             .description(lines.join("\n"))
