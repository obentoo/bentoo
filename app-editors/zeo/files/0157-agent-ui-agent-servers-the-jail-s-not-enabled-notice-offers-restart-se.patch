-    let meta = serde_json::Map::from_iter([(
-        SETTINGS_ACTION_META_KEY.to_string(),
-        serde_json::json!({ "label": "Open Capabilities", "path": CAPABILITIES_SETTINGS_PATH }),
-    )]);
+    let meta = serde_json::Map::from_iter([
+        (
