@@ -71,6 +99,19 @@ impl SessionNotice {
 /// Zeo's own notices carry it; an agent's `_meta` is free-form, so a malformed one is ignored.
 pub const OPEN_SETTINGS_META: &str = "zeo/openSettingsAt";
 
+/// The `_meta` key (`true`) a notice Zeo raises itself uses to offer restarting the thread's agent:
+/// the jail's "not enabled" notice, whose fix applies on the next start (operator, 2026-11-22).
+pub const RESTART_AGENT_META: &str = "zeo/restartAgent";
+
+fn asks_for_restart(notice: &acp::Notice) -> bool {
+    notice
+        .meta
+        .as_ref()
+        .and_then(|meta| meta.get(RESTART_AGENT_META))
+        .and_then(serde_json::Value::as_bool)
+        == Some(true)
+}
+
 fn settings_action(notice: &acp::Notice) -> Option<(SharedString, String)> {
     let action = notice.meta.as_ref()?.get(OPEN_SETTINGS_META)?;
     let label = action.get("label")?.as_str()?;
@@ -94,7 +135,7 @@ pub fn session_notice_list(id: impl Into<ElementId>) -> Stateful<Div> {
