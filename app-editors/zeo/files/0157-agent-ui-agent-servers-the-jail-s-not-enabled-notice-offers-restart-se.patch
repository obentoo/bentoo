+
+    #[test]
+    fn session_notice_offers_a_restart_only_when_zeos_notice_asks() {
+        let with = |value: serde_json::Value| {
+            acp::Notice::new(acp::NoticeSeverity::Info, "n").meta(serde_json::Map::from_iter([(
+                RESTART_AGENT_META.to_string(),
+                value,
+            )]))
+        };
+        assert!(asks_for_restart(&with(serde_json::json!(true))));
+        assert!(!asks_for_restart(&with(serde_json::json!(false))));
+        assert!(!asks_for_restart(&with(serde_json::json!("yes"))));
+        assert!(!asks_for_restart(&acp::Notice::new(
+            acp::NoticeSeverity::Info,
+            "n"
+        )));
+    }
