diff --git a/crates/settings_ui/src/zeo_badge.rs b/crates/settings_ui/src/zeo_badge.rs
new file mode 100644
index 0000000..a566d85
--- /dev/null
+++ b/crates/settings_ui/src/zeo_badge.rs
@@ -0,0 +1,57 @@
+//! The "Zeo" badge (operator ask 10 of 2026-11-23): the settings window mixes Zed's own settings
+//! with the ones Zeo added, and nothing told them apart -- a setting looked up in Zed's docs, or
+//! asked about upstream, might not exist there. A Zeo setting in one of Zed's pages carries the
+//! badge beside its title; a page that is Zeo's alone carries it on its link and on its title
+//! once, not on every row (operator, 2026-11-24: there it would only repeat itself).
+//!
+//! The lists are by hand because nothing in a setting says who added it. When a patch adds a
+//! setting to one of Zed's pages, or a page of its own, it adds the setting here too;
+//! `zeo_badge_lists_name_only_what_the_window_has` fails on a name the window no longer has.
+
+use gpui::{AnyElement, App};
+use ui::{Chip, Tooltip, prelude::*};
+
+/// The `json_path` of every setting Zeo added to one of Zed's pages.
+pub(crate) const ZEO_SETTING_PATHS: &[&str] = &[
+    "status_bar.remote_projects_button",
+    "agent.terminal_card_default",
+    "agent.edit_card_default",
+    "agent.tool_card_default",
+    "agent.ask_questions_in_cards",
+    "agent.mcp_servers_over_acp",
+    "agent.zeo_lsp",
+];
+
+/// The title of every sub-page that is Zeo's alone.
+pub(crate) const ZEO_PAGE_TITLES: &[&str] = &["Panel Button Order"];
+
+const BADGE: &str = "Zeo";
+const TOOLTIP: &str = "Added by Zeo: Zed does not have this setting.";
+const PAGE_TOOLTIP: &str = "Added by Zeo: Zed does not have this page.";
+
+/// Whether the setting at `json_path` is one Zeo added to a page of Zed's.
+pub(crate) fn is_zeo_setting(json_path: Option<&str>) -> bool {
+    json_path.is_some_and(|path| ZEO_SETTING_PATHS.contains(&path))
+}
+
+/// Whether the sub-page titled `title` is Zeo's alone.
+pub(crate) fn is_zeo_page(title: &str) -> bool {
+    ZEO_PAGE_TITLES.contains(&title)
+}
+
+/// The badge beside a Zeo setting's title.
+pub(crate) fn render_setting_badge() -> AnyElement {
+    render_badge(TOOLTIP)
+}
+
+/// The badge on a Zeo page's link and title.
+pub(crate) fn render_page_badge() -> AnyElement {
+    render_badge(PAGE_TOOLTIP)
+}
+
+fn render_badge(tooltip: &'static str) -> AnyElement {
+    Chip::new(BADGE)
+        .label_color(Color::Accent)
+        .tooltip(move |_window, cx: &mut App| Tooltip::simple(tooltip, cx))
+        .into_any_element()
+}
diff --git a/crates/settings_ui/src/zeo_badge_tests.rs b/crates/settings_ui/src/zeo_badge_tests.rs
new file mode 100644
index 0000000..31c3534
--- /dev/null
+++ b/crates/settings_ui/src/zeo_badge_tests.rs
@@ -0,0 +1,68 @@
+// Operator ask 10 of 2026-11-23: a "Zeo" badge on every setting and page Zeo added. The lists
+// are kept by hand, so this guards them against a name the window no longer has (a setting
+// renamed or moved by a later patch would silently lose its badge). Filter: `zeo_badge`.
+use std::collections::HashSet;
+
+use crate::page_data::settings_data;
+use crate::test::register_settings;
+use crate::zeo_badge::{ZEO_PAGE_TITLES, ZEO_SETTING_PATHS, is_zeo_page, is_zeo_setting};
+use crate::{SettingItem, SettingsPageItem};
+
+fn paths_of<'a>(items: impl IntoIterator<Item = &'a SettingItem>, into: &mut HashSet<String>) {
+    for item in items {
+        if let Some(path) = item.field.json_path() {
+            into.insert(path.to_string());
+        }
+    }
+}
+
+#[gpui::test]
+fn zeo_badge_lists_name_only_what_the_window_has(cx: &mut gpui::TestAppContext) {
+    let (paths, links) = cx.update(|cx| {
+        register_settings(cx);
+        let app_state = workspace::AppState::test(cx);
+        workspace::AppState::set_global(app_state, cx);
+        let mut paths = HashSet::new();
+        let mut links = HashSet::new();
+        for page in settings_data(cx) {
+            for item in page.items.iter() {
+                match item {
+                    SettingsPageItem::SettingItem(item) => paths_of([item], &mut paths),
+                    SettingsPageItem::DynamicItem(item) => {
+                        paths_of([&item.discriminant], &mut paths);
+                        paths_of(item.fields.iter().flatten(), &mut paths);
+                    }
+                    SettingsPageItem::SubPageLink(link) => {
+                        links.insert(link.title.to_string());
+                    }
+                    SettingsPageItem::SectionHeader(_) | SettingsPageItem::ActionLink(_) => {}
+                }
+            }
+        }
+        (paths, links)
+    });
+    for path in ZEO_SETTING_PATHS {
+        assert!(
+            paths.contains(*path),
+            "{path} is badged but no setting has it"
+        );
+    }
+    for title in ZEO_PAGE_TITLES {
+        assert!(
+            links.contains(*title),
+            "{title} is badged but no page link has it"
+        );
+    }
+}
+
+#[test]
+fn zeo_badge_marks_zeo_settings_and_pages_only() {
+    assert!(is_zeo_setting(Some("agent.tool_card_default")));
+    assert!(
+        !is_zeo_setting(Some("agent.default_model")),
+        "Zed's own setting"
+    );
+    assert!(!is_zeo_setting(None), "a row with no settings.json path");
+    assert!(is_zeo_page("Panel Button Order"));
+    assert!(!is_zeo_page("Edit Predictions"), "Zed's own page");
+}
