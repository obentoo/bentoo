diff --git a/crates/agent_ui/src/conversation_view/subagent_card/native_child_card_tests.rs b/crates/agent_ui/src/conversation_view/subagent_card/native_child_card_tests.rs
new file mode 100644
index 0000000..876ff17
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/subagent_card/native_child_card_tests.rs
@@ -0,0 +1,276 @@
+// Story 064, task 10.1 — one card for a child its spawning tool call already draws (R5.3, R5.4).
+// Fixup of `0072-agent-ui-native-subagent-surfaces`. Module path:
+// `conversation_view::subagent_card::native_child_card_tests`; wired at the end of
+// `src/conversation_view/subagent_card.rs`, beside `rfd_surfaces_tests`:
+//
+//     #[cfg(test)]
+//     #[path = "subagent_card/native_child_card_tests.rs"]
+//     mod native_child_card_tests;
+//
+// Validation: `cargo test -p agent_ui native_child_card`.
+//
+// Since upstream #66255 a native `spawn_agent` child is registered with its parent (with an
+// association) and is never sent a `SessionMessage`: its card is the spawning tool call's, whose
+// `subagent_session_info` names the child's session. R5.3's appended card is for a child with
+// NEITHER a message NOR such a tool call. The child is built here as `rfd_surfaces_tests` builds
+// one (agent-owned thread under the parent's session, association, `register_subagent`); the
+// tool call is the parent's, created first and then given the child's session in its meta, the
+// order the native agent reports them in.
+//
+// Contract read: `unsent_subagents(&AcpThread) -> Vec<Entity<AcpThread>>` and the debug selector
+// `subagent-card-unsent-{child session}` the appended card carries (both exist since task 7.1).
+//
+// Hostile halves first:
+//   - wrongly split: a child named by a tool call gets a second, appended card;
+//   - wrongly collapse: a tool call naming ANOTHER session ("alpha" vs "alpha-2"), or a tool call
+//     without `subagent_session_info` whose title happens to be the child's, suppresses the card
+//     of a child it does not name;
+//   - then the benign RFD child without a message, which keeps exactly one appended card.
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, SUBAGENT_SESSION_INFO_META_KEY, StubAgentConnection};
+use agent_client_protocol::v1::schema as acp_v1;
+use agent_client_protocol::v2::schema as acp_v2;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use workspace::MultiWorkspace;
+
+use super::unsent_subagents;
+use crate::AgentPanel;
+
+fn unsent_card(child: &str) -> &'static str {
+    Box::leak(format!("subagent-card-unsent-{child}").into_boxed_str())
+}
+
+struct Rig {
+    _panel: Entity<AgentPanel>,
+    connection: StubAgentConnection,
+    parent: Entity<AcpThread>,
+    parent_session: acp_v2::SessionId,
+    cx: VisualTestContext,
+}
+
+/// A visible agent panel on a parent thread whose first turn is still open.
+async fn rig(cx: &mut TestAppContext) -> Rig {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(1600.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    crate::test_support::open_thread_with_connection(&panel, connection.clone(), &mut cx);
+    crate::test_support::send_message(&panel, &mut cx);
+    let parent = panel.read_with(&cx, |panel, cx| {
+        panel.active_agent_thread(cx).expect("a thread was opened")
+    });
+    let parent_session = parent.read_with(&cx, |thread, _| thread.session_id().clone());
+    Rig {
+        _panel: panel,
+        connection,
+        parent,
+        parent_session,
+        cx,
+    }
+}
+
+impl Rig {
+    /// A child registered with the parent, with its association, and no message to it.
+    fn register_child(&mut self, session: &str, title: &str) -> Entity<AcpThread> {
+        let parent_session = self.parent_session.clone();
+        let shared: Rc<dyn AgentConnection> = Rc::new(self.connection.clone());
+        let parent = self.parent.clone();
+        let child = self.cx.update(|_, cx| {
+            let project = parent.read(cx).project().clone();
+            let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+            cx.new(|cx| {
+                AcpThread::new(
+                    Some(parent_session),
+                    None,
+                    None,
+                    shared,
+                    project,
+                    action_log,
+                    acp_v2::SessionId::new(session.to_string()),
+                    watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                    cx,
+                )
+                .agent_owned()
+            })
+        });
+        self.cx
+            .update(|_, cx| self.connection.track_session(&child, cx));
+        let update = acp_v2::SubagentUpdate::new(session.to_string()).title(title.to_string());
+        child
+            .update(&mut self.cx, |child, cx| {
+                child.update_subagent_association(&update, cx)
+            })
+            .expect("an agent-owned thread takes an association");
+        self.parent.update(&mut self.cx, |parent, cx| {
+            parent.register_subagent(child.clone(), cx)
+        });
+        self.cx.run_until_parked();
+        child
+    }
+
+    /// A tool call of the parent, as the native `spawn_agent` reports it: created with no meta,
+    /// then updated with `subagent_session_info` naming `child` (when given).
+    fn spawning_tool_call(&mut self, id: &str, title: &str, child: Option<&str>) {
+        let call = || {
+            acp_v1::ToolCall::new(acp_v1::ToolCallId::new(id.to_string()), title.to_string())
+                .kind(acp_v1::ToolKind::Other)
+                .status(acp_v1::ToolCallStatus::InProgress)
+        };
+        self.parent
+            .update(&mut self.cx, |parent, cx| {
+                parent.upsert_tool_call(call(), cx)
+            })
+            .expect("the tool call is created");
+        if let Some(child) = child {
+            let meta = acp_v1::Meta::from_iter([(
+                SUBAGENT_SESSION_INFO_META_KEY.into(),
+                json!({ "session_id": child, "message_start_index": 0 }),
+            )]);
+            self.parent
+                .update(&mut self.cx, |parent, cx| {
+                    parent.upsert_tool_call(call().meta(meta), cx)
+                })
+                .expect("the tool call names its child");
+        }
+        self.cx.run_until_parked();
+    }
+
+    fn end_turn(&mut self) {
+        self.connection
+            .end_turn(self.parent_session.clone(), acp_v1::StopReason::EndTurn);
+        self.cx.run_until_parked();
+    }
+
+    /// The sessions `unsent_subagents` returns for the parent, sorted (the registry's order is
+    /// not what these tests pin).
+    fn unsent(&mut self) -> Vec<String> {
+        let mut sessions = self.parent.read_with(&self.cx, |parent, cx| {
+            unsent_subagents(parent)
+                .iter()
+                .map(|child| child.read(cx).session_id().to_string())
+                .collect::<Vec<_>>()
+        });
+        sessions.sort();
+        sessions
+    }
+
+    fn painted(&mut self, selector: &'static str) -> bool {
+        self.cx.update(|window, _| window.refresh());
+        self.cx.run_until_parked();
+        self.cx.debug_bounds(selector).is_some()
+    }
+}
+
+// ── R5.4 — a child its tool call names has that card only ──────────────────
+
+/// Hostile (wrongly split): Alpha is a native `spawn_agent` child — registered, no message, its
+/// spawning tool call names it. At the turn's end it has no appended card: the tool call's card
+/// is its one card.
+#[gpui::test]
+async fn test_native_child_card_tool_call_child_gets_no_appended_card(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", None);
+    let _alpha = rig.register_child("alpha", "Alpha");
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", Some("alpha"));
+    rig.end_turn();
+
+    assert_eq!(
+        rig.unsent(),
+        Vec::<String>::new(),
+        "R5.4: a child named by a tool call's subagent_session_info is not unsent"
+    );
+    assert!(
+        !rig.painted(unsent_card("alpha")),
+        "R5.4: no second card is appended for the tool call's child"
+    );
+}
+
+/// Hostile (wrongly collapse): the tool call names "alpha"; "alpha-2", registered beside it with
+/// no message and no tool call, keeps its appended card — a session id is matched whole, never
+/// by prefix or by the child being "a" child of some tool call.
+#[gpui::test]
+async fn test_native_child_card_tool_call_spares_only_the_session_it_names(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = rig(cx).await;
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", None);
+    let _alpha = rig.register_child("alpha", "Alpha");
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", Some("alpha"));
+    let _alpha_2 = rig.register_child("alpha-2", "Alpha");
+    rig.end_turn();
+
+    assert_eq!(rig.unsent(), vec!["alpha-2".to_string()]);
+    assert!(
+        rig.painted(unsent_card("alpha-2")),
+        "alpha-2 keeps its card"
+    );
+    assert!(
+        !rig.painted(unsent_card("alpha")),
+        "alpha has only its tool call's"
+    );
+}
+
+/// Hostile (wrongly collapse): a tool call without `subagent_session_info` is not a spawning
+/// tool call, even when its title is the child's — Bravo keeps its appended card.
+#[gpui::test]
+async fn test_native_child_card_tool_call_without_session_info_spares_nothing(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = rig(cx).await;
+    let _bravo = rig.register_child("bravo", "Bravo");
+    rig.spawning_tool_call("bravo", "Bravo", None);
+    rig.end_turn();
+
+    assert_eq!(rig.unsent(), vec!["bravo".to_string()]);
+    assert!(rig.painted(unsent_card("bravo")));
+}
+
+// ── R5.3 — an RFD child without a message keeps exactly one card ───────────
+
+/// Benign: an RFD child with no message and no tool call, beside a native child: exactly one
+/// appended card, the RFD child's.
+#[gpui::test]
+async fn test_native_child_card_rfd_child_without_a_message_keeps_one_card(
+    cx: &mut TestAppContext,
+) {
+    let mut rig = rig(cx).await;
+    let _charlie = rig.register_child("charlie", "Charlie");
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", None);
+    let _alpha = rig.register_child("alpha", "Alpha");
+    rig.spawning_tool_call("spawn-alpha", "Spawn Alpha", Some("alpha"));
+    rig.end_turn();
+
+    assert_eq!(
+        rig.unsent(),
+        vec!["charlie".to_string()],
+        "R5.3: one unsent child, Charlie"
+    );
+    assert!(rig.painted(unsent_card("charlie")), "Charlie's one card");
+    assert!(!rig.painted(unsent_card("alpha")));
+}
diff --git a/crates/agent_ui/src/conversation_view/subagent_card/rfd_surfaces_tests.rs b/crates/agent_ui/src/conversation_view/subagent_card/rfd_surfaces_tests.rs
new file mode 100644
index 0000000..aa13140
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/subagent_card/rfd_surfaces_tests.rs
@@ -0,0 +1,417 @@
+// Story 064, task 7.1 — Zed's native subagent surfaces cover ACP (RFD) children: the
+// awaiting-permission bar, a Waiting card, and a card for a child that got no session message
+// (R5.1, R5.2, R5.3). New patch `agent-ui-native-subagent-surfaces`. Module path:
+// `conversation_view::subagent_card::rfd_surfaces_tests`; wired at the end of
+// `src/conversation_view/subagent_card.rs`:
+//
+//     #[cfg(test)]
+//     #[path = "subagent_card/rfd_surfaces_tests.rs"]
+//     mod rfd_surfaces_tests;
+//
+// Validation: `cargo test -p agent_ui subagent_card`.
+//
+// Upstream row this patch changes, on purpose (design.md): `subagent_card.rs`'s own
+// `reported_states_map_to_card_statuses` pins `RequiresAction → Running`; with R5.2 that row
+// reads `Waiting`. Nothing else of it moves.
+//
+// A child is built as `agent_servers::acp::apply_subagent_update` builds one (an `agent_owned`
+// thread under the parent's session, its association, `register_subagent`); the stub keeps the
+// parent's first prompt open until `end_turn`, which is the turn end R5.3 waits for.
+//
+// Contract assumed beyond design.md (one place each, rename here):
+//   - `SubagentStatus::Waiting`, and `SUBAGENT_WAITING_LABEL: &str = "Waiting for you"` in
+//     `subagent_card.rs`, the label the card renders for it;
+//   - the card appended for a child with no outgoing session message carries the debug selector
+//     `subagent-card-unsent-{child session}` (`unsent_card`), beside upstream's
+//     `subagent-card-{entry_ix}` for a message's card;
+//   - each row of the "Subagents Awaiting Permission" bar carries the debug selector
+//     `subagent-permission-{entry_ix}` — its element id today — where `entry_ix` is the entry
+//     of the child's card (`permission_row`).
+//
+// Hostile halves first:
+//   - Waiting is not Running, and Waiting does not lose Stop for a child the agent lets Zed
+//     cancel (the card's `can_stop` reads `status == Running` today);
+//   - exactly one card per child: a child that did get a message has no appended card; the late
+//     message replaces the appended card instead of adding a second; an INCOMING message from
+//     the child is not "a message to it" and removes nothing; nothing is appended before the
+//     turn ends;
+//   - the bar lists the child that waits for permission, not its sibling, and drops it when the
+//     request is answered;
+//   - then the benign Waiting card, appended card and bar row.
+
+use std::path::Path;
+use std::rc::Rc;
+
+use acp_thread::{AcpThread, AgentConnection, PermissionOptions, StubAgentConnection};
+use agent_client_protocol::v1::schema as acp_v1;
+use agent_client_protocol::v2::schema as acp_v2;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use workspace::MultiWorkspace;
+
+use super::{SUBAGENT_WAITING_LABEL, SubagentCardState, SubagentStatus};
+use crate::AgentPanel;
+
+fn unsent_card(child: &str) -> &'static str {
+    Box::leak(format!("subagent-card-unsent-{child}").into_boxed_str())
+}
+
+fn message_card(entry_ix: usize) -> &'static str {
+    Box::leak(format!("subagent-card-{entry_ix}").into_boxed_str())
+}
+
+fn card_stop(entry_ix: usize) -> &'static str {
+    Box::leak(format!("stop-subagent-{entry_ix}").into_boxed_str())
+}
+
+fn permission_row(entry_ix: usize) -> &'static str {
+    Box::leak(format!("subagent-permission-{entry_ix}").into_boxed_str())
+}
+
+struct Rig {
+    panel: Entity<AgentPanel>,
+    connection: StubAgentConnection,
+    parent: Entity<AcpThread>,
+    parent_session: acp_v2::SessionId,
+    cx: VisualTestContext,
+}
+
+/// A visible agent panel on a parent thread whose first turn is still open.
+async fn rig(cx: &mut TestAppContext) -> Rig {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone())
+        .unwrap();
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(1600.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    crate::test_support::open_thread_with_connection(&panel, connection.clone(), &mut cx);
+    crate::test_support::send_message(&panel, &mut cx);
+    let parent = panel.read_with(&cx, |panel, cx| {
+        panel.active_agent_thread(cx).expect("a thread was opened")
+    });
+    let parent_session = parent.read_with(&cx, |thread, _| thread.session_id().clone());
+    Rig {
+        panel,
+        connection,
+        parent,
+        parent_session,
+        cx,
+    }
+}
+
+impl Rig {
+    fn spawn_child(&mut self, session: &str, title: &str, can_cancel: bool) -> Entity<AcpThread> {
+        let parent_session = self.parent_session.clone();
+        let shared: Rc<dyn AgentConnection> = Rc::new(self.connection.clone());
+        let parent = self.parent.clone();
+        let child = self.cx.update(|_, cx| {
+            let project = parent.read(cx).project().clone();
+            let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+            cx.new(|cx| {
+                AcpThread::new(
+                    Some(parent_session),
+                    None,
+                    None,
+                    shared,
+                    project,
+                    action_log,
+                    acp_v2::SessionId::new(session.to_string()),
+                    watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                    cx,
+                )
+                .agent_owned()
+            })
+        });
+        self.cx
+            .update(|_, cx| self.connection.track_session(&child, cx));
+        let mut update = acp_v2::SubagentUpdate::new(session.to_string()).title(title.to_string());
+        if can_cancel {
+            update = update.capabilities(
+                acp_v2::SubagentSessionCapabilities::new()
+                    .cancel(acp_v2::SessionCancelCapabilities::new()),
+            );
+        }
+        child
+            .update(&mut self.cx, |child, cx| {
+                child.update_subagent_association(&update, cx)
+            })
+            .expect("an agent-owned thread takes an association");
+        self.parent.update(&mut self.cx, |parent, cx| {
+            parent.register_subagent(child.clone(), cx)
+        });
+        self.cx.run_until_parked();
+        child
+    }
+
+    fn report(&mut self, child: &Entity<AcpThread>, state: acp_v2::StateUpdate) {
+        child
+            .update(&mut self.cx, |child, cx| {
+                child.update_session_state(state, cx)
+            })
+            .expect("an agent-owned thread reports its state");
+        self.cx.run_until_parked();
+    }
+
+    /// The parent's message to `child` (or, with `incoming`, the child's to the parent); returns
+    /// its entry index in the parent.
+    fn message(&mut self, id: &str, child: &str, incoming: bool) -> usize {
+        let parent_session = self.parent_session.clone();
+        let child_session = acp_v2::SessionId::new(child.to_string());
+        let (sender, recipient) = if incoming {
+            (child_session, parent_session)
+        } else {
+            (parent_session, child_session)
+        };
+        self.parent
+            .update(&mut self.cx, |parent, cx| {
+                parent.upsert_session_message(
+                    acp_v2::SessionMessage::new(id.to_string())
+                        .sender_session_id(sender)
+                        .recipient_session_id(recipient)
+                        .content(vec!["Look into it".into()]),
+                    cx,
+                )
+            })
+            .expect("a session message applies");
+        self.cx.run_until_parked();
+        self.parent
+            .read_with(&self.cx, |parent, _| parent.entries().len() - 1)
+    }
+
+    fn end_turn(&mut self) {
+        self.connection
+            .end_turn(self.parent_session.clone(), acp_v1::StopReason::EndTurn);
+        self.cx.run_until_parked();
+    }
+
+    fn draw(&mut self) {
+        self.cx.update(|window, _| window.refresh());
+        self.cx.run_until_parked();
+    }
+
+    fn painted(&mut self, selector: &'static str) -> bool {
+        self.draw();
+        self.cx.debug_bounds(selector).is_some()
+    }
+
+    /// Every card of the parent's transcript drawn for a message, over its entries.
+    fn message_cards(&mut self) -> Vec<usize> {
+        self.draw();
+        let entries = self
+            .parent
+            .read_with(&self.cx, |parent, _| parent.entries().len());
+        (0..entries)
+            .filter(|ix| self.cx.debug_bounds(message_card(*ix)).is_some())
+            .collect()
+    }
+}
+
+// ── R5.2 — Waiting, distinct from Running ───────────────────────────────────
+
+#[test]
+fn requires_action_reads_waiting_and_running_stays_running() {
+    let waiting = acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new());
+    let running = acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new());
+    assert_eq!(
+        SubagentStatus::from_reported_state(Some(&waiting)),
+        (SubagentStatus::Waiting, None)
+    );
+    assert_eq!(
+        SubagentStatus::from_reported_state(Some(&running)),
+        (SubagentStatus::Running, None),
+        "Running is untouched by the new status"
+    );
+    assert_ne!(SubagentStatus::Waiting, SubagentStatus::Running);
+    assert!(
+        !SubagentStatus::Waiting.is_failed_or_canceled(),
+        "waiting is live work, not an ending"
+    );
+    assert_eq!(SUBAGENT_WAITING_LABEL, "Waiting for you");
+}
+
+/// Hostile: a Waiting child the agent lets Zed cancel keeps its Stop, on the card's state and
+/// on screen; one without the grant has none.
+#[gpui::test]
+async fn test_rfd_waiting_card_keeps_stop_with_a_cancel_grant(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let alpha = rig.spawn_child("alpha", "Alpha", true);
+    let bravo = rig.spawn_child("bravo", "Bravo", false);
+    let alpha_card = rig.message("to-alpha", "alpha", false);
+    let bravo_card = rig.message("to-bravo", "bravo", false);
+    let waiting = acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new());
+    rig.report(&alpha, waiting.clone());
+    rig.report(&bravo, waiting);
+
+    let state = alpha.read_with(&rig.cx, |child, _| {
+        SubagentCardState::from_acp_subagent(child, None)
+    });
+    assert_eq!(state.status, SubagentStatus::Waiting, "R5.2");
+    assert!(
+        state.can_stop,
+        "a waiting child with the grant can be stopped"
+    );
+    assert!(rig.painted(message_card(alpha_card)));
+    assert!(
+        rig.painted(card_stop(alpha_card)),
+        "the Waiting card shows Stop"
+    );
+    assert!(
+        !rig.painted(card_stop(bravo_card)),
+        "without the grant, no Stop, waiting or not"
+    );
+
+    // Back to running: the same card reads Running again.
+    rig.report(
+        &alpha,
+        acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new()),
+    );
+    let state = alpha.read_with(&rig.cx, |child, _| {
+        SubagentCardState::from_acp_subagent(child, None)
+    });
+    assert_eq!(state.status, SubagentStatus::Running);
+}
+
+// ── R5.3 — a card for a child that got no session message; never two ───────
+
+/// Hostile: Bravo got its message and keeps exactly that card; Alpha got none and gets one card
+/// at the turn's end — not before.
+#[gpui::test]
+async fn test_rfd_card_for_a_child_without_a_message_appears_at_turn_end(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let _alpha = rig.spawn_child("alpha", "Alpha", true);
+    let _bravo = rig.spawn_child("bravo", "Bravo", true);
+    let bravo_card = rig.message("to-bravo", "bravo", false);
+
+    assert!(
+        !rig.painted(unsent_card("alpha")),
+        "nothing is appended while the turn may still send Alpha its message"
+    );
+
+    rig.end_turn();
+
+    assert!(rig.painted(unsent_card("alpha")), "R5.3: Alpha gets a card");
+    assert!(
+        !rig.painted(unsent_card("bravo")),
+        "Bravo already has its message's card: no second one"
+    );
+    assert_eq!(
+        rig.message_cards(),
+        vec![bravo_card],
+        "one message card, Bravo's"
+    );
+}
+
+/// Hostile: the late message to Alpha replaces its appended card — exactly one card after.
+#[gpui::test]
+async fn test_rfd_late_message_replaces_the_appended_card(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let _alpha = rig.spawn_child("alpha", "Alpha", true);
+    rig.end_turn();
+    assert!(
+        rig.painted(unsent_card("alpha")),
+        "precondition: the appended card"
+    );
+
+    let late = rig.message("late-to-alpha", "alpha", false);
+
+    assert!(
+        rig.painted(message_card(late)),
+        "the message's card is drawn where the message is"
+    );
+    assert!(
+        !rig.painted(unsent_card("alpha")),
+        "the appended card goes: never two cards for one child"
+    );
+    assert_eq!(rig.message_cards(), vec![late]);
+}
+
+/// Hostile: a message FROM Alpha to the parent is not a message to Alpha: its appended card
+/// stays (removing it would leave Alpha with no card at all).
+#[gpui::test]
+async fn test_rfd_incoming_message_keeps_the_appended_card(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let _alpha = rig.spawn_child("alpha", "Alpha", true);
+    rig.end_turn();
+    let _reply = rig.message("from-alpha", "alpha", true);
+    assert!(rig.painted(unsent_card("alpha")));
+    assert!(
+        rig.message_cards().is_empty(),
+        "an incoming message is a row, not a card"
+    );
+}
+
+// ── R5.1 — the awaiting-permission bar lists RFD children ───────────────────
+
+/// Hostile first: of two children, only the one with a pending request is listed, at its card;
+/// answering the request drops it.
+#[gpui::test]
+async fn test_rfd_child_awaiting_permission_is_listed_in_the_bar(cx: &mut TestAppContext) {
+    let mut rig = rig(cx).await;
+    let alpha = rig.spawn_child("alpha", "Alpha", true);
+    let _bravo = rig.spawn_child("bravo", "Bravo", true);
+    let alpha_card = rig.message("to-alpha", "alpha", false);
+    let bravo_card = rig.message("to-bravo", "bravo", false);
+    assert!(
+        !rig.painted(permission_row(alpha_card)),
+        "precondition: nothing awaits permission"
+    );
+
+    let (request_id, _outcome) = rig.cx.update(|_, cx| {
+        alpha.update(cx, |thread, cx| {
+            thread
+                .request_tool_call_authorization_with_id(
+                    acp_v1::ToolCall::new(acp_v1::ToolCallId::new("alpha-call"), "Edit a file")
+                        .kind(acp_v1::ToolKind::Edit)
+                        .into(),
+                    PermissionOptions::Flat(vec![acp_v2::PermissionOption::new(
+                        acp_v2::PermissionOptionId::new("allow"),
+                        "Allow",
+                        acp_v2::PermissionOptionKind::AllowOnce,
+                    )]),
+                    acp_thread::AuthorizationKind::PermissionGrant,
+                    cx,
+                )
+                .expect("the request installs")
+        })
+    });
+    rig.cx.run_until_parked();
+
+    assert!(
+        rig.painted(permission_row(alpha_card)),
+        "R5.1: Alpha is listed in the parent's bar, at its card"
+    );
+    assert!(
+        !rig.painted(permission_row(bravo_card)),
+        "Bravo awaits nothing and is not listed"
+    );
+
+    alpha.update(&mut rig.cx, |thread, cx| {
+        thread.cancel_permission_request(request_id, cx)
+    });
+    rig.cx.run_until_parked();
+    assert!(
+        !rig.painted(permission_row(alpha_card)),
+        "an answered request leaves the bar"
+    );
+    let _ = rig.panel.clone();
+}
