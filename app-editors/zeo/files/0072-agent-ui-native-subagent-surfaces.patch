                 thread.background_task_count(),
+                any_child_active(thread, cx),
             );
 
             let diff_stats = thread.action_log().read(cx).diff_stats(cx);
@@ -9004,18 +9029,21 @@ fn dump_single_workspace(workspace: &Workspace, output: &mut String, cx: &gpui::
 }
 
 /// The status a thread's sidebar row shows. The order is the point: a permission prompt
-/// outranks a question (0030), both outrank an error, and background work (0029) marks
-/// only a thread that is otherwise idle -- it never hides a prompt, a question or an error.
+/// outranks a question (0030) -- a subagent waiting for the user is one (story 064, R4.2) --,
+/// both outrank an error, and background work (0029's tasks, or a running subagent, R4.1)
+/// marks only a thread that is otherwise idle -- it never hides a prompt, a question or an
+/// error. A subagent that has not reported, or reports Unknown, is not activity (R4.4).
 fn thread_row_status(
     pending_tool_call: bool,
     pending_elicitation: bool,
     had_error: bool,
     status: ThreadStatus,
     background_task_count: usize,
+    child_activity: ChildActivity,
 ) -> AgentThreadStatus {
     if pending_tool_call {
         AgentThreadStatus::WaitingForConfirmation
-    } else if pending_elicitation {
+    } else if pending_elicitation || child_activity == ChildActivity::Waiting {
         AgentThreadStatus::WaitingForAnswer
     } else if had_error {
         AgentThreadStatus::Error
@@ -9023,8 +9051,37 @@ fn thread_row_status(
         match status {
             ThreadStatus::Unconfirmed => AgentThreadStatus::Unconfirmed,
             ThreadStatus::Generating => AgentThreadStatus::Running,
-            ThreadStatus::Idle if background_task_count > 0 => AgentThreadStatus::Background,
+            ThreadStatus::Idle
+                if background_task_count > 0 || child_activity == ChildActivity::Running =>
+            {
+                AgentThreadStatus::Background
+            }
             ThreadStatus::Idle => AgentThreadStatus::Completed,
         }
     }
 }
+
+/// Why archiving a thread with work in progress is refused, when the work is a subagent's or
+/// a background task's (R4.3); `None` for the root's own work, refused silently as before.
+fn archive_refusal_reason(
+    workspace: &Entity<Workspace>,
+    session_id: &acp::SessionId,
+    cx: &App,
+) -> Option<&'static str> {
+    let agent_panel = workspace.read(cx).panel::<AgentPanel>(cx)?;
+    let thread = agent_panel
+        .read(cx)
+        .conversation_views()
+        .into_iter()
+        .filter_map(|view| view.read(cx).root_thread_view())
+        .map(|thread_view| thread_view.read(cx).thread.clone())
+        .find(|thread| thread.read(cx).session_id() == session_id)?;
+    let thread = thread.read(cx);
+    if any_child_active(thread, cx) != ChildActivity::None {
+        Some(ARCHIVE_REFUSED_SUBAGENTS)
+    } else if thread.background_task_count() > 0 {
+        Some(ARCHIVE_REFUSED_TASKS)
+    } else {
+        None
+    }
+}
diff --git a/crates/sidebar/src/sidebar_child_background_tests.rs b/crates/sidebar/src/sidebar_child_background_tests.rs
new file mode 100644
index 0000000..48ae393
--- /dev/null
+++ b/crates/sidebar/src/sidebar_child_background_tests.rs
@@ -0,0 +1,437 @@
+// Story 064, task 6.1 — the thread row combines its ACP children's activity (R4.1–R4.4).
+// Patches `0029`/`0030` (fixups). Materialize in `crates/sidebar/src/sidebar.rs`, beside
+// `mod sidebar_sub_thread_tests;`:
+//
+//     #[cfg(test)]
+//     mod sidebar_child_background_tests;
+//
+// Filter: `cargo test -p sidebar background` (paths `sidebar_child_background_tests::…`).
+// Dev-dependency this file adds to `crates/sidebar/Cargo.toml`: `watch.workspace = true` (the
+// child thread's prompt-capabilities receiver; already in the workspace lockfile).
+//
+// A child is built as `agent_servers::acp::apply_subagent_update` builds one: an `agent_owned`
+// `AcpThread` under the parent's session, its association, then `register_subagent` on the
+// parent. Its activity is set with `update_session_state` on the CHILD only — no parent event
+// follows, so a row that recomputes only on the root's events stays stale (R4 "without a
+// parent event").
+//
+// Reuses `sidebar_tests.rs`'s `pub(super)` helpers; statuses are read from `contents.entries`,
+// as 0029's and upstream's subagent tests read them.
+//
+// R4.3's refusal is SHOWN (operator, 2026-10-29): a workspace toast with the reason — "This
+// thread has running subagents" for a Running or Waiting child, and "This thread has running
+// tasks" for 0029's background tasks (same mechanism). Observed through
+// `Workspace::notification_ids()` (test-support), the route agent_ui's sandbox tests use for
+// their toasts. Contract assumed (rename HERE): the toast is shown on the thread's workspace
+// with id `NotificationId::named(<reason text>)`, so the id carries the exact text; the two
+// texts are `crate::ARCHIVE_REFUSED_SUBAGENTS` and `crate::ARCHIVE_REFUSED_TASKS`.
+//
+// Hostile halves first:
+//   - a registered child that has reported NOTHING (unconfirmed) or is Unknown is not activity:
+//     the row keeps the root's own status — a rule written as "any child" would wrongly mark it;
+//   - a child's pending permission keeps the row WaitingForConfirmation: a child's Waiting must
+//     not downgrade it to WaitingForAnswer;
+//   - a running root still reads Running with a running child (Background marks only an
+//     otherwise idle thread, 0029's order);
+//   - archive is refused while a child runs, WITH the subagents reason (never the tasks one), and
+//     the converse: allowed once it is idle, with no refusal shown;
+//   - 0029's background-task refusal shows the tasks reason, never the subagents one;
+//   - then the benign Background and WaitingForAnswer.
+
+use super::*;
+use crate::sidebar_tests::{
+    focus_sidebar, init_test_project_with_agent_panel, save_test_thread_metadata,
+    setup_sidebar_with_agent_panel,
+};
+use acp_thread::{AcpThread, AgentConnection, PermissionOptions, StubAgentConnection};
+use agent_client_protocol::{v1::schema as acp_v1, v2::schema as acp_v2};
+use agent_ui::test_support::{active_session_id, open_thread_with_connection, send_message};
+use gpui::{TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+use std::rc::Rc;
+use workspace::notifications::NotificationId;
+
+/// R4.3's two reasons, byte for byte.
+const SUBAGENTS_REASON: &str = "This thread has running subagents";
+const TASKS_REASON: &str = "This thread has running tasks";
+
+struct Rig {
+    sidebar: Entity<Sidebar>,
+    workspace: Entity<Workspace>,
+    connection: StubAgentConnection,
+    parent: Entity<AcpThread>,
+    parent_session: acp_v2::SessionId,
+}
+
+/// A sidebar over one project whose agent panel holds a persisted parent thread on a stub that
+/// follows the subagents RFD. With `end_turn`, the parent's first turn has ended (root Idle);
+/// without, it is still generating.
+async fn rig(end_turn: bool, cx: &mut TestAppContext) -> (Rig, &mut VisualTestContext) {
+    let project = init_test_project_with_agent_panel("/project-a", cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let (sidebar, panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let connection = StubAgentConnection::new().with_announced_subagents(true);
+    open_thread_with_connection(&panel, connection.clone(), cx);
+    send_message(&panel, cx);
+    let parent_session = active_session_id(&panel, cx);
+    save_test_thread_metadata(&parent_session, &project, cx).await;
+    if end_turn {
+        connection.end_turn(parent_session.clone(), acp_v1::StopReason::EndTurn);
+    }
+    cx.run_until_parked();
+    let parent = panel.read_with(cx, |panel, cx| {
+        panel.active_agent_thread(cx).expect("the parent thread")
+    });
+    (
+        Rig {
+            sidebar,
+            workspace,
+            connection,
+            parent,
+            parent_session,
+        },
+        cx,
+    )
+}
+
+impl Rig {
+    /// The refusal reasons shown on the thread's workspace, in the order of `notification_ids`.
+    fn refusals(&self, cx: &mut VisualTestContext) -> Vec<String> {
+        self.workspace.read_with(cx, |workspace, _| {
+            workspace
+                .notification_ids()
+                .into_iter()
+                .filter_map(|id| match id {
+                    NotificationId::Named(text)
+                        if text.as_ref() == SUBAGENTS_REASON || text.as_ref() == TASKS_REASON =>
+                    {
+                        Some(text.to_string())
+                    }
+                    _ => None,
+                })
+                .collect()
+        })
+    }
+
+    fn spawn_child(&self, session: &str, cx: &mut VisualTestContext) -> Entity<AcpThread> {
+        let parent_session = self.parent_session.clone();
+        let shared: Rc<dyn AgentConnection> = Rc::new(self.connection.clone());
+        let parent = self.parent.clone();
+        let child = cx.update(|_, cx| {
+            let project = parent.read(cx).project().clone();
+            let action_log = cx.new(|_| action_log::ActionLog::new(project.clone()));
+            cx.new(|cx| {
+                AcpThread::new(
+                    Some(parent_session),
+                    None,
+                    None,
+                    shared,
+                    project,
+                    action_log,
+                    acp_v2::SessionId::new(session.to_string()),
+                    watch::Receiver::constant(acp_v2::PromptCapabilities::new()),
+                    cx,
+                )
+                .agent_owned()
+            })
+        });
+        cx.update(|_, cx| self.connection.track_session(&child, cx));
+        child
+            .update(cx, |child, cx| {
+                child.update_subagent_association(
+                    &acp_v2::SubagentUpdate::new(session.to_string()).title("Worker"),
+                    cx,
+                )
+            })
+            .expect("an agent-owned thread takes an association");
+        self.parent
+            .update(cx, |parent, cx| parent.register_subagent(child.clone(), cx));
+        cx.run_until_parked();
+        child
+    }
+
+    fn status(&self, cx: &mut VisualTestContext) -> AgentThreadStatus {
+        let session = self.parent_session.clone();
+        self.sidebar.read_with(cx, |sidebar, _cx| {
+            sidebar
+                .contents
+                .entries
+                .iter()
+                .find_map(|entry| match entry {
+                    ListEntry::Thread(thread)
+                        if thread.metadata.session_id.as_ref() == Some(&session) =>
+                    {
+                        Some(thread.status)
+                    }
+                    _ => None,
+                })
+                .expect("the parent thread is listed")
+        })
+    }
+
+    fn is_listed(&self, cx: &mut VisualTestContext) -> bool {
+        let session = self.parent_session.clone();
+        self.sidebar.read_with(cx, |sidebar, _cx| {
+            sidebar.contents.entries.iter().any(|entry| {
+                matches!(
+                    entry,
+                    ListEntry::Thread(thread)
+                        if thread.metadata.session_id.as_ref() == Some(&session)
+                            && !thread.metadata.archived
+                )
+            })
+        })
+    }
+
+    fn archive(&self, cx: &mut VisualTestContext) {
+        let session = self.parent_session.clone();
+        let index = self.sidebar.read_with(cx, |sidebar, _cx| {
+            sidebar
+                .contents
+                .entries
+                .iter()
+                .position(|entry| {
+                    matches!(
+                        entry,
+                        ListEntry::Thread(thread)
+                            if thread.metadata.session_id.as_ref() == Some(&session)
+                    )
+                })
+                .expect("the parent thread is listed")
+        });
+        focus_sidebar(&self.sidebar, cx);
+        self.sidebar.update_in(cx, |sidebar, _window, _cx| {
+            sidebar.selection = Some(index);
+        });
+        cx.dispatch_action(ArchiveSelectedThread);
+        cx.run_until_parked();
+    }
+}
+
+/// The child reports a state; no parent event follows.
+fn report(child: &Entity<AcpThread>, state: acp_v2::StateUpdate, cx: &mut VisualTestContext) {
+    child
+        .update(cx, |child, cx| child.update_session_state(state, cx))
+        .expect("an agent-owned thread reports its state");
+    cx.run_until_parked();
+}
+
+fn running() -> acp_v2::StateUpdate {
+    acp_v2::StateUpdate::Running(acp_v2::RunningStateUpdate::new())
+}
+
+fn waiting() -> acp_v2::StateUpdate {
+    acp_v2::StateUpdate::RequiresAction(acp_v2::RequiresActionStateUpdate::new())
+}
+
+fn idle() -> acp_v2::StateUpdate {
+    acp_v2::StateUpdate::Idle(
+        acp_v2::IdleStateUpdate::new().stop_reason(acp_v2::StopReason::EndTurn),
+    )
+}
+
+// ── Hostile: what is NOT child activity ─────────────────────────────────────
+
+/// A child that has reported nothing yet (unconfirmed), then one that reports Unknown, is not
+/// Running or Waiting: the idle root's own status stands (R4.4).
+#[gpui::test]
+async fn test_child_background_unconfirmed_or_unknown_child_keeps_the_root_status(
+    cx: &mut TestAppContext,
+) {
+    let (rig, cx) = rig(true, cx).await;
+    let root_status = rig.status(cx);
+    assert_ne!(
+        root_status,
+        AgentThreadStatus::Background,
+        "precondition: the idle root reads its own status"
+    );
+
+    let child = rig.spawn_child("child", cx);
+    assert_eq!(
+        rig.status(cx),
+        root_status,
+        "an unconfirmed child is not activity"
+    );
+    report(
+        &child,
+        acp_v2::StateUpdate::Unknown(acp_v2::UnknownStateUpdate::new()),
+        cx,
+    );
+    assert_eq!(
+        rig.status(cx),
+        root_status,
+        "an Unknown child is not activity"
+    );
+}
+
+/// A child's pending permission keeps the row WaitingForConfirmation (upstream's own rule),
+/// even when the child also reports Waiting.
+#[gpui::test]
+async fn test_child_background_child_permission_outranks_child_waiting(cx: &mut TestAppContext) {
+    let (rig, cx) = rig(true, cx).await;
+    let child = rig.spawn_child("child", cx);
+    report(&child, waiting(), cx);
+    let _authorization = cx.update(|_, cx| {
+        child.update(cx, |thread, cx| {
+            thread
+                .request_tool_call_authorization(
+                    acp_v1::ToolCall::new(acp_v1::ToolCallId::new("child-call"), "Edit a file")
+                        .kind(acp_v1::ToolKind::Edit)
+                        .into(),
+                    PermissionOptions::Flat(vec![acp_v2::PermissionOption::new(
+                        acp_v2::PermissionOptionId::new("allow"),
+                        "Allow",
+                        acp_v2::PermissionOptionKind::AllowOnce,
+                    )]),
+                    acp_thread::AuthorizationKind::PermissionGrant,
+                    cx,
+                )
+                .expect("the request installs")
+        })
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        rig.status(cx),
+        AgentThreadStatus::WaitingForConfirmation,
+        "a permission outranks a question"
+    );
+}
+
+/// A running root stays Running beside a running child: Background marks only a thread that is
+/// otherwise idle.
+#[gpui::test]
+async fn test_child_background_running_root_stays_running(cx: &mut TestAppContext) {
+    let (rig, cx) = rig(false, cx).await;
+    assert_eq!(rig.status(cx), AgentThreadStatus::Running, "precondition");
+    let child = rig.spawn_child("child", cx);
+    report(&child, running(), cx);
+    assert_eq!(rig.status(cx), AgentThreadStatus::Running);
+}
+
+// ── R4.3 — archive refused while a child runs; allowed once it is idle ──────
+
+#[gpui::test]
+async fn test_child_background_archive_is_refused_while_a_child_runs(cx: &mut TestAppContext) {
+    let (rig, cx) = rig(true, cx).await;
+    let child = rig.spawn_child("child", cx);
+    report(&child, running(), cx);
+
+    assert!(
+        rig.refusals(cx).is_empty(),
+        "precondition: no refusal shown"
+    );
+    rig.archive(cx);
+    assert!(
+        rig.is_listed(cx),
+        "archiving is refused while a child runs, as 0029 refuses it for background work"
+    );
+    assert_eq!(rig.status(cx), AgentThreadStatus::Background);
+    assert_eq!(
+        rig.refusals(cx),
+        vec![SUBAGENTS_REASON.to_string()],
+        "the refusal says why: running subagents, not running tasks"
+    );
+    assert_eq!(crate::ARCHIVE_REFUSED_SUBAGENTS, SUBAGENTS_REASON);
+
+    // Converse: the child ends, and the same action archives the thread, refusing nothing.
+    report(&child, idle(), cx);
+    assert_ne!(rig.status(cx), AgentThreadStatus::Background);
+    let shown_before = rig.refusals(cx).len();
+    rig.archive(cx);
+    assert!(
+        !rig.is_listed(cx),
+        "with no child running, archive is allowed again"
+    );
+    assert!(
+        rig.refusals(cx).len() <= shown_before,
+        "an allowed archive shows no new refusal"
+    );
+}
+
+/// A Waiting child refuses archive too.
+#[gpui::test]
+async fn test_child_background_archive_is_refused_while_a_child_waits(cx: &mut TestAppContext) {
+    let (rig, cx) = rig(true, cx).await;
+    let child = rig.spawn_child("child", cx);
+    report(&child, waiting(), cx);
+    rig.archive(cx);
+    assert!(rig.is_listed(cx), "a waiting child refuses archive");
+    assert_eq!(rig.refusals(cx), vec![SUBAGENTS_REASON.to_string()]);
+}
+
+/// 0029's refusal for background tasks (no child at all) shows the TASKS reason, through the
+/// same mechanism, never the subagents one.
+#[gpui::test]
+async fn test_child_background_archive_refused_for_background_tasks_says_tasks(
+    cx: &mut TestAppContext,
+) {
+    let (rig, cx) = rig(true, cx).await;
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/backgroundTasks".to_string(),
+        serde_json::json!({ "count": 1, "tasks": [] }),
+    );
+    cx.update(|_, cx| {
+        rig.connection.send_update(
+            rig.parent_session.clone(),
+            acp_v1::SessionUpdate::SessionInfoUpdate(acp_v1::SessionInfoUpdate::new().meta(meta)),
+            cx,
+        )
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        rig.status(cx),
+        AgentThreadStatus::Background,
+        "precondition"
+    );
+
+    rig.archive(cx);
+    assert!(rig.is_listed(cx), "0029 still refuses it");
+    assert_eq!(
+        rig.refusals(cx),
+        vec![TASKS_REASON.to_string()],
+        "the refusal says why: running tasks"
+    );
+    assert_eq!(crate::ARCHIVE_REFUSED_TASKS, TASKS_REASON);
+}
+
+// ── R4.1, R4.2, R4.4 — the benign states, on the child's event alone ────────
+
+/// Idle root, zero background tasks: a running child marks the row Background on the child's
+/// own state change; its end returns the row to the root's status.
+#[gpui::test]
+async fn test_child_background_running_child_under_an_idle_root_reads_background(
+    cx: &mut TestAppContext,
+) {
+    let (rig, cx) = rig(true, cx).await;
+    let root_status = rig.status(cx);
+    let child = rig.spawn_child("child", cx);
+
+    report(&child, running(), cx);
+    assert_eq!(rig.status(cx), AgentThreadStatus::Background, "R4.1");
+
+    report(&child, idle(), cx);
+    assert_eq!(
+        rig.status(cx),
+        root_status,
+        "R4.4: back to the root's own status"
+    );
+}
+
+/// One child waiting for the user makes the row wait for an answer, like 0030's question does
+/// for the root; a second, running child does not hide it.
+#[gpui::test]
+async fn test_child_background_waiting_child_reads_waiting_for_answer(cx: &mut TestAppContext) {
+    let (rig, cx) = rig(true, cx).await;
+    let first = rig.spawn_child("first", cx);
+    let second = rig.spawn_child("second", cx);
+    report(&second, running(), cx);
+    report(&first, waiting(), cx);
+    assert_eq!(rig.status(cx), AgentThreadStatus::WaitingForAnswer, "R4.2");
+
+    report(&first, running(), cx);
+    assert_eq!(rig.status(cx), AgentThreadStatus::Background);
+}
