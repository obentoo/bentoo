+/// The registered children of `thread` that it has sent no message to and that no spawning tool
+/// call names, in registration order: each is drawn as a card after the turn's last entry (R5.3).
+pub(crate) fn unsent_subagents(thread: &AcpThread) -> Vec<Entity<AcpThread>> {
+    let own_session_id = thread.session_id();
+    thread
+        .subagents()
+        .filter(|subagent| {
+            let child = subagent.entity_id();
+            !thread.entries().iter().any(|entry| match entry {
+                AgentThreadEntry::SessionMessage(message) => {
+                    matches!(
+                        message.side(own_session_id),
+                        SessionMessageSide::Outgoing { recipient: Some(recipient) }
+                            if thread.subagent(recipient).map(|known| known.entity_id())
+                                == Some(child)
+                    )
+                }
+                // Since #66255 a native `spawn_agent` child is registered too, and its card is
+                // the spawning tool call's: appending another would draw the child twice.
+                AgentThreadEntry::ToolCall(tool_call) => tool_call
+                    .subagent_session_info
+                    .as_ref()
+                    .is_some_and(|info| {
+                        thread
+                            .subagent(&info.session_id)
+                            .map(|known| known.entity_id())
+                            == Some(child)
+                    }),
+                _ => false,
+            })
+        })
+        .cloned()
+        .collect()
+}
