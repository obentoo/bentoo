diff --git a/crates/workspace/src/panel_button_order.rs b/crates/workspace/src/panel_button_order.rs
new file mode 100644
index 0000000..b39aca9
--- /dev/null
+++ b/crates/workspace/src/panel_button_order.rs
@@ -0,0 +1,66 @@
+//! The order of the status bar's panel buttons (Zeo next proposal §6.36, ask 59).
+//!
+//! Upstream orders each dock's buttons by the panels' fixed `activation_priority`, and a button
+//! moves between sides only with its panel's dock (right-click → Dock Left/Right). The operator
+//! asked to order them in the settings window instead of by drag and drop, which would live in
+//! this crate's most-changed code. `status_bar.panel_button_order` lists panel persistent names;
+//! within each dock, listed panels come first in the listed order and the rest keep upstream's.
+//! The order is read left to right as the buttons are shown, so the right dock's buttons are
+//! ordered after upstream reverses them.
+
+/// Reorders `items` (each tagged with its panel's persistent name) by `order`: the listed names
+/// first, in the listed order, then everything else in its original order. A name that is listed
+/// twice, or carried by no item, changes nothing; no item is ever dropped.
+pub fn order_by_setting<T>(items: Vec<(&'static str, T)>, order: &[String]) -> Vec<T> {
+    let mut items: Vec<Option<(&'static str, T)>> = items.into_iter().map(Some).collect();
+    let mut ordered = Vec::with_capacity(items.len());
+    for name in order {
+        if let Some(slot) = items
+            .iter_mut()
+            .find(|slot| slot.as_ref().is_some_and(|(item, _)| item == name))
+            && let Some((_, item)) = slot.take()
+        {
+            ordered.push(item);
+        }
+    }
+    ordered.extend(items.into_iter().flatten().map(|(_, item)| item));
+    ordered
+}
+
+/// The whole order after moving `name` one place (`delta` -1 up/left, +1 down/right) inside its
+/// own group. `groups` are the docks' buttons as shown, each in its current order; the answer
+/// concatenates them, ready to be written as `status_bar.panel_button_order`. A move past either
+/// end of a group, or of a name no group carries, leaves the order as it is.
+pub fn move_panel(groups: &[Vec<&'static str>], name: &str, delta: isize) -> Vec<String> {
+    let mut groups: Vec<Vec<&'static str>> = groups.to_vec();
+    for group in &mut groups {
+        if let Some(ix) = group.iter().position(|item| *item == name) {
+            let target = ix as isize + delta;
+            if target >= 0 && (target as usize) < group.len() {
+                group.swap(ix, target as usize);
+            }
+            break;
+        }
+    }
+    groups.into_iter().flatten().map(str::to_string).collect()
+}
+
+/// A readable label for a persistent name: "GitPanel" → "Git Panel". Names that already have
+/// spaces are left as they are.
+pub fn panel_label(name: &str) -> String {
+    if name.contains(' ') {
+        return name.to_string();
+    }
+    let mut label = String::with_capacity(name.len() + 4);
+    for (ix, ch) in name.chars().enumerate() {
+        if ix > 0 && ch.is_uppercase() {
+            label.push(' ');
+        }
+        label.push(ch);
+    }
+    label
+}
+
