+++ b/crates/settings_ui/src/pages/panel_button_order_page.rs
@@ -0,0 +1,202 @@
+//! Settings → Status Bar → Panel Button Order (Zeo next proposal §6.36, ask 59).
+//!
+//! Lists the panel buttons of the window the settings were opened from, side by side as the
+//! status bar shows them, with up and down arrows. Each move writes the whole order to
+//! `status_bar.panel_button_order` (see `workspace::panel_button_order`). A button changes side
+//! only with its panel's dock, which upstream already offers on the button's right-click menu;
+//! the page says so rather than duplicating it.
+
+use std::sync::Arc;
+
+use fs::Fs;
+use gpui::{AnyElement, App, ScrollHandle, Window};
+use settings::{Settings as _, update_settings_file};
+use ui::{Button, IconButton, IconName, IconSize, Label, LabelSize, Tooltip, prelude::*};
+use workspace::StatusBarSettings;
+use workspace::panel_button_order::{move_panel, order_by_setting, panel_label};
+
+use crate::SettingsWindow;
+
+/// One side of the status bar: its label and its buttons' panel names as shown.
+pub(crate) type PanelGroup = (&'static str, Vec<&'static str>);
+
+/// The buttons of each side as the status bar shows them: upstream's order per dock, the right
+/// dock reversed as upstream draws it, then the setting's order. Empty sides are left out.
+pub(crate) fn shown_groups(
+    left: Vec<&'static str>,
+    bottom: Vec<&'static str>,
+    mut right: Vec<&'static str>,
+    order: &[String],
+) -> Vec<PanelGroup> {
+    right.reverse();
+    [("Left", left), ("Bottom", bottom), ("Right", right)]
+        .into_iter()
+        .map(|(side, names)| {
+            let tagged = names.into_iter().map(|name| (name, name)).collect();
+            (side, order_by_setting(tagged, order))
+        })
+        .filter(|(_, names)| !names.is_empty())
+        .collect()
+}
+
+fn groups_for_window(settings_window: &SettingsWindow, cx: &App) -> Option<Vec<PanelGroup>> {
+    let multi_workspace = settings_window.original_window?.read(cx).ok()?;
+    let workspace = multi_workspace.workspace().read(cx);
+    Some(shown_groups(
+        workspace.left_dock().read(cx).panel_names(),
+        workspace.bottom_dock().read(cx).panel_names(),
+        workspace.right_dock().read(cx).panel_names(),
+        &StatusBarSettings::get_global(cx).panel_button_order,
+    ))
+}
+
+fn write_order(order: Vec<String>, cx: &App) {
+    update_settings_file(<dyn Fs>::global(cx), cx, move |content, _| {
+        content
+            .status_bar
+            .get_or_insert_default()
+            .panel_button_order = Some(order);
+    });
+}
+
+fn move_button(
+    id: SharedString,
+    icon: IconName,
+    tooltip: &'static str,
+    enabled: bool,
+    groups: Arc<Vec<Vec<&'static str>>>,
+    name: &'static str,
+    delta: isize,
+) -> IconButton {
+    IconButton::new(id, icon)
+        .icon_size(IconSize::Small)
+        .disabled(!enabled)
+        .tooltip(Tooltip::text(tooltip))
+        .on_click(move |_, _, cx| write_order(move_panel(&groups, name, delta), cx))
+}
+
+fn render_group(
+    side: &'static str,
+    names: &[&'static str],
+    groups: &Arc<Vec<Vec<&'static str>>>,
+) -> AnyElement {
+    let last = names.len().saturating_sub(1);
+    v_flex()
+        .gap_1()
+        .child(Label::new(side).size(LabelSize::Small).color(Color::Muted))
+        .children(names.iter().enumerate().map(|(ix, &name)| {
+            h_flex()
+                .debug_selector(move || format!("panel-button-order-row-{name}"))
+                .gap_2()
+                .child(move_button(
+                    format!("panel-button-order-up-{name}").into(),
+                    IconName::ArrowUp,
+                    "Move Left",
+                    ix > 0,
+                    groups.clone(),
+                    name,
+                    -1,
+                ))
+                .child(move_button(
+                    format!("panel-button-order-down-{name}").into(),
+                    IconName::ArrowDown,
+                    "Move Right",
+                    ix < last,
+                    groups.clone(),
+                    name,
+                    1,
+                ))
+                .child(Label::new(panel_label(name)))
+        }))
+        .into_any_element()
+}
+
+pub(crate) fn render_panel_button_order_page(
+    settings_window: &SettingsWindow,
+    scroll_handle: &ScrollHandle,
+    _window: &mut Window,
+    cx: &mut Context<SettingsWindow>,
+) -> AnyElement {
+    let content = match groups_for_window(settings_window, cx) {
+        Some(groups) if !groups.is_empty() => {
+            let all: Arc<Vec<Vec<&'static str>>> =
+                Arc::new(groups.iter().map(|(_, names)| names.clone()).collect());
+            v_flex()
+                .gap_4()
+                .children(
+                    groups
+                        .iter()
+                        .map(|(side, names)| render_group(side, names, &all)),
+                )
+                .into_any_element()
+        }
+        _ => Label::new("Open the settings from a Zeo window to order its panel buttons.")
+            .color(Color::Muted)
+            .into_any_element(),
+    };
+    v_flex()
+        .id("panel-button-order-page")
+        .debug_selector(|| "panel-button-order-page".into())
+        .size_full()
+        .gap_4()
+        .pt_2p5()
+        .px_8()
+        .pb_16()
+        .overflow_y_scroll()
+        .track_scroll(scroll_handle)
+        .child(
+            Label::new(
+                "The order of the panel buttons in the status bar, left to right on each side. \
+                 A button changes side with its panel: right-click it and choose another dock.",
+            )
+            .color(Color::Muted),
+        )
+        .child(content)
+        .child(
+            Button::new("panel-button-order-reset", "Reset to Default")
+                .on_click(|_, _, cx| write_order(Vec::new(), cx)),
+        )
+        .into_any_element()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn groups_follow_the_status_bar_and_skip_empty_sides() {
+        let groups = shown_groups(
+            vec!["Project Panel", "GitPanel"],
+            vec![],
+            vec!["AgentPanel", "NotificationPanel"],
+            &[],
+        );
+        assert_eq!(
+            groups,
+            vec![
+                ("Left", vec!["Project Panel", "GitPanel"]),
+                // Upstream draws the right dock reversed.
+                ("Right", vec!["NotificationPanel", "AgentPanel"]),
+            ]
+        );
+    }
+
+    #[test]
+    fn groups_apply_the_setting_on_each_side() {
+        let order = vec!["GitPanel".to_string(), "AgentPanel".to_string()];
+        let groups = shown_groups(
+            vec!["Project Panel", "GitPanel"],
+            vec!["TerminalPanel"],
+            vec!["AgentPanel", "NotificationPanel"],
+            &order,
+        );
+        assert_eq!(
+            groups,
+            vec![
+                ("Left", vec!["GitPanel", "Project Panel"]),
+                ("Bottom", vec!["TerminalPanel"]),
+                ("Right", vec!["AgentPanel", "NotificationPanel"]),
+            ]
+        );
+    }
+}
