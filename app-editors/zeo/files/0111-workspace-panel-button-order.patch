@@ -0,0 +1,58 @@
+// Zeo next proposal §6.36 (ask 59): the order of the status bar's panel buttons.
+// Filter: `panel_button_order::tests`.
+
+use super::{move_panel, order_by_setting, panel_label};
+
+fn names(items: Vec<&'static str>) -> Vec<&'static str> {
+    items
+}
+
+#[test]
+fn without_a_setting_the_order_is_unchanged() {
+    let shown = order_by_setting(vec![("A", 1), ("B", 2), ("C", 3)], &[]);
+    assert_eq!(shown, vec![1, 2, 3]);
+}
+
+#[test]
+fn listed_panels_come_first_in_the_listed_order() {
+    let order = vec!["C".to_string(), "A".to_string()];
+    let shown = order_by_setting(vec![("A", 1), ("B", 2), ("C", 3)], &order);
+    assert_eq!(shown, vec![3, 1, 2]);
+}
+
+/// Hostile: a name in the setting that no panel in this dock carries -- a panel of the other
+/// side, a removed extension, a typo -- changes nothing and loses nothing.
+#[test]
+fn unknown_names_are_ignored_and_no_button_is_lost() {
+    let order = vec!["Gone".to_string(), "B".to_string(), "B".to_string()];
+    let shown = order_by_setting(vec![("A", 1), ("B", 2), ("C", 3)], &order);
+    assert_eq!(shown, vec![2, 1, 3]);
+}
+
+#[test]
+fn moving_a_panel_swaps_it_with_its_neighbour() {
+    let groups = vec![names(vec!["A", "B", "C"]), names(vec!["X", "Y"])];
+    assert_eq!(
+        move_panel(&groups, "B", -1),
+        vec!["B", "A", "C", "X", "Y"],
+        "up swaps with the one before"
+    );
+    assert_eq!(move_panel(&groups, "X", 1), vec!["A", "B", "C", "Y", "X"]);
+}
+
+/// Hostile: the ends do not wrap, and a move never crosses into another dock's group.
+#[test]
+fn moving_stops_at_the_ends_of_its_own_side() {
+    let groups = vec![names(vec!["A", "B"]), names(vec!["X", "Y"])];
+    assert_eq!(move_panel(&groups, "A", -1), vec!["A", "B", "X", "Y"]);
+    assert_eq!(move_panel(&groups, "B", 1), vec!["A", "B", "X", "Y"]);
+    assert_eq!(move_panel(&groups, "missing", 1), vec!["A", "B", "X", "Y"]);
+}
+
+#[test]
+fn labels_split_the_persistent_name() {
+    assert_eq!(panel_label("GitPanel"), "Git Panel");
+    assert_eq!(panel_label("AgentPanel"), "Agent Panel");
+    assert_eq!(panel_label("Project Panel"), "Project Panel");
+    assert_eq!(panel_label("DebugPanel"), "Debug Panel");
+}
