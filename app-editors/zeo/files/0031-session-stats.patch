new file mode 100644
index 0000000..dc93cc2
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/session_stats.rs
@@ -0,0 +1,297 @@
+use std::collections::BTreeMap;
+
+use acp_thread::AgentThreadEntry;
+use agent_client_protocol::schema::v2 as acp_v2;
+use gpui::{AnyElement, SharedString};
+use ui::prelude::*;
+
+/// Claude Code names a tool served by an MCP server `mcp__<server>__<tool>`.
+const MCP_TOOL_PREFIX: &str = "mcp__";
+
+/// Shell builtins that change the shell's own state rather than run a
+/// program. Counting them would bury the programs under a `cd` per command.
+const SHELL_BUILTINS: &[&str] = &["cd", "export", "set", "unset", "source", "."];
+
+/// The tool calls of one thread, grouped the way the turn stats list them.
+#[derive(Debug, Default, PartialEq)]
+pub(super) struct ToolUsage {
+    pub total: usize,
+    /// Every tool that is not an MCP tool, by name.
+    pub tools: BTreeMap<SharedString, usize>,
+    /// MCP tool calls, by the server that served them.
+    pub mcp_servers: BTreeMap<SharedString, usize>,
+    /// The programs the terminal tool calls ran. One call can run several
+    /// (`cargo fmt && cargo test`), so this is not a subset of `total`.
+    pub programs: BTreeMap<SharedString, usize>,
+}
+
+impl ToolUsage {
+    pub fn from_entries(entries: &[AgentThreadEntry]) -> Self {
+        Self::from_calls(entries.iter().filter_map(|entry| {
+            let AgentThreadEntry::ToolCall(call) = entry else {
+                return None;
+            };
+            let command = call
+                .raw_input
+                .as_ref()
+                .and_then(|input| input.get("command"))
+                .and_then(|command| command.as_str());
+            Some((call.tool_name.clone(), call.kind().clone(), command))
+        }))
+    }
+
+    /// The grouping itself, over each call's name, kind and command -- split from
+    /// `from_entries` so it can be tested without building tool-call entries.
+    fn from_calls<'a>(
+        calls: impl IntoIterator<Item = (Option<SharedString>, acp_v2::ToolKind, Option<&'a str>)>,
+    ) -> Self {
+        let mut usage = Self::default();
+        for (tool_name, kind, command) in calls {
+            usage.total += 1;
+
+            let name = tool_name.unwrap_or_else(|| format!("{kind:?}").into());
+            match mcp_server_name(&name) {
+                Some(server) => *usage.mcp_servers.entry(server.into()).or_default() += 1,
+                None => *usage.tools.entry(name).or_default() += 1,
+            }
+
+            if kind == acp_v2::ToolKind::Execute
+                && let Some(command) = command
+            {
+                for program in command_programs(command) {
+                    *usage
+                        .programs
+                        .entry(SharedString::from(program.to_owned()))
+                        .or_default() += 1;
+                }
+            }
+        }
+        usage
+    }
+}
+
+fn mcp_server_name(tool_name: &str) -> Option<&str> {
+    let server = tool_name
+        .strip_prefix(MCP_TOOL_PREFIX)?
+        .split("__")
+        .next()?;
+    (!server.is_empty()).then_some(server)
+}
+
+/// The programs a shell command runs, in order.
+///
+/// A heuristic, not a shell parser: it splits on the unquoted separators
+/// (`;`, `|`, `&&`, `||`, newline), skips heredoc bodies, and takes the first
+/// word of each segment that is not an environment assignment. A program
+/// launched through a wrapper (`xargs grep`, `sudo make`) counts as the
+/// wrapper.
+pub(super) fn command_programs(command: &str) -> Vec<&str> {
+    let mut programs = Vec::new();
+    let mut pending_heredocs: Vec<String> = Vec::new();
+    let mut quote: Option<char> = None;
+    let mut segment_start = 0;
+    let mut index = 0;
+
+    while let Some(character) = command[index..].chars().next() {
+        let rest = &command[index..];
+        let mut advance = character.len_utf8();
+        match (quote, character) {
+            (Some('"'), '\\') => advance += rest[1..].chars().next().map_or(0, char::len_utf8),
+            (Some(open), _) if character == open => quote = None,
+            (Some(_), _) => {}
+            (None, '\\') => advance += rest[1..].chars().next().map_or(0, char::len_utf8),
+            (None, '\'' | '"') => quote = Some(character),
+            (None, '<') if rest.starts_with("<<<") => advance = 3,
+            (None, '<') if rest.starts_with("<<") => {
+                pending_heredocs.extend(heredoc_delimiter_at(&rest[2..]));
+                advance = 2;
+            }
+            (None, '&') if rest.starts_with("&&") => {
+                push_program(&command[segment_start..index], &mut programs);
+                advance = 2;
+                segment_start = index + advance;
+            }
+            (None, ';' | '|') => {
+                push_program(&command[segment_start..index], &mut programs);
+                segment_start = index + advance;
+            }
+            (None, '\n') => {
+                push_program(&command[segment_start..index], &mut programs);
+                // Heredoc bodies start on the line after their `<<`, one after
+                // the other, each ending at the line that is its delimiter.
+                let mut line_start = index + 1;
+                for delimiter in pending_heredocs.drain(..) {
+                    while let Some(line) = command.get(line_start..)
+                        && !line.is_empty()
+                    {
+                        let line_end = line
+                            .find('\n')
+                            .map_or(command.len(), |offset| line_start + offset);
+                        let is_delimiter = command[line_start..line_end].trim() == delimiter;
+                        line_start = (line_end + 1).min(command.len());
+                        if is_delimiter {
+                            break;
+                        }
+                    }
+                }
+                advance = line_start - index;
+                segment_start = line_start;
+            }
+            _ => {}
+        }
+        index = (index + advance).min(command.len());
+    }
+
+    push_program(&command[segment_start..], &mut programs);
+    programs
+}
+
+fn heredoc_delimiter_at(rest: &str) -> Option<String> {
+    let rest = rest.strip_prefix('-').unwrap_or(rest).trim_start();
+    let word = rest.split_whitespace().next()?;
+    let delimiter = word.trim_matches(|character| matches!(character, '\'' | '"' | '\\'));
+    // `<<<` is a here-string, not a heredoc: it has no body to skip.
+    (!delimiter.is_empty() && !delimiter.starts_with('<')).then(|| delimiter.to_owned())
+}
+
+fn push_program<'a>(segment: &'a str, programs: &mut Vec<&'a str>) {
+    let program = segment
+        .split_whitespace()
+        .map(|word| word.trim_start_matches(['(', '{', '!']))
+        .find(|word| !word.is_empty() && !is_environment_assignment(word));
+    let Some(program) = program else {
+        return;
+    };
+    if program.starts_with('#') {
+        return;
+    }
+    let program = program.trim_matches(|character| matches!(character, '\'' | '"'));
+    let program = program.rsplit('/').next().unwrap_or(program);
+    if !program.is_empty() && !SHELL_BUILTINS.contains(&program) {
+        programs.push(program);
+    }
+}
+
+fn is_environment_assignment(word: &str) -> bool {
+    word.split_once('=').is_some_and(|(name, _)| {
+        !name.is_empty()
+            && name
+                .chars()
+                .all(|character| character.is_ascii_alphanumeric() || character == '_')
+    })
+}
+
+pub(super) fn render_tool_usage_tooltip(usage: &ToolUsage) -> AnyElement {
+    let section = |title: &'static str, counts: &BTreeMap<SharedString, usize>| {
+        let mut rows: Vec<_> = counts.iter().collect();
+        // Most used first; the map's own order breaks ties alphabetically.
+        rows.sort_by(|left, right| right.1.cmp(left.1));
+        (!rows.is_empty()).then(|| {
+            v_flex()
+                .gap_0p5()
+                .child(Label::new(title).size(LabelSize::Small).color(Color::Muted))
+                .children(rows.into_iter().map(|(name, count)| {
+                    h_flex()
+                        .gap_4()
+                        .justify_between()
+                        .child(Label::new(name.clone()).size(LabelSize::Small))
+                        .child(
+                            Label::new(count.to_string())
+                                .size(LabelSize::Small)
+                                .color(Color::Muted),
+                        )
+                }))
+        })
+    };
+
+    v_flex()
+        .gap_2()
+        .children(section("Tools", &usage.tools))
+        .children(section("MCP servers", &usage.mcp_servers))
+        .children(section("Commands", &usage.programs))
+        .into_any_element()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn splits_on_unquoted_separators() {
+        assert_eq!(
+            command_programs("cd crates && cargo fmt; cargo test | tail -5 || echo failed"),
+            ["cargo", "cargo", "tail", "echo"]
+        );
+    }
+
+    #[test]
+    fn keeps_quoted_separators_and_redirections() {
+        assert_eq!(
+            command_programs(r#"grep -n 'a\|b; c' file 2>&1 | head"#),
+            ["grep", "head"]
+        );
+        assert_eq!(command_programs(r#"git commit -m "x && y""#), ["git"]);
+    }
+
+    #[test]
+    fn skips_environment_assignments_paths_and_comments() {
+        assert_eq!(
+            command_programs("RUST_LOG=debug /usr/bin/cargo run\n# a comment\n./script/clippy"),
+            ["cargo", "clippy"]
+        );
+    }
+
+    #[test]
+    fn skips_heredoc_bodies() {
+        let command = "python3 - <<'EOF'\nimport sys; print(1) | x\nEOF\ngit status";
+        assert_eq!(command_programs(command), ["python3", "git"]);
+        assert_eq!(command_programs("cat <<<\"a; b\" && ls"), ["cat", "ls"]);
+    }
+
+    #[test]
+    fn unterminated_heredoc_counts_only_its_command() {
+        assert_eq!(command_programs("cat <<EOF\nnot | a program"), ["cat"]);
+        assert_eq!(command_programs("cat <<EOF"), ["cat"]);
+    }
+
+    /// Unnamed calls fall back to their kind, `mcp__<server>__<tool>` goes to the server
+    /// list, and programs are read only from Execute calls -- a `command` on any other
+    /// kind is not a program run.
+    #[test]
+    fn tool_usage_groups_by_name_kind_mcp_server_and_program() {
+        use acp_v2::ToolKind::{Edit, Execute, Read};
+        let usage = ToolUsage::from_calls([
+            (Some("Read".into()), Read, None),
+            (Some("Read".into()), Read, None),
+            (None, Edit, None),
+            (Some("mcp__github__create_issue".into()), acp_v2::ToolKind::Other, None),
+            (Some("mcp__github__list".into()), acp_v2::ToolKind::Other, None),
+            (Some("Bash".into()), Execute, Some("cargo fmt && cargo test")),
+            (Some("Note".into()), Read, Some("rm -rf /")),
+        ]);
+        assert_eq!(usage.total, 7);
+        assert_eq!(usage.tools.get("Read"), Some(&2));
+        assert_eq!(usage.tools.get("Edit"), Some(&1), "an unnamed call counts as its kind");
+        assert_eq!(usage.mcp_servers.get("github"), Some(&2));
+        assert!(!usage.tools.contains_key("mcp__github__create_issue"));
+        assert_eq!(usage.programs.get("cargo"), Some(&2));
+        assert!(!usage.programs.contains_key("rm"), "only Execute calls run programs");
+    }
+
+    /// Odd input never panics and always ends: multibyte text, a trailing backslash, a
+    /// heredoc marker at the very end, unbalanced quotes.
+    #[test]
+    fn command_programs_survives_odd_input() {
+        for command in ["é ü && ñ", "echo \\", "cat <<", "cat <<'", "echo 'open", "\"", "", "&&", "a ||"] {
+            let _ = command_programs(command);
+        }
+        assert_eq!(command_programs("ñandu --x && ü"), ["ñandu", "ü"]);
+    }
+
+    #[test]
+    fn recognises_mcp_servers() {
+        assert_eq!(mcp_server_name("mcp__github__create_issue"), Some("github"));
+        assert_eq!(mcp_server_name("mcp____tool"), None);
+        assert_eq!(mcp_server_name("Bash"), None);
+    }
+}
