+use std::{
+    collections::HashSet,
+    path::{MAIN_SEPARATOR_STR, Path, PathBuf},
+    sync::Arc,
+    time::Duration,
+};
+
+use fs::{Fs, PathEvent, PathEventKind, Watcher};
+use futures::{FutureExt as _, StreamExt as _};
+use gpui::{App, Task};
+use parking_lot::Mutex;
+
+/// At most one `on_change` per this window while events keep arriving (R5.3).
+pub const DEBOUNCE: Duration = Duration::from_millis(500);
+/// The native watcher's own batching; it sits inside `DEBOUNCE`.
+pub const WATCH_LATENCY: Duration = Duration::from_millis(100);
+
+const AREAS: [&str; 2] = ["stories", "archive"];
+
+type OnFailure = Box<dyn Fn(String) + Send>;
+/// The callback taken out of the state, with the reason to call it with.
+type Failure = (OnFailure, String);
+
+/// Follows one `.epic/` directory and reports debounced changes. Dropping it ends the watch:
+/// the task owns the event stream, and `state` owns the watcher.
+pub struct EpicWatch {
+    _task: Task<()>,
+    state: Arc<Mutex<WatchState>>,
+}
+
+struct WatchState {
+    /// `None` until `fs.watch` returns inside the background task.
+    watcher: Option<Arc<dyn Watcher>>,
+    added: HashSet<PathBuf>,
+    wanted: Vec<PathBuf>,
+    /// Taken on the first failure, so `on_failure` runs at most once per `EpicWatch`.
+    on_failure: Option<OnFailure>,
+    worktree_root: PathBuf,
+}
+
+impl EpicWatch {
+    /// Spawns on the background executor: watches `epic_dir`, adds `stories/` and `archive/`
+    /// when they exist (Linux inotify is not recursive), then every directory `sync_dirs` asked
+    /// for. Calls `on_change` at most once per `DEBOUNCE`; calls `on_failure` once, when a
+    /// directory cannot be added or the event stream ends.
+    pub fn start(
+        fs: Arc<dyn Fs>,
+        epic_dir: PathBuf,
+        on_change: impl Fn() + Send + 'static,
+        on_failure: impl Fn(String) + Send + 'static,
+        cx: &App,
+    ) -> Self {
+        let worktree_root = epic_dir.parent().map(Path::to_path_buf).unwrap_or_default();
+        let state = Arc::new(Mutex::new(WatchState {
+            watcher: None,
+            added: HashSet::default(),
+            wanted: Vec::new(),
+            on_failure: Some(Box::new(on_failure)),
+            worktree_root,
+        }));
+        let executor = cx.background_executor().clone();
+        let task = cx.background_executor().spawn({
+            let state = state.clone();
+            async move {
+                let (events, watcher) = fs.watch(&epic_dir, WATCH_LATENCY).await;
+                // Fused: the drain below may see the end, and the loop then polls once more.
+                let mut events = events.fuse();
+                let mut areas = Vec::new();
+                for area in AREAS {
+                    let path = epic_dir.join(area);
+                    // A missing area is not a failure: it arrives later through `sync_dirs`.
+                    // A symlinked area is never watched: it would point outside `.epic`.
+                    if matches!(
+                        fs.metadata(&path).await,
+                        Ok(Some(metadata)) if metadata.is_dir && !metadata.is_symlink
+                    ) {
+                        areas.push(path);
+                    }
+                }
+                let failure = {
+                    let mut state = state.lock();
+                    state.watcher = Some(watcher);
+                    let wanted = state.wanted.clone();
+                    state.add_missing(areas.iter().chain(wanted.iter()))
+                };
+                report(failure);
+
+                while let Some(batch) = events.next().await {
+                    state.lock().forget_stale(&batch);
+                    executor.timer(DEBOUNCE).await;
+                    // Whatever arrived during the window is covered by the one rescan below.
+                    while let Some(Some(batch)) = events.next().now_or_never() {
+                        state.lock().forget_stale(&batch);
+                    }
+                    on_change();
+                }
+                let failure = state.lock().take_failure("the watch ended".to_string());
+                report(failure);
+            }
+        });
+        Self { _task: task, state }
+    }
+
+    /// `dirs` replaces the wanted set: the areas that exist now plus every story directory.
+    /// Whatever is not yet added is added at once when the watcher exists, or by the task as
+    /// soon as it does. A directory that left the set is forgotten, so it is added again if it
+    /// returns (the watcher re-arms a stale registration).
+    pub fn sync_dirs(&self, dirs: &[PathBuf]) {
+        let failure = {
+            let mut state = self.state.lock();
+            state.wanted = dirs.to_vec();
+            let wanted: HashSet<&PathBuf> = dirs.iter().collect();
+            state.added.retain(|path| wanted.contains(path));
+            state.add_missing(dirs.iter())
+        };
+        report(failure);
+    }
+}
+
+/// Runs outside the state lock, so the callback may call back into `EpicWatch`.
+fn report(failure: Option<Failure>) {
+    if let Some((on_failure, reason)) = failure {
+        on_failure(reason);
+    }
+}
+
+impl WatchState {
+    /// A directory that was removed or created may have lost its inotify registration (the
+    /// kernel drops it on removal), so it is forgotten here and the next `sync_dirs` after the
+    /// rescan adds it again. A rescan event means anything may be stale.
+    fn forget_stale(&mut self, batch: &[PathEvent]) {
+        for event in batch {
+            match event.kind {
+                Some(PathEventKind::Rescan) => self.added.clear(),
+                Some(PathEventKind::Removed | PathEventKind::Created) => {
+                    self.added.remove(&event.path);
+                }
+                _ => {}
+            }
+        }
+    }
+
+    /// Adds every path not yet added. The first `add` error takes `on_failure` and is returned
+    /// with its reason; later ones are not reported again, and adding carries on.
+    fn add_missing<'a>(&mut self, paths: impl Iterator<Item = &'a PathBuf>) -> Option<Failure> {
+        let watcher = self.watcher.clone()?;
+        let mut failure = None;
+        for path in paths {
+            if !self.added.insert(path.clone()) {
+                continue;
+            }
+            if let Err(error) = watcher.add(path) {
+                let reason = format!(
+                    "could not watch {}: {}",
+                    self.relative(path),
+                    self.redact(&error.to_string())
+                );
+                if failure.is_none() {
+                    failure = self.take_failure(reason);
+                }
+            }
+        }
+        failure
+    }
+
+    fn take_failure(&mut self, reason: String) -> Option<Failure> {
+        self.on_failure
+            .take()
+            .map(|on_failure| (on_failure, reason))
+    }
+
+    fn relative(&self, path: &Path) -> String {
+        match path.strip_prefix(&self.worktree_root) {
+            Ok(relative) => relative.display().to_string(),
+            Err(_) => path
+                .file_name()
+                .map(|name| name.to_string_lossy().into_owned())
+                .unwrap_or_default(),
+        }
+    }
+
+    /// Error texts from the watcher backend can name absolute paths; reasons are shown and
+    /// logged worktree-relative (R8.4).
+    fn redact(&self, text: &str) -> String {
+        let root = self.worktree_root.display().to_string();
+        if root.is_empty() {
+            return text.to_string();
+        }
+        let prefix = if root.ends_with(MAIN_SEPARATOR_STR) {
+            root
+        } else {
+            format!("{root}{MAIN_SEPARATOR_STR}")
+        };
+        text.replace(&prefix, "")
+    }
+}
+
