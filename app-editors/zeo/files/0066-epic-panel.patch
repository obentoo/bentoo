+// Story 042, task 2.2 — the checkbox census (R4.1, R4.2).
+//
+// Mounted from `src/format.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "format_census_tests.rs"]
+//     mod census_tests;
+//
+// so the Validation filter `cargo test -p epic_panel format::census` selects this file.
+//
+// Oracle: epic-index.sh `census` (lines 385-416):
+//   box_re      ^[[:space:]]*- \[([ x~])\]
+//   deferred_re (^|[^[:alnum:]_-])deferred:
+//   terminal_re (^|[^[:alnum:]_-])(waived|n-a|superseded-by):
+// `[x]` closed; `[~]` + deferred: -> deferred (wins over a terminal qualifier); `[~]` + a
+// terminal qualifier alone -> closed; any other `[~]` counts in the total only. No fence
+// handling (Assumption A7).
+
+use super::*;
+
+fn c(total: u32, closed: u32, deferred: u32) -> Census {
+    Census {
+        total,
+        closed,
+        deferred,
+    }
+}
+
+#[test]
+fn census_counts_the_three_box_states() {
+    let text = "- [ ] open\n- [x] closed\n- [~] owed (deferred: later)\n";
+    assert_eq!(census(text), c(3, 1, 1));
+}
+
+#[test]
+fn census_of_empty_text_is_zero() {
+    assert_eq!(census(""), c(0, 0, 0));
+    assert_eq!(census("# Plan\n\nNo boxes here.\n"), c(0, 0, 0));
+}
+
+// Hostile half: lines that resemble a box and are not one.
+#[test]
+fn census_refuses_lines_that_only_resemble_a_box() {
+    for line in [
+        "- [X] uppercase is not a box",
+        "-  [x] two spaces",
+        "-[x] no space",
+        "* [x] star bullet",
+        "+ [x] plus bullet",
+        "1. [x] numbered",
+        "- [xx] two marks",
+        "- [] empty",
+        "- [-] dash",
+        "text - [x] not at the start",
+        "    - ToDo: close as `[~] (deferred: …)` naming the missing piece.",
+    ] {
+        assert_eq!(census(line), c(0, 0, 0), "{line:?}");
+    }
+}
+
+// Converse: differently-indented boxes are still boxes.
+#[test]
+fn census_counts_indented_boxes() {
+    let text = "  - [x] two spaces\n\t- [x] a tab\n    \t  - [ ] mixed\n- [x] none";
+    assert_eq!(census(text), c(4, 3, 0));
+}
+
+#[test]
+fn census_counts_boxes_inside_fenced_code_blocks() {
+    let text = "```markdown\n- [x] in a fence\n- [ ] also\n```\n- [x] outside\n";
+    assert_eq!(
+        census(text),
+        c(3, 2, 0),
+        "A7: the plugin does not skip fences"
+    );
+}
+
+#[test]
+fn census_counts_a_last_line_without_newline_and_crlf_lines() {
+    assert_eq!(census("- [x] a\r\n- [ ] b\r\n- [x] c"), c(3, 2, 0));
+}
+
+#[test]
+fn census_each_terminal_qualifier_closes_a_tilde_box() {
+    for line in [
+        "- [~] 1.1 - x (waived: not needed)",
+        "- [~] 1.1 - x (n-a: no UI)",
+        "- [~] 1.1 - x (superseded-by: 044)",
+        "- [~] waived: at the start of the text",
+    ] {
+        assert_eq!(census(line), c(1, 1, 0), "{line:?}");
+    }
+}
+
+#[test]
+fn census_deferred_wins_over_a_terminal_qualifier() {
+    assert_eq!(census("- [~] x (waived: a; deferred: b)"), c(1, 0, 1));
+    assert_eq!(census("- [~] x (deferred: b; n-a: a)"), c(1, 0, 1));
+}
+
+#[test]
+fn census_unqualified_tilde_counts_in_the_total_only() {
+    assert_eq!(census("- [~] no qualifier at all"), c(1, 0, 0));
+    assert_eq!(census("- [~] deferred without a colon"), c(1, 0, 0));
+}
+
+// Hostile half for qualifier identity: words that END in a qualifier are not the qualifier.
+#[test]
+fn census_qualifiers_need_a_word_boundary_before_them() {
+    for line in [
+        "- [~] x (man-a: not n-a)",
+        "- [~] x (undeferred: no)",
+        "- [~] x (pre-deferred: no)",
+        "- [~] x (re_deferred: no)",
+        "- [~] x (unwaived: no)",
+        "- [~] x (not-superseded-by: no)",
+        "- [~] x (x-n-a: no)",
+        "- [~] x (N-A: case matters)",
+        "- [~] x (Deferred: case matters)",
+    ] {
+        assert_eq!(
+            census(line),
+            c(1, 0, 0),
+            "{line:?} counts in the total only"
+        );
+    }
+}
+
+// Converse: punctuation, spaces and tabs ARE boundaries.
+#[test]
+fn census_qualifiers_after_punctuation_or_space_count() {
+    assert_eq!(census("- [~] x (deferred: a)"), c(1, 0, 1));
+    assert_eq!(census("- [~] x\tdeferred: a"), c(1, 0, 1));
+    assert_eq!(census("- [~] x,n-a: a"), c(1, 1, 0));
+    assert_eq!(census("- [~] x.waived: a"), c(1, 1, 0));
+}
+
+#[test]
+fn census_qualifiers_only_matter_on_a_tilde_box() {
+    assert_eq!(census("- [x] done (deferred: still closed)"), c(1, 1, 0));
+    assert_eq!(census("- [ ] open (waived: still open)"), c(1, 0, 0));
+}
+
+#[test]
+fn census_of_a_real_corpus_deferred_line() {
+    // .epico/archive/024-tasks-panel-opens-thread-in-its-project-window/tasks.md:108, shortened.
+    let text = "  - [~] 5.2 - Replay the report in a running Zeo (deferred: the Xvfb harness has no window manager)\n- [x] 5.1 - done\n";
+    assert_eq!(census(text), c(2, 1, 1));
+}
diff --git a/crates/epic_panel/src/format_dir_tests.rs b/crates/epic_panel/src/format_dir_tests.rs
new file mode 100644
index 0000000..3f58e75
--- /dev/null
+++ b/crates/epic_panel/src/format_dir_tests.rs
@@ -0,0 +1,82 @@
+// Story 042, task 2.1 — story directory names and the numeric key (R2.2).
+//
+// Mounted from `src/format.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "format_dir_tests.rs"]
+//     mod dir_tests;
+//
+// so the Validation filter `cargo test -p epic_panel format::dir` selects this file.
+//
+// Oracle: epic-index.sh `scan_area` (`^([0-9]+)-(.+)$` under LC_ALL=C, so `[0-9]` is ASCII
+// only) and `strip_zeros` (pure string work, never an integer: a 20-digit name must not wrap).
+
+use super::*;
+
+#[test]
+fn split_dir_name_splits_number_and_slug() {
+    assert_eq!(
+        split_dir_name("042-epic-panel-read-only"),
+        (Some("042"), "epic-panel-read-only")
+    );
+    assert_eq!(split_dir_name("7-x"), (Some("7"), "x"));
+    assert_eq!(split_dir_name("0099-c"), (Some("0099"), "c"));
+    // The number is the leading digit run; everything after the FIRST hyphen is the slug.
+    assert_eq!(split_dir_name("1-2-3"), (Some("1"), "2-3"));
+    assert_eq!(split_dir_name("12-café"), (Some("12"), "café"));
+}
+
+// Hostile half: names that look numbered but are not `NNN-slug`.
+#[test]
+fn split_dir_name_refuses_names_that_only_look_numbered() {
+    for name in [
+        "042",    // no slug
+        "042-",   // empty slug
+        "-042-x", // no leading digit
+        "abc-1",  // letters first
+        "v2-x", "4a-x",   // digits then a letter before the hyphen
+        "١٢-x",   // Arabic-Indic digits are not [0-9] under LC_ALL=C
+        "１２-x", // fullwidth digits neither
+        "",
+    ] {
+        assert_eq!(split_dir_name(name), (None, ""), "{name:?}");
+    }
+}
+
+#[test]
+fn split_dir_name_keeps_the_number_as_written() {
+    // The panel shows "007", like EPICO.md's `${dir%%-*}`; stripping is for comparison only.
+    assert_eq!(split_dir_name("007-bond").0, Some("007"));
+}
+
+#[test]
+fn strip_zeros_matches_the_plugin() {
+    assert_eq!(strip_zeros("007"), "7");
+    assert_eq!(strip_zeros("000"), "0");
+    assert_eq!(strip_zeros("0"), "0");
+    assert_eq!(strip_zeros("10"), "10");
+    assert_eq!(strip_zeros("100"), "100");
+    assert_eq!(strip_zeros("0099"), "99");
+}
+
+// Hostile half for "never parse into an integer": inputs that overflow u64/u128 or read as
+// octal in bash arithmetic must come back as digit strings, unchanged in value.
+#[test]
+fn strip_zeros_never_wraps_or_reads_octal() {
+    assert_eq!(strip_zeros("00000000000000000000123"), "123");
+    assert_eq!(
+        strip_zeros("99999999999999999999999999999999999999999"),
+        "99999999999999999999999999999999999999999"
+    );
+    assert_eq!(strip_zeros("0008"), "8");
+    assert_eq!(strip_zeros("0010"), "10");
+}
+
+// Converse: the strip must not split one number into two, nor collapse two into one.
+#[test]
+fn strip_zeros_keeps_distinct_numbers_distinct() {
+    assert_ne!(strip_zeros("12"), strip_zeros("120"));
+    assert_ne!(strip_zeros("1"), strip_zeros("10"));
+    assert_eq!(strip_zeros("012"), strip_zeros("12"));
+    assert_eq!(strip_zeros("0012"), strip_zeros("012"));
+}
diff --git a/crates/epic_panel/src/format_front_tests.rs b/crates/epic_panel/src/format_front_tests.rs
new file mode 100644
index 0000000..4bc6e88
--- /dev/null
+++ b/crates/epic_panel/src/format_front_tests.rs
@@ -0,0 +1,293 @@
+// Story 042, task 2.1 — the frontmatter reader and the title (R3.2, R3.3, R6.4, R2.9).
+//
+// Mounted from `src/format.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "format_front_tests.rs"]
+//     mod front_tests;
+//
+// so every test path reads `format::front_tests::…` and the Validation filter
+// `cargo test -p epic_panel format::front` selects exactly this file.
+//
+// Oracle: epic plugin 0.13.1 `scripts/epico-index.sh`, `front_value` (lines 316-357). Every
+// expectation below is what that function prints for the same bytes; where the plugin's
+// behaviour looks odd, the test pins the oddity on purpose (design.md, Assumption A7).
+
+use super::*;
+
+fn value<'a>(text: &'a str, key: &str) -> Option<String> {
+    front_value(text, key).map(|value| value.into_owned())
+}
+
+fn fm(body: &str) -> String {
+    format!("---\n{body}\n---\n# Story - Title\n")
+}
+
+// ── the key: column 0, then a colon ─────────────────────────────────────────
+
+// Hostile half first: near-identical keys that are NOT `status` must never be read as it.
+#[test]
+fn front_value_refuses_keys_that_only_start_like_the_key() {
+    for line in [
+        "statusx: done",
+        "status_x: done",
+        "status-x: done",
+        "review_status: done",
+        "  status: done",
+        "\tstatus: done",
+        "- status: done",
+        "status : done",
+        "Status: done",
+    ] {
+        assert_eq!(
+            value(&fm(line), "status"),
+            None,
+            "`{line}` must not be read as the `status` key"
+        );
+    }
+}
+
+// Converse: differently-shaped lines that ARE the key must be read.
+#[test]
+fn front_value_reads_the_key_however_its_value_is_spaced() {
+    for (line, expected) in [
+        ("status:done", "done"),
+        ("status: done", "done"),
+        ("status:    done   ", "done"),
+        ("status:\tdone\t", "done"),
+    ] {
+        assert_eq!(
+            value(&fm(line), "status").as_deref(),
+            Some(expected),
+            "`{line}`"
+        );
+    }
+}
+
+#[test]
+fn front_value_reads_a_hyphenated_key_and_not_its_longer_neighbour() {
+    assert_eq!(
+        value(&fm("superseded-by: 7"), "superseded-by").as_deref(),
+        Some("7")
+    );
+    assert_eq!(value(&fm("superseded-byx: 7"), "superseded-by"), None);
+    assert_eq!(
+        value(&fm("superseded-by: 7"), "superseded"),
+        None,
+        "`superseded` is not a prefix match of `superseded-by:` (the colon is part of the key)"
+    );
+}
+
+#[test]
+fn front_value_first_match_wins() {
+    assert_eq!(
+        value(&fm("status: draft\nstatus: done"), "status").as_deref(),
+        Some("draft")
+    );
+}
+
+// The plugin marks the key found on its first match even when the value is empty, and then
+// rejects the empty value: a later non-empty line does NOT rescue it.
+#[test]
+fn front_value_an_empty_first_match_hides_a_later_value() {
+    assert_eq!(value(&fm("status:\nstatus: done"), "status"), None);
+    assert_eq!(value(&fm("status:   \nstatus: done"), "status"), None);
+}
+
+#[test]
+fn front_value_empty_value_is_absent() {
+    assert_eq!(value(&fm("status:"), "status"), None);
+    assert_eq!(value(&fm("status:    "), "status"), None);
+    assert_eq!(value(&fm("status: \"\""), "status"), None);
+    assert_eq!(value(&fm("status: ''"), "status"), None);
+}
+
+#[test]
+fn front_value_ignores_keys_it_was_not_asked_for() {
+    let text =
+        fm("history:\n  - 2026-10-10: a: b\t|c\nweird line without colon\nstatus: done\nextra: x");
+    assert_eq!(value(&text, "status").as_deref(), Some("done"));
+    assert_eq!(value(&text, "scale"), None);
+}
+
+// ── quotes and comments ─────────────────────────────────────────────────────
+
+#[test]
+fn front_value_strips_one_pair_of_matching_quotes_and_keeps_the_inside_verbatim() {
+    for (line, expected) in [
+        ("status: \"done\"", "done"),
+        ("status: 'done'", "done"),
+        ("status: \"a # b\"", "a # b"),
+        ("status: ' padded '", " padded "),
+        ("status: \"\"done\"\"", "\"done\""),
+    ] {
+        assert_eq!(
+            value(&fm(line), "status").as_deref(),
+            Some(expected),
+            "`{line}`"
+        );
+    }
+}
+
+#[test]
+fn front_value_leaves_unmatched_quotes_alone() {
+    for (line, expected) in [
+        ("status: \"done'", "\"done'"),
+        ("status: \"done", "\"done"),
+        ("status: \"", "\""),
+        ("status: done\"", "done\""),
+    ] {
+        assert_eq!(
+            value(&fm(line), "status").as_deref(),
+            Some(expected),
+            "`{line}`"
+        );
+    }
+}
+
+// Hostile half: only a SPACE then `#` starts a comment, so `#` glued to the value stays.
+#[test]
+fn front_value_keeps_a_hash_that_does_not_start_a_comment() {
+    assert_eq!(
+        value(&fm("status: done#closed"), "status").as_deref(),
+        Some("done#closed")
+    );
+    assert_eq!(
+        value(&fm("superseded-by: 12#x"), "superseded-by").as_deref(),
+        Some("12#x")
+    );
+}
+
+#[test]
+fn front_value_cuts_an_unquoted_value_at_a_space_hash_comment() {
+    for (line, expected) in [
+        ("status: done # closed early", "done"),
+        ("status: done   # closed early", "done"),
+        ("status: in-progress # a # b", "in-progress"),
+    ] {
+        assert_eq!(
+            value(&fm(line), "status").as_deref(),
+            Some(expected),
+            "`{line}`"
+        );
+    }
+}
+
+#[test]
+fn front_value_a_value_that_starts_with_a_hash_is_empty() {
+    assert_eq!(value(&fm("status: # nothing yet"), "status"), None);
+    assert_eq!(value(&fm("status: #done"), "status"), None);
+}
+
+// ── the block: opens on line 1, must close ──────────────────────────────────
+
+#[test]
+fn front_value_requires_the_first_line_to_be_exactly_three_dashes() {
+    for text in [
+        "\n---\nstatus: done\n---\n",
+        "# Title\n---\nstatus: done\n---\n",
+        " ---\nstatus: done\n---\n",
+        "--- \nstatus: done\n---\n",
+        "----\nstatus: done\n---\n",
+        "status: done\n",
+        "",
+    ] {
+        assert_eq!(value(text, "status"), None, "{text:?}");
+    }
+}
+
+#[test]
+fn front_value_unterminated_block_makes_every_key_absent() {
+    assert_eq!(value("---\nstatus: done\nscale: spike\n", "status"), None);
+    assert_eq!(value("---\nstatus: done\nscale: spike", "scale"), None);
+    assert_eq!(value("---\n", "status"), None);
+    // `--- ` (trailing space) and `----` do not close the block either.
+    assert_eq!(value("---\nstatus: done\n--- \nbody\n", "status"), None);
+    assert_eq!(value("---\nstatus: done\n----\nbody\n", "status"), None);
+}
+
+#[test]
+fn front_value_never_reads_below_the_closing_line() {
+    assert_eq!(
+        value("---\ntype: feature\n---\nstatus: done\n", "status"),
+        None
+    );
+}
+
+#[test]
+fn front_value_closing_line_without_trailing_newline_still_closes() {
+    assert_eq!(
+        value("---\nstatus: done\n---", "status").as_deref(),
+        Some("done")
+    );
+}
+
+#[test]
+fn front_value_tolerates_crlf() {
+    let text = "---\r\nstatus: done\r\nscale: \"spike\"\r\n---\r\n# Story - X\r\n";
+    assert_eq!(value(text, "status").as_deref(), Some("done"));
+    assert_eq!(value(text, "scale").as_deref(), Some("spike"));
+}
+
+#[test]
+fn front_value_reads_a_real_corpus_header() {
+    // .epico/archive/006-measure-the-resumed-load-path/tasks.md, first 9 lines.
+    let text = "---\nstory: measure-the-resumed-load-path\ntype: feature\nscale: spike\nversion: 1\ncreated: 2026-09-05\nstatus: archived\n---\n\n# Implementation Plan - Measure the resumed load path\n";
+    assert_eq!(value(text, "scale").as_deref(), Some("spike"));
+    assert_eq!(value(text, "status").as_deref(), Some("archived"));
+    assert_eq!(value(text, "type").as_deref(), Some("feature"));
+    assert_eq!(value(text, "engineering"), None);
+}
+
+#[test]
+fn front_value_borrows_when_it_does_not_need_to_allocate() {
+    let text = fm("status: done");
+    assert!(matches!(
+        front_value(&text, "status"),
+        Some(Cow::Borrowed("done"))
+    ));
+}
+
+// ── title (R2.9) ────────────────────────────────────────────────────────────
+
+#[test]
+fn title_strips_the_plugin_prefixes() {
+    assert_eq!(title("# Story - A panel\n"), Some("A panel"));
+    assert_eq!(title("# Implementation Plan - A panel\n"), Some("A panel"));
+    assert_eq!(title("# Design - A panel\n"), Some("A panel"));
+    assert_eq!(title("# A panel\n"), Some("A panel"));
+}
+
+// Hostile half: words that merely contain a prefix are not stripped.
+#[test]
+fn title_keeps_text_that_only_resembles_a_prefix() {
+    assert_eq!(
+        title("# Storytelling - tips\n"),
+        Some("Storytelling - tips")
+    );
+    assert_eq!(title("# A Story - told\n"), Some("A Story - told"));
+    assert_eq!(title("# Story-less\n"), Some("Story-less"));
+    assert_eq!(title("# Designer - notes\n"), Some("Designer - notes"));
+}
+
+#[test]
+fn title_skips_a_hash_line_inside_the_frontmatter() {
+    let text = "---\n# a yaml comment\nstatus: done\n---\n\n# Story - The real title\n";
+    assert_eq!(title(text), Some("The real title"));
+}
+
+#[test]
+fn title_takes_the_first_level_one_heading_only() {
+    assert_eq!(
+        title("## Overview\n#NoSpace\n# Story - First\n# Second\n"),
+        Some("First")
+    );
+    assert_eq!(title("## Only deeper\n### headings\n"), None);
+    assert_eq!(title(""), None);
+}
+
+#[test]
+fn title_of_a_real_corpus_file() {
+    let text = "---\nstory: measure-the-resumed-load-path\nscale: spike\nstatus: archived\n---\n\n# Implementation Plan - Measure the resumed load path\n\n## Overview\n";
+    assert_eq!(title(text), Some("Measure the resumed load path"));
+}
diff --git a/crates/epic_panel/src/format_verdict_tests.rs b/crates/epic_panel/src/format_verdict_tests.rs
new file mode 100644
index 0000000..622001d
--- /dev/null
+++ b/crates/epic_panel/src/format_verdict_tests.rs
@@ -0,0 +1,208 @@
+// Story 042, task 2.2 — the spike `## Verdict` section (R3.4).
+//
+// Mounted from `src/format.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "format_verdict_tests.rs"]
+//     mod verdict_tests;
+//
+// so the Validation filter `cargo test -p epic_panel format::verdict` selects this file.
+//
+// Oracle: epic-index.sh `parse_verdict` (lines 443-468):
+//   heading_re  ^#{2,}[[:space:]]                         (any ##+ heading ends a section)
+//   verdict_re  ^#{2,}[[:space:]]+[Vv]erdict([[:space:]].*)?$
+//   status_re   ^[[:space:]]*(-[[:space:]]+)?status:[[:space:]]*([^[:space:]|]+)
+//   promoted_re ^[[:space:]]*(-[[:space:]]+)?promoted-to:[[:space:]]*([0-9][^[:space:]#]*)
+// Only the first MATCH of each key inside a verdict section is kept. A line that does not
+// match (an empty `status:`, a `promoted-to: NNN`) does not consume the slot.
+
+use super::*;
+
+fn v(status: Option<&str>, promoted_to: Option<&str>) -> Verdict {
+    Verdict {
+        status: status.map(str::to_string),
+        promoted_to: promoted_to.map(str::to_string),
+    }
+}
+
+#[test]
+fn verdict_reads_status_and_target() {
+    let text =
+        "# Plan\n\n## Verdict\n- status: promote\n- conclusion: worth it\n- promoted-to: 044\n";
+    assert_eq!(parse_verdict(text), v(Some("promote"), Some("044")));
+}
+
+#[test]
+fn verdict_absent_section_is_empty() {
+    assert_eq!(parse_verdict(""), v(None, None));
+    assert_eq!(
+        parse_verdict("## Overview\n- status: open\n"),
+        v(None, None)
+    );
+}
+
+// Hostile half first: a `status:` outside the section — above all the frontmatter's
+// lifecycle status — must never be read as the verdict.
+#[test]
+fn verdict_never_reads_a_status_outside_the_section() {
+    let text = "---\nscale: spike\nstatus: done\n---\n\n# Plan\n- status: open\n\n## Verdict\n- conclusion: none yet\n";
+    assert_eq!(parse_verdict(text), v(None, None));
+}
+
+#[test]
+fn verdict_heading_variants_that_open_the_section() {
+    for heading in [
+        "## Verdict",
+        "## verdict",
+        "### Verdict",
+        "#### verdict",
+        "## Verdict (2026-10-01)",
+        "##  Verdict",
+        "##\tVerdict",
+        "## Verdict ",
+    ] {
+        let text = format!("{heading}\n- status: wont-do\n");
+        assert_eq!(
+            parse_verdict(&text),
+            v(Some("wont-do"), None),
+            "{heading:?}"
+        );
+    }
+}
+
+// Hostile half: headings that look like a verdict heading and are not.
+#[test]
+fn verdict_heading_lookalikes_do_not_open_the_section() {
+    for heading in [
+        "## Verdict:",
+        "## Verdicts",
+        "## VERDICT",
+        "## The Verdict",
+        "# Verdict",
+        "##Verdict",
+        "Verdict",
+        "**Verdict**",
+    ] {
+        let text = format!("{heading}\n- status: wont-do\n");
+        assert_eq!(parse_verdict(&text), v(None, None), "{heading:?}");
+    }
+}
+
+#[test]
+fn verdict_section_ends_at_the_next_level_two_or_deeper_heading() {
+    let text = "## Verdict\n- conclusion: x\n## Notes\n- status: promote\n";
+    assert_eq!(parse_verdict(text), v(None, None));
+    let text = "## Verdict\n- conclusion: x\n### Sub\n- status: promote\n";
+    assert_eq!(parse_verdict(text), v(None, None));
+}
+
+#[test]
+fn verdict_a_level_one_heading_does_not_end_the_section() {
+    let text = "## Verdict\n# Aside\n- status: open\n";
+    assert_eq!(parse_verdict(text), v(Some("open"), None));
+}
+
+#[test]
+fn verdict_a_later_verdict_section_fills_what_the_first_lacked() {
+    let text = "## Verdict\n- conclusion: x\n## Notes\n- status: no\n## Verdict\n- status: promote\n- promoted-to: 12\n";
+    assert_eq!(parse_verdict(text), v(Some("promote"), Some("12")));
+}
+
+#[test]
+fn verdict_status_is_cut_at_whitespace_or_pipe() {
+    // The template line itself: the first alternative is what is read.
+    assert_eq!(
+        parse_verdict("## Verdict\n- status: open | promote | wont-do\n"),
+        v(Some("open"), None)
+    );
+    assert_eq!(
+        parse_verdict("## Verdict\n- status: promote|x\n"),
+        v(Some("promote"), None)
+    );
+    assert_eq!(
+        parse_verdict("## Verdict\n- status: wont-do (decided)\n"),
+        v(Some("wont-do"), None)
+    );
+}
+
+#[test]
+fn verdict_status_line_shapes() {
+    for line in [
+        "status: open",
+        "- status: open",
+        "  - status:open",
+        "\t-\tstatus:   open",
+    ] {
+        let text = format!("## Verdict\n{line}\n");
+        assert_eq!(parse_verdict(&text), v(Some("open"), None), "{line:?}");
+    }
+    for line in [
+        "- substatus: open",
+        "- **status**: open",
+        "* status: open",
+        "-status: open",
+    ] {
+        let text = format!("## Verdict\n{line}\n");
+        assert_eq!(parse_verdict(&text), v(None, None), "{line:?}");
+    }
+}
+
+#[test]
+fn verdict_first_status_wins() {
+    let text = "## Verdict\n- status: open\n- status: promote\n";
+    assert_eq!(parse_verdict(text), v(Some("open"), None));
+}
+
+// Contrast with front_value: an empty `status:` does not match status_re, so it does not take
+// the slot, and the next status line is read.
+#[test]
+fn verdict_an_empty_status_line_does_not_take_the_slot() {
+    let text = "## Verdict\n- status:\n- status: promote\n";
+    assert_eq!(parse_verdict(text), v(Some("promote"), None));
+}
+
+// Hostile half: the template placeholder is not a recorded target, and does not take the slot.
+#[test]
+fn verdict_promoted_to_must_start_with_a_digit() {
+    assert_eq!(
+        parse_verdict("## Verdict\n- status: promote\n- promoted-to: NNN\n"),
+        v(Some("promote"), None)
+    );
+    assert_eq!(
+        parse_verdict(
+            "## Verdict\n- status: promote\n- promoted-to: NNN   # required\n- promoted-to: 7\n"
+        ),
+        v(Some("promote"), Some("7"))
+    );
+    assert_eq!(
+        parse_verdict("## Verdict\n- status: promote\n- promoted-to: #12\n"),
+        v(Some("promote"), None)
+    );
+}
+
+#[test]
+fn verdict_promoted_to_is_cut_at_whitespace_or_hash() {
+    assert_eq!(
+        parse_verdict("## Verdict\n- promoted-to: 012#note\n- status: promote\n"),
+        v(Some("promote"), Some("012"))
+    );
+    assert_eq!(
+        parse_verdict("## Verdict\n- promoted-to: 12-foo bar\n"),
+        v(None, Some("12-foo"))
+    );
+    assert_eq!(
+        parse_verdict("## Verdict\n- promoted-to: 12|x\n"),
+        v(None, Some("12|x")),
+        "unlike status, a pipe does not end promoted-to"
+    );
+}
+
+#[test]
+fn verdict_of_real_corpus_sections() {
+    // .epico/archive/006-measure-the-resumed-load-path/tasks.md:162-164
+    let text = "## Verdict\n- status: open\n- conclusion: not yet measured\n";
+    assert_eq!(parse_verdict(text), v(Some("open"), None));
+    // .epico/archive/030-deleted-task-record-survives-restart/tasks.md:62-63, conclusion shortened.
+    let text = "## Verdict\n- status: wont-do\n- conclusion: The record does not come back in practice. status: promote | open\n";
+    assert_eq!(parse_verdict(text), v(Some("wont-do"), None));
+}
