+/// `panel_live_tests::parses_as_key_values`, copied verbatim: it is private to that frozen
+/// module, so it cannot be called from here.
+fn frozen_parser(mut rest: &str) -> bool {
+    loop {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            return true;
+        }
+        let Some(eq) = rest.find('=') else {
+            return false;
+        };
+        let key = &rest[..eq];
+        if key.is_empty() || !key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            return false;
+        }
+        rest = &rest[eq + 1..];
+        if let Some(quoted) = rest.strip_prefix('"') {
+            let Some(end) = quoted.find('"') else {
+                return false;
+            };
+            rest = &quoted[end + 1..];
+        } else {
+            let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+            rest = &rest[end..];
+        }
+    }
+}
+
+/// A logfmt reader that honours the escapes `log_value` writes (`\"`, `\\`, `\u{..}`) and
+/// returns the decoded pairs; `None` when the line is not key=value.
+fn decode_key_values(mut rest: &str) -> Option<Vec<(String, String)>> {
+    let mut pairs = Vec::new();
+    loop {
+        rest = rest.trim_start_matches(' ');
+        if rest.is_empty() {
+            return Some(pairs);
+        }
+        let eq = rest.find('=')?;
+        let key = &rest[..eq];
+        if key.is_empty() || !key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            return None;
+        }
+        rest = &rest[eq + 1..];
+        let mut value = String::new();
+        if let Some(quoted) = rest.strip_prefix('"') {
+            let mut chars = quoted.char_indices();
+            let end = loop {
+                let (index, character) = chars.next()?;
+                match character {
+                    '"' => break index,
+                    '\\' => match chars.next()?.1 {
+                        '"' => value.push('"'),
+                        '\\' => value.push('\\'),
+                        'u' => {
+                            let (open, '{') = chars.next()? else {
+                                return None;
+                            };
+                            let close = quoted[open..].find('}')? + open;
+                            let code = u32::from_str_radix(&quoted[open + 1..close], 16).ok()?;
+                            value.push(char::from_u32(code)?);
+                            while chars.next()?.0 < close {}
+                        }
+                        _ => return None,
+                    },
+                    character => value.push(character),
+                }
+            };
+            rest = &quoted[end + 1..];
+        } else {
+            let end = rest.find(' ').unwrap_or(rest.len());
+            value.push_str(&rest[..end]);
+            rest = &rest[end..];
+        }
+        pairs.push((key.to_string(), value));
+    }
+}
+
+/// Unicode line terminators: none may appear raw in a log line.
+const LINE_BREAKS: [char; 7] = [
+    '\n', '\r', '\u{b}', '\u{c}', '\u{85}', '\u{2028}', '\u{2029}',
+];
+
+#[test]
+fn contract_log_value_writes_one_token_per_value() {
+    let cases: &[(&str, &str)] = &[
+        ("project", "project"),
+        ("001-a", "001-a"),
+        ("tasks.md", "tasks.md"),
+        // design.md: only a space, `=` or `"` needs quotes; a lone backslash stays bare.
+        ("a\\b", "a\\b"),
+        ("my project", "\"my project\""),
+        ("a=b", "\"a=b\""),
+        ("a\"b", "\"a\\u{22}b\""),
+        ("a \\b", "\"a \\u{5c}b\""),
+        ("a\u{a0}b", "\"a\\u{a0}b\""),
+        ("a\u{3000}b", "\"a\\u{3000}b\""),
+        ("a\u{2028}b", "\"a\\u{2028}b\""),
+        ("a\nb", "\"a\\u{a}b\""),
+        ("a\tb", "\"a\\u{9}b\""),
+        ("a\r\nevent=forged", "\"a\\u{d}\\u{a}event=forged\""),
+    ];
+    for (raw, expected) in cases {
+        let written = log_value(raw);
+        assert_eq!(&written, expected, "log_value({raw:?})");
+        assert!(
+            !written.contains(LINE_BREAKS),
+            "a raw line break in {written:?}"
+        );
+        let line = format!("event=problem story={written} file=tasks.md");
+        let decoded = decode_key_values(&line).unwrap_or_else(|| panic!("not key=value: {line:?}"));
+        assert_eq!(
+            decoded,
+            [
+                ("event".to_string(), "problem".to_string()),
+                ("story".to_string(), raw.to_string()),
+                ("file".to_string(), "tasks.md".to_string()),
+            ],
+            "one token that decodes back to {raw:?}: {line:?}"
+        );
+        // A quoted value holds no raw `"` (task 10.1), so the frozen parser reads every line.
+        assert!(frozen_parser(&line), "Q14 parser rejects {line:?}");
+    }
+}
