+        &[("/work/one", small_tree()), ("/work/two", small_tree())],
+        &["/work/one", "/work/two"],
+    )
+    .await;
+    assert_eq!(lines(&mut rig).len(), 4, "{:?}", lines(&mut rig));
+    assert_eq!(banner(&mut rig), None);
+}
diff --git a/crates/epic_panel/src/panel_fs_log_tests.rs b/crates/epic_panel/src/panel_fs_log_tests.rs
new file mode 100644
index 0000000..5bce402
--- /dev/null
+++ b/crates/epic_panel/src/panel_fs_log_tests.rs
@@ -0,0 +1,278 @@
+// Story 042, task 11.1 — a hostile symlink in `.epico/` puts no absolute path in any log line,
+// from any crate (R8.5, R8.4; Q5, Q14). Module path: `panel::panel_fs_log_tests`.
+//
+// Mounted from `src/panel.rs`, a child of `panel` like its siblings:
+//
+//     #[cfg(test)]
+//     #[path = "panel_fs_log_tests.rs"]
+//     #[rustfmt::skip]
+//     mod panel_fs_log_tests;
+//
+// The corpus is built with blocking standard-library calls on a real temp directory, which the
+// workspace's disallowed-methods list rejects; the allow is an inner attribute below, so the
+// mount needs nothing more than the three lines above.
+//
+// HOW EVERY LOG TARGET IS SEEN. The process has one logger, `panel_test_helpers`'
+// `CaptureLogger`, installed once by `capture_logs()`. It records every record from every
+// target (the `fs` crate's included) on the thread that logs it, but its only reader of raw
+// lines, `panel_lines()`, keeps the lines containing "epic_panel". A second logger cannot be
+// installed: there is one per process and the sibling tests race to own it. So this test makes
+// the filter irrelevant to what it forbids instead: the temp directory's own name starts with
+// `epic_panel-`, hence every line carrying its absolute path — whichever crate wrote it —
+// contains "epic_panel" and is read. The forbidden set is observed in full.
+//
+// LIVENESS. A capture that never sees the `fs` crate would pass this test silently. A story-area
+// entry that is itself a symlink loop is named `099-epic_panel-loop`, so the `fs` warn for it
+// contains "epic_panel" whether it names the path or only the file name; the test requires that
+// warn to be seen.
+
+#![cfg(unix)]
+#![allow(clippy::disallowed_methods)]
+
+use std::{
+    fs as stdfs,
+    os::unix::fs::PermissionsExt as _,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::Duration,
+};
+
+use gpui::TestAppContext;
+
+use super::panel_test_helpers::*;
+use super::row_badge;
+use crate::scan::RowProblem;
+
+const LOOP_STORY: &str = "001-loop";
+const LOCKED_STORY: &str = "002-locked";
+/// A story-area entry that is a symlink to itself: `fs` warns about it, and its name makes the
+/// warn visible to `panel_lines()` (see LIVENESS above).
+const LOOP_ENTRY: &str = "099-epic_panel-loop";
+/// The derived value the fix logs is a file name. A name may hold a newline, which written
+/// raw would forge a second log line; this one names a field the panel's parser reads.
+const FORGING_ENTRY: &str = "098-epic_panel-forge\nevent=scan worktree=x";
+
+fn write(path: &Path, content: &str) {
+    let parent = path.parent().expect("a file has a parent");
+    stdfs::create_dir_all(parent).unwrap_or_else(|e| panic!("create {}: {e}", parent.display()));
+    stdfs::write(path, content).unwrap_or_else(|e| panic!("write {}: {e}", path.display()));
+}
+
+fn symlink(target: &Path, link: &Path) {
+    std::os::unix::fs::symlink(target, link)
+        .unwrap_or_else(|e| panic!("symlink {} -> {}: {e}", link.display(), target.display()));
+}
+
+/// Gives a locked directory its permissions back, so the temp directory can be removed even
+/// when an assertion fails first.
+struct Unlock(PathBuf);
+
+impl Drop for Unlock {
+    fn drop(&mut self) {
+        let _ = stdfs::set_permissions(&self.0, stdfs::Permissions::from_mode(0o755));
+    }
+}
+
+struct Corpus {
+    project: PathBuf,
+    /// The absolute paths of every hostile link and of the locked target.
+    hostile: Vec<PathBuf>,
+    /// True when the locked target really errors (false when running as root).
+    locked_errors: bool,
+    _unlock: Unlock,
+}
+
+/// `<root>/project/.epico/stories/` with:
+///   - `001-loop`: a `story.md`, and a `tasks.md` that is a symlink to itself (a loop);
+///   - `002-locked`: a `story.md`, and a `tasks.md` that is a symlink, by absolute path, to a
+///     file inside a directory with mode 000 (the user may not read the target);
+///   - `099-epic_panel-loop` and the forging name: entries that are symlinks to themselves.
+/// Every link target is absolute, so the link text itself carries the temp path.
+fn build(root: &Path) -> Corpus {
+    let project = root.join("project");
+    write(&project.join(".gitignore"), ".epico/\n");
+    let stories = project.join(".epico/stories");
+    let story = |status: &str| fm(&[("status", status)], "# Story - Hostile link\n");
+
+    write(
+        &stories.join(LOOP_STORY).join("story.md"),
+        &story("in-progress"),
+    );
+    let loop_tasks = stories.join(LOOP_STORY).join("tasks.md");
+    symlink(&loop_tasks, &loop_tasks);
+
+    write(
+        &stories.join(LOCKED_STORY).join("story.md"),
+        &story("draft"),
+    );
+    let locked_dir = root.join("locked");
+    let locked_target = locked_dir.join("tasks.md");
+    write(&locked_target, "- [ ] hidden\n");
+    symlink(&locked_target, &stories.join(LOCKED_STORY).join("tasks.md"));
+    stdfs::set_permissions(&locked_dir, stdfs::Permissions::from_mode(0o000))
+        .unwrap_or_else(|e| panic!("chmod 000 {}: {e}", locked_dir.display()));
+    let unlock = Unlock(locked_dir);
+    let locked_errors = stdfs::metadata(&locked_target).is_err();
+
+    let mut hostile = vec![
+        loop_tasks,
+        stories.join(LOCKED_STORY).join("tasks.md"),
+        locked_target,
+    ];
+    for entry in [LOOP_ENTRY, FORGING_ENTRY] {
+        let link = stories.join(entry);
+        symlink(&link, &link);
+        hostile.push(link);
+    }
+
+    Corpus {
+        project,
+        hostile,
+        locked_errors,
+        _unlock: unlock,
+    }
+}
+
+fn find_line(rig: &mut Rig, dir_name: &str) -> bool {
+    find_row(rig, dir_name).is_some()
+}
+
+// R8.5, R8.4 — opening the panel on a story whose `tasks.md` is a symlink loop, and on one whose
+// target the user may not read, logs no line from any crate that carries an absolute path; the
+// stories still show their row problem.
+#[gpui::test]
+async fn panel_fs_log_hostile_symlinks_log_no_absolute_path(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    capture_logs();
+    init_test(cx);
+
+    let temp = tempfile::Builder::new()
+        .prefix("epic_panel-fs-log-")
+        .tempdir()
+        .expect("temp dir");
+    let corpus = build(temp.path());
+    let mut forbidden = vec![temp.path().to_string_lossy().into_owned()];
+    if let Ok(canonical) = stdfs::canonicalize(temp.path()) {
+        forbidden.push(canonical.to_string_lossy().into_owned());
+    }
+    for path in &forbidden {
+        assert!(
+            path.contains("epic_panel"),
+            "the capture sees this path only through its name: {path}"
+        );
+    }
+
+    let fs: Arc<dyn fs::Fs> = fs::RealFs::new(None, cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    let project = project::Project::test(fs.clone(), [corpus.project.as_path()], cx).await;
+    let window = cx
+        .add_window(|window, cx| workspace::MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi, _| multi.workspace().clone())
+        .expect("workspace");
+    let mut vcx = gpui::VisualTestContext::from_window(window.into(), cx);
+    let panel = load(&workspace, &mut vcx).await;
+    workspace.update_in(&mut vcx, |workspace, window, cx| {
+        workspace.add_panel(panel.clone(), window, cx)
+    });
+    vcx.run_until_parked();
+    let fake = fs::FakeFs::new(vcx.executor());
+    let mut rig = Rig {
+        fs: fake,
+        project,
+        workspace,
+        panel,
+        cx: vcx,
+    };
+
+    // Real I/O: give the scan real time rather than virtual time.
+    for _ in 0..100 {
+        if find_line(&mut rig, LOOP_STORY) && find_line(&mut rig, LOCKED_STORY) {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+        rig.cx.run_until_parked();
+    }
+    // Open the panel and read again, so later reads log too.
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    for _ in 0..10 {
+        std::thread::sleep(Duration::from_millis(50));
+        rig.cx.run_until_parked();
+    }
+
+    // The stories still show their row problem.
+    for dir_name in [LOOP_STORY, LOCKED_STORY] {
+        let row = find_row(&mut rig, dir_name)
+            .unwrap_or_else(|| panic!("{dir_name} is listed: {:?}", lines(&mut rig)));
+        assert_eq!(
+            row.problem,
+            Some(RowProblem::Symlink("tasks.md".to_string())),
+            "{dir_name}: {row:?}"
+        );
+        assert_eq!(row_badge(&row), Some("symlink not followed"), "{dir_name}");
+    }
+
+    let captured = panel_lines();
+
+    // Liveness: the `fs` crate's warn for the looping entry was captured, so the scan below
+    // looked at the `fs` crate's lines and not only the panel's.
+    assert!(
+        captured
+            .iter()
+            .any(|(level, line)| *level == log::Level::Warn
+                && line.contains(LOOP_ENTRY)
+                && !line.starts_with("epic_panel ")),
+        "the capture saw the fs crate's warn for the looping entry {LOOP_ENTRY:?}: {captured:#?}"
+    );
+
+    // R8.5, R8.4 — no line, from any target, at debug or above, carries the temp directory's
+    // absolute path. Trace is left out on purpose: the `fs` watcher and the git ancestor lookup
+    // trace every directory they watch or consider, by absolute path, in any project and with
+    // or without a symlink; that is upstream behaviour the symlink does not trigger, and trace
+    // is never on in a shipped build.
+    for (level, line) in &captured {
+        if *level == log::Level::Trace {
+            continue;
+        }
+        for path in &forbidden {
+            assert!(
+                !line.contains(path.as_str()),
+                "R8.5 a {level} line carries the absolute path {path:?}: {line}"
+            );
+        }
+    }
+
+    // R8.5 — at every level, trace included, no line names a hostile link or the locked target
+    // by absolute path (as written, or under the canonical temp directory).
+    let canonical_root = stdfs::canonicalize(temp.path()).ok();
+    for link in &corpus.hostile {
+        let mut spellings = vec![link.to_string_lossy().into_owned()];
+        if let (Some(root), Ok(rest)) = (&canonical_root, link.strip_prefix(temp.path())) {
+            spellings.push(root.join(rest).to_string_lossy().into_owned());
+        }
+        for (level, line) in &captured {
+            for spelling in &spellings {
+                assert!(
+                    !line.contains(spelling.as_str()),
+                    "R8.5 a {level} line names the hostile link {spelling:?}: {line}"
+                );
+            }
+        }
+    }
+
+    // The derived file name is written escaped: a name holding a newline forges no line.
+    for (level, line) in &captured {
+        assert!(
+            !line.contains('\n'),
+            "a {level} line holds a raw newline (forged line): {line:?}"
+        );
+    }
+
+    if !corpus.locked_errors {
+        eprintln!(
+            "panel_fs_log: the locked target was readable (running as root?); only the loop exercised the error path"
+        );
+    }
+    drop(rig);
+}
diff --git a/crates/epic_panel/src/panel_live_tests.rs b/crates/epic_panel/src/panel_live_tests.rs
new file mode 100644
index 0000000..c37aa42
--- /dev/null
+++ b/crates/epic_panel/src/panel_live_tests.rs
@@ -0,0 +1,474 @@
+// Story 042, task 5.4 — live updates, Refresh, the watch-failure banner and the logs (R5.1-R5.6,
+// R8.1-R8.4; Q14; R6.5 over a full panel session). Module path: `panel::panel_live_tests`.
+// See panel_test_helpers.rs for the assumed contract.
+
+use std::{path::Path, sync::Arc, time::Duration};
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+use ui::IconName;
+
+use super::panel_test_helpers::*;
+
+const SECRET: &str = "SECRET-CONTENT-MARKER-42";
+
+fn corpus() -> Value {
+    json!({
+        ".git": {},
+        ".gitignore": ".epico/\n",
+        ".epico": {
+            "stories": {
+                "001-a": {
+                    "story.md": fm(&[("status", "in-progress")], &format!("# Story - A\n{SECRET}\n")),
+                    "tasks.md": format!("- [ ] one\n- [ ] two\n{SECRET}\n"),
+                },
+                "002-b": { "story.md": fm(&[("status", "draft")], "") },
+            },
+            "archive": { "003-c": { "story.md": fm(&[("status", "archived")], "") } },
+        },
+    })
+}
+
+fn line_of(rig: &mut Rig, prefix: &str) -> Option<String> {
+    lines(rig).into_iter().find(|line| line.starts_with(prefix))
+}
+
+#[gpui::test]
+async fn panel_live_tasks_md_change_shows_within_two_seconds(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 0/2")
+    );
+    rig.fs
+        .insert_file(
+            "/work/project/.epico/stories/001-a/tasks.md",
+            b"- [x] one\n- [ ] two\n".to_vec(),
+        )
+        .await;
+    settle(&mut rig.cx);
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 1/2"),
+        "R5.1"
+    );
+
+    rig.fs
+        .insert_file(
+            "/work/project/.epico/stories/001-a/story.md",
+            fm(&[("status", "done")], "").into_bytes(),
+        )
+        .await;
+    settle(&mut rig.cx);
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | done | 1/2"),
+        "R5.1 status"
+    );
+}
+
+#[gpui::test]
+async fn panel_live_directories_added_moved_removed(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    rig.fs
+        .insert_tree(
+            "/work/project/.epico/stories/004-new",
+            json!({ "story.md": fm(&[("status", "draft")], "") }),
+        )
+        .await;
+    settle(&mut rig.cx);
+    assert!(
+        line_of(&mut rig, "004 new").is_some(),
+        "R5.2 added: {:?}",
+        lines(&mut rig)
+    );
+
+    rig.fs
+        .rename(
+            Path::new("/work/project/.epico/stories/002-b"),
+            Path::new("/work/project/.epico/archive/002-b"),
+            Default::default(),
+        )
+        .await
+        .expect("archive 002-b");
+    settle(&mut rig.cx);
+    assert!(
+        line_of(&mut rig, "002 b").is_none(),
+        "moved out of the active rows"
+    );
+    assert!(
+        line_of(&mut rig, "Archived (2)").is_some(),
+        "R5.2 moved: {:?}",
+        lines(&mut rig)
+    );
+
+    rig.fs
+        .remove_dir(
+            Path::new("/work/project/.epico/stories/004-new"),
+            fs::RemoveOptions {
+                recursive: true,
+                ignore_if_not_exists: false,
+            },
+        )
+        .await
+        .expect("remove 004-new");
+    settle(&mut rig.cx);
+    assert!(line_of(&mut rig, "004 new").is_none(), "R5.2 removed");
+}
+
+// R5.3 — a stream of changes costs at most one read per 500 ms (each read logs one
+// `event=scan` line, R8.1), and the last change still lands.
+#[gpui::test]
+async fn panel_live_rereads_at_most_once_per_half_second(cx: &mut TestAppContext) {
+    capture_logs();
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    let scans_before = events("scan").len();
+    for round in 0..20u32 {
+        let ticked = if round == 19 { "x" } else { " " };
+        rig.fs
+            .insert_file(
+                "/work/project/.epico/stories/001-a/tasks.md",
+                format!("- [{ticked}] one\n- [ ] two {round}\n").into_bytes(),
+            )
+            .await;
+        rig.cx.executor().advance_clock(Duration::from_millis(50));
+        rig.cx.run_until_parked();
+    }
+    settle(&mut rig.cx);
+    let scans = events("scan").len() - scans_before;
+    // 20 changes over ~1 s, then the deadline: at most one read per 500 ms window.
+    assert!(
+        (1..=4).contains(&scans),
+        "R5.3: {scans} reads for 20 changes in 1 s"
+    );
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 1/2"),
+        "the last change lands"
+    );
+}
+
+// R5.5 — Refresh re-reads even when no event arrives; its hostile half: without Refresh (and
+// with events paused) nothing changes.
+#[gpui::test]
+async fn panel_live_refresh_rereads_without_events(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    rig.fs.pause_events();
+    rig.fs
+        .insert_file(
+            "/work/project/.epico/stories/001-a/tasks.md",
+            b"- [x] one\n- [x] two\n".to_vec(),
+        )
+        .await;
+    settle(&mut rig.cx);
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 0/2"),
+        "no event, no change"
+    );
+
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    settle(&mut rig.cx);
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 2/2"),
+        "R5.5"
+    );
+    rig.fs.unpause_events_and_flush();
+}
+
+// R5.4 — `.epico/` removed from every worktree: the empty state and no dock button.
+#[gpui::test]
+async fn panel_live_epic_removed_shows_the_empty_state(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    assert_eq!(icon(&mut rig), Some(IconName::ListTree));
+    rig.fs
+        .remove_dir(
+            Path::new("/work/project/.epico"),
+            fs::RemoveOptions {
+                recursive: true,
+                ignore_if_not_exists: false,
+            },
+        )
+        .await
+        .expect("remove .epico");
+    settle(&mut rig.cx);
+    assert_eq!(lines(&mut rig), ["No .epico/ directory in this project"]);
+    assert_eq!(icon(&mut rig), None);
+}
+
+// R5.6, R8.3 — a failed watch shows the banner, logs once, and the list and Refresh keep
+// working. The failure is provoked the way watch_tests.rs does it (a refused backend watch of
+// stories/), so it is Linux-only.
+#[cfg(target_os = "linux")]
+#[gpui::test]
+async fn panel_live_watch_failure_banner_and_refresh(cx: &mut TestAppContext) {
+    capture_logs();
+    init_test(cx);
+    let fs = fs::FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/work/project", corpus()).await;
+    fs.create_file_before_next_watch_add(
+        "/work/project/.epico/stories",
+        "/work/project/.epico/stories/001-a/tasks.md",
+    );
+    let project = project::Project::test(fs.clone(), [Path::new("/work/project")], cx).await;
+    let window = cx
+        .add_window(|window, cx| workspace::MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi, _| multi.workspace().clone())
+        .expect("workspace");
+    let mut vcx = gpui::VisualTestContext::from_window(window.into(), cx);
+    let panel = load(&workspace, &mut vcx).await;
+    workspace.update_in(&mut vcx, |workspace, window, cx| {
+        workspace.add_panel(panel.clone(), window, cx)
+    });
+    settle(&mut vcx);
+    let mut rig = Rig {
+        fs,
+        project,
+        workspace,
+        panel,
+        cx: vcx,
+    };
+
+    let shown = banner(&mut rig).expect("R5.6: a banner is shown");
+    assert!(shown.starts_with("Live updates are off: "), "{shown}");
+    assert!(shown.ends_with(". Use Refresh."), "{shown}");
+    assert!(
+        line_of(&mut rig, "001 a").is_some(),
+        "the list is still shown"
+    );
+
+    let failures = events("watch_failed");
+    assert_eq!(failures.len(), 1, "R8.3 one warn line: {failures:?}");
+    assert_eq!(failures[0].0, log::Level::Warn);
+    assert_eq!(field(&failures[0].1, "worktree"), Some("project"));
+    assert!(field(&failures[0].1, "reason").is_some());
+    assert!(
+        !failures[0].1.contains("/work/"),
+        "R8.4 no absolute path: {}",
+        failures[0].1
+    );
+
+    rig.fs.pause_events();
+    rig.fs
+        .insert_file(
+            "/work/project/.epico/stories/001-a/tasks.md",
+            b"- [x] one\n- [x] two\n".to_vec(),
+        )
+        .await;
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    settle(&mut rig.cx);
+    assert_eq!(
+        line_of(&mut rig, "001 a").as_deref(),
+        Some("001 a | in-progress | 2/2"),
+        "Refresh still works"
+    );
+    rig.fs.unpause_events_and_flush();
+}
+
+// R8.1, R8.2, R8.4, Q14 — the log lines.
+#[gpui::test]
+async fn panel_live_logs_are_structured_and_carry_no_content_or_absolute_path(
+    cx: &mut TestAppContext,
+) {
+    capture_logs();
+    let mut tree = corpus();
+    tree[".epico"]["stories"]["005-binary"] = json!({ "story.md": fm(&[("status", "draft")], "") });
+    let mut rig = rig(cx, &[("/work/project", tree)], &["/work/project"]).await;
+    rig.fs
+        .insert_file(
+            "/work/project/.epico/stories/005-binary/tasks.md",
+            b"\xff\xfe".to_vec(),
+        )
+        .await;
+    settle(&mut rig.cx);
+
+    let scans = events("scan");
+    assert!(!scans.is_empty(), "R8.1 a scan line is logged");
+    assert_eq!(
+        scans[0].0,
+        log::Level::Info,
+        "R8.1 the first read logs at info"
+    );
+    let first = &scans[0].1;
+    assert_eq!(field(first, "worktree"), Some("project"));
+    assert_eq!(field(first, "stories"), Some("3"), "{first}");
+    assert_eq!(field(first, "archived"), Some("1"), "{first}");
+    assert!(
+        field(first, "problems").is_some_and(|n| n.parse::<u32>().is_ok()),
+        "{first}"
+    );
+    assert!(
+        field(first, "duration_ms").is_some_and(|n| n.parse::<u64>().is_ok()),
+        "{first}"
+    );
+    for (level, line) in &scans[1..] {
+        assert_eq!(
+            *level,
+            log::Level::Debug,
+            "R8.1 later reads log at debug: {line}"
+        );
+    }
+
+    // R8.2 names no field keys: a warn line naming the story directory and the file.
+    let warns_for_binary = || {
+        panel_lines()
+            .into_iter()
+            .filter(|(level, line)| {
+                *level == log::Level::Warn
+                    && line.contains("005-binary")
+                    && line.contains("tasks.md")
+            })
+            .count()
+    };
+    assert_eq!(
+        warns_for_binary(),
+        1,
+        "R8.2 one warn line for the new problem: {:?}",
+        panel_lines()
+    );
+
+    // The same problem on the next read is not logged again (once per change of reason).
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    settle(&mut rig.cx);
+    assert_eq!(
+        warns_for_binary(),
+        1,
+        "R8.2 not repeated while the reason is unchanged"
+    );
+
+    for (_, line) in panel_lines() {
+        assert!(
+            !line.contains(SECRET),
+            "R8.4 no story content in the log: {line}"
+        );
+        assert!(
+            !line.contains("/work/project"),
+            "R8.4 no absolute path in the log: {line}"
+        );
+        if let Some(start) = line.find("event=") {
+            assert!(
+                parses_as_key_values(&line[start..]),
+                "Q14 key=value fields (quote values with spaces): {line}"
+            );
+        }
+    }
+}
+
+// R6.5 over a full panel session on the real file system: load, expand the archive, open a
+// story, Refresh, let the watcher run — and every path keeps its content, name and mtime.
+#[gpui::test]
+async fn panel_live_session_never_writes_on_real_fs(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    init_test(cx);
+    let temp = tempfile::tempdir().expect("temp dir");
+    let epic = crate::never_writes_tests::build_corpus(temp.path());
+    let project_root = epic.parent().expect(".epico has a parent").to_path_buf();
+    std::fs::write(project_root.join(".gitignore"), ".epico/\n").expect("write .gitignore");
+    let before = crate::never_writes_tests::tree_state(temp.path());
+
+    let fs: Arc<dyn fs::Fs> = fs::RealFs::new(None, cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    let project = project::Project::test(fs.clone(), [project_root.as_path()], cx).await;
+    let window = cx
+        .add_window(|window, cx| workspace::MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi, _| multi.workspace().clone())
+        .expect("workspace");
+    let mut vcx = gpui::VisualTestContext::from_window(window.into(), cx);
+    let panel = load(&workspace, &mut vcx).await;
+    workspace.update_in(&mut vcx, |workspace, window, cx| {
+        workspace.add_panel(panel.clone(), window, cx)
+    });
+    vcx.run_until_parked();
+    let fake = fs::FakeFs::new(vcx.executor());
+    let mut rig = Rig {
+        fs: fake,
+        project,
+        workspace,
+        panel,
+        cx: vcx,
+    };
+    // Real I/O: give the scan real time rather than virtual time.
+    for _ in 0..40 {
+        if line_of(&mut rig, "001 normal").is_some() {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+        rig.cx.run_until_parked();
+    }
+    assert!(
+        line_of(&mut rig, "001 normal").is_some(),
+        "the panel read the corpus: {:?}",
+        lines(&mut rig)
+    );
+    activate_line(&mut rig, "Archived (");
+    activate_line(&mut rig, "001 normal");
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    rig.cx.run_until_parked();
+    drop(rig);
+
+    let after = crate::never_writes_tests::tree_state(temp.path());
+    assert_eq!(
+        after.keys().collect::<Vec<_>>(),
+        before.keys().collect::<Vec<_>>(),
+        "R6.5 names"
+    );
+    for (path, state) in &before {
+        assert_eq!(
+            after.get(path),
+            Some(state),
+            "R6.5: {} changed during a panel session",
+            path.display()
+        );
+    }
+}
+
+/// `k=v k2="v with spaces" …` and nothing else (Q14).
+fn parses_as_key_values(mut rest: &str) -> bool {
+    loop {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            return true;
+        }
+        let Some(eq) = rest.find('=') else {
+            return false;
+        };
+        let key = &rest[..eq];
+        if key.is_empty() || !key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            return false;
+        }
+        rest = &rest[eq + 1..];
+        if let Some(quoted) = rest.strip_prefix('"') {
+            let Some(end) = quoted.find('"') else {
+                return false;
+            };
+            rest = &quoted[end + 1..];
+        } else {
+            let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+            rest = &rest[end..];
+        }
+    }
+}
+
+#[test]
+fn panel_live_key_value_parser_both_directions() {
+    assert!(parses_as_key_values(
+        "event=scan worktree=project stories=2 duration_ms=4"
+    ));
+    assert!(parses_as_key_values(
+        "event=watch_failed worktree=p reason=\"too many open files\""
+    ));
+    assert!(!parses_as_key_values(
+        "event=problem reason=stream did not contain valid UTF-8"
+    ));
+    assert!(!parses_as_key_values(
+        "event=scan worktree=p reason=\"unterminated"
+    ));
+}
