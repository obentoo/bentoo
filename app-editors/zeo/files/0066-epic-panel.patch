+#[gpui::test]
+async fn panel_shell_identity_dock_and_toggle_action(cx: &mut TestAppContext) {
+    let mut rig = rig(
+        cx,
+        &[("/work/project", project_with_epic())],
+        &["/work/project"],
+    )
+    .await;
+    assert_eq!(<EpicPanel as Panel>::persistent_name(), "EpicPanel");
+    assert_eq!(<EpicPanel as Panel>::panel_key(), "EpicPanel");
+    rig.panel.update_in(&mut rig.cx, |panel, window, cx| {
+        assert_eq!(
+            panel.position(window, cx),
+            DockPosition::Right,
+            "A8: right dock when nothing was saved"
+        );
+        assert_eq!(panel.default_size(window, cx), px(300.), "A8: 300 px");
+        for position in [
+            DockPosition::Left,
+            DockPosition::Right,
+            DockPosition::Bottom,
+        ] {
+            assert!(
+                panel.position_is_valid(position),
+                "{position:?} is a valid dock (R1.5)"
+            );
+        }
+        assert_eq!(panel.icon_tooltip(window, cx), Some("Epico Stories"));
+        assert!(panel.toggle_action().partial_eq(&super::ToggleFocus));
+    });
+}
