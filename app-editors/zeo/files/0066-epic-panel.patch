new file mode 100644
index 0000000..8e00df6
--- /dev/null
+++ b/crates/epic_panel/src/never_writes_tests.rs
@@ -0,0 +1,463 @@
+// Story 042, task 3.2 — the panel never writes and never starts a process (R6.5, R6.6).
+//
+// Mounted from the crate root `src/epic_panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "never_writes_tests.rs"]
+//     pub(crate) mod never_writes_tests;
+//
+// so the Validation filter `cargo test -p epic_panel never_writes` selects it. `build_corpus`
+// and `tree_state` are `pub(crate)` because the panel-session no-write test (task 5.4,
+// `panel_live_tests.rs`) reuses them.
+//
+// Two guards:
+//   * behavioural — a corpus holding every variant of design.md §Testing Strategy, built in a
+//     temp dir at test time (symlinks and a FIFO included), scanned twice on RealFs; every
+//     path's kind, size, mtime, content and link target must be identical afterwards;
+//   * static — the crate's non-test sources name no mutating `Fs` method, no `std::fs`, no
+//     process API. Its matcher is itself tested in both directions, so a guard that matches
+//     nothing cannot pass silently.
+//
+// Dev-dependencies: fs, gpui (test-support), tempfile; `regex` is a regular dependency.
+
+#![allow(dead_code)]
+
+use std::{
+    collections::BTreeMap,
+    fs as stdfs,
+    io::Read as _,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::SystemTime,
+};
+
+use fs::Fs;
+use gpui::TestAppContext;
+use regex::Regex;
+
+use crate::scan::scan_epic_dir;
+
+// ── the corpus ──────────────────────────────────────────────────────────────
+
+fn write(root: &Path, relative: &str, content: &[u8]) {
+    let file = root.join(relative);
+    let parent = file.parent().expect("a relative file has a parent");
+    stdfs::create_dir_all(parent).unwrap_or_else(|e| panic!("create {}: {e}", parent.display()));
+    stdfs::write(&file, content).unwrap_or_else(|e| panic!("write {}: {e}", file.display()));
+}
+
+fn mkdir(root: &Path, relative: &str) {
+    let dir = root.join(relative);
+    stdfs::create_dir_all(&dir).unwrap_or_else(|e| panic!("create {}: {e}", dir.display()));
+}
+
+fn symlink(target: &Path, link: &Path) {
+    std::os::unix::fs::symlink(target, link)
+        .unwrap_or_else(|e| panic!("symlink {} -> {}: {e}", link.display(), target.display()));
+}
+
+/// Builds `<root>/project/.epico` with one story directory per variant, plus an `outside/`
+/// directory the symlinks point into. Returns the `.epico` path.
+pub(crate) fn build_corpus(root: &Path) -> PathBuf {
+    let epic = root.join("project/.epico");
+    let fm = |pairs: &[(&str, &str)], body: &str| {
+        let mut text = String::from("---\n");
+        for (key, value) in pairs {
+            text.push_str(&format!("{key}: {value}\n"));
+        }
+        text.push_str("---\n\n");
+        text.push_str(body);
+        text.into_bytes()
+    };
+    write(
+        &epic,
+        "EPICO.md",
+        b"# Epic\n\n<!-- epico:index:start -->\n<!-- epico:index:end -->\n",
+    );
+    write(
+        &epic,
+        "stories/001-normal/story.md",
+        &fm(
+            &[("status", "in-progress"), ("type", "feature")],
+            "# Story - Normal\n",
+        ),
+    );
+    write(
+        &epic,
+        "stories/001-normal/tasks.md",
+        b"- [x] a\n- [ ] b\n- [~] c (deferred: d)\n",
+    );
+    write(
+        &epic,
+        "stories/002-spike/tasks.md",
+        &fm(
+            &[("scale", "spike")],
+            "## Verdict\n- status: promote\n- promoted-to: 3\n",
+        ),
+    );
+    write(
+        &epic,
+        "stories/004-no-status/story.md",
+        &fm(&[("type", "bug")], "# Story - No status\n"),
+    );
+    write(
+        &epic,
+        "stories/005-unknown/story.md",
+        &fm(&[("status", "blocked")], ""),
+    );
+    write(
+        &epic,
+        "stories/006-superseded/story.md",
+        &fm(&[("status", "superseded"), ("superseded-by", "3")], ""),
+    );
+    write(
+        &epic,
+        "stories/007-dangling/story.md",
+        &fm(&[("status", "superseded"), ("superseded-by", "999")], ""),
+    );
+    write(&epic, "stories/notes/tasks.md", b"- [ ] unnumbered\n");
+    mkdir(&epic, "stories/008-empty/.draft");
+    write(&epic, "stories/009-binary/tasks.md", b"- [x] a\n\xff\xfe\n");
+    let mut large = b"- [x] a\n".to_vec();
+    large.resize(1024 * 1024 + 1, b' ');
+    write(&epic, "stories/010-large/tasks.md", &large);
+    write(
+        &epic,
+        "archive/003-archived/story.md",
+        &fm(&[("status", "archived")], "# Story - Archived\n"),
+    );
+    write(&epic, "archive/manifest.yaml", b"entries: []\n");
+
+    write(
+        root,
+        "outside/real-story/story.md",
+        &fm(&[("status", "validated")], ""),
+    );
+    write(root, "outside/secret.md", b"- [x] secret\n");
+    symlink(
+        &root.join("outside/real-story"),
+        &epic.join("stories/011-linked-dir"),
+    );
+    write(
+        &epic,
+        "stories/012-linked-file/story.md",
+        &fm(&[("status", "done")], ""),
+    );
+    symlink(
+        &root.join("outside/secret.md"),
+        &epic.join("stories/012-linked-file/tasks.md"),
+    );
+    epic
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    File { len: u64, content: Vec<u8> },
+    Dir,
+    Symlink { target: PathBuf },
+    Other,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct EntryState {
+    kind: Kind,
+    mtime: SystemTime,
+}
+
+/// Every path under `root`, never following a symlink and never opening a FIFO.
+pub(crate) fn tree_state(root: &Path) -> BTreeMap<PathBuf, EntryState> {
+    fn walk(root: &Path, path: &Path, out: &mut BTreeMap<PathBuf, EntryState>) {
+        let meta = stdfs::symlink_metadata(path)
+            .unwrap_or_else(|e| panic!("symlink_metadata {}: {e}", path.display()));
+        let mtime = meta
+            .modified()
+            .unwrap_or_else(|e| panic!("mtime {}: {e}", path.display()));
+        let file_type = meta.file_type();
+        let kind = if file_type.is_symlink() {
+            Kind::Symlink {
+                target: stdfs::read_link(path)
+                    .unwrap_or_else(|e| panic!("read_link {}: {e}", path.display())),
+            }
+        } else if file_type.is_dir() {
+            let entries = stdfs::read_dir(path)
+                .unwrap_or_else(|e| panic!("read_dir {}: {e}", path.display()));
+            for entry in entries {
+                let entry = entry.unwrap_or_else(|e| panic!("entry of {}: {e}", path.display()));
+                walk(root, &entry.path(), out);
+            }
+            Kind::Dir
+        } else if file_type.is_file() {
+            let mut content = Vec::new();
+            stdfs::File::open(path)
+                .and_then(|mut file| file.read_to_end(&mut content))
+                .unwrap_or_else(|e| panic!("read {}: {e}", path.display()));
+            Kind::File {
+                len: meta.len(),
+                content,
+            }
+        } else {
+            Kind::Other
+        };
+        let relative = path.strip_prefix(root).unwrap_or(path).to_path_buf();
+        out.insert(relative, EntryState { kind, mtime });
+    }
+    let mut out = BTreeMap::new();
+    walk(root, root, &mut out);
+    out
+}
+
+fn assert_same_tree(before: &BTreeMap<PathBuf, EntryState>, after: &BTreeMap<PathBuf, EntryState>) {
+    let before_names: Vec<_> = before.keys().collect();
+    let after_names: Vec<_> = after.keys().collect();
+    assert_eq!(
+        after_names, before_names,
+        "R6.5: no path was created, removed or renamed"
+    );
+    for (path, state) in before {
+        assert_eq!(
+            after.get(path),
+            Some(state),
+            "R6.5: {} changed",
+            path.display()
+        );
+    }
+}
+
+#[gpui::test]
+async fn never_writes_a_scanned_corpus(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let epic = build_corpus(temp.path());
+
+    #[cfg(target_os = "linux")]
+    let fifo = {
+        let fifo = epic.join("stories/013-fifo/tasks.md");
+        mkdir(&epic, "stories/013-fifo");
+        let made = std::process::Command::new("mkfifo")
+            .arg(&fifo)
+            .status()
+            .expect("mkfifo runs");
+        assert!(made.success(), "mkfifo {}", fifo.display());
+        fifo
+    };
+    #[cfg(target_os = "linux")]
+    let (done, unblocker) = {
+        use std::os::unix::fs::OpenOptionsExt as _;
+        use std::sync::atomic::{AtomicBool, Ordering};
+        let done = Arc::new(AtomicBool::new(false));
+        let flag = done.clone();
+        let fifo = fifo.clone();
+        // A reader that opens the FIFO gets EOF instead of hanging the test.
+        let handle = std::thread::spawn(move || {
+            while !flag.load(Ordering::SeqCst) {
+                if let Ok(writer) = stdfs::OpenOptions::new()
+                    .write(true)
+                    .custom_flags(0o4000)
+                    .open(&fifo)
+                {
+                    drop(writer);
+                }
+                std::thread::sleep(std::time::Duration::from_millis(50));
+            }
+        });
+        (done, handle)
+    };
+
+    let before = tree_state(temp.path());
+    let fs: Arc<dyn Fs> = fs::RealFs::new(None, cx.executor());
+    for _ in 0..2 {
+        let snapshot = scan_epic_dir(fs.clone(), epic.clone())
+            .await
+            .expect("the corpus scans");
+        assert!(
+            snapshot.active.len() + snapshot.archived.len() >= 13,
+            "the scan saw the corpus (else this test proves nothing)"
+        );
+    }
+    let after = tree_state(temp.path());
+
+    #[cfg(target_os = "linux")]
+    {
+        done.store(true, std::sync::atomic::Ordering::SeqCst);
+        unblocker.join().expect("unblocker thread");
+    }
+    assert_same_tree(&before, &after);
+}
+
+// Hostile half for the behavioural guard: it must notice a write when one happens.
+#[test]
+fn never_writes_tree_state_notices_every_kind_of_change() {
+    let temp = tempfile::tempdir().expect("temp dir");
+    build_corpus(temp.path());
+    let base = tree_state(temp.path());
+
+    let epic = temp.path().join("project/.epico");
+    write(&epic, "stories/001-normal/tasks.md", b"- [x] a\n- [x] b\n");
+    assert_ne!(tree_state(temp.path()), base, "a content change is noticed");
+
+    let temp = tempfile::tempdir().expect("temp dir");
+    build_corpus(temp.path());
+    let base = tree_state(temp.path());
+    write(&temp.path().join("project/.epico"), ".epic-index.tmp", b"");
+    assert_ne!(tree_state(temp.path()), base, "a new file is noticed");
+
+    let temp = tempfile::tempdir().expect("temp dir");
+    build_corpus(temp.path());
+    let base = tree_state(temp.path());
+    let epic = temp.path().join("project/.epico");
+    stdfs::rename(
+        epic.join("stories/004-no-status"),
+        epic.join("archive/004-no-status"),
+    )
+    .expect("rename");
+    assert_ne!(tree_state(temp.path()), base, "a move is noticed");
+}
+
+// ── the static guard ────────────────────────────────────────────────────────
+
+fn forbidden_patterns() -> Vec<(Regex, &'static str)> {
+    [
+        (r"\bstd::fs\b", "std::fs"),
+        (r"\bstd::\{[^}]*\bfs\b", "std::fs (grouped import)"),
+        (r"\bstd::process\b", "std::process"),
+        (r"\bstd::\{[^}]*\bprocess\b", "std::process (grouped import)"),
+        (r"\bCommand::new\b", "Command::new"),
+        (r"\b(smol|tokio|async_std)::(fs|process)\b", "async fs/process"),
+        (r"\bnew_(smol|std)_command\b", "util::command"),
+        (
+            r"\.\s*(create_dir|create_symlink|create_file|create_file_with|extract_tar_file|copy_file|rename|remove_dir|remove_file|trash|atomic_write|save|write|git_init|git_clone|git_config)\s*\(",
+            "a mutating Fs method",
+        ),
+    ]
+    .into_iter()
+    .map(|(pattern, name)| (Regex::new(pattern).expect("a valid guard pattern"), name))
+    .collect()
+}
+
+/// The forbidden names a source text uses, ignoring `//` comment lines.
+fn violations(source: &str) -> Vec<String> {
+    let patterns = forbidden_patterns();
+    let mut found = Vec::new();
+    for (number, line) in source.lines().enumerate() {
+        if line.trim_start().starts_with("//") {
+            continue;
+        }
+        for (pattern, name) in &patterns {
+            if pattern.is_match(line) {
+                found.push(format!("line {}: {name}: {}", number + 1, line.trim()));
+            }
+        }
+    }
+    found
+}
+
+fn is_test_source(path: &Path) -> bool {
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or_default();
+    name.ends_with("_tests.rs") || name.ends_with("test_helpers.rs")
+}
+
+fn non_test_sources() -> Vec<PathBuf> {
+    fn walk(dir: &Path, out: &mut Vec<PathBuf>) {
+        let entries =
+            stdfs::read_dir(dir).unwrap_or_else(|e| panic!("read_dir {}: {e}", dir.display()));
+        for entry in entries {
+            let path = entry
+                .unwrap_or_else(|e| panic!("entry of {}: {e}", dir.display()))
+                .path();
+            if path.is_dir() {
+                walk(&path, out);
+            } else if path.extension().is_some_and(|ext| ext == "rs") && !is_test_source(&path) {
+                out.push(path);
+            }
+        }
+    }
+    let mut out = Vec::new();
+    walk(&Path::new(env!("CARGO_MANIFEST_DIR")).join("src"), &mut out);
+    out.sort();
+    out
+}
+
+#[test]
+fn never_writes_static_guard_over_the_crate_sources() {
+    let sources = non_test_sources();
+    let names: Vec<String> = sources
+        .iter()
+        .filter_map(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .map(str::to_string)
+        })
+        .collect();
+    for required in ["format.rs", "scan.rs"] {
+        assert!(
+            names.contains(&required.to_string()),
+            "the guard must read {required}; it read {names:?}"
+        );
+    }
+    let mut report = Vec::new();
+    for path in &sources {
+        let source =
+            stdfs::read_to_string(path).unwrap_or_else(|e| panic!("read {}: {e}", path.display()));
+        for violation in violations(&source) {
+            report.push(format!("{}: {violation}", path.display()));
+        }
+    }
+    assert!(
+        report.is_empty(),
+        "R6.5/R6.6: non-test code names a writer or a process:\n{}",
+        report.join("\n")
+    );
+}
+
+// Hostile half: the matcher fires on every forbidden shape...
+#[test]
+fn never_writes_static_guard_fires_on_forbidden_code() {
+    for sample in [
+        "use std::fs;",
+        "use std::{fs, path::Path};",
+        "use std::{path::Path, process::Stdio};",
+        "let out = std::process::Command::new(\"sh\");",
+        "let child = Command::new(\"bash\");",
+        "smol::fs::write(path, b\"x\").await?;",
+        "util::command::new_smol_command(\"git\");",
+        "fs.atomic_write(path, text).await?;",
+        "fs.save(&path, &rope, LineEnding::Unix).await?;",
+        "fs.write(&path, b\"x\").await?;",
+        "fs.rename(&a, &b, Default::default()).await?;",
+        "fs.create_dir(&dir).await?;",
+        "fs.remove_file(&path, Default::default()).await?;",
+        "fs.trash(&path, Default::default()).await?;",
+        "fs . copy_file (&a, &b, Default::default()).await?;",
+    ] {
+        assert!(
+            !violations(sample).is_empty(),
+            "the guard must flag {sample:?}"
+        );
+    }
+}
+
+// ...and stays quiet on the reads the crate is allowed, and on lookalikes.
+#[test]
+fn never_writes_static_guard_allows_reads_and_lookalikes() {
+    for sample in [
+        "let meta = fs.metadata(&path).await?;",
+        "let mut entries = fs.read_dir(&dir).await?;",
+        "let text = fs.load(&path).await?;",
+        "if fs.is_dir(&epic).await {",
+        "let (events, watcher) = fs.watch(&epic, WATCH_LATENCY).await;",
+        "kvp.write_kvp(key, value).await",
+        "// never uses std::fs or Command::new",
+        "    /// Calls no mutating Fs method such as fs.write(..)",
+        "let renamed = row.renamed_from.clone();",
+        "use std::{path::PathBuf, sync::Arc};",
+    ] {
+        assert!(
+            violations(sample).is_empty(),
+            "the guard must not flag {sample:?}: {:?}",
+            violations(sample)
+        );
+    }
+}
