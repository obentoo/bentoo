+
+#[test]
+fn cell_known_is_asked_with_stripped_digits_only() {
+    let asked = RefCell::new(Vec::<String>::new());
+    let known = |number: &str| {
+        asked.borrow_mut().push(number.to_string());
+        false
+    };
+    let tasks = spike_tasks("- status: promote\n- promoted-to: 0042-slug");
+    assert_eq!(
+        status_cell(None, Some(&tasks), &known).text(),
