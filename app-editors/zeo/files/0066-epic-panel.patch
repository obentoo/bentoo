+// so the Validation filter `cargo test -p epic_panel watch` selects it.
+//
+// Contract (design.md §Components `watch`): `DEBOUNCE` (500 ms), `WATCH_LATENCY`,
+// `EpicWatch::start(fs, epic_dir, on_change, on_failure, cx: &App) -> EpicWatch`,
+// `EpicWatch::sync_dirs(&self, &[PathBuf])`; dropping the value ends the watch.
+//
+// Time is the test executor's virtual clock, advanced in 50 ms steps; a call observed in a
+// step happened within that step, so gaps are checked with one step of tolerance.
+//
+// Notes on FakeFs: its delivery is effectively recursive (any registration on an ancestor
+// receives the event), so the non-recursive inotify GOTCHA is checked through
+// `FakeFs::watch_calls()` — the paths the native backend was asked to watch — on Linux, where
+// the native watcher is non-recursive and every `Watcher::add` reaches the backend. A
+// `Watcher::add` failure is provoked with `FakeFs::create_file_before_next_watch_add` aimed at
+// a path that already exists: the fake backend then refuses the watch ("file already exists").
+//
+// Dev-dependencies: fs, gpui (test-support), serde_json.
+
+use std::{
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use fs::{FakeFs, Fs};
+use gpui::TestAppContext;
+use serde_json::json;
+
+use super::*;
+
+const EPIC: &str = "/work/project/.epico";
+const STEP: Duration = Duration::from_millis(50);
+
+fn epic(relative: &str) -> PathBuf {
+    Path::new(EPIC).join(relative)
+}
+
+#[derive(Clone, Default)]
+struct Probe {
+    changes: Arc<AtomicUsize>,
+    failures: Arc<Mutex<Vec<String>>>,
+}
+
+impl Probe {
+    fn changes(&self) -> usize {
+        self.changes.load(Ordering::SeqCst)
+    }
+
+    fn failures(&self) -> Vec<String> {
+        self.failures.lock().expect("failures lock").clone()
+    }
+}
+
+async fn corpus(cx: &mut TestAppContext) -> Arc<FakeFs> {
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/work/project",
+        json!({ ".epico": {
+            "stories": {
+                "001-a": { "story.md": "---\nstatus: draft\n---\n", "tasks.md": "- [ ] a\n" },
+                "002-b": { "tasks.md": "- [ ] b\n" },
+            },
+            "archive": { "003-c": { "tasks.md": "- [x] c\n" } },
+        } }),
+    )
+    .await;
+    fs
+}
+
+fn start(fs: &Arc<FakeFs>, cx: &mut TestAppContext) -> (EpicWatch, Probe) {
+    let probe = Probe::default();
+    let changes = probe.changes.clone();
+    let failures = probe.failures.clone();
+    let fs: Arc<dyn Fs> = fs.clone();
+    let watch = cx.update(|cx| {
+        EpicWatch::start(
+            fs,
+            PathBuf::from(EPIC),
+            move || {
+                changes.fetch_add(1, Ordering::SeqCst);
+            },
+            move |reason: String| {
+                failures.lock().expect("failures lock").push(reason);
+            },
+            cx,
+        )
+    });
+    cx.run_until_parked();
+    (watch, probe)
+}
+
+/// Advances the virtual clock by `total` in steps; returns the step time of each call seen.
+fn advance(cx: &mut TestAppContext, probe: &Probe, total: Duration) -> Vec<Instant> {
+    let mut seen = probe.changes();
+    let mut times = Vec::new();
+    let mut elapsed = Duration::ZERO;
+    while elapsed < total {
+        cx.executor().advance_clock(STEP);
+        cx.run_until_parked();
+        elapsed += STEP;
+        let now = cx.executor().now();
+        let count = probe.changes();
+        for _ in seen..count {
+            times.push(now);
+        }
+        seen = count;
+    }
+    times
+}
+
+fn assert_spaced_by_debounce(times: &[Instant]) {
+    for pair in times.windows(2) {
+        let gap = pair[1] - pair[0];
+        assert!(
+            gap + STEP >= DEBOUNCE,
+            "R5.3: two rescans {gap:?} apart; at most one per {DEBOUNCE:?} is allowed ({times:?})"
+        );
+    }
+}
+
+#[test]
+fn watch_constants() {
+    assert_eq!(DEBOUNCE, Duration::from_millis(500), "R5.3");
+    assert!(
+        WATCH_LATENCY < DEBOUNCE,
+        "the native latency sits inside the debounce window"
+    );
+}
+
+// Hostile half: with no event there is no rescan.
+#[gpui::test]
+async fn watch_is_quiet_without_events(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    let (_watch, probe) = start(&fs, cx);
+    advance(cx, &probe, Duration::from_secs(3));
+    assert_eq!(probe.changes(), 0);
+    assert!(probe.failures().is_empty(), "{:?}", probe.failures());
+}
+
+#[gpui::test]
+async fn watch_reports_a_tasks_md_change_below_story_level_within_two_seconds(
+    cx: &mut TestAppContext,
+) {
+    let fs = corpus(cx).await;
+    let (watch, probe) = start(&fs, cx);
+    watch.sync_dirs(&[
+        epic("stories/001-a"),
+        epic("stories/002-b"),
+        epic("archive/003-c"),
+    ]);
+    cx.run_until_parked();
+
+    fs.insert_file(epic("stories/001-a/tasks.md"), b"- [x] a\n".to_vec())
+        .await;
+    let times = advance(cx, &probe, Duration::from_secs(2));
+    assert!(
+        !times.is_empty(),
+        "R5.1: a tasks.md change two levels down is reported within 2 s"
+    );
+    drop(watch);
+}
+
+#[gpui::test]
+async fn watch_debounces_a_burst_into_spaced_rescans(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    let (_watch, probe) = start(&fs, cx);
+    for round in 0..10u8 {
+        fs.insert_file(
+            epic("stories/001-a/tasks.md"),
+            vec![b'-', b' ', b'[', b' ', b']', b' ', b'0' + round, b'\n'],
+        )
+        .await;
+    }
+    let times = advance(cx, &probe, Duration::from_secs(3));
+    assert!(!times.is_empty(), "the burst is reported");
+    assert!(
+        times.len() <= 2,
+        "ten writes at one instant cost at most two rescans: {times:?}"
+    );
+    assert_spaced_by_debounce(&times);
+}
+
+#[gpui::test]
+async fn watch_sustained_changes_are_rate_limited_and_the_last_one_is_reported(
+    cx: &mut TestAppContext,
+) {
+    let fs = corpus(cx).await;
+    let (_watch, probe) = start(&fs, cx);
+    let mut times = Vec::new();
+    let mut last_event = cx.executor().now();
+    for round in 0..20u32 {
+        fs.insert_file(
+            epic("stories/002-b/tasks.md"),
+            format!("- [ ] {round}\n").into_bytes(),
+        )
+        .await;
+        last_event = cx.executor().now();
+        times.extend(advance(cx, &probe, Duration::from_millis(100)));
+    }
+    times.extend(advance(cx, &probe, Duration::from_secs(2)));
+
+    assert!(
+        times.len() < 20,
+        "one rescan per event is not a debounce: {} rescans",
+        times.len()
+    );
+    assert_spaced_by_debounce(&times);
+    let last_call = *times.last().expect("at least one rescan");
+    assert!(
+        last_call >= last_event,
+        "R5.1: a rescan follows the last change"
+    );
+    assert!(
+        last_call - last_event <= Duration::from_secs(2),
+        "R5.1: within 2 s of the last change"
+    );
+}
+
+#[gpui::test]
+async fn watch_reports_directories_created_moved_and_removed(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    let (_watch, probe) = start(&fs, cx);
+
+    fs.insert_tree(
+        epic("stories/004-new"),
+        json!({ "tasks.md": "- [ ] new\n" }),
+    )
+    .await;
+    assert!(
+        !advance(cx, &probe, Duration::from_secs(2)).is_empty(),
+        "R5.2 created"
+    );
+
+    fs.rename(
+        &epic("stories/002-b"),
+        &epic("archive/002-b"),
+        Default::default(),
+    )
+    .await
+    .expect("move a story to the archive");
+    assert!(
+        !advance(cx, &probe, Duration::from_secs(2)).is_empty(),
+        "R5.2 moved"
+    );
+
+    fs.remove_dir(
+        &epic("stories/004-new"),
+        fs::RemoveOptions {
+            recursive: true,
+            ignore_if_not_exists: false,
+        },
+    )
+    .await
+    .expect("remove a story directory");
+    assert!(
+        !advance(cx, &probe, Duration::from_secs(2)).is_empty(),
+        "R5.2 removed"
+    );
+}
+
+// Hostile half for "the watch lives as long as the value": once dropped, nothing is reported.
+#[gpui::test]
+async fn watch_ends_when_dropped(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    let (watch, probe) = start(&fs, cx);
+    drop(watch);
+    cx.run_until_parked();
+    fs.insert_file(epic("stories/001-a/tasks.md"), b"- [x] a\n".to_vec())
+        .await;
+    advance(cx, &probe, Duration::from_secs(2));
+    assert_eq!(probe.changes(), 0, "a dropped EpicWatch reports nothing");
+}
+
+// The Linux GOTCHA: inotify is not recursive, so the areas and every story directory need a
+// watch of their own.
+#[cfg(target_os = "linux")]
+#[gpui::test]
+async fn watch_adds_the_areas_and_each_synced_story_directory(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    let (watch, probe) = start(&fs, cx);
+    let calls = fs.watch_calls();
+    for path in [epic(""), epic("stories"), epic("archive")] {
+        assert!(
+            calls.contains(&path),
+            "{} watched: {calls:?}",
+            path.display()
+        );
+    }
+
+    fs.insert_tree(
+        epic("stories/005-later"),
+        json!({ "tasks.md": "- [ ] x\n" }),
+    )
+    .await;
+    advance(cx, &probe, Duration::from_secs(1));
+    watch.sync_dirs(&[
+        epic("stories/001-a"),
+        epic("stories/005-later"),
+        epic("archive/003-c"),
+    ]);
+    cx.run_until_parked();
+    let calls = fs.watch_calls();
+    for path in [
+        epic("stories/001-a"),
+        epic("stories/005-later"),
+        epic("archive/003-c"),
+    ] {
+        assert!(
+            calls.contains(&path),
+            "{} watched after sync_dirs: {calls:?}",
+            path.display()
+        );
+    }
+    assert!(probe.failures().is_empty(), "{:?}", probe.failures());
+}
+
+// Hostile half for failure reporting: a missing area is not a failure (it may appear later).
+#[gpui::test]
+async fn watch_a_missing_area_is_not_a_failure(cx: &mut TestAppContext) {
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(
+        "/work/project",
+        json!({ ".epico": { "stories": { "001-a": {} } } }),
+    )
+    .await;
+    let (_watch, probe) = start(&fs, cx);
+    advance(cx, &probe, Duration::from_secs(1));
+    assert!(
+        probe.failures().is_empty(),
+        "no archive/ yet: {:?}",
+        probe.failures()
+    );
+}
+
+#[cfg(target_os = "linux")]
+#[gpui::test]
+async fn watch_failure_is_reported_once_and_changes_still_flow(cx: &mut TestAppContext) {
+    let fs = corpus(cx).await;
+    // The next watch of stories/ will try to create a file that already exists, and fail.
+    fs.create_file_before_next_watch_add(epic("stories"), epic("stories/001-a/tasks.md"));
+    let (watch, probe) = start(&fs, cx);
+    watch.sync_dirs(&[epic("stories/001-a")]);
+    advance(cx, &probe, Duration::from_secs(1));
+
+    let failures = probe.failures();
+    assert_eq!(
+        failures.len(),
+        1,
+        "R5.6: on_failure is called once: {failures:?}"
+    );
+    assert!(
+        !failures[0].trim().is_empty(),
+        "the failure carries a reason"
+    );
+
+    fs.insert_file(epic("archive/003-c/tasks.md"), b"- [ ] reopened\n".to_vec())
+        .await;
+    assert!(
+        !advance(cx, &probe, Duration::from_secs(2)).is_empty(),
+        "the watch keeps going after a failed add"
+    );
+    assert_eq!(probe.failures().len(), 1, "still reported only once");
+}
