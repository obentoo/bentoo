+/// Test seams named by `panel_test_helpers.rs`.
+#[cfg(any(test, feature = "test-support"))]
+impl EpicPanel {
+    pub fn entries(&self) -> &[DisplayEntry] {
+        &self.entries
+    }
+
+    pub fn story_row(&self, worktree: usize, area: Area, row: usize) -> Option<&StoryRow> {
+        self.resolve_row(worktree, area, row)
+    }
+
+    pub fn worktree_name(&self, worktree: usize) -> Option<&str> {
+        self.worktrees.get(worktree).map(|epic| epic.name.as_str())
+    }
+
+    pub fn selected_index(&self) -> Option<usize> {
+        self.selection.as_ref().map(|selection| selection.index)
