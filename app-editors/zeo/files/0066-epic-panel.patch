+// ── RealFs-only cases: FIFO, permission, the real UTF-8 error ───────────────
+
+#[cfg(target_os = "linux")]
+mod real_fs {
+    use std::{
+        fs as stdfs,
+        os::unix::fs::{OpenOptionsExt as _, PermissionsExt as _},
+        sync::atomic::{AtomicBool, Ordering},
+        time::Duration,
+    };
+
+    use super::*;
+
+    const O_NONBLOCK: i32 = 0o4000;
+
+    fn write(root: &Path, relative: &str, content: &[u8]) {
+        let file = root.join(relative);
+        let parent = file.parent().expect("a relative file has a parent");
+        stdfs::create_dir_all(parent)
+            .unwrap_or_else(|e| panic!("create {}: {e}", parent.display()));
+        stdfs::write(&file, content).unwrap_or_else(|e| panic!("write {}: {e}", file.display()));
+    }
+
+    /// If anything opens `fifo` for reading, give it EOF instead of letting the test hang.
+    /// A correct scan never opens it, and then this only ever sees ENXIO.
+    fn unblock_readers_of(fifo: PathBuf, done: Arc<AtomicBool>) -> std::thread::JoinHandle<()> {
+        std::thread::spawn(move || {
+            while !done.load(Ordering::SeqCst) {
+                if let Ok(writer) = stdfs::OpenOptions::new()
+                    .write(true)
+                    .custom_flags(O_NONBLOCK)
+                    .open(&fifo)
+                {
+                    drop(writer);
+                }
+                std::thread::sleep(Duration::from_millis(50));
+            }
+        })
+    }
+
+    #[gpui::test]
+    async fn scan_refuses_a_fifo_without_blocking(cx: &mut TestAppContext) {
+        cx.executor().allow_parking();
+        let temp = tempfile::tempdir().expect("temp dir");
+        let epic = temp.path().join("project/.epico");
+        write(
+            &epic,
+            "stories/060-fifo/story.md",
+            fm(&[("status", "done")], "").as_bytes(),
+        );
+        let fifo = epic.join("stories/060-fifo/tasks.md");
+        let made = std::process::Command::new("mkfifo")
+            .arg(&fifo)
+            .status()
+            .expect("mkfifo runs");
+        assert!(made.success(), "mkfifo {}", fifo.display());
+        let done = Arc::new(AtomicBool::new(false));
+        let unblocker = unblock_readers_of(fifo.clone(), done.clone());
+
+        let fs: Arc<dyn Fs> = fs::RealFs::new(None, cx.executor());
+        let snapshot = scan_epic_dir(fs, epic.clone()).await.expect("scan");
+        done.store(true, Ordering::SeqCst);
+        unblocker.join().expect("unblocker thread");
+
+        let row = row(&snapshot, "060-fifo");
+        let shown = problem(row).expect("the FIFO is a problem, refused before any read");
+        assert!(shown.starts_with("unreadable tasks.md: "), "{shown}");
+        assert!(shown.contains("not a regular file"), "{shown}");
+        assert_eq!(status(row), "done");
+    }
+
+    #[gpui::test]
+    async fn scan_reports_the_root_cause_of_a_load_error(cx: &mut TestAppContext) {
+        cx.executor().allow_parking();
+        let temp = tempfile::tempdir().expect("temp dir");
+        let epic = temp.path().join("project/.epico");
+        write(&epic, "stories/061-binary/tasks.md", b"- [x] a\n\xff\xfe\n");
+        write(
+            &epic,
+            "stories/062-locked/story.md",
+            fm(&[("status", "done")], "").as_bytes(),
+        );
+        write(
+            &epic,
+            "stories/062-locked/tasks.md",
+            fm(&[("status", "draft")], "- [ ] a\n").as_bytes(),
+        );
+        let locked = epic.join("stories/062-locked/story.md");
+        stdfs::set_permissions(&locked, stdfs::Permissions::from_mode(0o000))
+            .unwrap_or_else(|e| panic!("chmod {}: {e}", locked.display()));
+        let can_still_read = stdfs::read(&locked).is_ok();
+
+        let fs: Arc<dyn Fs> = fs::RealFs::new(None, cx.executor());
+        let snapshot = scan_epic_dir(fs, epic.clone()).await.expect("scan");
+        stdfs::set_permissions(&locked, stdfs::Permissions::from_mode(0o644))
+            .unwrap_or_else(|e| panic!("chmod back {}: {e}", locked.display()));
+
+        let temp_text = temp.path().display().to_string();
+        let binary = problem(row(&snapshot, "061-binary")).expect("non-UTF-8 is a problem");
+        assert!(binary.starts_with("unreadable tasks.md: "), "{binary}");
+        assert!(
+            binary.contains("UTF-8"),
+            "the root cause, not a wrapper: {binary}"
+        );
+        assert!(
+            !binary.contains(&temp_text),
+            "no absolute path in the reason: {binary}"
+        );
+
+        if can_still_read {
+            eprintln!("SKIPPED permission case: this user reads mode-000 files");
+            return;
+        }
+        let row = row(&snapshot, "062-locked");
+        let shown = problem(row).expect("a mode-000 story.md is a problem");
+        assert!(shown.starts_with("unreadable story.md: "), "{shown}");
+        assert!(shown.contains("ermission denied"), "{shown}");
+        assert!(!shown.contains(&temp_text), "{shown}");
+        assert_eq!(
+            status(row),
+            "draft",
+            "status falls back to the readable tasks.md"
+        );
+    }
+}
