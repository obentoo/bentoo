+// Story 042, task 6.1 — the panel renders only what the scan provides.
+//
+// Four groups, all test-after:
+//   1. the field contract: for every scan path (normal, absent story.md, absent both, problem
+//      file, symlinked directory, too large, unreadable file, unreadable directory, area notes),
+//      every field `render_story`, `row_badge` and `row_tooltip` read is set the way they
+//      expect, and nothing they show holds an absolute path;
+//   2. `log_value`: one token per value, no raw line break, accepted by the key=value parser of
+//      `panel_live_tests` (and, for an escaped `"`, by an escape-aware one);
+//   3. a scan error in the panel (`.epico` unlistable) and its recovery;
+//   4. the banner with several `.epico` worktrees.
+//
+// Mounted from `src/panel.rs` as a child of `panel`, so it reaches the private renderer
+// helpers. Groups 1 and 3 run on RealFs in a temp dir; group 4 on FakeFs.
+
+use std::path::{Path, PathBuf};
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::panel_test_helpers::*;
+use super::{
+    DisplayEntry, holds_absolute_path, log_value, row_badge, row_tooltip, scan_error_text,
+    without_absolute_path,
+};
+use crate::format::{StatusCell, progress_text};
+use crate::scan::{Area, EpicSnapshot, MAX_FILE_BYTES, RowProblem, StoryRow};
+
+const EM_DASH: &str = "\u{2014}";
+
+// ── group 1: the field contract ─────────────────────────────────────────────
+
+/// What every row must satisfy for the renderer, whatever path the scan took. `epic` is the
+/// scanned `.epico`; `temp` the temp dir holding it, whose path must never be shown.
+fn assert_renderable(row: &StoryRow, epic: &Path, temp: &Path) {
+    let context = format!("row {}", row.dir_name);
+    // The line: the number and slug, or the em dash and the directory name (R2.1).
+    match &row.number {
+        Some(number) => {
+            assert!(!number.is_empty(), "{context}: empty number");
+            assert!(!row.slug.is_empty(), "{context}: a number without a slug");
+        }
+        None => assert!(
+            !row.dir_name.is_empty(),
+            "{context}: nothing to name the row by"
+        ),
+    }
+    assert!(
+        !row.status.text().is_empty(),
+        "{context}: empty status cell"
+    );
+    assert!(
+        !progress_text(row.census).is_empty(),
+        "{context}: empty progress cell"
+    );
+
+    // The badge agrees with the problem and the target (R2.7, R6.1-R6.3).
+    let expected_badge = match &row.problem {
+        Some(RowProblem::Unreadable(..)) => Some("unreadable"),
+        Some(RowProblem::TooLarge(..)) => Some("too large"),
+        Some(RowProblem::Symlink(..)) => Some("symlink not followed"),
+        None if row.open_target.is_none() => Some("no story files"),
+        None => None,
+    };
+    assert_eq!(row_badge(row), expected_badge, "{context}: badge");
+
+    // A problem names a file relative to the story directory, with a reason or a size.
+    if let Some(problem) = &row.problem {
+        let file = match problem {
+            RowProblem::Unreadable(file, reason) => {
+                assert!(!reason.is_empty(), "{context}: unreadable without a reason");
+                file
+            }
+            RowProblem::TooLarge(file, bytes) => {
+                assert!(
+                    *bytes > MAX_FILE_BYTES,
+                    "{context}: too large at {bytes} bytes"
+                );
+                file
+            }
+            RowProblem::Symlink(file) => file,
+        };
+        assert!(
+            ["story.md", "tasks.md", "directory"].contains(&file.as_str()),
+            "{context}: problem file {file:?}"
+        );
+        if file == "directory" {
+            // Nothing behind the directory was read, so nothing can be shown from it.
+            assert_eq!(row.status, StatusCell::Absent, "{context}: status");
+            assert_eq!(row.census, None, "{context}: census");
+            assert_eq!(row.title, None, "{context}: title");
+            assert_eq!(
+                (&row.kind, &row.scale, &row.engineering),
+                (&None, &None, &None),
+                "{context}: frontmatter values"
+            );
+            assert_eq!(row.open_target, None, "{context}: open target");
+        }
+    }
+
+    // The open target is a problem-free regular file of this very story directory.
+    if let Some(target) = &row.open_target {
+        let story_dir = epic.join(row.area.dir_name()).join(&row.dir_name);
+        let name = target
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or_default();
+        assert!(
+            target.parent() == Some(story_dir.as_path())
+                && (name == "story.md" || name == "tasks.md"),
+            "{context}: open target {}",
+            target.display()
+        );
+        let problem_file = row.problem.as_ref().map(|problem| match problem {
+            RowProblem::Unreadable(file, _)
+            | RowProblem::TooLarge(file, _)
+            | RowProblem::Symlink(file) => file.as_str(),
+        });
+        assert_ne!(
+            problem_file,
+            Some(name),
+            "{context}: opens its problem file"
+        );
+        let metadata = std::fs::symlink_metadata(target)
+            .unwrap_or_else(|error| panic!("{context}: stat {}: {error}", target.display()));
+        assert!(
+            metadata.is_file() && !metadata.file_type().is_symlink(),
+            "{context}: target is not a regular file"
+        );
+    }
+
+    // The tooltip: the title or the directory name first, then what the row holds (R2.9).
+    let tooltip = row_tooltip(row);
+    let first = tooltip.lines().next().unwrap_or_default();
+    assert_eq!(
+        first,
+        row.title.as_deref().unwrap_or(&row.dir_name),
+        "{context}: tooltip's first line"
+    );
+    for (key, value) in [
+        ("type", &row.kind),
+        ("scale", &row.scale),
+        ("engineering", &row.engineering),
+    ] {
+        if let Some(value) = value {
+            assert!(
+                tooltip.contains(&format!("{key}: {value}")),
+                "{context}: tooltip lacks {key}: {tooltip}"
+            );
+        }
+    }
+    match &row.problem {
+        Some(RowProblem::Unreadable(file, reason)) => assert!(
+            tooltip.contains(&format!("{file}: unreadable ({reason})")),
+            "{context}: {tooltip}"
+        ),
+        Some(RowProblem::TooLarge(file, bytes)) => assert!(
+            tooltip.contains(&format!("{file}: too large ({bytes} bytes")),
+            "{context}: {tooltip}"
+        ),
+        Some(RowProblem::Symlink(file)) => assert!(
+            tooltip.contains(&format!("{file}: symlink not followed")),
+            "{context}: {tooltip}"
+        ),
+        None if row.open_target.is_none() => assert!(
+            tooltip.contains("No story.md or tasks.md"),
+            "{context}: {tooltip}"
+        ),
+        None => {}
+    }
+    assert_no_absolute_path(&tooltip, temp, &context);
+}
+
+fn assert_no_absolute_path(text: &str, temp: &Path, context: &str) {
+    assert!(
+        !holds_absolute_path(text) && !text.contains(&temp.display().to_string()),
+        "{context}: an absolute path is shown: {text}"
+    );
+}
+
+fn all_rows(snapshot: &EpicSnapshot) -> impl Iterator<Item = &StoryRow> {
+    snapshot.active.iter().chain(&snapshot.archived)
+}
+
+fn row<'a>(snapshot: &'a EpicSnapshot, dir_name: &str) -> &'a StoryRow {
+    all_rows(snapshot)
+        .find(|row| row.dir_name == dir_name)
+        .unwrap_or_else(|| panic!("no row {dir_name}: {:?}", names(snapshot)))
+}
+
+fn names(snapshot: &EpicSnapshot) -> Vec<&str> {
+    all_rows(snapshot)
+        .map(|row| row.dir_name.as_str())
+        .collect()
+}
+
+/// The row as one line plus its badge and its target's file name, the way a reader sees it.
+fn shown(row: &StoryRow) -> String {
+    let target = row
+        .open_target
+        .as_ref()
+        .and_then(|target| target.file_name())
+        .map(|name| name.to_string_lossy().into_owned())
+        .unwrap_or_else(|| EM_DASH.to_string());
+    format!(
+        "{} [{}] -> {target}",
+        story_line(row),
+        row_badge(row).unwrap_or("")
+    )
+}
+
+#[cfg(unix)]
+mod real_fs {
+    use std::{
+        fs as stdfs,
+        os::unix::fs::{PermissionsExt as _, symlink},
+        sync::Arc,
+        time::Duration,
+    };
+
+    use fs::Fs;
+
+    use super::*;
+    use crate::scan::scan_epic_dir;
+
+    pub(super) fn write(root: &Path, relative: &str, content: &[u8]) {
+        let file = root.join(relative);
+        let parent = file.parent().expect("a relative file has a parent");
+        stdfs::create_dir_all(parent)
+            .unwrap_or_else(|error| panic!("create {}: {error}", parent.display()));
+        stdfs::write(&file, content)
+            .unwrap_or_else(|error| panic!("write {}: {error}", file.display()));
+    }
+
+    pub(super) fn mkdir(root: &Path, relative: &str) {
+        let dir = root.join(relative);
+        stdfs::create_dir_all(&dir)
+            .unwrap_or_else(|error| panic!("create {}: {error}", dir.display()));
+    }
+
+    pub(super) fn chmod(path: &Path, mode: u32) {
+        stdfs::set_permissions(path, stdfs::Permissions::from_mode(mode))
+            .unwrap_or_else(|error| panic!("chmod {mode:o} {}: {error}", path.display()));
+    }
+
+    /// Puts the modes back when dropped, so the temp dir can be removed even after a failure.
+    pub(super) struct RestoreModes(pub Vec<(PathBuf, u32)>);
+
+    impl Drop for RestoreModes {
+        fn drop(&mut self) {
+            for (path, mode) in &self.0 {
+                if let Err(error) =
+                    stdfs::set_permissions(path, stdfs::Permissions::from_mode(*mode))
+                {
+                    eprintln!(
+                        "could not restore mode {mode:o} on {}: {error}",
+                        path.display()
+                    );
+                }
+            }
+        }
+    }
+
+    async fn scan(cx: &mut TestAppContext, epic: &Path) -> EpicSnapshot {
+        let fs: Arc<dyn Fs> = fs::RealFs::new(None, cx.executor());
+        scan_epic_dir(fs, epic.to_path_buf())
+            .await
+            .unwrap_or_else(|error| panic!("scan {}: {error:#}", epic.display()))
+    }
+
+    // Normal, absent story.md, absent both, symlinked file, non-UTF-8 file, too large,
+    // symlinked directory, unnumbered — the paths that need no permission change.
+    #[gpui::test]
