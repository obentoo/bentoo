+// Story 042, task 3.1 — reading one `.epico/` directory into a snapshot (R2.1, R2.2, R2.3, R2.7,
+// R2.8, R2.11, R2.12, R3.5, R3.6, R6.1-R6.4, R6.6).
+//
+// Mounted from `src/scan.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "scan_tests.rs"]
+//     mod scan_tests;
+//
+// so the Validation filter `cargo test -p epic_panel scan` selects it.
+//
+// Dev-dependencies: fs, gpui (both with "test-support"), serde_json, tempfile.
+//
+// Contract used (design.md §Components `scan`, §Data Models): `scan_epic_dir(Arc<dyn Fs>,
+// PathBuf) -> anyhow::Result<EpicSnapshot>`; `EpicSnapshot { epic_dir, has_index, active,
+// archived, not_shown, duration }`; `StoryRow { dir_name, number, slug, area, status, census,
+// title, kind, scale, engineering, open_target, problem }`; `RowProblem::{Unreadable(file,
+// reason), TooLarge(file, bytes), Symlink(file)}` where `file`, `reason` and `bytes` only need
+// `Display`; `Area::{Active, Archived}`; `MAX_FILE_BYTES`, `MAX_ROWS`.
+
+use std::{
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+use fs::{FakeFs, Fs};
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::*;
+use crate::format::{StatusCell, progress_text};
+
+const ROOT: &str = "/work/project";
+const EPIC: &str = "/work/project/.epico";
+const EM_DASH: &str = "\u{2014}";
+
+fn fm(pairs: &[(&str, &str)], body: &str) -> String {
+    let mut text = String::from("---\n");
+    for (key, value) in pairs {
+        text.push_str(&format!("{key}: {value}\n"));
+    }
+    text.push_str("---\n\n");
+    text.push_str(body);
+    text
+}
+
+async fn scan(fs: &Arc<FakeFs>) -> EpicSnapshot {
+    let fs: Arc<dyn Fs> = fs.clone();
+    scan_epic_dir(fs, PathBuf::from(EPIC))
+        .await
+        .expect("a listable .epico directory scans without error")
+}
+
+fn all_rows(snapshot: &EpicSnapshot) -> impl Iterator<Item = &StoryRow> {
+    snapshot.active.iter().chain(snapshot.archived.iter())
+}
+
+fn row<'a>(snapshot: &'a EpicSnapshot, dir_name: &str) -> &'a StoryRow {
+    all_rows(snapshot)
+        .find(|row| row.dir_name == dir_name)
+        .unwrap_or_else(|| panic!("no row for {dir_name}"))
+}
+
+fn names(rows: &[StoryRow]) -> Vec<&str> {
+    rows.iter().map(|row| row.dir_name.as_str()).collect()
+}
+
+fn problem(row: &StoryRow) -> Option<String> {
+    match &row.problem {
+        None => None,
+        Some(RowProblem::Unreadable(file, reason)) => Some(format!("unreadable {file}: {reason}")),
+        Some(RowProblem::TooLarge(file, bytes)) => Some(format!("too large {file} {bytes}")),
+        Some(RowProblem::Symlink(file)) => Some(format!("symlink {file}")),
+    }
+}
+
+fn status(row: &StoryRow) -> String {
+    row.status.text()
+}
+
+fn progress(row: &StoryRow) -> String {
+    progress_text(row.census)
+}
+
+fn path(relative: &str) -> PathBuf {
+    Path::new(EPIC).join(relative)
+}
