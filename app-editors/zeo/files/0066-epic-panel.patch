+    fn icon(&self, _window: &Window, _cx: &App) -> Option<IconName> {
+        self.has_any_epic.then_some(IconName::ListTree)
+    }
+
+    fn icon_tooltip(&self, _window: &Window, _cx: &App) -> Option<&'static str> {
+        Some("Epico Stories")
+    }
+
+    fn toggle_action(&self) -> Box<dyn Action> {
+        Box::new(ToggleFocus)
+    }
