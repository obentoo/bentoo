+// R2.7, R6.1-R6.3 — what a problem row says, beside an ordinary one.
+#[gpui::test]
+async fn panel_rows_badges_for_problem_rows(cx: &mut TestAppContext) {
+    let tree = json!({ ".epico": { "stories": {
+        "001-fine": { "story.md": fm(&[("status", "draft")], "") },
+        "002-binary": { "story.md": fm(&[("status", "draft")], "") },
+        "003-large": {},
+        "004-linked": { "story.md": fm(&[("status", "draft")], "") },
+        "005-nothing": { "notes.txt": "x" },
+    } } });
+    let mut rig = rig(
+        cx,
+        &[
+            ("/work/project", tree),
+            ("/outside", json!({ "secret.md": "- [x] s\n" })),
+        ],
+        &["/work/project"],
+    )
+    .await;
+    let epic = PathBuf::from("/work/project/.epico/stories");
+    rig.fs
+        .insert_file(epic.join("002-binary/tasks.md"), b"\xff\xfe".to_vec())
+        .await;
+    let mut large = b"- [x] a\n".to_vec();
+    large.resize(1024 * 1024 + 1, b' ');
+    rig.fs
+        .insert_file(epic.join("003-large/tasks.md"), large)
+        .await;
+    rig.fs
+        .insert_symlink(
+            epic.join("004-linked/tasks.md"),
+            PathBuf::from("/outside/secret.md"),
+        )
+        .await;
+    focus_panel(&mut rig);
+    press(&mut rig, super::Refresh);
+    settle(&mut rig.cx);
+
+    let badge = |rig: &mut Rig, dir: &str| find_row(rig, dir).as_ref().and_then(row_badge);
+    assert_eq!(badge(&mut rig, "001-fine"), None);
+    assert_eq!(badge(&mut rig, "002-binary"), Some("unreadable"));
+    assert_eq!(badge(&mut rig, "003-large"), Some("too large"));
+    assert_eq!(badge(&mut rig, "004-linked"), Some("symlink not followed"));
+    assert_eq!(badge(&mut rig, "005-nothing"), Some("no story files"));
+
+    let tooltip = row_tooltip(&find_row(&mut rig, "002-binary").expect("row"));
+    assert!(
+        tooltip.contains("tasks.md"),
+        "R6.1 the tooltip names the file: {tooltip}"
+    );
+    assert!(
+        tooltip.to_lowercase().contains("utf-8"),
+        "R6.1 and the reason: {tooltip}"
+    );
+    assert!(
+        !tooltip.contains("/work/project"),
+        "no absolute path in the tooltip: {tooltip}"
+    );
+}
