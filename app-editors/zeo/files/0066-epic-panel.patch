+impl Render for EpicPanel {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        // Only while the panel has focus: a rescan must not scroll a list nobody is navigating.
+        if std::mem::take(&mut self.scroll_to_selection)
+            && self.focus_handle.contains_focused(window, cx)
+            && let Some(selection) = &self.selection
+        {
+            self.scroll_handle
+                .scroll_to_item(selection.index, ScrollStrategy::Nearest);
+        }
+        // With no `.epic/` anywhere the message stands alone, centred, as in the Agent Tasks
+        // panel; "No stories yet" is a line of its worktree's section.
+        let lone_message = match self.entries.as_slice() {
+            [DisplayEntry::Empty { message }] => Some(*message),
+            _ => None,
+        };
+        let entry_count = self.entries.len();
+        v_flex()
+            .key_context("EpicPanel")
+            .track_focus(&self.focus_handle)
+            .on_action(cx.listener(Self::refresh))
+            .on_action(cx.listener(Self::select_next))
+            .on_action(cx.listener(Self::select_previous))
+            .on_action(cx.listener(Self::confirm))
+            .size_full()
+            .bg(cx.theme().colors().panel_background)
+            .child(self.render_toolbar(cx))
+            .when_some(self.banner_text(), |panel, text| {
+                panel.child(
+                    div().p_1().child(
+                        Banner::new().severity(Severity::Warning).child(
+                            v_flex().min_w_0().children(
+                                text.lines().map(|line| {
+                                    Label::new(line.to_string()).size(LabelSize::Small)
+                                }),
+                            ),
+                        ),
+                    ),
+                )
+            })
+            .map(|panel| match lone_message {
+                Some(message) => panel.child(
+                    v_flex()
+                        .flex_1()
+                        .items_center()
+                        .justify_center()
+                        .p_4()
+                        .child(
+                            Label::new(message)
+                                .size(LabelSize::Small)
+                                .color(Color::Muted),
+                        ),
+                ),
+                None => panel.child(
+                    v_flex()
+                        .flex_1()
+                        .min_h_0()
+                        .overflow_hidden()
+                        .child(
+                            uniform_list(
+                                "epic-panel-list",
+                                entry_count,
+                                cx.processor(|panel, range: Range<usize>, _window, cx| {
+                                    panel.render_entries(range, cx)
+                                }),
+                            )
+                            .flex_1()
+                            .size_full()
+                            .track_scroll(&self.scroll_handle),
+                        )
+                        // The default scrollbar hides itself a second after the pointer enters,
+                        // and this panel has no settings to change that.
+                        .custom_scrollbars(
+                            Scrollbars::always_visible(ScrollAxes::Vertical)
+                                .tracked_scroll_handle(&self.scroll_handle),
+                            window,
+                            cx,
+                        ),
+                ),
+            })
+    }
+}
+
+impl Panel for EpicPanel {
+    fn persistent_name() -> &'static str {
+        "EpicPanel"
+    }
+
+    fn panel_key() -> &'static str {
+        "EpicPanel"
+    }
+
+    fn position(&self, _window: &Window, _cx: &App) -> DockPosition {
+        self.position
+    }
+
+    fn position_is_valid(&self, position: DockPosition) -> bool {
+        matches!(
+            position,
+            DockPosition::Left | DockPosition::Right | DockPosition::Bottom
+        )
+    }
+
+    fn set_position(
+        &mut self,
+        position: DockPosition,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.position = position;
+        let kvp = KeyValueStore::global(cx);
+        let value = dock_position_text(position).to_string();
+        self._save_position = cx.background_spawn(async move {
+            kvp.write_kvp(<Self as Panel>::panel_key().to_string(), value)
+                .await
+                .log_err();
+        });
+        // A dock moves its panels only when it re-reads their positions, which it does on a
+        // settings change. This panel has no settings, so it asks for the same re-read without
+        // changing any.
+        cx.update_global::<SettingsStore, _>(|_, _| {});
+        cx.notify();
+    }
