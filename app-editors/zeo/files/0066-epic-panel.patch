+    .await;
+    assert_eq!(
+        gpui::Action::name(&super::ToggleFocus),
+        "epic_panel::ToggleFocus",
+        "the palette shows it as `epic panel: toggle focus`"
+    );
+    press(&mut rig, super::ToggleFocus);
+    let (open, focused) = rig
+        .workspace
+        .update_in(&mut rig.cx, |workspace, window, cx| {
+            let dock = workspace.right_dock().read(cx);
+            let open = dock.is_open()
+                && dock
+                    .visible_panel()
+                    .is_some_and(|panel| panel.panel_key() == "EpicPanel");
+            let focused = workspace
+                .panel::<EpicPanel>(cx)
+                .is_some_and(|panel| panel.focus_handle(cx).contains_focused(window, cx));
+            (open, focused)
+        });
+    assert!(open, "the right dock shows the Epic panel");
+    assert!(focused, "the panel has focus");
