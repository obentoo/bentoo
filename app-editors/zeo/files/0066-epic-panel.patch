+// Story 042, task 2.3 — the Status and Progress cells (R3.1, R3.4-R3.8, R4.3, R4.4).
+//
+// Mounted from `src/format.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "format_cell_tests.rs"]
+//     mod cell_tests;
+//
+// so the Validation filter `cargo test -p epic_panel format::cell` selects this file.
+//
+// Oracle: epic-index.sh `status_cell` (786-825), `verdict_cell` (714-739), `progress_cell`
+// (830-841). Texts are compared byte for byte, before md_cell escaping. The absent cell is
+// U+2014 EM DASH.
+//
+// Contract used beyond the text: `StatusCell::{Absent, Lifecycle(Lifecycle), Unknown(String),
+// Verdict { .. }, Superseded { .. }}` and `Lifecycle::{Draft, InProgress, Done, Validated,
+// Superseded, Archived}` (design.md §Components `format`). Matched with `matches!`, so no
+// derive is required of them.
+
+use std::cell::RefCell;
+
+use super::*;
+
+const EM_DASH: &str = "\u{2014}";
+
+fn fm(pairs: &[(&str, &str)], body: &str) -> String {
+    let mut text = String::from("---\n");
+    for (key, value) in pairs {
+        text.push_str(&format!("{key}: {value}\n"));
+    }
+    text.push_str("---\n\n# Story - X\n\n");
+    text.push_str(body);
+    text
+}
+
+fn cell(story: Option<&str>, tasks: Option<&str>, known: &[&str]) -> StatusCell {
+    let known_fn = |number: &str| known.iter().any(|candidate| *candidate == number);
+    status_cell(story, tasks, &known_fn)
+}
+
+fn text(story: Option<&str>, tasks: Option<&str>, known: &[&str]) -> String {
+    cell(story, tasks, known).text()
+}
+
+fn spike_tasks(verdict: &str) -> String {
+    fm(
+        &[("scale", "spike"), ("status", "in-progress")],
+        &format!("## Verdict\n{verdict}\n"),
+    )
+}
+
+// ── where status comes from (R3.1) ──────────────────────────────────────────
+
+#[test]
+fn cell_status_comes_from_story_md() {
+    let story = fm(&[("status", "done")], "");
+    assert_eq!(text(Some(&story), None, &[]), "done");
+}
+
+#[test]
+fn cell_story_md_wins_over_tasks_md() {
+    let story = fm(&[("status", "validated")], "");
+    let tasks = fm(&[("status", "draft")], "");
+    assert_eq!(text(Some(&story), Some(&tasks), &[]), "validated");
+}
+
+#[test]
+fn cell_falls_back_to_tasks_md_when_story_md_lacks_the_key() {
+    let story = fm(&[("type", "feature")], "");
+    let tasks = fm(&[("status", "in-progress")], "");
+    assert_eq!(text(Some(&story), Some(&tasks), &[]), "in-progress");
+}
+
+#[test]
+fn cell_falls_back_to_tasks_md_when_there_is_no_story_md() {
+    let tasks = fm(&[("status", "draft")], "");
+    assert_eq!(text(None, Some(&tasks), &[]), "draft");
+}
+
+#[test]
+fn cell_falls_back_to_tasks_md_when_story_md_frontmatter_is_unterminated() {
+    let story = "---\nstatus: done\n# Story - never closed\n";
+    let tasks = fm(&[("status", "draft")], "");
+    assert_eq!(text(Some(story), Some(&tasks), &[]), "draft");
+}
+
+#[test]
+fn cell_no_status_anywhere_is_the_em_dash() {
+    let story = fm(&[("type", "feature")], "");
+    for (story, tasks) in [
+        (None, None),
+        (Some(story.as_str()), None),
+        (None, Some("# no frontmatter\n")),
+    ] {
+        let shown = text(story, tasks, &[]);
+        assert_eq!(shown, EM_DASH);
+        assert_eq!(
+            shown.as_bytes(),
+            [0xE2, 0x80, 0x94],
+            "U+2014, not '-' or '--'"
+        );
+        assert!(matches!(cell(story, tasks, &[]), StatusCell::Absent));
+    }
+}
+
+// ── lifecycle vs unknown (R3.8) ─────────────────────────────────────────────
+
+#[test]
+fn cell_lifecycle_values_are_recognised() {
+    let cases: [(&str, fn(&StatusCell) -> bool); 5] = [
+        ("draft", |c| {
+            matches!(c, StatusCell::Lifecycle(Lifecycle::Draft))
+        }),
+        ("in-progress", |c| {
+            matches!(c, StatusCell::Lifecycle(Lifecycle::InProgress))
+        }),
+        ("done", |c| {
+            matches!(c, StatusCell::Lifecycle(Lifecycle::Done))
+        }),
+        ("validated", |c| {
+            matches!(c, StatusCell::Lifecycle(Lifecycle::Validated))
+        }),
+        ("archived", |c| {
+            matches!(c, StatusCell::Lifecycle(Lifecycle::Archived))
+        }),
+    ];
+    for (status, is_expected) in cases {
+        let story = fm(&[("status", status)], "");
+        let got = cell(Some(&story), None, &[]);
+        assert!(is_expected(&got), "{status} maps to its Lifecycle variant");
+        assert_eq!(got.text(), status);
+    }
+    let story = fm(&[("status", "superseded")], "");
+    let got = cell(Some(&story), None, &[]);
+    assert!(
+        !matches!(got, StatusCell::Unknown(_)),
+        "superseded is a known status"
+    );
+    assert_eq!(got.text(), "superseded");
+}
+
+// Hostile half: spellings one character away from a lifecycle value are NOT that value.
+#[test]
+fn cell_near_miss_statuses_are_unknown_and_shown_verbatim() {
+    for status in [
+        "Done",
+        "DONE",
+        "in_progress",
+        "inprogress",
+        "validated!",
+        "blocked",
+        "done-ish",
+    ] {
+        let story = fm(&[("status", status)], "");
+        let got = cell(Some(&story), None, &[]);
+        assert!(
+            matches!(&got, StatusCell::Unknown(value) if value == status),
+            "{status:?} must be Unknown, verbatim"
+        );
+        assert_eq!(got.text(), status);
+    }
+}
+
+// Converse: differently-written values that ARE a lifecycle value after the grammar's own
+// quote and comment rules.
+#[test]
+fn cell_quoted_or_commented_lifecycle_values_are_recognised() {
+    for raw in ["\"done\"", "'done'", "done # closed early", "  done  "] {
+        let story = fm(&[("status", raw)], "");
+        assert!(
+            matches!(
+                cell(Some(&story), None, &[]),
+                StatusCell::Lifecycle(Lifecycle::Done)
+            ),
+            "{raw:?}"
+        );
+    }
+}
+
+// ── spikes (R3.4, R3.5) ─────────────────────────────────────────────────────
+
+#[test]
+fn cell_spike_shows_its_verdict() {
+    let tasks = spike_tasks("- status: wont-do");
+    let got = cell(None, Some(&tasks), &[]);
+    assert!(
+        matches!(got, StatusCell::Verdict { .. }),
+        "a verdict, not a lifecycle or Unknown"
+    );
+    assert_eq!(got.text(), "wont-do");
+    assert_eq!(
+        text(None, Some(&spike_tasks("- status: open")), &[]),
+        "open"
+    );
+}
+
+#[test]
+fn cell_spike_promote_resolved_and_missing() {
+    let tasks = spike_tasks("- status: promote\n- promoted-to: 12");
+    assert_eq!(text(None, Some(&tasks), &["12"]), "promote to 12");
+    assert_eq!(text(None, Some(&tasks), &["13"]), "promote to 12 (missing)");
+    assert_eq!(text(None, Some(&tasks), &[]), "promote to 12 (missing)");
+}
+
+#[test]
+fn cell_spike_promote_without_a_target_is_bare() {
+    assert_eq!(
+        text(None, Some(&spike_tasks("- status: promote")), &["12"]),
+        "promote"
+    );
+    assert_eq!(
+        text(
+            None,
+            Some(&spike_tasks("- status: promote\n- promoted-to: NNN")),
+            &["12"]
+        ),
+        "promote"
+    );
+}
+
+#[test]
+fn cell_spike_target_on_a_non_promote_verdict_is_not_shown() {
+    let tasks = spike_tasks("- status: wont-do\n- promoted-to: 12");
+    assert_eq!(text(None, Some(&tasks), &["12"]), "wont-do");
+}
+
+// Hostile half: a spike with no verdict shows the em dash even though its frontmatter has a
+// lifecycle status — falling back would print a status a spike does not use.
+#[test]
+fn cell_spike_without_a_verdict_is_the_em_dash_not_its_frontmatter_status() {
+    let tasks = fm(&[("scale", "spike"), ("status", "done")], "## Overview\n");
+    assert_eq!(text(None, Some(&tasks), &[]), EM_DASH);
+    let story = fm(&[("scale", "spike"), ("status", "done")], "");
+    assert_eq!(
+        text(Some(&story), None, &[]),
+        EM_DASH,
+        "spike with no tasks.md"
+    );
+}
+
+// Hostile half for "which file says spike": story.md's scale wins when present.
+#[test]
+fn cell_story_md_scale_wins_over_tasks_md_scale() {
+    let story = fm(&[("scale", "standard"), ("status", "done")], "");
+    let tasks = spike_tasks("- status: promote\n- promoted-to: 12");
+    assert_eq!(text(Some(&story), Some(&tasks), &["12"]), "done");
+}
+
+// Converse: story.md without `scale` lets tasks.md make it a spike.
+#[test]
+fn cell_tasks_md_scale_applies_when_story_md_has_none() {
+    let story = fm(&[("status", "done")], "");
+    let tasks = spike_tasks("- status: promote\n- promoted-to: 12");
+    assert_eq!(text(Some(&story), Some(&tasks), &["12"]), "promote to 12");
+}
+
+#[test]
+fn cell_spike_verdict_is_read_from_tasks_md_only() {
+    let story = fm(&[("scale", "spike")], "## Verdict\n- status: wont-do\n");
+    let tasks = spike_tasks("- status: open");
