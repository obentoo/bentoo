+//! Reading one worktree's `.epic/` directory into an [`EpicSnapshot`].
+//!
+//! Two passes, like the plugin's `epic-index.sh`: list every story directory of `stories/` and
+//! `archive/` first, so a `superseded by` or `promote to` pointer resolves against both areas,
+//! then read each row. Nothing here writes, and nothing behind a symlink is read (R6.3, R6.6).
+
+use std::{
+    cmp::Ordering,
+    collections::HashSet,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use anyhow::Context as _;
+use fs::{Fs, Metadata};
+use futures::StreamExt as _;
+
+use crate::format::{
+    Census, StatusCell, census, split_dir_name, status_cell, story_then_tasks, strip_zeros, title,
+};
+
+/// Files larger than this are not read (R6.2).
+pub const MAX_FILE_BYTES: u64 = 1024 * 1024;
+/// Rows kept per worktree, active and archived together (R2.12).
+pub const MAX_ROWS: usize = 2000;
+
+const STORY_FILE: &str = "story.md";
+const TASKS_FILE: &str = "tasks.md";
+/// The directories the panel looks for at a worktree's root, current first. The plugin, renamed
+/// Epico, moved `.epic/EPIC.md` to `.epico/EPICO.md` and migrates a project the next time it runs
+/// there; until then the old layout is still read. With both present it moves nothing, and the
+/// panel reads `.epico/`, the one it writes.
+pub(crate) const EPIC_DIR_NAMES: [&str; 2] = [".epico", ".epic"];
+const LEGACY_EPIC_DIR_NAME: &str = ".epic";
+
+/// The index the plugin writes inside `epic_dir`: `EPIC.md` in the old layout, `EPICO.md` now.
+pub(crate) fn index_file_name(epic_dir: &Path) -> &'static str {
+    if epic_dir
+        .file_name()
+        .is_some_and(|name| name == LEGACY_EPIC_DIR_NAME)
+    {
+        "EPIC.md"
+    } else {
+        "EPICO.md"
+    }
+}
+/// The name a problem on the story directory itself carries in place of a file name.
+pub(crate) const DIRECTORY: &str = "directory";
+
+/// Which of `.epic/`'s two areas a story directory lives in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Area {
+    Active,
+    Archived,
+}
+
+impl Area {
+    pub(crate) fn dir_name(self) -> &'static str {
+        match self {
+            Area::Active => "stories",
+            Area::Archived => "archive",
+        }
+    }
+}
+
+/// Why a row shows less than its files hold. The `String` is a file name relative to the story
+/// directory (or `"directory"`), never an absolute path.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum RowProblem {
+    /// The file or directory could not be read; the reason is the error's root cause.
+    Unreadable(String, String),
+    /// The file is larger than [`MAX_FILE_BYTES`]; the number is its length in bytes.
+    TooLarge(String, u64),
+    /// The file or directory is a symlink, and is not followed.
+    Symlink(String),
+}
+
+/// One story directory, as the panel shows it. A row with a problem keeps every field it could
+/// read.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StoryRow {
+    pub dir_name: String,
+    /// The leading digits as written ("042"); `None` when the name is not `NNN-slug`.
+    pub number: Option<String>,
+    /// `""` when the name is not `NNN-slug`.
+    pub slug: String,
+    pub area: Area,
+    pub status: StatusCell,
+    /// `None` when `tasks.md` is absent or was not read.
+    pub census: Option<Census>,
+    pub title: Option<String>,
+    /// The frontmatter `type`.
+    pub kind: Option<String>,
+    pub scale: Option<String>,
+    pub engineering: Option<String>,
+    /// The first of `story.md`, `tasks.md` that exists and carries no problem.
+    pub open_target: Option<PathBuf>,
+    pub problem: Option<RowProblem>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct EpicSnapshot {
+    pub epic_dir: PathBuf,
+    /// The index ([`index_file_name`]) is a regular file, not a symlink (R2.8).
+    pub has_index: bool,
+    /// Area-level read problems, worktree-relative, shown as the worktree's error line.
+    pub notes: Vec<String>,
+    pub active: Vec<StoryRow>,
+    pub archived: Vec<StoryRow>,
+    /// Rows past [`MAX_ROWS`], in display order.
+    pub not_shown: usize,
+    /// Story directories found in `stories/`, counted before the [`MAX_ROWS`] cap.
+    pub active_total: usize,
+    /// Story directories found in `archive/`, counted before the [`MAX_ROWS`] cap.
+    pub archived_total: usize,
+    pub duration: Duration,
+}
+
+/// Reads `epic_dir` into a snapshot. Fails only when `epic_dir` itself cannot be listed; every
+/// other read problem lands in [`EpicSnapshot::notes`] or on a row.
+pub async fn scan_epic_dir(fs: Arc<dyn Fs>, epic_dir: PathBuf) -> anyhow::Result<EpicSnapshot> {
+    let started = Instant::now();
+    let fs = fs.as_ref();
+    // Only whether `.epic/` can be listed matters here; the areas are listed by name below.
+    let listing = fs
+        .read_dir(&epic_dir)
+        .await
+        .with_context(|| format!("reading {}", worktree_relative(&epic_dir)))?;
+    drop(listing);
+
+    let mut notes = Vec::new();
+    let mut active = list_area(fs, &epic_dir, Area::Active, &mut notes).await;
+    let mut archived = list_area(fs, &epic_dir, Area::Archived, &mut notes).await;
+
+    let known: HashSet<String> = active
+        .iter()
+        .chain(archived.iter())
+        .filter_map(|entry| number_value(&entry.dir_name))
+        .map(str::to_string)
+        .collect();
+
+    active.sort_by(|left, right| display_order(&left.dir_name, &right.dir_name));
+    archived.sort_by(|left, right| display_order(&left.dir_name, &right.dir_name));
+    // Capped before any file is read, so a hostile tree cannot make the scan read more than
+    // MAX_ROWS directories' files.
+    let active_total = active.len();
+    let archived_total = archived.len();
+    let kept_active = active.len().min(MAX_ROWS);
+    let kept_archived = archived.len().min(MAX_ROWS - kept_active);
+    let not_shown = active.len() - kept_active + archived.len() - kept_archived;
+    active.truncate(kept_active);
+    archived.truncate(kept_archived);
+
+    let is_known = |number: &str| known.contains(number);
+    let active = read_rows(fs, active, &is_known).await;
+    let archived = read_rows(fs, archived, &is_known).await;
+
+    let has_index = matches!(
+        fs.metadata(&epic_dir.join(index_file_name(&epic_dir))).await,
+        Ok(Some(metadata)) if !metadata.is_symlink && is_regular(&metadata)
+    );
+
+    Ok(EpicSnapshot {
+        epic_dir,
+        has_index,
+        notes,
+        active,
+        archived,
+        not_shown,
+        active_total,
+        archived_total,
+        duration: started.elapsed(),
+    })
+}
+
+/// `<worktree>/.epic`: the directory's parent name and its own, never the absolute path.
+fn worktree_relative(epic_dir: &Path) -> String {
+    let own = epic_dir
+        .file_name()
+        .map(|name| name.to_string_lossy())
+        .unwrap_or_default();
+    match epic_dir.parent().and_then(Path::file_name) {
+        Some(worktree) => format!("{}/{own}", worktree.to_string_lossy()),
+        None => own.into_owned(),
+    }
+}
+
+/// A story directory found by pass 1, before any of its files is read.
+struct StoryEntry {
+    area: Area,
+    path: PathBuf,
+    dir_name: String,
+    kind: EntryKind,
+}
+
+enum EntryKind {
+    Directory,
+    Symlink,
+    /// `metadata` failed; the root cause.
+    Unreadable(String),
+}
+
+/// Pass 1 over one area: its story directories, with no file read. An absent area is empty; one
+/// that cannot be listed, or an entry that errors, becomes a note and the rest is still read.
+async fn list_area(
+    fs: &dyn Fs,
+    epic_dir: &Path,
+    area: Area,
+    notes: &mut Vec<String>,
+) -> Vec<StoryEntry> {
+    let area_dir = epic_dir.join(area.dir_name());
+    let shown = area.dir_name();
+    match fs.metadata(&area_dir).await {
+        Ok(None) => return Vec::new(),
+        Ok(Some(metadata)) if metadata.is_symlink => {
+            // The same rule as a symlinked story directory (R6.3): the target is never read.
+            notes.push(format!("{shown}/ is a symlink and is not followed"));
+            return Vec::new();
+        }
+        Ok(Some(metadata)) if !metadata.is_dir => return Vec::new(),
+        Ok(Some(_)) => {}
+        Err(error) => {
+            notes.push(format!("could not list {shown}/: {}", root_cause(&error)));
+            return Vec::new();
+        }
+    }
+    let mut listing = match fs.read_dir(&area_dir).await {
+        Ok(listing) => listing,
+        Err(error) => {
+            notes.push(format!("could not list {shown}/: {}", root_cause(&error)));
+            return Vec::new();
+        }
+    };
+
+    let mut entries = Vec::new();
+    while let Some(item) = listing.next().await {
+        let path = match item {
+            Ok(path) => path,
+            Err(error) => {
+                notes.push(format!(
+                    "could not list an entry of {shown}/: {}",
+                    root_cause(&error)
+                ));
+                continue;
+            }
+        };
+        let Some(dir_name) = path
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+        else {
+            continue;
+        };
+        // epic-index.sh lists `"$area"/*/`, a glob that skips hidden entries.
+        if dir_name.starts_with('.') {
+            continue;
+        }
+        // `metadata` follows a symlink for `is_dir`, so a symlinked directory is still a story
+        // directory (as `[[ -d ]]` sees it), only never read.
+        let kind = match fs.metadata(&path).await {
+            Ok(Some(metadata)) if !metadata.is_dir => continue,
+            Ok(Some(metadata)) if metadata.is_symlink => EntryKind::Symlink,
+            Ok(Some(_)) => EntryKind::Directory,
+            Ok(None) => continue,
+            Err(error) => EntryKind::Unreadable(root_cause(&error)),
+        };
+        entries.push(StoryEntry {
+            area,
+            path,
+            dir_name,
+            kind,
+        });
+    }
+    entries
+}
+
+/// R2.2: numbered rows first, by the number's value (compared as stripped digits, by length
+/// then bytewise, so no name wraps an integer), then unnumbered rows; ties by name, bytewise.
+fn display_order(left: &str, right: &str) -> Ordering {
+    match (number_value(left), number_value(right)) {
+        (Some(left_value), Some(right_value)) => left_value
+            .len()
+            .cmp(&right_value.len())
+            .then_with(|| left_value.cmp(right_value)),
+        (Some(_), None) => Ordering::Less,
+        (None, Some(_)) => Ordering::Greater,
+        (None, None) => Ordering::Equal,
+    }
+    .then_with(|| left.cmp(right))
+}
+
+/// The stripped digits of an `NNN-slug` name; `None` when unnumbered.
+fn number_value(dir_name: &str) -> Option<&str> {
+    split_dir_name(dir_name).0.map(strip_zeros)
+}
+
+/// What reading one of a story's files produced.
+enum FileRead {
+    Absent,
+    Text(String),
+    Problem(RowProblem),
+}
+
+impl FileRead {
+    fn text(&self) -> Option<&str> {
+        match self {
+            FileRead::Text(text) => Some(text),
+            FileRead::Absent | FileRead::Problem(_) => None,
+        }
+    }
+
+    fn into_problem(self) -> Option<RowProblem> {
+        match self {
+            FileRead::Problem(problem) => Some(problem),
+            FileRead::Absent | FileRead::Text(_) => None,
+        }
+    }
+}
+
+/// Pass 2, in the entries' order.
+async fn read_rows(
+    fs: &dyn Fs,
+    entries: Vec<StoryEntry>,
+    known: &(dyn Fn(&str) -> bool + Sync),
+) -> Vec<StoryRow> {
+    let mut rows = Vec::with_capacity(entries.len());
+    for entry in entries {
+        rows.push(read_row(fs, entry, known).await);
+    }
+    rows
+}
+
+/// Pass 2 for one story directory.
+async fn read_row(
+    fs: &dyn Fs,
+    entry: StoryEntry,
+    known: &(dyn Fn(&str) -> bool + Sync),
+) -> StoryRow {
+    let (story, tasks) = match entry.kind {
+        EntryKind::Directory => (
+            read_file(fs, &entry.path, STORY_FILE).await,
+            read_file(fs, &entry.path, TASKS_FILE).await,
+        ),
+        EntryKind::Symlink => (
+            FileRead::Problem(RowProblem::Symlink(DIRECTORY.to_string())),
+            FileRead::Absent,
+        ),
+        EntryKind::Unreadable(reason) => (
+            FileRead::Problem(RowProblem::Unreadable(DIRECTORY.to_string(), reason)),
+            FileRead::Absent,
+        ),
+    };
+    let story_md = story.text();
+    let tasks_md = tasks.text();
+
+    let open_target = if story_md.is_some() {
+        Some(entry.path.join(STORY_FILE))
+    } else if tasks_md.is_some() {
+        Some(entry.path.join(TASKS_FILE))
+    } else {
+        None
+    };
+    // R2.9: the title comes from tasks.md only when there is no story.md to read it from.
+    let title = match story_md {
+        Some(text) => title(text),
+        None => tasks_md.and_then(title),
+    };
+    let value =
+        |key: &str| story_then_tasks(story_md, tasks_md, key).map(|value| value.into_owned());
+    let (number, slug) = split_dir_name(&entry.dir_name);
+
+    StoryRow {
+        number: number.map(str::to_string),
+        slug: slug.to_string(),
+        area: entry.area,
+        status: status_cell(story_md, tasks_md, known),
+        census: tasks_md.map(census),
+        title: title.map(str::to_string),
+        kind: value("type"),
+        scale: value("scale"),
+        engineering: value("engineering"),
+        open_target,
+        problem: story.into_problem().or_else(|| tasks.into_problem()),
+        dir_name: entry.dir_name,
+    }
+}
+
+/// `metadata` before any read: a symlink is not followed, a FIFO is never opened (it would block
+/// the read), and an oversized file is never loaded whole.
+async fn read_file(fs: &dyn Fs, story_dir: &Path, file: &str) -> FileRead {
+    let path = story_dir.join(file);
+    let problem = match fs.metadata(&path).await {
+        Ok(None) => return FileRead::Absent,
+        Ok(Some(metadata)) if metadata.is_symlink => RowProblem::Symlink(file.to_string()),
+        Ok(Some(metadata)) if !is_regular(&metadata) => {
+            RowProblem::Unreadable(file.to_string(), "not a regular file".to_string())
+        }
+        Ok(Some(metadata)) if metadata.len > MAX_FILE_BYTES => {
+            RowProblem::TooLarge(file.to_string(), metadata.len)
+        }
+        Ok(Some(_)) => match fs.load(&path).await {
+            Ok(text) => return FileRead::Text(text),
+            Err(error) => RowProblem::Unreadable(file.to_string(), root_cause(&error)),
+        },
+        Err(error) => RowProblem::Unreadable(file.to_string(), root_cause(&error)),
+    };
+    FileRead::Problem(problem)
+}
+
+fn is_regular(metadata: &Metadata) -> bool {
+    !metadata.is_dir && !metadata.is_fifo
+}
+
+/// The innermost error's message: the cause without the wrappers that name absolute paths.
+fn root_cause(error: &anyhow::Error) -> String {
+    error.root_cause().to_string()
+}
