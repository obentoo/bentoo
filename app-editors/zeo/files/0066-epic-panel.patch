+/// The inode of `epic_dir` when it is a directory and not a symlink to one: a symlinked
+/// `.epic` is treated as absent, so the panel never reads through it (R6.3). A metadata error
+/// counts as absent, and is logged with the worktree name and the root cause only.
+async fn epic_dir_inode(fs: &dyn Fs, epic_dir: &Path, worktree_name: &str) -> Option<u64> {
+    match fs.metadata(epic_dir).await {
+        Ok(Some(metadata)) if metadata.is_dir && !metadata.is_symlink => Some(metadata.inode),
+        Ok(_) => None,
+        Err(error) => {
+            log::warn!(
+                "epic_panel event=detect_failed worktree={} reason={}",
+                log_value(worktree_name),
+                log_value(&without_absolute_path(
+                    error.root_cause().to_string(),
+                    "metadata failed"
+                ))
+            );
+            None
+        }
+    }
+}
+
+/// The file can still be opened as the scan found it: a regular file, not a symlink. The check
+/// is needed because `open_abs_path` does not fail for a missing file, it opens an empty
+/// unsaved buffer at that path, and because the file may have changed since the scan (R6.3).
+async fn check_open_target(fs: &dyn Fs, abs_path: &Path) -> Result<()> {
+    match fs.metadata(abs_path).await? {
+        None => Err(anyhow::anyhow!("file not found")),
+        Some(metadata) if metadata.is_symlink => Err(anyhow::anyhow!("symlink not followed")),
+        Some(metadata) if metadata.is_dir || metadata.is_fifo => {
+            Err(anyhow::anyhow!("not a regular file"))
+        }
+        Some(_) => Ok(()),
+    }
+}
+
+/// `abs_path` relative to the worktree's `root`, with `/` separators; the file name alone when
+/// it is not under `root`, so an absolute path never reaches a message or a log.
+fn relative_path(root: &Path, abs_path: &Path) -> String {
+    match abs_path.strip_prefix(root) {
+        Ok(relative) => relative
+            .components()
+            .map(|component| component.as_os_str().to_string_lossy())
+            .collect::<Vec<_>>()
+            .join("/"),
+        Err(_) => abs_path
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_default(),
+    }
+}
+
+/// The notification for a file the panel could not open. A type of its own gives it its own
+/// notification id, so it neither replaces nor is replaced by another part's error.
+struct OpenFailed(SharedString);
+
+impl WorkspaceError for OpenFailed {
+    fn primary_message(&self) -> SharedString {
+        self.0.clone()
+    }
+
+    fn primary_action(&self) -> ErrorAction {
+        ErrorAction::dismiss()
+    }
+
+    fn severity(&self) -> ErrorSeverity {
+        ErrorSeverity::Error
+    }
+}
+
+/// A log value: quoted when it holds whitespace, `=`, `"` or a control character. Inside the
+/// quotes, `"`, `\`, control characters and every whitespace other than the ASCII space are
+/// written as `\u{..}`, so a quoted value never holds a raw `"` or `\`: a name from a cloned
+/// repository can never end a line (U+2028 does, in some readers), close the quotes early or
+/// forge another key (Q14).
+fn log_value(value: &str) -> String {
+    if !value.contains(['=', '"'])
+        && !value
+            .chars()
+            .any(|character| character.is_whitespace() || character.is_control())
+    {
+        return value.to_string();
+    }
+    let mut quoted = String::with_capacity(value.len() + 2);
+    quoted.push('"');
+    for character in value.chars() {
+        match character {
+            ' ' => quoted.push(' '),
+            character
+                if matches!(character, '"' | '\\')
+                    || character.is_control()
+                    || character.is_whitespace() =>
+            {
+                quoted.push_str(&character.escape_unicode().to_string())
+            }
+            character => quoted.push(character),
+        }
+    }
+    quoted.push('"');
+    quoted
+}
+
+/// The file a problem names and its kind, as the `event=problem` line writes it (R8.2).
+fn problem_kind(problem: &RowProblem) -> (&str, &'static str) {
+    match problem {
+        RowProblem::Unreadable(file, _) => (file, "unreadable"),
+        RowProblem::TooLarge(file, _) => (file, "too_large"),
+        RowProblem::Symlink(file) => (file, "symlink"),
+    }
+}
+
+/// The problem is on the story directory itself rather than on one of its files.
+fn is_directory_problem(problem: Option<&RowProblem>) -> bool {
+    match problem {
+        Some(RowProblem::Unreadable(file, _) | RowProblem::Symlink(file)) => file == DIRECTORY,
+        Some(RowProblem::TooLarge(..)) | None => false,
+    }
+}
+
+/// The scan's own context, which is worktree-relative ("reading <worktree>/.epic"), followed by
+/// the root cause when that names no absolute path. The layers in between are never shown: they
+/// can carry one (R8.4).
+fn scan_error_text(error: &anyhow::Error) -> String {
+    let outer = error.to_string();
+    let root_cause = error.root_cause().to_string();
+    if error.chain().count() > 1 && !holds_absolute_path(&root_cause) {
+        format!("{outer}: {root_cause}")
+    } else {
+        outer
+    }
+}
+
+/// `text`, or `fallback` when `text` names an absolute path (R8.4).
+fn without_absolute_path(text: String, fallback: &str) -> String {
+    if holds_absolute_path(&text) {
+        fallback.to_string()
+    } else {
+        text
+    }
+}
+
+/// Whether any word of `text`, stripped of the quotes and punctuation an error message puts
+/// around a path, is an absolute path.
+fn holds_absolute_path(text: &str) -> bool {
+    text.split(|character: char| {
+        character.is_whitespace() || matches!(character, '"' | '\'' | '`' | '(' | ')' | ',' | ';')
+    })
+    .any(|word| Path::new(word.trim_end_matches([':', '.'])).is_absolute())
+}
+
+/// A story line: the number (or `—`), the slug (or the directory name when unnumbered), the
+/// status, the progress, then the badge of a problem or of a row with nothing to open (R2.1).
+fn render_story(index: usize, row: &StoryRow) -> impl IntoElement {
+    let (number, name) = match &row.number {
+        Some(number) => (number.as_str(), row.slug.as_str()),
+        None => (ABSENT, row.dir_name.as_str()),
+    };
+    h_flex()
+        .w_full()
+        .min_w_0()
+        .gap_2()
+        .child(
+            Label::new(number.to_string())
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .single_line(),
+        )
+        .child(
+            div().min_w_0().flex_1().child(
+                Label::new(name.to_string())
+                    .size(LabelSize::Small)
+                    .truncate(),
+            ),
+        )
+        .child(
+            h_flex()
+                .flex_none()
+                .gap_1()
+                .when_some(status_warning(&row.status), |this, warning| {
+                    this.child(
+                        div()
+                            .id(("epic-status-warning", index))
+                            .tooltip(Tooltip::text(warning))
+                            .child(
+                                Icon::new(IconName::Warning)
+                                    .size(IconSize::XSmall)
+                                    .color(Color::Warning),
+                            ),
+                    )
+                })
+                .child(
+                    Label::new(row.status.text())
+                        .size(LabelSize::Small)
+                        .color(Color::Muted)
+                        .single_line(),
+                )
+                .child(
+                    Label::new(progress_text(row.census))
+                        .size(LabelSize::Small)
+                        .color(Color::Muted)
+                        .single_line(),
+                )
+                .when_some(row_badge(row), |this, badge| {
+                    this.child(
+                        Label::new(badge)
+                            .size(LabelSize::XSmall)
+                            .color(Color::Warning)
+                            .single_line(),
+                    )
+                }),
+        )
+}
+
+/// The problem a row shows instead of its contents (R2.7, R6.1-R6.3). A problem wins over
+/// "no story files": a row whose only file is unreadable has nothing to open either.
+fn row_badge(row: &StoryRow) -> Option<&'static str> {
+    match &row.problem {
+        Some(RowProblem::Unreadable(..)) => Some("unreadable"),
+        Some(RowProblem::TooLarge(..)) => Some("too large"),
+        Some(RowProblem::Symlink(..)) => Some("symlink not followed"),
+        None => row.open_target.is_none().then_some("no story files"),
+    }
+}
+
+/// The title (the directory name when there is none), the `type`/`scale`/`engineering` values
+/// that are present, and a problem's file name and reason (R2.9, R6.1). Never a path: the
+/// scan keeps only names relative to the story directory.
+fn row_tooltip(row: &StoryRow) -> String {
+    let mut lines = vec![row.title.clone().unwrap_or_else(|| row.dir_name.clone())];
+    let values: Vec<String> = [
+        ("type", &row.kind),
+        ("scale", &row.scale),
+        ("engineering", &row.engineering),
+    ]
+    .into_iter()
+    .filter_map(|(key, value)| value.as_ref().map(|value| format!("{key}: {value}")))
+    .collect();
+    if !values.is_empty() {
+        lines.push(values.join(" \u{b7} "));
+    }
+    match &row.problem {
+        Some(RowProblem::Unreadable(file, reason)) => {
+            lines.push(format!("{file}: unreadable ({reason})"));
+        }
+        Some(RowProblem::TooLarge(file, bytes)) => lines.push(format!(
+            "{file}: too large ({bytes} bytes, over the {MAX_FILE_BYTES}-byte limit)"
+        )),
+        Some(RowProblem::Symlink(file)) => lines.push(format!("{file}: symlink not followed")),
+        None if row.open_target.is_none() => {
+            lines.push("No story.md or tasks.md in this directory".to_string());
+        }
+        None => {}
+    }
+    lines.join("\n")
+}
+
+/// The R3.8 warning, for a status outside the lifecycle only.
+fn status_warning(status: &StatusCell) -> Option<&'static str> {
+    matches!(status, StatusCell::Unknown(_)).then_some(UNKNOWN_STATUS)
+}
+
+fn saved_position(saved: Result<Option<String>>) -> DockPosition {
+    match saved.log_err().flatten() {
+        None => DockPosition::Right,
+        Some(text) => parse_dock_position(&text).unwrap_or_else(|| {
+            log::warn!("epic_panel event=dock_position_unknown fallback=right");
+            DockPosition::Right
+        }),
+    }
+}
+
+fn dock_position_text(position: DockPosition) -> &'static str {
+    match position {
+        DockPosition::Left => "left",
+        DockPosition::Right => "right",
+        DockPosition::Bottom => "bottom",
+    }
+}
+
+fn parse_dock_position(text: &str) -> Option<DockPosition> {
+    match text {
+        "left" => Some(DockPosition::Left),
+        "right" => Some(DockPosition::Right),
+        "bottom" => Some(DockPosition::Bottom),
+        _ => None,
+    }
+}
