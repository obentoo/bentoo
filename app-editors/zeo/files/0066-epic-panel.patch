+    assert_eq!(icon(&mut rig), None);
+    add_worktree(&mut rig, "/work/with").await;
+    assert_eq!(
+        icon(&mut rig),
+        Some(IconName::ListTree),
+        "a worktree with .epico/ was added"
+    );
+    remove_worktree(&mut rig, "/work/with").await;
+    assert_eq!(
+        icon(&mut rig),
+        None,
+        "the only worktree with .epico/ was removed"
+    );
+}
+
+async fn reload(rig: &mut Rig) -> gpui::Entity<EpicPanel> {
+    load(&rig.workspace.clone(), &mut rig.cx).await
+}
+
+fn move_to(rig: &mut Rig, position: DockPosition) {
+    rig.panel.update_in(&mut rig.cx, |panel, window, cx| {
+        panel.set_position(position, window, cx)
+    });
+    rig.cx.run_until_parked();
+}
+
+// R1.5 — the dock survives a restart; Right when nothing was saved.
+#[gpui::test]
+async fn panel_shell_dock_position_survives_a_reload(cx: &mut TestAppContext) {
+    let mut rig = rig(
+        cx,
+        &[("/work/project", project_with_epic())],
+        &["/work/project"],
+    )
+    .await;
+    for position in [
+        DockPosition::Left,
+        DockPosition::Bottom,
+        DockPosition::Right,
+    ] {
+        move_to(&mut rig, position);
+        let moved = rig.workspace.read_with(&rig.cx, |workspace, cx| {
+            let dock = match position {
+                DockPosition::Left => workspace.left_dock(),
+                DockPosition::Right => workspace.right_dock(),
+                DockPosition::Bottom => workspace.bottom_dock(),
+            };
+            dock.read(cx).panel::<EpicPanel>().is_some()
+        });
+        assert!(moved, "the dock moves the panel to {position:?}");
+        let reloaded = reload(&mut rig).await;
+        let saved = reloaded.update_in(&mut rig.cx, |panel, window, cx| panel.position(window, cx));
+        assert_eq!(
+            saved, position,
+            "a fresh load docks where the panel was left"
+        );
+    }
+}
+
+#[gpui::test]
+async fn panel_shell_unknown_saved_position_falls_back_to_right(cx: &mut TestAppContext) {
+    let mut rig = rig(
+        cx,
+        &[("/work/project", project_with_epic())],
+        &["/work/project"],
+    )
+    .await;
+    let kvp = rig.cx.update(|_, cx| db::kvp::KeyValueStore::global(cx));
+    kvp.write_kvp(
+        <EpicPanel as Panel>::panel_key().to_string(),
+        "upside-down".to_string(),
+    )
+    .await
+    .expect("seed the key-value store");
+    let reloaded = reload(&mut rig).await;
+    let position = reloaded.update_in(&mut rig.cx, |panel, window, cx| panel.position(window, cx));
+    assert_eq!(position, DockPosition::Right);
+}
diff --git a/crates/epic_panel/src/panel_test_helpers.rs b/crates/epic_panel/src/panel_test_helpers.rs
new file mode 100644
index 0000000..aa77f50
--- /dev/null
+++ b/crates/epic_panel/src/panel_test_helpers.rs
@@ -0,0 +1,389 @@
+// Story 042 — shared rig for the Epic panel tests (tasks 5.1-5.4).
+//
+// Mounted from `src/panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "panel_test_helpers.rs"]
+//     mod panel_test_helpers;
+//     #[cfg(test)]
+//     #[path = "panel_shell_tests.rs"]
+//     mod panel_shell_tests;
+//     #[cfg(test)]
+//     #[path = "panel_rows_tests.rs"]
+//     mod panel_rows_tests;
+//     #[cfg(test)]
+//     #[path = "panel_open_tests.rs"]
+//     mod panel_open_tests;
+//     #[cfg(test)]
+//     #[path = "panel_live_tests.rs"]
+//     mod panel_live_tests;
+//
+// so each test path carries its Validation filter: `panel_shell`, `panel_rows`, `panel_open`,
+// `panel_live`. Being children of `panel`, these modules see its private items.
+//
+// Dev-dependencies (all workspace crates): db, editor, fs, gpui, project, settings, workspace
+// — each with `features = ["test-support"]` where it has one — plus menu, serde_json,
+// tempfile, ui, log.
+//
+// CONTRACT ASSUMED BEYOND design.md's SIGNATURES. design.md names `EpicPanel`, `DisplayEntry`,
+// `ToggleFocus`, `Refresh`, `init`, `load` and the `Panel` impl, but not how a test reads what
+// the panel shows. These are the seams the tests use; when the implementation names them
+// differently, adjust HERE, not in each test:
+//   - `EpicPanel::entries(&self) -> &[DisplayEntry]` — the flattened list `uniform_list`
+//     renders, in display order (design.md §Performance: rebuilt on snapshot/expanded change).
+//   - `EpicPanel::story_row(&self, worktree: usize, area: Area, row: usize) -> Option<&StoryRow>`
+//     — resolves a `DisplayEntry::Story`.
+//   - `EpicPanel::worktree_name(&self, worktree: usize) -> Option<&str>` — the name a
+//     `WorktreeHeader` shows (R2.5).
+//   - `EpicPanel::selected_index(&self) -> Option<usize>` — index into `entries()`.
+//   - `EpicPanel::banner_text(&self) -> Option<String>` — the banner shown, if any (R5.6).
+//   - free functions in panel.rs used by `render` (so the test checks what is drawn):
+//       `row_badge(&StoryRow) -> Option<&'static str>` — "unreadable" | "too large" |
+//         "symlink not followed" | "no story files" (R2.7, R6.1-R6.3);
+//       `row_tooltip(&StoryRow) -> String` — title, type/scale/engineering, problem detail (R2.9);
+//       `status_warning(&StatusCell) -> Option<&'static str>` — the R3.8 tooltip, Unknown only.
+//   - `StoryRow: Clone` and `Area: Copy` (both plain data).
+//   - the panel reads the file system through the project's / the global `Fs`; the rig sets
+//     the test's FakeFs as both.
+
+#![allow(dead_code)]
+
+use std::{path::Path, sync::Arc, time::Duration};
+
+use fs::FakeFs;
+// Brings `Fs` methods such as `remove_dir` into scope for the tests that glob-import this rig.
+pub(crate) use fs::Fs as _;
+use gpui::{Action, Entity, TestAppContext, VisualTestContext};
+use project::Project;
+use serde_json::Value;
+use ui::IconName;
+use workspace::{AppState, MultiWorkspace, Workspace, dock::Panel};
+
+use super::{DisplayEntry, EpicPanel};
+use crate::format::progress_text;
+use crate::scan::{Area, StoryRow};
+
+/// R1.3, R5.1, R5.2: what the panel shows must be there within this long.
+pub(crate) const DEADLINE: Duration = Duration::from_secs(2);
+
+pub(crate) fn init_test(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        // A database of this test's own: the shared fallback lets parallel tests read each
+        // other's saved dock position.
+        cx.set_global(db::AppDatabase::test_new());
+        let app_state = AppState::test(cx);
+        editor::init(cx);
+        workspace::init(app_state, cx);
+        crate::init(cx);
+    });
+}
+
+pub(crate) struct Rig {
+    pub fs: Arc<FakeFs>,
+    pub project: Entity<Project>,
+    pub workspace: Entity<Workspace>,
+    pub panel: Entity<EpicPanel>,
+    pub cx: VisualTestContext,
+}
+
+/// A FakeFs holding `trees`, a project with one local worktree per entry of `roots`, a
+/// workspace window, and the Epic panel loaded through `EpicPanel::load` and added to the dock
+/// — the order Zeo starts in.
+pub(crate) async fn rig(cx: &mut TestAppContext, trees: &[(&str, Value)], roots: &[&str]) -> Rig {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    for (path, tree) in trees {
+        fs.insert_tree(path, tree.clone()).await;
+    }
+    let project = Project::test(fs.clone(), roots.iter().map(Path::new), cx).await;
+    let window = cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = window
+        .read_with(cx, |multi, _| multi.workspace().clone())
+        .expect("the window holds a workspace");
+    let mut vcx = VisualTestContext::from_window(window.into(), cx);
+    vcx.simulate_resize(gpui::size(gpui::px(1400.), gpui::px(900.)));
+    vcx.run_until_parked();
+    let panel = load(&workspace, &mut vcx).await;
+    workspace.update_in(&mut vcx, |workspace, window, cx| {
+        workspace.add_panel(panel.clone(), window, cx)
+    });
+    settle(&mut vcx);
+    Rig {
+        fs,
+        project,
+        workspace,
+        panel,
+        cx: vcx,
+    }
+}
+
+pub(crate) async fn load(
+    workspace: &Entity<Workspace>,
+    cx: &mut VisualTestContext,
+) -> Entity<EpicPanel> {
+    let weak = workspace.downgrade();
+    let loading = cx.update(|window, cx| EpicPanel::load(weak, window.to_async(cx)));
+    cx.run_until_parked();
+    loading.await.expect("the Epic panel loads")
+}
+
+/// Lets the debounce, the scans and the worktree scanner run out the R1.3/R5.1 deadline.
+pub(crate) fn settle(cx: &mut VisualTestContext) {
+    cx.run_until_parked();
+    cx.executor().advance_clock(DEADLINE);
+    cx.run_until_parked();
+}
+
+pub(crate) fn icon(rig: &mut Rig) -> Option<IconName> {
+    rig.panel
+        .update_in(&mut rig.cx, |panel, window, cx| panel.icon(window, cx))
+}
+
+/// One readable line per visible entry, in display order. A story reads
+/// `"<number or —> <slug or dir name> | <status> | <progress>"`.
+pub(crate) fn lines(rig: &mut Rig) -> Vec<String> {
+    rig.panel.read_with(&rig.cx, |panel, _| {
+        panel
+            .entries()
+            .iter()
+            .map(|entry| describe(panel, entry))
+            .collect()
+    })
+}
+
+fn describe(panel: &EpicPanel, entry: &DisplayEntry) -> String {
+    match entry {
+        DisplayEntry::WorktreeHeader { worktree } => {
+            format!("worktree {}", panel.worktree_name(*worktree).unwrap_or("?"))
+        }
+        DisplayEntry::OpenIndex { worktree } => panel.index_label(*worktree),
+        DisplayEntry::Story {
+            worktree,
+            area,
+            row,
+        } => match panel.story_row(*worktree, *area, *row) {
+            Some(row) => story_line(row),
+            None => format!("dangling story entry {worktree}/{row}"),
+        },
+        DisplayEntry::ArchivedHeader {
+            count, expanded, ..
+        } => {
+            format!(
+                "Archived ({count}){}",
+                if *expanded { " [expanded]" } else { "" }
+            )
+        }
+        DisplayEntry::MoreNotShown { count, .. } => format!("{count} more not shown"),
+        DisplayEntry::Empty { message } => message.to_string(),
+        DisplayEntry::WorktreeError { message, .. } => message.clone(),
+    }
+}
+
+pub(crate) fn story_line(row: &StoryRow) -> String {
+    let number = row.number.clone().unwrap_or_else(|| "\u{2014}".to_string());
+    let name = if row.number.is_some() {
+        row.slug.clone()
+    } else {
+        row.dir_name.clone()
+    };
+    format!(
+        "{number} {name} | {} | {}",
+        row.status.text(),
+        progress_text(row.census)
+    )
+}
+
+/// The StoryRow a visible entry shows, found by directory name.
+pub(crate) fn find_row(rig: &mut Rig, dir_name: &str) -> Option<StoryRow> {
+    rig.panel.read_with(&rig.cx, |panel, _| {
+        panel.entries().iter().find_map(|entry| match entry {
+            DisplayEntry::Story {
+                worktree,
+                area,
+                row,
+            } => panel
+                .story_row(*worktree, *area, *row)
+                .filter(|row| row.dir_name == dir_name)
+                .cloned(),
+            _ => None,
+        })
+    })
+}
+
+pub(crate) fn selected_line(rig: &mut Rig) -> Option<String> {
+    let index = rig
+        .panel
+        .read_with(&rig.cx, |panel, _| panel.selected_index())?;
+    lines(rig).get(index).cloned()
+}
+
+pub(crate) fn focus_panel(rig: &mut Rig) {
+    rig.workspace
+        .update_in(&mut rig.cx, |workspace, window, cx| {
+            workspace.focus_panel::<EpicPanel>(window, cx);
+        });
+    rig.cx.run_until_parked();
+}
+
+pub(crate) fn press(rig: &mut Rig, action: impl Action) {
+    rig.cx.dispatch_action(action);
+    rig.cx.run_until_parked();
+}
+
+/// Moves the selection with `menu::SelectNext` (R2.10) until the line starting with `prefix`
+/// is selected. Panics when a full lap does not reach it.
+pub(crate) fn select_line(rig: &mut Rig, prefix: &str) {
+    focus_panel(rig);
+    let laps = lines(rig).len() * 2 + 2;
+    for _ in 0..laps {
+        if selected_line(rig).is_some_and(|line| line.starts_with(prefix)) {
+            return;
+        }
+        press(rig, menu::SelectNext);
+    }
+    panic!(
+        "no line starting with {prefix:?} could be selected; lines: {:?}",
+        lines(rig)
+    );
+}
+
+pub(crate) fn activate_line(rig: &mut Rig, prefix: &str) {
+    select_line(rig, prefix);
+    press(rig, menu::Confirm);
+    settle(&mut rig.cx);
+}
+
+/// The worktree-relative path of the active editor tab, if any.
+pub(crate) fn active_path(rig: &mut Rig) -> Option<String> {
+    rig.workspace.read_with(&rig.cx, |workspace, cx| {
+        workspace
+            .active_item(cx)
+            .and_then(|item| item.project_path(cx))
+            .map(|path| path.path.as_unix_str().to_string())
+    })
+}
+
+pub(crate) fn item_count(rig: &mut Rig) -> usize {
+    rig.workspace
+        .read_with(&rig.cx, |workspace, cx| workspace.items(cx).count())
+}
+
+pub(crate) fn banner(rig: &mut Rig) -> Option<String> {
+    rig.panel.read_with(&rig.cx, |panel, _| panel.banner_text())
+}
+
+pub(crate) fn fm(pairs: &[(&str, &str)], body: &str) -> String {
+    let mut text = String::from("---\n");
+    for (key, value) in pairs {
+        text.push_str(&format!("{key}: {value}\n"));
+    }
+    text.push_str("---\n\n");
+    text.push_str(body);
+    text
+}
+
+pub(crate) async fn remove_worktree(rig: &mut Rig, root: &str) {
+    let id = rig.project.read_with(&rig.cx, |project, cx| {
+        project
+            .worktrees(cx)
+            .find(|worktree| worktree.read(cx).abs_path().as_ref() == Path::new(root))
+            .map(|worktree| worktree.read(cx).id())
+            .expect("the worktree exists")
+    });
+    rig.project
+        .update(&mut rig.cx, |project, cx| project.remove_worktree(id, cx));
+    settle(&mut rig.cx);
+}
+
+pub(crate) async fn add_worktree(rig: &mut Rig, root: &str) {
+    let task = rig.project.update(&mut rig.cx, |project, cx| {
+        project.find_or_create_worktree(root, true, cx)
+    });
+    task.await.expect("the worktree is added");
+    settle(&mut rig.cx);
+}
+
+pub(crate) fn area_is_archived(area: Area) -> bool {
+    matches!(area, Area::Archived)
+}
+
+// ── log capture (R8) — the 0035 pattern ─────────────────────────────────────
+
+thread_local! {
+    static CAPTURED: std::cell::RefCell<Vec<(log::Level, String)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+struct CaptureLogger;
+
+impl log::Log for CaptureLogger {
+    fn enabled(&self, _metadata: &log::Metadata) -> bool {
+        true
+    }
+
+    fn log(&self, record: &log::Record) {
+        let mut line = record.args().to_string();
+        struct Collect<'a>(&'a mut String);
+        impl<'kvs> log::kv::VisitSource<'kvs> for Collect<'_> {
+            fn visit_pair(
+                &mut self,
+                key: log::kv::Key<'kvs>,
+                value: log::kv::Value<'kvs>,
+            ) -> Result<(), log::kv::Error> {
+                self.0.push_str(&format!(" {key}={value}"));
+                Ok(())
+            }
+        }
+        record
+            .key_values()
+            .visit(&mut Collect(&mut line))
+            .unwrap_or_else(|error| line.push_str(&format!(" kv_error={error}")));
+        CAPTURED.with(|captured| captured.borrow_mut().push((record.level(), line)));
+    }
+
+    fn flush(&self) {}
+}
+
+static INSTALL: std::sync::Once = std::sync::Once::new();
+
+/// Starts capturing log lines on this thread. Panics when another logger owns the process,
+/// rather than letting a log assertion pass or fail for the wrong reason.
+pub(crate) fn capture_logs() {
+    INSTALL.call_once(|| {
+        log::set_boxed_logger(Box::new(CaptureLogger))
+            .expect("another logger is installed; the log capture cannot run");
+        log::set_max_level(log::LevelFilter::Trace);
+    });
+    CAPTURED.with(|captured| captured.borrow_mut().clear());
+}
+
+/// Captured lines naming `event=<event>`, with their level.
+pub(crate) fn events(event: &str) -> Vec<(log::Level, String)> {
+    let needle = format!("event={event}");
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .filter(|(_, line)| line.split_whitespace().any(|token| token == needle))
+            .cloned()
+            .collect()
+    })
+}
+
+/// Every captured line that mentions the panel.
+pub(crate) fn panel_lines() -> Vec<(log::Level, String)> {
+    CAPTURED.with(|captured| {
+        captured
+            .borrow()
+            .iter()
+            .filter(|(_, line)| line.contains("epic_panel"))
+            .cloned()
+            .collect()
+    })
+}
+
+/// `key=value` tokens of a structured line (Q14).
+pub(crate) fn field<'a>(line: &'a str, key: &str) -> Option<&'a str> {
+    line.split_whitespace()
+        .find_map(|token| token.strip_prefix(key)?.strip_prefix('='))
+}
diff --git a/crates/epic_panel/src/parity_tests.rs b/crates/epic_panel/src/parity_tests.rs
new file mode 100644
index 0000000..f3909fe
--- /dev/null
+++ b/crates/epic_panel/src/parity_tests.rs
@@ -0,0 +1,468 @@
+// Story 042, task 3.3 — parity with epic plugin 0.13.1's `epic-index.sh` (R4.5, Q13), carried to
+// the plugin renamed Epico: `epico-index.sh` in 0.25.1 is the same grammar under the new names
+// (`.epico/`, `EPICO.md`, `epico:index` markers), so the contract now runs against it.
+//
+// Mounted from the crate root `src/epic_panel.rs` as
+//
+//     #[cfg(test)]
+//     #[path = "parity_tests.rs"]
+//     mod parity_tests;
+//
+// so the Validation filter `cargo test -p epic_panel parity` selects it.
+//
+// The contract test runs only with both variables set:
+//   EPIC_PARITY_DIR  a `.epico` directory (the corpus; never written)
+//   EPIC_INDEX_SH    the plugin's `scripts/epico-index.sh`
+// Without them it prints `SKIPPED: set EPIC_PARITY_DIR and EPIC_INDEX_SH` and passes. With
+// them it copies the corpus to a temp dir (symlinks recreated, never followed), runs
+// `bash <EPIC_INDEX_SH> --epic-dir <copy>` — on the copy only, because the script writes
+// EPICO.md — parses the generated table and compares number, slug, status text, progress text
+// and location for every row with `scan_epic_dir` over the same copy. It fails on zero rows
+// and lists every mismatch in both directions.
+//
+// The parser and the comparator are tested on their own (always, no variables needed), each
+// with the input that would make it pass wrongly.
+//
+// Dev-dependencies: fs, gpui (test-support), tempfile.
+
+use std::{
+    collections::BTreeMap,
+    env, fs as stdfs,
+    path::{Path, PathBuf},
+    process::Command,
+    sync::Arc,
+};
+
+use fs::Fs;
+use gpui::TestAppContext;
+
+use crate::format::progress_text;
+use crate::scan::{Area, EpicSnapshot, scan_epic_dir};
+
+const START: &str = "<!-- epico:index:start -->";
+const END: &str = "<!-- epico:index:end -->";
+const REMOVED: &str = "archived (directory removed)";
+const EM_DASH: &str = "\u{2014}";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Row {
+    number: String,
+    slug: String,
+    status: String,
+    progress: String,
+    location: String,
+}
+
+impl Row {
+    fn key(&self) -> (String, String, String) {
+        (
+            self.location.clone(),
+            self.number.clone(),
+            self.slug.clone(),
+        )
+    }
+}
+
+/// Splits a table line on `|` not preceded by a backslash escape.
+fn split_unescaped(line: &str) -> Vec<String> {
+    let mut cells = vec![String::new()];
+    let mut chars = line.chars();
+    while let Some(c) = chars.next() {
+        match c {
+            '\\' => {
+                let cell = cells.last_mut().expect("at least one cell");
+                cell.push('\\');
+                if let Some(next) = chars.next() {
+                    cell.push(next);
+                }
+            }
+            '|' => cells.push(String::new()),
+            _ => cells.last_mut().expect("at least one cell").push(c),
+        }
+    }
+    cells
+}
+
+/// The inverse of epic-index.sh `md_cell` for `\\`, `\|`, `\[`, `\]`.
+fn unescape(cell: &str) -> String {
+    let mut out = String::new();
+    let mut chars = cell.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' {
+            if let Some(next) = chars.next() {
+                out.push(next);
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+/// `[slug](link)` -> slug; a cell without a link (manifest-only rows) is the slug itself.
+fn slug_of(raw: &str) -> String {
+    let raw = raw.trim();
+    if let Some(rest) = raw.strip_prefix('[') {
+        let mut escaped = false;
+        let bytes: Vec<char> = rest.chars().collect();
+        for (index, c) in bytes.iter().enumerate() {
+            if escaped {
+                escaped = false;
+                continue;
+            }
+            match c {
+                '\\' => escaped = true,
+                ']' if bytes.get(index + 1) == Some(&'(') => {
+                    return unescape(&bytes[..index].iter().collect::<String>());
+                }
+                _ => {}
+            }
+        }
+    }
+    unescape(raw)
+}
+
+fn parse_index(text: &str) -> Result<Vec<Row>, String> {
+    let start = text.find(START).ok_or("no start marker")?;
+    let end = text.find(END).ok_or("no end marker")?;
+    if end < start {
+        return Err("end marker before start marker".into());
+    }
+    let mut rows = Vec::new();
+    for line in text[start..end].lines() {
+        let line = line.trim_end_matches('\r');
+        if !line.starts_with('|') || line.starts_with("| # |") || line.starts_with("| --- |") {
+            continue;
+        }
+        let cells = split_unescaped(line);
+        // "| a | b | c | d | e |" -> ["", a, b, c, d, e, ""]
+        if cells.len() != 7 {
+            return Err(format!(
+                "a row with {} columns: {line}",
+                cells.len().saturating_sub(2)
+            ));
+        }
+        rows.push(Row {
+            number: unescape(cells[1].trim()),
+            slug: slug_of(&cells[2]),
+            status: unescape(cells[3].trim()),
+            progress: unescape(cells[4].trim()),
+            location: unescape(cells[5].trim()),
+        });
+    }
+    Ok(rows)
+}
+
+fn panel_rows(snapshot: &EpicSnapshot) -> Vec<Row> {
+    snapshot
+        .active
+        .iter()
+        .chain(snapshot.archived.iter())
+        .map(|row| Row {
+            number: row.number.clone().unwrap_or_else(|| EM_DASH.to_string()),
+            slug: if row.number.is_some() {
+                row.slug.clone()
+            } else {
+                row.dir_name.clone()
+            },
+            status: row.status.text(),
+            progress: progress_text(row.census),
+            location: match row.area {
+                Area::Active => "active".to_string(),
+                Area::Archived => "archived".to_string(),
+            },
+        })
+        .collect()
+}
+
+/// Every difference between the two readers, in both directions.
+fn compare(index: &[Row], panel: &[Row]) -> Vec<String> {
+    let mut report = Vec::new();
+    let mut by_key: BTreeMap<_, Vec<&Row>> = BTreeMap::new();
+    for row in panel {
+        by_key.entry(row.key()).or_default().push(row);
+    }
+    for expected in index {
+        match by_key.get_mut(&expected.key()).and_then(|rows| rows.pop()) {
+            None => report.push(format!("only in EPICO.md: {expected:?}")),
+            Some(actual) => {
+                if actual.status != expected.status {
+                    report.push(format!(
+                        "{} {}: status {:?} (EPICO.md) vs {:?} (panel)",
+                        expected.number, expected.slug, expected.status, actual.status
+                    ));
+                }
+                if actual.progress != expected.progress {
+                    report.push(format!(
+                        "{} {}: progress {:?} (EPICO.md) vs {:?} (panel)",
+                        expected.number, expected.slug, expected.progress, actual.progress
+                    ));
+                }
+            }
+        }
+    }
+    for rows in by_key.values() {
+        for row in rows {
+            report.push(format!("only in the panel: {row:?}"));
+        }
+    }
+    report
+}
+
+fn copy_tree(source: &Path, target: &Path) {
+    let meta = stdfs::symlink_metadata(source)
+        .unwrap_or_else(|e| panic!("stat {}: {e}", source.display()));
+    let file_type = meta.file_type();
+    if file_type.is_symlink() {
+        let link = stdfs::read_link(source)
+            .unwrap_or_else(|e| panic!("read_link {}: {e}", source.display()));
+        std::os::unix::fs::symlink(&link, target)
+            .unwrap_or_else(|e| panic!("symlink {} -> {}: {e}", target.display(), link.display()));
+    } else if file_type.is_dir() {
+        stdfs::create_dir_all(target)
+            .unwrap_or_else(|e| panic!("create {}: {e}", target.display()));
+        let entries = stdfs::read_dir(source)
+            .unwrap_or_else(|e| panic!("read_dir {}: {e}", source.display()));
+        for entry in entries {
+            let entry = entry.unwrap_or_else(|e| panic!("entry of {}: {e}", source.display()));
+            copy_tree(&entry.path(), &target.join(entry.file_name()));
+        }
+    } else if file_type.is_file() {
+        stdfs::copy(source, target)
+            .unwrap_or_else(|e| panic!("copy {} -> {}: {e}", source.display(), target.display()));
+    } else {
+        eprintln!(
+            "parity: not copied (neither file, directory nor symlink): {}",
+            source.display()
+        );
+    }
+}
+
+fn file_state(path: &Path) -> Option<(Vec<u8>, std::time::SystemTime)> {
+    let meta = stdfs::symlink_metadata(path).ok()?;
+    let content = stdfs::read(path).ok()?;
+    Some((content, meta.modified().ok()?))
+}
+
+// ── the contract test ───────────────────────────────────────────────────────
+
+#[gpui::test]
+async fn parity_with_epic_index_sh(cx: &mut TestAppContext) {
+    let (Some(corpus), Some(script)) =
+        (env::var_os("EPIC_PARITY_DIR"), env::var_os("EPIC_INDEX_SH"))
+    else {
+        println!("SKIPPED: set EPIC_PARITY_DIR and EPIC_INDEX_SH");
+        return;
+    };
+    cx.executor().allow_parking();
+    let corpus = PathBuf::from(corpus);
+    let script = PathBuf::from(script);
+    assert!(
+        corpus.is_dir(),
+        "EPIC_PARITY_DIR is not a directory: {}",
+        corpus.display()
+    );
+    assert!(
+        script.is_file(),
+        "EPIC_INDEX_SH is not a file: {}",
+        script.display()
+    );
+    let corpus_index_before = file_state(&corpus.join("EPICO.md"));
+
+    let temp = tempfile::tempdir().expect("temp dir");
+    let copy = temp.path().join(".epico");
+    copy_tree(&corpus, &copy);
+
+    let output = Command::new("bash")
+        .arg(&script)
+        .arg("--epic-dir")
+        .arg(&copy)
+        .output()
+        .unwrap_or_else(|e| panic!("running bash {}: {e}", script.display()));
+    assert!(
+        output.status.success(),
+        "epico-index.sh failed ({}):\n{}",
+        output.status,
+        String::from_utf8_lossy(&output.stderr)
+    );
+
+    let index_text = stdfs::read_to_string(copy.join("EPICO.md")).unwrap_or_else(|e| {
+        panic!(
+            "read the generated {}: {e}",
+            copy.join("EPICO.md").display()
+        )
+    });
+    let index: Vec<Row> = parse_index(&index_text)
+        .unwrap_or_else(|e| panic!("parse the generated index: {e}"))
+        .into_iter()
+        .filter(|row| row.location != REMOVED) // Assumption A5
+        .collect();
+    assert!(
+        !index.is_empty(),
+        "the generated index has zero story rows: parity would prove nothing"
+    );
+
+    let fs: Arc<dyn Fs> = fs::RealFs::new(None, cx.executor());
+    let snapshot = scan_epic_dir(fs, copy.clone())
+        .await
+        .expect("scan the copy");
+    assert_eq!(
+        snapshot.not_shown, 0,
+        "the corpus exceeds MAX_ROWS; parity would be partial"
+    );
+    let panel = panel_rows(&snapshot);
+
+    let report = compare(&index, &panel);
+    println!(
+        "parity: {} EPICO.md rows, {} panel rows, {} mismatches",
+        index.len(),
+        panel.len(),
+        report.len()
+    );
+    assert!(
+        report.is_empty(),
+        "the panel and epico-index.sh disagree:\n{}",
+        report.join("\n")
+    );
+
+    assert_eq!(
+        file_state(&corpus.join("EPICO.md")),
+        corpus_index_before,
+        "the corpus's own EPICO.md must be untouched: the script runs on the copy only"
+    );
+}
+
+// ── the parser, both directions ─────────────────────────────────────────────
+
+const SAMPLE: &str = "# Epic\n\nHand-written | text with a pipe.\n\n<!-- epico:index:start -->\n<!-- Generated by scripts/epico-index.sh — edits inside this block are overwritten. -->\n\n| # | Story | Status | Progress | Location |\n| --- | --- | --- | --- | --- |\n| 001 | [close-the-parity-backlog](archive/001-close-the-parity-backlog/story.md) | archived | 61/61 | archived |\n| 007 | [a\\|b \\[x\\]](stories/007-a%7Cb%20[x]/) | odd \\| status | 1/2 (+1 deferred) | active |\n| — | [notes](stories/notes/) | — | — | active |\n| 012 | gone-story | done | 3/3 | archived (directory removed) |\n<!-- epico:index:end -->\n\nAfter | the block.\n";
+
+#[test]
+fn parity_parser_reads_rows_inside_the_markers_only() {
+    let rows = parse_index(SAMPLE).expect("parses");
+    assert_eq!(
+        rows.len(),
+        4,
+        "text outside the markers is not a row: {rows:?}"
+    );
+    assert_eq!(
+        rows[0],
+        Row {
+            number: "001".into(),
+            slug: "close-the-parity-backlog".into(),
+            status: "archived".into(),
+            progress: "61/61".into(),
+            location: "archived".into(),
+        }
+    );
+    assert_eq!(rows[2].number, EM_DASH);
+    assert_eq!(rows[2].slug, "notes");
+    assert_eq!(rows[3].location, REMOVED);
+    assert_eq!(rows[3].slug, "gone-story", "a linkless manifest row");
+}
+
+// Hostile half: an escaped pipe is content, not a column break; escaped brackets are content,
+// not the end of the link text.
+#[test]
+fn parity_parser_keeps_escaped_pipes_and_brackets_as_content() {
+    let rows = parse_index(SAMPLE).expect("parses");
+    assert_eq!(rows[1].slug, "a|b [x]");
+    assert_eq!(rows[1].status, "odd | status");
+    assert_eq!(rows[1].progress, "1/2 (+1 deferred)");
+}
+
+// Converse: an unescaped pipe IS a column break, so a row with one too many is refused rather
+// than silently shifted.
+#[test]
+fn parity_parser_refuses_a_row_with_an_extra_column() {
+    let text = format!("{START}\n| 001 | [a](x) | done | extra | 1/1 | active |\n{END}\n");
+    assert!(parse_index(&text).is_err());
+}
+
+#[test]
+fn parity_parser_requires_both_markers() {
+    assert!(parse_index("| 001 | [a](x) | done | 1/1 | active |\n").is_err());
+    assert!(parse_index(&format!("{END}\n{START}\n")).is_err());
+}
+
+// ── the comparator, both directions ─────────────────────────────────────────
+
+fn r(number: &str, slug: &str, status: &str, progress: &str, location: &str) -> Row {
+    Row {
+        number: number.into(),
+        slug: slug.into(),
+        status: status.into(),
+        progress: progress.into(),
+        location: location.into(),
+    }
+}
+
+#[test]
+fn parity_comparator_accepts_identical_rows() {
+    let rows = vec![
+        r("001", "a", "done", "1/1", "active"),
+        r("002", "b", EM_DASH, EM_DASH, "archived"),
+    ];
+    assert!(compare(&rows, &rows).is_empty());
+}
+
+// Hostile half: every kind of disagreement is reported.
+#[test]
+fn parity_comparator_reports_every_disagreement() {
+    let index = vec![
+        r("001", "a", "done", "1/1", "active"),
+        r("002", "b", "draft", "0/3", "active"),
+        r("003", "c", "archived", "2/2", "archived"),
+    ];
+    let panel = vec![
+        r("001", "a", "done", "1/2", "active"),     // progress differs
+        r("002", "b", "draft ", "0/3", "active"),   // status differs by a trailing space
+        r("003", "c", "archived", "2/2", "active"), // location differs -> both sides orphaned
+        r("004", "d", "draft", "0/0", "active"),    // only in the panel
+    ];
+    let report = compare(&index, &panel);
+    assert!(
+        report.iter().any(|line| line.contains("progress")),
+        "{report:?}"
+    );
+    assert!(
+        report.iter().any(|line| line.contains("status")),
+        "{report:?}"
+    );
+    assert!(
+        report
+            .iter()
+            .any(|line| line.starts_with("only in EPICO.md") && line.contains("\"c\"")),
+        "{report:?}"
+    );
+    assert!(
+        report
+            .iter()
+            .filter(|line| line.starts_with("only in the panel"))
+            .count()
+            == 2,
+        "{report:?}"
+    );
+}
+
+// Hostile half for identity: two rows sharing a number in different areas are two rows, and
+// the same row twice on one side is not absorbed by one on the other.
+#[test]
+fn parity_comparator_neither_collapses_nor_splits_rows() {
+    let index = vec![
+        r("012", "a", "done", "1/1", "active"),
+        r("012", "b", "done", "1/1", "archived"),
+    ];
+    assert!(compare(&index, &index.clone()).is_empty());
+    let panel = vec![r("012", "a", "done", "1/1", "active")];
+    assert_eq!(
+        compare(&index, &panel).len(),
+        1,
+        "the archived 012 is missing from the panel"
+    );
+    let doubled = vec![index[0].clone(), index[0].clone(), index[1].clone()];
+    assert_eq!(
+        compare(&index, &doubled).len(),
+        1,
+        "one extra panel row is reported"
+    );
+}
