+// Story 042, task 5.3 — activating rows opens files (R2.6, R2.7, R2.8, R6.3).
+// Module path: `panel::panel_open_tests`. See panel_test_helpers.rs for the assumed contract.
+
+use std::path::PathBuf;
+
+use gpui::TestAppContext;
+use serde_json::{Value, json};
+
+use super::panel_test_helpers::*;
+
+fn corpus() -> Value {
+    json!({
+        ".gitignore": ".epico/\n",
+        "src": { "main.rs": "fn main() {}\n" },
+        ".epico": {
+            "EPICO.md": "# Epic\n",
+            "stories": {
+                "001-both": {
+                    "story.md": fm(&[("status", "draft")], "# Story - Both\n"),
+                    "tasks.md": fm(&[("status", "draft")], "- [ ] a\n"),
+                },
+                "002-tasks-only": { "tasks.md": fm(&[("status", "done")], "- [x] a\n") },
+                "003-nothing": { "notes.txt": "x" },
+            },
+        },
+    })
+}
+
+// Hostile half first: with both files present it is story.md, never tasks.md.
+#[gpui::test]
+async fn panel_open_prefers_story_md(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    activate_line(&mut rig, "001 both");
+    assert_eq!(
+        active_path(&mut rig).as_deref(),
+        Some(".epico/stories/001-both/story.md"),
+        "R2.6"
+    );
+}
+
+#[gpui::test]
+async fn panel_open_falls_back_to_tasks_md(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    activate_line(&mut rig, "002 tasks-only");
+    assert_eq!(
+        active_path(&mut rig).as_deref(),
+        Some(".epico/stories/002-tasks-only/tasks.md"),
+        "R2.6"
+    );
+}
+
+#[gpui::test]
+async fn panel_open_a_row_without_story_files_opens_nothing(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    let before = item_count(&mut rig);
+    activate_line(&mut rig, "003 nothing");
+    assert_eq!(item_count(&mut rig), before, "R2.7: nothing is opened");
+}
+
+#[gpui::test]
+async fn panel_open_epic_md_control(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    activate_line(&mut rig, "Open EPICO.md");
+    assert_eq!(
+        active_path(&mut rig).as_deref(),
+        Some(".epico/EPICO.md"),
+        "R2.8"
+    );
+}
+
+// R6.3 — a symlinked story directory opens nothing, so no file is read through the link.
+#[gpui::test]
+async fn panel_open_a_symlinked_story_directory_opens_nothing(cx: &mut TestAppContext) {
+    let mut rig = rig(
+        cx,
+        &[
+            ("/work/project", corpus()),
+            (
+                "/outside/real",
+                json!({ "story.md": fm(&[("status", "validated")], "# Story - Outside\n") }),
+            ),
+        ],
+        &["/work/project"],
+    )
+    .await;
+    rig.fs
+        .insert_symlink(
+            "/work/project/.epico/stories/004-linked",
+            PathBuf::from("/outside/real"),
+        )
+        .await;
+    settle(&mut rig.cx);
+    let before = item_count(&mut rig);
+    activate_line(&mut rig, "004 linked");
+    assert_eq!(item_count(&mut rig), before);
+    assert_ne!(
+        active_path(&mut rig).as_deref(),
+        Some(".epico/stories/004-linked/story.md")
+    );
+}
+
+// Error path: the file vanished between the scan and the activation (events paused, so no
+// rescan intervenes). The workspace shows an error instead of failing silently.
+#[gpui::test]
+async fn panel_open_failure_is_shown_to_the_user(cx: &mut TestAppContext) {
+    let mut rig = rig(cx, &[("/work/project", corpus())], &["/work/project"]).await;
+    let notifications_before = rig
+        .workspace
+        .read_with(&rig.cx, |workspace, _| workspace.notification_ids().len());
+    rig.fs.pause_events();
+    rig.fs
+        .remove_file(
+            std::path::Path::new("/work/project/.epico/stories/002-tasks-only/tasks.md"),
+            fs::RemoveOptions {
+                recursive: false,
+                ignore_if_not_exists: false,
+            },
+        )
+        .await
+        .expect("remove tasks.md");
+    activate_line(&mut rig, "002 tasks-only");
+    let notifications_after = rig
+        .workspace
+        .read_with(&rig.cx, |workspace, _| workspace.notification_ids().len());
+    assert!(
+        notifications_after > notifications_before,
+        "an open failure becomes a visible error (workspace.show_error)"
+    );
+    rig.fs.unpause_events_and_flush();
+}
diff --git a/crates/epic_panel/src/panel_polish_tests.rs b/crates/epic_panel/src/panel_polish_tests.rs
new file mode 100644
index 0000000..86c354f
--- /dev/null
+++ b/crates/epic_panel/src/panel_polish_tests.rs
@@ -0,0 +1,256 @@
+// Story 042, task 10.1 — log values the frozen Q14 parser reads, and a right gutter for the
+// list's scrollbar (R8.3, R8.4, R2.1; Q5, Q14, Q16). Module path: `panel::panel_polish_tests`.
+//
+// Mounted from `src/panel.rs` as a child of `panel`, so it reaches the private helpers:
+//
+//     #[cfg(test)]
+//     #[path = "panel_polish_tests.rs"]
+//     #[rustfmt::skip]
+//     mod panel_polish_tests;
+//
+// SEAMS THE IMPLEMENTATION MUST EXPOSE (in `panel.rs`, private is enough):
+//   - `fn log_value(value: &str) -> String` — exists today.
+//   - `const ROW_END_PADDING: Pixels` — the right gutter every list row keeps, applied by
+//     `EpicPanel::render_entry` (the builder every row kind goes through) by naming it.
+//
+// Value form, from design.md §As Built (Log values) and task 10.1's Objective: a value holding
+// `=`, `"`, whitespace or a control character is written in double quotes; inside the quotes
+// `"` is `\u{22}`, `\` is `\u{5c}`, and every `\` begins a `\u{..}` escape. Every other value
+// is bare.
+
+use gpui::Pixels;
+use ui::ScrollbarStyle;
+
+use super::{ROW_END_PADDING, log_value};
+
+// ── the frozen Q14 parser ───────────────────────────────────────────────────
+
+/// `panel_live_tests::parses_as_key_values`, copied verbatim: it is private to that frozen
+/// module, so it cannot be called from here.
+fn frozen_parser(mut rest: &str) -> bool {
+    loop {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            return true;
+        }
+        let Some(eq) = rest.find('=') else {
+            return false;
+        };
+        let key = &rest[..eq];
+        if key.is_empty() || !key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            return false;
+        }
+        rest = &rest[eq + 1..];
+        if let Some(quoted) = rest.strip_prefix('"') {
+            let Some(end) = quoted.find('"') else {
+                return false;
+            };
+            rest = &quoted[end + 1..];
+        } else {
+            let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+            rest = &rest[end..];
+        }
+    }
+}
+
+/// The SAME rule as `frozen_parser`, step for step, but returning the `(key, token)` pairs it
+/// reads instead of a bool — so a test can see how many keys a line holds and where each
+/// value ends. A token keeps its quotes.
+fn frozen_tokens(mut rest: &str) -> Option<Vec<(&str, &str)>> {
+    let mut pairs = Vec::new();
+    loop {
+        rest = rest.trim_start();
+        if rest.is_empty() {
+            return Some(pairs);
+        }
+        let eq = rest.find('=')?;
+        let key = &rest[..eq];
+        if key.is_empty() || !key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            return None;
+        }
+        rest = &rest[eq + 1..];
+        let token;
+        if let Some(quoted) = rest.strip_prefix('"') {
+            let end = quoted.find('"')?;
+            token = &rest[..end + 2];
+            rest = &quoted[end + 1..];
+        } else {
+            let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+            token = &rest[..end];
+            rest = &rest[end..];
+        }
+        pairs.push((key, token));
+    }
+}
+
+/// Reads a token back to the value: a bare token is the value as it is; a quoted token's
+/// inside may hold only `\u{hex}` escapes, so `\"` and `\\` are rejected (`None`).
+fn decode_token(token: &str) -> Option<String> {
+    let Some(inner) = token
+        .strip_prefix('"')
+        .and_then(|rest| rest.strip_suffix('"'))
+    else {
+        return Some(token.to_string());
+    };
+    let mut value = String::new();
+    let mut rest = inner;
+    while let Some(slash) = rest.find('\\') {
+        value.push_str(&rest[..slash]);
+        let escape = rest[slash + 1..].strip_prefix("u{")?;
+        let close = escape.find('}')?;
+        let code = u32::from_str_radix(&escape[..close], 16).ok()?;
+        value.push(char::from_u32(code)?);
+        rest = &escape[close + 1..];
+    }
+    value.push_str(rest);
+    Some(value)
+}
+
+/// One value's checks on a line shaped like the panel's `event=problem` line.
+fn assert_one_token(raw: &str) {
+    let written = log_value(raw);
+    let line = format!("event=problem story={written} file=tasks.md");
+    assert!(
+        frozen_parser(&line),
+        "Q14: the frozen parser rejects {line:?}"
+    );
+    let tokens = frozen_tokens(&line).unwrap_or_else(|| panic!("not key=value: {line:?}"));
+    let keys: Vec<&str> = tokens.iter().map(|(key, _)| *key).collect();
+    assert_eq!(
+        keys,
+        ["event", "story", "file"],
+        "{raw:?} must stay one value, neither forging a key nor splitting: {line:?}"
+    );
+    assert_eq!(
+        tokens[1].1, written,
+        "the whole of {written:?} is the story value"
+    );
+    assert_eq!(
+        decode_token(&written).as_deref(),
+        Some(raw),
+        "{written:?} must read back to {raw:?} with only \\u{{..}} escapes"
+    );
+}
+
+// ── log values ──────────────────────────────────────────────────────────────
+
+/// Values that hold `"`, `\`, `=` and a space — the hostile ones first: each is built to close
+/// the quotes early and forge a key under the old `\"` escape.
+const HOSTILE: &[&str] = &[
+    // all four at once
+    r#"say "hi" \ k=v"#,
+    // closes the quotes and forges `event=`
+    r#"x" event=forged reason="y"#,
+    // a backslash right before the closing quote (`\"` would swallow it)
+    r#"trailing \"#,
+    // the old escape spelled out literally
+    r#"a \" b = c"#,
+    r#"C:\Program Files\"x"=1"#,
+];
+
+#[test]
+fn polish_quoted_value_has_no_raw_quote_or_backslash() {
+    for raw in HOSTILE {
+        let written = log_value(raw);
+        let inner = written
+            .strip_prefix('"')
+            .and_then(|rest| rest.strip_suffix('"'))
+            .unwrap_or_else(|| panic!("{raw:?} needs quotes, got {written:?}"));
+        assert!(
+            !inner.contains('"'),
+            "a raw `\"` inside the quotes of {written:?} (for {raw:?})"
+        );
+        for (at, _) in inner.match_indices('\\') {
+            assert!(
+                inner[at + 1..].starts_with("u{"),
+                "a raw `\\` at byte {at} inside {written:?}: every backslash must begin a \\u{{..}} escape"
+            );
+        }
+        assert!(
+            !raw.contains('"') || inner.contains("\\u{22}"),
+            "`\"` is written as \\u{{22}} in {written:?}"
+        );
+        assert!(
+            !raw.contains('\\') || inner.contains("\\u{5c}"),
+            "`\\` is written as \\u{{5c}} in {written:?}"
+        );
+    }
+}
+
+#[test]
+fn polish_frozen_parser_reads_every_line_as_three_keys() {
+    for raw in HOSTILE {
+        assert_one_token(raw);
+    }
+}
+
+/// The escape is a spelling the fix invents, so a THIRD value can collide with it: a value
+/// whose own text is `\u{22}` must not render the same as a value holding `"`.
+#[test]
+fn polish_escape_spelling_cannot_collide_with_a_literal_value() {
+    let pairs: &[(&str, &str)] = &[
+        (r#"a "b"#, r#"a \u{22}b"#),
+        (r#"a \b"#, r#"a \u{5c}b"#),
+        (r#"a"b"#, r#"a\u{22}b"#),
+        (r#"a\b c"#, r#"a\u{5c}b c"#),
+    ];
+    for (with_char, with_escape_text) in pairs {
+        let left = log_value(with_char);
+        let right = log_value(with_escape_text);
+        assert_ne!(
+            left, right,
+            "{with_char:?} and {with_escape_text:?} must stay distinguishable"
+        );
+        assert_one_token(with_char);
+        assert_one_token(with_escape_text);
+    }
+}
+
+#[test]
+fn polish_plain_value_stays_bare() {
+    for raw in ["project", "001-epic-panel", "tasks.md", "0", "watch_failed"] {
+        assert_eq!(log_value(raw), raw, "a plain value is written bare");
+        assert_one_token(raw);
+    }
+}
+
+// ── the scrollbar gutter ────────────────────────────────────────────────────
+
+/// The track the panel's `Scrollbars::always_visible` draws over the list's right edge: the
+/// default `ScrollbarStyle::Regular` thumb plus the `SCROLLBAR_PADDING` (4px, private to `ui`)
+/// it is inset by on each side. A gutter narrower than this leaves text under the thumb.
+fn scrollbar_track() -> f32 {
+    ScrollbarStyle::Regular.to_pixels().as_f32() + 2.0 * 4.0
+}
+
+#[test]
+fn polish_row_gutter_is_the_scrollbar_width() {
+    let gutter: Pixels = ROW_END_PADDING;
+    let track = scrollbar_track();
+    assert!(
+        gutter.as_f32() >= track,
+        "every row keeps a right gutter at least as wide as the scrollbar track ({track}px), got {gutter:?}"
+    );
+    // A gutter far wider than the track only takes width from the labels, scrollbar or not.
+    assert!(
+        gutter.as_f32() <= 2.0 * track,
+        "the gutter ({gutter:?}) is at most twice the track ({track}px)"
+    );
+}
+
+/// `render_entry` is the builder every row kind goes through (headers, stories, `Archived (N)`,
+/// "N more not shown", errors), so the gutter is applied there, by name.
+#[test]
+fn polish_row_builder_applies_the_gutter() {
+    let source = include_str!("panel.rs");
+    let start = source
+        .find("fn render_entry(")
+        .expect("panel.rs has `fn render_entry(`");
+    let body = &source[start..];
+    // The method ends at the first closing brace at its own indentation.
+    let end = body.find("\n    }\n").map_or(body.len(), |end| end + 6);
+    assert!(
+        body[..end].contains("ROW_END_PADDING"),
+        "render_entry must apply ROW_END_PADDING to every row"
+    );
+}
diff --git a/crates/epic_panel/src/panel_rows_tests.rs b/crates/epic_panel/src/panel_rows_tests.rs
new file mode 100644
index 0000000..878c5a4
--- /dev/null
+++ b/crates/epic_panel/src/panel_rows_tests.rs
@@ -0,0 +1,397 @@
+// Story 042, task 5.2 — rows, groups, empty states, badges, tooltips and the keyboard (R1.4,
+// R2.1, R2.3, R2.4, R2.5, R2.7, R2.8, R2.9, R2.10, R2.11, R2.12, R3.8, R6.1-R6.3; Q16).
+// Module path: `panel::panel_rows_tests`. See panel_test_helpers.rs for the assumed contract.
+
+use std::path::PathBuf;
+
+use gpui::TestAppContext;
