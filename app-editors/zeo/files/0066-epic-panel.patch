+//! `EpicPanel`: the dock panel that lists the stories under each local worktree's `.epic/`.
+//!
+//! The panel only reads. It looks for `.epic/` at the root of every local worktree (A6), keeps
+//! one `WorktreeEpic` per worktree that has one, and shows its dock button only while at least
+//! one exists (R1.2). The worktree scanner never loads the inside of a gitignored directory, so
+//! worktree events are used only to notice the root entry `.epic` appearing or disappearing;
+//! the contents are followed by `EpicWatch`.
+//!
+//! The dock the panel sits in is saved in the key-value store under the panel's key, as the
+//! Agent Tasks panel does: the workspace saves each panel's size, but a panel's dock only
+//! through that panel's settings, and this panel has none.
+
+use std::{
+    ops::Range,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+use anyhow::Result;
+use collections::HashMap;
+use db::kvp::KeyValueStore;
+use fs::Fs;
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{
+    Action, AnyElement, App, AsyncWindowContext, Context, Entity, EventEmitter, FocusHandle,
+    Focusable, IntoElement, Pixels, Render, ScrollStrategy, SharedString, Subscription, Task,
+    UniformListScrollHandle, WeakEntity, Window, actions, px, uniform_list,
+};
+use project::{Project, WorktreeId};
+use settings::SettingsStore;
+use ui::{Banner, ListItem, ScrollAxes, Scrollbars, Tooltip, WithScrollbar, prelude::*};
+use util::ResultExt as _;
+use workspace::{
+    OpenOptions, OpenVisible, Workspace,
+    dock::{DockPosition, Panel, PanelEvent},
+    workspace_error::{ErrorAction, ErrorSeverity, WorkspaceError},
+};
+
+use crate::format::{StatusCell, progress_text};
+use crate::scan::{
+    Area, DIRECTORY, EPIC_DIR_NAMES, EpicSnapshot, MAX_FILE_BYTES, RowProblem, StoryRow,
+    index_file_name, scan_epic_dir,
+};
+use crate::watch::EpicWatch;
+
+actions!(
+    epic_panel,
+    [
+        /// Toggles focus on the Epico Stories panel.
+        ToggleFocus,
+        /// Reads every worktree's `.epico/` (or legacy `.epic/`) again.
+        Refresh
+    ]
+);
+
+const NO_EPIC_DIR: &str = "No .epico/ directory in this project";
+const NO_STORIES: &str = "No stories yet";
+/// The absent number, status or progress: U+2014, as the plugin writes it.
+const ABSENT: &str = "\u{2014}";
+/// The right gutter every list row keeps, so the always-visible scrollbar never covers the
+/// progress or the badges. It is the `ui` scrollbar's track: the `ScrollbarStyle::Regular`
+/// thumb (6px) plus the 4px it is inset by on each side (`SCROLLBAR_PADDING`, private to
+/// `ui`). `Pixels` has no const arithmetic, so the sum is spelled out here;
+/// `panel_polish_tests` recomputes it from `ScrollbarStyle::Regular` and fails on drift.
+const ROW_END_PADDING: Pixels = px(14.);
+const UNKNOWN_STATUS: &str = "Status not known to this Zeo; the epic plugin may be newer";
+
+/// Registers the panel's `ToggleFocus` on every workspace created from now on. No default
+/// keybinding (A3): the palette action and the dock button are enough.
+pub fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _window, _cx| {
+        workspace.register_action(|workspace, _: &ToggleFocus, window, cx| {
+            workspace.toggle_panel_focus::<EpicPanel>(window, cx);
+        });
+    })
+    .detach();
+}
+
+/// One line of the panel, in display order. `worktree` indexes the panel's worktrees, `row`
+/// the snapshot's rows of `area`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DisplayEntry {
+    /// Shown only when more than one worktree has `.epic/` (R2.5).
+    WorktreeHeader { worktree: usize },
+    /// "Open EPIC.md" (R2.8).
+    OpenIndex { worktree: usize },
+    Story {
+        worktree: usize,
+        area: Area,
+        row: usize,
+    },
+    /// "Archived (N)", collapsed on creation (R2.3, R2.4).
+    ArchivedHeader {
+        worktree: usize,
+        count: usize,
+        expanded: bool,
+    },
+    /// "N more not shown" (R2.12).
+    MoreNotShown { worktree: usize, count: usize },
+    /// A scan error or a snapshot note, at the top of that worktree's section.
+    WorktreeError { worktree: usize, message: String },
+    /// R1.4, R2.11.
+    Empty { message: &'static str },
+}
+
+impl DisplayEntry {
+    /// The worktree whose section holds this line; `None` for an `Empty` line, which does not
+    /// say (see `EpicPanel::empty_line_worktree`).
+    fn worktree(&self) -> Option<usize> {
+        match self {
+            DisplayEntry::WorktreeHeader { worktree }
+            | DisplayEntry::OpenIndex { worktree }
+            | DisplayEntry::Story { worktree, .. }
+            | DisplayEntry::ArchivedHeader { worktree, .. }
+            | DisplayEntry::MoreNotShown { worktree, .. }
+            | DisplayEntry::WorktreeError { worktree, .. } => Some(*worktree),
+            DisplayEntry::Empty { .. } => None,
+        }
+    }
+}
+
+/// What a selected entry is, independent of where it sits: the list is rebuilt on every
+/// scan, so the selection is found again by this key rather than kept as an index.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum EntryKey {
+    WorktreeHeader(WorktreeId),
+    OpenIndex(WorktreeId),
+    /// The area too: `stories/X` and `archive/X` can exist side by side.
+    Story(WorktreeId, Area, String),
+    ArchivedHeader(WorktreeId),
+    MoreNotShown(WorktreeId),
+    WorktreeError(WorktreeId, String),
+    /// `None` for the project-wide "No .epic/ directory" line.
+    Empty(Option<WorktreeId>, &'static str),
+}
+
+struct Selection {
+    index: usize,
+    key: EntryKey,
+}
+
+/// What the panel holds for one local worktree whose root has `.epic/`.
+struct WorktreeEpic {
+    worktree_id: WorktreeId,
+    name: String,
+    epic_dir: PathBuf,
+    snapshot: Option<EpicSnapshot>,
+    error: Option<String>,
+    archived_expanded: bool,
+    /// The inode of the `.epic` directory the watch was started on. A `.epic` removed and
+    /// recreated gets a new one, and the old watch no longer covers it on Linux.
+    epic_inode: u64,
+    /// Dropping the last handle ends the watch. Shared so `sync_dirs`, which makes watch
+    /// syscalls, runs on the background executor.
+    watch: Arc<EpicWatch>,
+    /// Forwards the watch's debounced changes and its failure to the panel; dropped with it.
+    _watch_events: Task<()>,
+    /// The latest `sync_dirs`; a newer one replaces the whole wanted set, so dropping this one
+    /// loses nothing.
+    _sync_dirs: Task<()>,
+    /// Why live updates stopped, shown in the banner (R5.6).
+    watch_failure: Option<String>,
+    /// The first scan logs at `info`, every later one at `debug` (R8.1).
+    logged_first_scan: bool,
+    /// The problem kind last logged per `(dir_name, file)`, so each is logged once per change
+    /// of its reason (R8.2).
+    logged_problems: HashMap<(bool, String, String), &'static str>,
+}
+
+/// What the watch's background callbacks send to the panel.
+enum WatchMessage {
+    Changed,
+    Failed(String),
+}
+
+impl WorktreeEpic {
+    /// R8.1: `stories` and `archived` count every directory found, before the row cap.
+    fn log_scan(&mut self, snapshot: &EpicSnapshot) {
+        let problems = snapshot.notes.len()
+            + snapshot
+                .active
+                .iter()
+                .chain(&snapshot.archived)
+                .filter(|row| row.problem.is_some())
+                .count();
+        let level = if self.logged_first_scan {
+            log::Level::Debug
+        } else {
+            log::Level::Info
+        };
+        self.logged_first_scan = true;
+        log::log!(
+            level,
+            "epic_panel event=scan worktree={} stories={} archived={} problems={} duration_ms={}",
+            log_value(&self.name),
+            snapshot.active_total,
+            snapshot.archived_total,
+            problems,
+            snapshot.duration.as_millis()
+        );
+    }
+
+    /// R8.2: one `warn` per problem that is new or whose kind changed since the last scan. A
+    /// problem that goes away is forgotten, so it is logged again if it returns.
+    fn log_new_problems(&mut self, snapshot: &EpicSnapshot) {
+        let mut current = HashMap::default();
+        // Keyed by area too: `stories/X` and `archive/X` are different directories.
+        let rows = snapshot
+            .active
+            .iter()
+            .map(|row| (false, row))
+            .chain(snapshot.archived.iter().map(|row| (true, row)));
+        for (archived, row) in rows {
+            let Some(problem) = &row.problem else {
+                continue;
+            };
+            let (file, kind) = problem_kind(problem);
+            let key = (archived, row.dir_name.clone(), file.to_string());
+            if self.logged_problems.get(&key) != Some(&kind) {
+                log::warn!(
+                    "epic_panel event=problem worktree={} story={} file={} reason={}",
+                    log_value(&self.name),
+                    log_value(&row.dir_name),
+                    log_value(file),
+                    kind
+                );
+            }
+            current.insert(key, kind);
+        }
+        self.logged_problems = current;
+    }
+
+    /// Hands the watch the areas that exist plus every story directory the snapshot holds, so
+    /// an `archive/` or a story directory created after the watch started is followed too. A
+    /// symlinked or unreadable directory is left out: it is never read, so never watched.
+    fn sync_watched_dirs(&self, fs: Arc<dyn Fs>, snapshot: &EpicSnapshot, cx: &App) -> Task<()> {
+        let watch = self.watch.clone();
+        let epic_dir = self.epic_dir.clone();
+        let story_dirs: Vec<PathBuf> = snapshot
+            .active
+            .iter()
+            .chain(&snapshot.archived)
+            .filter(|row| !is_directory_problem(row.problem.as_ref()))
+            .map(|row| epic_dir.join(row.area.dir_name()).join(&row.dir_name))
+            .collect();
+        cx.background_spawn(async move {
+            let mut dirs = Vec::with_capacity(story_dirs.len() + 2);
+            for area in [Area::Active, Area::Archived] {
+                let path = epic_dir.join(area.dir_name());
+                if let Ok(Some(metadata)) = fs.metadata(&path).await
+                    && metadata.is_dir
+                    && !metadata.is_symlink
+                {
+                    dirs.push(path);
+                }
+            }
+            dirs.extend(story_dirs);
+            watch.sync_dirs(&dirs);
+        })
+    }
+}
+
+pub struct EpicPanel {
+    workspace: WeakEntity<Workspace>,
+    project: Entity<Project>,
+    fs: Arc<dyn Fs>,
+    focus_handle: FocusHandle,
+    position: DockPosition,
+    /// In the project's worktree order.
+    worktrees: Vec<WorktreeEpic>,
+    /// The latest detection-and-scan per worktree. Replacing one drops, and so cancels, the
+    /// previous, so a slow read can never overwrite a newer snapshot.
+    refreshes: HashMap<WorktreeId, Task<Result<()>>>,
+    /// Cached so `icon()`, which runs on every dock render, does no I/O (R1.2).
+    has_any_epic: bool,
+    entries: Vec<DisplayEntry>,
+    selection: Option<Selection>,
+    /// Set when a rebuild moved the selection to another index; the next render scrolls it
+    /// into view while the panel has focus.
+    scroll_to_selection: bool,
+    scroll_handle: UniformListScrollHandle,
+    _save_position: Task<()>,
+    _subscriptions: Vec<Subscription>,
+}
+
+impl EpicPanel {
+    /// Builds the panel for `workspace` in its saved dock (Right when nothing was saved, A8)
+    /// and starts looking for `.epic/` in every worktree the project already has.
+    pub fn load(
+        workspace: WeakEntity<Workspace>,
+        cx: AsyncWindowContext,
+    ) -> Task<Result<Entity<Self>>> {
+        cx.spawn(async move |cx| {
+            let kvp = cx.update(|_, cx| KeyValueStore::global(cx))?;
+            let saved = cx
+                .background_spawn(async move { kvp.read_kvp(<Self as Panel>::panel_key()) })
+                .await;
+            let position = saved_position(saved);
+            workspace.update_in(cx, |workspace, _window, cx| {
+                let project = workspace.project().clone();
+                let workspace = cx.weak_entity();
+                cx.new(|cx| Self::new(workspace, project, position, cx))
+            })
+        })
+    }
+
+    fn new(
+        workspace: WeakEntity<Workspace>,
+        project: Entity<Project>,
+        position: DockPosition,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let fs = project.read(cx).fs().clone();
+        let subscription = cx.subscribe(&project, Self::handle_project_event);
+        let mut this = Self {
+            workspace,
+            project,
+            fs,
+            focus_handle: cx.focus_handle(),
+            position,
+            worktrees: Vec::new(),
+            refreshes: HashMap::default(),
+            has_any_epic: false,
+            entries: Vec::new(),
+            selection: None,
+            scroll_to_selection: false,
+            scroll_handle: UniformListScrollHandle::new(),
+            _save_position: Task::ready(()),
+            _subscriptions: vec![subscription],
+        };
+        this.refresh_all(cx);
+        this.rebuild_entries();
+        this
+    }
+
+    fn handle_project_event(
+        &mut self,
+        _project: Entity<Project>,
+        event: &project::Event,
+        cx: &mut Context<Self>,
+    ) {
+        match event {
+            project::Event::WorktreeAdded(worktree_id)
+            | project::Event::WorktreeRemoved(worktree_id) => {
+                self.refresh_worktree(*worktree_id, cx);
+            }
+            project::Event::WorktreeUpdatedEntries(worktree_id, changes)
+                if changes
+                    .iter()
+                    .any(|(path, _, _)| EPIC_DIR_NAMES.contains(&path.as_unix_str())) =>
+            {
+                self.refresh_worktree(*worktree_id, cx);
+            }
+            project::Event::WorktreeOrderChanged => {
+                self.sort_worktrees(cx);
+                self.rebuild_entries();
+                cx.notify();
+            }
+            _ => {}
+        }
+    }
+
+    /// Checks whether the worktree's root holds `.epic/`, starts or stops its `WorktreeEpic`
+    /// accordingly, and reads it when present. Only local, visible worktrees are looked at: a
+    /// hidden one is a single file opened from outside the project, not a project root.
+    fn refresh_worktree(&mut self, worktree_id: WorktreeId, cx: &mut Context<Self>) {
+        let worktree = self
+            .project
+            .read(cx)
+            .worktree_for_id(worktree_id, cx)
+            .filter(|worktree| {
+                let worktree = worktree.read(cx);
+                worktree.is_local() && worktree.is_visible()
+            });
+        let Some(worktree) = worktree else {
+            self.refreshes.remove(&worktree_id);
+            self.stop_worktree(worktree_id, cx);
+            return;
+        };
+        let (name, root) = {
+            let worktree = worktree.read(cx);
+            (worktree.root_name_str().to_string(), worktree.abs_path())
+        };
+        let fs = self.fs.clone();
+        let task = cx.spawn(async move |this, cx| {
+            let found = cx
+                .background_spawn({
+                    let fs = fs.clone();
+                    let name = name.clone();
+                    async move {
+                        for dir_name in EPIC_DIR_NAMES {
+                            let epic_dir = root.join(dir_name);
+                            if let Some(inode) = epic_dir_inode(fs.as_ref(), &epic_dir, &name).await
+                            {
+                                return Some((epic_dir, inode));
+                            }
+                        }
+                        None
+                    }
+                })
+                .await;
+            let Some((epic_dir, inode)) = found else {
+                return this.update(cx, |panel, cx| panel.stop_worktree(worktree_id, cx));
+            };
+            this.update(cx, |panel, cx| {
+                panel.start_worktree(worktree_id, name, epic_dir.clone(), inode, cx)
+            })?;
+            let result = cx.background_spawn(scan_epic_dir(fs, epic_dir)).await;
+            this.update(cx, |panel, cx| panel.apply_scan(worktree_id, result, cx))
+        });
+        self.refreshes.insert(worktree_id, task);
+    }
+
+    /// Creates the worktree's `WorktreeEpic` and its watch, unless one already watches this
+    /// same `.epic` directory. A `.epic` recreated under the same path (a new inode) gets a
+    /// new watch, since the old one stopped covering it.
+    fn start_worktree(
+        &mut self,
+        worktree_id: WorktreeId,
+        name: String,
+        epic_dir: PathBuf,
+        epic_inode: u64,
+        cx: &mut Context<Self>,
+    ) {
+        if let Some(index) = self
+            .worktrees
+            .iter()
+            .position(|epic| epic.worktree_id == worktree_id)
+        {
+            if self.worktrees[index].epic_inode == epic_inode {
+                self.worktrees[index].name = name;
+                return;
+            }
+            self.worktrees.remove(index);
+        }
+        // The watch's callbacks run on a background thread, and may run once after the watch
+        // is dropped; they only send, and the receiving task holds a weak handle to the panel.
+        // A closed channel means the panel is gone: nothing to tell.
+        let (messages_tx, mut messages_rx) = mpsc::unbounded::<WatchMessage>();
+        let failures_tx = messages_tx.clone();
+        let watch = EpicWatch::start(
+            self.fs.clone(),
+            epic_dir.clone(),
+            move || {
+                messages_tx.unbounded_send(WatchMessage::Changed).ok();
+            },
+            move |reason| {
+                failures_tx
+                    .unbounded_send(WatchMessage::Failed(reason))
+                    .ok();
+            },
+            cx,
+        );
+        let watch_events = cx.spawn(async move |this, cx| {
+            while let Some(message) = messages_rx.next().await {
+                let handled = this.update(cx, |panel, cx| match message {
+                    WatchMessage::Changed => panel.refresh_worktree(worktree_id, cx),
+                    WatchMessage::Failed(reason) => panel.watch_failed(worktree_id, reason, cx),
+                });
+                if handled.is_err() {
+                    break;
+                }
+            }
+        });
+        self.worktrees.push(WorktreeEpic {
+            worktree_id,
+            name,
+            epic_dir,
+            snapshot: None,
+            error: None,
+            archived_expanded: false,
+            epic_inode,
+            watch: Arc::new(watch),
+            _watch_events: watch_events,
+            _sync_dirs: Task::ready(()),
+            watch_failure: None,
+            logged_first_scan: false,
+            logged_problems: HashMap::default(),
+        });
+        self.sort_worktrees(cx);
+        self.epic_presence_changed(cx);
+    }
+
+    fn stop_worktree(&mut self, worktree_id: WorktreeId, cx: &mut Context<Self>) {
+        let before = self.worktrees.len();
+        self.worktrees
+            .retain(|epic| epic.worktree_id != worktree_id);
+        if self.worktrees.len() != before {
+            self.epic_presence_changed(cx);
+        }
+    }
+
+    /// Lands a scan: the snapshot replaces the previous one, and the watch is told about every
+    /// directory that now exists, so an area or a story directory created later is followed.
+    /// A failed scan drops the previous snapshot and shows the error; the watch keeps running,
+    /// so a later fix shows up on its own.
+    fn apply_scan(
+        &mut self,
+        worktree_id: WorktreeId,
+        result: Result<EpicSnapshot>,
+        cx: &mut Context<Self>,
+    ) {
+        let fs = self.fs.clone();
+        let Some(epic) = self
+            .worktrees
+            .iter_mut()
+            .find(|epic| epic.worktree_id == worktree_id)
+        else {
+            return;
+        };
+        match result {
+            Ok(snapshot) => {
+                epic.log_scan(&snapshot);
+                epic.log_new_problems(&snapshot);
+                epic._sync_dirs = epic.sync_watched_dirs(fs, &snapshot, cx);
+                epic.snapshot = Some(snapshot);
+                epic.error = None;
+            }
+            Err(error) => {
+                let reason = scan_error_text(&error);
+                log::warn!(
+                    "epic_panel event=scan_failed worktree={} reason={}",
+                    log_value(&epic.name),
+                    log_value(&reason)
+                );
+                epic.snapshot = None;
+                epic.error = Some(reason);
+            }
+        }
+        self.rebuild_entries();
+        cx.notify();
+    }
+
+    /// The watch reports at most one failure; it is kept for the banner and logged once (R5.6,
+    /// R8.3). The list and Refresh keep working.
+    fn watch_failed(&mut self, worktree_id: WorktreeId, reason: String, cx: &mut Context<Self>) {
+        let Some(epic) = self
+            .worktrees
+            .iter_mut()
+            .find(|epic| epic.worktree_id == worktree_id)
+        else {
+            return;
+        };
+        if epic.watch_failure.is_some() {
+            return;
+        }
+        let reason = without_absolute_path(reason, "the watch failed");
+        log::warn!(
+            "epic_panel event=watch_failed worktree={} reason={}",
+            log_value(&epic.name),
+            log_value(&reason)
+        );
+        epic.watch_failure = Some(reason);
+        cx.notify();
+    }
+
+    /// "Live updates are off: <reason>. Use Refresh." when the project has one worktree with
+    /// `.epic/`. With several, one such line per failing worktree, prefixed with its name, so
+    /// the banner says which one stopped even when only one did (R5.6).
+    pub fn banner_text(&self) -> Option<String> {
+        let several = self.worktrees.len() > 1;
+        let lines: Vec<String> = self
+            .worktrees
+            .iter()
+            .filter_map(|epic| {
+                let line = format!(
+                    "Live updates are off: {}. Use Refresh.",
+                    epic.watch_failure.as_deref()?
+                );
+                Some(if several {
+                    format!("{}: {line}", epic.name)
+                } else {
+                    line
+                })
+            })
+            .collect();
+        (!lines.is_empty()).then(|| lines.join("\n"))
+    }
+
+    /// Updates the cached dock-button state and redraws; the dock observes the panel, so its
+    /// button bar re-reads `icon()` (R1.2, R1.3, R5.4).
+    fn epic_presence_changed(&mut self, cx: &mut Context<Self>) {
+        self.has_any_epic = !self.worktrees.is_empty();
+        self.rebuild_entries();
+        cx.notify();
+    }
+
+    fn sort_worktrees(&mut self, cx: &App) {
+        let order: HashMap<WorktreeId, usize> = self
+            .project
+            .read(cx)
+            .worktrees(cx)
+            .enumerate()
+            .map(|(index, worktree)| (worktree.read(cx).id(), index))
+            .collect();
+        self.worktrees
+            .sort_by_key(|epic| order.get(&epic.worktree_id).copied().unwrap_or(usize::MAX));
+    }
+
+    fn refresh(&mut self, _: &Refresh, _window: &mut Window, cx: &mut Context<Self>) {
+        self.refresh_all(cx);
+    }
+
+    /// Looks for `.epic/` again in every worktree the project has.
+    fn refresh_all(&mut self, cx: &mut Context<Self>) {
+        let worktree_ids: Vec<WorktreeId> = self
+            .project
+            .read(cx)
+            .worktrees(cx)
+            .map(|worktree| worktree.read(cx).id())
+            .collect();
+        for worktree_id in worktree_ids {
+            self.refresh_worktree(worktree_id, cx);
+        }
+    }
+
+    /// Flattens the worktrees' snapshots into the lines the panel shows, then finds the
+    /// selection again in the new list.
+    fn rebuild_entries(&mut self) {
+        let mut entries = Vec::new();
+        if self.worktrees.is_empty() {
+            entries.push(DisplayEntry::Empty {
+                message: NO_EPIC_DIR,
+            });
+        }
+        let several = self.worktrees.len() > 1;
+        for (worktree, epic) in self.worktrees.iter().enumerate() {
+            if several {
+                entries.push(DisplayEntry::WorktreeHeader { worktree });
+            }
+            if let Some(message) = &epic.error {
+                entries.push(DisplayEntry::WorktreeError {
+                    worktree,
+                    message: message.clone(),
+                });
+            }
+            let Some(snapshot) = &epic.snapshot else {
+                continue;
+            };
+            for note in &snapshot.notes {
+                entries.push(DisplayEntry::WorktreeError {
+                    worktree,
+                    message: note.clone(),
+                });
+            }
+            if snapshot.has_index {
+                entries.push(DisplayEntry::OpenIndex { worktree });
+            }
+            // The totals are counted before the row cap, so a capped tree is never "empty".
+            if snapshot.active_total == 0 && snapshot.archived_total == 0 {
+                entries.push(DisplayEntry::Empty {
+                    message: NO_STORIES,
+                });
+            }
+            entries.extend((0..snapshot.active.len()).map(|row| DisplayEntry::Story {
+                worktree,
+                area: Area::Active,
+                row,
+            }));
+            if snapshot.archived_total > 0 {
+                // R2.3: N is every archived story directory, including those past the cap.
+                entries.push(DisplayEntry::ArchivedHeader {
+                    worktree,
+                    count: snapshot.archived_total,
+                    expanded: epic.archived_expanded,
+                });
+                if epic.archived_expanded {
+                    entries.extend((0..snapshot.archived.len()).map(|row| DisplayEntry::Story {
+                        worktree,
+                        area: Area::Archived,
+                        row,
+                    }));
+                }
+            }
+            if snapshot.not_shown > 0 {
+                entries.push(DisplayEntry::MoreNotShown {
+                    worktree,
+                    count: snapshot.not_shown,
+                });
+            }
+        }
+        self.entries = entries;
+        self.restore_selection();
+    }
+
+    /// Finds the selected entry in the rebuilt list by its key. A story found only in the other
+    /// area (it was archived, or restored) keeps the selection there; one that moved into a
+    /// collapsed Archived group selects that group's header; an entry that is gone hands the
+    /// selection to whatever now sits at its place, so the keyboard keeps its position.
+    fn restore_selection(&mut self) {
+        let Some(selection) = self.selection.take() else {
+            return;
+        };
+        let previous = selection.index;
+        self.selection = if let Some(index) = self.position_of(|key| *key == selection.key) {
+            Some(Selection {
+                index,
+                key: selection.key,
+            })
+        } else if let Some(index) = self.story_in_other_area(&selection.key) {
+            self.selection_at(index)
+        } else if let Some(index) = self.collapsed_archive_holding(&selection.key) {
+            Some(Selection {
+                index,
+                key: selection.key,
+            })
+        } else {
+            self.selection_at(previous.min(self.entries.len().saturating_sub(1)))
+        };
+        if self
+            .selection
+            .as_ref()
+            .is_some_and(|selection| selection.index != previous)
+        {
+            self.scroll_to_selection = true;
+        }
+    }
+
+    fn position_of(&self, matches: impl Fn(&EntryKey) -> bool) -> Option<usize> {
+        (0..self.entries.len())
+            .position(|index| self.entry_key(index).is_some_and(|key| matches(&key)))
+    }
+
+    /// The index of the story `key` names, shown in either area.
+    fn story_in_other_area(&self, key: &EntryKey) -> Option<usize> {
+        let EntryKey::Story(worktree_id, _, dir_name) = key else {
+            return None;
+        };
+        self.position_of(|candidate| {
+            matches!(candidate, EntryKey::Story(id, _, name) if id == worktree_id && name == dir_name)
+        })
+    }
+
+    /// The index of the collapsed Archived header whose group holds the story `key` names.
+    fn collapsed_archive_holding(&self, key: &EntryKey) -> Option<usize> {
+        let EntryKey::Story(worktree_id, _, dir_name) = key else {
+            return None;
+        };
+        let (worktree, epic) = self
+            .worktrees
+            .iter()
+            .enumerate()
+            .find(|(_, epic)| epic.worktree_id == *worktree_id)?;
+        let archived = epic
+            .snapshot
+            .as_ref()?
+            .archived
+            .iter()
+            .any(|row| row.dir_name == *dir_name);
+        if !archived || epic.archived_expanded {
+            return None;
+        }
+        self.entries.iter().position(|entry| {
+            matches!(entry, DisplayEntry::ArchivedHeader { worktree: header, .. } if *header == worktree)
+        })
+    }
+
+    fn entry_key(&self, index: usize) -> Option<EntryKey> {
+        let worktree_id =
+            |worktree: usize| self.worktrees.get(worktree).map(|epic| epic.worktree_id);
+        Some(match self.entries.get(index)? {
+            DisplayEntry::WorktreeHeader { worktree } => {
+                EntryKey::WorktreeHeader(worktree_id(*worktree)?)
+            }
+            DisplayEntry::OpenIndex { worktree } => EntryKey::OpenIndex(worktree_id(*worktree)?),
+            DisplayEntry::Story {
+                worktree,
+                area,
+                row,
+            } => EntryKey::Story(
+                worktree_id(*worktree)?,
+                *area,
+                self.resolve_row(*worktree, *area, *row)?.dir_name.clone(),
+            ),
+            DisplayEntry::ArchivedHeader { worktree, .. } => {
+                EntryKey::ArchivedHeader(worktree_id(*worktree)?)
+            }
+            DisplayEntry::MoreNotShown { worktree, .. } => {
+                EntryKey::MoreNotShown(worktree_id(*worktree)?)
+            }
+            DisplayEntry::WorktreeError { worktree, message } => {
+                EntryKey::WorktreeError(worktree_id(*worktree)?, message.clone())
+            }
+            DisplayEntry::Empty { message } => {
+                EntryKey::Empty(self.empty_line_worktree(index), message)
+            }
+        })
+    }
+
+    /// The worktree an `Empty` line at `index` belongs to. `DisplayEntry::Empty` does not carry
+    /// one, but a worktree's lines all follow its header, error and index lines, so it is the
+    /// worktree of the closest earlier line that names one, or the first worktree when no line
+    /// precedes it. With no `.epic/` anywhere there is no worktree: `None`.
+    fn empty_line_worktree(&self, index: usize) -> Option<WorktreeId> {
+        let worktree = self
+            .entries
+            .get(..index)?
+            .iter()
+            .rev()
+            .find_map(DisplayEntry::worktree)
+            .unwrap_or(0);
+        self.worktrees.get(worktree).map(|epic| epic.worktree_id)
+    }
+
+    fn selection_at(&self, index: usize) -> Option<Selection> {
+        let key = self.entry_key(index)?;
+        Some(Selection { index, key })
+    }
+
+    fn select_index(&mut self, index: usize, cx: &mut Context<Self>) {
+        self.selection = self.selection_at(index);
+        self.scroll_handle
+            .scroll_to_item(index, ScrollStrategy::Nearest);
+        cx.notify();
+    }
+
+    /// R2.10: Down, wrapping from the last line to the first. Every line takes the selection,
+    /// rows and headers alike.
+    fn select_next(&mut self, _: &menu::SelectNext, _window: &mut Window, cx: &mut Context<Self>) {
+        let count = self.entries.len();
+        if count == 0 {
+            return;
+        }
+        let index = match &self.selection {
+            Some(selection) => (selection.index + 1) % count,
+            None => 0,
+        };
+        self.select_index(index, cx);
+    }
+
+    /// R2.10: Up, wrapping from the first line to the last.
+    fn select_previous(
+        &mut self,
+        _: &menu::SelectPrevious,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let count = self.entries.len();
+        if count == 0 {
+            return;
+        }
+        let index = match &self.selection {
+            Some(selection) if selection.index > 0 && selection.index < count => {
+                selection.index - 1
+            }
+            _ => count - 1,
+        };
+        self.select_index(index, cx);
+    }
+
+    /// R2.10: Enter activates the selected line.
+    fn confirm(&mut self, _: &menu::Confirm, window: &mut Window, cx: &mut Context<Self>) {
+        if let Some(index) = self.selection.as_ref().map(|selection| selection.index) {
+            self.activate(index, window, cx);
+        }
+    }
+
+    /// An Archived header toggles its group (R2.4), a story row opens its `open_target` (R2.6)
+    /// and "Open EPICO.md" opens the index (R2.8). A row with no target, which includes every
+    /// problem row and a symlinked directory, opens nothing (R2.7, R6.3); so does any other line.
+    /// "Open EPICO.md", or "Open EPIC.md" for a worktree still on the legacy layout.
+    fn index_label(&self, worktree: usize) -> String {
+        let index_file = self
+            .worktrees
+            .get(worktree)
+            .and_then(|epic| epic.snapshot.as_ref())
+            .map_or("EPICO.md", |snapshot| index_file_name(&snapshot.epic_dir));
+        format!("Open {index_file}")
+    }
+
+    fn activate(&mut self, index: usize, window: &mut Window, cx: &mut Context<Self>) {
+        match self.entries.get(index) {
+            Some(DisplayEntry::ArchivedHeader { worktree, .. }) => {
+                self.toggle_archived(*worktree, cx);
+            }
+            Some(DisplayEntry::Story {
+                worktree,
+                area,
+                row,
+            }) => {
+                let worktree = *worktree;
+                let target = self
+                    .resolve_row(worktree, *area, *row)
+                    .and_then(|row| row.open_target.clone());
+                if let Some(target) = target {
+                    self.open_file(worktree, target, window, cx);
+                }
+            }
+            Some(DisplayEntry::OpenIndex { worktree }) => {
+                let worktree = *worktree;
+                let index_file = self
+                    .worktrees
+                    .get(worktree)
+                    .and_then(|epic| epic.snapshot.as_ref())
+                    .map(|snapshot| snapshot.epic_dir.join(index_file_name(&snapshot.epic_dir)));
+                if let Some(index_file) = index_file {
+                    self.open_file(worktree, index_file, window, cx);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// Opens `abs_path` in an editor tab without adding a worktree for it. A failure is shown
+    /// to the user and logged, both with the worktree-relative path only (R8.4).
+    fn open_file(
+        &self,
+        worktree: usize,
+        abs_path: PathBuf,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(epic) = self.worktrees.get(worktree) else {
+            return;
+        };
+        let Some(root) = epic
+            .snapshot
+            .as_ref()
+            .and_then(|snapshot| snapshot.epic_dir.parent())
+            .map(Path::to_path_buf)
+        else {
+            return;
+        };
+        let worktree_name = epic.name.clone();
+        let relative = relative_path(&root, &abs_path);
+        let workspace = self.workspace.clone();
+        let fs = self.fs.clone();
+        cx.spawn_in(window, async move |_panel, cx| {
+            let opened: Result<()> = async {
+                cx.background_spawn({
+                    let abs_path = abs_path.clone();
+                    async move { check_open_target(fs.as_ref(), &abs_path).await }
+                })
+                .await?;
+                let options = OpenOptions {
+                    visible: Some(OpenVisible::None),
+                    ..Default::default()
+                };
+                let opening = workspace.update_in(cx, |workspace, window, cx| {
+                    workspace.open_abs_path(abs_path, options, window, cx)
+                })?;
+                opening.await.map(drop)
+            }
+            .await;
+            let Err(error) = opened else {
+                return;
+            };
+            // The outer contexts of `open_abs_path` carry the absolute path; the root cause
+            // can too, so the worktree's root is replaced by its name.
+            let root_text = root.to_string_lossy();
+            let reason = error
+                .root_cause()
+                .to_string()
+                .replace(format!("{:?}", root_text).trim_matches('"'), &worktree_name)
+                .replace(root_text.as_ref(), &worktree_name);
+            // Whatever form the path took, an absolute path never reaches the user or the log.
+            let reason = without_absolute_path(reason, "the file could not be opened");
+            log::warn!(
+                "epic_panel event=open_failed worktree={} path={} reason={}",
+                log_value(&worktree_name),
+                log_value(&relative),
+                log_value(&reason)
+            );
+            let message = format!("Could not open {worktree_name}/{relative}: {reason}");
+            workspace
+                .update(cx, |workspace, cx| {
+                    workspace.show_error(OpenFailed(message.into()), cx)
+                })
+                .log_err();
+        })
+        .detach();
+    }
+
+    /// A click: the panel takes the focus and the line the selection, then it acts as Enter
+    /// would. The focus is taken here because the Archived chevron is a button, which stops the
+    /// mouse-down that would otherwise focus the panel, and Up/Down would then go elsewhere.
+    fn select_and_activate(&mut self, index: usize, window: &mut Window, cx: &mut Context<Self>) {
+        window.focus(&self.focus_handle, cx);
+        self.select_index(index, cx);
+        self.activate(index, window, cx);
+    }
+
+    fn toggle_archived(&mut self, worktree: usize, cx: &mut Context<Self>) {
+        let Some(epic) = self.worktrees.get_mut(worktree) else {
+            return;
+        };
+        epic.archived_expanded = !epic.archived_expanded;
+        self.rebuild_entries();
+        cx.notify();
+    }
+
+    fn resolve_row(&self, worktree: usize, area: Area, row: usize) -> Option<&StoryRow> {
+        let snapshot = self.worktrees.get(worktree)?.snapshot.as_ref()?;
+        match area {
+            Area::Active => snapshot.active.get(row),
+            Area::Archived => snapshot.archived.get(row),
+        }
+    }
+
+    fn render_toolbar(&self, cx: &Context<Self>) -> impl IntoElement {
+        let focus_handle = self.focus_handle.clone();
+        h_flex()
+            .w_full()
+            .p_1()
+            .justify_end()
+            .border_b_1()
+            .border_color(cx.theme().colors().border)
+            .child(
+                IconButton::new("epic-panel-refresh", IconName::RotateCw)
+                    .icon_size(IconSize::Small)
+                    .icon_color(Color::Muted)
+                    .tooltip(Tooltip::text("Refresh"))
+                    // Dispatched on the panel's own node, so the click reaches the handler
+                    // whether or not the panel holds the focus (R5.5).
+                    .on_click(move |_, window, cx| {
+                        focus_handle.dispatch_action(&Refresh, window, cx)
+                    }),
+            )
+    }
+
+    fn render_entries(&self, range: Range<usize>, cx: &mut Context<Self>) -> Vec<AnyElement> {
+        range
+            .filter_map(|index| Some(self.render_entry(index, self.entries.get(index)?, cx)))
+            .collect()
+    }
+
+    fn render_entry(
+        &self,
+        index: usize,
+        entry: &DisplayEntry,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let selected = self
+            .selection
+            .as_ref()
+            .is_some_and(|selection| selection.index == index);
+        let item = ListItem::new(("epic-entry", index))
+            .toggle_state(selected)
+            .on_click(cx.listener(move |panel, _, window, cx| {
+                panel.select_and_activate(index, window, cx)
+            }));
+        let row = match entry {
+            DisplayEntry::WorktreeHeader { worktree } => item.child(
+                Label::new(
+                    self.worktrees
+                        .get(*worktree)
+                        .map(|epic| epic.name.clone())
+                        .unwrap_or_default(),
+                )
+                .size(LabelSize::Small)
+                .color(Color::Muted)
+                .truncate(),
+            ),
+            DisplayEntry::OpenIndex { worktree } => item
+                .start_slot(
+                    Icon::new(IconName::FileDoc)
+                        .size(IconSize::Small)
+                        .color(Color::Muted),
+                )
+                .child(
+                    Label::new(self.index_label(*worktree))
+                        .size(LabelSize::Small)
+                        .truncate(),
+                ),
+            DisplayEntry::Story {
+                worktree,
+                area,
+                row,
+            } => match self.resolve_row(*worktree, *area, *row) {
+                Some(row) => item
+                    .tooltip(Tooltip::text(row_tooltip(row)))
+                    .child(render_story(index, row)),
+                None => item,
+            },
+            DisplayEntry::ArchivedHeader {
+                count, expanded, ..
+            } => item
+                .toggle(Some(*expanded))
+                // The disclosure chevron is a button that stops the click from reaching the
+                // item, so it needs the same handler.
+                .on_toggle(cx.listener(move |panel, _, window, cx| {
+                    panel.select_and_activate(index, window, cx)
+                }))
+                .child(
+                    Label::new(format!("Archived ({count})"))
+                        .size(LabelSize::Small)
+                        .truncate(),
+                ),
+            DisplayEntry::MoreNotShown { count, .. } => item.child(
+                Label::new(format!("{count} more not shown"))
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .truncate(),
+            ),
+            DisplayEntry::WorktreeError { message, .. } => item
+                .start_slot(
+                    Icon::new(IconName::Warning)
+                        .size(IconSize::Small)
+                        .color(Color::Error),
+                )
+                .tooltip(Tooltip::text(message.clone()))
+                .child(
+                    Label::new(message.clone())
+                        .size(LabelSize::Small)
+                        .color(Color::Error)
+                        .truncate(),
+                ),
+            DisplayEntry::Empty { message } => item.child(
+                Label::new(*message)
+                    .size(LabelSize::Small)
+                    .color(Color::Muted)
+                    .truncate(),
+            ),
+        };
+        // `ListItem` takes no padding of its own, so the gutter is the wrapper's.
+        div()
+            .w_full()
+            .pr(ROW_END_PADDING)
+            .child(row)
+            .into_any_element()
+    }
+}
