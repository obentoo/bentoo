diff --git a/crates/epic_panel/src/format.rs b/crates/epic_panel/src/format.rs
new file mode 100644
index 0000000..a2d9fed
--- /dev/null
+++ b/crates/epic_panel/src/format.rs
@@ -0,0 +1,459 @@
+//! The epic plugin grammar, as pure functions: no paths, no I/O.
+//!
+//! Every function here ports one helper of the plugin's `scripts/epic-index.sh` (0.13.1, which
+//! sets `LC_ALL=C`), so the panel and `EPIC.md` read the same bytes the same way. Where the
+//! plugin's behaviour looks odd it is ported as written (design.md, Assumption A7).
+
+use std::borrow::Cow;
+use std::sync::LazyLock;
+
+use regex::Regex;
+
+/// The line that opens and closes a frontmatter block.
+const FENCE: &str = "---";
+
+/// The prefixes the plugin puts in front of a document's `# ` heading (R2.9).
+const TITLE_PREFIXES: [&str; 3] = ["Story - ", "Implementation Plan - ", "Design - "];
+
+/// `[[:space:]]` under `LC_ALL=C`: ASCII whitespace only, so a non-breaking space is content.
+fn is_c_space(c: char) -> bool {
+    matches!(c, ' ' | '\t' | '\n' | '\x0b' | '\x0c' | '\r')
+}
+
+/// epic-index.sh `trim`.
+fn trim_c_locale(text: &str) -> &str {
+    text.trim_matches(is_c_space)
+}
+
+/// The file's lines as `read -r` sees them: split at `\n`, no empty line after a final `\n`,
+/// and one trailing `\r` removed from each.
+fn lines(text: &str) -> impl Iterator<Item = &str> {
+    text.split_terminator('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+}
+
+/// epic-index.sh `front_value`: the file must open with `---`; key at column 0, first match;
+/// value trimmed; one pair of "…" or '…' stripped; unquoted value cut at " #" (and a value
+/// starting with '#' is empty); unterminated block -> None; empty value -> None; CRLF tolerated.
+pub fn front_value<'a>(text: &'a str, key: &str) -> Option<Cow<'a, str>> {
+    let mut lines = lines(text);
+    if lines.next()? != FENCE {
+        return None;
+    }
+    let mut found = None;
+    for line in lines {
+        if line == FENCE {
+            return found.and_then(scalar).map(Cow::Borrowed);
+        }
+        // The first line naming the key wins, even when its value turns out empty.
+        if found.is_none() {
+            found = line
+                .strip_prefix(key)
+                .and_then(|rest| rest.strip_prefix(':'));
+        }
+    }
+    // No closing line: every key of the file is absent (R3.3).
+    None
+}
+
+/// The value part of `front_value`, after the key and its colon.
+fn scalar(raw: &str) -> Option<&str> {
+    let value = trim_c_locale(raw);
+    let quoted = ['"', '\''].into_iter().find_map(|quote| {
+        value
+            .strip_prefix(quote)
+            .and_then(|inner| inner.strip_suffix(quote))
+    });
+    let value = match quoted {
+        // A quoted scalar keeps its content verbatim.
+        Some(inner) => inner,
+        None if value.starts_with('#') => "",
+        // A plain scalar ends at an inline ` #` comment (YAML's rule).
+        None => match value.find(" #") {
+            Some(comment) => trim_c_locale(&value[..comment]),
+            None => value,
+        },
+    };
+    (!value.is_empty()).then_some(value)
+}
+
+/// Checkbox counts of a `tasks.md`: every box, the closed ones, and the deferred ones.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Census {
+    pub total: u32,
+    pub closed: u32,
+    pub deferred: u32,
+}
+
+// The census and verdict patterns of epic-index.sh, verbatim except for the POSIX classes,
+// which are spelled out as `LC_ALL=C` defines them: `[[:space:]]` is `[ \t\n\r\x0B\x0C]` and
+// `[[:alnum:]]` is `[A-Za-z0-9]`. They are applied to one line at a time, so `^` and `$` are
+// the line's own ends, as in `[[ $line =~ … ]]`.
+
+/// box_re `^[[:space:]]*- \[([ x~])\]`.
+static BOX_RE: LazyLock<Regex> = LazyLock::new(|| compile(r"^[ \t\n\r\x0B\x0C]*- \[([ x~])\]"));
+/// deferred_re `(^|[^[:alnum:]_-])deferred:`.
+static DEFERRED_RE: LazyLock<Regex> = LazyLock::new(|| compile(r"(^|[^A-Za-z0-9_-])deferred:"));
+/// terminal_re `(^|[^[:alnum:]_-])(waived|n-a|superseded-by):`.
+static TERMINAL_RE: LazyLock<Regex> =
+    LazyLock::new(|| compile(r"(^|[^A-Za-z0-9_-])(waived|n-a|superseded-by):"));
+/// heading_re `^#{2,}[[:space:]]`: any level-two-or-deeper heading ends a section.
+static HEADING_RE: LazyLock<Regex> = LazyLock::new(|| compile(r"^#{2,}[ \t\n\r\x0B\x0C]"));
+/// verdict_re `^#{2,}[[:space:]]+[Vv]erdict([[:space:]].*)?$`.
+static VERDICT_RE: LazyLock<Regex> =
+    LazyLock::new(|| compile(r"^#{2,}[ \t\n\r\x0B\x0C]+[Vv]erdict([ \t\n\r\x0B\x0C].*)?$"));
+/// status_re `^[[:space:]]*(-[[:space:]]+)?status:[[:space:]]*([^[:space:]|]+)`.
+static STATUS_RE: LazyLock<Regex> = LazyLock::new(|| {
+    compile(
+        r"^[ \t\n\r\x0B\x0C]*(-[ \t\n\r\x0B\x0C]+)?status:[ \t\n\r\x0B\x0C]*([^ \t\n\r\x0B\x0C|]+)",
+    )
+});
+/// promoted_re `^[[:space:]]*(-[[:space:]]+)?promoted-to:[[:space:]]*([0-9][^[:space:]#]*)`.
+static PROMOTED_RE: LazyLock<Regex> = LazyLock::new(|| {
+    compile(
+        r"^[ \t\n\r\x0B\x0C]*(-[ \t\n\r\x0B\x0C]+)?promoted-to:[ \t\n\r\x0B\x0C]*([0-9][^ \t\n\r\x0B\x0C#]*)",
+    )
+});
+
+/// Compiles one of the fixed patterns above. They are literals checked by the tests, so a
+/// failure is a programming error, never a runtime condition.
+fn compile(pattern: &str) -> Regex {
+    Regex::new(pattern).expect("fixed epic grammar pattern compiles")
+}
+
+/// The file's lines as `IFS= read -r` sees them: split at `\n`, a last line without `\n`
+/// included, and a trailing `\r` kept (the patterns treat it as whitespace).
+fn raw_lines(text: &str) -> impl Iterator<Item = &str> {
+    text.split_terminator('\n')
+}
+
+/// epic-index.sh `census`: box_re `^[[:space:]]*- \[([ x~])\]`; deferred_re
+/// `(^|[^[:alnum:]_-])deferred:`; terminal_re `(^|[^[:alnum:]_-])(waived|n-a|superseded-by):`.
+/// No fence handling (A7).
+///
+/// `[x]` is closed. `[~]` with `deferred:` is deferred, even when a terminal qualifier is also
+/// present; `[~]` with a terminal qualifier alone is closed; any other `[~]` counts only in
+/// the total.
+pub fn census(text: &str) -> Census {
+    let mut census = Census::default();
+    for line in raw_lines(text) {
+        let Some(mark) = BOX_RE.captures(line).and_then(|captures| captures.get(1)) else {
+            continue;
+        };
+        census.total += 1;
+        match mark.as_str() {
+            "x" => census.closed += 1,
+            "~" if DEFERRED_RE.is_match(line) => census.deferred += 1,
+            "~" if TERMINAL_RE.is_match(line) => census.closed += 1,
+            _ => {}
+        }
+    }
+    census
+}
+
+/// A spike's `## Verdict` section: the first recorded `status:` and `promoted-to:`.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Verdict {
+    pub status: Option<String>,
+    pub promoted_to: Option<String>,
+}
+
+/// epic-index.sh `parse_verdict`: section from a heading `^#{2,}\s+[Vv]erdict(\s.*)?$` to the
+/// next `^#{2,}\s` heading; first `status:` (value cut at whitespace or '|'), first
+/// `promoted-to:` whose value starts with a digit (cut at whitespace or '#').
+///
+/// A line that does not match a key's pattern (an empty `status:`, a `promoted-to: NNN`) does
+/// not take that key's slot, and a later verdict section fills what an earlier one lacked.
+pub fn parse_verdict(text: &str) -> Verdict {
+    let mut verdict = Verdict::default();
+    let mut in_verdict = false;
+    for line in raw_lines(text) {
+        if HEADING_RE.is_match(line) {
+            in_verdict = VERDICT_RE.is_match(line);
+            continue;
+        }
+        if !in_verdict {
+            continue;
+        }
+        // One key per line, status first, exactly like the plugin's `if … elif`.
+        if verdict.status.is_none()
+            && let Some(value) = second_group(&STATUS_RE, line)
+        {
+            verdict.status = Some(value.to_string());
+        } else if verdict.promoted_to.is_none()
+            && let Some(value) = second_group(&PROMOTED_RE, line)
+        {
+            verdict.promoted_to = Some(value.to_string());
+        }
+    }
+    verdict
+}
+
+/// `BASH_REMATCH[2]` of a match of `re` against `line`.
+fn second_group<'a>(re: &Regex, line: &'a str) -> Option<&'a str> {
+    re.captures(line)
+        .and_then(|captures| captures.get(2))
+        .map(|group| group.as_str())
+}
+
+/// `NNN-slug` -> (Some("NNN" as written), "slug"); anything else -> (None, "").
+///
+/// epic-index.sh `scan_area` matches `^([0-9]+)-(.+)$` under `LC_ALL=C`, so only ASCII digits
+/// make a number and everything after the first hyphen is the slug.
+pub fn split_dir_name(name: &str) -> (Option<&str>, &str) {
+    let (number, rest) = leading_digits(name);
+    match rest.strip_prefix('-') {
+        Some(slug) if !number.is_empty() && !slug.is_empty() => (Some(number), slug),
+        _ => (None, ""),
+    }
+}
+
+/// `text` split after its leading ASCII digits, as `^([0-9]+)` matches under `LC_ALL=C`.
+fn leading_digits(text: &str) -> (&str, &str) {
+    let digits_end = text
+        .find(|c: char| !c.is_ascii_digit())
+        .unwrap_or(text.len());
+    text.split_at(digits_end)
+}
+
+/// Leading-zero strip for numeric comparison ("007" -> "7", "000" -> "0"); digits only,
+/// never parsed into an integer (epic-index.sh `strip_zeros`; a 20-digit name must not wrap).
+pub fn strip_zeros(digits: &str) -> &str {
+    match digits.trim_start_matches('0') {
+        "" => "0",
+        stripped => stripped,
+    }
+}
+
+/// First line starting with "# " (outside the frontmatter), without the "# " and without a
+/// leading "Story - " / "Implementation Plan - " / "Design - " prefix (R2.9).
+///
+/// A frontmatter block that never closes has no outside, so it has no title either.
+pub fn title(text: &str) -> Option<&str> {
+    let mut lines = lines(text).peekable();
+    if lines.peek() == Some(&FENCE) {
+        lines.next();
+        lines.by_ref().find(|line| *line == FENCE)?;
+    }
+    let heading = lines.find_map(|line| line.strip_prefix("# "))?;
+    let heading = TITLE_PREFIXES
+        .iter()
+        .find_map(|prefix| heading.strip_prefix(prefix))
+        .unwrap_or(heading);
+    let heading = trim_c_locale(heading);
+    (!heading.is_empty()).then_some(heading)
+}
+
+/// What epic-index.sh writes into a row's Status column, before its md_cell escaping.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum StatusCell {
+    /// No status recorded anywhere, or a spike without a verdict: "—".
+    Absent,
+    Lifecycle(Lifecycle),
+    /// A status outside the lifecycle, shown as written (R3.8).
+    Unknown(String),
+    /// A `scale: spike` story's `## Verdict`. `promoted_to` is kept only for a `promote`
+    /// verdict, the one the plugin renders a target for.
+    Verdict {
+        status: String,
+        promoted_to: Option<String>,
+        resolved: bool,
+    },
+    /// `status: superseded`, with story.md's `superseded-by:` pointer when there is one.
+    Superseded {
+        by: Option<String>,
+        resolved: bool,
+    },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Lifecycle {
+    Draft,
+    InProgress,
+    Done,
+    Validated,
+    Superseded,
+    Archived,
+}
+
+impl Lifecycle {
+    /// The exact frontmatter spelling; anything else is not a lifecycle value.
+    fn parse(value: &str) -> Option<Self> {
+        match value {
+            "draft" => Some(Self::Draft),
+            "in-progress" => Some(Self::InProgress),
+            "done" => Some(Self::Done),
+            "validated" => Some(Self::Validated),
+            "superseded" => Some(Self::Superseded),
+            "archived" => Some(Self::Archived),
+            _ => None,
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Draft => "draft",
+            Self::InProgress => "in-progress",
+            Self::Done => "done",
+            Self::Validated => "validated",
+            Self::Superseded => "superseded",
+            Self::Archived => "archived",
+        }
+    }
+}
+
+/// The absent cell: U+2014 EM DASH. An empty cell would read as a rendering bug.
+const ABSENT_CELL: &str = "\u{2014}";
+
+impl StatusCell {
+    /// Exactly the Status cell text epic-index.sh writes, before its md_cell escaping:
+    /// "—", "done", "promote to 12", "promote to 12 (missing)", "superseded by 7 (missing)" …
+    pub fn text(&self) -> String {
+        match self {
+            Self::Absent => ABSENT_CELL.to_string(),
+            Self::Lifecycle(lifecycle) => lifecycle.as_str().to_string(),
+            Self::Unknown(value) => value.clone(),
+            Self::Verdict {
+                status,
+                promoted_to: None,
+                ..
+            } => status.clone(),
+            Self::Verdict {
+                promoted_to: Some(target),
+                resolved,
+                ..
+            } => pointer_text("promote to", target, *resolved),
+            Self::Superseded { by: None, .. } => Lifecycle::Superseded.as_str().to_string(),
+            Self::Superseded {
+                by: Some(target),
+                resolved,
+            } => pointer_text("superseded by", target, *resolved),
+        }
+    }
+}
+
+/// A pointer is shown as written; one that resolves nowhere is named, not hidden.
+fn pointer_text(lead: &str, target: &str, resolved: bool) -> String {
+    if resolved {
+        format!("{lead} {target}")
+    } else {
+        format!("{lead} {target} (missing)")
+    }
+}
+
+/// Whether `pointer`'s leading ASCII digits name a known story. Resolution is numeric, so
+/// `7` finds `007-slug`; a pointer with no leading digits names nothing.
+fn resolves(pointer: &str, known: &dyn Fn(&str) -> bool) -> bool {
+    let (digits, _) = leading_digits(pointer);
+    !digits.is_empty() && known(strip_zeros(digits))
+}
+
+/// story.md's value for `key`, else tasks.md's: a `fast` or `spike` story has no story.md.
+pub fn story_then_tasks<'a>(
+    story_md: Option<&'a str>,
+    tasks_md: Option<&'a str>,
+    key: &str,
+) -> Option<Cow<'a, str>> {
+    story_md
+        .and_then(|text| front_value(text, key))
+        .or_else(|| tasks_md.and_then(|text| front_value(text, key)))
+}
+
+/// epic-index.sh `status_cell` precedence (R3.1, R3.4–R3.7). `known` answers whether a
+/// stripped number names a story directory in stories/ or archive/.
+///
+/// Reading `scale:` with story.md first is the plugin's registered exception to its shared
+/// scale rule; it is affordable because a cell gates nothing (A7).
+pub fn status_cell(
+    story_md: Option<&str>,
+    tasks_md: Option<&str>,
+    known: &dyn Fn(&str) -> bool,
+) -> StatusCell {
+    if story_then_tasks(story_md, tasks_md, "scale").as_deref() == Some("spike") {
+        return verdict_cell(tasks_md, known);
+    }
+    let Some(status) = story_then_tasks(story_md, tasks_md, "status") else {
+        return StatusCell::Absent;
+    };
+    match Lifecycle::parse(&status) {
+        Some(Lifecycle::Superseded) => {
+            // The pointer is read from story.md only, as the plugin does.
+            let by = story_md.and_then(|text| front_value(text, "superseded-by"));
+            let resolved = by.as_deref().is_some_and(|by| resolves(by, known));
+            StatusCell::Superseded {
+                by: by.map(Cow::into_owned),
+                resolved,
+            }
+        }
+        Some(lifecycle) => StatusCell::Lifecycle(lifecycle),
+        None => StatusCell::Unknown(status.into_owned()),
+    }
+}
+
+/// epic-index.sh `verdict_cell`: a spike's verdict, read from tasks.md only. No verdict is the
+/// em dash, never the frontmatter status a spike does not use.
+fn verdict_cell(tasks_md: Option<&str>, known: &dyn Fn(&str) -> bool) -> StatusCell {
+    let Verdict {
+        status,
+        promoted_to,
+    } = tasks_md.map(parse_verdict).unwrap_or_default();
+    let Some(status) = status else {
+        return StatusCell::Absent;
+    };
+    let promoted_to = promoted_to.filter(|_| status == "promote");
+    let resolved = promoted_to
+        .as_deref()
+        .is_some_and(|target| resolves(target, known));
+    StatusCell::Verdict {
+        status,
+        promoted_to,
+        resolved,
+    }
+}
+
+/// epic-index.sh `progress_cell`: None -> "—"; Some(c) -> "c/t" + " (+d deferred)" when d > 0.
+///
+/// An empty tasks.md is a measurement (`0/0`); only an absent one is the em dash.
+pub fn progress_text(census: Option<Census>) -> String {
+    let Some(Census {
+        total,
+        closed,
+        deferred,
+    }) = census
+    else {
+        return ABSENT_CELL.to_string();
+    };
+    if deferred > 0 {
+        format!("{closed}/{total} (+{deferred} deferred)")
+    } else {
+        format!("{closed}/{total}")
+    }
+}
+
