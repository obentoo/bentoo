+    assert_eq!(
+        text(Some(&story), None, &[]),
+        EM_DASH,
+        "a verdict in story.md is never read"
+    );
+}
+
+// ── superseded (R3.6) ───────────────────────────────────────────────────────
+
+#[test]
+fn cell_superseded_by_resolved_and_missing() {
+    let story = fm(&[("status", "superseded"), ("superseded-by", "7")], "");
+    assert_eq!(text(Some(&story), None, &["7"]), "superseded by 7");
+    assert_eq!(
+        text(Some(&story), None, &["8"]),
+        "superseded by 7 (missing)"
+    );
+}
+
+#[test]
+fn cell_superseded_without_a_pointer_is_plain() {
+    let story = fm(&[("status", "superseded")], "");
+    assert_eq!(text(Some(&story), None, &["7"]), "superseded");
+}
+
+// Hostile half: `superseded-by` is read from story.md ONLY (Assumption A7).
+#[test]
+fn cell_superseded_by_in_tasks_md_is_ignored() {
