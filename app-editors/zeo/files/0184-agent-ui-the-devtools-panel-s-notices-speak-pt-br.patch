diff --git a/crates/zeo_i18n/locales/en-US/devtools.ftl b/crates/zeo_i18n/locales/en-US/devtools.ftl
new file mode 100644
index 0000000..7dded9f
--- /dev/null
+++ b/crates/zeo_i18n/locales/en-US/devtools.ftl
@@ -0,0 +1,14 @@
+### The devtools panel's notices: agent_ui/src/devtools_browser.rs and devtools_run.rs (patch
+### 0184, USE devtools-panel). The English is the code's own, byte for byte. The wire errors the
+### browser extension receives (browser_wire.rs) are not here: the extension localizes them itself.
+
+devtools-chromium-not-found = Chromium not found: opened in your default browser
+devtools-chromium-or-edge-not-found = Chromium or Edge not found: opened in your default browser
+devtools-panel-no-local-project = Open a local project to open its devtools panel
+devtools-panel-open-failed = Could not open the devtools panel: { $error }
+devtools-no-dev-script = This project has no dev script
+devtools-no-dev-script-untrusted = This project has no dev script. devtools.dev_command is ignored because this project is not trusted.
+devtools-untrusted-override = devtools.dev_command is ignored because this project is not trusted: running its dev script instead.
+devtools-not-announced = The dev server did not connect to Zeo — is @lucascouts/zeo-devtools in its config?
+devtools-nothing-to-stop = No dev server started by Zeo for this project
+devtools-server-no-local-project = Open a local project to start its dev server
diff --git a/crates/zeo_i18n/locales/pt-BR/devtools.ftl b/crates/zeo_i18n/locales/pt-BR/devtools.ftl
new file mode 100644
index 0000000..689238b
--- /dev/null
+++ b/crates/zeo_i18n/locales/pt-BR/devtools.ftl
@@ -0,0 +1,14 @@
+### The devtools panel's notices in Brazilian Portuguese (patch 0184), translated by hand on
+### 2026-11-25; awaiting the operator's review as a native speaker. "dev server" and "dev script"
+### stay: they name the package.json script and what it starts.
+
+devtools-chromium-not-found = Chromium não encontrado: aberto no seu navegador padrão
+devtools-chromium-or-edge-not-found = Chromium ou Edge não encontrado: aberto no seu navegador padrão
+devtools-panel-no-local-project = Abra um projeto local para abrir o painel de devtools dele
+devtools-panel-open-failed = Não foi possível abrir o painel de devtools: { $error }
+devtools-no-dev-script = Este projeto não tem um dev script
+devtools-no-dev-script-untrusted = Este projeto não tem um dev script. devtools.dev_command é ignorado porque este projeto não é confiável.
+devtools-untrusted-override = devtools.dev_command é ignorado porque este projeto não é confiável: rodando o dev script dele no lugar.
+devtools-not-announced = O dev server não se conectou ao Zeo — o @lucascouts/zeo-devtools está na configuração dele?
+devtools-nothing-to-stop = Nenhum dev server iniciado pelo Zeo neste projeto
+devtools-server-no-local-project = Abra um projeto local para iniciar o dev server dele
