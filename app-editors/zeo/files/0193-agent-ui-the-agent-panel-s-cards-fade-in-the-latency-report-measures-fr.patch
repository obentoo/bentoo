 }
+
+#[cfg(test)]
+mod zeo_frame_duration_tests {
+    use super::*;
+
+    fn histogram(values_ms: &[u64]) -> Histogram<u64> {
+        let mut histogram = Histogram::<u64>::new(3).unwrap();
+        for value in values_ms {
+            histogram.record(value * 1_000_000).unwrap();
+        }
+        histogram
+    }
+
+    fn snapshot(draws_ms: &[u64], intervals_ms: &[u64]) -> gpui::FrameDurationSnapshot {
+        gpui::FrameDurationSnapshot {
+            dirty_to_present_histogram: histogram(&[]),
+            draw_duration_histogram: histogram(draws_ms),
+            present_interval_histogram: histogram(intervals_ms),
+            by_refresh_interval: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn frame_report_gives_draw_and_animation_percentiles() {
+        let mut report = String::new();
+        write_frame_durations(&mut report, &snapshot(&[2, 3, 40], &[16, 17]));
+        assert!(report.contains("Frames drawn: 3"), "{report}");
+        assert!(report.contains("Draw duration:"), "{report}");
+        assert!(
+            report.contains("Frames presented while animating: 2"),
+            "{report}"
+        );
+        assert!(
+            report.contains("Interval between frames while animating:"),
+            "{report}"
+        );
+        // The slowest frame is reported, not averaged away.
+        assert!(report.contains("40.0"), "{report}");
+    }
+
+    #[test]
+    fn frame_report_without_frames_says_so() {
+        let mut report = String::new();
+        write_frame_durations(&mut report, &snapshot(&[], &[]));
+        assert!(report.contains("No frames recorded yet."), "{report}");
+        assert!(!report.contains("Draw duration"), "{report}");
+    }
+}
