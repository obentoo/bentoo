+//! The agent panel's cards fade in (Zeo next §6.52, first step; operator, 2026-11-17: start with
+//! the cheapest and measure it).
+//!
+//! A card that appears -- the tasks card in each of its three states, the `/btw` answer, the
+//! question card and its minimized bar -- fades in over [`CARD_FADE_IN`] with an ease-out, and
+//! appears at once when the platform asks for reduced motion. The fade is applied to the card's
+//! own root rather than to a wrapper, so no layout changes: the tasks card is positioned by its
+//! overlay from the root's size, and a wrapper would stretch the pill to the free area.
+//!
+//! GPUI keeps an animation's start in the element state of its id, and drops that state when the
+//! element is not drawn in a frame, so a card fades again each time it reappears -- and not on the
+//! frames in between, where it is redrawn with the same id. Only appearing is animated: fading out
+//! needs the card kept on screen after its state says it is gone, which no card here supports yet.
+//! The floating thread controls are left alone: they are always present, and their hover change is
+//! a style, not an appearance.
+
+use std::time::Duration;
+
+use gpui::{
+    Animation, AnimationExt as _, AnyElement, App, ElementId, IntoElement, Styled, ease_out_quint,
+};
+
+/// How long a card takes to fade in: short enough to read as a response to what caused it.
+pub(crate) const CARD_FADE_IN: Duration = Duration::from_millis(150);
+
+/// The opacity a fade-in draws at `delta`, the animation's eased progress in `0.0..=1.0`.
+pub(crate) fn fade_in_opacity(delta: f32) -> f32 {
+    delta.clamp(0., 1.)
+}
+
+/// A card's root, fading in when it appears.
+pub(crate) trait FadeIn: Styled + IntoElement + 'static {
+    /// This card as an element that fades in under `id` unless the platform asks for reduced
+    /// motion. `id` must be stable while the card stays up and unique among the cards.
+    fn fade_in(self, id: impl Into<ElementId>, cx: &App) -> AnyElement {
+        if cx.reduce_motion() {
+            return self.into_any_element();
+        }
+        self.with_animation(
+            id,
+            Animation::new(CARD_FADE_IN).with_easing(ease_out_quint()),
+            |card, delta| card.opacity(fade_in_opacity(delta)),
+        )
+        .into_any_element()
+    }
+}
+
+impl<E: Styled + IntoElement + 'static> FadeIn for E {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn card_fade_ends_fully_opaque_and_starts_invisible() {
+        assert_eq!(fade_in_opacity(0.), 0.);
+        assert_eq!(fade_in_opacity(1.), 1.);
+        // An easing may overshoot; the card never draws past opaque or below invisible.
+        assert_eq!(fade_in_opacity(1.2), 1.);
+        assert_eq!(fade_in_opacity(-0.1), 0.);
+        assert!(ease_out_quint()(1.) >= 1. - f32::EPSILON);
+    }
+
+    #[test]
+    fn card_fade_is_short_enough_to_read_as_a_response() {
+        assert!(CARD_FADE_IN <= Duration::from_millis(200));
+    }
+}
