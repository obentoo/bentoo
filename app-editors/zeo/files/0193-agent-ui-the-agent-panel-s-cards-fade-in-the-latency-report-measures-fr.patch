+}
+
+/// Zeo (patch 0193): how long the window takes to draw a frame, and how far apart frames are
+/// presented while it animates, both since the window opened. A frame budget is 16.67 ms at
+/// 60 Hz; an animation that pushes the intervals past it drops frames.
+fn write_frame_durations(report: &mut String, frames: &gpui::FrameDurationSnapshot) {
+    const PERCENTILES: &[(&str, f64)] = &[
+        ("p50  ", 0.50),
+        ("p90  ", 0.90),
+        ("p99  ", 0.99),
+        ("max  ", 1.0),
+    ];
+    report.push_str("\nFrame Durations (since the window opened)\n");
+    report.push_str("=========================================\n");
+    let draws = &frames.draw_duration_histogram;
+    if draws.len() == 0 {
+        report.push_str("No frames recorded yet.\n");
+        return;
+    }
+    report.push_str(&format!("Frames drawn: {}\n", draws.len()));
+    write_latency_percentiles(report, "Draw duration", draws, PERCENTILES);
+    let animating = &frames.present_interval_histogram;
+    report.push_str(&format!(
+        "\nFrames presented while animating: {}\n",
+        animating.len()
+    ));
+    if animating.len() > 0 {
+        write_latency_percentiles(
+            report,
+            "Interval between frames while animating",
+            animating,
+            PERCENTILES,
+        );
+    }
 }
 
 #[derive(Default)]
