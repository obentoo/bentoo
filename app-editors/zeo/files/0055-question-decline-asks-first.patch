+    let (view, thread, mut cx) = setup(cx).await;
+    let q = ask(
+        &thread,
+        two_questions(),
+        "Pick a colour and a language.",
+        &mut cx,
+    );
+    assert!(
+        view.read_with(&cx, |v, _| v.has_elicitation_form_state(&q.id)),
+        "precondition: the pending question has a form state"
+    );
+
+    decline(&view, &q, &mut cx);
+    settle(&mut cx);
+
+    assert!(
+        !cx.has_pending_prompt(),
+        "R2.1: no confirmation for an untouched card"
+    );
+    assert_eq!(
+        status(&thread, &q.id, &cx),
+        "declined",
+        "R2.1: declined at once"
+    );
+    assert_eq!(sent(&q), "decline", "R2.5: the agent receives Decline");
+}
