+    settle(&mut cx);
+
+    assert!(!cx.has_pending_prompt(), "R2.10: Cancel never asks");
+    assert_eq!(status(&thread, &q.id, &cx), "canceled");
+}
diff --git a/crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_decline_harness.rs b/crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_decline_harness.rs
