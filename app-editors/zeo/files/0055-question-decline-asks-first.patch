+async fn decline_contract_untouched_card_decline_does_not_ask(cx: &mut TestAppContext) {
+    // Hostile half: the same keyboard route on an untouched card must not ask.
+    let (view, thread, mut cx) = setup(cx).await;
+    bind_default_keymap(&mut cx);
+    let q = ask(&thread, one_question(), "Pick a colour.", &mut cx);
+
+    focus_other_box(&view, &q, None, &mut cx);
+    press_keys(&mut cx, "tab tab enter");
+    settle(&mut cx);
+
+    assert!(!cx.has_pending_prompt(), "R2.1: untouched, no confirmation");
+    assert_eq!(status(&thread, &q.id, &cx), "declined");
+    assert_eq!(sent(&q), "decline");
+}
+
+#[gpui::test]
+async fn decline_contract_card_cancel_does_not_ask(cx: &mut TestAppContext) {
+    // R2.10: one stop further, the card's Cancel on a touched card aborts at once.
+    let (view, thread, mut cx) = setup(cx).await;
+    bind_default_keymap(&mut cx);
+    let q = ask(&thread, one_question(), "Pick a colour.", &mut cx);
+
