@@ -0,0 +1,299 @@
+//! Shared harness for story 035's Decline tests (Tasks 3.2, 3.3, 3.4). Holds no tests.
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view/thread_view.rs`'s `mod tests { .. }`,
+//! declare `mod elicitation_decline_harness;` beside `mod decline_confirmation_tests;`,
+//! `mod elicitation_skipped_tests;` and `mod decline_contract_tests;`. An inline module of a
+//! non-mod-rs file, so these resolve to
+//! `crates/agent_ui/src/conversation_view/thread_view/tests/<name>.rs`. Living under
+//! `thread_view` is what lets them reach `ThreadView`'s private `decline_elicitation`,
+//! `cancel_elicitation` and `elicitation_form_states`.
+//!
+//! Setup: a visible agent panel in a workspace window (the shape of story 020's
+//! `setup_panel_in_workspace`, restated here because that one is private to `agent_panel`'s
+//! tests), a thread on a `StubAgentConnection`, and questions raised on that thread exactly as
+//! the adapter raises them: a session-scoped form elicitation. Each question's response is
+//! captured, so a test can see what was SENT to the agent, not only the card's status.
+//!
+//! Prompts: `window.prompt` lands on the test platform (`init_test` installs no in-app prompt
+//! renderer), driven with `cx.has_pending_prompt()` / `cx.simulate_prompt_answer(label)` as in
+//! `tasks_card/stop_tests.rs`. Answering by label necessarily pins R2.11's two button labels.
+
+use std::{cell::RefCell, collections::BTreeMap, path::Path, rc::Rc, time::Duration};
+
+use acp_thread::{AcpThread, ElicitationEntryId, ElicitationStatus, StubAgentConnection};
+use agent_client_protocol::v2::schema as acp_v2;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, UpdateGlobal as _, VisualTestContext};
+use project::Project;
+use serde_json::json;
+use settings::{ElicitationPlacement, SettingsStore};
+use workspace::MultiWorkspace;
+
+use super::super::ThreadView;
+use crate::AgentPanel;
+
+pub(super) const MARKER: &str = "_askUserQuestionCustomAnswer";
+
+pub(super) type Response = Rc<RefCell<Option<acp_v2::CreateElicitationResponse>>>;
+
+pub(super) struct Question {
+    pub id: ElicitationEntryId,
+    pub schema: acp_v2::ElicitationSchema,
+    pub response: Response,
+}
+
+/// A visible panel with one thread open on a stub connection.
+pub(super) async fn setup(
+    cx: &mut TestAppContext,
+) -> (Entity<ThreadView>, Entity<AcpThread>, VisualTestContext) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.update(|cx| {
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+    fs.insert_tree("/project", json!({ "file.txt": "" })).await;
+    let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+    let multi_workspace =
+        cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace
+        .read_with(cx, |multi_workspace, _cx| {
+            multi_workspace.workspace().clone()
+        })
+        .expect("workspace");
+    let mut cx = VisualTestContext::from_window(multi_workspace.into(), cx);
+    cx.simulate_resize(gpui::size(gpui::px(1200.), gpui::px(800.)));
+    let panel = workspace.update_in(&mut cx, |workspace, window, cx| {
+        let panel = cx.new(|cx| AgentPanel::new(workspace, window, cx));
+        workspace.add_panel(panel.clone(), window, cx);
+        workspace.focus_panel::<AgentPanel>(window, cx);
+        panel
+    });
+    cx.run_until_parked();
+    crate::test_support::open_thread_with_custom_connection(
+        &panel,
+        StubAgentConnection::new(),
+        &mut cx,
+    );
+    cx.run_until_parked();
+    let thread_view = panel
+        .read_with(&cx, |panel, cx| panel.active_thread_view(cx))
+        .expect("a thread view is active");
+    let thread = panel
+        .read_with(&cx, |panel, cx| panel.active_agent_thread(cx))
+        .expect("a thread is active");
+    (thread_view, thread, cx)
+}
+
+/// A free-text field carrying the custom-answer marker for `question_id`.
+pub(super) fn marked(question_id: &str) -> acp_v2::StringPropertySchema {
+    let mut schema = acp_v2::StringPropertySchema::new().title("Other");
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        MARKER.to_string(),
+        json!({ "questionId": question_id, "isCustomAnswer": true }),
+    );
+    schema.meta = Some(meta);
+    schema
+}
+
+pub(super) fn choices(values: &[&str]) -> acp_v2::StringPropertySchema {
+    acp_v2::StringPropertySchema::new()
+        .enum_values(values.iter().map(|v| v.to_string()).collect::<Vec<_>>())
+}
+
+/// One AskUserQuestion question: options plus its "Other" box.
+pub(super) fn one_question() -> acp_v2::ElicitationSchema {
+    acp_v2::ElicitationSchema::new()
+        .property("question_0", choices(&["Red", "Blue"]), false)
+        .property("question_0_custom", marked("question_0"), false)
+}
+
+/// Two AskUserQuestion questions: two pages on the card.
+pub(super) fn two_questions() -> acp_v2::ElicitationSchema {
+    acp_v2::ElicitationSchema::new()
+        .property("question_0", choices(&["Red", "Blue"]), false)
+        .property("question_0_custom", marked("question_0"), false)
+        .property("question_1", choices(&["Rust", "Go"]), false)
+        .property("question_1_custom", marked("question_1"), false)
+}
+
+/// Raises a form elicitation on `thread` and captures its response.
+pub(super) fn ask(
+    thread: &Entity<AcpThread>,
+    schema: acp_v2::ElicitationSchema,
+    message: &str,
+    cx: &mut VisualTestContext,
+) -> Question {
+    let session_id = thread.read_with(cx, |thread, _| thread.session_id().clone());
+    let request = acp_v2::CreateElicitationRequest::new(
+        acp_v2::ElicitationFormMode::new(
+            acp_v2::ElicitationSessionScope::new(session_id),
+            schema.clone(),
+        ),
+        message,
+    );
+    let (id, task) = thread.update(cx, |thread, cx| {
+        thread
+            .request_elicitation_with_id(request, cx)
+            .expect("the question is a valid elicitation")
+    });
+    let response: Response = Rc::default();
+    let slot = response.clone();
+    cx.update(|_, cx| {
+        cx.spawn(async move |_| {
+            *slot.borrow_mut() = Some(task.await);
+        })
+        .detach()
+    });
+    cx.run_until_parked();
+    Question {
+        id,
+        schema,
+        response,
+    }
+}
+
+pub(super) fn status(
+    thread: &Entity<AcpThread>,
+    id: &ElicitationEntryId,
+    cx: &VisualTestContext,
+) -> &'static str {
+    thread.read_with(cx, |thread, _| {
+        match thread.elicitation(id).map(|(_, e)| &e.status) {
+            Some(ElicitationStatus::Pending { .. }) => "pending",
+            Some(ElicitationStatus::Accepted) => "accepted",
+            Some(ElicitationStatus::Declined) => "declined",
+            Some(ElicitationStatus::Canceled) => "canceled",
+            Some(ElicitationStatus::Completed) => "completed",
+            None => "missing",
+        }
+    })
+}
+
+/// What was sent to the agent for `question`: "decline", "accept", "cancel", or "nothing".
+pub(super) fn sent(question: &Question) -> &'static str {
+    match question.response.borrow().as_ref().map(|r| &r.action) {
+        None => "nothing",
+        Some(acp_v2::ElicitationAction::Decline) => "decline",
+        Some(acp_v2::ElicitationAction::Accept(_)) => "accept",
+        Some(_) => "cancel",
+    }
+}
+
+pub(super) fn entry_ix(
+    thread: &Entity<AcpThread>,
+    id: &ElicitationEntryId,
+    cx: &VisualTestContext,
+) -> usize {
+    thread
+        .read_with(cx, |thread, _| thread.elicitation(id).map(|(ix, _)| ix))
+        .expect("the elicitation is in the thread")
+}
+
+pub(super) fn type_into(
+    thread_view: &Entity<ThreadView>,
+    question: &Question,
+    field: &str,
+    text: &str,
+    cx: &mut VisualTestContext,
+) {
+    let editor = thread_view
+        .read_with(cx, |view, _| {
+            view.elicitation_text_field(&question.id, field)
+        })
+        .unwrap_or_else(|| panic!("{field} is a text field of a pending question"));
+    editor.update_in(cx, |editor, window, cx| editor.set_text(text, window, cx));
+    cx.run_until_parked();
+}
+
+pub(super) fn select(
+    thread_view: &Entity<ThreadView>,
+    question: &Question,
+    field: &str,
+    value: &str,
+    cx: &mut VisualTestContext,
+) {
+    thread_view.update(cx, |view, cx| {
+        view.elicitation_form_states
+            .get_mut(&question.id)
+            .expect("a pending question has a form state")
+            .set_single_select(field, value.to_string());
+        cx.notify();
+    });
+    cx.run_until_parked();
+}
+
+pub(super) fn set_page(
+    thread_view: &Entity<ThreadView>,
+    question: &Question,
+    page: usize,
+    cx: &mut VisualTestContext,
+) {
+    thread_view.update(cx, |view, cx| {
+        view.elicitation_form_states
+            .get_mut(&question.id)
+            .expect("a pending question has a form state")
+            .set_page(page);
+        cx.notify();
+    });
+    cx.run_until_parked();
+}
+
+/// Everything the operator has put on the card: the collected answers and the page shown.
+pub(super) fn card_state(
+    thread_view: &Entity<ThreadView>,
+    question: &Question,
+    cx: &VisualTestContext,
+) -> Option<(BTreeMap<String, String>, usize)> {
+    thread_view.read_with(cx, |view, cx| {
+        let form = view.elicitation_form_states.get(&question.id)?;
+        let answers = form
+            .collect(&question.schema, cx)
+            .ok()?
+            .into_iter()
+            .map(|(name, value)| (name, format!("{value:?}")))
+            .collect();
+        Some((answers, form.page()))
+    })
+}
+
+pub(super) fn decline(
+    thread_view: &Entity<ThreadView>,
+    question: &Question,
+    cx: &mut VisualTestContext,
+) {
+    let id = question.id.clone();
+    thread_view.update_in(cx, |view, window, cx| {
+        view.decline_elicitation(id, window, cx)
+    });
+    cx.run_until_parked();
+}
+
+pub(super) fn settle(cx: &mut VisualTestContext) {
+    cx.run_until_parked();
+    cx.executor().advance_clock(Duration::from_secs(2));
+    cx.run_until_parked();
+}
+
+pub(super) fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+pub(super) fn set_placement(placement: ElicitationPlacement, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, |settings| {
+                settings.agent.get_or_insert_default().elicitation_placement = Some(placement);
+            });
+        });
+    });
+    cx.run_until_parked();
+}
+
+/// The debug selector of the "Skipped" row for the entry at `ix` (Task 3.3 Objective).
+pub(super) fn skipped_selector(ix: usize) -> &'static str {
+    Box::leak(format!("elicitation-skipped-{ix}").into_boxed_str())
+}
diff --git a/crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_skipped_tests.rs b/crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_skipped_tests.rs
