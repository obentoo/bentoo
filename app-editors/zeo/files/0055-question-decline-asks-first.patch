+/// Whether a form is an AskUserQuestion card: some property carries the
+/// custom-answer marker. The marker is the rule, never the field's name.
+pub(crate) fn is_question_shaped(schema: &acp::ElicitationSchema) -> bool {
+    schema
+        .properties
+        .values()
+        .any(|property| custom_answer_companion_of(property).is_some())
+}
