+//! Contract: the card's own Decline reaches the conditional path, in both placements (story 035,
+//! Task 3.4; R2.2, R2.5, R2.10, Q11, Q12).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view/thread_view.rs`'s `mod tests { .. }`,
+//! declare `mod decline_contract_tests;` beside `mod elicitation_decline_harness;`.
+//! Resolves to `crates/agent_ui/src/conversation_view/thread_view/tests/decline_contract_tests.rs`.
+//!
+//! Where 3.2's tests call `decline_elicitation` directly, these go through the rendered card:
+//! the operator's keyboard route (Q12). Focus the question's "Other" box, type into it with real
+//! keystrokes (so the form state the card renders from is the one that changes), then Tab past
+//! Submit to Decline and press Enter -- the card's tab order is [fields...] [Submit] [Decline]
+//! [Cancel], as `elicitation.rs`'s `form_tab_order_*` test pins for the card itself.
+//!
+//! Audited surface: the key sequence ("tab tab enter" from the last field) is the one pin on
+//! the card's layout. If Run mode finds the panel inserts another focus stop, adjust the
+//! sequence -- never the assertions. Buttons carry no debug selector, so a mouse click on
+//! Decline cannot be located here; the GUI proof (Task 4.2) clicks it with the mouse.
+//! ⚠ Fidelity: drives the real card, but not a pointer click on it.
+
+use gpui::{KeyUpEvent, Keystroke, PlatformInput, TestAppContext, VisualTestContext};
+use settings::ElicitationPlacement;
+
+use super::super::ThreadView;
+use super::elicitation_decline_harness::*;
+
+fn bind_default_keymap(cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        let bindings = settings::KeymapFile::load_asset_allow_partial_failure(
+            "keymaps/default-linux.json",
+            cx,
+        )
+        .expect("default keymap should load");
+        cx.bind_keys(bindings);
+    });
+}
+
+fn press_keys(cx: &mut VisualTestContext, keys: &'static str) {
+    for key in keys.split_whitespace() {
+        cx.simulate_keystrokes(key);
+        cx.update(|window, cx| {
+            // Click handlers activate buttons on key release.
+            window.dispatch_event(
+                PlatformInput::KeyUp(KeyUpEvent {
+                    keystroke: Keystroke::parse(key).expect("valid test keystroke"),
+                }),
+                cx,
+            );
+        });
+        cx.run_until_parked();
+    }
+}
+
+/// Focuses `question`'s "Other" box on the rendered card and optionally types into it.
+fn focus_other_box(
+    view: &gpui::Entity<ThreadView>,
+    question: &Question,
+    text: Option<&str>,
+    cx: &mut VisualTestContext,
+) {
+    draw(cx);
+    let editor = view
+        .read_with(cx, |v, _| {
+            v.elicitation_text_field(&question.id, "question_0_custom")
+        })
+        .expect("the pending question renders its Other box");
+    cx.update(|window, cx| {
+        let handle = gpui::Focusable::focus_handle(editor.read(cx), cx);
+        window.focus(&handle, cx);
+    });
+    cx.run_until_parked();
+    if let Some(text) = text {
+        cx.simulate_input(text);
+        cx.run_until_parked();
+    }
+}
+
+async fn touched_card_decline_asks(placement: ElicitationPlacement, cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    bind_default_keymap(&mut cx);
+    set_placement(placement, &mut cx);
+    let q = ask(&thread, one_question(), "Pick a colour.", &mut cx);
+
+    focus_other_box(&view, &q, Some("Green"), &mut cx);
+    press_keys(&mut cx, "tab tab enter");
+
+    assert!(
+        cx.has_pending_prompt(),
+        "R2.2: the card's Decline on a touched card asks first ({placement:?})"
+    );
+    assert_eq!(status(&thread, &q.id, &cx), "pending");
+    cx.simulate_prompt_answer("Skip Question");
+    settle(&mut cx);
+    assert_eq!(status(&thread, &q.id, &cx), "declined");
+    assert_eq!(
+        sent(&q),
+        "decline",
+        "R2.5: the adapter receives Decline (its mapping yields empty answers)"
+    );
+}
+
