index 0000000..b68facf
--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_skipped_tests.rs
@@ -0,0 +1,224 @@
+//! A declined question leaves a "Skipped" line (story 035, Task 3.3; R3.1-R3.4, Q11).
+//!
+//! Wiring: inside `crates/agent_ui/src/conversation_view/thread_view.rs`'s `mod tests { .. }`,
+//! declare `mod elicitation_skipped_tests;` beside `mod elicitation_decline_harness;`.
+//! Resolves to `crates/agent_ui/src/conversation_view/thread_view/tests/elicitation_skipped_tests.rs`.
+//!
+//! Contract (Task 3.3 Objective): a declined, question-shaped form renders in the conversation
+//! as one muted line, "Skipped" + the request's message cut to one line, no buttons, under the
+//! debug selector `elicitation-skipped-<entry_ix>`, in both placements.
+//!
+//! Hostile halves, authored first: the line drawn WRONGLY -- for a cancelled question, an
+//! accepted one, a declined form that is not a question, a question still pending, a question
+//! kept after the prompt -- and, for the derived selector, a THIRD element: with two questions
+//! queued, declining the first must not draw a line at the second's index. Then the line drawn
+//! where it must be: untouched decline, confirmed decline, inline placement.
+//!
+//! Not asserted: the line's text (no text read-back from a painted frame here) -- one line is
+//! asserted as height, "Skipped" + message by the GUI proof (Task 4.2).
+
+use gpui::{TestAppContext, px};
+use settings::ElicitationPlacement;
+
+use super::super::ThreadView;
+use super::elicitation_decline_harness::*;
+
+const LONG: &str = "Which of these three deployment strategies should the agent use for the staging \
+    cluster, given that the database migration is irreversible and the cache must be warmed before \
+    traffic shifts, and the rollback window is fifteen minutes at most?";
+
+fn skipped_painted(
+    ix: usize,
+    cx: &mut gpui::VisualTestContext,
+) -> Option<gpui::Bounds<gpui::Pixels>> {
+    draw(cx);
+    cx.debug_bounds(skipped_selector(ix))
+}
+
+// ---- the line must NOT be drawn ----
+
+#[gpui::test]
+async fn elicitation_skipped_absent_for_cancelled_accepted_and_pending(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    let cancelled = ask(&thread, one_question(), "Cancelled one?", &mut cx);
+    let accepted = ask(&thread, one_question(), "Accepted one?", &mut cx);
+    let pending = ask(&thread, one_question(), "Pending one?", &mut cx);
+
+    let id = cancelled.id.clone();
+    view.update_in(&mut cx, |v, window, cx| {
+        v.cancel_elicitation(id, window, cx)
+    });
+    let id = accepted.id.clone();
+    thread.update(&mut cx, |thread, cx| {
+        thread.respond_to_elicitation(
+            &id,
+            agent_client_protocol::v2::schema::CreateElicitationResponse::new(
+                agent_client_protocol::v2::schema::ElicitationAction::Accept(
+                    agent_client_protocol::v2::schema::ElicitationAcceptAction::new(),
+                ),
+            ),
+            cx,
+        );
+    });
+    settle(&mut cx);
+
+    for (question, why) in [
+        (&cancelled, "R3.3: cancelled"),
+        (&accepted, "R3.3: accepted"),
+        (&pending, "still pending"),
+    ] {
+        let ix = entry_ix(&thread, &question.id, &cx);
+        assert!(
+            skipped_painted(ix, &mut cx).is_none(),
+            "{why}: no Skipped line"
+        );
+    }
+}
+
+#[gpui::test]
+async fn elicitation_skipped_absent_for_a_declined_form_that_is_not_a_question(
+    cx: &mut TestAppContext,
+) {
+    // R2.9/Constraint: for the refusal-fallback prompt and MCP forms, Decline means "no", not
+    // "skipped" -- no line.
+    let (view, thread, mut cx) = setup(cx).await;
+    let q = ask(
+        &thread,
+        agent_client_protocol::v2::schema::ElicitationSchema::new().property(
+            "retry",
+            choices(&["Retry", "Skip"]),
+            false,
+        ),
+        "Retry with another model?",
+        &mut cx,
+    );
+    decline(&view, &q, &mut cx);
+    settle(&mut cx);
+    assert_eq!(status(&thread, &q.id, &cx), "declined", "precondition");
+    let ix = entry_ix(&thread, &q.id, &cx);
+    assert!(skipped_painted(ix, &mut cx).is_none());
+}
+
+#[gpui::test]
+async fn elicitation_skipped_absent_while_the_question_is_kept(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    let q = ask(&thread, one_question(), "Pick a colour.", &mut cx);
+    type_into(&view, &q, "question_0_custom", "Green", &mut cx);
+    decline(&view, &q, &mut cx);
+    assert!(cx.has_pending_prompt());
+    let ix = entry_ix(&thread, &q.id, &cx);
+    assert!(
+        skipped_painted(ix, &mut cx).is_none(),
+        "no line while the confirmation is open"
+    );
+    cx.simulate_prompt_answer("Keep Answering");
+    settle(&mut cx);
+    assert!(
+        skipped_painted(ix, &mut cx).is_none(),
+        "no line after Keep Answering"
+    );
+}
+
+#[gpui::test]
+async fn elicitation_skipped_only_at_the_declined_question_and_the_next_takes_the_card(
+    cx: &mut TestAppContext,
+) {
+    // Third element for the derived selector: two queued questions, the first declined.
+    let (view, thread, mut cx) = setup(cx).await;
+    let first = ask(&thread, one_question(), "First question?", &mut cx);
+    let second = ask(&thread, one_question(), "Second question?", &mut cx);
+
+    decline(&view, &first, &mut cx);
+    settle(&mut cx);
+
+    let first_ix = entry_ix(&thread, &first.id, &cx);
+    let second_ix = entry_ix(&thread, &second.id, &cx);
+    assert_ne!(first_ix, second_ix);
+    assert!(
+        skipped_painted(first_ix, &mut cx).is_some(),
+        "R3.1: the declined one"
+    );
+    assert!(
+        skipped_painted(second_ix, &mut cx).is_none(),
+        "the queued one is not skipped"
+    );
+    // R3.2: the skipped question holds no fields, and the pinned slot moves to the next one.
+    assert!(!view.read_with(&cx, |v, _| v.has_elicitation_form_state(&first.id)));
+    assert_eq!(status(&thread, &second.id, &cx), "pending");
+    cx.update(|_, cx| {
+        let thread = thread.read(cx);
+        let (_, first) = thread.elicitation(&first.id).expect("first");
+        let (_, second) = thread.elicitation(&second.id).expect("second");
+        assert!(
+            !ThreadView::renders_elicitation_as_card(first, cx),
+            "R3.2: the skipped question no longer holds the pinned card"
+        );
+        assert!(
+            ThreadView::renders_elicitation_as_card(second, cx),
+            "R3.2: the next queued question takes it"
+        );
+    });
+}
+
+// ---- the line MUST be drawn ----
+
+#[gpui::test]
+async fn elicitation_skipped_after_an_untouched_decline_on_one_line(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    let q = ask(&thread, one_question(), LONG, &mut cx);
+    decline(&view, &q, &mut cx);
+    settle(&mut cx);
+
+    let ix = entry_ix(&thread, &q.id, &cx);
+    let row = skipped_painted(ix, &mut cx).expect("R3.1: a Skipped line where the question was");
+    assert!(
+        row.size.height < px(48.),
+        "R3.1/A2: a long message is cut to one line (row height {:?})",
+        row.size.height
+    );
+    assert!(
+        !cx.has_pending_prompt(),
+        "R3.2: the line has no prompt behind it"
+    );
+}
+
+#[gpui::test]
+async fn elicitation_skipped_after_a_confirmed_decline(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    let q = ask(
+        &thread,
+        two_questions(),
+        "Pick a colour and a language.",
+        &mut cx,
+    );
+    select(&view, &q, "question_1", "Go", &mut cx);
+    decline(&view, &q, &mut cx);
+    cx.simulate_prompt_answer("Skip Question");
+    settle(&mut cx);
+
+    let ix = entry_ix(&thread, &q.id, &cx);
+    assert!(
+        skipped_painted(ix, &mut cx).is_some(),
+        "R3.1: confirmed decline is skipped too"
+    );
+}
+
+#[gpui::test]
+async fn elicitation_skipped_in_the_inline_placement(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    set_placement(ElicitationPlacement::Inline, &mut cx);
+    let q = ask(&thread, one_question(), "Pick a colour.", &mut cx);
+    let ix = entry_ix(&thread, &q.id, &cx);
+    assert!(
+        skipped_painted(ix, &mut cx).is_none(),
+        "precondition: the inline card is pending"
+    );
+
+    decline(&view, &q, &mut cx);
+    settle(&mut cx);
+
+    assert!(
+        skipped_painted(ix, &mut cx).is_some(),
+        "R3.4: the same line replaces the inline card"
+    );
+}
