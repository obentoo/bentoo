--- /dev/null
+++ b/crates/agent_ui/src/conversation_view/elicitation/elicitation_has_input_tests.rs
@@ -0,0 +1,275 @@
+//! Was the question card touched, and is a form question-shaped (story 035, Task 3.1; R2.1-R2.4,
+//! R2.9, assumption A1).
+//!
+//! Wiring: in `crates/agent_ui/src/conversation_view/elicitation.rs` declare
+//!
+//!     #[cfg(test)]
+//!     mod elicitation_has_input_tests;
+//!
+//! -- a module of a non-mod-rs file, so it resolves to
+//! `crates/agent_ui/src/conversation_view/elicitation/elicitation_has_input_tests.rs`.
+//!
+//! Contract (Task 3.1 Objective):
+//!   - `ElicitationFormState::has_input(&self, cx: &App) -> bool` -- true when any field differs
+//!     from the state the form had right after construction (defaults and preselection applied).
+//!   - `pub(crate) fn is_question_shaped(schema: &acp::ElicitationSchema) -> bool` -- true when any
+//!     property carries the `_askUserQuestionCustomAnswer` marker in its `_meta`.
+//!
+//! Hostile halves, authored first:
+//!   - has_input wrongly TRUE: a preselected required option, a schema default, whitespace typed,
+//!     a choice made and undone -- the card still holds its initial state (R2.1, R2.4, A1).
+//!   - has_input wrongly FALSE: text typed on a page that is not shown, a choice that differs from
+//!     a non-empty initial selection, a multi-select pick (R2.2, R2.3).
+//!   - is_question_shaped wrongly TRUE: a field NAMED like the adapter's custom box
+//!     (`question_0_custom`) without the marker; wrongly FALSE: the marker on a field with any
+//!     other name. The marker is the rule, never the name (R2.9).
+//! The marker key is spelled out literally: it is the wire contract with the adapter.
+
+use super::*;
+use gpui::TestAppContext;
+
+const MARKER: &str = "_askUserQuestionCustomAnswer";
+
+fn marked(question_id: &str) -> acp::StringPropertySchema {
+    let mut schema = acp::StringPropertySchema::new().title("Other");
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        MARKER.to_string(),
+        serde_json::json!({ "questionId": question_id, "isCustomAnswer": true }),
+    );
+    schema.meta = Some(meta);
+    schema
+}
+
+fn choices(values: &[&str]) -> acp::StringPropertySchema {
+    acp::StringPropertySchema::new()
+        .enum_values(values.iter().map(|v| v.to_string()).collect::<Vec<_>>())
+}
+
+/// What AskUserQuestion sends for two questions (single-select, then multi-select): nothing
+/// required, one "Other" box per question, one page per question.
+fn ask_user_question_schema() -> acp::ElicitationSchema {
+    acp::ElicitationSchema::new()
+        .property("question_0", choices(&["Red", "Blue"]), false)
+        .property("question_0_custom", marked("question_0"), false)
+        .property(
+            "question_1",
+            acp::MultiSelectPropertySchema::new(vec!["Rust".into(), "Go".into()]),
+            false,
+        )
+        .property("question_1_custom", marked("question_1"), false)
+}
+
+fn set_text(
+    form: &ElicitationFormState,
+    field: &str,
+    text: &str,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    form.text_field_editor(field)
+        .unwrap_or_else(|| panic!("{field} is a text field"))
+        .update(cx, |editor, cx| editor.set_text(text, window, cx));
+}
+
+/// Runs `body` with a window, for forms whose text fields are editors.
+fn with_window(cx: &mut TestAppContext, body: impl FnOnce(&mut Window, &mut App) + 'static) {
+    crate::conversation_view::tests::init_test(cx);
+    cx.add_window(|window, cx| {
+        body(window, cx);
+        Editor::single_line(window, cx)
+    });
+}
+
+// ---- has_input: the cases where it must NOT fire (hostile: wrongly collapse into "touched") ----
+
+#[gpui::test]
+fn elicitation_has_input_false_for_a_fresh_question_card(cx: &mut TestAppContext) {
+    with_window(cx, |window, cx| {
+        let form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        assert!(!form.has_input(cx), "R2.1: an untouched card has no input");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_false_for_a_preselected_required_option(cx: &mut TestAppContext) {
+    // A required single-select starts with its first option picked: not empty, and not input.
+    with_window(cx, |window, cx| {
+        let schema = acp::ElicitationSchema::new().property("pick", choices(&["a", "b"]), true);
+        let form = ElicitationFormState::new(&schema, window, cx);
+        assert!(
+            !form.has_input(cx),
+            "R2.1: the preselection is the initial state, not something the operator did"
+        );
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_false_for_schema_defaults(cx: &mut TestAppContext) {
+    with_window(cx, |window, cx| {
+        let mut text = acp::StringPropertySchema::new();
+        text.default = Some("prefilled".into());
+        let mut flag = acp::BooleanPropertySchema::new();
+        flag.default = Some(true);
+        let schema = acp::ElicitationSchema::new()
+            .property("text", text, false)
+            .property("flag", flag, false)
+            .property("pick", choices(&["a", "b"]), false);
+        let form = ElicitationFormState::new(&schema, window, cx);
+        assert!(!form.has_input(cx), "R2.1: defaults are the initial state");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_false_for_whitespace_only_text(cx: &mut TestAppContext) {
+    with_window(cx, |window, cx| {
+        let form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        set_text(&form, "question_0_custom", "   \n\t ", window, cx);
+        assert!(!form.has_input(cx), "A1: whitespace is not something typed");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_false_after_a_choice_is_made_and_undone(cx: &mut TestAppContext) {
+    // R2.4, every field kind: picked then unpicked, typed then erased, toggled then toggled back,
+    // and a required preselection moved away and back.
+    with_window(cx, |window, cx| {
+        let schema = ask_user_question_schema()
+            .property("flag", acp::BooleanPropertySchema::new(), false)
+            .property("required_pick", choices(&["x", "y"]), true);
+        let mut form = ElicitationFormState::new(&schema, window, cx);
+
+        form.set_multi_select("question_1", "Go".into(), true);
+        assert!(form.has_input(cx), "precondition: a pick is input");
+        form.set_multi_select("question_1", "Go".into(), false);
+        assert!(!form.has_input(cx), "R2.4: unpicked again");
+
+        set_text(&form, "question_1_custom", "Zig", window, cx);
+        assert!(form.has_input(cx), "precondition: typed text is input");
+        set_text(&form, "question_1_custom", "", window, cx);
+        assert!(!form.has_input(cx), "R2.4: erased again");
+
+        form.set_boolean("flag", true);
+        assert!(form.has_input(cx), "precondition: a toggle is input");
+        form.set_boolean("flag", false);
+        assert!(!form.has_input(cx), "R2.4: toggled back");
+
+        form.set_single_select("required_pick", "y".into());
+        assert!(
+            form.has_input(cx),
+            "R2.3: moving off the preselection is input"
+        );
+        form.set_single_select("required_pick", "x".into());
+        assert!(!form.has_input(cx), "R2.4: back on the preselection");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_ignores_the_page_shown(cx: &mut TestAppContext) {
+    // Moving between pages is navigation, not an answer.
+    with_window(cx, |window, cx| {
+        let mut form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        assert_eq!(form.pages().len(), 2, "precondition: one page per question");
+        form.set_page(1);
+        assert!(!form.has_input(cx));
+    });
+}
+
+// ---- has_input: the cases where it MUST fire (hostile: wrongly split away from "touched") ----
+
+#[gpui::test]
+fn elicitation_has_input_true_for_text_on_a_page_not_shown(cx: &mut TestAppContext) {
+    // R2.2: "on any page" -- text on page 2 counts while page 1 is shown, and vice versa.
+    with_window(cx, |window, cx| {
+        let mut form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        set_text(&form, "question_1_custom", "Zig", window, cx);
+        form.set_page(0);
+        assert!(form.has_input(cx), "R2.2: text on the hidden page 2");
+
+        let mut form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        set_text(&form, "question_0_custom", "Green", window, cx);
+        form.set_page(1);
+        assert!(form.has_input(cx), "R2.2: text on the hidden page 1");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_true_for_a_selection(cx: &mut TestAppContext) {
+    with_window(cx, |window, cx| {
+        let mut form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        form.set_single_select("question_0", "Blue".into());
+        assert!(form.has_input(cx), "R2.3: a single-select pick");
+
+        let mut form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        form.set_multi_select("question_1", "Rust".into(), true);
+        assert!(form.has_input(cx), "R2.3: a multi-select pick on page 2");
+    });
+}
+
+#[gpui::test]
+fn elicitation_has_input_true_for_text_around_whitespace(cx: &mut TestAppContext) {
+    // The converse of A1: whitespace around a real answer does not hide it.
+    with_window(cx, |window, cx| {
+        let form = ElicitationFormState::new(&ask_user_question_schema(), window, cx);
+        set_text(&form, "question_0_custom", "  Green \n", window, cx);
+        assert!(form.has_input(cx), "R2.2: non-whitespace text is input");
+    });
+}
+
+// ---- is_question_shaped ----
+
+#[test]
+fn elicitation_has_input_is_question_shaped_for_ask_user_question_forms() {
+    assert!(is_question_shaped(&ask_user_question_schema()));
+}
+
+#[test]
+fn elicitation_has_input_is_question_shaped_rejects_the_name_without_the_marker() {
+    // Hostile: wrongly collapse a look-alike into a question.
+    let schema = acp::ElicitationSchema::new()
+        .property("question_0", choices(&["Red", "Blue"]), false)
+        .property(
+            "question_0_custom",
+            acp::StringPropertySchema::new().title("Other"),
+            false,
+        );
+    assert!(
+        !is_question_shaped(&schema),
+        "R2.9: the field name is not the rule; the marker is"
+    );
+}
+
+#[test]
+fn elicitation_has_input_is_question_shaped_accepts_the_marker_under_any_name() {
+    // Hostile: wrongly split a marked form away from questions because its names differ.
+    let schema = acp::ElicitationSchema::new()
+        .property("colour", choices(&["Red", "Blue"]), false)
+        .property("notes", marked("colour"), false);
+    assert!(
+        is_question_shaped(&schema),
+        "the marker alone makes it a question"
+    );
+}
+
+#[test]
+fn elicitation_has_input_is_question_shaped_false_for_ordinary_forms() {
+    // MCP-style forms and the adapter's refusal-fallback "Retry with ...?" prompt carry no marker.
+    let plain = acp::ElicitationSchema::new()
+        .string("host", true)
+        .string("port", false);
+    assert!(!is_question_shaped(&plain));
+    let retry = acp::ElicitationSchema::new().property("retry", choices(&["Retry", "Skip"]), false);
+    assert!(!is_question_shaped(&retry));
+    let mut other_meta = acp::StringPropertySchema::new();
+    let mut meta = serde_json::Map::new();
+    meta.insert(
+        "_claude/askUserQuestionOption".into(),
+        serde_json::json!({}),
+    );
+    other_meta.meta = Some(meta);
+    let unrelated = acp::ElicitationSchema::new().property("x", other_meta, false);
+    assert!(
+        !is_question_shaped(&unrelated),
+        "another `_meta` key on a field is not the marker"
+    );
+}
