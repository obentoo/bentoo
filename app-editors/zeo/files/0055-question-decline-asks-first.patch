+    /// selections are sets, so a choice made and undone is no answer either.
+    pub(crate) fn has_input(&self, cx: &App) -> bool {
+        let current = self.snapshot(cx);
+        current.fields.iter().any(
+            |(name, value)| match (value, self.initial.fields.get(name)) {
