+    /// Declines a question at once when nothing would be lost; when the
+    /// operator has typed or selected something, asks first and declines only
+    /// on "Skip Question". Forms that are not questions decline as they always
+    /// did.
     fn decline_elicitation(
         &mut self,
         elicitation_id: ElicitationEntryId,
-        _window: &mut Window,
+        window: &mut Window,
         cx: &mut Context<Self>,
     ) {
+        if self.open_decline_confirmations.contains(&elicitation_id) {
+            return;
+        }
+        if !self.decline_needs_confirmation(&elicitation_id, cx) {
+            self.log_decline_outcome(&elicitation_id, "not_needed", "declined");
+            self.send_decline(elicitation_id, cx);
+            return;
+        }
+
+        self.open_decline_confirmations
+            .insert(elicitation_id.clone());
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            "Skip this question?",
+            Some(
+                "What you typed or selected will be discarded, \
+                 and the agent will continue without an answer.",
+            ),
+            &["Skip Question", "Keep Answering"],
+            cx,
+        );
+        cx.spawn_in(window, async move |this, cx| {
+            // Index 0 is "Skip Question"; `Err` is a prompt whose sender was
+            // dropped, which keeps the question like "Keep Answering" does.
+            let confirmed = matches!(answer.await, Ok(0));
+            this.update(cx, |this, cx| {
+                this.open_decline_confirmations.remove(&elicitation_id);
+                if !confirmed {
+                    this.log_decline_outcome(&elicitation_id, "asked", "kept");
+                    return;
+                }
+                // The question may have been answered, cancelled or ended
+                // with the turn while the prompt was open: it is no longer
+                // the operator's to decline.
+                if !this.is_elicitation_pending(&elicitation_id, cx)
+                    || !this.elicitation_form_states.contains_key(&elicitation_id)
+                {
+                    log::debug!(
+                        "elicitation decline: session_id={} elicitation_id={} \
+                         resolved before the skip was confirmed; nothing sent",
+                        this.session_id,
+                        elicitation_id.0
+                    );
+                    return;
+                }
+                this.log_decline_outcome(&elicitation_id, "asked", "declined");
+                this.send_decline(elicitation_id, cx);
+            })
+            .log_err();
+        })
+        .detach();
+    }
+
+    /// Whether declining this elicitation would discard an answer in
+    /// progress: only a question-shaped form whose fields differ from their
+    /// initial values.
+    fn decline_needs_confirmation(&self, elicitation_id: &ElicitationEntryId, cx: &App) -> bool {
+        let Some(form_state) = self.elicitation_form_states.get(elicitation_id) else {
+            return false;
+        };
+        let is_question = self
+            .thread
+            .read(cx)
+            .elicitation(elicitation_id)
+            .is_some_and(|(_, elicitation)| match &elicitation.request.mode {
+                acp_v2::ElicitationMode::Form(mode) => is_question_shaped(&mode.requested_schema),
+                _ => false,
+            });
+        is_question && form_state.has_input(cx)
+    }
+
+    fn is_elicitation_pending(&self, elicitation_id: &ElicitationEntryId, cx: &App) -> bool {
+        self.thread
+            .read(cx)
+            .elicitation(elicitation_id)
+            .is_some_and(|(_, elicitation)| {
+                matches!(elicitation.status, ElicitationStatus::Pending { .. })
+            })
+    }
+
+    /// One line per decline outcome. Identifiers only: never the typed text
+    /// or the options chosen.
+    fn log_decline_outcome(
+        &self,
+        elicitation_id: &ElicitationEntryId,
+        confirmation: &str,
+        outcome: &str,
+    ) {
