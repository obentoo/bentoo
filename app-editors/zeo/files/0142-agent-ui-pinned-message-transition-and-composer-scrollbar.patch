@@ -0,0 +1,94 @@
+//! Zeo: the pinned user message opens with a short transition -- a fade while its body grows
+//! from the minimized row to its 160 px cap -- and opens at once under reduce motion; collapsing
+//! stays instant (proposal §6.66, ask 91). Filter: `pinned_expand_tests`.
+//!
+//! §6.52 ruled height animations out because the conversation list would lay out again on every
+//! frame. The pinned card is an overlay outside that list, so the objection does not hold here.
+//!
+//! Resolves to `crates/agent_ui/src/conversation_view/thread_view/tests/pinned_expand_tests.rs`.
+
+use std::time::Duration;
+
+use gpui::{Pixels, VisualTestContext, px};
+
+use super::elicitation_decline_harness::*;
+use super::pinned_avatar_tests::pin_a_message;
+
+/// Twenty lines: the expanded body reaches its cap and scrolls.
+fn long_message() -> String {
+    (0..20)
+        .map(|ix| format!("step {ix} of a long request"))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn body_height(cx: &mut VisualTestContext) -> Pixels {
+    cx.debug_bounds("thread-pinned-user-message-body")
+        .expect("the pinned message's body is painted")
+        .size
+        .height
+}
+
+fn expand(view: &gpui::Entity<super::super::ThreadView>, cx: &mut VisualTestContext) {
+    view.update(cx, |view, cx| {
+        view.pinned_message_expanded = Some(0);
+        cx.notify();
+    });
+    draw(cx);
+}
+
+#[gpui::test]
+async fn expanding_grows_from_the_minimized_row(cx: &mut gpui::TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    pin_a_message(&long_message(), &view, &thread, &mut cx);
+    let minimized = body_height(&mut cx);
+    expand(&view, &mut cx);
+    let first_frame = body_height(&mut cx);
+    assert!(
+        first_frame <= minimized + px(4.),
+        "the first expanded frame is {first_frame:?}, the minimized body {minimized:?}: \
+         the card opened at once"
+    );
+    cx.executor().advance_clock(Duration::from_millis(400));
+    draw(&mut cx);
+    let opened = body_height(&mut cx);
+    assert!(
+        opened >= px(150.),
+        "after the transition the body is {opened:?}, short of its 160 px cap"
+    );
+}
+
+/// Under reduce motion GPUI draws a one-shot animation at its end state: no transition at all.
+#[gpui::test]
+async fn reduce_motion_expands_at_once(cx: &mut gpui::TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    cx.update(|_, cx| cx.set_reduce_motion(true));
+    pin_a_message(&long_message(), &view, &thread, &mut cx);
+    expand(&view, &mut cx);
+    let first_frame = body_height(&mut cx);
+    assert!(
+        first_frame >= px(150.),
+        "with reduce motion the first frame is {first_frame:?}, not the open card"
+    );
+}
+
+/// Collapsing is instant: the minimized line comes back on the next frame.
+#[gpui::test]
+async fn collapsing_is_instant(cx: &mut gpui::TestAppContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    pin_a_message(&long_message(), &view, &thread, &mut cx);
+    let minimized = body_height(&mut cx);
+    expand(&view, &mut cx);
+    cx.executor().advance_clock(Duration::from_millis(400));
+    draw(&mut cx);
+    view.update(&mut cx, |view, cx| {
+        view.pinned_message_expanded = None;
+        cx.notify();
+    });
+    draw(&mut cx);
+    let collapsed = body_height(&mut cx);
+    assert!(
+        (collapsed - minimized).abs() <= px(0.5),
+        "collapsed to {collapsed:?}, the minimized body was {minimized:?}"
+    );
+}
