diff --git a/crates/agent_ui/src/message_editor_scrollbar_tests.rs b/crates/agent_ui/src/message_editor_scrollbar_tests.rs
new file mode 100644
index 0000000..96527f2
--- /dev/null
+++ b/crates/agent_ui/src/message_editor_scrollbar_tests.rs
@@ -0,0 +1,111 @@
+//! Zeo: the composer reserves a vertical scrollbar (proposal §6.66, ask 96). Its editor was built
+//! in auto-height mode with scrollbars off, and its style left the scrollbar width at zero, so a
+//! draft that outgrew the composer -- normal or expanded -- scrolled with no scrollbar at all.
+//! Filter: `message_editor::scrollbar_tests`.
+//!
+//! The editor reserves the scrollbar's width on the right whenever it may show one, so the
+//! effect is measured where it lands: in the expanded (full-mode) composer a long paragraph wraps
+//! into more rows with the scrollbar than with `scrollbar.show = never`. An auto-height editor
+//! wraps without that margin (`compute_auto_height_layout`), so the normal composer's scrollbar
+//! is proven on Xvfb instead.
+
+use std::path::Path;
+
+use editor::EditorMode;
+use fs::FakeFs;
+use gpui::{
+    AppContext as _, TestAppContext, UpdateGlobal as _, VisualTestContext, point, px, size,
+};
+use project::Project;
+use serde_json::json;
+use settings::{SettingsStore, ShowScrollbar};
+use ui::{IntoElement as _, ParentElement as _, Styled as _, div};
+use util::path;
+use workspace::MultiWorkspace;
+
+use crate::conversation_view::tests::init_test;
+use crate::message_editor::MessageEditor;
+
+#[gpui::test]
+async fn the_composer_reserves_a_vertical_scrollbar(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree("/project", json!({"file": ""})).await;
+    let project = Project::test(fs, [Path::new(path!("/project"))], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let message_editor = cx.update(|window, cx| {
+        cx.new(|cx| {
+            MessageEditor::new(
+                workspace.downgrade(),
+                project.downgrade(),
+                None,
+                Default::default(),
+                "Test Agent".into(),
+                "Test",
+                EditorMode::full(),
+                window,
+                cx,
+            )
+        })
+    });
+    let editor = message_editor.update(cx, |message_editor, _| message_editor.editor.clone());
+    let paragraph = vec!["a"; 600].join(" ");
+    editor.update_in(cx, |editor, window, cx| {
+        editor.set_text(paragraph, window, cx)
+    });
+
+    let rows = |show: ShowScrollbar, cx: &mut VisualTestContext| {
+        cx.update(|_, cx| {
+            SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings.editor.scrollbar.get_or_insert_default().show = Some(show);
+                });
+            });
+        });
+        cx.run_until_parked();
+        for _ in 0..2 {
+            // A box of the panel's size: as a bare root the composer's flex children get no
+            // width, and every word wraps alone.
+            cx.draw(point(px(0.), px(0.)), size(px(400.), px(200.)), |_, _| {
+                div()
+                    .flex()
+                    .size_full()
+                    .child(message_editor.clone())
+                    .into_any_element()
+            });
+            cx.run_until_parked();
+        }
+        editor.update(cx, |editor, cx| editor.max_point(cx).row().0)
+    };
+    let without = rows(ShowScrollbar::Never, cx);
+    let with = rows(ShowScrollbar::Always, cx);
+    assert!(
+        with > without,
+        "the paragraph wraps into {with} rows with the scrollbar and {without} without: \
+         the composer reserves no room for one"
+    );
+}
+
+/// Hostile: a draft that fits -- and a sent message, which grows instead of scrolling -- gets no
+/// scrollbar, so no empty track or cursor marker sits beside a short message.
+#[test]
+fn a_draft_that_fits_gets_no_scrollbar() {
+    use super::composer_scrollbar_width;
+    assert_eq!(composer_scrollbar_width(1, Some(8.)), px(0.));
+    assert_eq!(
+        composer_scrollbar_width(8, Some(8.)),
+        px(0.),
+        "exactly full"
+    );
+    assert_eq!(
+        composer_scrollbar_width(3, None),
+        px(0.),
+        "not laid out yet"
+    );
+    assert!(
+        composer_scrollbar_width(9, Some(8.)) > px(0.),
+        "one row past the composer"
+    );
+}
