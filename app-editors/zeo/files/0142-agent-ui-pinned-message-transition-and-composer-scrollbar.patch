+/// The composer's scrollbar width for a draft of `rows` display rows in a composer that shows
+/// `visible` of them (Zeo §6.66, ask 96): the editor's own width once the draft is taller than
+/// the composer, else none. With a width the editor reserves a track on the right and draws its
+/// markers there, even for a one-line draft or a sent message, which never scroll.
+pub(crate) fn composer_scrollbar_width(rows: u32, visible: Option<f64>) -> Pixels {
+    match visible {
+        Some(visible) if f64::from(rows) > visible.round() => ui::EDITOR_SCROLLBAR_WIDTH,
+        _ => Pixels::ZERO,
+    }
+}
+
 impl Render for MessageEditor {
     fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let scrollbar_width = self.editor.update(cx, |editor, cx| {
+            let rows = editor.max_point(cx).row().0 + 1;
+            composer_scrollbar_width(rows, editor.visible_line_count())
+        });
         v_flex()
             .key_context("MessageEditor")
             .on_action(cx.listener(Self::chat))
@@ -2352,6 +2371,8 @@ impl Render for MessageEditor {
                         text: text_style,
                         syntax: cx.theme().syntax().clone(),
                         inlay_hints_style: editor::make_inlay_hints_style(cx),
+                        // Zeo §6.66 (ask 96): the default width is 0, which draws no scrollbar.
+                        scrollbar_width,
                         ..Default::default()
                     },
                 )
@@ -2566,6 +2587,10 @@ fn find_matching_bracket(text: &str, open: char, close: char) -> Option<usize> {
     None
 }
 
