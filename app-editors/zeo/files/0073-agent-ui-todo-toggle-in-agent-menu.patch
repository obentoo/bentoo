diff --git a/crates/agent_ui/src/config_options.rs b/crates/agent_ui/src/config_options.rs
index 7185a22..0072048 100644
--- a/crates/agent_ui/src/config_options.rs
+++ b/crates/agent_ui/src/config_options.rs
@@ -33,6 +33,34 @@ use crate::{
 
 const PICKER_THRESHOLD: usize = 5;
 
+/// Claude Agent (Plus)'s todo-tools option (`plan-updates.ts`). Zeo shows it as
+/// a toggle in the agent panel's options menu instead of the composer row: it is
+/// set once per thread, and the row is where per-turn choices live.
+pub const TODO_CONFIG_ID: &str = "plan_updates";
+/// The menu label, fixed here rather than taken from the adapter so the entry
+/// reads the same against an adapter that still advertises the old name.
+pub const TODO_MENU_LABEL: &str = "ToDo";
+/// The select fallback an adapter sends to a client without boolean options.
+const TODO_SELECT_ON: &str = "on";
+const TODO_SELECT_OFF: &str = "off";
+
+fn shows_in_composer_row(option: &acp::SessionConfigOption) -> bool {
+    matches!(
+        &option.kind,
+        acp::SessionConfigKind::Select(_) | acp::SessionConfigKind::Boolean(_)
+    ) && option.config_id.0.as_ref() != TODO_CONFIG_ID
+}
+
+fn todo_option_enabled(option: &acp::SessionConfigOption) -> Option<bool> {
+    match &option.kind {
+        acp::SessionConfigKind::Boolean(boolean) => Some(boolean.current_value),
+        acp::SessionConfigKind::Select(select) => {
+            Some(select.current_value.0.as_ref() == TODO_SELECT_ON)
+        }
+        _ => None,
+    }
+}
+
 pub struct ConfigOptionsView {
     config_options: Rc<dyn AgentSessionConfigOptions>,
     selectors: Vec<Entity<ConfigOptionSelector>>,
@@ -80,6 +108,52 @@ impl ConfigOptionsView {
         self.config_options.is_read_only()
     }
 
+    /// Whether the session's ToDo option is on; `None` when the agent does not
+    /// offer it, so the menu leaves the entry out.
+    pub fn todo_enabled(&self) -> Option<bool> {
+        self.config_options
+            .config_options()
+            .into_iter()
+            .find(|option| option.config_id.0.as_ref() == TODO_CONFIG_ID)
+            .and_then(|option| todo_option_enabled(&option))
+    }
+
+    pub fn toggle_todo(&mut self, cx: &mut Context<Self>) {
+        if self.config_options.is_read_only() {
+            return;
+        }
+        let Some(option) = self
+            .config_options
+            .config_options()
+            .into_iter()
+            .find(|option| option.config_id.0.as_ref() == TODO_CONFIG_ID)
+        else {
+            return;
+        };
+        let Some(enabled) = todo_option_enabled(&option) else {
+            return;
+        };
+        let value = match &option.kind {
+            acp::SessionConfigKind::Boolean(_) => acp::SessionConfigOptionValue::boolean(!enabled),
+            _ => acp::SessionConfigOptionValue::id(if enabled {
+                TODO_SELECT_OFF
+            } else {
+                TODO_SELECT_ON
+            }),
+        };
+        // Thread-local, like the composer switch it replaces: the adapter
+        // scopes the option to the session, so no default is saved.
+        let task = self
+            .config_options
+            .set_config_option(option.config_id, value, cx);
+        cx.spawn(async move |_, _| {
+            if let Err(err) = task.await {
+                log::error!("Failed to set config option: {:?}", err);
+            }
+        })
+        .detach();
+    }
+
     pub fn toggle_category_picker(
         &mut self,
         category: acp::SessionConfigOptionCategory,
@@ -258,12 +332,7 @@ impl ConfigOptionsView {
         config_options
             .config_options()
             .into_iter()
-            .filter(|option| {
-                matches!(
-                    &option.kind,
-                    acp::SessionConfigKind::Select(_) | acp::SessionConfigKind::Boolean(_)
-                )
-            })
+            .filter(shows_in_composer_row)
             .map(|option| {
                 let config_options = config_options.clone();
                 let agent_server = agent_server.clone();
@@ -1851,6 +1920,102 @@ mod tests {
         );
     }
 
+    fn todo_view(
+        config_options: &Rc<TestSessionConfigOptions>,
+        agent_server: &Rc<TestAgentServer>,
+        fs: &Arc<dyn Fs>,
+        cx: &mut App,
+    ) -> Entity<ConfigOptionsView> {
+        let config_options: Rc<dyn AgentSessionConfigOptions> = config_options.clone();
+        let agent_server: Rc<dyn AgentServer> = agent_server.clone();
+        let fs = fs.clone();
+        cx.new(|_| ConfigOptionsView {
+            config_option_ids: ConfigOptionsView::config_option_ids(&config_options),
+            config_options,
+            selectors: Vec::new(),
+            agent_server,
+            fs,
+            _refresh_task: Task::ready(()),
+        })
+    }
+
+    #[gpui::test]
+    fn todo_toggle_flips_both_shapes_without_saving_a_default(cx: &mut TestAppContext) {
+        let shapes = [
+            (
+                acp::SessionConfigOption::boolean(TODO_CONFIG_ID, "Plan updates", false),
+                acp::SessionConfigOptionValue::boolean(true),
+            ),
+            (
+                acp::SessionConfigOption::select(
+                    TODO_CONFIG_ID,
+                    "Plan updates",
+                    TODO_SELECT_OFF,
+                    vec![
+                        acp::SessionConfigSelectOption::new(TODO_SELECT_ON, "On"),
+                        acp::SessionConfigSelectOption::new(TODO_SELECT_OFF, "Off"),
+                    ],
+                ),
+                acp::SessionConfigOptionValue::id(TODO_SELECT_ON),
+            ),
+        ];
+        for (offered, expected) in shapes {
+            let agent_server = Rc::new(TestAgentServer::default());
+            let config_options = Rc::new(TestSessionConfigOptions::new(vec![offered]));
+            let fs: Arc<dyn Fs> = FakeFs::new(cx.executor());
+            let view = cx.update(|cx| todo_view(&config_options, &agent_server, &fs, cx));
+
+            assert_eq!(
+                view.read_with(cx, |view, _| view.todo_enabled()),
+                Some(false)
+            );
+            view.update(cx, |view, cx| view.toggle_todo(cx));
+            cx.run_until_parked();
+
+            assert_eq!(
+                config_options.set_values.borrow().as_slice(),
+                &[(TODO_CONFIG_ID.to_string(), expected)]
+            );
+            assert_eq!(
+                view.read_with(cx, |view, _| view.todo_enabled()),
+                Some(true)
+            );
+            assert!(
+                agent_server.saved_defaults.lock().is_empty(),
+                "the adapter scopes ToDo to the session"
+            );
+        }
+    }
+
+    #[gpui::test]
+    fn todo_is_absent_when_the_agent_does_not_offer_it(cx: &mut TestAppContext) {
+        let agent_server = Rc::new(TestAgentServer::default());
+        let config_options = Rc::new(TestSessionConfigOptions::new(vec![
+            acp::SessionConfigOption::boolean("fast", "Fast mode", false),
+        ]));
+        let fs: Arc<dyn Fs> = FakeFs::new(cx.executor());
+        let view = cx.update(|cx| todo_view(&config_options, &agent_server, &fs, cx));
+
+        assert_eq!(view.read_with(cx, |view, _| view.todo_enabled()), None);
+        view.update(cx, |view, cx| view.toggle_todo(cx));
+        cx.run_until_parked();
+        assert!(config_options.set_values.borrow().is_empty());
+    }
+
+    #[test]
+    fn todo_leaves_the_composer_row_and_other_options_stay() {
+        assert!(!shows_in_composer_row(&acp::SessionConfigOption::boolean(
+            TODO_CONFIG_ID,
+            "Plan updates",
+            true
+        )));
+        assert!(shows_in_composer_row(&acp::SessionConfigOption::boolean(
+            "fast",
+            "Fast mode",
+            true
+        )));
+    }
+
     #[derive(Default)]
     struct TestAgentServer {
         saved_defaults: Arc<Mutex<Vec<(String, Option<AgentConfigOptionValue>)>>>,
