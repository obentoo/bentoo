+// ── load_all: a row this build cannot read ─────────────────────────────────
+
+// Hostile (downgrade): a status written by a newer Zeo is skipped, with a warning naming
+// the row, and every readable row still loads -- one row must not fail the whole load.
+#[gpui::test]
+async fn history_db_load_all_skips_an_unreadable_row_and_keeps_the_rest(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_unreadable_row").await;
+    db.insert_started(&record("s1", "readable", AgentTaskStatus::Running, 1_000))
+        .await
+        .unwrap();
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at) \
+         VALUES ('s-new', 't-new', 'project', 'shell', 'Task', 0, 'paused', 2000)",
+    )
+    .await;
+    capture_logs();
+
+    let rows = db
+        .load_all()
+        .await
+        .expect("an unreadable row must not fail the load");
+
+    assert_eq!(rows.len(), 1, "only the readable row is returned");
+    assert!(find(&rows, "s1", "readable").is_some());
+    let warnings = warn_lines();
+    assert!(
+        warnings
+            .iter()
+            .any(|line| line.contains("s-new/t-new") && line.contains("paused")),
+        "the skipped row is named at warn level: {warnings:?}"
+    );
+}
+
+// Q13 for delete: the delete batch runs in its own savepoint, so a row that fails part-way
+// leaves every row of the batch in place.
+#[gpui::test]
+async fn history_db_delete_is_atomic_when_a_row_fails_mid_batch(_cx: &mut TestAppContext) {
+    let db = AgentTaskHistoryDb::open_test_db("history_db_delete_atomic").await;
+    for task in ["a", "boom", "c"] {
+        db.insert_started(&record("s1", task, AgentTaskStatus::Running, 1_000))
+            .await
+            .unwrap();
+    }
+    // Only archived rows are ever deleted.
+    db.set_archived(&[key("s1", "a"), key("s1", "boom"), key("s1", "c")], true)
+        .await
+        .unwrap();
+    run_sql(
+        &db,
+        "CREATE TRIGGER fail_delete_mid_batch BEFORE DELETE ON agent_task_history \
+         WHEN OLD.task_id = 'boom' \
+         BEGIN SELECT RAISE(ABORT, 'forced mid-batch failure'); END;",
+    )
+    .await;
+
+    let batch = [key("s1", "a"), key("s1", "boom"), key("s1", "c")];
+    assert!(db.delete(&batch).await.is_err(), "the forced failure surfaces");
+    assert_eq!(load(&db).await.len(), 3, "no row of the failed batch is gone");
+
+    run_sql(&db, "DROP TRIGGER fail_delete_mid_batch").await;
+    db.delete(&batch).await.unwrap();
+    assert!(load(&db).await.is_empty());
+}
