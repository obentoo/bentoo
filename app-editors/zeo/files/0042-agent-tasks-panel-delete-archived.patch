+// The thread a deleted record belonged to is untouched: its metadata row stays.
+#[gpui::test]
+async fn delete_action_leaves_the_thread_metadata_untouched(cx: &mut TestAppContext) {
+    init_base(cx);
+    let mut panels = open_panels(cx).await;
+    let thread = open_live_thread(&mut panels, "Kept Thread");
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "completed", 1_000, None)],
+        &mut panels.cx,
+    );
+    let session = session_of(&thread, &panels.cx);
+    let target = key(&session.to_string(), "t");
+    panels
+        .tasks_panel
+        .update(&mut panels.cx, |panel, cx| panel.archive(&target, cx));
+    panels.cx.run_until_parked();
+    only(&mut panels, &[TaskFilter::Archived]);
+
+    request_delete(&mut panels, &session.to_string(), "t");
+    answer(&mut panels, "Delete");
+
+    assert!(find_row(&mut panels, &session.to_string(), "t").is_none());
+    let metadata = panels.cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entry_by_session(&session)
+            .cloned()
+    });
+    assert!(metadata.is_some(), "the thread's metadata row is untouched");
+
+    // The thread keeps reporting the task; the deleted record does not come back.
+    send_tasks(
+        &thread,
+        vec![wire_task("t", "completed", 1_000, None)],
+        &mut panels.cx,
+    );
+    only(&mut panels, &TaskFilter::ALL);
+    assert!(find_row(&mut panels, &session.to_string(), "t").is_none());
+}
