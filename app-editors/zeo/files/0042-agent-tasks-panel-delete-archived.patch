+    /// Deletes a batch of archived tasks in one transaction: when any row fails, every row of
+    /// the batch is kept. A key that is not archived is left in place, so a running or listed
+    /// task is never deleted. Only the history row goes; the thread is never touched.
+    pub async fn delete(&self, keys: &[(acp_v2::SessionId, AgentTaskId)]) -> Result<()> {
+        let keys: Vec<(String, String)> = keys
+            .iter()
+            .map(|(session_id, task_id)| (session_id.to_string(), task_id.to_string()))
+            .collect();
+        self.write(move |connection| {
+            connection.with_savepoint("agent_task_history_delete", || {
+                let mut delete = connection.exec_bound(sql!(
+                    DELETE FROM agent_task_history
+                    WHERE session_id = ?1 AND task_id = ?2 AND archived = 1
+                ))?;
+                for (session_id, task_id) in &keys {
+                    delete((session_id.as_str(), task_id.as_str()))
+                        .with_context(|| format!("deleting {session_id}/{task_id}"))?;
+                }
+                Ok(())
+            })
+        })
+        .await
+    }
