+/// The keys of every archived record, in the store's order.
+fn archived_keys(records: &[HistoryEntry]) -> Vec<TaskKey> {
+    records
+        .iter()
+        .filter(|entry| entry.archived)
+        .map(|entry| {
+            (
+                entry.record.session_id.clone(),
+                entry.record.task_id.clone(),
+            )
+        })
+        .collect()
+}
