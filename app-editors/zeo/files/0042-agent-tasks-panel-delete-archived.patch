@@ -0,0 +1,203 @@
+// Story 025, task 1.2 — deleting archived records (R1, Q4, Q11). Module path: `store::delete`.
+// Every test name starts with `delete_`, the story's validation filter. Hostile fixtures come
+// before benign ones.
+
+use acp_thread::AgentTaskStatus;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, HistoryEntry, TaskHistoryStore};
+
+/// A store over `name`'s database holding `finished` tasks, the ones in `archived` archived.
+async fn seeded_store(
+    name: &'static str,
+    finished: &[(&str, &str)],
+    archived: &[(&str, &str)],
+    cx: &mut TestAppContext,
+) -> (AgentTaskHistoryDb, Entity<TaskHistoryStore>, CardRig) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db(name).await;
+    for (index, (session, task)) in finished.iter().enumerate() {
+        let at = 1_000 + index as i64 * 100;
+        db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+            .await
+            .unwrap();
+        db.update_ended(&record(session, task, AgentTaskStatus::Completed, at))
+            .await
+            .unwrap();
+    }
+    let keys: Vec<_> = archived
+        .iter()
+        .map(|(session, task)| key(session, task))
+        .collect();
+    db.set_archived(&keys, true).await.unwrap();
+    let store = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    store.update(&mut rig.cx, |store, cx| store.register_card(&card, cx));
+    rig.cx.run_until_parked();
+    (db, store, rig)
+}
+
+fn entries(store: &Entity<TaskHistoryStore>, cx: &VisualTestContext) -> Vec<HistoryEntry> {
+    store.read_with(cx, |store, _| store.records().to_vec())
+}
+
+fn keys_of(view: &[HistoryEntry]) -> Vec<(String, String)> {
+    let mut keys: Vec<_> = view.iter().map(key_of).collect();
+    keys.sort();
+    keys
+}
+
+fn pairs(keys: &[(&str, &str)]) -> Vec<(String, String)> {
+    let mut pairs: Vec<_> = keys
+        .iter()
+        .map(|(session, task)| (session.to_string(), task.to_string()))
+        .collect();
+    pairs.sort();
+    pairs
+}
+
+// Hostile: a batch naming an unarchived task, a running one and an unknown key deletes only
+// the archived one — in memory and on disk.
+#[gpui::test]
+async fn delete_leaves_a_non_archived_key_in_the_batch_untouched(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "delete_non_archived_key",
+        &[("s1", "gone"), ("s1", "kept"), ("s2", "gone")],
+        &[("s1", "gone")],
+        cx,
+    )
+    .await;
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s1", "run", AgentTaskStatus::Running, 9_000)),
+        &mut rig.cx,
+    );
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(
+            &[
+                key("s1", "gone"),
+                key("s1", "kept"),
+                key("s1", "run"),
+                key("s2", "gone"),
+                key("s9", "unknown"),
+            ],
+            cx,
+        )
+    });
+    rig.cx.run_until_parked();
+
+    let expected = pairs(&[("s1", "kept"), ("s1", "run"), ("s2", "gone")]);
+    assert_eq!(keys_of(&entries(&store, &rig.cx)), expected, "memory");
+    assert_eq!(keys_of(&load(&db).await), expected, "database");
+}
+
+// Hostile: delete-all spares every unarchived record, a running one and a same-id task of
+// another session included.
+#[gpui::test]
+async fn delete_all_archived_removes_every_archived_row_and_only_those(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "delete_all_archived",
+        &[("s1", "a"), ("s1", "b"), ("s2", "a"), ("s3", "c")],
+        &[("s1", "a"), ("s1", "b"), ("s3", "c")],
+        cx,
+    )
+    .await;
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s4", "run", AgentTaskStatus::Running, 9_000)),
+        &mut rig.cx,
+    );
+
+    store.update(&mut rig.cx, |store, cx| store.delete_all_archived(cx));
+    rig.cx.run_until_parked();
+
+    let expected = pairs(&[("s2", "a"), ("s4", "run")]);
+    assert_eq!(keys_of(&entries(&store, &rig.cx)), expected, "memory");
+    assert_eq!(keys_of(&load(&db).await), expected, "database");
+}
+
+// Q4: a delete whose write fails keeps the rows gone this session and logs both ids.
+#[gpui::test]
+async fn delete_write_failure_keeps_rows_gone_from_memory_and_logs_ids(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "delete_write_failure",
+        &[("session-d1", "task-d1"), ("session-d1", "task-d2")],
+        &[("session-d1", "task-d1")],
+        cx,
+    )
+    .await;
+    drop_history_table(&db).await;
+    capture_logs();
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(&[key("session-d1", "task-d1")], cx)
+    });
+    rig.cx.run_until_parked();
+
+    assert_eq!(
+        keys_of(&entries(&store, &rig.cx)),
+        pairs(&[("session-d1", "task-d2")])
+    );
+    let errors = error_lines();
+    assert!(
+        errors.iter().any(|line| line.contains("delet")
+            && line.contains("session-d1")
+            && line.contains("task-d1")),
+        "the failed delete is logged with both ids: {errors:?}"
+    );
+}
+
+// Hostile: the feed repeats a finished task in later snapshots (a replayed `Started`, then
+// `Ended`); a record deleted this session stays deleted.
+#[gpui::test]
+async fn delete_feed_snapshot_does_not_bring_a_deleted_task_back(cx: &mut TestAppContext) {
+    let (db, store, mut rig) =
+        seeded_store("delete_feed_snapshot", &[("s1", "t1")], &[("s1", "t1")], cx).await;
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(&[key("s1", "t1")], cx)
+    });
+    rig.cx.run_until_parked();
+    let card = rig.card.clone();
+    let finished = record("s1", "t1", AgentTaskStatus::Completed, 1_000);
+    emit(&card, started(&finished), &mut rig.cx);
+    emit(&card, ended(&finished), &mut rig.cx);
+    rig.cx.run_until_parked();
+
+    assert!(entries(&store, &rig.cx).is_empty(), "memory");
+    assert!(load(&db).await.is_empty(), "database");
+}
+
+// R1: deleted records are gone from the database, so a store loaded from it after a restart
+// does not list them; the other records come back as they were.
+#[gpui::test]
+async fn delete_removes_archived_rows_from_memory_and_after_a_reload(cx: &mut TestAppContext) {
+    let (db, store, mut rig) = seeded_store(
+        "delete_reload",
+        &[("s1", "t1"), ("s1", "t2"), ("s2", "t1")],
+        &[("s1", "t1"), ("s2", "t1")],
+        cx,
+    )
+    .await;
+
+    store.update(&mut rig.cx, |store, cx| {
+        store.delete_archived(&[key("s1", "t1"), key("s2", "t1")], cx)
+    });
+    rig.cx.run_until_parked();
+    assert_eq!(
+        keys_of(&entries(&store, &rig.cx)),
+        pairs(&[("s1", "t2")]),
+        "memory"
+    );
+
+    let reloaded = rig.cx.new(|cx| TaskHistoryStore::new(db.clone(), cx));
+    rig.cx.run_until_parked();
+    let view = entries(&reloaded, &rig.cx);
+    assert_eq!(keys_of(&view), pairs(&[("s1", "t2")]), "after a reload");
+    assert!(!view[0].archived);
+}
