+    /// Deletes `key`'s record once the user confirms (story 025). Only an archived record is
+    /// offered for deletion, so a running or listed task never is; the thread is not touched.
+    pub fn request_delete(&mut self, key: &TaskKey, window: &mut Window, cx: &mut Context<Self>) {
+        let (session_id, task_id) = key;
+        let archived = self.store.read(cx).records().iter().any(|entry| {
+            entry.archived
+                && entry.record.session_id == *session_id
+                && entry.record.task_id == *task_id
+        });
+        if !archived {
+            log::debug!(
+                "agent tasks panel: not deleting task {task_id} of session {session_id}: \
+                 it is not archived"
+            );
+            return;
+        }
+        self.confirm_delete(vec![key.clone()], window, cx);
+    }
+
+    /// Deletes every archived record once the user confirms (story 025). The batch is the one
+    /// the prompt counted, so a task archived while it is open is not deleted unasked.
+    pub fn request_delete_all_archived(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        let keys = archived_keys(self.store.read(cx).records());
+        if keys.is_empty() {
+            return;
+        }
+        self.confirm_delete(keys, window, cx);
+    }
+
+    fn confirm_delete(&mut self, keys: Vec<TaskKey>, window: &mut Window, cx: &mut Context<Self>) {
+        let message = match keys.len() {
+            1 => "Delete 1 task record?".to_string(),
+            count => format!("Delete {count} task records?"),
+        };
+        let answer = window.prompt(
+            PromptLevel::Warning,
+            &message,
+            Some("The threads are not affected."),
+            &["Delete", "Cancel"],
+            cx,
+        );
+        let store = self.store.clone();
+        cx.spawn(async move |_, cx| {
+            // Index 0 is "Delete"; `Err` is a prompt whose sender was dropped.
+            if !matches!(answer.await, Ok(0)) {
+                return;
+            }
+            store.update(cx, |store, cx| store.delete_archived(&keys, cx));
+        })
+        .detach();
+    }
