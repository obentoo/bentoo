+// Hostile: Delete is never offered, nor acted on, for a task that is not archived.
+#[gpui::test]
+async fn delete_action_button_renders_only_on_archived_rows(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "kept", AgentTaskStatus::Completed, 1_000, false).await;
+    seed(&db, "s1", "old", AgentTaskStatus::Completed, 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Archived]);
+
+    let labels = painted_labels(&mut panels);
+    assert!(
+        labels.iter().any(|label| label == "Delete: Task old"),
+        "the archived row offers Delete: {labels:?}"
+    );
+    assert!(
+        !labels.iter().any(|label| label == "Delete: Task kept"),
+        "a row that is not archived offers no Delete: {labels:?}"
+    );
+
+    request_delete(&mut panels, "s1", "kept");
+    assert!(
+        !panels.cx.has_pending_prompt(),
+        "nothing to confirm for a task that is not archived"
+    );
+    assert!(find_row(&mut panels, "s1", "kept").is_some());
+}
+
+// Hostile: Delete All Archived spares every listed task of the other filters, and is offered
+// only while the Archived filter is on.
+#[gpui::test]
+async fn delete_action_all_archived_asks_with_the_count_and_empties_the_archived_filter(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "s1", "a1", AgentTaskStatus::Completed, 1_000, true).await;
+    seed(&db, "s1", "a2", AgentTaskStatus::Failed, 1_100, true).await;
+    seed(&db, "s2", "a3", AgentTaskStatus::Stopped, 1_200, true).await;
+    seed(&db, "s2", "done", AgentTaskStatus::Completed, 1_300, false).await;
+    seed(&db, "s3", "bad", AgentTaskStatus::Failed, 1_400, false).await;
+    let mut panels = open_panels(cx).await;
+
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Failed]);
+    let labels = painted_labels(&mut panels);
+    assert!(
+        !labels.iter().any(|label| label == "Delete All Archived"),
+        "not offered while Archived is off: {labels:?}"
+    );
+
+    only(&mut panels, &[TaskFilter::Archived]);
+    let labels = painted_labels(&mut panels);
+    assert!(
+        labels.iter().any(|label| label == "Delete All Archived"),
+        "offered under Archived: {labels:?}"
+    );
+
+    request_delete_all(&mut panels);
+    let (message, detail) = panels.cx.pending_prompt().unwrap();
+    assert_eq!(message, "Delete 3 task records?");
+    assert_eq!(detail, "The threads are not affected.");
+    answer(&mut panels, "Cancel");
+    assert_eq!(visible_keys(&mut panels).len(), 3, "Cancel deletes nothing");
+
+    request_delete_all(&mut panels);
+    answer(&mut panels, "Delete");
+    assert!(
+        visible_keys(&mut panels).is_empty(),
+        "the Archived filter is empty"
+    );
+    only(&mut panels, &[TaskFilter::Finished, TaskFilter::Failed]);
+    let mut kept = visible_keys(&mut panels);
+    kept.sort();
+    assert_eq!(
+        kept,
+        vec![
+            ("s2".to_string(), "done".to_string()),
+            ("s3".to_string(), "bad".to_string()),
+        ],
+        "the other filters keep their rows"
+    );
+    assert_eq!(load(&db).await.len(), 2);
+
+    request_delete_all(&mut panels);
+    assert!(
+        !panels.cx.has_pending_prompt(),
+        "nothing archived is left to confirm"
+    );
+}
+
+// Hostile (race): the archive state changes while the confirmation is open. "Delete" removes
+// exactly the counted batch that is still archived -- not a row unarchived meanwhile, and
+// not one archived after the count was shown.
+#[gpui::test]
+async fn delete_action_all_archived_deletes_only_the_counted_rows_still_archived(
+    cx: &mut TestAppContext,
+) {
+    let db = init_base(cx);
+    seed(&db, "s1", "kept-archived", AgentTaskStatus::Completed, 1_000, true).await;
+    seed(&db, "s1", "unarchived-meanwhile", AgentTaskStatus::Failed, 1_100, true).await;
+    seed(&db, "s2", "archived-meanwhile", AgentTaskStatus::Completed, 1_200, false).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Archived]);
+
+    request_delete_all(&mut panels);
+    let (message, _) = panels.cx.pending_prompt().unwrap();
+    assert_eq!(message, "Delete 2 task records?");
+
+    let unarchive = key("s1", "unarchived-meanwhile");
+    let archive = key("s2", "archived-meanwhile");
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        panel.unarchive(&unarchive, cx);
+        panel.archive(&archive, cx);
+    });
+    panels.cx.run_until_parked();
+    answer(&mut panels, "Delete");
+
+    // What the panel shows comes from the store's memory, not the database -- whose
+    // DELETE also filters on `archived` -- so the memory is checked too.
+    let in_memory = panels.tasks_panel.read_with(&panels.cx, |panel, cx| {
+        panel.store.read(cx).records().to_vec()
+    });
+    assert!(find(&in_memory, "s1", "kept-archived").is_none());
+    assert!(
+        find(&in_memory, "s1", "unarchived-meanwhile").is_some(),
+        "a row unarchived while asking stays on screen"
+    );
+    assert!(find(&in_memory, "s2", "archived-meanwhile").is_some());
+
+    let rows = load(&db).await;
+    assert!(find(&rows, "s1", "kept-archived").is_none(), "the counted row still archived goes");
+    let unarchived = find(&rows, "s1", "unarchived-meanwhile").expect("not deleted");
+    assert!(!unarchived.archived, "a row unarchived while asking is kept, unarchived");
+    let archived = find(&rows, "s2", "archived-meanwhile").expect("not deleted");
+    assert!(archived.archived, "a row archived after the count is not in the batch");
+}
