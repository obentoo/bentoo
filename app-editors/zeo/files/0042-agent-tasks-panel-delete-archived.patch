+
+// Hostile (downgrade): a row with a status this build does not know -- a newer Zeo wrote it --
+// leaves the history Available, so this session's tasks are still loaded and still written.
+#[gpui::test]
+async fn store_one_unreadable_row_does_not_disable_the_history(cx: &mut gpui::TestAppContext) {
+    let mut rig = card_rig(cx).await;
+    let db = AgentTaskHistoryDb::open_test_db("store_unreadable_row").await;
+    db.insert_started(&record("s-old", "kept", AgentTaskStatus::Completed, 1_000))
+        .await
+        .unwrap();
+    run_sql(
+        &db,
+        "INSERT INTO agent_task_history \
+         (session_id, task_id, project, kind, description, background, status, started_at) \
+         VALUES ('s-new', 't-new', 'project', 'shell', 'Task', 0, 'paused', 2000)",
+    )
+    .await;
+
+    let store = registered_store(&db, &mut rig);
+
+    assert!(
+        is_available(&store, &rig.cx),
+        "one unreadable row must not make the history unavailable"
+    );
+    assert!(find(&entries(&store, &rig.cx), "s-old", "kept").is_some());
+
+    let card = rig.card.clone();
+    emit(
+        &card,
+        started(&record("s-live", "t-live", AgentTaskStatus::Running, 3_000)),
+        &mut rig.cx,
+    );
+    assert!(
+        find(&load(&db).await, "s-live", "t-live").is_some(),
+        "this session's tasks are still written"
+    );
+}
