@@ -0,0 +1,293 @@
+// Story 025, task 1.3 — Delete on an archived row and Delete All Archived, both confirmed.
+// Module path: `panel::delete_action`. Every test name starts with `delete_action_`, the
+// story's validation filter.
+
+use acp_thread::AgentTaskStatus;
+use agent_ui::thread_metadata_store::ThreadMetadataStore;
+use gpui::{TestAppContext, VisualTestContext};
+
+use crate::test_helpers::*;
+use crate::{AgentTaskHistoryDb, AgentTasksPanel, TaskFilter};
+
+fn only(panels: &mut Panels, on: &[TaskFilter]) {
+    panels.tasks_panel.update(&mut panels.cx, |panel, cx| {
+        for filter in TaskFilter::ALL {
+            panel.set_filter(filter, on.contains(&filter), cx);
+        }
+    });
+    panels.cx.run_until_parked();
+}
+
+async fn seed(
+    db: &AgentTaskHistoryDb,
+    session: &str,
+    task: &str,
+    status: AgentTaskStatus,
+    at: i64,
+    archived: bool,
+) {
+    db.insert_started(&record(session, task, AgentTaskStatus::Running, at))
+        .await
+        .unwrap();
+    db.update_ended(&record(session, task, status, at))
+        .await
+        .unwrap();
+    if archived {
+        db.set_archived(&[key(session, task)], true).await.unwrap();
+    }
+}
+
+fn request_delete(panels: &mut Panels, session: &str, task: &str) {
+    let target = key(session, task);
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_delete(&target, window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn request_delete_all(panels: &mut Panels) {
+    panels
+        .tasks_panel
+        .update_in(&mut panels.cx, |panel, window, cx| {
+            panel.request_delete_all_archived(window, cx)
+        });
+    panels.cx.run_until_parked();
+}
+
+fn answer(panels: &mut Panels, button: &str) {
+    panels.cx.simulate_prompt_answer(button);
+    panels.cx.run_until_parked();
+}
+
+/// The screen-reader labels of the panel's last paint (GPUI's test windows build no
+/// accessibility tree, so the panel records them).
+fn painted_labels(panels: &mut Panels) -> Vec<String> {
+    let workspace = panels.workspace.clone();
+    workspace.update_in(&mut panels.cx, |workspace, window, cx| {
+        workspace.focus_panel::<AgentTasksPanel>(window, cx);
+    });
+    draw(&mut panels.cx);
+    super::RENDERED_ARIA_LABELS
+        .with_borrow(|labels| labels.iter().map(ToString::to_string).collect())
+}
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+// Hostile: Cancel keeps the record; the same task id in another session survives the confirm.
+#[gpui::test]
+async fn delete_action_on_an_archived_row_asks_first_and_cancel_keeps_it(cx: &mut TestAppContext) {
+    let db = init_base(cx);
+    seed(&db, "s1", "t1", AgentTaskStatus::Completed, 1_000, true).await;
+    seed(&db, "s2", "t1", AgentTaskStatus::Completed, 1_100, true).await;
+    let mut panels = open_panels(cx).await;
+    only(&mut panels, &[TaskFilter::Archived]);
+
+    request_delete(&mut panels, "s1", "t1");
+    assert!(
+        panels.cx.has_pending_prompt(),
+        "Delete asks before deleting"
+    );
+    let (message, detail) = panels.cx.pending_prompt().unwrap();
+    assert_eq!(message, "Delete 1 task record?");
+    assert_eq!(detail, "The threads are not affected.");
+    answer(&mut panels, "Cancel");
+    assert!(
+        find_row(&mut panels, "s1", "t1").is_some(),
+        "Cancel deletes nothing"
+    );
+    assert_eq!(load(&db).await.len(), 2);
+
+    request_delete(&mut panels, "s1", "t1");
+    answer(&mut panels, "Delete");
+    assert!(
+        find_row(&mut panels, "s1", "t1").is_none(),
+        "confirm deletes it"
+    );
+    assert!(
+        find_row(&mut panels, "s2", "t1").is_some(),
+        "the same task id in another session stays"
+    );
+    let stored: Vec<_> = load(&db).await.iter().map(key_of).collect();
+    assert_eq!(stored, vec![("s2".to_string(), "t1".to_string())]);
