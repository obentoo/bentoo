+// ═══ The "Tags…" entry (R1.1, R1.2, R1.10) ═════════════════════════════════
+
+// R1.1, R1.2 — a group row and a pinned row both offer "Tags…", and choosing it opens the Tags
+// picker FOR THAT THREAD: typing a new tag and confirming the first entry (R1.4's "Add tag")
+// tags the clicked thread and no other.
+#[gpui::test]
+async fn tags_entry_on_group_and_pinned_rows_opens_the_picker_for_that_thread(
+    cx: &mut TestAppContext,
+) {
+    let (multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let fix_login = save("a1", "Fix login", ALPHA, 2, cx);
+    let neighbour = save("a2", "Login page", ALPHA, 1, cx);
+    let write_docs = save("b1", "Write docs", BETA, 1, cx);
+    pin(write_docs, cx);
+
+    let ix = group_row_ix(&sidebar, fix_login, cx);
+    right_click(entry_bounds(&sidebar, ix, cx).center(), cx);
+    cx.debug_bounds("MENU_ITEM-Archive Thread")
+        .expect("fixture: the thread's context menu is open");
+    let item = cx
+        .debug_bounds(TAGS_MENU_ITEM)
+        .expect("R1.1: a thread row of a project group offers Tags…");
+    let pin = cx
+        .debug_bounds("MENU_ITEM-Pin Thread")
+        .expect("fixture: Pin Thread is offered");
+    let gap = item.top() - pin.top();
+    assert!(
+        gap > px(0.) && gap < pin.size.height * 1.5,
+        "R1.1: right after Pin Thread"
+    );
+    cx.simulate_click(item.center(), Modifiers::none());
