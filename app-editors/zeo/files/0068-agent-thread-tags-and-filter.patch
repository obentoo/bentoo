+++ b/crates/agent_ui/src/thread_tags_picker_selection_tests.rs
@@ -0,0 +1,332 @@
+// Story 037, task 4.2 — the Tags picker keeps the confirmed tag selected after the list is
+// rebuilt, so a second Enter toggles the SAME tag back. Requirements: R1.12 (with R1.5, R1.6;
+// Q5, Q12). Tech review note N4.
+//
+// Materialize at the end of `crates/agent_ui/src/thread_tags_picker.rs`, beside 4.1's module (a
+// child module, so the tests reach the modal's private `picker` field and the delegate's
+// `selected_index`):
+//     #[cfg(test)]
+//     #[path = "thread_tags_picker_selection_tests.rs"]
+//     mod thread_tags_picker_selection_tests;
+// Filter: `cargo test -p agent_ui thread_tags_picker` (both picker files).
+//
+// A separate file because 4.1's `thread_tags_picker_tests.rs` is at the 500-line limit; its
+// helpers are private, so the minimal setup is repeated here. The same seams as 4.1: the delegate's
+// `test_entries()` ("+ Add tag “<text>”" · "[x] <display>" · "[ ] <display>", one per match
+// index) and `test_message()`.
+//
+// "The confirmed tag" is a KEY, not an index and not a label. Hostile halves first:
+//   - wrong collapse: after "Add tag “ui”" the re-sort puts `build-ui` at the index `ui` had; the
+//     selection must not stay on the index (it would then point at a DIFFERENT tag). `web-ui`
+//     makes `ui` land in the middle of the list, so "select the last entry" is no fix either;
+//   - wrong split: removing a tag no other thread carries turns its entry from "[x] ui" into
+//     "+ Add tag “ui”" — a different label and kind, the same tag. The selection follows it, so
+//     a second Enter adds `ui` back rather than adding the neighbour `build-ui`.
+// Regression guards (green on the tip, kept so a fix cannot break them):
+//   - `confirming_an_applied_tag_keeps_it_selected` — a removal that keeps the entry in place;
+//   - `a_refused_add_keeps_the_selection` — a refusal moves nothing (ToDo 3).
+
+use std::path::Path;
+
+use agent_client_protocol::v2::schema as acp;
+use chrono::Utc;
+use fs::FakeFs;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList, Workspace};
+
