+    assert_eq!(rows.threads, vec!["Fix login".to_string()], "{rows:?}");
+    assert_eq!(rows.pinned, vec!["Write docs".to_string()], "{rows:?}");
+}
+
+// Hook d — a tag-only query (no text) keeps every tagged thread of a group.
+#[gpui::test]
+async fn a_tag_only_query_keeps_every_tagged_thread_of_a_group(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
