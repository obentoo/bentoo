+            badges: 2,
+            ..Row::default()
+        },
+    );
+    assert!(cx.debug_bounds("THREAD_ITEM_BADGE").is_some());
+    let first = cx.debug_bounds("THREAD_ITEM_BADGE_0").expect("first badge");
+    let second = cx
+        .debug_bounds("THREAD_ITEM_BADGE_1")
+        .expect("second badge");
+    assert!(
+        first.right() <= second.left(),
+        "R3.1: {first:?} before {second:?}"
+    );
+}
