+// Story 055, task 14.1 (ui half) — `ThreadItem::badge(icon, tooltip)`, a builder drawn after the
+// title (design.md §B8). Requirement: R8.1 (Q2, Q5).
+// Story 037, task 2.1 — the badge became a list (`badges`, in call order) and the row gained tag
+// chips (`tags`), drawn after every badge, at most three plus "+N", with a tooltip naming every
+// tag. Requirements: R3.1, R3.3, R3.4, R2.2, R2.4, R2.5.
+//
+// Mounted in `crates/ui/src/components/ai/thread_item.rs`, beside `mod tests`:
+//     #[cfg(test)]
+//     #[path = "thread_item_badge_tests.rs"]
+//     mod badge_tests;
+// Filter: `cargo test -p ui thread_item` (paths `components::ai::thread_item::badge_tests::…`).
+//
+// A child module of `thread_item`, so it reads the builder's private fields. `badge_of()` reads
+// the first badge, which is what story 055's tests were written against.
+// Rendering is checked with debug selectors (the pattern of the existing `ACTION_SLOT` test),
+// because a GPUI test cannot read painted text: `THREAD_ITEM_BADGE` (the container, kept for 055
+// and story 039), `THREAD_ITEM_BADGE_<ix>`, `THREAD_ITEM_TAG_CHIPS`, `THREAD_ITEM_TAG_CHIP_<ix>`,
+// `THREAD_ITEM_TAG_MORE`, and inside tooltips `THREAD_ITEM_BADGE_TOOLTIP-<ix>` and
+// `THREAD_ITEM_TAG_TOOLTIP-<tag>`.
+//
+// Hostile halves first: a row WITHOUT the builder calls has no badge and no chip (a default would
+// mark every editor thread), and neither displaces the action slot — the row still routes a click
+// on its action slot to the action, not to the row.
+
+use super::*;
+use gpui::{Entity, Modifiers, MouseButton, TestAppContext, VisualTestContext, point};
+use std::time::Duration;
+
+const LONG_TITLE: &str = "A rather long thread title that will truncate";
+
+fn badge_of(item: &ThreadItem) -> Option<(IconName, SharedString)> {
+    item.badges.first().cloned()
+}
+
+fn shared(values: &[&str]) -> Vec<SharedString> {
+    values
+        .iter()
+        .map(|value| SharedString::from(*value))
+        .collect()
+}
+
+fn init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let settings_store = settings::SettingsStore::test(cx);
+        cx.set_global(settings_store);
+        theme_settings::init(theme::LoadThemes::JustBase, cx);
+    });
+}
