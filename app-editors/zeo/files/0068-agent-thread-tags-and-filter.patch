+// Story 037, task 5.1 (part 1 of 2) — tags in the threads sidebar: the "Tags…" entry of the
+// thread menu and the chips on group and pinned rows, plus the fixtures both parts share. Part 2,
+// `sidebar_tags_filter_tests.rs`, holds the `#tag` filter. Two files because one would pass the
+// constitution's 500-line limit. Requirements here: R1.1, R1.2, R1.10, R2.1, R2.3, R2.4, R2.6 (Q5,
+// Q11, Q12).
+//
+// Materialize with, in `crates/sidebar/src/sidebar.rs`, beside `mod sidebar_organization_tests;`:
+//     #[cfg(test)]
+//     mod sidebar_tags_tests;
+//     #[cfg(test)]
+//     mod sidebar_tags_filter_tests;
+// Filter: `cargo test -p sidebar sidebar_tags` (both files).
+//
+// Reuses story 032's `pub(super)` helpers from `sidebar_tests.rs`. Assumed seams — each named in
+// ONE place below, adjust there if it moved:
+//   - `chips_of()`: `thread_tags::tag_chips_for(thread_id, cx) -> Vec<SharedString>` (task 5.1
+//     Objective; `pub(crate)` at least), the full list a row is given, in first spelling,
+//     ordered by key (`ThreadItem` draws three plus "+N", task 2.1);
+//   - `CHIPS_SELECTOR`: the debug selector task 2.1 puts on a row's chips, so a test can tell
+//     that a row DRAWS its chips, not only that a function returns them;
+//   - `TAGS_MENU_ITEM`: the menu entry "Tags…" (U+2026, as in R1.1), read through the
+//     `MENU_ITEM-<label>` selector every `ContextMenu` entry carries;
+//   - `tags_picker_open()`: `agent_ui::thread_tags_picker::ThreadTagsPicker` (a `pub mod`), the
+//     workspace's active modal once "Tags…" is chosen (task 4.1). The menu test types into the
+//     opened picker and confirms its first entry, so it also proves the picker targets the
+//     clicked thread;
+//   - `tooltip_lists()`: task 2.1's chips tooltip shows after GPUI's hover delay and renders one
+//     label per tag, each with the debug selector `THREAD_ITEM_TAG_TOOLTIP-<display>` (a
+//     selector, because a GPUI test cannot read painted text).
+//
+// Hostile halves first: no chip drawn anywhere while no thread carries a tag, and none on the
+// untagged neighbour, before the tagged row draws its own; a second spelling of a tag ("rust"
+// after "Rust") is not a second chip; the picker opened from one row never tags its neighbour;
+// the tooltip lists the tags hidden behind "+N", and never another thread's tag.
+// `tags_entry_is_absent_without_the_store` also passes on the series tip (a regression guard).
+//
+// NOT covered here: R2.7 (chips after a restart) — the store's persistence (0048) plus the GUI
+// proof (task 9.1).
+
+use super::*;
+use crate::sidebar_tests::{init_test, save_thread_metadata_with_main_paths, setup_sidebar};
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use agent_ui::thread_tags_picker::ThreadTagsPicker;
+use fs::FakeFs;
+use gpui::{Bounds, MouseButton, Point, TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+
+pub(super) const ALPHA: &str = "/alpha";
+pub(super) const BETA: &str = "/beta";
+
+/// Task 2.1's debug selector on a row's chips.
+pub(super) const CHIPS_SELECTOR: &str = "THREAD_ITEM_TAG_CHIPS";
+/// R1.1's entry, as `ContextMenu` names its debug selector.
+pub(super) const TAGS_MENU_ITEM: &str = "MENU_ITEM-Tags…";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// A window on `ALPHA` and `BETA` (two project groups) with its sidebar open; the organization
+/// store is installed before the sidebar exists when `with_store`.
+pub(super) async fn two_projects(
+    with_store: bool,
+    cx: &mut TestAppContext,
+) -> (
+    Entity<MultiWorkspace>,
+    Entity<Sidebar>,
+    &mut VisualTestContext,
+) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    for path in [ALPHA, BETA] {
+        fs.insert_tree(path, serde_json::json!({ "src": {} })).await;
+    }
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        if with_store {
+            agent_ui::thread_organization::init(cx);
+        }
+    });
+    cx.run_until_parked();
+    let alpha = project::Project::test(fs.clone(), [ALPHA.as_ref()], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(alpha, window, cx));
+    let sidebar = setup_sidebar(&multi_workspace, cx);
+    let beta = project::Project::test(fs as Arc<dyn fs::Fs>, [BETA.as_ref()], cx).await;
+    multi_workspace.update_in(cx, |multi_workspace, window, cx| {
+        multi_workspace.test_add_workspace(beta, window, cx);
+    });
+    cx.run_until_parked();
+    (multi_workspace, sidebar, cx)
+}
+
+/// Saves a thread with a sent message in the local project `folder`; a later `minute` is more
+/// recent.
+pub(super) fn save(
+    session: &str,
+    title: &str,
+    folder: &str,
+    minute: u32,
+    cx: &mut VisualTestContext,
+) -> ThreadId {
+    let paths = PathList::new(&[PathBuf::from(folder)]);
+    save_thread_metadata_with_main_paths(
+        session,
+        title,
+        paths.clone(),
+        paths,
+        chrono::TimeZone::with_ymd_and_hms(&Utc, 2026, 10, 20, 12, minute, 0).unwrap(),
+        cx,
+    );
+    let session_id = acp::SessionId::new(Arc::from(session));
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx)
+            .read(cx)
+            .entries()
+            .find(|entry| entry.session_id.as_ref() == Some(&session_id))
+            .map(|entry| entry.thread_id)
+            .expect("fixture: the thread was saved")
+    })
+}
+
+// ── The store, driven directly (fixtures, not the code under test) ─────────
