+        rows.threads,
+        titles(&["Fix login", "Login page", "Write docs"])
+    );
+    assert_eq!(rows.headers, titles(&["alpha", "beta"]));
+}
+
+// R4.14 — the text beside a term is matched as typed, highlight included.
+#[gpui::test]
+async fn text_beside_a_tag_term_keeps_its_case_and_spacing(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
