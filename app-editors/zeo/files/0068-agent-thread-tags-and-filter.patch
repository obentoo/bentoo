diff --git a/crates/agent_ui/src/threads_archive_view_tags_tests.rs b/crates/agent_ui/src/threads_archive_view_tags_tests.rs
new file mode 100644
index 0000000..e5defa7
--- /dev/null
+++ b/crates/agent_ui/src/threads_archive_view_tags_tests.rs
@@ -0,0 +1,298 @@
+// Story 037, task 6.1 — the `#tag` filter in the History view (`ThreadsArchiveView`).
+// Requirements: R5.1–R5.4 (Q5, Q11).
+//
+// Materialize at the end of `crates/agent_ui/src/threads_archive_view.rs` (a child module, so
+// the tests reach the view's private filter editor, list and All/Archived choice):
+//     #[cfg(test)]
+//     #[path = "threads_archive_view_tags_tests.rs"]
+//     mod threads_archive_view_tags_tests;
+// Filter: `cargo test -p agent_ui threads_archive_view` (the paths are
+// `threads_archive_view::threads_archive_view_tags_tests::…`).
+//
+// The real view over the real stores: a window on `/project-a`, every thread of that project, so
+// the file holds with and without 0015's project scoping (037's edit lands before 0015 in the
+// series). Text goes in through the view's own filter editor; the All/Archived choice is set
+// the way its toggle button sets it. Rows are read as sorted titles: no assertion depends on the
+// time buckets or their order.
+//
+// Hostile halves first:
+//   - a plain-text match on the project FOLDER name must not bring in an untagged thread under a
+//     tag term (every thread here is in `/project-a`, so without the tag rule "project-a" lists
+//     them all) — before the tag-and-title combination that does hold;
+//   - the tag term matches the KEY exactly: a title holding "php" and a longer tag "phpunit" stay
+//     out, while `#PHP` still matches the thread tagged "php".
+// `plain_text_filters_as_before` also passes on the series tip (a regression guard).
+
+use std::path::Path;
+
+use chrono::Utc;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext, WeakEntity};
+use pretty_assertions::assert_eq;
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList};
+
+use super::{ArchiveListItem, ThreadFilter, ThreadsArchiveView};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore, WorktreePaths};
+use crate::thread_organization::ThreadOrganizationStore;
+use agent_client_protocol::v2::schema as acp;
+
+const PROJECT: &str = "/project-a";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+/// Agent UI test globals, upstream's thread stores, the organization store, a window on
+/// `PROJECT`, and the History view of that window's workspace.
+async fn history(cx: &mut TestAppContext) -> (Entity<ThreadsArchiveView>, &mut VisualTestContext) {
+    crate::test_support::init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(PROJECT, json!({ "src": {} })).await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        prompt_store::init(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        agent::ThreadStore::init_global(cx);
+        ThreadMetadataStore::init_global(cx);
+    });
+    cx.run_until_parked();
+    cx.update(crate::thread_organization::init);
+    cx.run_until_parked();
+    let project = Project::test(fs, [Path::new(PROJECT)], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let workspace =
+        multi_workspace.read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone());
+    let view = cx.update(|window, cx| {
+        cx.new(|cx| {
+            ThreadsArchiveView::new(
+                workspace.downgrade(),
+                WeakEntity::new_invalid(),
+                WeakEntity::new_invalid(),
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (view, cx)
+}
+
+/// A thread with a sent message in `PROJECT`, created `age_minutes` ago.
+fn thread(title: &str, archived: bool, age_minutes: i64, cx: &mut VisualTestContext) -> ThreadId {
+    let created = Utc::now() - chrono::Duration::minutes(age_minutes);
+    let thread_id = ThreadId::new();
+    let metadata = ThreadMetadata {
+        thread_id,
+        session_id: Some(acp::SessionId::new(format!(
+            "history-{}",
+            thread_id.to_key_string()
+        ))),
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: Some(title.to_string().into()),
+        title_override: None,
+        updated_at: created,
+        created_at: Some(created),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(PROJECT)])),
+        remote_connection: None,
+        archived,
+    };
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+fn tag(thread_id: ThreadId, tag: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.add_tag(thread_id, tag, cx))
+    })
+    .expect("fixture: the store accepts a valid tag on a thread with a message");
+    cx.run_until_parked();
+}
+
+fn untag(thread_id: ThreadId, tag: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.remove_tag(thread_id, tag, cx))
+    })
+    .expect("fixture: the store removes a tag of a thread with a message");
+    cx.run_until_parked();
+}
+
+// ── Driving and reading the view ───────────────────────────────────────────
+
+fn type_filter(view: &Entity<ThreadsArchiveView>, text: &str, cx: &mut VisualTestContext) {
+    view.update_in(cx, |view, window, cx| {
+        view.filter_editor
+            .update(cx, |editor, cx| editor.set_text(text, window, cx));
+    });
+    cx.run_until_parked();
+}
+
+/// The All/Archived choice, set as its toggle button sets it.
+fn choose(view: &Entity<ThreadsArchiveView>, filter: ThreadFilter, cx: &mut VisualTestContext) {
+    view.update(cx, |view, cx| {
+        view.thread_filter = filter;
+        view.update_items(cx);
+    });
+    cx.run_until_parked();
+}
+
+/// Titles of the listed threads, sorted.
+fn listed(view: &Entity<ThreadsArchiveView>, cx: &mut VisualTestContext) -> Vec<String> {
+    let mut titles: Vec<String> = view.read_with(cx, |view, _| {
+        view.items
+            .iter()
+            .filter_map(|item| match item {
+                ArchiveListItem::Entry { thread, .. } => Some(thread.display_title().to_string()),
+                ArchiveListItem::BucketSeparator(_) => None,
+            })
+            .collect()
+    });
+    titles.sort();
+    titles
+}
+
+fn titles(titles: &[&str]) -> Vec<String> {
+    let mut titles: Vec<String> = titles.iter().map(|title| title.to_string()).collect();
+    titles.sort();
+    titles
+}
+
+/// "Fix login" [php], "Login page" [], "Write docs" [PHP], "php notes" [], "Tune cache" [phpunit],
+/// and two archived threads: "Old php work" [php], "Old mail" [].
+struct Fixture {
+    fix_login: ThreadId,
+    login_page: ThreadId,
+}
+
+fn seed(cx: &mut VisualTestContext) -> Fixture {
+    let fix_login = thread("Fix login", false, 1, cx);
+    let login_page = thread("Login page", false, 2, cx);
+    let write_docs = thread("Write docs", false, 3, cx);
+    thread("php notes", false, 4, cx);
+    let tune_cache = thread("Tune cache", false, 5, cx);
+    let old_php = thread("Old php work", true, 6, cx);
+    thread("Old mail", true, 7, cx);
+    tag(write_docs, "PHP", cx);
+    tag(fix_login, "php", cx);
+    tag(tune_cache, "phpunit", cx);
+    tag(old_php, "php", cx);
+    Fixture {
+        fix_login,
+        login_page,
+    }
+}
+
+// ═══ Tests ═════════════════════════════════════════════════════════════════
+
+// R5.2 hostile half — the folder name "project-a" matches every thread here; with a tag term it
+// brings in only the tagged ones.
+#[gpui::test]
+async fn a_folder_name_match_does_not_bring_untagged_threads_in(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    seed(cx);
+    type_filter(&view, "project-a", cx);
+    assert_eq!(
+        listed(&view, cx).len(),
+        7,
+        "control: the folder name alone lists every thread"
+    );
+
+    type_filter(&view, "#php project-a", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Fix login", "Old php work", "Write docs"])
+    );
+}
+
+// R5.1 hostile half, then the converse — the term matches the tag key exactly ("php notes" and
+// the "phpunit" thread stay out), case-insensitively ("PHP" on one thread, `#PHP` typed).
+#[gpui::test]
+async fn a_tag_term_matches_the_key_exactly(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    seed(cx);
+
+    type_filter(&view, "#php", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Fix login", "Old php work", "Write docs"]),
+        "R5.1 under All"
+    );
+    type_filter(&view, "#PHP", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Fix login", "Old php work", "Write docs"])
+    );
+}
+
+// R5.1 — under the Archived choice, only the archived threads carrying the tag.
+#[gpui::test]
+async fn a_tag_term_holds_under_the_archived_choice(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    seed(cx);
+    choose(&view, ThreadFilter::ArchivedOnly, cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Old mail", "Old php work"]),
+        "control: the Archived choice"
+    );
+
+    type_filter(&view, "#php", cx);
+    assert_eq!(listed(&view, cx), vec!["Old php work".to_string()]);
+}
+
+// R5.2 — a tag term and title text combine, in either order.
+#[gpui::test]
+async fn a_tag_term_and_title_text_combine(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    seed(cx);
+    for query in ["#php login", "login #php"] {
+        type_filter(&view, query, cx);
+        assert_eq!(
+            listed(&view, cx),
+            vec!["Fix login".to_string()],
+            "{query:?}: 'Login page' matches the text without the tag"
+        );
+    }
+}
+
+// R5.3 — plain text filters exactly as before this story (regression guard; the expected rows
+// are the series tip's): a title match, and "php" read as text, not as a tag.
+#[gpui::test]
+async fn plain_text_filters_as_before(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    seed(cx);
+    type_filter(&view, "login", cx);
+    assert_eq!(listed(&view, cx), titles(&["Fix login", "Login page"]));
+    type_filter(&view, "php", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Old php work", "php notes"]),
+        "without '#', the tags play no part"
+    );
+}
+
+// R5.4 — while `#php` is typed, a thread gaining or losing the tag joins or leaves the list
+// without the filter being retyped.
+#[gpui::test]
+async fn a_tag_change_updates_the_list_under_a_tag_term(cx: &mut TestAppContext) {
+    let (view, cx) = history(cx).await;
+    let fixture = seed(cx);
+    type_filter(&view, "#php", cx);
+
+    tag(fixture.login_page, "Php", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Fix login", "Login page", "Old php work", "Write docs"])
+    );
+    untag(fixture.fix_login, "php", cx);
+    assert_eq!(
+        listed(&view, cx),
+        titles(&["Login page", "Old php work", "Write docs"])
+    );
+}
