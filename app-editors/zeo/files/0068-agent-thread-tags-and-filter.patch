+//! Tags in the threads sidebar (story 037): the "Tags…" menu entry, the chips on a row and the
+//! `#tag` part of the filter. `sidebar.rs` only calls into it through one-line hooks.
+
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use agent_ui::ThreadId;
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use agent_ui::thread_tag_filter::TagQuery;
+use agent_ui::thread_tags_picker::ThreadTagsPicker;
+use gpui::{App, Entity, SharedString, WeakEntity};
+use ui::ContextMenu;
+
+use crate::{Sidebar, TerminalEntry, ThreadEntry};
+
+/// Every tag of the thread in its first spelling. The store keeps a thread's keys sorted, which
+/// is the order R2.1 asks for. Empty without the store: there is nowhere a tag could live.
+pub(crate) fn tag_chips_for(thread_id: ThreadId, cx: &App) -> Vec<SharedString> {
+    let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+        return Vec::new();
+    };
+    store
+        .read(cx)
+        .tags(thread_id)
+        .into_iter()
+        .map(|tag| tag.display)
+        .collect()
+}
+
+/// With `#` terms, keeps only the threads carrying every tag and drops every terminal and draft,
+/// none of which can carry one (R4.9). A tag-only query gets the kept threads back: an empty text
+/// matches nothing in the group's text loop, which would otherwise drop them all.
+///
+/// Every dropped thread goes into `hidden_thread_ids`: hidden, not gone (R4.15), so the rebuild's
+/// purge keeps its notification and access time for when the term is removed — 0063's rule for
+/// the devtools-only view. A notification is seen once, so one purged here never comes back.
+pub(crate) fn retain_tagged(
+    threads: &mut Vec<Arc<ThreadEntry>>,
+    terminals: &mut Vec<TerminalEntry>,
+    tag_query: &TagQuery,
+    hidden_thread_ids: &mut HashSet<ThreadId>,
+    cx: &App,
+) -> Option<Vec<Arc<ThreadEntry>>> {
+    if !tag_query.has_keys() {
+        return None;
+    }
+    terminals.clear();
+    let store = ThreadOrganizationStore::try_global(cx);
+    threads.retain(|thread| {
+        let kept = thread.draft.is_none() && carries_tags(store.as_ref(), tag_query, thread, cx);
+        if !kept {
+            hidden_thread_ids.insert(thread.metadata.thread_id);
+        }
+        kept
+    });
+    let text_is_empty = tag_query.text.as_deref().is_none_or(str::is_empty);
+    text_is_empty.then(|| threads.clone())
+}
+
+/// The Pinned section's share of the `#` terms (R4.7); its text part is matched by
+/// `filter_pinned_rows`, as before. Dropped rows go into `hidden_thread_ids`, as in
+/// `retain_tagged`: R4.15 covers every row the term hides, pinned ones included.
+pub(crate) fn retain_tagged_rows(
+    rows: Vec<Arc<ThreadEntry>>,
+    tag_query: &TagQuery,
+    hidden_thread_ids: &mut HashSet<ThreadId>,
+    cx: &App,
+) -> Vec<Arc<ThreadEntry>> {
+    if !tag_query.has_keys() {
+        return rows;
+    }
+    let store = ThreadOrganizationStore::try_global(cx);
+    let (kept, hidden): (Vec<_>, Vec<_>) = rows
+        .into_iter()
+        .partition(|row| carries_tags(store.as_ref(), tag_query, row, cx));
+    hidden_thread_ids.extend(hidden.iter().map(|row| row.metadata.thread_id));
+    kept
+}
+
+fn carries_tags(
+    store: Option<&Entity<ThreadOrganizationStore>>,
+    tag_query: &TagQuery,
+    thread: &ThreadEntry,
+    cx: &App,
+) -> bool {
+    store.is_some_and(|store| tag_query.thread_matches(store.read(cx), thread.metadata.thread_id))
+}
+
+/// "Tags…" for the thread's menu (R1.1), offered only when the store is installed (R1.10).
+pub(crate) fn tags_menu_entry(
+    menu: ContextMenu,
+    thread_id: ThreadId,
+    sidebar: WeakEntity<Sidebar>,
+    cx: &App,
+) -> ContextMenu {
+    if ThreadOrganizationStore::try_global(cx).is_none() {
+        return menu;
+    }
+    menu.entry("Tags…", None, move |window, cx| {
+        // Resolved on click: the active workspace can change while the menu is open.
+        let workspace = sidebar
+            .read_with(cx, |sidebar, cx| sidebar.active_workspace(cx))
+            .ok()
+            .flatten();
+        let Some(workspace) = workspace else {
+            log::warn!("sidebar: no workspace to open the tags picker for thread {thread_id:?}");
+            return;
+        };
+        workspace.update(cx, |workspace, cx| {
+            workspace.toggle_modal(window, cx, |window, cx| {
+                ThreadTagsPicker::new(thread_id, window, cx)
+            });
+        });
+    })
+}
