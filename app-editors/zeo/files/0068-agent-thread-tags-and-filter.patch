+// Story 037, task 5.1 (part 2 of 2) — the `#tag` filter in the threads sidebar, in project
+// groups and in the Pinned section. Part 1, `sidebar_tags_tests.rs`, holds the shared fixtures
+// (`two_projects`, `save`, `tag`, `pin`, …), the menu entry and the chips. Requirements here:
+// R4.1–R4.9, R4.11–R4.14 (Q5, Q11).
+//
+// Materialize beside part 1 (see its header); filter `cargo test -p sidebar sidebar_tags`.
+//
+// Hostile halves come first in every identity rule:
+//   - a `#php` term matches the tag KEY exactly: a thread titled "php notes" with no tag and a
+//     thread tagged "phpunit" stay out (the wrong collapse of text, or of a longer tag, into the
+//     tag), before `#pHp` must still bring in the threads tagged "PHP" and "php" (the wrong
+//     split);
+//   - a project label matching the plain text must not bring an untagged thread in, nor show a
+//     header with no tagged row (R4.8), before the label match that does hold; the same for a
+//     pinned row whose label matches;
+//   - a valid tag no thread carries shows nothing even when a title holds the literal "#ghost"
+//     (it is a tag term, not text), while an invalid term "#a,b" is text and must not match the
+//     thread tagged "ab";
+//   - text beside a term keeps case and spacing (R4.14): "Fix  login" (two spaces) matches no
+//     title; "AÇÃO" matches "Ajustar AÇÃO", which a lowercased "ação" misses (ASCII-only fold).
+// Regression guards, green on the tip: `plain_text_filters_as_before`, `an_invalid_tag_term_*`.
+
+use super::*;
+use crate::sidebar_tags_tests::*;
+use crate::sidebar_tests::{
+    init_test_project_with_agent_panel, setup_sidebar_with_agent_panel, type_in_search,
+};
+use gpui::{MouseButton, Point, TestAppContext, VisualTestContext, point};
+use pretty_assertions::assert_eq;
+
+/// A draft (no session) in `folder` with prompt text: an empty one is listed only while active.
+fn save_draft(folder: &str, cx: &mut VisualTestContext) -> ThreadId {
+    let thread_id = ThreadId::new();
+    let paths = PathList::new(&[PathBuf::from(folder)]);
+    let metadata = ThreadMetadata {
+        thread_id,
+        session_id: None,
+        agent_id: ZED_AGENT_ID.clone(),
+        title: None,
+        title_override: None,
+        updated_at: Utc::now(),
+        created_at: None,
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_path_lists(paths.clone(), paths)
+            .expect("fixture: one folder is a valid worktree pair"),
+        archived: false,
+        remote_connection: None,
+    };
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx));
+        agent_ui::draft_prompt_store::write(thread_id, &["wip".into()], cx).detach_and_log_err(cx);
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+// ── Reading the sidebar ────────────────────────────────────────────────────
+
+/// What the sidebar shows, each list sorted so group order never matters.
+#[derive(Debug, Default, PartialEq)]
+struct Shown {
+    headers: Vec<String>,
+    /// Group rows of threads with a message.
+    threads: Vec<String>,
+    /// Rows of the Pinned section.
+    pinned: Vec<String>,
+    pinned_header: bool,
+    terminals: Vec<String>,
+    drafts: usize,
+}
+
+fn shown(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Shown {
+    sidebar.read_with(cx, |sidebar, _| {
+        let mut shown = Shown::default();
+        for entry in &sidebar.contents.entries {
+            match entry {
+                ListEntry::ProjectHeader { label, .. } => shown.headers.push(label.to_string()),
+                ListEntry::PinnedHeader { .. } => shown.pinned_header = true,
+                ListEntry::Terminal(terminal) => shown
+                    .terminals
+                    .push(terminal.metadata.display_title().to_string()),
+                ListEntry::Thread(thread) if thread.draft.is_some() => shown.drafts += 1,
+                ListEntry::Thread(thread) => {
+                    let title = thread.metadata.display_title().to_string();
+                    if thread.pinned_project_label.is_some() {
+                        shown.pinned.push(title);
+                    } else {
+                        shown.threads.push(title);
+                    }
+                }
+            }
+        }
+        shown.headers.sort();
+        shown.threads.sort();
+        shown.pinned.sort();
+        shown.terminals.sort();
+        shown
+    })
+}
+
+fn titles(titles: &[&str]) -> Vec<String> {
+    let mut titles: Vec<String> = titles.iter().map(|title| title.to_string()).collect();
+    titles.sort();
+    titles
+}
+
+/// Press, move past GPUI's drag threshold, release where it started: whether a drag began.
+fn drag_starts_at(from: Point<Pixels>, cx: &mut VisualTestContext) -> bool {
+    cx.simulate_mouse_down(from, MouseButton::Left, Modifiers::none());
+    cx.simulate_mouse_move(
+        point(from.x, from.y + px(6.)),
+        MouseButton::Left,
+        Modifiers::none(),
+    );
+    let started = cx.update(|_, cx| cx.has_active_drag());
+    cx.simulate_mouse_move(from, MouseButton::Left, Modifiers::none());
+    cx.simulate_mouse_up(from, MouseButton::Left, Modifiers::none());
+    cx.run_until_parked();
+    started
+}
+
+fn has_filter_query(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> bool {
+    sidebar.read_with(cx, |sidebar, cx| sidebar.has_filter_query(cx))
+}
+
+/// alpha: "Fix login" [php], "Login page" [], "Tune cache" [phpunit], "php notes" [];
+/// beta: "Write docs" [php, urgent], "Read mail" [urgent].
+struct Fixture {
+    fix_login: ThreadId,
+    login_page: ThreadId,
+    write_docs: ThreadId,
+    read_mail: ThreadId,
+}
+
+fn seed(cx: &mut VisualTestContext) -> Fixture {
+    let fix_login = save("a1", "Fix login", ALPHA, 4, cx);
+    let login_page = save("a2", "Login page", ALPHA, 3, cx);
+    let tune_cache = save("a3", "Tune cache", ALPHA, 2, cx);
+    save("a4", "php notes", ALPHA, 1, cx);
+    let write_docs = save("b1", "Write docs", BETA, 2, cx);
+    let read_mail = save("b2", "Read mail", BETA, 1, cx);
+    tag(fix_login, "PHP", cx);
+    tag(tune_cache, "phpunit", cx);
+    tag(write_docs, "php", cx);
+    tag(write_docs, "urgent", cx);
+    tag(read_mail, "urgent", cx);
+    Fixture {
+        fix_login,
+        login_page,
+        write_docs,
+        read_mail,
+    }
+}
+
+// ═══ The `#tag` filter (R4.1–R4.9, R4.11, R4.12) ═══════════════════════════
+
+// R4.1 hostile half first — the term matches the tag KEY exactly: neither a title holding the
+// text ("php notes") nor a longer tag ("phpunit") comes in. Then the converse: a different case
+// in the filter or in the stored spelling is the same tag, across both projects.
+#[gpui::test]
+async fn a_tag_term_matches_the_key_exactly_not_text_or_a_longer_tag(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+
+    type_in_search(&sidebar, "#php", cx);
+    let rows = shown(&sidebar, cx);
+    assert_eq!(
+        rows.threads,
+        titles(&["Fix login", "Write docs"]),
+        "{rows:?}"
+    );
+    assert_eq!(rows.headers, titles(&["alpha", "beta"]));
+
+    type_in_search(&sidebar, "#pHp", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Fix login", "Write docs"]),
+        "R4.1 compared case-insensitively ('PHP' on one thread, 'php' typed on the other)"
+    );
+}
+
+// R4.2 — a tag term and plain text together: only rows carrying the tag AND matching the text,
+// whichever order they are typed in.
+#[gpui::test]
+async fn a_tag_term_and_plain_text_combine(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+
+    for query in ["#php login", "login #php"] {
+        type_in_search(&sidebar, query, cx);
+        let rows = shown(&sidebar, cx);
+        assert_eq!(
+            rows.threads,
+            vec!["Fix login".to_string()],
+            "{query:?}: 'Login page' matches the text but carries no tag, 'Write docs' carries \
+             the tag but does not match the text"
+        );
+        assert_eq!(rows.headers, vec!["alpha".to_string()]);
+    }
+}
+
+// R4.3 — several tag terms: every one is required.
+#[gpui::test]
+async fn several_tag_terms_require_every_tag(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+
+    type_in_search(&sidebar, "#php #urgent", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        vec!["Write docs".to_string()],
+        "'Fix login' (php only) and 'Read mail' (urgent only) are out"
+    );
+}
+
+// R4.4 — a valid tag no thread carries shows no row and the "No threads match your search."
+// state, even though a title holds the literal text "#ghost" (the term is a tag, not text).
+#[gpui::test]
+async fn a_tag_no_thread_carries_shows_no_rows(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+    save("a9", "Deploy #ghost fix", ALPHA, 9, cx);
+    type_in_search(&sidebar, "ghost", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        vec!["Deploy #ghost fix".to_string()],
+        "control: the title holds the text"
+    );
+
+    type_in_search(&sidebar, "#ghost", cx);
+    assert_eq!(shown(&sidebar, cx), Shown::default(), "no row, no header");
+    assert!(
+        has_filter_query(&sidebar, cx),
+        "the empty state is the search one: \"No threads match your search.\""
+    );
+}
+
+// R4.8 hostile — with a tag term, a project label matching the plain text no longer brings in
+// every thread of the project: only its tagged rows, and no header at all when none is tagged.
+#[gpui::test]
+async fn a_project_label_match_does_not_bring_untagged_threads_in(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+    type_in_search(&sidebar, "alpha", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Fix login", "Login page", "Tune cache", "php notes"]),
+        "control: without a tag term, the label match lists the whole project"
+    );
+
+    type_in_search(&sidebar, "#php alpha", cx);
+    let rows = shown(&sidebar, cx);
+    assert_eq!(rows.threads, vec!["Fix login".to_string()], "{rows:?}");
+    assert_eq!(rows.headers, vec!["alpha".to_string()]);
+
+    type_in_search(&sidebar, "#urgent alpha", cx);
+    assert_eq!(
+        shown(&sidebar, cx),
+        Shown::default(),
+        "alpha's label matches but no alpha thread is urgent: no header"
+    );
+}
+
+// R4.6 — an invalid `#` term is plain text: "#a,b" matches the title holding it and not the
+// thread tagged "ab" (the term is not cleaned into a tag).
+#[gpui::test]
+async fn an_invalid_tag_term_is_plain_text(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let fixture = seed(cx);
+    save("a9", "Fix #a,b parsing", ALPHA, 9, cx);
+    tag(fixture.read_mail, "ab", cx);
+
+    type_in_search(&sidebar, "#a,b", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        vec!["Fix #a,b parsing".to_string()]
+    );
+}
+
+// R4.5 — plain text filters exactly as before this story (regression guard; the expected rows
+// are the series tip's): a title match, and a label match listing the whole project.
+#[gpui::test]
+async fn plain_text_filters_as_before(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    seed(cx);
+
+    type_in_search(&sidebar, "login", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Fix login", "Login page"])
+    );
+    type_in_search(&sidebar, "beta", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Read mail", "Write docs"])
+    );
+    type_in_search(&sidebar, "php", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        vec!["php notes".to_string()],
+        "without '#', 'php' is text: the tags play no part"
+    );
+}
+
+// R4.7 — the Pinned section is filtered by the same term: a pinned untagged row whose project
+// label matches the text stays out, the tagged one stays in, once.
+#[gpui::test]
+async fn the_pinned_section_is_filtered_by_the_tag_term(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let fixture = seed(cx);
+    pin(fixture.write_docs, cx);
+    pin(fixture.read_mail, cx);
+
+    type_in_search(&sidebar, "#php beta", cx);
+    let rows = shown(&sidebar, cx);
+    assert_eq!(rows.pinned, vec!["Write docs".to_string()], "{rows:?}");
+    assert!(rows.pinned_header);
+    assert!(
+        rows.threads.is_empty(),
+        "both beta threads are pinned, so no group row"
+    );
+
+    type_in_search(&sidebar, "#php", cx);
+    let rows = shown(&sidebar, cx);
+    assert_eq!(rows.pinned, vec!["Write docs".to_string()]);
+    assert_eq!(rows.threads, vec!["Fix login".to_string()]);
+
+    type_in_search(&sidebar, "#ghost", cx);
+    assert!(
+        !shown(&sidebar, cx).pinned_header,
+        "no pinned row matches: no Pinned header"
+    );
+}
+
+// R4.9 — terminal and draft rows carry no tags: a tag term hides them even where the project
+// label matches the text (without a tag term that label match would list them).
+#[gpui::test]
+async fn terminal_and_draft_rows_are_hidden_under_a_tag_term(cx: &mut TestAppContext) {
+    let project = init_test_project_with_agent_panel(ALPHA, cx).await;
+    cx.update(|cx| agent_ui::thread_organization::init(cx));
+    cx.run_until_parked();
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+    let (sidebar, panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+    panel
+        .update_in(cx, |panel, window, cx| {
+            panel.insert_test_terminal("php server", true, window, cx)
+        })
+        .expect("fixture: a test terminal is inserted");
+    cx.run_until_parked();
+    save_draft(ALPHA, cx);
+    let fix_login = save("a1", "Fix login", ALPHA, 1, cx);
+    tag(fix_login, "php", cx);
+    sidebar.update(cx, |sidebar, cx| sidebar.update_entries(cx));
+    cx.run_until_parked();
+
+    let rows = shown(&sidebar, cx);
+    assert!(rows.drafts >= 1, "fixture: the draft has a row: {rows:?}");
+    type_in_search(&sidebar, "php", cx);
+    assert_eq!(
+        shown(&sidebar, cx).terminals,
+        vec!["php server".to_string()],
+        "control: plain text reaches the terminal row"
+    );
+
+    type_in_search(&sidebar, "#php alpha", cx);
+    let rows = shown(&sidebar, cx);
+    assert_eq!(rows.terminals, Vec::<String>::new(), "{rows:?}");
+    assert_eq!(rows.drafts, 0, "{rows:?}");
+    assert_eq!(rows.threads, vec!["Fix login".to_string()]);
+}
+
+// R4.12 — while `#php` is typed, a thread gaining or losing the tag joins or leaves the rows
+// without the filter being retyped.
+#[gpui::test]
+async fn a_tag_change_updates_the_rows_under_a_tag_term(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let fixture = seed(cx);
+    type_in_search(&sidebar, "#php", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Fix login", "Write docs"])
+    );
+
+    tag(fixture.login_page, "Php", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Fix login", "Login page", "Write docs"])
+    );
+    untag(fixture.fix_login, "php", cx);
+    assert_eq!(
+        shown(&sidebar, cx).threads,
+        titles(&["Login page", "Write docs"])
+    );
+}
+
+// R4.11 — a tag term is filter text: no thread drag and no pinned drag while it is typed.
+#[gpui::test]
+async fn no_thread_or_pinned_drag_under_a_tag_term(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
