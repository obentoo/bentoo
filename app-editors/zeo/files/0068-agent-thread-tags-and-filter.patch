+#[gpui::test]
+fn four_tags_draw_three_chips_and_a_plus_chip(cx: &mut TestAppContext) {
+    let (_view, cx) = open(
+        cx,
+        Row {
+            tags: shared(&["a", "b", "c", "d"]),
+            ..Row::default()
+        },
+    );
+    for selector in [
+        "THREAD_ITEM_TAG_CHIP_0",
+        "THREAD_ITEM_TAG_CHIP_1",
+        "THREAD_ITEM_TAG_CHIP_2",
+        "THREAD_ITEM_TAG_MORE",
+    ] {
+        assert!(cx.debug_bounds(selector).is_some(), "R2.2: {selector}");
+    }
+    assert!(cx.debug_bounds("THREAD_ITEM_TAG_CHIP_3").is_none());
+    assert!(
+        cx.debug_bounds("THREAD_ITEM_BADGE").is_none(),
+        "chips alone draw no badge container"
+    );
+
+    hover_for_tooltip(cx, "THREAD_ITEM_TAG_CHIPS");
+    for selector in [
+        "THREAD_ITEM_TAG_TOOLTIP-a",
+        "THREAD_ITEM_TAG_TOOLTIP-b",
+        "THREAD_ITEM_TAG_TOOLTIP-c",
+        "THREAD_ITEM_TAG_TOOLTIP-d",
+    ] {
+        assert!(
+            cx.debug_bounds(selector).is_some(),
+            "the tooltip names every tag, the hidden one too: {selector}"
+        );
+    }
+}
