+    );
+}
+
+fn highlight_of(sidebar: &Entity<Sidebar>, title: &str, cx: &mut VisualTestContext) -> Vec<usize> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .find_map(|entry| match entry {
+                ListEntry::Thread(t) if t.metadata.display_title() == title => {
+                    Some(t.highlight_positions.clone())
+                }
+                _ => None,
+            })
+            .expect("fixture: the row is shown")
+    })
+}
+
+// R4.13 — a tag term shows matches in a collapsed group and a collapsed Pinned section.
+#[gpui::test]
+async fn a_tag_term_shows_matches_in_collapsed_groups_and_pinned(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
