+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let other = thread("Other thread", cx);
+    tag(this, "Rust", cx);
+    tag(other, "perl", cx);
+
+    let modal = open_picker(&workspace, this, cx);
+    type_query(&modal, "RUST", cx);
+    assert_eq!(
+        listed(&modal, cx),
+        vec!["[x] Rust"],
+        "'RUST' is the applied 'Rust'"
+    );
+
+    type_query(&modal, "perl", cx);
+    assert_eq!(
+        listed(&modal, cx),
+        vec!["[ ] perl"],
+        "carried by another thread: listed, not new, not applied here"
+    );
+
+    type_query(&modal, "rus", cx);
+    assert_eq!(
+        listed(&modal, cx),
+        vec![add_entry("rus"), "[x] Rust".to_string()],
+        "R1.4: 'rus' is a new tag, offered first"
+    );
+}
+
+// ═══ R1.5, R1.6 — confirming ══════════════════════════════════════════════
+
+// R1.5 — confirming "Add tag" adds the tag in the spelling typed, keeps the picker open, and the
+// tag is then listed as applied, with no add entry left; confirming an unapplied existing tag
+// adds it too.
+#[gpui::test]
+async fn confirming_a_tag_the_thread_lacks_adds_it_and_keeps_the_picker_open(
+    cx: &mut TestAppContext,
+) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let other = thread("Other thread", cx);
+    tag(other, "perl", cx);
+
+    let modal = open_picker(&workspace, this, cx);
+    type_query(&modal, "Kiwi", cx);
+    confirm(&modal, &add_entry("Kiwi"), cx);
+    assert_eq!(stored(this, cx), vec!["Kiwi"], "R1.5: added as typed");
+    assert!(active_picker(&workspace, cx).is_some(), "R1.5: still open");
+    assert_eq!(listed(&modal, cx), vec!["[x] Kiwi"], "R1.5: marked applied");
+
+    type_query(&modal, "perl", cx);
+    confirm(&modal, "[ ] perl", cx);
+    assert_eq!(stored(this, cx), vec!["Kiwi", "perl"]);
+    assert_eq!(listed(&modal, cx), vec!["[x] perl"]);
+    assert!(active_picker(&workspace, cx).is_some());
+}
+
+// R1.6 — confirming an applied tag removes it from THIS thread only and keeps the picker open;
+// the other thread carrying it keeps it, so it stays listed, unapplied.
+#[gpui::test]
+async fn confirming_an_applied_tag_removes_it_from_this_thread_only(cx: &mut TestAppContext) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let other = thread("Other thread", cx);
+    tag(this, "Rust", cx);
+    tag(other, "rust", cx);
+
+    let modal = open_picker(&workspace, this, cx);
+    confirm(&modal, "[x] Rust", cx);
+    assert_eq!(stored(this, cx), Vec::<String>::new(), "R1.6");
+    assert_eq!(stored(other, cx), vec!["Rust"], "the other thread keeps it");
+    assert!(active_picker(&workspace, cx).is_some(), "R1.6: still open");
+    assert_eq!(listed_tags(&modal, cx), vec!["[ ] Rust"]);
+}
+
+// ═══ R1.7, R1.8 — the query's form ════════════════════════════════════════
+
+// R1.7 — one leading '#' is ignored: "#PHP" is the existing "php"; "#kiwi" offers and adds
+// "kiwi"; a second '#' is not stripped, so "##kiwi" is invalid.
+#[gpui::test]
+async fn one_leading_hash_is_ignored(cx: &mut TestAppContext) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let other = thread("Other thread", cx);
+    tag(other, "php", cx);
+
+    let modal = open_picker(&workspace, this, cx);
+    type_query(&modal, "#PHP", cx);
+    assert_eq!(listed(&modal, cx), vec!["[ ] php"], "'#PHP' is 'php'");
+
+    type_query(&modal, "##kiwi", cx);
+    assert!(!has_add_entry(&modal, cx), "only ONE '#' is ignored");
+    assert_eq!(message(&modal, cx).as_deref(), Some(RULE));
+
+    type_query(&modal, "#kiwi", cx);
+    assert_eq!(listed(&modal, cx), vec![add_entry("kiwi")]);
+    assert_eq!(message(&modal, cx), None);
+    confirm(&modal, &add_entry("kiwi"), cx);
+    assert_eq!(stored(this, cx), vec!["kiwi"], "stored without the '#'");
+}
+
+// R1.8 — a query that is not a valid tag shows the store's rule and offers no add: a comma, a
+// space, 33 characters. The converse: 32 characters is valid, with no rule shown.
+#[gpui::test]
+async fn an_invalid_query_shows_the_rule_and_offers_no_add(cx: &mut TestAppContext) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let modal = open_picker(&workspace, this, cx);
+
+    let too_long = "x".repeat(33);
+    for invalid in ["a,b", "two words", too_long.as_str()] {
+        type_query(&modal, invalid, cx);
+        assert!(!has_add_entry(&modal, cx), "{invalid:?}: no add entry");
+        assert_eq!(message(&modal, cx).as_deref(), Some(RULE), "{invalid:?}");
+    }
+
+    let longest = "y".repeat(32);
+    type_query(&modal, &longest, cx);
+    assert_eq!(listed(&modal, cx), vec![add_entry(&longest)]);
+    assert_eq!(message(&modal, cx), None, "a valid query clears the rule");
+}
+
+// ═══ R1.9 — refusals ══════════════════════════════════════════════════════
+
+// R1.9, Q4, Q13 — the store refuses a 21st tag: the thread's tags and the known tags are
+// unchanged, the picker shows the refusal and stays open, and one log line names the thread id
+// while no line carries the thread's title or the tag text.
+#[gpui::test]
+async fn a_refused_add_changes_nothing_shows_the_refusal_and_logs_the_id_only(
+    cx: &mut TestAppContext,
+) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("Secret plans", cx);
+    for n in 1..=20 {
+        tag(this, &format!("t{n:02}"), cx);
+    }
+    let before = stored(this, cx);
+    let known_before = known_tags(cx);
+    assert_eq!(before.len(), 20, "fixture: the store's limit is reached");
+
+    let modal = open_picker(&workspace, this, cx);
+    type_query(&modal, "overflowtag", cx);
+    capture_logs();
+    confirm(&modal, &add_entry("overflowtag"), cx);
+
+    assert_eq!(stored(this, cx), before, "R1.9: tags unchanged");
+    assert_eq!(known_tags(cx), known_before, "no tag created on the side");
+    assert_eq!(
+        message(&modal, cx),
+        Some(OrganizeError::TooManyTags { thread_id: this }.to_string()),
+        "R1.9: the refusal is shown in the picker"
+    );
+    assert!(active_picker(&workspace, cx).is_some());
+    let lines = all_lines_lowercased();
+    let id = this.to_key_string().to_lowercase();
+    assert_eq!(
+        lines.iter().filter(|line| line.contains(&id)).count(),
+        1,
+        "R1.9: one warning names the thread id: {lines:?}"
+    );
+    assert!(
+        lines
+            .iter()
+            .all(|line| !line.contains("overflowtag") && !line.contains("secret plans")),
+        "R1.9: no tag text, no title in a log line: {lines:?}"
+    );
+}
+
+// R1.9 — a refused removal: the thread was deleted while its picker was open, so the store
+// refuses whatever is confirmed. The refusal is shown, the other thread's tag is untouched, and
+// one log line names the id.
+#[gpui::test]
+async fn a_refused_removal_shows_the_refusal_and_touches_nothing_else(cx: &mut TestAppContext) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let other = thread("Other thread", cx);
+    tag(this, "Rust", cx);
+    tag(other, "Rust", cx);
+    let modal = open_picker(&workspace, this, cx);
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(this, cx))
+    });
+    cx.run_until_parked();
+
+    capture_logs();
+    let entry = listed(&modal, cx)
+        .into_iter()
+        .find(|entry| entry.ends_with("] Rust"))
+        .expect("fixture: Rust is still listed (the other thread carries it)");
+    confirm(&modal, &entry, cx);
+
+    assert_eq!(
+        message(&modal, cx),
+        Some(OrganizeError::UnknownThread { thread_id: this }.to_string()),
+        "R1.9: the refusal is shown"
+    );
+    assert_eq!(stored(other, cx), vec!["Rust"]);
+    let id = this.to_key_string().to_lowercase();
+    assert_eq!(
+        all_lines_lowercased()
+            .iter()
+            .filter(|line| line.contains(&id))
+            .count(),
+        1
+    );
+}
+
+// R1.11 — Escape closes the picker and keeps every change already confirmed (it is not a
+// "cancel the edits").
+#[gpui::test]
+async fn escape_closes_and_keeps_confirmed_changes(cx: &mut TestAppContext) {
+    let (workspace, cx) = setup(cx).await;
+    let this = thread("This thread", cx);
+    let modal = open_picker(&workspace, this, cx);
+    type_query(&modal, "kiwi", cx);
+    confirm(&modal, &add_entry("kiwi"), cx);
+    type_query(&modal, "mango", cx);
+
+    cx.dispatch_action(menu::Cancel);
+    cx.run_until_parked();
+
+    assert!(active_picker(&workspace, cx).is_none(), "R1.11: closed");
+    assert_eq!(
+        stored(this, cx),
+        vec!["kiwi"],
+        "R1.11: the confirmed tag stays, the typed-only one was never added"
+    );
+}
diff --git a/crates/agent_ui/src/thread_tags_picker_unicode_tests.rs b/crates/agent_ui/src/thread_tags_picker_unicode_tests.rs
new file mode 100644
index 0000000..a7c75d1
--- /dev/null
+++ b/crates/agent_ui/src/thread_tags_picker_unicode_tests.rs
@@ -0,0 +1,221 @@
+// Story 037, task 7.2 (refine v4) — the Tags picker: removing a tag whose key outgrows its
+// spelling. Requirement: R1.6 (Q5). Found by 7.1's contract check (row 3): `normalize_tag`
+// counts the characters BEFORE lowercasing, and `İ` (U+0130) lowercases to `i` + U+0307, so a
+// valid 32-character spelling holding `İ` has a 33-character key. The store's `remove_tag`
+// re-normalizes its argument; handed that key, it refuses it as an invalid tag.
+//
+// Materialize at the end of `crates/agent_ui/src/thread_tags_picker.rs` (a child module, so the
+// tests reach the modal's private `picker` field):
+//     #[cfg(test)]
+//     #[path = "thread_tags_picker_unicode_tests.rs"]
+//     mod thread_tags_picker_unicode_tests;
+// Filter: `cargo test -p agent_ui thread_tags_picker_unicode`.
+//
+// The setup is a minimal copy of `thread_tags_picker_tests.rs`'s (that file is at its size
+// limit), driven the same way: `Workspace::toggle_modal`, `Picker::set_selected_index`, then
+// `menu::Confirm`; read through the delegate's `test_entries()` and `test_message()`.
+//
+// Hostile halves first: the ASCII twin `Istanbul-…` on the same thread is ANOTHER tag and must
+// survive the removal (wrong collapse); the same tag on another thread, first spelled in another
+// case, keeps it (the removal is this thread's only). Guard (green on the tip): an ordinary tag
+// is removed as before.
+
+use std::path::Path;
+
+use agent_client_protocol::v2::schema as acp;
+use chrono::Utc;
+use fs::FakeFs;
+use gpui::{Entity, TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList, Workspace};
+
+use super::ThreadTagsPicker;
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore, WorktreePaths};
+use crate::thread_organization::ThreadOrganizationStore;
+
+const PROJECT: &str = "/project-a";
+/// 32 characters, one of them `İ` (U+0130): valid, with a 33-character key.
+const DOTTED: &str = "İstanbul-release-plan-2026-q4-ok";
+/// The same tag in another case (same key).
+const DOTTED_UPPER: &str = "İSTANBUL-RELEASE-PLAN-2026-Q4-OK";
+/// A different tag one dot away: ASCII `I`.
+const PLAIN: &str = "Istanbul-release-plan-2026-q4-ok";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+async fn unicode_setup(cx: &mut TestAppContext) -> (Entity<Workspace>, &mut VisualTestContext) {
+    crate::test_support::init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(PROJECT, json!({ "src": {} })).await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        prompt_store::init(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        agent::ThreadStore::init_global(cx);
+        ThreadMetadataStore::init_global(cx);
+    });
+    cx.run_until_parked();
+    cx.update(crate::thread_organization::init);
+    cx.run_until_parked();
+    let project = Project::test(fs, [Path::new(PROJECT)], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let workspace =
+        multi_workspace.read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone());
+    cx.run_until_parked();
+    (workspace, cx)
+}
+
+fn picker_thread(title: &str, cx: &mut VisualTestContext) -> ThreadId {
+    let now = Utc::now();
+    let thread_id = ThreadId::new();
+    let metadata = ThreadMetadata {
+        thread_id,
+        session_id: Some(acp::SessionId::new(format!(
+            "unicode-picker-{}",
+            thread_id.to_key_string()
+        ))),
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: Some(title.to_string().into()),
+        title_override: None,
+        updated_at: now,
+        created_at: Some(now),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(PROJECT)])),
+        remote_connection: None,
+        archived: false,
+    };
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+/// Fixture write through the store; its `Ok` is the proof that the spelling is a valid tag.
+fn picker_tag(thread_id: ThreadId, tag: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.add_tag(thread_id, tag, cx))
+    })
+    .unwrap_or_else(|error| panic!("fixture: the store accepts {tag:?}: {error:?}"));
+    cx.run_until_parked();
+}
+
+/// The thread's tags as the store holds them, in first spelling, sorted.
+fn picker_stored(thread_id: ThreadId, cx: &mut VisualTestContext) -> Vec<String> {
+    let mut tags: Vec<String> = cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .read(cx)
+            .tags(thread_id)
+            .into_iter()
+            .map(|tag| tag.display.to_string())
+            .collect()
+    });
+    tags.sort();
+    tags
+}
+
+fn open_unicode_picker(
+    workspace: &Entity<Workspace>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) -> Entity<ThreadTagsPicker> {
+    workspace.update_in(cx, |workspace, window, cx| {
+        workspace.toggle_modal(window, cx, |window, cx| {
+            ThreadTagsPicker::new(thread_id, window, cx)
+        })
+    });
+    cx.run_until_parked();
+    workspace
+        .read_with(cx, |workspace, cx| {
+            workspace.active_modal::<ThreadTagsPicker>(cx)
+        })
+        .expect("the Tags picker is the active modal")
+}
+
+fn picker_entries(modal: &Entity<ThreadTagsPicker>, cx: &mut VisualTestContext) -> Vec<String> {
+    modal.read_with(cx, |modal, cx| {
+        modal.picker.read(cx).delegate.test_entries()
+    })
+}
+
+fn picker_message(modal: &Entity<ThreadTagsPicker>, cx: &mut VisualTestContext) -> Option<String> {
+    modal.read_with(cx, |modal, cx| {
+        modal
+            .picker
+            .read(cx)
+            .delegate
+            .test_message()
+            .map(|message| message.to_string())
+    })
+}
+
+/// Selects the entry listed as `entry` and presses Enter.
+fn confirm_entry(modal: &Entity<ThreadTagsPicker>, entry: &str, cx: &mut VisualTestContext) {
+    let ix = picker_entries(modal, cx)
+        .iter()
+        .position(|listed| listed == entry)
+        .unwrap_or_else(|| panic!("{entry:?} is not listed: {:?}", picker_entries(modal, cx)));
+    let picker = modal.read_with(cx, |modal, _| modal.picker.clone());
+    picker.update_in(cx, |picker, window, cx| {
+        picker.set_selected_index(ix, None, true, window, cx)
+    });
+    cx.dispatch_action(menu::Confirm);
+    cx.run_until_parked();
+}
+
+// ═══ Tests ═════════════════════════════════════════════════════════════════
+
+// R1.6 — confirming the applied `İstanbul-…` removes it from this thread, with no refusal shown;
+// the ASCII twin on the same thread and the other thread's copy stay. Fails on the tip: the
+// picker hands the 33-character key to `remove_tag`, which refuses it as an invalid tag.
+#[gpui::test]
+async fn confirming_an_applied_dotted_capital_i_tag_removes_it(cx: &mut TestAppContext) {
+    let (workspace, cx) = unicode_setup(cx).await;
+    let other = picker_thread("Other thread", cx);
+    let this = picker_thread("This thread", cx);
+    picker_tag(other, DOTTED_UPPER, cx);
+    picker_tag(this, DOTTED, cx);
+    picker_tag(this, PLAIN, cx);
+    assert_eq!(
+        picker_stored(this, cx),
+        vec![PLAIN.to_string(), DOTTED_UPPER.to_string()],
+        "fixture: one tag in its first spelling, and its ASCII twin"
+    );
+
+    let modal = open_unicode_picker(&workspace, this, cx);
+    confirm_entry(&modal, &format!("[x] {DOTTED_UPPER}"), cx);
+    assert_eq!(
+        picker_message(&modal, cx),
+        None,
+        "R1.6: a valid applied tag is removed, not refused"
+    );
+    assert_eq!(
+        picker_stored(this, cx),
+        vec![PLAIN.to_string()],
+        "R1.6: only the confirmed tag leaves this thread; the ASCII twin is another tag"
+    );
+    assert_eq!(
+        picker_stored(other, cx),
+        vec![DOTTED_UPPER.to_string()],
+        "the other thread keeps it"
+    );
+}
+
+// Guard (green on the tip) — an ordinary applied tag is removed as before, and the dotted tag
+// beside it is untouched.
+#[gpui::test]
+async fn confirming_an_applied_ordinary_tag_still_removes_it(cx: &mut TestAppContext) {
+    let (workspace, cx) = unicode_setup(cx).await;
+    let this = picker_thread("This thread", cx);
+    picker_tag(this, "Rust", cx);
+    picker_tag(this, DOTTED, cx);
+
+    let modal = open_unicode_picker(&workspace, this, cx);
+    confirm_entry(&modal, "[x] Rust", cx);
+    assert_eq!(picker_message(&modal, cx), None);
+    assert_eq!(picker_stored(this, cx), vec![DOTTED.to_string()]);
+}
