+// ═══ Chips (R2.1, R2.3, R2.4, R2.6) ══════════════════════════════════════════════
+
+// R2.4 first (no chip drawn anywhere while no thread carries a tag), then R2.1: the tagged row
+// draws chips, the untagged neighbour draws none, and the list is in first spelling, by key.
+#[gpui::test]
+async fn chips_are_drawn_on_a_tagged_group_row_only(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let tagged = save("a1", "Fix login", ALPHA, 2, cx);
