@@ -0,0 +1,133 @@
+//! The `#tag` part of a thread filter, shared by the sidebar and History (story 037). It needs no
+//! `cx`, so either caller can run it on the text its filter editor holds.
+
+use std::ops::Range;
+
+use gpui::SharedString;
+
+use crate::thread_metadata_store::ThreadId;
+use crate::thread_organization::{ThreadOrganizationStore, normalize_tag};
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct TagQuery {
+    /// In `normalize_tag`'s key form, so they compare equal to the store's keys.
+    pub tag_keys: Vec<SharedString>,
+    /// `None` when the query names no key: the caller then matches the raw text exactly as it did
+    /// before tags existed (R4.5, R5.3).
+    pub text: Option<String>,
+}
+
+impl TagQuery {
+    pub fn has_keys(&self) -> bool {
+        !self.tag_keys.is_empty()
+    }
+
+    pub fn text_or<'a>(&'a self, raw: &'a str) -> &'a str {
+        self.text.as_deref().unwrap_or(raw)
+    }
+
+    /// Every key must be on the thread (R4.3); a query without keys passes every thread.
+    pub fn thread_matches(&self, store: &ThreadOrganizationStore, thread_id: ThreadId) -> bool {
+        if self.tag_keys.is_empty() {
+            return true;
+        }
+        let tags = store.tags(thread_id);
+        self.tag_keys
+            .iter()
+            .all(|key| tags.iter().any(|tag| &tag.key == key))
+    }
+
+    /// History can run without the organization store installed; typed keys then match no
+    /// thread rather than being ignored, so a tag term never lists untagged threads (R5.1).
+    pub fn admits_thread(
+        &self,
+        store: Option<&ThreadOrganizationStore>,
+        thread_id: ThreadId,
+    ) -> bool {
+        match store {
+            Some(store) => self.thread_matches(store, thread_id),
+            None => !self.has_keys(),
+        }
+    }
+}
+
+/// The text is never lowercased or re-joined: the sidebar matches it with the case and spacing
+/// typed, and History lowercases it on its own afterwards (R4.14).
+pub fn parse_tag_query(raw: &str) -> TagQuery {
+    let tokens = whitespace_tokens(raw);
+    let mut tag_keys: Vec<SharedString> = Vec::new();
+    let mut removed: Vec<Range<usize>> = Vec::new();
+    for (index, token) in tokens.iter().enumerate() {
+        let Some(name) = raw[token.clone()].strip_prefix('#') else {
+            continue;
+        };
+        // An invalid term is plain text (R4.6), so the error is the answer, not a failure.
+        let Ok((key, _display)) = normalize_tag(name) else {
+            continue;
+        };
+        if !tag_keys.contains(&key) {
+            tag_keys.push(key);
+        }
+        removed.push(with_one_adjacent_space(raw, &tokens, index, token));
+    }
+    if tag_keys.is_empty() {
+        return TagQuery::default();
+    }
+
+    let mut text = String::with_capacity(raw.len());
+    let mut kept_from = 0;
+    for range in &removed {
+        if range.start > kept_from {
+            text.push_str(&raw[kept_from..range.start]);
+        }
+        kept_from = kept_from.max(range.end);
+    }
+    text.push_str(&raw[kept_from..]);
+    TagQuery {
+        tag_keys,
+        text: Some(text.trim().to_string()),
+    }
+}
+
+/// Byte ranges of the whitespace-separated tokens, in order. Always on char boundaries.
+fn whitespace_tokens(raw: &str) -> Vec<Range<usize>> {
+    let mut tokens = Vec::new();
+    let mut start = None;
+    for (offset, character) in raw.char_indices() {
+        match (character.is_whitespace(), start) {
+            (true, Some(token_start)) => {
+                tokens.push(token_start..offset);
+                start = None;
+            }
+            (false, None) => start = Some(offset),
+            _ => {}
+        }
+    }
+    if let Some(token_start) = start {
+        tokens.push(token_start..raw.len());
+    }
+    tokens
+}
+
+/// The token plus the whitespace run after it, or the one before it when it ends the string, so
+/// removing a key leaves the words around it one gap apart.
+fn with_one_adjacent_space(
+    raw: &str,
+    tokens: &[Range<usize>],
+    index: usize,
+    token: &Range<usize>,
+) -> Range<usize> {
+    if token.end < raw.len() {
+        let next_start = tokens.get(index + 1).map_or(raw.len(), |next| next.start);
+        return token.start..next_start;
+    }
+    let previous_end = index
+        .checked_sub(1)
+        .and_then(|previous| tokens.get(previous))
+        .map_or(0, |previous| previous.end);
+    previous_end..token.end
+}
+
