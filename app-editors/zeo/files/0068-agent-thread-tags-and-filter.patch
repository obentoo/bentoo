+    cx.simulate_mouse_move(chips.center(), None, Modifiers::none());
+    cx.run_until_parked();
+    assert!(!tooltip_lists("ant", cx), "no tooltip before the delay");
+    cx.executor()
+        .advance_clock(std::time::Duration::from_millis(600));
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
