+#[gpui::test]
+fn the_badge_is_drawn_only_when_set(cx: &mut TestAppContext) {
+    let (_with, with_cx) = open(cx, Row::badge());
+    assert!(
+        with_cx.debug_bounds("THREAD_ITEM_BADGE").is_some(),
+        "R8.1: drawn"
+    );
+    assert!(with_cx.debug_bounds("THREAD_ITEM_BADGE_0").is_some());
+    assert!(with_cx.debug_bounds("THREAD_ITEM_BADGE_1").is_none());
+    let (_without, without_cx) = cx.add_window_view(|_, _| Row::default());
+    assert!(without_cx.debug_bounds("THREAD_ITEM_BADGE").is_none());
+    assert!(
+        without_cx.debug_bounds("THREAD_ITEM_TAG_CHIPS").is_none(),
+        "R2.4: no empty container"
+    );
+}
