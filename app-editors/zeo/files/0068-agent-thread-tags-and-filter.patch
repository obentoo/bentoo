+#[test]
+fn the_title_truncates_when_only_chips_are_present() {
+    let bare = ThreadItem::new("t", LONG_TITLE);
+    assert!(
+        !bare.truncates_title(true),
+        "R2.4: a bare row fades as before"
+    );
+    let chips = ThreadItem::new("t", LONG_TITLE).tags(shared(&["alpha"]));
+    assert!(
+        chips.truncates_title(true),
+        "R2.5: chips end the title in an ellipsis"
+    );
+    let badge = ThreadItem::new("t", LONG_TITLE).badge(IconName::ToolWeb, "Devtools thread");
+    assert!(badge.truncates_title(true));
+}
+
+#[derive(Default)]
+struct Row {
+    badges: usize,
+    tags: Vec<SharedString>,
+    row_clicks: usize,
+}
+
+impl Row {
+    fn badge() -> Self {
+        Self {
+            badges: 1,
+            ..Self::default()
+        }
+    }
+}
+
+impl Render for Row {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let mut item = ThreadItem::new("thread", LONG_TITLE)
+            .hovered(true)
+            .action_slot(
+                div()
+                    .debug_selector(|| "ACTION_SLOT".to_owned())
+                    .child(IconButton::new("action", IconName::Archive).on_click(|_, _, _| {})),
+            )
+            .on_click(cx.listener(|row, _, _, _| row.row_clicks += 1));
+        if self.badges >= 2 {
+            item = item.badge(IconName::ArrowDownRight, "Ungrouped");
+        }
+        if self.badges >= 1 {
+            item = item.badge(IconName::ToolWeb, "Devtools thread");
+        }
+        if !self.tags.is_empty() {
+            item = item.tags(self.tags.clone());
+        }
+        div()
+            .size_full()
+            .p(px(20.))
+            .child(div().w(px(260.)).child(item))
+    }
+}
+
+fn open(cx: &mut TestAppContext, row: Row) -> (Entity<Row>, &mut VisualTestContext) {
+    init(cx);
+    cx.add_window_view(|_, _| row)
+}
+
+fn hover_for_tooltip(cx: &mut VisualTestContext, selector: &'static str) {
+    let bounds = cx.debug_bounds(selector).expect(selector);
+    cx.simulate_mouse_move(bounds.center(), None, Modifiers::default());
+    // Past gpui's 500 ms tooltip show delay.
+    cx.executor().advance_clock(Duration::from_millis(600));
+    cx.run_until_parked();
+}
+
+fn click_action_slot(view: &Entity<Row>, cx: &mut VisualTestContext) -> usize {
+    let action = cx.debug_bounds("ACTION_SLOT").expect("action bounds");
+    let position = point(action.center().x, action.center().y);
+    cx.simulate_mouse_move(position, None, Modifiers::default());
+    cx.simulate_mouse_down(position, MouseButton::Left, Modifiers::default());
+    cx.simulate_mouse_up(position, MouseButton::Left, Modifiers::default());
+    view.read_with(cx, |row, _| row.row_clicks)
+}
