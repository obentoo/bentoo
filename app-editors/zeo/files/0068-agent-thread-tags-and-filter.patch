+// R2.3 — resting the pointer on the chips shows, after the hover delay, a tooltip listing EVERY
+// tag: the two hidden behind "+2" too. Hostile halves first: no tooltip before the delay, and
+// never a tag only another thread carries.
+#[gpui::test]
+async fn the_chips_tooltip_lists_every_tag_of_the_thread(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let tagged = save("a1", "Fix login", ALPHA, 2, cx);
+    let other = save("b1", "Write docs", BETA, 1, cx);
+    for name in ["eel", "dog", "cat", "bee", "ant"] {
+        tag(tagged, name, cx);
+    }
+    tag(other, "fox", cx);
+    let ix = group_row_ix(&sidebar, tagged, cx);
+    entry_bounds(&sidebar, ix, cx);
+    let chips = cx
+        .debug_bounds(CHIPS_SELECTOR)
