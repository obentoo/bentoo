+// Story 037, task 3.1 — the `#tag` query parser (R4.1, R4.3, R4.5, R4.6, R4.14, R5.3).
+// Filter: `cargo test -p agent_ui thread_tag_filter`.
+//
+// The parser is pure, so most of this file needs no app. `thread_matches` reads a real
+// `ThreadOrganizationStore`, whose writes admit only threads `ThreadMetadataStore` knows with a
+// session, so those tests build the same globals story 031's store tests use.
+
+use std::path::Path;
+
+use agent_client_protocol::v2::schema as acp;
+use chrono::Utc;
+use fs::Fs;
+use gpui::{SharedString, TestAppContext};
+use project::FakeFs;
+use workspace::PathList;
+
+use super::{TagQuery, parse_tag_query};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore, WorktreePaths};
+use crate::thread_organization::ThreadOrganizationStore;
+
+fn keys(query: &TagQuery) -> Vec<&str> {
+    query.tag_keys.iter().map(SharedString::as_ref).collect()
+}
+
+// ── Parsing ────────────────────────────────────────────────────────────────
+
+// R4.1 — a valid `#` term is a key; the rest is the text.
+#[test]
+fn thread_tag_filter_key_and_text() {
+    let raw = "#php login";
+    let query = parse_tag_query(raw);
+    assert_eq!(keys(&query), ["php"]);
+    assert_eq!(query.text.as_deref(), Some("login"));
+    assert_eq!(query.text_or(raw), "login");
+    assert!(query.has_keys());
+}
+
+// R4.14 — the text keeps the case and the inner spacing typed.
+#[test]
+fn thread_tag_filter_text_keeps_case_and_inner_spacing() {
+    let query = parse_tag_query("#php Login  Page");
+    assert_eq!(keys(&query), ["php"]);
+    assert_eq!(query.text.as_deref(), Some("Login  Page"));
+}
+
+// R4.14 — a key at the end leaves no trailing space behind.
+#[test]
+fn thread_tag_filter_key_after_text() {
+    let query = parse_tag_query("Login #php");
+    assert_eq!(keys(&query), ["php"]);
+    assert_eq!(query.text.as_deref(), Some("Login"));
+}
+
+// R4.1 — keys are compared case-insensitively, in `normalize_tag`'s key form.
+#[test]
+fn thread_tag_filter_duplicate_keys_collapse() {
+    let query = parse_tag_query("#PHP #php");
+    assert_eq!(keys(&query), ["php"]);
+    assert_eq!(query.text.as_deref(), Some(""));
+}
+
+// R4.6 — an invalid `#` term is plain text: a bare `#`, a comma, more than 32 characters.
+#[test]
+fn thread_tag_filter_invalid_terms_stay_text() {
+    let too_long = format!("#{}", "a".repeat(33));
+    for raw in ["#", "#a,b", too_long.as_str()] {
+        let query = parse_tag_query(raw);
+        assert!(!query.has_keys(), "{raw:?} is not a key");
+        assert_eq!(query.text, None, "{raw:?} leaves the text untouched");
+        assert_eq!(query.text_or(raw), raw);
+    }
+
+    let query = parse_tag_query("#a,b #php");
+    assert_eq!(keys(&query), ["php"]);
+    assert_eq!(query.text.as_deref(), Some("#a,b"));
+}
+
+// R4.5, R5.3 — text alone runs exactly today's code: the raw string, untouched.
+#[test]
+fn thread_tag_filter_text_only_is_untouched() {
+    let raw = "  Login  Page ";
+    let query = parse_tag_query(raw);
+    assert_eq!(query, TagQuery::default());
+    assert_eq!(query.text_or(raw), raw);
+}
+
+// ── Matching ───────────────────────────────────────────────────────────────
+
+fn init(cx: &mut TestAppContext) {
+    let fs = FakeFs::new(cx.executor());
+    cx.update(|cx| {
+        cx.set_global(db::AppDatabase::test_new());
+        let settings_store = settings::SettingsStore::test(cx);
+        cx.set_global(settings_store);
+        theme_settings::init(theme::LoadThemes::JustBase, cx);
+        editor::init(cx);
+        release_channel::init("0.0.0".parse().unwrap(), cx);
+        prompt_store::init(cx);
+        <dyn Fs>::set_global(fs, cx);
+        ThreadMetadataStore::init_global(cx);
+        agent::ThreadStore::init_global(cx);
+        language_model::LanguageModelRegistry::test(cx);
+    });
+    cx.run_until_parked();
+    cx.update(crate::thread_organization::init);
+    cx.run_until_parked();
+}
+
+/// A thread with a sent message (a session), so the store admits tags on it.
+fn thread(tags: &[&str], cx: &mut TestAppContext) -> ThreadId {
+    let thread_id = ThreadId::new();
+    let now = Utc::now();
+    let metadata = ThreadMetadata {
+        thread_id,
+        session_id: Some(acp::SessionId::new(format!(
+            "tag-filter-{}",
+            thread_id.to_key_string()
+        ))),
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: Some("Thread".into()),
+        title_override: None,
+        updated_at: now,
+        created_at: Some(now),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(
+            "/project-a",
+        )])),
+        remote_connection: None,
+        archived: false,
+    };
+    cx.update(|cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+    for tag in tags {
+        cx.update(|cx| {
+            ThreadOrganizationStore::global(cx)
+                .update(cx, |store, cx| store.add_tag(thread_id, tag, cx))
+        })
+        .expect("fixture: the store accepts a valid tag on a thread with a message");
+    }
+    cx.run_until_parked();
+    thread_id
+}
+
+fn matches(query: &TagQuery, thread_id: ThreadId, cx: &mut TestAppContext) -> bool {
+    cx.update(|cx| query.thread_matches(ThreadOrganizationStore::global(cx).read(cx), thread_id))
+}
+
+// R4.3 — several keys are an AND: a thread carrying one of two fails.
+#[gpui::test]
+async fn thread_tag_filter_two_keys_require_both(cx: &mut TestAppContext) {
+    init(cx);
+    let php_only = thread(&["php"], cx);
+    let both = thread(&["PHP", "Auth"], cx);
+    let query = parse_tag_query("#php #auth");
+
+    assert!(
+        !matches(&query, php_only, cx),
+        "one of two keys is not a match"
+    );
+    assert!(
+        matches(&query, both, cx),
+        "the first spelling does not matter"
+    );
+}
+
+// R4.1 — a thread with no tags fails a key, even a key no thread carries.
+#[gpui::test]
+async fn thread_tag_filter_untagged_thread_fails_a_key(cx: &mut TestAppContext) {
+    init(cx);
+    let untagged = thread(&[], cx);
+    let tagged = thread(&["rust"], cx);
+
+    assert!(!matches(&parse_tag_query("#rust"), untagged, cx));
+    assert!(!matches(&parse_tag_query("#nobody"), tagged, cx));
+}
+
+// R4.5 — no keys match every thread.
+#[gpui::test]
+async fn thread_tag_filter_no_keys_match_every_thread(cx: &mut TestAppContext) {
+    init(cx);
+    let untagged = thread(&[], cx);
+    let tagged = thread(&["rust"], cx);
+    let query = parse_tag_query("login");
+
+    assert!(matches(&query, untagged, cx));
+    assert!(matches(&query, tagged, cx));
+}
diff --git a/crates/agent_ui/src/thread_tags_picker.rs b/crates/agent_ui/src/thread_tags_picker.rs
new file mode 100644
index 0000000..ad4772a
--- /dev/null
+++ b/crates/agent_ui/src/thread_tags_picker.rs
@@ -0,0 +1,325 @@
+//! The Tags picker (story 037): a keyboard picker over every existing tag that toggles one
+//! thread's tags. It stays open across confirms, so several tags can be set in one visit, and
+//! Escape keeps whatever was already confirmed (R1.5, R1.6, R1.11).
+
+use std::sync::Arc;
+
+use gpui::{
+    App, Context, DismissEvent, Entity, EventEmitter, FocusHandle, Focusable, Render, SharedString,
+    Subscription, Task, Window,
+};
+use picker::{Picker, PickerDelegate};
+use ui::{ListItem, ListItemSpacing, prelude::*};
+use workspace::ModalView;
+
+use crate::thread_metadata_store::ThreadId;
+use crate::thread_organization::{Tag, ThreadOrganizationStore, normalize_tag};
+
+pub struct ThreadTagsPicker {
+    picker: Entity<Picker<ThreadTagsPickerDelegate>>,
+    _subscriptions: Vec<Subscription>,
+}
+
+impl ThreadTagsPicker {
+    pub fn new(thread_id: ThreadId, window: &mut Window, cx: &mut Context<Self>) -> Self {
+        let mut delegate = ThreadTagsPickerDelegate {
+            thread_id,
+            query: String::new(),
+            entries: Vec::new(),
+            message: None,
+            selected_index: 0,
+        };
+        delegate.rebuild(cx);
+        // The picker owns the width, so its rows and separators are laid out inside the frame
+        // (a fixed wrapper around an unsized picker let them overrun it, R1.13).
+        let picker =
+            cx.new(|cx| Picker::uniform_list(delegate, window, cx).initial_width(rems(24.)));
+
+        let mut subscriptions = vec![cx.subscribe(&picker, |_, _, _: &DismissEvent, cx| {
+            cx.emit(DismissEvent);
+        })];
+        // Another surface (the sidebar, a deleted thread) can change the tags while the picker
+        // is open; without this the checked marks would go stale until the next keystroke.
+        if let Some(store) = ThreadOrganizationStore::try_global(cx) {
+            subscriptions.push(cx.observe_in(&store, window, |this, _, window, cx| {
+                this.picker
+                    .update(cx, |picker, cx| picker.refresh(window, cx));
+            }));
+        }
+
+        Self {
+            picker,
+            _subscriptions: subscriptions,
+        }
+    }
+}
+
+impl ModalView for ThreadTagsPicker {}
+
+impl EventEmitter<DismissEvent> for ThreadTagsPicker {}
+
+impl Focusable for ThreadTagsPicker {
+    fn focus_handle(&self, cx: &App) -> FocusHandle {
+        self.picker.focus_handle(cx)
+    }
+}
+
+impl Render for ThreadTagsPicker {
+    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        v_flex()
+            .key_context("ThreadTagsPicker")
+            .child(self.picker.clone())
+    }
+}
+
+enum TagEntry {
+    /// A valid tag no thread carries yet, in the spelling typed (R1.4).
+    Add {
+        key: SharedString,
+        display: SharedString,
+    },
+    Existing {
+        tag: Tag,
+        applied: bool,
+    },
+}
+
+pub struct ThreadTagsPickerDelegate {
+    thread_id: ThreadId,
+    query: String,
+    entries: Vec<TagEntry>,
+    /// The store's rule for an invalid query, or its last refusal (R1.8, R1.9).
+    message: Option<SharedString>,
+    selected_index: usize,
+}
+
+impl ThreadTagsPickerDelegate {
+    /// Recomputes the entries and the rule from the store, so a checked mark is never older than
+    /// the last write.
+    fn rebuild(&mut self, cx: &App) {
+        // R1.7: exactly one '#' — "##kiwi" must stay invalid rather than become "kiwi".
+        let text = self.query.strip_prefix('#').unwrap_or(&self.query);
+        let normalized = normalize_tag(text);
+        let needle = match &normalized {
+            Ok((key, _)) => key.to_string(),
+            Err(_) => text.trim().to_lowercase(),
+        };
+        self.message = match &normalized {
+            Err(error) if !text.trim().is_empty() => Some(error.to_string().into()),
+            _ => None,
+        };
+
+        self.entries.clear();
+        if let Some(store) = ThreadOrganizationStore::try_global(cx) {
+            let store = store.read(cx);
+            let applied = store.tags(self.thread_id);
+            let mut known = store.all_tags();
+            known.sort_by(|left, right| left.key.cmp(&right.key));
+            if let Ok((key, display)) = &normalized
+                && !known.iter().any(|tag| &tag.key == key)
+            {
+                self.entries.push(TagEntry::Add {
+                    key: key.clone(),
+                    display: display.clone(),
+                });
+            }
+            self.entries.extend(
+                known
+                    .into_iter()
+                    .filter(|tag| tag.key.contains(needle.as_str()))
+                    .map(|tag| {
+                        let applied = applied.iter().any(|own| own.key == tag.key);
+                        TagEntry::Existing { tag, applied }
+                    }),
+            );
+        }
+        self.selected_index = self
+            .selected_index
+            .min(self.entries.len().saturating_sub(1));
+    }
+
+    fn entry_key(entry: &TagEntry) -> &SharedString {
+        match entry {
+            TagEntry::Add { key, .. } => key,
+            TagEntry::Existing { tag, .. } => &tag.key,
+        }
+    }
+
+    fn entry_label(entry: &TagEntry) -> SharedString {
+        match entry {
+            TagEntry::Add { display, .. } => format!("Add tag “{display}”").into(),
+            TagEntry::Existing { tag, .. } => tag.display.clone(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn test_entries(&self) -> Vec<String> {
+        self.entries
+            .iter()
+            .map(|entry| match entry {
+                TagEntry::Add { .. } => format!("+ {}", Self::entry_label(entry)),
+                TagEntry::Existing { tag, applied } => {
+                    format!("[{}] {}", if *applied { "x" } else { " " }, tag.display)
+                }
+            })
+            .collect()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn test_message(&self) -> Option<SharedString> {
+        self.message.clone()
+    }
+}
+
+impl PickerDelegate for ThreadTagsPickerDelegate {
+    type ListItem = ListItem;
+
+    fn name() -> &'static str {
+        "thread_tags_picker"
+    }
+
+    fn match_count(&self) -> usize {
+        self.entries.len()
+    }
+
+    fn selected_index(&self) -> usize {
+        self.selected_index
+    }
+
+    fn set_selected_index(&mut self, ix: usize, _: &mut Window, _: &mut Context<Picker<Self>>) {
+        self.selected_index = ix;
+    }
+
+    fn placeholder_text(&self, _: &mut Window, _: &mut App) -> Arc<str> {
+        "Add or remove a tag…".into()
+    }
+
+    fn no_matches_text(&self, _: &mut Window, _: &mut App) -> Option<SharedString> {
+        Some(if self.query.is_empty() {
+            "No tags yet".into()
+        } else {
+            "No matching tags".into()
+        })
+    }
+
+    fn update_matches(
+        &mut self,
+        query: String,
+        _: &mut Window,
+        cx: &mut Context<Picker<Self>>,
+    ) -> Task<()> {
+        if query != self.query {
+            self.selected_index = 0;
+        }
+        self.query = query;
+        self.rebuild(cx);
+        Task::ready(())
+    }
+
+    fn confirm(&mut self, _: bool, _: &mut Window, cx: &mut Context<Picker<Self>>) {
+        let Some(entry) = self.entries.get(self.selected_index) else {
+            return;
+        };
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        let thread_id = self.thread_id;
+        let confirmed_key = Self::entry_key(entry).clone();
+        // Called from a picker action, never from inside a `ThreadMetadataStore` update, which
+        // the store's admission check would re-enter.
+        let result = store.update(cx, |store, cx| match entry {
+            TagEntry::Add { display, .. } => store.add_tag(thread_id, display, cx),
+            // The spelling, never the key: the store re-validates its argument, and a key can be
+            // longer than the 32 characters its spelling was checked against (`İ` lowercases to
+            // `i` + U+0307).
+            TagEntry::Existing { tag, applied: true } => {
+                store.remove_tag(thread_id, &tag.display, cx)
+            }
+            TagEntry::Existing {
+                tag,
+                applied: false,
+            } => store.add_tag(thread_id, &tag.display, cx),
+        });
+        self.rebuild(cx);
+        // R1.12: the rebuild re-sorts, and removing a tag's last carrier turns its entry into
+        // "Add tag", so the index alone would point at a neighbour; follow the key instead. A
+        // refusal changed nothing, so the clamped index is still the confirmed entry.
+        if result.is_ok()
+            && let Some(ix) = self
+                .entries
+                .iter()
+                .position(|entry| Self::entry_key(entry) == &confirmed_key)
+        {
+            self.selected_index = ix;
+        }
+        if let Err(error) = result {
+            // Ids only (Q13): the error's fields are ids, and the title and tag text stay out.
+            log::warn!(
+                "thread_tags_picker: the store refused a tag change on thread {}: {error:?}",
+                thread_id.to_key_string()
+            );
+            self.message = Some(error.to_string().into());
+        }
+        cx.notify();
+    }
+
+    fn dismissed(&mut self, _: &mut Window, _: &mut Context<Picker<Self>>) {}
+
+    fn render_header(&self, _: &mut Window, _: &mut Context<Picker<Self>>) -> Option<AnyElement> {
+        let message = self.message.clone()?;
+        Some(
+            h_flex()
+                .px_3()
+                .pt_2()
+                .child(
+                    Label::new(message)
+                        .size(LabelSize::Small)
+                        .color(Color::Warning),
+                )
+                .into_any_element(),
+        )
+    }
+
+    fn render_match(
+        &self,
+        ix: usize,
+        selected: bool,
+        _: &mut Window,
+        _: &mut Context<Picker<Self>>,
+    ) -> Option<Self::ListItem> {
+        let entry = self.entries.get(ix)?;
+        let icon = match entry {
+            TagEntry::Add { .. } => Icon::new(IconName::Plus).color(Color::Muted),
+            TagEntry::Existing { applied: true, .. } => {
+                Icon::new(IconName::Check).color(Color::Accent)
+            }
+            TagEntry::Existing { applied: false, .. } => {
+                Icon::new(IconName::Hash).color(Color::Muted)
+            }
+        };
+        Some(
+            ListItem::new(ix)
+                .inset(true)
+                .spacing(ListItemSpacing::Sparse)
+                .toggle_state(selected)
+                .start_slot(icon.size(IconSize::Small))
+                .child(Label::new(Self::entry_label(entry))),
+        )
+    }
+}
+
