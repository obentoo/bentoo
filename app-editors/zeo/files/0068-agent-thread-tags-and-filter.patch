+        "R2.2"
+    );
+    assert_eq!(
+        tag_chip_labels(&shared(&["a", "b", "c"])),
+        shared(&["a", "b", "c"])
+    );
+    assert_eq!(
+        tag_chip_labels(&shared(&["a", "b", "c", "d", "e", "f"])),
+        shared(&["a", "b", "c", "+3"])
