+#[gpui::test]
+fn hostile_the_badge_does_not_displace_the_action_slot(cx: &mut TestAppContext) {
+    let (view, cx) = open(cx, Row::badge());
+    let badge = cx.debug_bounds("THREAD_ITEM_BADGE").expect("badge bounds");
+    let action = cx.debug_bounds("ACTION_SLOT").expect("action bounds");
+    assert!(
+        badge.right() <= action.left(),
+        "the badge sits after the title and before the action slot: {badge:?} vs {action:?}"
+    );
+    assert_eq!(
+        click_action_slot(&view, cx),
+        0,
+        "the click went to the action"
+    );
+}
