+    );
+
+    type_in_search(&sidebar, "#php", cx);
+    let ix = group_row_ix(&sidebar, fixture.fix_login, cx);
+    let row = entry_bounds(&sidebar, ix, cx).center();
+    assert!(!drag_starts_at(row, cx), "no thread drag under a tag term");
+    let ix = pinned_row_ix(&sidebar, fixture.write_docs, cx);
