@@ -0,0 +1,217 @@
+// Story 037, task 7.2 (refine v4) — History: a tag whose key outgrows its spelling. Requirement:
+// R5.1 (Q5). Found by 7.1's contract check (row 1a): `normalize_tag` counts the characters
+// BEFORE lowercasing, and exactly one scalar grows when lowercased — `İ` (U+0130) becomes
+// `i` + U+0307. A valid 32-character spelling holding `İ` therefore has a 33-character key, and
+// a filter that lowercases the whole query before parsing it sees an invalid term.
+//
+// Materialize at the end of `crates/agent_ui/src/threads_archive_view.rs` (a child module, so
+// the tests reach the view's private filter editor and list):
+//     #[cfg(test)]
+//     #[path = "threads_archive_view_unicode_tests.rs"]
+//     mod threads_archive_view_unicode_tests;
+// Filter: `cargo test -p agent_ui threads_archive_view_unicode`.
+//
+// The setup is a minimal copy of `threads_archive_view_tags_tests.rs`'s (that file is at its
+// size limit): the real view over the real stores, a window on `/project-a`.
+//
+// Hostile halves first: the near-identical ASCII spelling `Istanbul-…` is a DIFFERENT tag and
+// must stay out (wrong collapse); the same tag typed in another case on another thread must come
+// in (wrong split); an untagged thread stays out. Guards (green on the tip): an ordinary `#php`
+// term, and the text beside a tag term still compared lowercased (`ÉTÉ` finds "notes été" — the
+// title matcher folds ASCII only, so dropping the text part's lowercasing would lose it).
+
+use std::path::Path;
+
+use agent_client_protocol::v2::schema as acp;
+use chrono::Utc;
+use fs::FakeFs;
+use gpui::{AppContext as _, Entity, TestAppContext, VisualTestContext, WeakEntity};
+use pretty_assertions::assert_eq;
+use project::Project;
+use serde_json::json;
+use workspace::{MultiWorkspace, PathList};
+
+use super::{ArchiveListItem, ThreadsArchiveView};
+use crate::thread_metadata_store::{ThreadId, ThreadMetadata, ThreadMetadataStore, WorktreePaths};
+use crate::thread_organization::{ThreadOrganizationStore, normalize_tag};
+
+const PROJECT: &str = "/project-a";
+/// 32 characters, one of them `İ` (U+0130): valid, with a 33-character key.
+const DOTTED: &str = "İstanbul-release-plan-2026-q4-ok";
+/// The same tag in another case (same key).
+const DOTTED_UPPER: &str = "İSTANBUL-RELEASE-PLAN-2026-Q4-OK";
+/// A different tag one dot away: ASCII `I`, key `istanbul-…` without U+0307.
+const PLAIN: &str = "Istanbul-release-plan-2026-q4-ok";
+
+// ── Setup ──────────────────────────────────────────────────────────────────
+
+async fn unicode_history(
+    cx: &mut TestAppContext,
+) -> (Entity<ThreadsArchiveView>, &mut VisualTestContext) {
+    crate::test_support::init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(PROJECT, json!({ "src": {} })).await;
+    cx.update(|cx| {
+        <dyn fs::Fs>::set_global(fs.clone(), cx);
+        prompt_store::init(cx);
+        language_model::LanguageModelRegistry::test(cx);
+        agent::ThreadStore::init_global(cx);
+        ThreadMetadataStore::init_global(cx);
+    });
+    cx.run_until_parked();
+    cx.update(crate::thread_organization::init);
+    cx.run_until_parked();
+    let project = Project::test(fs, [Path::new(PROJECT)], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let workspace =
+        multi_workspace.read_with(cx, |multi_workspace, _| multi_workspace.workspace().clone());
+    let view = cx.update(|window, cx| {
+        cx.new(|cx| {
+            ThreadsArchiveView::new(
+                workspace.downgrade(),
+                WeakEntity::new_invalid(),
+                WeakEntity::new_invalid(),
+                window,
+                cx,
+            )
+        })
+    });
+    cx.run_until_parked();
+    (view, cx)
+}
+
+fn unicode_thread(title: &str, age_minutes: i64, cx: &mut VisualTestContext) -> ThreadId {
+    let created = Utc::now() - chrono::Duration::minutes(age_minutes);
+    let thread_id = ThreadId::new();
+    let metadata = ThreadMetadata {
+        thread_id,
+        session_id: Some(acp::SessionId::new(format!(
+            "unicode-{}",
+            thread_id.to_key_string()
+        ))),
+        agent_id: agent::ZED_AGENT_ID.clone(),
+        title: Some(title.to_string().into()),
+        title_override: None,
+        updated_at: created,
+        created_at: Some(created),
+        interacted_at: None,
+        worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[Path::new(PROJECT)])),
+        remote_connection: None,
+        archived: false,
+    };
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.save(metadata, cx))
+    });
+    cx.run_until_parked();
+    thread_id
+}
+
+/// Fixture write through the store; its `Ok` is the proof that the spelling is a valid tag.
+fn unicode_tag(thread_id: ThreadId, tag: &str, cx: &mut VisualTestContext) {
+    cx.update(|_, cx| {
+        ThreadOrganizationStore::global(cx)
+            .update(cx, |store, cx| store.add_tag(thread_id, tag, cx))
+    })
+    .unwrap_or_else(|error| panic!("fixture: the store accepts {tag:?}: {error:?}"));
+    cx.run_until_parked();
+}
+
+fn unicode_filter(view: &Entity<ThreadsArchiveView>, text: &str, cx: &mut VisualTestContext) {
+    view.update_in(cx, |view, window, cx| {
+        view.filter_editor
+            .update(cx, |editor, cx| editor.set_text(text, window, cx));
+    });
+    cx.run_until_parked();
+}
+
+fn unicode_listed(view: &Entity<ThreadsArchiveView>, cx: &mut VisualTestContext) -> Vec<String> {
+    let mut titles: Vec<String> = view.read_with(cx, |view, _| {
+        view.items
+            .iter()
+            .filter_map(|item| match item {
+                ArchiveListItem::Entry { thread, .. } => Some(thread.display_title().to_string()),
+                ArchiveListItem::BucketSeparator(_) => None,
+            })
+            .collect()
+    });
+    titles.sort();
+    titles
+}
+
+fn sorted(titles: &[&str]) -> Vec<String> {
+    let mut titles: Vec<String> = titles.iter().map(|title| title.to_string()).collect();
+    titles.sort();
+    titles
+}
+
+/// "Plan review" [DOTTED], "Release notes" [DOTTED_UPPER, same tag], "Ascii twin" [PLAIN],
+/// "Fix login" [php], "notes été" [php], "Untagged work" [].
+fn seed_unicode(cx: &mut VisualTestContext) {
+    let plan_review = unicode_thread("Plan review", 1, cx);
+    let release_notes = unicode_thread("Release notes", 2, cx);
+    let ascii_twin = unicode_thread("Ascii twin", 3, cx);
+    let fix_login = unicode_thread("Fix login", 4, cx);
+    let notes_ete = unicode_thread("notes été", 5, cx);
+    unicode_thread("Untagged work", 6, cx);
+    unicode_tag(plan_review, DOTTED, cx);
+    unicode_tag(release_notes, DOTTED_UPPER, cx);
+    unicode_tag(ascii_twin, PLAIN, cx);
+    unicode_tag(fix_login, "php", cx);
+    unicode_tag(notes_ete, "php", cx);
+}
+
+// ═══ Tests ═════════════════════════════════════════════════════════════════
+
+// The edge itself, stated as the store's own rule sees it (a fixture check, green on the tip).
+#[gpui::test]
+async fn the_dotted_spelling_is_a_valid_tag_with_a_longer_key(_cx: &mut TestAppContext) {
+    assert_eq!(DOTTED.chars().count(), 32);
+    let (key, display) = normalize_tag(DOTTED).expect("32 characters, no space, '#' or ','");
+    assert_eq!(display.as_ref(), DOTTED);
+    assert_eq!(key.chars().count(), 33, "U+0130 lowercases to two scalars");
+    let (upper_key, _) = normalize_tag(DOTTED_UPPER).expect("the same tag in another case");
+    assert_eq!(upper_key, key);
+    let (plain_key, _) = normalize_tag(PLAIN).expect("the ASCII twin");
+    assert_ne!(plain_key, key, "one dot apart is another tag");
+}
+
+// R5.1 — `#İstanbul-…` lists exactly the threads carrying that tag, in either spelling, and
+// neither the ASCII twin nor the untagged thread. Fails on the tip: the lowercased term is 33
+// characters, read as text, and no title matches it.
+#[gpui::test]
+async fn a_dotted_capital_i_tag_is_filtered_as_a_tag_in_history(cx: &mut TestAppContext) {
+    let (view, cx) = unicode_history(cx).await;
+    seed_unicode(cx);
+    assert_eq!(unicode_listed(&view, cx).len(), 6, "control: no filter");
+
+    unicode_filter(&view, &format!("#{DOTTED}"), cx);
+    assert_eq!(
+        unicode_listed(&view, cx),
+        sorted(&["Plan review", "Release notes"]),
+        "R5.1: the tag term selects the tagged threads; 'Ascii twin' is another tag"
+    );
+
+    unicode_filter(&view, &format!("#{DOTTED_UPPER} plan"), cx);
+    assert_eq!(
+        unicode_listed(&view, cx),
+        vec!["Plan review".to_string()],
+        "the other case is the same tag, and the text beside it still narrows"
+    );
+}
+
+// Guard (green on the tip) — an ordinary tag term, and the text beside it compared lowercased:
+// "ÉTÉ" finds "notes été" only because the text is lowercased before the ASCII-folding matcher.
+#[gpui::test]
+async fn an_ordinary_tag_term_behaves_as_before_in_history(cx: &mut TestAppContext) {
+    let (view, cx) = unicode_history(cx).await;
+    seed_unicode(cx);
+
+    unicode_filter(&view, "#php", cx);
+    assert_eq!(
+        unicode_listed(&view, cx),
+        sorted(&["Fix login", "notes été"])
+    );
+    unicode_filter(&view, "#PHP ÉTÉ", cx);
+    assert_eq!(unicode_listed(&view, cx), vec!["notes été".to_string()]);
+}
