+//     #[cfg(test)]
+//     mod sidebar_tags_notify_tests;
+// Filter: `cargo test -p sidebar sidebar_tags`.
+//
+// Reuses 5.1's `pub(super)` fixtures (`two_projects`, `save`, `tag`, `pin`) and story 032's
+// helpers from `sidebar_tests.rs`. Assumed seams, each named in ONE helper below:
+//   - `row_state()`: whether a thread is listed, and whether its row carries the unread mark
+//     (`SidebarContents::is_thread_notified`, what the row's dot is drawn from);
+//   - `switcher_order()`: `Sidebar::mru_entries_for_switcher`, the list the ctrl-tab switcher is
+//     built from, sorted by `switcher_entry_cmp` (last access first);
+//   - `opened()`: `Sidebar::record_thread_access`, what opening a thread records.
+//
+// The rule is "a row the TAG TERM hides is hidden, not gone" — 0063's devtools-only policy.
+// Hostile halves first:
+//   - wrongly gone (the defect): an untagged thread that completes while `#review` hides it, and
+//     a thread opened before the term was typed, lose their mark and their place in the switcher;
+//     the same for a pinned row the term hides (R4.15 says EVERY row — see the note on that test);
+//   - wrongly kept: a thread deleted while the term is typed is gone, so its access time must not
+//     survive (a fix that simply skips the purge under a `#` term keeps it);
+//   - plain text stays today's: a row the TEXT hides is dropped as it is upstream (ToDo 3: with no
+//     keys nothing is registered).
+// Regression guards, green on the tip: `a_thread_deleted_under_a_tag_term_is_forgotten`,
+// `plain_text_hiding_is_todays_behaviour`.
+
+use super::*;
+use crate::sidebar_tags_tests::{ALPHA, pin, save, tag, two_projects};
+use crate::sidebar_tests::{
+    init_test_project_with_agent_panel, save_test_thread_metadata, setup_sidebar_with_agent_panel,
+    type_in_search,
+};
+use acp_thread::StubAgentConnection;
+use agent_client_protocol::v1::schema as acp_v1;
+use agent_ui::test_support::{
+    active_session_id, active_thread_id, open_thread_with_connection, send_message,
+};
+use gpui::{TestAppContext, VisualTestContext};
+use pretty_assertions::assert_eq;
+
+const PROJECT_A: &str = "/project-a";
+
+// ── Reading the sidebar ────────────────────────────────────────────────────
+
+/// `None` when the thread has no row; `Some(notified)` when it is listed.
+fn row_state(
+    sidebar: &Entity<Sidebar>,
+    thread_id: ThreadId,
+    cx: &mut VisualTestContext,
+) -> Option<bool> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .find_map(|entry| match entry {
+                ListEntry::Thread(thread) if thread.metadata.thread_id == thread_id => {
+                    Some(sidebar.contents.is_thread_notified(&thread_id))
+                }
+                _ => None,
+            })
+    })
+}
+
+fn switcher_order(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<ThreadId> {
+    sidebar.read_with(cx, |sidebar, cx| {
+        sidebar
+            .mru_entries_for_switcher(cx)
+            .iter()
+            .filter_map(|entry| entry.thread_id())
+            .collect()
+    })
+}
+
+fn opened(sidebar: &Entity<Sidebar>, thread_id: ThreadId, cx: &mut VisualTestContext) {
+    sidebar.update(cx, |sidebar, _| sidebar.record_thread_access(&thread_id));
+}
+
+// ═══ R4.15 — hidden, not gone ═════════════════════════════════════════════
+
+// The defect, as N1 describes it: the filter holds `#review`; an untagged thread in a background
+// workspace goes Running -> Completed while the term hides it. Clearing the filter must show its
+// unread mark — the transition is seen only once, so a mark dropped here never comes back.
+#[gpui::test]
+async fn a_thread_completing_under_a_tag_term_shows_its_notification_after(
+    cx: &mut TestAppContext,
+) {
+    let project_a = init_test_project_with_agent_panel(PROJECT_A, cx).await;
+    cx.update(agent_ui::thread_organization::init);
+    cx.run_until_parked();
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project_a.clone(), window, cx));
+    let (sidebar, panel) = setup_sidebar_with_agent_panel(&multi_workspace, cx);
+
+    let connection = StubAgentConnection::new();
+    open_thread_with_connection(&panel, connection.clone(), cx);
+    send_message(&panel, cx);
+    let session = active_session_id(&panel, cx);
+    let hidden = active_thread_id(&panel, cx);
+    save_test_thread_metadata(&session, &project_a, cx).await;
+    cx.update(|_, cx| {
+        connection.send_update(
+            session.clone(),
+            acp_v1::SessionUpdate::AgentMessageChunk(acp_v1::ContentChunk::new("chunk".into())),
+            cx,
+        );
+    });
+    cx.run_until_parked();
+    let review = save("r1", "Review notes", PROJECT_A, 5, cx);
+    tag(review, "review", cx);
+
+    // A second workspace, activated: the running thread is now out of sight.
+    let fs = cx.update(|_, cx| <dyn fs::Fs>::global(cx));
+    let project_b = project::Project::test(fs, [], cx).await;
+    multi_workspace.update_in(cx, |multi_workspace, window, cx| {
+        multi_workspace.test_add_workspace(project_b, window, cx);
+    });
+    cx.run_until_parked();
+    assert_eq!(
+        row_state(&sidebar, hidden, cx),
+        Some(false),
+        "fixture: listed, running, no mark yet"
+    );
+
+    type_in_search(&sidebar, "#review", cx);
+    assert_eq!(row_state(&sidebar, hidden, cx), None, "R4.1: hidden");
+    assert_eq!(row_state(&sidebar, review, cx), Some(false));
+
+    connection.end_turn(session.clone(), acp_v1::StopReason::EndTurn);
+    cx.run_until_parked();
+    assert_eq!(row_state(&sidebar, hidden, cx), None, "still hidden");
+
+    type_in_search(&sidebar, "", cx);
+    assert_eq!(
+        row_state(&sidebar, hidden, cx),
+        Some(true),
+        "R4.15: the thread that completed while the tag term hid it keeps its unread mark"
+    );
+}
+
+// A thread opened before the term was typed keeps its last-access time: with the term cleared it
+// is still first in the switcher, ahead of threads updated later than it.
+#[gpui::test]
+async fn a_thread_hidden_by_a_tag_term_keeps_its_switcher_place(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let older = save("a1", "Older thread", ALPHA, 1, cx);
+    let newer = save("a2", "Newer thread", ALPHA, 3, cx);
+    let review = save("a3", "Review notes", ALPHA, 5, cx);
+    tag(review, "review", cx);
+    opened(&sidebar, older, cx);
+    assert_eq!(
+        switcher_order(&sidebar, cx),
+        vec![older, review, newer],
+        "fixture: the opened thread first, then by time"
+    );
+
+    type_in_search(&sidebar, "#review", cx);
+    assert_eq!(row_state(&sidebar, older, cx), None, "R4.1: hidden");
+    type_in_search(&sidebar, "", cx);
+
+    assert_eq!(
+        switcher_order(&sidebar, cx),
+        vec![older, review, newer],
+        "R4.15: the hidden thread keeps its last-access time"
+    );
+}
+
+// The Pinned section's share of R4.15 ("every thread row the term hides"): an untagged pinned row
+// the term hides keeps its last-access time too. NOTE for the executor: the Pinned rows are
+// dropped by `retain_tagged_rows` (hook f), not by `retain_tagged`, so 5.3's fix as worded
+// ("`retain_tagged` registers the ids it drops") leaves this test red; it needs hook f's call
+// line, also this story's own, to pass the same set.
+#[gpui::test]
+async fn a_pinned_row_hidden_by_a_tag_term_keeps_its_switcher_place(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let pinned = save("a1", "Pinned thread", ALPHA, 1, cx);
+    let newer = save("a2", "Newer thread", ALPHA, 3, cx);
+    let review = save("a3", "Review notes", ALPHA, 5, cx);
+    pin(pinned, cx);
+    tag(review, "review", cx);
+    opened(&sidebar, pinned, cx);
+    assert_eq!(
+        switcher_order(&sidebar, cx),
+        vec![pinned, review, newer],
+        "fixture"
+    );
+
+    type_in_search(&sidebar, "#review", cx);
+    assert_eq!(row_state(&sidebar, pinned, cx), None, "R4.7: hidden");
+    type_in_search(&sidebar, "", cx);
+
+    assert_eq!(
+        switcher_order(&sidebar, cx),
+        vec![pinned, review, newer],
+        "R4.15: the hidden pinned row keeps its last-access time"
+    );
+}
+
+// ═══ Regression guards ════════════════════════════════════════════════════
+
+// Guard, the wrongly-kept half: a thread DELETED while the term is typed is gone, not hidden, so
+// the purge still forgets it (a fix that skips the purge under a `#` term would keep it).
+#[gpui::test]
+async fn a_thread_deleted_under_a_tag_term_is_forgotten(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let gone = save("a1", "Gone thread", ALPHA, 1, cx);
+    let review = save("a2", "Review notes", ALPHA, 5, cx);
+    tag(review, "review", cx);
+    opened(&sidebar, gone, cx);
+
+    type_in_search(&sidebar, "#review", cx);
+    cx.update(|_, cx| {
+        ThreadMetadataStore::global(cx).update(cx, |store, cx| store.delete(gone, cx))
+    });
+    cx.run_until_parked();
+    type_in_search(&sidebar, "", cx);
+
+    assert_eq!(row_state(&sidebar, gone, cx), None);
+    assert!(
+        sidebar.read_with(cx, |sidebar, _| !sidebar
+            .thread_last_accessed
+            .contains_key(&gone)),
+        "a deleted thread's access time is not kept"
+    );
+}
+
+// Guard, ToDo 3: with plain text only, the rows are today's, and a row the TEXT hides loses its
+// access time as it does upstream — nothing is registered without a `#` key.
+#[gpui::test]
+async fn plain_text_hiding_is_todays_behaviour(cx: &mut TestAppContext) {
+    let (_multi_workspace, sidebar, cx) = two_projects(true, cx).await;
+    let older = save("a1", "Older thread", ALPHA, 1, cx);
+    let newer = save("a2", "Newer thread", ALPHA, 3, cx);
+    let review = save("a3", "Review notes", ALPHA, 5, cx);
+    tag(review, "review", cx);
+    opened(&sidebar, older, cx);
+
+    type_in_search(&sidebar, "Review", cx);
+    assert_eq!(row_state(&sidebar, review, cx), Some(false));
+    assert_eq!(row_state(&sidebar, older, cx), None);
+    assert_eq!(row_state(&sidebar, newer, cx), None);
+    type_in_search(&sidebar, "", cx);
+
+    assert_eq!(
+        switcher_order(&sidebar, cx),
+        vec![review, newer, older],
+        "R4.5: a text-hidden row is dropped from the access record, as upstream"
+    );
+}
