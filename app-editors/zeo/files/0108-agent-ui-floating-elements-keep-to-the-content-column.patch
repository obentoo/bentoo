 /// `area` without the strip an overlay takes at its top: the thread's pinned user message
 /// floats over the first lines of the conversation, and the card shares that corner. An
 /// overlay that ends above the area, or past its bottom, never moves the area outside itself.
+/// `area` narrowed to the conversation's column (Zeo next proposal §6.30): as wide as `area` up
+/// to `max_content_width`, centred in it -- the column upstream gives the entries and the
+/// composer. The card's corner is then the column's corner, and a preview that widens to its
+/// frame widens to the column instead of the whole panel. With no maximum the area is unchanged.
+pub(crate) fn within_content_column(
+    area: Bounds<Pixels>,
+    max_content_width: Option<Pixels>,
+) -> Bounds<Pixels> {
+    let Some(max_width) = max_content_width else {
+        return area;
+    };
+    if area.size.width <= max_width {
+        return area;
+    }
+    let left = area.left() + (area.size.width - max_width) / 2.;
+    Bounds::new(point(left, area.top()), size(max_width, area.size.height))
+}
