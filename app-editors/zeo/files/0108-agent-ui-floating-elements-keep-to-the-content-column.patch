@@ -0,0 +1,176 @@
+//! Zeo next proposal §6.30 (ask 50): on a panel wider than `agent.max_content_width`, the
+//! series' own elements -- the pinned user message, the question card and its bar, the
+//! floating navigation controls -- keep to the conversation's centred column, as the entries
+//! and the composer do, instead of spanning the whole agent area. Filter: `content_width_tests`.
+//!
+//! Resolves to `crates/agent_ui/src/conversation_view/thread_view/tests/content_width_tests.rs`.
+
+use acp_thread::AcpThread;
+use agent_client_protocol::v1::schema as acp;
+use agent_settings::AgentSettings;
+use gpui::{Bounds, Entity, ListOffset, Pixels, TestAppContext, VisualTestContext, px, size};
+use settings::Settings as _;
+use workspace::dock::PanelSizeState;
+
+use super::super::ThreadView;
+use super::elicitation_decline_harness::*;
+use crate::AgentPanel;
+
+const WIDE_PANEL: f32 = 1700.;
+
+async fn wide(
+    cx: &mut TestAppContext,
+) -> (Entity<ThreadView>, Entity<AcpThread>, VisualTestContext) {
+    let (view, thread, mut cx) = setup(cx).await;
+    cx.simulate_resize(size(px(WIDE_PANEL + 500.), px(900.)));
+    let workspace = view
+        .read_with(&cx, |view, _| view.workspace.upgrade())
+        .expect("the workspace is alive");
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.set_panel_size_state::<AgentPanel>(
+            PanelSizeState {
+                size: Some(px(WIDE_PANEL)),
+                flex: None,
+            },
+            window,
+            cx,
+        );
+    });
+    draw(&mut cx);
+    (view, thread, cx)
+}
+
+fn max_content_width(cx: &mut VisualTestContext) -> Pixels {
+    cx.update(|_, cx| AgentSettings::get_global(cx).max_content_width)
+        .expect("the column is limited by default")
+}
+
+fn panel_bounds(cx: &mut VisualTestContext) -> Bounds<Pixels> {
+    cx.debug_bounds("agent-panel").expect("panel painted")
+}
+
+/// `inner` fits the `width`-wide column centred on `outer`; a few pixels of slack cover the
+/// overlays' own insets (`left_2`/`right_4`) and rounding.
+fn assert_in_column(what: &str, outer: Bounds<Pixels>, width: Pixels, inner: Bounds<Pixels>) {
+    assert!(
+        inner.size.width <= width + px(0.5),
+        "{what} {inner:?} is wider than the {width:?} column"
+    );
+    let half = width / 2.;
+    let center = outer.center().x;
+    assert!(
+        inner.left() >= center - half - px(8.) && inner.right() <= center + half + px(8.),
+        "{what} {inner:?} is outside the {width:?} column centred in {outer:?}"
+    );
+}
+
+/// A user message and a long reply, scrolled so the message is above the viewport and pinned.
+fn scroll_past_a_user_message(
+    view: &Entity<ThreadView>,
+    thread: &Entity<AcpThread>,
+    cx: &mut VisualTestContext,
+) {
+    thread.update(cx, |thread, cx| {
+        thread.push_user_content_block(None, "the question that started the turn".into(), cx)
+    });
+    let reply = (0..120)
+        .map(|ix| format!("line {ix} of a reply long enough to scroll"))
+        .collect::<Vec<_>>()
+        .join("\n\n");
+    thread
+        .update(cx, |thread, cx| {
+            thread.handle_session_update(
+                acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(reply.into())),
+                cx,
+            )
+        })
+        .expect("the reply applies");
+    draw(cx);
+    view.update(cx, |view, cx| {
+        view.list_state.scroll_to(ListOffset {
+            item_ix: 1,
+            offset_in_item: px(200.),
+        });
+        cx.notify();
+    });
+    draw(cx);
+}
+
+#[gpui::test]
+async fn the_pinned_user_message_keeps_to_the_column(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = wide(cx).await;
+    scroll_past_a_user_message(&view, &thread, &mut cx);
+    let max_width = max_content_width(&mut cx);
+    let panel = panel_bounds(&mut cx);
+    assert!(
+        panel.size.width > max_width + px(200.),
+        "the panel {panel:?} is wide"
+    );
+    let header = cx
+        .debug_bounds("thread-pinned-user-message")
+        .expect("the user message is pinned");
+    assert_in_column("the pinned message", panel, max_width, header);
+}
+
+#[gpui::test]
+async fn the_floating_navigation_sits_at_the_columns_right_edge(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = wide(cx).await;
+    scroll_past_a_user_message(&view, &thread, &mut cx);
+    let max_width = max_content_width(&mut cx);
+    let panel = panel_bounds(&mut cx);
+    let controls = cx
+        .debug_bounds("thread-floating-navigation")
+        .expect("the controls are painted");
+    assert_in_column("the navigation controls", panel, max_width, controls);
+    assert!(
+        controls.right() >= panel.center().x + max_width / 2. - px(24.),
+        "the controls {controls:?} sit at the column's right edge, not its middle"
+    );
+}
+
+#[gpui::test]
+async fn the_question_card_and_its_bar_keep_to_the_column(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = wide(cx).await;
+    ask(&thread, one_question(), "Which one?", &mut cx);
+    draw(&mut cx);
+    let max_width = max_content_width(&mut cx);
+    let panel = panel_bounds(&mut cx);
+    let card = cx
+        .debug_bounds("pinned-elicitations")
+        .expect("the question card is painted");
+    assert_in_column("the question card", panel, max_width, card);
+
+    view.update(&mut cx, |view, cx| {
+        view.toggle_question_card(&crate::ToggleQuestionCard, cx)
+    });
+    draw(&mut cx);
+    let bar = cx
+        .debug_bounds("question-card-bar")
+        .expect("minimized: the bar shows");
+    assert_in_column("the question bar", panel, max_width, bar);
+}
+
+/// Hostile: with `limit_content_width` off there is no column, and the bar spans the panel as
+/// it always did -- the fix must not invent a width of its own.
+#[gpui::test]
+async fn without_a_maximum_the_bar_spans_the_panel(cx: &mut TestAppContext) {
+    let (view, thread, mut cx) = wide(cx).await;
+    cx.update(|_, cx| {
+        let mut settings = AgentSettings::get_global(cx).clone();
+        settings.max_content_width = None;
+        AgentSettings::override_global(settings, cx);
+    });
+    ask(&thread, one_question(), "Which one?", &mut cx);
+    view.update(&mut cx, |view, cx| {
+        view.toggle_question_card(&crate::ToggleQuestionCard, cx)
+    });
+    draw(&mut cx);
+    let panel = panel_bounds(&mut cx);
+    let bar = cx
+        .debug_bounds("question-card-bar")
+        .expect("minimized: the bar shows");
+    assert!(
+        bar.size.width >= panel.size.width * 0.9,
+        "the bar {bar:?} spans the panel {panel:?}"
+    );
+}
