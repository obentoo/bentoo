diff --git a/crates/agent_ui/src/tasks_card/content_width_tests.rs b/crates/agent_ui/src/tasks_card/content_width_tests.rs
new file mode 100644
index 0000000..eff30e6
--- /dev/null
+++ b/crates/agent_ui/src/tasks_card/content_width_tests.rs
@@ -0,0 +1,172 @@
+// Zeo next proposal §6.30 (ask 50): on a panel wider than `agent.max_content_width`, the tasks
+// card -- floating in any corner, previewing, or docked as a bar -- keeps to the conversation's
+// centred column, as the entries and the composer do. Filter: `tasks_card::content_width`.
+
+use agent_client_protocol::v1::schema as acp;
+use agent_settings::AgentSettings;
+use gpui::{Bounds, Modifiers, Pixels, TestAppContext, VisualTestContext, px, size};
+use settings::{Settings as _, TasksCardPosition};
+use workspace::dock::PanelSizeState;
+
+use super::test_helpers::*;
+use crate::AgentPanel;
+
+/// Wide enough that the default 850 px column leaves room on both sides.
+const WIDE_PANEL: f32 = 1700.;
+
+fn draw(cx: &mut VisualTestContext) {
+    cx.update(|window, _| window.refresh());
+    cx.run_until_parked();
+}
+
+fn click(selector: &'static str, cx: &mut VisualTestContext) {
+    let bounds = cx
+        .debug_bounds(selector)
+        .unwrap_or_else(|| panic!("{selector} is painted"));
+    cx.simulate_click(bounds.center(), Modifiers::none());
+    draw(cx);
+}
+
+fn max_content_width(cx: &mut VisualTestContext) -> Option<Pixels> {
+    cx.update(|_, cx| AgentSettings::get_global(cx).max_content_width)
+}
+
+fn update_agent_settings(cx: &mut VisualTestContext, change: impl FnOnce(&mut AgentSettings)) {
+    cx.update(|_, cx| {
+        let mut settings = AgentSettings::get_global(cx).clone();
+        change(&mut settings);
+        AgentSettings::override_global(settings, cx);
+    });
+    draw(cx);
+}
+
+/// A panel of `WIDE_PANEL` px holding a thread with one entry and one running task.
+async fn wide_panel_with_a_task(
+    cx: &mut TestAppContext,
+) -> (gpui::Entity<AgentPanel>, VisualTestContext) {
+    let (panel, workspace, mut cx) = setup_card_panel_in_workspace(cx).await;
+    cx.simulate_resize(size(px(WIDE_PANEL + 500.), px(900.)));
+    workspace.update_in(&mut cx, |workspace, window, cx| {
+        workspace.set_panel_size_state::<AgentPanel>(
+            PanelSizeState {
+                size: Some(px(WIDE_PANEL)),
+                flex: None,
+            },
+            window,
+            cx,
+        );
+    });
+    let connection = TaskActionsConnection::new();
+    let thread = open_titled_thread(&panel, &connection, "A", &mut cx);
+    thread
+        .update(&mut cx, |thread, cx| {
+            thread.handle_session_update(
+                acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(
+                    "a response long enough to be an entry".into(),
+                )),
+                cx,
+            )
+        })
+        .expect("the agent message applies");
+    send_tasks(
+        &thread,
+        vec![wire_task("t1", "running", true, 1_000)],
+        &mut cx,
+    );
+    draw(&mut cx);
+    (panel, cx)
+}
+
+fn conversation(panel: &gpui::Entity<AgentPanel>, cx: &VisualTestContext) -> Bounds<Pixels> {
+    panel.read_with(cx, |panel, cx| {
+        let view = panel.active_thread_view(cx).expect("a thread view");
+        view.read(cx).list_state.viewport_bounds()
+    })
+}
+
+/// `inner` lies within the `width`-wide column centred on `outer`, half a pixel of rounding
+/// allowed on each side.
+fn inside_column(outer: Bounds<Pixels>, width: Pixels, inner: Bounds<Pixels>) -> bool {
+    let half = width / 2.;
+    let center = outer.center().x;
+    inner.left() >= center - half - px(0.5) && inner.right() <= center + half + px(0.5)
+}
+
+#[test]
+fn a_wide_area_narrows_to_the_centred_column() {
+    let area = Bounds::new(gpui::point(px(100.), px(40.)), size(px(1700.), px(600.)));
+    let column = crate::tasks_card::within_content_column(area, Some(px(850.)));
+    assert_eq!(column.size.width, px(850.));
+    assert_eq!(column.size.height, area.size.height);
+    assert_eq!(column.top(), area.top());
+    assert_eq!(column.center().x, area.center().x);
+}
+
+/// Hostile: a column wider than the area must never grow the area past the panel, and no
+/// maximum (`limit_content_width` off) leaves it exactly as it was.
+#[test]
+fn a_narrow_area_or_no_maximum_is_left_alone() {
+    let area = Bounds::new(gpui::point(px(10.), px(10.)), size(px(400.), px(300.)));
+    assert_eq!(
+        crate::tasks_card::within_content_column(area, Some(px(850.))),
+        area
+    );
+    assert_eq!(crate::tasks_card::within_content_column(area, None), area);
+}
+
+#[gpui::test]
+async fn test_the_floating_card_keeps_to_the_column_in_every_corner(cx: &mut TestAppContext) {
+    let (panel, mut cx) = wide_panel_with_a_task(cx).await;
+    let max_width = max_content_width(&mut cx).expect("the column is limited by default");
+    let viewport = conversation(&panel, &cx);
+    assert!(
+        viewport.size.width > max_width + px(200.),
+        "the conversation {viewport:?} is wider than the column"
+    );
+    for position in [
+        TasksCardPosition::TopRight,
+        TasksCardPosition::TopLeft,
+        TasksCardPosition::BottomRight,
+        TasksCardPosition::BottomLeft,
+    ] {
+        update_agent_settings(&mut cx, |settings| settings.tasks_card.position = position);
+        let card = cx.debug_bounds("tasks-card").expect("card painted");
+        assert!(
+            inside_column(viewport, max_width, card),
+            "{position:?}: card {card:?} outside the {max_width:?} column of {viewport:?}"
+        );
+    }
+}
+
+/// With no maximum the card goes back to the panel's corner: the fix narrows to the column,
+/// it does not move the card in for its own sake.
+#[gpui::test]
+async fn test_without_a_maximum_the_card_reaches_the_panel_corner(cx: &mut TestAppContext) {
+    let (panel, mut cx) = wide_panel_with_a_task(cx).await;
+    update_agent_settings(&mut cx, |settings| settings.max_content_width = None);
+    let viewport = conversation(&panel, &cx);
+    let card = cx.debug_bounds("tasks-card").expect("card painted");
+    assert!(
+        card.right() >= viewport.right() - px(24.),
+        "TopRight with no maximum: card {card:?} sits at the right edge of {viewport:?}"
+    );
+}
+
+#[gpui::test]
+async fn test_the_docked_bar_keeps_to_the_column(cx: &mut TestAppContext) {
+    let (_panel, mut cx) = wide_panel_with_a_task(cx).await;
+    let max_width = max_content_width(&mut cx).expect("the column is limited by default");
+    click("tasks-card-dock-bottom", &mut cx);
+    let bar = cx
+        .debug_bounds("tasks-card-bar")
+        .expect("the bar is painted");
+    let panel_bounds = cx.debug_bounds("agent-panel").expect("panel painted");
+    assert!(
+        bar.size.width <= max_width + px(0.5),
+        "the bar {bar:?} is wider than the {max_width:?} column"
+    );
+    assert!(
+        inside_column(panel_bounds, max_width, bar),
+        "the bar {bar:?} is not centred in {panel_bounds:?}"
+    );
+}
