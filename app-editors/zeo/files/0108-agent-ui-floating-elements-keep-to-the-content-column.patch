+//! The series' own elements keep to the conversation's column (Zeo next proposal §6.30, ask 50).
+//!
+//! Upstream caps the entries, the activity bar and the composer at `agent.max_content_width`
+//! (850 px by default, while `agent.limit_content_width` is on) and centres them. The pinned user
+//! message, the question card and its bar, the docked tasks bar and the floating navigation
+//! controls were added by the series without that cap, so on a wide panel they spanned the whole
+//! agent area while everything around them stayed in the column. They now go through
+//! [`content_column`], which is upstream's own `centered_container` from `render_entries`, so the
+//! two can never disagree about where the column is.
+
+use agent_settings::AgentSettings;
+use gpui::{App, Div, IntoElement};
+use settings::Settings as _;
+use ui::prelude::*;
+
+/// `child` inside the conversation's column: as wide as the panel up to the configured maximum,
+/// and centred. With `limit_content_width` off there is no maximum and the column is the panel.
+pub(crate) fn content_column(child: impl IntoElement, cx: &App) -> Div {
+    let max_content_width = AgentSettings::get_global(cx).max_content_width;
+    h_flex().w_full().justify_center().child(
+        div()
+            .when_some(max_content_width, |this, max_w| this.max_w(max_w))
+            .w_full()
+            .min_w_0()
+            .child(child),
+    )
+}
