+/// The pinned questions a thread is waiting on, counted across one burst of
+/// them: from the moment one is pending until none is.
+///
+/// Counting only what is pending would make the counter shrink instead of
+/// advance -- "1 of 3", then "1 of 2" -- because an answered question leaves
+/// the pending list. Remembering every question seen pending since the queue
+/// last ran dry is what lets the second one read "2 of 3".
+#[derive(Default)]
+pub(crate) struct QuestionQueue {
+    seen: HashSet<ElicitationEntryId>,
+}
+
+impl QuestionQueue {
+    /// Record the questions pending now, in arrival order, and return
+    /// `(position, total)` for the first of them -- the one the card shows.
+    /// `None` when nothing is pending, which also ends the burst, so the next
+    /// question starts a count of its own.
+    pub(crate) fn advance(&mut self, pending: &[&ElicitationEntryId]) -> Option<(usize, usize)> {
+        if pending.is_empty() {
+            self.seen.clear();
+            return None;
+        }
+        self.seen.extend(pending.iter().map(|id| (*id).clone()));
+        let total = self.seen.len();
+        Some((total.saturating_sub(pending.len()) + 1, total))
+    }
+}
