+/// Shared `_meta` key marking a free-text field as the custom-answer companion
+/// of a select field — the "Other" box that belongs to one specific question.
+///
+/// Deliberately *not* namespaced to any agent, and that is the adapter's
+/// choice, not an omission: the same marker is meant to be recognised across
+/// every AskUserQuestion bridge. Reading it here is what lets a page hold a
+/// question together with its own free-text box instead of splitting the two
+/// across two pages.
+const ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY: &str = "_askUserQuestionCustomAnswer";
+
+/// The `_meta` of a property schema, for the variants that carry one.
+///
+/// `Other` is the untagged custom/future variant: it keeps its payload as raw
+/// JSON under `fields` and has no typed `_meta`, so it answers `None` rather
+/// than being parsed speculatively.
+fn property_meta(property: &acp::ElicitationPropertySchema) -> Option<&acp::Meta> {
+    match property {
+        acp::ElicitationPropertySchema::String(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Number(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Integer(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Boolean(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Array(schema) => schema.meta.as_ref(),
+        _ => None,
+    }
+}
+
+/// The field this one is the custom-answer companion of, if it is one.
+/// Tolerant in the same way as the option previews above: an absent key, a
+/// non-object entry or a wrong-typed field all yield `None`, never an error.
+fn custom_answer_companion_of(property: &acp::ElicitationPropertySchema) -> Option<&str> {
+    property_meta(property)?
+        .get(ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY)?
+        .as_object()?
+        .get("questionId")?
+        .as_str()
+}
+
+/// Split a form's fields into the pages a paginated card shows one at a time.
+///
+/// A page is one field plus every companion that names it, so a question and
+/// its own "Other" box stay together. Fields keep schema order, which for a
+/// `BTreeMap` is the key order the agent chose. A companion naming a field
+/// this schema does not have opens its own page instead of vanishing — a
+/// field the user cannot reach is worse than one on a page of its own.
+///
+/// A form that marks no field as a companion is **not** split at all: it comes
+/// back as one page holding everything. Only the marker says "these fields are
+/// separate questions"; without it the fields are a form to read together --
+/// an MCP server asking for a host and a port -- and putting the second on a
+/// page that hides the first would be a wizard nobody asked for.
+///
+/// A form with one question therefore yields one page, which is how a
+/// paginated card ends up looking exactly like an unpaginated one.
+fn form_pages(schema: &acp::ElicitationSchema) -> Vec<Vec<SharedString>> {
+    let marks_questions = schema
+        .properties
+        .values()
+        .any(|property| custom_answer_companion_of(property).is_some());
+    if !marks_questions {
+        return vec![
+            schema
+                .properties
+                .keys()
+                .map(|name| SharedString::from(name.clone()))
+                .collect(),
+        ];
+    }
+
+    let mut pages: Vec<Vec<SharedString>> = Vec::new();
+    let mut page_of_field: HashMap<&str, usize> = HashMap::default();
+
+    for (name, property) in &schema.properties {
+        let is_companion = custom_answer_companion_of(property)
+            .is_some_and(|target| schema.properties.contains_key(target));
+        if is_companion {
+            continue;
+        }
+        page_of_field.insert(name.as_str(), pages.len());
+        pages.push(vec![SharedString::from(name.clone())]);
+    }
+
+    for (name, property) in &schema.properties {
+        let Some(target) = custom_answer_companion_of(property) else {
+            continue;
+        };
+        let Some(&page) = page_of_field.get(target) else {
+            continue;
+        };
+        pages[page].push(SharedString::from(name.clone()));
+    }
+
+    pages
+}
