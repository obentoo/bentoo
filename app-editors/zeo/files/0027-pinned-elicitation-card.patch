+    /// A free-text field carrying the marker that pairs it with `question_id`
+    /// -- what the adapter emits beside every question it asks.
+    fn custom_answer_field(question_id: &str) -> acp::StringPropertySchema {
+        let mut schema = acp::StringPropertySchema::new().title("Other");
+        let mut meta = serde_json::Map::new();
+        meta.insert(
+            ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY.to_string(),
+            serde_json::json!({ "questionId": question_id, "isCustomAnswer": true }),
+        );
+        schema.meta = Some(meta);
+        schema
+    }
+
+    /// Two questions, each with its own "Other" box: the shape an
+    /// AskUserQuestion call with two questions arrives in.
+    fn two_question_schema() -> acp::ElicitationSchema {
+        acp::ElicitationSchema::new()
+            .property(
+                "question_0",
+                acp::StringPropertySchema::new()
+                    .enum_values(vec!["first".to_string(), "second".to_string()]),
+                false,
+            )
+            .property(
+                "question_0_custom",
+                custom_answer_field("question_0"),
+                false,
+            )
+            .property(
+                "question_1",
+                acp::StringPropertySchema::new()
+                    .enum_values(vec!["third".to_string(), "fourth".to_string()]),
+                false,
+            )
+            .property(
+                "question_1_custom",
+                custom_answer_field("question_1"),
+                false,
+            )
+    }
+
+    fn entry_ids<const N: usize>(ids: [&str; N]) -> [ElicitationEntryId; N] {
+        ids.map(|id| ElicitationEntryId(id.into()))
+    }
+
+    #[test]
+    fn question_queue_advances_instead_of_shrinking() {
+        let [first, second, third] = entry_ids(["first", "second", "third"]);
+        let mut queue = QuestionQueue::default();
+
+        assert_eq!(queue.advance(&[&first, &second, &third]), Some((1, 3)));
+        assert_eq!(
+            queue.advance(&[&second, &third]),
+            Some((2, 3)),
+            "an answered question still counts, or the total shrinks under the user"
+        );
+        assert_eq!(queue.advance(&[&third]), Some((3, 3)));
+    }
+
+    #[test]
+    fn question_queue_counts_a_late_question_into_the_same_burst() {
+        let [first, second, third] = entry_ids(["first", "second", "third"]);
+        let mut queue = QuestionQueue::default();
+
+        assert_eq!(queue.advance(&[&first, &second]), Some((1, 2)));
+        assert_eq!(queue.advance(&[&second, &third]), Some((2, 3)));
+    }
+
+    #[test]
+    fn question_queue_starts_over_once_it_runs_dry() {
+        let [first, second] = entry_ids(["first", "second"]);
+        let mut queue = QuestionQueue::default();
+
+        assert_eq!(queue.advance(&[&first]), Some((1, 1)));
+        assert_eq!(queue.advance(&[]), None);
+        assert_eq!(
+            queue.advance(&[&second]),
+            Some((1, 1)),
+            "a question asked after the queue emptied is not the second of the old burst"
+        );
+    }
+
