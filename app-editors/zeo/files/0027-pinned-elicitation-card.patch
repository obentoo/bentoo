+                acp_v2::CreateElicitationRequest::new(
+                    acp_v2::ElicitationUrlMode::new(
+                        scope,
+                        acp_v2::ElicitationId::new("u"),
+                        "https://example.com",
+                    ),
+                    "Open the link",
+                )
+            } else {
+                acp_v2::CreateElicitationRequest::new(
+                    acp_v2::ElicitationFormMode::new(
+                        scope,
+                        acp_v2::ElicitationSchema::new().string("name", true),
+                    ),
+                    "Provide a name",
+                )
+            };
+            let status = if pending {
+                ElicitationStatus::Pending {
+                    respond_tx: futures::channel::oneshot::channel().0,
+                }
+            } else {
+                ElicitationStatus::Accepted
+            };
+            Elicitation {
+                id: ElicitationEntryId("e".into()),
+                request,
+                status,
+            }
+        };
+
+        cx.update(|cx| {
+            assert_eq!(
+                AgentSettings::get_global(cx).elicitation_placement,
+                ElicitationPlacement::Card,
+                "default.json ships the pinned card"
+            );
+            assert!(ThreadView::renders_elicitation_as_card(&elicitation(false, true), cx));
+            assert!(!ThreadView::renders_elicitation_as_card(&elicitation(true, true), cx));
+            assert!(!ThreadView::renders_elicitation_as_card(&elicitation(false, false), cx));
+
+            SettingsStore::update_global(cx, |store, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings.agent.get_or_insert_default().elicitation_placement =
+                        Some(ElicitationPlacement::Inline);
+                });
+            });
+            assert!(
+                !ThreadView::renders_elicitation_as_card(&elicitation(false, true), cx),
+                "inline placement draws even a pending form in the conversation"
+            );
+        });
+    }
 }
 
