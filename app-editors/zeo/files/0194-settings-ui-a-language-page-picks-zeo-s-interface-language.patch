-/// What ships: every `locales/<language>/*.ftl`, listed by build.rs into `$OUT_DIR`.
-/// `include_str!` keeps the files inside the binary, so no path is resolved at run time;
-/// a new `.ftl` file ships by being there, and no patch edits this file to add one.
+// What ships: every `locales/<language>/*.ftl`, listed by build.rs into `$OUT_DIR`.
+// `include_str!` keeps the files inside the binary, so no path is resolved at run time;
+// a new `.ftl` file ships by being there, and no patch edits this file to add one.
+// A plain comment: rustdoc documents no macro invocation, and `///` here was clippy's
+// unused_doc_comments (found by 0194's lab run, 2026-11-26).
 include!(concat!(env!("OUT_DIR"), "/shipped.rs"));
 
+/// The message every language names itself with, in its own `zeo.ftl`: a
+/// picker shows "Português (Brasil)", not "Portuguese", because the person
+/// looking for it may not read the language the UI is in now.
+pub const LANGUAGE_NAME_ID: &str = "zeo-language-name";
+
+/// A language a picker can offer.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ShippedLanguage {
+    /// Its BCP 47 tag, the value `ui_language` takes.
+    pub tag: &'static str,
+    /// Its name in itself; the tag when its `zeo.ftl` gives none.
+    pub name: String,
+}
+
+/// Every language in `sources`, English first, the rest by tag. A name comes
+/// only from the language's own bundle, never from the English fallback, so a
+/// translation without the message shows its tag rather than "English".
+pub fn shipped_languages(sources: &[LocaleSource]) -> Vec<ShippedLanguage> {
+    let mut languages: Vec<ShippedLanguage> = sources
+        .iter()
+        .map(|source| {
+            let bundle = build_bundle(source, source.language, None);
+            let name = bundle
+                .get_message(LANGUAGE_NAME_ID)
+                .and_then(|message| message.value())
+                .map(|pattern| {
+                    let mut errors = Vec::new();
+                    bundle
+                        .format_pattern(pattern, None, &mut errors)
+                        .into_owned()
+                })
+                .filter(|name| !name.trim().is_empty())
+                .unwrap_or_else(|| source.language.to_string());
+            ShippedLanguage {
+                tag: source.language,
+                name,
+            }
+        })
+        .collect();
+    languages.sort_by_key(|language| (language.tag != FALLBACK_LANGUAGE, language.tag));
+    languages
+}
