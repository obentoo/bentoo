diff --git a/crates/settings_ui/src/pages/ui_language_picker.rs b/crates/settings_ui/src/pages/ui_language_picker.rs
new file mode 100644
index 0000000..eccc478
--- /dev/null
+++ b/crates/settings_ui/src/pages/ui_language_picker.rs
@@ -0,0 +1,116 @@
+//! The Language page's picker for `ui_language` (zed-patches 0194): System,
+//! then every language zeo_i18n ships, each named in itself, then the
+//! pseudo-locale. Picking applies at once: zeo_i18n observes the settings
+//! store and refreshes every window.
+
+use gpui::{AnyElement, App, ReadGlobal, SharedString, Window};
+use settings::{SettingsStore, UiLanguageName};
+use ui::{ContextMenu, DropdownMenu, DropdownStyle, FluentBuilder, IconPosition, IntoElement};
+use util::ResultExt;
+use zeo_i18n::{PSEUDO_LANGUAGE, t};
+
+use crate::{SettingField, SettingsFieldMetadata, SettingsUiFile, update_settings_file};
+
+/// One entry of the picker: `None` clears the setting (follow the system).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct UiLanguageChoice {
+    pub(crate) tag: Option<String>,
+    pub(crate) label: String,
+}
+
+/// The entries in the order the menu shows them.
+pub(crate) fn ui_language_choices() -> Vec<UiLanguageChoice> {
+    let mut choices = vec![UiLanguageChoice {
+        tag: None,
+        label: t!("settings-ui-language-system"),
+    }];
+    choices.extend(
+        zeo_i18n::shipped_languages()
+            .into_iter()
+            .map(|language| UiLanguageChoice {
+                tag: Some(language.tag.to_string()),
+                label: language.name,
+            }),
+    );
+    choices.push(UiLanguageChoice {
+        tag: Some(PSEUDO_LANGUAGE.to_string()),
+        label: t!("settings-ui-language-pseudo"),
+    });
+    choices
+}
+
+/// Whether `choice` is what settings.json holds. Tags compare without case, as
+/// BCP 47 does; an empty value is the same as none.
+pub(crate) fn ui_language_matches(choice: &UiLanguageChoice, stored: Option<&str>) -> bool {
+    let stored = stored.map(str::trim).filter(|tag| !tag.is_empty());
+    match (choice.tag.as_deref(), stored) {
+        (None, None) => true,
+        (Some(tag), Some(stored)) => tag.eq_ignore_ascii_case(stored),
+        _ => false,
+    }
+}
+
+/// What the trigger shows for the stored value. A tag Zeo does not ship (typed
+/// by hand in settings.json) is shown as written, so the picker never hides
+/// what the file says.
+pub(crate) fn ui_language_label(choices: &[UiLanguageChoice], stored: Option<&str>) -> String {
+    choices
+        .iter()
+        .find(|choice| ui_language_matches(choice, stored))
+        .map(|choice| choice.label.clone())
+        .unwrap_or_else(|| stored.map(str::trim).unwrap_or_default().to_string())
+}
+
+pub(crate) fn render_ui_language_picker(
+    field: SettingField<UiLanguageName>,
+    file: SettingsUiFile,
+    _metadata: Option<&SettingsFieldMetadata>,
+    title: &'static str,
+    description: &'static str,
+    window: &mut Window,
+    cx: &mut App,
+) -> AnyElement {
+    let (_, stored) = SettingsStore::global(cx).get_value_from_file(file.to_settings(), field.pick);
+    let stored: Option<String> = stored.map(|name| name.0.clone());
+    let choices = ui_language_choices();
+    let current = ui_language_label(&choices, stored.as_deref());
+
+    let menu = ContextMenu::build(window, cx, move |mut menu, _, _| {
+        for choice in &choices {
+            let selected = ui_language_matches(choice, stored.as_deref());
+            let tag = choice.tag.clone();
+            let file = file.clone();
+            menu = menu.toggleable_entry(
+                choice.label.clone(),
+                selected,
+                IconPosition::Start,
+                None,
+                move |window, cx| {
+                    let value = tag.clone().map(UiLanguageName);
+                    update_settings_file(
+                        file.clone(),
+                        field.json_path,
+                        window,
+                        cx,
+                        move |settings, app| (field.write)(settings, value, app),
+                    )
+                    .log_err();
+                },
+            );
+        }
+        menu
+    });
+
+    DropdownMenu::new("ui-language-picker", current, menu) // i18n: not text
+        .style(DropdownStyle::Outlined)
+        .full_width(true)
+        .aria_label(SharedString::new_static(title))
+        .when(!description.is_empty(), |this| {
+            this.aria_description(SharedString::new_static(description))
+        })
+        .into_any_element()
+}
+
+#[cfg(test)]
+#[path = "ui_language_picker_tests.rs"]
+mod ui_language_picker_tests;
diff --git a/crates/settings_ui/src/pages/ui_language_picker_tests.rs b/crates/settings_ui/src/pages/ui_language_picker_tests.rs
new file mode 100644
index 0000000..2acc022
--- /dev/null
+++ b/crates/settings_ui/src/pages/ui_language_picker_tests.rs
@@ -0,0 +1,36 @@
+use super::{ui_language_choices, ui_language_label, ui_language_matches};
+
+#[test]
+fn the_picker_offers_system_then_the_shipped_languages_then_the_pseudo_locale() {
+    let choices = ui_language_choices();
+    let tags: Vec<Option<&str>> = choices.iter().map(|c| c.tag.as_deref()).collect();
+    assert_eq!(tags.first(), Some(&None));
+    assert_eq!(tags.get(1), Some(&Some("en-US")));
+    assert!(tags.contains(&Some("pt-BR")));
+    assert_eq!(tags.last(), Some(&Some(zeo_i18n::PSEUDO_LANGUAGE)));
+    // Tests never call zeo_i18n::init, so the catalog answers in English.
+    assert_eq!(choices[0].label, "System");
+}
+
+#[test]
+fn the_trigger_names_what_settings_json_holds() {
+    let choices = ui_language_choices();
+    assert_eq!(ui_language_label(&choices, None), "System");
+    assert_eq!(ui_language_label(&choices, Some("  ")), "System");
+    assert_eq!(ui_language_label(&choices, Some("PT-br")), "Português (Brasil)");
+    // A tag typed by hand that Zeo does not ship is shown as written.
+    assert_eq!(ui_language_label(&choices, Some("eo")), "eo");
+}
+
+#[test]
+fn exactly_one_entry_is_checked_for_a_shipped_value() {
+    let choices = ui_language_choices();
+    for stored in [None, Some("en-US"), Some("pt-br"), Some("en-XA")] {
+        let checked = choices
+            .iter()
+            .filter(|choice| ui_language_matches(choice, stored))
+            .count();
+        assert_eq!(checked, 1, "stored {stored:?}");
+    }
+    assert!(!choices.iter().any(|choice| ui_language_matches(choice, Some("eo"))));
+}
