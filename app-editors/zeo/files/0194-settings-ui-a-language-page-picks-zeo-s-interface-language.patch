+#[test]
+fn a_picker_lists_english_first_each_language_named_in_itself() {
+    static SOURCES: &[LocaleSource] = &[
+        LocaleSource {
+            language: "pt-BR",
+            files: &[("pt-BR/zeo.ftl", "zeo-language-name = Português (Brasil)\n")],
+        },
+        LocaleSource {
+            language: "de-DE",
+            // No name of its own: the picker shows the tag, not English's name.
+            files: &[("de-DE/zeo.ftl", "greeting = Hallo\n")],
+        },
+        LocaleSource {
+            language: "en-US",
+            files: &[("en-US/zeo.ftl", "zeo-language-name = English (United States)\n")],
+        },
+    ];
+    let languages = crate::catalog::shipped_languages(SOURCES);
+    let shown: Vec<(&str, &str)> = languages
+        .iter()
+        .map(|language| (language.tag, language.name.as_str()))
+        .collect();
+    assert_eq!(
+        shown,
+        [
+            ("en-US", "English (United States)"),
+            ("de-DE", "de-DE"),
+            ("pt-BR", "Português (Brasil)"),
+        ]
+    );
+}
+
+#[test]
+fn every_shipped_language_names_itself() {
+    let languages = crate::shipped_languages();
+    assert_eq!(
+        languages.first().map(|language| language.tag),
+        Some(FALLBACK_LANGUAGE)
+    );
+    for language in &languages {
+        assert_ne!(
+            language.name, language.tag,
+            "{}/zeo.ftl has no {}",
+            language.tag,
+            crate::LANGUAGE_NAME_ID
+        );
+    }
+}
