diff --git a/crates/agent_sandbox/src/jail_hostname.rs b/crates/agent_sandbox/src/jail_hostname.rs
new file mode 100644
index 0000000..0d60926
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_hostname.rs
@@ -0,0 +1,112 @@
+//! A host name per project for jails that hide the host (operator ask 5 of 2026-11-23). Every
+//! jail was `ai-sandbox`, so two projects looked like the same machine and both said "sandbox";
+//! the operator chose a stable name per project that looks like an ordinary machine's
+//! (`desktop-` and six letters or digits, 2026-11-24).
+//!
+//! The name is a hash of a secret kept on this machine and the project's canonical root, so it
+//! is the same on every start of the project and says nothing about its path: without the
+//! secret, nobody can tell which folder a name belongs to, or that two names are this
+//! machine's. ai-jail gives it to the UTS namespace, `/etc/hosts`, `/etc/hostname` and, under
+//! Hide the Kernel, `uname(2)` (`--hostname`, ai-jail 3.5.0-r6).
+
+use std::fs;
+use std::io::{self, Read as _, Write as _};
+use std::os::unix::fs::{OpenOptionsExt as _, PermissionsExt as _};
+use std::path::{Path, PathBuf};
+
+use sha2::{Digest as _, Sha256};
+
+/// ai-jail's option (3.5.0-r6).
+pub const HOSTNAME_OPTION: &str = "--hostname";
+
+/// What every name starts with: what an ordinary workstation is often called.
+const PREFIX: &str = "desktop-";
+/// Characters after the prefix: 36^6, about two billion names.
+const SUFFIX_LEN: usize = 6;
+const ALPHABET: &[u8; 36] = b"abcdefghijklmnopqrstuvwxyz0123456789";
+const SECRET_LEN: usize = 32;
+
+/// The secret's file, beside Zeo's other data; never inside a jail.
+pub fn secret_path() -> PathBuf {
+    paths::data_dir().join("agent_sandbox").join("hostname.key")
+}
+
+/// The name of the project at `canonical_root`, from `secret`.
+pub fn hostname_for(secret: &[u8], canonical_root: &Path) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(b"zeo-jail-hostname\0");
+    hasher.update(secret);
+    hasher.update(b"\0");
+    hasher.update(canonical_root.as_os_str().as_encoded_bytes());
+    let digest = hasher.finalize();
+    let mut name = String::from(PREFIX);
+    // A byte mod 36 leans slightly towards the first letters; for a name, that is harmless.
+    name.extend(
+        digest
+            .iter()
+            .take(SUFFIX_LEN)
+            .map(|byte| ALPHABET[usize::from(*byte) % ALPHABET.len()] as char),
+    );
+    name
+}
+
+/// The secret at `path`, made on first use: 32 bytes from the kernel's random source in an
+/// owner-only file. A file of any other size is refused rather than replaced, since replacing it
+/// would rename every project.
+pub fn load_or_create_secret(path: &Path) -> io::Result<Vec<u8>> {
+    match fs::read(path) {
+        Ok(secret) if secret.len() == SECRET_LEN => return Ok(secret),
+        Ok(other) => {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!(
+                    "{} holds {} bytes, not {SECRET_LEN}",
+                    path.display(),
+                    other.len()
+                ),
+            ));
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error),
+    }
+    let mut secret = vec![0u8; SECRET_LEN];
+    fs::File::open("/dev/urandom")?.read_exact(&mut secret)?;
+    if let Some(dir) = path.parent() {
+        fs::create_dir_all(dir)?;
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o700))?;
+    }
+    // create_new: a second Zeo that raced this one keeps the file the first wrote.
+    match fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+    {
+        Ok(mut file) => {
+            file.write_all(&secret)?;
+            file.sync_all()?;
+            log::info!("agent_sandbox event=hostname_secret_created");
+            Ok(secret)
+        }
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => load_or_create_secret(path),
+        Err(error) => Err(error),
+    }
+}
+
+/// The `--hostname` arguments for the project at `canonical_root`, or none when the secret
+/// cannot be read or made: the jail is then `ai-sandbox`, as before, and the reason is logged.
+pub fn hostname_args(secret_file: &Path, canonical_root: &Path) -> Vec<String> {
+    match load_or_create_secret(secret_file) {
+        Ok(secret) => vec![
+            HOSTNAME_OPTION.to_string(),
+            hostname_for(&secret, canonical_root),
+        ],
+        Err(error) => {
+            log::warn!(
+                "agent_sandbox event=hostname_skipped reason=secret file={} error={error}",
+                secret_file.display()
+            );
+            Vec::new()
+        }
+    }
+}
diff --git a/crates/agent_sandbox/src/jail_hostname_tests.rs b/crates/agent_sandbox/src/jail_hostname_tests.rs
new file mode 100644
index 0000000..eea4788
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_hostname_tests.rs
@@ -0,0 +1,179 @@
+// Operator ask 5 of 2026-11-23: a stable host name per project, an ordinary machine's, that
+// says nothing about the project's path. Filter: `jail_hostname`.
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::Path;
+
+use crate::jail_hostname::{hostname_args, hostname_for, load_or_create_secret};
+
+const SECRET: [u8; 32] = [7; 32];
+
+#[test]
+fn jail_hostname_is_an_ordinary_machine_name_and_one_dns_label() {
+    let name = hostname_for(&SECRET, Path::new("/home/u/work/app"));
+    assert!(name.starts_with("desktop-"), "{name}");
+    assert_eq!(name.len(), "desktop-".len() + 6, "{name}");
+    assert!(
+        name.bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-'),
+        "what ai-jail's --hostname accepts: {name}"
+    );
+}
+
+#[test]
+fn jail_hostname_is_stable_per_project_and_differs_across_them() {
+    let app = Path::new("/home/u/work/app");
+    assert_eq!(hostname_for(&SECRET, app), hostname_for(&SECRET, app));
+    assert_ne!(
+        hostname_for(&SECRET, app),
+        hostname_for(&SECRET, Path::new("/home/u/work/other")),
+        "two projects look like two machines"
+    );
+    assert_ne!(
+        hostname_for(&SECRET, app),
+        hostname_for(&[8; 32], app),
+        "another machine's secret gives another name"
+    );
+}
+
+#[test]
+fn jail_hostname_secret_is_made_once_owner_only_and_kept() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let path = dir.path().join("agent_sandbox").join("hostname.key");
+    let first = load_or_create_secret(&path).expect("made");
+    assert_eq!(first.len(), 32);
+    let mode = std::fs::metadata(&path).expect("file").permissions().mode();
+    assert_eq!(mode & 0o777, 0o600);
+    let dir_mode = std::fs::metadata(path.parent().expect("dir"))
+        .expect("dir")
+        .permissions()
+        .mode();
+    assert_eq!(dir_mode & 0o777, 0o700);
+    assert_eq!(load_or_create_secret(&path).expect("read"), first, "kept");
+}
+
+#[test]
+fn jail_hostname_refuses_a_damaged_secret_and_skips_the_option() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let path = dir.path().join("hostname.key");
+    std::fs::write(&path, b"short").expect("write");
+    assert!(load_or_create_secret(&path).is_err(), "never replaced");
+    assert_eq!(std::fs::read(&path).expect("read"), b"short");
+    assert!(
+        hostname_args(&path, Path::new("/w/app")).is_empty(),
+        "the jail stays ai-sandbox"
+    );
+}
+
+#[test]
+fn jail_hostname_args_name_the_option_and_the_name() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let path = dir.path().join("hostname.key");
+    let args = hostname_args(&path, Path::new("/w/app"));
+    assert_eq!(args.len(), 2);
+    assert_eq!(args[0], "--hostname");
+    let secret = std::fs::read(&path).expect("made");
+    assert_eq!(args[1], hostname_for(&secret, Path::new("/w/app")));
+}
+
+mod launch {
+    use std::collections::HashSet;
+
+    use gpui::TestAppContext;
+    use project::agent_registry_store::ZEO_PLUS_AGENT_ID;
+    use project::agent_server_store::AgentId;
+    use serde_json::{Value, json};
+
+    use crate::launch::{LaunchDecision, LaunchEnv, decide_in};
+    use crate::launch_tests::*;
+
+    /// ai-jail 3.5.0-r5's options; `hostname` adds `--hostname`, as 3.5.0-r6 does.
+    fn help(hostname: bool) -> String {
+        let extra = if hostname {
+            "    --hostname <NAME>  Host name\\n"
+        } else {
+            ""
+        };
+        format!(
+            "case \"$1\" in --help) printf '    --memory <SIZE>  Cap memory\\n    --state-root <DIR>  State on disk\\n    --cpus <LIST>  Pin CPUs\\n    --mask-host  Synthetic host view\\n    --overlay-system  Overlays\\n    --syscall-view  Syscalls\\n    --minimal-etc  Allowlisted /etc\\n{extra}' ;; *) echo 'ai-jail 3.5.0' ;; esac"
+        )
+    }
+
+    fn settings(f: &Fixture, project: Value) -> Value {
+        let mut value = sandbox(f, true, project, memory_off());
+        value["agent_sandbox"]["state_root"] = json!(f.base.join("state"));
+        value
+    }
+
+    /// The decision with the secret kept in the fixture, never in Zeo's own data folder.
+    async fn decide_here(
+        f: &Fixture,
+        project: &gpui::Entity<project::Project>,
+        cx: &mut TestAppContext,
+    ) -> LaunchDecision {
+        let env = LaunchEnv {
+            home: f.base.join("zeo-home"),
+            config_dir: f.base.join("zeo-home/.config/zeo"),
+            runtime_dir: None,
+            hostname_secret: f.base.join("zeo-home/hostname.key"),
+        };
+        let mut async_cx = cx.to_async();
+        decide_in(
+            AgentId::new(ZEO_PLUS_AGENT_ID),
+            project,
+            agent_cmd("/usr/bin/claude-agent-acp-plus"),
+            &HashSet::new(),
+            env,
+            &mut async_cx,
+        )
+        .await
+    }
+
+    /// The value after `--hostname` among the jailed command's own options.
+    fn hostname_arg(args: &[String]) -> Option<String> {
+        let end = args.iter().position(|a| a == "--").unwrap_or(args.len());
+        let at = args[..end].iter().position(|a| a == "--hostname")?;
+        args.get(at + 1).cloned()
+    }
+
+    #[gpui::test]
+    async fn jail_hostname_names_a_jail_that_hides_the_host(cx: &mut TestAppContext) {
+        init(cx);
+        let f = fixture("ai-jail 3.5.0");
+        write_script(&f.ai_jail, &help(true));
+        set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+        let project = project(&f, cx).await;
+        let (_, first) = jailed(decide_here(&f, &project, cx).await);
+        let name = hostname_arg(&first.args).expect("named");
+        assert!(name.starts_with("desktop-"), "{name}");
+        let (_, again) = jailed(decide_here(&f, &project, cx).await);
+        assert_eq!(hostname_arg(&again.args), Some(name), "stable");
+    }
+
+    #[gpui::test]
+    async fn jail_hostname_only_with_the_host_hidden_and_the_option(cx: &mut TestAppContext) {
+        init(cx);
+        let f = fixture("ai-jail 3.5.0");
+        write_script(&f.ai_jail, &help(false));
+        set_user_settings(settings(&f, json!({ "mask_host": true })), cx);
+        let project = project(&f, cx).await;
+        let (_, cmd) = jailed(decide_here(&f, &project, cx).await);
+        assert_eq!(
+            hostname_arg(&cmd.args),
+            None,
+            "an older ai-jail starts, as ai-sandbox"
+        );
+
+        write_script(&f.ai_jail, &help(true));
+        set_user_settings(settings(&f, json!({ "mask_host": false })), cx);
+        let (_, cmd) = jailed(decide_here(&f, &project, cx).await);
+        assert_eq!(
+            hostname_arg(&cmd.args),
+            None,
+            "the host shown, nothing to hide"
+        );
+        assert!(
+            !f.base.join("zeo-home/hostname.key").exists(),
+            "no secret made for a jail that does not use one"
+        );
+    }
+}
