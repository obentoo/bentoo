+// Zeo next proposal §6.5 (ask 12), as the operator corrected it in Zeo 0.10.1: pinning is to the
+// project by default; the active project's pins have a Pinned section of their own, above the
+// global one; the other scope is one menu entry away. Filter:
+// `sidebar_pinned_tests::project_pins`.
+
+use super::*;
+use pretty_assertions::assert_eq;
+
+/// The index of each Pinned header with whether it is the project's, top to bottom.
+fn pinned_headers(sidebar: &Entity<Sidebar>, cx: &mut VisualTestContext) -> Vec<(usize, bool)> {
+    sidebar.read_with(cx, |sidebar, _| {
+        sidebar
+            .contents
+            .entries
+            .iter()
+            .enumerate()
+            .filter_map(|(ix, entry)| match entry {
+                ListEntry::PinnedHeader { project, .. } => Some((ix, *project)),
+                _ => None,
+            })
+            .collect()
+    })
+}
+
+fn is_project_pin(thread_id: ThreadId, cx: &mut VisualTestContext) -> bool {
+    cx.update(|_, cx| !crate::project_pins::is_global_pin(thread_id, cx))
+}
+
+#[gpui::test]
+async fn the_default_pin_is_the_projects_and_its_section_sits_above_the_global_one(
+    cx: &mut TestAppContext,
+) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let old = save_in("s1", "Oldest", ALPHA, 1, cx);
+    let mid = save_in("s2", "Middle", ALPHA, 2, cx);
+    let new = save_in("s3", "Newest", ALPHA, 3, cx);
+    cx.run_until_parked();
+
+    // What the row button, the keyboard action and "Pin Thread" all run.
+    sidebar.update(cx, |sidebar, cx| sidebar.toggle_project_pin(old, cx));
+    cx.run_until_parked();
+    assert!(is_project_pin(old, cx), "the default pin is a project pin");
+    assert_eq!(stored_pins(cx), vec![old], "it is a pin like any other");
+    let headers = pinned_headers(&sidebar, cx);
+    assert_eq!(headers.len(), 1, "one section: the project's");
+    assert!(headers[0].1);
+    assert_eq!(rows_of(&sidebar, old, cx), 1, "listed once, in the section");
+    assert!(pinned_row_ix(&sidebar, old, cx) > headers[0].0);
+    assert!(
+        group_row_ix(&sidebar, new, cx) < headers[0].0,
+        "the section follows the project's threads"
+    );
+
+    // A global pin gets the section under it.
+    sidebar.update(cx, |sidebar, cx| sidebar.pin_globally(mid, cx));
+    cx.run_until_parked();
+    let headers = pinned_headers(&sidebar, cx);
+    assert_eq!(
+        headers
+            .iter()
+            .map(|(_, project)| *project)
+            .collect::<Vec<_>>(),
+        vec![true, false],
+        "the project's section first, then the global one"
+    );
+    let (project_header, global_header) = (headers[0].0, headers[1].0);
+    let old_ix = pinned_row_ix(&sidebar, old, cx);
+    let mid_ix = pinned_row_ix(&sidebar, mid, cx);
+    assert!(project_header < old_ix && old_ix < global_header);
+    assert!(global_header < mid_ix);
+}
