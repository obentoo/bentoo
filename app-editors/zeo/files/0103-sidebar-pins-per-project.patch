diff --git a/crates/sidebar/src/project_pins.rs b/crates/sidebar/src/project_pins.rs
new file mode 100644
index 0000000..92c7285
--- /dev/null
+++ b/crates/sidebar/src/project_pins.rs
@@ -0,0 +1,81 @@
+//! Project pins (Zeo next proposal §6.5, ask 12): a thread pinned to its project is listed in
+//! a Pinned section of that project, shown while the project is the active one, above the
+//! global Pinned section.
+//!
+//! The pin and its order are `0048`'s; the scope is `ThreadPinScopeStore`'s. A project pin of
+//! the active project is left out of its group and of the global section
+//! (`pinned_section::pinned_thread_ids`) and listed by [`active_project_pin_ids`]. A project pin
+//! of any other project stays an ordinary row of its group until that project is the active one.
+
+use agent_ui::ThreadId;
+use agent_ui::thread_metadata_store::ThreadMetadataStore;
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use agent_ui::thread_organization::pin_scope::ThreadPinScopeStore;
+use gpui::App;
+use workspace::ProjectGroupKey;
+
+/// The project pins, in pin order: pinned in the organization and scoped to their project.
+pub(crate) fn project_pin_order(cx: &App) -> Vec<ThreadId> {
+    let Some(scope) = ThreadPinScopeStore::try_global(cx) else {
+        return Vec::new();
+    };
+    let scope = scope.read(cx);
+    ThreadOrganizationStore::try_global(cx)
+        .map(|store| {
+            store
+                .read(cx)
+                .pinned()
+                .filter(|thread_id| scope.is_project_pin(*thread_id))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Whether a pinned thread belongs in the global Pinned section: every pin but a project one.
+pub(crate) fn is_global_pin(thread_id: ThreadId, cx: &App) -> bool {
+    ThreadPinScopeStore::try_global(cx)
+        .is_none_or(|scope| !scope.read(cx).is_project_pin(thread_id))
+}
+
+/// The project pins of the active project, in pin order. The project of a thread is derived
+/// from the thread alone, as the global section's label is.
+pub(crate) fn active_project_pin_ids(active: Option<&ProjectGroupKey>, cx: &App) -> Vec<ThreadId> {
+    let order = project_pin_order(cx);
+    if order.is_empty() {
+        return order;
+    }
+    let store = ThreadMetadataStore::global(cx).read(cx);
+    pins_of(
+        &order,
+        |thread_id| {
+            store.entry(thread_id).map(|metadata| {
+                ProjectGroupKey::from_worktree_paths(
+                    &metadata.worktree_paths,
+                    metadata.remote_connection.clone(),
+                )
+            })
+        },
+        active,
+    )
+}
+
+/// The ids of `order` whose project is `active`, in `order`'s order. None without an active
+/// project, and a thread whose project is unknown belongs to none.
+pub(crate) fn pins_of<K: PartialEq>(
+    order: &[ThreadId],
+    project_of: impl Fn(ThreadId) -> Option<K>,
+    active: Option<&K>,
+) -> Vec<ThreadId> {
+    let Some(active) = active else {
+        return Vec::new();
+    };
+    order
+        .iter()
+        .copied()
+        .filter(|thread_id| project_of(*thread_id).as_ref() == Some(active))
+        .collect()
+}
+
+#[cfg(test)]
+#[path = "project_pins_tests.rs"]
+mod tests;
diff --git a/crates/sidebar/src/project_pins_tests.rs b/crates/sidebar/src/project_pins_tests.rs
new file mode 100644
index 0000000..70b54af
--- /dev/null
+++ b/crates/sidebar/src/project_pins_tests.rs
@@ -0,0 +1,35 @@
+// Zeo next proposal §6.5: which project pins the active project's section lists.
+// Filter: `project_pins::tests`.
+
+use agent_ui::ThreadId;
+
+use super::pins_of;
+
+fn ids(n: usize) -> Vec<ThreadId> {
+    (0..n).map(|_| ThreadId::new()).collect()
+}
+
+#[test]
+fn only_the_active_projects_pins_are_listed_in_pin_order() {
+    let order = ids(4);
+    let project_of = |id: ThreadId| {
+        let ix = order.iter().position(|other| *other == id)?;
+        Some(if ix % 2 == 0 { "alpha" } else { "beta" })
+    };
+    assert_eq!(
+        pins_of(&order, project_of, Some(&"alpha")),
+        vec![order[0], order[2]]
+    );
+    assert_eq!(
+        pins_of(&order, project_of, Some(&"beta")),
+        vec![order[1], order[3]]
+    );
+}
+
+/// Hostile: with no active project, or a thread whose project is unknown, nothing is listed.
+#[test]
+fn no_active_project_and_unknown_threads_list_nothing() {
+    let order = ids(2);
+    assert!(pins_of(&order, |_| Some("alpha"), None).is_empty());
+    assert!(pins_of(&order, |_| None::<&str>, Some(&"alpha")).is_empty());
+}
