     }
 
+    /// Pins `thread_id` to its project (Zeo next §6.5): pinned as any thread, and scoped so it
+    /// heads its project's group rather than the Pinned section.
+    fn pin_to_project(&mut self, thread_id: ThreadId, cx: &mut Context<Self>) {
+        let Some(store) = ThreadOrganizationStore::try_global(cx) else {
+            return;
+        };
+        if let Err(error) = store.update(cx, |store, cx| store.pin(thread_id, cx)) {
+            log::warn!("sidebar: project pin refused for thread {thread_id:?}: {error}");
+            return;
+        }
+        Self::set_pin_scope(thread_id, true, cx);
+    }
+
+    fn set_pin_scope(thread_id: ThreadId, project: bool, cx: &mut App) {
+        let Some(scope) =
+            agent_ui::thread_organization::pin_scope::ThreadPinScopeStore::try_global(cx)
+        else {
+            return;
+        };
+        if let Err(error) = scope.update(cx, |scope, cx| {
+            scope.set_project_pin(thread_id, project, cx)
+        }) {
+            log::warn!("sidebar: pin scope refused for thread {thread_id:?}: {error}");
+        }
