+// Zeo next proposal §6.5 (ask 12): "Pin to Project" heads the project's group and stays out of
+// the Pinned section, which keeps the global pins; unpinning clears the scope. Filter:
+// `sidebar_pinned_tests::project_pins`.
+
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[gpui::test]
+async fn a_project_pin_heads_its_group_and_skips_the_pinned_section(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let old = save_in("s1", "Oldest", ALPHA, 1, cx);
+    let mid = save_in("s2", "Middle", ALPHA, 2, cx);
+    let new = save_in("s3", "Newest", ALPHA, 3, cx);
+    cx.run_until_parked();
+    assert!(
+        group_row_ix(&sidebar, new, cx) < group_row_ix(&sidebar, old, cx),
+        "by time first"
+    );
+
+    sidebar.update(cx, |sidebar, cx| sidebar.pin_to_project(old, cx));
+    cx.run_until_parked();
+    assert_eq!(
+        pinned_header_ix(&sidebar, cx),
+        None,
+        "no Pinned section for a project pin"
+    );
+    assert_eq!(rows_of(&sidebar, old, cx), 1, "listed once, in its group");
+    assert!(
+        group_row_ix(&sidebar, old, cx) < group_row_ix(&sidebar, new, cx),
+        "the project pin heads its group"
+    );
+    assert_eq!(stored_pins(cx), vec![old], "it is a pin like any other");
+
+    // A global pin still goes to the Pinned section, beside the project pin in its group.
+    toggle_pin(&sidebar, mid, cx);
+    assert!(pinned_header_ix(&sidebar, cx).is_some());
+    let _ = pinned_row_ix(&sidebar, mid, cx);
+    assert!(group_row_ix(&sidebar, old, cx) < group_row_ix(&sidebar, new, cx));
+}
+
+/// Hostile: unpinning a project pin clears its scope, so a later plain pin is global.
+#[gpui::test]
+async fn unpinning_clears_the_scope(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let old = save_in("s1", "Oldest", ALPHA, 1, cx);
+    let new = save_in("s3", "Newest", ALPHA, 3, cx);
+    cx.run_until_parked();
+
+    sidebar.update(cx, |sidebar, cx| sidebar.pin_to_project(old, cx));
+    cx.run_until_parked();
+    toggle_pin(&sidebar, old, cx);
+    assert!(stored_pins(cx).is_empty(), "unpinned");
+    assert!(
+        group_row_ix(&sidebar, new, cx) < group_row_ix(&sidebar, old, cx),
+        "back in time order"
+    );
+
+    toggle_pin(&sidebar, old, cx);
+    assert!(
+        pinned_header_ix(&sidebar, cx).is_some(),
+        "a plain pin is global again"
+    );
+    let _ = pinned_row_ix(&sidebar, old, cx);
+}
