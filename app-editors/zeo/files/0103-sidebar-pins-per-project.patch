@@ -0,0 +1,120 @@
+// Zeo next proposal §6.5 (ask 12): a pin's scope, global or its project. Filter:
+// `thread_organization::pin_scope::tests`.
+
+use db::sqlez::connection::Connection;
+use gpui::{Entity, TestAppContext};
+
+use super::super::ThreadOrganizationDb;
+use super::super::test_helpers::{PROJECT_A, delete_thread, draft_in, init, thread};
+use super::*;
+
+async fn open_db(name: &'static str) -> ThreadPinScopeDb {
+    ThreadPinScopeDb::open_test_db(name).await
+}
+
+fn open_store(db: &ThreadPinScopeDb, cx: &mut TestAppContext) -> Entity<ThreadPinScopeStore> {
+    let db = db.clone();
+    let store = cx.new(|cx| ThreadPinScopeStore::with_fallback_flag(db, false, cx));
+    cx.run_until_parked();
+    store
+}
+
+fn set(
+    store: &Entity<ThreadPinScopeStore>,
+    thread_id: ThreadId,
+    project: bool,
+    cx: &mut TestAppContext,
+) -> Result<(), OrganizeError> {
+    let result = store.update(cx, |store, cx| {
+        store.set_project_pin(thread_id, project, cx)
+    });
+    cx.run_until_parked();
+    result
+}
+
+fn is_project(store: &Entity<ThreadPinScopeStore>, id: ThreadId, cx: &TestAppContext) -> bool {
+    store.read_with(cx, |store, _| store.is_project_pin(id))
+}
+
+fn reopen(
+    store: Entity<ThreadPinScopeStore>,
+    db: &ThreadPinScopeDb,
+    cx: &mut TestAppContext,
+) -> Entity<ThreadPinScopeStore> {
+    cx.run_until_parked();
+    drop(store);
+    open_store(db, cx)
+}
+
+/// Hostile: the scope must not share 0048's migration list, whose steps land at different
+/// indexes with and without the `devtools-panel` USE flag (0063).
+#[test]
+fn the_pin_scope_has_a_migration_list_of_its_own() {
+    assert_ne!(ThreadPinScopeDb::NAME, ThreadOrganizationDb::NAME);
+    assert!(
+        ThreadOrganizationDb::MIGRATIONS
+            .iter()
+            .all(|step| !step.contains("pin_scope")),
+        "no step of thread_organization mentions it"
+    );
+    let connection = Connection::open_memory(Some("thread_pin_scope_migration"));
+    connection
+        .migrate(
+            ThreadPinScopeDb::NAME,
+            ThreadPinScopeDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the pin scope migration applies");
+}
+
+#[gpui::test]
+async fn a_project_pin_survives_a_restart_and_global_clears_it(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_restart").await;
+    let store = open_store(&db, cx);
+    let thread_id = thread(cx);
+    assert!(!is_project(&store, thread_id, cx), "global by default");
+
+    set(&store, thread_id, true, cx).expect("a saved thread");
+    let store = reopen(store, &db, cx);
+    assert!(is_project(&store, thread_id, cx));
+
+    set(&store, thread_id, false, cx).expect("back to global");
+    let store = reopen(store, &db, cx);
+    assert!(!is_project(&store, thread_id, cx), "cleared on disk");
+}
+
+/// Hostile: a draft is refused, as the organization refuses it.
+#[gpui::test]
+async fn a_draft_has_no_pin_scope(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_draft").await;
+    let store = open_store(&db, cx);
+    let draft = draft_in(PROJECT_A, cx);
+    assert!(matches!(
+        set(&store, draft, true, cx),
+        Err(OrganizeError::Draft { .. })
+    ));
+    assert!(!is_project(&store, draft, cx));
+}
+
+/// A deleted thread's scope goes with it, through thread_organization::forget.
+#[gpui::test]
+async fn a_deleted_threads_pin_scope_is_forgotten(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_forget").await;
+    let store = open_store(&db, cx);
+    cx.update(|cx| cx.set_global(GlobalThreadPinScopeStore(store.clone())));
+    let thread_id = thread(cx);
+    set(&store, thread_id, true, cx).expect("a saved thread");
+    assert!(
+        is_project(&store, thread_id, cx),
+        "precondition: there is something to forget"
+    );
+    delete_thread(thread_id, cx);
+    assert!(!is_project(&store, thread_id, cx));
+    drop(store);
+    cx.update(|cx| cx.remove_global::<GlobalThreadPinScopeStore>());
+    let store = open_store(&db, cx);
+    assert!(!is_project(&store, thread_id, cx), "and from disk");
+}
