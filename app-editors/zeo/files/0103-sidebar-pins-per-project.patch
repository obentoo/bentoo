@@ -1198,11 +1208,42 @@ impl Sidebar {
                 store.pin(thread_id, cx)
             }
         });
+        // Pinning here is global, and an unpin leaves no scope behind (Zeo next §6.5). Only after
+        // the store accepted the toggle: a refused one changes nothing and warns once.
+        if result.is_ok() {
