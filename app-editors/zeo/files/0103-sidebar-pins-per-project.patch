+/// The menu names the default and offers the other scope: "Pin Globally" beside "Pin Thread",
+/// and on a project pin; "Pin to Project" on a global one.
+#[gpui::test]
+async fn the_menu_offers_the_other_scope(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    save_in("a1", "Fix login", ALPHA, 2, cx);
+    let target = save_in("a2", "Write docs", ALPHA, 1, cx);
+    cx.run_until_parked();
+
+    let ix = group_row_ix(&sidebar, target, cx);
+    right_click(entry_bounds(&sidebar, ix, cx).center(), cx);
+    cx.debug_bounds("MENU_ITEM-Pin Thread")
+        .expect("an unpinned thread is offered Pin Thread");
+    assert!(cx.debug_bounds("MENU_ITEM-Pin to Project").is_none());
+    let global = cx
+        .debug_bounds("MENU_ITEM-Pin Globally")
+        .expect("an unpinned thread is offered Pin Globally");
+    cx.simulate_click(global.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert_eq!(stored_pins(cx), vec![target]);
+    assert!(!is_project_pin(target, cx));
+
+    let ix = pinned_row_ix(&sidebar, target, cx);
+    right_click(entry_bounds(&sidebar, ix, cx).center(), cx);
+    cx.debug_bounds("MENU_ITEM-Unpin Thread")
+        .expect("a pinned thread is offered Unpin Thread");
+    assert!(cx.debug_bounds("MENU_ITEM-Pin Globally").is_none());
+    let to_project = cx
+        .debug_bounds("MENU_ITEM-Pin to Project")
+        .expect("a global pin is offered Pin to Project");
+    cx.simulate_click(to_project.center(), Modifiers::none());
+    cx.run_until_parked();
+    assert!(is_project_pin(target, cx));
+    assert_eq!(stored_pins(cx), vec![target], "still one pin");
+}
