+/// Hostile: a project pin of a project that is not the active one is in no Pinned section; it
+/// stays a row of its own group, and moves to the section once its project is active.
+#[gpui::test]
+async fn a_project_pin_shows_its_section_only_while_its_project_is_active(cx: &mut TestAppContext) {
+    let (fs, multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let alpha = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+    let in_alpha = save_in("a1", "Fix login", ALPHA, 1, cx);
+    let beta = open_in_window(BETA, &fs, &multi_workspace, cx).await;
+    let in_beta = save_in("b1", "Ship release", BETA, 1, cx);
+    cx.run_until_parked();
+
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.pin_to_project(in_alpha, cx);
+        sidebar.pin_to_project(in_beta, cx);
+    });
+    cx.run_until_parked();
+
+    // Opening BETA made it the active project.
+    assert_eq!(pinned_headers(&sidebar, cx).len(), 1);
+    let _ = pinned_row_ix(&sidebar, in_beta, cx);
+    let _ = group_row_ix(&sidebar, in_alpha, cx);
+    assert_eq!(rows_of(&sidebar, in_alpha, cx), 1);
+    assert_eq!(rows_of(&sidebar, in_beta, cx), 1);
+
+    multi_workspace.update_in(cx, |mw, window, cx| {
+        mw.activate(alpha.clone(), None, window, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(pinned_headers(&sidebar, cx).len(), 1);
+    let _ = pinned_row_ix(&sidebar, in_alpha, cx);
+    let _ = group_row_ix(&sidebar, in_beta, cx);
+    drop(beta);
+}
