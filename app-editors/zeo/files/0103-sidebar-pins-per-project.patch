+/// The two sections collapse on their own, each under its own key.
+#[gpui::test]
+async fn each_pinned_section_collapses_on_its_own(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let mine = save_in("s1", "Mine", ALPHA, 1, cx);
+    let everywhere = save_in("s2", "Everywhere", ALPHA, 2, cx);
+    cx.run_until_parked();
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.pin_to_project(mine, cx);
+        sidebar.pin_globally(everywhere, cx);
+    });
+    cx.run_until_parked();
+
+    sidebar.update(cx, |sidebar, cx| {
+        sidebar.set_pinned_section_collapsed(true, true, cx)
+    });
+    cx.run_until_parked();
+    assert_eq!(rows_of(&sidebar, mine, cx), 0, "the project's rows fold");
+    assert_eq!(rows_of(&sidebar, everywhere, cx), 1, "the global ones stay");
+    assert_eq!(pinned_headers(&sidebar, cx).len(), 2, "both headers stay");
+    assert!(sidebar.read_with(cx, |sidebar, _| !sidebar.pinned_collapsed));
+}
+
+/// Hostile: unpinning a project pin clears its scope, so a later global pin is global, and a
+/// pinned thread changes scope in place without a second pin.
+#[gpui::test]
+async fn unpinning_clears_the_scope(cx: &mut TestAppContext) {
+    let (_fs, _multi_workspace, sidebar, cx) = alpha_window(cx).await;
+    let old = save_in("s1", "Oldest", ALPHA, 1, cx);
+    let new = save_in("s3", "Newest", ALPHA, 3, cx);
+    cx.run_until_parked();
+
+    sidebar.update(cx, |sidebar, cx| sidebar.pin_to_project(old, cx));
+    cx.run_until_parked();
+    sidebar.update(cx, |sidebar, cx| sidebar.toggle_project_pin(old, cx));
+    cx.run_until_parked();
+    assert!(stored_pins(cx).is_empty(), "unpinned");
+    assert!(!is_project_pin(old, cx), "no scope left behind");
+    assert!(
+        group_row_ix(&sidebar, new, cx) < group_row_ix(&sidebar, old, cx),
+        "back in time order"
+    );
+
+    toggle_pin(&sidebar, old, cx);
+    assert_eq!(
+        pinned_headers(&sidebar, cx)
+            .iter()
+            .map(|(_, project)| *project)
+            .collect::<Vec<_>>(),
+        vec![false],
+        "the global toggle pins globally"
+    );
+
+    sidebar.update(cx, |sidebar, cx| sidebar.pin_to_project(old, cx));
+    cx.run_until_parked();
+    assert_eq!(stored_pins(cx), vec![old], "still one pin");
+    assert_eq!(
+        pinned_headers(&sidebar, cx)
+            .iter()
+            .map(|(_, project)| *project)
+            .collect::<Vec<_>>(),
+        vec![true],
+        "moved to the project's section"
+    );
+}
