diff --git a/crates/sidebar/src/project_pins.rs b/crates/sidebar/src/project_pins.rs
new file mode 100644
index 0000000..8bee2df
--- /dev/null
+++ b/crates/sidebar/src/project_pins.rs
@@ -0,0 +1,77 @@
+//! Project pins (Zeo next proposal §6.5, ask 12): a thread pinned to its project heads that
+//! project's group instead of joining the Pinned section, which keeps the global pins.
+//!
+//! The pin and its order are `0048`'s; the scope is `ThreadPinScopeStore`'s. A project pin is
+//! left out of the Pinned section (`pinned_section::pinned_thread_ids`), so its group lists it
+//! like any thread, and [`hoist_project_pins`] then moves it to the top, after the group's own
+//! sort and manual order, which would otherwise undo it.
+
+use agent_ui::ThreadId;
+use agent_ui::thread_organization::ThreadOrganizationStore;
+use agent_ui::thread_organization::pin_scope::ThreadPinScopeStore;
+use gpui::App;
+
+use crate::ListEntry;
+
+/// The project pins, in pin order: pinned in the organization and scoped to their project.
+pub(crate) fn project_pin_order(cx: &App) -> Vec<ThreadId> {
+    let Some(scope) = ThreadPinScopeStore::try_global(cx) else {
+        return Vec::new();
+    };
+    let scope = scope.read(cx);
+    ThreadOrganizationStore::try_global(cx)
+        .map(|store| {
+            store
+                .read(cx)
+                .pinned()
+                .filter(|thread_id| scope.is_project_pin(*thread_id))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Whether a pinned thread belongs in the Pinned section: every pin but a project one.
+pub(crate) fn is_global_pin(thread_id: ThreadId, cx: &App) -> bool {
+    ThreadPinScopeStore::try_global(cx)
+        .is_none_or(|scope| !scope.read(cx).is_project_pin(thread_id))
+}
+
+/// Moves a group's project pins to its top, in pin order; every other row keeps its place
+/// relative to the rest.
+pub(crate) fn hoist_project_pins(rows: &mut Vec<ListEntry>, cx: &App) {
+    let order = project_pin_order(cx);
+    hoist_by(
+        rows,
+        |entry| match entry {
+            ListEntry::Thread(thread) => Some(thread.metadata.thread_id),
+            _ => None,
+        },
+        &order,
+    );
+}
+
+/// The rows whose key is in `order` first, in `order`'s order, then the rest as they were.
+pub(crate) fn hoist_by<T>(
+    rows: &mut Vec<T>,
+    key: impl Fn(&T) -> Option<ThreadId>,
+    order: &[ThreadId],
+) {
+    if order.is_empty() {
+        return;
+    }
+    let mut hoisted: Vec<(usize, T)> = Vec::new();
+    let mut rest: Vec<T> = Vec::new();
+    for row in rows.drain(..) {
+        match key(&row).and_then(|id| order.iter().position(|pinned| *pinned == id)) {
+            Some(rank) => hoisted.push((rank, row)),
+            None => rest.push(row),
+        }
+    }
+    hoisted.sort_by_key(|(rank, _)| *rank);
+    rows.extend(hoisted.into_iter().map(|(_, row)| row));
+    rows.extend(rest);
+}
+
+#[cfg(test)]
+#[path = "project_pins_tests.rs"]
+mod tests;
diff --git a/crates/sidebar/src/project_pins_tests.rs b/crates/sidebar/src/project_pins_tests.rs
new file mode 100644
index 0000000..fc8397b
--- /dev/null
+++ b/crates/sidebar/src/project_pins_tests.rs
@@ -0,0 +1,33 @@
+// Zeo next proposal §6.5: the order a group's rows take once its project pins are hoisted.
+// Filter: `project_pins::tests`.
+
+use agent_ui::ThreadId;
+
+use super::hoist_by;
+
+fn ids(n: usize) -> Vec<ThreadId> {
+    (0..n).map(|_| ThreadId::new()).collect()
+}
+
+#[test]
+fn project_pins_go_first_in_pin_order_and_the_rest_keep_theirs() {
+    let t = ids(5);
+    let mut rows = t.clone();
+    hoist_by(&mut rows, |id| Some(*id), &[t[3], t[1]]);
+    assert_eq!(rows, vec![t[3], t[1], t[0], t[2], t[4]]);
+}
+
+/// Hostile: a pin of another project (absent from this group) and rows with no thread change
+/// nothing; no pins is the identity.
+#[test]
+fn absent_pins_and_threadless_rows_are_left_alone() {
+    let t = ids(3);
+    let other = ThreadId::new();
+    let mut rows: Vec<Option<ThreadId>> = vec![Some(t[0]), None, Some(t[1]), Some(t[2])];
+    hoist_by(&mut rows, |row| *row, &[other, t[2]]);
+    assert_eq!(rows, vec![Some(t[2]), Some(t[0]), None, Some(t[1])]);
+
+    let mut unchanged = t.clone();
+    hoist_by(&mut unchanged, |id| Some(*id), &[]);
+    assert_eq!(unchanged, t);
+}
