diff --git a/crates/agent_ui/src/thread_organization/pin_scope.rs b/crates/agent_ui/src/thread_organization/pin_scope.rs
new file mode 100644
index 0000000..0e1a835
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/pin_scope.rs
@@ -0,0 +1,193 @@
+//! Zeo next proposal §6.5 (ask 12): a pin is global or belongs to its thread's project. A
+//! project pin heads that project's group in the threads sidebar; the Pinned section keeps the
+//! global ones.
+//!
+//! The pin itself -- whether a thread is pinned, and the order of pins -- stays where `0048`
+//! keeps it. Only the scope lives here, in a domain of its own for the reason `description`
+//! gives: `0048`'s migration list is appended to by `0063` under a USE flag, so a step appended
+//! by an earlier patch would sit at a different index with and without the flag. A row in
+//! `thread_pin_scope` means "pinned to its project"; no row means global. The project is the
+//! thread's own, read from its metadata when the sidebar groups it, so it is not stored twice.
+//!
+//! Like the organization, the scope belongs to a saved thread (`admit`), and a deleted thread's
+//! goes with it (`forget`).
+
+use std::collections::HashSet;
+use std::sync::atomic::Ordering;
+
+use anyhow::{Context as _, Result};
+use db::{
+    sqlez::{domain::Domain, thread_safe_connection::ThreadSafeConnection},
+    sqlez_macros::sql,
+};
+use futures::{StreamExt as _, channel::mpsc};
+use gpui::{App, AppContext as _, Context, Entity, Global, Task};
+
+use super::{OrganizeError, admit};
+use crate::thread_metadata_store::ThreadId;
+
+pub(crate) struct ThreadPinScopeDb(ThreadSafeConnection);
+
+static PIN_SCOPE_MIGRATIONS: [&str; 1] = ["CREATE TABLE thread_pin_scope(
+    thread_id BLOB PRIMARY KEY NOT NULL
+) STRICT;"];
+
+impl Domain for ThreadPinScopeDb {
+    const NAME: &str = stringify!(ThreadPinScopeDb);
+    const MIGRATIONS: &[&str] = &PIN_SCOPE_MIGRATIONS;
+}
+
+db::static_connection!(ThreadPinScopeDb, []);
+
+struct GlobalThreadPinScopeStore(Entity<ThreadPinScopeStore>);
+
+impl Global for GlobalThreadPinScopeStore {}
+
+pub fn init(cx: &mut App) {
+    let db = ThreadPinScopeDb::global(cx);
+    let store = cx.new(|cx| ThreadPinScopeStore::new(db, cx));
+    cx.set_global(GlobalThreadPinScopeStore(store));
+}
+
+/// Called with `thread_organization::forget`, inside a `ThreadMetadataStore` update.
+pub fn forget(thread_id: ThreadId, cx: &mut App) {
+    if let Some(store) = ThreadPinScopeStore::try_global(cx) {
+        store.update(cx, |store, cx| store.forget_thread(thread_id, cx));
+    }
+}
+
+enum Write {
+    Project(ThreadId),
+    Global(ThreadId),
+}
+
+pub struct ThreadPinScopeStore {
+    project_pins: HashSet<ThreadId>,
+    /// `None` when loading failed or the database is the in-memory fallback: the session's
+    /// scopes stay in memory.
+    writes: Option<mpsc::UnboundedSender<Write>>,
+    _writer: Task<()>,
+}
+
+impl ThreadPinScopeStore {
+    pub fn global(cx: &App) -> Entity<Self> {
+        cx.global::<GlobalThreadPinScopeStore>().0.clone()
+    }
+
+    pub fn try_global(cx: &App) -> Option<Entity<Self>> {
+        cx.try_global::<GlobalThreadPinScopeStore>()
+            .map(|global| global.0.clone())
+    }
+
+    fn new(db: ThreadPinScopeDb, cx: &mut Context<Self>) -> Self {
+        let on_fallback = db::ALL_FILE_DB_FAILED.load(Ordering::Acquire);
+        Self::with_fallback_flag(db, on_fallback, cx)
+    }
+
+    pub(super) fn with_fallback_flag(
+        db: ThreadPinScopeDb,
+        on_fallback: bool,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let mut store = Self {
+            project_pins: HashSet::default(),
+            writes: None,
+            _writer: Task::ready(()),
+        };
+        if on_fallback {
+            log::warn!("thread_pin_scope: database unavailable, pin scopes will not persist");
+        }
+        match load(&db) {
+            Ok(project_pins) => store.project_pins = project_pins,
+            Err(error) => {
+                log::warn!(
+                    "thread_pin_scope: loading failed, pin scopes will not persist this \
+                     session: {error:#}"
+                );
+                return store;
+            }
+        }
+        let (writes, mut queue) = mpsc::unbounded::<Write>();
+        store.writes = Some(writes);
+        store._writer = cx.background_spawn(async move {
+            while let Some(write) = queue.next().await {
+                let (operation, thread_id) = match &write {
+                    Write::Project(thread_id) => ("project", *thread_id),
+                    Write::Global(thread_id) => ("global", *thread_id),
+                };
+                if let Err(error) = db.write(move |connection| apply(connection, write)).await {
+                    log::error!(
+                        "thread_pin_scope: setting {operation} failed for thread {}: {error:#}",
+                        thread_id.to_key_string()
+                    );
+                }
+            }
+        });
+        store
+    }
+
+    /// Whether `thread_id`'s pin, if it has one, belongs to its project.
+    pub fn is_project_pin(&self, thread_id: ThreadId) -> bool {
+        self.project_pins.contains(&thread_id)
+    }
+
+    /// Scopes a saved thread's pin to its project, or back to global.
+    pub fn set_project_pin(
+        &mut self,
+        thread_id: ThreadId,
+        project: bool,
+        cx: &mut Context<Self>,
+    ) -> Result<(), OrganizeError> {
+        admit(thread_id, cx)?;
+        let changed = if project {
+            self.project_pins.insert(thread_id)
+        } else {
+            self.project_pins.remove(&thread_id)
+        };
+        if changed {
+            let write = if project {
+                Write::Project(thread_id)
+            } else {
+                Write::Global(thread_id)
+            };
+            self.commit(write, cx);
+        }
+        Ok(())
+    }
+
+    fn forget_thread(&mut self, thread_id: ThreadId, cx: &mut Context<Self>) {
+        if self.project_pins.remove(&thread_id) {
+            self.commit(Write::Global(thread_id), cx);
+        }
+    }
+
+    fn commit(&mut self, write: Write, cx: &mut Context<Self>) {
+        if let Some(writes) = &self.writes
+            && let Err(error) = writes.unbounded_send(write)
+        {
+            log::error!("thread_pin_scope: the writer stopped, a change was not saved: {error}");
+        }
+        cx.notify();
+    }
+}
+
+fn apply(connection: &db::sqlez::connection::Connection, write: Write) -> Result<()> {
+    match write {
+        Write::Project(thread_id) => connection.exec_bound::<ThreadId>(sql!(
+            INSERT INTO thread_pin_scope(thread_id) VALUES (?) ON CONFLICT(thread_id) DO NOTHING
+        ))?(thread_id),
+        Write::Global(thread_id) => connection.exec_bound::<ThreadId>(sql!(
+            DELETE FROM thread_pin_scope WHERE thread_id = ?
+        ))?(thread_id),
+    }
+}
+
+fn load(db: &ThreadPinScopeDb) -> Result<HashSet<ThreadId>> {
+    let rows = db.select::<ThreadId>(sql!(SELECT thread_id FROM thread_pin_scope))?()
+        .context("reading thread_pin_scope")?;
+    Ok(rows.into_iter().collect())
+}
+
+#[cfg(test)]
+#[path = "pin_scope_tests.rs"]
+mod tests;
diff --git a/crates/agent_ui/src/thread_organization/pin_scope_tests.rs b/crates/agent_ui/src/thread_organization/pin_scope_tests.rs
new file mode 100644
index 0000000..f3dd742
--- /dev/null
+++ b/crates/agent_ui/src/thread_organization/pin_scope_tests.rs
@@ -0,0 +1,120 @@
+// Zeo next proposal §6.5 (ask 12): a pin's scope, global or its project. Filter:
+// `thread_organization::pin_scope::tests`.
+
+use db::sqlez::connection::Connection;
+use gpui::{Entity, TestAppContext};
+
+use super::super::ThreadOrganizationDb;
+use super::super::test_helpers::{PROJECT_A, delete_thread, draft_in, init, thread};
+use super::*;
+
+async fn open_db(name: &'static str) -> ThreadPinScopeDb {
+    ThreadPinScopeDb::open_test_db(name).await
+}
+
+fn open_store(db: &ThreadPinScopeDb, cx: &mut TestAppContext) -> Entity<ThreadPinScopeStore> {
+    let db = db.clone();
+    let store = cx.new(|cx| ThreadPinScopeStore::with_fallback_flag(db, false, cx));
+    cx.run_until_parked();
+    store
+}
+
+fn set(
+    store: &Entity<ThreadPinScopeStore>,
+    thread_id: ThreadId,
+    project: bool,
+    cx: &mut TestAppContext,
+) -> Result<(), OrganizeError> {
+    let result = store.update(cx, |store, cx| {
+        store.set_project_pin(thread_id, project, cx)
+    });
+    cx.run_until_parked();
+    result
+}
+
+fn is_project(store: &Entity<ThreadPinScopeStore>, id: ThreadId, cx: &TestAppContext) -> bool {
+    store.read_with(cx, |store, _| store.is_project_pin(id))
+}
+
+fn reopen(
+    store: Entity<ThreadPinScopeStore>,
+    db: &ThreadPinScopeDb,
+    cx: &mut TestAppContext,
+) -> Entity<ThreadPinScopeStore> {
+    cx.run_until_parked();
+    drop(store);
+    open_store(db, cx)
+}
+
+/// Hostile: the scope must not share 0048's migration list, whose steps land at different
+/// indexes with and without the `devtools-panel` USE flag (0063).
+#[test]
+fn the_pin_scope_has_a_migration_list_of_its_own() {
+    assert_ne!(ThreadPinScopeDb::NAME, ThreadOrganizationDb::NAME);
+    assert!(
+        ThreadOrganizationDb::MIGRATIONS
+            .iter()
+            .all(|step| !step.contains("pin_scope")),
+        "no step of thread_organization mentions it"
+    );
+    let connection = Connection::open_memory(Some("thread_pin_scope_migration"));
+    connection
+        .migrate(
+            ThreadPinScopeDb::NAME,
+            ThreadPinScopeDb::MIGRATIONS,
+            &mut |_, _, _| false,
+        )
+        .expect("the pin scope migration applies");
+}
+
+#[gpui::test]
+async fn a_project_pin_survives_a_restart_and_global_clears_it(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_restart").await;
+    let store = open_store(&db, cx);
+    let thread_id = thread(cx);
+    assert!(!is_project(&store, thread_id, cx), "global by default");
+
+    set(&store, thread_id, true, cx).expect("a saved thread");
+    let store = reopen(store, &db, cx);
+    assert!(is_project(&store, thread_id, cx));
+
+    set(&store, thread_id, false, cx).expect("back to global");
+    let store = reopen(store, &db, cx);
+    assert!(!is_project(&store, thread_id, cx), "cleared on disk");
+}
+
+/// Hostile: a draft is refused, as the organization refuses it.
+#[gpui::test]
+async fn a_draft_has_no_pin_scope(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_draft").await;
+    let store = open_store(&db, cx);
+    let draft = draft_in(PROJECT_A, cx);
+    assert!(matches!(
+        set(&store, draft, true, cx),
+        Err(OrganizeError::Draft { .. })
+    ));
+    assert!(!is_project(&store, draft, cx));
+}
+
+/// A deleted thread's scope goes with it, through thread_organization::forget.
+#[gpui::test]
+async fn a_deleted_threads_pin_scope_is_forgotten(cx: &mut TestAppContext) {
+    init(cx);
+    let db = open_db("pin_scope_forget").await;
+    let store = open_store(&db, cx);
+    cx.update(|cx| cx.set_global(GlobalThreadPinScopeStore(store.clone())));
+    let thread_id = thread(cx);
+    set(&store, thread_id, true, cx).expect("a saved thread");
+    assert!(
+        is_project(&store, thread_id, cx),
+        "precondition: there is something to forget"
+    );
+    delete_thread(thread_id, cx);
+    assert!(!is_project(&store, thread_id, cx));
+    drop(store);
+    cx.update(|cx| cx.remove_global::<GlobalThreadPinScopeStore>());
+    let store = open_store(&db, cx);
+    assert!(!is_project(&store, thread_id, cx), "and from disk");
+}
