+/// Shared `_meta` key marking a free-text field as the custom-answer companion
+/// of a select field — the "Other" box that belongs to one specific question.
+///
+/// Deliberately *not* namespaced to any agent, and that is the adapter's
+/// choice, not an omission: the same marker is meant to be recognised across
+/// every AskUserQuestion bridge. Reading it here is what lets a page hold a
+/// question together with its own free-text box instead of splitting the two
+/// across two pages.
+const ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY: &str = "_askUserQuestionCustomAnswer";
+
+/// The `_meta` of a property schema, for the variants that carry one.
+///
+/// `Other` is the untagged custom/future variant: it keeps its payload as raw
+/// JSON under `fields` and has no typed `_meta`, so it answers `None` rather
+/// than being parsed speculatively.
+fn property_meta(property: &acp::ElicitationPropertySchema) -> Option<&acp::Meta> {
+    match property {
+        acp::ElicitationPropertySchema::String(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Number(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Integer(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Boolean(schema) => schema.meta.as_ref(),
+        acp::ElicitationPropertySchema::Array(schema) => schema.meta.as_ref(),
+        _ => None,
+    }
+}
