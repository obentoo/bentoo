+    /// A free-text field carrying the marker that pairs it with `question_id`
+    /// -- what the adapter emits beside every question it asks.
+    fn custom_answer_field(question_id: &str) -> acp::StringPropertySchema {
+        let mut schema = acp::StringPropertySchema::new().title("Other");
+        let mut meta = serde_json::Map::new();
+        meta.insert(
+            ASK_USER_QUESTION_CUSTOM_ANSWER_META_KEY.to_string(),
+            serde_json::json!({ "questionId": question_id, "isCustomAnswer": true }),
+        );
+        schema.meta = Some(meta);
+        schema
+    }
+
+    /// Two questions, each with its own "Other" box: the shape an
