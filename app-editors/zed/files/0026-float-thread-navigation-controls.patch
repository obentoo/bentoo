+
         let separator_dots = || {
             Label::new("•")
                 .size(LabelSize::Small)
@@ -7082,11 +7064,75 @@ impl ThreadView {
             )
             .when_some(feedback_buttons, |this, buttons| this.child(buttons))
             .when_some(copy_response_button, |this, button| this.child(button))
-            .child(scroll_to_recent_user_prompt)
-            .when_some(scroll_to_top, |this, button| this.child(button))
             .into_any_element()
     }
 
+    /// The two navigation controls, as a fixed overlay on the conversation
+    /// instead of a row inside the last entry.
+    ///
+    /// `render_thread_controls` renders *inside* a list item, so the moment the
+    /// turn it belongs to scrolls out of view its controls go with it --
+    /// precisely when "take me back to my message" and "take me to the top"
+    /// start being useful. Anchoring them on the conversation container instead
+    /// keeps them reachable from anywhere in the thread.
+    ///
+    /// The copy button deliberately stays inline. It copies one specific agent
+    /// response, and a control that floats over the whole conversation has no
+    /// way to say which response it means.
+    fn render_floating_thread_navigation(&self, cx: &Context<Self>) -> impl IntoElement {
+        // `scroll_to_user_message_index(None, ..)` already falls back to the
+        // most recent user message, which is the right target for a control
+        // that is not attached to any particular turn. The button is hidden
+        // outright when there is no user message at all, rather than left to
+        // that function's second fallback of scrolling to the end.
+        let has_user_message = self
+            .thread
+            .read(cx)
+            .entries()
+            .iter()
+            .any(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)));
+
+        div()
+            .absolute()
+            // Clear of the vertical scrollbar the same container draws.
+            .right_4()
+            .bottom_2()
+            .child(
+                h_flex()
+                    .gap_0p5()
+                    .p_0p5()
+                    .rounded_md()
+                    .border_1()
+                    .border_color(cx.theme().colors().border)
+                    .bg(cx.theme().colors().elevated_surface_background)
+                    .opacity(0.4)
+                    .hover(|s| s.opacity(1.))
+                    .when(has_user_message, |this| {
+                        this.child(
+                            IconButton::new(
+                                "floating_scroll_to_user_message",
+                                IconName::UserArrowUp,
+                            )
+                            .icon_size(IconSize::Small)
+                            .icon_color(Color::Muted)
+                            .tooltip(Tooltip::text("Scroll to User Message"))
+                            .on_click(cx.listener(|this, _, _, cx| {
+                                this.scroll_to_user_message_index(None, cx);
+                            })),
+                        )
+                    })
+                    .child(
+                        IconButton::new("floating_scroll_to_top", IconName::ArrowUp)
+                            .icon_size(IconSize::Small)
+                            .icon_color(Color::Muted)
+                            .tooltip(Tooltip::text("Scroll to Top"))
+                            .on_click(cx.listener(|this, _, _, cx| {
+                                this.scroll_to_top(cx);
+                            })),
+                    ),
+            )
+    }
+
     fn is_thread_feedback_enabled(&self, cx: &App) -> bool {
         util::maybe!({
             let project = self.thread.read(cx).project().read(cx);
@@ -12420,9 +12466,11 @@ impl Render for ThreadView {
             })
             .map(|this| {
                 if has_messages {
-                    this.flex_1()
+                    this.relative()
