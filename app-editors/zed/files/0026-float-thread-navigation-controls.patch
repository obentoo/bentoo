@@ -7050,6 +7019,19 @@ impl ThreadView {
             })
             .flatten();
 
+        // With the navigation buttons gone, every remaining part is optional
+        // and they can all be absent at once: a last entry that is not an
+        // assistant message, turn stats off, feedback unavailable. Rendering
