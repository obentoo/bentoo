DEFINED_PHASES=install postinst postrm preinst pretend
DESCRIPTION=Zeo - the Zed editor, rebranded, with the bentoo patch series (binary)
EAPI=8
HOMEPAGE=https://github.com/zeo-workspace/zeo https://zed.dev
IDEPEND=dev-util/desktop-file-utils x11-misc/shared-mime-info
INHERIT=xdg
IUSE=+claude-agent-acp-plus +claude-agent-acp-tui +claude-code-ide
KEYWORDS=-* ~amd64
LICENSE=GPL-3+ Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0 CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3 MIT MIT-0 MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB BZIP2
RDEPEND=!app-editors/zed !app-editors/zed-bin !app-editors/zeo media-libs/alsa-lib dev-libs/glib:2 x11-libs/libxcb x11-libs/libxkbcommon[X] media-libs/vulkan-loader dev-libs/wayland x11-libs/libX11 || ( media-fonts/dejavu media-fonts/cantarell media-fonts/noto media-fonts/ubuntu-font-family ) claude-agent-acp-plus? ( >=dev-util/claude-agent-acp-plus-0.24.0 ) claude-agent-acp-tui? ( dev-util/claude-agent-acp-tui ) claude-code-ide? ( dev-util/claude-code )
RESTRICT=mirror strip
SLOT=0
