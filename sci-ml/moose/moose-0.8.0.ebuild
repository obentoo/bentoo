RUST_MIN_VER="1.92.0"

inherit cargo gnome2-utils meson xdg

DESCRIPTION="GTK/libadwaita chat client for local and remote Ollama servers"
HOMEPAGE="https://github.com/moooossee/moose"
SRC_URI="
	https://github.com/moooossee/moose/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3+"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD
	CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016
	ZLIB
"
# STIX Two Math font, embedded into the binary by the latex-rust crate
LICENSE+=" OFL-1.1"
SLOT="0"
KEYWORDS="~amd64"

# sys-crates in Cargo.lock: cairo, gdk-pixbuf, gdk4/gsk4/gtk4, gio/glib/gobject,
# graphene, libadwaita, sqlite (system, FTS5 is always on in ::gentoo), pango,
# gtksourceview, zstd (forced to pkg-config in src_compile).
# gtk4 is built with feature gnome_50 (v4_22), libadwaita with v1_9.
DEPEND="
	app-arch/zstd:=
	dev-db/sqlite:3
	dev-libs/glib:2
	>=gui-libs/gtk-4.22:4
	>=gui-libs/libadwaita-1.9:1
	gui-libs/gtksourceview:5
	media-libs/graphene
	x11-libs/cairo
	x11-libs/gdk-pixbuf:2
	x11-libs/pango
"
# pdftotext is spawned at runtime to import PDF attachments
RDEPEND="
	${DEPEND}
	app-text/poppler[utils]
"
BDEPEND="
	dev-libs/glib:2
	virtual/pkgconfig
"

src_configure() {
	local emesonargs=(
		# The non-gui binary is an empty "fn main() {}" in 0.5.0, and the
		# desktop file, D-Bus service and schema meson installs all point at
		# the GUI, so gui=false would ship a no-op program.
		-Dgui=true
		-Dcargo_profile=$(usex debug dev release)
	)
	meson_src_configure
}

src_compile() {
	# build-aux/cargo-build.py runs cargo itself; cargo_env gives it the
	# eclass toolchain and flags. CARGO_HOME (offline, vendored) is already
	# exported by cargo_gen_config.
	local -x ZSTD_SYS_USE_PKG_CONFIG=1
	# Panic locations embed the vendored crate paths under ${WORKDIR}.
	# Not "local": cargo_env unsets RUSTFLAGS in a subshell after folding it
	# into CARGO_TARGET_*_RUSTFLAGS, and unsetting a caller's local only
	# re-exposes the global value, which then overrides the folded flags.
	RUSTFLAGS+=" --remap-path-prefix=${WORKDIR}=/usr/src/debug/${CATEGORY}/${PF}"
	cargo_env meson_src_compile
}

src_test() {
	# meson defines no tests; the Rust unit tests live in the non-gui modules
	local -x ZSTD_SYS_USE_PKG_CONFIG=1
	cargo_src_test
}

pkg_postinst() {
	xdg_pkg_postinst
	gnome2_schemas_update

	elog "Moose is a client: it needs an Ollama server, by default at"
	elog "http://127.0.0.1:11434. Install one locally (sci-ml/ollama or"
	elog "sci-ml/ollama-bin, with whatever GPU backend fits your hardware)"
	elog "or point Moose at a remote instance in its preferences."
	elog "Moose's own \"managed Ollama\" option downloads upstream's prebuilt"
	elog "Ollama binaries at runtime, outside of Portage."
}

pkg_postrm() {
	xdg_pkg_postrm
	gnome2_schemas_update
}
