src_prepare() {
	default

	# The dracut module names the udev helpers by absolute path. Point it at
	# this system's udev directory when that is not /usr/lib/udev; guarded,
	# because a sed that matches nothing exits 0 and would ship a module whose
	# check() fails on every host.
	local udevdir=$(get_udevdir)
	if [[ ${udevdir} != /usr/lib/udev ]]; then
		local f=dracut/50stratis/module-setup.sh.in
		grep -qF '/usr/lib/udev/stratis-str-cmp' "${f}" ||
			die "${f}: /usr/lib/udev anchor not found"
		sed -i "s|/usr/lib/udev/|${udevdir}/|g" "${f}" || die
		grep -qF "${udevdir}/stratis-str-cmp" "${f}" ||
			die "${f}: udev directory was not rewritten"
	fi
}

src_compile() {
	# Cargo.toml denies every rustc warning, so a lint added by a newer
	# toolchain would fail the build. Cap them, as upstream's CAP_LINTS does.
	local -x RUSTFLAGS="${RUSTFLAGS} --cap-lints=warn"

	# One cargo pass per feature set, the same sets the Makefile's build-*
	# targets use (the Makefile itself is not run: it would call cargo without
	# the eclass environment). Each binary keeps exactly upstream's features:
	# the dbus_enabled and min features change engine behaviour, so they are
	# never merged into a single pass.
	local systemd_compat=$(usev systemd ,systemd_compat)

	# stratisd: default features (dbus_enabled, engine); never links libsystemd.
	cargo_src_compile --bin stratisd
	cargo_src_compile --bin stratisd-tools \
		--no-default-features --features engine,extras
	# stratisd-min + stratis-min: the JSON-RPC pair used in early boot, and the
	# only command-line client this package ships. systemd_compat adds the
	# sd_notify() readiness signal the Type=notify units wait for.
	cargo_src_compile --bin stratis-min --bin stratisd-min \
		--no-default-features --features "engine,min${systemd_compat}"
	# stratis-utils: predict-usage, decode-dm and, with systemd_compat, the
	# two systemd generators (without it they exit with an error).
	cargo_src_compile --bin stratis-utils \
		--no-default-features --features "dbus_enabled,engine${systemd_compat}"
	# udev helpers. Upstream links them with +crt-static; they are linked
	# dynamically here, since dracut copies their libraries into the initramfs
	# and the real root already has them.
	cargo_src_compile --bin stratis-str-cmp --bin stratis-base32-decode \
		--no-default-features --features udev_scripts

	local page
	for page in stratisd stratis-dumpmetadata; do
		a2x -L -f manpage "docs/${page}.txt" || die "a2x failed for ${page}"
	done
}

src_install() {
	# Reuse the Makefile's install targets, which never invoke cargo, so a bump
	# picks up upstream's layout (hard links included) without rewriting it.
	# They read the binaries from target/$(PROFILEDIR).
	local target_dir=$(cargo_target_dir)
	[[ ${target_dir} == target/* ]] ||
		die "cargo target directory ${target_dir} is not under target/"
	local -a mymakeargs=(
		DESTDIR="${D}"
		PREFIX="${EPREFIX}/usr"
		LIBEXECDIR="${EPREFIX}/usr/libexec"
		UDEVDIR="${EPREFIX}$(get_udevdir)"
		UNITDIR="$(systemd_get_systemunitdir)"
		UNITEXECDIR="$(systemd_get_utildir)"
		UNITGENDIR="$(systemd_get_systemgeneratordir)"
		DRACUTDIR="${EPREFIX}/usr/lib/dracut"
		PROFILEDIR="${target_dir#target/}"
	)
	local -a targets=(
		install-binaries
		install-daemons
		install-dbus-cfg
		install-udev-binaries
	)
	use systemd && targets+=( install-systemd-cfg install-fstab-script )
	use dracut && targets+=( install-dracut-cfg )
	emake "${mymakeargs[@]}" "${targets[@]}"

	if ! use systemd; then
		# install-binaries always links the two generators into the systemd
		# generator directory; without systemd_compat they only print an error.
		rm -r "${D}$(systemd_get_systemgeneratordir)" ||
			die "systemd generator directory not found"
		# Drop the parent too when nothing else of systemd's is left in it.
		find "${D}$(dirname "$(systemd_get_systemgeneratordir)")" \
			-maxdepth 0 -empty -delete || die
	fi
	if use dracut; then
		# Needs app-crypt/clevis, which is not packaged yet (see IUSE).
		rm -r "${ED}/usr/lib/dracut/modules.d/50stratis-clevis" ||
			die "50stratis-clevis dracut module not found"
	fi

	udev_dorules udev/61-stratisd.rules
	doman docs/stratisd.8 docs/stratis-dumpmetadata.8

	# The systemd units above are gated behind USE=systemd; the OpenRC script
	# never is (overlay policy: no systemd-only daemons). It mirrors
	# stratisd.service only. What has no OpenRC counterpart, and why:
	#  - stratisd-min-postinitrd.service and stratis-fstab-setup{,-with-network}@
	#    .service: the systemd boot path that starts the pools named in
	#    /etc/fstab (x-systemd.requires=stratis-fstab-setup@<pool-uuid>) before
	#    local-fs-pre.target, prompting through systemd-ask-password. OpenRC has
	#    no per-mount unit dependency to hang them on; under OpenRC the pools
	#    are set up by stratisd itself once its init script runs.
	#  - stratis-setup-generator and stratis-clevis-setup-generator: systemd
	#    generators, a concept OpenRC does not have. They serve root-on-Stratis
	#    in a systemd initramfs (USE=dracut).
	newinitd "${FILESDIR}"/stratisd.initd stratisd
	newconfd "${FILESDIR}"/stratisd.confd stratisd

	dodoc README.md CHANGES.txt
}

pkg_postinst() {
	udev_reload

	elog "stratisd is controlled over D-Bus (org.storage.stratis3). The usual"
	elog "client, the Python 'stratis' command (stratis-cli), is a separate"
	elog "project; stratis-min, installed here, talks only to stratisd-min."
	elog
	elog "OpenRC: rc-update add stratisd default"
	use systemd && elog "systemd: systemctl enable --now stratisd.service"
	elog
	elog "Under OpenRC, mark Stratis filesystems in /etc/fstab 'noauto' and mount"
	elog "them once stratisd is running: localmount runs before D-Bus, hence"
	elog "before stratisd, and the systemd-only stratis-fstab-setup units that"
	elog "order these mounts have no OpenRC equivalent."
	if use dracut; then
		elog
		elog "Root on Stratis: the 50stratis dracut module needs a systemd"
		elog "initramfs and the kernel parameter stratis.rootfs.pool_uuid=<UUID>."
	fi
	if ! has_version app-crypt/clevis; then
		elog
		elog "Clevis/Tang/TPM2 pool binding needs app-crypt/clevis, not"
		elog "installed; passphrase (keyring) encryption works without it."
	fi
}

pkg_postrm() {
	udev_reload
}
