+    #[test]
+    fn uptime_is_the_jails_age_with_every_cpu_idle() {
+        assert_eq!(uptime(0.0, 4), format!("{:>16} {:>16}\n", "0.00", "0.00"));
+        let text = uptime(12.345, 4);
+        let values: Vec<f64> = text
+            .split_whitespace()
+            .map(|v| v.parse().unwrap())
+            .collect();
+        assert_eq!(values.len(), 2);
