+                server_port,
+                proxy.port(),
+                client_in,
+                output,
+            );
+            let _ = done_tx.send(result);
+        });
+        let result = done_rx
+            .recv_timeout(Duration::from_secs(10))
+            .expect("the packet was held back: the session deadlocked");
+        result.unwrap();
+        assert_eq!(client.join().unwrap(), b"done");
+    }
