+            client_reads.read_exact(&mut packet).unwrap();
+            client_answers.write_all(b"ok").unwrap();
+            drop(client_answers);
+            let mut rest = Vec::new();
+            client_reads.read_to_end(&mut rest).unwrap();
+            rest
