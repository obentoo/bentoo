+        limits
+            .iter()
+            .find(|l| l.name.as_str() == name)
+            .unwrap_or_else(|| panic!("no effective limit named {name}"))
+    }
+
+    fn pair(limits: &[EffectiveLimit], name: &str) -> (u64, u64) {
+        let l = find(limits, name);
+        (l.soft, l.hard)
