+    #[test]
+    fn sched_setaffinity_is_not_denied_without_cpus() {
+        // Hostile half first: the lock must not fire when nothing is pinned.
+        assert!(!filter_names(
+            &Config::default(),
+            libc::SYS_sched_setaffinity
+        ));
+    }
+
+    #[test]
+    fn sched_setaffinity_is_denied_when_cpus_is_set() {
+        assert!(filter_names(&pinned(), libc::SYS_sched_setaffinity));
+    }
+
+    #[test]
+    fn sched_getaffinity_stays_allowed_with_cpus() {
+        assert!(!filter_names(&pinned(), libc::SYS_sched_getaffinity));
+    }
+
+    #[test]
+    fn io_uring_stays_denied_while_cpus_is_set() {
+        // IORING_REGISTER_IOWQ_AFF would set worker affinity.
+        for nr in [
+            libc::SYS_io_uring_setup,
+            libc::SYS_io_uring_enter,
+            libc::SYS_io_uring_register,
+        ] {
+            assert!(filter_names(&pinned(), nr), "io_uring syscall {nr}");
+        }
+    }
+}
diff --git a/tests/resource_limits.rs b/tests/resource_limits.rs
new file mode 100644
index 0000000..83c93e0
--- /dev/null
+++ b/tests/resource_limits.rs
@@ -0,0 +1,348 @@
+// End-to-end tests for the whole-sandbox resource limits: `--cpus`
+// (CPU affinity locked by seccomp) and `--memory` / `--max-tasks` /
+// `--cpu-quota` (a systemd user scope), plus the exit report that
+// explains a death.
+//
+// Linux-only. Tests needing bwrap skip when it cannot create user
+// namespaces; tests needing a cgroup skip when `systemd-run --user
+// --scope` is unavailable (no systemd user session).
+#![cfg(target_os = "linux")]
+
+use std::path::PathBuf;
+use std::process::{Command, Output};
+use std::sync::OnceLock;
+
+fn bwrap_available() -> bool {
+    static RESULT: OnceLock<bool> = OnceLock::new();
+    *RESULT.get_or_init(|| {
+        Command::new("bwrap")
+            .args([
+                "--ro-bind",
+                "/",
+                "/",
+                "--proc",
+                "/proc",
+                "--unshare-pid",
+                "--",
+                "true",
+            ])
+            .output()
+            .map(|o| o.status.success())
+            .unwrap_or(false)
+    })
+}
+
+fn scope_available() -> bool {
+    static RESULT: OnceLock<bool> = OnceLock::new();
+    *RESULT.get_or_init(|| {
+        Command::new("systemd-run")
+            .args([
+                "--user",
+                "--scope",
+                "--quiet",
+                "-p",
+                "TasksMax=100",
+                "true",
+            ])
+            .output()
+            .map(|o| o.status.success())
+            .unwrap_or(false)
+    })
+}
+
+macro_rules! require {
+    ($cond:expr, $why:literal) => {
+        if !$cond {
+            eprintln!(concat!("SKIPPED: ", $why));
+            return;
+        }
+    };
+}
+
+fn ai_jail() -> PathBuf {
+    PathBuf::from(env!("CARGO_BIN_EXE_ai-jail"))
+}
+
+fn test_tree(name: &str) -> (PathBuf, PathBuf) {
+    let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR"))
+        .join(format!("resource-limits-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let project = root.join("project");
+    let home = root.join("home");
+    std::fs::create_dir_all(&project).unwrap();
+    std::fs::create_dir_all(&home).unwrap();
+    (project, home)
+}
+
+fn run_in(name: &str, args: &[&str]) -> (Output, PathBuf) {
+    let (project, home) = test_tree(name);
+    let output = Command::new(ai_jail())
+        .args(["--clean", "--no-save-config", "--no-status-bar"])
+        .args(args)
+        .current_dir(&project)
+        .env("HOME", &home)
+        .env_remove("AI_JAIL_LIMITS_SCOPE")
+        .output()
+        .expect("failed to run ai-jail");
+    (output, home)
+}
+
+fn text(bytes: &[u8]) -> String {
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+/// The first CPU this test process may run on (not necessarily 0).
+fn first_allowed_cpu() -> usize {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap();
+    let list = status
+        .lines()
+        .find_map(|l| l.strip_prefix("Cpus_allowed_list:"))
+        .unwrap()
+        .trim();
+    list.split([',', '-']).next().unwrap().parse().unwrap()
+}
+
+fn launch_record(home: &std::path::Path) -> serde_json::Value {
+    let log = home.join(".local/share/ai-jail/history.jsonl");
+    let content = std::fs::read_to_string(&log).expect("audit log written");
+    content
+        .lines()
+        .map(|l| serde_json::from_str::<serde_json::Value>(l).unwrap())
+        .find(|v| v["type"] == "launch")
+        .expect("launch record")
+}
+
+// ── --cpus ─────────────────────────────────────────────────────
+
+#[test]
+fn cpus_pin_the_sandbox_and_cannot_be_widened() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    let cpu = first_allowed_cpu().to_string();
+    let (output, _) = run_in(
+        "cpus-pin",
+        &[
+            "--exec",
+            "--cpus",
+            &cpu,
+            "bash",
+            "-c",
+            "grep Cpus_allowed_list /proc/self/status; \
+             echo nproc=$(nproc); \
+             taskset -p -c 0-$(( $(getconf _NPROCESSORS_CONF) - 1 )) $$ \
+               >/dev/null 2>&1; echo widen=$?; \
+             grep Cpus_allowed_list /proc/self/status",
+        ],
+    );
+    let stdout = text(&output.stdout);
+    assert!(output.status.success(), "{stdout} {}", text(&output.stderr));
+    let lists: Vec<&str> = stdout
+        .lines()
+        .filter_map(|l| l.strip_prefix("Cpus_allowed_list:"))
+        .map(str::trim)
+        .collect();
+    assert_eq!(lists, vec![cpu.as_str(), cpu.as_str()], "{stdout}");
+    assert!(stdout.contains("nproc=1"), "{stdout}");
+    assert!(
+        !stdout.contains("widen=0"),
+        "taskset widened the CPU set: {stdout}"
+    );
+}
+
+#[test]
+fn cpus_without_seccomp_are_refused() {
+    let (output, _) = run_in(
+        "cpus-noseccomp",
+        &["--exec", "--no-seccomp", "--cpus", "0", "true"],
+    );
+    assert!(!output.status.success());
+    assert!(
+        text(&output.stderr).contains("--cpus needs seccomp"),
+        "{}",
+        text(&output.stderr)
+    );
+}
+
+#[test]
+fn cpus_the_host_does_not_have_are_refused() {
+    let (output, _) =
+        run_in("cpus-missing", &["--exec", "--cpus", "1023", "true"]);
+    assert!(!output.status.success());
+    assert!(
+        text(&output.stderr).contains("cannot use: 1023"),
+        "{}",
+        text(&output.stderr)
+    );
+}
+
+// ── cgroup scope ───────────────────────────────────────────────
+
+#[test]
+fn memory_limit_death_is_reported_as_oom() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    require!(scope_available(), "no systemd user session");
+    let (output, home) = run_in(
+        "oom",
+        &[
+            "--exec",
+            "--audit-log",
+            "--memory",
+            "64M",
+            "bash",
+            "-c",
+            // Command substitution holds the whole output in memory.
+            "x=$(head -c 256M /dev/zero | tr '\\0' a); echo ${#x}",
+        ],
+    );
+    let stderr = text(&output.stderr);
+    assert_ne!(output.status.code(), Some(0), "{stderr}");
+    assert!(stderr.contains("out of memory"), "{stderr}");
+    assert!(stderr.contains("64.0 MiB"), "{stderr}");
+
+    let record = launch_record(&home);
+    assert_eq!(record["limits"]["memory"], 64 << 20);
+    assert!(
+        record["cgroup"]["oom_kills"].as_u64().unwrap() >= 1,
+        "{record}"
+    );
+    assert!(record["cgroup"]["memory_peak"].as_u64().is_some());
+}
+
+#[test]
+fn task_limit_refusals_are_reported() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    require!(scope_available(), "no systemd user session");
+    let (output, _) = run_in(
+        "tasks",
+        &[
+            "--exec",
+            "--max-tasks",
+            "40",
+            "bash",
+            "-c",
+            "for i in $(seq 80); do sleep 1 & done 2>/dev/null; wait",
+        ],
+    );
+    let stderr = text(&output.stderr);
+    assert!(stderr.contains("task limit reached"), "{stderr}");
+    assert!(stderr.contains("max-tasks 40"), "{stderr}");
+}
+
+#[test]
+fn a_clean_run_under_limits_is_quiet_and_accounted() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    require!(scope_available(), "no systemd user session");
+    let (output, home) = run_in(
+        "clean",
+        &[
+            "--exec",
+            "--audit-log",
+            "--memory",
+            "512M",
+            "--max-tasks",
+            "500",
+            "--cpu-quota",
+            "150%",
+            "bash",
+            "-c",
+            "exit 4",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(4), "{}", text(&output.stderr));
+    // v3 security-warns that the hidden legacy `.ai-jail` mask has nothing
+    // to cover in a fresh project; that notice is upstream's, not a report.
+    let stderr = text(&output.stderr);
+    let report: Vec<&str> = stderr
+        .lines()
+        .filter(|line| {
+            !line.ends_with(".ai-jail does not exist; rule not applied")
+        })
+        .collect();
+    assert!(report.is_empty(), "no report for a normal exit: {stderr}");
+    let record = launch_record(&home);
+    assert_eq!(record["exit_code"], 4);
+    assert_eq!(record["limits"]["max_tasks"], 500);
+    assert_eq!(record["limits"]["cpu_quota"], 150);
+    assert_eq!(record["cgroup"]["oom_kills"], 0);
+    assert!(record["cgroup"]["cpu_usage_usec"].as_u64().is_some());
+}
+
+#[test]
+fn the_sandbox_not_the_supervisor_is_the_oom_victim() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    require!(scope_available(), "no systemd user session");
+    let read = "cat /proc/self/oom_score_adj";
+    let (limited, _) = run_in(
+        "oomadj",
+        &["--exec", "--memory", "256M", "bash", "-c", read],
+    );
+    assert_eq!(text(&limited.stdout).trim(), "500");
+    let (plain, _) = run_in("oomadj-plain", &["--exec", "bash", "-c", read]);
+    assert_ne!(
+        text(&plain.stdout).trim(),
+        "500",
+        "no --memory, no bias: behaviour unchanged"
+    );
+}
+
+#[test]
+fn arguments_survive_the_scope_hop_verbatim() {
+    require!(bwrap_available(), "bwrap cannot create user namespaces");
+    require!(scope_available(), "no systemd user session");
+    let (output, _) = run_in(
+        "verbatim",
+        &[
+            "--exec",
+            "--memory",
+            "256M",
+            "bash",
+            "-c",
+            "printf '%s|%s' \"$1\" \"$2\"",
+            "_",
+            "lit$HOME",
+            "a b;c",
+        ],
+    );
+    assert!(output.status.success(), "{}", text(&output.stderr));
+    assert_eq!(text(&output.stdout), "lit$HOME|a b;c");
+}
+
+#[test]
+fn a_spoofed_scope_marker_is_refused() {
+    // The marker only names the scope to check; claiming one that this
+    // process is not in must stop the launch, not skip the limits.
+    let (project, home) = test_tree("spoof");
+    let output = Command::new(ai_jail())
+        .args([
+            "--clean",
+            "--no-save-config",
+            "--exec",
+            "--memory",
+            "256M",
+            "true",
+        ])
+        .current_dir(&project)
+        .env("HOME", &home)
+        .env("AI_JAIL_LIMITS_SCOPE", "not-this-one")
+        .output()
+        .unwrap();
+    assert!(!output.status.success());
+    assert!(
+        text(&output.stderr).contains("expected to run in not-this-one.scope"),
+        "{}",
+        text(&output.stderr)
+    );
+}
+
+#[test]
+fn dry_run_names_the_scope_without_entering_it() {
+    let (output, _) = run_in(
+        "dryrun",
+        &["--dry-run", "--memory", "1G", "--cpus", "0", "bash"],
+    );
+    assert!(output.status.success(), "{}", text(&output.stderr));
+    let stderr = text(&output.stderr);
+    assert!(stderr.contains("-p MemoryMax=1073741824"), "{stderr}");
+    assert!(stderr.contains("-p MemorySwapMax=0"), "{stderr}");
+    let stdout = text(&output.stdout);
+    assert!(stdout.contains("--cpus 0"), "wrapper gets --cpus: {stdout}");
+}
diff --git a/tests/rlimit_dry_run_ceiling.rs b/tests/rlimit_dry_run_ceiling.rs
new file mode 100644
index 0000000..e121bca
--- /dev/null
+++ b/tests/rlimit_dry_run_ceiling.rs
@@ -0,0 +1,260 @@
+// `--dry-run` reports the `core` and `nofile` values the sandbox actually
+// receives, and every printed limit spells RLIM_INFINITY as `unlimited`.
+//
+// The supervisor applies its own `core` 0 and `nofile` 65536 with hard
+// pinned to soft before it starts the sandbox, so an explicit value above
+// them is unreachable inside. The dry run must print what a real launch
+// with the same flags measures with `ulimit`, marked `ceiling=supervisor`
+// where the ceiling changed the value, while the launch keeps warning about
+// the clamp in the operator's own words.
+//
+// Launches run without `--exec`, because `--exec` silences warnings, from a
+// temporary HOME, XDG_CONFIG_HOME and project directory, so the developer's
+// own config cannot leak in; they skip with a message when bwrap cannot
+// create namespaces.
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use std::path::PathBuf;
+use std::process::{Command, Output, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new() -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!(
+            "rlimit-dry-run-ceiling-{}-{id}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        for dir in [&project, &home, &xdg] {
+            std::fs::create_dir_all(dir).unwrap();
+        }
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+/// Run `ai-jail --no-status-bar --no-save-config <flags> sh -c <script>`.
+fn jail(flags: &[&str], script: &str) -> Output {
+    let _lock = common::SANDBOX_RUN_LOCK
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let tree = Tree::new();
+    Command::new(ai_jail())
+        .args(["--no-status-bar", "--no-save-config"])
+        .args(flags)
+        .args(["sh", "-c", script])
+        .current_dir(&tree.project)
+        .env("HOME", &tree.home)
+        .env("XDG_CONFIG_HOME", &tree.xdg)
+        .env_remove("AI_JAIL_QUIET")
+        .env_remove("NO_COLOR")
+        .stdin(Stdio::null())
+        .output()
+        .expect("failed to spawn ai-jail")
+}
+
+fn text(bytes: &[u8]) -> String {
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+/// The dry run's `rlimit name=<name> ...` line.
+fn dry_run(flags: &[&str]) -> String {
+    let mut all = vec!["--dry-run"];
+    all.extend_from_slice(flags);
+    let out = jail(&all, "true");
+    let stdout = text(&out.stdout);
+    assert!(
+        out.status.success(),
+        "dry run failed: stdout={stdout}\nstderr={}",
+        text(&out.stderr)
+    );
+    stdout
+}
+
+fn line<'a>(stdout: &'a str, name: &str) -> &'a str {
+    let prefix = format!("rlimit name={name} ");
+    stdout
+        .lines()
+        .find(|l| l.starts_with(&prefix))
+        .unwrap_or_else(|| panic!("no {prefix:?} line in:\n{stdout}"))
+}
+
+/// The value of `key=` on a dry-run line.
+fn field<'a>(line: &'a str, key: &str) -> Option<&'a str> {
+    let prefix = format!("{key}=");
+    line.split_whitespace()
+        .find_map(|w| w.strip_prefix(prefix.as_str()))
+}
+
+/// `ulimit -n` and `ulimit -c` measured inside a real launch.
+fn measured(flags: &[&str]) -> (String, String, String) {
+    let out = jail(flags, "echo nofile=$(ulimit -n) core=$(ulimit -c)");
+    let stdout = text(&out.stdout);
+    let stderr = text(&out.stderr);
+    assert!(
+        out.status.success(),
+        "launch failed: stdout={stdout}\nstderr={stderr}"
+    );
+    let row = stdout
+        .lines()
+        .find(|l| l.starts_with("nofile="))
+        .unwrap_or_else(|| panic!("no ulimit row in:\n{stdout}"));
+    let mut cols = row.split_whitespace();
+    let nofile = cols.next().unwrap().trim_start_matches("nofile=");
+    let core = cols.next().unwrap().trim_start_matches("core=");
+    (nofile.to_string(), core.to_string(), stderr)
+}
+
+/// The test process's own hard limit for a `/proc/self/limits` label.
+fn host_hard(label: &str) -> String {
+    let limits = std::fs::read_to_string("/proc/self/limits").unwrap();
+    let row = limits
+        .lines()
+        .find(|l| l.starts_with(label))
+        .unwrap_or_else(|| panic!("no {label} in {limits}"));
+    row[label.len()..]
+        .split_whitespace()
+        .nth(1)
+        .unwrap()
+        .to_string()
+}
+
+/// Whether the host lets the supervisor reach its own defaults and the
+/// sandbox reach the values asked for here; on a host with lower hard
+/// limits the measured values are the host's, not ai-jail's.
+fn host_is_roomy() -> bool {
+    let nofile = host_hard("Max open files");
+    let roomy = nofile == "unlimited"
+        || nofile.parse::<u64>().is_ok_and(|n| n >= 100000);
+    if !roomy {
+        eprintln!("SKIPPED: host hard nofile {nofile} is below 100000");
+    }
+    roomy
+}
+
+#[test]
+fn dry_run_leaves_values_within_the_ceiling_unmarked() {
+    // The marker must not fire when the ceiling changed nothing.
+    require_bwrap!();
+    if !host_is_roomy() {
+        return;
+    }
+    let flags = ["--rlimit", "nofile=1024", "--rlimit", "core=0"];
+    let stdout = dry_run(&flags);
+    let nofile = line(&stdout, "nofile");
+    let core = line(&stdout, "core");
+    assert_eq!(field(nofile, "soft"), Some("1024"), "{nofile}");
+    assert_eq!(field(core, "soft"), Some("0"), "{core}");
+    assert_eq!(field(nofile, "ceiling"), None, "{nofile}");
+    assert_eq!(field(core, "ceiling"), None, "{core}");
+    let (in_nofile, in_core, _) = measured(&flags);
+    assert_eq!(field(nofile, "soft"), Some(in_nofile.as_str()));
+    assert_eq!(field(core, "soft"), Some(in_core.as_str()));
+
+    // Asking for exactly the supervisor default is not a clamp either.
+    let stdout = dry_run(&["--rlimit", "nofile=65536"]);
+    let nofile = line(&stdout, "nofile");
+    assert_eq!(field(nofile, "soft"), Some("65536"), "{nofile}");
+    assert_eq!(field(nofile, "ceiling"), None, "{nofile}");
+}
+
+#[test]
+fn dry_run_reports_the_supervisor_ceiling_the_sandbox_gets() {
+    require_bwrap!();
+    if !host_is_roomy() {
+        return;
+    }
+    let flags = ["--rlimit", "nofile=100000", "--rlimit", "core=unlimited"];
+    let stdout = dry_run(&flags);
+    let nofile = line(&stdout, "nofile");
+    let core = line(&stdout, "core");
+    assert_eq!(field(nofile, "soft"), Some("65536"), "{nofile}");
+    assert_eq!(field(nofile, "hard"), Some("65536"), "{nofile}");
+    assert_eq!(field(core, "soft"), Some("0"), "{core}");
+    assert_eq!(field(core, "hard"), Some("0"), "{core}");
+    assert_eq!(field(nofile, "ceiling"), Some("supervisor"), "{nofile}");
+    assert_eq!(field(core, "ceiling"), Some("supervisor"), "{core}");
+    // The layer that asked is still named.
+    assert_eq!(field(nofile, "source"), Some("cli"), "{nofile}");
+    assert_eq!(field(core, "source"), Some("cli"), "{core}");
+
+    // The same flags on a real launch measure the same values.
+    let (in_nofile, in_core, _) = measured(&flags);
+    assert_eq!(field(nofile, "soft"), Some(in_nofile.as_str()), "{nofile}");
+    assert_eq!(field(core, "soft"), Some(in_core.as_str()), "{core}");
+}
+
+#[test]
+fn dry_run_without_the_default_set_prints_unlimited_unmarked() {
+    // With `--no-rlimits` the supervisor holds no ceiling, so the request
+    // is what is reported, and RLIM_INFINITY reads as typed.
+    require_bwrap!();
+    let stdout = dry_run(&[
+        "--no-rlimits",
+        "--rlimit",
+        "nofile=100000",
+        "--rlimit",
+        "core=unlimited",
+    ]);
+    let nofile = line(&stdout, "nofile");
+    let core = line(&stdout, "core");
+    assert_eq!(field(nofile, "soft"), Some("100000"), "{nofile}");
+    assert_eq!(field(core, "soft"), Some("unlimited"), "{core}");
+    assert_eq!(field(core, "hard"), Some("unlimited"), "{core}");
+    assert_eq!(field(nofile, "ceiling"), None, "{nofile}");
+    assert_eq!(field(core, "ceiling"), None, "{core}");
+    assert!(!stdout.contains("18446744073709551615"), "{stdout}");
+}
+
+#[test]
+fn launch_warns_about_the_clamp_in_the_operators_words() {
+    require_bwrap!();
+    if !host_is_roomy() {
+        return;
+    }
+    let (_, _, stderr) =
+        measured(&["--rlimit", "nofile=100000", "--rlimit", "core=unlimited"]);
+    // Reporting the ceiling in the dry run must not silence the launch:
+    // the operator asked for a value they are not getting.
+    let core: Vec<&str> = stderr
+        .lines()
+        .filter(|l| l.contains("RLIMIT_CORE"))
+        .collect();
+    assert_eq!(core.len(), 1, "one RLIMIT_CORE warning:\n{stderr}");
+    assert!(core[0].contains("requested unlimited"), "{}", core[0]);
+    assert!(core[0].contains("applied 0"), "{}", core[0]);
+    assert!(!stderr.contains("18446744073709551615"), "{stderr}");
+    let nofile: Vec<&str> = stderr
+        .lines()
+        .filter(|l| l.contains("RLIMIT_NOFILE"))
+        .collect();
+    assert_eq!(nofile.len(), 1, "one RLIMIT_NOFILE warning:\n{stderr}");
+    assert!(nofile[0].contains("requested 100000"), "{}", nofile[0]);
+    assert!(nofile[0].contains("applied 65536"), "{}", nofile[0]);
+}
diff --git a/tests/rlimit_host_ceiling.rs b/tests/rlimit_host_ceiling.rs
new file mode 100644
index 0000000..82cdf83
--- /dev/null
+++ b/tests/rlimit_host_ceiling.rs
@@ -0,0 +1,274 @@
+// `--dry-run` and the audit record report the soft and hard values the
+// sandbox actually receives when the host's own hard limit is the one that
+// binds, marked `ceiling=host`.
+//
+// The host limit is lowered for one launch only, by a `sh -c 'ulimit …;
+// exec ai-jail …'` wrapper: lowering a hard limit needs no privilege, and
+// ai-jail inherits it like any process started from a restricted shell.
+// For `cpu` the sandbox gets `min(soft, host)` as soft and `min(soft + 5,
+// host)` as hard, so a host limit below the request leaves no grace.
+//
+// Launches run without `--exec`, because `--exec` silences warnings, from a
+// temporary HOME, XDG_CONFIG_HOME and project directory, so the developer's
+// own config and history cannot leak in; they skip with a message when
+// bwrap cannot create namespaces or the host is already below the limit a
+// test lowers it to.
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use std::path::PathBuf;
+use std::process::{Command, Output, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new() -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR"))
+            .join(format!("rlimit-host-ceiling-{}-{id}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        for dir in [&project, &home, &xdg] {
+            std::fs::create_dir_all(dir).unwrap();
+        }
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+
+    /// Run `ai-jail --no-status-bar --no-save-config <flags> sh -c
+    /// <script>` from a shell that first runs `ulimit <host>`.
+    fn under_host(&self, host: &str, flags: &[&str], script: &str) -> Output {
+        let _lock = common::SANDBOX_RUN_LOCK
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        Command::new("sh")
+            .arg("-c")
+            .arg(format!("ulimit {host} && exec \"$0\" \"$@\""))
+            .arg(ai_jail())
+            .args(["--no-status-bar", "--no-save-config"])
+            .args(flags)
+            .args(["sh", "-c", script])
+            .current_dir(&self.project)
+            .env("HOME", &self.home)
+            .env("XDG_CONFIG_HOME", &self.xdg)
+            .env_remove("AI_JAIL_QUIET")
+            .env_remove("NO_COLOR")
+            .stdin(Stdio::null())
+            .output()
+            .expect("failed to spawn ai-jail")
+    }
+
+    /// The last record of this tree's audit log.
+    fn last_record(&self) -> serde_json::Value {
+        let log = self.home.join(".local/share/ai-jail/history.jsonl");
+        let content = std::fs::read_to_string(&log)
+            .unwrap_or_else(|e| panic!("no audit log at {log:?}: {e}"));
+        let last = content.lines().last().expect("an empty audit log");
+        serde_json::from_str(last).unwrap()
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+fn text(bytes: &[u8]) -> String {
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+fn assert_ok(out: &Output) -> String {
+    let stdout = text(&out.stdout);
+    assert!(
+        out.status.success(),
+        "ai-jail failed ({:?}): stdout={stdout}\nstderr={}",
+        out.status,
+        text(&out.stderr)
+    );
+    stdout
+}
+
+/// The dry run's `rlimit name=<name> ...` line under a lowered host.
+fn dry_run(host: &str, flags: &[&str], name: &str) -> String {
+    let tree = Tree::new();
+    let mut all = vec!["--dry-run"];
+    all.extend_from_slice(flags);
+    let stdout = assert_ok(&tree.under_host(host, &all, "true"));
+    let prefix = format!("rlimit name={name} ");
+    stdout
+        .lines()
+        .find(|l| l.starts_with(&prefix))
+        .unwrap_or_else(|| panic!("no {prefix:?} line in:\n{stdout}"))
+        .to_string()
+}
+
+/// The value of `key=` on a dry-run line.
+fn field<'a>(line: &'a str, key: &str) -> Option<&'a str> {
+    let prefix = format!("{key}=");
+    line.split_whitespace()
+        .find_map(|w| w.strip_prefix(prefix.as_str()))
+}
+
+/// The soft and hard columns of a `/proc/<pid>/limits` row.
+fn limits_row(limits: &str, label: &str) -> (String, String) {
+    let row = limits
+        .lines()
+        .find(|l| l.starts_with(label))
+        .unwrap_or_else(|| panic!("no {label} row in:\n{limits}"));
+    let mut cols = row[label.len()..].split_whitespace();
+    let soft = cols.next().unwrap().to_string();
+    let hard = cols.next().unwrap().to_string();
+    (soft, hard)
+}
+
+/// `/proc/self/limits` measured inside a real launch under the host.
+fn measured(host: &str, flags: &[&str], label: &str) -> (String, String) {
+    let tree = Tree::new();
+    let script = format!("grep '^{label}' /proc/self/limits");
+    let stdout = assert_ok(&tree.under_host(host, flags, &script));
+    limits_row(&stdout, label)
+}
+
+/// Whether the test process's own hard limit for `label` is at least
+/// `floor`, so `ulimit` can lower it there.
+fn host_allows(label: &str, floor: u64) -> bool {
+    let limits = std::fs::read_to_string("/proc/self/limits").unwrap();
+    let (_, hard) = limits_row(&limits, label);
+    let roomy =
+        hard == "unlimited" || hard.parse::<u64>().is_ok_and(|n| n >= floor);
+    if !roomy {
+        eprintln!("SKIPPED: host hard {label:?} {hard} is below {floor}");
+    }
+    roomy
+}
+
+const CPU: &str = "Max cpu time";
+const NOFILE: &str = "Max open files";
+
+#[test]
+fn dry_run_leaves_cpu_unmarked_when_the_host_limit_is_roomy() {
+    // The marker must not fire when the host changed nothing: a host
+    // limit above the request and its grace, and one exactly at the grace.
+    require_bwrap!();
+    if !host_allows(CPU, 100) {
+        return;
+    }
+    for host in ["-t 100", "-t 65"] {
+        let line = dry_run(host, &["--rlimit", "cpu=60"], "cpu");
+        assert_eq!(field(&line, "soft"), Some("60"), "{host}: {line}");
+        assert_eq!(field(&line, "hard"), Some("65"), "{host}: {line}");
+        assert_eq!(field(&line, "ceiling"), None, "{host}: {line}");
+        assert_eq!(field(&line, "source"), Some("cli"), "{host}: {line}");
+    }
+}
+
+#[test]
+fn dry_run_reports_the_host_cpu_limit_the_sandbox_gets() {
+    require_bwrap!();
+    if !host_allows(CPU, 30) {
+        return;
+    }
+    let flags = ["--rlimit", "cpu=60"];
+    let line = dry_run("-t 30", &flags, "cpu");
+    assert_eq!(field(&line, "soft"), Some("30"), "{line}");
+    assert_eq!(field(&line, "hard"), Some("30"), "{line}");
+    assert_eq!(field(&line, "ceiling"), Some("host"), "{line}");
+    // The layer that asked is still named.
+    assert_eq!(field(&line, "source"), Some("cli"), "{line}");
+
+    // The same flags on a real launch under the same host measure it.
+    let (soft, hard) = measured("-t 30", &flags, CPU);
+    assert_eq!(field(&line, "soft"), Some(soft.as_str()), "{line}");
+    assert_eq!(field(&line, "hard"), Some(hard.as_str()), "{line}");
+}
+
+#[test]
+fn dry_run_shortens_the_cpu_grace_to_the_host_limit() {
+    // The request fits under the host limit, its grace does not.
+    require_bwrap!();
+    if !host_allows(CPU, 62) {
+        return;
+    }
+    let flags = ["--rlimit", "cpu=60"];
+    let line = dry_run("-t 62", &flags, "cpu");
+    assert_eq!(field(&line, "soft"), Some("60"), "{line}");
+    assert_eq!(field(&line, "hard"), Some("62"), "{line}");
+    let (soft, hard) = measured("-t 62", &flags, CPU);
+    assert_eq!((soft.as_str(), hard.as_str()), ("60", "62"));
+}
+
+#[test]
+fn dry_run_reports_the_host_nofile_below_the_supervisor_default() {
+    // The supervisor would hold `nofile` at 65536; a host limit of 2048 is
+    // lower still, so it is the value and the ceiling shown.
+    require_bwrap!();
+    if !host_allows(NOFILE, 2048) {
+        return;
+    }
+    let flags = ["--rlimit", "nofile=100000"];
+    let line = dry_run("-n 2048", &flags, "nofile");
+    assert_eq!(field(&line, "soft"), Some("2048"), "{line}");
+    assert_eq!(field(&line, "hard"), Some("2048"), "{line}");
+    assert_eq!(field(&line, "ceiling"), Some("host"), "{line}");
+    let (soft, hard) = measured("-n 2048", &flags, NOFILE);
+    assert_eq!((soft.as_str(), hard.as_str()), ("2048", "2048"));
+}
+
+#[test]
+fn audit_record_holds_the_host_cpu_limit_the_sandbox_gets() {
+    require_bwrap!();
+    if !host_allows(CPU, 30) {
+        return;
+    }
+    let tree = Tree::new();
+    let out = tree.under_host(
+        "-t 30",
+        &["--audit-log", "--rlimit", "cpu=60"],
+        &format!("grep '^{CPU}' /proc/self/limits"),
+    );
+    let stdout = assert_ok(&out);
+    let (in_soft, in_hard) = limits_row(&stdout, CPU);
+    assert_eq!((in_soft.as_str(), in_hard.as_str()), ("30", "30"));
+
+    let record = tree.last_record();
+    assert_eq!(record["type"], "launch");
+    let rlimits = record["rlimits"].as_array().expect("rlimits array");
+    let cpu = rlimits
+        .iter()
+        .find(|r| r["name"] == "cpu")
+        .unwrap_or_else(|| panic!("no cpu entry in {record}"));
+    assert_eq!(cpu["soft"], 30, "{cpu}");
+    assert_eq!(cpu["hard"], 30, "{cpu}");
+    assert_eq!(cpu["source"], "cli", "{cpu}");
+    // The record and the sandbox agree, number for number.
+    assert_eq!(cpu["soft"].to_string(), in_soft, "{cpu}");
+    assert_eq!(cpu["hard"].to_string(), in_hard, "{cpu}");
+
+    // Reporting the host value must not silence the launch: the operator
+    // asked for a value they are not getting, and hears it once.
+    let stderr = text(&out.stderr);
+    let warned: Vec<&str> = stderr
+        .lines()
+        .filter(|l| l.contains("RLIMIT_CPU"))
+        .collect();
+    assert_eq!(warned.len(), 1, "one RLIMIT_CPU warning:\n{stderr}");
+    assert!(warned[0].contains("requested 60"), "{}", warned[0]);
+    assert!(warned[0].contains("30"), "{}", warned[0]);
+}
diff --git a/tests/rlimit_project_save.rs b/tests/rlimit_project_save.rs
new file mode 100644
index 0000000..6156bd1
--- /dev/null
+++ b/tests/rlimit_project_save.rs
@@ -0,0 +1,303 @@
+// The project's own limit survives save and migration, through the built
+// binary.
+//
+// Both cases use a trusted `nproc = 8192` above the built-in default
+// (4096) and a project `nproc = 6000` between the two.
+//
+// - External project document: a real launch auto-saves the policy; the
+//   next `--dry-run` must still report the project's 6000.
+// - Legacy repository `.ai-jail`: the launch that migrates it must run at
+//   the 6000 `--dry-run` reported, and the written project document must
+//   hold `nproc = 6000` before the legacy file is gone.
+//
+// Each test runs with a temporary HOME, XDG_CONFIG_HOME and project
+// directory, so the developer's own config cannot leak in. Tests skip
+// with a message when bwrap cannot create user namespaces.
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use sha2::{Digest, Sha256};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+const GLOBAL_NPROC_8192: &str = "[rlimit]\nnproc = 8192\n";
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new(name: &str) -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!(
+            "rlimit-project-save-{name}-{}-{id}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        for dir in [&project, &home, &xdg] {
+            std::fs::create_dir_all(dir).unwrap();
+        }
+        let project = project.canonicalize().unwrap();
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+
+    fn store(&self) -> PathBuf {
+        self.xdg.join("ai-jail")
+    }
+
+    fn prepare_store(&self) {
+        let projects = self.store().join("projects");
+        std::fs::create_dir_all(&projects).unwrap();
+        for dir in [self.store(), projects] {
+            std::fs::set_permissions(
+                dir,
+                std::fs::Permissions::from_mode(0o700),
+            )
+            .unwrap();
+        }
+    }
+
+    fn write_private(&self, path: &Path, text: &str) {
+        std::fs::write(path, text).unwrap();
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))
+            .unwrap();
+    }
+
+    fn write_global(&self, text: &str) {
+        self.prepare_store();
+        self.write_private(&self.store().join("config.toml"), text);
+    }
+
+    fn project_doc_path(&self) -> PathBuf {
+        self.store()
+            .join("projects")
+            .join(format!("{}.toml", project_key(&self.project)))
+    }
+
+    /// The external project document, as onboarding saves it, carrying
+    /// `constraints` (a TOML body for `[constraints.rlimit]`).
+    fn write_project_doc(&self, rlimit_constraints: &str) {
+        self.prepare_store();
+        let key = project_key(&self.project);
+        let doc = format!(
+            "schema_version = 1\nonboarding_complete = true\n\n[project]\n\
+             canonical_path = {:?}\nkey = {key:?}\n\n[constraints.rlimit]\n\
+             {rlimit_constraints}",
+            self.project.to_str().unwrap()
+        );
+        self.write_private(&self.project_doc_path(), &doc);
+    }
+
+    fn run(&self, args: &[&str]) -> Output {
+        let _lock = common::SANDBOX_RUN_LOCK
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        Command::new(ai_jail())
+            .args(args)
+            .current_dir(&self.project)
+            .env("HOME", &self.home)
+            .env("XDG_CONFIG_HOME", &self.xdg)
+            .env_remove("AI_JAIL_QUIET")
+            .env_remove("NO_COLOR")
+            .stdin(Stdio::null())
+            .output()
+            .expect("failed to run ai-jail")
+    }
+
+    /// A real launch of `sh -c script` that auto-saves, as an ordinary
+    /// run does.
+    fn launch(&self, script: &str) -> Output {
+        self.run(&["--no-status-bar", "sh", "-c", script])
+    }
+
+    /// `--dry-run sh` from the project; never auto-saves.
+    fn dry_run(&self) -> Output {
+        self.run(&["--no-status-bar", "--dry-run", "sh"])
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+/// Same formula as `project_identity` in src/config_store.rs.
+fn project_key(canonical: &Path) -> String {
+    let digest =
+        format!("{:x}", Sha256::digest(canonical.as_os_str().as_bytes()));
+    let base = canonical
+        .file_name()
+        .and_then(std::ffi::OsStr::to_str)
+        .unwrap()
+        .chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '-' || c == '_' {
+                c
+            } else {
+                '-'
+            }
+        })
+        .collect::<String>();
+    format!("{base}-{}", &digest[..20])
+}
+
+fn stdout(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stdout).into_owned()
+}
+
+fn stderr(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stderr).into_owned()
+}
+
+fn assert_ok(o: &Output) -> String {
+    assert!(
+        o.status.success(),
+        "ai-jail failed: status={:?}\nstdout={}\nstderr={}",
+        o.status,
+        stdout(o),
+        stderr(o)
+    );
+    stdout(o) + &stderr(o)
+}
+
+/// The `rlimit name=nproc ...` line of a `--dry-run`.
+fn nproc_line(dry_run: &Output) -> String {
+    let text = assert_ok(dry_run);
+    text.lines()
+        .map(str::trim)
+        .find(|l| l.starts_with("rlimit name=nproc "))
+        .map(str::to_string)
+        .unwrap_or_else(|| panic!("no nproc line in the dry run: {text}"))
+}
+
+/// `soft=` of a `--dry-run` rlimit line.
+fn soft_of(line: &str) -> String {
+    line.split_whitespace()
+        .find_map(|w| w.strip_prefix("soft="))
+        .unwrap_or_else(|| panic!("no soft= in {line}"))
+        .to_string()
+}
+
+/// The last non-empty stdout line of a launch (the script's output).
+fn last_line(o: &Output) -> String {
+    assert_ok(o);
+    stdout(o)
+        .lines()
+        .map(str::trim)
+        .rfind(|l| !l.is_empty())
+        .unwrap_or_else(|| panic!("no output: {}", stderr(o)))
+        .to_string()
+}
+
+/// `constraints.rlimit.nproc` of a written project document, as text
+/// (the store may write it as an integer or as a string).
+fn doc_nproc(path: &Path) -> Option<String> {
+    let text = std::fs::read_to_string(path)
+        .unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    let doc: toml::Value = toml::from_str(&text).unwrap();
+    let value = doc.get("constraints")?.get("rlimit")?.get("nproc")?;
+    Some(match value {
+        toml::Value::String(s) => s.clone(),
+        other => other.to_string(),
+    })
+}
+
+#[test]
+fn external_project_nproc_survives_a_launch_under_a_raised_global() {
+    require_bwrap!();
+    let tree = Tree::new("external");
+    tree.write_global(GLOBAL_NPROC_8192);
+    tree.write_project_doc("nproc = 6000\n");
+
+    let before = nproc_line(&tree.dry_run());
+    assert!(
+        before.contains("soft=6000") && before.contains("source=project"),
+        "precondition, the project's 6000 applies: {before}"
+    );
+
+    // A real launch runs at 6000 and auto-saves the project policy.
+    let out = tree.launch("ulimit -u");
+    assert_eq!(last_line(&out), "6000", "stderr={}", stderr(&out));
+
+    let after = nproc_line(&tree.dry_run());
+    assert!(
+        after.contains("soft=6000") && after.contains("source=project"),
+        "the saved policy lost the project's 6000: {after}\ndocument={}",
+        std::fs::read_to_string(tree.project_doc_path()).unwrap_or_default()
+    );
+    assert_eq!(
+        doc_nproc(&tree.project_doc_path()).as_deref(),
+        Some("6000"),
+        "the document keeps nproc = 6000"
+    );
+}
+
+#[test]
+fn legacy_project_nproc_is_applied_and_kept_by_the_migrating_launch() {
+    require_bwrap!();
+    let tree = Tree::new("legacy");
+    tree.write_global(GLOBAL_NPROC_8192);
+    let legacy = tree.project.join(".ai-jail");
+    std::fs::write(&legacy, "[rlimit]\nnproc = 6000\n").unwrap();
+
+    // What `--dry-run` reports for this launch (it does not migrate).
+    let reported = nproc_line(&tree.dry_run());
+    assert!(
+        reported.contains("source=project"),
+        "precondition: {reported}"
+    );
+    let reported = soft_of(&reported);
+    assert_eq!(reported, "6000", "precondition, the dry run's value");
+
+    // The launch that migrates the legacy file applies that same value.
+    let out = tree.launch("ulimit -u");
+    assert_eq!(
+        last_line(&out),
+        reported,
+        "the migrating launch ran at a different nproc than --dry-run \
+         reported; stderr={}",
+        stderr(&out)
+    );
+
+    // The project document now carries the entry; the legacy file may
+    // only be gone once it does.
+    let doc = tree.project_doc_path();
+    assert!(
+        doc.exists(),
+        "no project document written: stderr={}",
+        stderr(&out)
+    );
+    assert_eq!(
+        doc_nproc(&doc).as_deref(),
+        Some("6000"),
+        "the migrated document dropped nproc = 6000 (legacy file still \
+         there: {}); document={}",
+        legacy.exists(),
+        std::fs::read_to_string(&doc).unwrap_or_default()
+    );
+
+    let next = nproc_line(&tree.dry_run());
+    assert!(
+        next.contains("soft=6000") && next.contains("source=project"),
+        "the next launch keeps the migrated 6000: {next}"
+    );
+}
diff --git a/tests/rlimit_supervisor.rs b/tests/rlimit_supervisor.rs
new file mode 100644
index 0000000..f108376
--- /dev/null
+++ b/tests/rlimit_supervisor.rs
@@ -0,0 +1,241 @@
+// An explicit `core` or `nofile` never loosens ai-jail's own supervisor,
+// measured on the running processes: the supervisor's
+// `/proc/<pid>/limits` while the sandbox sleeps, and the sandbox's own
+// `/proc/self/limits`.
+//
+// The supervisor is the spawned ai-jail process itself (it applies its
+// limits, then forks bwrap). The launching shell first makes itself
+// dumpable (core soft = hard) and lowers its `nofile` soft limit, so a
+// supervisor that inherits instead of
+// applying its defaults then shows `unlimited` / the low value.
+//
+// Each test runs with a temporary HOME, XDG_CONFIG_HOME and project
+// directory, so the developer's own config cannot leak in, and skips with a
+// message when bwrap cannot create namespaces.
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new(name: &str) -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!(
+            "rlimit-supervisor-{name}-{}-{id}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        for dir in [&project, &home, &xdg] {
+            std::fs::create_dir_all(dir).unwrap();
+        }
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+
+    /// Spawn `ai-jail --no-status-bar --no-save-config <flags> sh -c
+    /// '<script>'` from a shell that is dumpable and has `nofile` soft 2048.
+    /// The shell `exec`s, so the child's pid is the supervisor's.
+    fn spawn(&self, flags: &[&str], script: &str) -> Child {
+        let mut args = vec!["--no-status-bar", "--no-save-config"];
+        args.extend_from_slice(flags);
+        args.extend_from_slice(&["sh", "-c", script]);
+        Command::new("sh")
+            .arg("-c")
+            .arg(
+                "ulimit -S -c \"$(ulimit -H -c)\" && ulimit -S -n 2048 \
+                 && exec \"$0\" \"$@\"",
+            )
+            .arg(ai_jail())
+            .args(&args)
+            .current_dir(&self.project)
+            .env("HOME", &self.home)
+            .env("XDG_CONFIG_HOME", &self.xdg)
+            .env_remove("AI_JAIL_QUIET")
+            .env_remove("NO_COLOR")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("failed to spawn ai-jail")
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+/// Soft and hard columns of the `label` line of a limits dump.
+fn limit(limits: &str, label: &str) -> (String, String) {
+    let line = limits
+        .lines()
+        .find(|l| l.starts_with(label))
+        .unwrap_or_else(|| panic!("no {label} line in {limits}"));
+    let mut cols = line[label.len()..].split_whitespace();
+    (
+        cols.next().unwrap().to_string(),
+        cols.next().unwrap().to_string(),
+    )
+}
+
+fn pair(soft: &str, hard: &str) -> (String, String) {
+    (soft.to_string(), hard.to_string())
+}
+
+/// The last line of a `/proc/<pid>/limits` dump.
+const LAST_LIMIT_LINE: &str = "Max realtime timeout";
+
+/// Read the sandbox's stdout until its `/proc/self/limits` dump is complete.
+/// The sandbox prints it before sleeping, so the supervisor has applied its
+/// own limits by then (it forks other helpers earlier, so "has a child" is
+/// not enough).
+fn read_sandbox_dump(child: &mut Child) -> String {
+    let stdout = child.stdout.as_mut().expect("piped stdout");
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let mut seen = Vec::new();
+    let mut buf = [0u8; 4096];
+    loop {
+        let text = String::from_utf8_lossy(&seen).into_owned();
+        if let Some(i) = text.find(LAST_LIMIT_LINE)
+            && text[i..].contains('\n')
+        {
+            return text;
+        }
+        assert!(Instant::now() < deadline, "no limits dump: {text}");
+        match stdout.read(&mut buf) {
+            Ok(0) => {
+                let mut err = String::new();
+                if let Some(e) = child.stderr.as_mut() {
+                    let _ = e.read_to_string(&mut err);
+                }
+                panic!("ai-jail closed stdout early: {text}\nstderr={err}");
+            }
+            Ok(n) => seen.extend_from_slice(&buf[..n]),
+            Err(e) => panic!("read ai-jail stdout: {e}"),
+        }
+    }
+}
+
+/// Run one launch: the supervisor's `/proc/<pid>/limits` during the
+/// sandbox's sleep, and what the sandbox printed for `/proc/self/limits`.
+fn launch(flags: &[&str]) -> (String, String) {
+    let _lock = common::SANDBOX_RUN_LOCK
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let tree = Tree::new("launch");
+    let mut child = tree.spawn(flags, "cat /proc/self/limits; sleep 3");
+    let sandbox = read_sandbox_dump(&mut child);
+    let pid = child.id();
+    let supervisor =
+        std::fs::read_to_string(Path::new(&format!("/proc/{pid}/limits")))
+            .expect("read the supervisor's limits during the sleep");
+    let out = child.wait_with_output().expect("wait for ai-jail");
+    assert!(
+        out.status.success(),
+        "ai-jail failed: status={:?}\nstdout={sandbox}{}\nstderr={}",
+        out.status,
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    (supervisor, sandbox)
+}
+
+#[test]
+fn supervisor_without_explicit_limits_runs_at_the_defaults() {
+    // Baseline the explicit cases must match: no flag, defaults applied.
+    require_bwrap!();
+    let (supervisor, sandbox) = launch(&[]);
+    assert_eq!(
+        limit(&supervisor, "Max core file size"),
+        pair("0", "0"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&supervisor, "Max open files"),
+        pair("65536", "65536"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&sandbox, "Max core file size"),
+        pair("0", "0"),
+        "sandbox:\n{sandbox}"
+    );
+}
+
+#[test]
+fn supervisor_keeps_core_zero_when_core_zero_is_explicit() {
+    // An explicit `core=0` must not remove the supervisor's core limit:
+    // the supervisor holds the egress proxy and its secret substitution.
+    require_bwrap!();
+    let (supervisor, sandbox) = launch(&["--rlimit", "core=0"]);
+    assert_eq!(
+        limit(&supervisor, "Max core file size"),
+        pair("0", "0"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&sandbox, "Max core file size"),
+        pair("0", "0"),
+        "sandbox:\n{sandbox}"
+    );
+}
+
+#[test]
+fn supervisor_keeps_its_nofile_default_whatever_nofile_is_explicit() {
+    require_bwrap!();
+    // Asking for the default value must not hand the supervisor the
+    // launching shell's 2048.
+    let (supervisor, sandbox) =
+        launch(&["--rlimit", "core=0", "--rlimit", "nofile=65536"]);
+    assert_eq!(
+        limit(&supervisor, "Max open files"),
+        pair("65536", "65536"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&supervisor, "Max core file size"),
+        pair("0", "0"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&sandbox, "Max open files"),
+        pair("65536", "65536"),
+        "sandbox:\n{sandbox}"
+    );
+    // The converse: a tighter explicit value is the sandbox's alone and
+    // does not reach the supervisor.
+    let (supervisor, sandbox) = launch(&["--rlimit", "nofile=1024"]);
+    assert_eq!(
+        limit(&supervisor, "Max open files"),
+        pair("65536", "65536"),
+        "supervisor:\n{supervisor}"
+    );
+    assert_eq!(
+        limit(&sandbox, "Max open files"),
+        pair("1024", "1024"),
+        "sandbox:\n{sandbox}"
+    );
+}
diff --git a/tests/rlimit_supervisor_fsize.rs b/tests/rlimit_supervisor_fsize.rs
new file mode 100644
index 0000000..af0b537
--- /dev/null
+++ b/tests/rlimit_supervisor_fsize.rs
@@ -0,0 +1,314 @@
+// Under `--lockdown` an explicit `fsize` never loosens ai-jail's own
+// supervisor, measured on the running processes: the supervisor's
+// `/proc/<pid>/limits` while the sandbox sleeps, and the sandbox's own
+// `/proc/self/limits`.
+//
+// The supervisor is the spawned ai-jail process itself (it applies its
+// limits, then forks bwrap). Lockdown's 1 GiB `fsize` default stays on it
+// whether the explicit `fsize` comes from the CLI or from a legacy project
+// `.ai-jail` (untrusted input); the explicit value is the sandbox's. The
+// file-size clamp is reported at most once per launch.
+//
+// Each test runs with a temporary HOME, XDG_CONFIG_HOME and project
+// directory, so the developer's own config cannot leak in, and skips with a
+// message when bwrap cannot create network namespaces (lockdown needs one).
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use std::{
+    io::Read,
+    path::{Path, PathBuf},
+    process::{Child, Command, Stdio},
+    sync::atomic::{AtomicUsize, Ordering},
+    time::{Duration, Instant},
+};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+const ONE_GIB: &str = "1073741824";
+const HALF_GIB: &str = "536870912";
+const QUARTER_GIB: &str = "268435456";
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new(name: &str) -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!(
+            "rlimit-supervisor-fsize-{name}-{}-{id}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        for dir in [&project, &home, &xdg] {
+            std::fs::create_dir_all(dir).unwrap();
+        }
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+
+    /// Spawn `ai-jail --no-status-bar <flags> sh -c '<script>'`. With
+    /// `host_fsize`, util-linux `prlimit` sets that soft and hard `fsize`
+    /// first and execs ai-jail, so in both cases the child's pid is the
+    /// supervisor's.
+    fn spawn(
+        &self,
+        flags: &[&str],
+        script: &str,
+        host_fsize: Option<&str>,
+    ) -> Child {
+        let mut command = match host_fsize {
+            Some(bytes) => {
+                let mut c = Command::new("prlimit");
+                c.arg(format!("--fsize={bytes}:{bytes}"))
+                    .arg("--")
+                    .arg(ai_jail());
+                c
+            }
+            None => Command::new(ai_jail()),
+        };
+        command
+            .arg("--no-status-bar")
+            .args(flags)
+            .args(["sh", "-c", script])
+            .current_dir(&self.project)
+            .env("HOME", &self.home)
+            .env("XDG_CONFIG_HOME", &self.xdg)
+            .env_remove("AI_JAIL_QUIET")
+            .env_remove("NO_COLOR")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+        command.spawn().expect("failed to spawn ai-jail")
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+fn prlimit_available() -> bool {
+    Command::new("prlimit")
+        .arg("--version")
+        .output()
+        .map(|o| o.status.success())
+        .unwrap_or(false)
+}
+
+/// Soft and hard columns of the `label` line of a limits dump.
+fn limit(limits: &str, label: &str) -> (String, String) {
+    let line = limits
+        .lines()
+        .find(|l| l.starts_with(label))
+        .unwrap_or_else(|| panic!("no {label} line in {limits}"));
+    let mut cols = line[label.len()..].split_whitespace();
+    (
+        cols.next().unwrap().to_string(),
+        cols.next().unwrap().to_string(),
+    )
+}
+
+fn pair(soft: &str, hard: &str) -> (String, String) {
+    (soft.to_string(), hard.to_string())
+}
+
+const FSIZE: &str = "Max file size";
+
+/// The last line of a `/proc/<pid>/limits` dump.
+const LAST_LIMIT_LINE: &str = "Max realtime timeout";
+
+/// Read the sandbox's stdout until its `/proc/self/limits` dump is complete.
+/// The sandbox prints it before sleeping, so the supervisor has applied its
+/// own limits by then.
+fn read_sandbox_dump(child: &mut Child) -> String {
+    let stdout = child.stdout.as_mut().expect("piped stdout");
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let mut seen = Vec::new();
+    let mut buf = [0u8; 4096];
+    loop {
+        let text = String::from_utf8_lossy(&seen).into_owned();
+        if let Some(i) = text.find(LAST_LIMIT_LINE)
+            && text[i..].contains('\n')
+        {
+            return text;
+        }
+        assert!(Instant::now() < deadline, "no limits dump: {text}");
+        match stdout.read(&mut buf) {
+            Ok(0) => {
+                let mut err = String::new();
+                if let Some(e) = child.stderr.as_mut() {
+                    let _ = e.read_to_string(&mut err);
+                }
+                panic!("ai-jail closed stdout early: {text}\nstderr={err}");
+            }
+            Ok(n) => seen.extend_from_slice(&buf[..n]),
+            Err(e) => panic!("read ai-jail stdout: {e}"),
+        }
+    }
+}
+
+struct Launch {
+    supervisor: String,
+    sandbox: String,
+    stderr: String,
+}
+
+impl Launch {
+    /// The stderr lines that report the file-size limit.
+    fn fsize_lines(&self) -> Vec<&str> {
+        self.stderr
+            .lines()
+            .filter(|l| l.contains("RLIMIT_FSIZE"))
+            .collect()
+    }
+}
+
+/// Run one launch in `tree`: the supervisor's `/proc/<pid>/limits` during
+/// the sandbox's sleep, the sandbox's own dump, and ai-jail's stderr.
+fn launch_in(tree: &Tree, flags: &[&str], host_fsize: Option<&str>) -> Launch {
+    let _lock = common::SANDBOX_RUN_LOCK
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let mut child =
+        tree.spawn(flags, "cat /proc/self/limits; sleep 3", host_fsize);
+    let sandbox = read_sandbox_dump(&mut child);
+    let pid = child.id();
+    let supervisor =
+        std::fs::read_to_string(Path::new(&format!("/proc/{pid}/limits")))
+            .expect("read the supervisor's limits during the sleep");
+    let out = child.wait_with_output().expect("wait for ai-jail");
+    let stderr = String::from_utf8_lossy(&out.stderr).into_owned();
+    assert!(
+        out.status.success(),
+        "ai-jail failed: status={:?}\nstdout={sandbox}{}\nstderr={stderr}",
+        out.status,
+        String::from_utf8_lossy(&out.stdout),
+    );
+    Launch {
+        supervisor,
+        sandbox,
+        stderr,
+    }
+}
+
+fn launch(flags: &[&str], host_fsize: Option<&str>) -> Launch {
+    launch_in(&Tree::new("cli"), flags, host_fsize)
+}
+
+/// The supervisor holds lockdown's 1 GiB, the sandbox the explicit 512 MiB,
+/// and the file-size limit is reported at most once.
+fn assert_supervisor_keeps_one_gib(run: &Launch) {
+    assert_eq!(
+        limit(&run.supervisor, FSIZE),
+        pair(ONE_GIB, ONE_GIB),
+        "supervisor:\n{}",
+        run.supervisor
+    );
+    assert_eq!(
+        limit(&run.sandbox, FSIZE),
+        pair(HALF_GIB, HALF_GIB),
+        "sandbox:\n{}",
+        run.sandbox
+    );
+    assert!(
+        run.fsize_lines().len() <= 1,
+        "the file-size limit reported more than once: {:?}",
+        run.fsize_lines()
+    );
+}
+
+#[test]
+fn supervisor_fsize_lockdown_without_explicit_fsize_runs_at_one_gib() {
+    // Baseline the explicit cases must match, green by design: lockdown's
+    // default on both processes.
+    require_bwrap_net!();
+    require_lockdown_tools!("cat", "sleep");
+    let run = launch(&["--lockdown"], None);
+    assert_eq!(
+        limit(&run.supervisor, FSIZE),
+        pair(ONE_GIB, ONE_GIB),
+        "supervisor:\n{}",
+        run.supervisor
+    );
+    assert_eq!(
+        limit(&run.sandbox, FSIZE),
+        pair(ONE_GIB, ONE_GIB),
+        "sandbox:\n{}",
+        run.sandbox
+    );
+}
+
+#[test]
+fn supervisor_fsize_keeps_one_gib_under_cli_fsize() {
+    // An explicit `fsize` must not drop lockdown's limit from the
+    // supervisor: the sandbox runs at 512 MiB, the supervisor at 1 GiB.
+    require_bwrap_net!();
+    require_lockdown_tools!("cat", "sleep");
+    let run = launch(&["--lockdown", "--rlimit", "fsize=512M"], None);
+    assert_supervisor_keeps_one_gib(&run);
+}
+
+#[test]
+fn supervisor_fsize_keeps_one_gib_under_legacy_project_fsize() {
+    // The repository's own `.ai-jail` is untrusted: its `fsize` must not
+    // loosen the process that holds the proxy's secrets. The launch is an
+    // ordinary one, so it also migrates the legacy file.
+    require_bwrap_net!();
+    require_lockdown_tools!("cat", "sleep");
+    let tree = Tree::new("legacy");
+    std::fs::write(
+        tree.project.join(".ai-jail"),
+        "lockdown = true\n\n[rlimit]\nfsize = \"512M\"\n",
+    )
+    .unwrap();
+    let run = launch_in(&tree, &[], None);
+    assert_supervisor_keeps_one_gib(&run);
+}
+
+#[test]
+fn supervisor_fsize_reports_a_lower_host_hard_limit_once() {
+    // Guard, green by design: with the host hard limit below both lockdown's
+    // default and the explicit value, the supervisor's default is clamped
+    // silently and the sandbox's clamp is the one line reported.
+    require_bwrap_net!();
+    require_lockdown_tools!("cat", "sleep");
+    if !prlimit_available() {
+        eprintln!("SKIPPED: util-linux prlimit not found in PATH");
+        return;
+    }
+    let run =
+        launch(&["--lockdown", "--rlimit", "fsize=512M"], Some(QUARTER_GIB));
+    assert_eq!(
+        limit(&run.supervisor, FSIZE),
+        pair(QUARTER_GIB, QUARTER_GIB),
+        "supervisor:\n{}",
+        run.supervisor
+    );
+    assert_eq!(
+        limit(&run.sandbox, FSIZE),
+        pair(QUARTER_GIB, QUARTER_GIB),
+        "sandbox:\n{}",
+        run.sandbox
+    );
+    assert_eq!(
+        run.fsize_lines().len(),
+        1,
+        "the clamp is reported exactly once: stderr={}",
+        run.stderr
+    );
+}
diff --git a/tests/rlimit_values.rs b/tests/rlimit_values.rs
new file mode 100644
index 0000000..c1ae7b2
--- /dev/null
+++ b/tests/rlimit_values.rs
@@ -0,0 +1,684 @@
+// Adjustable per-process limits and CPU affinity, observed through the
+// built binary.
+//
+// Launch-refusal and --dry-run tests need no sandbox. Tests that look
+// inside the jail need bwrap with user + network namespaces and skip with
+// a message when it is unavailable, through the shared harness in
+// `tests/common/mod.rs` (`require_bwrap_net!`, `ai_jail()`, `run_in()`).
+// Every launch runs with a temporary HOME, XDG_CONFIG_HOME and project
+// directory, so the developer's own global config cannot leak in. The
+// trusted global config is `$XDG_CONFIG_HOME/ai-jail/config.toml`
+// (upstream v3.3.0); `~/.ai-jail` is only the legacy file it migrates.
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use common::ai_jail;
+use std::os::unix::fs::PermissionsExt;
+use std::path::PathBuf;
+use std::process::{Command, Output, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+
+fn tool_available(bin: &str) -> bool {
+    Command::new(bin)
+        .arg("--version")
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status()
+        .is_ok_and(|s| s.success())
+}
+
+macro_rules! require_tool {
+    ($bin:expr) => {
+        if !tool_available($bin) {
+            eprintln!("SKIPPED: {} not found in PATH", $bin);
+            return;
+        }
+    };
+}
+
+struct Tree {
+    root: PathBuf,
+    project: PathBuf,
+    home: PathBuf,
+    xdg: PathBuf,
+}
+
+impl Tree {
+    fn new(name: &str) -> Self {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let root = PathBuf::from(env!("CARGO_TARGET_TMPDIR"))
+            .join(format!("rlimit-values-{name}-{}-{id}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let project = root.join("project");
+        let home = root.join("home");
+        let xdg = root.join("xdg");
+        std::fs::create_dir_all(&project).unwrap();
+        std::fs::create_dir_all(&home).unwrap();
+        std::fs::create_dir_all(&xdg).unwrap();
+        Self {
+            root,
+            project,
+            home,
+            xdg,
+        }
+    }
+
+    /// Write the trusted global config: `<xdg>/ai-jail/config.toml`,
+    /// directory 0700 and file 0600 as the store requires.
+    fn global(&self, body: &str) -> &Self {
+        let store = self.xdg.join("ai-jail");
+        std::fs::create_dir_all(&store).unwrap();
+        std::fs::set_permissions(
+            &store,
+            std::fs::Permissions::from_mode(0o700),
+        )
+        .unwrap();
+        let path = store.join("config.toml");
+        std::fs::write(&path, body).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))
+            .unwrap();
+        self
+    }
+
+    /// Write the legacy project policy (`.ai-jail` in the project), which
+    /// v3.3.0 still reads, untrusted, when no stored project policy exists.
+    fn project_file(&self, body: &str) -> &Self {
+        std::fs::write(self.project.join(".ai-jail"), body).unwrap();
+        self
+    }
+
+    fn run(&self, args: &[&str]) -> Output {
+        Command::new(ai_jail())
+            .args(args)
+            .current_dir(&self.project)
+            .env("HOME", &self.home)
+            .env("XDG_CONFIG_HOME", &self.xdg)
+            .env_remove("AI_JAIL_QUIET")
+            .stdin(Stdio::null())
+            .output()
+            .expect("failed to run ai-jail")
+    }
+
+    /// `--dry-run bash` with extra flags; no sandbox is started.
+    fn dry_run(&self, flags: &[&str]) -> Output {
+        let mut args = vec!["--no-status-bar", "--no-save-config"];
+        args.extend_from_slice(flags);
+        args.extend_from_slice(&["--dry-run", "bash"]);
+        self.run(&args)
+    }
+
+    /// Run `bash -c script` inside a real sandbox from the project, network
+    /// off, through the shared `run_in` (private HOME and config home).
+    fn jail(&self, flags: &[&str], script: &str) -> Output {
+        let mut all = vec!["--no-network"];
+        all.extend_from_slice(flags);
+        common::run_in(Some(&self.project), &all, script)
+    }
+
+    /// Like `jail`, but with this tree's HOME, so the audit log lands in
+    /// `<home>/.local/share/ai-jail/history.jsonl`.
+    fn jail_with_home(&self, flags: &[&str], script: &str) -> Output {
+        let _lock = common::SANDBOX_RUN_LOCK
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let mut args = vec![
+            "--no-status-bar",
+            "--exec",
+            "--no-save-config",
+            "--no-network",
+        ];
+        args.extend_from_slice(flags);
+        args.extend_from_slice(&["bash", "-c", script]);
+        self.run(&args)
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+fn stdout(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stdout).into_owned()
+}
+
+fn stderr(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stderr).into_owned()
+}
+
+fn assert_ok(o: &Output) -> String {
+    assert!(
+        o.status.success(),
+        "ai-jail failed: status={:?}\nstdout={}\nstderr={}",
+        o.status,
+        stdout(o),
+        stderr(o)
+    );
+    stdout(o)
+}
+
+fn assert_refused(o: &Output) -> String {
+    assert!(
+        !o.status.success(),
+        "launch must be refused\nstdout={}\nstderr={}",
+        stdout(o),
+        stderr(o)
+    );
+    stderr(o)
+}
+
+/// The `rlimit name=<n> ...` line of a --dry-run, from stdout or stderr.
+fn dry_run_limit_line(o: &Output, name: &str) -> Option<String> {
+    let prefix = format!("rlimit name={name} ");
+    stdout(o)
+        .lines()
+        .chain(stderr(o).lines().collect::<Vec<_>>())
+        .map(str::trim)
+        .find(|l| l.starts_with(&prefix))
+        .map(str::to_string)
+}
+
+fn field(line: &str, key: &str) -> Option<String> {
+    line.split_whitespace()
+        .find_map(|tok| tok.strip_prefix(&format!("{key}=")))
+        .map(str::to_string)
+}
+
+/// The CPUs this test process may use, from the kernel.
+fn allowed_cpus() -> Vec<usize> {
+    let list = std::fs::read_to_string("/proc/self/status")
+        .unwrap()
+        .lines()
+        .find_map(|l| l.strip_prefix("Cpus_allowed_list:"))
+        .map(|v| v.trim().to_string())
+        .unwrap();
+    let mut cpus = Vec::new();
+    for part in list.split(',') {
+        match part.split_once('-') {
+            Some((a, b)) => {
+                cpus.extend(a.parse::<usize>().unwrap()..=b.parse().unwrap())
+            }
+            None => cpus.push(part.parse().unwrap()),
+        }
+    }
+    cpus
+}
+
+fn allowed_list_text() -> String {
+    std::fs::read_to_string("/proc/self/status")
+        .unwrap()
+        .lines()
+        .find_map(|l| l.strip_prefix("Cpus_allowed_list:"))
+        .map(|v| v.trim().to_string())
+        .unwrap()
+}
