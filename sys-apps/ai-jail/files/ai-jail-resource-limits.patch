+        assert_eq!(pair(&got, "nofile"), (65536, 65536));
+        assert_eq!(pair(&got, "core"), (0, 0));
+        assert_eq!(marker(&got, "nofile"), Some("supervisor"));
+        assert_eq!(marker(&got, "core"), Some("supervisor"));
