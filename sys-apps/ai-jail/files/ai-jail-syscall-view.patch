+fn field(bytes: &[u8], i: usize) -> &str {
+    let f = &bytes[i * UTS_FIELD..(i + 1) * UTS_FIELD];
+    let end = f.iter().position(|b| *b == 0).unwrap();
+    std::str::from_utf8(&f[..end]).unwrap()
+}
