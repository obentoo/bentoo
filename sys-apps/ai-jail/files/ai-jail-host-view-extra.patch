+    assert!(!tmpfs_at(&plan, "/proc/pressure"));
+    assert_eq!(bound_from(&plan, "/proc/sys/kernel/random/boot_id"), None);
+    assert!(bound_from(&plan, "/proc/partitions").is_some());
