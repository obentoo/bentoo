+    let script = r#"
+awk '$5=="/usr" || $5=="/etc" {print "src" $5 "=" $(NF-1)}' /proc/self/mountinfo
+echo "hosts=$(wc -c < /etc/hosts)"
+echo "crypttab=$(wc -c < /etc/crypttab 2>/dev/null || echo absent)"
+echo "usrmode=$(stat -c %a /usr)"
