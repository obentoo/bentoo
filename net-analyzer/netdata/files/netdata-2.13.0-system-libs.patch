-                        "${sqlite_OUTPUT_DIR}/sqlite3.h"
-                        "${sqlite_OUTPUT_DIR}/sqlite3recover.c"
-                        "${sqlite_OUTPUT_DIR}/sqlite3recover.h"
-                        "${sqlite_OUTPUT_DIR}/dbdata.c"
