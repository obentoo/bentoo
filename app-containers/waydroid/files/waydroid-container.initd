# Counterpart of waydroid-container.service: same scope (system), same
# command, same umask. The container manager claims id.waydro.Container on
# the system bus, so D-Bus must be up before it starts.

description="Waydroid Android container manager"
supervisor="supervise-daemon"
command="/usr/bin/waydroid"
command_args="container start"
pidfile="/run/${RC_SVCNAME}.pid"
umask=0022
retry="TERM/30/KILL/5"

depend() {
	need dbus localmount
	after net
}
