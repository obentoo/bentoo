declare -A GIT_CRATES=(
	[cudaforge]='https://github.com/jbg/cudaforge;e7c1967340e40673db98dc9e17da0f04834a456f;cudaforge-%commit%'
)

CUDAFORGE_COMMIT="e7c1967340e40673db98dc9e17da0f04834a456f"

inherit cargo

DESCRIPTION="Local, extensible AI agent that executes, edits and tests code, with MCP support"
HOMEPAGE="https://goose-docs.ai/ https://github.com/aaif-goose/goose"
# Upstream moved from block/goose to aaif-goose/goose; the old path resolves
# only through a GitHub 301 that can be withdrawn at any time.
SRC_URI="
	https://github.com/aaif-goose/goose/releases/download/v${PV}/goose-source-v${PV}.tar.gz
		-> ${P}.tar.gz
"
# cargo.eclass computes CARGO_CRATE_URIS from CRATES but does NOT touch
# SRC_URI, so the crates have to be appended by hand. Appending after the
# assignment above matters: a plain SRC_URI="..." here would drop all of them.
SRC_URI+=" ${CARGO_CRATE_URIS}"
S="${WORKDIR}/goose-v${PV}"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3+ MIT MIT-0 MPL-2.0 MPL-2.0
	Unicode-3.0 Unlicense ZLIB BZIP2
"
SLOT="0"
KEYWORDS="~amd64"

# Upstream's default feature set is not reproduced verbatim, and each
# difference is deliberate:
#
#   local-inference  off by default. It pulls candle plus llama-cpp-sys-2,
#                    which builds a full llama.cpp through cmake -- a large
#                    build most users of an agent CLI do not want, and one
#                    that only pays off once models are downloaded at runtime.
#   telemetry        off by default. Reporting usage is the user's call to
#                    make, not the packager's.
#   update           NEVER enabled. It is a self-updater that would overwrite
#                    a Portage-managed binary behind Portage's back.
#
# cuda and vulkan are accelerator backends for local inference and stay
# optional, so nobody has to pull CUDA in to run this on a CPU.
IUSE="aws cuda +keyring local-inference telemetry vulkan"

DEPEND="
	keyring? ( sys-apps/dbus )
"
RDEPEND="${DEPEND}"
BDEPEND="
	local-inference? ( dev-build/cmake )
"

QA_FLAGS_IGNORED="usr/bin/goose"

src_prepare() {
	default

	# Upstream's own [patch.crates-io] redirects this crate at a GIT URL.
	# cargo.eclass writes its own [patch] into the cargo config pointing at
	# the tarballs it already unpacked, but the two patch tables ADD UP
	# instead of overriding, so cargo still tries to reach github and dies
	# on --offline with "can't checkout ... you are in the offline mode".
	# Rewriting upstream's entries to local paths is what actually removes
	# the network access.
	local forge="${WORKDIR}/cudaforge-${CUDAFORGE_COMMIT}"

	# sed exits 0 when it matches nothing, so every substitution is asserted
	# below -- otherwise an upstream reshuffle would silently restore the
	# network fetch and only fail much later.
	sed -i -E \
		-e "s|^(cudaforge) = \{ git = .*\}$|\1 = { path = \"${forge}\" }|" \
		Cargo.toml || die "failed to rewrite upstream [patch.crates-io]"

	local crate
	for crate in cudaforge; do
		grep -qF "${crate} = { path = " Cargo.toml ||
			die "[patch.crates-io] entry for ${crate} was not rewritten"
	done
	! grep -qE '^[a-z-]+ = \{ git = ' Cargo.toml ||
		die "a git dependency survived in Cargo.toml [patch.crates-io]"
}

src_configure() {
	local myfeatures=(
		code-mode
		rustls-tls
		$(usev aws aws-providers)
		$(usev keyring system-keyring)
		$(usev telemetry)
	)

	# cuda and vulkan accelerate LOCAL inference and mean nothing without it,
	# so they are folded in here rather than gated by REQUIRED_USE. That is
	# deliberate: both are global USE flags that the stock desktop profiles
	# enable by default, so "vulkan? ( local-inference )" failed REQUIRED_USE
	# on 36 profiles -- turning a common desktop USE setting into a refusal to
	# emerge. Silently ignoring them when local-inference is off is the lesser
	# evil, and metadata.xml says so.
	if use local-inference; then
		myfeatures+=(
			local-inference
			$(usev cuda)
			$(usev vulkan)
		)
	fi

	# --no-default-features is what keeps "update" out: it is in upstream's
	# default list, and there is no feature that switches it back off.
	cargo_src_configure --no-default-features
}

src_compile() {
	# The workspace also builds generate_manpages and mcp_conformance_driver,
	# which are development helpers and are not installed.
	cargo_src_compile -p goose-cli --bin goose
}

src_install() {
	# cargo_src_install runs "cargo install", which takes --path and not the
	# -p of "cargo build" -- passing -p here dies with "unexpected argument".
	# The feature list from src_configure still applies: the eclass threads
	# ECARGO_ARGS through both phases.
	cargo_src_install --path crates/goose-cli --bin goose

	einstalldocs
}
