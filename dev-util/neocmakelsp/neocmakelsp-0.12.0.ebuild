SLOT="0"
KEYWORDS="~amd64"

src_test() {
	# document_link and grammar tests both mutate the process-global CMake
	# cache (fileapi::set_cache_data); run in parallel they race and
	# test_document_link_search fails deterministically. Serial is clean.
	# Via the env var: cargo_src_test prepends its own '--', and a second
	# one from the caller turns into a filter that skips every test.
	RUST_TEST_THREADS=1 cargo_src_test
}

src_install() {
	cargo_src_install

	dobashcomp completions/bash/${PN}
	dofishcomp completions/fish/${PN}.fish
	dozshcomp completions/zsh/_${PN}

	einstalldocs
}
