# Distributed under the terms of the GNU General Public License v2

# OpenRC counterpart of upstream's socksproxy.service (system scope), the
# local SOCKS5 proxy the Mozilla VPN browser extension connects to. Named
# mozillavpn-socksproxy here so a generic "socksproxy" name stays free.
#   ExecStart=/usr/bin/socksproxy --unix /var/run/mozillavpn.proxy
#                                      -> command + command_args
#   ExecStopPost=rm -f ...             -> stop_post
#   Restart=on-failure                 -> supervise-daemon respawn
#   NoNewPrivileges=yes                -> no_new_privs
# Not mapped: CapabilityBoundingSet=CAP_NET_RAW.

description="Mozilla VPN SOCKS5 proxy for the browser extension"

command="/usr/bin/socksproxy"
command_args="--unix /run/mozillavpn.proxy"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
no_new_privs="yes"

depend() {
	use net
}

stop_post() {
	rm -f /run/mozillavpn.proxy
}
