Ioex_Internals.C calls fmt::format but includes only <fmt/core.h>, which
since libfmt 11 no longer declares it: "'format' is not a member of 'fmt'".
Every other ioss file using fmt::format includes <fmt/ostream.h>, which pulls
in <fmt/format.h>. ::gentoo's vtk-9.4.2-ThirdParty-libfmt-12.patch does not
cover this file.

--- a/ThirdParty/ioss/vtkioss/exodus/Ioex_Internals.C	2026-11-24 17:35:53.727576479 -0300
+++ b/ThirdParty/ioss/vtkioss/exodus/Ioex_Internals.C	2026-11-24 17:35:53.730576438 -0300
@@ -8,6 +8,7 @@
 #include "exodus/Ioex_Utils.h"
 #include "vtk_fmt.h"
 #include VTK_FMT(fmt/core.h)
+#include VTK_FMT(fmt/format.h)
 
 #include "Ioss_ElementTopology.h"
 #include "Ioss_GroupingEntity.h"
