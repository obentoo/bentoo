Mark gdbus-server-auth test flaky

Rebase of glib-2.64.1-mark-gdbus-server-auth-test-flaky.patch (Matt Turner)
onto 2.90.1, whose test table gained can_fail entries.
See https://gitlab.gnome.org/GNOME/glib/-/issues/1954

--- a/gio/tests/meson.build
+++ b/gio/tests/meson.build
@@ -290,6 +290,7 @@
     },
     'gdbus-server-auth' : {
       'dependencies' : [dbus1_dep],
+      'suite' : ['flaky'],
       # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/1672
       'can_fail': 'thread' in glib_sanitizers,
     },
@@ -300,6 +301,7 @@
     'gdbus-server-auth' : {
       # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/1672
       'can_fail': 'thread' in glib_sanitizers,
+      'suite' : ['flaky'],
     },
   }
 endif
