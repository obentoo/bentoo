#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

# SYSTEM-SCOPE OpenRC counterpart of speech-dispatcherd.service, which this
# package installs under USE=systemd. Installed unconditionally: it is the only
# way to run the system-wide daemon on a host that does not run systemd.
#
# The unit forks with "-d -t 0". Here the server runs in the foreground
# ("-s", single mode) under supervise-daemon instead, so OpenRC owns the
# process; "-t 0" keeps it from exiting when the last client leaves.

description="Common interface to speech synthesizers"
supervisor=supervise-daemon
command="/usr/bin/speech-dispatcher"
command_args="-s -t 0 ${SPEECHD_OPTS}"
extra_started_commands="reload"

depend() {
	after sound
}

reload() {
	ebegin "Reloading ${RC_SVCNAME}"
	supervise-daemon "${RC_SVCNAME}" --signal HUP
	eend $?
}
