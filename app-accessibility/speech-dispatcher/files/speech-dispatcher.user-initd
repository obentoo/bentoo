# USER-SCOPE service, installed to /etc/user/init.d and started by openrc-user
# as the logged-in user -- never by the system init. It is the OpenRC
# counterpart of the speech-dispatcher.service/.socket user units this package
# installs under USE=systemd, and unlike them it is installed unconditionally.
#
# The systemd unit is socket-activated on
# ${XDG_RUNTIME_DIR}/speech-dispatcher/speechd.sock. OpenRC has no socket
# activation, so the server is simply started up front; speech-dispatcher
# creates that same socket itself, so clients find it at the usual path. Clients
# that autospawn the server keep working whether or not this is enabled.

description="Common interface to speech synthesizers (per user)"
supervisor=supervise-daemon
command="/usr/bin/speech-dispatcher"
command_args="-s -t 0"
